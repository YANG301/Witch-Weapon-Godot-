# bathophobia_ep02.gd - 深海恐惧篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep02_script()

func play_script():
	pass

func bathophobia_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Beatrice morì nel 1290.) \\n(Il suo corpo attuale dovrebbe essere creato da Ren.)", "Mariru")
	await novel_interface.show_dialog("(Costruire un contenitore per l’anima… Questo è più una sorta di potere divino.)", "Mariru")
	await novel_interface.show_dialog("(Devo tacere su questo…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Ahah, interessante... \\nDavvero interessante.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Suppongo che tu abbia già indagato sull'altro agente coinvolto nell'operazione Sky Hotel. Il suo nome è Annie Basso.", "Mariru")
	await novel_interface.show_dialog("È una delle 50.000 persone scomparse nell'incidente della Light of Freedom Arena sette anni fa.", "Mariru")
	await novel_interface.show_dialog("È Ren che l'ha tirata fuori da un altro spaziotempo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Non sembri sorpreso.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("In tal caso… Spiega molto.", "Eloise")
	await novel_interface.show_dialog("Lasciare che Annie effettui operazioni senza nemmeno un alias… Mi sembra che non avessi intenzione di nascondercela.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Non puoi davvero nascondere una celebrità come Annie Bass, vero, signora Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ma assegnarti il ruolo di tutore di Ren... C'è qualche ulteriore motivo in gioco?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Humph. Naturalmente c'è.", "Mariru")
	await novel_interface.show_dialog("Ho notato l'abilità speciale di Ren anni fa. Ma dal momento che i suoi genitori progettavano di emigrare a Newmoridas...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("dovevo prendere qualche provvedimento...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Quell'incidente aereo in cui morirono i suoi genitori e suo fratello...", "#C")
	await novel_interface.show_dialog("Eri... tu?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Eheh, non lo ammetterei.", "Mariru")
	await novel_interface.show_dialog("Voglio ancora essere il tutore del tesoro, lo sai.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Eh, ora vedo cosa serve per diventare il capo di SID. Mi sento molto più sicuro!", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Per la pace e la stabilità di New Opulentia sono necessari alcuni sacrifici.", "Kirs")
	await novel_interface.show_dialog("Mariru e SID hanno sempre fatto un buon lavoro.", "Kirs")
	await novel_interface.show_dialog("Quindi, immagino che SID abbia trovato alcune informazioni sui recenti flussi spaziotemporali.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Secondo il profilo della ragazza ha solo 15 anni. Sarebbe troppo rischioso mandarla in una zona Flux?", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vale la pena rischiare.", "Mariru")
	await novel_interface.show_dialog("Sulla base delle informazioni che ha raccolto... \\nCrediamo che il flusso spaziotemporale sia la manifestazione di turbolenza probabilistica.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Cioè, far sì che un evento estremamente improbabile accada con certezza al 100%.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Sembra una magia!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("È davvero... un'abilità per la quale la gente morirebbe...", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("No. Questo è fattibile solo teoricamente… Richiederebbe un osservatore estremamente competente…", "Bright")
	await novel_interface.show_dialog("Ma una tale intensità di osservazione è impossibile, anche se concentriamo su di essa tutta l’attenzione umana…", "Bright")
	await novel_interface.show_dialog("A meno che...", "Bright")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("A meno che non stiamo parlando di colui che ha creato Substance H…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Uffa—", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il dottor Kirs sospira profondamente. Un lungo silenzio riempie la stanza.")
	await novel_interface.show_text_only("Il creatore di Substance H è un argomento a lungo evitato dalla comunità scientifica.")
	await novel_interface.show_text_only("Proprio come la domanda “chi ha creato il big bang”: senza falsificabilità, va oltre la portata della scienza.")
	await novel_interface.show_text_only("Proprio come il tentativo degli scienziati di studiare galassie distanti oltre le capacità di Hubble, che si muovono più velocemente della luce lontano dalla Terra a causa dell’espansione cosmologica.")
	await novel_interface.show_text_only("Credono che l'universo osservabile sia solo una piccola frazione dell'intero universo. Stiamo intenzionalmente evitando il resto.")
	await novel_interface.show_text_only("La parte più rassicurante della scienza è che chiude gli occhi sull’ignoto.")
	await novel_interface.show_text_only("Se esistono osservatori onnipotenti, allora per loro gli esseri umani non sono altro che polvere di cometa...")
	await novel_interface.show_text_only("E un tale dio non ci benedirà... Solo noi possiamo salvarci.")
	await novel_interface.show_text_only("Nell'universo oscuro e freddo... Forse questa è la verità più terrificante.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("… In sintesi, lo Spaziotempo Fluxional è un incidente di collasso probabilistico irregolare su larga scala.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ciò viene innescato dall'evocazione, dall'interno di uno spaziotempo delimitato con dimensioni limitate, un osservatore onnipotente che va oltre la comprensione umana.", "Mariru")
	await novel_interface.show_dialog("Il flusso spaziotemporale, come risultato di una turbolenza probabilistica, viene creato quando i sensi dell'evocatore vengono distrutti dall'osservatore.", "Mariru")
	await novel_interface.show_dialog("Ma il suo impatto può essere efficacemente eliminato se qualcuno riesce ad entrare nell'Area Flux e controllare l'evocatore.", "Mariru")
	await novel_interface.show_dialog("Ho testato questa teoria più volte nell'Area del Flusso in ​ New Opulentia. E funziona.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("D’altra parte, lasciare evaporare solo l’Area di Flusso senza alcun intervento causerà un’esplosione di entropia locale.", "Mariru")
	await novel_interface.show_dialog("È molto probabile che uno o più sensitivi perdano la sanità mentale all'interno del punto di evaporazione, causando ulteriori danni.", "Mariru")
	await novel_interface.show_dialog("Finora, tale follia sembra irreversibile e questi sensitivi corrispondono alla descrizione delle streghe nei dossier medievali.", "Mariru")
	await novel_interface.show_dialog("L'unica buona notizia è che le streghe possono essere soppresse con mezzi convenzionali dopo che uno Spaziotempo Fluxional è evaporato.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Questo è tutto da parte mia.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Segue un silenzio di tomba.")
	await novel_interface.show_text_only("Dall'altra parte del canale di comunicazione criptato, solo i sussulti per lo shock rompono il pesante silenzio.")
	await novel_interface.show_text_only("Anche l’élite al potere di New Opulentia difficilmente riesce a digerire queste informazioni tutte in una volta.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Infatti…", "Kirs")
	await novel_interface.show_dialog("I danni causati dal Flusso Spaziotemporale a New Opulentia sono molto inferiori a quelli causati in altre Città Accademia.", "Kirs")
	await novel_interface.show_dialog("Abbiamo sempre attribuito tutti i crediti a Aegis…", "Kirs")
	await novel_interface.show_dialog("Adesso capisco... Le capacità della ragazza giustificano l'assoluta riservatezza.", "Kirs")
	await novel_interface.show_dialog("E Mariru è davvero la persona migliore come suo tutore.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ma puoi provare quello che hai detto?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("SID ha conservato tutti i dati di monitoraggio.", "Mariru")
	await novel_interface.show_dialog("E ci sono state segnalazioni di creature simili a quelle umane trovate vicino alle aree di Flux che hanno un enorme potere distruttivo e non sono in grado di comunicare.", "Mariru")
	await novel_interface.show_dialog("Un caso simile si è verificato recentemente vicino alla sottostazione Johnson.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Credo che il dottor #C ne abbia già sentito parlare.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fissa la sagoma criptata sullo schermo.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Il ricordo di Madam Mariru che scende trionfante dall'elicottero stealth è indimenticabile.", "#C")
	await novel_interface.show_dialog("Non ho altri dubbi se anche la ragazza di nome Ren sia su quell'elicottero.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Sembra che Enzo e i suoi uomini abbiano tenuto la bocca chiusa.)", "Mariru")
	await novel_interface.show_dialog("Per lo stesso motivo, ho inviato Ren allo Sky Hotel nel caso in cui si verificasse un flusso spaziotemporale nella zona demilitarizzata.", "Mariru")
	await novel_interface.show_dialog("Semplicemente non mi aspettavo che qualcuno portasse via le prove chiave...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Quindi, fin dall’inizio, hai cercato la B d’Oro…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("—Mariru aveva ragione.", "Kirs")
	await novel_interface.show_dialog("Sai come Ren attiva la sua abilità? Oppure hai testato la soglia di intervento?", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Kirs interrompe rapidamente Bright e cambia argomento.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Eh, ora stai mostrando i tuoi colori…)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Non abbiamo organizzato un esperimento perché abbiamo bisogno di strutture protettive speciali.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quello sullo schermo sembra infastidito.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Per una risorsa così speciale, il Senato ti darà sicuramente pieno sostegno.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru abbassa la testa, nascondendo un sorriso sornione.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Per ora non sappiamo se ci sia qualche pericolo mortale in un altro spaziotempo.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("E anche se riportiamo qualcuno o qualcosa, come facciamo a sapere se non sono offensivi?", "Mariru")
	await novel_interface.show_dialog("Dopotutto, ci sono state molte voci nella storia che incolpavano le streghe per l'ascesa della Morte Nera...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ma incaricare Mariru di un esperimento così entusiasmante? Non credo…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Perché non portare quel Ren nel mio laboratorio? \\nAhahahahahah…", "Bright")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bright emette una sonora risata.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Non so chi voglio che si prenda cura di questo gattino... Se possibile, vorrei anche provare ad allevarlo~", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("In qualità di tutore di Ren, rifiuto tutte le tue richieste.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorride.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ma...", "Mariru")
	await novel_interface.show_dialog("Dato che il Senato tiene così tanto a Ren, vorrei fare una proposta...", "Mariru")

	print("=== 深海恐惧篇第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
