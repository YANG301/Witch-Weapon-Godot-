# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-chou…", "Beth")
	await novel_interface.show_text_only("Posant sa tête sur le bureau, la jeune fille aurait pu s'assoupir sans cet éternuement.")
	await novel_interface.show_text_only("À l'extérieur de la fenêtre du sous-marin se trouve la nuit polaire, et la couleur du ciel ne permet pas de lire l'heure.")
	await novel_interface.show_text_only("Beth regarde l'écran et se rend compte que ce n'est que quelques heures après sa rencontre avec le monstre des profondeurs.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Est-ce que je fais la bonne chose ?", "Beth")
	await novel_interface.show_dialog("(L'utiliser pour trouver la vérité par moi-même…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sans s'en rendre compte, Beth jette un coup d'œil au cahier qu'elle tient à la main.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Si mon père était là…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Il ne vacillerait jamais à cause de ce genre d'émotions.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("En pensant aux mains fortes de son père, Beth serre lentement le poing.")
	await novel_interface.show_text_only("Le carnet, rempli de textes obscurs, appartenait autrefois à son père adoptif.")
	await novel_interface.show_text_only("C'était un biologiste grand, silencieux et dévoué, strict avec Beth et lui-même.")
	await novel_interface.show_text_only("En raison des capacités particulières de Beth, il lui a organisé des formations rigoureuses en dehors de ses travaux scolaires.")
	await novel_interface.show_text_only("Beth se souvient qu'elle a dû travailler très dur chaque jour pour atteindre les objectifs fixés par son père.")
	await novel_interface.show_text_only("Ce à quoi elle s'attendait le plus, c'était le sourire occasionnel de reconnaissance sur son visage sérieux.")
	await novel_interface.show_text_only("Sans grande tendresse, l'homme réservé la protégeait à sa manière…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("— Comme pour la préparer à un destin inéluctable…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("On her 12th birthday, Beth received an anonymous package. À l'intérieur se trouvait ce carnet et la nouvelle de la mort de son père.")
	await novel_interface.show_text_only("Une explosion de gaz a tué plus de 30 personnes, dont le seul membre de la famille de Beth au monde.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Les lèvres tremblantes, Beth prononce un nom silencieux.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les indices derrière ce nom lui ont fait comprendre que la mort de son père n'était pas un accident comme le rapportent officiellement.")
	await novel_interface.show_text_only("La jeune fille solitaire a dû sécher ses larmes et grandir rapidement pour survivre aux dangers inconnus.")
	await novel_interface.show_text_only("—Son père a dit dans le cahier que sa capacité spéciale l'exposerait au danger et ferait d'elle la cible du gang.")
	await novel_interface.show_text_only("Le colis ne serait envoyé que lorsqu’il ne pourrait plus la protéger…")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Pourquoi les gens auraient-ils envie de… ce genre de capacité…)", "Beth")
	await novel_interface.show_dialog("(N'est-ce pas plutôt une malédiction…)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth regarde sa paume. Plusieurs boules de lumières argentées rebondissent sur ses doigts.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth sait qu'elle est différente depuis qu'elle peut se souvenir des choses, mais pas à cause de ses capacités spéciales.")
	await novel_interface.show_text_only("Elle a une mémoire eidétique des chiffres même lorsqu'elle était enfant. Elle peut faire du calcul mental beaucoup plus rapidement que les autres et s'intéresse vivement aux machines.")
	await novel_interface.show_text_only("Mais son père lui a demandé de faire profil bas et d'agir comme une enfant ordinaire afin de dissimuler ses capacités spéciales.")
	await novel_interface.show_text_only("Après sa mort, Beth a décidé de ne plus se cacher.")
	await novel_interface.show_text_only("Un an plus tard, elle a été admise dans une université prestigieuse avec une autorisation spéciale, une exception faite pour la première fois depuis des années.")
	await novel_interface.show_text_only("Elle étudiait dur et lisait beaucoup, mais ne trouvait la réponse ni dans les livres ni dans les cours.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Pourquoi suis-je différent…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle continuait à apprendre et à réfléchir, comme si elle essayait de satisfaire d’un seul coup sa curiosité longtemps réprimée.")
	await novel_interface.show_text_only("Elle ne réalisait pas qu'elle était ainsi qualifiée d'arrogante, indifférente et inaccessible.")
	await novel_interface.show_text_only("Petit à petit, les gens lui ont tourné le dos, mais elle s'en fichait.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Sinon, je ne t'aurais pas rencontré…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle a rencontré Silvia dans un accident.")
	await novel_interface.show_text_only("Il n'a fallu que quelques minutes à Beth pour comprendre que Silvia était une enquêtrice déguisée en étudiante. Sa mission était de rechercher des Substance H illégaux sur le campus.")
	await novel_interface.show_text_only("Elle savait que le nom et les expériences de Silvia pouvaient être faux, mais elle était toujours attirée par sa personnalité insouciante et joyeuse.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Elle est… différente.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elle me connaît mieux que quiconque…")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Même si elle a l'habitude de se déguiser devant les autres…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle m'a vraiment ouvert son cœur sans aucune réserve.")
	await novel_interface.show_text_only("Mais aucun d’eux ne s’attendait à ce que leur amitié attire l’attention de l’organisation derrière Milk.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sachant qu'elle était la fille adoptive du célèbre biologiste, le patron de Milk l'invite à rejoindre la mission Antarctique.")
	await novel_interface.show_dialog("(J'avais l'intention de refuser…)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("Dans une base souterraine du Squad.")
	await novel_interface.show_text_only("Ce qui l'a fait changer d'avis et décider de nous rejoindre, c'est un symbole sur le guide de mission :")
	await novel_interface.show_text_only("Un symbole qu'elle a vu dans le carnet de son père.")
	await novel_interface.show_text_only("Un globe oculaire noir effrayant représentant une organisation religieuse secrète.")
	await novel_interface.show_text_only("Son père a enregistré ses contacts avec des personnes de cette organisation. Ils avaient montré leur intention de mobiliser des personnes dotées de capacités particulières et de créer un groupe militant.")
	await novel_interface.show_text_only("Le plan a été nommé Projet Ningen.")
	await novel_interface.show_text_only("Après que les documents de son orphelinat soient tombés entre leurs mains, Beth figurait sur la liste des personnes les plus recherchées du projet Ningen.")
	await novel_interface.show_text_only("En conséquence, son père est devenu la cible de cette dangereuse organisation.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen… l'Antarctique.)", "Beth")
	await novel_interface.show_dialog("(La base de la Reine des Neiges en Antarctique…) \\n(Elle doit son nom à une histoire des contes de fées d'Andersen.)", "Beth")
	await novel_interface.show_dialog("En danois, c'est Snedronningen \\nOu Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(Ce n'est pas une coïncidence.)", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Donc votre patron et la bande poursuivent la même chose…", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("À en juger par votre expression… ce gang semble être plus dur que les autres sur la liste noire…", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth hoche la tête, mais elle ne veut pas parler davantage.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Désolé. J'ai rejoint cette mission pour des raisons égoïstes.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Eh bien, je le sais.", "Lait")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Mais Boss veut juste que vous poursuiviez les recherches de votre père sur la vie marine.", "Lait")
	await novel_interface.show_dialog("C'est donc gagnant-gagnant.", "Lait")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Quant à tes motivations égoïstes… Je sais que tu es tellement charmé par moi que tu décides de rester ici.", "Lait")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Oh, c'est trop de pression pour moi !", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk dit et envoya un baiser à Bai Yan, ce qui fit sourire Bai Zhu.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ce qu'elle ne remarque pas, c'est une tristesse passagère dans les yeux clairs de son amie.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Elle se sent encore coupable en repensant au moment où elle a signé les documents.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Je… l'utilisais.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth s'assoit au bureau, sort un stylo et regarde le cahier ouvert.")
	await novel_interface.show_text_only("Les plus utiles sont précieux.")
	await novel_interface.show_text_only("— Elle note sa pensée.")
	await novel_interface.show_text_only("Tu m'as dit ça… Et j'ai toujours été d'accord avec toi…")
	await novel_interface.show_text_only("Utilisez les autres ou soyez utilisé sans scrupules \\n« C'est quelque chose que vous prenez pour acquis… »")
	await novel_interface.show_text_only("Cela dépend uniquement de qui a la valeur la plus élevée.")
	await novel_interface.show_text_only("Il n'y a pas besoin d'expliquer. Concentrez-vous simplement sur votre objectif.")
	await novel_interface.show_text_only("Seule une relation aussi simple peut vous protéger de la plupart des gens.")
	await novel_interface.show_text_only("Beth fait une pause.")
	await novel_interface.show_text_only("Mais tu m'as aussi dit qu'il y avait encore...")
	await novel_interface.show_text_only("Quelqu’un qui veut être utilisé par vous quoi qu’il arrive. \\n\"Et quelqu'un que vous ne voulez utiliser sous aucun prétexte.\"")
	await novel_interface.show_text_only("En pensant à cela, un léger sourire se dessine sur ses lèvres.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(La culpabilité ? C'est un sentiment qui doit être écarté.)", "Beth")
	await novel_interface.show_dialog("(Alors est-ce… de l'affection ?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ferme son journal.")
	await novel_interface.show_text_only("Maintenant, elle a trouvé sa réponse.")
	await novel_interface.show_text_only("Elle regarde par la fenêtre et constate que le ciel bleu foncé s'approfondit, se fondant presque dans la mer infinie.")
	await novel_interface.show_text_only("Soudain, une alarme d'urgence se déclenche à travers le navire.")
	await novel_interface.show_text_only("Attention, tout l'équipage. Directive modifiée. Présentez-vous à la salle de réunion dans dix minutes.")
	await novel_interface.show_text_only("Répétez. Directive modifiée…")
	await novel_interface.show_text_only("Beth prend une profonde inspiration, range le cahier et sort précipitamment de la pièce.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
