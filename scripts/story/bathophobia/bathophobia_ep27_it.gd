# bathophobia_ep27.gd - 深海恐惧症篇第27话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep27_script()

func play_script():
	pass

func bathophobia_ep27_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Alla fine Beth cade in un sonno agitato sulla mia spalla.")
	await novel_interface.show_text_only("Henriette si avvicina lentamente al serbatoio frantumato e preme una mano sul fondo, dove si è ancora accumulato del liquido azzurro.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Questo è...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Cosa?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Più del 99% è acqua, ma non è questo il punto. Il punto è...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gira intorno al retro della vasca e osserva attentamente, rintracciando infine i fili e i tubi fino a un angolo buio, dove trova un piccolo armadietto.")
	await novel_interface.show_text_only("È dipinto con uno strato di metallo grigio-verde, che riflette il bagliore azzurro della tormalina.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Quello è...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("(È lo stesso materiale dipinto sopra la valigia che contiene il frammento della strega di Beatrice!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È una lega che indebolisce o blocca gli effetti psicologici e meme causati da Substance H. Ciò significa che ciò che c'è all'interno dell'armadio deve essere...")
	await novel_interface.show_text_only("Prima che possa fermarla, l'alchimista ha già aperto l'armadietto e recuperato una fiala di vetro.")
	await novel_interface.show_text_only("Un quinto del liquido blu all'interno è già stato consumato.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Deve essere quello che l'uomo nel filmato ha portato con sé...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Non so dire di cosa si tratti esattamente, ma deve essere stato ciò che ha tenuto in vita la ragazza e l'ha guarita.","Henriette")
	await novel_interface.show_dialog("Secondo il timer sulla serratura dell'armadietto, l'ultima volta è stata aperta 167.665 ore e 48 minuti fa.","Henriette")
	await novel_interface.show_dialog("Dopo tutto questo tempo, non è invecchiata per niente. Oh. È già qualcosa.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gli occhi di Henriette brillano, la voce trema per l’eccitazione.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Biologicamente, questo significa...","Raphael")
	await novel_interface.show_dialog("... che questa sostanza ferma il processo del metabolismo e prolunga notevolmente la durata della vita delle cellule. Un’altra possibile spiegazione è che sia in grado di fornire telomeri e accelerare il processo di apoptosi delle cellule danneggiate.","Raphael")
	await novel_interface.show_dialog("Ma stava ancora respirando all'interno della vasca.","Raphael")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("In tal caso...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Noi tre riportiamo Beth fino all'ingresso della base. Adesso non siamo più nel sogno, ma non abbiamo ancora incrociato nessun corpo lungo la strada.")
	await novel_interface.show_text_only("Liliu, che aspettava qui da molto tempo, mi ha gettato sulla nave senza dire una parola e ha lasciato che Aiyi mi devastasse all'impazzata.")
	await novel_interface.show_text_only("Aya alza un sopracciglio vedendo il mio vestito fradicio e mi lancia un paio di pantaloni della tuta rosa con strisce laterali bianche.")
	await novel_interface.show_text_only("Per quanto riguarda quello che è successo dopo, per favore... dimentichiamolo!")
	await novel_interface.show_text_only("Raphael esprime i suoi sospetti che il risveglio di Beth non sia stato il motivo per cui siamo riusciti a lasciare il sogno.\\nNel frattempo, Aya raccoglie i vestiti che mi sono cambiata, dichiarando che condurrà degli studi su di essi.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(Studi? Che tipo di studi?)","Lian")
	await novel_interface.show_dialog("(Lasciami in pace, ok?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stavo sognando che mi scoppiava la vescica... e poi qualcuno mi ha dato una gomitata nello stomaco...")
	await novel_interface.show_text_only("Chi non si sveglierebbe quando gli accade qualcosa del genere, giusto?")
	await novel_interface.show_text_only("Beth, ancora profondamente addormentata, viene immediatamente messa in quarantena nell'infermeria. Anche Annie si addormenta non appena sale sull'aereo. Deve essere spesa.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Tuttavia, non abbiamo trovato un modo per gestire la perdita di metano...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mormoro preoccupata, fissando la gigantesca crepa nel ghiaccio dalla finestra.")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("... Secondo te?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael appare da dietro e si unisce a me guardando fuori dalla finestra. Un sorriso misterioso gioca sulle sue labbra.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Sa qualcosa che io non so? Sta... ridendo di me?)","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ehm.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael torna sobria e inizia a parlare sul serio.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Ci sono due problemi principali con il piano suggerito dal nonno, quello con i metanofili resistenti al freddo.","Raphael")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annuisco, anche se non ho la minima idea di cosa stia parlando.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Il problema principale è che i geni degli archaea metanofili sono piuttosto instabili. Ciò li rende difficili da coltivare su larga scala. Dopo qualche dozzina di cicli di divisione, di solito mutano e non funzionano più nel modo in cui ne abbiamo bisogno.","Raphael")
	await novel_interface.show_dialog("La divisione avviene ogni dieci, venti minuti circa, il che è positivo, ma i batteri mutati possono comunque moltiplicarsi e finire per contaminare il resto degli esemplari a una velocità incontrollabile.","Raphael")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("È quasi impossibile eliminare i ceppi mutati con la nostra attuale tecnologia. Questo è il motivo principale per cui i metanofili sono difficili da coltivare.","Raphael")
	await novel_interface.show_dialog("Eppure, se “questa sostanza” è in grado di mantenere in vita una persona così a lungo, senza nemmeno invecchiare...","Raphael")
	await novel_interface.show_dialog("Potrebbe essere la chiave per risolvere questo problema dal punto di vista delle cellule stesse.","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sembra interessante detto così... \\nQuindi, questo significa che il progetto metanofilo è un tentativo?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("C'è ancora un altro problema, però. I metanofili muoiono a contatto con l'ossigeno, quindi potranno sopravvivere solo vicino alle fonti di perdita.","Raphael")
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Se proviamo a diffonderli nell'atmosfera utilizzando il bioaerosol, moriranno prima ancora di raggiungere la terra.","Raphael")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Abbiamo bisogno di una sorta di recipiente per impedire loro di entrare in contatto con l'ossigeno. Deve anche essere in grado di autodegradarsi in un ambiente freddo.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya mi dà un pizzicotto e mi lancia uno sguardo significativo.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh... intendi aerogel?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Questo era ciò che Annie usava per sigillare la camera d'albergo di quella principessa viziata. Il gruppo di Igor però è riuscito a sfondarlo con l'azoto liquido.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Sembra un piano divertente. Sei piuttosto intelligente, eh?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mi ha appena... lodato?")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ho sentito male?)","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ehi, a proposito, perché indossi i pantaloni della tuta? Ti sei pisciato addosso o qualcosa del genere?","Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, no, no, decisamente no!","Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Nel laboratorio della Stazione McMurdo sono conservati alcuni metanofili resistenti al freddo estratti dal limo sepolto nelle profondità dei ghiacciai.")
	await novel_interface.show_text_only("Anche se all'inizio riusciamo a ottenere solo pochi esemplari, Aya coltiva comunque abbastanza ceppi attivi utilizzando il liquido blu nel giro di un paio d'ore.")
	await novel_interface.show_text_only("Mentre l’incrociatore sorvola l’Antartide, noto che, laggiù, innumerevoli droni provenienti da paesi diversi lavorano insieme sopra le crepe.")
	await novel_interface.show_text_only("Nell'aerosol modificato con strutture a rete, i metanofili ad alta densità sono sigillati e dispersi nei siti di perdita sotto forma di innumerevoli minuscoli cristalli.")
	await novel_interface.show_text_only("Dodici ore dopo il terremoto, i dati provenienti da diverse stazioni meteorologiche dell'Antartide mostrano che il livello di metano nell'atmosfera è ormai di nuovo sotto controllo.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mariru successivamente invia al Congresso Unito una richiesta per una scandalosa tassa di mantenimento, che sarà pagata da tutte e sei le Città Accademia.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Henriette è seduta nella sala di controllo, con il viso impassibile. Mariru sta davanti al grande schermo e studia le figure su di esso.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Henriette Khunrath...","Mariru")
	await novel_interface.show_dialog("Sei davvero qualcosa, non è vero? Ho trascinato la mia squadra in una fase di fluttuazione nel momento in cui sei arrivato...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Piacere di conoscerti.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sorride, il viso tranquillo.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ne abbiamo già parlato, ma questa è la prima volta che ci incontriamo faccia a faccia.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Almeno questa non sembra una stanza per gli interrogatori. Dovrei essere grato... ?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ignora le parole provocatorie di Henriette e continua a fissare il suo curriculum.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Entrò all'Università di Lipsia all'età di dieci anni. Divenne un alchimista certificato a quattordici anni.","Mariru")
	await novel_interface.show_dialog("Successivamente è andato all'Università di Basilea e ha conseguito il dottorato in medicina in quattro mesi.","Mariru")
	await novel_interface.show_dialog("La data di morte registrata risale al 1605. La ragione della morte fu un'esplosione in un laboratorio.","Mariru")
	await novel_interface.show_dialog("Secondo alcuni manoscritti, prima che avvenisse l'esplosione, una società registrata nei Paesi Bassi aveva pagato profumatamente gli abitanti dei dintorni chiedendo loro di trasferirsi.","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Il diario dell'ispettore di allora ci diceva che la potenza degli esplosivi coinvolti probabilmente superava quella della dinamite alla nitroglicerina inventata oltre duecento anni dopo.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ahah. Quello era semplicemente il mio piano per sfuggire a The One.","Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Eppure quegli alchimisti hanno impiegato più di duecento anni per raggiungermi, eh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette prende in giro.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Duecento anni dopo non esistevano più gli alchimisti. Adesso si chiamano chimici.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Anche gli esplosivi inventati successivamente non necessitavano di un sigillo magico. I non alchimisti potrebbero produrli in grandi lotti. È abbastanza redditizio.","Mariru")
	await novel_interface.show_dialog("Anche se di tanto in tanto le persone uccidevano accidentalmente i loro parenti...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sorride, come se capisse.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("L'unico scritto che hai lasciato è stato il manoscritto dell'Anfiteatro della Saggezza. Attualmente fa parte della collezione del Museo Municipale di Newmoridas.","Mariru")
