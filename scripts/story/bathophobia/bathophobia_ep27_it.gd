	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, quello. Mi ci è voluto molto tempo, quello. Dovrei controllarlo quando ne avrò la possibilità.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Eri prima di tutto un collezionista di gemme, anche se della tua collezione rimangono solo cinque pezzi, che rappresentano i cinque elementi. Il lapislazzuli è il più importante di tutti...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, quello che Ren ha distrutto? Non è così importante.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... Davvero non hai lasciato molte informazioni. Prima di questa operazione non ci rendevamo nemmeno conto che fossi solo una ragazzina.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tutto ciò che avevamo erano i documenti lasciati dai civili all'epoca, scoperti da Salmonton durante le indagini dopo la tua scomparsa insieme a Raphael e Ren.","Mariru")
	await novel_interface.show_dialog("Se avessimo preso in considerazione queste informazioni in primo luogo, sicuramente non avremmo scelto il lapislazzuli per sperimentare.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Troppo tardi per pentirsene adesso. Quindi sembra che io e il Maestro fossimo destinati a incontrarci, eh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza bionda stira pigramente le sue membra.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("C'è un'altra cosa che mi incuriosisce. Sia la registrazione audio di Ren che la tua descrizione menzionano l'Albero della Vita come una sorta di sigillo...","Mariru")
	await novel_interface.show_dialog("... che tiene a bada l'essere che anche l'Uno teme.","Mariru")
	await novel_interface.show_dialog("Secondo la testimonianza di Beth, quell'essere... o uno di quegli esseri... è un'enorme creatura simile a un bulbo oculare che esiste nelle profondità marine.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
