	await novel_interface.show_dialog("Tutto quello che posso fare ora è trattarli come leggi della fisica: come condizioni preesistenti.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Una decisione saggia. E allora cosa vuoi sapere?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Voglio che tu mi dica... cosa ha reso instabile il sigillo.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una buona domanda da parte di un tattico pratico. Henriette alza lo sguardo negli occhi determinati di Mariru.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("A proposito...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza bionda alza la mano destra. In un'esplosione di luce e simboli vorticosi, una gemma azzurra si materializza nel suo palmo.")
	await novel_interface.show_text_only("Al suo centro galleggia la proiezione di un oggetto a forma di bulbo oculare, avvolto da una sostanza fluente, simile a un liquido.")
	await novel_interface.show_text_only("La pupilla del bulbo oculare si dilata, trema in modo irregolare, come farebbe il bulbo oculare di un essere umano che entra nel sonno REM.")
	await novel_interface.show_text_only("Quelli che sembrano nervi periferici ramificati galleggiano nel liquido. Sembra tranquillo, stranamente.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Nemmeno io ho idea di cosa sia \"esso\".","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette fissa il bulbo oculare in totale fascino.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Ciò che conta è che qualunque cosa lo trattenesse nel suo corpo ora non c'è più.","Henriette")
	await novel_interface.show_dialog("Oppure... pensi davvero che un essere umano sarebbe potuto sopravvivere dopo aver punto questa cosa... con una sonda?","Henriette")
