	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... Morirebbero, immagino.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette annuisce, lancia la gemma in aria prima di riprenderla.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("La Nona Sephira rappresenta il “fondamento” della vita. La sua capacità di rivitalizzare gli esseri viventi è probabilmente ciò che ha tenuto in vita quella ragazza per così tanto tempo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Per diciannove anni, eh...","Mariru")
