	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru digita sul suo dispositivo portatile, richiamando la cronologia dei dati dei parametri vitali di Beth dal gigantesco database.")
	novel_interface.show_character("heinrich_battle","smile")
