# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Землетрясение на Южном полюсе продлится недолго. Пустой слой под станцией снабжения, установленный в качестве меры предосторожности против метелей, эффективно уменьшает ущерб, причиняемый подземными толчками.")
	await novel_interface.show_text_only("Менее чем через минуту земля возвращается в прежнее спокойное состояние.")
	await novel_interface.show_text_only("Я вырос на границе Aegis — землетрясение такой силы меня нисколько не беспокоит.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Просто небольшое землетрясение. Все в порядке?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Да,..., но почему твоей первой реакцией было придержать юбку?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Например, вы уверены, что это должно быть вашим приоритетом во время землетрясения?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Э-э, ну... \\nЭто просто...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ой, давай, дай мне передохнуть!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("И все же это странно. Антарктида – это континент, покрытый слоем толстого льда. Это точно не сейсмоопасная зона.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия хмурится, глядя в окно.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Или я неправильно запомнил?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Итак, Девятая Сефира наконец-то вызвала проблему, да...", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Рен, смотри!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie внезапно кричит, указывая на окно. Я наклоняюсь поближе, чтобы посмотреть.")
	await novel_interface.show_text_only("На ровном слое льда появилась гигантская трещина. Под бархатным небом оно выглядит почти как пропасть, ведущая прямиком в ад.")
	await novel_interface.show_text_only("В каком-то смысле это не трещина, а скорее каньон...")
	await novel_interface.show_text_only("На краю пропасти торчат острые шипы. Из глубины толстого слоя льда вылезают аномальные сетчатые структуры.")
	await novel_interface.show_text_only("Ледяные скалы с обеих сторон, кажется, остаются примерно на одной высоте. Будто какая-то невообразимая сила разорвала всю ледяную стойку на части.")
	await novel_interface.show_text_only("Огромная трещина извивается вперед, к высокогорью, исчезая из поля зрения...")
	await novel_interface.show_text_only("К счастью, мы здесь, в долине. Мы здесь в безопасности.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Эй, что это?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия и Генриетта подходят ближе, чтобы посмотреть на то, на что я показываю. Они оба задыхаются.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Это здание..., почему оно не пострадало?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На ледяных равнинах прямо перед нами на пути распространяющейся трещины вырисовывается огромное искусственное сооружение, совершенно нетронутое.")
	await novel_interface.show_text_only("Его темные стены кажутся неуместными на этой бледной, белой земле.")
	await novel_interface.show_text_only("Вместо того, чтобы разорвать здание на части, как это должно было быть, трещина огибала его в виде двух дуг, как будто в конструкции было что-то, что она не хотела нарушать.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Это только что упомянутое место встречи Mariru?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Кажется, это правильное место.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Из панели управления слышно потрескивание помех. Кажется, станция снабжения восстанавливает связь с внешним миром.")
	await novel_interface.show_dialog("Привет? Рен? Ты слышишь меня?", "Mariru")
	await novel_interface.show_text_only("Mariru звучит немного нервно.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Прежде чем вызванная нами группа разведывательных спутников завершит смену маршрутов, графический канал Антарктиды может обновляться только раз в тридцать пять минут в статическом виде.")
	await novel_interface.show_text_only("На экране продолжают появляться сообщения, содержащие информацию Mariru, собранную с крупных полярных станций.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Что-то не так. Это землетрясение... это ненормально.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Странно, я до сих пор не могу получить сигнал от ребят с базы Снедроннинген...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru щурится на последний обновленный отчет датчика погоды на базе в Нюрнберге.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Подождите, это...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru отчаянно стучит по своему портативному устройству, вызывая в режиме реального времени все данные метеорологического и гидрологического мониторинга Антарктиды, которые она может найти.")
	await novel_interface.show_text_only("Легко заметить, что цифры меняются — быстро и последовательно. Ей внезапно вспомнился курс, который она проходила в университете...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Скажи мне, Ая...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Хм?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Даже если не принимать во внимание воздействие ядерного оружия и посторонних объектов, на земле все еще скрывается множество природных факторов, которые могут вызвать «конец света».", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Конечно. Люди, по сути, появились только после пятого массового вымирания на Земле. Природные факторы действительно могут быть смертельными.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("А что касается самого опасного природного элемента, который можно найти в Антарктиде...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Черт возьми,..., это метан!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Рен, ты уверен, что трещина рядом с тобой?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Да. Но что странно, так это то, что...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я сообщил Лилилиу информацию о том, что разлом, похоже, намеренно обходит базу Белой Королевы.")
	await novel_interface.show_text_only("Mariru немного обдумывает эту информацию. Когда она заговорит в следующий раз, ее тон будет четким и деловым.")
	await novel_interface.show_dialog("Послушайте, вполне вероятно, что метан, который был запечатан под землей в течение миллионов лет, в настоящее время вытекает из разлома.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Подождите,..., да, я знаю, что здесь под землей хранятся миллиарды тонн метана, но... разве они не твердые? Как горючий лед?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Возможно, они испарились из-за давления, вызванного разрывом шельфового ледника во время землетрясения. По крайней мере, те, кто разоблачен, скорее всего, так и сделали.", "Ai")
	await novel_interface.show_dialog("По данным датчиков Нюрнбергской базы, уровень метана над Антарктидой поднялся на 2,1 промилле по сравнению с часом назад, до землетрясения.", "Mariru")
	await novel_interface.show_dialog("На других метеостанциях цифры различаются, но результаты одни и те же: там наблюдается резкий рост уровня метана, как ни посмотри.", "Mariru")
	await novel_interface.show_dialog("В районе океана возле шельфового ледника Эймери также наблюдаются аномалии. Мы полагаем, что это произошло из-за того, что метан из-под океана вскипел, вызвав нарушение приливов и отливов.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Если я правильно помню, парниковый эффект метана в двадцать один раз превышает выбросы углекислого газа...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Итак,..., станет еще жарче?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я изо всех сил стараюсь вспомнить, что читал в брошюрах по охране окружающей среды, которые мы получали в школе.")
	await novel_interface.show_dialog("Приливы уже растут, а скорость ветра уменьшается. Температура будет повышаться... на 0,2 градуса каждые 12 часов. И еще долго не перестанет подниматься.", "Mariru")
	await novel_interface.show_dialog("Это означает, что наши океаны скоро будут лишены кислорода, что, конечно же, разрушит всю экосистему. Большинство живых существ на нашей планете будет очищено.", "Mariru")
	await novel_interface.show_text_only("Рафилия, кажется, наконец осознала, насколько серьезна ситуация.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Итак,... через две недели... все открытые растения завянут...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("А через три недели большинству животных грозит исчезновение. 90% людей останутся без питьевой воды. Даже спутники на низкой околоземной орбите больше не будут двигаться так, как должны, из-за изменений в нашей атмосфере...", "Ai")
	await novel_interface.show_dialog("В течение сорока пяти дней в такой среде выживут лишь несколько редких видов — все насекомые.", "Mariru")
	await novel_interface.show_dialog("Если мы ничего не предпримем, и причём быстро, то скоро станем пищей для этих насекомых.", "Ai")
	await novel_interface.show_text_only("Я не могу сдержать дрожь, пробегающую по моему позвоночнику, когда я смотрю на трещину, которая приведет к гибели человечества.")
	await novel_interface.show_text_only("Mariru откашливается. Все присутствующие затаили дыхание и ждут ее приказаний.")
	await novel_interface.show_dialog("Нельзя терять ни минуты. С каждой секундой трещина продолжает причинять все больший ущерб.", "Mariru")
	await novel_interface.show_dialog("Если мы будем сидеть сложа руки и ждать, пока Объединенный Конгресс пришлет свою команду экстренной помощи, будет слишком поздно.", "Mariru")
	await novel_interface.show_dialog("Кроме того, их команда экстренной помощи вряд ли знает, как справиться с чем-то подобным __ЭЛЛИПСИС__", "Mariru")
	await novel_interface.show_dialog("Итак, Генриетта...", "Mariru")
	await novel_interface.show_text_only("Мы все поворачиваемся к алхимику, который не выглядит слишком удивленным, когда его окликнул Mariru.")
	await novel_interface.show_dialog("Если это каким-то образом связано с Девятой Сфирой, которую вы должны защищать..., то сталкивались ли вы когда-нибудь с чем-то, что могло бы иметь столь серьезные последствия?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("Видите, это то, что больше всего раздражает в моей работе!", "Генриетта")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Блондинка-алхимик качает головой со слабой улыбкой, вспоминая.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Обычно Избранный просто телепортирует меня к месту происшествия и оставляет там.", "Генриетта")
	await novel_interface.show_dialog("Но если мы оставим «такие вещи» без кого-то, кто мог бы с ними разобраться, мир может просто закончиться здесь.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 г. н. э., гора Уайнапутина, недалеко от испанской колонии>", "Генриетта")
	await novel_interface.show_dialog("Я восстал против Единого и затянул свою миссию еще на пару дней. В итоге все деревни в радиусе нескольких километров оказались полностью в руинах.", "Генриетта")
	await novel_interface.show_text_only("Выражение ее лица невероятно грустно.")
	await novel_interface.show_dialog("Я все еще выполнял свою работу..., но многие умерли. Это было более шестидесяти тысяч человеческих жизней, которые я мог бы спасти.", "Генриетта")
	await novel_interface.show_dialog("Пепел вулкана оставался в атмосфере, закрывая солнечный свет от суши более года. Это были самые холодные годы за эти пару десятилетий.", "Генриетта")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Генриетта смотрит вниз, не желая продолжать.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Та катастрофа из-за вулкана в Перу в конце пятнадцатого века, да...", "Ai")
	await novel_interface.show_dialog("— Действительно, это кризис такого же масштаба.", "Mariru")
	await novel_interface.show_dialog("Чрезвычайно низкая температура, которая преследовала мир в течение следующих нескольких лет, привела к всемирному голоду и войнам. Некоторые империи в этот период даже пали.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Звучит очень серьезно...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Это была слишком тяжелая ответственность, чтобы ты мог нести ее в одиночку.", "Mariru")
	await novel_interface.show_dialog("Рен, разве ты не упомянул способы передвижения в чрезвычайно холодном климате?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ты имеешь в виду..., ты хочешь, чтобы мы поехали, проверили базу? Посмотрите, чем мы можем помочь?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Верно. Хотя я не могу точно знать, что происходит, я считаю, что единственный способ спасти ситуацию находится внутри самой базы.", "Mariru")
	await novel_interface.show_dialog("Нам нужно как минимум собрать оттуда данные...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Но мы не можем войти в эту зону, если там слишком высокий уровень метана, не так ли?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Этот «метан», о котором вы говорите..., это то «горючее вещество», которое я сейчас чувствую в воздухе?", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Хотя я не совсем понимаю, о чем она говорит, я все же киваю.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Тогда всё должно быть хорошо. Плотность горючего вещества в воздухе фактически демонстрирует нисходящую спираль.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Там? Вы имеете в виду __ЭЛЛИПСИС__", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта, должно быть, говорит о базе Снедроннинген.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Вне базы Снедроннинген>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Привет? Annie? Вы нас слышите?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Стоя перед гигантским сооружением, гордо вырисовывающимся в мире снега и льда, я ору в свою старую рацию, прикрывая ее от ветра одной рукой.")
	await novel_interface.show_dialog("Понял... сигнал хороший... \\nНадвигается метель... будьте осторожны...", "Annie")
	await novel_interface.show_text_only("Ответ Annie пронизан статикой и еще большей статикой.")
	await novel_interface.show_text_only("Mariru приказал нам поторопиться со сбором данных о погоде и как можно скорее отправить их обратно на New Opulentia.")
