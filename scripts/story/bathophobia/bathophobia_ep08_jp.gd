# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("マリルがタブレットを操作すると、\\n貯水池の底から低い開閉音が聞こえた。\\nそれに伴って水位も下がっていく。")
	await novel_interface.show_text_only("貯水池はビル4階分ほどの深さがあり、\\n岸辺はすぐに崖へと変化した。")
	await novel_interface.show_text_only("水位が下がるにつれ、崖の向こう側の台座から\\n青い石碑が姿を現す。")
	await novel_interface.show_text_only("周囲の照明設備が順々に起動する──\\n\\n石碑の輪郭『トスハイム青金石柱』が、\\nはっきりと見えてきた。")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("わぁ……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("対岸にあるのは標準的なサッカーグラウンドを\\n超えるほどの広大な空間で、\\n巨大な柱の数列が闇へと連なり伸びている。")
	await novel_interface.show_text_only("天井の照明設備の光も近くを照らせはするが、\\n\\n100メートル近くあるであろうこの空間の\\n奥深くまでは届かない。")
	await novel_interface.show_text_only("あまりにも大掛かりな建築スケールは、\\n恐怖と威圧感を人々に与えるだろう。")
	await novel_interface.show_text_only("前方の台座にある四角の指示ランプは、\\n周囲に電磁防壁がある事を教えてくれている。")
	await novel_interface.show_text_only("一筋の通路が、こちらの岸辺から奥へと\\nゆっくり伸び始めた。")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("（かっ……恰好いいッ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("とあるFPSゲームのオープニングストーリーを\\n思い出すよなコレ。")
	await novel_interface.show_text_only("俺達はマリルの後ろに付いていく。\\n\\nコンソールへ続く可変通路へと足を踏み入れた。")
	await novel_interface.show_text_only("可変通路は通常時、壁の中に収まっているのだが\\n人が歩こうと前に踏み込むたびに、\\nその分だけ壁の中から姿を現して伸びていく──")
	await novel_interface.show_text_only("この設計は容易に向こう岸へ近付いたり、\\n離れたりする事を阻止するためであろう。")
	await novel_interface.show_text_only("周囲を見渡すと、蜂の巣みたいに並ぶ\\n小型重火器の発射口に気付く。")
	await novel_interface.show_text_only("今まで歩いてきた光景を思い出しつつ、\\nこの巨大な地下施設の構造を脳内で整理する。")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("…ほんと、お金の使い方に容赦がないなぁ……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("改造するのには苦労したが、短期間で方舟計画の\\n安全基準を達成できるのはここだけだった。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルの言う「安全基準」とは、\\n強大な敵意を持つ魔女や他の何かを\\n万が一にも召喚してしまった場合──")
	await novel_interface.show_text_only("学園都市の安全を確保するため、元老院が\\nその存在を施設内で確実に制御、消滅できる…\\nという範囲である。")
	await novel_interface.show_text_only("しかし未知なる脅威に直面した際には、\\nいわゆる『基準』などは心の慰めでしかない。")
	await novel_interface.show_text_only("と、この前マリルが作戦会議でそう言っていた。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("何をボーッとしている？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そんな事を思い出しつつコンソールの前まで\\nたどり着く。\\n通路が自動に反応すると分かってはいるが、\\nこの高さではどうしても緊張してしまう。")
	await novel_interface.show_text_only("前方の台の上、\\n4つの爪のようなアームに支えられているのは、\\n俺よりも背の高い青金石柱。")
	await novel_interface.show_text_only("ネットで見た写真とその場にある実物を\\n比べれば、感じる衝撃は雲泥の差だ。")
	await novel_interface.show_text_only("半透明な碧藍色の石碑の表面に、均一な\\n太さの線で構成された図形が刻まれている。")
	await novel_interface.show_text_only("この図形達は独特の論理で並んだ文字記号\\nらしいのだが、\\n現在でも考古学者達はずっと解読が\\nできないままらしい。")
	await novel_interface.show_text_only("同心円、軸体、等値線──\\n実際に意味がある暗号の言葉というより、\\n直接的に何かの概念を伝えようとしている気が\\nする。")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("国宝級の文化財なんだよな～～これ……\\n\\n初回の実験なら何か代わりの物で\\n試してみるべきじゃ……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("あら？　臆病風に吹かれたのかしら？", "ラファエル")
	await novel_interface.show_dialog("失敗したら、どうなるか分かるわよね？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは脅しのような口調で言い放った。")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("いやいや、ただ贅沢すぎじゃないかなって……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("では、今から電磁防壁を解除する──", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルはコンソールの赤い色のレバーを\\n力を込めて倒す。\\n防衛装置についている赤い四角形のランプが、\\n同時に消灯した。")
	await novel_interface.show_text_only("俺の頭皮にビリビリとした感覚が伝わってくる。微弱な電流が脳の中を通り抜けたかのようだ。")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("どうだ？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("魔法刻印のはず、だけど……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("じっと青金石柱を見つめると、\\n何か異様な雰囲気を感じた。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("どうやらお前の身体は敏感なようだな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("ちょ、マリル、みんなの前で！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルの方を向くと\\n案の定、変態を蔑む目で俺を見ていた。")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("そんな誤解を招くような事は言わないでって！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("安全のため、もう一度お前達に電磁防壁の\\n操作方法を説明しておく。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルはラファエルとアニーにコンソールの前に\\n行くように指示すると、改めて俺の方を見る。")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（いよいよ芝居が始まるのか……）", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("この制御装置と周囲の柱には、数十種類の\\nセンサーとフルスペクトルの映像カメラがあり、\\n隔離ボックスが開いたら自動的に動き出す。", "マリル")
	await novel_interface.show_dialog("データと映像資料は直接モニタールームに送信。\\n\\n実験終了後、これらの実験データは\\nサモントンの研究施設と共有される。", "マリル")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("マリルは俺にウインクをする。")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("（本当の事かのように説明してるけど……）\\n\\n（偽造データを事前に用意しているくせに……）", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("俺は近くの柱の上にあったモニタールームを\\n見上げた。")
	await novel_interface.show_text_only("単方向の防爆ガラスに人影は映らず、\\n冷たく光を反射しているだけ。")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（元老院の人達、あそこにいるんだろうな……）", "小憐")
	await novel_interface.show_dialog("（上手く誤魔化せればいいけど……）", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("隔離ボックスと桟橋の操作方法は簡単だ。\\n\\nこっちのマスターコントローラーと\\n手回し型のハンドルを使用する。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("アニーはマリルの指示で、\\n順々にコンソールの操作方法を確認する。")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("マスターコントローラーなんて見るのは\\n久しぶりね。手回しハンドルまで……\\nなぜこのような古い制御装置を使うのかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("古き良き構造と言うのは、逆に一番安定する事も\\nあるって事だ。\\n不便さはちょっと我慢しな～～", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("では、私は指令室に戻るが、何か質問はあるか？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("（は、始まるのか……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は脈打つ鼓動が早まるのを感じ、\\n深呼吸をして調整する。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("……緊張しているのか？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の不安を見破ったように、俺を片腕で\\n後ろから抱きしめ、マリルは優しくそう告げた。")
	await novel_interface.show_text_only("マリルに積極的な行動をされた俺は、\\nどう反応すれば良いのか分からない。\\nただ、頬が燃えるかのように熱い。")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("ちょ、ちょっと……だけ……", "小憐")
	await novel_interface.show_text_only("（ドキドキが余計に早くなった！！）")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（芝居なんて、本当に苦手なんだよッ！）\\n\\n（小学生の時に『アンクル・トムの小屋』の\\n　小屋役を演じた事くらいしか……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは上のモニタールームを一瞬だけ確認し、\\nそのまま横を向いた。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("そうか……", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("彼女の呼吸で耳の根が痺れ、全身へと伝わる。\\n\\n耳の後ろから胴体を突き抜けて、1本の神経が\\nかかとの先まで続くかのように感じた。")
	novel_interface.character_light()
	await novel_interface.show_dialog("安心しろ。元老院にはしばらくここで\\n何が起こったのか見えなくなる。", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは耳打ちに近い方法で俺に告げた。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("私達の頭上20メートルのところに、\\n光学迷彩を設置している。", "マリル")
	await novel_interface.show_dialog("モニタールームのガラスも特殊な処理を施した。\\n彼らには「見せるべき」部分しか見せない……", "マリル")
	await novel_interface.show_dialog("ラファエルが防衛装置を解除した後、\\n\\nお前は異変区間に入ったかのように、\\n彼らの視界から消える。", "マリル")
	await novel_interface.show_dialog("そこからお前は青金石柱に触れてみるだけでいい\\n計画通りに魔女を呼び出せなくても大丈夫だ……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("耳元でかすかに笑うと、\\nマリルは俺の耳に息を吹きかけた。\\n再び神経が強く反応してしまう。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("ひゃうんっ！？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("だか、ヤバイ奴を召喚してしまったら……\\n\\n最悪の場合、\\nどのような事になるかは知っているな？", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("──俺は唾を飲んだ。")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("センサーが警戒値を超えると、\\n自動で封鎖と破壊プログラムが作動する……", "小憐")
	await novel_interface.show_dialog("5秒以内に俺達は右側の床にある非常口から、\\n地下の隔離エリアに入らなくてはならない。", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("俺の目線は作戦会議中に話していた\\n避難経路を追っていた。")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("より正確に言うと、\\nお前達の脱出時間は4.8秒しかない。", "マリル")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（少しでも遅れたら、瞬時に基地全体が\\n　海水に満たされる）\\n（その上で、頭上には豊富な武器システムが…）", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("だが、青金石柱に関する来歴調査によると……", "マリル")
	await novel_interface.show_dialog("昔の持ち主は、比較的落ち着いた平和主義者だ。\\n\\nほんの少し奇妙な側面があったり、\\n多くの仮名を持っていたらしいが。", "マリル")
	await novel_interface.show_dialog("ひょっとしたら召喚する人物は、\\nエロいおっさんだったりするかもしれない。", "マリル")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("もし、おっさんを召喚してしまったら──\\n\\nラファエルに任せてサモントンに\\n連れ帰ってもらおう！！")
