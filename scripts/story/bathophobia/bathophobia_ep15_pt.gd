# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-choo…", "Beth")
	await novel_interface.show_text_only("Apoiando a cabeça na mesa, a menina poderia ter cochilado se não fosse o espirro.")
	await novel_interface.show_text_only("Do lado de fora da janela do submarino está a noite polar, e ela não consegue saber as horas pela cor do céu.")
	await novel_interface.show_text_only("Beth olha para a tela e percebe que se passaram apenas algumas horas depois de seu encontro com o monstro do fundo do mar.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Estou fazendo a coisa certa?", "Beth")
	await novel_interface.show_dialog("(Usando-a para descobrir a verdade por mim mesmo...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sem perceber, Beth dá uma olhada no caderno que tem em mãos.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Se o pai estivesse aqui…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Ele nunca vacilaria por causa desse tipo de emoções.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Pensando nas mãos fortes de seu pai, Beth cerra lentamente o punho.")
	await novel_interface.show_text_only("O caderno, cheio de textos obscuros, pertenceu ao seu pai adotivo.")
	await novel_interface.show_text_only("Ele era um biólogo alto, silencioso e dedicado, rigoroso tanto com Beth quanto consigo mesmo.")
	await novel_interface.show_text_only("Por causa da habilidade especial de Beth, ele organizou treinamentos rigorosos para ela, além dos trabalhos escolares.")
	await novel_interface.show_text_only("Beth lembra que ela teve que trabalhar duro todos os dias para alcançar as metas estabelecidas por seu pai.")
	await novel_interface.show_text_only("O que ela mais esperava era um ocasional sorriso de reconhecimento em seu rosto sério.")
	await novel_interface.show_text_only("Sem muita ternura, o homem reservado vinha protegendo-a à sua maneira…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("—Como se estivesse preparando-a para algum destino inevitável…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("No seu aniversário de 12 anos, Beth recebeu um pacote anônimo. Dentro dele estava este caderno – e a notícia da morte de seu pai.")
	await novel_interface.show_text_only("Uma explosão de gás matou mais de 30 pessoas, incluindo o único membro remanescente da família de Beth no mundo.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Com os lábios trêmulos, Beth pronuncia um nome silencioso.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As pistas por trás desse nome a fizeram perceber que a morte de seu pai não foi um acidente, conforme relatado oficialmente.")
	await novel_interface.show_text_only("A garota solitária teve que enxugar as lágrimas e crescer rapidamente para sobreviver aos perigos desconhecidos.")
	await novel_interface.show_text_only("—Seu pai disse no caderno que sua habilidade especial a exporia ao perigo e a tornaria alvo da gangue.")
	await novel_interface.show_text_only("O pacote só seria enviado quando ele não pudesse mais protegê-la…")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Por que as pessoas desejariam… esse tipo de habilidade…)", "Beth")
	await novel_interface.show_dialog("(Isso não é mais uma maldição...)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth olha para a palma da mão. Várias bolas de luzes prateadas saltam sobre seus dedos.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth sabe que é diferente desde que consegue se lembrar das coisas – mas não por causa de sua habilidade especial.")
	await novel_interface.show_text_only("Ela tem uma memória eidética para números desde criança. Ela pode fazer contas mentais muito mais rápido do que os outros e está profundamente interessada em máquinas.")
	await novel_interface.show_text_only("Mas seu pai pediu que ela se mantivesse discreta e agisse como uma criança comum, para encobrir sua habilidade especial.")
	await novel_interface.show_text_only("Depois que ele morreu, Beth decidiu não se esconder mais.")
	await novel_interface.show_text_only("Um ano depois, ela foi admitida em uma universidade de prestígio com permissão especial, exceção feita pela primeira vez em anos.")
	await novel_interface.show_text_only("Ela estudou muito e leu muito, mas não conseguiu encontrar a resposta nem nos livros nem nas aulas.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Por que sou diferente…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela continuou aprendendo e pensando, como se tentasse satisfazer de uma só vez sua curiosidade há muito reprimida.")
	await novel_interface.show_text_only("Ela não percebeu que era rotulada de arrogante, indiferente e inacessível.")
	await novel_interface.show_text_only("Aos poucos, as pessoas viraram as costas para ela, mas ela não se importou.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Caso contrário, eu não teria conhecido você…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela conheceu Silvia em um acidente.")
	await novel_interface.show_text_only("Demorou apenas alguns minutos para Beth descobrir que Silvia era uma investigadora disfarçada de estudante. Sua missão era procurar Substance H ilegal no campus.")
	await novel_interface.show_text_only("Ela sabia que o nome e as experiências de Silvia poderiam ser falsos, mas ainda assim se sentia atraída por sua personalidade descuidada e alegre.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Ela é... diferente.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ela me conhece melhor do que ninguém...")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Embora ela esteja acostumada a se disfarçar para os outros…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela realmente abriu seu coração para mim sem qualquer reserva.")
	await novel_interface.show_text_only("Mas nenhum deles esperava que a amizade deles chamasse a atenção da organização por trás de Milk.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sabendo que ela era filha adotiva do famoso biólogo, o chefe de Milk a convidou para ingressar na missão antártica.")
	await novel_interface.show_dialog("(Eu pretendia recusar…)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("Em uma base subterrânea do Esquadrão.")
	await novel_interface.show_text_only("O que a fez mudar de ideia e decidir ingressar foi um símbolo no guia da missão:")
	await novel_interface.show_text_only("Um símbolo que ela viu no caderno de seu pai.")
	await novel_interface.show_text_only("Um assustador globo ocular preto representando uma organização religiosa secreta.")
	await novel_interface.show_text_only("O pai dela registrou o contato com pessoas daquela organização. Mostraram a intenção de mobilizar pessoas com capacidades especiais e criar um grupo militante.")
	await novel_interface.show_text_only("O plano foi denominado Projeto Ningen.")
	await novel_interface.show_text_only("Depois que os documentos de seu orfanato caíram em suas mãos, Beth estava no topo da lista de procurados do Projeto Ningen.")
	await novel_interface.show_text_only("Como resultado, seu pai tornou-se alvo desta perigosa organização.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen… a Antártica.)", "Beth")
	await novel_interface.show_dialog("(A Base Rainha da Neve na Antártida…) \\n(O nome vem de uma história dos Contos de Fadas de Andersen.)", "Beth")
	await novel_interface.show_dialog("Em dinamarquês é Snedronningen \\nOu Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(Não é uma coincidência.)", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Então seu chefe e sua turma estão perseguindo a mesma coisa…", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Pela sua cara… essa gangue parece ser mais durona do que outras na Lista Negra…", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth acena com a cabeça, mas ela não quer falar mais.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Desculpe. Entrei nesta missão por motivos egoístas.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Bem, eu sei disso.", "Milk")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Mas Boss só quer que você continue a pesquisa de seu pai sobre a vida marinha.", "Milk")
	await novel_interface.show_dialog("Portanto, é uma situação em que todos ganham.", "Milk")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Quanto aos seus motivos egoístas… sei que você está tão encantado por mim que decide ficar aqui.", "Milk")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Oh, isso é muita pressão para mim!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk disse e mandou um beijo para Bai Yan, o que fez Bai Zhu sorrir.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O que ela não percebe é uma tristeza fugaz nos olhos claros da amiga.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Ela ainda se sente culpada ao pensar no momento em que assinou a papelada.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Eu estava... usando ela.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth se senta à mesa, pega uma caneta e olha para o caderno aberto.")
	await novel_interface.show_text_only("Valiosos são os úteis.")
	await novel_interface.show_text_only("—Ela anota seu pensamento.")
	await novel_interface.show_text_only("Você me disse isso… E eu sempre concordei com você…")
	await novel_interface.show_text_only("Use os outros ou seja usado sem escrúpulos \\n“Isso é algo que você dá como certo…”")
	await novel_interface.show_text_only("Depende apenas de quem tem um valor maior.")
	await novel_interface.show_text_only("Não há necessidade de explicar. Concentre-se apenas no seu objetivo.")
	await novel_interface.show_text_only("Somente um relacionamento tão simples pode mantê-lo protegido da maioria das pessoas.")
	await novel_interface.show_text_only("Beth faz uma pausa.")
	await novel_interface.show_text_only("Mas você também me disse que ainda existem...")
	await novel_interface.show_text_only("Alguém que quer ser usado por você, não importa o que aconteça. \\n\"E alguém que você não deseja usar em nenhuma circunstância.\"")
	await novel_interface.show_text_only("Pensando nisso, um leve sorriso aparece em seus lábios.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Culpa? É um sentimento que deve ser descartado.)", "Beth")
	await novel_interface.show_dialog("(Então é... carinho?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth fecha seu diário.")
	await novel_interface.show_text_only("Agora ela encontrou sua resposta.")
	await novel_interface.show_text_only("Ela olha pela janela e descobre que o céu azul escuro fica cada vez mais profundo, quase se fundindo com o mar infinito.")
	await novel_interface.show_text_only("De repente, um alarme de emergência dispara em toda a embarcação.")
	await novel_interface.show_text_only("Atenção, toda tripulação. Diretiva alterada. Apresente-se na sala de reuniões em dez minutos.")
	await novel_interface.show_text_only("Repita. Diretiva alterada…")
	await novel_interface.show_text_only("Beth respira fundo, guarda o caderno e sai correndo da sala.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
