# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("El terremoto en el Polo Sur no dura mucho. La capa vacía debajo de la estación de suministro, establecida como medida de precaución contra las tormentas de nieve, reduce efectivamente los daños causados ​​por los temblores.")
	await novel_interface.show_text_only("En menos de un minuto, la tierra vuelve a su estado de calma anterior.")
	await novel_interface.show_text_only("Crecí en las fronteras de Aegis; un terremoto de este tamaño no me molesta en lo más mínimo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sólo un pequeño terremoto. ¿Todos bien?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Sí... pero ¿por qué sostenerte la falda fue tu primera reacción?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("¿Estás seguro de que esa debería ser tu prioridad en un terremoto?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, bueno... \\nEs solo...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¡Vamos, dame un respiro!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Aun así, es extraño. La Antártida es un continente cubierto de capa tras capa de hielo espeso. Seguramente no es una zona propensa a terremotos.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael frunce el ceño y mira fijamente por la ventana.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿O lo recordé mal?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Así que el Noveno Sephira finalmente ha causado un problema, ¿eh?...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("¡Ren, mira!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie grita de repente, señalando fuera de la ventana. Me inclino más para echar un vistazo.")
	await novel_interface.show_text_only("Ha aparecido una grieta gigantesca en la capa plana de hielo. Bajo el cielo aterciopelado, parece casi un abismo que conduce directamente al infierno.")
	await novel_interface.show_text_only("En cierto sentido, es menos una grieta y más como un cañón...")
	await novel_interface.show_text_only("En el borde de la brecha, se erigen algunas púas afiladas. Estructuras anormales en forma de red emergen de las profundidades de la gruesa capa de hielo.")
	await novel_interface.show_text_only("Los acantilados de hielo a ambos lados parecen permanecer aproximadamente a la misma altura. Es como si una fuerza inimaginable hubiera destrozado toda la plataforma de hielo.")
	await novel_interface.show_text_only("La enorme grieta serpentea hacia las tierras altas, desapareciendo de la vista...")
	await novel_interface.show_text_only("Por suerte estamos aquí en el valle. Estamos a salvo aquí.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Oye, ¿qué es eso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael y Henriette se acercan para ver lo que estoy señalando. Ambos jadean.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Ese edificio... ¿por qué no está afectado?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En las llanuras de hielo, justo delante de nosotros, una enorme estructura hecha por el hombre se alza, completamente tranquila, justo en el camino de la grieta que se está extendiendo.")
	await novel_interface.show_text_only("Sus paredes oscuras parecen fuera de lugar en esta tierra blanca y pálida.")
	await novel_interface.show_text_only("En lugar de destrozar el edificio como debería haberlo hecho, la grieta lo circunnavegó en forma de dos arcos, como si hubiera algo en la estructura que no quisiera perturbar.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¿Es ese el punto de encuentro Mariru que acaba de mencionar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Parece ser el lugar correcto.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se puede escuchar estática crepitante desde el panel de control. Parece que la estación de suministro está restableciendo la conexión con el mundo exterior.")
	await novel_interface.show_dialog("Hola? ¿Ren? ¿Puedes oírme?", "Mariru")
	await novel_interface.show_text_only("Mariru suena un poco nervioso.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Antes de que el grupo de satélites de reconocimiento que hemos convocado termine de cambiar de trayectoria, la transmisión gráfica de la Antártida sólo puede actualizarse una vez cada treinta y cinco minutos en forma estática.")
	await novel_interface.show_text_only("En la pantalla, siguen apareciendo mensajes que contienen información que Mariru ha recopilado de las principales estaciones polares.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Algo anda mal. Este terremoto... no es normal.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Qué extraño, todavía no puedo recibir señal de los chicos de la base Snedronningen...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru entrecierra los ojos ante el informe actualizado más reciente del sensor meteorológico en la Base de Nuremberg.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Espera, ¿eso es...?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru teclea frenéticamente en su dispositivo de mano, recuperando todos los datos de monitoreo meteorológico e hidrológico en tiempo real en la Antártida que puede encontrar.")
	await novel_interface.show_text_only("Es fácil ver que las cifras están cambiando de forma rápida y constante. De repente recuerda un curso que tomó en la universidad...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Dime, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Mmmm?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Incluso sin considerar el impacto de las armas nucleares y los objetos extraños, todavía hay muchos factores naturales acechando en la Tierra que pueden causar \"el fin del mundo\".", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Por supuesto. De hecho, los humanos aparecieron sólo después de la quinta extinción masiva en la Tierra. Los factores naturales pueden ser realmente letales.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("Y cuando se trata del elemento natural más peligroso que se puede encontrar en la Antártida...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("¡Maldita sea..., es metano!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, ¿estás seguro de que la grieta está cerca de tu ubicación?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sí. Pero lo extraño es que...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le informé a Lililiu que la grieta parecía estar evitando deliberadamente la base de la Reina Blanca.")
	await novel_interface.show_text_only("Mariru reflexiona un poco sobre esta información. La próxima vez que habla, su tono es nítido y serio.")
	await novel_interface.show_dialog("Escuche, es probable que el metano que ha estado sellado bajo tierra durante millones de años se esté escapando actualmente de la grieta.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Espera... como, sí, sé que miles de millones de toneladas de metano se almacenan bajo tierra aquí, pero... ¿no son sólidos? ¿Te gusta el hielo inflamable?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Es posible que se hayan vaporizado debido a la presión causada por la rotura de la plataforma de hielo durante el terremoto. Al menos los expuestos probablemente lo habían hecho.", "Ai")
	await novel_interface.show_dialog("Según los sensores de la base de Nuremberg, los niveles de metano sobre la Antártida han aumentado 2,1 ppm en comparación con hace una hora, antes del terremoto.", "Mariru")
	await novel_interface.show_dialog("Las cifras difieren entre otras estaciones meteorológicas, pero los resultados son los mismos: hay un aumento dramático en el nivel de metano allí, no importa cómo se mire.", "Mariru")
	await novel_interface.show_dialog("El área del océano cerca de la plataforma de hielo Amery también ha mostrado anomalías. Creemos que se debe a que el gas metano del fondo del océano ha burbujeado, provocando una alteración en las mareas.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Si no recuerdo mal, el efecto invernadero que provoca el metano es veintiún veces mayor que el del dióxido de carbono...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Entonces... ¿Hará más calor?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hago lo mejor que puedo para recordar lo que leí en esos folletos sobre preservación del medio ambiente que recibimos en la escuela.")
	await novel_interface.show_dialog("Las mareas ya están subiendo, mientras que la velocidad del viento disminuye. La temperatura aumentará... 0,2 grados cada 12 horas. Y no dejará de subir por bastante tiempo.", "Mariru")
	await novel_interface.show_dialog("Esto significa que nuestros océanos pronto se verán privados de oxígeno, lo que, por supuesto, arruinará todo el ecosistema. La mayoría de los seres vivos de nuestro planeta serán purgados.", "Mariru")
	await novel_interface.show_text_only("Raphael finalmente parece darse cuenta de cuán grave es realmente la situación.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Entonces... en dos semanas... todas las plantas expuestas se marchitarán...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Y en tres semanas, la mayoría de los animales se enfrentarán a la extinción. El 90% de los seres humanos no tendrá agua potable. Incluso los satélites en órbita terrestre baja ya no se moverán como deberían debido al cambio en nuestra atmósfera...", "Ai")
	await novel_interface.show_dialog("En cuarenta y cinco días, sólo unas pocas especies (insectos, todas ellas) sobrevivirán en un entorno así.", "Mariru")
	await novel_interface.show_dialog("Si no hacemos algo y rápido, pronto nos convertiremos en alimento para esos insectos.", "Ai")
	await novel_interface.show_text_only("No puedo evitar el escalofrío que recorre mi espalda mientras miro la grieta que conducirá a la perdición de la humanidad.")
	await novel_interface.show_text_only("Mariru se aclara la garganta. Todos los presentes contienen la respiración y esperan sus órdenes.")
	await novel_interface.show_dialog("No hay un minuto que perder. Cada segundo que pasa, la grieta sigue causando más daños.", "Mariru")
	await novel_interface.show_dialog("Si nos sentamos y esperamos a que el Congreso Unido envíe su equipo de emergencia, será demasiado tarde.", "Mariru")
	await novel_interface.show_dialog("Además, no es como si su equipo de emergencia supiera cómo lidiar con algo como esto...", "Mariru")
	await novel_interface.show_dialog("Entonces, Henriette...", "Mariru")
	await novel_interface.show_text_only("Todos nos volvemos hacia el alquimista, quien no parece demasiado sorprendido de haber sido llamado por Mariru.")
	await novel_interface.show_dialog("Si esto está de alguna manera relacionado con el Noveno Sephira que se supone que debes proteger..., ¿alguna vez te has encontrado con algo que podría tener repercusiones tan serias como esto?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("¡Mira, eso es lo más molesto de mi trabajo!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La alquimista rubia sacude la cabeza con una pálida sonrisa mientras recuerda.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Por lo general, The One simplemente me teletransporta al lugar del incidente y me deja allí.", "Henriette")
	await novel_interface.show_dialog("Pero si dejamos “ese tipo de cosas” ahí fuera sin que alguien se ocupe de ellas, el mundo bien podría terminar aquí.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 d.C., Monte Huaynaputina, cerca de la colonia española>", "Henriette")
	await novel_interface.show_dialog("Me estaba rebelando contra El Único y alargué mi misión por un par de días más. Al final, todas las aldeas en un radio de unos pocos kilómetros quedaron completamente en ruinas.", "Henriette")
	await novel_interface.show_text_only("Su expresión es increíblemente triste.")
	await novel_interface.show_dialog("Seguí haciendo mi trabajo... pero muchos murieron. Eran más de sesenta mil vidas humanas que podría haber salvado.", "Henriette")
	await novel_interface.show_dialog("Las cenizas del volcán permanecieron en la atmósfera, bloqueando la luz del sol desde la tierra durante más de un año. Fueron los años más fríos de esas dos décadas.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette mira hacia abajo, sin querer continuar.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Ese desastre volcánico en el Perú a finales del siglo XV, eh...", "Ai")
	await novel_interface.show_dialog("—Ésta es una crisis de la misma magnitud, en efecto.", "Mariru")
	await novel_interface.show_dialog("La temperatura extremadamente baja que azotó al mundo durante los años siguientes provocó hambrunas y guerras en todo el mundo. Algunos imperios incluso cayeron durante ese período.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Suena muy serio...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Era una responsabilidad demasiado pesada para que usted pudiera soportarla sola.", "Mariru")
	await novel_interface.show_dialog("Ren, ¿no mencionaste métodos de viaje en climas extremadamente fríos?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("¿Te refieres a... a la que quieres que viajemos y revisemos la base? ¿Ves lo que podemos hacer para ayudar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Correcto. Si bien no puedo estar seguro de qué está pasando exactamente, creo que la única forma de salvar la situación está dentro de la propia base.", "Mariru")
	await novel_interface.show_dialog("Necesitamos al menos recopilar datos desde allí...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Pero no podemos entrar en esa zona si el nivel de metano es demasiado alto, ¿verdad?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Este “metano” del que hablas... ¿es la “sustancia combustible” que siento actualmente en el aire?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aunque no estoy del todo seguro de qué está hablando, aun así asiento.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Entonces debería estar bien. De hecho, la densidad de la sustancia combustible en el aire muestra una espiral descendente.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("¿Por allá? Te refieres a...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette debe estar hablando de la base Snedronningen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Fuera de la base de Snedronningen>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Hola? Annie? ¿Puedes oírnos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De pie frente a la gigantesca estructura, que se alza orgullosa en un mundo de nieve y hielo, grito por mi viejo walkie-talkie, protegiéndolo del viento con una mano.")
	await novel_interface.show_dialog("Entendido... la señal está bien... \\nSe acerca una tormenta de nieve... ten cuidado...", "Annie")
	await novel_interface.show_text_only("La respuesta de Annie está plagada de estática y más estática.")
	await novel_interface.show_text_only("Mariru nos ha ordenado que nos apresuremos con la recopilación de datos meteorológicos y los enviemos de vuelta a New Opulentia lo antes posible.")
	await novel_interface.show_text_only("Mientras tanto, teniendo en cuenta lo que nos dijo Henriette, algo anda mal con esta base. Realmente destaca de su entorno.")
	await novel_interface.show_text_only("No lo disfruté exactamente, pero aun así me aventuré hacia la base gigantesca junto a Raphael y Henriette, sujetándome la falda bajo el viento furioso mientras avancé.")
	await novel_interface.show_text_only("Annie se queda atrás, manteniendo la comunicación entre nosotros y Mariru con nuestros antiguos walkie-talkies.")
	await novel_interface.show_text_only("Mientras avanzábamos, pudimos ver por nuestro cromatógrafo de gases que efectivamente había una cantidad alarmante de gas metano en el aire.")
	await novel_interface.show_text_only("Estaba a punto de desmayarme cuando Raphael me agarró la mano.")
	await novel_interface.show_text_only("No sólo rico y elegante, sino también cálido y relajante. Su presencia fue lo único que me mantuvo adelante.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("No te pongas arrogante, solo te estoy ayudando porque prometí a Mariru que lo haría.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... No es que yo mismo haya pedido esto, ¿vale?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Inmediatamente cerré la boca después de replicar, no queriendo tragar bocados de nieve.")
	await novel_interface.show_text_only("Si no fuera por el efecto de calentamiento del Fire Jade, ya me habría convertido en una paleta humana.")
	await novel_interface.show_text_only("Aún así, en general, la base parece mucho más avanzada que las estaciones de suministro en las que hemos estado anteriormente.")
	await novel_interface.show_text_only("Cruzamos la pista de aterrizaje de aviones y llegamos frente a un monumento de piedra.")
	await novel_interface.show_text_only("En él se incrusta una caja de muestras. A su alrededor está escrito el nombre de la base, Snedronningen, con motivos florales.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... espera, ¿cómo se pronuncia eso?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Es finlandés. Snedronningen, idiota.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Esta base con un nombre que no puedo pronunciar ya parece asombrosamente grande desde fuera, y es sólo la punta del iceberg. La mayor parte de la estructura ni siquiera es visible desde arriba.")
	await novel_interface.show_text_only("Me pregunto cuánto dinero se invirtió en construir una estructura tan impresionante, nada menos que en la Antártida.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("¡Vamos!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette avanza rápidamente, antes de que pueda reaccionar.")
	await novel_interface.show_text_only("La alquimista coloca su mano sobre la cerradura eléctrica junto a la puerta. En lugar de dejar que escanee su palma, simplemente arranca todo, marco y todo, de la pared.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(¿Qué clase de monstruo es ella?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
	await novel_interface.show_text_only("Una vez solucionado el problema de la cerradura, los cables que sujetan la barrera comienzan a moverse, pequeños engranajes zumban y finalmente revelan la entrada.")
	await novel_interface.show_text_only("Nos asomamos y vemos una escalera que conduce hacia abajo.")
	await novel_interface.show_dialog("... Entonces ¿simplemente entramos? ¿Sin informar a nadie?", "Lian")
	await novel_interface.show_text_only("No puedo evitar volverme para mirar boquiabierto el enorme agujero que dejamos en la pared.")
	await novel_interface.show_text_only("Hicimos un maldito agujero en la pared, pero nadie apareció para gritarnos. Mmm.")
	await novel_interface.show_dialog("Simplemente... entremos.", "Lian")
	await novel_interface.show_text_only("Veo un casquillo de bala en el suelo junto al pasillo.")
	await novel_interface.show_text_only("Eso no puede ser una buena señal...")
	print("=== 深海恐惧症篇第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
