# bathophobia_ep19.gd - 深海恐惧症篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep19_script()

func play_script():
	pass

func bathophobia_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("We follow the stairs downward and end up in an exhibition room.")
	await novel_interface.show_text_only("Surprisingly, the power and ventilation systems still seem to be working all right. The air quality here seems fine.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("It’s such a big building... but why does it feel so empty?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Everything seems to be running just fine though...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The exhibitions are lit in an eerie glow. The sound of ventilation fans working can be heard from a distance.")
	await novel_interface.show_text_only("It’s dark, dark enough to conceal any potential predators, hiding in the corners, watching our every move...")
	await novel_interface.show_text_only("We observe our surroundings carefully before finally directing our attention to the exhibit items.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Are these... specimens?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("An exhibit in the transparent case, supported by an organic glass rack, catches my eye. It resembles some kind of marine animal.")
	await novel_interface.show_text_only("It’s got a slippery, shiny body in a translucent white color. The tail is sleek as well. It looks like the kind of animal that could only survive in the depths of the ocean.")
	await novel_interface.show_text_only("If its back looks like this, I wonder how it looks from the front...")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I wander over to the other side to take a look, and gasp in surprise and disgust.")
	await novel_interface.show_text_only("The creature has eight thick, unbecoming claws, each with two joints, much like human fingers.")
	await novel_interface.show_text_only("And on its palms are what look like little mouths that contain miniscule, barbed teeth. In the place of lips is red, muscly tissue.")
	await novel_interface.show_text_only("Reminds me of those aliens that latch onto your face and never let go, the kind you see in B-grade horror movies.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Why would something like this be on exhibit...?", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Is this some kind of movie prop?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("No. This is a specimen of a real, existing creature.", "Raphael")
	await novel_interface.show_dialog("It was the result of a failed genetic experiment during the war. I’ve seen a lot of those in the Salmonton Research Institute.", "Raphael")
	await novel_interface.show_dialog("They were later proven to be worthless and abandoned after a while.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Still, people usually treat them as biological waste...", "Raphael")
	await novel_interface.show_dialog("It’s rare to see something like this on display, as if it were a piece of artwork.", "Raphael")
	novel_interface.change_2nd_expression("jeer")
	await novel_interface.show_dialog("The owner of this facility must be a creep. Even bigger of a creep than you!", "Raphael")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I’m not a creep! Geez!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Anyway, this thing really does look a bit... you know... disturbing.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("And what’s worse, there’s no one here.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("It’s like a whole empty city. You can tell that some corners are getting rusty from disuse.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("Hey! Watch your step!", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Huh?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I trip on a cartridge and fall forward in the direction of the display case. Right as I’m about to hit my head on the sharp corner—")
	await novel_interface.show_text_only("Raphael steps forward and pulls me back in time.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("What a klutz...", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	await novel_interface.show_dialog("Whew! That was close!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Thanks, Raphael.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I open my eyes to find myself in Raphael’s arms, as if we were performing a ballroom dance. I have to admit she looks... nice, like this. Total boyfriend material.")
	await novel_interface.show_text_only("Raphael coughs awkwardly, releasing me from her grasp.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("We leave the exhibition room to find a corridor, with its ground covered by metal boards.")
	await novel_interface.show_text_only("The lights are significantly brighter here. The atmosphere is also significantly more eerie. Too quiet. I don’t like it.")
	await novel_interface.show_text_only("Still, the white noise of machines running can be heard. Which means—")
	await novel_interface.show_text_only("This base is not, well, completely dead.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("If someone’s still around to man the machines, shouldn’t they have already come out to greet us?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","smile",0.25)
	await novel_interface.show_dialog("Or, if they’re not the friendly type, they could have launched attack already, too.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Suddenly I noticed a light spot moving in the darkness. After a closer look, I discovered that it was a surveillance camera not far away that was turned toward us.")
	await novel_interface.show_text_only("I wave at it.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Uh, excuse me...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("You look so girly doing this.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael comments.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Come on, whoever’s in there, can’t you just come out and talk to us?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Still, I don’t feel like someone’s watching us...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Perhaps the surveillance camera had turned towards us because it sensed our footsteps? Perhaps no one’s controlling it?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sound-activated devices hasn’t been in use since decades ago, though. Too weak. Even a tiny ultrasonic generator could paralyze them.")
	await novel_interface.show_text_only("The surveillance camera is still running—yet it doesn’t seem like someone’s manning it.")
	await novel_interface.show_text_only("I’m kind of disappointed, and decide to spook poor Raphael a bit. In a pretentious, sinister tone, I tell her:")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("See, you might not believe me, but actually...", "Lian")
	await novel_interface.show_dialog("I can see dead people...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("You... you mean there are ghosts here?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael screeches in an uncharacteristically high-pitched voice.")
	await novel_interface.show_text_only("She then realizes that I’m just clowning and dashes over to whack me on the head.")
	await novel_interface.show_text_only("In attempt to back away, I fall to the ground, my Fire Jade rolling out of my shirt.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Raphael, I didn’t mean to—ah... achoo!\\nSorry, I didn’t know you were such a scaredy cat...", "Lian")
	await novel_interface.show_dialog("Ugh, so cold...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hmph!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael calms down somewhat when she sees me huddled on the ground, trembling from the cold without the jade’s protection.")
	await novel_interface.show_text_only("Why is it so cold even though we’re indoors...?")
	await novel_interface.show_text_only("I hurry to pick up my Fire Jade.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Isn’t this a bit too cold? How do the people in the base even live like this?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observing carefully, I found that many places in the corners of the wall were already frozen...")
	await novel_interface.show_text_only("It reminds me vaguely of a game about survival in the ice and snow...")
	await novel_interface.show_text_only("That game was about producing resources or something. And it had a pretty bizarre ending.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Wait...)", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette places her palm on the wall once again.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hey, d-don’t wreck that wall too...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She’s the kind of person who’d totally yank out a whole pillar if she weren’t being careful.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Something doesn’t feel right.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blonde alchemist frowns, face solemn.")
	await novel_interface.show_text_only("A ripple of air seems to be flowing in all directions, starting from where her palm is pressed down.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("... We’re trapped.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Eh?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I sprint to the end of the corridor. The door to the exhibition room isn’t locked. Nah, we’re fine. Totally not trapped.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Stop scaring me, geez...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("One hand over my heart, I stalk off towards the archive room we just passed by. The door is open.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room.png")
	await novel_interface.show_text_only("The room is brightly lit, feels much cozier than the corridor.")
	await novel_interface.show_text_only("Too busy looking around, I nearly trip over a crack in the floor tiles.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Watch your step, klutz.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael stands in the doorway of the archive room, keeping an eye on me on one hand, and watching over Henriette on another. The alchemist still seems to be puzzling over the corridor wall.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Wait. Why do I feel a draft in this room?", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Could it be...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I take out my Fire Jade and place it on the table, so that I can better feel the temperature in the room.")
	await novel_interface.show_text_only("Sure enough, the temperature here is much higher than in the frigid corridor. There’s heating—so warm it’s hard to believe we’re in Antarctica.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Eh…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wait. Back when we passed by this room, I remember glancing at the shelf.\\nSomething looks different...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Or is it just my memory playing tricks on me?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Scratching my head, I walk towards the door.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Watch your feet.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Gotcha. I almost tripped over that gigantic crack on the ground just now. I won’t make the same mistake again—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I say, gesturing towards the floor to make my point clear. But wait...")
	await novel_interface.show_text_only("There is no crack. The tiles are all intact.")
	await novel_interface.show_text_only("Smooth, sleek, marble tiles. Almost like a mirror. It even reflects my blue-and-white panties—")
	await novel_interface.show_text_only("Oops. I immediately close my legs.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Something really isn’t right.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("... Anything wrong, Ren?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("What are you doing there?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("There was a crack right here just now. But it’s gone...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I couldn’t have remembered wrong, because I almost tripped over it.")
	await novel_interface.show_text_only("The ground, where there should have been a crack...")
	await novel_interface.show_text_only("The archive room, the only place that’s heated...")
	await novel_interface.show_text_only("The shelf, on which the objects seem to have changed order...")
	await novel_interface.show_text_only("I can feel my heart thumping madly in my chest.")
	await novel_interface.show_text_only("Cautiously, I take a step forward.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hey, what do you mean by connecting in the cracks? Do you still want me to help you...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael sounds annoyed. She’s definitely not kidding around—she really does see a crack on the floor.")
	await novel_interface.show_text_only("But as far as I can see (and feel), there’s no crack.")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("... Something’s not right. What you see and what I see... they’re different.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("How could that be...?")
	await novel_interface.show_text_only("Unnerved, I grab my walkie-talkie in an attempt to contact Annie or Mariru. That would at least give me a semblance of security.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hello? Annie? You there?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("There’s no reply. We’re underground after all, the signal probably doesn’t reach that far.")
	await novel_interface.show_text_only("Noticing the confusion on my face, Raphael and Henriette enter the archive room as well.")
	await novel_interface.show_text_only("The archive room that looks completely different from the one we just passed by.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Feels like I’m dreaming, but I know I’m not.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("This room, and the one we passed... they’re not the same room.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, we hear weird, disturbing clacking sounds, coming from the corridor outside.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Who’s there?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianContact.png")
	await novel_interface.show_text_only("Raphael and Henriette get into battle mode right away.")
	await novel_interface.show_text_only("Right behind me comes running a whole horde of enemies with sinister looks on their faces and blades in their hands.")
	await novel_interface.show_text_only("There is nothing in their eyes except pure hostility.")
	await novel_interface.show_text_only("I grip my baseball bat tight...")
	print("=== 深海恐惧症篇第19话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
