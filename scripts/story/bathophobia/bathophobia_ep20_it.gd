# bathophobia_ep20.gd - 深海恐惧症篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep20_script()

func play_script():
	pass

func bathophobia_ep20_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("La squadra continua a schivare gli attacchi dei nemici frenetici e non identificabili e invia una chiamata di soccorso dopo l'altra.")
	await novel_interface.show_text_only("Altri nemici si stanno riversando dall'ingresso della base. La squadra si congratula con se stessa per non essersi ritirata fuori nella violenta bufera di neve.")
	await novel_interface.show_text_only("Di certo non possono affrontare questi nemici straordinariamente agili fuori nella neve, senza ostacoli dietro cui nascondersi.")
	await novel_interface.show_text_only("Tuttavia, questo non lascia loro altra scelta se non quella di spostarsi più in profondità nella base, cercando una posizione strategicamente vantaggiosa per chiedere supporto.")
	await novel_interface.show_text_only("Sono costretti sempre più all’interno, fuori dalla sala espositiva, in un corridoio.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_dialog("Fa schifo. Non c'è segnale qui.","Membro della squadra C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Ragazzi, andate prima nella sala comunicazioni. Potresti trovare alcuni dispositivi di trasmissione funzionanti lì.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Capito!","Membro della squadra C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Ho controllato la mappa del layout 3D di questo posto. La nostra migliore linea d'azione in questo momento è dirigerci... \\n... verso il basso, in direzione delle ore otto.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tutti i membri della squadra sono feriti con diversi gradi di gravità. Ma continuano comunque, fornendosi copertura a vicenda sotto forma di due gruppi, uno in testa e uno in coda.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(Questi ragazzi... guariscono così rapidamente. Semplicemente non mi sembra giusto... )","Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","shock",0.25)
	await novel_interface.show_dialog("Attenzione!","Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth si allontana solo per una frazione di secondo, ed è in quel momento che i nemici che la inseguono da dietro girano improvvisamente le loro articolazioni, enormi lame tagliano l'aria con un'angolazione bizzarra.")
	await novel_interface.show_text_only("Colto di sorpresa, Milk spinge Beth nell'archivio dietro di lei.")
	await novel_interface.show_text_only("Evitano con successo la lama oscillante, anche se lascia comunque una gigantesca crepa sulle piastrelle del terreno.")
	await novel_interface.show_text_only("La fessura non è troppo ampia, ma comunque abbastanza ampia da separare i due gruppi. Potrebbe anche essere un canyon senza fondo.")
	await novel_interface.show_dialog("Ah!","Membro della squadra D")
	await novel_interface.show_text_only("Un membro della squadra, nome in codice Mute, sembra essere il più vicino al nemico e brandisce l'enorme lama. Nel disperato tentativo di proteggere i suoi membri, avanza, lasciando che la lama trafigga il suo corpo ancora e ancora.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("... Muto!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Muto, sempre così spensierato, che adora le camicie hawaiane. Ogni volta che Milk avvia uno dei suoi pool di scommesse, Mute è quell'idiota che finisce per perdere soldi.")
	await novel_interface.show_text_only("È passato molto tempo dall'ultima volta che Milk ricorda di aver chiamato Mute per l'ultima volta con il suo nome in codice. Non si sarebbe mai aspettata di trovarsi in una situazione del genere.")
	await novel_interface.show_text_only("Il suo sangue appena versato dipinge di rosso le pareti del corridoio.")
	await novel_interface.show_text_only("L’MP5K modificato di Mute cade a terra, slitta un po’, fermandosi infine accanto ai piedi di Milk.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Maledizione!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il fucile mitragliatore modificato di Milk ha un rinculo ridotto, permettendole di impugnarlo e sparare un'intera pioggia di proiettili con una sola mano.")
	await novel_interface.show_text_only("Tira fuori un pugnale, inchiodando il suo bersaglio, il cui corpo è crivellato di fori di proiettile e ricoperto di un liquido verde grossolano, sul muro vicino al collo.")
	await novel_interface.show_text_only("Mentre gli altri membri della squadra intervengono con i loro scudi antisommossa per respingere i nemici, Milk reindirizza la sua attenzione al suo compagno di squadra caduto, premendo sulla ferita che le decora il collo.")
	await novel_interface.show_text_only("La temperatura qui è così bassa che il sangue che sgorga dall’aorta di Mute frizza come acqua bollente.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Dov’è il kit di pronto soccorso? Prendi lo spray blocca-sangue!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Haah... ah...","Membro della squadra D")
	await novel_interface.show_text_only("Nel profondo, sanno che probabilmente è impossibile salvarla. But they still try.")
	await novel_interface.show_text_only("Lo spray emostatico si mescolò al sangue, facendo diventare rapidamente rosso il cotone emostatico sulla ferita e scivolando a terra lungo la mano di Milk.")
	await novel_interface.show_text_only("Nel frattempo, sempre più nemici si stanno radunando fuori nel corridoio, attratti dal trambusto.")
	await novel_interface.show_text_only("Gli scudi antisommossa che li trattengono sono stati colpiti così tante volte che si stanno già rompendo.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Uffa...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tre membri della squadra si avvicinano per aiutare, aprendo il fuoco per fornire copertura mentre Milk tenta di trascinare il suo compagno di squadra caduto nella stanza dell'archivio all'angolo più avanti.")
	await novel_interface.show_text_only("Mentre se ne vanno, lasciano una lunga scia di sangue sul pavimento freddo e lucido del corridoio.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Dark.png")
	await novel_interface.show_text_only("Dopo aver finalmente fatto entrare Muto nella stanza, Milk le controlla il polso con le dita.") #换行问题
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Abbiamo bisogno di un po' di adrenalina qui!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth si precipita, strappa la camicia intrisa di sangue di Muto, valuta la posizione migliore sul lato sinistro del suo petto e, con un movimento rapido, infila la penna dell'adrenalina.")
	await novel_interface.show_text_only("Lo scatto tempestivo riporta sollievo e un accenno di colore sul viso di Mute, ma solo per pochi secondi.")
	await novel_interface.show_dialog("*tosse*\\n*ansimante*","Membro della squadra D")
	await novel_interface.show_text_only("Tuttavia, dopo pochi secondi, il tasso di perdita di sangue ha superato di gran lunga il limite che il corpo può sopportare.")
	await novel_interface.show_text_only("Il colore abbandona ancora una volta il volto di Mute. Le sue pupille si dilatano.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("…","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le lacrime sgorgano negli occhi di Milk.")
	await novel_interface.show_text_only("Beth posa una mano su quella di Milk, che è ancora saldamente premuta sulla ferita del suo compagno di squadra. Si scambiano uno sguardo silenzioso che dice molte parole.")
	await novel_interface.show_dialog("Non possiamo trattenerli più a lungo! Dobbiamo ritirarci!","Membro della squadra C")
	novel_interface.show_character("baizhu_break","speechless")
	await novel_interface.show_dialog("Latte!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk stringe i denti e raccoglie la scatola dei campioni che Mute aveva rischiato la vita per recuperare nell'archivio.")
	await novel_interface.show_text_only("The squad is already outnumbered as it is. Con uno in meno, gli altri sono in guai ancora più grandi.")
	await novel_interface.show_text_only("Nessuno vuole ammetterlo, ma questa è la realtà che stanno affrontando adesso.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Prenderemo quel passaggio laggiù. Ritirarsi!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Io mi occuperò della retroguardia.","Membro della squadra B")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BTB.png")
	await novel_interface.show_text_only("Le ragazze stanno una contro l'altra, con gli occhi attenti.")
	await novel_interface.show_text_only("Milk stringe forte la pistola, facendo del suo meglio per tenere coperto il resto della squadra.")
	await novel_interface.show_dialog("(Come... è successo... ?)","Beth")
	await novel_interface.show_text_only("Secondo le indagini di Beth, “Ningen” non aveva inviato altro che una normale squadra di esploratori in Antartide.")
	await novel_interface.show_text_only("Tuttavia, i nemici che vedono... non sono una normale squadra di ricognizione.")
	await novel_interface.show_dialog("(È stata colpa mia se non l'ho previsto?)","Beth")
	await novel_interface.show_dialog("(Ma lo avevo previsto, vero?)","Beth")
	await novel_interface.show_dialog("(Lo sapevo da sempre... )\\n(Sapevo da sempre che li sto semplicemente usando ed è pericoloso... )","Beth")
	await novel_interface.show_dialog("(Eppure lascio ancora che ciò accada...)","Beth")
	await novel_interface.show_text_only("Notando l'esitazione di Beth, Milk le mette le spalle alle spalle.")
	await novel_interface.show_text_only("Il latte è avvolto in strati spessi, quindi non è che possano sentire il calore corporeo dell'altro. Yet, somehow, Beth still feel comforted.")
	await novel_interface.show_dialog("Andrà tutto bene.","Milk")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_dialog("Sono proprio qui.","Milk")
	await novel_interface.show_text_only("... \"Andrà tutto bene. Sono proprio qui.\"")
	await novel_interface.show_text_only("Quando Beth torna alla realtà, il suo sguardo cade sul resto dei membri della sua squadra.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Quelli che portano gli scudi antisommossa le dedicano a malapena una seconda occhiata mentre i nemici continuano a irrompere. Le fanno un breve gesto: vai, vai.")
	await novel_interface.show_text_only("Questi valorosi guerrieri sanno esattamente con cosa hanno a che fare?")
	await novel_interface.show_text_only("Sanno almeno cosa stanno facendo... coloro che danno loro gli ordini?")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_dialog("Mi dispiace. È stata colpa mia... Ho valutato male la situazione...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non è il momento di scusarsi.","Membro della squadra B")
	await novel_interface.show_text_only("L'altra parte ha fatto l'occhiolino a Bai Zhu dicendo che aveva capito.")
	await novel_interface.show_dialog("Faresti meglio a offrirmi dieci anni di tequila una volta usciti da questo buco infernale.","Membro della squadra C")
	await novel_interface.show_text_only("Beth difficilmente riesce a credere che i suoi compagni di squadra stiano ancora cercando di confortarla anche in una situazione del genere.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("—Attento!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk spinge giù la spalla sinistra di Beth, bloccando una falce in arrivo con un mitragliatore già senza munizioni.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Questi ragazzi sono impossibili!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I nemici, come un'orda di leopardi appena liberati, attraversano facilmente la zona cuscinetto sgombrata dai detentori degli scudi antisommossa.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("È perché sono Ningen..., che significa \"umano\" in giapponese.","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Nin... gen... heeheehee... \\nMuori! Morire! Morire!","???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È come se la parola Ningen li divertisse. Il leader dei nemici sorride da un orecchio all'altro in un sorriso straziante.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Sono pazzi... \\nNon possiamo sconfiggere questi mostri...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Beth, prendi gli altri e vai! Li terremo a bada!","Caposquadra")
	await novel_interface.show_text_only("Prima ancora che il membro della squadra con lo scudo possa finire la sua frase, il suo scudo viene fatto volare da un nemico con la falce. Persa la copertura, i membri della squadra aprono immediatamente il fuoco, schivando gli attacchi al meglio delle loro capacità.")
	await novel_interface.show_text_only("All'improvviso, dal nulla—")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BaizhuBattle.png")
	await novel_interface.show_text_only("All'improvviso, la lama di una spada dalla forma strana bloccò saldamente la falce che stava attaccando Milk.")
	await novel_interface.show_text_only("Beth evoca dozzine di macchie di luce argentate, che sfrecciano verso i nemici, lasciando macchie bianche simili a congelamento sui loro corpi.")
	await novel_interface.show_text_only("La melma verde che fuoriesce dai corpi dei nemici può riparare le loro ferite, ma non ha alcun effetto su queste macchie bianche. Una volta colpiti dalle schegge, i loro corpi si frantumano in pezzi.")
	await novel_interface.show_text_only("Beth poi lampeggia e appare accanto a Milk. Si lancia in aria, sparando dozzine di proiettili ai nemici circostanti in un istante.")
	await novel_interface.show_dialog("Uh... Bethy... ?","Milk")
	await novel_interface.show_text_only("Gli occhi di Milky, stupiti, riflettevano lo strano gruppo di luce bianca che stava colpendo sull'arma del suo amico.")
	await novel_interface.show_text_only("Più velocemente di quanto i suoi proiettili possano viaggiare, Beth brandisce lo spadone nella mano sinistra. Sulla sua superficie compaiono intricati motivi a spirale.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("È allora che il continente ricomincia a tremare.")
	await novel_interface.show_text_only("Eppure i membri della squadra, troppo occupati a combattere, notano a malapena...")
	
	print("=== 深海恐惧症篇第20话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
