# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("廊下に現れた連中は、即座に俺達の方へと\\n突進してきた。")
	await novel_interface.show_text_only("奴らは何も喋らず、衣服の擦れと足音以外に\\n呼吸音さえ聞こえない。")
	await novel_interface.show_text_only("俺は武器を握り直して奴らに応戦しようとする。\\nだが、先に動いたのはハインリッヒだった。\\n戦闘服が光を放つと、霧だけをその場に残して\\n姿を消す。")
	await novel_interface.show_text_only("私がまだ唖然としている間に、ハインリヒはすでに一人の人の前を避け、ラピスラズリの剣の背で女性の一人の胸当てを打ちつけていた。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("──は、速いっ！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("剣に似つかわしくない鈍く大きな音が響く。\\n俺は痛みを想像し、思わず胸元を押さえた……")
	await novel_interface.show_text_only("相手は力なく事切れ、打たれた衝撃で地面を\\n大きく転がっていく。")
	await novel_interface.show_text_only("人間が地面へ倒れる時に行うような、反射的な\\n受け身などは取らず、まるで人形のようだ。")
	await novel_interface.show_text_only("さらに転がりが止まると、胸の打たれた部分が\\n少し陥没しているというのに、\\n何事もなかったかのように、再び武器を持って\\n俺達に突撃してきた。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…………！","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは事態の異様さに気付き、\\n素早く身を翻して刃で3人のかかとを貫いた。")
	await novel_interface.show_text_only("筋を断ち切られ地面に倒れても、俺達の方に這い\\n寄ろうと痙攣する。\\nなおも沈黙を保ちながら……")
	await novel_interface.show_text_only("強敵ではないが人間の肉体で表現された\\n非人間性がなんとも……")
	await novel_interface.show_text_only("不気味の谷現象ってやつに語られているような\\n存在みたいで、文字通りに不気味だ……")
	await novel_interface.show_text_only("この敵達の脅威性が失われた事を確認した後、\\nラファエルは相手の一部に近付き治療を試みる。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("その時、突然再び地面が揺れた。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("また地震ですか……","ハインリッヒ")
	await novel_interface.show_text_only("今回の揺れはさらに激しく、震動時間も長い。")
	await novel_interface.show_text_only("震動と共に廊下の明かりが暗くなり、\\n遠くから耳障りな音が聞こえてきた。\\n金切り声なのか本当に金属が切られているのか、\\nとにかく耳障りな音がする。")
	await novel_interface.show_text_only("地面に倒れていた奴らは、地殻変動で歪む\\n波間の飛沫のように、だんだん透明な……\\n……これは液体になったのか？") #换行问题
	await novel_interface.show_text_only("熱した鉄板上の水滴のように、液体は沸騰し始め\\n大量の泡を作りながら数秒間で蒸発した。")
	await novel_interface.show_text_only("そして冷たい甲板の上には跡形もなく、\\n痕跡すら残らず消えた。\\nあんな不気味な奴らなど、最初から存在して\\nいなかったかのように。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("地震後、俺達の周囲の環境には奇妙な変化が\\n発生していた。")
	await novel_interface.show_text_only("何故か資料室の木製品は粉砕され、空気中に\\n散らばり、壁も斑模模様に半壊している。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("……え？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ここは相変わらず、あの資料室だ。")
	await novel_interface.show_text_only("だが部屋内の光源は消えている。\\n\\n床も以前と比べ劣化しており、\\n本棚の物の置き方も明らかな差異がある。")
	await novel_interface.show_text_only("産業風の太い鉄骨の梁の後ろで、別の音を感知する監視カメラが暗いレンズを私たちに向けていました。")
	await novel_interface.show_text_only("壁には精美な南極地形図が貼り付けられていて、\\n\\n大気データを記録するノートが開かれたまま\\n机の上で存在感を匂わせている。")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("これは……どういう事だ！？","小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("今のは……まさか幻覚だったのでしょうか……","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("あいつらも存在していなかったのかしらね？","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは血痕の消えた武器を眺めながら、\\n連中が蒸発して消えた場所を真剣に観察する。")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("いいえ、恐らくですが先程までわたくし達は\\n現実世界から離れていたようですわ……","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリヒは突然リー・トンの声で遮られた。")
	await novel_interface.show_dialog("──やっと繋がったか！？","マリル")
	await novel_interface.show_text_only("俺の胸からマリルの声が。")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("マリル！　電波に何か問題があったのかっ？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは「そうだ」と返事をするが、\\n声からは少し疲れが感じられる。\\n一方、ハインリッヒは驚いた様子で俺の胸元を\\n見つめていた。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("（待ってくれ、何を言い出すか分からないけど）\\n\\n（こいつ絶対誤解しているぞっ！！）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは俺のを見て色々理解した感じで\\n頷き、軽く自分の胸元を弄った。")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("（小声）マスターはわたくしにも……\\nそのような改造を為されたのでしょうか？","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("断固していない！！！\\n何か、期待していないかッ！？！？")
	await novel_interface.show_dialog("そ、そうだ。\\nどうして無線機が使えなかったんだ……？\\nアニーの方は大丈夫なのか……？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("通信衛星はすでに配置に就いた。\\n\\nアニーはメタンが漏洩している地点の情報を\\n集めてくれている。そっちはどうだ？","マリル")
	await novel_interface.show_text_only("俺は考えを整理しながら、できるだけ簡潔に\\n俺達が基地に入ってから起きた色々を報告した。")
	await novel_interface.show_dialog("………………………\\n（『現実世界にいなかった』か……）","マリル")
	await novel_interface.show_dialog("ちょっと待て、時間を確認するぞ。","マリル")
	await novel_interface.show_dialog("お前達が基地の入り口でアニーと最後の連絡を\\n取ってから……現時点で8分が経過した。","マリル")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("……そんなに短かったのか？","小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("少なくとも、すでに40分は経っているはずよ。","ラファエル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは何か思い当る事があったのか、\\n素早くキーボードを叩いた。")
	await novel_interface.show_dialog("先ほど、南極海域を巡航していたリバーナ所属の\\n駆逐艦が低周波ノイズと思われる信号を\\n受信した。","マリル")
	await novel_interface.show_dialog("地震の余波だと思っていたが、現在の状況から\\n推察すると……","マリル")
	await novel_interface.show_text_only("マリルがEEGモジュールを展開し、\\nモデル解析をやり直す。")
	await novel_interface.show_dialog("やはり……","マリル")
	await novel_interface.show_dialog("この信号は人間のレム睡眠時の脳波パターンと\\n類似性が非常に高い。ただ……","マリル")
	await novel_interface.show_dialog("その強度が62万倍にも増幅されている。","マリル")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("……冗談じゃないわ！！","ラファエル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("じゃあ、私達がさっきまで夢を見ていたとでも？","ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("確かに夢を見ている時、時間は遅く感じる……","小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("夢は『記憶』の反映です。\\n\\n今しがた現れた様々な状況は、\\n記憶の欠片の再編と似ていましたわ……","ハインリッヒ")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あれはきっと悪夢だった……","小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("昔見た映画を思い出した。\\n\\nあのオシャレな独楽さえ用意できれば、\\nもしかしたら夢かどうか判断できるかもな。")
	await novel_interface.show_dialog("……お前達ではなく、\\n別の「何か」が夢を見ているのかもしれん。","マリル")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("そしてわたくし達は、その者の夢の中にいる……\\nという事でしょうか？","ハインリッヒ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("証拠のない推測は不安を悪戯に増やすだけだ。\\n\\nどうやら動員されている人員が多いのか、\\nマリルの方がとても騒がしくなっている。")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そうだ、外は……どうなってる？","小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは情報をどこまで話すべきかを\\n考えているようで、しばらく沈黙している。")
	await novel_interface.show_dialog("──思ったより、厄介だ。","マリル")
	await novel_interface.show_dialog("『連合議会』はメタン漏洩についての対応措置を\\n現在議論している。\\nだがあんな政府機関にこのような『終末事件』の\\n対応を求めても期待はできん。","マリル")
	await novel_interface.show_dialog("サモントンのデックス博士はメタン分解微生物を\\n利用する案を出しているが……","マリル")
	await novel_interface.show_dialog("耐寒性菌種の在庫不足はもちろんの事、\\n細菌の育成周期も長すぎる。","マリル")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("それに好気性ではなく嫌気性の菌は、\\n大気中のメタンをどうする事もできない──","ラファエル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("お爺様も、今回は打つ手なしのようね……","ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("（何を言っているのかさっぱり分からん……）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("現在、中小規模の視察拠点の多くが撤退準備を\\n始めている。\\nまた、南極の3大基地では臨時対応チームが\\n設立された。","マリル")
	await novel_interface.show_dialog("現時点の南極圏内で発見されたメタン流出点は\\n42箇所あり、その内の6箇所がすでに発火。\\nネット上に映像もアップロードされている。","マリル")
	await novel_interface.show_dialog("氷原の亀裂から火炎が噴出する映像を\\n全世界のニュースが繰り返し流している状態だ。","マリル")
	await novel_interface.show_dialog("報道規制に関してはすでに失効している。\\n\\nこの終末に向かうような空気は、\\n「ブラッククリスマス」以来だろうな……","マリル")
	await novel_interface.show_text_only("マリルの発言は皮肉というより、\\nお手上げといった感じの方が強い。")
	await novel_interface.show_dialog("計測した結果、メタンの流出点は不凍湖と\\nロス島にあるエレバス火山地帯に集中している。","マリル")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("…………火山？","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("お前達の近くのプリンセス・エリザベス・ランド\\nでも、2件のメタン性小規模火災が報告された。","マリル")
	await novel_interface.show_dialog("うち1件はクローブ山の旅行団が火炎放射器を\\n不正使用したものだが……\\n……本当に金持ちの馬鹿どもめが。","マリル")
	await novel_interface.show_dialog("ともかく、スノークイーン基地は現時点で火災の\\n影響は受けないはず。","マリル")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("ふう……","小憐")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（よかった……）\\n\\n（しばらくは炙り焼きにならずに済みそうだ）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……しかしマクマード基地にて、大陸の亀裂の\\n下方で熔岩流の大範囲な活動が観測された。","マリル")
	await novel_interface.show_dialog("スノークイーン基地付近の亀裂が一番激しく、\\n付近氷層の強度も急速に減少している。","マリル")
	await novel_interface.show_text_only("俺は思わず足元の金属甲板を見た。")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("（炙り焼きじゃなくて、鉄板焼きになるのか…）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そんな事を考えていると、前触れなく通信機から\\n甲高いノイズが発生すると共に、\\n俺の胸が震えつつ通信が切れた。") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("次々と出現する噴出炎、流れるマグマ、\\n死の煙……","ハインリッヒ")
	await novel_interface.show_dialog("まるで400年前のあの時と同じ……","ハインリッヒ")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("これらはすべて「根源的な物質」の崩壊の前兆です。","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("1600年……ってあの事件よね？","ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("あれは第七のセフィロス。\\n『豊穣』の地────ペルー副王領。","ハインリッヒ")
	await novel_interface.show_dialog("四面を捉える火の海と、鼻を突く硫黄の匂い。\\nどうにも忘れられません……","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒの辛い記憶が俺の心を震わせた。\\n俺もあの時、似たような事を経験したから……")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("……これは全部、君が言っていた『あの方』と\\n関係があるのか？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは頷いた。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("昔、わたくしは薔薇十字団の友人達と\\n3冊の秘本を集めました。\\n『天車の書』　『創造の書』　『光の書』","ハインリッヒ")
	await novel_interface.show_dialog("記された内容に基づき、わたくし達は錬金術の\\n中で最も偉大なる成果を達成しました──\\n因果の狭間を出入りできる『扉』を作成する事に\\n成功したのです。","ハインリッヒ")
	await novel_interface.show_dialog("当時のわたくし達は『扉』の向こうでは、慈愛に\\n溢れる全能の主が世界の真理を示してくれる──\\nと、甘い期待を抱いていましたわ。","ハインリッヒ")
	await novel_interface.show_dialog("「『扉』をくぐってはならない」\\n「『真理』を覗いてはならない」\\nそんな戒めが存在しているのは、然るべき理由が\\n存在していたのです……","ハインリッヒ")
	await novel_interface.show_dialog("『扉』は一度でも入ってしまうと、永遠に出口が\\n見つからなくなります。\\n『真理』は一度でも脳内に刻まれてしまうと、\\n永遠に忘れる事はできません。","ハインリッヒ")
	await novel_interface.show_dialog("人間が唯一理解できるのは言語そのもの──","ハインリッヒ")
	await novel_interface.show_dialog("言語で表現できないモノは、わたくし達の知能の\\n限界を超えているのです。","ハインリッヒ")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("それは20世紀になって、まとめられた\\n哲学的な観点よ……","ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("あら？　思考だけで、この結論に至った方が\\nいらっしゃるのですか？","ハインリッヒ")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("その方は、相当な苦しみを経験したのでしょう。","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("それどころか、彼の家は精神病棟と化して\\nいたわよ……","ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("あの知識達は絶えず人の自我を消滅させ、\\n恐怖の中に咲く好奇が混ざり合えと囁き、\\n理性によっての制御を許さない。","ハインリッヒ")
	await novel_interface.show_dialog("わたくしが溶解の過程を経験している最中、\\n『あの方』は目の前に現れました……","ハインリッヒ")
