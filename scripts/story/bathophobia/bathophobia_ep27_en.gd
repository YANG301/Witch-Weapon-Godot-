# bathophobia_ep27.gd - 深海恐惧症篇第27话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep27_script()

func play_script():
	pass

func bathophobia_ep27_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Beth eventually falls into uneasy slumber on my shoulder.")
	await novel_interface.show_text_only("Henriette ambles over to the shattered tank and presses a hand in the bottom, where some light blue liquid is still accumulated.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Is this...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("What?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("More than 99% of it is water, but that’s not the point. The point is...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She circles to the back of the tank and observes carefully, finally tracing the wires and pipes to a dark corner, where she finds a small cabinet.")
	await novel_interface.show_text_only("It’s painted over in a layer of grey-green metal, reflecting the tourmaline’s light blue glow.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Is that...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("(That’s the same material painted over the suitcase storing Beatrice’s Witch’s Shard!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s an alloy that weakens or blocks the psychological and meme effects caused by Substance H. Which means that what’s inside the cabinet must be...")
	await novel_interface.show_text_only("Before I can stop her, the alchemist has already opened the cabinet and retrieved a glass vial.")
	await novel_interface.show_text_only("One-fifths of the blue liquid inside has already been consumed.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("That must be what the man in the footage took with him...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("I can’t tell what this is exactly, but it must have been what kept the girl alive and healed her.","Henriette")
	await novel_interface.show_dialog("According to the timer on the cabinet lock, it was last opened 167,665 hours and 48 minutes ago.","Henriette")
	await novel_interface.show_dialog("After all this time, she didn’t age one bit. Wow. That’s quite something.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette’s eyes are sparkling, voice trembling in excitement.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Biologically, this means...","Raphael")
	await novel_interface.show_dialog("... that this substance pauses the process of metabolism and forcefully extends the lifespan of cells. Another possible explanation is that it’s capable of supplying telomere and speed up the apoptosis process of damaged cells.","Raphael")
	await novel_interface.show_dialog("But she was still breathing inside the tank.","Raphael")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("In that case...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("The three of us carry Beth all the way back to the entrance of the base. We’re no longer in the dream now, but we still didn’t pass by any bodies on the way.")
	await novel_interface.show_text_only("Liliu, who had been waiting here for a long time, threw me onto the ship without saying a word and let Aiyi ravage me crazily.")
	await novel_interface.show_text_only("Aya raises an eyebrow at my soggy outfit and throws a pair of pink sweatpants with white side stripes at me.")
	await novel_interface.show_text_only("As for what happened next, please... let’s just forget it!")
	await novel_interface.show_text_only("Raphael voices her suspicions that Beth waking was not the reason we were able to leave the dream.\\nMeanwhile, Aya collects the clothes I changed out of, declaring that she‘ll conduct some studies on them.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(Studies? What kind of studies?)","Lian")
	await novel_interface.show_dialog("(Just leave me alone, okay?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I was dreaming about my bladder bursting... and then someone elbowed me in the gut...")
	await novel_interface.show_text_only("Who wouldn’t wake up when something like that happens to them, right?")
	await novel_interface.show_text_only("Beth, still deep in slumber, is immediately quarantined in Medbay. Annie, too, falls asleep the second she gets on the plane. She must be spent.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Still, we didn’t find a way to deal with the leaking methane...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I murmur in worry, staring out at the gigantic crack in the ice from the window.")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("... You think?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael appears from behind and joins me in gazing outside the window. A mysterious smile is playing on her lips.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Does she know something I don’t? Is she... laughing at me?)","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ahem.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael sobers up and begins talking in earnest.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("There are two main issues with the plan that Grandpa suggested, the one with the cold-resistant methanophiles.","Raphael")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I nod along, even though I don’t have the least idea what she's talking about.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("The main issue is that the genes of methanophile archaea are quite unstable. That makes them hard to cultivate on a large scale. After a few dozen cycles of division, they usually mutate and no longer function they way we need them to.","Raphael")
	await novel_interface.show_dialog("The division happens every ten, twenty minutes or so, which is good, but the mutated bacteria can still multiply and end up contaminating the rest of the specimens in an uncontrollable speed.","Raphael")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("It's near impossible to weed out the mutated strains with our current technology. That's the main reason the methanophiles are hard to cultivate.","Raphael")
	await novel_interface.show_dialog("Still, if “this substance” is capable of keeping someone alive for this long, without even ageing...","Raphael")
	await novel_interface.show_dialog("It may be the key to solving this problem from the aspect of the cells themselves.","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sounds cool when you put it like that...\\nSo, does this mean that project methanophile is a go?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("There's still another issue, though. The methanophiles die when in contact with oxygen, so they'll only be able to survive near the leakage sources.","Raphael")
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("If we try to spread them in the atmosphere using bioaerosol, they'll die before they even reach land.","Raphael")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("We need some kind of vessel to keep them from getting in contact with oxygen. It must also be capable of auto-degrading in a cold environment.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya pinches me and sends me a meaningful glance.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh... you mean aerogel?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("That was what Annie used to seal up that spoiled princess's hotel room. Igor's group managed to break through it with liquid nitrogen, though.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Sounds like a fun plan. You're quite smart, huh?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Did she just... praise me?")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Did I hear wrong?)","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hey, why are you wearing sweatpants by the way? Did you piss your pants or something?","Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, no, no, definitely not!","Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("In the lab of McMurdo Station, some cold-resistant methanophiles extracted from the silt buried in the depths of the glaciers are stored.")
	await novel_interface.show_text_only("Though we only manage to obtain a few specimens at first, Aya still cultivates enough active strains using the blue liquid within a couple hours.")
	await novel_interface.show_text_only("As the cruiser passes over Antarctica, I notice that, down there, countless drones from different countries are working together above the cracks.")
	await novel_interface.show_text_only("In the modified aerosol with net-like structures, high-density methanophiles are sealed and scattered at the leakage sites in the form of countless miniscule crystals.")
	await novel_interface.show_text_only("Twelve hours after the earthquake, the data from different weather stations in Antarctica shows that the methane level in the atmosphere is now back under control.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mariru later sends the United Congress a request for an outrageous maintenance fee, which will be paid by all of the six Academy Cities.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Henriette is seated inside the control room, face impassive. Mariru stands in front of the big screen, studying the figures on it.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Henriette Khunrath...","Mariru")
	await novel_interface.show_dialog("You’re quite something, aren’t you. Dragged my team into a phase fluctuation the moment you showed up...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Nice to meet you.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette smiles, face tranquil.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("We've spoken before, but this is the first time we're meeting face-to-face.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("At least this doesn't look like an interrogation room. Should I be grateful...?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ignores Henriette's taunting words and continues staring down at her resume.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Entered Leipzig University at ten years old. Became a certified alchemist at fourteen.","Mariru")
	await novel_interface.show_dialog("Later went to Universität Basel, got a medical Ph.D in four months.","Mariru")
	await novel_interface.show_dialog("Recorded date of death was in 1605. Reason for death was a lab explosion.","Mariru")
	await novel_interface.show_dialog("According to some manuscripts, before the explosion occurred, a company registered in the Netherlands had paid the nearby inhabitants handsomely and asked them to move.","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("The diary of the inspector at that time told us that the power of the explosives involved likely exceeded that of the nitroglycerin dynamite invented over two hundred years later.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Haha. That was simply my scheme to escape The One.","Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Still, those alchemists spent more than two hundred years to catch up to me, huh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette mocks.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Two hundred years later, there were no longer alchemists. They're called chemists now.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("The explosives invented later didn't require a magic seal either. Non-alchemists could manufacture them in large batches. It's quite profitable.","Mariru")
	await novel_interface.show_dialog("Though people did accidentally blast their relatives to death from time to time...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette smiles, like she understands.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("The only writing you left behind was the manuscript of the Amphitheatre of Wisdom. It's currently part of the Newmoridas Municipal Museum collection.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, that. Took me a long time, that one. I should check it out when I get a chance.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("You were a gem collector first and foremost, though only five pieces in your collection, representing the five elements, still remain. The Lapis Lazuli is the most important one of all...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, the one Ren smashed? It's not that important.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... You really didn't leave behind much information. Before this operation, we didn't even realize you were just a little girl.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("All we had was records left behind by the civilians back then, discovered by Salmonton during investigations after you disappeared along with Raphael and Ren.","Mariru")
	await novel_interface.show_dialog("If we had taken this info into consideration in the first place, we certainly wouldn't have chosen the Lapis Lazuli to experiment on.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Too late to regret that now. So it seems that Master and I were destined to meet, huh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl stretches her limbs lazily.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("There’s another thing I’m curious about. Ren’s audio recording and your description both mentioned the Tree of Life being a kind of seal...","Mariru")
	await novel_interface.show_dialog("... which keeps at bay the being that even The One fears.","Mariru")
	await novel_interface.show_dialog("According to Beth’s testimony, that being... or one of those beings... is a massive eyeball-like creature that exists in the deep sea.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("I won’t force you to tell me who The One is, nor do I need to know what that eyeball is exactly. They were probably around far before humans first appeared on earth.","Mariru")
	await novel_interface.show_dialog("All I can do now is treat them like the laws of physics: as pre-existing conditions.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("A wise decision. Well, what do you want to know, then?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("I want you to tell me... what caused the seal to become unstable.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A good question from a practical tactician. Henriette looks up approvingly into Mariru’s determined eyes.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("About that...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl raises her right hand. In a blast of light and swirling symbols, an azure gem materializes in her palm.")
	await novel_interface.show_text_only("In its center floats a projection of an eyeball-shaped object, enveloped by a flowing, liquid-like substance.")
	await novel_interface.show_text_only("The pupil of the eyeball is dilating, quivering erratically, like an eyeball of a human entering REM sleep would.")
	await novel_interface.show_text_only("What look like branching peripheral nerves are floating in the liquid. Looks tranquil, eerily so.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("I have no idea what “it” is either.","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette stares at the eyeball in utter fascination.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("What matters is that whatever had been restraining it in its body is now gone.","Henriette")
	await novel_interface.show_dialog("Or else... do you really think a human could have survived after pricking this... thing with a probe?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... They’d die, I guess.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette nods, tosses the gem in the air before catching it again.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("The Ninth Sephira represents the “foundation” of life. Its ability to revitalize living beings is probably what kept that girl alive for so long.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("For nineteen years, huh...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Ah, by the way, you’ve collected it all, right? The most valuable data from the base?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oh, you mean the data from the culture tank?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru taps away on her handheld device, calling up the data timeline of Beth’s vitals from the gigantic database.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("In that location, over seventy days ago...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("There was this... “wobble” in the atmosphere. And then it kept gaining force...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Perhaps, that was when “that being” could no longer maintain stability...","Henriette")
	await novel_interface.show_dialog("It “vibed” with Beth via that blue liquid, and generated a sort of dream world which affected all humans in the vicinity.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Or perhaps it’s the other way around? That was when Beth’s body could no longer remain stable, and it affected the eyeball...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("No matter which it is, we know for sure that both became unstable at the time point—\\nSome seventy days ago. That’s not a long time ago.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("That’s in accord with our suspicions. Throughout all these years, someone must have been keeping Snedronningen Base running.","Mariru")
	await novel_interface.show_dialog("However, after the war, the organization didn't have enough man power to do anything besides perform basic maintenance. They would even empty the whole base during the polar night period.","Mariru")
	await novel_interface.show_dialog("The organization must be big on keeping everything under wraps. All we could find in our investigations were dummy company names which they were registered under. And all of the organization’s funds were credited via encrypted methods.","Mariru")
	await novel_interface.show_dialog("They deleted all the video recordings they had every year. You wouldn't have been able to see anything in the control room had you not been in a dream.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(But... the watch...)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("... Wait...","Mariru")
	await novel_interface.show_dialog("Over seventy days ago...","Mariru")
	await novel_interface.show_dialog("(Wasn't that when the Ross Goblet disappeared?)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette shrugs.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Don't know. I wasn't \"awake\" then.","Henriette")
	await novel_interface.show_dialog("Besides, like you just said...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("If you had had access to all the materials in the very beginning, you wouldn't have chosen the Lapis Lazuli. That way, I wouldn't have brought those girls along to Antarctica at all, right?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... I guess.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("However, if we hadn't arrived in Antarctica in time and stopped the dream from spreading further, then the world would have...","Henriette")
	await novel_interface.show_dialog("Boom!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette gestures widely, then flashes a knowing smile.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("I'm not sure what happened before that, of course...","Henriette")
	await novel_interface.show_dialog("But do you really think it was simply a coincidence that you chose the Lapis Lazuli?","Henriette")
	await novel_interface.hide_character()
