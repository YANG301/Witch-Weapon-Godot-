# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Le strane figure apparse all'improvviso nel corridoio si dirigono verso di noi.")
	await novel_interface.show_text_only("Sono totalmente silenziosi, a parte il suono del fruscio dei tessuti e del ticchettio dei passi. Hanno anche bisogno di respirare?")
	await novel_interface.show_text_only("Stringo forte la mia arma, preparandomi mentalmente. È allora che forti raggi di luce escono dalla tuta da battaglia di Henriette. Scompare dalla vista in un lampo, lasciando dietro di sé solo una nuvola di fumo luminoso.")
	await novel_interface.show_text_only("Mentre ero ancora stordito, Heinrich si era già schivato davanti a una persona e aveva colpito una delle donne sul pettorale con il dorso della sua spada di lapislazzuli.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ehi, ha delle mosse!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il suono forte e ovattato della sua arma che colpisce il bersaglio echeggia sulle pareti del corridoio. Giuro che mi fa male il petto solo a sentirlo.")
	await novel_interface.show_text_only("Il suo bersaglio cade a terra come un burattino di legno e rotola lontano.")
	await novel_interface.show_text_only("Qualunque essere umano si sarebbe mosso istintivamente per proteggersi da ulteriori danni, eppure questa fantoccio non fa nulla del genere.")
	await novel_interface.show_text_only("Una volta che smette di rotolare, salta semplicemente in piedi, con l'ammaccatura al petto e tutto il resto, e si carica contro di noi.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rendendosi conto che questi non sono nemici comuni, Henriette si gira e trafigge tre di loro nel tallone alla velocità della luce.")
	await novel_interface.show_text_only("I tre, con i tendini recisi, si accasciano a terra, eppure continuano a strisciare verso di noi con movimenti stranamente silenziosi e spasmi.")
	await novel_interface.show_text_only("Non sembrano così spaventosi a prima vista, ma il fatto che mostrino caratteristiche chiaramente non umane è... molto inquietante, per usare un eufemismo.")
	await novel_interface.show_text_only("Sembrano umani. Non si comportano come umani. È dannatamente inquietante.")
	await novel_interface.show_text_only("Dopo aver confermato che i nemici non rappresenteranno più una minaccia, Raphael va avanti nel tentativo di vedere qual è il problema con loro.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("All'improvviso la terra ricomincia a tremare.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("Un altro terremoto?","Henriette")
	await novel_interface.show_text_only("Questa volta il terremoto è più intenso e dura molto più a lungo.")
	await novel_interface.show_text_only("Insieme ai tremori, le luci nel corridoio si accendono e si spengono, seguendo quello che sembra uno stridore acuto, o forse il metallo che viene strattonato.")
	await novel_interface.show_text_only("I nemici a terra sembrano trasformarsi in... liquido trasparente? Schiuma? Proprio davanti ai nostri occhi.") #换行问题
	await novel_interface.show_text_only("Il liquido inizia quindi a bollire e a bollire, come se fosse su una tavola teppanyaki. In pochi secondi, quelle che prima erano figure a forma umana erano evaporate nel nulla.")
	await novel_interface.show_text_only("Non lasciano alcuna traccia sulle fredde assi del pavimento. È come se quelle ragazze bizzarre non fossero mai esistite.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Anche il nostro ambiente sembra essere cambiato dopo il terremoto.")
	await novel_interface.show_text_only("Gli ornamenti in legno nell'archivio si sono sgretolati, diventando semplice segatura che fluttua nell'aria. Anche la vernice sui muri si è scrostata.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("... Eh?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È sempre la stessa stanza d'archivio...")
	await novel_interface.show_text_only("Ma le luci sono spente. Le piastrelle a terra non sono più lucide. E gli oggetti sullo scaffale, disposti in modo completamente diverso.")
	await novel_interface.show_text_only("Dietro le spesse travi d'acciaio dall'aspetto industriale, un'altra telecamera di sorveglianza con rilevamento del suono puntava verso di noi la sua lente scura.")
	await novel_interface.show_text_only("Alla parete c'è una mappa topografica dettagliata dell'Antartide e sulla scrivania un taccuino che registra i cambiamenti nei dati atmosferici.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Cosa... cos'è questo?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Ciò che abbiamo appena visto... era un'illusione?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Anche quelle marionette?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette abbassa lo sguardo sulla sua arma: non macchiata di sangue, anche se dovrebbe esserlo. Poi alza lo sguardo verso il punto in cui i nostri improvvisi aggressori sono apparentemente evaporati.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Forse quello in cui eravamo... non era il mondo reale.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich fu improvvisamente interrotto dalla voce di Li Tong.")
	await novel_interface.show_dialog("Finalmente! Una connessione!","Mariru")
	await novel_interface.show_text_only("La voce di Mariru rimbomba da... nel mio petto?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Ehi, Mariru! Che succede con il segnale?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru canticchia, sembrando esausto. Nel frattempo, Henriette fissa il mio petto con orrore, confusa sul motivo per cui la voce di Mariru provenga da lì.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Ehi, questo è un malinteso, lo giuro!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedendo lo sguardo sul mio viso, Henriette annuisce, come se avesse capito, e comincia a tastarsi anche il seno.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Sussurrando) Anche il Maestro... ha modificato il mio corpo in quel modo?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("Ovviamente no! E perché sembravi che ne fossi entusiasta?")
	await novel_interface.show_dialog("Ehi, a proposito, perché invece non ci hai contattato tu con il walkie-talkie?\\nVa bene Annie?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Il satellite per le comunicazioni è in posizione adesso. Annie sta raccogliendo informazioni sulle fonti delle fughe di metano. Come va laggiù?","Mariru")
	await novel_interface.show_text_only("Faccio del mio meglio per riordinare i miei pensieri e riferire tutto ciò che abbiamo incontrato dopo essere entrati nella base nel modo più conciso possibile.")
	await novel_interface.show_dialog("... \\n(Non il mondo reale, eh...)","Mariru")
	await novel_interface.show_dialog("Aspetta un attimo, fammi controllare l'ora.","Mariru")
	await novel_interface.show_dialog("Sono trascorsi otto minuti dall'ultima volta che hai contattato Annie al cancello della base.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("... Solo otto minuti?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Non avrebbero dovuto essere almeno quaranta minuti?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Come se si fosse reso conto di qualcosa, Mariru inizia a digitare.")
	await novel_interface.show_dialog("Un cacciatorpediniere di classe Lebona che pattuglia l'Oceano Antartico ha appena ricevuto una specie di segnale a bassa frequenza.","Mariru")
	await novel_interface.show_dialog("Pensavo fosse una scossa di assestamento, ma considerando come stanno le cose adesso...","Mariru")
	await novel_interface.show_text_only("Mariru richiama il suo sistema EEG ed esegue nuovamente un'analisi del pattern.")
	await novel_interface.show_dialog("Proprio come mi aspettavo...","Mariru")
	await novel_interface.show_dialog("Questo segnale... ha lo stesso schema delle onde cerebrali durante il sonno REM umano...","Mariru")
	await novel_interface.show_dialog("... Ma sessantadue volte più intenso.","Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("... Stai scherzando?","Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Vuoi dire che stavamo sognando proprio adesso?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Il tempo rallenta quando sogni, è vero...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("I sogni riflettono i ricordi. E quello che è appena successo... sembrava davvero una ricombinazione di diversi frammenti di memoria.","Henriette")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se quello era un sogno, allora è stato sicuramente un incubo...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("All'improvviso mi viene in mente questo film che ho visto, in cui i personaggi usavano i totem per capire se erano in un sogno o no. Vorrei averne uno.")
	await novel_interface.show_dialog("... Forse non eravate voi a sognare. Potresti essere stato nel sogno di qualcun altro.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Il sogno di qualcun altro...?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tutte queste sono solo speculazioni, ovviamente, che servono solo a innervosirmi ancora di più. Noto che c'è un po' di rumore dalla parte di Mariru: sembra che molte persone siano impegnate a lavorare intorno a lei.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("A proposito, com'è... là fuori?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru rimane in silenzio per un momento, come se stesse cercando di decidere quanto vuole rivelare.")
	await novel_interface.show_dialog("È un po' più... complicato di quanto ci aspettassimo.","Mariru")
	await novel_interface.show_dialog("Il Congresso Unito sta attualmente discutendo su come risolvere il problema delle perdite di metano. Ma sai come sono le loro persone. Non saranno in alcun modo in grado di far fronte a un evento a livello di apocalisse come questo.","Mariru")
	await novel_interface.show_dialog("Il Dr. Deckers di Salmonton ha proposto un piano per utilizzare gli archei metanofili...","Mariru")
	await novel_interface.show_dialog("Ma al momento non ce n’è molto in magazzino, soprattutto non del tipo che può sopravvivere al freddo. Ed è troppo tardi per coltivare di più da zero.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Inoltre, i batteri anaerobici non possono fare molto nella nostra atmosfera perché l’ossigeno li uccide.","Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Quindi anche il nonno è perplesso, eh...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(Non ho idea di cosa stiano parlando... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Attualmente, la maggior parte delle stazioni di ricerca di media e piccola scala sono in fase di evacuazione, sebbene una squadra di emergenza temporanea sia già stata istituita dalle tre principali basi antartiche.","Mariru")
	await novel_interface.show_dialog("Finora sono state identificate quarantadue fonti di perdite di metano nel Circolo Antartico. Sei sono già accesi e le foto di quei siti si stanno diffondendo a macchia d'olio su Internet proprio in questo momento.","Mariru")
	await novel_interface.show_dialog("E anche sui canali di informazione. Probabilmente tutte le TV del mondo stanno ora trasmettendo in loop filmati di fiamme che fuoriescono dalle fessure nelle pianure di ghiaccio polare, sparando fino a decine di metri di altezza.","Mariru")
	await novel_interface.show_dialog("Non c’è modo che possano tenerlo nascosto ancora a lungo. Il mondo lo sa, ed è chiaramente nel panico: alcuni stanno già organizzando festeggiamenti: un ultimo evviva prima che il mondo finisca.","Mariru")
	await novel_interface.show_text_only("Le parole di Mariru sono ciniche, il suo tono impotente.")
	await novel_interface.show_dialog("I siti delle perdite sono concentrati vicino a diversi laghi liberi dai ghiacci e nell'area del Monte Erebus sull'isola di Ross.","Mariru")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("... Monte Erebo? Quello è un vulcano.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Per quanto riguarda la stazione di ricerca Princess Elisabeth Antartide, vicino alla vostra posizione, sono già scoppiati due piccoli incendi a causa delle perdite di metano.","Mariru")
	await novel_interface.show_dialog("C'è anche un incendio appiccato da un gruppo di ricchi e senza cervello membri del gruppo turistico di Mt. Grove che stavano giocando con gli spruzzatori di fiamma. Idioti.","Mariru")
	await novel_interface.show_dialog("Almeno la base di Snedronningen non è in pericolo immediato in questo momento.","Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Uff...","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Bello. Almeno non corriamo ancora il pericolo di essere fritti....)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("... Tuttavia, la stazione McMurdo ha rilevato un'attività di flusso di lava su larga scala sotto le fessure.","Mariru")
	await novel_interface.show_dialog("La fessura vicino alla base di Snedronningen è la più evidente e le calotte di ghiaccio che la circondano stanno diventando sempre più instabili a una velocità allarmante.","Mariru")
	await novel_interface.show_text_only("Non posso fare a meno di guardare le assi di metallo sotto i miei piedi.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Quindi finiremo comunque fritti, eh...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un rumore improvviso e acuto squarcia l'aria. Il mio petto vibra e subito dopo siamo disconnessi.") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Fiamme che sgorgano dal terreno, flussi di lava, fuliggine vulcanica mortale...","Henriette")
	await novel_interface.show_dialog("È troppo simile a quello che accadde circa quattrocento anni fa...","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Tutti questi sono precursori del collasso della “sostanza primordiale”.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Intendi cosa accadde nel 1600?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Questo era nella Settima Particella, la Terra dell’Abbondanza: il Distretto del Governatore del Perù.","Henriette")
	await novel_interface.show_dialog("Non dimenticherò mai il mare di fuoco, l'odore pungente dello zolfo nell'aria...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette ricorda, con tono amareggiato, e non posso fare a meno di esserne colpito, perché anch'io ho avuto un'esperienza molto simile.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Quindi... tutto questo ha a che fare con quel tipo \"The One\" che hai menzionato?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette annuisce.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Allora, i miei amici del Rosenkreuzer e io collezionammo tre libri mistici: Libro del Carro, Libro della Creazione e Libro della Luce.","Henriette")
	await novel_interface.show_dialog("Seguendo le istruzioni sui libri, abbiamo completato il più grande risultato mai raggiunto in alchimia: creare un “portale” che potesse condurci nel regno karmico.","Henriette")
	await novel_interface.show_dialog("Essendo ingenui, credevamo onestamente che il portale ci avrebbe portato da un Signore Supremo benevolo e onniveggente, che ci avrebbe mostrato tutte le verità del mondo.","Henriette")
	await novel_interface.show_dialog("... Ma in realtà c'è un motivo per cui esistono le regole “non passare attraverso il portale” e “non cercare la verità”...","Henriette")
	await novel_interface.show_dialog("Perché una volta entrato nel portale, non troverai mai la via d'uscita.\\nE una volta che vedrai la verità, resterà impressa per sempre nella tua mente.","Henriette")
	await novel_interface.show_dialog("Gli esseri umani sono in grado di comprendere solo il linguaggio.","Henriette")
	await novel_interface.show_dialog("Tutto ciò che non può essere descritto dal linguaggio è al di là delle nostre capacità.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Questa è una filosofia che qualcuno ha inventato nel 20° secolo.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ah? Qualcuno è arrivato a questa conclusione semplicemente filosofeggiando...?","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Quella persona deve aver sofferto molto, allora.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Certo che l'ha fatto. Tutta la sua famiglia era considerata pazza.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sì. Doveva essere un uomo saggio. Solo che quel tipo di saggezza serve semplicemente a divorare il tuo ego finché non ne diventi parte, così pauroso, così disperato.","Henriette")
	await novel_interface.show_dialog("Anch'io ho fatto parte di quel processo una volta. E fu allora che The One si presentò davanti a me...","Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Senza dire una parola, mi ha fatto scegliere.","Henriette")
	await novel_interface.show_dialog("Voglio scomparire, come una goccia nell'oceano?","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("O diventare una singola goccia in una bottiglia, conservata per l'eternità, esistente come custode dell'Albero della Vita?","Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Ti hanno preso di mira quando eri il più debole...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("E il cosiddetto Albero della Vita non è quello che dicono, giusto?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sorride, un po' mestamente.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("... È una specie di sigillo.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("I Dieci Sephiroth dell'Albero della Vita agiscono come un sigillo che tiene a bada un essere indicibile, temuto anche dall'Uno.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Non so cosa sia esattamente quell'essere, però.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Forse dovrei essere sollevato di non farlo.","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette fa una pausa.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Nel cratere di Enaptina, che sembra sul punto di bruciare tutto) \\n (Una volta ne ho avuto un assaggio...)","Henriette")
	await novel_interface.show_dialog("L'Uno non ha mai detto esplicitamente quello che voleva, ma non è difficile capire di cosa si tratta da come è cambiata la nostra terra...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lei ride, senza allegria.")
	await novel_interface.show_text_only("Un silenzio inquieto si insinua su di noi alle parole di Henriette.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Aspetta!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tiro fuori il gascromatografo e indico le cifre che ci sono sopra.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Anche se in questo momento siamo in un “sogno”, la “realtà” qui non è ancora diversa da quella di altri posti?","Lian")
