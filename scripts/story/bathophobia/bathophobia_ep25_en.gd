# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("—Look out!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette shoves me aside the second the door to the control room creaks open.")
	await novel_interface.show_text_only("Just in time, too, for the next thing I know, countless flashing electric arcs are ramming ruthlessly into the blond girl’s chest, accompanied by harsh, ear-splitting blasts. The light is blinding—I can barely keep my eyes open.")
	await novel_interface.show_text_only("And in a few seconds, it’s all over. Everything is quiet once more. My hair stands on end—a huge amount of static must have accumulated there. The air reeks of chlorine.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Wow...\\nHenriette, you okay?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("It’s a trap, I think. Some kind of defensive weapon.\\nPretty impressive, it probably holds as much energy as a small radar.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette stands, studying the ceiling lights of the control room pensively. In her hand is a translucent light blue crystal.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What was that anyway?\\nAnd what’s that in your hand?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("It’s a tourmaline. Wanna try, Master?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The alchemist flashes me a cryptic smile, extends her right hand and places the crystal gently at the back of my ear.")
	await novel_interface.show_text_only("A sudden warm, fuzzy current surges through my body, making all my hairs stand on end.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahh!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I can’t help letting out a dainty moan.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("La? The master's body is very sensitive~","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("You’re moaning? Here? Really?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael glares at me as if I were trash.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Hey, it’s not like I did that on purpose...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I mumble, lowering my head and blushing furiously.")
	await novel_interface.show_text_only("At least the static accumulated over my head is gone. My hair is nice and smooth now.")
	await novel_interface.show_text_only("I should ask Henriette for one of those crystals when we get back...\\nShe won’t mind, right?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("I sheepishly follow the alchemist into the control room.")
	await novel_interface.show_text_only("The place looks wrecked. Most of the screens and equipment have been damaged in various degrees. The ceiling and walls are also crumbling.")
	await novel_interface.show_text_only("Black burn marks left behind by high voltage shocks spread from the main control panel to both sides. The exposed circuits are still fizzling with sparks.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("The spherical radius is over fifteen feet...\\nSomeone must have used a high-voltage discharge weapon here...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("If they were using the standard Genuine security system, it means that this mark over here...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Someone must have crudely rewired the system’s offensive defense equipment and forced in a chemical secondary battery using the high-voltage system of the base’s intranet...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stare at the shell, barely recognizable after the blast, and finally understand why the air stinks of chlorine.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("An electrical explosion...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("When a powerful current passes through metallic foil, the increasing heat causes a huge amount of energy to congregate, which leads to violent explosions and flashes.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("So whoever did this used the layers of folded metallic foil to their advantage. A very effective and deadly contraption indeed.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("But... for this to work, someone’s got to place the metal wire guiding the current in the crack under the door, which is this place’s only exit...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("So, whoever did that would explode alongside the enemies the second the door to the room is opened.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The key hardware of this security system seems to be protected by electromagnetic barriers. I notice that the main control panel can still be activated. Only a few buttons are damaged.")
	await novel_interface.show_text_only("We enter the security system to find that it’s been hacked through. Might have something to do with the military watch connected to the main control panel.")
	await novel_interface.show_text_only("The flash storage in the watch is still accessible. It's easy to tell the identity of its owner from the content.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Seems to be someone really badass.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A few screens at the surveillance station are still working, dutifully playing real-time footage captured by the surveillance cameras.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hope we can find some useful info here.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I take a deep breath and call up the history records.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hmm…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As expected of a top-secret establishment, there are too many records to count. Some of the earlier videos are even stored in VCR files.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Finding anything useful in all this mess will take years!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Quit your whining. There should be an easy way to run a search, or else the UI designer would've been fired already.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Well, there is indeed a mode that lets us efficiently preview all recordings at once, but...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("There are hundreds of surveillance cameras in the base, and the system's been collecting data since the base was first constructed. Only a single twenty-inch screen in front of me is still working. To display everything on it at once... it's impossible.")
	await novel_interface.show_text_only("In despair, I continue to zoom out, until the thumbnails of the footage are all shrunk into mere pixels.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Hey! Look at that!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael whacks me on the head and points at a straight, vertical white line on the screen.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("All the footage caught at this point of time... they're all... white?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("...\\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("I skip to the time point Raphael is referring to and call up the first frame after the part with all the whiteness that's got any content in it.")
	await novel_interface.show_text_only("Coming into view is a tall, broad man.")
	await novel_interface.show_text_only("He’s clad in a cobalt-colored hazmat suit and looks to be around over six feet tall. He strides forward in a steady, quick pace.")
	await novel_interface.show_text_only("He doesn't seem to be mind being filmed—but the resolution is too low for us to clearly see his face.")
	await novel_interface.show_dialog("There's something about him...","Lian")
	await novel_interface.show_dialog("You know him, Master?","Henriette")
	await novel_interface.show_dialog("No...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("The man surveys the place as he strolls forward, as if looking for something.")
	await novel_interface.show_text_only("His steps quicken as he heads from the archive room to the infirmary.")
	await novel_interface.show_text_only("As he passes by two bundled-up soldier corpses, he suddenly stops and bends down to study them.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("That soldier... she's missing a calf?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael and I hold our breaths, horrified by the soldier's leg wound and the dark blood at its edges.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("So a fight happened here, huh...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I can't help recalling the gigantic crack in the floor of the archive room.")
	await novel_interface.show_text_only("Face impassive, the man struts into the infirmary and retrieves a black card from the medicine cabinet. Out of nowhere, he loads his gun.")
	await novel_interface.show_text_only("From the corner of the infirmary, a dark shadow pounces. The man fires several times without missing a beat, sending it flying outside the frame.")
	await novel_interface.show_text_only("He then pulls out a dagger and disappears out of the frame as well. He reappears in a few seconds and tosses a bundle of indistinguishable items into the trash.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Is that... is that...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No way. Can't be.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Following a clear protocol, I see.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... Doesn't matter. Keep watching.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The man calmly shuts the door to the infirmary, then swipes the card to open a metal gate. He seems very familiar with the layout of the base.")
	await novel_interface.show_text_only("After checking to see if it’s empty (it is), the man marches into the tunnel outside the control room.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("What’s this...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The graphics on the screen are kind of grainy, but it’s still easy to tell that the tunnel in the footage had definitely been the site of a bloodbath.")
	await novel_interface.show_text_only("Dozens of dead bodies lie haphazardly in a radial formation, as if a powerful blast has mowed them all down at once.")
	await novel_interface.show_text_only("And at the center of it all kneels a girl clad in white, upper body erect, pierced through by a long-hilted weapon.")
	await novel_interface.show_text_only("She is wearing way too few layers considering that she’s in Antarctica. Her milky skin is dyed a bloody red.")
	await novel_interface.show_text_only("She has a weapon in each hand, gripping them tightly despite having lost consciousness.")
	await novel_interface.show_text_only("The man kneels down in front of her, caresses her face with one hand.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Do they know each other?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("He then circles to her back, grasps the hilt, and slowly pulls out the weapon, revealing a gold-lined spearhead.")
	await novel_interface.show_text_only("The girl's body didn't move at all, and no more blood came out of the wound. There was an indescribable sense of disobedience in the whole process.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Whispers) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The man took off his coat, carefully removed the gun head, wrapped it in cloth and put it inside his suit jacket, and threw the long handle aside.")
	await novel_interface.show_text_only("He then enters the control room. We try to check what he’s up to by switching cameras, but the screen showing the control room shows only static.")
	await novel_interface.show_text_only("We look up and see that the camera in the room has already been completely destroyed in an electric shock.")
	await novel_interface.show_text_only("After a moment, the man reemerges in the corridor, carrying an alloy suitcase around 1.6 feet wide.")
	await novel_interface.show_text_only("The lock of the suitcase seems to be broken. He snaps the case open and takes out three glass vessels.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... What exactly is he doing?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("One of the glass vessels is shattered. The man stares at it, hesitates a bit, then places the two intact ones into his pocket.")
	await novel_interface.show_text_only("Gently, he attempts to retrieve the weapons from the girl’s clenched fists. That’s when a notebook falls out from somewhere in her shirt.")
	await novel_interface.show_text_only("The man picks it up, flips through it, then stuffs it back into the girl’s outfit.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("As if carrying a baby, he carefully picks up the slender, frail girl in his arms. His movements are loving and tender.")
	await novel_interface.show_text_only("He carries her bridal-style all the way to the end of the tunnel, where he taps the black card against the wall.")
	await novel_interface.show_text_only("The wall slides aside, and the two, together, disappear into darkness...")
	await novel_interface.show_text_only("... That’s where the recordings end.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("There is a lengthy period of blankness in all video recordings that come afterward. And the man never reappears in the rest of the footage.")
	await novel_interface.show_text_only("In fact, there is nothing worth seeing in the footage to follow. Nothing, until the three of us turn up at the entrance of the base.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("That’s weird...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Wait, look.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael points to the screen showing the infirmary.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Wasn’t there a corpse right there? It’s... gone.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In fact, all the corpses are gone...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("This means that during the blank periods in the footage, the battle sites had been completely tidied up.")
	await novel_interface.show_text_only("We start checking back, looking through earlier records.")
	await novel_interface.show_text_only("We manage to find footage recording what happened to the girl and her squad.")
	await novel_interface.show_text_only("The last frame we see, captured by the control room camera, is a lady in a snow suit, forcing the black-haired girl out of the door with a gun.")
	await novel_interface.show_text_only("That’s where the recording ends.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... So that was what happened here...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I exit the data interface and call up the real-time surveillance footage.")
	await novel_interface.show_text_only("We have coverage of the main entrance, the exhibit room, the corridors, the archive, the tunnels... and some other locations we haven’t been to.")
	await novel_interface.show_text_only("As I scan the screen showing real-time footage, it suddenly occurs to me that the battle we had back outside the archive room hasn’t been recorded. At all.")
	await novel_interface.show_text_only("According to the video, the three of us entered the archive room from the corridor and never exited it. Instead, we arrived in the tunnel from an opening on the other side.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("So did that fight happen in a “dream”? How strange...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("And just who cleared up the place?","Raphael")
	await novel_interface.show_dialog("... Someone must have meddled with the footage as well.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("We can’t even find footage of the tall man leaving the premises.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I sift through the real-time surveillance screens mechanically, as the three of us debate the identities of the girl and man we just saw.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Wait...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s reasonable for us to think that someone may have messed with the recordings and that we were in a “dream”.")
	await novel_interface.show_text_only("What’s unreasonable is—")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Why can we see the real-time footage of the archive room?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael and Henriette freeze instantly.")
	await novel_interface.show_text_only("The room is eerily silent for a few seconds.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Didn’t we...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... pull out the cable before leaving the room?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("What's that important question again…")
	await novel_interface.show_text_only("—How did I come here?")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("My bladder is demanding attention again. Dang.")
	
	print("=== 潜渊症篇第25话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
