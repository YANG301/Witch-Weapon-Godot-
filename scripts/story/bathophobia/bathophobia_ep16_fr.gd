# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Rapha?l a trouvé quelques réservoirs de diesel au deuxième étage, ce qui devrait permettre de faire fonctionner le dépôt pendant quelques jours.")
	await novel_interface.show_text_only("Alors que le courant est rétabli au milieu du grondement du générateur, je me précipite immédiatement dans la salle de bain.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Utiliser les toilettes dans le noir serait certainement la dernière chose que je voudrais faire…)", "Lian")
	await novel_interface.show_dialog("(Dieu merci, ils n'en ont pas fait une salle de bain transparente…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Putain de merde…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je sors de la salle de bain, le ventre toujours douloureux. Annie semble un peu rétablie et est capable de se remettre sur pied.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, ça va ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Ouais, je vais bien. Allons vérifier la salle de communication…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Comme elle arrive à peine à se tenir droite, je l'aide jusqu'au deuxième étage.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("La salle de communication est assez rustique à l'intérieur, où une allée en forme de T mène jusqu'au mur incurvé de la zone d'observation.")
	await novel_interface.show_text_only("Les armoires sont remplies d’eau potable, de conserves et d’autres aliments non périssables.")
	await novel_interface.show_text_only("L'air ici semble plutôt frais. Par la fenêtre, nous pouvons voir les aurores danser dans le ciel nocturne.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Voyons si le système fonctionne…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle essaie de démarrer l'ancien équipement sur le panneau de commande. Heureusement, tout le matériel « la fiabilité avant tout » fonctionne toujours.")
	await novel_interface.show_text_only("En tant qu'agent SID bien formé, Annie connaît assez bien le système. Les antennes installées à l’extérieur du dépôt ne semblent pas très affectées par les températures extrêmes.")
	await novel_interface.show_text_only("À travers les bouches d’aération dans le mur, un flux d’air chaud et humide s’écoule lentement dans la pièce.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("On dirait que le système de chauffage est allumé.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je jette un coup d'œil à l'affichage de la température fixé au mur, qui indique que la température intérieure augmente régulièrement à partir de 32°F.")
	await novel_interface.show_text_only("Mais la température extérieure… -44°F ?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("S'il n'y avait pas eu la topaze d'Heinrich…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Porter une jupe à une température de -44°F et jouer dans la neige…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Je suppose que j’ai débloqué un nouveau succès dont je peux me vanter…)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Attendez… Nous ferions mieux de prendre contact avec Mariru dès que possible. Elle seule peut nous sortir d'ici.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(En parlant de ça, qu'est-ce qui ne va pas avec la puce ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je touche instinctivement ma poitrine. Je n'ai jamais été aussi impatient d'entendre la voix de Mariru de là-bas.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Connexion aux satellites… Terminé.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En suivant les instructions de Annie, j'entre une chaîne de chiffres qui est gravée depuis longtemps dans mon esprit.")
	await novel_interface.show_text_only("Je suppose que je dois remercier Mariru de m'avoir forcé à apprendre par cœur les codes d'identification cryptés de SID.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("C'est comme ça que ça marche ! Intéressant…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Depuis notre arrivée au dépôt, Heinrich est tellement absorbé par l'observation des matériaux et des objets stockés ici.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("J'ai toujours voulu les sentir dans mes mains !", "Henriette")
	await novel_interface.show_dialog("Quelle merveilleuse combinaison de sable, d’aluminium, de calcium, de métaux combustibles et de basalte…", "Henriette")
	await novel_interface.show_dialog("Et le processus de fibrage a modifié toutes leurs propriétés.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Hum ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ils ont utilisé une nouvelle combinaison de matériaux pour fabriquer ce verre. C’est quelque chose dont je n’ai jamais entendu parler.", "Henriette")
	await novel_interface.show_dialog("Leur méthode peut éviter les pertes de chaleur… C'est vraiment intelligent.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mais nous, alchimistes, préférons utiliser les inscriptions de conversion d’énergie, ce qui est beaucoup plus simple.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Inscriptions… Vous voulez dire la magie ?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Qui utiliserait la magie pour fabriquer un morceau de verre ?! Vous pourriez en perdre la tête !)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Mais les produits en caoutchouc présentés en petits paquets m'ont vraiment impressionné par leur extraordinaire flexibilité.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Et les parfums fruités… A quoi servent-ils ?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Je… je ne sais pas !!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("C'est juste du chewing-gum, espèce de stupide pervers.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l lève les yeux au ciel.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Pour l'amour de Dieu, Heinrich s'est pleinement absorbée dans le monde de l'alchimie !")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("De retour au quartier général, Mariru et Aya recherchent Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Toujours aucun signe de la puce de Ren. C'est bizarre. Le cluster de satellites couvre littéralement tous les coins du globe…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Serait-ce une téléportation extraterrestre ou une distorsion temporelle ?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Comme le dit le proverbe, « les entités ne doivent pas être multipliées au-delà de la nécessité ». Des hypothèses plus simples ont plus de chances d’être correctes.", "Mariru")
	await novel_interface.show_dialog("En fait, les soi-disant « satellites globaux » couvrent seulement entre 70°N et 70°S.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu veux dire…", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Une confirmation de connexion apparaît soudainement via le canal de communication crypté de SID.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("He-bonjour ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru ! C'est moi !! \\nOh mon Dieu, enfin…", "Lian")
	await novel_interface.show_text_only("En entendant la voix familière, Mariru revient bientôt à elle. La tension semble instantanément disparue.")
	await novel_interface.show_text_only("Les yeux rivés sur le signal hors ligne, elle lance immédiatement la procédure de traçabilité.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ren ? Signalez votre emplacement. \\nEs-tu avec les autres filles ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Oui, je suis maintenant dans un dépôt avec Rapha?l et Annie. \\nNous sommes en sécurité ici, mais…", "Lian")
	await novel_interface.show_dialog("Nous sommes maintenant… en Antarctique.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("L'Antarctique ?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("De toute évidence, c’est une réponse au-delà de toute attente, mais il n’y a aucune lueur de surprise sur le visage de Mariru.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(On dirait que Ren ne souffre pas d'hypothermie.) \\n(Ils ont dû trouver un endroit sûr.)", "Mariru")
	await novel_interface.show_dialog("(Y a-t-il eu un autre flux spatio-temporel pendant l'expérience à la base Ark ?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le résultat du traçage apparaît à l’écran – Non. 2 Dépôt commun en Terre Princesse Elizabeth, Antarctique oriental.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Tout cela a du sens maintenant… Les satellites en orbite terrestre basse ne survoleront pas cette zone à moins que leurs orbites ne soient modifiées manuellement.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Parce que le vent solaire polaire interrompra la transmission des données.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("J'ai complètement oublié…", "Ai")
	await novel_interface.show_dialog("Devons-nous connecter les satellites au-dessus de l'Antarctique ?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh-hum. N'oubliez pas de ne pas réveiller ces vieux chiens endormis.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Je ne sais pas ce qui s'est passé… J'ai été amené ici tout d'un coup.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("A part vous trois, y a-t-il quelqu'un d'autre ?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Tu veux dire Heinrich ? \\nElle est juste à côté de moi.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Je ne m'attendais pas à ce que nous puissions entrer en contact avec Mariru grâce à un équipement aussi ancien. Je dois admettre que la voix de Mariru m'a apporté un grand soulagement.")
	await novel_interface.show_text_only("Je la briefe sur la situation actuelle.")
	await novel_interface.show_dialog("…très bien noté.", "Mariru")
	await novel_interface.show_dialog("Écoute, tu es maintenant très proche du pôle Sud, ce qui veut dire que venir te chercher n'est pas si simple.", "Mariru")
	await novel_interface.show_dialog("Selon la Nouvelle Convention de l'Antarctique d'après-guerre, tout pays souhaitant envoyer une équipe d'expédition de plus de 5 membres…", "Mariru")
	await novel_interface.show_dialog("… Ou alors, un avion là-bas doit demander l’autorisation du Congrès américain.", "Mariru")
	await novel_interface.show_dialog("Et l’avion devra probablement faire escale en Nouvelle-Australie…", "Mariru")
	await novel_interface.show_dialog("Donc même si nous parvenons à décoller en 1 heure et à effectuer toutes les procédures pendant le vol, il nous faudra environ 40 heures pour y arriver.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ce sera bien. Le générateur ici peut durer quelques jours et nous avons assez de nourriture pour survivre.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("L'aire de trafic la plus proche de vous est 68° 24' S et 76° 55' E, à environ 800 mètres de vous.", "Mariru")
	await novel_interface.show_dialog("Compte tenu des conditions météorologiques imprévisibles dans l’Antarctique, nous risquons de perdre le contact avec vous à tout moment. Si cela arrive, n'oubliez pas que je vous y retrouverai.", "Mariru")
	await novel_interface.show_dialog("Il s'agit d'une grande base nommée Snedronningen, qui signifie littéralement la reine des neiges, et la plupart de ses installations ont été construites sous terre...", "Mariru")
	await novel_interface.show_dialog("Quant aux détails… Nous vous tiendrons au courant. Ren,… ce merdier rrrerrk…", "Mariru")
	await novel_interface.show_text_only("La voix de Mariru est avalée par un soudain bruit électrique.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru ? Bonjour?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("He-bonjour ? Pouvez-vous m'entendre?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le bruit au centre de communication devient de plus en plus fort.")
	await novel_interface.show_dialog("Il se peut qu'il y ait une explosion de vent solaire… Vous feriez mieux… de vérifier la réception du signal maintenant.", "Mariru")
	await novel_interface.show_text_only("Waouh——")
	await novel_interface.show_text_only("Alors que le bruit électrique devient plus fort, la voix de Mariru disparaît du récepteur.")
	await novel_interface.show_text_only("Un silence s'impose sur nous.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Je suppose… nous avons encore perdu contact avec eux…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Quarante heures ? Tu ferais mieux de prier pour qu'il n'y ait plus de surprise.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela me donne de mauvaises ondes mais je ne sais pas pourquoi.")
	await novel_interface.show_text_only("À l’extérieur de la fenêtre, les aurores ont toutes disparu avec les signaux qui s’estompent et même le faible vent s’est calmé.")
	await novel_interface.show_text_only("Les seuls bruits que nous entendons désormais proviennent des radiateurs des ordinateurs et des ventilateurs de climatisation.")
	await novel_interface.show_text_only("Un tel silence me rappelle toujours le calme avant la tempête…")
	await novel_interface.show_text_only("Soudain, le panneau de commande tremble un peu.")
	await novel_interface.show_text_only("Non, c'est impossible. J'ai dû perdre pied à l'instant.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Avez-vous ressenti cela ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Tu veux dire le…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le léger tremblement devient de plus en plus violent.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Oh mon Dieu… Vous vous moquez de moi ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En tenant le panneau de commande pour me soutenir, je sens mon cœur s'emballer.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Qu'est-ce que c'est… ?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un bruit rugissant vient du sol sous nos pieds.")
	await novel_interface.show_text_only("Le bâtiment commence à trembler si violemment que nous pouvons à peine nous tenir droit.")
	await novel_interface.show_text_only("Tout sur la table rebondit comme des Pop Rocks qui se dissolvent dans la bouche.")
	await novel_interface.show_text_only("Un horrible bruit de craquement provient des glaciers au loin.")
	await novel_interface.show_text_only("Un coup d’œil par la fenêtre confirme ma crainte…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("C'est un tremblement de terre !", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
