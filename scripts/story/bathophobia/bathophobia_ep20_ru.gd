	await novel_interface.hide_character()
	await novel_interface.show_dialog("Понял!","Член отряда C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Я проверил трехмерную карту этого места. Лучшее, что мы можем сделать сейчас, — направить... \\n... вниз, в направлении на восемь часов.","Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все члены отряда ранены разной степени тяжести. Но они все равно продолжают идти, прикрывая друг друга в виде двух групп: ведущей и замыкающей.")
