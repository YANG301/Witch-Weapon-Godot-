	await novel_interface.show_text_only("Они определенно не смогут справиться с этими необычайно проворными врагами снаружи, в снегу, без препятствий, за которыми можно спрятаться.")
	await novel_interface.show_text_only("Однако это также не оставляет им иного выбора, кроме как продвигаться глубже в базу в поисках стратегически выгодной позиции, где они могли бы обратиться за поддержкой.")
	await novel_interface.show_text_only("Их загоняют все дальше и дальше внутрь, из выставочного зала, в коридор.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_dialog("Отстой. Здесь нет сигнала.","Член отряда C")
	novel_interface.show_character("milk_battle","solemn")
