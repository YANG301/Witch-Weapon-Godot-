	await novel_interface.show_dialog("……\\n（「不在現實世界」嗎？ ）","莉琉")
	await novel_interface.show_dialog("等等，我確認一下時間。","莉琉")
	await novel_interface.show_dialog("從妳們在基地門口最後一次與安妮聯絡開始，已經過了8分鐘。","莉琉")
	novel_interface.show_character("ren_battle","panic")
