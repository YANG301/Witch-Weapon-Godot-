	await novel_interface.show_dialog("薩蒙頓的戴克斯博士倒是提出了利用嗜甲烷古菌的方案……","莉琉")
	await novel_interface.show_dialog("但耐寒的菌種目前庫存嚴重不足，那種古代菌種的培養週期又太長。","莉琉")
	novel_interface.show_character("raphael","normal1")
