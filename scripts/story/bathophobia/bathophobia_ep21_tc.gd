# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("走廊上突然出現了一群人，並直接朝我們衝過來。")
	await novel_interface.show_text_only("她們一言不發，除了衣物摩擦和腳步聲之外，甚至連呼吸都沒有聲音。")
	await novel_interface.show_text_only("我握緊武器正準備應戰，海因里希的戰服卻突然發出強光並瞬間消失，只留下一片光霧。")
	await novel_interface.show_text_only("在我還在錯愕時，海因里希已經閃到一人身前，用青金石的劍背痛擊其中一個女人的胸甲。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("──好快！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("鈍擊發出的巨大悶響迴盪在走廊間，我不禁偷偷捂住了胸部……")
	await novel_interface.show_text_only("轟一聲之後，那人像木偶般被擊倒，並順著打擊的力道向外滾出一大段距離。")
	await novel_interface.show_text_only("但是那傢伙並沒有任何人類在落地時自然反射的自我保護動作。")
	await novel_interface.show_text_only("滾動停止後，那個胸部凹陷的傢伙再次拿起武器朝我們衝來。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("……！","拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("海因里希察覺到不對勁，轉身以極快的速度用劍鋒刺穿了三人的腳跟。")
	await novel_interface.show_text_only("但是，她們即使被斬斷腳筋癱倒在地，卻依然一邊抽搐身體一邊爬向我們，而且始終一言不發。")
	await novel_interface.show_text_only("雖然這些敵人不是很強，但這種以人類的軀體所表現出的非人性…")
	await novel_interface.show_text_only("如同恐怖谷效應一樣，令人更加不寒而慄……")
	await novel_interface.show_text_only("確認這些敵人無法再構成威脅後，拉斐爾上前試圖治療對方。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("突然間，地面再次顫抖。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("又地震了！","海因里希")
	await novel_interface.show_text_only("這次的晃動更加猛烈，也更久。")
	await novel_interface.show_text_only("走廊的燈光隨之忽亮忽暗，遠處傳來無法分辨是哀嚎還是金屬延展的刺耳聲。")
	await novel_interface.show_text_only("那幾個癱在地上的人，搖晃中就像被震碎的浪花，在我們面前漸漸變成透明的……液體？") #换行问题
	await novel_interface.show_text_only("液體隨後開始冒出大量的氣泡，就像落在炙熱鐵板上的水珠，幾秒不到就蒸發殆盡。")
	await novel_interface.show_text_only("冰冷的地面上，什麼痕跡都沒有，彷彿那些詭異的「人」從未存在過。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("搖晃停止後，我們發現周圍環境也變了模樣。")
	await novel_interface.show_text_only("資料室的木製品化成了碎屑，在空氣中飄散，牆壁也變得破舊斑駁。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("……哎？ 這裡跟剛才……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("看起來依舊是那間資料室。")
	await novel_interface.show_text_only("但是，此時房內幾乎沒有光源，地磚不再光可鑑人，書架上物品的擺放方式也截然不同。")
	await novel_interface.show_text_only("厚重重工業感的鋼鐵橫樑後面，另一隻聲音感應監視器將黑洞洞的鏡頭對準了我們。")
	await novel_interface.show_text_only("牆上掛著一張精美的南極地形圖，桌上攤著一本記錄著大氣數據變化的本子。")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("這是……怎麼回事！","小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("剛才……難道是幻覺嗎……","海因里希")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("那群傢伙也是假的？","拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("海因里希低頭看著手中沒有半點血跡的武器，然後抬頭面色凝重地打量著那些人蒸發的地方。")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("恐怕……剛才，我們並不在現實世界裡……","海因里希")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("海因里希被莉統的聲音突然打斷。")
	await novel_interface.show_dialog("總算聯絡上了！","莉琉")
	await novel_interface.show_text_only("我的胸前傳出莉琉的聲音。")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("莉琉！ 剛才訊號出問題了嗎？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉嗯了一聲，聲音聽起來有些疲憊，海因里希則是一臉訝異地盯著我的胸部。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("（等等，不管妳要說什麼，妳一定是誤會了！ ！）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("海因里希看著我，彷彿心領神會地點了點頭，然後用手輕輕在自己胸前摸索。")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("（小聲）主人對我……也做了這樣的改造嗎？","海因里希")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("沒有！ 並沒有！ ！！ 為什麼妳好像很期待似的？ ！")
