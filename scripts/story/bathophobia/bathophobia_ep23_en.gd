# bathophobia_ep23.gd - 深海恐惧症篇第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep23_script()

func play_script():
	pass

func bathophobia_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Request access... okay, done. We’re in.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beep—\\nThe door to the control room swings open.")
	await novel_interface.show_text_only("The indoor sound monitor was turned on at the same time, and White Candle and Milk walked into the room, supporting each other.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("*Coughing*","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("*Heavy panting*","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","smile")
	await novel_interface.show_dialog("We should be safe here... for now.","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","serious")
	await novel_interface.show_dialog("Yeah. I’ll check the system.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk walks over to the control panel and checks out the messages on the screen. They don’t talk about the elephant in the room—the skills that Beth had just unleashed. Clearly not human.")
	novel_interface.show_character("milk_battle","pleased")
	await novel_interface.show_dialog("Ooh, they‘re using Genuine for their security system. Nice.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk loves boasting about her hacking expertise to Beth. The Genuine system—piece of cake for her. She’s done much harder.")
	novel_interface.show_character("milk_battle","pleased")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("baizhu_break","think",0.25)
	await novel_interface.show_dialog("Milk, I...","Beth")
	novel_interface.character_light(0.35,"laugh")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Shh, it’s fine, I get it.","Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Milk pets the shaken younger girl on the head with one hand, fondly.")
	await novel_interface.show_text_only("She really does get it. It’s not like her friend had been hiding her skills on purpose to spite her.")
	await novel_interface.show_text_only("After all, if the Boss found out, he’d be way too delighted to utilize this “tactical resource” to the max.")
	await novel_interface.show_text_only("As she pets her head, Milk removes a black metal hairpin from Beth’s hair. Beth stares, confused.")
	await novel_interface.show_text_only("Milk makes a face at her and crouches down swiftly, disappearing under the control panel desk.")
	await novel_interface.show_dialog("If I use a metal object to short-circuit the system, it triggers the automatic overload defense.","Milk")
	await novel_interface.show_text_only("After a tiny, fizzling sound, the two rows of indicator lights on the panel go out at once. The central screen is now all static.")
	await novel_interface.show_text_only("Scrambling out from under the desk, Milk pulls out a data cable from inside her watch and plugs it into the desktop jack.")
	await novel_interface.show_text_only("Seconds later, the indicator lights blink on again, and the fans begin whirring once more as well.")
	novel_interface.show_character("milk_battle","serious")
	await novel_interface.show_dialog("As long as I add the flash memory into the self-test queue before the system restarts, we’ll be able to enter the code.","Milk")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("See? This security system... not so secure after all.","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","mock")
	await novel_interface.show_dialog("So no matter how seamlessly the software is designed, there’s still a way to break in through the hardware...?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk had ranted to Beth about stuff like this, when they were having lunch together in their favorite teahouse. Beth didn’t understand a word, of course.")
	await novel_interface.show_text_only("Milk continues glaring at the screen, typing in quick commands with her left hand, sending Beth a finger heart with her right.")
	await novel_interface.show_text_only("A finger heart—so out-of-place in a situation like this, yet to Beth, it feels like warmth, relief, home.")
	await novel_interface.show_text_only("There’s no need to explain her skills to Milk after all. They’re... soulmates, right?")
	await novel_interface.show_text_only("Milk has overridden the system and is now running one of her own softwares, gradually gaining control over all monitoring devices in the base.")
	await novel_interface.show_text_only("Beth stands there, observing the other devices in the room. There’s a row of equipment next to the main control panel, but she has no idea what those are used for. Nor does she have time to find out.")
	await novel_interface.show_text_only("On the large screen in front of Milk, surveillance camera footage begin popping up.")
	await novel_interface.show_text_only("In the center of the screen, the enemies shot to the ground by the squad are slowly getting back to their feet, limbs still distorted.")
	await novel_interface.show_text_only("They’re moving slowly, but their wounds are gradually healing.")
	await novel_interface.show_text_only("Milk zooms in. There’s a green, vine-like organism attaching itself to the wounds like a sort of net.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("(I’ve seen something like that before in a report...)","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That’s a kind of ivy-like plant that’s been genetically modified to latch onto humans, steal their consciousness and make them zombie-esque killing machines.")
	await novel_interface.show_text_only("Milk knows only too well what damage this kind of technique could bring on the battlefield.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("... We’re in trouble.","Milk")
	await novel_interface.hide_character() 
	await novel_interface.show_text_only("Following Milk’s Gaze, Beth turns to the monitor on the left.")
	await novel_interface.show_text_only("According to the surveillance footage, besides those who had engaged the squad in battle, there are at least two other groups of enemies currently in the base.")
	await novel_interface.show_text_only("One of them, the two had just shaken off three minutes ago. The other group, consisting of seven, eight members, is currently moving in neck-breaking speed towards the east wing.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(If this goes on, the closest group of enemies will come upon us within three minutes.)","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth turns her direction to another set of footage, where she finds blurry images of the rest of the squad members who’ve gotten separated from them not long ago.")
	await novel_interface.show_text_only("The member holding the shield has lost half a leg and is currently on a stretcher, which two others are carrying towards the infirmary.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(They don’t have much ammo left, it seems. If they continue along the east wing like this, they’ll encounter another group of enemies within five minutes.)","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Is that...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk notices a figure on one of the small windows.")
	await novel_interface.show_text_only("It’s the fastest enemy of the group. She’s just wandering along the corridor now, swinging a blood-stained boot that belonged to one of the squad members.")
	await novel_interface.show_text_only("As if sensing Beth’s gaze, she tilts her face up towards the camera, and smiles—a horrifying, toothless grin.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Darn it!","Milk")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("baizhu_break","normal",0.25)
	await novel_interface.show_dialog("Stay calm, stay calm.","Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth pats Milk comfortingly on the shoulder, then begins rapidly scanning the dozens of monitoring screens in the room.")
	await novel_interface.show_text_only("She quickly puts together a 3D layout map of the base in her head and compares it with the footage, in attempt to come up with the most optimal plan possible.")
	await novel_interface.show_text_only("Milk can tell that Beth’s in one of those calculating modes just by glancing at her face. When she’s having one of those episodes, there’s no snapping her out of it.")
	await novel_interface.show_text_only("But considering the situation, there’s really no way she can come up with a workable plan... right?")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Mm. Bethy’s good at this...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk’s voice fades away into a whisper.")
	await novel_interface.show_text_only("She notices on the screen that the group of enemies combing through the east wing has somehow skipped checking an alloy barrier.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("…","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk closes her eyes, ponders, then makes up her mind.")
	await novel_interface.show_text_only("In a flash, she types in a series of commands on the keyboard and sends them.")
	await novel_interface.show_text_only("An underground military data center, located in the hills somewhere in Asia, will receive the message within ten seconds.")
	await novel_interface.show_text_only("Not a plea for help, but a message informing them of the squad’s demise.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("(... I’m sorry.)","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk smiles sadly at Beth, who’s still deep in thought.")
	await novel_interface.show_text_only("The dark-haired girl seems to be glowing in a faint silver color.")
	await novel_interface.show_dialog("... Bethy...","Milk")
	await novel_interface.show_dialog("You remember when we first met?","Milk")
	novel_interface.show_character("baizhu_break","shock")
	await novel_interface.show_dialog("Hmm?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth, still immersed in her planning, barely notices what Milk is doing.")
	await novel_interface.show_dialog("Back then, I stole a research report right in front of you. Remember that?","Milk")
	novel_interface.show_character("baizhu_break","smile")
	await novel_interface.show_dialog("Why mention this all of a sudden?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You’ve never asked me why I did that, and who I did it for.","Milk")
	await novel_interface.show_text_only("Beth turns around, finally detecting the strange emotions in Milk’s voice.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("milk_aim","normal")
	await novel_interface.show_text_only("She looks up to meet the eyes of her leader, who’s pointing at her with a revolver in one hand.")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("You’ve always been like this...","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","normal")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth determinedly ignores Milk’s strange behavior.")
	await novel_interface.show_text_only("She glances back at the screens, and pushes the muzzle out of the way impatiently.")
	novel_interface.show_character("baizhu_break","speechless")
	await novel_interface.show_dialog("Stop kidding around. We have less than a minute. Those guys will find us soon.","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk laughs, self-deprecatingly.")
	novel_interface.show_character("milk_aim","gratified")
	await novel_interface.show_dialog("See? I’m pointing a gun at you. And still, you trust me...","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","smile")
	await novel_interface.show_dialog("I know you’ll never hurt me.","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk gulps at the words, knowing that her friend sees right through her.")
	await novel_interface.show_text_only("She loads her pistol, pops the safety off, places her finger on the trigger, and points it right back at Beth.")
	novel_interface.show_character("milk_aim","gratified")
	await novel_interface.show_dialog("Stand back.","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth suddenly gets a vague idea of what exactly her leader is planning.")
	novel_interface.show_character("milk_aim","solemn")
	await novel_interface.show_dialog("—Stand back!","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth backs up until her back is up against the back door of the control room.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("The door swings open, revealing a sloping passage.")
	await novel_interface.show_text_only("Beth continues backing up, with Milk’s gun muzzle still pointing between her eyes.")
	novel_interface.show_character("milk_aim","gratified")
	await novel_interface.show_dialog("Hey, you remember that question?","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("Stop kidding around, Milk...","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_aim","gratified")
	await novel_interface.show_dialog("There’s a train that simply can’t stop. There’s two ways it can go. One way, it crushes your teammates. Another, it crushes you.","Milk")
	await novel_interface.show_dialog("Who do you save?","Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("—Milk!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The grief on Milk’s face is obvious, tragically so.")
	novel_interface.show_character("milk_aim","mock")
	await novel_interface.show_dialog("I choose to save... the one I love...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With a shrewd smile, Milk charges forward, forcing Beth into a trapdoor on the tunnel wall.")
	await novel_interface.show_dialog("Huh...?","Beth")
	await novel_interface.show_text_only("Before Beth can even react, she’s rolling down the stairs into one of the only secret warehouses in the base, protected by an alloy barrier.")
	await novel_interface.show_text_only("A barrier that can only be opened from the outside.")
	novel_interface.show_character("milk_aim","mock")
	await novel_interface.show_dialog("Bethy...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The digital voice speaks in a monotone.\\n“Security system locked. Barrier closing.”")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Locking.png")
	await novel_interface.show_text_only("In front of Beth’s eyes, Milk smiles, brighter than ever.\\nThe barrier gates begin to close.")
	await novel_interface.show_text_only("Too quickly.")
	await novel_interface.show_dialog("“Three...”","System")
	await novel_interface.show_dialog("Let’s celebrate next Christmas together. What do you say?","Milk")
	await novel_interface.show_dialog("“Two...”","System")
	await novel_interface.show_text_only("Beth reaches out desperately, trying to clutch at Milk, but the latter shrinks away, sends her a flying kiss.")
	await novel_interface.show_dialog("“One...”","System")
	await novel_interface.show_text_only("Beth stares in disbelief.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Locking2.png")
	await novel_interface.show_text_only("One second left. Beth’s face distorts, a thousand emotions surfacing at once.")
	await novel_interface.show_dialog("Come on, smile! Smile for me!","Milk")
	await novel_interface.show_text_only("That’s the last thing Beth hears before the barrier gates slam shut, merciless, emotionless.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("The sound of Beth pounding on the wall echoes through the tunnel.")
	await novel_interface.show_text_only("How heavy it sounds, on the multiple layers of Ti-451 alloy boards...")
	
	print("=== 深海恐惧症篇第23话结束 ===")
	
	await novel_interface.end_story_episode(0.5)
