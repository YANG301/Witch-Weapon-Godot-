# bathophobia_ep22.gd - 潜渊症篇第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep22_script()

func play_script():
	pass

func bathophobia_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("... Здесь нет сигнала. Совсем.","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Означает ли это, что мы снова в этом «сне»?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В любом случае, система вентиляции по-прежнему работает в полную силу. Мы слышим шум вентиляторов даже из вентиляционного отверстия в архивной комнате.")
	await novel_interface.show_text_only("Судя по карте, эта база, несмотря на то, что была построена очень давно, построена строго по нормам для сверхсекретных организаций.")
	await novel_interface.show_text_only("Доступ между разделами жестко ограничен. И есть бесчисленное множество независимых единиц, разделенных барьерами из усиленного сплава.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("На карте не указано, что делает большинство этих комнат. Должны ли мы обыскать их всех?","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Это... такой сложный...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Чтобы прочесать все это место, потребовались бы часы. Прикроватные, мы даже понятия не имеем, что ищем.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("А за углами могут скрываться и другие сумасшедшие враги.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эти странные девочки-марионетки, с которыми мы только что столкнулись, __ЭЛЛИПСИС__, от одной мысли о них у меня учащается сердцебиение.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Ну, я, например, отказываюсь быть сидячей уткой!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия стучит кулаком по столу, поднимая облако пыли.")
	await novel_interface.show_text_only("Звукочувствительная камера наблюдения за металлической балкой слегка меняет угол наклона, реагируя на внезапный шум.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Возможно, сейчас самое время задать вопрос, который преследовал меня с тех пор, как я вернулся на станцию снабжения.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Эй, ты,..., можешь почувствовать, из какого материала что-то сделано?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка ухмыльнулась на мой вопрос.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Конечно. Это базовый навык для всех алхимиков Розенкройцера.","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Тогда, если... есть действительно очень длинный изолированный металлический провод, сможете ли вы проследить его на всем пути и найти, куда он ведет?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Если я могу прикоснуться к этому, я смогу это сделать.","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Вы имеете в виду…","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я киваю Рафилии. Вместе мы оборачиваемся и смотрим в темный угол комнаты __ЭЛЛИПСИС__")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Red_Dot.png")
	await novel_interface.show_text_only("Где красная точка света ритмично появляется и исчезает из поля зрения, как будто у нее был пульс.")
	await novel_interface.show_text_only("Звукочувствительная камера наблюдения.")
	await novel_interface.show_text_only("На обширной подземной базе должны быть кучи этих устройств.")
	await novel_interface.show_text_only("Все это должно привести к одному месту:")
	await novel_interface.show_dialog("Диспетчерская.","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("... Метель прервала сигнал?","Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("GPS-чип Рена больше не передает данные.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Если связь будет потеряна до такой степени, это также повлияет на миссии в районах, покрытых заряженными частицами высокой энергии, верно?","Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Ребята из SRD, вам нужно улучшить свою игру.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru закатывает глаза на Аю, которая высовывает язык.")
	novel_interface.show_character("liliu_uniform1","sigh")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Ну, в конце концов, мы на Южном полюсе. Конечно, условия здесь другие.","Ai")
	novel_interface.change_2nd_expression("blush_stare")
	await novel_interface.show_dialog("Тем не менее, просто так терять сигнал... наши устройства не настолько бесполезны.","Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы имеете в виду, что есть... другие причины, вызывающие отключение?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_dizzy")
	await novel_interface.show_dialog("Ага. Я не знаю, что это такое, но это должно быть мощно... \\nЯ конечно завидую тому, кто стоит за этим...","Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru задумчиво смотрит на устройство в своей руке и на мигающее слово «ОТКЛЮЧЕНО» на экране.")
	await novel_interface.show_text_only("Тем временем Ая наблюдает за лицом Mariru.")
	novel_interface.show_character("liliu_uniform1","serious")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Вы похожи на владельца домашнего животного, который беспокоится о своем сбежавшем котенке.","Ai")
	novel_interface.character_light(0.35,"sigh")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("В любом случае, нам ничего не остается, как ждать.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая выдыхает, поворачиваясь лицом к окну.")
	novel_interface.show_character("liliu_uniform1","sigh")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Высота 37 000 метров над уровнем моря. Как будто мы уже в открытом космосе.","Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если мы поднимемся еще выше, наш радар и связь перестанут работать.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru бросает взгляд на рабочее место своего крейсера, где более тридцати сотрудников разведки деловито сортируют данные, поступающие со всех уголков мира.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Этот скоростной тяжеловоз... \\nВы давно на него положили глаз, да?","Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ха. В Сенате наверняка припасено кое-что интересное.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Еще три часа, прежде чем мы достигнем Антарктиды...","Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Если какая-либо часть тела Рена сломается, у нас будут огромные проблемы.","Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заметив, что Ая с тревогой кусает ногти, Mariru стучит костяшкой пальца по затылку.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Эй.","Mariru")
	await novel_interface.show_dialog("Как вы думаете, кто обучал этих ребят?","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("<База Снедроннинген>")
	await novel_interface.show_text_only("Следуя указаниям Генриетты, прослеживаем кабель, подключенный к устройству наблюдения, до самой глубины базы.")
	await novel_interface.show_text_only("Коридоры здесь становятся все более узкими. Стены голые, как будто строительство еще не завершено.")
	await novel_interface.show_text_only("Наши шаги эхом отражаются от стен туннеля. Противный. Слишком жутко. Я чувствую, как мое сердце бьется в груди.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Сейчас неподходящее время для этого, но...")
	await novel_interface.show_text_only("Но чем больше я нервничаю, тем труднее удержаться в...")
	await novel_interface.show_text_only("Я останавливаюсь как вкопанный, поднимаю руку.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Эй…","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Что теперь?","Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Могу ли я...","Lian")
	await novel_interface.show_dialog("Сходить к... в туалет?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("И вот я в, казалось бы, бесконечном туннеле без дверей и ответвлений, с двумя девушками. И я прошу в туалет. Я хочу спрыгнуть со скалы.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("…","Raphael")
	novel_interface.change_2nd_expression("subtle")
	await novel_interface.show_dialog("Вы хоть осознаёте серьёзность ситуации?","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я..., извините! Я ничего не могу с этим поделать, ясно?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я крепче сжимаю бедра, пытаясь смотреть куда угодно, только не на явное отвращение лицо Рафилии.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","subtle",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Чем больше я нервничаю, чем больше говорю себе не думать об этом, тем хуже я себя чувствую... )","Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я близок к тому, чтобы обссаться в штаны...")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("(Чем я заслужил это?)","Lian")
	await novel_interface.show_dialog("Э-э, если у кого-то из вас есть пластиковая бутылка или что-то в этом роде, я мог бы __ЭЛЛИПСИС__","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ А?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ох, о чем я вообще говорю?")
	await novel_interface.show_text_only("Раньше Рафилия считала меня извращенцем, но теперь... она, вероятно, считает меня мусором.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Вам нужно что-нибудь, чтобы сдержать мочу, да, Мастер? Ну, я мог бы попробовать подделать некоторые материалы...","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетте, кажется, это слишком нравится.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Давай! Ты знаешь, что я не это имею в виду!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Увидев отчаяние в моих глазах, алхимик наконец сжалился надо мной и вырезал в стенах туннеля дыру подходящего размера.")
	await novel_interface.show_text_only("За стеной находится что-то похожее на рабочее помещение — темное, затхлое и, самое главное, с туалетом.")
	await novel_interface.show_text_only("Да здравствует алхимия!")
	await novel_interface.show_text_only("Я сразу же протискиваюсь в дыру, не желая больше стоять под пристальным взглядом Рафилии.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Кажется, здесь температура ниже. Стены покрыты тонким слоем льда, и я вижу, как мое дыхание выходит белыми клубами.")
	await novel_interface.show_text_only("Благодаря свету, исходящему из туннелей, я могу видеть показания ртутного термометра на стене. Там написано минус тридцать два градуса.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Ух ты, в таком случае, моя моча замерзнет, как только выйдет?)","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Наверное, не..., верно?)","Lian")
	await novel_interface.show_dialog("(но...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("Наконец я возвращаюсь в туннель, яростно краснея.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Что заняло у тебя так много времени?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Твое лицо все красное.","Генриетта")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Вся энергия вашего Огненного Нефрита израсходована? Нужен новый?","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Нет-нет, все в порядке!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прости, Генриетта... \\nЭтот Огненный Нефрит... ни за что не позволю никому его подержать!")
	await novel_interface.show_text_only("Мочевой пузырь меня больше не убивает, и я радостно следую за Генриеттой и Рафилией, пока мы продолжаем идти в направлении кабелей.")
	await novel_interface.show_text_only("Я пытаюсь вспомнить, что я только что видел в рабочих помещениях. На столе стояла полбутылки водки, а на стенах темный лед.")
	await novel_interface.show_text_only("Кажется, я пнул металлический предмет, гуляя в темноте... \\nЭто гильзы от пуль?")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Нет, нет. Должно быть, это было мое воображение.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я наблюдаю за своим окружением. Стены цементного туннеля по большей части голые, за исключением пары плиток.")
	await novel_interface.show_text_only("Подождите, плитки...? Если бы это место строилось, как я думал, плитки не были бы расположены так беспорядочно, как сейчас.")
	await novel_interface.show_text_only("Но какая сила отслоила всю внутреннюю стену тоннеля? ?")
