	await novel_interface.show_text_only("Sau đó, cô ấy giật mạnh sợi dây và nó được thắt chặt lại. Mười mấy bậc thang lại bị kéo về vị trí ban đầu.")
	await novel_interface.show_text_only("Cô gắn lại sợi dây vào chiếc khóa trên sàn, như thể nó chỉ là một cuộn sợi mềm.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ôi… Tuyệt vời!", "Lian")
