	await novel_interface.show_dialog("Chà… Ít nhất thuộc tính cường hóa của bộ chiến đấu này khá hữu ích cho các nhà giả kim.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Suy cho cùng, đôi khi chúng ta phải đối mặt với những rắc rối… rắc rối ngoài sức tưởng tượng.", "Henriette")
