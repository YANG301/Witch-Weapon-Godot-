# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru delivers a one-way briefing in a closed-door meeting.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… That's all we got on the Salmonton delegation incident.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers paid another visit to New Opulentia to run some \"personal errands\".", "Mariru")
	await novel_interface.show_dialog("Now, SID has included her in the A-level protection list.", "Mariru")
	await novel_interface.show_dialog("This time though, Salmonton submitted full details of the delegation and a complete list of restricted goods to the Ministry of Foreign Affairs.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("They've even reported all the military operations in which their security staff have engaged in the past. You can't find a single flaw in the records…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("So, it sounds like a disclaimer that if something bad happens to the granddaughter of Dr. Dekkers, it will be all our fault.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Humph! That cunning fox…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("In exchange for that young lady's safety here, though, they promised a 20% prioritized delivery of our agricultural products purchase contract.", "Eloise")
	await novel_interface.show_dialog("According to the current NBOT index, it's like a giveaway.", "Eloise")
	await novel_interface.show_dialog("I've signed an executive order to keep the media off her trail for the moment.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Are they using the Senate part of their market-making strategy?) \\n(And they knew I would stay out of it…)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Humph… old cunning fox…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("The girl is useful to us. Can we dig out more intelligence from her?", "Bright")
	await novel_interface.show_dialog("Frankly speaking, we've been very interested in their gene editing technology and the mega greenhouse systems.", "Bright")
	await novel_interface.show_dialog("If she can spend a few hours in my lab…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dr. Bright…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("You’ve already got a big reputation for your \"unique\" moral standards on Substance H that affects the human mind.", "Mariru")
	await novel_interface.show_dialog("I'm afraid that Salmonton would immediately impose trade sanctions on New Opulentia once the young lady steps into your lab.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("My reputation? Really? \\nHahaha…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ahem, that’s enough!", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Talking about those unknown armed men at the Sky Hotel…", "Kirs")
	await novel_interface.show_dialog("They attacked the Salmonton delegation and grabbed some valuable art pieces…", "Kirs")
	await novel_interface.show_dialog("Does SID have any clues?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(The old fox concealed the golden butterfly from the Senate and put the blame on Jacob and his gang.)", "Mariru")
	await novel_interface.show_dialog("(They disabled the security cameras at the hotel before taking actions.) \\n(There’s an information gap there…)", "Mariru")
	await novel_interface.show_dialog("Our hands are tied at the Agreed Demilitarized Zone. According to different sources, we believe that they used special weapons.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Special weapons… you mean Substance H weapons? \\nThey used the weapons inside the protective field of Aegis?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Judging from the tree-like burn marks on the floor, we believe they used high-power discharge devices with series resonance circuits.", "Mariru")
	await novel_interface.show_dialog("Such a complicated device is too bulky for an individual soldier to carry, and there’s virtually no way to downsize it.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("According to witness statements, there were about 10 men armed with the same weapon that night.", "Mariru")
	await novel_interface.show_dialog("According to Aegis records, about ten unknown IDs went offline at the same time that night. They must have retreated from the site.", "Mariru")
	await novel_interface.show_dialog("Since SID had blocked regular departures, they might have gotten away through diplomatic channels.", "Mariru")
	await novel_interface.show_dialog("(Or executed because of their failure…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… I see.", "Kirs")
	await novel_interface.show_dialog("Substance H weapons can't be produced on such a large scale.", "Kirs")
	await novel_interface.show_dialog("But before the cameras were shut off, two suspicious persons attacked the guards at the corridor.", "Kirs")
	await novel_interface.show_dialog("One of them dressed as a maid of that hotel, and the other wore the uniform of Gosakuragawa. Did you send them there?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A high-pitch squeak comes out from the screen.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Hahaha… Our Chief Executive seems very interested in kitties… So do I.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Kitties?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Oh, I quoted it from Her Excellency Ms. Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(What a nuisance…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie and Ren, right? \\nAdorable names…", "#C")
	await novel_interface.show_dialog("Maybe there are other cats that Mikakawa has raised——", "#C")
	await novel_interface.show_dialog("Am I right, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Heh, thanks for not handing them over to the security forces. I owe you.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("It's no big deal. \\nIt seems that you have no intention to conceal anything from us anyway.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("So, allow me to debrief you with more details.", "Mariru")
	await novel_interface.show_dialog("The satellite detected several Spacetime Fluxes at the Sky Hotel, but SID had no right to take actions there.", "Mariru")
	await novel_interface.show_dialog("So I sent two undercover agents there.", "Mariru")
	await novel_interface.show_dialog("During their mission, they came across a group of armed men and one of them shot Annie with the special weapon.", "Mariru")
	await novel_interface.show_dialog("Now the agent is finally out of danger after emergency treatments, and we've collected some statistics about that weapon.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Why didn't you tell us earlier?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Mr. Chief Executive, I wonder what exactly are the “art pieces” that went missing?", "Mariru")
	await novel_interface.show_dialog("Maybe it's time we all became more open to sharing intelligence.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("What do you think?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Why don't we start with the kitty you adopted?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Bummer… That information was not enough to distract him.)", "Mariru")
	await novel_interface.show_dialog("(What a headache...) \\n(Guess it's time to test those forged files. Let's tell them a story.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Shall we begin, my dear?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("During the Seven Years War, scientists scrambled to develop technologies that would let humans activate the Divine Touch.", "Mariru")
	await novel_interface.show_dialog("Rumor has it that human body-modification experiments were secretly conducted on combatants. I believe you've heard those rumors.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Um-hum.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru chuckles, the corners of her lip curving slightly upwards.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Some people are born with special aptitudes, and the New Opulentia Academy of Sciences and Brain Research Institute have records to prove that.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Actually, Dr. Bright can be considered one of them.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Wait, I have to remind you that nearly all those gifted people are female.", "Bright")
	await novel_interface.show_dialog("However, people with special talents like this are usually only put on the watch list, and there is no need for special control.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Right. But among all these gifted people, no one has any power comparable to B-Class Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("As experiment results were below expectations, this kind of researches had been called off during the war period.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Those females with superpower are also known as \"Witches\". A few decades ago, no one would ever believe the existence of such things in the world…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("But Ren is different—she is able to pass through flux areas.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What?!!","Crowd")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
