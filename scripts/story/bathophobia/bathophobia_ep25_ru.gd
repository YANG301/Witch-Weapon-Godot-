# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("— Берегись!","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта отталкивает меня в ту же секунду, как скрипит дверь в диспетчерскую.")
	await novel_interface.show_text_only("И как раз вовремя, и следующее, что я помню, — бесчисленные сверкающие электрические дуги безжалостно врезаются в грудь блондинки, сопровождаемые резкими, оглушительными взрывами. Свет ослепляет – я едва могу держать глаза открытыми.")
	await novel_interface.show_text_only("И через несколько секунд все будет кончено. Все снова тихо. Волосы у меня встают дыбом — там, наверное, скопилось огромное количество статики. В воздухе пахнет хлором.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ух ты,... \\nГенриетта, ты в порядке?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Я думаю, это ловушка. Что-то вроде защитного оружия.\\nВпечатляюще, оно, вероятно, содержит столько же энергии, сколько небольшой радар.","Генриетта")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Генриетта стоит, задумчиво изучая потолочные светильники диспетчерской. В ее руке полупрозрачный голубой кристалл.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что это вообще было?\\nИ что это у тебя в руке?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Это турмалин. Хочешь попробовать, Мастер?","Генриетта")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Алхимик загадочно улыбается мне, протягивает правую руку и осторожно кладет кристалл мне за ухо.")
	await novel_interface.show_text_only("Внезапный теплый, нечеткий поток проходит через мое тело, заставляя все мои волосы вставать дыбом.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ах!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не могу сдержать изящный стон.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Ла? Тело мастера очень чувствительно~","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ты стонешь? Здесь? Действительно?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия смотрит на меня так, будто я мусор.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Эй, я не специально это сделал...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— бормочу я, опуская голову и яростно краснея.")
	await novel_interface.show_text_only("По крайней мере, статика, скопившаяся над моей головой, исчезла. Мои волосы теперь красивые и гладкие.")
	await novel_interface.show_text_only("Я должен попросить у Генриетты один из этих кристаллов, когда мы вернемся... \\nОна не будет возражать, верно?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Я робко следую за алхимиком в диспетчерскую.")
	await novel_interface.show_text_only("Место выглядит разрушенным. Большинство экранов и оборудования повреждены в различной степени. Потолок и стены тоже рушатся.")
	await novel_interface.show_text_only("Черные следы ожогов, оставленные ударами высокого напряжения, распространились от главной панели управления в обе стороны. Открытые цепи все еще полны искр.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Радиус сферы составляет более пятнадцати футов... \\nКто-то, должно быть, использовал здесь высоковольтное разрядное оружие...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Если они использовали стандартную систему безопасности Genuine, это означает, что эта отметка здесь...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Кто-то, должно быть, грубо перемонтировал оборудование наступательной защиты системы и подключил химическую аккумуляторную батарею, используя высоковольтную систему внутренней сети базы... ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на снаряд, едва узнаваемый после взрыва, и наконец понимаю, почему воздух воняет хлором.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Электрический взрыв...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда мощный ток проходит через металлическую фольгу, возрастающее тепло вызывает скопление огромного количества энергии, что приводит к сильным взрывам и вспышкам.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Итак, кто бы это ни сделал, он использовал слои сложенной металлической фольги в своих целях. Действительно очень эффективное и смертоносное изобретение.","Генриетта")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Но..., чтобы это сработало, кто-то должен проложить металлический провод, пропускающий ток, в щель под дверью, которая является единственным выходом из этого места...","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Итак, кто бы это ни сделал, он взорвется вместе с врагами, как только откроется дверь в комнату.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ключевое оборудование этой системы безопасности, судя по всему, защищено электромагнитными барьерами. Я заметил, что главную панель управления все еще можно активировать. Повреждено лишь несколько кнопок.")
	await novel_interface.show_text_only("Входим в систему безопасности и обнаруживаем, что она взломана. Возможно, это как-то связано с военными часами, подключенными к главной панели управления.")
	await novel_interface.show_text_only("Флеш-накопитель в часах по-прежнему доступен. По содержанию легко определить личность его владельца.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Кажется, это кто-то очень крутой.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Несколько экранов на станции наблюдения все еще работают, послушно воспроизводя в реальном времени кадры, снятые камерами наблюдения.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Надеюсь, мы сможем найти здесь полезную информацию.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я делаю глубокий вдох и вызываю исторические записи.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Хм…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как и ожидалось от сверхсекретного заведения, здесь слишком много записей, чтобы их можно было сосчитать. Некоторые из более ранних видео даже хранятся в файлах видеомагнитофона.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("На поиск во всем этом бардаке чего-нибудь полезного уйдут годы!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Прекрати нытье. Должен быть простой способ выполнить поиск, иначе дизайнер пользовательского интерфейса уже был бы уволен.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что ж, действительно существует режим, который позволяет нам эффективно просматривать все записи одновременно, но...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("На базе установлены сотни камер наблюдения, и система собирает данные с момента постройки базы. Передо мной пока работает только один двадцатидюймовый экран. Отобразить на нем все сразу... невозможно.")
	await novel_interface.show_text_only("В отчаянии я продолжаю уменьшать масштаб, пока миниатюры отснятого материала не превратится в простые пиксели.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Эй! Посмотрите на это!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Рафилия бьет меня по голове и указывает на прямую вертикальную белую линию на экране.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Все кадры, снятые в этот момент..., они все... белые?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Я перехожу к моменту времени, о котором говорит Рафилия, и вызываю первый кадр после части со всей белизной, в которой есть какое-либо содержание.")
	await novel_interface.show_text_only("В поле зрения появляется высокий, широкоплечий мужчина.")
	await novel_interface.show_text_only("Он одет в защитный костюм кобальтового цвета, а рост на вид превышает шесть футов. Он шагает вперед уверенным и быстрым шагом.")
	await novel_interface.show_text_only("Похоже, он не против того, чтобы его сняли на видео, но разрешение слишком низкое, чтобы мы могли четко разглядеть его лицо.")
	await novel_interface.show_dialog("В нем есть что-то...","Lian")
	await novel_interface.show_dialog("Вы знаете его, Мастер?","Генриетта")
	await novel_interface.show_dialog("Нет...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Мужчина осматривает это место, идя вперед, как будто что-то ищет.")
	await novel_interface.show_text_only("Его шаги ускоряются, когда он направляется из архивной комнаты в лазарет.")
	await novel_interface.show_text_only("Проходя мимо двух связанных трупов солдат, он внезапно останавливается и наклоняется, чтобы изучить их.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Этот солдат... потерял теленка?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мы с Рафилией затаили дыхание, в ужасе от раны на ноге солдата и темной крови по ее краям.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Итак, здесь произошла драка, да...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Не могу не вспомнить гигантскую трещину в полу архивного помещения.")
	await novel_interface.show_text_only("С бесстрастным лицом мужчина входит в лазарет и достает из аптечки черную карточку. Из ниоткуда он заряжает свой пистолет.")
	await novel_interface.show_text_only("Из угла лазарета набрасывается темная тень. Мужчина выстрелил несколько раз, не пропуская ни секунды, и пуля вылетела за пределы кадра.")
	await novel_interface.show_text_only("Затем он вытаскивает кинжал и тоже исчезает из кадра. Он появляется снова через несколько секунд и выбрасывает в мусорку связку неразличимых предметов.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Это..., это...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ни в коем случае. Не может быть.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Я вижу, что следую четкому протоколу.","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Не имеет значения. Продолжайте наблюдать.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мужчина спокойно закрывает дверь в лазарет, затем проводит картой, чтобы открыть металлические ворота. Кажется, он очень хорошо знаком с планировкой базы.")
	await novel_interface.show_text_only("Проверив, пуст ли он (а так оно и есть), мужчина идет в туннель за пределами диспетчерской.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Что это за __ЭЛЛИПСИС__?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Графика на экране немного зернистая, но все же легко сказать, что туннель на кадрах определенно был местом кровавой бани.")
	await novel_interface.show_text_only("Десятки трупов беспорядочно лежат радиальным строем, как будто мощный взрыв скосил их всех одновременно.")
	await novel_interface.show_text_only("А в центре всего этого стоит на коленях девушка, одетая в белое, с выпрямленной верхней частью тела, пронзенная оружием с длинной рукоятью.")
	await novel_interface.show_text_only("На ней слишком мало слоев одежды, учитывая, что она в Антарктиде. Ее молочная кожа окрашена в кроваво-красный цвет.")
	await novel_interface.show_text_only("В каждой руке у нее по оружию, и она крепко сжимает их, несмотря на то, что потеряла сознание.")
	await novel_interface.show_text_only("Мужчина становится перед ней на колени, ласкает ее лицо одной рукой.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Они знают друг друга?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Затем он поворачивается к ее спине, хватается за рукоять и медленно вытаскивает оружие, обнажая позолоченный наконечник копья.")
	await novel_interface.show_text_only("Тело девушки вообще не двигалось, и кровь из раны больше не текла. Во всем этом процессе было неописуемое чувство непослушания.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Шепотом) Ааа...","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мужчина снял пальто, аккуратно снял дуло пистолета, завернул его в ткань и сунул за пазуху пиджака, а длинную рукоятку отбросил в сторону.")
	await novel_interface.show_text_only("Затем он входит в диспетчерскую. Мы пытаемся проверить, что он задумал, переключая камеры, но на экране диспетчерской отображается только статика.")
	await novel_interface.show_text_only("Смотрим вверх и видим, что камера в комнате уже полностью разрушена ударом тока.")
	await novel_interface.show_text_only("Через мгновение мужчина снова появляется в коридоре, неся чемодан из сплава шириной около 1,6 фута.")
	await novel_interface.show_text_only("Замок чемодана, кажется, сломан. Он открывает футляр и достает три стеклянных сосуда.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Что именно он делает?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Один из стеклянных сосудов разбит. Мужчина смотрит на него, немного колеблется, затем кладет два целых в карман.")
	await novel_interface.show_text_only("Он осторожно пытается вырвать оружие из сжатых кулаков девушки. В этот момент откуда-то из ее рубашки выпадает блокнот.")
	await novel_interface.show_text_only("Мужчина берет его, пролистывает и засовывает обратно в наряд девушки.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Словно неся младенца, он осторожно берет на руки стройную, хрупкую девушку. Его движения любящие и нежные.")
	await novel_interface.show_text_only("Он несет ее в свадебном стиле до конца туннеля, где стучит черной карточкой по стене.")
	await novel_interface.show_text_only("Стена отодвигается, и они вместе исчезают во тьме...")
	await novel_interface.show_text_only("... На этом записи заканчиваются.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("На всех последующих видеозаписях следует длительный период пустоты. И в остальных кадрах мужчина больше не появляется.")
	await novel_interface.show_text_only("На самом деле в последующих кадрах нет ничего заслуживающего внимания. Ничего, пока мы втроем не окажемся у входа на базу.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Это странно...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Подожди, посмотри.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия указывает на экран, показывающий лазарет.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Разве здесь не было трупа? Этого... больше нет.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("На самом деле все трупы исчезли...","Lian")
