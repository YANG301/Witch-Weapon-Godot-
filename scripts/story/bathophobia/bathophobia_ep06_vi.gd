# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Đứng trên bục phát biểu, Mariru đang trình bày báo cáo tiến độ toàn diện về các nghiên cứu gần đây trong cuộc họp video thường lệ.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Về Dự án Ark…", "Kirs")
	await novel_interface.show_dialog("Từ danh sách các thánh tích được cung cấp bởi Salmonton, bạn đã chọn Trụ cột Tesheim Lapis phải không?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vâng, thưa ngài. Bây giờ điều quan trọng là làm thế nào để tạo Vùng thông lượng có thể kiểm soát được.", "Mariru")
	await novel_interface.show_dialog("Tất cả các trường hợp gần đây về Dòng chảy Không thời gian ở tất cả các thành phố học thuật đều do con người tiếp xúc với các vật phẩm có thuộc tính Substance H.", "Mariru")
	await novel_interface.show_dialog("Những vật phẩm đó đã không hoạt động trong một thời gian dài nhưng gần như được kích hoạt cùng lúc.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Chính xác hơn là Mảnh vỡ Phù thủy và Mảnh Grimoire. Nhưng tốt hơn tôi nên giải thích nó theo cách hiểu thông thường.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ý bạn là ngày Ross Goblet biến mất…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Chúng tôi chưa thể xác nhận kết nối của họ.", "Mariru")
	await novel_interface.show_dialog("Vì có quá nhiều yếu tố không thể kiểm soát được nên chúng ta phải lọc tất cả các di tích theo hai tiêu chí.", "Mariru")
	await novel_interface.show_dialog("Đầu tiên, nó phải là chất có hoạt tính thấp thể hiện các đặc tính Substance H theo quá trình quét màu sắc.", "Mariru")
	await novel_interface.show_dialog("Thứ hai, chủ sở hữu ban đầu được truy tìm trong hồ sơ lịch sử và người này không được có bất kỳ xu hướng bạo lực hoặc phạm tội nào.", "Mariru")
	await novel_interface.show_dialog("Trụ cột Tesheim Lapis ban đầu thuộc sở hữu của Heinrich Khunrath, một bác sĩ và nhà giả kim thời Phục hưng.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Hoạt động thấp… Thật đáng tiếc… Tôi đã mong đợi lần này chúng ta có thể thu thập dữ liệu gần hơn với giá trị tới hạn.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Mẫu vật quá quý giá để mất. Tốt hơn là nên ở bên an toàn.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Mình chỉ cần chứng minh khả năng đi qua các vùng dòng chảy của Ren. Để làm được điều đó, chúng ta chỉ cần diễn thôi.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Trên thực tế, Trụ đá Tesheim Lapis không phải là Mảnh vỡ của Phù thủy) \\n(Nó gần như là Substance H với những dòng chữ ma thuật trên đó.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Chạm vào Mảnh vỡ của Phù thủy là quá nguy hiểm đối với người bình thường.) \\n(Xét cho cùng, tôi không phải là người khỉ đột…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một tràng cười sâu sắc phát ra từ màn hình.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Nhà giả kim… Người tiên phong của khoa học à? \\nThật là một sự lựa chọn thú vị.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Tôi nghe nói nó là một tác phẩm nghệ thuật có ý nghĩa lịch sử to lớn và chủ sở hữu Heinrich là một trong những người sáng lập Rosenkreutz…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Rosenkreutz chỉ là một nhóm tôn giáo và huyền bí. Nó không liên quan gì đến cơ quan tình báo hiện tại của Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Tôi đoán các nhà giả kim có thể được coi là nhà khoa học của thời đại đó. Hy vọng rằng anh ấy là một người đàn ông sợ hãi những điều chưa biết.", "Mariru")
	await novel_interface.show_dialog("Nhưng bạn biết rõ về Tiến sĩ Dekkers. Anh ấy sẽ không bao giờ cho chúng tôi mượn một di vật quan trọng như vậy mà không phải trả phí, trừ khi…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một sự im lặng kỳ lạ tràn ngập căn phòng.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Đúng vậy. Bên Salmonton muốn chia sẻ dữ liệu cùng với một đại diện trong nhóm của chúng tôi.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Vì vậy, họ vẫn chưa từ bỏ việc sản xuất thêm phù thủy…) \\n(Họ có muốn sử dụng Ren làm chất ổn định không?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Cũng lưu ý. Tôi chỉ muốn xác nhận rằng tất cả mọi người, kể cả phe Salmonton, đều hiểu sự nguy hiểm của thí nghiệm này.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Khẳng định. Chúng tôi đã chuyển đổi các cơ sở thoát nước ngầm khổng lồ của thủ đô cũ thành Căn cứ Ark, đề phòng trường hợp xấu nhất xảy ra.", "Kirs")
	await novel_interface.show_dialog("Hệ thống xâm nhập nước biển siêu tốc có thể nhấn chìm toàn bộ căn cứ trong vòng 30 giây.", "Kirs")
	await novel_interface.show_dialog("Nếu có vấn đề gì xảy ra trong quá trình thử nghiệm…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Trong trường hợp đó, tôi hy vọng Mariru thân yêu của chúng ta có đủ can đảm để khởi động thiết bị tự hủy khẩn cấp.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
