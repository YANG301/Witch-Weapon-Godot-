# bathophobia_ep02.gd - 深海恐惧篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep02_script()

func play_script():
	pass

func bathophobia_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Beatrice умерла в 1290 году.) \\n(Ее нынешнее тело должно быть создано Реном.)", "Mariru")
	await novel_interface.show_dialog("(Создание вместилища для души… Это скорее своего рода богоподобная сила.)", "Mariru")
	await novel_interface.show_dialog("(Я должен промолчать об этом…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Хаха, интересно… \\nЭто действительно интересно.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Полагаю, вы уже расследовали действия другого агента, участвовавшего в операции в отеле «Скай». Ее зовут Annie Басс.", "Mariru")
	await novel_interface.show_dialog("Она одна из 50 000 человек, пропавших без вести в результате инцидента на арене «Свет Свободы» семь лет назад.", "Mariru")
	await novel_interface.show_dialog("Это Рен вытащил ее из другого пространства-времени.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ты не выглядишь удивленным.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("В таком случае… Это многое объясняет.", "Элоиза")
	await novel_interface.show_dialog("Позволить Annie выполнять операции даже без псевдонима… Мне кажется, вы не собирались ее от нас скрывать.", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Вы ведь не сможете спрятать такую знаменитость, как Annie Басс, верно, мадам Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Но назначить себя опекуном Рена… Есть ли здесь какой-то скрытый мотив?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Хм. Конечно, есть.", "Mariru")
	await novel_interface.show_dialog("Я заметил особую способность Рена много лет назад. Но поскольку ее родители планировали эмигрировать в Ньюморидас…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Мне пришлось предпринять какие-то действия…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Та авиакатастрофа, в которой погибли ее родители и брат…", "#C")
	await novel_interface.show_dialog("Это был... ты?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Хе-хе, я бы в этом не признался.", "Mariru")
	await novel_interface.show_dialog("Знаешь, я все еще хочу быть опекуном милашки.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Ха, теперь я понимаю, что нужно, чтобы сделать голову SID. Я чувствую себя гораздо увереннее!", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Ради мира и стабильности New Opulentia необходимы некоторые жертвы.", "Кирс")
	await novel_interface.show_dialog("Mariru и SID всегда хорошо справлялись со своей задачей.", "Кирс")
	await novel_interface.show_dialog("Итак, я думаю, SID, должно быть, нашел некоторую информацию о недавних потоках пространства-времени.", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Судя по анкете девушки, ей всего 15. Будет ли слишком рискованно отправлять ее в Зону Флюкса?", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Это стоит риска.", "Mariru")
	await novel_interface.show_dialog("Основываясь на информации, которую она собрала… \\nМы считаем, что Поток пространства-времени — это проявление вероятностной турбулентности.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("То есть сделать так, чтобы крайне маловероятное событие произошло со 100-процентной уверенностью.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Звучит как волшебство!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Это действительно… способность, за которую люди готовы умереть…", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Нет. Это только теоретически возможно… Для этого потребуется чрезвычайно компетентный наблюдатель…", "Bright")
	await novel_interface.show_dialog("Но такая интенсивность наблюдения невозможна, даже если сосредоточить на ней всё человеческое внимание…", "Bright")
	await novel_interface.show_dialog("Если только…", "Bright")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Если только мы не говорим о том, кто создал Substance H…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Тьфу—", "Кирс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Доктор Кирс глубоко вздыхает. Комнату наполняет долгая тишина.")
	await novel_interface.show_text_only("Создатель Substance H — тема, которую научное сообщество долгое время избегало.")
	await novel_interface.show_text_only("Так же, как и вопрос «кто создал большой взрыв» — без фальсифицируемости он выходит за рамки науки.")
	await novel_interface.show_text_only("Точно так же, как и попытка учёных изучить далекие галактики за пределами возможностей Хаббла, которые удаляются от Земли быстрее скорости света из-за космологического расширения.")
	await novel_interface.show_text_only("Они верят, что наблюдаемая Вселенная — это лишь крошечная часть целого. Остального мы намеренно избегаем.")
	await novel_interface.show_text_only("Самая обнадеживающая часть науки заключается в том, что она закрывает глаза на неизведанное.")
	await novel_interface.show_text_only("Если всемогущие наблюдатели существуют, то люди для них не более чем кометная пыль…")
	await novel_interface.show_text_only("И такой бог нас не благословит… Только мы можем спасти себя.")
	await novel_interface.show_text_only("В темной, холодной вселенной… Пожалуй, это самая страшная истина.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("… Подводя итог, можно сказать, что потоковое пространство-время — это случай крупномасштабного беспорядочного коллапса вероятности.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Это запускается вызовом из ограниченного пространства-времени с ограниченными размерами всемогущего наблюдателя, находящегося за пределами человеческого понимания.", "Mariru")
	await novel_interface.show_dialog("Поток пространства-времени, как результат вероятностной турбулентности, создается, когда чувства призывателя уничтожаются наблюдателем.", "Mariru")
	await novel_interface.show_dialog("Но его воздействие можно эффективно устранить, если кто-то сможет войти в Зону Потока и контролировать призывателя.", "Mariru")
	await novel_interface.show_dialog("Я несколько раз проверял эту теорию в области потоков в New Opulentia. И это работает.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("С другой стороны, испарение одной только области потока без какого-либо вмешательства приведет к локальному взрыву энтропии.", "Mariru")
	await novel_interface.show_dialog("Один или несколько экстрасенсов с высокой вероятностью потеряют рассудок в месте испарения, что приведет к дальнейшему ущербу.", "Mariru")
	await novel_interface.show_dialog("Пока что такое безумие кажется необратимым, и эти экстрасенсы подходят под описание ведьм в средневековых досье.", "Mariru")
	await novel_interface.show_dialog("Единственная хорошая новость заключается в том, что ведьм можно подавить обычными средствами после того, как Испаряется Флюкциональное Пространство-Время.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Это все от меня.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Наступает мертвая тишина.")
	await novel_interface.show_text_only("На другом конце зашифрованного канала связи только потрясенные вздохи нарушают тяжелую тишину.")
	await novel_interface.show_text_only("Даже правящая элита New Opulentia вряд ли сможет сразу переварить эту информацию.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Действительно…", "Кирс")
	await novel_interface.show_dialog("Ущерб, причиненный Потоком пространства-времени в New Opulentia, намного меньше, чем в других Академгородах.", "Кирс")
	await novel_interface.show_dialog("Мы всегда отдавали должное Aegis…", "Кирс")
	await novel_interface.show_dialog("Теперь я вижу... Способности девушки оправдывают абсолютную конфиденциальность.", "Кирс")
	await novel_interface.show_dialog("И Mariru действительно лучший ее опекун.", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Но можете ли вы доказать то, что сказали?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("SID сохранил все данные мониторинга.", "Mariru")
	await novel_interface.show_dialog("Также поступали сообщения о человекоподобных существах, обнаруженных вблизи областей Потока, которые обладают огромной разрушительной силой и не способны общаться.", "Mariru")
	await novel_interface.show_dialog("Похожий случай произошел недавно возле подстанции Джонсон.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Я думаю, доктор #C уже слышал об этом.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru смотрит на зашифрованный силуэт на экране.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Воспоминания о том, как мадам Mariru с триумфом вышла из вертолета-невидимки, незабываемы.", "#C")
	await novel_interface.show_dialog("У меня нет другого вопроса, находится ли девушка по имени Рен тоже в этом вертолете.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Похоже, Энцо и его люди держат рот на замке.)", "Mariru")
	await novel_interface.show_dialog("По той же причине я отправил Рена в отель «Скай» на случай, если в демилитаризованной зоне произойдет Поток пространства-времени.", "Mariru")
	await novel_interface.show_dialog("Я просто не ожидал, что кто-то заберет ключевые улики…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Итак, с самого начала вы стремились к золотой четверке…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("—Mariru был прав.", "Кирс")
	await novel_interface.show_dialog("Знаешь ли ты, как Рен активирует свою способность? Или вы проверяли порог срабатывания?", "Кирс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кирс быстро перебивает Брайта и меняет тему.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Ха, теперь ты показываешь свои цвета...)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Мы не стали проводить эксперимент, так как нам нужны специальные средства защиты.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тот, что на экране, звучит раздраженно.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("За такой специальный ресурс Сенат обязательно окажет вам полную поддержку.", "Кирс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru опускает голову, скрывая хитрую улыбку.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("На данный момент мы не знаем, существует ли смертельная опасность в другом пространстве-времени.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("И даже если мы возвращаем кого-то или что-то, как мы узнаем, что это не оскорбительно?", "Mariru")
	await novel_interface.show_dialog("В конце концов, в истории ходило немало слухов, обвиняющих ведьм в возникновении Черной смерти…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Но поручить ли Mariru полный контроль над таким захватывающим экспериментом? Я так не думаю…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Почему бы не привести этого Рена в мою лабораторию? \\nХахахахахаха…", "Bright")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Брайт разражается громким смехом.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Я не знаю, кому я хочу взять на себя заботу об этом котёнке... Если возможно, я бы тоже хотела попробовать его вырастить~", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Как опекун Рена, я отклоняю все ваши просьбы.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru сияет улыбкой.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Но...", "Mariru")
	await novel_interface.show_dialog("Поскольку Сенат очень дорожит Реном, я хотел бы сделать предложение…", "Mariru")

	print("=== 深海恐惧篇第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
