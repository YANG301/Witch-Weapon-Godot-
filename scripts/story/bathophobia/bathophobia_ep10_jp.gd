	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Record、バイジュウ。", "バイジュウ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("少女は少し疲れた様子で、薄っすらと濡れた髪を背後に散らかしてる。\\nしかし彼女の姿はいつも通り──")
	await novel_interface.show_text_only("気骨と自信、そして誇りに満ちている。")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("パスワードを音声入力してください──", "システム")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Keshi0415-Z。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("情報登録中……スキャン開始。", "システム")
	await novel_interface.show_text_only("周囲から8本の光の帯が現れ、\\nバイジュウのスキャンを始めた。")
	await novel_interface.show_text_only("この時、二重防護扉の向こう側では\\nクルーの何人かが観察窓の前に集まり、\\nとある話題について興奮気味に談話している。")
	await novel_interface.show_text_only("真ん中にいる褐色の髪の少女、「思儀」は\\nバイジュウの親友だ。")
	await novel_interface.show_text_only("彼女は自身のコードネームを好んでいるため──\\n\\n普段から「ミルク」と周りから呼ばれている。")
	await novel_interface.show_text_only("観察窓を通して2人の視線が合うと、\\nバイジュウの表情は柔らかくなった。")
