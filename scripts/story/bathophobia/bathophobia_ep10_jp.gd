	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウは順番通りに、その6桁の数字を\\n入力した。")
	await novel_interface.show_text_only("ブザーが数回鳴った後、通路の扉は依然として\\n閉じたままだった。")
	await novel_interface.show_dialog("パスコードが正しくありません。\\n警告1回目──", "システム")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("……やっぱり。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("多分ミルク以外の全員、システムから締め出され\\n途方に暮れる私の姿を待ち望んでいるのだろう。")
	await novel_interface.show_text_only("ミルクは得意げな笑顔を浮かべ、\\nバイジュウは溜め息をついた。")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("また、暗号ゲームですか……", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("観察窓の後ろにいる人達の表情は様々だが、\\nどれもが戯れているかのような感じだ。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("なぁなぁ……\\nあの小娘、今回はどれくらいかかると思う？", "隊員A")
	await novel_interface.show_dialog("対プルートフォース攻撃モジュールも\\n書き込んだんだろう？\\nだったら、解析プログラムを使ったとしても\\n無理じゃねえか？", "隊員C")
	await novel_interface.show_dialog("おっと、そうだミルク。\\nヒントはなしだぞ。", "隊員B")
	await novel_interface.show_text_only("ミルクは口上でファスナーを閉める仕草をした。")
	await novel_interface.show_dialog("俺は60秒に賭けるぜ！", "隊員D")
	await novel_interface.show_dialog("いくら天才といえども、そんなに早くアレが\\n解けるわけがないだろ……\\n俺は10分だ！", "隊員C")
	await novel_interface.show_dialog("お前らバイジュウとコイツを甘く見ていると\\n痛い目にあうぞ……？", "隊員A")
	await novel_interface.show_text_only("背の高い部隊長が、後ろからミルクの頭を揉む。")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("ちぇ～～、編集プログラムのコードは全員で\\nしっかり確認したでしょ！？ ", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("だけどバイジュウちゃんなら、この合図だけで\\nきっとわかるはず……")
	await novel_interface.show_text_only("それは2人の間しか知らない。小さな秘密。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("うーん……", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウはミルクが右手の親指と人差し指で、\\n「指ハート」を作っているのに気が付いた。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("ほんとに……もう……", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("それは最初に2人が出会った時の暗号。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("「100485」……\\nつまり……「124155」か。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("その間、たった20秒未満。\\n\\n人々の驚異のまなざしを浴びながら、\\n正確なパスコードを入力した──")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("ゆっくりと中央制御室の扉が開く。\\n少女は髪を整え、口元に僅かな微笑を浮かべた。")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("ふふふっ、さすがバイジュウちゃん……", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルクはニヤリと口角を上げつつ、\\n先ほど賭けた人達から紙幣を回収している。")
	await novel_interface.show_dialog("おい──\\nお前まさかヒントを与えたんじゃねえだろうな？\\n\\nヒントはなしって約束したじゃねえかッ！", "隊員D")
	await novel_interface.show_text_only("ミルクは両手を軽く広げ、無実と言わんばかりの\\n表情を作った。")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("あんた達もこの場でちゃんと見てたでしょ？\\n私はなんにも言ってませんよ～～", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("一体、彼女はどうやって当てた？", "隊員B")
	await novel_interface.show_dialog("おかしい、絶対どこかで情報が漏れたんじゃ……", "隊員C")
	await novel_interface.show_text_only("彼らに考察の時間など与えず、バイジュウは\\n清らかに喉を鳴らし、すぐに調査報告を始めた。")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("予想通り、確かに『アレ』は超深海層に\\n存在しています。", "バイジュウ")
	await novel_interface.show_dialog("私は数時間前に『アレ』と近距離接触を行い\\n液体サンプルを採集する事に成功しました。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	novel_interface.show_character("milk_normal","shock")
	await novel_interface.show_dialog("……えっ？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一瞬で全員が騒ぐのをやめた。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("バイジュウの言う『アレ』とは、彼らの今回の\\n任務目標である深海に住まう古代生物だ。")
	await novel_interface.show_text_only("いくつかの古い宗教では、地球上に存在する\\n全ての生命の基礎と考えられている。")
	await novel_interface.show_text_only("『アレ』が単一生命体かどうかはおろか、\\n物質的な存在なのかでさえ分からない。")
	await novel_interface.show_text_only("出発する前、隊員の大半は科学的な根拠の無い\\nただの噂話だと考え。\\n言わばネス湖の怪物みたいな類だと思っていた。")
	await novel_interface.show_text_only("しかし今回のバイジュウの報告によって、任務を\\nさっさと終わらせて早めに帰還するという\\n彼らの願望は幻想となって砕け散ったのだ。")
	await novel_interface.show_text_only("南極海、エリザベス王女の氷の下 4,000 ～ 6,000 メートルの深層水の中で...")#文字删除
	await novel_interface.show_text_only("人類の誕生以前、遥か昔より存在し、\\n今の今まで生き長らえてきた神秘的な生物が\\n現在も棲息している。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("そんな発想が僅かでも真実味を帯びるのなら\\n\\n……それだけで人々を恐怖に凍えさせるには\\n十分である。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("短い時間ではありましたが『アレ』が\\n海水区域に散布した神経活動の電気信号を、\\nセンサーは検知していました。", "バイジュウ")
	await novel_interface.show_dialog("最初の波形は緩やかでしたが、\\nその後周波数が急激に上昇。\\n波形の特徴は人間のベータ波と酷似しています。", "バイジュウ")
	await novel_interface.show_dialog("ただ、強さは人間の数十万倍ですが……", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("あの巨大な眼球に凝視された時……徐々に理性が\\n溶かされていった感覚をバイジュウは思い出す。")
	novel_interface.show_character("milk_normal","solemn")
	await novel_interface.show_dialog("人間が悪夢から覚めた時と似ているね……", "ミルク")
	await novel_interface.show_dialog("そうなると、ブリーフィングの時に言っていた\\n南極空域で検知した「異常電波」は、\\n設備の故障じゃなかったって事になるの？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("本当に確かなのか？\\nその深さに留まるだけでも、ダンプカー数台に\\nフルパワーで挟まれかのような水圧を\\n受け続ける事になるのだが……", "隊員A")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("──確かです。", "バイジュウ")
	await novel_interface.show_dialog("しかも悪いことに情報通りでした。\\n\\n『アレ』は非常に巨体で、横幅はこの潜水艦を\\n優に超えています。", "バイジュウ")
	await novel_interface.show_dialog("あれほどの巨大生物が、計り知れない水圧の下\\nどのように形態を維持しているのか……\\n私にも分かりません……", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ワーオッ！\\nじゃ、アレは海底の巨大『異質物』なのかっ！？", "隊員D")
