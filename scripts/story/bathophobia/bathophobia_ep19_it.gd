	await novel_interface.show_dialog("Ehi! Attenzione al gradino!", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Eh?!", "Lian")
	await novel_interface.hide_character()
