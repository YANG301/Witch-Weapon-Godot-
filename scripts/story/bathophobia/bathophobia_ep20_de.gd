	await novel_interface.show_text_only("Dies lässt ihnen jedoch auch keine andere Wahl, als tiefer in die Basis vorzudringen und eine strategisch vorteilhafte Position zu suchen, von der aus sie Unterstützung anfordern können.")
	await novel_interface.show_text_only("Sie werden immer weiter nach innen gezwungen, aus dem Ausstellungsraum heraus, in einen Korridor.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_dialog("Mist. Hier gibt es kein Signal.","Kadermitglied C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Leute, geht zuerst in den Kommunikationsraum. Möglicherweise finden Sie dort einige funktionierende Übertragungsgeräte.","Milch")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verstanden!","Kadermitglied C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Ich habe die 3D-Layoutkarte dieses Ortes überprüft. Unsere derzeit beste Vorgehensweise besteht darin,... \\n... nach unten zu bewegen, Richtung 8 Uhr.","Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alle Truppmitglieder sind unterschiedlich schwer verwundet. Aber sie machen weiter und bieten sich gegenseitig Deckung in Form von zwei Gruppen, einer an der Spitze und einer im Nachhinein.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(Diese Typen... sie heilen so schnell. Es scheint einfach nicht richtig... )","Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","shock",0.25)
