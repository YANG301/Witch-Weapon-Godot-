	await novel_interface.show_text_only("Девушка вздыхает.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Нашли так быстро.", "Генриетта")
	await novel_interface.show_dialog("Даже с новым телом я по-прежнему связан контрактом…", "Генриетта")
	await novel_interface.hide_character()
