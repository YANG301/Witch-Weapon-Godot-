	await novel_interface.show_dialog("… !!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_text_only("Раскинув руки, она спокойно стоит передо мной… Но я просто не могу оторвать глаз от этой гламурной сцены.")
	await novel_interface.show_text_only("В воздухе витает слабый аромат цветов апельсина и фиалки.")
	await novel_interface.show_text_only("Девушка медленно открывает глаза.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Какой интригующий, сказочный «результат»…", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Она смотрит вокруг.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Это… современное время!?", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("В ее глазах растущее волнение сменяет пустое замешательство.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Вода и углерод, хлорид натрия и сера, кремний и железо…", "Блондинка")
	await novel_interface.show_dialog("Они создали такой красивый…", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Она недоверчиво смотрит на свои дрожащие руки.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Прикосновение тела…", "Блондинка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка медленно ощупывает свое тело сверху вниз.")
	await novel_interface.show_text_only("Я вдруг понимаю, что мне не следует смотреть, поэтому немедленно отворачиваюсь.")
	await novel_interface.show_text_only("Но я не могу не бросить на нее взгляд...")
	await novel_interface.show_text_only("Она... даже прикасается к ней... к ней...!!")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Даже это... воссоздано?", "Блондинка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("… Свет был настолько сильным, что я ничего не видел!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("У нас есть всевозможные планы действий в чрезвычайных ситуациях, но какое-то время никто из нас троих не знает, что делать дальше.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Итак…", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Блондинка взглянула на Анну и Рафаэля, которые все еще были напряжены, и ее взгляд упал на меня, выглядевшего скучным.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Вы сотворили это чудо?", "Блондинка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка медленно приземляется на пол и уважительно делает шаг назад.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("… Э? \\n(Я не знаю, где искать!!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Или ты сделал этот контейнер для моей души?", "Блондинка")
