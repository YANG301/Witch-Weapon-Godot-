	await novel_interface.show_dialog("Черт… Поток пространства-времени…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Позади Генриха появляется зеркало, которое вращается против часовой стрелки и напоминает волны.")
