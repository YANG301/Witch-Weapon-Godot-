	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ха… Может быть… Да?", "Lian")
	await novel_interface.show_text_only("Извините, я только что слегка толкнул столб!")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка кладет руку на грудь и слегка кланяется мне.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Итак, если вам нравится…", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Она смотрит мне в глаза. \\nЯ прочитал сильное желание в ее голубых глазах.")
