	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ээээссенция?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Стоп!")
	await novel_interface.show_text_only("Остановите странное воображение!!!")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("«Алхимия, поиск мудрости стихий и жизни».", "Блондинка")
