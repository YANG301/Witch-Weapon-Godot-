# bathophobia_ep09.gd - 深海恐惧篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep09_script()

func play_script():
	pass

func bathophobia_ep09_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/liliu_observation.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Стоя на контрольной станции на берегу напротив платформы, Mariru может видеть нас на первом этаже и в наблюдательной комнате сенаторов.")
	await novel_interface.show_text_only("Из зала доносятся три глубоких, тихих предупреждения, указывающие на готовность Mariru.")
	await novel_interface.show_text_only("Рафилия машет рукой Mariru. Мы с Annie зорко стоим рядом с ней.")
	await novel_interface.show_dialog("Проект «Ковчег», эксперимент номер один.", "Mariru")
	await novel_interface.show_dialog("Щит будет деактивирован через десять секунд.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("На базе оперативного стола появляется обратный отсчет с красными цифрами.")
	await novel_interface.show_text_only("Шлюз закрывается, и ступеньки убираются в стену.")
	await novel_interface.show_text_only("Звуки скрежета шестерен доносятся из верхней части зала, а автоматический набор оружия, спрятанный в потолке, нацелен на стол, готовый выстрелить в любой момент.")
	await novel_interface.show_text_only("Я, как рыба в глубоком океане, стою посреди тьмы.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Я чувствую себя осужденным преступником…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда на меня направлено столько оружия, я чувствую себя крайне напряженным.")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Расслабься, Рен. Я защищу тебя!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie тоже нервничает... Ее пальцы так сильно сжимают бейсбольную биту, что ногти бледнеют, но она все равно меня утешает.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Хм, трус.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В тот момент, когда таймер доходит до нуля, Рафилия быстро тянет рычаг.")
	await novel_interface.show_text_only("Прозрачный щит, окружающий платформу, быстро сжимается вниз, а затем исчезает.")
	await novel_interface.show_text_only("Когда Ляписовый Столб слегка приподнимается, меня охватывает более сильное чувство.")
	await novel_interface.show_text_only("Я чувствую, как моя кровь закипает, и внезапно у меня возникает необъяснимый порыв.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Ой... Животик болит сильнее...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Если я попрошу перерыв в туалет, они, вероятно, захотят меня убить…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/bedstand.png")
	await novel_interface.show_text_only("Пространство наверху внезапно дрожит, и луч света быстро проносится над нашими головами и мчится в конец зала.")
	await novel_interface.show_text_only("Затем мне в грудь ударили два коротких гудка, сигнализируя о том, что фальшивая система запущена.")
	await novel_interface.show_text_only("Высокий слой оптического камуфляжа в зале и специально обработанное стекло наблюдательной комнаты гарантируют, что сенаторам не попадет ни один звук.")
	await novel_interface.show_text_only("По их мнению, Рафилия, Annie и я должны немедленно исчезнуть вместе с Ляписовой колонной.")
	await novel_interface.show_text_only("После этого они увидят изображения, которые мы подделали.")
	await novel_interface.show_text_only("Шоу идет. Прямо в центре сцены, другого выхода у меня нет.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Придется выдержать это…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я делаю шаг вперед и осторожно протягиваю руку.")
	await novel_interface.show_text_only("Когда моя рука приближается к столбу, я нервно закрываю глаза и задерживаю дыхание, \\nпока кончики пальцев не коснутся столба.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("… ?")
	await novel_interface.show_text_only("Я медленно открываю глаза.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Похоже… ничего не произошло.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я кладу всю ладонь на столб. Ощущение мрамора.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Хм…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я пробую другой угол и сильно толкаю его. \\nСтолб весом более пятнадцати тысяч фунтов остается неподвижным.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Тск!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия изливает на меня презрение.")
	await novel_interface.show_text_only("То, что ничего не происходит, — это результат, которого я хочу больше всего среди всех предположений, которые мы сделали во время подготовительной встречи.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Но почему... мне немного неловко...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Пока моя рука все еще лежит на столбе, атмосфера неловкая. Как раз в тот момент, когда я подумываю нажать на нее сильнее, мое сердце внезапно резко дергается.")
	await novel_interface.show_text_only("Почти в то же время столб дрожит.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Затем колонна ускользает из моей руки, оставляя небольшую щель, которая медленно расширяется.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("— Э?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Высокая платформа и нижняя часть колонны скрипят, издавая глубокие, тихие звуки…")
	await novel_interface.show_text_only("Национальное достояние Salmonton, артефакт, символизирующий просвещение человечества в эпоху Возрождения, — Тесхаймский лазуритовый столб…")
	await novel_interface.show_text_only("… медленно разрушается в направлении, в котором я нажимаю…")
	await novel_interface.show_text_only("И он падает все быстрее и быстрее.")
	await novel_interface.show_text_only("Бум——!!!")
	await novel_interface.show_text_only("Мощный взрыв происходит, когда колонна сталкивается с металлической платформой и разбивается на две части. Дальняя часть даже сдвигается на несколько дюймов вперед.") #缩减符号
	await novel_interface.show_text_only("Мелкие осколки разлетаются вокруг, а самый дальний кусок даже скатывается в лужу впереди.")
	await novel_interface.show_text_only("Наступает долгое молчание…")
	await novel_interface.show_text_only("На какое-то время даже Рафилия потеряла свое обычное высокомерие и выглядела крайне шокированной.")
	await novel_interface.show_text_only("Затем она медленно поворачивается ко мне.")
	await novel_interface.show_text_only("Я вижу огонь, горящий в ее глазах.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Нет, я... я не...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_flare.png")
	await novel_interface.show_text_only("Когда я изо всех сил пытаюсь придумать, как спасти свою задницу, из ниоткуда доносится звук колокольчиков.")
	await novel_interface.show_text_only("Обломки, лежащие на полу, раскололись на еще более мелкие части и начали летать, как листы бумаги, унесенные порывом ветра.")
	await novel_interface.show_text_only("Отражая разноцветные дуги света, фрагменты столба образуют несколько колец и уплывают вверх.")
	await novel_interface.show_text_only("Наконец, все осколки рассеиваются в воздухе, оставляя многочисленные плавающие кольца света, освещающие весь зал.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Вау…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не могу не прикоснуться к кольцу, состоящему из мелких осколков...")
	await novel_interface.show_text_only("Кольцо тут же распадается на золотые точки света.")
	await novel_interface.show_text_only("Плавающие точки разлетаются, как пыль.")
	await novel_interface.show_text_only("Затем они концентрируются и создают всё более ослепительный свет…")
	await novel_interface.show_text_only("Из-за резящей глаза яркости передо мной появляется золотоволосая девочка-подросток.")
