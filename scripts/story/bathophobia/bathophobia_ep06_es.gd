# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("De pie en el podio, Mariru presenta un informe completo de avances sobre las investigaciones recientes durante la videoconferencia de rutina.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Respecto al Proyecto Arca…", "Kirs")
	await novel_interface.show_dialog("De la lista de reliquias proporcionada por Salmonton, has elegido el Pilar de Lapislázuli de Tesheim, ¿verdad?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Sí, señor. Ahora la clave es cómo crear un área de flujo controlable.", "Mariru")
	await novel_interface.show_dialog("Todos los casos recientes de flujos espacio-temporales en todas las ciudades académicas fueron causados por el contacto humano con elementos que tenían propiedades Substance H.", "Mariru")
	await novel_interface.show_dialog("Esos elementos habían permanecido inactivos durante mucho tiempo pero se activaron casi al mismo tiempo.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Más precisamente, Witch's Shard y Grimoire Fragments. Pero será mejor que lo explique en términos sencillos).", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Te refieres al día en que desapareció el cáliz Ross...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Aún no podemos confirmar su conexión.", "Mariru")
	await novel_interface.show_dialog("Debido a que hay demasiados factores incontrolables, tenemos que filtrar todas las reliquias según dos criterios.", "Mariru")
	await novel_interface.show_dialog("En primer lugar, tiene que ser una sustancia de baja actividad que presente propiedades Substance H según el escaneo de tonos.", "Mariru")
	await novel_interface.show_dialog("En segundo lugar, el propietario original es rastreable en los registros históricos y esta persona no debe tener tendencias violentas ni cometer actos delictivos.", "Mariru")
	await novel_interface.show_dialog("El pilar de lapislázuli de Tesheim fue originalmente propiedad de Heinrich Khunrath, médico y alquimista del Renacimiento.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Baja actividad... Qué lástima... Esperaba que esta vez pudiéramos recopilar datos más cercanos al valor crítico.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("La muestra es demasiado preciosa para perderla. Es mejor mantenerse en el lado seguro.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Solo necesito demostrar la capacidad de Ren para atravesar áreas de flujo. Para eso, solo necesitamos actuar).","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(De hecho, el Pilar de Lapislázuli de Tesheim no es un fragmento de bruja) \\n(Es solo un cuasi Substance H con inscripciones mágicas).","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Tocar un fragmento de bruja es demasiado peligroso para la gente común.) \\n(Después de todo, no soy el hombre gorila...)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una carcajada profunda surge de la pantalla.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alquimista… Un pionero de la ciencia, ¿eh? \\nQué elección tan interesante.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Escuché que era una obra de arte de gran importancia histórica, y el propietario, Heinrich, fue uno de los fundadores de Rosenkreutz...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Los Rosenkreutz eran sólo un grupo religioso y ocultista. No tiene nada que ver con la actual agencia de inteligencia de Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Supongo que los alquimistas pueden ser vistos como los científicos de esa época. Con suerte, era un hombre asombrado por lo desconocido.", "Mariru")
	await novel_interface.show_dialog("Pero conoces bien al Dr. Dekkers. Él nunca nos prestaría una reliquia tan importante sin un costo, a menos que...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un extraño silencio llena la habitación.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Así es. El lado Salmonton quiere compartir datos y un representante en nuestro equipo.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Entonces, no han renunciado a producir más brujas...) \\n(¿Quieren usar a Ren como estabilizador?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Bien anotado. Solo quiero confirmar que todos, incluido el lado Salmonton, comprenden el peligro de este experimento.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Afirmativo. Hemos transformado las mega instalaciones de drenaje subterráneo de la antigua capital en la Base Ark, en caso de que ocurra el peor escenario.", "Kirs")
	await novel_interface.show_dialog("El sistema de intrusión de agua de mar ultrarrápido puede inundar toda la base en 30 segundos.", "Kirs")
	await novel_interface.show_dialog("Si algo sale mal durante el experimento...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("En ese caso, espero que nuestro querido Mariru tenga el valor de iniciar el dispositivo de autodestrucción de emergencia.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
