# bathophobia_ep19.gd - 深海恐惧症篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep19_script()

func play_script():
	pass

func bathophobia_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("Descemos as escadas e chegamos a uma sala de exposição.")
	await novel_interface.show_text_only("Surpreendentemente, os sistemas de energia e ventilação ainda parecem estar funcionando bem. A qualidade do ar aqui parece boa.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("É um edifício tão grande... mas por que parece tão vazio?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Tudo parece estar funcionando bem...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As exposições são iluminadas com um brilho misterioso. O som dos ventiladores funcionando pode ser ouvido à distância.")
	await novel_interface.show_text_only("Está escuro, escuro o suficiente para esconder qualquer predador em potencial, escondido nos cantos, observando cada movimento nosso...")
	await novel_interface.show_text_only("Observamos cuidadosamente o que nos rodeia antes de finalmente dirigirmos a nossa atenção para os itens expostos.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Esses espécimes são...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma exposição na caixa transparente, sustentada por uma prateleira de vidro orgânico, chama minha atenção. Assemelha-se a algum tipo de animal marinho.")
	await novel_interface.show_text_only("Tem um corpo escorregadio e brilhante em uma cor branca translúcida. A cauda também é elegante. Parece o tipo de animal que só sobreviveria nas profundezas do oceano.")
	await novel_interface.show_text_only("Se a parte de trás fica assim, eu me pergunto como fica de frente...")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("__ELIPSE__ !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vou até o outro lado para dar uma olhada e suspiro de surpresa e desgosto.")
	await novel_interface.show_text_only("A criatura tem oito garras grossas e impróprias, cada uma com duas juntas, muito parecidas com dedos humanos.")
	await novel_interface.show_text_only("E nas palmas das mãos há o que parecem pequenas bocas que contêm dentes minúsculos e farpados. No lugar dos lábios há tecido musculoso e vermelho.")
	await novel_interface.show_text_only("Me lembra daqueles alienígenas que agarram seu rosto e nunca mais o soltam, do tipo que você vê em filmes de terror de grau B.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Por que algo assim estaria em exibição... ?", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso é algum tipo de acessório de filme?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Não. Este é um espécime de uma criatura real e existente.", "Raphael")
	await novel_interface.show_dialog("Foi o resultado de uma experiência genética fracassada durante a guerra. Já vi muitos deles no Salmonton Research Institute.", "Raphael")
	await novel_interface.show_dialog("Mais tarde, eles foram considerados inúteis e abandonados depois de um tempo.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Mesmo assim, as pessoas costumam tratá-los como lixo biológico...", "Raphael")
	await novel_interface.show_dialog("É raro ver algo assim em exposição, como se fosse uma obra de arte.", "Raphael")
	novel_interface.change_2nd_expression("jeer")
	await novel_interface.show_dialog("O dono desta instalação deve ser um canalha. Ainda maior do que você!", "Raphael")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu não sou um canalha! Nossa!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De qualquer forma, essa coisa realmente parece um pouco... você sabe... perturbadora.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("E o que é pior, não há ninguém aqui.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("É como uma cidade totalmente vazia. Dá para perceber que alguns cantos estão enferrujando pelo desuso.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("Ei! Cuidado com o seu passo!", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hein?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tropeço em um cartucho e caio na direção da vitrine. Bem quando estou prestes a bater minha cabeça na curva fechada—")
	await novel_interface.show_text_only("Raphael dá um passo à frente e me puxa de volta no tempo.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Que desajeitado...", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	await novel_interface.show_dialog("Uau! Isso foi perto!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Obrigado, Raphael.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Abro os olhos e me encontro nos braços de Raphael, como se estivéssemos realizando uma dança de salão. Eu tenho que admitir que ela parece... legal, assim. Material total para namorado.")
	await novel_interface.show_text_only("Raphael tosse sem jeito, me libertando de suas mãos.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Saímos da sala expositiva e encontramos um corredor, com o chão coberto por tábuas metálicas.")
	await novel_interface.show_text_only("As luzes são significativamente mais brilhantes aqui. A atmosfera também é significativamente mais assustadora. Muito quieto. Eu não gosto disso.")
	await novel_interface.show_text_only("Ainda assim, o ruído branco das máquinas em funcionamento pode ser ouvido. O que significa—")
	await novel_interface.show_text_only("Esta base não está completamente morta.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Se alguém ainda está por perto para operar as máquinas, já não deveria ter vindo nos cumprimentar?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","smile",0.25)
	await novel_interface.show_dialog("Ou, se não forem do tipo amigável, também poderiam ter lançado o ataque.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente, notei um ponto de luz se movendo na escuridão. Depois de olhar mais de perto, descobri que era uma câmera de vigilância não muito longe dali que estava voltada para nós.")
	await novel_interface.show_text_only("Eu aceno para isso.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Uh, com licença...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Você parece tão feminina fazendo isso.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael comenta.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Vamos lá, quem quer que esteja aí, não pode simplesmente sair e falar conosco?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Ainda assim, não sinto que alguém esteja nos observando...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Talvez a câmera de vigilância tenha se voltado para nós porque sentiu nossos passos? Talvez ninguém a esteja controlando?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No entanto, dispositivos ativados por som não são usados há décadas. Muito fraco. Até mesmo um minúsculo gerador ultrassônico poderia paralisá-los.")
	await novel_interface.show_text_only("A câmera de vigilância ainda está funcionando, mas não parece que alguém a esteja controlando.")
	await novel_interface.show_text_only("Estou meio desapontado e decido assustar um pouco a pobre Raphael. Num tom pretensioso e sinistro, digo a ela:")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Veja, você pode não acreditar em mim, mas na verdade...", "Lian")
	await novel_interface.show_dialog("Eu posso ver pessoas mortas...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Você... você quer dizer que há fantasmas aqui?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael grita com uma voz estranhamente aguda.")
	await novel_interface.show_text_only("Ela então percebe que estou apenas fazendo palhaçada e corre para me bater na cabeça.")
	await novel_interface.show_text_only("Na tentativa de recuar, caio no chão, minha Jade de Fogo rolando para fora da camisa.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Raphael, eu não queria—ah... acho!\\nDesculpe, não sabia que você era uma gata tão assustada...", "Lian")
	await novel_interface.show_dialog("Ugh, que frio...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hmph!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se acalma um pouco ao me ver encolhida no chão, tremendo de frio sem a proteção da jade.")
	await novel_interface.show_text_only("Por que está tão frio mesmo estando dentro de casa... ?")
	await novel_interface.show_text_only("Corro para pegar meu Fire Jade.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Não está um pouco frio demais? Como é que as pessoas da base vivem assim?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observando com atenção, descobri que muitos lugares nos cantos da parede já estavam congelados...")
	await novel_interface.show_text_only("Isso me lembra vagamente um jogo sobre sobrevivência no gelo e na neve...")
	await novel_interface.show_text_only("Esse jogo era sobre produzir recursos ou algo assim. E teve um final bastante bizarro.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Espere...)", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette coloca a palma da mão na parede mais uma vez.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ei, não destrua essa parede também...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela é o tipo de pessoa que arrancaria totalmente um pilar inteiro se não tomasse cuidado.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Algo não parece certo.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A alquimista loira franze a testa, com o rosto solene.")
	await novel_interface.show_text_only("Uma onda de ar parece fluir em todas as direções, começando onde a palma da mão está pressionada.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("O quê?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("... Estamos presos.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Eh?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corro até o fim do corredor. A porta da sala de exposição não está trancada. Não, estamos bem. Totalmente não preso.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Pare de me assustar, nossa...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com uma mão sobre o coração, sigo em direção à sala de arquivo pela qual acabamos de passar. A porta está aberta.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room.png")
	await novel_interface.show_text_only("A sala está bem iluminada e parece muito mais aconchegante que o corredor.")
	await novel_interface.show_text_only("Muito ocupado olhando em volta, quase tropeço em uma rachadura no piso.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Cuidado onde pisa, desajeitado.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael está parada na porta da sala de arquivo, de olho em mim por um lado e por Henriette por outro. O alquimista ainda parece estar intrigado com a parede do corredor.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Espere. Por que sinto uma corrente de ar nesta sala?", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Poderia ser...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pego meu Fire Jade e coloco sobre a mesa, para sentir melhor a temperatura do ambiente.")
	await novel_interface.show_text_only("Com certeza, a temperatura aqui é muito mais alta do que no corredor gelado. Há aquecimento – tão quente que é difícil acreditar que estamos na Antártida.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ei...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Espere. Quando passamos por esta sala, lembro-me de olhar para a estante.\\nAlgo parece diferente...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Ou é apenas minha memória pregando peças em mim?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Coçando a cabeça, caminho em direção à porta.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Cuidado com seus pés.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Entendi. Quase tropecei naquela rachadura gigantesca no chão agora há pouco. Não cometerei o mesmo erro novamente—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu digo, apontando para o chão para deixar claro meu ponto de vista. Mas espere...")
	await novel_interface.show_text_only("Não há nenhuma rachadura. As telhas estão todas intactas.")
	await novel_interface.show_text_only("Ladrilhos de mármore lisos e elegantes. Quase como um espelho. Até reflete minha calcinha azul e branca—")
	await novel_interface.show_text_only("Ops. Eu imediatamente fecho minhas pernas.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algo realmente não está certo.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("... Alguma coisa errada, Ren?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("O que você está fazendo aí?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Houve uma rachadura aqui agora há pouco. Mas acabou...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não poderia ter me lembrado errado, porque quase tropecei nele.")
	await novel_interface.show_text_only("O chão, onde deveria haver uma rachadura...")
	await novel_interface.show_text_only("A sala de arquivo, o único lugar aquecido...")
	await novel_interface.show_text_only("A prateleira, na qual os objetos parecem ter mudado de ordem...")
	await novel_interface.show_text_only("Posso sentir meu coração batendo loucamente em meu peito.")
	await novel_interface.show_text_only("Cautelosamente, dou um passo à frente.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Ei, o que você quer dizer com conectar nas rachaduras? Você ainda quer que eu te ajude...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael parece irritada. Ela definitivamente não está brincando – ela realmente vê uma rachadura no chão.")
	await novel_interface.show_text_only("Mas até onde posso ver (e sentir), não há rachadura.")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("... Algo não está certo. O que você vê e o que eu vejo... são diferentes.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como isso poderia ser... ?")
	await novel_interface.show_text_only("Enervado, pego meu walkie-talkie na tentativa de entrar em contato com Annie ou Mariru. Isso pelo menos me daria uma aparência de segurança.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Olá? Annie? Você aí?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não há resposta. Afinal, estamos no subsolo, o sinal provavelmente não chega tão longe.")
	await novel_interface.show_text_only("Percebendo a confusão no meu rosto, Raphael e Henriette entram na sala do arquivo também.")
	await novel_interface.show_text_only("A sala de arquivo que parece completamente diferente daquela pela qual acabamos de passar.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Parece que estou sonhando, mas sei que não estou.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Esta sala e aquela pela qual passamos... não são a mesma sala.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, ouvimos sons estranhos e perturbadores vindos do corredor externo.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Quem está aí?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianContact.png")
	await novel_interface.show_text_only("Raphael e Henriette entram em modo de batalha imediatamente.")
	await novel_interface.show_text_only("Logo atrás de mim vem correndo uma horda inteira de inimigos com olhares sinistros em seus rostos e lâminas em suas mãos.")
	await novel_interface.show_text_only("Não há nada em seus olhos, exceto pura hostilidade.")
	await novel_interface.show_text_only("Eu agarro meu taco de beisebol com força...")
	print("=== 深海恐惧症篇第19话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
