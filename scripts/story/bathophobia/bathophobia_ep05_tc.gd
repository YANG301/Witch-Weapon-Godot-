# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("「靈魂」是什麼？")
	await novel_interface.show_text_only("是記錄著意識的某種能量，還是無法觀測的量子存在？")
	await novel_interface.show_text_only("或許，「靈魂」只是一種概念。")
	await novel_interface.show_text_only("就像物理學中「時間」的概念一樣──")
	await novel_interface.show_text_only("只是一種幻覺……或者，一場夢。")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("那麼唯一的問題只有──")
	await novel_interface.show_text_only("做夢的人是誰？")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("南極輻合帶，冰冷刺骨的寒意似乎阻擋著外界所有進一步的探究。")
	await novel_interface.show_text_only("海平面下6100公尺，深淵水層。")
	await novel_interface.show_text_only("以鈦合金耐壓外殼包裹的深潛艙正緩緩地沉降。")
	await novel_interface.show_text_only("艙體狀態燈所發出的微弱光線，不出10公分就被黑暗吞噬殆盡。")
	await novel_interface.show_text_only("光線以外，盡是無法感知的空間。")
	await novel_interface.show_text_only("一隻色彩詭異的尖牙魚試著撞擊艙身，但沒有收到任何回應。")
	await novel_interface.show_text_only("60兆帕的巨大水壓不斷考驗著深潛艙的極限。") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("突然，深潛艙的8組探照燈按照預設順序同時打開，筆直射出八道狹長光柱。") #换行问题
	await novel_interface.show_text_only("像刺入黑暗的長劍，瞬間爆發出炫目光芒。")
	await novel_interface.show_text_only("一縷光線從幾十公分厚的觀察窗射入，照亮了艙內沉睡中的少女。")
	await novel_interface.show_text_only("黑灰色的長髮反射出淡藍色的光澤，柔順地披散在少女冰玉般透亮無暇的臉上。")
	await novel_interface.show_text_only("在她面前，控制台上的深度探測儀已經失效，深度顯示還停留在1247公尺。")
	await novel_interface.show_text_only("外部探照燈的光芒逐漸暗淡，少女周圍卻閃耀著一層隱晦的銀白微光。")
	await novel_interface.show_text_only("在足以喚醒人類最恐懼事物的海洋深處，傳來了一陣低沉悠遠的聲音。")
	await novel_interface.show_text_only("如同來自遠古的召喚。")
	await novel_interface.show_text_only("沉睡的少女彷彿從母體中被喚醒。")
	await novel_interface.show_text_only("隨之而來的，是被壓迫的眩暈感和無法克制的嘔吐欲望……")
	await novel_interface.show_text_only("現在深度已經遠超過4500公尺的安全限制，深潛艙的金屬外殼開始發出怪聲。")
	await novel_interface.show_text_only("少女發出壓抑著的嗆咳。")
	await novel_interface.show_text_only("起初有些呼吸困難，但在調整幾次呼吸後，她很快適應並穩定了下來。")
	await novel_interface.show_dialog("剛才撞擊的關係嗎？ 我好像暈過去了。", "少女")
	await novel_interface.show_dialog("目前還能正常呼吸，代表含氧量正常。", "少女")
	await novel_interface.show_dialog("從呼氣會產生白霧看來……果然，\\n艙內已經接近0度了嗎……", "少女")
	await novel_interface.show_dialog("主系統檢查，準備冷啟動。 \\n身分訊息：白燭。", "少女")
	await novel_interface.show_text_only("名為白燭的少女似乎不擔心低溫可能對身體產生的影響，只是認真地檢查各個系統。")
	await novel_interface.show_text_only("這是她與生俱來的能力；當初還是嬰兒的她，被發現時，已經在冬日冰封的深山中過了一整夜。")
	await novel_interface.show_text_only("經過後來一系列的檢查，發現這個小女孩奇蹟般地能適應各種寒冷環境。")
	await novel_interface.show_text_only("在成年人30秒內就會失去意識的極端低溫下，她始終能保持正常體溫，手掌還很溫暖。")
	await novel_interface.show_text_only("直到養父將小白燭從孤兒院接走為止，那些醫生也沒能搞清楚原因。")
	await novel_interface.show_dialog("照明動力系統正常，感測器重啟後也OK。", "白燭")
	await novel_interface.show_dialog("居然沉到6000公尺了……「那個東西」不可能會在壓力這麼大的地方吧。", "白燭")
	await novel_interface.show_dialog("要節省電力返航……先關掉探照燈好了──", "白燭")
	await novel_interface.show_text_only("在探照燈熄滅前一刻，白燭用餘光掃到觀察窗外。")
	await novel_interface.show_dialog("什……", "白燭")
	await novel_interface.show_text_only("那令人驚悚的畫面，讓少女瞬間寒毛倒豎僵在那裡。")
	await novel_interface.show_dialog("那是……什麼……", "白燭")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("探照燈熄滅前一秒，照亮了觀察窗外一片巨型珊瑚狀組織。")
	await novel_interface.show_text_only("一圈崎嶇不平的血紅色組織像瀑布般往中心點凹陷，形成巨大深邃的黑洞。")
	await novel_interface.show_text_only("可是，剛才掃描周圍的區域時，並沒有發現任何生物或地形構造。")
	await novel_interface.show_text_only("白燭立刻打開艙外的廣角鏡頭，試圖看清全景──")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("螢幕上，白燭看到黑暗中一個橫向展開超過90公尺、長著觸鬚、巨大而模糊的影子。")
	await novel_interface.show_dialog("怎麼可能……", "白燭")
	await novel_interface.show_text_only("可以確定的是，這絕對不是地形而是某種生物，在黑暗中可以觀察到上面流動著的紅色光斑。")
	await novel_interface.show_dialog("那是……眼球嗎？", "白燭")
	await novel_interface.show_text_only("──如果，那種誇張的東西能稱作是「眼球」的話，")
	await novel_interface.show_text_only("那麼，觀察窗正對著的凹陷黑洞就是瞳孔。")
	await novel_interface.show_text_only("因為太過接近反而無法判斷距離，好像隨時都會被吸進去一樣。")
	await novel_interface.show_text_only("流動的光斑漸漸消失，在沉默的黑暗中，少女與不知名的物體對峙著。")
	await novel_interface.show_text_only("慢慢適應黑暗環境後，能看到螢幕上那個巨大的眼球本身發出的微弱紅光，彷彿不透明的水母。")
	await novel_interface.show_text_only("眼球內充斥著似乎隨時都會傾巢而出的組織物，\\n而每次鼓動都與少女的心跳合拍。")
	await novel_interface.show_dialog("（冷靜……冷靜！ ）\\n（仔細想想……）", "白燭")
	await novel_interface.show_text_only("如果那真的是眼球的話，水晶體應該對光線非常敏感。")
	await novel_interface.show_text_only("眼球之下，脈絡膜結構的位置，在黑暗中閃爍著密密麻麻的白色光點。")
	await novel_interface.show_text_only("白燭注意到螢幕中眼球的後方，連接著枝枒一般的觸鬚。")
	await novel_interface.show_text_only("灰黑色的觸鬚浸沒在海洋深處，似乎沒有盡頭。")
	await novel_interface.show_dialog("（……身體……動不了……）", "白燭")
	await novel_interface.show_text_only("——與其說是對峙，不如說是「那個東西」在單方面觀察著少女。")
	await novel_interface.show_text_only("這種極具壓迫感的觀察而造成的恐慌，正在慢慢消磨少女的理智。")
	await novel_interface.show_dialog("哈……", "白燭")
	await novel_interface.show_text_only("——我……會被吞噬嗎？")
	await novel_interface.show_text_only("這深海中的奇異景象，讓她懷疑起自己的存在。")
	await novel_interface.show_dialog("（是夢嗎……）\\n（是的話就快點醒來啊……）", "白燭")
	await novel_interface.show_text_only("然而本能卻比意識快一步掙脫了枷鎖。")
	await novel_interface.show_text_only("隨著少女左手拉動操縱桿，潛水倉繼續向眼球前進了一段距離。")
	await novel_interface.show_text_only("水流傳來的波動顯示「那個東西」似乎被驚動了。")
	await novel_interface.show_text_only("眼球緊縮了一下，觀察著少女的下一步動作。")
	await novel_interface.show_dialog("喂？ 喂喂？", "白燭")
	await novel_interface.show_text_only("白燭摸到了自己佩戴的耳機，嘗試與控制中心的人通訊。")
	await novel_interface.show_text_only("但是這個深度的海水足以屏蔽任何電磁波，現在又不能嘗試水下通訊。")
	await novel_interface.show_dialog("……", "白燭")
	await novel_interface.show_text_only("如果是她的話，一定會在耳機裡拼命對我喊——\\n「別再繼續靠近了！」")
	await novel_interface.show_dialog("哈哈……為什麼我會想這些……", "白燭")
	await novel_interface.show_dialog("「她」……又是誰？", "白燭")
	await novel_interface.show_dialog("這是……哪裡……", "白燭")
	await novel_interface.show_text_only("在眼球注視的壓力下，白燭的神智開始恍惚，真實和虛幻的邊界逐漸模糊。")
	await novel_interface.show_text_only("少女的手慌亂地在控制台上摸索著。")
	await novel_interface.show_text_only("很快，她找到了採樣機械臂的操作器。")
	await novel_interface.show_dialog("（真的要……這麼做嗎……）", "白燭")
	await novel_interface.show_text_only("白燭逐漸穩住自己的心神，但依然有幻覺似的光斑在她眼前晃蕩。")
	await novel_interface.show_dialog("好，取樣……然後馬上離開……", "白燭")
	await novel_interface.show_text_only("先把探照燈都調往正前方……")
	await novel_interface.show_text_only("動力系統設定到最大航速，方向……往後。")
	await novel_interface.show_text_only("少女光是強打精神一步步做完這些前置步驟，就已經快要暈過去了。")
	await novel_interface.show_dialog("父親，這就是……精神污染嗎……\\n我快要……", "白燭")
	await novel_interface.show_text_only("白燭慢慢地調整著操作器，機械臂逐漸展開，露出一個巨大的針頭──")
	await novel_interface.show_dialog("抽吸模式……這種壓力只要壓一下……", "白燭")
	await novel_interface.show_text_only("機械臂一直向前伸出，直到針頭刺入了眼球的玻璃體內。")
	await novel_interface.show_text_only("一瞬間，採樣容器的飽和值就從0%飆升到100%。") #标点删除
	await novel_interface.show_text_only("眼球瞳孔的位置開始扭曲變形，如果現在能聽到聲音的話，應該會是刺骨的尖叫聲吧……")
	await novel_interface.show_dialog("（是幻聽嗎……）", "白燭")
	await novel_interface.show_text_only("少女用盡最後一點力氣，按下了序列執行按鈕。")
	await novel_interface.show_text_only("依照剛才預設的順序，深潛艙的8個探照燈同時向眼球瞳孔射出強光，螺旋槳也開始快速轉動。")
	await novel_interface.show_text_only("隨著刺激和強光，眼球向後退卻，深潛艙逐漸遠離並上浮……")
	await novel_interface.show_text_only("少女終於耗盡了心神，眼前一黑倒了下去。")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
