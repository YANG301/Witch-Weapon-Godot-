	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(Tôi không biết họ đang nói về điều gì... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hiện tại, hầu hết các trạm nghiên cứu quy mô vừa và nhỏ đang trong quá trình sơ tán, mặc dù ba căn cứ chính ở Nam Cực đã thành lập một đội khẩn cấp tạm thời.","Mariru")
	await novel_interface.show_dialog("Cho đến nay, 42 nguồn rò rỉ khí mê-tan đã được xác định ở Vòng Nam Cực. Sáu địa điểm đã được đốt cháy và hình ảnh của những địa điểm đó hiện đang lan truyền như cháy rừng trên internet.","Mariru")
	await novel_interface.show_dialog("Và trên các kênh tin tức nữa. Tất cả TV trên thế giới có lẽ hiện đang chiếu đi chiếu lại cảnh ngọn lửa phun ra từ các vết nứt ở vùng đồng bằng băng ở vùng cực, bắn lên cao hàng chục mét.","Mariru")
	await novel_interface.show_dialog("Không đời nào họ có thể giữ kín chuyện này được nữa. Thế giới biết, và rõ ràng là họ đang hoảng sợ—một số người đã tổ chức ăn mừng: nỗ lực cuối cùng trước khi thế giới kết thúc.","Mariru")
