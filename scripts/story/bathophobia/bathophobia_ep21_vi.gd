	await novel_interface.show_dialog("Tiến sĩ Deckers từ Salmonton đã đề xuất một kế hoạch sử dụng vi khuẩn cổ ?a m?tan...","Mariru")
	await novel_interface.show_dialog("Nhưng hiện tại không có nhiều thứ đó trong kho, đặc biệt không phải loại có thể tồn tại trong giá lạnh. Và đã quá muộn để trau dồi thêm từ đầu.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Ngoài ra, vi khuẩn kỵ khí thực sự không thể làm được gì nhiều trong bầu khí quyển của chúng ta vì oxy sẽ giết chết chúng.","Raphael")
