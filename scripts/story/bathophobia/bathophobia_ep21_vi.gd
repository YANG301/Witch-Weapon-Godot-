	await novel_interface.show_dialog("Ngoài ra còn có một vụ hỏa hoạn do một nhóm thành viên nhóm du lịch Mt. Grove giàu có, ngu ngốc đang chơi với bình phun lửa. Đồ ngốc.","Mariru")
