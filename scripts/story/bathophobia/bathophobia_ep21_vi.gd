	await novel_interface.show_dialog("Một tàu khu trục lớp Lebona đang tuần tra ở Nam Cực vừa nhận được một loại tín hiệu tần số thấp nào đó.","Mariru")
	await novel_interface.show_dialog("Tôi nghĩ đó là do một cơn dư chấn, nhưng xét đến tình hình hiện tại thì...","Mariru")
	await novel_interface.show_text_only("Mariru gọi hệ thống EEG của cô ấy và chạy lại phân tích mẫu.")
	await novel_interface.show_dialog("Đúng như tôi mong đợi...","Mariru")
	await novel_interface.show_dialog("Tín hiệu này... nó có kiểu giống như sóng não trong giấc ngủ REM của con người...","Mariru")
	await novel_interface.show_dialog("... Nhưng dữ dội hơn sáu mươi hai lần.","Mariru")
	novel_interface.show_character("raphael","subtle")
