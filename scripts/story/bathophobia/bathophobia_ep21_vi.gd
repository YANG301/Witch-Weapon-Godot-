# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Những bóng người kỳ lạ đột nhiên xuất hiện trên hành lang đi thẳng tới chỗ chúng tôi.")
	await novel_interface.show_text_only("Họ hoàn toàn im lặng - ngoài tiếng vải xào xạc và tiếng bước chân lộp cộp. Họ thậm chí có cần thở không?")
	await novel_interface.show_text_only("Tôi nắm chặt vũ khí, chuẩn bị tinh thần. Đó là lúc những tia sáng mạnh bắn ra từ bộ đồ chiến đấu của Henriette. Cô ấy biến mất khỏi tầm mắt trong nháy mắt, không để lại gì ngoài một làn khói sáng.")
	await novel_interface.show_text_only("Trong khi tôi vẫn còn choáng váng, Heinrich đã né được trước mặt một người và tấn công một trong những người phụ nữ trên tấm giáp ngực bằng lưng thanh kiếm lưu ly của mình.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wow, cô ấy có một số động thái!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Âm thanh lớn, bị bóp nghẹt khi vũ khí của cô chạm vào mục tiêu vang vọng từ các bức tường hành lang. Tôi thề là chỉ nghe thôi mà ngực tôi đã đau rồi.")
	await novel_interface.show_text_only("Mục tiêu của cô rơi xuống đất như một con rối gỗ và lăn ra xa.")
	await novel_interface.show_text_only("Bất kỳ con người nào cũng sẽ hành động theo bản năng để bảo vệ bản thân khỏi bị thương thêm—nhưng cô gái bù nhìn này lại không làm điều tương tự.")
	await novel_interface.show_text_only("Khi cô ấy ngừng lăn, cô ấy chỉ cần nhảy lên, ngực lõm xuống và lao về phía chúng tôi.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhận ra đây không phải là kẻ thù bình thường, Henriette quay lại, đâm xuyên qua gót chân của ba người trong số họ với tốc độ cực nhanh.")
	await novel_interface.show_text_only("Cả ba, bị đứt gân, ngã xuống đất—nhưng chúng vẫn tiếp tục bò về phía chúng tôi trong những chuyển động co thắt, im lặng đến kỳ quái.")
	await novel_interface.show_text_only("Họ trông không đáng sợ ngay từ cái nhìn đầu tiên, nhưng thực tế là họ đang thể hiện những đặc điểm rõ ràng không phải con người thì... ít nhất là rất đáng lo ngại.")
	await novel_interface.show_text_only("Họ trông giống con người. Họ không hành động như con người. Điều đó thật đáng sợ.")
	await novel_interface.show_text_only("Sau khi xác nhận rằng kẻ thù sẽ không còn là mối đe dọa nữa, Raphael tiến về phía trước để xem có vấn đề gì với chúng.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Đột nhiên, mặt đất lại bắt đầu rung chuyển.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("Lại một trận động đất nữa?","Henriette")
	await novel_interface.show_text_only("Lần này, trận động đất mạnh hơn và kéo dài hơn nhiều.")
	await novel_interface.show_text_only("Cùng với những cơn chấn động, đèn ở hành lang nhấp nháy rồi tắt, theo sau những âm thanh như tiếng rít chói tai—hoặc có thể là tiếng kim loại bị kéo mạnh.")
	await novel_interface.show_text_only("Kẻ thù trên mặt đất dường như biến thành... chất lỏng trong suốt? Bọt? Ngay trước mắt chúng ta.") #换行问题
	await novel_interface.show_text_only("Chất lỏng sau đó bắt đầu sôi và sủi bọt, như thể nó ở trên tấm teppanyaki. Trong vòng vài giây, những hình người trước đây đã bốc hơi vào hư vô.")
	await novel_interface.show_text_only("Chúng không để lại dấu vết gì trên sàn nhà lạnh lẽo. Giống như những cô gái kỳ quái đó chưa từng tồn tại.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Môi trường xung quanh chúng ta dường như cũng đã thay đổi sau trận động đất.")
	await novel_interface.show_text_only("Những món đồ trang trí bằng gỗ trong phòng lưu trữ đã vỡ vụn, chỉ còn là mùn cưa bay lơ lửng trong không trung. Lớp sơn trên tường cũng đã bong tróc.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("... Hả?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vẫn là phòng lưu trữ đó...")
	await novel_interface.show_text_only("Nhưng đèn đã tắt. Những viên gạch trên mặt đất không còn sáng bóng nữa. Và những món đồ trên kệ—được sắp xếp hoàn toàn khác nhau.")
	await novel_interface.show_text_only("Đằng sau những thanh dầm thép dày trông như công nghiệp, một camera giám sát cảm biến âm thanh khác chĩa ống kính tối màu về phía chúng tôi.")
	await novel_interface.show_text_only("Trên tường là bản đồ địa hình chi tiết của Nam Cực, và trên bàn là một cuốn sổ ghi chép những thay đổi về dữ liệu khí quyển.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("... cái gì thế này?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Những gì chúng ta vừa thấy... có phải là ảo ảnh không?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Những cô gái bù nhìn đó nữa à?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette nhìn xuống vũ khí của mình - không dính máu, mặc dù lẽ ra nó phải như vậy. Sau đó cô ấy nhìn lên nơi những kẻ tấn công bất ngờ của chúng tôi dường như đã bốc hơi.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Có lẽ những gì chúng ta đang ở... không phải là thế giới thực.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich đột nhiên bị giọng nói của Lý Đồng cắt ngang.")
	await novel_interface.show_dialog("Cuối cùng! Một kết nối!","Mariru")
	await novel_interface.show_text_only("Giọng của Mariru vang lên từ... trong ngực tôi?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Này, Mariru! Có chuyện gì với tín hiệu vậy?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ngân nga, nghe có vẻ kiệt sức. Trong khi đó, Henriette đang kinh hãi nhìn chằm chằm vào ngực tôi, bối rối không hiểu tại sao giọng của Mariru lại phát ra từ đó.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Này, đây là một sự hiểu lầm, tôi thề!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhìn thấy vẻ mặt của tôi, Henriette gật đầu, như thể cô ấy hiểu điều đó, và cũng bắt đầu sờ nắn bộ ngực của chính mình.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Thì thầm) Có phải Chủ nhân... cũng đã sửa đổi cơ thể của tôi theo cách đó không?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("Tất nhiên là không! Và tại sao trông bạn có vẻ hào hứng với điều đó?")
	await novel_interface.show_dialog("Này, nhân tiện, tại sao bạn không liên hệ với chúng tôi bằng bộ đàm?\\Annie ổn chứ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vệ tinh liên lạc hiện đã vào vị trí. Annie đang thu thập thông tin về các nguồn rò rỉ khí mê-tan. Mọi chuyện ở đó thế nào rồi?","Mariru")
	await novel_interface.show_text_only("Tôi cố gắng hết sức để sắp xếp suy nghĩ của mình và báo cáo mọi thứ chúng tôi gặp phải sau khi vào căn cứ theo cách ngắn gọn nhất có thể.")
	await novel_interface.show_dialog("... \\n(Không phải thế giới thực, huh... )","Mariru")
	await novel_interface.show_dialog("Đợi một chút, để tôi kiểm tra thời gian.","Mariru")
	await novel_interface.show_dialog("Tám phút đã trôi qua kể từ lần cuối bạn liên lạc với Annie ở cổng căn cứ.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("... Chỉ tám phút thôi à?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
