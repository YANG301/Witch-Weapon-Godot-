	await novel_interface.show_dialog("Vết nứt gần Căn cứ Snedronningen là vết nứt nổi bật nhất và các tảng băng xung quanh nó ngày càng trở nên lung lay với tốc độ đáng báo động.","Mariru")
	await novel_interface.show_text_only("Tôi không khỏi nhìn xuống tấm ván kim loại dưới chân mình.")
