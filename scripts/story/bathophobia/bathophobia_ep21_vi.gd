	await novel_interface.show_dialog("... Có lẽ không phải các bạn đang mơ đâu. Bạn có thể đã ở trong giấc mơ của người khác.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
