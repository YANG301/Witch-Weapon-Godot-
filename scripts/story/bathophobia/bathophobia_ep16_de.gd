# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Raphael fand im zweiten Stock ein paar Dieseltanks, die das Depot für ein paar Tage am Laufen halten sollten.")
	await novel_interface.show_text_only("Als der Strom unter dem rumpelnden Geräusch des Generators wieder angeht, renne ich sofort ins Badezimmer.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Im Dunkeln auf die Toilette zu gehen, wäre definitiv das Letzte, was ich tun möchte…)", "Lian")
	await novel_interface.show_dialog("(Gott sei Dank haben sie es nicht zu einem durchsichtigen Badezimmer gemacht …)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Heilige Scheiße…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich ziehe mich aus dem Badezimmer, mein Magen schmerzt immer noch. Annie scheint sich etwas erholt zu haben und kommt wieder auf die Beine.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, geht es dir gut?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Ja, mir geht es gut. Schauen wir uns mal den Kommunikationsraum an …", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Da sie kaum aufrecht stehen kann, helfe ich ihr bis in den zweiten Stock.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Der Kommunikationsraum ist innen recht rustikal eingerichtet, wo ein T-förmiger Gang bis zur geschwungenen Wand des Beobachtungsbereichs führt.")
	await novel_interface.show_text_only("Die Schränke sind gefüllt mit Trinkwasser, Konserven und anderen haltbaren Lebensmitteln.")
	await novel_interface.show_text_only("Die Luft hier scheint ziemlich frisch zu sein. Durch das Fenster können wir die Polarlichter am Nachthimmel tanzen sehen.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Mal sehen, ob das System funktioniert...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie versucht, das alte Gerät am Bedienfeld zu starten. Glücklicherweise funktioniert die gesamte „Zuverlässigkeit zuerst“-Hardware immer noch.")
	await novel_interface.show_text_only("Als gut ausgebildeter SID-Agent ist Annie mit dem System bestens vertraut. Die außerhalb des Depots installierten Antennen scheinen von den extremen Temperaturen kaum betroffen zu sein.")
	await novel_interface.show_text_only("Durch die Lüftungsschlitze in der Wand strömt langsam ein warmer und feuchter Luftstrom in den Raum.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Es sieht so aus, als ob die Heizung eingeschaltet ist.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue auf die an der Wand befestigte Temperaturanzeige, die anzeigt, dass die Innentemperatur stetig von 32 °F ansteigt.")
	await novel_interface.show_text_only("Aber die Außentemperatur… -44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wäre da nicht Heinrichs Topas gewesen...", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Bei einer Temperatur von -44 °F einen Rock tragen und im Schnee spielen…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Ich schätze, ich habe einen neuen Erfolg freigeschaltet, mit dem ich prahlen kann...)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Warten Sie... Wir sollten so schnell wie möglich Kontakt mit Mariru aufnehmen. Nur sie kann uns hier rausholen.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Apropos, was stimmt mit dem Chip nicht?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich berühre instinktiv meine Brust. Noch nie war ich so gespannt darauf, die Stimme von Mariru von dort zu hören.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Verbindung zu Satelliten herstellen… Fertig.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Den Anweisungen von Annie folgend, gebe ich eine Zahlenfolge ein, die sich lange in mein Gedächtnis eingebrannt hat.")
	await novel_interface.show_text_only("Ich muss wohl Mariru dafür danken, dass er mich gezwungen hat, die verschlüsselten Identifikationscodes von SID auswendig zu lernen.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("So funktioniert es! Interessant…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich war seit unserer Ankunft im Depot mit der Beobachtung der hier gelagerten Materialien und Gegenstände beschäftigt.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ich wollte sie schon immer in meinen Händen spüren!", "Henriette")
	await novel_interface.show_dialog("Was für eine wunderbare Kombination aus Sand, Aluminium, Kalzium, brennbaren Metallen und Basalt …", "Henriette")
	await novel_interface.show_dialog("Und der Faserungsprozess hat alle ihre Eigenschaften verändert.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Hmm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Zur Herstellung dieses Glases verwendeten sie eine neue Materialkombination. Davon habe ich noch nie gehört.", "Henriette")
	await novel_interface.show_dialog("Ihre Methode kann Wärmeverluste verhindern … Das ist wirklich clever.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Aber wir Alchemisten würden lieber die Inschriften zur Energieumwandlung verwenden, was viel einfacher ist.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Inschriften... Du meinst die Magie?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Wer würde Magie nutzen, um ein Stück Glas herzustellen?! Du könntest dafür den Verstand verlieren!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Aber die Gummiprodukte in den kleinen Packungen dort haben mich durch ihre außergewöhnliche Flexibilität wirklich beeindruckt.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Und die fruchtigen Düfte... Wofür werden sie verwendet?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ich... ich weiß es nicht!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Es ist nur Kaugummi, du dummer Perverser.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael verdreht die Augen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Um Himmels willen, Heinrich hat sich völlig in die Welt der Alchemie vertieft!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Zurück im Hauptquartier suchen Mariru und Aya nach Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Immer noch keine Spur von Rens Chip. Das ist seltsam. Der Satellitencluster deckt buchstäblich jeden Winkel der Welt ab …", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Könnte es sich um eine außerirdische Teleportation oder einen Zeitsprung handeln?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Wie das Sprichwort sagt: „Entitäten sollten nicht über das Notwendige hinaus vermehrt werden“. Einfachere Annahmen sind eher richtig.", "Mariru")
	await novel_interface.show_dialog("Tatsächlich decken die sogenannten „globalen Satelliten“ nur den Bereich zwischen 70 °N und 70°S ab.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du meinst...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Über den verschlüsselten Kommunikationskanal von SID erscheint plötzlich eine Verbindungsbestätigung.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("He-hallo?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! Da ich bin!! \\nOh mein Gott, endlich...", "Lian")
	await novel_interface.show_text_only("Als Mariru die vertraute Stimme hört, kommt sie bald zu sich. Die Spannung scheint sofort verschwunden zu sein.")
	await novel_interface.show_text_only("Während sie den Blick auf das Offline-Signal richtet, beginnt sie sofort mit der Rückverfolgung.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ren? Melden Sie Ihren Standort. \\nBist du bei den anderen Mädchen?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja, ich bin jetzt mit Raphael und Annie in einem Depot. \\nWir sind hier sicher, aber...", "Lian")
	await novel_interface.show_dialog("Wir sind jetzt... in der Antarktis.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Antarktis?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Es ist eindeutig eine Antwort, die alle Erwartungen übersteigt, aber auf Marirus Gesicht ist kein Anflug von Überraschung zu erkennen.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Hört sich an, als ob Ren nicht unter Unterkühlung leidet.) \\n(Sie müssen einen sicheren Ort gefunden haben.)", "Mariru")
	await novel_interface.show_dialog("(Gab es während des Experiments auf der Ark Base einen weiteren Raumzeitfluss?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Das Nachverfolgungsergebnis erscheint auf dem Bildschirm – Nr. 2 Gemeinsames Depot im Princess Elizabeth Land, Ostantarktis.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Jetzt ergibt alles einen Sinn... Satelliten mit niedriger Erdumlaufbahn werden dieses Gebiet nicht überfliegen, es sei denn, ihre Umlaufbahnen werden manuell geändert.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Denn der polare Sonnenwind wird die Datenübertragung unterbrechen.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Das habe ich völlig übersehen...", "Ai")
	await novel_interface.show_dialog("Sollen wir die Satelliten über der Antarktis anschließen?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ähm. Denken Sie daran, diese schlafenden alten Hunde nicht zu wecken.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Ich weiß nicht, was passiert ist... Ich wurde ganz plötzlich hierher gebracht.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Gibt es außer euch dreien noch jemanden?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Du meinst Heinrich? \\nSie ist direkt neben mir.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Ich hätte nicht erwartet, dass wir über solch antike Geräte Kontakt mit Mariru aufnehmen könnten. Ich muss zugeben, dass die Stimme von Mariru mich sehr erleichtert hat.")
	await novel_interface.show_text_only("Ich informiere sie über die aktuelle Situation.")
	await novel_interface.show_dialog("… sehr gut notiert.", "Mariru")
	await novel_interface.show_dialog("Hören Sie, Sie sind jetzt sehr nahe am Südpol, was bedeutet, dass es nicht so einfach ist, Sie abzuholen.", "Mariru")
	await novel_interface.show_dialog("Gemäß der Neuen Antarktis-Konvention der Nachkriegszeit kann jedes Land, das ein Expeditionsteam mit mehr als 5 Mitgliedern entsenden möchte,…", "Mariru")
	await novel_interface.show_dialog("… Oder ein Flugzeug dort muss die Genehmigung des Vereinigten Kongresses einholen.", "Mariru")
	await novel_interface.show_dialog("Und das Flugzeug wird wahrscheinlich einen Zwischenstopp in New Australia einlegen müssen …", "Mariru")
	await novel_interface.show_dialog("Selbst wenn wir es also schaffen, in einer Stunde abzuheben und alle Abläufe während des Fluges zu durchlaufen, wird es etwa 40 Stunden dauern, bis wir dort ankommen.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Das wird in Ordnung sein. Der Generator kann hier ein paar Tage halten und wir haben genug Nahrung zum Überleben.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Das euch am nächsten gelegene Vorfeld liegt bei 68° 24' S und 76° 55' E, etwa eine halbe Meile von euch entfernt.", "Mariru")
	await novel_interface.show_dialog("Angesichts der unvorhersehbaren Wetterbedingungen in der Antarktis kann es jederzeit passieren, dass wir den Kontakt zu euch verlieren. Wenn das passiert, denken Sie daran, dass ich Sie dort treffen werde.", "Mariru")
	await novel_interface.show_dialog("Es handelt sich um eine große Basis namens Snedronningen, was wörtlich „Schneekönigin“ bedeutet, und die meisten ihrer Einrichtungen wurden unter der Erde gebaut …", "Mariru")
	await novel_interface.show_dialog("Was die Details betrifft... Wir halten Sie auf dem Laufenden. Ren,… thisshig rrrrrk…", "Mariru")
	await novel_interface.show_text_only("Die Stimme von Mariru wird von einem plötzlichen Elektrizitätsgeräusch verschluckt.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? Hallo?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("He-hallo? Können Sie mich hören?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Lärm im Kommunikationszentrum wird immer lauter.")
	await novel_interface.show_dialog("Möglicherweise gibt es einen Sonnenwindstoß. Überprüfen Sie jetzt besser den Signalempfang.", "Mariru")
	await novel_interface.show_text_only("Wow——")
	await novel_interface.show_text_only("Während das Elektrizitätsrauschen stärker wird, verschwindet die Stimme von Mariru aus dem Empfänger.")
	await novel_interface.show_text_only("Eine Stille liegt über uns.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ich schätze... wir haben wieder den Kontakt zu ihnen verloren...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Vierzig Stunden? Du solltest besser beten, dass es keine Überraschung mehr gibt.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es gibt mir schlechte Laune, aber ich weiß nicht warum.")
	await novel_interface.show_text_only("Draußen vor dem Fenster sind mit den verblassenden Signalen alle Polarlichter verschwunden, und sogar der schwache Wind hat nachgelassen.")
	await novel_interface.show_text_only("Die einzigen Geräusche, die wir jetzt hören, kommen von den Computerkühlern und den Klimaanlagenventilatoren.")
	await novel_interface.show_text_only("Eine solche Stille erinnert mich immer an die Ruhe vor dem Sturm...")
	await novel_interface.show_text_only("Plötzlich wackelt das Bedienfeld ein wenig.")
	await novel_interface.show_text_only("Nein, das ist unmöglich. Ich muss gerade den Halt verloren haben.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Hast du das gespürt?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Du meinst die…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das leichte Zittern wird immer heftiger.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Oh mein Gott... Willst du mich veräppeln?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während ich das Bedienfeld zur Unterstützung halte, spüre ich, wie mein Herz schneller schlägt.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Was sind das...?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein dröhnendes Geräusch kommt vom Boden unter unseren Füßen.")
	await novel_interface.show_text_only("Das Gebäude beginnt so heftig zu beben, dass wir kaum noch aufrecht stehen können.")
	await novel_interface.show_text_only("Alles auf dem Tisch hüpft wie Pop Rocks, die sich im Mund auflösen.")
	await novel_interface.show_text_only("Von den Gletschern in der Ferne ertönt ein schreckliches Knacken.")
	await novel_interface.show_text_only("Ein Blick aus dem Fenster bestätigt meine Befürchtung –")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Es ist ein Erdbeben!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
