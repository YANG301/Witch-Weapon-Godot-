# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru s'approche d'Aya et se penche pour lire les données rafraîchissantes sur l'écran.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Le rapport médical de Beatrice ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Euh-huh—Un échantillon parfait !", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("Et ce serait bien plus intéressant si nous pouvions le comparer avec des documents historiques.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mais aucune de nos bases de données ne contient aucune de ses informations. Cela pourrait être dû au manque de données causé par la guerre.", "Mariru")
	await novel_interface.show_dialog("Néanmoins, selon ses déclarations et votre rapport…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru affiche le profil de Beatrice à l'écran.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 ans… \\nQuel âge privilégié !", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru et Aya échangent un regard, sachant qu'elles ont remarqué la même chose. Ensuite, ils reviennent à l'écran.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est le résultat de son test la nuit où elle est apparue ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Pratiquement aucun élément radioactif trouvé dans son corps. Bien que les niveaux de métaux lourds soient relativement élevés dans ses échantillons de sang.", "Ai")
	await novel_interface.show_dialog("Cela pourrait avoir quelque chose à voir avec les ustensiles ou les cosmétiques rudimentaires du Moyen Âge…", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Donc tu as déjà une conclusion ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Après tout, selon les archives de ses déclarations...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya passe son doigt sur une ligne de texte à l'écran.")
	await novel_interface.show_text_only("GMT+9 13:09:11 La cible revendique 1265 après JC comme année de naissance.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—C'est la première fois que je vois un échantillon vivant des temps anciens.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Serait-ce le même cas avec Annie ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Nan ! \\nBeatrice a dit qu'elle était sûre à 100 % d'être morte.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("Elle a dit qu'elle avait intentionnellement bu du poison.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Il existe des documents historiques à l’appui… Mais la possibilité d’une falsification ne peut être exclue.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya clique pour ouvrir un autre rapport de test.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Il n’existe qu’une variété limitée de poisons enregistrés au Moyen Âge. Pruche, morelle, noix vomique, etc.", "Ai")
	await novel_interface.show_dialog("Nous avons trouvé des résidus d'alcaloïde toxique dans ses échantillons de sang prélevés la nuit de sa sortie.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mais dans le sang que nous avons prélevé le lendemain, il n’y a presque aucune trace d’alcaloïde toxique ou de métal lourd.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Pas étonnant que tu aies l'air si excité…", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Attendez, ce n’est pas encore la partie la plus excitante !", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La voix d'Aya tremble d'excitation.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Contrairement à Annie, Beatrice possède un système immunitaire présent chez les nouveau-nés. Elle a été testée négative aux IgD.", "Ai")
	await novel_interface.show_dialog("Et… les propriétés du microbiome de son corps sont presque les mêmes que celles de Ren !!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… Comment vous est venue l’idée de passer ces tests ?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuition. Instinct. Et une passion pour les échantillons rares !!", "Ai")
	await novel_interface.show_dialog("Un corps créé à partir de rien… reproduisant fidèlement la « malédiction » la plus intéressante en la matière : la capacité d'attirer l'amour.", "Ai")
	await novel_interface.show_dialog("Ren est juste… incroyable !!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("En disant cela, Aya ferme les yeux et croise les bras pour se serrer dans ses bras, l'air assez enivrée par ses pensées.")
	await novel_interface.show_text_only("Mariru sort une série de rapports et frappe violemment le front d'Aya.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si une âme peut exister indépendamment dans un espace-temps différent…", "Mariru")
	await novel_interface.show_dialog("Alors, comment sélectionne-t-il un conteneur ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("Cela pourrait-il avoir quelque chose à voir avec le papillon doré ?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Non, compte tenu de Annie et de sa batte de baseball, je pense que Beatrice est en quelque sorte lié à la gemme verte…", "Mariru")
	await novel_interface.show_dialog("C'est comme si certains objets pouvaient invoquer les âmes qui y sont attachées.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Il s’agit de voyager dans l’espace-temps et de créer du corps…", "Mariru")
	await novel_interface.show_dialog("(Le Sénat ne devrait jamais rien savoir à ce sujet.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ainsi, Ren peut même attirer une âme…", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya interrompt le fil des pensées de Mariru.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Hum ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Sortir une certaine âme de nulle part et créer un corps pour l’héberger… Cela ressemble à une alchimie interdite.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Si je n’avais pas vécu à cette époque, j’aurais peut-être essayé de faire du commerce d’âmes avec les dieux en utilisant des éléments de base, tout comme les alchimistes.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Comme le soi-disant « Fils des Dieux » promu par de petits groupes religieux. Mais il n'y a pas de marché pour cela dans New Opulentia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("Non, je préfère les titres féminins comme « Déesse ». Ils me donnent cette envie intérieure de défier l’abstinence.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mon Dieu, pourquoi diable ai-je employé quelqu'un comme vous…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Euh-huh ! Peut-être que nos âmes sont simplement attirées les unes par les autres.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("— Alors, c'est tout ce que j'ai trouvé.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Au centre de santé, après l'examen physique régulier, je parle à Aya de Beatrice tout en enfilant mes vêtements.")
	await novel_interface.show_text_only("Le commentaire d'Aya sur les conditions physiques de Beatrice peut avoir du sens…")
	await novel_interface.show_text_only("Mais la théorie de l’âme semble être de la merde totale…")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Surtout la soi-disant \"Déesse\"…) \\n(Même si j'ai déjà capturé ce genre de rôles dans des jeux vidéo)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Mais je ne voudrais jamais d'un tel titre pour moi !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne peux m'empêcher de passer mes bras autour de moi en frissonnant.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Non, jamais !!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, quelque chose d'indicible dans ton esprit ?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alors… C'est pourquoi mes éléments de contrôle ont augmenté ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Euh-huh.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya affiche un sourire rusé, comme si elle planifiait quelque chose en secret.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(C’est peut-être une autre recherche non autorisée…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Dommage que je n'ai pas assez de matériel de support ; sinon, je pourrais faire des tests plus \"intéressants\"…", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("Au fait, tu veux tester le mode puissance maximale de la puce implantée en toi ?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Non ! Merci beaucoup!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
