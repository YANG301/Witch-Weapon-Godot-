# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Mentre Mariru tocca il suo ricevitore, un profondo rombo proviene dalle profondità del serbatoio. Il livello dell'acqua scende quando la chiusa sottomarina si apre.")
	await novel_interface.show_text_only("A quanto pare, il bacino è profondo più di 30 piedi e la diga è diventata immediatamente una scogliera.")
	await novel_interface.show_text_only("Quando il livello dell'acqua scende, un monumento blu sorge dalla piattaforma sul lato opposto della scogliera.")
	await novel_interface.show_text_only("Mentre le luci circostanti si accendono una dopo l'altra, la forma di questo monumento è inconfondibile: è il Tesheim Lapis Pillar.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Ehi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sul lato opposto c'è uno spazio gigantesco, più ampio di un normale campo da calcio. File di pilastri, alti decine se non centinaia di piedi, allineano lo spazio nell'oscurità.")
	await novel_interface.show_text_only("A quasi 300 piedi di altezza, le luci sul tetto riescono a malapena a rivelare le aree circostanti, e l'estremità più lontana rimane buia.")
	await novel_interface.show_text_only("La scala esagerata della struttura sembra spaventosamente intimidatoria.")
	await novel_interface.show_text_only("Gli indicatori lampeggianti ai quattro angoli della piattaforma ricordano la presenza di uno scudo di protezione elettromagnetica.")
	await novel_interface.show_text_only("Una passerella si estende lentamente verso di noi.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(... Fantastico!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questo mi ricorda la scena iniziale di uno sparatutto.")
	await novel_interface.show_text_only("Seguiamo Mariru e camminiamo su una scala reattiva verso il banco di controllo.")
	await novel_interface.show_text_only("I gradini, solitamente nascosti nel muro, compaiono solo quando qualcuno sta per calpestarli.")
	await novel_interface.show_text_only("La scala sembra essere progettata per impedire alle persone di avvicinarsi o allontanarsi dalla postazione di controllo.")
	await novel_interface.show_text_only("Mi guardo attorno e noto sul soffitto un paio di feritoie chiuse per sparare piccole armi pesanti.")
	await novel_interface.show_text_only("Ripensando a come siamo arrivati fin qui, provo a visualizzare la struttura di questa enorme struttura sotterranea.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("…Devi aver investito miliardi di dollari in questo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("La ristrutturazione non è un compito facile, ma questa è l'unica scelta che abbiamo se vogliamo rispettare gli standard di sicurezza e rispettare le scadenze per il Progetto Ark.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Per standard di sicurezza, Mariru indica la capacità di difendersi da possibili minacce come streghe potenti ma ostili.")
	await novel_interface.show_text_only("Per garantire la sicurezza delle Città Accademia, il Senato richiede che queste strutture siano in grado di gestire ed eliminare tali minacce.")
	await novel_interface.show_text_only("Con minacce sconosciute, tuttavia, questi standard fornirebbero nella migliore delle ipotesi solo un cuscinetto psicologico.")
	await novel_interface.show_text_only("Questo è ciò che ha detto Mariru alla riunione operativa.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Cosa stai aspettando?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre ci avviciniamo al banco di controllo, mi sento ancora titubante nel salire le scale sospese a più di 30 piedi di altezza, anche se so che i gradini seguiranno il movimento dei miei piedi.")
	await novel_interface.show_text_only("Sulla piattaforma di fronte c'è il Pilastro di Lapislazzuli, più alto di me e sostenuto da quattro grandi pinze.")
	await novel_interface.show_text_only("Mi sento completamente sopraffatto nel vedere il pilastro di persona. Le foto online non hanno nulla a che vedere con il confronto.")
	await novel_interface.show_text_only("La superficie di questo monumento turchese traslucido è piena di motivi inscritti di linee sottili.")
	await novel_interface.show_text_only("Sembrano simboli disposti in un certo ordine logico, ma finora gli archeologi non sono stati in grado di decifrarli.")
	await novel_interface.show_text_only("Cerchi concentrici, alberi, contorni: anziché codici significativi, sembrano trasmettere concetti in modo più diretto.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Deve essere un tesoro nazionale... Forse dovremmo provare altri manufatti di minore importanza nel nostro primo esperimento...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Eh? Spaventato?", "Raphael")
	await novel_interface.show_dialog("Se sbagli tutto, sai cosa aspettarti, giusto?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael avverte.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("No, ovviamente no. Mi sembra semplicemente troppo stravagante...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("OK, ora disattiviamo lo scudo elettromagnetico.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru tira delicatamente la leva rossa sul banco di controllo. Le luci rosse agli angoli del dispositivo di protezione si spengono tutte contemporaneamente.")
	await novel_interface.show_text_only("All'improvviso un ronzio mi colpisce il cuoio capelluto, come se una debole corrente mi attraversasse il cervello.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Tutto bene?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Potrebbe essere l'iscrizione magica, ma...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fisso gli occhi sul Pilastro di Lapislazzuli. Qualcosa non va.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Sembra che il tuo corpo sia molto sensibile.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, non davanti a…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lancio un'occhiata a Raphael, che mi sta lanciando uno sguardo da \"pervertito\".")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Quello che hai detto è fuorviante!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Per la nostra sicurezza, ripeterò le istruzioni su come utilizzare lo scudo elettromagnetico.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru indica a Raphael e Annie il banco di controllo, quindi si gira verso di me.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Lo spettacolo è in onda?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ci sono dozzine di sensori e telecamere a spettro completo su questa stazione di controllo e sui pilastri circostanti. Sono impostati per funzionare automaticamente quando la custodia di schermatura è aperta.", "Mariru")
	await novel_interface.show_dialog("I dati e le immagini verranno inviati direttamente alla sala di osservazione e condivisi con istituti di ricerca con sede in Salmonton dopo l'esperimento.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru mi fa l'occhiolino.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Diamine, lo farai...) \\n(Hai ovviamente preparato dati falsi...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Alzo lo sguardo verso la sala di osservazione in cima ai pilastri adiacenti.")
	await novel_interface.show_text_only("Il vetro antideflagrante unidirezionale non mostra segni di persone dietro di esso e riflette solo freddamente le luci circostanti.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Quei Senatori dovrebbero esserci dietro…)", "Lian")
	await novel_interface.show_dialog("(Spero di poterli ingannare...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("La custodia protettiva e il molo possono essere facilmente controllati con questo interruttore meccanico e la manovella.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Seguendo le indicazioni di Mariru, Annie esamina ogni angolo e interruttore del banco di controllo.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Non vedo interruttori meccanici da un bel po', e una manovella qui... \\nPerché usi questi antichi apparecchi?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("I dispositivi meccanici sono solitamente le soluzioni più stabili. Basta sfidarlo.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Allora, prima che parta per la sala di comando, vuoi chiedermi qualcosa?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Stiamo... stiamo per iniziare?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il mio cuore batte all'impazzata. Faccio qualche respiro profondo.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Nervoso?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembrando aver notato il mio disagio, Mariru mi mette un braccio intorno alla schiena e mi dice con gentilezza.")
	await novel_interface.show_text_only("Un comportamento così intimo di fronte agli altri mi fa bruciare la faccia.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Un... Un po'...", "Lian")
	await novel_interface.show_text_only("Il mio cuore batte più forte!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Organizzare uno spettacolo non fa proprio per me! Da bambino, il mio unico ruolo da attore era nella capanna dello zio Tom. E io ero la capanna.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru alza lo sguardo verso la sala di osservazione.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Sì?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Il suo respiro mi intorpidisce l'orecchio. È come se un nervo mi partisse dalla parte posteriore dell'orecchio, trasmettendo l'intorpidimento a tutto il corpo mentre corre fino ai talloni.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Rilassati, i senatori non si accorgeranno di nulla.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru mi sussurra all'orecchio.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("C'è uno strato di mimetizzazione ottica a circa 70 piedi sopra la mia testa.", "Mariru")
	await novel_interface.show_dialog("E il vetro della sala di osservazione è trattato, così vedono solo quello che \"dovrebbero\" vedere...", "Mariru")
	await novel_interface.show_dialog("Dopo che Raphael avrà chiuso la custodia protettiva, sparirai davanti a loro come se fossi entrato nell'area del flusso.", "Mariru")
	await novel_interface.show_dialog("Dopodiché, devi solo provare a toccare il Lapis Pillar. Va bene se non puoi chiamare le streghe come avevamo previsto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sento una risatina e poi Mariru mi soffia uno sbuffo d'aria nell'orecchio. \\nIl coraggio che ho appena notato sta nuovamente protestando vigorosamente.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eeeek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Ma se viene fuori qualcosa di brutto... \\nSai come gestire il caso peggiore, giusto?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Deglutisco brevemente.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nel momento in cui i sensori raggiungono il valore di soglia, verranno attivati i programmi di blocco e distruzione...", "Lian")
	await novel_interface.show_dialog("Entro 5 secondi dobbiamo prendere la botola sul pavimento alla tua destra ed entrare nella zona di segregazione sotterranea.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Guardo il percorso di emergenza che abbiamo pianificato durante la riunione operativa.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Per essere precisi, hai solo 4,8 secondi.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(L'intera base verrà immediatamente inondata dall'acqua di mare) \\n(Per non parlare del sistema d'armi sopra la mia testa...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Ma secondo il mio controllo dei precedenti sul Pilastro Lapislazzuli...", "Mariru")
	await novel_interface.show_dialog("Il suo ex proprietario era un devoto pacifista, anche se era molto riservato e usava diversi pseudonimi.", "Mariru")
	await novel_interface.show_dialog("Quindi forse è un uomo peloso di mezza età che potresti chiamare.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Se è così, lascia che Raphael lo riporti a Salmonton!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("In ogni caso, la sicurezza prima di tutto.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru mi lascia andare e mi dà una pacca sulla testa.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Abbi cura di te... ti terrò d'occhio.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Con un tono che segnala l'inizio dell'esperimento, fisso di nuovo i miei occhi sul Pilastro di Lapislazzuli in piedi silenziosamente sulla piattaforma.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ci riusciremo?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
