# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Una distesa infinita di terra desolata, tinta di un verde mistico dalla splendida aurora australe.")
	await novel_interface.show_text_only("Una fila di fari squarcia l’oscurità gelida e silenziosa.")
	await novel_interface.show_text_only("Appartengono ad una flotta di motoslitte. Gli scooter sfrecciano oltre le pianure ghiacciate avvolte nell'oscurità, oltre l'eliporto, parcheggiando infine all'ingresso della vasta base.")
	await novel_interface.show_text_only("Di fronte a loro si erge eretto un monumento a forma di bozzolo. Una robusta scatola per campioni, precedentemente utilizzata per contenere le meteore del Monte Grove, è incastonata nella sua superficie rocciosa.")
	await novel_interface.show_text_only("La parola \"Snedronningen\" è dipinta innumerevoli volte attorno alla scatola, scintillante d'argento sotto i riflettori.")
	await novel_interface.show_text_only("Snedronningen: la Regina Bianca. Il nome della base che i ciclisti stanno cercando.")
	await novel_interface.show_text_only("Un membro della squadra pesantemente corazzato, che cavalcava in prima linea, le strappa la visiera.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Aaaed eccoci qui!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguendo il suo esempio, i restanti cinque motociclisti spengono i motori e scendono, raccogliendo ciascuno le rispettive provviste.")
	await novel_interface.show_text_only("Si tratta di un gruppo di ricerca scientifica, in cui tutti i membri hanno seguito un addestramento al combattimento standard.")
	await novel_interface.show_text_only("Le segnalazioni di onde radio generate da Substance H rilevate in Antartide due mesi fa hanno portato molte fazioni curiose nell'area. La maggior parte di loro è arrivata armata.")
	await novel_interface.show_text_only("Per la squadra è saggio essere prudenti per mantenere gli esemplari al sicuro.")
	await novel_interface.show_text_only("Sono stati fortunati finora. Il viaggio verso la base di ricerca menzionata nel piano di riserva si è svolto senza intoppi.")
	await novel_interface.show_dialog("Va bene. Tutto quello che dobbiamo fare è consegnare la roba.", "Membro della squadra D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Sì.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A differenza degli altri, che sono avvolti in strati spessi e caldi, Beth indossa un abito casual, chiaramente resistente alla temperatura estrema.")
	await novel_interface.show_text_only("Anche le sue armi auto-migliorate si distinguono dalla massa.")
	await novel_interface.show_text_only("Il loro viaggio era andato esattamente come lei si aspettava...")
	await novel_interface.show_text_only("Beth si era tuffata nelle profondità dell'oceano poche ore prima, riportando con successo campioni vivi raccolti dal corpo di una creatura non identificata.")
	await novel_interface.show_text_only("Per concludere il progetto di ricerca, il supervisore di Milk ha inviato il rompighiaccio Ushuaia per assistere la squadra operativa speciale.")
	await novel_interface.show_text_only("Mentre la scatola dei campioni veniva trasferita a Ushuaia, il biolaboratorio sulla nave subì “accidentalmente” un’interruzione di corrente.")
	await novel_interface.show_text_only("Allo stesso tempo, la base di Snedronningen, a circa un’ora di distanza, si è offerta di lasciare temporaneamente alla squadra la conservazione dei campioni nel loro laboratorio, che soddisfa tutte le specifiche.")
	await novel_interface.show_text_only("La squadra ricevette presto il permesso di entrare nei locali e fu incaricata di portare gli esemplari alla base di Snedronningen entro novanta minuti.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Siamo arrivati ​​fin qui...)", "Beth")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Si faranno vivi quei bastardi?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth stringe il pugno.")
	await novel_interface.show_text_only("Ciò che la infastidisce ancora di più è che qualcosa nella scatola dei campioni sembra aver innescato una sorta di risposta nel suo corpo.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("... \\n(Per qualche motivo mi sembra familiare... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che possa contemplarlo ulteriormente, il mondo inizia a tremare violentemente.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(Sono solo stordito dall'immersione?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No, non è questo.")
	await novel_interface.show_text_only("—Tutta questa terra trema.")
	await novel_interface.show_text_only("Si sente un rombo profondo da lontano.")
	await novel_interface.show_text_only("Anche i veterani più provati sembrano scossi.")
	await novel_interface.show_text_only("Il tremore che scuote questo continente bianco dura meno di trenta secondi.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("L'Antartide non è nella zona del terremoto..., vero?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il terremoto non è stato troppo forte. Tuttavia, ha lasciato tutti un po’ storditi.")
	await novel_interface.show_dialog("(Mormorando) È molto peggio dello tsunami...", "Membro della squadra B")
	await novel_interface.show_dialog("La piattaforma di ghiaccio sotto i nostri piedi sembra piuttosto robusta. Se lo stesso terremoto fosse avvenuto in una città tropicale altamente popolata, avrebbe causato molti più danni.", "Caposquadra")
	await novel_interface.show_text_only("I membri della squadra si scrollano di dosso questo piccolo terremoto e continuano il loro lavoro.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Ok, andiamo.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con la scatola dei campioni al sicuro tra le sue braccia, Beth salta giù dal sedile posteriore della motoslitta di Milk.")
	await novel_interface.show_dialog("Sono esaurito. Non vedo l'ora di tornare a casa, nel mio letto e a prendere una cioccolata calda.", "Membro della squadra B")
	await novel_interface.show_text_only("Mentre i membri della squadra stanno già abbassando la guardia, il leader rimane vigile, lanciando sguardi significativi verso Beth.")
	await novel_interface.show_text_only("Se non fosse stato per questa ragazza, avrebbero fallito la missione, proprio come hanno fatto tutte le altre fazioni.")
	await novel_interface.show_text_only("Ha dovuto tuffarsi nelle profondità dell'oceano, rischiare la malattia da decompressione e affrontare creature non identificate...")
	await novel_interface.show_text_only("La posta in gioco è troppo alta. Neppure la stessa Milk avrebbe potuto garantire il successo in tali circostanze.")
	await novel_interface.show_dialog("Quindi tutto ciò che dobbiamo fare è consegnare il materiale agli scienziati qui, giusto?", "Membro della squadra D")
	await novel_interface.show_dialog("Beth, lascia che ti regaliamo una birra quando torniamo a Buenos Aires, eh?", "Membro della squadra C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("Assolutamente no! La nostra Bethy non beve alcolici!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tirando Beth tra le sue braccia, dichiara Milk.")
	await novel_interface.show_text_only("Bai Zhu strinse le labbra, sopprimendo deliberatamente il suo disagio.")
	await novel_interface.show_text_only("Milk invia più richieste di ingresso al cancello della base, ma non riceve risposta.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Che strano...", "Milk")
	await novel_interface.show_dialog("Il terremoto ha rovinato la connessione o qualcosa del genere?\\nErano ancora in contatto subito prima che attraccassimo.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tuttavia, anche se i picchetti sul cancello principale che limitano l'ingresso dei veicoli rimangono in piedi, la squadra è tecnicamente in grado di entrare comunque: dopotutto hanno ricevuto in anticipo il codice di accesso.")
	await novel_interface.show_text_only("Quindi si dirigono verso la barriera illuminata a lato della base.")
	await novel_interface.show_text_only("Beth si ferma all'improvviso e consegna la scatola di campioni a uno dei suoi compagni di squadra.")
	await novel_interface.show_text_only("Con le mani libere stringe saldamente le sue armi.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Che succede?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Notando le azioni di Beth, Milk tira fuori anche le sue armi, con gli occhi attenti.")
	await novel_interface.show_text_only("Anche gli altri membri si irrigidiscono ed entrano in modalità battaglia, avanzando in formazione a ventaglio, guardandosi le spalle a vicenda.")
	await novel_interface.show_dialog("... Che diavolo?", "Membro della squadra D")
	await novel_interface.show_dialog("Shh, tienilo basso.", "Caposquadra")
	await novel_interface.show_text_only("Nel silenzio assordante si sentono solo il cigolio degli scarponi da neve sulla superficie del ghiaccio e il respiro tranquillo dei membri della squadra.")
	await novel_interface.show_text_only("Milk si avvicina alla porta e inserisce il codice nella serratura di sicurezza.")
	await novel_interface.show_text_only("Il sistema accetta il codice e sullo schermo lampeggia la scritta ENTER in verde.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Wow... dovrebbe essere sicuro, vero?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma Beth non riesce ancora a reprimere la sensazione snervante che ha nello stomaco...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("La barriera verso la base di Snedronningen finalmente si apre, insieme al rumore degli ingranaggi che ronzano e delle corde che si tendono.")
	await novel_interface.show_text_only("Dietro il cancello c'è una rampa di scale che scende dritta verso il livello inferiore poco illuminato.")
	await novel_interface.show_dialog("Qualcuno?", "Milk")
	await novel_interface.show_text_only("La sua domanda echeggia nello stretto passaggio.")
	await novel_interface.show_dialog("Capisco che la maggior parte delle strutture qui sono sotterranee, ma non avrebbero potuto mandare qualcuno di sopra ad accoglierci?", "Milk")
	await novel_interface.show_dialog("Almeno uno di questi ricercatori dovrebbe venire a controllare i campioni...", "Membro della squadra B")
	await novel_interface.show_dialog("In posizione di battaglia!", "Beth")
	await novel_interface.show_text_only("Con gli occhi puntati sull'estremità delle scale, Beth abbaia il suo ordine.")
	await novel_interface.show_dialog("Qualcuno ci sta guardando.", "Beth")
	await novel_interface.show_dialog("Più l'opzione è nascosta, più facile sarà attirare l'attenzione, immagino...", "Milk")
	await novel_interface.show_dialog("(Sono i nostri nemici quelli di cui ti preoccupi?)", "Milk")
	await novel_interface.show_text_only("Una serie di scatti di sicure delle armi rompe il silenzio spaventoso.")
	await novel_interface.show_text_only("I membri della squadra, tutti soldati addestrati a pieno titolo, guardano la ragazza che ricopre la carica di comandante temporaneo, aspettando i suoi ordini.")
	await novel_interface.show_dialog("Siamo in una posizione molto esposta in questo momento. Saremo in pericolo se hanno organizzato un'imboscata. Possiamo ritirarci fuori...", "Membro della squadra D")
	await novel_interface.show_dialog("Non posso. Abbiamo ricevuto un avvertimento, abbiamo detto che ci sarebbe stata una bufera di neve tra un'ora.", "Beth")
	await novel_interface.show_dialog("Tutti in massima allerta. Continua a muoverti.", "Beth")
	await novel_interface.show_dialog("(Tutti) Sì, signore!", "Membro della squadra")
	await novel_interface.show_text_only("I membri della squadra procedono in punta di piedi, mantenendo il respiro basso.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Attenzione!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il rumore di una lama affilata che tagliava l'aria ruppe il momento di silenzio.")
	await novel_interface.show_text_only("Una creatura che brandisce un'arma pesante a forma di falce salta fuori dall'ombra e colpisce il lato destro di Beth.")
	await novel_interface.show_text_only("L'avvertimento di Milk è arrivato appena in tempo, permettendo a Beth di schivare l'attacco.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("Cosa?!!", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahaha... ahahahah...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'aggressore è una ragazza: occhi infossati, postura distorta. Si china in avanti, facendo schioccare le articolazioni, rumorosamente e disorientando.")
	await novel_interface.show_text_only("Molti altri, volti freschi, espressioni folli, si riversano attraverso l'ingresso del corridoio precedentemente vuoto.") 
	await novel_interface.show_text_only("I membri della squadra assumono immediatamente la loro formazione triangolare standard, continuando a rispondere al fuoco contro gli aggressori.")
	await novel_interface.show_text_only("Seguendo l'esempio di Beth, circondano il membro che tiene la scatola del campione, proteggendola da tutti i lati.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("La squadra mantiene un ritmo di fuoco costante mentre cerca copertura. Ben presto arrivano in uno spazio che sembra essere una sala espositiva.")
	await novel_interface.show_text_only("Qui le luci sono fioche e gli oggetti esposti sono per lo più esemplari di animali.")
	await novel_interface.show_text_only("Il leader ordina alla squadra di formare una linea di difesa all'ingresso della stanza, mentre il resto della squadra discute delle qualità anomale che hanno notato in questi nemici.")
	await novel_interface.show_text_only("Quando vengono colpiti, non sanguinano. Non sembrano nemmeno sentire dolore.")
	await novel_interface.show_text_only("Il gruppo apre gli scudi antisommossa in fibra di Kevler, che bloccano in qualche modo gli attacchi.")
	await novel_interface.show_text_only("I nemici che si precipitano da un altro lato, con gli spadoni in mano, vengono trattenuti all'angolo dai membri della squadra che impugnano ancora più scudi antisommossa.")
	await novel_interface.show_text_only("Nel frattempo, da dietro i portascudi, proiettili da 9 mm continuano a piovere sui nemici, l'odore della polvere da sparo è pesante nell'aria.")
	await novel_interface.show_dialog("Ricarica!", "Membro della squadra C")
	await novel_interface.show_text_only("Gli spari non fanno nulla per scoraggiare gli strani nemici. Anche se i proiettili attraversano i loro volti, queste ragazze orribili continuano a sorridere.")
	await novel_interface.show_text_only("Finché una delle ragazze scavalca uno scudo e si impicca a testa in giù, tutta simile a un pipistrello, al soffitto del corridoio.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Uh... è anche... umana?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dalle ferite dei proiettili della ragazza fuoriesce un liquido verde inchiostro. Il suo collo, quasi spezzato a metà dalla forza dei proiettili, è ora tinto di un inquietante viola-verdastro.")
	await novel_interface.show_dialog("Attenzione!", "Membro della squadra B")
	await novel_interface.show_text_only("Altri nemici arriveranno alla carica dalla fine del corridoio.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Ritirati! Ritirarsi!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I membri della squadra non hanno altra scelta che dividersi in due direzioni e cercare altri punti di attacco adatti, che fortunatamente trovano presto.")
	await novel_interface.show_text_only("Non combattono ancora da molto, ma è ovvio a tutti che i nemici, qualunque essi siano, sono potenti quanto i loro.")
	await novel_interface.show_text_only("E anche cento per cento più folle.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... Cosa sono... ?", "Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("Che diavolo?\\nNon possono essere umani!", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Per Beth, è ovvio che queste giovani ragazze armate di spade sono proprio come lei...")
	await novel_interface.show_text_only("No, non completamente.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Sono più simili a quelli descritti dal padre...)\\n(stile \\\"Ningen\\\")", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sono resistenti, si riprendono rapidamente, con articolazioni estremamente flessibili che li rendono meno umani e più simili ad agili burattini. Troppo potente.")
	await novel_interface.show_text_only("E sono chiaramente impazziti. Come macchine per uccidere attivate da programmi.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahahaha... Jajajajajaja...", "Patchy Pythoness")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le loro chiacchiere senza senso sembrano una sorta di canto demoniaco. Decisamente non umano.")
	await novel_interface.show_text_only("All'improvviso, il membro della squadra che tiene la scatola del campione viene colpito da una freccia. Mentre si accascia a terra, la scatola le scivola via dalle braccia.")
	await novel_interface.show_text_only("Ma i nemici non sembrano avere fretta di raccoglierlo.")
	await novel_interface.show_dialog("Beth!", "Membro della squadra D")
	await novel_interface.show_text_only("I membri della squadra, costretti dall'avanzata dei nemici fino alle profondità della sala espositiva, gridano al loro comandante di dare ulteriori istruzioni.")
	await novel_interface.show_text_only("Questa è una situazione in cui non si applica alcun protocollo normale. Tutto ciò su cui Beth può fare affidamento ora sono i propri sensi e il proprio giudizio.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Quindi non sono qui per i campioni?)", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Maledizione!", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Allora il loro obiettivo deve essere—)", "Beth")
	novel_interface.change_expression("angry")
	await novel_interface.show_text_only("– per annientarci tutti.")
	await novel_interface.show_dialog("... \\n(Quindi siete davvero voi ragazzi...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lo sguardo di Beth si ferma sul simbolo ricamato sulla benda sull’occhio di una di quelle burattini.")
	await novel_interface.show_text_only("Ha visto quel simbolo innumerevoli volte mentre indagava sulla morte di suo padre.")
	await novel_interface.show_text_only("È un occhio inquietante e solitario, un occhio con gli arti.")
	print("=== 深海恐惧症篇第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
