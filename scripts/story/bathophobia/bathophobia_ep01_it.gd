# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru sta presentando un rapporto unilaterale in una riunione a porte chiuse.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… Questo è tutto quello che abbiamo sull'incidente della delegazione Salmonton.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers ha fatto un'altra visita a New Opulentia per svolgere alcune \"commissioni personali\".", "Mariru")
	await novel_interface.show_dialog("Ora, SID l'ha inclusa nell'elenco di protezione di livello A.", "Mariru")
	await novel_interface.show_dialog("Questa volta, però, Salmonton ha presentato al Ministero degli Affari Esteri tutti i dettagli della delegazione e un elenco completo delle merci soggette a restrizioni.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Hanno anche denunciato tutte le operazioni militari in cui è stato coinvolto in passato il personale di sicurezza. Non è possibile trovare un solo difetto nei registri...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Quindi, sembra un disclaimer secondo cui se dovesse succedere qualcosa di brutto alla nipote del Dr. Dekkers, sarà tutta colpa nostra.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Humph! Quella volpe astuta...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("In cambio della sicurezza di quella signorina qui, però, hanno promesso una consegna prioritaria del 20% del nostro contratto di acquisto di prodotti agricoli.", "Eloise")
	await novel_interface.show_dialog("Secondo l'attuale indice NBOT, è come un omaggio.", "Eloise")
	await novel_interface.show_dialog("Ho firmato un ordine esecutivo per tenere i media fuori dalle sue tracce per il momento.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Stanno utilizzando il Senato come parte della loro strategia di creazione del mercato?) \\n(E sapevano che ne sarei rimasto fuori...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Umph... vecchia volpe astuta...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("La ragazza ci è utile. Possiamo estrarre più informazioni da lei?", "Bright")
	await novel_interface.show_dialog("Francamente, siamo stati molto interessati alla loro tecnologia di editing genetico e ai sistemi delle mega serre.", "Bright")
	await novel_interface.show_dialog("Se può trascorrere qualche ora nel mio laboratorio...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dottor Bright…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Hai già una grande reputazione per i tuoi standard morali \"unici\" su Substance H che influenzano la mente umana.", "Mariru")
	await novel_interface.show_dialog("Temo che Salmonton imporrebbe immediatamente sanzioni commerciali a New Opulentia una volta che la giovane donna entrerà nel tuo laboratorio.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("La mia reputazione? Veramente? \\nAhahah…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ehm, basta così!", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("A proposito di quegli sconosciuti armati allo Sky Hotel…", "Kirs")
	await novel_interface.show_dialog("Hanno attaccato la delegazione Salmonton e hanno sequestrato alcune opere d'arte di valore...", "Kirs")
	await novel_interface.show_dialog("SID ha qualche indizio?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(La vecchia volpe nascose la farfalla d'oro al Senato e diede la colpa a Giacobbe e alla sua banda.)", "Mariru")
	await novel_interface.show_dialog("(Hanno disabilitato le telecamere di sicurezza dell'hotel prima di intraprendere azioni.) \\n(C'è una lacuna informativa lì...)", "Mariru")
	await novel_interface.show_dialog("Abbiamo le mani legate nella zona demilitarizzata concordata. Secondo diverse fonti, riteniamo che usassero armi speciali.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Armi speciali... intendi armi Substance H? \\nHanno usato le armi all'interno del campo protettivo di Aegis?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("A giudicare dai segni di bruciature a forma di albero sul pavimento, crediamo che usassero dispositivi di scarica ad alta potenza con circuiti di risonanza in serie.", "Mariru")
	await novel_interface.show_dialog("Un dispositivo così complicato è troppo ingombrante per essere trasportato da un singolo soldato e non c’è praticamente alcun modo per ridimensionarlo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Secondo le dichiarazioni dei testimoni, quella notte c'erano circa 10 uomini armati con la stessa arma.", "Mariru")
	await novel_interface.show_dialog("Secondo i registri di Aegis, circa dieci ID sconosciuti sono andati offline alla stessa ora quella notte. Devono essersi ritirati dal sito.", "Mariru")
	await novel_interface.show_dialog("Dato che SID aveva bloccato le partenze regolari, avrebbero potuto scappare attraverso i canali diplomatici.", "Mariru")
	await novel_interface.show_dialog("(O giustiziati a causa del loro fallimento…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… capisco.", "Kirs")
	await novel_interface.show_dialog("Le armi Substance H non possono essere prodotte su così larga scala.", "Kirs")
	await novel_interface.show_dialog("Ma prima che le telecamere venissero spente, due persone sospette hanno aggredito le guardie nel corridoio.", "Kirs")
	await novel_interface.show_dialog("Uno di loro si vestiva da cameriera di quell'albergo e l'altro indossava l'uniforme di Gosakuragawa. Li hai mandati lì?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Dallo schermo esce un cigolio acuto.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Hahaha... Il nostro amministratore delegato sembra molto interessato ai gattini... Anch'io.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Gattini?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Oh, l'ho citato da Sua Eccellenza la signora Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Che rottura di palle...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie e Ren, giusto? \\nNomi adorabili...", "#C")
	await novel_interface.show_dialog("Forse ci sono altri gatti che Mikakawa ha allevato——", "#C")
	await novel_interface.show_dialog("Ho ragione, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ah, grazie per non averli venduti all'esercito di sicurezza. Te ne devo uno.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Non è un grosso problema. \\nSembra che tu non abbia comunque intenzione di nasconderci nulla.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Quindi, permettimi di informarti con maggiori dettagli.", "Mariru")
	await novel_interface.show_dialog("Il satellite ha rilevato diversi flussi spaziotemporali presso lo Sky Hotel, ma SID non aveva il diritto di agire lì.", "Mariru")
	await novel_interface.show_dialog("Quindi ho mandato lì due agenti sotto copertura.", "Mariru")
	await novel_interface.show_dialog("Durante la loro missione, si sono imbattuti in un gruppo di uomini armati e uno di loro ha sparato a Annie con l'arma speciale.", "Mariru")
	await novel_interface.show_dialog("Ora l'agente è finalmente fuori pericolo dopo le cure d'emergenza e abbiamo raccolto alcune statistiche su quell'arma.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Perché non ce lo hai detto prima?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Signor amministratore delegato, mi chiedo quali siano esattamente le \"opere d'arte\" scomparse?", "Mariru")
	await novel_interface.show_dialog("Forse è ora che tutti noi diventiamo più aperti alla condivisione dell'intelligenza.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Cosa ne pensi?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Perché non iniziamo con il gattino che hai adottato?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Peccato… Quell’informazione non era sufficiente a distrarlo.)", "Mariru")
	await novel_interface.show_dialog("(Che rompicapo...) \\n(Bene, è ora di testare quei documenti contraffatti, temo. È tempo di raccontare, ragazzi.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Cominciamo, mia cara?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Durante la Guerra dei Sette Anni, gli scienziati si erano dati da fare per sviluppare nuove tecnologie che consentissero l'attivazione del Tocco Divino da parte degli esseri umani.", "Mariru")
	await novel_interface.show_dialog("Si diceva che fossero stati condotti segretamente esperimenti di modificazione del corpo umano sui combattenti. Credo che tu abbia sentito queste voci.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Uhm.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ridacchia, gli angoli delle sue labbra si curvano leggermente verso l'alto.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Alcune persone nascono con attitudini speciali e l'Accademia delle Scienze New Opulentia e l'Istituto di ricerca sul cervello hanno documenti che lo dimostrano.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("In realtà, il Dr. Bright può essere considerato uno di questi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Aspetta, devo ricordarti che quasi tutte quelle persone dotate sono donne.", "Bright")
	await novel_interface.show_dialog("Tuttavia, le persone con talenti speciali come questo vengono solitamente inserite solo nella lista di controllo e non è necessario un controllo speciale.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Giusto. Ma tra tutte queste persone dotate, nessuno ha un potere paragonabile alla Classe B Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Poiché i risultati degli esperimenti furono inferiori alle aspettative, questo tipo di ricerca venne interrotto durante il periodo bellico.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Quelle donne dotate di superpoteri sono anche conosciute come \"streghe\". Qualche decennio fa, nessuno avrebbe mai creduto all’esistenza di cose del genere nel mondo…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Ma Ren è diversa: è in grado di attraversare aree di flusso.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cosa?!!","Folla")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
