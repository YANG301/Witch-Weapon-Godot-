# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("封閉的會議室內，正在進行單向的報告。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("……以上，就是關於薩蒙頓考察團成員受到襲擊事件的後續調查。", "莉琉")
	await novel_interface.show_dialog("拉斐爾·戴克斯由於「個人原因」，上周再次來到新豐洲。", "莉琉")
	await novel_interface.show_dialog("SID現已將其設為A級監控保護對象。", "莉琉")
	await novel_interface.show_dialog("和上次不同的是，這回薩蒙頓向外交部提交了非常詳細的隨行人員檔案和物品申報清單。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("連隨行的保安警察參加過哪些軍事行動都在報告中如實詳載了，這次合規的程度這麼完備……", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("這不是擺明：如果戴克斯博士的寶貝孫女在新豐洲出了事，就全都是我們的責任。", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("哼！ 那個老狐狸──", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("不過，他們也承諾讓新豐洲優先採購20%農產品來做為保護她的交換條件。", "華音瀧")
	await novel_interface.show_dialog("從NBOT的行情看來……這筆交易非常划算。", "華音瀧")
	await novel_interface.show_dialog("我已經簽署禁止令，暫時不會有媒體敢騷擾那位大小姐了。", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（打算讓元老院利用這件事賺利差？）\\n（還料到我不會插手……）", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（哼哼，果然是個老奸巨猾的傢伙～）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("既然那個小丫頭這麼重要，妳們就試試從她身上多探點情資。", "布萊特")
	await novel_interface.show_dialog("我們科學院對薩蒙頓的基因編輯技術和超級溫室系統一直很感興趣。", "布萊特")
	await novel_interface.show_dialog("如果能讓她來我的實驗室待上幾個小時……", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("咳咳，布萊特博士──", "莉琉")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("您對精神類異質物「獨特」的道德標準，早就臭，啊，不，名聲遠播了。", "莉琉")
	await novel_interface.show_dialog("如果那位大小姐踏進您的實驗室，薩蒙頓恐怕就會立刻宣布對新豐洲貿易制裁吧。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("我這麼有名嗎？ \\n啊哈哈哈哈，真有點不好意思──", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("……這個話題到此為止！", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("話說回來，在天空酒店出現的那群不明武裝分子……", "基爾斯")
	await novel_interface.show_dialog("他們襲擊了薩蒙頓考察團，還奪走了貴重的藝術品。", "基爾斯")
	await novel_interface.show_dialog("對此，SID有什麼發現嗎？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（老狐狸對元老院隱瞞了黃金蝴蝶的事情，還把帳算到了雅各那夥人頭上。）", "莉琉")
	await novel_interface.show_dialog("（他們在行動前癱瘓了酒店監視系統，）\\n（正好利用這個情資的落差……）", "莉琉")
	await novel_interface.show_dialog("「協議非武裝區」不是SID的管轄範圍。目前結合各方面情報，我判斷那群人應該使用了特殊武器。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("特殊武器……是異質物武器嗎？ \\n還是在埃癸斯的防護範圍內？ ！", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("根據酒店房間地板上的樹狀灼燒痕跡，推測是大功率的串聯諧振放電設備。", "莉琉")
	await novel_interface.show_dialog("將這種武器縮小成可個人攜帶的物品，並不是一般的技術能做到的。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("根據考察團的口供，當晚約有十人，而且全員都配備了相同武器。", "莉琉")
	await novel_interface.show_dialog("再比對埃癸斯的記錄，事發當晚有大約10個不明編號幾乎同時離線，我想應該是已經撤離了。", "莉琉")
	await novel_interface.show_dialog("SID控制了所有正常離境管道，因此這些人很可能是透過外交管道逃走的。", "莉琉")
	await novel_interface.show_dialog("（或是因為行動失敗而被就地處決了……）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……瞭解。", "基爾斯")
	await novel_interface.show_dialog("如果是能夠大規模生產的裝備，倒不像是異質物武器。", "基爾斯")
	await novel_interface.show_dialog("話說……在監視器被癱瘓之前，有兩個可疑人物在走廊襲擊了保全。", "基爾斯")
	await novel_interface.show_dialog("一個穿著酒店的女僕裝，另一個穿著御櫻川的校服，是不是妳派出的……", "基爾斯")
	novel_interface.character_dark()
	await novel_interface.show_text_only("螢幕中傳來了尖銳的電子噪音。")
	novel_interface.character_light()
	await novel_interface.show_dialog("——？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("哈哈哈哈，原來首席執政大人也和我一樣，對小貓咪很感興趣呢～", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……小貓咪？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("啊，這是引用莉琉閣下的說法──", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("（果然，這傢伙……）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("那兩位是安妮和憐吧？ \\n名字挺可愛的啊～", "#C")
	await novel_interface.show_dialog("或許禦櫻川還養著其他的貓也不一定——", "#C")
	await novel_interface.show_dialog("您說是不是這樣呢，莉琉閣下？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("呵呵呵，看來保安警察查不到她們倆的資料，真是得感謝元老院了。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("哪裡哪裡，您太客氣了──\\n看來莉琉閣下也沒打算向我們隱瞞。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("那麼，請讓我在此補充一下其他資料。", "莉琉")
	await novel_interface.show_dialog("衛星偵測到天空酒店的異常相位波動，但SID不便直接行動。", "莉琉")
	await novel_interface.show_dialog("所以我派了兩名臥底探員前往調查。", "莉琉")
	await novel_interface.show_dialog("但她們在行動中遭遇到那群武裝分子，其中安妮還被那種武器擊中。", "莉琉")
	await novel_interface.show_dialog("所幸搶救後已無大礙，也因此我們收集到那種武器的一些數據。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("這種事！ ……妳剛才為什麼沒說？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("首席執政大人，您剛才不也說薩蒙頓考察團遺失的只是「藝術品」嗎？", "莉琉")
	await novel_interface.show_dialog("或許更充分的情報共享，對我們都更有利。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("您說是嗎？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("那麼，不知道莉琉閣下想不想跟我們分享一下，您親自收養的那隻小貓咪呢？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（嘖，沒有被我拋出去的訊息誤導……）", "莉琉")
	await novel_interface.show_dialog("（果然是個討厭的傢伙……）\\n（只能賭一賭那套偽造的背景資料夠不夠完美了。）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("莉琉閣下，您打算如何解釋呢？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("「七年戰爭」期間，一直有人試圖開發只靠人體就可發動「神蹟」的技術。", "莉琉")
	await novel_interface.show_dialog("各式各樣的人體改造實驗傳聞，相信各位多多少少都有耳聞吧。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……嗯。", "基爾斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉勾起嘴角，輕笑了一聲。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("確實，有些人天生就擁有特殊天賦，這方面新豐洲科學院和播磨腦研也有記錄。", "莉琉")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("如果真的要算的話，布萊特博士也是其中一人吧。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("我的狀況比較不同，有超能力記錄的基本都是女性……", "布萊特")
	await novel_interface.show_dialog("不過像這樣擁有特殊天賦的人，通常只會列入觀察名單，並沒必要特殊控制吧。", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("確實如此，依照目前的超能力者的檔案來看，連可以達到B級異質物能力的人都沒有。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("也由於效果不穩定，戰爭期間這方面的研究幾乎都終止了。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("這些擁有超能力的女性也被稱為「魔女」；在幾十年前可能會有人因此大驚小怪吧……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("不過這位名為「憐」的少女之所以特殊，就是她擁有可以穿越相位波動空間的能力。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("——！！！","眾人")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
