	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("最大の問題は古細菌は遺伝子が不安定な事よ。\\n\\n大規模な培養は数十代目の分裂から突然変異を\\n起こし、効果が消失する可能性が高いわ。","ラファエル")
