	await novel_interface.show_dialog("これは──","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("どうかしたのか？","小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("99％以上の成分は水ですわ。\\nしかし最も重要なのは……","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は培養槽の後ろに回って、注意深く周辺を\\n調べ始めた。\\n配管に沿って行くと、薄暗い部屋の一角で\\n小型のキャビネットを見つけてきた。")
