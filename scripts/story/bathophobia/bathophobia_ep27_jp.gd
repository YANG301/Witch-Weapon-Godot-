	await novel_interface.show_dialog("当時の捜査員の日記によると、爆発物の威力は\\n200年後に発明されたニトログリセリンを\\n超えていた可能性があるのだそうな……","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("ふふふっ、あれは『あの方』の束縛から逃れる\\nための手段に過ぎませんわ。","ハインリッヒ")
