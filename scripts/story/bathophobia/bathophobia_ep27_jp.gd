	await novel_interface.show_dialog("まあ、たまにどこかの兄弟が謎の爆破で、\\n殺害されたりしているけどな……","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは言葉の意味を理解して笑った。")
	novel_interface.show_character("liliu_uniform2","normal2")
