	await novel_interface.show_dialog("…………","ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルクの目に涙が浮かんだ。")
	await novel_interface.show_text_only("戦友の傷口を抑えているミルクの手の上に、\\nバイジュウは手を重ねた。\\n彼女は何も言わずに、深く息を吸い込むだけ。")
	await novel_interface.show_dialog("もうダメだッ！　ここから離れないとッ！","隊員C")
	novel_interface.show_character("baizhu_break","speechless")
	await novel_interface.show_dialog("ミルクッ！","バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルクは歯を食いしばり、展示室でMuteが\\n必死に取り戻したサンプル箱を拾い上げた。")
