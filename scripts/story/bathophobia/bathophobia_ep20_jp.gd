	await novel_interface.hide_character()
	await novel_interface.show_text_only("敵は豹のようにシールドにより作りだされた\\n緩衝地帯を軽く飛び越えた。")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("そうね、Ningen（ニンゲン）だものね……","バイジュウ")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Nin――gen……ヒヒヒヒッ……\\nシ……ネ――ッ！！","？？？")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウの口にした言葉を聞き、\\n最も戦闘力が高いであろう敵の1体が\\nまるで耳の根まで裂けんばかりの危険な笑みを\\n浮かべた。")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("くっそ……ッ！　こいつら……\\nもう止められない……ッ！","ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("バイッ！　お前らはさっさと退避しろ！\\nこっちはまだ少しの間、持ちこたえられるッ！","隊長")
