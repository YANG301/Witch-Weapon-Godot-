	await novel_interface.show_text_only("Beth si schiarisce la voce per interrompere le loro speculazioni e inizia subito il debriefing.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Come abbiamo pensato, Quella Cosa esiste nella zona abissale.", "Beth")
	await novel_interface.show_dialog("L'ho osservato da vicino qualche ora fa. E ho raccolto alcuni campioni liquidi.", "Beth")
