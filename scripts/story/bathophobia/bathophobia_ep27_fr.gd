	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("(C’est le même matériau peint sur la valise contenant l’éclat de sorcière de Beatrice !)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C’est un alliage qui affaiblit ou bloque les effets psychologiques et mèmes provoqués par Substance H. Ce qui signifie que ce qu'il y a à l'intérieur du meuble doit être...")
