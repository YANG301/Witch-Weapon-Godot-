	await novel_interface.show_text_only("Un cinquième du liquide bleu qu’il contient a déjà été consommé.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("C'est sûrement ce que l'homme dans la vidéo a emporté avec lui...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Je ne peux pas dire ce que c’est exactement, mais c’est probablement ce qui a permis à la jeune fille de rester en vie et de la guérir.","Henriette")
