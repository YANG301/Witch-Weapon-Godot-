	await novel_interface.show_dialog("Pourtant, nous n’avons pas trouvé de moyen de gérer les fuites de méthane...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je murmure d'inquiétude en regardant la gigantesque fissure dans la glace depuis la fenêtre.")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("... Vous pensez ?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l apparaît de derrière et se joint à moi pour regarder par la fenêtre. Un sourire mystérieux joue sur ses lèvres.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Est-ce qu'elle sait quelque chose que j'ignore ? Est-ce qu'elle... se moque de moi ?)","Lian")
