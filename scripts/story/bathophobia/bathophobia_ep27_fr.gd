	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Trop tard pour le regretter maintenant. Il semble donc que le Maître et moi étions destinés à nous rencontrer, hein ?","Henriette")
