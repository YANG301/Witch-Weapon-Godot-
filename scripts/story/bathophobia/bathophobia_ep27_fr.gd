	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Biologiquement, cela signifie...","Raphael")
	await novel_interface.show_dialog("... que cette substance interrompt le processus de métabolisme et prolonge avec force la durée de vie des cellules. Une autre explication possible est qu’il est capable de fournir des télomères et d’accélérer le processus d’apoptose des cellules endommagées.","Raphael")
