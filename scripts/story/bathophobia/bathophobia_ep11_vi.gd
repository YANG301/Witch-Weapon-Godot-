	await novel_interface.show_text_only("Tôi đưa tay ra và cố chạm vào chúng, nhưng chúng bốc hơi ngay lập tức.")
	await novel_interface.show_dialog("Tôi đang ở đâu…", "Lian")
	await novel_interface.show_text_only("Tôi đang đứng trên một bề mặt rắn chắc và có thể cảm nhận được trọng lực. Nhưng tôi không thể nhìn thấy mặt đất… như thể tầm nhìn của tôi bị hút vào khoảng không.")
	await novel_interface.show_text_only("Có một tiếng vang bất thường trong nền. Không có bất kỳ hệ quy chiếu nào thì không thể nhận biết được phương hướng.")
	await novel_interface.show_text_only("Tôi nhìn lên và thấy hình dáng của một vật tổ giống như cái cây đang lơ lửng trên cao phía trên tôi.")
	await novel_interface.show_text_only("Nó trải rộng như một tấm chăn lấp lánh trên bầu trời.")
	await novel_interface.show_text_only("Mười vòng trên vật tổ quay chậm, một vòng phát ra tia màu đỏ.")
	await novel_interface.show_text_only("Sau đó, một mô hình khổng lồ bao gồm các đường nét và chữ khắc mở ra dưới chân tôi, tạo thành thứ có thể gọi là mặt đất.")
	await novel_interface.show_text_only("Vật tổ trên mặt đất giống như vật tổ trên không, nhưng lớn hơn nhiều khi nhìn từ khoảng cách ngắn.")
	await novel_interface.show_text_only("Các vòng, mỗi vòng có đường kính khoảng 15 ft, được kết nối theo một thứ tự nhất định. Chữ khắc trên chúng trông cổ xưa.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Mình… đang mơ à?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi đã được huấn luyện để xác định ảo giác và giấc mơ…")
	await novel_interface.show_text_only("Câu hỏi quan trọng đó là gì nữa…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("-Sao tôi lại tới đây được?", "Lian")
	await novel_interface.hide_character()
