# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Thực tế là gì?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Có thể thực tế mà chúng ta biết chỉ là một trò chơi máy tính.")
	await novel_interface.show_text_only("Đăng nhập, nhân vật thức dậy; đăng xuất và họ ngủ thiếp đi. Khi tài khoản bị đóng, họ sẽ chết.")
	await novel_interface.show_text_only("Thời gian trôi qua, họ phát triển nhận thức về linh hồn.")
	await novel_interface.show_text_only("Họ tin rằng tất cả những hành động được lập trình sẵn đó đều được thực hiện theo ý muốn tự do của họ.")
	await novel_interface.show_text_only("Các công thức, luật lệ, quy tắc ngữ pháp, quy tắc ứng xử… mọi nhân vật đều được đưa ra những quy tắc này để tuân theo mà không biết ai đã tạo ra chúng… cho đến khi cuối cùng họ được giải thoát.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Ngay cả khi một mảng lớn của bầu trời bị vỡ pixel do lỗi kết xuất—")
	await novel_interface.show_text_only("Họ chỉ hợp lý hóa nó bằng những câu chuyện cổ tích hay tín ngưỡng tôn giáo, thay vì thừa nhận rằng nó nằm ngoài tầm hiểu biết của họ.")
	await novel_interface.show_text_only("Bởi vì chấp nhận điều chưa biết có nghĩa là khả năng đáng lo ngại nhất—")
