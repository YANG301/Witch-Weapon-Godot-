# bathophobia_ep12.gd - 深海恐惧篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep12_script()

func play_script():
	pass

func bathophobia_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Para ser honesto, no estoy seguro de la verdadera identidad de The One, porque incluso si me miente, no puedo saberlo.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Y siempre me pregunto, incluso si todo es verdad...", "Henriette")
	await novel_interface.show_dialog("Debe ser una criatura muy superior a los humanos. Entonces, ¿por qué se molesta en preocuparse por nosotros?", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Piénselo. Quizás The One no sea más que un niño travieso de su especie, al que le gusta usar una lupa para quemar hormigas.", "Henriette")
	await novel_interface.show_dialog("Sin embargo, las hormigas no tienen idea de lo que está pasando. Lo toman como un castigo de Dios y se postran ante la sombra detrás de la luz deslumbrante.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Jajaja…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael suelta una risa desconcertante.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("No estaría en desacuerdo.", "Raphael")
	await novel_interface.show_dialog("La gente inclinaba la cabeza y oraba al objeto de oración... El primer mandamiento era tan voluntarioso como un niño.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Sus intenciones aún se desconocen, pero a juzgar por todas las malas acciones de The One, es posible que haya involucrado deliberadamente a las chicas.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras responde a Raphael, Heinrich vuelve su mirada hacia Annie y hacia mí.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Quieres decir… nosotros?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Annie ha estado aquí antes, y durante el período en que desapareció, probablemente quedó atrapada en este espacio...", "Raphael")
	await novel_interface.show_dialog("Rose Cross descubrió la identidad de Annie poco después del incidente del Sky Hotel. Sin embargo, supusieron que ella era simplemente un duplicado.", "Raphael")
	await novel_interface.show_dialog("Sólo pudieron confirmar su identidad después del cotejo con SID... Llevaba siete años desaparecida.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","speechless",0.25)
	await novel_interface.show_dialog("Rosa Cruz... ¿Te refieres a Rosenkreutz?", "Henriette")
	await novel_interface.show_dialog("¿La sociedad secreta que fundé para el intercambio académico entre mujeres alquimistas? ¿Se ha convertido ahora en una agencia de inteligencia?", "Henriette")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Entonces, parece que he dejado un \"legado\" interesante.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich deja escapar una sonrisa acicalada y Raphael parece tener una epifanía sobre algo.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ahora todo tiene sentido... El saludo de Rosenkreutz, muy popular hoy en día, en aquella época era en realidad una blasfemia.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Que las Rosas florezcan en Tu Cruz.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Las rosas se refieren a mujeres alquimistas… No, no exactamente. Las rosas representan a todas las mujeres, ¿verdad?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("No lo entiendo del todo, pero parece increíblemente increíble...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("De todos modos, Aquel del que has estado hablando… Es realmente un mal tipo, ¿no?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Al ver a Annie totalmente asustado, siento un aumento de rabia dentro de mí.")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("¿Cómo podría obligar a alguien a firmar un contrato y traernos a este extraño lugar?", "Lian")
	await novel_interface.show_dialog("Y debe haberle hecho algo aún más terrible a Annie…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¡Si lo veo en persona, le daré una paliza!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente se hace un silencio entre ellos y todos me miran como si fuera un idiota.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Qué? ¿Por qué me miras?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("… Nada. Suenas como un idiota.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Si usted lo dice, Maestro.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hmm… Ahora, ¿cómo podemos regresar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Me temo que no podemos. Quizás no sientas nada en este espacio, pero ahora estamos siendo transferidos al lugar de nuestra misión.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Qué tipo de tarea? ¿Puedo dejarlo?", "Lian")
