	await novel_interface.show_dialog("Así es como solíamos recuperar información de áreas de flujo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("¿Qué pasa con los datos sobre la activación de Substance H?", "Kirs")
