	await novel_interface.show_dialog("Esa ubicación es... Yesod. Representa el origen de todas las especies y el poder creativo de Dios. Puede verse como el \"Origen de la Vida\".", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Nunca he estado allí antes. Pero una vez que entramos en este espacio, nuestro destino no es negociable.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Supongo que entonces no hay manera de dejar de fumar, lo que de repente me recuerda a nuestro viejo amigo...")
	await novel_interface.show_text_only("Siento mi pecho por el orador.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Extraño. Ha pasado mucho tiempo desde la última vez que Mariru se comunicó conmigo...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al escuchar lo que dijimos, Annie parece más nervioso ahora.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("No… No, no podemos quedarnos aquí…", "Annie")
	await novel_interface.show_dialog("El Único nos tragaría a todos...", "Annie")
	await novel_interface.show_dialog("Nunca tendremos la oportunidad de escapar...", "Annie")
	await novel_interface.show_dialog("No… ¡No lo hagas!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie me agarra con fuerza con desesperación, pero no tengo idea de qué hacer.")
	novel_interface.character_light()
	await novel_interface.show_dialog("No me dejes solo...", "Annie")
