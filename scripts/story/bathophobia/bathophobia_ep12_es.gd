	await novel_interface.show_dialog("(No podemos seguir así…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie actúa como un paciente con trastorno de estrés postraumático. He visto estos síntomas antes en soldados hospitalizados que solían vigilar la frontera de Ageis.")
	await novel_interface.show_text_only("Espera... Hospital... \\nHe estado... ¿hospitalizado?")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(No importa. No tengo tiempo para esto ahora…)", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("¿Hay alguna salida?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich sacude la cabeza con las palmas levantadas.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("No. Hasta cierto punto, los humanos no son más que esclavos del Único.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sácame de aquí… ¡Ren!", "Annie")
	await novel_interface.show_text_only("Annie llora y agarra mi ropa con fuerza. Su rostro ya está bañado en lágrimas.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¡¡¡Tenemos que irnos de aquí ahora!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras rugo de rabia, el tótem dorado que nos rodea comienza a resquebrajarse.")
	await novel_interface.show_text_only("Krrr... Krrr... Krrr...")
	await novel_interface.show_text_only("Suena como un cristal rompiéndose en el vacío.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("??", "Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect_collapse.png")
	await novel_interface.show_text_only("A los ojos de Heinrich, los fragmentos del tótem siguen cayendo, como fichas de dominó, sobre las cuatro chicas que se encuentran en el vacío.")
	await novel_interface.show_text_only("Todos los fragmentos se vaporizan al llegar a la pelinegra.")
	await novel_interface.show_text_only("El espacio circundante comienza a retorcerse en finos rectángulos y luego se divide nuevamente para formar franjas tridimensionales de espacio.")
	await novel_interface.show_text_only("En un abrir y cerrar de ojos, la quietud absoluta se llena de formas geométricas y el único \"suelo\" bajo los pies de todos se siente tembloroso, como si soplara un fuerte vendaval.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("¿Qué es…?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Fabiola/white_bg.png")
	await novel_interface.show_text_only("Antes de que Heinrich termine, la última pieza del tótem comienza a resquebrajarse.")
	await novel_interface.show_text_only("Todas las chicas caen al fondo del vacío.")
	await novel_interface.show_text_only("La repentina caída obviamente ha sobresaltado a la chica rubia. En sus pupilas dilatadas hay un color extraño: el blanco.")
	await novel_interface.show_text_only("Luz blanca pura.")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("En el momento en que las chicas desaparecieron, aparecen grietas en el todopoderoso cristal antibalas frente a la sala de vigilancia. Se supone que es capaz de defenderse de los ataques electromagnéticos de los rifles de francotirador.")
	await novel_interface.show_text_only("Según el protocolo de seguridad, el equipo SWAT ayuda inmediatamente a los miembros del Senado a evacuar el área del pasaje de respaldo que prepararon de antemano.")
	await novel_interface.show_text_only("Mariru, que aún permanece en la Base Arca, está siendo interrogado por el Senado frente a una pantalla digital.")
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("La reliquia y los sujetos humanos han desaparecido...", "Eloise")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Bueno, ¿eso te sorprende?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru dice tranquilamente a través del transceptor.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Esta posibilidad se menciona en la sección tres del Informe de simulación de flujo espacio-temporal.", "Mariru")
	await novel_interface.show_dialog("Si Substance H colapsa, es probable que absorba todo lo que se encuentre dentro de un radio de treinta metros hacia el área de flujo.", "Mariru")
	await novel_interface.show_dialog("Y el talento especial de Ren ha aumentado la probabilidad de que Raphael y Annie sean llevados al área de flujo.", "Mariru")
	await novel_interface.show_dialog("Aunque el sitio del experimento está equipado con un escudo aislante...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Resulta que ni siquiera los materiales más avanzados pueden soportar una gravitación tan fuerte.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un breve silencio recorre la sala de vigilancia.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Jaja... Un alboroto diplomático está a la vuelta de la esquina, querida. ¿Cómo puedes mantenerte tan tranquilo?", "Bright")
	await novel_interface.show_dialog("Si el Dr. Dekkers sabe que su monada ha desaparecido, ¿cuánto tiempo crees que pasará antes de que se vengue de nosotros?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("No te preocupes.", "Mariru")
	await novel_interface.show_dialog("No es la primera vez que Ren ingresa a un área de flujo, y todos los registros han demostrado que…", "Mariru")
	await novel_interface.show_dialog("Si nada sale mal, saldrán del área de flujo dentro de 24 horas y aparecerán en algún lugar aleatorio en New Opulentia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ja... eso espero.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Pero entonces los datos experimentales pueden estar contaminados...", "Eloise")
