# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru si avvicina ad Aya e si china per leggere i dati aggiornati sullo schermo.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Il referto medico di Beatrice?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Uh-huh, un campione perfetto!", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("E sarebbe molto più interessante se potessimo confrontarlo con i documenti storici.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ma nessuno dei nostri database contiene nessuna delle sue informazioni. Potrebbe essere dovuto alla lacuna di dati causata dalla guerra.", "Mariru")
	await novel_interface.show_dialog("Tuttavia, secondo le sue dichiarazioni e il tuo rapporto...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru visualizza il profilo di Beatrice sullo schermo.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 anni... \\nChe età privilegiata!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru e Aya si scambiano un'occhiata, sapendo di aver notato la stessa cosa. Quindi tornano allo schermo.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo è il risultato del test la notte in cui è emersa?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Praticamente zero elementi radioattivi trovati nel suo corpo. Anche se i livelli di metalli pesanti sono relativamente alti nei suoi campioni di sangue.", "Ai")
	await novel_interface.show_dialog("Potrebbe avere qualcosa a che fare con gli utensili o i cosmetici grezzi del Medioevo…", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Quindi hai già una conclusione?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Dopotutto, secondo le registrazioni delle sue dichiarazioni...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya fa scorrere il dito su una riga di testo sullo schermo.")
	await novel_interface.show_text_only("GMT+9 13:09:11 Target afferma che il 1265 d.C. come anno di nascita.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—Questa è la prima volta che vedo un esemplare vivente dei tempi antichi.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Potrebbe essere lo stesso caso con Annie?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("No! \\nBeatrice ha detto che era sicura al 100% che fosse morta.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("Ha detto di aver bevuto intenzionalmente del veleno.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ci sono documenti storici a sostegno di ciò... Ma la possibilità di falsificazione non può essere esclusa.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya fa clic per aprire un altro rapporto di test.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Nel Medioevo si registra solo una varietà limitata di veleni. Cicuta, belladonna, noce vomitica, ecc.", "Ai")
	await novel_interface.show_dialog("Abbiamo trovato residui di alcaloidi tossici nei campioni di sangue prelevati la notte in cui è emersa.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ma nel sangue che abbiamo prelevato il giorno dopo non c'è quasi traccia di alcaloidi tossici o metalli pesanti.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Non c'è da stupirsi che tu sembri così eccitato...", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aspetta, questa non è ancora la parte più emozionante!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La voce di Aya trema per l'eccitazione.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("A differenza di Annie, Beatrice ha un sistema immunitario presente nei neonati. È risultata negativa alle IgD.", "Ai")
	await novel_interface.show_dialog("E... le proprietà del microbioma nel suo corpo sono quasi le stesse di Ren!!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… Come ti è venuta l’idea di sostenere questi test?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuizione. Istinto. E una passione per i campioni rari!!", "Ai")
	await novel_interface.show_dialog("Un corpo creato dal nulla... che riproduce fedelmente la \"maledizione\" più interessante sull'argomento: la capacità di attrarre l'amore.", "Ai")
	await novel_interface.show_dialog("Ren è semplicemente... incredibile!!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Detto questo, Aya chiude gli occhi e incrocia le braccia per abbracciarsi, sembrando piuttosto inebriata dai suoi pensieri.")
	await novel_interface.show_text_only("Mariru tira fuori un rotolo di rapporti e bussa forte sulla fronte di Aya.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se un’anima può esistere indipendentemente in uno Spaziotempo diverso…", "Mariru")
	await novel_interface.show_dialog("Allora come seleziona un contenitore?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("Potrebbe avere qualcosa a che fare con la farfalla dorata?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No, considerando Annie e la sua mazza da baseball, penso che Beatrice sia in qualche modo collegato alla gemma verde...", "Mariru")
	await novel_interface.show_dialog("È come se certi oggetti potessero evocare le anime a loro legate.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Si tratta del viaggio nello spaziotempo e della creazione del corpo...", "Mariru")
	await novel_interface.show_dialog("(Il Senato non dovrebbe mai sapere nulla al riguardo.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Quindi, Ren può persino attrarre un’anima…", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya interrompe il filo dei pensieri di Mariru.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ehm?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Ottenere una certa anima dal nulla e creare un corpo per ospitarla... Sembra un'alchimia proibita.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Se non fossi vissuto in quest’epoca, avrei potuto provare a fare scambio di anime con gli dei utilizzando elementi di base, proprio come gli alchimisti.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Come il cosiddetto “Figlio di Dio” promosso da piccoli gruppi religiosi. Ma non c'è mercato per questo in New Opulentia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("No, preferisco titoli femminili come “Goddess”. Mi danno questo bisogno interiore di sfidare l’astinenza.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Accidenti, perché mai ho assunto qualcuno come te...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Uh-eh! Forse le nostre anime sono semplicemente attratte l'una dall'altra.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("—Allora, questo è tutto quello che ho trovato.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel centro sanitario, dopo il regolare controllo fisico, parlo con Aya di Beatrice mentre mi vesto.")
	await novel_interface.show_text_only("Il commento di Aya sulle condizioni fisiche di Beatrice potrebbe avere senso...")
	await novel_interface.show_text_only("Ma la teoria dell’anima sembra una totale schifezza…")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Soprattutto la cosiddetta \"Dea\"...) \\n(Anche se una volta ho catturato questo tipo di ruoli nei videogiochi)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ma non vorrei mai un titolo del genere per me!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non posso fare a meno di abbracciarmi in preda ai brividi.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("No, mai!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, c'è qualcosa di indicibile nella tua mente?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Allora... è per questo che i miei articoli di controllo sono aumentati?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uh-eh.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya mostra un sorriso furbo, come se stesse pianificando qualcosa in segreto.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Forse è un’altra ricerca non autorizzata…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Peccato che non ho abbastanza attrezzature di supporto; altrimenti potrei fare prove più “interessanti”…", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("A proposito, vuoi provare la modalità di massima potenza del chip inserito in te?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("No! Grazie mille!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
