# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("閉ざされた会議室で、一方的な報告が\\n続いている。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("……以上が、サモントン視察団が襲撃を受けた\\n事件についての事後調査です。", "マリル")
	await novel_interface.show_dialog("ラファエル・デックスは「プライベートな理由」\\nで先週より再び新豊洲を訪問しています。", "マリル")
	await novel_interface.show_dialog("SIDでは現在、\\n彼女をクラスAの監視・保護対象としました。", "マリル")
	await novel_interface.show_dialog("前回と異なり今回サモントン側は外務省へ、\\n随行人員の非常に詳細なプロファイルと、\\n持ち込み予定である所持品の申告リストを\\n提出しています。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("同行するボディーガードが過去に参加した\\n軍事作戦まで、包み隠さず全てを報告。\\n完璧にルールを厳守しております……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("まるで「新豊洲内でデックス博士の可愛い孫娘に\\n何かあれば、全てそちらの責任」と\\n言わんばかりのようだな。", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("ふんっ　あの古狐めっ……", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("だが、あのお嬢さんの保護条件として\\n20%の農産物の購入契約を、\\n優先的に新豊洲へ譲渡する事が約束された。", "華音瀧")
	await novel_interface.show_dialog("NBOTの相場からすれば……\\nこれは非常に魅力的な取引ではある。", "華音瀧")
	await novel_interface.show_dialog("接触禁止令は発布したので、マスコミもしばらく\\nあのお嬢さんには干渉しないはずだ。", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（元老院を介して市場を操作するつもりか？）\\n\\n（そして私が関与しない事まで計算して……）", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（ふん……確かに古狐だな）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("あの小娘がそれほどに重要ならば、\\n彼女から更なる情報を絞り出す事は可能か？", "ブライト")
	await novel_interface.show_dialog("我々、科学院としてはサモントンの持つ\\nゲノム編集技術とスーパー温室システムに\\nすべからく興味を抱いていてね。", "ブライト")
	await novel_interface.show_dialog("なに、彼女が私の実験室に数時間ほど\\nいてくれるだけでいいのだが……", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("ブライト博士──", "マリル")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("あなたの「独特」な精神類異質物に対する\\n倫理基準は、既に世間にまで周知されています。", "マリル")
	await novel_interface.show_dialog("あのお嬢様があなたの実験室に、\\n一歩でも足を踏み入れたその瞬間、\\nサモントンはすぐさま新豊洲への貿易制裁を\\n発動するでしょう。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("私はそんなに有名なのかね？\\nはっはっはっは──", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("うぉっほん！\\nこの話はここまでにしてくれたまえ！", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("さて、スカイホテルにいた身元不明の武装集団に\\n関してだが……", "ギアーズ")
	await novel_interface.show_dialog("彼らはサモントン視察団を襲撃し、\\n貴重な芸術品を強奪した。", "ギアーズ")
	await novel_interface.show_dialog("それについて、SIDで何か発見はあるかね？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（老キツネは金色の蝶を元老院から隠し、その責任をジェイコブとその一味に押しつけました。）", "マリル")
	await novel_interface.show_dialog("（彼らは作戦前にホテルの監視を麻痺させた…）\\n\\n（その情報ギャップを利用すれば……）", "マリル")
	await novel_interface.show_dialog("『協定非武装地域』はSIDの管轄範囲内では\\n　ありませんが。\\n現在、各方面の情報を統合した結果、\\n彼らは特殊な武器を使用してたと推測できます。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("特殊な武器………異質物武器の事か？\\n\\nそれもイージスの防御フィールド内でか！？", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("ホテル内の床に残された樹木模様の焼け跡から、\\n\\nその武器は高出力の直列共振放電装置であると、\\n我々は推測を立てました。", "マリル")
	await novel_interface.show_dialog("この装置を小型化、\\n1人の兵士だけで携帯可能とするには、\\n従来の技術だけでは不可能でしょう。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("視察団メンバーの供述によれば、\\nその夜に現れた連中は10人ほど。\\n全員が全員、同じ武器を装備していたようです。", "マリル")
	await novel_interface.show_dialog("また、イージスの記録によれば事件当日の夜に\\n同じく10個ほどの不明な電子番号が、\\nほぼ同時にオフラインになったのを確認。\\nおそらく新豊洲から撤退した兆候かと。", "マリル")
	await novel_interface.show_dialog("事件当日、SIDでは通常の出国ルートの全てを\\n制御していましたので\\n連中はきっと外交VIPのルートを通じて\\n逃亡を図ったものと思われます。", "マリル")
	await novel_interface.show_dialog("（あるいは任務失敗のために処刑されたか……）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……仔細承知した。", "ギアーズ")
	await novel_interface.show_dialog("それほどの量産化がされている装備となると\\n異質物武器とは考えにくい。", "ギアーズ")
	await novel_interface.show_dialog("しかしだ、監視カメラが麻痺する前、\\n2人の怪しい人物が廊下で警備員を襲っている。", "ギアーズ")
	await novel_interface.show_dialog("1人はホテル従業員のメイド服を着ており\\nもう1人は御桜川の制服を着ていた。\\n彼女らは君が派遣したのでは……", "ギアーズ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("モニターから甲高い電子雑音がした。")
	novel_interface.character_light()
	await novel_interface.show_dialog("──？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("フハハハ、どうやら主席執政官殿も私と同じく、\\nその子猫ちゃんに興味があるご様子ですね。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……子猫？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("おっと、\\nそれはマリル殿の呼び方を引用したまでで──", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("（やはり、こいつ……）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("あの2人はアニーとレンと言うのですね？\\n実に可愛らしい名前ではありませんか。", "#C")
	await novel_interface.show_dialog("もしかしたら、美川さんが育てた猫は他にもいるかも――。", "#C")
	await novel_interface.show_dialog("──どうなんですか、マリル殿？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("ふふふ……どうやら元老院の方々には\\n感謝しなければならないようですね。\\n彼女達の事が保安軍に漏れてないようですので。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("いえいえ、どういたしまして──\\n\\nマリル殿も我々に隠すつもりは無かったよう\\nですな。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("それではブリーフィング情報を補足します。", "マリル")
	await novel_interface.show_dialog("事件前、衛星によってスカイホテルでの異常な\\n位相波動を検出。\\nしかし、SIDの管理管轄外のため直接の行動が\\n取れませんでした。", "マリル")
	await novel_interface.show_dialog("そのため、先ほど話しに挙がった2名を\\n捜査員として潜り込ませ調査を命じました。", "マリル")
	await novel_interface.show_dialog("ですが、調査途中に武装集団に遭遇。\\n\\nその際、捜査員であるアニーが例の武器で\\n撃たれて負傷。", "マリル")
	await novel_interface.show_dialog("彼女は緊急治療を受け、現在の容態は\\n落ち着いております。\\nそれに伴い、武器のデータの一部を採取する事に\\n成功しました。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……なにゆえ、先ほど話さなかったのだ？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("主席執政官殿。\\n\\nあなたも先程、サモントン視察団が失くしたのは\\nただの「芸術品」だとおっしゃいましたね？", "マリル")
	await novel_interface.show_dialog("より十分な情報共有は、お互いにとって\\nより有意義になるのでは？", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("……いかがでしょう？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…………", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("では、マリル殿が自ら引き取った子猫については\\nいかがでしょうか？\\nそれこそ、我々と情報をもっと分かち合うべき\\nではありませんか？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（ふん、私が放り投げた情報に惑わされないか）", "マリル")
	await novel_interface.show_dialog("（やはり嫌な奴だ……）\\n\\n（偽造した情報の完璧さに賭けるしかないな）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("……マリル殿\\n是非とも説明をして頂けないでしょうか？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("『七年戦争』の期間中、人体を用いて『聖痕』を\\n再現しようとする動きがありました。", "マリル")
	await novel_interface.show_dialog("戦闘要員に対して、\\n秘密裏な人体改造の実験を施した　など、\\n様々な噂を皆様も耳にした事があると思います。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……ああ。", "ギアーズ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは口角を上げて、フッと軽く笑った。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("確かに一部の人間は生まれながら特殊な才能を\\n持っていることがある……\\nこれについては、新豊洲科学院と播磨脳研にも\\n記録が残っているはずです。", "マリル")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("強いて言えば、\\nブライト博士もその1人に当てはまりますが……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("……私は違う。\\n超能力の記録を持つ者は、ほとんどが女性だ……", "ブライト")
	await novel_interface.show_dialog("ただし、このような特別な才能を持った人は、通常は監視リストに入れられるだけであり、特別な管理は必要ありません。", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("確かに、現時点での全超能力者のデータでは\\nB級の異質物能力に及ぶ人間ですら\\n存在しませんから。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("しかも効果が不安定なため、この手の研究は\\nそのほとんどが戦争中に打ち切られました。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("超能力を持つ女性を『魔女』と称する人もいる。\\n十数年前なら誰かしらが騒ぎになっていたが……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("ですが、この「レン」と言う少女は\\nかなり特別でしてね。\\n彼女は『位相波動空間』を越える能力を\\n持っているのです。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("────ッ！！！","全員")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
