# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru se acerca a Aya y se inclina para leer los datos refrescantes en la pantalla.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("¿El informe médico de Beatrice?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Ajá, ¡una muestra perfecta!", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("Y sería mucho más interesante si pudiéramos compararlo con registros históricos.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pero ninguna de nuestras bases de datos contiene información sobre ella. Podría deberse a la falta de datos provocada por la guerra.", "Mariru")
	await novel_interface.show_dialog("Sin embargo, según sus declaraciones y su informe…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru muestra el perfil de Beatrice en la pantalla.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 años… \\n¡Qué edad tan privilegiada!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru y Aya intercambian una mirada, sabiendo que han notado lo mismo. Luego, vuelven a la pantalla.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Este es el resultado de su prueba la noche que salió?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Prácticamente no se encontraron elementos radiactivos en su cuerpo. Aunque los niveles de metales pesados ​​son relativamente altos en sus muestras de sangre.", "Ai")
	await novel_interface.show_dialog("Quizás tenga algo que ver con los utensilios o la cosmética tosca de la Edad Media…", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("¿Entonces ya tienes una conclusión?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Después de todo, según los registros de sus declaraciones—", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya pasa el dedo por una línea de texto en la pantalla.")
	await novel_interface.show_text_only("GMT+9 13:09:11 Target afirma que el año de nacimiento es 1265 d.C.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—Esta es la primera vez que veo una muestra viva de la antigüedad.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Podría ser el mismo caso con Annie?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¡No! \\nBeatrice dijo que estaba 100 por ciento segura de que estaba muerta.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("Dijo que bebió veneno intencionalmente.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hay registros históricos que respaldan esto… Pero no se puede descartar la posibilidad de falsificación.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya hace clic para abrir otro informe de prueba.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("En la Edad Media sólo se conoce una variedad limitada de venenos. Cicuta, solanácea, nuez vómica, etc.", "Ai")
	await novel_interface.show_dialog("Encontramos residuos de alcaloides tóxicos en las muestras de sangre tomadas la noche en que emergió.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Pero en la sangre que extrajimos al día siguiente, casi no hay rastros de ningún alcaloide tóxico o metal pesado.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("No es de extrañar que luzcas tan emocionado...", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Espera, ¡esta no es la parte más emocionante todavía!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La voz de Aya tiembla de emoción.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("A diferencia de Annie, Beatrice tiene un sistema inmunológico que se encuentra en los recién nacidos. La prueba de IgD fue negativa.", "Ai")
	await novel_interface.show_dialog("Y… ¡¡las propiedades del microbioma en su cuerpo son casi las mismas que las de Ren!!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… ¿Cómo se te ocurrió la idea de realizar estas pruebas?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuición. Instinto. ¡¡Y pasión por las muestras raras!!", "Ai")
	await novel_interface.show_dialog("Un cuerpo creado de la nada... que reproduce fielmente la \"maldición\" más interesante sobre el tema: la capacidad de atraer el amor.", "Ai")
	await novel_interface.show_dialog("¡¡Ren es simplemente… increíble!!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Al decir eso, Aya cierra los ojos y se cruza de brazos para abrazarse, luciendo bastante intoxicada por sus pensamientos.")
	await novel_interface.show_text_only("Mariru saca un rollo de informes y golpea con fuerza la frente de Aya.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si un alma puede existir independientemente en un espacio-tiempo diferente...", "Mariru")
	await novel_interface.show_dialog("Entonces, ¿cómo selecciona un contenedor?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("¿Tendrá algo que ver con la mariposa dorada?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No, considerando Annie y su bate de béisbol, creo que Beatrice está de alguna manera conectado con la gema verde...", "Mariru")
	await novel_interface.show_dialog("Es como si ciertos objetos pudieran convocar a las almas unidas a ellos.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Se trata de viajes en el espacio-tiempo y creación de cuerpos...", "Mariru")
	await novel_interface.show_dialog("(El Senado nunca debería saber nada sobre esto).", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Entonces, Ren puede incluso atraer un alma...", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya rompe el hilo de pensamientos de Mariru.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Mmmm?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Sacar cierta alma de la nada y crear un cuerpo que albergue el alma… Suena a alquimia prohibida.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Si no hubiera estado viviendo en esta era, podría haber intentado comerciar almas con los dioses usando elementos básicos, como los alquimistas.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Como el llamado “Hijo de Dioses” promovido por pequeños grupos religiosos. Pero no hay mercado para esto en New Opulentia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("No, prefiero títulos femeninos como \"Diosa\". Me dan este impulso interior de desafiar la abstinencia.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dios mío, ¿por qué diablos contraté a alguien como tú?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("¡Ajá! Quizás nuestras almas simplemente se sientan atraídas una por la otra.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("—Entonces, esto es todo lo que he encontrado.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el centro de salud, después del chequeo físico regular, hablo con Aya sobre Beatrice mientras me pongo la ropa.")
	await novel_interface.show_text_only("El comentario de Aya sobre las condiciones físicas de Beatrice puede tener sentido...")
	await novel_interface.show_text_only("Pero la teoría del alma suena como una completa mierda...")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Especialmente la llamada \"Diosa\"...) \\n(Aunque una vez capturé este tipo de roles en videojuegos)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(¡Pero nunca querría ese título para mí!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No puedo evitar abrazarme con un escalofrío.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("¡¡No, nunca!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, ¿hay algo indescriptible en tu mente?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Entonces… ¿Es por eso que mis artículos de chequeo han aumentado?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ajá.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya muestra una sonrisa astuta como si estuviera planeando algo en secreto.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Tal vez sea otra investigación no autorizada…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Lástima que no tengo suficiente equipo de apoyo; de lo contrario, podría hacer más pruebas \"interesantes\"...", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("Por cierto, ¿quieres probar el modo de máxima potencia del chip que llevas instalado?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¡No! ¡¡Muchas gracias!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
