# bathophobia_ep04.gd - 深海恐惧篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep04_script()

func play_script():
	pass

func bathophobia_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("En el césped, bajo las sombras, miro de mal humor el cielo de la tarde.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Uf—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente una sombra bloquea mi vista.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("¿Qué pasa, Ren? ¿Qué te molesta?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Hola, Annie…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie se sienta a mi lado y deja una bolsa de papel sobre las rodillas.")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("—¡Huele tan dulce!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("¡Ta-dah! ¡Galletas de crema de arce recién horneadas! \\n¿Quieres uno?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Después de preguntarme, no parece esperar ningún rechazo y me mete una galleta en la boca.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Umm… (Masticando) \\n¡Qué rico!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¡Lo sé! Capté un olor súper bueno cuando pasé por una clase de trabajo doméstico, así que le pedí a alguien que me colara una bolsa.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es muy agradable... verte convertirte en un miembro de la familia de la escuela, Annie.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Mmmm?", "Annie")
	await novel_interface.show_dialog("Ren, tú también eres muy popular. \\nMuchos compañeros me han preguntado por ti...", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("¿En serio?")
	await novel_interface.show_text_only("¡Mi suerte en el romance es mucho mejor que cuando era niño!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Pero la Sra. Mariru no nos permite divulgar información personal... ¡así que nunca le hablé a nadie de ti!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie me mira atentamente mientras come las galletas.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("¿No te sientes bien?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Una vida tan pacífica me incomoda…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("¿No es bueno para ti?", "Annie")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es como si tuviera algo importante que hacer pero no sé por dónde empezar. \\nEl hecho de que ahora no tengamos nada que hacer me pone nervioso...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("¿Algo importante?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Digamos, cómo sería el futuro… Cosas así. \\nY mi cuerpo—", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Jaja—", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mmm—! \\n¡¡Crees que esto es gracioso!!")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_text_only("¡¡¡Es tan vergonzoso decir esto !!!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("M... muchas compañeras de clase hablarían conmigo abiertamente sobre todos estos temas femeninos... Me siento incómoda.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Ya veo. ¿Por eso estás aquí solo?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie parece tranquila.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Sí. A veces, inconscientemente jugueteaba con mi cabello o me ajustaba la ropa interior.", "Lian")
	await novel_interface.show_dialog("Y cuando salía a una misión, naturalmente me ponía falda y tacones altos…", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Pero en el momento en que me di cuenta de lo que había hecho, pensé: \"Dios, ¿cómo podría hacer esto?\"", "Lian")
	await novel_interface.show_dialog("Yo... soy un niño...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","relieve",0.25)
	await novel_interface.show_dialog("Los chicos también pueden hacer eso.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie de repente suena serio.")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","relieve",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Los tacones altos fueron inventados por Luis XIV.", "Annie")
	await novel_interface.show_dialog("Y en el siglo XVII, las mujeres comenzaron a usar tacones altos para parecer masculinas.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Los tacones altos estaban destinados a... ¿masculinidad?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("¡Y los hombres escoceses usan faldas escocesas en ocasiones formales!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eso lo sé…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Ajá… ¡Se dice que ni siquiera usan calzoncillos!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Inconscientemente, me di unas palmaditas en la falda.")
	await novel_interface.show_text_only("¡Gracias a Dios que no soy escocés!")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Entonces, Ren, ¡te ves muy varonil!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿…lo hago?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hmm… Y la ropa interior…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Los ojos de Annie se vuelven hacia mi pecho.")
	novel_interface.show_character("ren_uniform","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("¡E… mira! ¡Estos dos no son de ninguna manera varoniles!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Creo que son similares a los equipos de entrenamiento con pesas.", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("—¿Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("¡Eso es! Tómalos como sacos de arena.", "Annie")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Ojalá pudiera tener estas dulces cargas...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie se toca el pecho con tristeza.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Tú... suenas sensato.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—¡De ninguna manera!")
	await novel_interface.show_text_only("¿Crees que compraré esto?")
	novel_interface.show_character("ren_uniform","uneasy")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("De todos modos, Ren, ¡creo que eres un muy buen chico!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Mi cara arde.")
	await novel_interface.show_dialog("¿Y… lo haces?", "Lian")
	await novel_interface.show_dialog("(Suena sensata, pero todavía me siento engañado…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie parece inocente y sincera, así que… elijo confiar en ella.")
	await novel_interface.show_dialog("Qué edad tan despreocupada.", "Mariru")
	await novel_interface.show_text_only("La voz de Mariru acaba de salir de mi pecho.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Ah—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sobresaltada, me cubrí el pecho al instante, temiendo que otros estudiantes me descubrieran.")
	await novel_interface.show_text_only("¡¡Aya dijo que me acostumbraría al hablante, pero creo que nunca aceptaré este extraño entumecimiento!!")
	await novel_interface.show_text_only("Después de la operación del Sky Hotel, les pedí que me quitaran el estúpido chip.")
	await novel_interface.show_text_only("Hasta que Mariru amenazó con tocar el timbre de la escuela a través del chip delante de toda mi clase.")
	await novel_interface.show_text_only("¡¡Qué demonio!! Waaah...")
	await novel_interface.show_dialog("He estado trabajando sin parar para ustedes estos días.", "Mariru")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("¡No es de extrañar que no recibamos ninguna misión!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ja... jaja... \\nParece que no puedes esperar para trabajar, Annie...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Si no fuera por los testarudos senadores, lo habría arreglado todo...", "Mariru")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru suena emocionada.")
	await novel_interface.show_dialog("Pronto lo sabrás", "Mariru")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No importa. Pero ya casi es hora de entrenar y ustedes dos todavía están dando vueltas por el campus. ¿Para qué? ¿Tener una cita?", "Mariru")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Aún nos queda media hora...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿No tienes mi correo electrónico? \\nTu entrenamiento físico ha aumentado.", "Mariru")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Torturar de nuevo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ya puedo imaginar numerosas noches venideras en las que yo, agotado, me desplomo en mi cama…")
	await novel_interface.show_dialog("¿Tortura? Humph—", "Mariru")
	await novel_interface.show_dialog("No lo olvides, tu cuerpo ha sido mío durante mucho tiempo.", "Mariru")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_text_only("Oye, deja eso. ¡¡¡Esto no suena bien!!!")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru corta la llamada con una sonrisa.")
	await novel_interface.show_text_only("Está parada frente a una pantalla sombría.")
	await novel_interface.show_text_only("Los datos del teléfono se presentan a quienes están detrás de la pantalla.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("En cuanto al presupuesto...", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("He solicitado a las autoridades municipales que le den a SID el mandato para apoderarse de la tierra deshabitada dentro de las 25 millas de G-cans en la región del Nuevo Noreste.", "Mariru")
	await novel_interface.show_dialog("El presupuesto es de 1,49 mil millones.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "multitud")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Reconstruiremos las tuberías y la infraestructura de transporte y seguridad de apoyo, todo de acuerdo con el estándar de búnkeres militares clase V.", "Mariru")
	await novel_interface.show_dialog("El presupuesto es de 620 millones.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "multitud")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Los puertos subterráneos de control de inundaciones se renovarán para conectarse en paralelo. Se colocarán escudos electromagnéticos en toda la zona. Se desplegará un sistema de armas autónomo personalizado.", "Mariru")
	await novel_interface.show_dialog("El presupuesto es de 532 millones.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "multitud")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Se espera que el proyecto demore 58 días.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Senadores, si no tienen preguntas sobre esto, SID iniciará el proyecto de inmediato.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Eso es... muy... caro...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Esta es la opción más rentable entre los tres planes de desarrollo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Bueno, no me importa poner fin a este proyecto.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Pero si se me permite decirlo, sus opiniones cuentan...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "multitud")
	await novel_interface.show_text_only("El silencio no significa que no.")
	await novel_interface.show_text_only("En la habitación sólo se oye un zumbido estático.")
	await novel_interface.show_text_only("— La palabra \"Aprobado\" aparece una tras otra en la pantalla.")
	await novel_interface.show_text_only("La palabra se muestra debajo de todas las transmisiones de video.")
	await novel_interface.show_text_only("Mariru sonríe satisfecho.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Entonces, ¡anuncio el inicio del \"Proyecto Arca\"!", "Mariru")

	print("=== 深海恐惧篇第04话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
