	await novel_interface.show_text_only("ไฮน์ริชชี้ไปที่หน้าอกของเธอ")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("ใหญ่กว่าที่เคยเป็น… รสนิยมของอาจารย์คนนี้เหรอ?", "Henriette")
