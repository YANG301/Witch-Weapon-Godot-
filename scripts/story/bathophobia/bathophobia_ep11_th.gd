# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("ความเป็นจริงคืออะไร?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("บางทีความจริงที่เรารู้อาจเป็นเพียงเกมคอมพิวเตอร์")
	await novel_interface.show_text_only("เข้าสู่ระบบ ตัวละครจะตื่น ออกจากระบบแล้วพวกเขาก็หลับไป พอปิดบัญชีก็ตาย")
	await novel_interface.show_text_only("เมื่อเวลาผ่านไป การรับรู้ของจิตวิญญาณก็จะพัฒนา")
	await novel_interface.show_text_only("พวกเขาเชื่อว่าการกระทำที่ตั้งโปรแกรมไว้ล่วงหน้าทั้งหมดนั้นถูกพรากไปจากเจตจำนงเสรีของพวกเขา")
	await novel_interface.show_text_only("สูตร กฎหมาย กฎไวยากรณ์ หลักจรรยาบรรณ... ตัวละครทุกตัวจะได้รับกฎเหล่านี้ให้ปฏิบัติตามโดยไม่รู้ว่าใครเป็นผู้สร้าง... จนกระทั่งพวกเขาได้รับการปลดปล่อยในที่สุด")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("แม้ว่าท้องฟ้าผืนใหญ่จะกลายเป็นพิกเซลเนื่องจากข้อผิดพลาดในการเรนเดอร์—")
	await novel_interface.show_text_only("พวกเขาเพียงแต่หาเหตุผลเข้าข้างตนเองด้วยเทพนิยายหรือความเชื่อทางศาสนา แทนที่จะยอมรับว่ามันเป็นเรื่องนอกเหนือความรู้ของพวกเขา")
	await novel_interface.show_text_only("เพราะการยอมรับสิ่งที่ไม่รู้หมายถึงความเป็นไปได้ที่น่ากังวลที่สุด—")
	await novel_interface.show_text_only("ว่าสิ่งที่เรียกว่าความจริงนั้นอาจเป็นเพียงภาพลวงตาเท่านั้น")
	await novel_interface.show_text_only("ความฝันของท่อ")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("ฉันลืมตาขึ้นช้าๆ และพบว่าตัวเองอยู่ในหมอกควัน")
	await novel_interface.show_text_only("ฉันถูกล้อมรอบด้วยหมอก น่าแปลกที่สายฝนห้อยอยู่กลางอากาศ")
