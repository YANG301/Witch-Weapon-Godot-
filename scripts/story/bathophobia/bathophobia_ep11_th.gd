	await novel_interface.show_dialog("ฉันอยู่ที่ไหน…", "Lian")
	await novel_interface.show_text_only("ฉันยืนอยู่บนพื้นผิวแข็ง และสัมผัสได้ถึงแรงโน้มถ่วง แต่ฉันมองไม่เห็นพื้นดิน… ราวกับว่าสายตาของฉันถูกดูดกลืนไปในความว่างเปล่า")
	await novel_interface.show_text_only("มีเสียงฮือฮาที่ไม่ธรรมดาอยู่เบื้องหลัง หากไม่มีกรอบอ้างอิงใดๆ ทิศทางจะมองไม่เห็น")
	await novel_interface.show_text_only("ฉันเงยหน้าขึ้นและเห็นโครงร่างของโทเท็มที่ดูเหมือนต้นไม้ลอยอยู่เหนือฉัน")
	await novel_interface.show_text_only("มันแผ่กระจายเหมือนผ้าห่มที่แวววาวบนท้องฟ้า")
	await novel_interface.show_text_only("วงแหวนสิบวงบนโทเท็มหมุนช้าๆ หนึ่งวงเปล่งแสงสีแดง")
	await novel_interface.show_text_only("จากนั้นลวดลายขนาดใหญ่ที่ประกอบด้วยเส้นและคำจารึกก็แผ่ออกไปใต้ฝ่าเท้าของฉัน ก่อให้เกิดสิ่งที่เรียกได้ว่าเป็นพื้นดิน")
