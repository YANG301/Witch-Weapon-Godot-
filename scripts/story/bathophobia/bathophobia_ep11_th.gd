	await novel_interface.show_text_only("พวกเขายังต้องถูกดูดเข้าไปในสถานที่แห่งนี้ด้วย!")
	await novel_interface.show_text_only("ฉันมองไปรอบๆ ในหมอกเพื่อพวกเขา โดยไม่คาดคิด แขนอันอบอุ่นคู่หนึ่งโอบกอดฉันไว้จากด้านหลัง")
