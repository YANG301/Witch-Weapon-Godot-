	await novel_interface.show_text_only("วงแหวนแต่ละวงมีเส้นผ่านศูนย์กลางประมาณ 15 ฟุต เชื่อมต่อกันตามลำดับที่แน่นอน คำจารึกบนนั้นดูโบราณ")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(ฉัน... ฝันไปหรือเปล่า?)", "Lian")
