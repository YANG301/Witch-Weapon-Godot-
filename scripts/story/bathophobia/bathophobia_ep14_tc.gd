	await novel_interface.show_text_only("我拿著暖玉，往拉斐爾和安妮手裡也塞了幾塊。")
	await novel_interface.show_text_only("伸手碰觸，就能感覺到她們兩人的體溫正在上升。")
	await novel_interface.show_dialog("咳、咳咳……", "拉斐爾")
	await novel_interface.show_dialog("唔……哈啊……", "安妮")
	await novel_interface.show_text_only("隨著幾聲咳嗽，安妮和拉斐爾都醒了過來。")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("妳們沒事吧？", "小憐")
	await novel_interface.hide_character()
