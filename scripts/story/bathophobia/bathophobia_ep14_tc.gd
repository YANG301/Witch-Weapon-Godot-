# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("一片純白之中。")
	await novel_interface.show_text_only("眼前漸漸浮現出模糊的輪廓，似乎身邊的一切都在被加速，就像正從萬米高空極速墜落。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("雙腳終於接觸到地面的瞬間，意外地沒有感到任何衝擊，只有耳壓突然升高帶來的強烈不適。")
	await novel_interface.show_dialog("好痛……", "小憐")
	await novel_interface.show_text_only("從吸入第一口空氣開始，我就知道自己已經脫離那個空間、回到了現世，因為周圍實在是……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("好冷冷冷冷冷冷冷冷冷——！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("還沒睜開雙眼，身體就被刺骨的嚴寒包圍，小腹傳來陣陣劇痛。")
	await novel_interface.show_text_only("就連動動睫毛也會傳來陣陣刺痛，好像已經結了冰，連睜眼都十分費力……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("好不容易恢復視覺，只見四周都被銀白覆蓋，吸入的寒冷空氣讓氣管有如刀割。")
	await novel_interface.show_text_only("因為突如其來吸入冷空氣，我忍不住咳嗽起來。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("呼——咳咳、咳咳咳！", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("已經是晚上了嗎？ \\n我們現在在哪裡……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("嚴寒令人喪失思考能力，我感到自己快速失溫，身體開始無法控制地顫抖。")
	await novel_interface.show_text_only("而身旁的海因里希卻莫名地露出了興奮的表情。 \\n安妮和拉斐爾則暈倒在我右側的雪地上。")
