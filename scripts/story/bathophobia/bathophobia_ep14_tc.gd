	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("……主人這麼怕冷嗎？", "海因里希")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("海因里希輕輕握住了我的手。")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("欸……？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("一股暖流從她掌心傳過來，我瞬間產生坐在爐火旁的錯覺。")
	await novel_interface.show_text_only("我驚訝地看著這位穿得比我更單薄的金髮少女，她鬆開雙手，在我手心留下幾枚黃澄澄的石頭。")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("這是……？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("拿著這些暖玉，你會好受些。", "海因里希")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("玉石質地的晶體雖然不燙手，但卻能散出一股包裏全身暖意。")
	await novel_interface.show_text_only("我捧著它們，在冰天雪地的荒原中，卻彷彿置身於溫暖的室內。")
	await novel_interface.show_text_only("這種視覺與體感溫度上的違和，讓我不禁有了周圍可能都是室內布景的錯覺。")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這個好厲害啊……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("沒什麼，只是用煉金術和能量轉換的刻印造出的小玩意。", "海因里希")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("海因里希淡淡地說著，臉上的表情卻透露著得意的神情。")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("不不不，這已經不能叫做小玩意了……", "小憐")
	await novel_interface.hide_character()
