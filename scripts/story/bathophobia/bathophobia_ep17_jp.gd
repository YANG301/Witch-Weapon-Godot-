# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("果てしなく広がる大地は、空のオーロラにより\\n異様なほどの緑色を映し出している。")
	await novel_interface.show_text_only("暗く静まり返った極寒の大陸を一筋の光が\\n走り抜けていく。")
	await novel_interface.show_text_only("数台のスノーモービルが夜の氷原を渡る。\\n\\nヘリポートを通過し、巨大な基地の入り口の前に\\n止まった。")
	await novel_interface.show_text_only("彼らの真正面には楕円形の石碑が立っていた。\\n\\nクローブ山に飛来したベスタ星隕石を\\n採集した時の箱が、石碑には埋め込まれている。")
	await novel_interface.show_text_only("箱は岩石塗料で書かれた\\n『Snedronningen』という文字で囲われており\\nライトに照らされ銀色に輝いている。")
	await novel_interface.show_text_only("ここがライダー達の目的地。\\nスノークイーン基地。")
	await novel_interface.show_text_only("前方に降りた完全武装のタスクフォース隊員が、\\nゴーグルをあげた。")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("到着～～っと！", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女の後ろにいる5人も、バイクから次々と降り\\n各自の装備を点検している。")
	await novel_interface.show_text_only("彼らは名義上「科学視察団」と呼ばれているが\\nその装備は軍の小隊規模に等しい。")
	await novel_interface.show_text_only("2ヵ月前、南極において異質物に似た電波が\\n検知された事実は、あらゆる勢力を惹きつけた。\\nすでに各勢力間での小競り合いが、\\n大きな戦闘に発展する事態も頻繁に起きている。")
	await novel_interface.show_text_only("サンプルの安全を守るため、タスクフォースは\\n普段よりも慎重にならなければならない。")
	await novel_interface.show_text_only("しかし彼らは運が良かった。\\n\\n実験基地に向かう道中は特にトラブル等はなく、\\n無事にたどり着いたのだった。")
	await novel_interface.show_dialog("OK～～ッ！　あとは引継ぎを待つだけだ！", "隊員D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("はい。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("分厚い保温服の隊員とは対照的。\\n\\n低温に対して特殊な耐性を持つバイジュウは、\\n普段と特に変わらない格好をしている。")
	await novel_interface.show_text_only("彼女が持ってる武器は自身で改造したものだ。\\n\\n異彩を放つ武器のグリップを彼女は確かめつつ、\\nゆっくりと握りしめる。")
	await novel_interface.show_text_only("──小隊の作戦過程だが、今のところは\\nバイジュウの予想通りに事が進んでいた。")
	await novel_interface.show_text_only("バイジュウは深海にいた未知物の「身体」から\\n数時間前に生体サンプルを採取する事に成功。")
	await novel_interface.show_text_only("研究計画を完遂するためにミルクの上司は\\n砕氷船ウスアイア号を派遣して、\\nタスクフォースに協力した。")
	await novel_interface.show_text_only("しかし、サンプルがウスアイア号に移送されると\\n砕氷船上に設置した臨時の生物実験室にて\\n突如「想定外」の電力故障が発生。")
	await novel_interface.show_text_only("同時刻、1時間あまりの距離に位置していた\\nスノークイーン基地が協力を申し出る。\\n相応の規格の実験室を提供したいと、\\n協力に積極的な意思を表明したのだ。")
	await novel_interface.show_text_only("結果、タスクフォースは通行許可を入手。\\n\\n90分以内にサンプルをスノークイーン基地に\\n「荷物」を届けるよう指令が下された。")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("（ここ……なのでしょうか……）", "バイジュウ")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("あの連中は、本当に姿を現すでしょうか？", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウはこっそり拳を握りしめた。")
	await novel_interface.show_text_only("バイジュウの不安は大きい。\\n\\n収集したサンプルが自分と何らかの感応を\\n引き起こしている事実も、彼女の不安を煽った。")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("………………\\n（この感覚、なんとなく馴染みがあります）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウが考えを巡らそうとした瞬間、\\n周囲の景色が急に揺れ始めた。")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("（深海に潜った後の後遺症？）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──否、明らかに違う。")
	await novel_interface.show_text_only("──大地全体が揺れている。")
	await novel_interface.show_text_only("遠方の大地から轟きが聞こえてくる。")
	await novel_interface.show_text_only("歴戦の隊員達も、少し驚きを見せてしまう。")
	await novel_interface.show_text_only("白い大陸の震動は、30秒弱続いた。")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("南極は地震のない地域じゃないの……！？\\nなんで……っ！？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("とはいえ、震感はそこまで強烈ではなく\\n全員に一瞬のめまいを感じさせる程度だった。")
	await novel_interface.show_dialog("（ブツブツ）津波よりずっとひどいですよ…。", "隊員B")
	await novel_interface.show_dialog("俺達が踏んでいる氷棚が丈夫でよかったな。\\n\\nこれが都会で起きていたら、\\n家やビルが倒壊していたかもしれん。", "隊長")
	await novel_interface.show_text_only("タスクフォースの隊員にとって、この程度の\\n地震は大した事がなかったようだ。\\n長い揺れが収まると全員が普通の調子に戻る。")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("それでは、行きましょう。", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウは慎重にサンプル収容箱を抱え、\\nミルクのモービルの後部座席から飛び降りた。")
	await novel_interface.show_dialog("終わったらホットココア飲ませてくれよ。\\n今回は本当に疲れたぜ……", "隊員B")
	await novel_interface.show_text_only("気楽な隊員達と違い、隊長はバイジュウの様子を\\nさりげなくうかがっていた。")
	await novel_interface.show_text_only("この小娘がいなければ今回の極地任務は\\n手ぶらで帰るはめになっただろう──\\nこの地に出張ってきた他の同業者と同じように。")
	await novel_interface.show_text_only("深海恐怖症、高圧潜水艦、不明生物……")
	await novel_interface.show_text_only("そんな正体不明のプレッシャーを感じながら\\n無事にサンプルを採取するなど、\\nもし自分自身が彼女の立場だったら\\n成し得ただろうか？")
	await novel_interface.show_dialog("後はあっちの科学者に任せればいいんだろ？", "隊員D")
	await novel_interface.show_dialog("ブエノスアイレスに戻ったら、一杯奢るよ。\\nバイちゃん～～♪", "隊員C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("コラッ！\\nうちのバイちゃんはお酒を飲まないのっ！", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルクはバイジュウを自分の胸元まで引っ張り\\n大声で騒いでいる。")
	await novel_interface.show_text_only("Bai Zhu は唇を押し、不安を意図的に抑えました。")
	await novel_interface.show_text_only("ミルクが基地の入り口で通行許可を提示する\\n……しかし、何度やっても返事が返ってこない。")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("おっかしいな～……", "ミルク")
	await novel_interface.show_dialog("さっきの地震のせいで回線が壊れたのかな？\\n上陸前に基地の人と打ち合わせしたはずなのに…", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("基地正門にある車両の通行制限のボラードは、\\n到着を拒否するかのように上がったままだ。\\nしかしタスクフォースは既に通行用の\\nパスコードを受け取っている。")
	await novel_interface.show_text_only("タスクフォースは基地側面の明かりが灯っていた\\nゲートへ移動を始める。")
	await novel_interface.show_text_only("バイジュウは突然立ち止まり、\\nサンプル収容箱を1人の隊員に預けた。")
	await novel_interface.show_text_only("そして、自分の武器を握り締める。")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("……どうしたの？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウの異常に気付くと\\nミルクも背負っていた武器を取り外し、構えた。")
	await novel_interface.show_text_only("2人の変化は他の隊員にも伝わり、\\nすぐに全員が戦闘態勢に入った。\\nお互いを援護できる半円の陣形で進む。")
	await novel_interface.show_dialog("……嘘だろおい？", "隊員D")
	await novel_interface.show_dialog("しっ！　静かに。", "隊長")
	await novel_interface.show_text_only("スノーシューズが氷を踏む音と、数人の僅かな\\n呼吸音だけがその場を支配する。")
	await novel_interface.show_text_only("ミルクはゲートのセキュリティシステムに近付き\\n認証機械へパスコードを入力した。")
	await novel_interface.show_text_only("認証が無事完了すると\\nモニターが緑色の「Enter」を表示する。")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("ふっ──これで問題なし？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しかし、バイジュウはまだ気を緩めない……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("歯車の噛み合う音とロープが滑る音と共に、\\nスノークイーン基地のゲートがゆっくり開く……")
	await novel_interface.show_text_only("ゲートの奥は真っ直ぐな階段が続いており、\\n暗い下層へと通じている。")
	await novel_interface.show_dialog("誰か────いないの──？", "ミルク")
	await novel_interface.show_text_only("彼女の質問は、狭い通路に空しく反響した。")
	await novel_interface.show_dialog("施設の大部分が地下にあるからって、\\n誰も迎えに来ないなんてありえる？", "ミルク")
	await novel_interface.show_dialog("研究員の1人でさえも、サンプルの様子を\\n確認しに来ないのか……", "隊員B")
	await novel_interface.show_dialog("──戦闘準備ッ！", "バイジュウ")
	await novel_interface.show_text_only("バイジュウは奈落のような階段の果てを見つめ、\\n命令を下した。")
	await novel_interface.show_dialog("おそらくですが、私達は狙われています。", "バイジュウ")
	await novel_interface.show_dialog("やっぱ秘密裏に行動すればするほど、\\n目立っちゃうのかな……", "ミルク")
	await novel_interface.show_dialog("（……あんたが気にしている連中？）", "ミルク")
	await novel_interface.show_text_only("静けさの中で銃器のセーフティー解除音が響く。")
	await novel_interface.show_text_only("隊員達は兵士としての「本来の顔」に戻り、\\n臨時の指揮権を持つ少女から\\n次に下される命令を待っていた。")
	await novel_interface.show_dialog("待ち伏せの場合、現在の位置だと狙われ放題だ。\\n氷原に撤退も可能だが──", "隊員D")
	await novel_interface.show_dialog("ダメです。さっき受け取った警報によると、\\n1時間以内に猛吹雪が来ます。", "バイジュウ")
	await novel_interface.show_dialog("全員で警戒しつつ、前へ進むしかありません。", "バイジュウ")
	await novel_interface.show_dialog("（全員）了解っ！", "隊員")
	await novel_interface.show_text_only("全員が足音を軽くし、呼吸音も極限まで潜めた。")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("──気を付けてっ！", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一瞬の静寂を破る、空気を切り裂く鋭い刃の音が響いた。")
	await novel_interface.show_text_only("巨大な鎌状の武器を持つ生物が、突如影から現れ\\nバイジュウの右側から迫ってくる。")
	await novel_interface.show_text_only("ミルクの注意もあってか、バイジュウは\\nとっさの攻撃を避ける事ができた。")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("……っ！！！", "バイジュウ")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("オォおオおおHaは――ッ！", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──襲撃者は少女だった。\\n\\n目の焦点と手足の動作が明らかにおかしく\\n彼女が動く度、関節からカタカタと鳴っている。")
	await novel_interface.show_text_only("その狂った少女はいつの間にか徒党を組み、\\n\\nそれまで静まり返っていた通路の入口に\\n次々と押し寄せてきた。")
	await novel_interface.show_text_only("隊員達はすぐさま戦闘態勢に入り、\\n標準的な三角陣形を維持しながら\\n敵に向けて発砲する。")
	await novel_interface.show_text_only("サンプル収容箱を持つ隊員を小隊の最優先対象と\\n考え、\\nバイジュウは真っ先に反対側からの襲撃に\\n立ち塞がった。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("全員が一定の射撃間隔を保ちつつ、\\nカバーポイントを探し、\\nすぐに展示室のような空間へ移動した。")
	await novel_interface.show_text_only("部屋の明かりは薄暗く、周囲の展示ガラスには\\n生物の標本のようなモノばかりが飾られている。")
	await novel_interface.show_text_only("隊長がその部屋の入口に防衛線を組み\\nこの部屋を守備地点とする。\\nその最中にも、小隊のメンバーは敵に対して\\n異常さを感じていた。")
	await novel_interface.show_text_only("撃った敵の傷口からは出血が見られず、\\n痛みもまったく感じていない様子なのだ。")
	await novel_interface.show_text_only("黒いケブラー繊維で作られた、\\n折り畳み式のライオットシールドを展開し、\\n近接武器による衝撃を防ぐ。")
	await novel_interface.show_text_only("反対側から大剣を持って襲い来る敵にも\\n同じくライオットシールドを持つ別の隊員が、\\n入口通路の角に立ち塞がり妨害。")
	await novel_interface.show_text_only("シールドの後ろから、硝煙を漂わせる9mm弾を\\n絶え間なく敵に撃ち込む。")
	await novel_interface.show_dialog("リロードッ！", "隊員C")
	await novel_interface.show_text_only("連続射撃を行っても、敵の攻撃は止まらない。\\n\\n顔面を撃たれた敵の1人はおぞましい笑みを\\n浮かべた。")
	await novel_interface.show_text_only("彼女はシールドの力を利用して跳ね上がり、\\nコウモリのように天井にぶら下がっている。")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("こいつら……人間なの？", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("敵の銃創から深緑色の液体が大量に溢れ出した。\\n\\nそしてほとんど千切れかけている首が、\\n一瞬で紫と緑の混在した色に染まる。")
	await novel_interface.show_dialog("気を付けろッ！", "隊員B")
	await novel_interface.show_text_only("通路の奥より、さらに多くの敵が突撃してくる。")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("後退──ッ！", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("やむを得ず隊員達は2つの方向に散開するが\\nすぐに次の攻撃地点を確保した。")
	await novel_interface.show_text_only("短い交戦ではあったが、それだけでも隊員全員が\\n認識する。\\n相手が何者でも、個々の戦力は劣っていない。")
	await novel_interface.show_text_only("しかし狂気に染まった敵の戦意は、\\nこの軍人達を遥かに凌駕していた。")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("こ…この……人達……", "バイジュウ")
