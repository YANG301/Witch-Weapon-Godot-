	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("こいつらなんなのッ！？\\nどう見てもおかしい！", "ミルク")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("バイジュウは分かってしまった。目の前にいる弓や剣を持つこの子達は、自分と同じく──")
