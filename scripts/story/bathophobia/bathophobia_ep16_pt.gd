# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Raphael encontrou alguns tanques de diesel no segundo andar, que deveriam manter o depósito funcionando por alguns dias.")
	await novel_interface.show_text_only("Quando a energia é ligada novamente em meio ao barulho do gerador, corro para o banheiro imediatamente.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Usar um banheiro no escuro seria definitivamente a última coisa que quero fazer…)", "Lian")
	await novel_interface.show_dialog("(Graças a Deus eles não fizeram um banheiro transparente…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Caramba…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saio do banheiro, meu estômago ainda doendo. Annie parece um pouco recuperada e consegue se levantar.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, você está bem?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Sim, estou bem. Vamos verificar a sala de comunicação…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como ela mal consegue ficar em pé, eu a ajudo até o segundo andar.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("A sala de comunicação é bastante rústica por dentro, onde um corredor em forma de T conduz até a parede curva da área de observação.")
	await novel_interface.show_text_only("Os armários estão cheios de água potável, alimentos enlatados e outros alimentos não perecíveis.")
	await novel_interface.show_text_only("O ar aqui parece bem fresco. Pela janela podemos ver as auroras dançando no céu noturno.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Vamos ver se o sistema funciona…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela tenta ligar o equipamento antigo no painel de operação. Felizmente, todo o hardware “confiável em primeiro lugar” ainda funciona.")
	await novel_interface.show_text_only("Como agente SID bem treinado, Annie está bastante familiarizado com o sistema. As antenas instaladas fora do depósito não parecem muito afetadas pelas temperaturas extremas.")
	await novel_interface.show_text_only("Através das aberturas de ventilação na parede, um fluxo de ar quente e úmido entra lentamente na sala.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Parece que o sistema de aquecimento está ligado.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho para o display de temperatura fixado na parede, que mostra que a temperatura interna está subindo constantemente de 32°F.")
	await novel_interface.show_text_only("Mas a temperatura externa… -44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Se não fosse pelo topázio de Heinrich...", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Usando uma saia a uma temperatura de -44°F e brincando na neve…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Acho que desbloqueei uma nova conquista para me gabar…)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Espere… É melhor entrarmos em contato com Mariru o mais rápido possível. Só ela pode nos tirar daqui.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Falando nisso, o que há de errado com o chip?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toco meu peito instintivamente. Nunca estive tão ansioso para ouvir a voz de Mariru de lá.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Conectando-se a satélites… Pronto.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguindo as instruções de Annie, insiro uma sequência de números que está gravada há muito tempo em minha mente.")
	await novel_interface.show_text_only("Acho que preciso agradecer a Mariru por me forçar a decorar os códigos de identificação criptografados de SID.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("É assim que funciona! Interessante…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Desde que chegamos ao depósito, Heinrich ficou muito concentrado observando os materiais e itens armazenados aqui.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Sempre quis senti-los em minhas mãos!", "Henriette")
	await novel_interface.show_dialog("Que combinação maravilhosa de areia, alumínio, cálcio, metais combustíveis e basalto…", "Henriette")
	await novel_interface.show_dialog("E o processo de fibração mudou todas as suas propriedades.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Hum?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Eles usaram uma nova combinação de materiais para fazer este vidro. É algo que nunca ouvi falar.", "Henriette")
	await novel_interface.show_dialog("O método deles pode prevenir a perda de calor… Isso é muito inteligente.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mas nós, alquimistas, preferiríamos usar as inscrições de conversão de energia, o que é muito mais fácil.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Inscrições… Você quer dizer a magia?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Quem usaria magia para fazer um pedaço de vidro?! Você pode perder a cabeça por causa disso!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Mas os produtos de borracha nas embalagens pequenas realmente me impressionaram com sua extraordinária flexibilidade.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("E as fragrâncias frutadas… Para que servem?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eu… eu não sei!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("É só chiclete, seu pervertido estúpido.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael revira os olhos para mim.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Pelo amor de Deus, Heinrich absorveu-se totalmente no mundo da alquimia!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("De volta à sede, Mariru e Aya estão procurando por Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Ainda não há sinal do chip do Ren. Isso é estranho. O aglomerado de satélites cobre literalmente todos os cantos do globo…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Poderia ser teletransporte extraterrestre ou distorção temporal?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Como diz o ditado, “as entidades não devem ser multiplicadas além da necessidade”. Suposições mais simples têm maior probabilidade de serem corretas.", "Mariru")
	await novel_interface.show_dialog("Na verdade, os chamados “satélites globais” cobrem apenas entre 70°N e 70°S.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você quer dizer…", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Uma confirmação de conexão aparece repentinamente através do canal de comunicação criptografado de SID.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ele-olá?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! Sou eu!! \\nOh meu Deus, finalmente…", "Lian")
	await novel_interface.show_text_only("Ao ouvir a voz familiar, Mariru logo volta a si. A tensão parece desaparecer instantaneamente.")
	await novel_interface.show_text_only("Com os olhos fixos no sinal off-line, ela inicia imediatamente o procedimento de rastreamento.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ren? Informe sua localização. \\nVocê está com as outras garotas?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sim, agora estou em um depósito com Raphael e Annie. \\nEstamos seguros aqui, mas…", "Lian")
	await novel_interface.show_dialog("Estamos agora… na Antártida.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Antártica?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Claramente é uma resposta além das expectativas, mas não há nenhum lampejo de surpresa no rosto de Mariru.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Parece que Ren não está sofrendo de hipotermia.) \\n(Eles devem ter encontrado algum lugar seguro.)", "Mariru")
	await novel_interface.show_dialog("(Houve outro Fluxo de Espaço-Tempo durante o experimento na Base Ark?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("O resultado do rastreamento aparece na tela – Não. 2 Depósito Conjunto em Princess Elizabeth Land, Leste da Antártida.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Tudo faz sentido agora… Os satélites em órbita baixa da Terra não passarão por essa área a menos que suas órbitas sejam alteradas manualmente.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Porque o vento solar polar interromperá a transmissão de dados.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Eu esqueci completamente…", "Ai")
	await novel_interface.show_dialog("Devemos conectar os satélites acima da Antártica?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-hum. Lembre-se, não acorde aqueles cachorros velhos adormecidos.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Não sei o que aconteceu... Fui trazido aqui de repente.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Além de vocês três, tem mais alguém?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Você quer dizer Henrique? \\nEla está bem ao meu lado.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Não esperava que pudéssemos fazer contato com Mariru através de um equipamento tão antigo. Tenho que admitir que a voz de Mariru me deu um grande alívio.")
	await novel_interface.show_text_only("Eu a informo sobre a situação atual.")
	await novel_interface.show_dialog("… muito bem anotado.", "Mariru")
	await novel_interface.show_dialog("Ouça, agora você está muito perto do Pólo Sul, o que significa que buscá-lo não é tão fácil.", "Mariru")
	await novel_interface.show_dialog("De acordo com a Nova Convenção Antártica do pós-guerra, qualquer país que queira enviar uma equipe de expedição com mais de 5 membros…", "Mariru")
	await novel_interface.show_dialog("… Ou uma aeronave lá, tem que pedir permissão ao Congresso Unido.", "Mariru")
	await novel_interface.show_dialog("E a aeronave provavelmente precisará fazer escala na Nova Austrália…", "Mariru")
	await novel_interface.show_dialog("Portanto, mesmo que consigamos decolar em 1 hora e realizar todos os procedimentos durante o voo, demoraremos cerca de 40 horas para chegar lá.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Tudo bem. O gerador aqui pode durar alguns dias e temos comida suficiente para sobreviver.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O avental mais próximo de vocês fica 68° 24' S e 76° 55' E, cerca de meia milha de distância de vocês.", "Mariru")
	await novel_interface.show_dialog("Dadas as condições climáticas imprevisíveis na Antártica, podemos perder contato com vocês a qualquer momento. Se isso acontecer, lembre-se que te encontrarei lá.", "Mariru")
	await novel_interface.show_dialog("É uma grande base chamada Snedronningen, que significa literalmente a rainha da neve\\ne a maioria de suas instalações foram construídas no subsolo…", "Mariru")
	await novel_interface.show_dialog("Quanto aos detalhes… Manteremos você informado. Ren,… essa merda rrrrk…", "Mariru")
	await novel_interface.show_text_only("A voz de Mariru é engolida por um ruído repentino de eletricidade.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? Olá?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Ele-olá? Você pode me ouvir?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O barulho no centro de comunicação está cada vez mais alto.")
	await novel_interface.show_dialog("Pode haver uma rajada de vento solar... É melhor você... verificar a recepção do sinal agora.", "Mariru")
	await novel_interface.show_text_only("Uau——")
	await novel_interface.show_text_only("À medida que o ruído elétrico fica mais forte, a voz de Mariru desaparece do receptor.")
	await novel_interface.show_text_only("Um silêncio paira sobre nós.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Acho que... perdemos contato com eles novamente...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Quarenta horas? É melhor rezar para que não haja mais surpresas.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso me dá más vibrações, mas não sei por quê.")
	await novel_interface.show_text_only("Do lado de fora da janela, todas as auroras desapareceram com os sinais cada vez mais fracos e até o vento fraco diminuiu.")
	await novel_interface.show_text_only("Os únicos sons que ouvimos agora vêm dos radiadores dos computadores e dos ventiladores do ar condicionado.")
	await novel_interface.show_text_only("Tal silêncio sempre me lembra a calmaria antes da tempestade…")
	await novel_interface.show_text_only("De repente, o painel de operação treme um pouco.")
	await novel_interface.show_text_only("Não, isso é impossível. Devo ter perdido o equilíbrio agora há pouco.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Você sentiu isso?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Você quer dizer o…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O leve tremor está ficando cada vez mais violento.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Oh meu Deus… Você está brincando comigo?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Segurando o painel de operação para me apoiar, sinto meu coração disparar.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("O que são estes…?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um barulho estrondoso vem do chão sob nossos pés.")
	await novel_interface.show_text_only("O prédio começa a tremer com tanta violência que mal conseguimos ficar em pé.")
	await novel_interface.show_text_only("Tudo na mesa quica como Pop Rocks se dissolvendo na boca.")
	await novel_interface.show_text_only("Um som horrível de estalo viaja das geleiras ao longe.")
	await novel_interface.show_text_only("Uma olhada pela janela confirma meu medo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("É um terremoto!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
