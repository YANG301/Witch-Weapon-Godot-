# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Raphael ha trovato alcune taniche di gasolio al secondo piano, che dovrebbero bastare a far funzionare il deposito per qualche giorno.")
	await novel_interface.show_text_only("Non appena torna la corrente in mezzo al rombo del generatore, corro immediatamente in bagno.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Usare il bagno al buio sarebbe sicuramente l’ultima cosa che voglio fare…)", "Lian")
	await novel_interface.show_dialog("(Grazie a Dio non l'hanno fatto un bagno trasparente…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Santo cielo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esco dal bagno, con lo stomaco ancora dolorante. Annie sembra essersi ripreso un po' ed è in grado di rimettersi in piedi.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, stai bene?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Sì, sto bene. Andiamo a controllare la sala comunicazioni...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dato che riesce a malapena a stare in piedi, la aiuto fino al secondo piano.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("L'interno della sala comunicazioni è piuttosto rustico, dove un corridoio a forma di T conduce fino alla parete curva dell'area di osservazione.")
	await novel_interface.show_text_only("Gli armadietti sono pieni di acqua potabile, cibo in scatola e altri alimenti non deperibili.")
	await novel_interface.show_text_only("L'aria qui sembra piuttosto fresca. Attraverso la finestra possiamo vedere le aurore danzare nel cielo notturno.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Vediamo se il sistema funziona...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cerca di avviare la vecchia apparecchiatura sul pannello operativo. Fortunatamente, tutto l'hardware \"l'affidabilità innanzitutto\" funziona ancora.")
	await novel_interface.show_text_only("Essendo un agente SID ben addestrato, Annie ha abbastanza familiarità con il sistema. Le antenne installate all'esterno del deposito non sembrano essere molto influenzate dalla temperatura estrema.")
	await novel_interface.show_text_only("Attraverso le aperture nel muro, un flusso d'aria calda e umida entra lentamente nella stanza.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Sembra che il sistema di riscaldamento sia acceso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Guardo il display della temperatura fissato al muro, che mostra che la temperatura interna è in costante aumento da 32°F.")
	await novel_interface.show_text_only("Ma la temperatura esterna… -44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Se non fosse stato per il topazio di Heinrich...", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Indossare una gonna a una temperatura di -4°C e giocare nella neve…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Immagino di aver sbloccato un nuovo risultato di cui vantarmi...)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Aspetta... Sarà meglio contattare Mariru il prima possibile. Solo lei può tirarci fuori di qui.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(A proposito, cosa c'è che non va nel chip?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi tocco istintivamente il petto. Non sono mai stato così ansioso di sentire la voce di Mariru da lì.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Connessione ai satelliti… Fatto.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguendo le istruzioni di Annie, inserisco una stringa di numeri che è impressa da tempo nella mia mente.")
	await novel_interface.show_text_only("Immagino di dover ringraziare Mariru per avermi costretto a imparare a memoria i codici di identificazione crittografati di SID.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Funziona così! Interessante…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Da quando siamo arrivati al deposito, Heinrich è stato così preso dall'osservazione dei materiali e degli oggetti qui immagazzinati.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ho sempre desiderato sentirli tra le mani!", "Henriette")
	await novel_interface.show_dialog("Che meravigliosa combinazione di sabbia, alluminio, calcio, metalli combustibili e basalto...", "Henriette")
	await novel_interface.show_dialog("E il processo di fibrezzazione ha cambiato tutte le loro proprietà.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Ehm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Hanno utilizzato una nuova combinazione di materiali per realizzare questo vetro. È qualcosa di cui non ho mai sentito parlare.", "Henriette")
	await novel_interface.show_dialog("Il loro metodo può prevenire la perdita di calore... È davvero intelligente.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ma noi alchimisti preferiremmo usare le iscrizioni di conversione dell'energia, che è molto più semplice.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Iscrizioni... Intendi la magia?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Chi userebbe la magia per creare un pezzo di vetro?! Potresti perdere la testa per questo!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ma i prodotti in gomma nelle confezioni piccole mi hanno davvero impressionato per la loro straordinaria flessibilità.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("E le fragranze fruttate… a cosa servono?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Io... non lo so!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("È solo una gomma da masticare, stupido pervertito.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael alza gli occhi al cielo.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Per l'amor del cielo, Heinrich si è completamente immersa nel mondo dell'alchimia!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Tornati al quartier generale, Mariru e Aya stanno cercando Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Ancora nessuna traccia del chip di Ren. È strano. L’ammasso satellitare copre letteralmente ogni angolo del globo…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Potrebbe trattarsi di teletrasporto extraterrestre o distorsione temporale?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Come si suol dire, \"le entità non dovrebbero essere moltiplicate oltre il necessario\". Le ipotesi più semplici hanno maggiori probabilità di essere corrette.", "Mariru")
	await novel_interface.show_dialog("Infatti, i cosiddetti \"satelliti globali\" coprono solo tra 70°N e 70°S.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vuoi dire...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Improvvisamente appare una conferma di connessione attraverso il canale di comunicazione crittografato di SID.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ehi, ciao?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! Sono io!! \\nOh mio Dio, finalmente...", "Lian")
	await novel_interface.show_text_only("Sentendo la voce familiare, Mariru torna presto in sé. La tensione sembra sparita all'istante.")
	await novel_interface.show_text_only("Con gli occhi fissi sul segnale offline, avvia immediatamente la procedura di tracciamento.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ren? Segnala la tua posizione. \\nSei con le altre ragazze?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sì, ora sono in un deposito con Raphael e Annie. \\nSiamo al sicuro qui, ma...", "Lian")
	await novel_interface.show_dialog("Ora siamo... in Antartide.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Antartide?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Chiaramente è una risposta oltre ogni aspettativa, ma non c'è alcun barlume di sorpresa sul volto di Mariru.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Sembra che Ren non soffra di ipotermia.) \\n(Devono aver trovato un posto sicuro.)", "Mariru")
	await novel_interface.show_dialog("(C'è stato un altro flusso spaziotemporale durante l'esperimento alla Base dell'Arca?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Il risultato del tracciamento viene visualizzato sullo schermo: n. 2 Deposito congiunto nella Terra della Principessa Elisabetta, Antartide orientale.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Ora tutto ha senso... I satelliti in orbita terrestre bassa non passeranno su quell'area a meno che le loro orbite non vengano modificate manualmente.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Perché il vento solare polare interromperà la trasmissione dei dati.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ho completamente trascurato...", "Ai")
	await novel_interface.show_dialog("Collegheremo i satelliti sopra l'Antartide?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uhm. Ricorda, non svegliare quei vecchi cani addormentati.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Non so cosa sia successo... sono stato portato qui all'improvviso.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Oltre a voi tre, c'è qualcun altro?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Intendi Heinrich? \\nLei è proprio accanto a me.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Non mi aspettavo che potessimo entrare in contatto con Mariru tramite un'attrezzatura così antica. Devo ammettere che la voce di Mariru mi ha dato un grande sollievo.")
	await novel_interface.show_text_only("La informo sulla situazione attuale.")
	await novel_interface.show_dialog("…molto ben notato.", "Mariru")
	await novel_interface.show_dialog("Ascolta, ora sei molto vicino al Polo Sud, il che significa che venirti a prendere non è così facile.", "Mariru")
	await novel_interface.show_dialog("Secondo la Convenzione della Nuova Antartica del dopoguerra, qualsiasi paese che desideri inviare una squadra di spedizione composta da più di 5 membri...", "Mariru")
	await novel_interface.show_dialog("… Oppure un aereo lì deve chiedere il permesso al Congresso Unito.", "Mariru")
	await novel_interface.show_dialog("E probabilmente l’aereo dovrà fare scalo in Nuova Australia…", "Mariru")
	await novel_interface.show_dialog("Quindi, anche se riuscissimo a decollare in 1 ora e a seguire tutte le procedure durante il volo, ci vorranno circa 40 ore per arrivare a destinazione.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Andrà tutto bene. Il generatore qui può durare qualche giorno e abbiamo abbastanza cibo per sopravvivere.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La zona più vicina a voi ragazzi è 68° 24' S e 76° 55' E, a circa mezzo miglio da voi.", "Mariru")
	await novel_interface.show_dialog("Date le condizioni meteorologiche imprevedibili in Antartide, potremmo perdere i contatti con voi in qualsiasi momento. Se ciò accade, ricorda che ci vediamo lì.", "Mariru")
	await novel_interface.show_dialog("È una grande base chiamata Snedronningen, che letteralmente significa la regina delle nevi\\ne la maggior parte delle sue strutture sono state costruite sottoterra...", "Mariru")
	await novel_interface.show_dialog("Per quanto riguarda i dettagli... Vi terremo aggiornati. Ren,... thisshig rrrerrk...", "Mariru")
	await novel_interface.show_text_only("La voce di Mariru viene inghiottita da un improvviso rumore elettrico.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? Ciao?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Ehi, ciao? Riesci a sentirmi?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il rumore nel centro di comunicazione diventa sempre più forte.")
	await novel_interface.show_dialog("Potrebbe esserci un'esplosione di vento solare... Faresti meglio... controlla subito la ricezione del segnale.", "Mariru")
	await novel_interface.show_text_only("Wow——")
	await novel_interface.show_text_only("Man mano che il rumore elettrico diventa più forte, la voce di Mariru svanisce dal ricevitore.")
	await novel_interface.show_text_only("Un silenzio incombe su di noi.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Immagino... abbiamo perso di nuovo i contatti con loro...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Quaranta ore? Faresti meglio a pregare affinché non ci siano più sorprese.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi dà brutte vibrazioni ma non so perché.")
	await novel_interface.show_text_only("Fuori dalla finestra le aurore se ne sono andate insieme ai segnali in dissolvenza e anche il debole vento si è calmato.")
	await novel_interface.show_text_only("Gli unici suoni che sentiamo ora provengono dai radiatori del computer e dalle ventole dell'aria condizionata.")
	await novel_interface.show_text_only("Un silenzio simile mi ricorda sempre la calma prima della tempesta…")
	await novel_interface.show_text_only("All'improvviso, il pannello operativo trema leggermente.")
	await novel_interface.show_text_only("No, è impossibile. Devo aver perso l'equilibrio proprio adesso.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Lo hai sentito?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Intendi il...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il leggero scuotimento si fa sempre più violento.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Oh mio Dio… stai scherzando?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tenendo il pannello operativo come supporto, sento il cuore battere forte.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Cosa sono questi...?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un rumore ruggente proviene dalla terra sotto i nostri piedi.")
	await novel_interface.show_text_only("L'edificio inizia a tremare così violentemente che riusciamo a malapena a stare in piedi.")
	await novel_interface.show_text_only("Tutto sul tavolo rimbalza come Pop Rocks che si sciolgono in bocca.")
	await novel_interface.show_text_only("Un orribile schiocco proviene dai ghiacciai in lontananza.")
	await novel_interface.show_text_only("Uno sguardo fuori dalla finestra conferma la mia paura –")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("È un terremoto!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
