# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Als ich aus dem roten Coupé von Mariru krieche, spüre ich, wie sich die ganze Welt dreht und ich kaum aufrecht stehen kann.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… W?rg… \\nWie du fährst!! Es ist verrückt!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heute Morgen habe ich es mir wie immer in einer kuscheligen Decke gemütlich gemacht. Plötzlich platzte Annie herein und zog mich aus dem Bett.")
	await novel_interface.show_text_only("Noch im Halbschlaf wurde ich ins Auto gestoßen. In diesem Moment protestierte ich immer noch gegen ihr gewalttätiges Verhalten.")
	await novel_interface.show_text_only("Aber nach dieser schrecklichen Fahrt bleibt mir nur noch „Gott sei Dank, ich lebe noch“…")
	await novel_interface.show_text_only("Ark-Projekt startet heute, aber ich möchte mich unbedingt krank melden.")
	await novel_interface.show_text_only("Mein Magen tut seit Tagen weh. Verdammt!")
	await novel_interface.show_text_only("Und ich habe immer das Gefühl, mich übergeben zu müssen... W?rg!")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Geht es dir gut, Ren?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich winke Annie abweisend zu.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mir geht es gut, nur ein bisschen krank. Und ich kann gerade nicht aufhören zu zittern...", "Lian")
	await novel_interface.show_dialog("Kann ich ein anderes Auto nehmen, wenn wir zurückfahren?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frage ich mit schwacher Stimme und schaue flehend auf Annie")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Schau dich an. Sie sind doch so daran gewöhnt, Fräulein Unschuld zu spielen, nicht wahr?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich mich stützend an die Wand lehnte, ertönte von hinten eine vertraute Stimme. Meine Güte! Lass mich einfach gehen...")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Raphael? Warum bist du...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hat dir Mariru nicht gesagt, dass ich hier sein würde?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Sie würde nicht auftauchen, wenn ich es täte.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sieht mich an, als wäre ich ihr Haustier zum Verkauf, und übergeht Raphaels Frage.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ich überlasse Ren Ihnen, \\nMiss Dekkers, unserer lieben Geschäftsführerin von Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Warte! Mich ihr überlassen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru setzt ein Lächeln auf und führt uns zum Eingang der Ark-Basis.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Sind Sie sicher, dass dies... der Eingang ist?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vor uns liegt der Eingang zu einem Betonkeller gegenüber dieser Straße am Rande der Stadt. Die Tür lässt nur eine Person durch.")
	await novel_interface.show_text_only("Im Umkreis von einer halben Meile gibt es überhaupt keine Gebäude. Wäre da nicht das in die Wand eingravierte SID-Logo gewesen, hätte ich es für einen gruseligen Zufluchtsort für einen Perversen gehalten.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hihi, komm mit mir.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("Wir gingen die Treppe hinter der Tür hinunter, die zu einem großen Lastenaufzug führte.")
	await novel_interface.show_text_only("Es scheint, dass der Aufzug für extreme Umgebungen ausgelegt ist. Vier dicke Metallscheiben sorgen für einen sicheren und stabilen Betrieb.")
	await novel_interface.show_text_only("Während der Aufzug sanft nach unten fährt, ertönt aus allen Ecken das Geräusch rotierender Zahnräder.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("Die Lüftungsschlitze, Metallgitter, Nieten und das gedämpfte Licht … Vintage-Industrieelemente sind überall.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Zuverlässigkeit geht über alles andere... Ich habe solche Designs im Goldtresor der Zentralbank von Newmoridas gesehen.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Boah, du warst dort?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Es war eines der größten Bauprojekte der Welt vor dem Siebenjährigen Krieg und es hat uns viel Arbeit gekostet, diesen Ort wiederherzustellen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru stellt stolz diese unterirdische Struktur vor.")
	await novel_interface.show_text_only("Raphael hat recht. Der Aufzug ist zwar noch in Betrieb, aber so stabil wie ein riesiges Stück massiven Stahl. Mir kommt in den Sinn, dass selbst das Herumspringen nicht das geringste Zittern des Aufzugs hervorrufen würde.")
	await novel_interface.show_text_only("Nachdem ich mich gerade von der Reisekrankheit erholt habe, brenne es in mir, es auszuprobieren, doch Raphael starrt mich böse an.")
	await novel_interface.show_text_only("Als mir klar wurde, dass ich mich vielleicht dumm verhalte, mache ich sofort Schluss mit einem verlegenen Blick. Aber sie wandte ihr Gesicht verächtlich dem Beobachtungsfenster zu.")
	await novel_interface.show_text_only("Was zum Teufel kann sie in der Dunkelheit sehen?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Warum starrst du mich an?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Dieb schreit Dieb, oder?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ugh... Ich hätte nie gedacht, dass Salmonton Sie hierher schicken würde.", "Lian")
	await novel_interface.show_dialog("Schließlich ist das heutige Experiment ziemlich gefährlich.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noch wichtiger ist, dass ich weiß, dass es sich bei diesem Experiment um eine Inszenierung mit zwei Drehbüchern handelt.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Wissen Sie wirklich, worauf Sie sich einlassen, Mylady?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hilflos wende ich mich Mariru zu.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Oberflächlich betrachtet handelt es sich um ein gemeinsames Forschungsprojekt von New Opulentia und Salmonton.", "Mariru")
	await novel_interface.show_dialog("Ziel ist es, die Ursachen des Raumzeitflusses und Gegenmaßnahmen zu identifizieren.", "Mariru")
	await novel_interface.show_dialog("Beide Seiten müssen eine qualifizierte und vertrauenswürdige Person als menschliches Subjekt entsenden.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Nachdem Ihr Unsinn an diesem Abend im Sky Hotel Ihre Identität enthüllt hat, sind Sie definitiv die beste Wahl für New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru wirft mir einen Blick zu, der mir einen Schauer über den Rücken jagt.")
	await novel_interface.show_text_only("Komm schon, ich habe meine Lektion gelernt...")
	novel_interface.character_light()
	await novel_interface.show_dialog("Was Raphael betrifft, unsere „hochgeborene, zum Bürger gewordene“ Bewohnerin von Gosakuragawa, so meldete sie sich freiwillig, im Namen von Salmonton an dem Experiment teilzunehmen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Freiwilligenarbeit?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, die Lapissäule ist für Salmonton sehr wichtig. Ich würde niemals zulassen, dass du Verlierer das vermasselst.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Raphael ist in der Lage, die Selbstheilung auf Zellebene zu beschleunigen. Dies wurde von Aya bestätigt.", "Mariru")
	await novel_interface.show_dialog("Aber laut Beatrice sollte Raphael besser mit Ren zusammenarbeiten, um ihr Talent voll zur Geltung zu bringen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich fällt mir ein, dass Raphael auf dem Parkplatz des Sky Hotels Annie im Handumdrehen geheilt hat.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Raphael ist also auf unserer Seite, oder?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, ich kann mir deinen erbärmlichen Blick vorstellen, wenn du um dein Leben kämpfst. „Owww… ich sterbe… Heile mich jetzt…“", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Klingt, als könnten Sie es kaum erwarten, dass das passiert?!", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Moment, ich dachte, es sei ein geheimes Experiment. \\nWoher wusste sie das?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ich habe Dr. Dekkers alles klar gemacht.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Da er miterlebte, wie Sie Beatrice wieder zum Leben erweckten, hatte er das Gefühl, dass seine bisherige Zusammenarbeit mit dem Senat in die falsche Richtung ging.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Hat das etwas mit Religion zu tun?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("So einfach ist es wahrscheinlich nicht... Aber jetzt ist Salmonton bereit, mit SID zusammenzuarbeiten, solange Raphael bei uns in Sicherheit ist.", "Mariru")
	await novel_interface.show_dialog("Der Senat weiß nichts über Ihre wahren Fähigkeiten. Das ist die Stärke, die wir voll ausschöpfen sollten.", "Mariru")
	await novel_interface.show_dialog("Eine Hexe löst nichts aus, wenn sie einen Hexensplitter berührt. Deshalb kann unser Plan funktionieren.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Deshalb möchte ich den Führern beider Seiten wirklich dafür danken, dass sie dies möglich gemacht haben.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Sind Sie sicher, dass sich mein skurriler Opa da nicht reinlegen lässt?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Dein Großvater ist nicht so naiv, Schatz. Das Relikt hier ist keineswegs seine zufällige Wahl.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("All dies haben wir getan, um sicherzustellen, dass das „echte Experiment“ erfolgreich durchgeführt werden kann.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, wenn da nicht die Bestellung meines Großvaters gewesen wäre...", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael murmelte etwas vage, sein Blick huschte leicht über mich hinweg.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Ich würde niemals zustimmen, mit diesem perversen Transvestiten zusammenzuarbeiten!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Aber Dr. Dekkers sagt immer, dass Sie derjenige sind, der nie zuhört.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Lassen Sie mich raten... Salmonton ist tatsächlich an Heinrich interessiert, dem ursprünglichen Besitzer der Lapissäule?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Viel Glück, Ren!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Senat plant, mit Salmonton zusammenzuarbeiten, um mehr Hexen hinter dem Rücken von SID hervorzubringen. Und dieses Mal wollen sie prüfen, ob es machbar ist, mich als Stabilisator einzusetzen.")
	await novel_interface.show_text_only("Salmonton hat jedoch einen geheimen Abkommen mit Mariru abgeschlossen.")
	await novel_interface.show_text_only("Was Mariru angeht, ließ sie den Senat über unsere wahren Fähigkeiten im Dunkeln.")
	await novel_interface.show_text_only("Es wird kompliziert. Das bringt mich um …")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Können wir wirklich Seite an Seite kämpfen?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich werfe einen verstohlenen Blick auf die herrische Dame vor mir.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Raphael nach Gosakuragawa verlegen…) \\n(Ist das auch Teil ihres Plans?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Sehen Sie sich dieses dumme Gesicht an. Sie muss wieder etwas Dummes denken.)", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mit einem klopfenden Geräusch kommt der Aufzug schließlich zum Stehen. \\nEin 35 Fuß hohes Metalltor ragt vor uns auf.")
	await novel_interface.show_text_only("Ein roter Laserstrahl streicht von Kopf bis Fuß über meinen Körper. \\nBald ertönt ein Bestätigungston vom Tor.")
	await novel_interface.show_text_only("Mariru geht weiter für einen weiteren Iris-Scan.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Sie mögen altmodisch sein, aber die Sicherheitsmaßnahmen sind hier ziemlich streng...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Als wir mit dem Scannen fertig sind, senkt sich das riesige Tor langsam und lässt uns von dem erstaunlichen Raum hinter der Tür staunen.")
	await novel_interface.show_text_only("Der riesige unterirdische Raum wird von zwei Reihen stattlicher Betonpfeiler getragen.")
	await novel_interface.show_text_only("Die Basis jeder Säule ist mit Stapeln von Rüstungssplittern bedeckt, die in beide Richtungen verwendet werden können.")
	await novel_interface.show_text_only("Nach außen gerichtet können diese Scherben die Struktur vor verheerenden Raketenangriffen schützen. Wenn sie jedoch in die entgegengesetzte Richtung eingesetzt werden, können sie die Säulen auf einmal zerstören.")
	await novel_interface.show_text_only("Während des Siebenjährigen Krieges wurden diese Rüstungssplitter häufig in Festungen verwendet, die entweder blockiert oder zerstört werden mussten.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hier ist es ziemlich feucht...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Boden ist voller Wasserflecken. Hoch oben sind Dutzende neuer Rohre an der Decke montiert, aus denen Geräusche von durchströmender Flüssigkeit entstehen.")
	await novel_interface.show_text_only("Mariru muss eine Menge Mühe investiert haben, um diesen Ort umzugestalten.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Tief am Ende des Ganges stehen wir vor einem von Metallplatten umschlossenen Raum.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Meine Damen.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Willkommen in der Ark-Basis.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich... ich kann meinen Augen einfach nicht trauen!")
	await novel_interface.show_text_only("Was vor uns liegt, ist ein Stausee. Wenn ich den Nebel beobachte, der aus dem glitzernden Wasser aufsteigt, kommt es mir vor, als stünde ich auf einem Kai.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Schauen Sie einfach zu – die Einstiegsleiter ist auf dem Weg zu uns.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
