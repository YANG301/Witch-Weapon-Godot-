# bathophobia_ep09.gd - 深海恐惧篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep09_script()

func play_script():
	pass

func bathophobia_ep09_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/liliu_observation.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Standing at the control station atop the bank opposite to the platform, Mariru can see us on the first floor and the Senators' observation room.")
	await novel_interface.show_text_only("Three deep, low warnings come from the hall, indicating Mariru's readiness.")
	await novel_interface.show_text_only("Raphael waves at Mariru. Annie and I vigilantly stand next to her.")
	await novel_interface.show_dialog("Project Ark, experiment number one.", "Mariru")
	await novel_interface.show_dialog("The shield will be deactivated in ten seconds.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("On the base of the operation desk appears a countdown with red numbers.")
	await novel_interface.show_text_only("The sluice is shut, and the steps retract into the wall.")
	await novel_interface.show_text_only("Sounds of gears grinding come from the top of the hall, and the automatic array of weapons hidden in the ceiling are aimed at the desk, ready to shoot at any moment.")
	await novel_interface.show_text_only("I, like a fish in the deep ocean, stand in the middle of darkness.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("I feel like a condemned criminal…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With so many weapons pointing at me, I feel extremely tense.")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Relax, Ren. I'll protect you!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie seems nervous, too… Her fingers press on the baseball bat so hard that the nails become pale, but she’s comforting me still.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, coward.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The moment the timer counts down to zero, Raphael swiftly pulls the lever.")
	await novel_interface.show_text_only("The transparent shield circling the platform rapidly shrinks towards the bottom before it disappears.")
	await novel_interface.show_text_only("As the Lapis Pillar is slightly lifted, a stronger feeling strikes me.")
	await novel_interface.show_text_only("I feel like my blood starts to boil, and suddenly have an inexplicable impulse.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Ouch… My tummy hurts more…)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(If I ask for a bathroom break, they probably wanna kill me…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/bedstand.png")
	await novel_interface.show_text_only("The space above suddenly trembles, and a beam of light quickly sweeps over our heads and races to the end of the hall.")
	await novel_interface.show_text_only("Then, two short buzzes strike my chest, signaling that the fake system is initiated.")
	await novel_interface.show_text_only("The layer of optical camouflage high in the hall and the specially treated glass of the observation room ensure that no sound is leaked to Senators.")
	await novel_interface.show_text_only("In their eyes, Raphael, Annie and I should be instantly gone together with the Lapis Pillar.")
	await novel_interface.show_text_only("After that, they'll see the images we faked.")
	await novel_interface.show_text_only("The show is on. Right at the center of the stage, I have no other way out.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Have to brave it out…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I step forward and carefully reach out my hand.")
	await novel_interface.show_text_only("As my hand approaches the pillar, I nervously close my eyes and hold my breath \\nUntil my fingertips touch the pillar.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("… ?")
	await novel_interface.show_text_only("I slowly open my eyes.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Looks like… nothing happened.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I place my entire palm on the pillar. It feels like marble.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Hm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I try another angle, and give it a hard push \\nThe pillar, weighing over fifteen thousand pounds, remains motionless.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Tsk!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael pours scorn on me.")
	await novel_interface.show_text_only("That nothing happens has been the result I want the most among all the assumptions we made during the prep meeting—")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(But why… am I feeling a bit embarrassed…)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("While my hand is still on the pillar, the atmosphere is awkward. Just as I'm thinking to press it harder, my heart suddenly twitches sharply.")
	await novel_interface.show_text_only("Almost at the same time, the pillar trembles.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Then, the pillar eases away from my hand, leaving a small gap that’s slowly widening.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("—Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The high platform and the bottom of the pillar are grinding, making deep, low noises…")
	await novel_interface.show_text_only("Salmonton's national treasure, an artifact symbolizing the enlightenment of human beings during the Renaissance—The Tesheim Lapis Pillar…")
	await novel_interface.show_text_only("… is slowly collapsing towards the direction I'm pressing…")
	await novel_interface.show_text_only("And it's falling faster and faster.")
	await novel_interface.show_text_only("Boom——!!!")
	await novel_interface.show_text_only("The enormous bang comes as the pillar clashes with the metal platform and breaks into two pieces. The farther piece even slides a few inches forward.") #缩减符号
	await novel_interface.show_text_only("Small fragments scatter around, and the farthest piece even rolls into the pool in front.")
	await novel_interface.show_text_only("There is a long silence…")
	await novel_interface.show_text_only("For quite some time, even Raphael has lost her usual arrogance, looking extremely shocked.")
	await novel_interface.show_text_only("She then slowly turns to me.")
	await novel_interface.show_text_only("I can see fire burning in her eyes.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("No, I… I didn't…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_flare.png")
	await novel_interface.show_text_only("When I struggle to think of ways to save my own butt, the sound of a wind chime comes from nowhere.")
	await novel_interface.show_text_only("The fragments lying on the floor split into even smaller pieces, and start drifting like sheets of paper blown away by a gust of wind.")
	await novel_interface.show_text_only("Reflecting colorful arcs of light, the pillar fragments form several rings and float upward.")
	await novel_interface.show_text_only("Finally, all the broken pieces dissipate into the air, leaving numerous floating rings of light that illuminate the entire hall.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Wow…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I can't help touching a ring formed by small fragments—")
	await novel_interface.show_text_only("The ring immediately breaks into golden dots of light.")
	await novel_interface.show_text_only("The floating dots scatter like dust.")
	await novel_interface.show_text_only("Then, they concentrate and create an increasingly dazzling light…")
	await novel_interface.show_text_only("From the eye-hurting brightness, a golden-hair teenage girl appears in front of me.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("… !!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_text_only("With arms wide open, she stands calmly in front of me… But I just can't move my eyes away from this glamorous scene.")
	await novel_interface.show_text_only("There is a faint scent of orange blossom and violet in the air.")
	await novel_interface.show_text_only("The girl slowly opens her eyes.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("What an intriguing, fabulous \"result\"…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("She looks around.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Is this… modern time!?", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("In her eyes, increasing excitement is replacing the blank confusion.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Water and carbon, sodium chloride and sulphur, silicon and iron…", "Blond Girl")
	await novel_interface.show_dialog("They have created such a beautiful…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("She looks incredulously at her trembling hands.")
	novel_interface.character_light()
	await novel_interface.show_dialog("The touch of the body…", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl slowly feels her body from top to bottom.")
	await novel_interface.show_text_only("I suddenly realize I shouldn't look, so I immediately turn away.")
	await novel_interface.show_text_only("But I can't help stealing a glance at her…")
	await novel_interface.show_text_only("She… is even touching her… her…!!")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Even this… is recreated?", "Blond Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("… The light was so strong that I saw nothing!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We have all kinds of emergency plans, but for a while, none of the three of us knows what to do next.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("So…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The blonde girl glanced at Anne and Raphael, who were still tense, and her eyes fell on me, who looked dull.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Did you make this miracle happen?", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl slowly lands on the floor, and takes a step back respectfully.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("… Eh? \\n(I don't know where to look!!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Or, did you make this container for my soul?", "Blond Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ha… Maybe… Yes?", "Lian")
	await novel_interface.show_text_only("Sorry, I just gave the pillar a teeny-weeny push!")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl puts her hand over her chest and bows slightly to me.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("So, if you like…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("She gazes up into my eyes. \\nI read strong desire in her blue eyes.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Please bestow all your essence on me…", "Blond Girl")
	await novel_interface.show_dialog("Master.", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Master?", "Raphael & Annie")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eeeeessence?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stop—!")
	await novel_interface.show_text_only("Stop the weird imagination!!!")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("“Alchemy, the search for wisdom of elements and life.”", "Blond Girl")
	await novel_interface.show_dialog("The man able to rebuild a body and summon a soul must hold the truth I do not possess.", "Blond Girl")
	await novel_interface.show_dialog("I… Henriette Kunhardt, am ready to be a servant of truth…", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich suddenly stops, and solemnly gazes at an open space in the hall.")
	await novel_interface.show_text_only("Following her glance, I see nothing but pillars.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Wait. Did she say something about s…servant?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl sighs.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Found so quickly.", "Henriette")
	await novel_interface.show_dialog("Even with a new body, I'm still bound by the contract…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She’s barely finished speaking when the hall suddenly starts distorting heavily.")
	await novel_interface.show_text_only("Sensors in the shielded case send out threshold alarms all at once, and the status indicators immediately turn red.")
	await novel_interface.show_text_only("A deafening sound of glass cracking comes from above.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Shoot… A Spacetime Flux…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Behind Heinrich appears a mirror, which is rotating counterclockwise, looking like waves.")
	await novel_interface.show_text_only("The girl falls back, and gradually submerges into the void.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ren, run!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But it's too late—")
	novel_interface.change_background("res://assets/images/bg/Baizhu/spaceTransfer.png")
	await novel_interface.show_text_only("The space surrounding us is distorted and rotates along numerous mirror surfaces.")
	await novel_interface.show_text_only("—Then I'm overwhelmed by the feeling of weightlessness.")
	await novel_interface.show_text_only("When I finally come to myself, I realize we have been falling.")
	await novel_interface.show_dialog("Aaaah—!!", "Lian")
	await novel_interface.show_text_only("The only thing I remember before I pass out is…")
	await novel_interface.show_text_only("My butt feels chilly in the wind and my stomach hurts more!")
	await novel_interface.show_text_only("This is…")
	await novel_interface.show_text_only("The worst day ever!!!")
	
	print("=== 深海恐惧篇第9话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
