# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("¿Qué es el alma?")
	await novel_interface.show_text_only("¿Una forma de energía que preserva la conciencia? ¿O un estado cuántico inobservable?")
	await novel_interface.show_text_only("O simplemente un concepto...")
	await novel_interface.show_text_only("Al igual que el concepto de tiempo en física:")
	await novel_interface.show_text_only("Tal vez sea sólo una ilusión... un sueño.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Entonces la pregunta es—")
	await novel_interface.show_text_only("¿Quién es el soñador?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("El frío cortante en la Convergencia Antártica aísla todo el ruido del mundo exterior.")
	await novel_interface.show_text_only("A 20.000 pies bajo el nivel del mar se encuentra la zona abisal.")
	await novel_interface.show_text_only("Envuelto en un casco de presión de titanio, un submarino de aguas profundas desciende lentamente.")
	await novel_interface.show_text_only("La tenue luz emitida por su indicador de estado rápidamente se ve envuelta en la abismal oscuridad.")
	await novel_interface.show_text_only("Sin luz, no puede percibir el espacio.")
	await novel_interface.show_text_only("Un espeluznante diente de colmillo intenta golpear el casco, pero no recibe respuesta.")
	await novel_interface.show_text_only("La presión del agua de 60 MPa pone a prueba el límite de tensión de compresión del casco.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("De repente, ocho reflectores preprogramados se encienden simultáneamente, proyectando ocho rayos de luz rectos y estrechos.") #换行问题
	await novel_interface.show_text_only("Como espadas afiladas, los reflectores estallan en un resplandor deslumbrante y atraviesan la oscuridad.")
	await novel_interface.show_text_only("Un rayo de luz atraviesa los gruesos cristales de la sala de control y cae sobre el rostro de una niña dormida.")
	await novel_interface.show_text_only("Su largo cabello gris oscuro, brillando con brillo azul, se esparce sobre su rostro pálido pero puro.")
	await novel_interface.show_text_only("El medidor de profundidad en el tablero frente a la niña deja de funcionar a 4091 pies.")
	await novel_interface.show_text_only("Los reflectores fuera de la habitación se apagan gradualmente. Pero un tenue brillo plateado comienza a parpadear alrededor del cuerpo de la niña.")
	await novel_interface.show_text_only("Desde las profundidades del océano tan temido por los humanos, llega una voz profunda y distante.")
	await novel_interface.show_text_only("Como la llamada de un monstruo antiguo.")
	await novel_interface.show_text_only("La niña dormida parece despertar del vientre de su madre.")
	await novel_interface.show_text_only("También se despiertan los incontrolables mareos y náuseas…")
	await novel_interface.show_text_only("Muy por debajo de la profundidad de seguridad de 15.000 pies, el casco metálico comienza a emitir un crujido anormal.")
	await novel_interface.show_text_only("Una tos reprimida sale de la garganta de la chica.")
	await novel_interface.show_text_only("Al principio tiene algunas dificultades para respirar, pero rápidamente se adapta a la presión bajo el agua y estabiliza su respiración.")
	await novel_interface.show_dialog("La colisión de hace un momento... Parece haberme dejado inconsciente.", "Girl")
	await novel_interface.show_dialog("Pero todavía puedo respirar... Debe haber suficiente oxígeno.", "Girl")
	await novel_interface.show_dialog("Puedo ver mi respiración... \\nCerca de 32 °F, efectivamente...", "Girl")
	await novel_interface.show_dialog("Comprobación del sistema. Listo para un arranque en frío. \\nInformación de identificación: Beth.", "Girl")
	await novel_interface.show_text_only("La niña llamada Beth no parece preocuparse por la temperatura gélida. Ella revisa el sistema con atención.")
	await novel_interface.show_text_only("Nació con la capacidad de soportar un frío extremo. Cuando encontraron a la bebé Beth en las montañas invernales, ya había pasado una noche entera sobre el hielo.")
	await novel_interface.show_text_only("Varios exámenes físicos han demostrado que la milagrosa niña puede adaptarse a diversos ambientes fríos.")
	await novel_interface.show_text_only("Bajo el intenso frío que podría dejar inconsciente a un adulto en 30 segundos, su temperatura corporal sigue siendo normal y sus manos están calientes.")
	await novel_interface.show_text_only("Los médicos no pudieron descubrir por qué antes de que su padre adoptivo la sacara del orfanato.")
	await novel_interface.show_dialog("Sistemas de iluminación y propulsión... arranque normal. Reinicio de sensores... todo bien.", "Beth")
	await novel_interface.show_dialog("¿Ya tiene 20.000 pies de profundidad? \"Esa cosa\" no puede existir bajo una presión de agua tan alta.", "Beth")
	await novel_interface.show_dialog("Tengo que ahorrar energía para el viaje de regreso... Reflectores apagados...", "Beth")
	await novel_interface.show_text_only("Justo cuando los reflectores se apagan, Beth mira por la ventana.")
	await novel_interface.show_dialog("¿Qué…?", "Beth")
	await novel_interface.show_text_only("Una escena espeluznante le pone los pelos de punta.")
	await novel_interface.show_dialog("¿Qué es... eso...?", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Justo antes de que se apagaran los reflectores, una gigantesca estructura parecida a un coral aparece fuera de la ventana de observación.")
	await novel_interface.show_text_only("Es una estructura centrípeta similar a un tejido. En él, los vasos irregulares parecen una cascada escarlata que cae en un enorme agujero negro.")
	await novel_interface.show_text_only("Pero durante el escaneo de ahora no se ha encontrado ninguna estructura biológica o topográfica.")
	await novel_interface.show_text_only("Beth inmediatamente enciende la lente gran angular del casco, tratando de tener una visión más amplia.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("En la pantalla hay una sombra enorme y brumosa. Se extiende por más de 300 pies y tiene tentáculos.")
	await novel_interface.show_dialog("Esto no puede ser…", "Beth")
	await novel_interface.show_text_only("No es parte del paisaje, pero seguro es algún tipo de criatura. Motas rojas de luz brillan en la oscuridad.")
	await novel_interface.show_dialog("¿Eso es... un globo ocular?", "Beth")
	await novel_interface.show_text_only("—Si a esa cosa rara se le puede llamar \"globo ocular\".")
	await novel_interface.show_text_only("El agujero negro que mira hacia la ventana es la pupila del globo ocular.")
	await novel_interface.show_text_only("Está demasiado cerca para determinar la distancia. Parece probable que el casco sea absorbido por la pupila en cualquier momento.")
	await novel_interface.show_text_only("Las motas rojas se desvanecen. La niña ahora se enfrenta al objeto desconocido en la silenciosa oscuridad.")
	await novel_interface.show_text_only("Cuando sus ojos se adaptan a la oscuridad, ve en la pantalla el enorme globo ocular que emite una tenue luz roja, como si fuera una medusa opaca.")
	await novel_interface.show_text_only("El globo ocular está lleno de bultos de tejidos retorcidos. \\nEstá latiendo junto con su corazón.")
	await novel_interface.show_dialog("(¡Relájate… relájate!) \\n(Piénsalo…)", "Beth")
	await novel_interface.show_text_only("Si se trata de un globo ocular, su cristalino debería ser sensible a la luz.")
	await novel_interface.show_text_only("En la capa exterior del globo ocular, donde debería existir la coroides, parpadean enjambres de manchas blancas.")
	await novel_interface.show_text_only("Beth nota que hay tentáculos en forma de ramas adheridos a la parte posterior del globo ocular.")
	await novel_interface.show_text_only("Los tentáculos de color gris oscuro se sumergen en las profundidades del océano, sin un final a la vista.")
	await novel_interface.show_dialog("(…no puedo… moverme…)", "Beth")
	await novel_interface.show_text_only("—Beth es más como ser observada por Esa Cosa, en lugar de enfrentarla.")
	await novel_interface.show_text_only("La mirada intrusiva erosiona su calma y la asusta.")
	await novel_interface.show_dialog("Ayuda…", "Beth")
	await novel_interface.show_text_only("—¿Se lo tragará todo?")
	await novel_interface.show_text_only("La extraña sensación de estar en las profundidades del océano le hace dudar de su propia existencia.")
	await novel_interface.show_dialog("(¿Es un sueño…?) \\n(Despierta, rápido…)", "Beth")
	await novel_interface.show_text_only("Su cuerpo reacciona por instinto antes de que su mente alcance a seguirlo.")
	await novel_interface.show_text_only("Mientras la niña tiraba del joystick con su mano izquierda, la cámara de buceo continuó moviéndose una cierta distancia hacia el globo ocular.")
	await novel_interface.show_text_only("El agua se pone turbulenta como si esa cosa estuviera siendo perturbada.")
	await novel_interface.show_text_only("La pupila se contrae, esperando el próximo movimiento de la chica.")
	await novel_interface.show_dialog("¿Hola? ¿Hola?", "Beth")
	await novel_interface.show_text_only("Beth toma sus auriculares e intenta conectarse con el escritorio de control.")
	await novel_interface.show_text_only("Pero ninguna onda electromagnética puede escapar a esta profundidad y la comunicación acústica submarina no es viable por el momento.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Si ella estuviera allí... Me habría gritado: \\n\"¡Deja de acercarte más!\"")
	await novel_interface.show_dialog("Ja... ¿por qué habría de pensar en esto...?", "Beth")
	await novel_interface.show_dialog("¿Quién es... \"Ella\"?", "Beth")
	await novel_interface.show_dialog("¿Dónde… estoy…?", "Beth")
	await novel_interface.show_text_only("Beth, observada por el globo ocular gigante, está perdida y aturdida. La frontera entre realidad e ilusión se está borrando poco a poco.")
	await novel_interface.show_text_only("Pasa la mano por todo el tablero.")
	await novel_interface.show_text_only("Pronto localiza el controlador del brazo robótico.")
	await novel_interface.show_dialog("(¿Realmente tengo que...?)", "Beth")
	await novel_interface.show_text_only("Ella recupera el aliento, pero la luz ilusoria continúa brillando frente a sus ojos.")
	await novel_interface.show_dialog("Tome algunas muestras… Y luego retírelas de inmediato…", "Beth")
	await novel_interface.show_text_only("Primero, apunte los reflectores hacia el frente...")
	await novel_interface.show_text_only("Luego, configura el sistema de propulsión… velocidad máxima. Dirección… inversa.")
	await novel_interface.show_text_only("Luchando por terminar la preconfiguración, la niña está casi a punto de perder el conocimiento.")
	await novel_interface.show_dialog("Padre, esto es... contaminación espiritual... \\nEstoy casi...", "Beth")
	await novel_interface.show_text_only("Beth opera el manipulador lentamente para liberar el brazo robótico. Se revela una enorme aguja.")
	await novel_interface.show_dialog("Modo de succión activado... Bajo tal presión, una aspiración rápida será suficiente...", "Beth")
	await novel_interface.show_text_only("El brazo del robot se estira hacia adelante hasta que la aguja se inserta en el vítreo.")
	await novel_interface.show_text_only("El nivel de concentración del contenedor salta de 0 a 100% en un instante.") #标点删除
	await novel_interface.show_text_only("Por un momento, la pupila queda distorsionada. Si el sonido pudo penetrar el casco, debió haber escuchado un grito áspero...")
	await novel_interface.show_dialog("(Estoy escuchando cosas…)", "Beth")
	await novel_interface.show_text_only("En su último esfuerzo, la niña presiona el botón de ejecución programado.")
	await novel_interface.show_text_only("Según el programa preestablecido, los reflectores proyectan ocho intensos rayos de luz en la pupila y la hélice comienza a girar salvajemente.")
	await novel_interface.show_text_only("El globo ocular retrocede ante el estímulo de la luz y el casco comienza a retroceder y elevarse...")
	await novel_interface.show_text_only("Totalmente exhausta, la niña se desmaya y cae al suelo.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
