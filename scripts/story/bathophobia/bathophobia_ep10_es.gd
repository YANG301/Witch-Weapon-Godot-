# bathophobia_ep10.gd - 深海恐惧篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep10_script()

func play_script():
	pass

func bathophobia_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("El submarino de propulsión alternativa SS Deepsea acecha en las aguas profundas de la Antártida.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	await novel_interface.show_text_only("Una chica con un vestido blanco está parada frente a la Sala de Control Central.")
	await novel_interface.show_dialog("Se requiere identificación de visitante:", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Registro, Beth.", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La niña parece un poco cansada, pero se mantiene erguida y su largo cabello mojado cae libremente sobre su espalda.")
	await novel_interface.show_text_only("Ella está ahí, confiada, segura y orgullosa.")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Confirme el token de seguridad.", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Keshi0415-Z.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Iniciando sesión... Modo de escaneo activado.", "System")
	await novel_interface.show_text_only("Ocho rayos de luz, emitidos desde la pared del pasillo, comienzan a escanear a Beth.")
	await novel_interface.show_text_only("Al otro lado de la puerta protectora reforzada, un grupo de personas observa con entusiasmo a través de la ventana de observación.")
	await novel_interface.show_text_only("Entre ellos, una chica de cabello castaño es Silvia, la amiga de Beth.")
	await novel_interface.show_text_only("Pero ella prefiere que la llamen Milk, su nombre en clave.")
	await novel_interface.show_text_only("El rostro de Beth se suaviza cuando sus ojos se encuentran a través de la ventana.")
	await novel_interface.show_dialog("Escaneo completado. Código de acceso de seis dígitos, por favor—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth recuerda claramente que ese procedimiento de verificación no existía antes de que ella se fuera.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(... Ja, han manipulado el sistema de seguridad nuevamente.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como experta externa, Beth está acostumbrada a este tipo de pruebas traviesas.")
	await novel_interface.show_text_only("Es consultora del escuadrón formado por altos oficiales militares, pero no tiene ninguna experiencia real en batalla.")
	await novel_interface.show_text_only("Y como esta operación implica entornos extremos, el consultor también tiene poder temporal de toma de decisiones estratégicas.")
	await novel_interface.show_text_only("Es muy común que la cuestionen, a pesar de que es conocida como un genio en su campo profesional...")
	await novel_interface.show_text_only("Sólo podrá encajar si se demuestra a sí misma.")
	await novel_interface.show_text_only("Beth lo tiene muy claro.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Código de acceso digital... \\nHace mucho tiempo que no veo esto.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mirada de Bai Yan recorrió la leche detrás de la ventana de observación.")
	await novel_interface.show_text_only("Con las manos apretadas contra la ventana, Milk le hace muecas.")
	await novel_interface.show_text_only("Desde el ángulo de Beth, pudo ver a Milk mirando el plato fuera de la puerta protectora.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_text_only("¿Número de puerta…? \\nZ-100485.")
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("No es tan simple...", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ingresa los seis dígitos tal como están.")
	await novel_interface.show_text_only("Después de un largo zumbido, la puerta permanece cerrada.")
	await novel_interface.show_dialog("Código de acceso incorrecto. Primera advertencia", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("… Lo sabía.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A excepción de Milk, quizás todos los demás estén ansiosos por verla fracasar.")
	await novel_interface.show_text_only("Beth suspira ante la sonrisa de regodeo de Milk.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("¿Otro juego de códigos?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Detrás de la ventana de observación, el grupo de personas permanece allí, mirándola con un dejo de disfrute.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("¿Cuánto tiempo crees que tardará esta vez?", "Miembro del equipo A")
	await novel_interface.show_dialog("Hay un módulo especial para prevenir ataques de fuerza bruta. ¡Los programas de descifrado no funcionarán!", "Miembro del equipo C")
	await novel_interface.show_dialog("¡Ah, y Milk, no le des pistas!", "Miembro del equipo B")
	await novel_interface.show_text_only("Los dedos de Milk recorren su boca obedientemente.")
	await novel_interface.show_dialog("Entonces yo diría… 60 segundos.", "Miembro del equipo D")
	await novel_interface.show_dialog("Eso es demasiado rápido incluso para un genio... \\n¡Apuesto al menos diez minutos!", "Miembro del equipo C")
	await novel_interface.show_dialog("No menosprecies a Beth y a esta chica...", "Miembro del equipo A")
	await novel_interface.show_text_only("El miembro alto del escuadrón A frota la cabeza de Milk desde atrás.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("¡Vamos, todos habéis revisado el código modificado!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero si es Beth... definitivamente lo entendería...")
	await novel_interface.show_text_only("Ese es un pequeño secreto entre ellos.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Mmm—", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por el rabillo del ojo, Beth ve a Milk levantar la mano derecha y cruzar el pulgar y el índice para formar un corazón.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("Mmmm...", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esa fue la palabra clave cuando se conocieron.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("100485… \\nCorresponde a 124155.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bajo estrecha vigilancia, Beth ingresa la contraseña correcta en menos de 20 segundos.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("La puerta de la Sala de Control Central se abre lentamente. Beth se peina con los dedos y sonríe para sí misma.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("Jeje, sabía que puedes hacerlo...", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk se ríe mientras cobra dinero de quienes pierden la apuesta.")
	await novel_interface.show_dialog("Oye, ¡debes haberle dado alguna pista! \\n… ¡Hacer trampa no es bueno!", "Miembro del equipo D")
	await novel_interface.show_text_only("Milk se encoge de hombros y los mira inocentemente.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("No dije una palabra. Lo sabías.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Entonces, ¿cómo acertó?", "Miembro del equipo B")
	await novel_interface.show_dialog("Quizás nos hemos perdido algo...", "Miembro del equipo C")
	await novel_interface.show_text_only("Beth se aclara la garganta para interrumpir sus especulaciones y comienza a informar de inmediato.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Como hemos pensado, Esa Cosa existe en la zona abisal.", "Beth")
	await novel_interface.show_dialog("Lo miré de cerca hace unas horas. Y he recogido algunas muestras líquidas.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	novel_interface.show_character("milk_normal","shock")
	await novel_interface.show_dialog("¿Eh…?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todos se callan inmediatamente.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Esa Cosa es el objetivo de esta misión: una criatura antigua en las profundidades del océano.")
	await novel_interface.show_text_only("En algunas religiones, es el origen de toda la vida en la tierra.")
	await novel_interface.show_text_only("La gente aún no ha descubierto si se trata de una forma de vida simple o incluso si existe físicamente.")
	await novel_interface.show_text_only("Antes de que Beth partiera, la mayoría de los miembros del equipo pensaban que era sólo un mito como el monstruo del Lago Ness.")
	await novel_interface.show_text_only("Pero el informe de Beth hizo añicos sus esperanzas de concluir la misión y regresar a casa temprano.")
	await novel_interface.show_text_only("En el Océano Austral, en las aguas profundas del mar, entre 4.000 y 6.000 metros bajo el hielo de la Princesa Isabel...")#文字删除
	await novel_interface.show_text_only("Hay una criatura misteriosa que podría haber existido mucho antes de que existieran los humanos... y ha sobrevivido hasta el día de hoy.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sólo pensar en esto es suficiente para poner los pelos de punta.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("El sensor captó con éxito señales nerviosas eléctricas en las aguas circundantes, aunque sólo por un corto tiempo.", "Beth")
	await novel_interface.show_dialog("Al principio la forma de onda era plana. Pero luego la frecuencia se disparó repentinamente y se parecía más a las ondas beta que se encuentran en los cerebros humanos.", "Beth")
	await novel_interface.show_dialog("Aunque cientos de miles de veces más intenso...", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ante esto, Beth recuerda el terrible aturdimiento cuando fue observada por el gigantesco globo ocular hace unas horas.")
	novel_interface.show_character("milk_normal","solemn")
	await novel_interface.show_dialog("Suena como el estado en el que la gente se despierta con una pesadilla...", "Milk")
	await novel_interface.show_dialog("La guía de la misión ha mencionado ondas de radio anormales en el espacio aéreo antártico... Entonces no se trata de una falla del equipo.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Estás seguro? A esa profundidad, obtienes toneladas de presión en solo una superficie del tamaño de la palma de la mano...", "Miembro del equipo A")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Estoy seguro.", "Beth")
	await novel_interface.show_dialog("Tal como indicaron nuestras fuentes, tiene un cuerpo enorme que se extiende más que este submarino.", "Beth")
	await novel_interface.show_dialog("No tengo idea de por qué esta criatura gigantesca no queda aplastada bajo una presión de agua tan extrema.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vaya, ¿podría ser un mar profundo Substance H?", "Miembro del equipo D")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("No.", "Beth")
	await novel_interface.show_dialog("No es Substance H.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Para sorpresa de todos, Beth de repente habla con voz firme.")
	await novel_interface.show_text_only("Es conocida por ser meticulosa con sus declaraciones. Ella no sacaría ninguna conclusión sin pruebas concretas.")
	await novel_interface.show_text_only("¿Qué la hace estar tan segura?")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Quiero decir, hasta ahora, nadie ha encontrado ningún Substance H con conciencia...", "Beth")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Pero Esa Cosa sí tiene conciencia...", "Beth")
	await novel_interface.show_dialog("Y uno muy fuerte...", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bai Zhuchen frunció los labios, como si quisiera explicar, pero no podía expresarlo con palabras, pero su voz se hizo cada vez más pequeña.")
	await novel_interface.show_text_only("Su voz se desvanece y el silencio llena la habitación. Sólo se oyen respiraciones débiles.")
	await novel_interface.show_text_only("Es un instinto humano temer a lo desconocido.")
	novel_interface.show_character("milk_normal","laugh")
	await novel_interface.show_dialog("Bueno, entonces no es Substance H. ¡Beth siempre tiene razón!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk rompe el silencio con una risa halagadora. Todos los demás fuerzan una sonrisa.")
	await novel_interface.show_text_only("Solo Bai Yan seguía frunciendo el ceño y Milk suspiró, dio un paso adelante y abrazó su cintura.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Bueno, al menos has dado el primer paso. \\n¡No luzcas tan sombrío!", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Para mantener las muestras activas, debemos enviarlas a un laboratorio lo antes posible.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ignora el gesto de Milk y continúa hablando con el capitán.")
	await novel_interface.show_dialog("¿Y el de Buenos Aires?", "Miembro del equipo A")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("No tenemos suficiente tiempo. El ambiente de las profundidades marinas en nuestra cámara de muestreo actual solo puede durar cuatro horas más.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("El laboratorio calificado más cercano está al otro lado de la plataforma de hielo Amery. Primero necesito presentarme en la sede.", "Miembro del equipo A")
	await novel_interface.show_dialog("¿Qué? ¡Odio solicitar actividades para romper el hielo!", "Miembro del equipo B")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Creo que el rompehielos de Ushuaia es gratis este mes.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ushuaia…", "Miembro del equipo D")
	await novel_interface.show_text_only("Varios miembros del escuadrón intercambian miradas.")
	novel_interface.show_character("baizhu_normal","normal") 
	await novel_interface.show_dialog("Para ahorrar tiempo, también podemos instalar un laboratorio temporal en el rompehielos.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk de repente agarra a Beth por el brazo y la interrumpe.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("¿Por qué no simplemente dejarles actualizar a Boss con la información más reciente? ¡Guarda el papeleo para ellos también!", "Milk")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("—Nena, no seas tan seria. ¡Animar!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk se frota contra Beth aduladoramente.")
	
	print("=== 深海恐惧篇第10话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
