# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Стоя у трибуны, Mariru спокойно представляет подробный отчет о ходе последних исследований на очередной видеоконференции.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Что касается проекта Арк…", "Кирс")
	await novel_interface.show_dialog("Из списка реликвий, предоставленного Salmonton, вы выбрали Тесхаймский столп из ляписа, верно?", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Да, сэр. Теперь ключевой момент заключается в том, как создать контролируемую область потока.", "Mariru")
	await novel_interface.show_dialog("Все недавние случаи Пространственно-временных потоков во всех академических городах были вызваны контактом человека с предметами, имеющими свойства Substance H.", "Mariru")
	await novel_interface.show_dialog("Эти предметы долгое время оставались бездействующими, но были активированы почти в одно и то же время.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Точнее, «Осколок ведьмы» и «Фрагменты гримуара». Но я лучше объясню это непрофессионалом.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Вы имеете в виду тот день, когда исчез Кубок Росса…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Мы пока не можем подтвердить их связь.", "Mariru")
	await novel_interface.show_dialog("Поскольку неконтролируемых факторов слишком много, нам приходится фильтровать все реликвии по двум критериям.", "Mariru")
	await novel_interface.show_dialog("Во-первых, это должно быть вещество с низкой активностью, проявляющее свойства Substance H по данным цветового сканирования.", "Mariru")
	await novel_interface.show_dialog("Во-вторых, первоначальный владелец прослеживается в исторических записях, и этот человек не должен иметь склонности к насилию или совершению преступных действий.", "Mariru")
	await novel_interface.show_dialog("Столб из ляписа Тесхайма первоначально принадлежал Генриху Кунрату, врачу и алхимику эпохи Возрождения.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Низкая активность... Как жаль... Я ожидал, что на этот раз мы сможем собрать данные ближе к критическому значению.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Образец слишком ценен, чтобы его терять. Лучше оставаться на безопасной стороне.", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Мне просто нужно доказать способность Рена проходить через области потока. Для этого нам просто нужно разыграть игру.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(На самом деле, Тесхеймский Ляписовый Столб не является Ведьминым Осколок) \\n(Это просто квази Substance H с магическими надписями на нем.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Прикасаться к осколку ведьмы слишком опасно для обычных людей.) \\n(В конце концов, я не человек-горилла…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("С экрана доносится взрыв смеха.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Алхимик… Пионер науки, да? \\nКакой интересный выбор.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Я слышал, что это произведение искусства имеет огромное историческое значение, а владелец Генрих был одним из основателей Розенкрейца…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Розенкрейц был просто религиозной и оккультной группой. Это не имеет ничего общего с нынешним разведывательным агентством Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Я думаю, алхимиков можно рассматривать как учёных той эпохи. Будем надеяться, что он был человеком, трепещущим перед неизведанным.", "Mariru")
	await novel_interface.show_dialog("Но вы хорошо знаете доктора Dekkers. Он никогда бы не одолжил нам такую важную реликвию бесплатно, если бы…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Странная тишина наполняет комнату.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Это верно. Сторона Salmonton хочет поделиться данными и иметь представителя в нашей команде.", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Итак, они не отказались от создания новых ведьм…) \\n(Хотят ли они использовать Рена в качестве стабилизатора?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Хорошо подмечено. Я просто хочу подтвердить, что все, включая сторону Salmonton, понимают опасность этого эксперимента.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Утвердительно. Мы превратили огромные подземные дренажные сооружения старой столицы в базу «Ковчег» на случай худшего сценария.", "Кирс")
	await novel_interface.show_dialog("Сверхскоростная система проникновения морской воды может затопить всю базу за 30 секунд.", "Кирс")
	await novel_interface.show_dialog("Если во время эксперимента что-то пойдет не так…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("В таком случае, я надеюсь, что нашему дорогому Mariru хватит смелости запустить устройство аварийного самоуничтожения.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
