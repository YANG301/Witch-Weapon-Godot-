# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Le séisme au pôle Sud ne dure pas longtemps. La couche vide située sous la station de ravitaillement, établie par mesure de précaution contre les blizzards, atténue efficacement les dégâts provoqués par les secousses.")
	await novel_interface.show_text_only("En moins d’une minute, le terrain retrouve son calme antérieur.")
	await novel_interface.show_text_only("J’ai grandi aux frontières du Aegis – un tremblement de terre de cette ampleur ne me dérange pas du tout.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Juste un petit tremblement de terre. Tout le monde va bien ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ouais... mais pourquoi maintenir ta jupe a-t-il été ta première réaction ?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Par exemple, êtes-vous sûr que cela devrait être votre priorité en cas de tremblement de terre ?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh, eh bien... \\nC'est juste...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Oh, allez, donne-moi une pause !")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("C’est quand même étrange. L’Antarctique est un continent recouvert de couches de glace épaisse. Ce n’est certainement pas une zone sujette aux tremblements de terre.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l fronça les sourcils et regarda par la fenêtre.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ou est-ce que je m'en souviens mal ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Donc la Neuvième Sephira a finalement causé un problème, hein...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Ren, regarde !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie crie soudainement, en désignant l'extérieur de la fenêtre. Je me rapproche pour jeter un œil.")
	await novel_interface.show_text_only("Une gigantesque fissure est apparue sur la couche plate de glace. Sous le ciel de velours, on dirait presque un abîme qui mène tout droit à l’enfer.")
	await novel_interface.show_text_only("Dans un sens, c'est moins une fissure qu'un canyon...")
	await novel_interface.show_text_only("Au bord de la brèche, quelques pointes acérées se dressent. Des structures anormales en forme de filet sortent des profondeurs de l’épaisse couche de glace.")
	await novel_interface.show_text_only("Les falaises de glace de chaque côté semblent rester à peu près à la même hauteur. C’est comme si une force inimaginable avait déchiré toute la grille à glace.")
	await novel_interface.show_text_only("La gigantesque fissure serpente vers les hautes terres, disparaissant de la vue...")
	await novel_interface.show_text_only("Heureusement nous sommes ici dans la vallée. Nous sommes en sécurité ici.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Hé, qu'est-ce que c'est ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l et Henriette se rapprochent pour regarder ce que je montre du doigt. Ils haletent tous les deux.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Ce bâtiment... pourquoi n’est-il pas affecté ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sur les plaines de glace juste devant nous, une énorme structure artificielle se dresse juste sur le chemin de la fissure qui s'étend, sans aucune inquiétude.")
	await novel_interface.show_text_only("Ses murs sombres semblent déplacés dans ce pays pâle et blanc.")
	await novel_interface.show_text_only("Au lieu de déchirer le bâtiment comme il aurait dû le faire, la fissure l’a contourné sous la forme de deux arcs, comme s’il y avait quelque chose dans la structure qu’il ne voulait pas perturber.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Est-ce le point de rendez-vous Mariru que je viens de mentionner ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Il semble que ce soit le bon endroit.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Des crépitements statiques peuvent être entendus depuis le panneau de commande. Il semble que la station de ravitaillement rétablisse la connexion avec le monde extérieur.")
	await novel_interface.show_dialog("Bonjour ? Ren ? Pouvez-vous m'entendre?", "Mariru")
	await novel_interface.show_text_only("Mariru semble plutôt nerveux.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Avant que le groupe de satellites de reconnaissance que nous avons appelé n’ait fini de changer de piste, le flux graphique de l’Antarctique ne peut être actualisé qu’une fois toutes les trente-cinq minutes sous forme statique.")
	await novel_interface.show_text_only("Sur l'écran, des messages contenant des informations que Mariru a recueillies auprès des principales stations polaires continuent d'apparaître.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Quelque chose ne va pas. Ce tremblement de terre... ce n’est pas normal.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Étrange, je n'arrive toujours pas à recevoir de signal des gars de la base de Snedronningen...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru plisse les yeux devant le dernier rapport mis à jour du capteur météo de la base de Nuremberg.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Attends, c'est...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tape frénétiquement sur son appareil portatif, appelant toutes les données de surveillance météorologique et hydrologique en temps réel en Antarctique qu'elle peut trouver.")
	await novel_interface.show_text_only("Il est facile de constater que les chiffres évoluent – rapidement et de manière constante. Elle se souvient soudain d'un cours qu'elle a suivi à l'université...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Dis-moi, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Hum ?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Même sans tenir compte de l'impact des armes nucléaires et des corps étrangers, de nombreux facteurs naturels se cachent encore sur terre et peuvent provoquer « la fin du monde ».", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Bien sûr. En fait, les humains ne sont apparus qu’après la cinquième extinction massive sur Terre. Les facteurs naturels peuvent en effet être mortels.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("Et quand il s’agit de l’élément naturel le plus dangereux que l’on puisse trouver en Antarctique...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Bon sang... c'est du méthane !", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, es-tu sûr que la fissure est près de chez toi ?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ouais. Mais ce qui est bizarre c'est que...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai rapporté l'information à Lililiu selon laquelle la faille semblait contourner délibérément la base de la Reine Blanche.")
	await novel_interface.show_text_only("Mariru réfléchit un peu à ces informations. Lorsqu’elle parle ensuite, son ton est vif et pragmatique.")
	await novel_interface.show_dialog("Écoutez, il est probable que le méthane qui a été enfermé sous terre pendant des millions d’années s’échappe actuellement de la faille.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Attendez..., oui, je sais que des milliards de tonnes de méthane sont stockées sous terre ici, mais... ne sont-elles pas solides ? Comme de la glace inflammable ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ils se sont peut-être vaporisés en raison de la pression provoquée par la déchirure de la banquise lors du tremblement de terre. Au moins, ceux qui étaient exposés l’avaient probablement fait.", "Ai")
	await novel_interface.show_dialog("Selon les capteurs de la base de Nuremberg, les niveaux de méthane au-dessus de l'Antarctique ont augmenté de 2,1 ppm par rapport à il y a une heure, avant le tremblement de terre.", "Mariru")
	await novel_interface.show_dialog("Les chiffres diffèrent selon les autres stations météorologiques, mais les résultats sont les mêmes : il y a une augmentation spectaculaire du niveau de méthane, quel que soit l’angle sous lequel on le regarde.", "Mariru")
	await novel_interface.show_dialog("La zone océanique proche de la banquise Amery a également montré des anomalies. Nous pensons que c’est parce que le méthane provenant du sous-marin a bouillonné, provoquant une perturbation des marées.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Si je me souviens bien, l'effet de serre provoqué par le méthane est vingt et un fois supérieur à celui du dioxyde de carbone...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Alors... ça va faire plus chaud ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fais de mon mieux pour me souvenir de ce que j'ai lu dans les brochures sur la préservation de l'environnement que nous avons reçues à l'école.")
	await novel_interface.show_dialog("Les marées montent déjà, tandis que la vitesse du vent diminue. La température augmentera... 0,2 degrés toutes les 12 heures. Et cela ne cessera de monter pendant un bon moment.", "Mariru")
	await novel_interface.show_dialog("Cela signifie que nos océans seront bientôt privés d’oxygène, ce qui bien sûr ruinera tout l’écosystème. La plupart des êtres vivants de notre planète seront purgés.", "Mariru")
	await novel_interface.show_text_only("Rapha?l semble enfin prendre conscience de la gravité de la situation.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Donc... dans deux semaines... toutes les plantes exposées se faneront...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Et dans trois semaines, la plupart des animaux seront menacés d’extinction. 90 % des humains n’auront pas d’eau potable. Même les satellites en orbite terrestre basse ne bougeront plus comme ils le devraient en raison du changement de notre atmosphère...", "Ai")
	await novel_interface.show_dialog("En quarante-cinq jours, seules quelques rares espèces (tous les insectes) survivront dans un tel environnement.", "Mariru")
	await novel_interface.show_dialog("Si nous ne faisons rien et vite, nous deviendrons bientôt de la nourriture pour ces insectes.", "Ai")
	await novel_interface.show_text_only("Je ne peux pas empêcher le frisson qui parcourt ma colonne vertébrale alors que je regarde la fissure qui mènera à la perte de l’humanité.")
	await novel_interface.show_text_only("Mariru s'éclaircit la gorge. Toutes les personnes présentes retiennent leur souffle et attendent ses ordres.")
	await novel_interface.show_dialog("Il n'y a pas une minute à perdre. À chaque seconde qui passe, la fissure continue de causer davantage de dégâts.", "Mariru")
	await novel_interface.show_dialog("Si nous restons assis et attendons que le Congrès uni envoie son équipe d’urgence, il sera trop tard.", "Mariru")
	await novel_interface.show_dialog("En plus, ce n’est pas comme si leur équipe d’urgence savait comment gérer quelque chose comme ça...", "Mariru")
	await novel_interface.show_dialog("Alors Henriette...", "Mariru")
	await novel_interface.show_text_only("Nous nous tournons tous vers l’alchimiste, qui n’a pas l’air trop surpris d’avoir été interpellé par Mariru.")
	await novel_interface.show_dialog("Si cela est lié d’une manière ou d’une autre à la Neuvième Séphira que vous êtes censé protéger..., alors avez-vous déjà rencontré quelque chose qui pourrait avoir des répercussions aussi graves que celle-ci ?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("Vous voyez, c'est ce qui est le plus ennuyeux dans mon travail !", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("L'alchimiste blonde secoue la tête avec un sourire pâle en se remémorant ses souvenirs.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("The One me téléporte généralement sur le lieu de l'incident et m'y laisse.", "Henriette")
	await novel_interface.show_dialog("Mais si nous laissons « ce genre de choses » là sans quelqu’un pour s’en occuper, le monde pourrait tout aussi bien s’arrêter ici.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 après J.-C., mont Huaynaputina, près de la colonie espagnole>", "Henriette")
	await novel_interface.show_dialog("Je me rebellais contre The One et j'ai prolongé ma mission pendant quelques jours supplémentaires. Finalement, tous les villages dans un rayon de quelques kilomètres étaient complètement en ruines.", "Henriette")
	await novel_interface.show_text_only("Son expression est incroyablement triste.")
	await novel_interface.show_dialog("J'ai quand même fait mon travail... mais tant de gens sont morts. Cela faisait plus de soixante mille vies humaines que j’aurais pu sauver.", "Henriette")
	await novel_interface.show_dialog("Les cendres du volcan sont restées dans l’atmosphère, bloquant la lumière du soleil pendant plus d’un an. Ce furent les années les plus froides de ces deux décennies.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette baisse les yeux, ne voulant pas continuer.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Cette catastrophe volcanique au Pérou à la fin du XVe siècle, hein...", "Ai")
	await novel_interface.show_dialog("— Il s’agit en effet d’une crise de même ampleur.", "Mariru")
	await novel_interface.show_dialog("Les températures extrêmement basses qui ont frappé le monde au cours des années suivantes ont provoqué famine et guerres dans le monde entier. Certains empires tombèrent même durant cette période.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ça a l'air vraiment sérieux...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("C'était une responsabilité trop lourde à assumer seule.", "Mariru")
	await novel_interface.show_dialog("Ren, n’as-tu pas mentionné les méthodes de voyage dans des climats extrêmement froids ?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Tu veux dire que tu veux que nous traversions... pour vérifier la base ? Vous voyez ce que nous pouvons faire pour vous aider ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("C'est vrai. Même si je ne peux pas être sûr de ce qui se passe exactement, je crois que le seul moyen de sauver la situation réside à l’intérieur de la base elle-même.", "Mariru")
	await novel_interface.show_dialog("Nous devons au moins collecter des données à partir de là...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Mais nous ne pouvons pas entrer dans la zone si le niveau de méthane est trop élevé là-bas, n’est-ce pas ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ce « méthane » dont vous parlez... est-ce la « substance combustible » que je sens actuellement dans l’air ?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Même si je ne suis pas entièrement sûr de ce dont elle parle, j’acquiesce quand même.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ça devrait aller, alors. La densité de la substance combustible dans l’air là-bas montre en fait une spirale descendante.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Là-bas ? Tu veux dire...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette doit parler de la base de Snedronningen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<À l’extérieur de la base de Snedronningen>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Bonjour ? Annie ? Pouvez-vous nous entendre ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Debout devant la gigantesque structure, fière dans un monde de neige et de glace, je crie dans mon vieux talkie-walkie, le protégeant du vent d'une main.")
	await novel_interface.show_dialog("Compris... le signal va bien... \\nUn blizzard est en route... soyez prudent...", "Annie")
	await novel_interface.show_text_only("La réponse de Annie est ponctuée de statique et de plus en plus statique.")
	await novel_interface.show_text_only("Mariru nous a ordonné de dépêcher la collecte des données météorologiques et de les renvoyer à New Opulentia dès que possible.")
	await novel_interface.show_text_only("En attendant, d'après ce que nous a dit Henriette, quelque chose ne va effectivement pas dans cette base. Il se démarque vraiment de son environnement.")
	await novel_interface.show_text_only("Je n’ai pas vraiment apprécié, mais je me suis quand même aventuré vers la gigantesque base aux côtés de Rapha?l et Henriette, en maintenant ma jupe dans le vent impétueux.")
	await novel_interface.show_text_only("Annie reste derrière, maintenant la communication entre nous et Mariru avec nos anciens talkies-walkies.")
	await novel_interface.show_text_only("Alors que nous avancions péniblement, nous avons pu constater grâce à notre chromatographe en phase gazeuse qu'il y avait effectivement une quantité alarmante de méthane dans l'air.")
	await novel_interface.show_text_only("J'étais sur le point de m'évanouir lorsque Rapha?l m'a attrapé la main.")
	await novel_interface.show_text_only("Non seulement riche et élégant, mais aussi chaleureux et apaisant. Sa présence était la seule chose qui me faisait tenir.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ne soyez pas arrogant, je vous aide simplement parce que j'ai promis à Mariru de le faire.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Ce n'est pas comme si j'avais demandé ça moi-même, d'accord ?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("J'ai immédiatement fermé la bouche après avoir répliqué, ne voulant pas avaler des bouchées de neige.")
	await novel_interface.show_text_only("Sans l’effet réchauffant du Fire Jade, je me serais déjà transformé en glace humaine.")
	await novel_interface.show_text_only("Pourtant, dans l’ensemble, la base semble beaucoup plus avancée que les stations de ravitaillement dans lesquelles nous nous sommes rendus auparavant.")
	await novel_interface.show_text_only("Nous traversons la piste d'atterrissage pour avions à voilure fixe et arrivons devant un monument en pierre.")
	await novel_interface.show_text_only("Une boîte à spécimens y est intégrée. Autour se trouve le nom de la base, Snedronningen, en imprimé fleuri.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... attends, comment tu prononces ça ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("C'est du finlandais. Snedronningen, idiot.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Cette base au nom que je n’arrive pas à prononcer semble déjà incroyablement grande de l’extérieur – et ce n’est que la pointe de l’iceberg. La majeure partie de la structure n’est même pas visible du haut.")
	await novel_interface.show_text_only("Je me demande combien d’argent a été dépensé pour construire une structure aussi impressionnante, en Antarctique, rien de moins.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Allez!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette avance rapidement, avant même que je puisse réagir.")
	await novel_interface.show_text_only("L'alchimiste pose la main sur la serrure électrique près de la porte. Au lieu de le laisser scanner sa paume, elle arrache simplement le tout, le cadre et tout, du mur.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Quel genre de monstre est-elle ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
	await novel_interface.show_text_only("Une fois le problème de serrure réglé, les câbles qui maintiennent la barrière fermée commencent à bouger, de petits rouages vrombissant, révélant enfin l'embrasure de la porte.")
	await novel_interface.show_text_only("Nous regardons à l’intérieur pour voir un escalier qui descend.")
