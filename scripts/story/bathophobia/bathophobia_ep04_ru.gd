# bathophobia_ep04.gd - 深海恐惧篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep04_script()

func play_script():
	pass

func bathophobia_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Сидя на траве под тенями, я угрюмо смотрю на послеполуденное небо.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Тьфу—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тень внезапно закрывает мне обзор.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Что случилось, Рен? Что тебя беспокоит?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Привет, Annie…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie садится рядом со мной и кладёт на колени бумажный пакет.")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("— Он так сладко пахнет!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Та-да! Свежеиспеченное печенье с кленовым кремом! \\nХочешь такой?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Спросив меня, она, похоже, не ждет отказа и сует мне в рот печенье.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ммм… (жует) \\nВкуснятина!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Знаю! Я проходила мимо кабинета домоводства, там так вкусно пахло, что я тайком попросила достать мне пакетик.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Так здорово... видеть, как ты стала здесь своей, Annie.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Хм?", "Annie")
	await novel_interface.show_dialog("Рен, ты тоже очень популярен. \\nМногие одноклассники спрашивали меня о тебе…", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Правда?")
	await novel_interface.show_text_only("Мне везет в романтических отношениях намного лучше, чем когда я был мальчиком!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Но госпожа Mariru не разрешает разглашать личные данные... так что я никому о тебе не рассказывала!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie внимательно смотрит на меня, пока ест печенье.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Ты плохо себя чувствуешь?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Такая мирная жизнь меня как-то смущает…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Разве это не хорошо для тебя?", "Annie")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Как будто у меня есть что-то важное, но я не знаю, с чего начать. \\nТот факт, что нам сейчас нечего делать, заставляет меня нервничать…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Что-то важное?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Скажем, каким будет будущее… В таком духе. \\nИ мое тело—", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Хаха—", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Хм! \\nВы думаете, что это смешно!!")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_text_only("Очень стыдно об этом говорить!!!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("М… многие одноклассники открыто говорили со мной на все эти девчачьи темы… Мне просто неловко.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Я вижу. Так вот почему ты здесь один?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie выглядит непринужденно.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Да. Иногда я бессознательно теребила волосы или поправляла нижнее белье.", "Lian")
	await novel_interface.show_dialog("А отправляясь на задание, я, естественно, надевала юбку и туфли на высоком каблуке…", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Но в тот момент, когда я осознавал, что я сделал, я думал: «Боже, как я мог это сделать?»", "Lian")
	await novel_interface.show_dialog("Я… я мальчик…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","relieve",0.25)
	await novel_interface.show_dialog("Мальчики могут это сделать.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie внезапно звучит серьёзно.")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","relieve",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Высокие каблуки были изобретены Людовиком XIV.", "Annie")
	await novel_interface.show_dialog("А в 17 веке женщины начали носить высокие каблуки, чтобы выглядеть мужественно.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Высокие каблуки созданы для… мужественности?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("А шотландские мужчины носят килты в официальных случаях!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это я знаю…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Угу... Говорят, они даже трусов не носят!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Неосознанно я похлопала себя по юбке.")
	await novel_interface.show_text_only("Слава богу, я не шотландец!")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Итак, Рен, ты выглядишь очень мужественно!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я… я?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Хм... И нижнее белье...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Глаза Annie обращаются к моей груди.")
	novel_interface.show_character("ren_uniform","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("С… смотри! Эти двое ни в коей мере не мужественны!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Я думаю, что они похожи на оборудование для силовых тренировок.", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("—А?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Это верно! Просто возьмите их как мешки с песком.", "Annie")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Мне бы хотелось иметь эти сладкие ноши…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie грустно касается своей груди.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Ты… говоришь разумно.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Ни в коем случае!")
	await novel_interface.show_text_only("Думаешь, я куплю это?")
	novel_interface.show_character("ren_uniform","uneasy")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("В любом случае, Рен, я думаю, ты очень хороший мальчик!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Моё лицо горит.")
	await novel_interface.show_dialog("Д... ты знаешь?", "Lian")
	await novel_interface.show_dialog("(Она звучит разумно, но я все еще чувствую себя обманутым…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie выглядит невинной и искренней, поэтому… я предпочитаю ей доверять.")
	await novel_interface.show_dialog("Какой беззаботный возраст.", "Mariru")
	await novel_interface.show_text_only("Голос Mariru просто вырвался из моей груди.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Аа-", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вздрогнув, я тут же схватился за грудь, боясь, что меня поймают другие ученики.")
	await novel_interface.show_text_only("Ая сказала, что я привыкну к динамику, но думаю, что никогда не смирюсь с этим странным онемением!!")
	await novel_interface.show_text_only("После операции в отеле Sky Hotel я просил их удалить этот дурацкий чип.")
	await novel_interface.show_text_only("Пока Mariru не пригрозил позвонить в школьный звонок через чип на глазах у всего моего класса.")
	await novel_interface.show_text_only("Какой дьявол!! Вааа…")
	await novel_interface.show_dialog("Ребята, я безостановочно работал для вас все эти дни.", "Mariru")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Неудивительно, что мы не получаем ни одной миссии!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ха… хаха… \\nПохоже, тебе не терпится работать, Annie…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Если бы не упрямые сенаторы, я бы все уладил…", "Mariru")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Э?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru звучит взволнованно.")
	await novel_interface.show_dialog("Скоро ты узнаешь—", "Mariru")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Что?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Неважно. Но уже почти время тренировок, а вы все еще околачиваетесь по кампусу. За что? Встречаться?", "Mariru")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("У нас еще есть полчаса…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вы не получили мою электронную почту? \\nВаша физическая подготовка повысилась.", "Mariru")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Опять пытки…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я уже представляю себе множество предстоящих ночей, когда я, смертельно измученный, рухну на кровать…")
	await novel_interface.show_dialog("Пытки? Хм…", "Mariru")
	await novel_interface.show_dialog("Не забывай, твое тело уже давно принадлежит мне.", "Mariru")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_text_only("Эй, прекрати это. Это звучит не правильно!!!")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru с улыбкой прерывает разговор.")
	await novel_interface.show_text_only("Она стоит прямо перед мрачным экраном.")
	await novel_interface.show_text_only("Данные на трубке передаются тем, кто находится за экраном.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Что касается бюджета…", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Я попросил муниципальные власти дать SID мандат на захват необитаемой земли в пределах 25 миль от G-cans в районе Нового Северо-Востока.", "Mariru")
	await novel_interface.show_dialog("Бюджет – 1,49 миллиарда.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Толпа")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Мы восстановим трубы, вспомогательную транспортную инфраструктуру и охранную инфраструктуру в соответствии со стандартами военного бункера V-класса.", "Mariru")
	await novel_interface.show_dialog("Бюджет – 620 миллионов.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Толпа")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Подземные порты защиты от паводков будут отремонтированы для параллельного соединения. По всей территории будут установлены электромагнитные щиты. Будет развернута адаптированная автономная система вооружения.", "Mariru")
	await novel_interface.show_dialog("Бюджет – 532 миллиона.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Толпа")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ожидается, что проект продлится 58 дней.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Сенаторы, если у вас нет вопросов по этому поводу, SID немедленно начнет проект.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Это… очень… дорого…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Это наиболее экономически эффективный вариант среди трех планов развития.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Что ж, я не против положить конец этому проекту.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Но, если можно так сказать, ваше мнение имеет значение…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Толпа")
	await novel_interface.show_text_only("Молчание не означает нет.")
	await novel_interface.show_text_only("В комнате слышно только статическое жужжание.")
	await novel_interface.show_text_only("— На экране одно за другим появляется слово «Одобрено».")
	await novel_interface.show_text_only("Это слово отображается под всеми видеопотоками.")
	await novel_interface.show_text_only("Mariru сияет от удовлетворения.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Итак — объявляю о старте «Проекта Ковчег»!", "Mariru")

	print("=== 深海恐惧篇第04话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
