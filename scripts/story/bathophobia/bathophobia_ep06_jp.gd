# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("いつものように、一方通行の映像会議が続いている。\\n\\n会議台の中央に立つマリルは、\\n各研究の進捗を冷静に報告していた。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("『方舟計画』についてだが……", "ギアーズ")
	await novel_interface.show_dialog("サモントンが提示した歴史文化財リストの中から\\n『トスハイム青金石柱』を選択したのかね？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("はい。この計画では如何にして\\n「制御可能な異変空間を作成できるか」が\\n非常に重要なカギとなります。", "マリル")
	await novel_interface.show_dialog("最近、各学園都市で頻繁している時空位相波動は\\n人間と『異質物』の性質に似た物品との\\n接触が大部分の原因だと考えられるでしょう。", "マリル")
	await novel_interface.show_dialog("これまではこの類の『異質物』は\\n沈黙状態でしたが、\\nほぼ同時期に活性化を迎えていますので。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（正確には『魔導器』と『魔導書の残ページ』と　呼ぶべきだが…）\\n（こいつらに馴染みある言葉で説明した方が良い　だろう）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("『ロス・ゴールド』が消失した日、だな……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("この2つの事件の関係性は、現時点で未だ確認が取れていません。", "マリル")
	await novel_interface.show_dialog("制御不能な要因が多すぎるため、今回は\\n2つの条件で選別するしかありませんでした。", "マリル")
	await novel_interface.show_dialog("その1　色相スキャンで、この類の『異質物』の\\n特徴に符合するが活性が高くないもの。", "マリル")
	await novel_interface.show_dialog("その2　歴史文献によって、その文化財の関係者を遡る事ができ──\\n更に暴力性と犯罪傾向がないと確信できるもの。", "マリル")
	await novel_interface.show_dialog("『トスハイム青金石柱』の元の持ち主は、\\nハインリッヒ・クンラート。\\nこの人物はルネサンス時代の医者であり、\\n錬金術士であったと記述があります。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("活性が高くないか……より臨界的なデータを\\n収集できると思ったのだが。", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("貴重なサンプルである以上、\\n過激な実験計画は避けるに越した事はない。", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("（レンが異変空間に出入りできると言う\\n　一芝居を打って元老院に信じ込ませればいい）","マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（実際『トスハイム青金石柱』は『魔導器』では　ない）\\n（特徴が似ている「魔法刻印」を持つ品であるだ　け）","マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（普通の人間に『魔導器』に触れさせるなんて\\n　そんな危険な事……）\\n（あのゴリラじゃあるまいし……）","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクリーンから渋い笑い声が響く。")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("錬金術士……いわゆる科学の起源でしょうか？\\nいやぁ……実に面白い選択ですな。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("サモントンの重要な歴史芸術と聞いた事もある。\\nそのハインリッヒなる人物は──\\nあの『薔薇十字団』の創始者の1人……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("その『薔薇十字団』は、ただの神秘学と\\n宗教的な団体です。\\n現在のサモントンの情報機関である『十字薔薇』\\nとは一切関係ありません。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("それに錬金術士は、あの時代では科学者と\\n等しい存在です。\\n彼が未知のモノに対して、基本的な畏敬を\\n持っている事を私たちは願いましょう。", "マリル")
	await novel_interface.show_dialog("ただ1点、デックス博士の性格を鑑みると\\nそう易々と重要文化財を貸してくれるとは──\\n私には思えません……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──会議室に不気味な沈黙が訪れた。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("……その通りだ。\\nサモントンは実験データの共有を要求している。\\nそして、全過程に1人の代表を参加させろとも。", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…………", "マリル")
	await novel_interface.show_dialog("（どうやらあいつらは魔女製造計画を諦めてない　ようだな）\\n（レンを『安定装置』とするつもりか……）","マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("了解しました。\\nそれでは最後にもう一度確認させて下さい。\\nサモントン側や各位も、\\n今回の実験の危険性をご承知でありますか？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("無論。旧都の巨大地下排水施設を改造した\\n『方舟基地』を実験に使用するのは、\\n最悪の事態を想定しているためだ。", "ギアーズ")
	await novel_interface.show_dialog("あの超高速海水逆流システムを発動すれば、\\n30秒と経たずに基地全体を水没状態にできる。", "ギアーズ")
	await novel_interface.show_dialog("もし実験中になんらかの事故が発生した場合……", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("その時はマリル殿に緊急自滅装置を、\\n起動する決心がある事を願いましょう。", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
