# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru walks up to Aya and bends over to read the latest data on the screen.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Beatrice's medical report?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Uh-huh—A perfect sample!", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("And it would be much more interesting if we could compare it with historical records.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("But none of our databases contains any of her information. It might be due to the data gap caused by the war.", "Mariru")
	await novel_interface.show_dialog("Nevertheless, according to her statements and your report…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru pulls up Beatrice's profile on the screen.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 years old… \\nWhat a prime age!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru and Aya exchange a look, knowing that they've noticed the same thing. Then, they turn back to the screen.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("This is her testing result on the night she emerged?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Virtually zero radioactive elements found in her body. Although the levels of heavy metal are relatively high in her blood samples.", "Ai")
	await novel_interface.show_dialog("It might have something to do with the utensils or crude cosmetics in the Middle Ages…", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("So you've got a conclusion already?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("After all, according to the records of her statements—", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya traces her finger over a line of text on the screen.")
	await novel_interface.show_text_only("GMT+9 13:09:11  Target claims 1265 AD as year of birth.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—This is the first time I see a living sample from ancient times.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Could it be the same case with Annie?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Nah! \\nBeatrice said she was 100 percent sure that she was dead.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("She said she intentionally drank poison.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("There are historical records to support this… But the possibility of falsification cannot be ruled out.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya clicks open another testing report.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Only a limited range of poisons was recorded in the Middle Ages: hemlock, nightshade, nux vomica, among others.", "Ai")
	await novel_interface.show_dialog("We found residuals of toxic alkaloid in her blood samples taken on the night she emerged.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("But in the blood we drew the next day, there is almost no trace of any toxic alkaloid or heavy metal.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("No wonder you look so excited…", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hold on, this is not the most exciting part yet!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya's voice trembles with excitement.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Unlike Annie, Beatrice has an immune system found in newborns. She tested negative for IgD.", "Ai")
	await novel_interface.show_dialog("And… the properties of the microbiome in her body are almost the same as Ren's!!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… How did you even think to run these tests?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuition. Instinct. And a passion for rare samples!!", "Ai")
	await novel_interface.show_dialog("A body created out of nothing… accurately reproducing the most interesting \"curse\" on the subject – the ability to attract love.", "Ai")
	await novel_interface.show_dialog("Ren is just… incredible!!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Saying that, Aya closes her eyes, and crosses her arms to hug herself, looking quite intoxicated by her thoughts.")
	await novel_interface.show_text_only("Mariru whips out a roll of reports and knocks hard on Aya's forehead.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("If a soul can independently exist in a different Spacetime…", "Mariru")
	await novel_interface.show_dialog("Then how does it select a container?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("Could it have something to do with the golden butterfly?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No, considering Annie and her baseball bat, I think Beatrice is somehow connected with the green gem…", "Mariru")
	await novel_interface.show_dialog("It's like certain objects can summon the souls attached to them.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("This is about Spacetime travelling and body creation…", "Mariru")
	await novel_interface.show_dialog("(The Senate should never know anything about this.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("So, Ren can even attract a soul…", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya breaks Mariru's train of thoughts.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("To get a certain soul out of nowhere, and create a body to host the soul… It sounds like forbidden alchemy.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("If I hadn’t been living in this era, I might have tried to do soul trade with gods by using basic elements, just like alchemists.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Like the so-called \"Son of Gods” promoted by small religious groups. But there's no market for this in New Opulentia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("Nah, I prefer feminine titles such as “Goddess\". They give me this inner urge to defy abstinence.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Gosh—Why on earth did I employ someone like you…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Uh-huh! Maybe our souls are just attracted to each other.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("—So, this is all I've found.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Huh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In the health center, after the regular physical checkup, I talk to Aya about Beatrice while putting on my clothes.")
	await novel_interface.show_text_only("Aya's comment on Beatrice's physical conditions may make sense…")
	await novel_interface.show_text_only("But the soul theory sounds like total crap…")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Especially the so-called \"Goddess\"...) \\n(Though I used to play those kinds of roles in video games.)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(But I'd never want such a title for myself!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I can't help putting my arms around myself in a shiver.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("No, never!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, anything unspeakable in your mind?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So... this is why my checkup list got longer?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uh-huh.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya shows a foxy smile as if planning something in secret.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Maybe it’s another unauthorized research …)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Too bad I don't have enough supporting equipment; otherwise, I could do more \"interesting\" tests…", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("By the way, wanna try out the maximum power mode of the chip planted in you?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("No! Thank you very much!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
