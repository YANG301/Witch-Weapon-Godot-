# bathophobia_ep13.gd - 深海恐惧症篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep13_script()

func play_script():
	pass

func bathophobia_ep13_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("In the Central Control Room, Beth stares at the image of icebergs transmitted by the real-time camera outside the hull.")
	await novel_interface.show_text_only("The submarine starts to surface. The cabin is now enveloped in the violet light of the Antarctic night.")
	novel_interface.show_character("milk_normal","laugh")
	await novel_interface.show_dialog("Beth my babe…", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The door is suddenly pushed open, and a girl with a ponytail bounces into the room.")
	await novel_interface.show_text_only("Beth comes back to earth. She gives a sigh of resignation.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("You must be missing me!", "Milk")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("The passcode thing was just a boring prank. Don't take it to heart!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk pulls down the neck of her T-shirt to show off her prize—banknotes stuffed down her cleavage.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("Disgusting.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","laugh")
	await novel_interface.show_dialog("You never let me down! You're so great, and so so cute!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth tries to push away the girl clinging onto her, but Milk wouldn't loosen her hold.")
	novel_interface.show_character("milk_normal","mock")
	await novel_interface.show_dialog("Anyway, let's cut to the chase.  \\nThere was something wrong with you during the briefing…", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","think")
	await novel_interface.show_dialog("Oh, really?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Beth lies down on the couch. Milk sits down on her laps and reaches out to hold her cheek.")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Beth looks away stiffly.")
	novel_interface.show_character("baizhu_normal","think")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_normal","gratified",0.25)
	await novel_interface.show_dialog("…", "Milk")
	await novel_interface.show_dialog("Wanna deny it?", "Milk")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("After a moment of silence, Milk smiles softly.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("To be honest, I hated to join this mission…", "Milk")
	await novel_interface.show_dialog("Supernatural phenomena, non-human creatures, you know, they are not my thing.", "Milk")
	await novel_interface.show_dialog("Plus, the only clue is that abnormal bio-signals are detected over the Antarctic… How is it possible to find any target?", "Milk")
	novel_interface.change_2nd_expression("laugh")
	await novel_interface.show_dialog("I won't be surprised if we go back empty-handed… I will just take it as a holiday.", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth gets what she means immediately.")
	novel_interface.show_character("baizhu_normal","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("milk_normal","laugh",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("… Tell me, how much do you know?", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Suddenly, Milk looks serious.")
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("Hmm, I've retrieved your activity logs in the hull.", "Milk")
	await novel_interface.show_dialog("You… You've met That Thing face to face?", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth examines the military-grade Antarctic map lying on the desk.")
	await novel_interface.show_text_only("A shadowed area is clearly visible on the map—")
	await novel_interface.show_text_only("It marks a body of water to the east of the Antarctic continent where the unidentified giant creature was found.")
	novel_interface.show_character("baizhu_normal","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","pleased",0.25)
	await novel_interface.show_dialog("—Hey, relax.", "Milk")
	novel_interface.change_2nd_expression("sprite")
	await novel_interface.show_dialog("I've modified all the logs for you. No one else knows you deliberately allowed the submarine to lose control and set up auto-wake at 20,000 ft underwater.", "Milk")
	await novel_interface.show_dialog("You may be good at mechanics, but you always forget about those hidden code…", "Milk")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I knew I could count on you.", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth smiles slyly.")
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_dialog("Come on, just now you were almost telling everyone that you want to go deep into the Antarctic!", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Milk pats Beth on the head gently.")
	novel_interface.show_character("baizhu_normal","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","normal",0.25)
	await novel_interface.show_dialog("And even if the deep-sea environment in the sampling chamber can only last for a few hours, the sample won't necessarily lose its activity, right?", "Milk")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm…", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("Hey, does That Thing look good?", "Milk")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Beth shakes her head, a fearful look crosses her face.")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Nah, what a pity.", "Milk")
	await novel_interface.show_dialog("… But why did you hold back what you know about That Thing?", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth says nothing.")
	await novel_interface.show_text_only("Milk sits on Beth's bed, looking out of the window.")
	novel_interface.show_character("baizhu_normal","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","normal",0.25)
	await novel_interface.show_dialog("At first, I thought your target was the Ushuaia icebreaker.", "Milk")
	await novel_interface.show_dialog("But equipping a lab on the icebreaker? That sounds quite tricky…", "Milk")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So this proposal will be rejected for sure.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Then you have to use permanent Antarctic facilities which are capable of analyzing the samples.", "Milk")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Within two hours' reach, there are only two bases up to standard—the Snow Queen and Nuremberg.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("The rest are either obsolete or under multiple jurisdictions, even with troops deployed.", "Milk")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Geographically, the Nuremberg Base is closer to the Amery Ice Shelf.", "Beth")
	await novel_interface.show_dialog("But—", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("Unfortunately, some \"independent institution\" took over the base and had soldiers stationed in there since last month.", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("They exchange a look. Beth blinks.")
	novel_interface.show_character("baizhu_normal","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("milk_normal","sprite",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Umm, if your Boss can express willingness to work with private companies…", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Eww, those high-ranking guys need respect more than they need air.", "Milk")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Even if they have to buy off pirates and dictators who control the surrounding waters?", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"pleased")
	await novel_interface.show_dialog("You don't have to say it loud!", "Milk")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Anyway, ruling out the icebreaker and the Nuremberg Base, your real target is—", "Milk")
	await novel_interface.show_dialog("East longitude 76-55-22, south latitude 68-24-59... \"Snedroningen\" - White Queen Base.", "Milk")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Um-hum.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Is this a confession then?", "Milk")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You've already figured me out, haven't you?", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Instead of feeling flattered, Milk casts a worried look on her friend.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Have the clues led to… there?", "Milk")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth gives a silent nod.")
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("So… rest assured. I'll see you through!", "Milk")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You can always read my mind.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("Don’t underestimate me, my sweet. I know everything about you.", "Milk")
	await novel_interface.show_dialog("And you shouldn't keep everything to yourself. I can’t help you without knowing your plan!", "Milk")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("But…", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Or you don't trust me?", "Milk")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Of course I do. \\nBut—", "Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Milk puts her warm arms around Beth before she could even start to disagree.")
	novel_interface.show_character("baizhu_normal","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","gratified",0.25)
	await novel_interface.show_dialog("It must be hard on you…", "Milk")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I understand…  \\nYou just don't want me to get involved in those things…", "Milk")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Beth looks down.")
	novel_interface.character_light(0.35,"sad")
	await novel_interface.show_dialog("I don't want to drag you into the mess my father has left me…", "Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Milk hugs Beth more tightly.")
	await novel_interface.show_text_only("Beth turns rather pink. She tries unconsciously to push Milk away, but eventually drops her resistance.")
	await novel_interface.show_text_only("A peculiar feeling rises in her heart, as if she is being bathed in warmth and peace.")
	novel_interface.show_character("baizhu_normal","sad")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","gratified",0.25)
	await novel_interface.show_dialog("You always look cold… But I know you're actually soft-hearted…", "Milk")
	await novel_interface.show_dialog("You've just met these idiots on the Squad and now you are already so concerned about them!", "Milk")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, I…", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("Hehe, why did you say it’s alright if they wanted to give up?", "Milk")
	await novel_interface.show_dialog("You want them to return to the safety zone early, don’t you?", "Milk")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Yeah, maybe.", "Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("In the warmth of Milk’s arms, Beth looks up at her and smiles. Light fills her eyes.")
	novel_interface.show_character("baizhu_normal","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","laugh",0.25)
	await novel_interface.show_dialog("Don't hide it from me. \\nYou're too innocent to lie.", "Milk")
	novel_interface.change_2nd_expression("gratified")
	await novel_interface.show_dialog("Trust me, and tell me the truth…", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth says nothing.")
	novel_interface.show_character("baizhu_normal","think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","sprite",0.25)
	await novel_interface.show_dialog("Well, it's not hard to guess even if you don't tell me. I have the superpower to read your mind!", "Milk")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah, you are so smart.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("But the more I think about your intentions, the more I'm worried…", "Milk")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sorry for this.", "Beth")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("Don't say sorry. Prove it!", "Milk")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Milk pokes Beth's forehead.")
	novel_interface.show_character("baizhu_normal","shock")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","laugh",0.25)
	await novel_interface.show_dialog("What about hugging me back?", "Milk")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Um-hum.", "Beth")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth reaches out her arms and holds Milk around her waist, looking relieved.")
	novel_interface.show_character("baizhu_normal","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("milk_normal","laugh",0.25)
	await novel_interface.show_dialog("You should laugh more. That's good for your cute face!", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The submarine, now floating on the surface, quietly sails through the icy currents.")
	await novel_interface.show_text_only("The midnight sky in the white night zone is bathed in orange and purple twilight.")
	await novel_interface.show_text_only("In Beth's eyes, Milk's warm and bright smile is shining like the rising sun.")
	await novel_interface.show_text_only("This scene is more beautiful than the scenery outside the window.")
	novel_interface.show_character("baizhu_normal","shy")
	await novel_interface.show_dialog("(muttered)...you are cuter.", "Beth")
	
	print("=== 深海恐惧症篇第13话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
