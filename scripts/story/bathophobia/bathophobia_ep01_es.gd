# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru está presentando un informe unilateral en una reunión a puerta cerrada.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… Eso es todo lo que tenemos sobre el incidente de la delegación Salmonton.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers hizo otra visita a New Opulentia para hacer algunos \"recados personales\".", "Mariru")
	await novel_interface.show_dialog("Ahora, SID la ha incluido en la lista de protección de nivel A.", "Mariru")
	await novel_interface.show_dialog("Sin embargo, esta vez, Salmonton presentó todos los detalles de la delegación y una lista completa de productos restringidos al Ministerio de Asuntos Exteriores.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Incluso han informado de todas las operaciones militares en las que ha participado su personal de seguridad en el pasado. No se puede encontrar ni un solo defecto en los registros...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Entonces, suena como un descargo de responsabilidad de que si algo malo le sucede a la nieta del Dr. Dekkers, será todo culpa nuestra.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("¡Huh! Ese zorro astuto...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Sin embargo, a cambio de la seguridad de esa joven aquí, prometieron una entrega prioritaria del 20% de nuestro contrato de compra de productos agrícolas.", "Eloise")
	await novel_interface.show_dialog("Según el índice NBOT actual, es como un regalo.", "Eloise")
	await novel_interface.show_dialog("He firmado una orden ejecutiva para mantener a los medios fuera de su pista por el momento.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(¿Están utilizando el Senado como parte de su estrategia de creación de mercado?) \\n(Y sabían que yo me mantendría al margen...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Humph… viejo zorro astuto…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("La niña nos es útil. ¿Podemos extraer más inteligencia de ella?", "Bright")
	await novel_interface.show_dialog("Hablando francamente, hemos estado muy interesados en su tecnología de edición de genes y en los megasistemas de invernaderos.", "Bright")
	await novel_interface.show_dialog("Si puede pasar unas horas en mi laboratorio...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dr. brillante...", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Ya tienes una gran reputación por tus estándares morales \"únicos\" en Substance H que afectan la mente humana.", "Mariru")
	await novel_interface.show_dialog("Me temo que Salmonton impondría inmediatamente sanciones comerciales a New Opulentia una vez que la joven entre a su laboratorio.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("¿Mi reputación? ¿En realidad? \\nJajaja…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ejem, ¡ya es suficiente!", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Hablando de esos desconocidos armados en el Sky Hotel…", "Kirs")
	await novel_interface.show_dialog("Atacaron a la delegación Salmonton y se apoderaron de algunas valiosas obras de arte...", "Kirs")
	await novel_interface.show_dialog("¿Tiene SID alguna pista?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(El viejo zorro ocultó la mariposa dorada al Senado y culpó a Jacob y su pandilla).", "Mariru")
	await novel_interface.show_dialog("(Desactivaron las cámaras de seguridad del hotel antes de tomar medidas). \\n(Hay una laguna de información allí...)", "Mariru")
	await novel_interface.show_dialog("Tenemos las manos atadas en la Zona Desmilitarizada Acordada. Según distintas fuentes, creemos que utilizaron armas especiales.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Armas especiales… ¿te refieres a armas Substance H? \\n¡¿Usaron las armas dentro del campo protector de Aegis?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("A juzgar por las marcas de quemaduras en forma de árboles en el suelo, creemos que utilizaron dispositivos de descarga de alta potencia con circuitos de resonancia en serie.", "Mariru")
	await novel_interface.show_dialog("Un dispositivo tan complicado es demasiado voluminoso para que lo lleve un soldado individual y prácticamente no hay forma de reducirlo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Según declaraciones de testigos, esa noche había unos 10 hombres armados con la misma arma.", "Mariru")
	await novel_interface.show_dialog("Según los registros de Aegis, unas diez identificaciones desconocidas se desconectaron al mismo tiempo esa noche. Debieron haberse retirado del sitio.", "Mariru")
	await novel_interface.show_dialog("Dado que SID había bloqueado las salidas regulares, podrían haber escapado a través de canales diplomáticos.", "Mariru")
	await novel_interface.show_dialog("(O ejecutado por su fracaso…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("... Ya veo.", "Kirs")
	await novel_interface.show_dialog("Las armas Substance H no se pueden producir a tan gran escala.", "Kirs")
	await novel_interface.show_dialog("Pero antes de que apagaran las cámaras, dos sospechosos atacaron a los guardias en el pasillo.", "Kirs")
	await novel_interface.show_dialog("Una de ellas vestía como sirvienta de ese hotel y la otra vestía el uniforme de Gosakuragawa. ¿Los enviaste allí?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un chirrido agudo sale de la pantalla.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Jajaja… Nuestro Director Ejecutivo parece muy interesado en los gatitos… Yo también.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… ¿Gatitos?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Oh, lo cité de Su Excelencia la Sra. Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Qué dolor en el trasero…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie y Ren, ¿verdad? \\nNombres adorables...", "#C")
	await novel_interface.show_dialog("Tal vez haya otros gatos que Mikakawa haya criado——", "#C")
	await novel_interface.show_dialog("¿Estoy en lo cierto, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ja, gracias por no venderlos al ejército de seguridad. Te debo una.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("No es gran cosa. \\nParece que no tienes intención de ocultarnos nada de todos modos.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Entonces, permítame informarle con más detalles.", "Mariru")
	await novel_interface.show_dialog("El satélite detectó varios flujos espacio-temporales en el Sky Hotel, pero SID no tenía derecho a actuar allí.", "Mariru")
	await novel_interface.show_dialog("Entonces envié dos agentes encubiertos allí.", "Mariru")
	await novel_interface.show_dialog("Durante su misión, se encontraron con un grupo de hombres armados y uno de ellos disparó a Annie con el arma especial.", "Mariru")
	await novel_interface.show_dialog("Ahora el agente finalmente está fuera de peligro después de los tratamientos de emergencia y hemos recopilado algunas estadísticas sobre esa arma.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… ¿Por qué no nos lo dijiste antes?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Señor director ejecutivo, me pregunto cuáles son exactamente las “obras de arte” que desaparecieron.", "Mariru")
	await novel_interface.show_dialog("Tal vez sea hora de que todos nos volvamos más abiertos a compartir inteligencia.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("¿Qué opinas?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("¿Por qué no empezamos con el gatito que adoptaste?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Qué lástima… Esa información no fue suficiente para distraerlo).", "Mariru")
	await novel_interface.show_dialog("(Qué dolor de cabeza...) \\n(Bueno, me temo que es hora de probar esos documentos falsificados. Es hora de contar cuentos, muchachos.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("¿Empezamos, querida?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Durante la Guerra de los Siete Años, los científicos lucharon por desarrollar nuevas tecnologías que permitieran la activación del Toque Divino por parte de los humanos.", "Mariru")
	await novel_interface.show_dialog("Se rumoreaba que se habían realizado en secreto experimentos de modificación del cuerpo humano en combatientes. Creo que has oído esos rumores.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Um-hum.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se ríe, las comisuras de su labio se curvan ligeramente hacia arriba.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Algunas personas nacen con aptitudes especiales y la Academia de Ciencias New Opulentia y el Instituto de Investigación del Cerebro tienen registros que lo demuestran.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("De hecho, el Dr. Bright puede considerarse uno de ellos.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Espera, tengo que recordarte que casi todas esas personas superdotadas son mujeres.", "Bright")
	await novel_interface.show_dialog("Sin embargo, las personas con talentos especiales como este generalmente solo se incluyen en la lista de vigilancia y no hay necesidad de un control especial.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Correcto. Pero entre todos estos talentos, nadie tiene una potencia comparable a la del Clase B Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Como los resultados del experimento estuvieron por debajo de las expectativas, este tipo de investigaciones se suspendieron durante el período de guerra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Aquellas mujeres con superpoderes también se conocen como \"Brujas\". Hace unas décadas, nadie hubiera creído jamás la existencia de cosas así en el mundo…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Pero Ren es diferente: puede atravesar áreas de flujo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡¿Qué?!!","multitud")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
