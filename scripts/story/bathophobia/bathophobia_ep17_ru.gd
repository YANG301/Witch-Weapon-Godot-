# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Бесконечные просторы унылой земли, окрашенные в мистический зеленый цвет потрясающим полярным сиянием.")
	await novel_interface.show_text_only("Ряд фар пронзает холодный, безмолвный мрак.")
	await novel_interface.show_text_only("Они принадлежат к парку снегоходов. Скутеры проносятся мимо окутанных тьмой ледяных равнин, мимо вертолетной площадки и наконец останавливаются у входа на обширную базу.")
	await novel_interface.show_text_only("Перед ними стоит памятник в форме кокона. В его каменистую поверхность встроен прочный ящик для образцов, ранее использовавшийся для хранения метеоров с горы Гроув.")
	await novel_interface.show_text_only("Слово «Snedronningen» нарисовано бесчисленное количество раз вокруг коробки и блестит серебром в лучах прожекторов.")
	await novel_interface.show_text_only("Снедроннинген — Белая Королева. Название базы, которую ищут гонщики.")
	await novel_interface.show_text_only("Член отделения в тяжелой броне, едущий впереди, срывает с нее забрало.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("— Иаа, вот и мы!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Следуя ее примеру, оставшиеся пять гонщиков выключают двигатели и спешиваются, каждый забирая свои припасы.")
	await novel_interface.show_text_only("Это научно-исследовательская группа, все члены которой прошли стандартную боевую подготовку.")
	await novel_interface.show_text_only("Сообщения о радиоволнах, генерируемых Substance H, обнаруженных в Антарктиде два месяца назад, привлекли в этот район множество любопытных группировок. Большинство из них пришли вооруженными.")
	await novel_interface.show_text_only("Отряду разумно проявлять осторожность, чтобы сохранить экземпляры в безопасности.")
	await novel_interface.show_text_only("Им пока повезло. Путешествие к исследовательской базе, упомянутой в запасном плане, прошло вполне гладко.")
	await novel_interface.show_dialog("Хорошо. Все, что нам нужно сделать, это передать вещи.", "Член отряда D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Да.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В отличие от остальных, одетых в толстые теплые одежды, Бет одета в повседневную одежду, явно не подверженную воздействию экстремальной температуры.")
	await novel_interface.show_text_only("Ее самоусовершенствованное оружие тоже выделяется из толпы.")
	await novel_interface.show_text_only("Их путешествие прошло именно так, как она и ожидала __ЭЛЛИПСИС__")
	await novel_interface.show_text_only("Бет нырнула в глубины океана всего несколько часов назад и успешно принесла живые образцы, собранные ею из тела неопознанного существа.")
	await novel_interface.show_text_only("Для завершения исследовательского проекта руководитель Милка направил ледокол «Ушуайя» на помощь отряду специального назначения.")
	await novel_interface.show_text_only("Когда ящик с образцами переправляли на «Ушуайю», в биолаборатории на корабле «случайно» отключилось электричество.")
	await novel_interface.show_text_only("В то же время база Снедроннинген, расположенная примерно в часе езды, предложила команде временно хранить образцы в своей лаборатории, которая соответствует всем требованиям.")
	await novel_interface.show_text_only("Вскоре отряд получил разрешение войти в помещение и получил задание доставить образцы на базу Снедроннинген в течение девяноста минут.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Мы зашли так далеко... )", "Бет")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Появятся ли эти подонки?", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет сжимает кулак.")
	await novel_interface.show_text_only("Еще больше ее беспокоит то, что что-то в коробке с образцами, похоже, вызвало некую реакцию в ее организме.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("... \\n(Почему-то это кажется знакомым... )", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем она успевает обдумать это дальше, мир начинает сильно трястись.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(У меня просто закружилась голова от погружения?)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Нет, это не то.")
	await novel_interface.show_text_only("— Вся эта земля трясется.")
	await novel_interface.show_text_only("Глубокий грохот слышен издалека.")
	await novel_interface.show_text_only("Даже самые закаленные ветераны кажутся потрясенными.")
	await novel_interface.show_text_only("Дрожь, сотрясающая этот белый континент, длится менее тридцати секунд.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Антарктида не находится в зоне землетрясений..., не так ли?", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Землетрясение было не слишком сильным. Однако это вызвало у всех небольшое головокружение.")
	await novel_interface.show_dialog("(Бормочет) Это намного хуже, чем цунами...", "Член отряда Б")
	await novel_interface.show_dialog("Шельфовый ледник под нашими ногами кажется довольно прочным. Если бы такое же землетрясение произошло в густонаселенном тропическом городе, оно причинило бы гораздо больший ущерб.", "Командир отряда")
	await novel_interface.show_text_only("Члены отряда не обращают внимания на это небольшое землетрясение и продолжают свою работу.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Хорошо, поехали.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Беря в руки коробку с образцами, Бет спрыгивает с заднего сиденья снегохода Милка.")
	await novel_interface.show_dialog("Я устал. Не могу дождаться, когда вернусь домой, в постель и горячее какао.", "Член отряда Б")
	await novel_interface.show_text_only("Хотя члены отряда уже ослабляют бдительность, лидер сохраняет бдительность, посылая многозначительные взгляды в сторону Бет.")
	await novel_interface.show_text_only("Если бы не эта девушка, они бы провалили эту миссию, как и все остальные фракции.")
	await novel_interface.show_text_only("Ей пришлось нырнуть в глубины океана, рискнуть получить декомпрессионную болезнь и столкнуться с неопознанными существами...")
	await novel_interface.show_text_only("Ставки слишком высоки. Даже сама Милк не могла гарантировать успех в таких обстоятельствах.")
	await novel_interface.show_dialog("Так что все, что нам нужно сделать, это передать материал здешним ученым, верно?", "Член отряда D")
	await novel_interface.show_dialog("Бет, давай угостим тебя пивом, когда вернемся в Буэнос Aires, а?", "Член отряда C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("Ни в коем случае! Наша Бети не пьет алкоголь!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Обхватив Бет на руки, — заявляет Милк.")
	await novel_interface.show_text_only("Бай Чжу сжал губы, намеренно подавляя свое беспокойство.")
	await novel_interface.show_text_only("Милк отправляет несколько запросов на вход к воротам базы, но не получает ответа.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Как странно __ЭЛЛИПСИС__", "Молоко")
	await novel_interface.show_dialog("Землетрясение испортило связь или что-то в этом роде?\\nОни все еще были на связи до того, как мы причалили.", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тем не менее, хотя шипы на передних воротах, ограничивающие въезд транспортных средств, остаются стоять, технически отряд все равно может войти — в конце концов, они заранее получили код доступа.")
	await novel_interface.show_text_only("Поэтому они направляются к ярко освещенному барьеру сбоку от базы.")
	await novel_interface.show_text_only("Бет внезапно останавливается как вкопанная и передает коробку с образцами одному из своих товарищей по команде.")
	await novel_interface.show_text_only("Свободными руками она крепко сжимает оружие.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Что случилось?", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заметив действия Бет, Милк тоже выхватывает свое оружие, глаза насторожены.")
	await novel_interface.show_text_only("Остальные участники тоже напрягаются и переходят в боевой режим, двигаясь вперед веерным строем, наблюдая друг за другом.")
	await novel_interface.show_dialog("... Какого черта?", "Член отряда D")
	await novel_interface.show_dialog("Тсс, потише.", "Командир отряда")
	await novel_interface.show_text_only("Все, что слышно в оглушительной тишине, — это скрипы снежных ботинок по поверхности льда и тихое дыхание членов отряда.")
	await novel_interface.show_text_only("Милк подходит к двери и вводит код в замок безопасности.")
	await novel_interface.show_text_only("Система принимает код, и на экране мигает зеленым цветом слово ENTER.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Ух,..., это должно быть безопасно, верно?", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но Бет до сих пор не может подавить тревожащее чувство в животе...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("Барьер на базе Снедроннинген наконец открывается, сопровождаясь звуками жужжащих шестерен и натянутых шнуров.")
	await novel_interface.show_text_only("За воротами находится лестница, ведущая прямо вниз, на тускло освещенный нижний уровень.")
	await novel_interface.show_dialog("Кто-нибудь?", "Молоко")
	await novel_interface.show_text_only("Ее вопрос эхом разносится по узкому коридору.")
	await novel_interface.show_dialog("Я понимаю, что большинство объектов здесь находятся под землей, но разве они не могли послать кого-нибудь наверх, чтобы встретить нас?", "Молоко")
	await novel_interface.show_dialog("Хотя бы один из этих исследователей должен прийти и проверить образцы...", "Член отряда Б")
	await novel_interface.show_dialog("В боевой позиции!", "Бет")
	await novel_interface.show_text_only("Взглянув на дальний конец лестницы, Бет выкрикивает свой приказ.")
	await novel_interface.show_dialog("Кто-то наблюдает за нами.", "Бет")
	await novel_interface.show_dialog("Чем более скрытный вариант, тем легче привлечь внимание, я думаю...", "Молоко")
	await novel_interface.show_dialog("(Вы беспокоитесь о наших врагах?)", "Молоко")
	await novel_interface.show_text_only("Страшную тишину нарушает серия хлопков предохранителей.")
	await novel_interface.show_text_only("Члены отряда, каждый из которых является обученным солдатом, смотрят на девушку, занимающую должность временного командира, и ждут ее приказов.")
	await novel_interface.show_dialog("Мы сейчас находимся в очень уязвимом месте. Мы будем в опасности, если они устроят засаду. Мы можем отступить за пределы....", "Член отряда D")
	await novel_interface.show_dialog("Не могу. Нас предупредили, сказали, что через час будет метель.", "Бет")
	await novel_interface.show_dialog("Все в состоянии повышенной готовности. Продолжайте двигаться.", "Бет")
	await novel_interface.show_dialog("(Все) Да, сэр!", "Член отряда")
	await novel_interface.show_text_only("Члены отделения идут на цыпочках, сохраняя тихое дыхание.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Берегись!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Звук острого лезвия, рассекавшего воздух, нарушил тишину.")
	await novel_interface.show_text_only("Существо, владеющее тяжелым оружием в форме косы, выпрыгивает из тени и наносит удар по правому боку Бет.")
	await novel_interface.show_text_only("Предупреждение Милка пришло как раз вовремя, позволив Бет уклониться от атаки.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("Что?!!", "Бет")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Ха-ха-ха... хахахахаха...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Нападавшая — девушка: глаза пустые, поза искажена. Она наклоняется вперед, ее суставы щелкают громко и дезориентируют.")
	await novel_interface.show_text_only("Еще несколько человек со свежими лицами и безумными выражениями хлынули через ранее пустой вход в коридор.") 
	await novel_interface.show_text_only("Члены отряда сразу выстраиваются в стандартный треугольный строй, продолжая при этом отстреливаться по нападающим.")
	await novel_interface.show_text_only("Следуя указаниям Бет, они окружают участницу, держащую коробку с образцами, охраняя ее со всех сторон.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("Команда поддерживает устойчивый ритм стрельбы, ища укрытие. Вскоре они попадают в помещение, похожее на выставочный зал.")
	await novel_interface.show_text_only("Свет здесь тусклый, а экспонаты представляют собой в основном образцы животных.")
	await novel_interface.show_text_only("Лидер приказывает команде сформировать линию защиты у входа в комнату, в то время как остальная часть команды обсуждает ненормальные качества, которые они заметили у этих врагов.")
	await novel_interface.show_text_only("При попадании они не кровоточат. Кажется, они даже не чувствуют боли.")
	await novel_interface.show_text_only("Группа разворачивает свои щиты из кевлерового волокна, которые несколько блокируют атаки.")
	await novel_interface.show_text_only("Враги, врывающиеся с другой стороны, с большими мечами в руках, сдерживаются в углу членами отряда, держащими в руках еще больше защитных щитов.")
	await novel_interface.show_text_only("Тем временем из-за щитоносцев на врагов продолжают сыпаться 9-миллиметровые пули, в воздухе витает тяжелый запах пороха.")
	await novel_interface.show_dialog("Перезагрузи!", "Член отряда C")
	await novel_interface.show_text_only("Стрельба не останавливает странных врагов. Даже когда пули пронзают их лица, эти ужасные девушки продолжают ухмыляться.")
	await novel_interface.show_text_only("Пока одна из девушек не перемахивает через щит и не повешивается вниз головой, как летучая мышь, на потолке коридора.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Э-э,..., она вообще... человек?", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Из пулевых ранений девушки вытекает чернильно-зеленая жидкость. Ее шея, почти раздробленная пополам силой пуль, теперь окрасилась в тревожный зеленовато-фиолетовый цвет.")
	await novel_interface.show_dialog("Берегись!", "Член отряда Б")
	await novel_interface.show_text_only("Еще больше врагов приближаются из конца коридора.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Отступите! Отступление!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Членам отряда ничего не остается, как разделиться на два направления и искать другие подходящие точки для атаки, которые они, к счастью, вскоре находят.")
	await novel_interface.show_text_only("Сражаются они еще недолго, но для них всех очевидно, что враги — кем бы они ни были — ничуть не менее сильны, чем их собственные.")
	await novel_interface.show_text_only("И еще на сто процентов безумнее.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... Что такое... ?", "Бет")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("Какого черта?\\nОни не могут быть людьми!", "Молоко")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Для Бет очевидно, что эти юные девушки, владеющие клинками, такие же, как она…")
	await novel_interface.show_text_only("Нет, не полностью.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Они больше похожи на то, что описал их отец...)\\n(стиль «Нингена»)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Они выносливы, быстро восстанавливаются, имеют чрезвычайно гибкие суставы, что делает их менее человечными и больше похожими на подвижных марионеток. Слишком мощный.")
	await novel_interface.show_text_only("И они явно охуели. Как машины для убийства, активируемые программой.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Хахахаха... Джаджаджаджаджа...", "Patchy Pythoness")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Их бессмысленный лепет звучит как какое-то демоническое пение. Определенно не человек.")
	await novel_interface.show_text_only("Внезапно в члена отряда, держащего коробку с образцами, попадает стрела. Когда она падает на землю, коробка выкатывается из ее рук.")
