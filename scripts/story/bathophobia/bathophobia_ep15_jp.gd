# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("くしゅん……っ！", "バイジュウ")
	await novel_interface.show_text_only("机の前で1人、ウトウトとうつ伏せの少女は\\nくしゃみによって目を覚ました。")
	await novel_interface.show_text_only("潜水艦が渡航している海域は極夜であるため、\\n空模様からは時間を判別できない。")
	await novel_interface.show_text_only("モニターの情報を確認して、バイジュウは\\nようやく気付いた。\\n深海であの巨大な怪物と会ってから、\\nまだわずか数時間しか経ってない事に。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("……本当に、これでいいのでしょうか？", "バイジュウ")
	await novel_interface.show_dialog("（真相を探るために……）\\n\\n（あの子を利用するなんて……）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は思わず、広げたノートに目を向けた。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（お父さんでしたら……）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──あの人でしたら、\\nこんな感情で動揺する事なんてないでしょう。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("父の厚い手を思い出し、少女は拳を握りしめた。")
	await novel_interface.show_text_only("難解な文字列が大量に記されたこのノートは、\\n元々は彼女の養父の物だ。")
	await novel_interface.show_text_only("彼は背が高く、寡黙で真面目な生物学者だった。\\n\\n自分自身に対しても、バイジュウに対しても\\n彼はとても厳しかった。")
	await novel_interface.show_text_only("特異体質を持っていたバイジュウは、幼い頃から\\n勉強の他にも厳しい訓練が課せられていた。")
	await novel_interface.show_text_only("父が設定した目標を達成するため\\n毎日一生懸命ずっと頑張っていた日々を、\\n彼女は未だに覚えている。")
	await novel_interface.show_text_only("厳しい訓練を頑張っていた理由は、誉める時に\\n見せてくれる父の笑顔が嬉しかったから……")
	await novel_interface.show_text_only("あまり暖かい家庭の話ではないが、寡黙な男は\\n粛々と彼女に訓練を行い、見守り続けてきた。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──いつか必ず来るであろう、\\n運命に備えるかのように。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("バイジュウが12歳の誕生日を迎えた時、\\nこのノートが入っていた匿名の小包と\\n父の死の知らせを受けた。")
	await novel_interface.show_text_only("市街地内のガス爆発によって、この少女の唯一の\\n家族は30人以上の命と共に失われたのだ。")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…………", "バイジュウ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("少女は唇を微かに動かし、声を出さずに\\nその名前を呼んだ。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("その名に隠された手がかりが、\\n彼女を揺り動かす。\\n父の死は決して世間が思うような\\n不慮の事故ではない。")
	await novel_interface.show_text_only("いつ来るか分からない危険を避けるため\\nたった1人となった少女は涙を拭き、\\n早く成長しなければならなかった。")
	await novel_interface.show_text_only("──父がノートに残したメッセージ\\n\\n「特殊能力を持っているバイジュウは………」\\n「必ずあの連中の標的になる」")
	await novel_interface.show_text_only("小包がバイジュウに届いたという事は、\\n\\n父がもうバイジュウを守る事が\\nできなくなってしまったという意味であった……")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（そんなに特別なものでしょうか、この能力…）", "バイジュウ")
	await novel_interface.show_dialog("（これは、呪いではないのでしょうか……）", "バイジュウ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("バイジュウは自分の手のひらを見た。\\n\\n銀色の光の粒子が、彼女の指の間で動いている。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("物心付いた時から、自分が他人と違うのを\\nバイジュウは知っていた──\\n特異体質になった原因は、本人にも分からない。")
	await novel_interface.show_text_only("幼い頃から数字に対する完全記憶能力と\\n超人的な暗算速度を会得していた。\\nまた、機械に対しても並々ならぬ興味があった。")
	await novel_interface.show_text_only("しかし体質を理由に、父は抑制を求める。\\n常に「普通の人」のように振舞いなさいと。")
	await novel_interface.show_text_only("父が亡くなった後、\\nバイジュウは自分を隠す事をやめた。")
	await novel_interface.show_text_only("1年後……とある名門大学が史上初の特例で、\\n彼女を新入生として招き入れた。")
	await novel_interface.show_text_only("しかし、いくら本の海に沈んでも\\n彼女の心底に隠された疑問に答えてくれた本や\\n授業は1つもなかった。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（なぜ、私は「違う」のでしょう……）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は思考と勉学に励み続けた。\\n\\n今まで抑えていた好奇心を\\nまるで一気に吐き出すかのように。")
	await novel_interface.show_text_only("たとえ自分が\\n「高慢」「冷淡」「付き合いづらい」\\nと他人からレッテルを貼られても、\\n彼女は特に意識しなかった。")
	await novel_interface.show_text_only("もちろん徐々に孤立していったが、\\nそんな事を彼女は気にも留めなかった。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（そうでなければ……）\\n\\n（あなたに出会う事はありませんでした……）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルク……\\n思いがけない経緯で知り合い、親友となった人。")
	await novel_interface.show_text_only("出会って数分足らずでバイジュウは推理できた。\\n\\nこの人は生徒を装い、キャンパス内の違法な\\n異質物研究を調べにきた調査員だと。")
	await novel_interface.show_text_only("相手は名前から経歴まで、\\n全てを偽装していると分かっているのに\\nその大らかな性格に惹かれてしまった。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（彼女は……「違う」）", "バイジュウ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("誰より自分の事を理解してくれている……")
	novel_interface.character_light()
	await novel_interface.show_dialog("（偽る事に、慣れている人なのに……）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("むしろ遠慮をする事なく、\\n自分に対して心を開いてくれた。")
	await novel_interface.show_text_only("だが、プライベートな付き合いが\\nミルクの背後にいる組織の注意を引いてしまう\\n結果になってしまうとは……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("「バイジュウがあの生物学者の養女である」\\n\\nと知ったミルクの上司はすぐさま彼女を\\n南極深海視察プロジェクトに誘った。")
	await novel_interface.show_dialog("（本当は、断るつもりたったのに……）", "バイジュウ")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("とあるタスクフォースの地下拠点。")
	await novel_interface.show_text_only("最終的に私を決心させたのは、\\nあのブリーフィングで見た印──")
	await novel_interface.show_text_only("──父のノートの中にもあったアノ印だ。")
	await novel_interface.show_text_only("とある秘密の宗教組織を表す、\\n不気味な黒い眼球のシンボル。")
	await novel_interface.show_text_only("父はその宗教組織と接触した事があり、\\n奴らは武装した異質能力者の組織を作りたい。\\nという意向を漏らしていたと、ノートには\\n記載されていた。")
	await novel_interface.show_text_only("その計画は『Ningen』という名前が\\n名付けられていた。")
	await novel_interface.show_text_only("孤児院にいた頃の記録のせいで\\nバイジュウは『Ningen』計画I類に指定され、\\n狙われる事となってしまう。")
	await novel_interface.show_text_only("あの危険な組織が父に目を付けたのは、\\nそれが原因に違いない。")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("（『Ningen』……南極 ）", "バイジュウ")
	await novel_interface.show_dialog("（南極基地『スノークイーン』……）\\n（『アンデルセン童話』の雪の女王……）", "バイジュウ")
	await novel_interface.show_dialog("デンマーク語ではSnedronningen。\\n\\nもしくは、Snedron-Ningen。", "バイジュウ")
	await novel_interface.show_dialog("（……ただの偶然のはずがない）", "バイジュウ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("あなたのBossは、あの連中と同じものに\\n目を付けたのでしょうか？", "バイジュウ")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("あんたの顔を見た感じ、その組織は\\n『ブラックリスト』に載ってる他の奴らより\\n厄介そうだね……", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウは頷いたが、この話題に関して\\n多くは語りたくなかった。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("ごめんなさい。\\n\\nこのプロジェクトに参加するのは、\\n私的な目的もあるからです。", "バイジュウ")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("分かってるって～～", "ミルク")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Bossからしてみると、バイジュウちゃんが\\n親父さんの海洋生物研究を続けてくれるなら\\n問題ないだろうしね。", "ミルク")
	await novel_interface.show_dialog("ウィンウィンだよ。win-winっ！", "ミルク")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("とは言え、バイジュウちゃんの私的な目的って…\\n\\nまさか私に惚れちゃって、この泥舟に乗り込んだ\\nとかじゃ～～？", "ミルク")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("だったら～私、すごくすごぉ～～く責任を\\n感じちゃうなぁ～～！", "ミルク")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミルクはそう言って白燕に向けて投げキスをすると、白朱は笑みを浮かべた。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("しかし、その時バイジュウは気付かなかった。\\n\\n──親友の澄んだ目が、微かに曇っていた事を。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("バイジュウは契約を交わした時の事を思い出し、\\n未だに自分を責めていた。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（私……彼女を利用してる）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バイジュウは机の前に座ってペンを取り出し、\\n広げたノートを見つめた。")
	await novel_interface.show_text_only("「利用できる人間こそ、価値がある」")
	await novel_interface.show_text_only("──少女はこう書いた。")
	await novel_interface.show_text_only("「あなたはかつてそう言った。」\\n\\n「そして私もずっとそう思ってた……」")
	await novel_interface.show_text_only("「遠慮なく他人を利用し、利用される……」\\n\\n「あなたから見れば、それは当然の事……」")
	await novel_interface.show_text_only("「唯一の違いは、誰の価値が、より高いか」")
	await novel_interface.show_text_only("「解釈も説明も不要。ただ目標を見つめるのみ」")
	await novel_interface.show_text_only("「こんな単純な関係であるからこそ」\\n\\n「多くの人と安全な距離を保つ事ができる」")
	await novel_interface.show_text_only("バイジュウは動きを少し止めた。")
	await novel_interface.show_text_only("しかし、あなたが言った通り、\\nこの世界には確かに存在している──")
	await novel_interface.show_text_only("「私に利用されたい彼女」\\n「彼女を利用したくない私」")
	await novel_interface.show_text_only("──少女は口元を噛みしめた。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（後ろめたい？）\\n（そんな感情はとっくに捨てたはず）", "バイジュウ")
	await novel_interface.show_dialog("（それは……好きだからでしょうか？）", "バイジュウ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は日記を閉じた。")
	await novel_interface.show_text_only("彼女は自分なりの答えを見つけたのだろうか。")
	await novel_interface.show_text_only("バイジュウは窓の外を眺めた。\\n\\n深い藍色の空は、より一層の闇に覆われ、\\n果てのない海と一体化しているように見える。")
	await novel_interface.show_text_only("──突然、艦内全域に緊急通知が鳴り響いた。")
	await novel_interface.show_text_only("緊急命令！緊急命令！　中央制御室から全員へ、\\n10分後に会議室に集合せよ！")
	await novel_interface.show_text_only("繰り返す、緊急命令……")
	await novel_interface.show_text_only("バイジュウは深く息を吐き、ノートを収めた後。\\n大きく外へと一歩を踏み出す。")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
