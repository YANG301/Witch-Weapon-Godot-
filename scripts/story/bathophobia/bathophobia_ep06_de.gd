# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Mariru steht am Rednerpult und gibt in der routinemäßigen Videokonferenz einen umfassenden Fortschrittsbericht zu den jüngsten Forschungsergebnissen.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Bezüglich Projekt Ark…", "Kirs")
	await novel_interface.show_dialog("Aus der von Salmonton bereitgestellten Liste der Relikte haben Sie sich für die Lapissäule von Tesheim entschieden, oder?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ja, Herr. Der Schlüssel liegt nun darin, einen kontrollierbaren Flussbereich zu erstellen.", "Mariru")
	await novel_interface.show_dialog("Alle jüngsten Fälle von Raumzeitflüssen in allen akademischen Städten wurden durch menschlichen Kontakt mit Gegenständen mit Substance H-Eigenschaften verursacht.", "Mariru")
	await novel_interface.show_dialog("Diese Elemente blieben lange Zeit inaktiv, wurden aber fast gleichzeitig aktiviert.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Genauer gesagt: Hexensplitter und Grimoire-Fragmente. Aber ich erkläre es besser in Laienbegriffen.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Du meinst den Tag, an dem der Ross-Kelch verschwand ...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Wir können ihre Verbindung noch nicht bestätigen.", "Mariru")
	await novel_interface.show_dialog("Da es zu viele unkontrollierbare Faktoren gibt, müssen wir alle Relikte nach zwei Kriterien filtern.", "Mariru")
	await novel_interface.show_dialog("Erstens muss es sich um eine Substanz mit geringer Aktivität handeln, die laut Farbtonscan Substance H-Eigenschaften aufweist.", "Mariru")
	await novel_interface.show_dialog("Zweitens ist der ursprüngliche Eigentümer in historischen Aufzeichnungen nachweisbar und diese Person darf keine Tendenzen zur Gewalt oder zur Begehung krimineller Handlungen aufweisen.", "Mariru")
	await novel_interface.show_dialog("Die Tesheimer Lapissäule war ursprünglich im Besitz von Heinrich Khunrath, einem Arzt und Alchemisten der Renaissance.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Geringe Aktivität … Schade … Ich hatte erwartet, dass wir dieses Mal Daten sammeln könnten, die näher am kritischen Wert liegen.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Die Probe ist zu wertvoll, um sie zu verlieren. Es ist besser, auf der sicheren Seite zu bleiben.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Ich muss nur Rens Fähigkeit beweisen, Flussgebiete zu durchqueren. Dafür müssen wir nur eine Show aufführen.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Tatsächlich handelt es sich bei der Lapissäule von Tesheim nicht um einen Hexensplitter.) \\n(Es handelt sich quasi nur um einen Substance H mit magischen Inschriften darauf.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Eine Hexenscherbe zu berühren ist für normale Menschen viel zu gefährlich.) \\n(Schließlich bin ich nicht der Gorilla-Mann ...)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein tiefes Gelächter ertönt vom Bildschirm.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alchemist ... Ein Pionier der Wissenschaft, oder? \\nWas für eine interessante Wahl.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ich habe gehört, dass es sich um ein Kunstwerk von großer historischer Bedeutung handelte und der Besitzer Heinrich einer der Gründer des Rosenkreutz war …", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Der Rosenkreutz war lediglich eine religiöse und okkulte Gruppe. Es hat nichts mit dem aktuellen Geheimdienst von Salmonton zu tun.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ich denke, Alchemisten können als die Wissenschaftler dieser Zeit angesehen werden. Hoffentlich war er ein Mann, der Ehrfurcht vor dem Unbekannten hatte.", "Mariru")
	await novel_interface.show_dialog("Aber Sie kennen Dr. Dekkers gut. Er würde uns niemals eine so wichtige Reliquie kostenlos leihen, es sei denn ...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eine unheimliche Stille erfüllt den Raum.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Das ist richtig. Die Salmonton-Seite möchte den Datenaustausch sowie einen Vertreter in unserem Team.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Sie haben also nicht aufgegeben, mehr Hexen hervorzubringen …) \\n(Wollen sie Ren als Stabilisator verwenden?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Gut notiert. Ich möchte nur bestätigen, dass jeder, einschließlich der Salmonton-Seite, die Gefahr dieses Experiments versteht.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Bejahend. Für den Fall, dass das schlimmste Szenario eintritt, haben wir die riesigen unterirdischen Entwässerungsanlagen der alten Hauptstadt in die Ark-Basis umgewandelt.", "Kirs")
	await novel_interface.show_dialog("Das ultraschnelle Meerwasser-Intrusionssystem kann die gesamte Basis innerhalb von 30 Sekunden überschwemmen.", "Kirs")
	await novel_interface.show_dialog("Wenn während des Experiments etwas schief geht ...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("In diesem Fall hoffe ich, dass unser lieber Mariru den Mut hat, die Notfall-Selbstzerstörungsvorrichtung zu starten.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
