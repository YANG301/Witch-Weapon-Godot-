# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("哈啾……", "白燭")
	await novel_interface.show_text_only("獨自趴在桌前昏昏欲睡的少女打了個噴嚏，一下子清醒過來。")
	await novel_interface.show_text_only("潛艇所在的海域正處於永夜後期，僅憑天色無法分辨出時間。")
	await novel_interface.show_text_only("看了看螢幕上的訊息，白燭才意識到，距離她在深海見到那個怪物，僅僅過了幾個小時。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("……這樣，真的好嗎？", "白燭")
	await novel_interface.show_dialog("（為了尋找真相……而利用她。 ）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女不自覺地望向手中攤開的筆記本。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（如果是父親的話……）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("——如果是那個男人的話，根本不會為了這種情感而動搖吧。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("回想起父親寬厚的手掌，少女漸漸握緊了拳頭。")
	await novel_interface.show_text_only("這本記錄了大量艱深文字的筆記，原本屬於她的養父。")
	await novel_interface.show_text_only("他是個身材高大、沉默而認真的生物學家，無論對自己還是對白燭都很嚴格。")
	await novel_interface.show_text_only("由於白燭體質特殊，父親從小就要求她在學習之餘還得接受嚴格的訓練。")
	await novel_interface.show_text_only("少女還記得，小時候為了達到父親所設定的目標，自己每天都拼了命努力練習。")
	await novel_interface.show_text_only("而她最期待的，就是父親偶爾卸下嚴肅的表情，對自己露出認同的微笑。")
	await novel_interface.show_text_only("或許沒有太多溫情，但這個沉默寡言的男人一直默默地訓練並保護著她……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──就像是在為了某種必定到來的命運做好準備。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("在白燭十二歲生日那天，她收到了裝有這本筆記的匿名包裹──以及自己父親的死訊。")
	await novel_interface.show_text_only("一次市區內的瓦斯爆炸，讓少女唯一的親人與另外三十多條生命瞬間消逝。")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("……", "白燭")
	novel_interface.character_dark()
	await novel_interface.show_text_only("少女嘴唇微張，無聲地念出那個名字。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那名字背後的線索讓她意識到，父親的死絕非官方認定的意外事故。")
	await novel_interface.show_text_only("隻身一人的小女孩必須擦乾淚水並快快長大，以躲避不知何時降臨的危險。")
	await novel_interface.show_text_only("——父親筆記中留下的訊息表示，擁有特殊能力的白燭，一定會成為那群傢伙的目標。")
	await novel_interface.show_text_only("如果這個包裹被寄出，就代表自己無法繼續保護她了……")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（人們就這麼在意……這種能力嗎……）", "白燭")
	await novel_interface.show_dialog("（這，難道不是詛咒嗎……）", "白燭")
	novel_interface.character_dark()
	await novel_interface.show_text_only("白燭看了看自己的手心，幾個銀色的小光團在她的指縫間跳動。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("自從有記憶起，白燭就知道自己與眾不同──但並非因為她的異常體質。")
	await novel_interface.show_text_only("她從小就對數字過目不忘，心算速度遠遠超乎常人，同時對機械也有濃厚的興趣。")
	await novel_interface.show_text_only("由於這些特殊能力，父親從小就要求她必須低調收斂，並且偽裝成一個「普通人」。")
	await novel_interface.show_text_only("自從父親死後，白燭決定不再隱藏自己。")
	await novel_interface.show_text_only("一年後，她成為一所歷史悠久的大學多年來首次破例特招的新生。")
	await novel_interface.show_text_only("但就算埋首書堆，依舊沒有任何書本或課程能解答她心中的疑問。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（為什麼，我是「不一樣」的……）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女不斷地思考和學習，好像要把壓抑多年的好奇心一口氣全釋放出來。")
	await novel_interface.show_text_only("她沒有意識到，這樣的自己會被貼上「高傲」、「冷淡」和「難相處」的標籤。")
	await novel_interface.show_text_only("雖然漸漸被孤立，但她並不在意。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（不然，我也不會遇見你……）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("思儀，她在一場意外中結識的好友。")
	await novel_interface.show_text_only("只花了幾分鐘，白燭就推理出對方是偽裝成學生進入校園調查非法異質物研究的調查員。")
	await novel_interface.show_text_only("明知對方可能從名字到經歷全是偽造的，卻被她那種大剌剌的性格所吸引。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（她是……「不一樣」的。 ）", "白燭")
	novel_interface.character_dark()
	await novel_interface.show_text_only("比任何人更加瞭解自己……")
	novel_interface.character_light()
	await novel_interface.show_dialog("（明明就是習慣了偽裝的傢伙……）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("卻毫無保留地對自己敞開了心扉。")
	await novel_interface.show_text_only("只是，她們倆都沒料到，單純的私下來往會引起牛奶背後組織的注意。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("牛奶的上級得知白燭是那位生物學家的養女後，很快就向她提出南極深海考察專案的邀請。")
	await novel_interface.show_dialog("（本來是打算拒絕的……）", "白燭")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("在特遣隊的某個地下站點。")
	await novel_interface.show_text_only("最終讓我下定決心的，是在任務簡述上看到的那個標誌──")
	await novel_interface.show_text_only("那個在父親的筆記中曾經出現的標誌。")
	await novel_interface.show_text_only("一個代表著祕密宗教組織、令人毛骨悚然的黑色眼球符號。")
	await novel_interface.show_text_only("筆記中記載著，父親曾與那個組織接觸過，當時對方流露出想要組織異質能力者武裝部隊的想法。")
	await novel_interface.show_text_only("相關的計劃被命名為「Ningen」。")
	await novel_interface.show_text_only("根據白燭在孤兒院時留下的記錄，她的名字當時就在「Ningen」計劃I類目標的名單上。")
	await novel_interface.show_text_only("父親也因此成為這個危險組織的眼中釘。")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("（「Ningen」……南極。 ）", "白燭")
	await novel_interface.show_dialog("（我記得南極的白皇后基地……）\\n（命名取自《安徒生童話》中的冰雪女王。 ）", "白燭")
	await novel_interface.show_dialog("丹麥語：Snedronningen，\\n或者是：Snedron-Ningen。", "白燭")
	await novel_interface.show_dialog("（這絕對不是巧合。 ）", "白燭")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("妳的Boss和那群傢伙看上了同樣的東西嗎？", "白燭")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("看妳的表情，這個組織似乎比「黑名單」上的其他傢伙還麻煩啊……", "牛奶")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("白燭點了點頭，但並不想深談。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("抱歉，就算我參與這個專案，也是出於私心。", "白燭")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("我知道啊～", "牛奶")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("可對我家Boss來說，只要妳能延續妳父親對海洋生物的研究就可以了。", "牛奶")
	await novel_interface.show_dialog("魚幫水，水幫魚嘛～", "牛奶")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("小白燭的私心……該不會是因為被我迷倒，才決定上了這艘賊船吧？", "牛奶")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("唉啊～如果是這樣，那我可是非常非常有壓力的唷～", "牛奶")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("牛奶說著朝著白煙拋了個飛吻，白燭被逗得撲哧一笑。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("但白燭並沒有注意到，當時她好友清澈的眼神中閃過了一絲陰霾。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("回想起簽約時的情形，白燭還是一陣自責。")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("（我……在利用她。 ）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("白燭坐在桌前抽出筆，盯著攤開的筆記本。")
	await novel_interface.show_text_only("「能夠被利用的人，才有價值。 」")
	await novel_interface.show_text_only("——少女這樣寫道。")
	await novel_interface.show_text_only("「您曾經這麼說過，我也一直是如此認為的……」")
	await novel_interface.show_text_only("「毫無壓力地利用別人，或者被利用，」\\n「在您看來，是一件理所當然的事情……」")
	await novel_interface.show_text_only("「區別只在於，誰的價值更高。 」")
	await novel_interface.show_text_only("「無須解釋、無須說明，只要鎖定目標。 」")
	await novel_interface.show_text_only("「只有這樣單純的關係，才能和大多數人保持安全的距離。 」")
	await novel_interface.show_text_only("白燭頓住了。")
	await novel_interface.show_text_only("可是，正如您所說，世界上還是有那種——")
	await novel_interface.show_text_only("「無論如何也希望被我利用的存在。 」\\n以及「無論如何也不願意利用她的存在。 」")
	await novel_interface.show_text_only("少女想到這裡，嘴角微微揚起。")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("（愧疚嗎？ 明明應該是被捨棄的情緒。 ）", "白燭")
	await novel_interface.show_dialog("（那是……喜歡嗎？ ）", "白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女闔上了日記。")
	await novel_interface.show_text_only("她已經找到了自己的答案。")
	await novel_interface.show_text_only("白燭望向窗外，深藍黯淡的天空變得更加深邃，幾乎和漫無邊際的海水融為一體。")
	await novel_interface.show_text_only("忽然，全艦響起了緊急警報。")
	await novel_interface.show_text_only("指令變更！ 控制中心呼叫全體成員，十分鐘後會議室集合。")
	await novel_interface.show_text_only("重複，指令變更……")
	await novel_interface.show_text_only("白燭深深地呼了一口氣，收好筆記本，大步朝外走去。")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
