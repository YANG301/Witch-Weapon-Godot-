# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Raphael encontró algunos tanques de diésel en el segundo piso, que deberían poder mantener el depósito en funcionamiento durante unos días.")
	await novel_interface.show_text_only("Cuando vuelve la luz en medio del ruido sordo del generador, corro al baño inmediatamente.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Usar un baño en la oscuridad definitivamente sería lo último que quisiera hacer…)", "Lian")
	await novel_interface.show_dialog("(Gracias a Dios no lo hicieron un baño transparente…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Santa mierda…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Salgo del baño, todavía me duele el estómago. Annie parece un poco recuperada y puede volver a ponerse de pie.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, ¿estás bien?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Sí, estoy bien. Vamos a revisar la sala de comunicaciones...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como apenas puede mantenerse erguida, la ayudo hasta el segundo piso.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("La sala de comunicaciones tiene un interior bastante rústico, donde un pasillo en forma de T conduce hasta la pared curva del área de observación.")
	await novel_interface.show_text_only("Los armarios están llenos de agua potable, comida enlatada y otros alimentos no perecederos.")
	await novel_interface.show_text_only("El aire aquí parece bastante fresco. A través de la ventana podemos ver las auroras bailando en el cielo nocturno.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("A ver si el sistema funciona...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intenta poner en marcha el equipo antiguo en el panel de operaciones. Afortunadamente, todo el hardware que prioriza la confiabilidad todavía funciona.")
	await novel_interface.show_text_only("Como agente SID bien capacitado, Annie está bastante familiarizado con el sistema. Las antenas instaladas fuera del depósito no parecen muy afectadas por las temperaturas extremas.")
	await novel_interface.show_text_only("A través de las rejillas de ventilación de la pared, un flujo de aire cálido y húmedo entra lentamente en la habitación.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Parece que el sistema de calefacción está encendido.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro la pantalla de temperatura fijada en la pared, que muestra que la temperatura interior aumenta constantemente desde 32°F.")
	await novel_interface.show_text_only("Pero la temperatura exterior… ¡¿-44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Si no hubiera sido por el topacio de Heinrich...", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Usar falda a una temperatura de -44°F y jugar en la nieve…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Supongo que he desbloqueado un nuevo logro del que presumir…)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Espera… Será mejor que nos pongamos en contacto con Mariru lo antes posible. Sólo ella puede sacarnos de aquí.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Hablando de esto, ¿qué le pasa al chip?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toco mi pecho instintivamente. Nunca había tenido tantas ganas de escuchar la voz de Mariru desde allí.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Conectándose a satélites… Listo.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Siguiendo las instrucciones de Annie, introduzco una serie de números que están grabados en mi mente desde hace mucho tiempo.")
	await novel_interface.show_text_only("Supongo que debo agradecer a Mariru por obligarme a aprenderme los códigos de identificación cifrados de SID de memoria.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("¡Así es como funciona! Interesante…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Desde que llegamos al depósito, Heinrich ha estado muy absorto observando los materiales y artículos almacenados aquí.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("¡Siempre quise sentirlos en mis manos!", "Henriette")
	await novel_interface.show_dialog("Qué maravillosa combinación de arena, aluminio, calcio, metales combustibles y basalto…", "Henriette")
	await novel_interface.show_dialog("Y el proceso de fibrización ha cambiado todas sus propiedades.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Mmmm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Utilizaron una nueva combinación de materiales para fabricar este vidrio. Es algo de lo que nunca he oído hablar.", "Henriette")
	await novel_interface.show_dialog("Su método puede prevenir la pérdida de calor... Eso es realmente inteligente.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Pero nosotros, los alquimistas, preferiríamos utilizar las inscripciones de conversión de energía, que son mucho más fáciles.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Inscripciones… ¿Te refieres a la magia?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(¡¿Quién usaría magia para hacer un trozo de vidrio?! ¡Puedes perder la cabeza por ello!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Pero los productos de caucho en paquetes pequeños realmente me han impresionado por su extraordinaria flexibilidad.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Y las fragancias frutales… ¿Para qué sirven?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡¡Yo… no lo sé!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Es sólo chicle, estúpido pervertido.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me pone los ojos en blanco.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡Por el amor de Dios, Heinrich se ha sumergido completamente en el mundo de la alquimia!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("De vuelta en la sede, Mariru y Aya están buscando a Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Todavía no hay señales del chip de Ren. Eso es raro. El grupo de satélites cubre literalmente todos los rincones del mundo...", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿Podría ser teletransportación extraterrestre o distorsión del tiempo?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Como dice el refrán, \"las entidades no deben multiplicarse más allá de lo necesario\". Es más probable que las suposiciones más simples sean correctas.", "Mariru")
	await novel_interface.show_dialog("De hecho, los llamados \"satélites globales\" cubren sólo entre 70°N y 70°S.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quieres decir...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente aparece una confirmación de conexión a través del canal de comunicación cifrado de SID.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("¿Hola?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! ¡¡Soy yo!! \\nDios mío, finalmente…", "Lian")
	await novel_interface.show_text_only("Al escuchar la voz familiar, Mariru pronto vuelve en sí. La tensión parece desaparecer instantáneamente.")
	await novel_interface.show_text_only("Con los ojos fijos en la señal fuera de línea, inmediatamente inicia el procedimiento de rastreo.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("¿Ren? Informe su ubicación. \\n¿Estás con las otras chicas?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sí, ahora estoy en un depósito con Raphael y Annie. \\nEstamos a salvo aquí, pero...", "Lian")
	await novel_interface.show_dialog("Ahora estamos… en la Antártida.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("¿Antártida?", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Claramente es una respuesta que supera las expectativas, pero no hay ningún atisbo de sorpresa en el rostro de Mariru.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Parece que Ren no sufre hipotermia). \\n(Deben haber encontrado un lugar seguro).", "Mariru")
	await novel_interface.show_dialog("(¿Hubo otro flujo de espacio-tiempo durante el experimento en la Base Arca?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("El resultado del rastreo aparece en la pantalla: No. 2 Depósito conjunto en Tierra de la Princesa Isabel, Antártida Oriental.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Todo tiene sentido ahora... Los satélites en órbita terrestre baja no pasarán sobre esa área a menos que sus órbitas se modifiquen manualmente.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Porque el viento solar polar interrumpirá la transmisión de datos.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Lo pasé por alto por completo…", "Ai")
	await novel_interface.show_dialog("¿Conectamos los satélites sobre la Antártida?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-hum. Recuerda, no despiertes a esos perros viejos que duermen.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("No sé qué pasó... Me trajeron aquí de repente.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Además de ustedes tres, ¿hay alguien más?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("¿Te refieres a Enrique? \\nElla está justo a mi lado.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("No esperaba que pudiéramos hacer contacto con Mariru a través de un equipo tan antiguo. Debo admitir que la voz de Mariru me ha dado un gran alivio.")
	await novel_interface.show_text_only("Le informo sobre la situación actual.")
	await novel_interface.show_dialog("…muy bien anotado.", "Mariru")
	await novel_interface.show_dialog("Escucha, ahora estás muy cerca del Polo Sur, lo que significa que recogerte no es tan fácil.", "Mariru")
	await novel_interface.show_dialog("Según la Nueva Convención Antártica de posguerra, cualquier país que quiera enviar un equipo de expedición de más de 5 miembros…", "Mariru")
	await novel_interface.show_dialog("… O un avión allí, tiene que pedir permiso al Congreso Unido.", "Mariru")
	await novel_interface.show_dialog("Y el avión probablemente tendrá que hacer escala en Nueva Australia…", "Mariru")
	await novel_interface.show_dialog("Así que incluso si conseguimos despegar en 1 hora y realizamos todos los procedimientos durante el vuelo, tardaremos unas 40 horas en llegar.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Eso estará bien. El generador aquí puede durar unos días y tenemos suficiente comida para sobrevivir.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La plataforma más cercana a ustedes está a 68° 24' S y 76° 55' E, aproximadamente a media milla de ustedes.", "Mariru")
	await novel_interface.show_dialog("Dadas las condiciones climáticas impredecibles en la Antártida, podemos perder el contacto con ustedes en cualquier momento. Si eso sucede, recuerda que te veré allí.", "Mariru")
	await novel_interface.show_dialog("Es una base grande llamada Snedronningen, que literalmente significa la reina de las nieves\\ny la mayoría de sus instalaciones fueron construidas bajo tierra...", "Mariru")
	await novel_interface.show_dialog("En cuanto a los detalles… los mantendremos informados. Ren,… estoshig rrrerrk…", "Mariru")
	await novel_interface.show_text_only("La voz de Mariru es tragada por un repentino ruido eléctrico.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? ¿Hola?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("¿Hola? ¿Puedes oírme?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El ruido en el centro de comunicaciones es cada vez más fuerte.")
	await novel_interface.show_dialog("Puede que haya una ráfaga de viento solar... Será mejor... comprobar la recepción de la señal ahora.", "Mariru")
	await novel_interface.show_text_only("Vaya——")
	await novel_interface.show_text_only("A medida que el ruido de la electricidad se vuelve más fuerte, la voz de Mariru desaparece del receptor.")
	await novel_interface.show_text_only("Un silencio se cierne sobre nosotros.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Supongo… hemos perdido el contacto con ellos otra vez…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¿Cuarenta horas? Será mejor que reces para que no haya más sorpresas.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me da mala vibra pero no sé por qué.")
	await novel_interface.show_text_only("Fuera de la ventana, todas las auroras se han ido con las señales que se desvanecen e incluso el débil viento ha amainado.")
	await novel_interface.show_text_only("Los únicos sonidos que escuchamos ahora provienen de los radiadores de la computadora y los ventiladores del aire acondicionado.")
	await novel_interface.show_text_only("Un silencio así siempre me recuerda la calma antes de la tormenta...")
	await novel_interface.show_text_only("De repente, el panel de operaciones tiembla un poco.")
	await novel_interface.show_text_only("No, eso es imposible. Debo haber perdido el equilibrio hace un momento.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… ¿Sentiste eso?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Te refieres a...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El ligero temblor se vuelve cada vez más violento.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Dios mío… ¡¿Estás bromeando?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sosteniendo el panel de operaciones como apoyo, siento que mi corazón da un vuelco.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("¿Qué son estos…?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un rugido surge del suelo bajo nuestros pies.")
	await novel_interface.show_text_only("El edificio empieza a temblar tan violentamente que apenas podemos mantenernos erguidos.")
	await novel_interface.show_text_only("Todo lo que está sobre la mesa rebota como Pop Rocks disolviéndose en la boca.")
	await novel_interface.show_text_only("Un horrible crujido llega desde los glaciares a lo lejos.")
	await novel_interface.show_text_only("Una mirada por la ventana confirma mi miedo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¡Es un terremoto!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
