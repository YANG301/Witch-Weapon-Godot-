# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("牛奶回到監控室，用椅子將大門卡死。")
	await novel_interface.show_text_only("最近一組敵人再幾十秒就會抵達這裡，而東翼的隊友也會在兩三分鐘內遭遇另一組敵人。")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("是啊，我早該想到的……","牛奶")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("如果我有一群行動力驚人、聽覺異常敏銳，還有超強恢復能力的士兵的話──")
	await novel_interface.show_text_only("為什麼只給她們配備冷兵器呢？")
	await novel_interface.show_text_only("需要團隊行動，只能以超強的個體戰鬥力彌補戰術上的不足。")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("那些東西，早就不能稱為「人」了啊……","牛奶")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("牛奶看了看主控台左側的一排控制器，上面是白燭剛剛留在那裡的樣本箱。")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("枉費小白燭這麼努力，可惜任務已經不重要了……","牛奶")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("不過，這裡的攻擊性防禦策略還是挺全面的～","牛奶")
	await novel_interface.show_dialog("希望那個擴音器還能用。","牛奶")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女深吸一口氣後，毫不猶豫地在控制器前輸入一連串指令……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("昏暗的倉庫內，白燭焦急地不斷摸索著。")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("密碼……\\n密碼是……","白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女的手指顫抖個不停，無法準確按下倉庫內壁上的按鍵。")
	await novel_interface.show_text_only("如果能輸入正確的密碼，就能夠出去與好友並肩作戰。")
	await novel_interface.show_text_only("但是這次，另一側的牛奶沒有留下任何可以破解密碼的提示。")
	await novel_interface.show_text_only("又或者，再也不會給她任何提示了……")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("不可能！ ！！ \\n不可能不可能不可能不可能不可能不可能……","白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("即使白燭不計後果地瘋狂敲擊著金屬閘門，她所期望的那一幕仍舊沒有發生。")
	await novel_interface.show_text_only("在黑暗寂靜的密閉空間內，少女停下了動作，想像著接下來門的另一側會發生什麼情形。")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("不，我不能接受……","白燭")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("（是因為……）","白燭")
	await novel_interface.show_dialog("（我沒有足夠的力量嗎……）","白燭")
	await novel_interface.show_dialog("（父親也是……牛奶也是……）","白燭")
	await novel_interface.show_dialog("（為什麼……會這樣……）","白燭")
	await novel_interface.show_dialog("（無力。 ）","白燭")
	await novel_interface.show_dialog("（弱小。 ）","白燭")
	await novel_interface.show_dialog("（……又自私。 ）","白燭")
	await novel_interface.show_dialog("（為什麼？ ）","白燭")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("我只是想要一些些溫暖而已……")
	await novel_interface.show_text_only("為什麼連如此渺小的願望也無法成真……")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("黑暗中，少女泣不成聲。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("白燭沒有意識到剛剛接二連三的高強度戰鬥，已經讓自己的體力嚴重透支。")
	await novel_interface.show_text_only("深海後遺症逐漸將她的心智淹沒。")
	await novel_interface.show_text_only("腦內轟鳴的水聲一點一滴地將她的精神抽離。")
	await novel_interface.show_text_only("或許在黑暗的深海中，她並沒看到那個存在……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("少女彷彿置身冰川當中，細密而尖銳的冰磧深深地刺穿了她的心。")
	await novel_interface.show_text_only("她柔軟的身體逐漸變得冰冷，血液似乎也開始凝結。") #换行问题
	await novel_interface.show_text_only("無數純自的光團環繞在周圍，直到完全覆蓋了她的存在。")
	await novel_interface.show_text_only("痛苦也好，孤獨也好。")
	await novel_interface.show_text_only("都不存在了。")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("在一片純白中，忽然響起一個熟悉的旋律。")
	await novel_interface.show_dialog("……牛奶？","白燭")
	await novel_interface.show_text_only("那是她和牛奶最喜歡的歌。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("突然，數百個光團從白燭的體內爆發而出──")
	await novel_interface.show_text_only("少女逐漸睜開眼睛，隨著刺眼的白光和一聲巨響，厚重的金屬門已經被吹飛。")
	await novel_interface.show_text_only("監控室的擴音器正播放著牛奶手錶裡的歌，音樂在隧道中迴盪。")
	await novel_interface.show_text_only("幾十名循聲而來的敵人聚集在附近，看來，基地裡潛伏的敵人遠比她們剛剛看到的更多。")
	await novel_interface.show_text_only("十幾名敵人已經聚在監控室門前──")
	await novel_interface.show_text_only("此時少女距離監控室只有三十公尺左右的距離。")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("（只要十秒……不，五秒！ ）","白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她就可以出現在好友面前，阻止她做傻事。")
	await novel_interface.show_text_only("大群寄生士兵立刻湧向了白燭，幾柄利刃突然從她身後襲來。")
	await novel_interface.show_text_only("白燭轉身從槍刃中射出數發伴隨著強光的霰彈，瞬間將幾個敵人打成黏在牆上的碎漿。")
	await novel_interface.show_text_only("她毫無停頓地朝著監控室狂奔，身上散發著陽光般閃耀的光芒。")
	await novel_interface.show_text_only("奔跑中的巨大氣場使得隧道內壁不停剝落，她身上閃耀的強光像是一曲神聖的輓歌。")
	await novel_interface.show_text_only("已經沒人能阻止這股力量了……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("此時，從白皇后基地射出無數道強光，連永夜的夜空也被照耀得恍若白晝。")
	await novel_interface.show_text_only("這一切，似乎在迎接神明的降臨。")
	await novel_interface.show_text_only("突然間，整個大陸板塊開始顫抖……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("在短短數秒內斬殺幾十名敵人的白燭，視野逐漸被光斑所浸染。")
	await novel_interface.show_text_only("體內激昂的力量似乎快要連她一同吞噬。")
	await novel_interface.show_text_only("就在少女右手的利刃劃開一名敵人的瞬間。")
	await novel_interface.show_text_only("十幾名敵人同時攻破了監控室的大門並一擁而入—")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("笨蛋……等我……","白燭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("「我來了……」")
	await novel_interface.show_text_only("轟——！")
	await novel_interface.show_text_only("少女眼前的監控室，先是釋放出一道巨大的電弧，隨後在一秒內傳出數十次強烈的爆炸。")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("時間彷彿就停滯在那瞬間了。")
	await novel_interface.show_text_only("少女距離監控室僅僅幾公尺，踉蹌著停住了步伐。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("此時，這片毫無慈悲、終年被冰層覆蓋的大陸，向大夢初醒般睜開了眼睛。")
	await novel_interface.show_text_only("黑暗中，一個金色影子從地底冰層飛出，一直向上衝破了隧道地板，同時無聲地貫穿了少女身體。")
	await novel_interface.show_text_only("那是一支樣式樸素的長槍，只在槍頭鑲著金色的滾邊。")
	await novel_interface.show_dialog("……","白燭")
	await novel_interface.show_text_only("一股溫暖的熱流劃過槍尖，順著槍身，和血液融合在一起。")
	await novel_interface.show_text_only("少女的雙手無力垂下，心有不甘地盯著前方，瞳孔卻逐漸開始渙散。")
	await novel_interface.show_text_only("血滴滴答答地落到地上……")
	await novel_interface.show_text_only("──啪嗒。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("極地的閃光熄滅了。")

	print("=== 深海恐惧症篇第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
