# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Milk returns to the control room and jams the main door with a chair.")
	await novel_interface.show_text_only("The closest group of enemies will arrive in mere minutes. The other group will come upon Milk’s squad in the east wing soon as well.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Hmm. I should have thought of this earlier...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("If I had my own troop of extremely agile soldiers with sharp hearing and incredible self-healing abilities...")
	await novel_interface.show_text_only("Why equip them with blades and not firearms?")
	await novel_interface.show_text_only("These enemies move in groups, have no strategy to speak of, even though they’re all insanely effective fighters.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("They can no longer be considered human, these girls...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk glances over at the row of equipment to the left of the main control panel. On it sits the specimen box Beth has left behind.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("The mission... it doesn’t matter anymore.","Milk")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("I guess the strategic offensive defense measures employed here aren’t too bad after all...","Milk")
	await novel_interface.show_dialog("I hope the speaker still works...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She takes a deep breath, steadies herself, before keying in a series of commands in the control panel...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Meanwhile, in the dark warehouse, Beth flutters around the room, frantically searching for something that might not even be there.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("The password...\\nWhat’s the password?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With her fingers trembling, she barely has any idea what keys she’s pressing on the lock panel anymore.")
	await novel_interface.show_text_only("If she gets the password right, she can exit the warehouse and fight alongside her friend.")
	await novel_interface.show_text_only("But Milk, on the other side of the wall, did not leave any hints as to what the password could be.")
	await novel_interface.show_text_only("Perhaps she’ll never leave her another hint again...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("No! No!\\nI can’t accept this! I won’t accept this!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frenzied, Beth continues pummeling on the door with her fists, but her attempts to break out are futile.")
	await novel_interface.show_text_only("All she can do is imagine what will happen next at the other side of the wall, all alone in the dark, silent, confining space.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Please, no...","Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(I’m useless...)","Beth")
	await novel_interface.show_dialog("(Can’t save anyone...)","Beth")
	await novel_interface.show_dialog("(Not Father... not Milk...)","Beth")
	await novel_interface.show_dialog("(How... did this happen...?)","Beth")
	await novel_interface.show_dialog("(Why am I so weak...?)","Beth")
	await novel_interface.show_dialog("(So helpless...)","Beth")
	await novel_interface.show_dialog("(... And selfish.)","Beth")
	await novel_interface.show_dialog("(Why?)","Beth")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("All I want is to not be lonely, not be cold...")
	await novel_interface.show_text_only("I’m not asking for too much, am I...?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl sits alone in the dark, shoulders shaking with sobs.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("She hardly notices that the continuous intense combat has exhausted her body to the core.")
	await novel_interface.show_text_only("Decompression sickness is muddling up her brain.")
	await novel_interface.show_text_only("It’s like there’s water churning in her head, messing with her consciousness bit by bit.")
	await novel_interface.show_text_only("Perhaps she didn’t see that being in the dark, deep ocean, after all...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("She feels like she’s on top of a glacier—nay, inside one. The ice, sharp and dense, pierces through her heart, her soul.")
	await novel_interface.show_text_only("Her supple body freezes, little by little, and her blood begins to congeal.") #换行问题
	await novel_interface.show_text_only("Countless pure light groups surrounded her until they completely covered her existence.")
	await novel_interface.show_text_only("There’s no longer pain, no longer loneliness.")
	await novel_interface.show_text_only("No more.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("In this world of pure white, she hears a familiar melody.")
	await novel_interface.show_dialog("... Milk?","Beth")
	await novel_interface.show_text_only("That’s their favorite song. Their song.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("In an explosive burst, hundreds of glowing orbs fly out of Beth’s body.")
	await novel_interface.show_text_only("The girl blinks open her eyes. The blinding white light, in a deafening boom, has blown the entire wall away.")
	await novel_interface.show_text_only("The speaker in the control room is playing their song, echoing all the way down the tunnel. Milk must have used the audio file she stored in her watch.")
	await novel_interface.show_text_only("Dozens of enemies have gathered, attracted by the sound. So many of them, far more than they had counted on the screen.")
	await novel_interface.show_text_only("The enemies have surrounded the entrance of the control room.")
	await novel_interface.show_text_only("Beth is a mere thirty meters from the control room now.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(All I need is ten seconds... no, five...)","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Five seconds to reach her idiot best friend, stop her from doing whatever she’s gonna do.")
	await novel_interface.show_text_only("A large group of parasitic soldiers immediately swarmed towards Bai Zhu, and several sharp blades suddenly attacked from behind her.")
	await novel_interface.show_text_only("She turns around, firing several rounds of bullets in the form of bright beams of light, blasting her targets into smithereens on the wall.")
	await novel_interface.show_text_only("She continues dashing towards the control room, body glowing in a light, brighter than ever before.")
	await novel_interface.show_text_only("The energy waves radiating from her body tear off the inner walls of the tunnel. She glows, blindingly, like a requiem from the Heavens.")
	await novel_interface.show_text_only("No one can stop her now.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("Countless shattering white beams shoot out from Snedronningen Base, lighting up the starry skies, as if dawn has fallen on the slumbering continent.")
	await novel_interface.show_text_only("Like a welcoming rite for a deity, almost.")
	await novel_interface.show_text_only("Suddenly, the whole continent begins to quake...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("In a mere few seconds, Beth has slain dozens of enemies all at once. She falls back, vision clouded by the flaring light.")
	await novel_interface.show_text_only("The power surging from her body is close to swallowing her whole.")
	await novel_interface.show_text_only("As she throws an enemy out of the way with the blade in her right hand...")
	await novel_interface.show_text_only("A dozen of enemies crash through the jammed door of the control room and charge inside.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Wait for me... idiot...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("“I’m coming...”")
	await novel_interface.show_text_only("Boom!")
	await novel_interface.show_text_only("A gigantic electric arc shoots out from the control room. Then the explosions come, countless flaming explosions in a second, right in front of Beth’s eyes.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("It’s like time is standing still.")
	await novel_interface.show_text_only("She stops in her tracks, falling to her knees, only meters away from the control room.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("That’s when this icy continent, ruthless and cold, finally opens its eyes from its never-ending slumber.")
	await novel_interface.show_text_only("In the darkness, a golden shadow bursts out from the underground ice layers, rips through the ground of the tunnel, silently pierces through the girl’s torso.")
	await novel_interface.show_text_only("It’s a spear, plain-looking if not for the intricate gold patterns swirling around the spearhead.")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_text_only("A warm stream of heat crossed the tip of the gun, followed the gun body, and merged with the blood.")
	await novel_interface.show_text_only("Her arms fall limply to her sides. Even as her pupils dilate, she glares, like she’s not ready to give up yet.")
	await novel_interface.show_text_only("On the ground, crimson blood.")
	await novel_interface.show_text_only("Drip. Drip. Drip.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("The bright light enveloping the continent fades away.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
