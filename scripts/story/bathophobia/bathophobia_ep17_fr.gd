# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Une étendue infinie de terres désolées, teintée d'un vert mystique par les superbes aurores australes.")
	await novel_interface.show_text_only("Une rangée de phares perce l’obscurité glaciale et silencieuse.")
	await novel_interface.show_text_only("Ils appartiennent à une flotte de motoneiges. Les scooters passent devant les plaines de glace plongées dans l'obscurité, passent devant l'héliport et se garent enfin à l'entrée de la base tentaculaire.")
	await novel_interface.show_text_only("Devant eux se dresse un monument en forme de cocon. Une boîte à spécimens robuste, auparavant utilisée pour contenir les météores du mont Grove, est incrustée dans sa surface rocheuse.")
	await novel_interface.show_text_only("Le mot « Snedronningen » est peint d'innombrables fois autour de la boîte, brillant d'argent sous un projecteur.")
	await novel_interface.show_text_only("Snedronningen-la Reine Blanche. Le nom de la base recherchée par les coureurs.")
	await novel_interface.show_text_only("Un membre de l'escouade lourdement blindé, chevauchant au premier plan, arrache sa visière.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Aaaet nous y sommes !", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suivant son exemple, les cinq cavaliers restants coupent leurs moteurs et descendent de cheval, chacun récupérant ses fournitures respectives.")
	await novel_interface.show_text_only("Il s’agit d’une équipe de recherche scientifique dont tous les membres ont suivi un entraînement de combat standard.")
	await novel_interface.show_text_only("Les rapports faisant état d'ondes radio générées par Substance H détectées en Antarctique il y a deux mois ont attiré de nombreuses factions curieuses dans la région. La plupart d’entre eux sont venus armés.")
	await novel_interface.show_text_only("Pour l’équipe, il est sage d’être prudent afin de protéger les spécimens.")
	await novel_interface.show_text_only("Ils ont eu de la chance jusqu’à présent. Le voyage vers la base de recherche mentionnée dans le plan de sauvegarde s’est déroulé sans problème.")
	await novel_interface.show_dialog("Très bien. Tout ce qu'on a à faire, c'est de remettre les affaires.", "Membre de l'équipe D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Oui.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Contrairement aux autres, qui sont enveloppées dans des couches épaisses et chaudes, Beth est vêtue d'une tenue décontractée, clairement insensible aux températures extrêmes.")
	await novel_interface.show_text_only("Ses armes auto-améliorées se démarquent également de la foule.")
	await novel_interface.show_text_only("Leur voyage s'était déroulé exactement comme elle l'avait prévu...")
	await novel_interface.show_text_only("Beth avait plongé dans les profondeurs de l'océan il y a quelques heures à peine, rapportant avec succès des échantillons vivants qu'elle avait collectés sur le corps d'une créature non identifiée.")
	await novel_interface.show_text_only("Pour conclure le projet de recherche, le superviseur de Milk a envoyé le brise-glace Ushuaia pour aider l’équipe des opérations spéciales.")
	await novel_interface.show_text_only("Lorsque la boîte d’échantillons était transférée à l’Ushuaia, le biolab du navire a connu « accidentellement » une panne de courant.")
	await novel_interface.show_text_only("Dans le même temps, la base de Snedronningen, située à environ une heure de route, a proposé de laisser temporairement l’équipe stocker les échantillons dans son laboratoire, qui répond à toutes les spécifications.")
	await novel_interface.show_text_only("L'équipe a rapidement reçu l'autorisation d'entrer dans les locaux et a été chargée d'amener les spécimens à la base de Snedronningen dans un délai de quatre-vingt-dix minutes.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Nous sommes arrivés jusqu'ici...)", "Beth")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Ces salauds vont-ils apparaître ?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth serre le poing.")
	await novel_interface.show_text_only("Ce qui la dérange encore plus, c'est que quelque chose dans la boîte à spécimens semble avoir déclenché une sorte de réponse dans son corps.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("... \\n(Cela semble familier pour une raison quelconque... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avant qu’elle puisse y réfléchir davantage, le monde commence à trembler violemment.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(Suis-je juste étourdi par la plongée ?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non, ce n'est pas ça.")
	await novel_interface.show_text_only("—Tout ce pays tremble.")
	await novel_interface.show_text_only("Un grondement profond peut être entendu de loin.")
	await novel_interface.show_text_only("Même les vétérans les plus aguerris semblent ébranlés.")
	await novel_interface.show_text_only("La secousse qui secoue ce continent blanc dure moins de trente secondes.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("L'Antarctique n'est pas dans la zone sismique..., n'est-ce pas ?", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le séisme n’a pas été trop fort. Cependant, cela a laissé tout le monde un peu étourdi.")
	await novel_interface.show_dialog("(Marmonne) C'est bien pire que le tsunami...", "Membre de l'équipe B")
	await novel_interface.show_dialog("La banquise sous nos pieds semble assez solide. Si le même séisme s’était produit dans une ville tropicale très peuplée, les dégâts auraient été bien plus importants.", "Chef d'escouade")
	await novel_interface.show_text_only("Les membres de l’équipe ignorent ce petit tremblement de terre et poursuivent leur travail.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Bon, allons-y.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La boîte d’échantillons bien rangée dans ses bras, Beth saute de la banquette arrière de la motoneige de Milk.")
	await novel_interface.show_dialog("Je suis épuisé. J'ai hâte de rentrer à la maison, dans mon lit et mon chocolat chaud.", "Membre de l'équipe B")
	await novel_interface.show_text_only("Alors que les membres de l’escouade baissent déjà leur garde, le chef reste vigilant, envoyant des regards significatifs en direction de Beth.")
	await novel_interface.show_text_only("Sans cette fille, ils auraient échoué dans cette mission, tout comme toutes les autres factions l’ont fait.")
	await novel_interface.show_text_only("Elle a dû plonger dans les profondeurs de l'océan, risquer un accident de décompression et affronter des créatures non identifiées...")
	await novel_interface.show_text_only("Les enjeux sont trop élevés. Même Milk elle-même n'aurait pas pu garantir le succès dans de telles circonstances.")
	await novel_interface.show_dialog("Donc tout ce que nous avons à faire c'est de remettre tout cela aux scientifiques ici, n'est-ce pas ?", "Membre de l'équipe D")
	await novel_interface.show_dialog("Beth, laisse-nous t'offrir une bière à notre retour à Buenos Aires, hein ?", "Membre de l'équipe C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("Pas question ! Notre Bethy ne boit pas d'alcool !", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tirant Beth dans ses bras, Milk déclare.")
	await novel_interface.show_text_only("Bai Zhu serra les lèvres, réprimant délibérément son inquiétude.")
	await novel_interface.show_text_only("Milk envoie plusieurs demandes d’entrée à la porte de la base, mais ne reçoit aucune réponse.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Comme c'est étrange...", "Lait")
	await novel_interface.show_dialog("Le tremblement de terre a-t-il détruit la connexion ou quoi ?\\nIls étaient toujours en contact juste avant notre accostage.", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pourtant, même si les pointes de la porte d'entrée qui restreignent l'entrée des véhicules restent debout, l'équipe est techniquement en mesure d'entrer quand même : après tout, elle a reçu le code d'accès à l'avance.")
	await novel_interface.show_text_only("Ils se dirigent donc vers la barrière bien éclairée sur le côté de la base.")
	await novel_interface.show_text_only("Beth s'arrête brusquement et remet la boîte de spécimens à l'un de ses coéquipiers.")
	await novel_interface.show_text_only("De ses mains libres, elle serre fermement ses armes.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Quoi de neuf ?", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Remarquant les actions de Beth, Milk sort également ses armes, les yeux alertes.")
	await novel_interface.show_text_only("Les autres membres, eux aussi, se tendent et se mettent en mode combat, avançant en formation en éventail, se surveillant mutuellement.")
	await novel_interface.show_dialog("... Qu'est-ce qui se passe ?", "Membre de l'équipe D")
	await novel_interface.show_dialog("Chut, garde ça bas.", "Chef d'escouade")
	await novel_interface.show_text_only("Dans le silence assourdissant, on n'entend que les grincements des bottes de neige sur la surface de la glace et la respiration tranquille des membres de l'équipe.")
	await novel_interface.show_text_only("Milk s'approche de la porte et tape le code dans le verrou de sécurité.")
	await novel_interface.show_text_only("Le système accepte le code et le mot ENTER clignote en vert sur l'écran.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Ouf..., cela devrait être sûr, n'est-ce pas ?", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais Beth n'arrive toujours pas à apaiser le sentiment troublant qui l'habite...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("La barrière menant à la base de Snedronningen s'ouvre enfin, accompagnée de sons de rouages vrombissants et de cordes tendues.")
	await novel_interface.show_text_only("Derrière le portail se trouve un escalier qui descend directement vers le niveau inférieur faiblement éclairé.")
	await novel_interface.show_dialog("Quelqu'un ?", "Lait")
	await novel_interface.show_text_only("Sa question résonne dans le passage étroit.")
	await novel_interface.show_dialog("Je comprends que la plupart des installations ici sont souterraines, mais n’auraient-ils pas pu envoyer quelqu’un à l’étage pour nous accueillir ?", "Lait")
	await novel_interface.show_dialog("Au moins un de ces chercheurs devrait venir vérifier les spécimens...", "Membre de l'équipe B")
	await novel_interface.show_dialog("En position de combat !", "Beth")
	await novel_interface.show_text_only("Les yeux rivés au bout des escaliers, Beth aboie sa commande.")
	await novel_interface.show_dialog("Quelqu'un nous regarde.", "Beth")
	await novel_interface.show_dialog("Plus l'option est secrète, plus il est facile d'attirer l'attention, je suppose...", "Lait")
	await novel_interface.show_dialog("(Est-ce que nos ennemis sont ceux qui vous inquiètent ?)", "Lait")
	await novel_interface.show_text_only("Une série de sécurités d'armes à feu brise le silence effrayant.")
	await novel_interface.show_text_only("Les membres de l'escouade, tous des soldats entraînés à part entière, se tournent vers la jeune fille qui occupe le poste de commandante intérimaire, attendant ses ordres.")
	await novel_interface.show_dialog("Nous sommes actuellement dans un endroit très exposé. Nous serons en danger s’ils tendent une embuscade. Nous pouvons nous retirer à l'extérieur de...", "Membre de l'équipe D")
	await novel_interface.show_dialog("Je ne peux pas. Nous avons reçu un avertissement, disant qu’il y aurait une tempête de neige dans une heure.", "Beth")
	await novel_interface.show_dialog("Tout le monde en alerte. Continuez à bouger.", "Beth")
	await novel_interface.show_dialog("(Tous) Oui, monsieur !", "Membre de l'équipe")
	await novel_interface.show_text_only("Les membres de l’escouade avancent sur la pointe des pieds, gardant leur souffle bas.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Attention !", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le bruit d’une lame tranchante traversant l’air brisa le moment de silence.")
	await novel_interface.show_text_only("Une créature brandissant une arme lourde en forme de faux surgit de l’ombre et frappe le côté droit de Beth.")
	await novel_interface.show_text_only("L'avertissement de Milk est arrivé juste à temps, permettant à Beth d'esquiver l'attaque.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("Quoi ?!!", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahaha... hahahahaha...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L’agresseur est une fille : les yeux creux, la posture déformée. Elle se penche en avant, ses articulations claquant, bruyantes et désorientantes.")
	await novel_interface.show_text_only("Plusieurs autres, visages frais, expressions folles, surgissent par l’entrée du couloir auparavant vide.") 
	await novel_interface.show_text_only("Les membres de l'escouade se mettent immédiatement dans leur formation triangulaire standard, tout en continuant à riposter sur les attaquants.")
	await novel_interface.show_text_only("Suivant l'exemple de Beth, ils entourent le membre qui tient la boîte à spécimens, la gardant de tous côtés.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("L’équipe maintient un rythme de tir régulier tout en cherchant à se mettre à couvert. Bientôt, ils arrivent dans un espace qui semble être une salle d'exposition.")
	await novel_interface.show_text_only("Les lumières sont tamisées ici, les objets exposés étant principalement des spécimens d'animaux.")
	await novel_interface.show_text_only("Le chef ordonne à l’équipe de former une ligne de défense à l’entrée de la pièce, tandis que le reste de l’équipe discute des qualités anormales qu’ils ont remarquées chez ces ennemis.")
	await novel_interface.show_text_only("Lorsqu'ils sont touchés, ils ne saignent pas. Ils ne semblent même pas ressentir de douleur.")
	await novel_interface.show_text_only("Le groupe déploie ses boucliers anti-émeute en fibre de Kevler, qui bloquent quelque peu les attaques.")
	await novel_interface.show_text_only("Les ennemis qui se précipitent d'un autre côté, leurs épées à la main, sont retenus au coin par des membres de l'escouade tenant encore plus de boucliers anti-émeutes.")
	await novel_interface.show_text_only("Pendant ce temps, derrière les porte-boucliers, des balles de 9 mm continuent de pleuvoir sur les ennemis, l'odeur de la poudre pesant dans l'air.")
	await novel_interface.show_dialog("Rechargez !", "Membre de l'équipe C")
	await novel_interface.show_text_only("Les tirs ne font rien pour dissuader les étranges ennemis. Même si les balles leur transpercent le visage, ces horribles filles continuent de sourire.")
	await novel_interface.show_text_only("Jusqu'à ce qu'une des filles saute par-dessus un bouclier et se pend la tête en bas, comme une chauve-souris, au plafond du couloir.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Euh... est-elle même... humaine ?", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un liquide vert d’encre s’écoule des blessures par balle de la jeune fille. Son cou, presque brisé en deux par la force des balles, est maintenant teint d'un inquiétant violet verdâtre.")
	await novel_interface.show_dialog("Attention !", "Membre de l'équipe B")
	await novel_interface.show_text_only("D'autres ennemis arrivent du bout du couloir.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Retraite ! Retraite!", "Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les membres de l'escouade n'ont d'autre choix que de se diviser en deux directions et de chercher d'autres points d'attaque appropriés, qu'ils trouvent heureusement bientôt.")
	await novel_interface.show_text_only("Ils ne se battent pas depuis longtemps, mais il est évident pour eux que les ennemis, quels qu’ils soient, sont tout aussi puissants que les leurs.")
	await novel_interface.show_text_only("Et aussi cent pour cent plus fou.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... Que sont-ils... ?", "Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("Qu'est-ce que c'est ?\\nIls ne peuvent pas être humains !", "Lait")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Pour Beth, il est évident que ces jeunes filles brandissant des lames sont comme elle…")
	await novel_interface.show_text_only("Non, pas complètement.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Ils ressemblent plus à ce que leur père a décrit...)\\n(Le style de \\\"Ningen\\\")", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ils sont résilients, récupèrent rapidement, avec des articulations extrêmement flexibles qui les rendent moins humains et ressemblent davantage à des marionnettes agiles. Trop puissant.")
	await novel_interface.show_text_only("Et ils sont clairement devenus coucous. Comme des machines à tuer activées par un programme.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahahaha... Jajajajajaja...", "Pythonesse inégale")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Leur bavardage absurde ressemble à une sorte de chant démoniaque. Certainement pas humain.")
	await novel_interface.show_text_only("Soudain, le membre de l'équipe qui tient la boîte à spécimens est touché par une flèche. Alors qu'elle s'effondre au sol, la boîte sort de ses bras.")
	await novel_interface.show_text_only("Mais les ennemis ne semblent pas pressés de s’en emparer.")
	await novel_interface.show_dialog("Beth !", "Membre de l'équipe D")
	await novel_interface.show_text_only("Les membres de l'escouade, poussés jusqu'aux profondeurs de la salle d'exposition par l'avancée des ennemis, crient à leur commandant de donner des instructions supplémentaires.")
	await novel_interface.show_text_only("Il s’agit d’une situation dans laquelle aucun protocole normal ne s’applique. Tout ce sur quoi Beth peut compter désormais, ce sont ses propres sens et son jugement.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Donc ils ne sont pas là pour les spécimens ?)", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Bon sang !", "Lait")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Alors leur objectif doit être—)", "Beth")
	novel_interface.change_expression("angry")
	await novel_interface.show_text_only("- pour nous anéantir tous.")
	await novel_interface.show_dialog("... \\n(Donc c'est bien vous les gars... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le regard de Beth se pose sur le symbole brodé sur le cache-œil d’une de ces marionnettes.")
	await novel_interface.show_text_only("Elle a vu ce symbole d’innombrables fois alors qu’elle enquêtait sur la mort de son père.")
	await novel_interface.show_text_only("C’est un œil effrayant et solitaire, un œil avec des membres.")
	print("=== 深海恐惧症篇第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
