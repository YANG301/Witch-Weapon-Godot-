# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru caminha até Aya e se inclina para ler os dados atualizados na tela.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Relatório médico de Beatrice?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Uh-huh – Uma amostra perfeita!", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("E seria muito mais interessante se pudéssemos compará-lo com os registros históricos.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mas nenhum de nossos bancos de dados contém nenhuma informação dela. Pode ser devido à lacuna de dados causada pela guerra.", "Mariru")
	await novel_interface.show_dialog("No entanto, de acordo com as declarações dela e o seu relatório…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru abre o perfil de Beatrice na tela.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 anos… \\nQue idade nobre!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru e Aya trocam um olhar, sabendo que notaram a mesma coisa. Então, eles voltam para a tela.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Este é o resultado do teste dela na noite em que ela surgiu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Praticamente nenhum elemento radioativo encontrado em seu corpo. Embora os níveis de metal pesado sejam relativamente altos em suas amostras de sangue.", "Ai")
	await novel_interface.show_dialog("Pode ter algo a ver com os utensílios ou cosméticos rudimentares da Idade Média…", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Então você já tem uma conclusão?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Afinal, de acordo com os registros de suas declarações—", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya passa o dedo sobre uma linha de texto na tela.")
	await novel_interface.show_text_only("GMT+9 13:09:11 A meta afirma 1265 DC como ano de nascimento.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—Esta é a primeira vez que vejo uma amostra viva dos tempos antigos.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Poderia ser o mesmo caso com Annie?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Não! \\nBeatrice disse que tinha 100% de certeza de que estava morta.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("Ela disse que bebeu veneno intencionalmente.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Existem registos históricos que apoiam isto… Mas a possibilidade de falsificação não pode ser descartada.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya clica para abrir outro relatório de teste.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Há apenas uma variedade limitada de venenos registrados na Idade Média. Cicuta, erva-moura, noz vômica e etc.", "Ai")
	await novel_interface.show_dialog("Encontrámos resíduos de alcalóide tóxico nas amostras de sangue recolhidas na noite em que ela emergiu.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mas no sangue que extraímos no dia seguinte quase não há vestígios de qualquer alcalóide tóxico ou metal pesado.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Não é à toa que você parece tão animado...", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Espere, esta não é a parte mais emocionante ainda!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A voz de Aya treme de excitação.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Ao contrário de Annie, Beatrice possui um sistema imunológico encontrado em recém-nascidos. Ela testou negativo para IgD.", "Ai")
	await novel_interface.show_dialog("E… as propriedades do microbioma em seu corpo são quase as mesmas do Ren!!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… Como você teve a ideia de fazer esses testes?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuição. Instinto. E uma paixão por amostras raras!!", "Ai")
	await novel_interface.show_dialog("Um corpo criado do nada… reproduzindo com precisão a “maldição” mais interessante sobre o assunto – a capacidade de atrair amor.", "Ai")
	await novel_interface.show_dialog("Ren é simplesmente… incrível!!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dizendo isso, Aya fecha os olhos e cruza os braços para se abraçar, parecendo bastante embriagada com seus pensamentos.")
	await novel_interface.show_text_only("Mariru saca uma lista de relatórios e bate com força na testa de Aya.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se uma alma pode existir independentemente num espaço-tempo diferente…", "Mariru")
	await novel_interface.show_dialog("Então como ele seleciona um contêiner?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("Poderia ter algo a ver com a borboleta dourada?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Não, considerando Annie e seu taco de beisebol, acho que Beatrice está de alguma forma conectado com a joia verde…", "Mariru")
	await novel_interface.show_dialog("É como se certos objetos pudessem invocar as almas ligadas a eles.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Trata-se de viagens no espaço-tempo e criação de corpos…", "Mariru")
	await novel_interface.show_dialog("(O Senado nunca deveria saber nada sobre isso.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Então, Ren pode até atrair uma alma…", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya interrompe a linha de pensamentos de Mariru.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Hum?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Tirar uma certa alma do nada e criar um corpo para hospedar a alma… Parece alquimia proibida.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Se eu não estivesse vivendo nesta época, poderia ter tentado fazer comércio de almas com deuses usando elementos básicos, assim como os alquimistas.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Como o chamado “Filho dos Deuses” promovido por pequenos grupos religiosos. Mas não há mercado para isso em New Opulentia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("Não, prefiro títulos femininos como “Deusa”. Eles me dão esse desejo interior de desafiar a abstinência.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nossa, por que diabos eu contratei alguém como você...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Uh-huh! Talvez nossas almas estejam apenas atraídas uma pela outra.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("—Então, isso é tudo que encontrei.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Hein?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No centro de saúde, após o exame físico regular, converso com Aya sobre Beatrice enquanto visto minhas roupas.")
	await novel_interface.show_text_only("O comentário de Aya sobre as condições físicas de Beatrice pode fazer sentido…")
	await novel_interface.show_text_only("Mas a teoria da alma parece uma porcaria total…")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Especialmente a chamada \"Deusa\"…) \\n(Embora uma vez eu tenha capturado esse tipo de papel em videogames)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Mas eu nunca iria querer esse título para mim!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não consigo evitar colocar meus braços em volta de mim e tremer.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Não, nunca!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, algo indescritível em sua mente?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Então… É por isso que meus itens de checkup aumentaram?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uh-huh.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya mostra um sorriso sexy, como se estivesse planejando algo em segredo.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Talvez seja outra pesquisa não autorizada…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Pena que não tenho equipamento de apoio suficiente; caso contrário, eu poderia fazer testes mais \"interessantes\"…", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("A propósito, quer experimentar o modo de potência máxima do chip plantado em você?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Não! Muito obrigado!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
