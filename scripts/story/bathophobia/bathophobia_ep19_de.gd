	await novel_interface.show_dialog("Sind das...-Exemplare?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein Exponat in der transparenten Vitrine, getragen von einem organischen Glasgestell, fällt mir ins Auge. Es ähnelt einer Art Meerestier.")
	await novel_interface.show_text_only("Es hat einen glatten, glänzenden Körper in durchscheinendem Weiß. Auch der Schwanz ist glatt. Es sieht aus wie ein Tier, das nur in den Tiefen des Ozeans überleben konnte.")
	await novel_interface.show_text_only("Wenn die Rückseite so aussieht, frage ich mich, wie sie von vorne aussieht...")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("... !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich gehe auf die andere Seite, um einen Blick darauf zu werfen, und keuche vor Überraschung und Abscheu.")
