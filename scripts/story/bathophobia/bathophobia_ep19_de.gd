	await novel_interface.show_dialog("Es kommt selten vor, dass so etwas so ausgestellt wird, als wäre es ein Kunstwerk.", "Raphael")
	novel_interface.change_2nd_expression("jeer")
	await novel_interface.show_dialog("Der Besitzer dieser Anlage muss ein Idiot sein. Noch schlimmer als du!", "Raphael")
