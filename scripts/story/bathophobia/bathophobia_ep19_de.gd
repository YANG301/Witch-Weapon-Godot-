	await novel_interface.show_dialog("Etwas fühlt sich nicht richtig an.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der blonde Alchemist runzelt die Stirn, sein Gesicht ist ernst.")
	await novel_interface.show_text_only("Eine Luftwelle scheint in alle Richtungen zu strömen, beginnend dort, wo ihre Handfläche nach unten gedrückt wird.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Was?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("... Wir sitzen in der Falle.", "Henriette")
