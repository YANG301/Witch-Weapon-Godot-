	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Aber alles scheint gut zu laufen...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Ausstellungen erstrahlen in einem unheimlichen Glanz. Das Geräusch der laufenden Ventilatoren ist schon von weitem zu hören.")
