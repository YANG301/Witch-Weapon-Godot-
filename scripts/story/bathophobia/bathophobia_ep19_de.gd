	await novel_interface.show_dialog("Ist das eine Art Filmrequisite?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Nein. Dies ist ein Exemplar einer real existierenden Kreatur.", "Raphael")
	await novel_interface.show_dialog("Es war das Ergebnis eines gescheiterten genetischen Experiments während des Krieges. Ich habe viele davon im Salmonton Research Institute gesehen.", "Raphael")
