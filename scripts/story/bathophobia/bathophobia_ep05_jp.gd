# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("『魂』とは何か？")
	await novel_interface.show_text_only("意識を記録した、ある種のエネルギーか。\\nそれとも観測できない量子状態的な存在か？")
	await novel_interface.show_text_only("あるいは『魂』とは単なる概念の1つに過ぎないのかもしれない。")
	await novel_interface.show_text_only("物理学における『時間』の概念と同じく──")
	await novel_interface.show_text_only("ただの幻覚……夢。")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("ならば唯一の問題は──")
	await novel_interface.show_text_only("夢を見ているのは──誰なのか？")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("南極収束線区域。骨身まで刺すような寒さは、\\n外界からの探究を拒絶しているかのようだ。")
	await novel_interface.show_text_only("海面下6100m、超深海層。")
	await novel_interface.show_text_only("チタン合金の耐圧外殻に包まれた潜水艦が、\\nゆっくりと沈下していた。")
	await novel_interface.show_text_only("船室のステータスランプから発せられた\\n微弱な光は、10cm弱を照らす事しかできず、\\n周囲の暗闇に飲み込まれてしまっている。")
	await novel_interface.show_text_only("光の存在しない場所では、空間も正しく感知\\nできないであろう。")
	await novel_interface.show_text_only("尖った牙と奇妙な色を持つ1匹の魚が、船体に\\nぶつかったが潜水艦はビクともしない。")
	await novel_interface.show_text_only("60MPaの巨大な水圧が、\\n潜水艦の限界強度を試し続けている。") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("──突然、潜水艦の8組のサーチライトが\\n予めプログラムされていたかように起動し、\\n8本の光柱を真っ直ぐ放った。") #换行问题
	await novel_interface.show_text_only("暗闇を突き刺す長剣のように、\\n目を灼くような光が爆発的に広がる。")
	await novel_interface.show_text_only("厚さ数10cmの観察窓から一筋の光が差し、\\n船室内で眠っている少女を照らした。")
	await novel_interface.show_text_only("鈍色の長髪は淡青色の光を反射し、\\n氷のように透き通った少女の顔に沿って\\nしなやかに伸び散っている。")
	await novel_interface.show_text_only("彼女の前にあるコントロールパネル上の深度計は\\nすでに意味を成しておらず。\\n深海1247mの時点で計測を停止していた。")
	await novel_interface.show_text_only("外部サーチライトの光が次第に暗くなると、\\n銀色の光が少女の周囲に漂っているのが分かる。\\n……それはほんの微かに。")
	await novel_interface.show_text_only("……低く、悠遠な声が聞こえてくる。\\n\\n人類の想像の果て、恐怖を包んだ深海の奥から。")
	await novel_interface.show_text_only("──まるで太古からの召喚のように。")
	await novel_interface.show_text_only("眠っていた少女は、母の身体から……\\n\\n生れ出づるかのように呼び起こされた。")
	await novel_interface.show_text_only("圧迫感からの眩暈と抑えられない嘔吐の欲求が、\\n目覚めたばかりの身体を苛む。")
	await novel_interface.show_text_only("すでに深さは、潜水艇の設計上にて\\n安全ラインである4500mを超えている。\\n潜水艇の金属外殻からは異音が鳴り始めていた。")
	await novel_interface.show_text_only("少女の肺から抑圧されたような咳が出る。")
	await novel_interface.show_text_only("最初は少し呼吸困難に陥ったが、\\n数回整えると呼吸はすぐに適応し、安定した。")
	await novel_interface.show_dialog("さっきの衝撃……私、気を失っていたのかしら。", "少女")
	await novel_interface.show_dialog("まともに呼吸できるという事は、\\n酸素はまだ正常レベル……", "少女")
	await novel_interface.show_dialog("吐く息からして……おそらく船室内は、\\n0℃近くでしょう。", "少女")
	await novel_interface.show_dialog("メインシステムチェック……\\nコールドスタート……スタンバイ……\\n情報識別：バイジュウ", "少女")
	await novel_interface.show_text_only("バイジュウと識別された少女は、\\n低温が身体に及ぼす影響などは一切気にせず、\\n船内の各システムを丁寧にチェックしている。")
	await novel_interface.show_text_only("彼女は生まれついた能力を持っていた。\\n\\n冬の氷に閉ざされた山奥で発見された時は、\\nまだ彼女が赤子の頃の話だ。")
	await novel_interface.show_text_only("その後の一連の検査の結果で、この奇跡の少女があらゆる極寒環境に適応できる事が判明した。")
	await novel_interface.show_text_only("成人が30秒で意識を失うほどの極寒でも、\\n彼女は終始正常な体温を保つ事ができる。\\nしかも手のひらは暖かいまま──")
	await novel_interface.show_text_only("原因は不明であり、医者達の手を以てしても\\n未だに解明はできていない。\\nそのまま彼女は孤児院から養父によって\\n引き取られる事となった。")
	await novel_interface.show_dialog("照明動力システム正常。センサー再起動もOK。", "バイジュウ")
	await novel_interface.show_dialog("6000mまで潜っているなんて……ここまでの\\n水圧の場所に『アレ』がいるとは思えません…", "バイジュウ")
	await novel_interface.show_dialog("帰航のための電力は節約して\\n確保しておかないと……\\nとりあえずサーチライトは消して──", "バイジュウ")
	await novel_interface.show_text_only("サーチライトが消える直前、バイジュウは\\n観察窓の外に見える異様な景色に気付いた。")
	await novel_interface.show_dialog("な……っ！", "バイジュウ")
	await novel_interface.show_text_only("その光景を見た少女は、\\n慄然のあまりに固まってしまう。")
	await novel_interface.show_dialog("アレは……なに……？", "バイジュウ")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("サーチライトが消える直前、観察窓の外に\\n巨大なサンゴ状の『何か』が映し出された。")
	await novel_interface.show_text_only("不均一に構成された鮮紅色の物体。\\n\\n中心が滝つぼのように陥没し、\\n黒く深い大穴と化している。")
	await novel_interface.show_text_only("先ほど周辺のエリアをスキャンした際には、異常な生命体や地形構造などは一切発見していない。")
	await novel_interface.show_text_only("バイジュウはすぐに船外の広角レンズを開き、\\n物体の全体像を確かめようとした──")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("モニターに映し出されたのは、\\n暗闇の中に浮かぶ90メートルはくだらない──\\n触手であろうモノが生えたおぼろげな影──")
	await novel_interface.show_dialog("そ、そんな、馬鹿な事が……", "バイジュウ")
	await novel_interface.show_text_only("無機物でなく、これが生命体なのは確かである。物体の表面にうごめく、赤く光る斑点が見えた。")
	await novel_interface.show_dialog("あれは……目玉……でしょうか？", "バイジュウ")
	await novel_interface.show_text_only("──もし、あの大きなものが\\n「目玉」と形容できるのであれば。")
	await novel_interface.show_text_only("観察窓の正面にある黒い大穴は、\\nおそらく眼球の瞳孔。")
	await novel_interface.show_text_only("巨大ゆえに近すぎると、距離感の判別がつかず、\\n今にも吸い込まれてしまいそうだ。")
	await novel_interface.show_text_only("うごめく斑点が徐々に消えていくと共に、\\n闇の静けさの中。\\n少女は名状しがたいモノと対峙する。")
	await novel_interface.show_text_only("視界が暗闇に慣れると、想像が実像へと\\n映り替わる。\\nモニターに映るのは「目玉」とも呼べるが、\\nまるで不透明なクラゲとも言えよう。")
	await novel_interface.show_text_only("中身が溢れ出すかのように、目玉は鼓動を打つ。\\nその鼓動は少女の心臓の脈動と重なり合う。")
	await novel_interface.show_dialog("（落ち着いて……落ち着きなさい！）\\n\\n（よく……考えなければ……）", "バイジュウ")
	await novel_interface.show_text_only("もしあれが本当に目玉ならば、水晶体の部分は\\n光に敏感なはず。")
	await novel_interface.show_text_only("眼球の奥にある脈絡膜の部分。\\nそこから隙間なく多くの白い光の点在が伺える。")
	await novel_interface.show_text_only("バイジュウはモニターに映る眼球の後方に、\\n枝のような触手が伸びている事に気が付いた。")
	await novel_interface.show_text_only("鈍色の触手は海の底へと続き、根元は遥か深淵に\\n沈んでいる。")
	await novel_interface.show_dialog("（……身体が……動かない……）", "バイジュウ")
	await novel_interface.show_text_only("──対峙というより『アレ』が少女を\\n一方的に観察してるとも言えようか。")
	await novel_interface.show_text_only("凝視による圧迫感が恐怖を煽り、少女の理性を\\n徐々に侵食していく。")
	await novel_interface.show_dialog("は……っ！", "バイジュウ")
	await novel_interface.show_text_only("──飲み込まれてしまうの？")
	await novel_interface.show_text_only("深海がもたらした異様な感覚によって、少女は\\n自分の存在すら疑うまでになってしまう。")
	await novel_interface.show_dialog("（これが、夢なら……）\\n\\n（そうでしたら、早く目覚めて……っ！）", "バイジュウ")
	await novel_interface.show_text_only("──彼女の身体は本能に従い動いた。\\n\\n本能は自意識よりも先に、意識の束縛から\\n抜け出していた。")
	await novel_interface.show_text_only("少女が左手でジョイスティックを引くと、ダイビングチャンバーは眼球に向かって一定距離を移動し続けた。")
	await novel_interface.show_text_only("水流の波動が伝わってきた。\\nまるで『アレ』が驚いてるかのようだ。")
	await novel_interface.show_text_only("眼球が瞳孔を縮めて、少女の動きを逐一\\n観察している。")
	await novel_interface.show_dialog("こちら……？ もしもし？", "バイジュウ")
	await novel_interface.show_text_only("バイジュウは自分が着けているヘッドセットを\\n触り、通信を試みる。")
	await novel_interface.show_text_only("しかし、この水深ではあらゆる電磁波は遮断され\\n水中音響通信を試みる事も敵わない。")
	await novel_interface.show_dialog("…………", "バイジュウ")
	await novel_interface.show_text_only("彼女でしたら、きっとヘッドホンへ必死に\\n叫んでいるでしょう──\\n「これ以上は近付くなッ！」と。")
	await novel_interface.show_dialog("はは……なんでこんな事を、\\n今思い出しているのでしょうか……", "バイジュウ")
	await novel_interface.show_dialog("そして「彼女」とは……誰なのか……", "バイジュウ")
	await novel_interface.show_dialog("ここは……どこ……", "バイジュウ")
	await novel_interface.show_text_only("眼球が凝視する圧迫感の中で、\\nバイジュウの意識は緩やかに霞み。\\n次第に現実と幻の境界線も曖昧と化してきた。")
	await novel_interface.show_text_only("緊張状態が身を苛む。だが、それでも少女の手は\\nコントロールパネル上の模索を続ける。")
	await novel_interface.show_text_only("少女の手はサンプル採取用機械アームの\\n操作機器を素早く発見した。")
	await novel_interface.show_dialog("（本当に……やるのですか……？）", "バイジュウ")
	await novel_interface.show_text_only("依然として幻覚のような光の斑点がうごめき、\\n脈数は早まるばかり。\\nバイジュウは少しずつ自分の心を落ち着かせる。")
	await novel_interface.show_dialog("サンプルを採取して……\\nその後、すぐに離れるだけ……", "バイジュウ")
	await novel_interface.show_text_only("まずは全てのサーチライトを前方に移す。")
	await novel_interface.show_text_only("動力システムを最大航速に設定。\\n方向は……後退。")
	await novel_interface.show_text_only("いつ失神してもおかしくないような状態だが、\\n少女は踏ん張った。\\n……そして一連の準備作業を完了させる。")
	await novel_interface.show_dialog("お父さん、これが……精神汚染でしょうか……\\n後…もう少し……", "バイジュウ")
	await novel_interface.show_text_only("バイジュウの操作に応じて、機械アームが\\nゆっくりと巨大な針を展開する。")
	await novel_interface.show_dialog("サクションモード……この圧力なら1度で十分…", "バイジュウ")
	await novel_interface.show_text_only("機械アームが前方へ伸びて、\\n針が眼球の硝子体まで差し込まれる。")
	await novel_interface.show_text_only("サンプリング容器の飽和度は、\\n0％から一瞬で100％に到達した。") #标点删除
	await novel_interface.show_text_only("眼球の瞳孔らしき部位が歪み始める。\\n\\nもし声が聞こえるのならば、骨を刺すような\\n悲鳴を上げているのだろうか……")
	await novel_interface.show_dialog("（幻……聴……？）", "バイジュウ")
	await novel_interface.show_text_only("少女は最後の力を振り絞り、\\nシーケンス実行ボタンを押した。")
	await novel_interface.show_text_only("先ほど設定したシーケンスに従い、8つの\\nサーチライトが一斉に眼球の瞳孔へと照射され、\\n同時にスクリューも高速回転を始める。")
	await novel_interface.show_text_only("刺激と強烈な光で怯えるように眼球は後退。\\n\\n徐々に遠ざかっていく潜水艦も浮上を始める。")
	await novel_interface.show_text_only("やがて、その場に立てなくなり、\\n目の前が暗闇の帳に包まれると……\\n遂に少女の精神は尽き果てた…………")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
