# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-choo...", "Beth")
	await novel_interface.show_text_only("Con la cabeza apoyada en el escritorio, la niña podría haberse quedado dormida de no haber sido por este estornudo.")
	await novel_interface.show_text_only("Fuera de la ventana del submarino está la noche polar y no puede saber la hora por el color del cielo.")
	await novel_interface.show_text_only("Beth mira la pantalla y se da cuenta de que han pasado solo unas horas de su encuentro con el monstruo de las profundidades marinas.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… ¿Estoy haciendo lo correcto?", "Beth")
	await novel_interface.show_dialog("(Usándola para encontrar la verdad por mí mismo…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sin darse cuenta, Beth echa un vistazo al cuaderno que tiene en la mano.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Si padre estuviera aquí…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Él nunca flaquearía ante ese tipo de emociones.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Pensando en las fuertes manos de su padre, Beth aprieta lentamente el puño.")
	await novel_interface.show_text_only("El cuaderno, lleno de textos oscuros, perteneció a su padre adoptivo.")
	await novel_interface.show_text_only("Era un biólogo alto, silencioso y devoto que era estricto tanto con Beth como con él mismo.")
	await novel_interface.show_text_only("Debido a la habilidad especial de Beth, organizó entrenamientos rigurosos para ella además de sus tareas escolares.")
	await novel_interface.show_text_only("Beth recuerda que tuvo que trabajar muy duro todos los días para alcanzar las metas marcadas por su padre.")
	await novel_interface.show_text_only("Lo que más esperaba era la ocasional sonrisa de reconocimiento en su rostro serio.")
	await novel_interface.show_text_only("Sin mucha ternura, el hombre reservado había estado protegiéndola a su manera…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("—Como si la preparara para algún destino ineludible…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("En su cumpleaños número 12, Beth recibió un paquete anónimo. Dentro estaba este cuaderno y la noticia de la muerte de su padre.")
	await novel_interface.show_text_only("Una explosión de gas mató a más de 30 personas, incluido el único miembro de la familia de Beth que quedaba en el mundo.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Con los labios temblorosos, Beth pronuncia un nombre silencioso.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las pistas detrás de este nombre le hicieron darse cuenta de que la muerte de su padre no fue un accidente como se informó oficialmente.")
	await novel_interface.show_text_only("La niña solitaria tuvo que secarse las lágrimas y crecer rápidamente para sobrevivir a los peligros desconocidos.")
	await novel_interface.show_text_only("—Su padre dijo en el cuaderno que su habilidad especial la expondría al peligro y la convertiría en el objetivo de la pandilla.")
	await novel_interface.show_text_only("El paquete sólo se enviaría cuando él ya no pudiera protegerla...")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(¿Por qué la gente anhelaría… ese tipo de habilidad…)", "Beth")
	await novel_interface.show_dialog("(¿No es esto más bien una maldición...?)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth mira su palma. Varias bolas de luces plateadas rebotan sobre sus dedos.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth sabe que es diferente desde que recuerda las cosas, pero no por su habilidad especial.")
	await novel_interface.show_text_only("Tiene una memoria eidética para los números incluso cuando era niña. Puede hacer cálculos mentales mucho más rápido que otros y está muy interesada en la maquinaria.")
	await novel_interface.show_text_only("Pero su padre le pidió que mantuviera un perfil bajo y actuara como una niña normal para ocultar su habilidad especial.")
	await novel_interface.show_text_only("Después de su muerte, Beth decidió no esconderse más.")
	await novel_interface.show_text_only("Un año después, fue admitida en una prestigiosa universidad con un permiso especial, una excepción que se hizo por primera vez en años.")
	await novel_interface.show_text_only("Estudió mucho y leyó mucho, pero no pudo encontrar la respuesta ni en los libros ni en las clases.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(¿Por qué soy diferente…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Siguió aprendiendo y pensando, como si tratara de satisfacer de una vez su curiosidad reprimida durante mucho tiempo.")
	await novel_interface.show_text_only("No se dio cuenta de que así la tildaban de arrogante, indiferente e inaccesible.")
	await novel_interface.show_text_only("Poco a poco la gente le fue dando la espalda, pero a ella no le importaba.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(De lo contrario, no te habría conocido…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Conoció a Silvia en un accidente.")
	await novel_interface.show_text_only("Beth tardó sólo unos minutos en darse cuenta de que Silvia era una investigadora disfrazada de estudiante. Su misión era buscar Substance H ilegal en el campus.")
	await novel_interface.show_text_only("Sabía que el nombre y las experiencias de Silvia podían ser falsos, pero aun así se sentía atraída por su personalidad alegre y descuidada.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Ella es… diferente.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ella me conoce mejor que nadie...")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Aunque está acostumbrada a disfrazarse ante los demás…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella realmente me ha abierto su corazón sin ninguna reserva.")
	await novel_interface.show_text_only("Pero ninguno de los dos esperaba que su amistad llamara la atención de la organización detrás de Milk.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sabiendo que era la hija adoptiva del famoso biólogo, el jefe de Milk la invitó a unirse a la misión antártica.")
	await novel_interface.show_dialog("(Tenía la intención de rechazar...)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("En una base subterránea del Escuadrón.")
	await novel_interface.show_text_only("Lo que la hizo cambiar de opinión y decidir unirse fue un símbolo en la guía de la misión:")
	await novel_interface.show_text_only("Un símbolo que vio en el cuaderno de su padre.")
	await novel_interface.show_text_only("Un espeluznante globo ocular negro que representa una organización religiosa secreta.")
	await novel_interface.show_text_only("Su padre registró su contacto con personas de esa organización. Habían mostrado la intención de movilizar a personas con capacidades especiales y crear un grupo militante.")
	await novel_interface.show_text_only("El plan se denominó Proyecto Ningen.")
	await novel_interface.show_text_only("Después de que los documentos de su orfanato cayeron en sus manos, Beth había estado en la lista de personas más buscadas del Proyecto Ningen.")
	await novel_interface.show_text_only("Como resultado, su padre se convirtió en el objetivo de esta peligrosa organización.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen… la Antártida.)", "Beth")
	await novel_interface.show_dialog("(La base de la Reina de las Nieves en la Antártida…) \\n(Lleva el nombre de una historia de los cuentos de hadas de Andersen.)", "Beth")
	await novel_interface.show_dialog("En danés es Snedronningen \\nO Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(No es una coincidencia).", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Entonces tu jefe y la pandilla van tras lo mismo...", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Por la expresión de tu cara... esta pandilla parece ser más dura que otras en la Lista Negra...", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth asiente, pero no quiere hablar más.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Lo siento. Me uní a esta misión por motivos egoístas.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Bueno, eso lo sé.", "Milk")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Pero Boss sólo quiere que continúes con la investigación de tu padre sobre la vida marina.", "Milk")
	await novel_interface.show_dialog("Así que todos ganan.", "Milk")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("En cuanto a tus motivos egoístas… sé que estás tan encantado conmigo que decides quedarte aquí.", "Milk")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("¡Oh, eso es demasiada presión para mí!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dijo Milk y le lanzó un beso a Bai Yan, lo que hizo sonreír a Bai Zhu.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Lo que no nota es una fugaz tristeza en los ojos claros de su amiga.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Todavía se siente culpable cuando piensa en el momento en que firmó el papeleo.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Yo… la estaba usando.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth se sienta ante el escritorio, saca un bolígrafo y mira fijamente el cuaderno abierto.")
	await novel_interface.show_text_only("Valiosos son los útiles.")
	await novel_interface.show_text_only("—Anota su pensamiento.")
	await novel_interface.show_text_only("Tú me dijiste esto… Y siempre he estado de acuerdo contigo…")
	await novel_interface.show_text_only("Utilizar a otros o ser utilizado sin escrúpulos \\n“Esto es algo que se da por sentado…”")
	await novel_interface.show_text_only("Sólo depende de quién tiene un valor mayor.")
	await novel_interface.show_text_only("No hay necesidad de dar explicaciones. Sólo concéntrate en tu objetivo.")
	await novel_interface.show_text_only("Sólo una relación tan simple puede mantenerte a salvo de la mayoría de las personas.")
	await novel_interface.show_text_only("Beth hace una pausa.")
	await novel_interface.show_text_only("Pero también me dijiste que todavía hay...")
	await novel_interface.show_text_only("Alguien que quiera ser utilizado por ti pase lo que pase. \\n\"Y alguien a quien no quieras utilizar bajo ninguna circunstancia.\"")
	await novel_interface.show_text_only("Al pensar en esto, una leve sonrisa se dibuja en sus labios.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(¿Culpa? Es un sentimiento que debe descartarse).", "Beth")
	await novel_interface.show_dialog("(Entonces ¿es… cariño?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth cierra su diario.")
	await novel_interface.show_text_only("Ahora ha encontrado su respuesta.")
	await novel_interface.show_text_only("Mira por la ventana y descubre que el cielo azul oscuro se hace más profundo, casi fusionándose con el mar infinito.")
	await novel_interface.show_text_only("De repente, suena una alarma de emergencia en todo el barco.")
	await novel_interface.show_text_only("Atención a toda la tripulación. La directiva cambió. Preséntese en la sala de reuniones en diez minutos.")
	await novel_interface.show_text_only("Repita. Directiva cambiada...")
	await novel_interface.show_text_only("Beth respira hondo, guarda el cuaderno y sale apresuradamente de la habitación.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
