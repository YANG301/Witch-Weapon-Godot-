	await novel_interface.show_text_only("Non non non, je suis (ou j'étais) un garçon…")
	await novel_interface.show_text_only("Heinrich montre sa poitrine.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Plus gros qu'avant… Est-ce le goût du Maître ?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l se retourne et me lance un regard sévère.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Non ! Pas moi! Je ne l'ai pas fait !!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Je viens de détruire le trésor national de Salmonton par accident…")
	await novel_interface.show_dialog("Et, s'il vous plaît, ne m'appelez pas maître… Appelez-moi simplement Ren.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ren…? \\nJe ne m'attendais pas à ce qu'une personne formidable comme vous porte un si joli nom…", "Henriette")
