	await novel_interface.show_text_only("Elle hésite, regarde les chiffres à son poignet et soupire légèrement.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Cela fait déjà 400 ans…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Attendez, y a-t-il une montre ou un calendrier à son poignet !?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Je me suis fait passer pour un homme pour faire des recherches, publier des articles ou pratiquer la médecine.", "Henriette")
	novel_interface.change_expression("normal")
