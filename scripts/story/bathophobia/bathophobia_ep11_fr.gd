# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Qu'est-ce que la réalité ?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Peut-être que la réalité telle que nous la connaissons n’est qu’un jeu informatique.")
	await novel_interface.show_text_only("Connectez-vous, les personnages se réveillent ; déconnectez-vous et ils s'endorment. Quand les comptes sont fermés, ils meurent.")
	await novel_interface.show_text_only("Au fil du temps, ils développent la perception de l’âme.")
	await novel_interface.show_text_only("Ils croient que toutes ces actions préprogrammées sont prises par leur libre arbitre.")
	await novel_interface.show_text_only("Formules, lois, règles de grammaire, codes de conduite… chaque personnage se voit confier ces règles à suivre sans savoir qui les a créées… jusqu'à ce qu'il soit enfin libéré.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Même si une grande partie du ciel devient pixellisée à cause d'une erreur de rendu...")
	await novel_interface.show_text_only("Ils l’ont simplement rationalisé avec des contes de fées ou des croyances religieuses, au lieu d’admettre que cela dépasse leurs connaissances.")
	await novel_interface.show_text_only("Parce qu'accepter l'inconnu signifie la possibilité la plus troublante—")
	await novel_interface.show_text_only("Que la soi-disant réalité n’est peut-être qu’une illusion.")
	await novel_interface.show_text_only("Une chimère.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("J'ouvre lentement les yeux et me retrouve dans le brouillard.")
	await novel_interface.show_text_only("Je suis entouré par la brume. Étrangement, des chapelets de gouttes de pluie pendent dans les airs.")
	await novel_interface.show_text_only("Je tends la main et essaie de les toucher, mais ils s'évaporent immédiatement.")
	await novel_interface.show_dialog("Où suis-je…", "Lian")
	await novel_interface.show_text_only("Je me tiens sur une surface solide et je peux ressentir la gravité. Mais je ne vois pas le sol… comme si ma vue était absorbée par le vide.")
	await novel_interface.show_text_only("Il y a un bourdonnement inhabituel en arrière-plan. Sans aucun cadre de référence, les directions sont imperceptibles.")
	await novel_interface.show_text_only("Je lève les yeux et vois le contour d’un totem en forme d’arbre flottant au-dessus de moi.")
	await novel_interface.show_text_only("Il s’étend comme une couverture scintillante dans le ciel.")
	await novel_interface.show_text_only("Dix anneaux sur le totem tournent lentement, l'un émettant un rayon rougeâtre.")
	await novel_interface.show_text_only("Puis un immense motif composé de lignes et d’inscriptions se déploie sous mes pieds, formant ce qu’on peut appeler le sol.")
	await novel_interface.show_text_only("Le totem au sol est le même que celui dans les airs, mais beaucoup plus grand vu de courte distance.")
	await novel_interface.show_text_only("Les anneaux, chacun d'environ 15 pieds de diamètre, sont reliés dans un certain ordre. Les inscriptions dessus semblent anciennes.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Est-ce que je… rêve ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai été formé pour identifier les hallucinations et les rêves…")
	await novel_interface.show_text_only("Quelle est cette question importante encore…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("— Comment suis-je arrivé ici ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les souvenirs reviennent. J'étais dans la base de l'Arche et tout a commencé à tomber… Puis…")
	await novel_interface.show_text_only("Non, ce n’est pas un rêve.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Est-ce que ça a quelque chose à voir avec cette fille ?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Elle m'appelait Maître, et même…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aww— \\nNon... Ce n'est pas le moment de faire de la fantaisie...")
	await novel_interface.show_text_only("Où est Annie ? Et Rapha?l ?")
	await novel_interface.show_text_only("Ils doivent aussi se laisser aspirer par cet endroit !")
	await novel_interface.show_text_only("Je regarde autour d'eux dans la brume. De façon inattendue, une paire de bras chauds me tient par derrière.")
	await novel_interface.show_dialog("Ne vous inquiétez pas, Maître—", "Fille blonde")
	await novel_interface.show_text_only("C'est elle ! \\nLa fille nue me serre dans ses bras !")
	await novel_interface.show_text_only("J'ai beaucoup de questions pour elle. Mais j'hésite à regarder en arrière...")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Maître… Comme c'est étrange !) \\n(Tout comme les cinglés dans les films d'animation !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle semble chercher quelque chose à tâtons. Ses mains rampent le long de ma taille et s'arrêtent sur mon ventre plat.")
	await novel_interface.show_text_only("Dans le silence, j'entends mon cœur battre vite tandis que son souffle me chatouille les cheveux…")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(Que… va-t-elle faire ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah ?","Fille blonde")
	await novel_interface.show_text_only("Elle semblait avoir découvert quelque chose d'intéressant. Elle l'a pressé légèrement avec sa paume, et mon estomac a immédiatement laissé échapper un « gargouillis » insatisfaisant.")
	await novel_interface.show_text_only("Dans cet environnement calme, ce son est particulièrement perceptible.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Hein ? Pourquoi…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ahhhhhhh… Tellement embarrassant…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me détache d'elle. Elle s'approche de moi et me regarde avec curiosité.")
	await novel_interface.show_dialog("Le corps du Maître a-t-il également été modifié ? \\n… Quel produit alchimique parfait !","Fille blonde")
	await novel_interface.show_text_only("Je veux me couvrir les yeux, mais j'ai réalisé qu'elle était déjà habillée.")
	await novel_interface.show_text_only("Attends, est-ce qu'elle vient de dire que mon corps a été modifié ?! \\nEt… que porte-t-elle ?")
	await novel_interface.show_text_only("Un seul coup d'œil au costume d'Heinrich suffit à en révéler l'état de l'art.")
	await novel_interface.show_text_only("À en juger par la texture et le design, il ne peut pas être fabriqué au XVIe siècle… Non, cela dépasse même l’artisanat moderne.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Les informations de Mariru sont-elles fausses ?) \\n(Et comment connaît-elle ma transformation corporelle ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que j’essaie de verbaliser mes pensées, quelqu’un me fait soudainement reculer.")
	await novel_interface.show_text_only("C'est Rapha?l. Elle m'attrape par ma capuche, s'avance et se place entre moi et Heinrich.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Dis-moi, qui es-tu ?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("— Eh bien ?", "Fille blonde")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich se tourne vers Rapha?l, un sourire méprisant sur le visage.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Tu me demandes mon nom ? \\nJ'en ai des centaines.", "Fille blonde")
	await novel_interface.show_dialog("Mais vous pouvez m'appeler Henriette Khunrath, c'est celle qui figure sur le contrat.", "Fille blonde")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Ce n'est pas drôle !", "Raphael")
	await novel_interface.show_dialog("Heinrich est un homme dans tous les documents historiques...", "Raphael")
	await novel_interface.show_dialog("Et en plus, regarde ce que tu portes ! \\nAvez-vous confondu des sous-vêtements avec des vêtements d'extérieur ?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ne souille pas Heinrich le grand alchimiste, fille sans vergogne ! Arrêtez d’appeler les gens « maître » et… et de prendre l’essence des gens…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Rapha?l rougit en parlant.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… Qui diable es-tu !", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors qu'ils s'affrontaient, je n'ai pas pu m'empêcher de jeter un coup d'œil à Heinrich depuis le dos de Rapha?l.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Quelle est la matière de son costume…) \\n(Incroyable écharpe ! Comment ses seins pourraient-ils trembler dans différentes directions ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nos regards se croisent et je rougis aussitôt. Paniquée, je baisse les yeux sur ma jupe, évitant tout contact visuel ultérieur.")
