	await novel_interface.show_text_only("Je suis soudain curieux de savoir comment elle est entrée. Peut-être…")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Je me suis simplement coupé les cheveux, je me suis forgé plusieurs références et je suis entré à l'Université de Leipzig sous un pseudonyme.", "Henriette")
