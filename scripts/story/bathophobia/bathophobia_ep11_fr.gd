	await novel_interface.show_dialog("À mon époque, les universités n'admettaient pas les filles et l'Église interdisait aux femmes de pratiquer la médecine...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Sans parler de devenir alchimiste… Hmm, je ne veux pas avoir d'ennuis avec le tribunal religieux.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("… \\\\n", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("D’une manière ou d’une autre, je commence à me sentir indigné chaque fois que j’apprends l’oppression des femmes.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Il est facile de se débarrasser de ces chiens de cour, mais ils ne valent pas mon temps.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Wow… ça a l'air cool…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l regarde Heinrich pensivement.")
	novel_interface.show_character("ren_battle","happy")
