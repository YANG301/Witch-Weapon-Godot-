# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Milk retourne à la salle de contrôle et bloque la porte principale avec une chaise.")
	await novel_interface.show_text_only("Le groupe d’ennemis le plus proche arrivera dans quelques minutes seulement. L’autre groupe rencontrera bientôt également l’équipe de Milk dans l’aile est.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Hum. J'aurais dû y penser plus tôt...","Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si j'avais ma propre troupe de soldats extrêmement agiles, dotés d'une ouïe fine et d'incroyables capacités d'auto-guérison...")
	await novel_interface.show_text_only("Pourquoi les équiper d’armes blanches et non d’armes à feu ?")
	await novel_interface.show_text_only("Ces ennemis se déplacent en groupes, n’ont aucune stratégie à proprement parler, même s’ils sont tous des combattants incroyablement efficaces.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("On ne peut plus les considérer comme humaines, ces filles...","Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk jette un coup d’œil à la rangée d’équipements à gauche du panneau de commande principal. Sur celui-ci se trouve la boîte à spécimens que Beth a laissée derrière elle.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("La mission... n’a plus d’importance.","Lait")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Je suppose que les mesures de défense offensives stratégiques utilisées ici ne sont pas si mauvaises après tout...","Lait")
	await novel_interface.show_dialog("J'espère que le haut-parleur fonctionne toujours...","Lait")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle prend une profonde inspiration, se stabilise, avant de saisir une série de commandes dans le panneau de commande...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Pendant ce temps, dans l'entrepôt sombre, Beth voltige dans la pièce, cherchant frénétiquement quelque chose qui pourrait même ne pas être là.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("Le mot de passe... \\nQuel est le mot de passe ?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avec ses doigts tremblants, elle n’a plus aucune idée des touches sur lesquelles elle appuie sur le panneau de verrouillage.")
	await novel_interface.show_text_only("Si elle obtient le bon mot de passe, elle peut quitter l'entrepôt et se battre aux côtés de son amie.")
	await novel_interface.show_text_only("Mais Milk, de l’autre côté du mur, n’a laissé aucune indication sur ce que pourrait être le mot de passe.")
	await novel_interface.show_text_only("Peut-être qu'elle ne lui laissera plus jamais d'indices...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Non ! Non !\\nJe ne peux pas accepter ça ! Je n'accepterai pas ça !","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frénétique, Beth continue de frapper la porte avec ses poings, mais ses tentatives pour s'échapper sont vaines.")
	await novel_interface.show_text_only("Tout ce qu'elle peut faire, c'est imaginer ce qui va se passer ensuite de l'autre côté du mur, seule dans l'espace sombre, silencieux et confiné.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("S'il vous plaît, non...","Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Je suis inutile...)","Beth")
	await novel_interface.show_dialog("(Je ne peux sauver personne...)","Beth")
	await novel_interface.show_dialog("(Pas le Père..., pas le Lait...)","Beth")
	await novel_interface.show_dialog("(Comment... est-ce arrivé... ?)","Beth")
	await novel_interface.show_dialog("(Pourquoi suis-je si faible... ?)","Beth")
	await novel_interface.show_dialog("(Tellement impuissant...)","Beth")
	await novel_interface.show_dialog("(... Et égoïste.)","Beth")
	await novel_interface.show_dialog("(Pourquoi ?)","Beth")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("Tout ce que je veux, c'est ne pas être seul, ne pas avoir froid...")
	await novel_interface.show_text_only("Je n’en demande pas trop, n’est-ce pas... ?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille est assise seule dans le noir, les épaules tremblantes de sanglots.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Elle remarque à peine que les combats intenses et continus ont épuisé son corps jusqu'au cœur.")
	await novel_interface.show_text_only("Les accidents de décompression lui perturbent le cerveau.")
	await novel_interface.show_text_only("C’est comme si de l’eau bouillonnait dans sa tête, perturbant peu à peu sa conscience.")
	await novel_interface.show_text_only("Peut-être qu'elle n'a pas vu cela dans l'océan sombre et profond, après tout...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Elle a l’impression d’être au sommet d’un glacier, voire à l’intérieur d’un glacier. La glace, tranchante et dense, transperce son cœur, son âme.")
	await novel_interface.show_text_only("Son corps souple se fige peu à peu et son sang commence à se figer.") #换行问题
	await novel_interface.show_text_only("D’innombrables groupes de lumière pure l’entouraient jusqu’à couvrir complètement son existence.")
	await novel_interface.show_text_only("Il n’y a plus de douleur, plus de solitude.")
	await novel_interface.show_text_only("Pas plus.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("Dans ce monde d’un blanc pur, elle entend une mélodie familière.")
	await novel_interface.show_dialog("... Du lait ?","Beth")
	await novel_interface.show_text_only("C'est leur chanson préférée. Leur chanson.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("Dans une explosion explosive, des centaines d’orbes lumineux s’envolent du corps de Beth.")
	await novel_interface.show_text_only("La fille cligne des yeux et ouvre les yeux. La lumière blanche aveuglante, dans un fracas assourdissant, a emporté tout le mur.")
	await novel_interface.show_text_only("Le haut-parleur de la salle de contrôle joue sa chanson, qui résonne tout au long du tunnel. Milk a dû utiliser le fichier audio qu'elle a stocké dans sa montre.")
	await novel_interface.show_text_only("Des dizaines d'ennemis se sont rassemblés, attirés par le son. Ils étaient si nombreux, bien plus que ce qu'ils avaient prévu à l'écran.")
	await novel_interface.show_text_only("Les ennemis ont encerclé l'entrée de la salle de contrôle.")
	await novel_interface.show_text_only("Beth n'est plus qu'à trente mètres de la salle de contrôle.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(Tout ce dont j'ai besoin, c'est de dix secondes... non, cinq...)","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cinq secondes pour joindre sa meilleure amie idiote, l’empêcher de faire tout ce qu’elle veut faire.")
	await novel_interface.show_text_only("Un grand groupe de soldats parasites a immédiatement envahi Bai Zhu, et plusieurs lames tranchantes ont soudainement attaqué derrière elle.")
	await novel_interface.show_text_only("Elle se retourne, tirant plusieurs balles sous la forme de faisceaux de lumière brillants, faisant exploser ses cibles en mille morceaux sur le mur.")
	await novel_interface.show_text_only("Elle continue de se précipiter vers la salle de contrôle, son corps brillant d'une lumière plus brillante que jamais.")
	await novel_interface.show_text_only("Les ondes d'énergie rayonnant de son corps arrachent les parois intérieures du tunnel. Elle brille, aveuglante, comme un requiem venu du ciel.")
	await novel_interface.show_text_only("Personne ne peut l'arrêter maintenant.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("D'innombrables rayons blancs éclatants jaillissent de la base de Snedronningen, illuminant le ciel étoilé, comme si l'aube était tombée sur le continent endormi.")
	await novel_interface.show_text_only("Comme un rite de bienvenue pour une divinité, presque.")
	await novel_interface.show_text_only("Soudain, tout le continent commence à trembler...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("En quelques secondes seulement, Beth a tué des dizaines d’ennemis d’un seul coup. Elle recule, la vision brouillée par la lumière éclatante.")
	await novel_interface.show_text_only("La puissance jaillissant de son corps est sur le point de l’avaler entièrement.")
	await novel_interface.show_text_only("Alors qu'elle jette un ennemi hors du chemin avec la lame dans sa main droite...")
	await novel_interface.show_text_only("Une douzaine d'ennemis franchissent la porte bloquée de la salle de contrôle et chargent à l'intérieur.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Attends-moi... idiot...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("«J'arrive...»")
	await novel_interface.show_text_only("Boum !")
	await novel_interface.show_text_only("Un gigantesque arc électrique jaillit de la salle de contrôle. Puis les explosions arrivent, d’innombrables explosions enflammées en une seconde, juste devant les yeux de Beth.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("C’est comme si le temps s’était arrêté.")
	await novel_interface.show_text_only("Elle s'arrête net, tombant à genoux, à seulement quelques mètres de la salle de contrôle.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("C’est alors que ce continent glacé, impitoyable et froid, ouvre enfin les yeux de son sommeil sans fin.")
	await novel_interface.show_text_only("Dans l’obscurité, une ombre dorée jaillit des couches de glace souterraines, déchire le sol du tunnel et transperce silencieusement le torse de la jeune fille.")
	await novel_interface.show_text_only("C’est une lance, d’apparence simple si ce n’est les motifs dorés complexes tourbillonnant autour du fer de lance.")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_text_only("Un courant de chaleur tiède traversa la pointe du pistolet, suivit le corps du pistolet et se fusionna avec le sang.")
	await novel_interface.show_text_only("Ses bras tombent mollement sur ses côtés. Même si ses pupilles se dilatent, elle le regarde, comme si elle n’était pas encore prête à abandonner.")
	await novel_interface.show_text_only("Au sol, du sang cramoisi.")
	await novel_interface.show_text_only("Goutte à goutte. Goutte. Goutte.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La lumière vive qui enveloppait le continent s’estompe.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
