# bathophobia_ep26.gd - 深海恐惧症篇第26话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep26_script()

func play_script():
	pass

func bathophobia_ep26_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation1.png")
	await novel_interface.show_text_only("Chi sono io?")
	await novel_interface.show_text_only("L’ego occupa la maggior parte dello spazio nella coscienza umana.")
	await novel_interface.show_text_only("Tutto è sempre più importante se riguarda “me”.")
	await novel_interface.show_text_only("La mia stanza, il mio portatile, il mio telefono, il mio zaino, le mie sensazioni, i miei ricordi...")
	await novel_interface.show_text_only("Questi concetti sono sempre più speciali per noi, perché il nostro cervello li ha riconfezionati meticolosamente, conferendo loro nuovi significati oltre alle loro esistenze originarie.")
	await novel_interface.show_text_only("“Sono speciale”. Questo è ciò che il tuo cervello vuole farti credere.")
	await novel_interface.show_text_only("Per credere veramente in qualcosa, gli esseri umani cercano ogni tipo di prova.")
	await novel_interface.show_text_only("Le prove possono provenire dai luoghi più casuali. Articoli di rivista, esami, incontri, sogni...")
	await novel_interface.show_text_only("Finché vuoi credere che qualcosa sia vero, troverai la logica che stai cercando ovunque guardi.")
	await novel_interface.show_text_only("Questo è un effetto che gli psicologi chiamano “convalida soggettiva”.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Certo, puoi dire: “Devo essere speciale, purché credo di esserlo!”")
	await novel_interface.show_text_only("Bene, allora ecco la domanda:")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation2.png")
	await novel_interface.show_text_only("Il tuo ego è reale?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Rimaniamo tutti e tre in silenzio mentre ci incamminiamo verso la fine del tunnel dopo essere usciti dalla sala di controllo.")
	await novel_interface.show_text_only("Henriette pratica un enorme buco nel muro, nel punto in cui è passato l'uomo che abbiamo visto nel filmato.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Metal_Corridor.png")
	await novel_interface.show_text_only("Dietro il muro c'è un passaggio lungo e stretto, con una sorta di solido metallo giallo che ricopre le pareti.")
	await novel_interface.show_text_only("Anche la tormalina può illuminare solo una piccola sezione nel passaggio buio come la pece.")
	await novel_interface.show_text_only("Camminiamo in silenzio, i nostri passi echeggiano nel corridoio. È tutto così surreale in questo momento.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Siamo... ancora nel “sogno” di... chiunque esso sia?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Probabilmente. E la situazione è probabilmente più complicata di quanto ci aspettassimo.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza bionda spiega con espressione solenne, agitando la tormalina, che usa come torcia temporanea.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("La trappola elettrica per esplosioni nella sala di controllo deve essere “reale”. La potenza che sprigiona potrebbe aver arrostito i nostri organi interni.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("La mia tuta da battaglia ha subito il danno maggiore, ma fa ancora male...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Quando sogniamo, non ci svegliamo immediatamente quando proviamo una stimolazione improvvisa e forte... come il dolore?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Sì. Ma questo probabilmente non si applica a questo “sogno”. Molto probabilmente non ci sveglieremo nemmeno se moriamo.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ma finché uno di noi trova il modo di svegliarsi, non importa in che modo, dovrebbe riportarci tutti alla realtà.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Oppure continueremo a... continuare a dormire in questo incubo per sempre... ?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce di Raphael trema. È rimasta aggrappata all'orlo della mia camicia da quando siamo entrati nel corridoio.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Probabilmente ha paura del buio... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, il mio corpo mi avvisa di un problema totalmente serio.")
	await novel_interface.show_text_only("Stringo l'orologio che abbiamo portato con noi dalla sala di controllo.")
	await novel_interface.show_text_only("Durante le mie indagini, ho trovato per caso alcune informazioni in questo orologio.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("(Oppure invece di informazioni dovrei dire... una registrazione audio?)","Lian")
	await novel_interface.show_dialog("Spero che potremo trovare la risposta che vogliamo, e presto.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi costringo a camminare più velocemente.")
	await novel_interface.show_text_only("Devo sbrigarmi.")
	await novel_interface.show_text_only("Perché, dopotutto, chiunque abbia buon senso dovrebbe saperlo...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(Quando sogni che stai facendo pipì, di solito significa... )\\n(Uffa, non può andare peggio di così!)","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Finalmente arriviamo a quello che sembra un laboratorio dopo aver aperto una pesante porta di metallo.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Dovrebbe essere questo...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A differenza delle altre aree della base, il laboratorio è insolitamente silenzioso. Le pareti e il pavimento sembrano fatti di materiale fonoassorbente.")
	await novel_interface.show_text_only("Decine di vasche di coltura si profilano silenziose nello spazio scarsamente illuminato. L'unica fonte di luce sono le spie blu pallide tremolanti sui dispositivi.")
	await novel_interface.show_text_only("Sul soffitto vediamo tonnellate di cavi e tubi, disposti in modo ordinato.")
	await novel_interface.show_text_only("Anche per gli elevati standard della New Opulentia Accademia delle Scienze, questo è un laboratorio abbastanza ben attrezzato.")
	await novel_interface.show_text_only("Individuiamo presto l'unica attrezzatura ancora funzionante...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("La temperatura nella stanza è vicina al punto di congelamento. Il liquido azzurro nel serbatoio vigila silenziosamente, pazientemente, sul suo protetto.")
	await novel_interface.show_text_only("Lunghi capelli corvini, pelle di porcellana: la ragazza che dorme in quello che sembra un oceano azzurro è la stessa che abbiamo visto nel filmato della telecamera di sorveglianza.")
	await novel_interface.show_text_only("La sua pelle ha ancora colore, gli arti ondeggiano naturalmente nel liquido. Un flusso di bolle fluttua costantemente dalla sua maschera. Tutto questo deve significare...")
	await novel_interface.show_dialog("È... viva?","Raphael")
	await novel_interface.show_dialog("Ed è anche lei nel sogno? Oppure...","Lian")
	await novel_interface.show_text_only("Henriette si ferma davanti alla vasca, preme la mano sul vetro e scuote la testa.")
	await novel_interface.show_dialog("Questo dispositivo la sta semplicemente tenendo in vita, ritardando l'inevitabile.","Henriette")
	await novel_interface.show_dialog("(Sussurra) Strano...","Henriette")
	await novel_interface.show_text_only("La ragazza bionda osserva con curiosità le macchine e infine gira verso il fondo della vasca.")
	await novel_interface.show_dialog("Ah, proprio come mi aspettavo.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Raphael e io la seguiamo per vedere che la ferita della ragazza è ancora presente, visibile sotto il vestito sbrindellato.")
	await novel_interface.show_text_only("Anche se è meno una ferita e più una superficie pulita. Come una sezione trasversale.")
	await novel_interface.show_text_only("Come se fosse stato squarciato da un coltello da scatola. La pelle, i muscoli, le ossa... tutti ordinatamente disposti davanti ai nostri occhi.")
	await novel_interface.show_text_only("Il suo corpo non sembra averlo capito. Non si vede nessuna delle solite reazioni: nessun sanguinamento, nessuna iperplasia, la pelle attorno alla ferita non è nemmeno infetta o gonfia.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("La lancia sembra aver cancellato anche il concetto stesso di “ferita”. Il corpo non ha idea di dover tentare di guarire.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Troppi organi e nervi sono stati trafitti. Durerebbe pochi minuti se non fosse collegata a questo dispositivo.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Anche se non posso dire come sia successo esattamente, sembra che le altre parti del suo corpo dovrebbero essersi già riprese abbastanza da permetterle di riprendere conoscenza.)","Henriette")
	await novel_interface.show_dialog("(Se questo è il suo sogno in cui ci troviamo, dobbiamo trovare un modo per svegliarla.)","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, una debole luce bianca appare sul corpo della ragazza.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un sorriso scaltro si insinua sul volto della ragazza bionda.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("(L'unico modo per svegliare la Bella Addormentata... )","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Maestro, controllami il suo respiro, vero?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ah.","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("Torno davanti e guardo la ragazza nella vasca. Respira, sì, anche se molto lentamente.")
	await novel_interface.show_dialog("Carina...","Lian")
	await novel_interface.show_text_only("Allungo istintivamente la mano, le dita non vedono l'ora di toccare il serbatoio, ma Raphael mi dà una pacca sulla schiena.")
	await novel_interface.show_dialog("Scommetto che stai pensando di nuovo a cose perverse, eh?","Raphael")
	await novel_interface.show_dialog("N-no!\\nNon sono quel tipo di persona...","Lian")
	await novel_interface.show_text_only("Attraverso il liquido nel serbatoio, vedo Henriette dall'altra parte, che armeggia con alcuni fili e tubi.")
	await novel_interface.show_dialog("( __ELLIPSI__ ?)","Lian")
	await novel_interface.show_dialog("Si sta svegliando!","Henriette")
	await novel_interface.show_dialog("Eh?!","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesopen.png")
	await novel_interface.show_text_only("Dopo una serie di crepitii, gli occhi della ragazza nella vasca si aprono di scatto.")
	await novel_interface.show_text_only("Quegli occhi penetravano dritti nei miei...")
	await novel_interface.show_text_only("Un paio di occhi rosso vivo e privi di emozioni.")
	await novel_interface.show_text_only("Senza emozioni, eppure così seducente...")
	await novel_interface.show_text_only("All'improvviso, uno schiumoso bagliore argentato si irradia dal suo corpo. Il liquido nel serbatoio si gonfia, formando quello che sembra un vortice...")
	await novel_interface.show_text_only("E quella ragazza... sta fissando l'orologio che ho in mano con gli occhi di un predatore!")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Con un forte schiocco, il serbatoio va in frantumi.")
	await novel_interface.show_text_only("In una gloriosa esplosione argentata, il liquido blu divora Raphael e io come uno tsunami.")
	await novel_interface.show_text_only("La ragazza adesso è libera. E a giudicare dai suoi occhi, mi vuole morto.")
	await novel_interface.show_text_only("Ma si muove a malapena di mezzo pollice prima di accartocciarsi come un aquilone con la corda rotta.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, no!","Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Eh? Sono caduto?) \\n (Mi fa male la testa...)","Lian")
	await novel_interface.show_dialog("(Perché fa così freddo? Oh, sì, il liquido dal serbatoio... )\\n(Nemmeno Fire Jade può aiutare con quello... )","Lian")
	await novel_interface.show_dialog("(Oh no, mi sta...?)","Lian")
	await novel_interface.show_dialog("(Aspetta, se è così, ciò che le mie dita stanno toccando è quello di qualcun altro—)","Lian")
	await novel_interface.show_text_only("Al mio orecchio, una calda boccata d'aria.")
	await novel_interface.show_dialog("Tu!","Raphael")
	await novel_interface.show_dialog("Crepuscolo! Pervertito! Smettila di toccare!","Raphael")
	await novel_interface.show_text_only("Colpo!")
	await novel_interface.show_text_only("Ho una gomitata (molto pesante) allo stomaco.")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Mi siedo sul pavimento in mezzo alle tante pozzanghere, gocciolante e completamente confuso.")
	await novel_interface.show_text_only("Sì, confuso. Ma in qualche modo, non ho più paura.")
	await novel_interface.show_dialog("Ciao? Ren, mi copi?","Mariru")
	await novel_interface.show_text_only("Ah. Sono Mariru. Parlando dal walkie-talkie.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru espira di sollievo quando sente la mia stanca risposta.")
	await novel_interface.show_dialog("Comunque, cosa sta succedendo laggiù? Ragazzi, avete idea di quanto tempo siete assenti?\\nCi siamo già incontrati con Annie!","Mariru")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Stiamo bene, ma siamo un po' occupati adesso..., ci sentiamo più tardi.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Spengo il walkie-talkie e mi concentro nuovamente sulla ragazza dai capelli neri.")
	await novel_interface.show_text_only("Henriette si siede al suo fianco, lasciandola appoggiarsi sulla sua spalla.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("__ELLIPSI__","Ragazza misteriosa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza apre la bocca, cercando disperatamente di formare parole, ma non esce alcun suono.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Ehi, sta bene?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Non preoccuparti, la ferita si sta rimarginando.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("O dovrei dire che... il suo corpo sta... resuscitando?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","angry")
	await novel_interface.show_dialog("…","Ragazza misteriosa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembra che stia cercando qualcuno, ma non ne uscirà alcun suono. Sembra prossima alle lacrime.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ehi, rilassati, Bethy.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Provo a chiamarla con “quel nome”.")
	await novel_interface.show_text_only("La ragazza mi guarda, perplessa.")
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("Come hai fatto......","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le sue corde vocali sembrano arrugginite per il disuso.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Beth. Questo è il tuo nome, vero?","Lian")
	await novel_interface.show_dialog("Questo è quello che ho catturato dalla registrazione nell'orologio...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza fissa lo sguardo sull'orologio militare che ho in mano.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Apparteneva al tuo amico..., te lo ricordi?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le metto delicatamente l'orologio in mano e ci incrocio sopra le sue dita.")
	novel_interface.show_character("baizhu_normal","cry")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le sue pupille si dilatano rapidamente mentre guarda l'orologio. Le lacrime scendono in modo incontrollabile.")
	novel_interface.show_character("baizhu_normal","tear")
	await novel_interface.show_dialog("... Latte...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alla fine riesce a pronunciare correttamente il nome. Nei suoi occhi vedo angoscia, dolore, frustrazione.")
	await novel_interface.show_text_only("Mi sono seduto accanto a Bai Zhu e volevo consolarla. Nel momento in cui le ho toccato la spalla, la testa della ragazza era già caduta debolmente sulla mia spalla.")
	await novel_interface.show_text_only("La fronte di Beth aggrotta le sopracciglia mentre si rannicchia più vicino a me, con l'orologio ancora stretto in mano.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("(A bassa voce) Shh... va tutto bene, adesso è tutto finito.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le scompigliai delicatamente i capelli.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("... Deve essere esausta.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Bene…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dopotutto, sono passati diciannove anni.")
	
	print("=== 潜渊症篇第26话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
