# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("De pé no pódio, Mariru apresenta um relatório abrangente de progresso sobre as pesquisas recentes na videoconferência de rotina.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Em relação ao Projeto Ark…", "Kirs")
	await novel_interface.show_dialog("Da lista de relíquias fornecida por Salmonton, você escolheu o Pilar Tesheim Lapis, certo?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Sim, senhor. Agora a chave é como criar uma área de fluxo controlável.", "Mariru")
	await novel_interface.show_dialog("Todos os casos recentes de Fluxos de Espaço-Tempo em todas as cidades acadêmicas foram causados pelo contato humano com itens com propriedades Substance H.", "Mariru")
	await novel_interface.show_dialog("Esses itens permaneceram inativos por um longo tempo, mas foram ativados quase ao mesmo tempo.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Mais precisamente, Fragmento de Bruxa e Fragmentos de Grimório. Mas é melhor explicar isso em termos leigos.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Você quer dizer o dia em que o Cálice de Ross desapareceu…", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ainda não podemos confirmar a conexão deles.", "Mariru")
	await novel_interface.show_dialog("Como existem muitos fatores incontroláveis, temos que filtrar todas as relíquias por dois critérios.", "Mariru")
	await novel_interface.show_dialog("Primeiro, tem que ser uma substância de baixa atividade exibindo propriedades Substance H de acordo com a varredura de matiz.", "Mariru")
	await novel_interface.show_dialog("Em segundo lugar, o proprietário original é rastreável nos registos históricos e esta pessoa não deve ter quaisquer tendências de violência ou de cometer actos criminosos.", "Mariru")
	await novel_interface.show_dialog("O Tesheim Lapis Pillar foi originalmente propriedade de Heinrich Khunrath, um médico e alquimista durante a Renascença.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Baixa atividade… Que pena… Eu esperava que desta vez pudéssemos coletar dados mais próximos do valor crítico.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("A amostra é preciosa demais para ser perdida. É melhor ficar do lado seguro.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Eu só preciso provar a habilidade de Ren de passar por áreas de fluxo. Para isso, só precisamos agir.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Na verdade, o Pilar Lapis de Tesheim não é um Fragmento de Bruxa) \\n(É apenas um quase Substance H com inscrições mágicas.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Tocar no Fragmento de uma Bruxa é muito perigoso para pessoas comuns.) \\n(Afinal, eu não sou o homem gorila…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma gargalhada profunda sai da tela.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alquimista… Um pioneiro da ciência, né? \\nQue escolha interessante.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ouvi dizer que era uma obra de arte de grande significado histórico, e o proprietário Heinrich foi um dos fundadores do Rosenkreutz…", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("O Rosenkreutz era apenas um grupo religioso e ocultista. Não tem nada a ver com a atual agência de inteligência Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Acho que os alquimistas podem ser vistos como os cientistas daquela época. Felizmente, ele era um homem maravilhado com o desconhecido.", "Mariru")
	await novel_interface.show_dialog("Mas você conhece bem o Dr. Dekkers. Ele nunca nos emprestaria uma relíquia tão importante sem nenhum custo, a menos que...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um silêncio estranho preenche a sala.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Isso mesmo. O lado Salmonton deseja o compartilhamento de dados e um representante em nossa equipe.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Então, eles não desistiram de produzir mais bruxas…) \\n(Eles querem usar Ren como Estabilizador?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Bem anotado. Só quero confirmar que todos, incluindo o lado Salmonton, entendem o perigo deste experimento.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Afirmativo. Transformamos as mega instalações de drenagem subterrânea da antiga capital na Base Ark, caso o pior cenário aconteça.", "Kirs")
	await novel_interface.show_dialog("O sistema de intrusão de água do mar de ultravelocidade pode inundar toda a base em 30 segundos.", "Kirs")
	await novel_interface.show_dialog("Se algo der errado durante o experimento…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Nesse caso, espero que nosso querido Mariru tenha coragem de iniciar o dispositivo de autodestruição de emergência.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
