# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Uma brancura gritante.")
	await novel_interface.show_text_only("Um contorno borrado apareceu gradualmente diante dos meus olhos, e tudo ao meu redor parecia estar acelerando, como se estivesse caindo em alta velocidade de uma altitude de 10.000 metros.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Finalmente, meus pés tocam o chão, mas o impacto esperado não aconteceu. Apenas a dor nos ouvidos me lembra um aumento acentuado na pressão do ar.")
	await novel_interface.show_dialog("Ai…", "Lian")
	await novel_interface.show_text_only("Respiro fundo e percebo que saí daquele espaço. Este deve ser o mundo real, porque é tão maldito…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Que legal!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, sou açoitado pelo ar gelado e sinto fortes cólicas estomacais.")
	await novel_interface.show_text_only("Eu mal conseguia abrir meus olhos doloridos, como se os cílios estivessem todos congelados…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Quando finalmente recupero a visão, encontro tudo coberto de neve. O ar frio parece uma faca esfaqueando minha traqueia.")
	await novel_interface.show_text_only("Respiro o ar frio e não consigo evitar de tossir.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hoo-tosse!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Quanto tempo faz? Já está escuro? \\nOnde estamos…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No frio entorpecente, a temperatura do meu corpo cai rapidamente e começo a tremer involuntariamente.")
	await novel_interface.show_text_only("Ao meu lado, Heinrich parece animado de alguma forma. \\nAnnie e Raphael estão deitadas na neve, exaustas.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Mestre, você sente frio?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich segura minha mão gentilmente.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Ei...?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sinto o calor se espalhar das pontas dos dedos por todo o meu corpo, como se estivesse sentado perto de uma lareira.")
	await novel_interface.show_text_only("Surpreso, olho para essa garota que usa ainda menos do que eu. Quando ela solta minhas mãos, encontro algumas pedras douradas em minhas palmas.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("O que são estes…?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você vai se sentir melhor com este jade quente.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Embora os cristais de jade não sejam quentes ao toque, eles podem irradiar calor por todo o corpo.")
	await novel_interface.show_text_only("Com essas pedras, o deserto gelado e nevado se transforma em um lugar quente e aconchegante.")
	await novel_interface.show_text_only("Isso me faz pensar se o ambiente não passa de uma cena de estúdio.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Legal…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Apenas alguns brinquedos. Eu os fiz com ferramentas alquímicas e inscrições de conversão de energia.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich diz modestamente, mas com uma expressão de satisfação no rosto.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Não, não, isso é incrível!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso é realmente incrível… A tecnologia para esses materiais feitos pelo homem com propriedades Substance H ainda é secreta até hoje.")
	await novel_interface.show_text_only("Peguei o jade quente e coloquei alguns pedaços nas mãos de Raphael e Annie.")
	await novel_interface.show_text_only("Ao tocar suas mãos, posso sentir a temperatura corporal aumentando rapidamente.")
	await novel_interface.show_dialog("Tosse… Tosse…", "Raphael")
	await novel_interface.show_dialog("Hum... hum...", "Annie")
	await novel_interface.show_text_only("Com um ataque de tosse, Annie e Raphael recuperam a consciência.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Você está bem?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ao vê-los acenar de volta sonolentos, dou um suspiro de alívio.")
	await novel_interface.show_text_only("Começo a olhar em volta e me vejo em um chão de cascalho congelado, coberto por uma fina camada de neve.")
	await novel_interface.show_text_only("Sobre a brancura paira uma estranha calma, como se a paisagem fosse apenas uma simulação de computador.")
	await novel_interface.show_text_only("Ao meu lado, Heinrich está murmurando para si mesma, imerso em pensamentos.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Como conseguimos escapar daquele espaço…", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Não, não foi uma fuga… Mas a Fenda da Causalidade foi forçada a rachar.", "Henriette")
	await novel_interface.show_dialog("Mas como é que isso acontece? Até mesmo o Um deve seguir a Regra da Causalidade ao transmitir pessoas—", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("Poderia ser... ela...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich se vira para olhar para Ren involuntariamente.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Uau, isso é neve de verdade? Não está nada frio.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Coletei uma bola de neve com muito interesse, mas depois de olhar para elas resolvi jogar a bola de neve no chão...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(Devo parecer totalmente estúpido…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma rajada de vento cortante joga cristais de gelo em meu rosto.")
	await novel_interface.show_text_only("Graças ao topázio, não sinto frio nenhum.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Onde diabos estamos…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me levanto. Abaixo de mim está o campo de neve plano.")
	await novel_interface.show_text_only("Ao longe, montanhas cobertas de geleiras erguem-se da borda do campo de neve.")
	await novel_interface.show_text_only("O céu deveria estar cheio da escuridão da noite.")
	await novel_interface.show_text_only("Mas—")
	await novel_interface.show_text_only("É iluminado por uma faixa colorida de luz que se estende até o horizonte.")
	await novel_interface.show_text_only("Raios de luzes coloridas são claramente visíveis sob as estrelas. O céu é iluminado por uma cor esverdeada fluorescente listrada de violeta e rosa.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Isso é... aurora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ver as fotos na Internet não se compara ao espanto de vê-las pessoalmente.")
	await novel_interface.show_text_only("Entre a noite estrelada e o puro campo de neve flutuam raios de brilho brilhante.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Estamos no… Círculo Polar Ártico?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não… de jeito nenhum?!")
	await novel_interface.show_text_only("Heinrich choca a cabeça dela.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Ufa… Deve ser algum tipo de imagem 3D…)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("O efeito desta simulação é muito bom, até a temperatura e o toque...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Estamos na Antártica.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Espere, ela acabou de dizer Antártica...)\\n(Aquele com os pinguins...?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("…Eh? O que??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Antártida?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("A área correspondente à nona Sephirot.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Vocês falaram sobre eles antes, a Árvore da Vida, Sephiroth, blá, blá, blá, que diabos…", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Diz a lenda que Deus usou a Árvore da Vida como modelo para o universo. É como um mapa estrutural do mundo.", "Henriette")
	await novel_interface.show_dialog("Quanto às Sephirot… são os dez pilares que sustentam a Árvore da Vida.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("De acordo com The One, pelo menos…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A julgar pela expressão facial dela, Heinrich realmente não acredita na lenda.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Portanto, a nona Sephirot corresponde… à Antártica. É esta a área onde precisamos proteger desta vez?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Mas contra o quê? Selos!?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De acordo com as nossas experiências anteriores, mesmo áreas não atravessadas podem gerar catástrofes.", "Henriette")
	await novel_interface.show_dialog("As disputas entre os humanos não são nada comparadas ao poder da natureza.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mas… parece que não pousamos no lugar certo.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Em outras palavras, estamos livres por enquanto.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sorri para mim, com os olhos brilhando.")
	novel_interface.character_light()
	await novel_interface.show_dialog("É a primeira vez que desfruto da liberdade em centenas de anos, mesmo este lugar é desolado, e mesmo que seja apenas por um tempo…", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Hahaha… O Único deve estar muito irritado agora!", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("E – o crédito é para você, Ren!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Com a mão no coração, ela faz uma reverência para mim.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("O que, eu? Eu fiz alguma coisa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Ainda não tenho ideia sobre suas próprias habilidades… Interessante.)", "Henriette")
	await novel_interface.show_dialog("Transcendendo as regras estabelecidas por The One—", "Henriette")
	await novel_interface.show_dialog("Você deve ter inscrito a verdade em sua alma, Mestre.", "Henriette")
	await novel_interface.show_dialog("Esse é o nível que ansiava durante a minha vida.", "Henriette")
	await novel_interface.show_dialog("Qual é o preço para atingir esse nível?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Não entendo essa coisa de nível…", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Mas o preço é enorme!")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("O vento está ficando forte, vamos encontrar algum lugar para nos esconder?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Siga em frente… Há um depósito…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie fala com voz fraca.")
	await novel_interface.show_text_only("Ela se esforça para ficar de pé, a mão apontando para frente.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Existe uma arquitetura circular. Não é grande, mas tem um espaço para rastejar de mais de 9 metros de altura para se manter protegido contra tempestades de neve.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Vidro duplo resistente ao frio com grande estrutura metálica…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Usando um estilo minimalista tão pouco prático na região polar… Devem ser aqueles caras nórdicos.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O fio de aço que segura a escada está quebrado e todos os degraus caíram no chão, deixando apenas dois corrimãos pendurados.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Com licença... alguém aqui?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Fique esperto, idiota! Ninguém seria tolo o suficiente para ficar em uma casa de vidro com dissipação de calor tão alta durante a noite polar!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebi que a noite no Círculo Polar Antártico dura meio ano. Agora eu realmente perco a noção do tempo.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Skuld?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie ainda parece pálido. Ela mal consegue se segurar depois que entramos no depósito.")
	await novel_interface.show_text_only("Corro para pegá-la enquanto ela perde o controle do corpo e cai no chão.")
	await novel_interface.show_dialog("Ufa…", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Nenhuma facilidade de comunicação no primeiro andar. Precisamos tentar subir.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Subindo?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com essas palavras, Heinrich caminha até o corrimão.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Resmungando) Hmm... é um material que eu nunca vi antes...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mas não é difícil reconstruí-lo…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela pega o fio quebrado e tira um pedaço de pedra parecida com uma gema.")
	await novel_interface.show_text_only("A fissura é torcida, alongada e conectada suavemente, como se fosse dúctil nas mãos de Heinrich.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Então isso é alquimia…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um olhar de admiração aparece no rosto altivo de Raphael.")
	await novel_interface.show_text_only("Heinrich pega o arame, seu traje de batalha começa a brilhar em cores diferentes.")
	await novel_interface.show_text_only("Ela então dá um puxão no fio, que é apertado novamente. Uma dúzia de degraus são puxados de volta ao seu lugar original.")
	await novel_interface.show_text_only("Ela recoloca o fio na fivela no chão, como se fosse apenas um novelo de lã macio.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Uau… Maravilhoso!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Bem… Pelo menos a propriedade de reforço deste traje de batalha é bastante útil para alquimistas.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Afinal, às vezes temos que lidar com problemas... problemas além da imaginação.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Colocando Annie no sofá, nós três subimos as escadas…")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
