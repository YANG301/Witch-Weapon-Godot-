	await novel_interface.show_text_only("これを持っているだけで、氷雪の中でも\\nまるで暖かい室内のようだ。")
	await novel_interface.show_text_only("もはや、周りの雪原が撮影スタジオの背景セット\\nだと勘違いしてしまうぐらいの違和感を覚える。")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
