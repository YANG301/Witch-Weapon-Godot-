# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("一面が純白の中。")
	await novel_interface.show_text_only("ぼやけた輪郭が徐々に目の前に現れ、まるで高度1万メートルから高速で落下するかのように、周囲のすべてが加速しているように見えました。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("そのまま地面が両足に触れたが、感じた衝撃は\\n特になく、\\n耳への圧力が急上昇した事によって\\n強烈な不快感だけを感じた。")
	await novel_interface.show_dialog("ぃ…痛っ……", "小憐")
	await novel_interface.show_text_only("最初に吸い込んだ空気で分かった。\\nあの空間から脱出して、現実に戻ったのだ！\\nだって周りの空気は本当に……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("さ、寒いいいいいいぃぃぃぃぃ――ッッ！？！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目を開ける前から、体は肌を刺すような強烈な\\n寒さに包まれていた。\\nそして、下腹部から痛みが一定のリズムを\\n刻むように伝わってくる。")
	await novel_interface.show_text_only("まつ毛を動かすだけでも鈍痛が走る。\\n\\nまるで凍り付いたみたいに、目を開けるだけでも\\n一苦労だ……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("やっとのことで目を開くと、周囲は白銀の世界に\\n覆われていた。\\n吸い込んだ冷たい空気によって、\\n呼吸気管が切り刻まれたかのように痛む。")
	await novel_interface.show_text_only("冷気が喉へと入り込み、咳が止まらない。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("ゴホッ──ケホッケホッ！！", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("どれくらい経ったんだ？　もう夜なのか？\\n\\nというか俺達は今、どこにいるんだ……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("寒さは思考能力さえも奪い去る。\\n\\n俺の身体から熱量が急激に失われていき、\\n先ほどから震えが止まらない。")
	await novel_interface.show_text_only("隣にいるハインリッヒは、なぜか興奮した表情を\\n浮かべている。\\nアニーとラファエルは右側の雪の上で、\\n揃って気を失っていた。")
