# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Una blancura deslumbrante.")
	await novel_interface.show_text_only("Un contorno borroso apareció gradualmente frente a mis ojos, y todo a mi alrededor parecía acelerarse, como si cayera a gran velocidad desde una altitud de 10,000 metros.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Finalmente mis pies tocan el suelo, pero el impacto esperado no se produjo. Sólo el dolor en mis oídos me recuerda un fuerte aumento de la presión del aire.")
	await novel_interface.show_dialog("Ay...", "Lian")
	await novel_interface.show_text_only("Respiro y me doy cuenta de que he abandonado ese espacio. Este debe ser el mundo real, porque es tan maldito...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¡Genial!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, el aire helado me azota y me duele el estómago.")
	await novel_interface.show_text_only("Apenas podía abrir los ojos que me picaban, como si tuviera todas las pestañas congeladas…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Cuando finalmente recupero la vista, lo encuentro todo cubierto de nieve. El aire frío se siente como un cuchillo apuñalándome la tráquea.")
	await novel_interface.show_text_only("Respiro el aire frío y no pude evitar toser.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¡Hoo, tos, tos!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("¿Cuánto tiempo ha pasado? ¿Ya está oscuro? \\n¿Dónde estamos...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el frío entumecedor, la temperatura de mi cuerpo desciende rápidamente y empiezo a temblar involuntariamente.")
	await novel_interface.show_text_only("A mi lado, Heinrich parece algo emocionado. \\nAnnie y Raphael están tumbadas en la nieve, exhaustas.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Maestro, ¿sientes frío?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich toma mi mano suavemente.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("¿Eh…?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Siento el calor extenderse desde las yemas de sus dedos por todo mi cuerpo, como si estuviera sentado junto a una chimenea.")
	await novel_interface.show_text_only("Sorprendida, miro a esta chica que viste incluso menos que yo. Cuando suelta mis manos, encuentro algunas piedras doradas descansando en mis palmas.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("¿Qué son estos…?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Te sentirás mejor con estos cálidos jade.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aunque los cristales de jade no son calientes al tacto, pueden irradiar calor por todo el cuerpo.")
	await novel_interface.show_text_only("Con estas piedras, el páramo helado y nevado se convierte en un lugar cálido y acogedor.")
	await novel_interface.show_text_only("Me hace preguntarme si los alrededores no son más que una escena de estudio.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genial…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Sólo algunos juguetes. Los hice con herramientas alquímicas e inscripción de conversión de energía.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich dice modestamente, pero con una expresión de satisfacción en su rostro.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¡No, no, eso es increíble!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eso es realmente asombroso... La tecnología para estos materiales artificiales con propiedades Substance H sigue siendo un alto secreto incluso hoy en día.")
	await novel_interface.show_text_only("Tomé el jade tibio y puse algunos pedazos en las manos de Raphael y Annie.")
	await novel_interface.show_text_only("Mientras toco sus manos, puedo sentir que la temperatura de su cuerpo aumenta rápidamente.")
	await novel_interface.show_dialog("Tos... tos...", "Raphael")
	await novel_interface.show_dialog("Mmm… eh…", "Annie")
	await novel_interface.show_text_only("Con un ataque de tos, Annie y Raphael recuperan el conocimiento.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("¿Estás bien?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al ver que asienten adormilados, suspiro de alivio.")
	await novel_interface.show_text_only("Empiezo a mirar a mi alrededor y me encuentro de pie sobre un suelo de grava congelado cubierto por una fina capa de nieve.")
	await novel_interface.show_text_only("Sobre la blancura flota una extraña calma, como si el paisaje fuera sólo una simulación por ordenador.")
	await novel_interface.show_text_only("A mi lado, Heinrich murmura para sí misma, sumida en sus pensamientos.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("¿Cómo pudimos escapar de ese espacio?", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("No, no fue un escape... Pero la Grieta de la Causalidad se vio obligada a resquebrajarse.", "Henriette")
	await novel_interface.show_dialog("¿Pero cómo es eso? Incluso El Uno debería seguir la Regla de Causalidad al transmitir a las personas...", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("¿Podría ser... ella...?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich se vuelve para mirar a Ren involuntariamente.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Vaya, ¿es esto nieve de verdad? No hace nada de frío.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Recogí una bola de nieve con mucho interés, pero después de mirarlas, decidí tirar la bola de nieve al suelo...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(Debo parecer completamente estúpido…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una ráfaga de viento amargo me arroja cristales de hielo a la cara.")
	await novel_interface.show_text_only("Gracias al topacio no siento nada de frío.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Dónde diablos estamos...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me levanto. Debajo de mí está el campo nevado plano.")
	await novel_interface.show_text_only("A lo lejos, desde el borde del campo nevado se elevan montañas cubiertas de glaciares.")
	await novel_interface.show_text_only("El cielo debería haberse llenado de la oscuridad de la noche.")
	await novel_interface.show_text_only("Pero—")
	await novel_interface.show_text_only("Está iluminado por una banda de luz de colores que se extiende hacia el horizonte.")
	await novel_interface.show_text_only("Bajo las estrellas se ven claramente rayos de luces de colores. El cielo está iluminado por un color verdoso fluorescente rayado de violeta y rosa.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(¿Es esto... aurora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ver las fotos en Internet no se compara con el asombro de verlas en persona.")
	await novel_interface.show_text_only("Entre la noche estrellada y el puro campo de nieve flotan rayos de brillante resplandor.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Estamos en… el Círculo Polar Ártico?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡¿No… de ninguna manera?!")
	await novel_interface.show_text_only("Heinrich se sacude la cabeza.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Uf… Deben ser algún tipo de imágenes en 3D…)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("El efecto de esta simulación es bastante bueno, incluso la temperatura y el tacto...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Estamos en la Antártida.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Espera, ella acaba de decir Antártida...)\\n(¿El de los pingüinos...?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("…¿Eh? ¿¿Qué??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Antártida?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("El área correspondiente a la novena Sephirot.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Ustedes hablaron de ellos antes, el Árbol de la Vida, Sephiroth, bla, bla, bla, qué diablos...", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cuenta la leyenda que Dios usó el Árbol de la Vida como modelo para el universo. Es como un mapa estructural del mundo.", "Henriette")
	await novel_interface.show_dialog("En cuanto a las Sephirot… son los diez pilares que sostienen el Árbol de la Vida.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Según The One, al menos…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A juzgar por su expresión facial, Heinrich realmente no cree en la leyenda.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Entonces la novena Sephirot corresponde a… la Antártida. ¿Es esta el área donde debemos proteger esta vez?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("¿Pero contra qué? ¿Sellos?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Según nuestras experiencias anteriores, incluso las zonas no atravesadas pueden generar catástrofes.", "Henriette")
	await novel_interface.show_dialog("Las disputas entre humanos no son nada comparadas con el poder de la naturaleza.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Pero… parece que no hemos aterrizado en el lugar correcto.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("En otras palabras, somos libres por ahora.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich me sonríe y sus ojos brillan.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Es la primera vez que disfruto de la libertad en cientos de años, incluso este lugar está desolado, y aunque sea solo por un tiempo…", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Jajaja… ¡El Único debe estar muy molesto ahora mismo!", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¡Y el mérito es tuyo, Ren!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Con la mano en el corazón, me hace una reverencia.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Qué, yo? ¿Hice algo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Aún no tengo idea de sus propias habilidades... Interesante.)", "Henriette")
	await novel_interface.show_dialog("Trascendiendo las reglas establecidas por The One—", "Henriette")
	await novel_interface.show_dialog("Debes haber grabado la verdad en tu alma, Maestro.", "Henriette")
	await novel_interface.show_dialog("Ese es el nivel que anhelaba durante mi vida.", "Henriette")
	await novel_interface.show_dialog("¿Cuál es el precio por alcanzar este nivel?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("No entiendo esto del nivel...", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("¡Pero el precio es enorme!")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("El viento se está poniendo fuerte, ¿buscamos algún lugar donde escondernos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Siga recto... Hay un depósito...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie habla con voz débil.")
	await novel_interface.show_text_only("Ella lucha por ponerse de pie, con la mano apuntando hacia adelante.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Hay una arquitectura circular. No es grande bajo ninguna medida, pero tiene un espacio de acceso de más de 30 pies de altura para mantenerse a salvo de las tormentas de nieve.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Vidrio doble a prueba de frío con una gran estructura metálica…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Usar un estilo minimalista tan poco práctico en la región polar… Deben ser esos tipos nórdicos.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El alambre de acero que sujeta la escalera está roto y todos los escalones han caído al suelo, dejando solo dos pasamanos colgando.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Disculpe… ¿hay alguien aquí?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¡Anímate, idiota! ¡Nadie sería tan tonto como para quedarse en una casa de cristal con una disipación de calor tan alta durante la noche polar!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy cuenta de que la noche en el Círculo Antártico dura medio año. Ahora realmente pierdo la noción del tiempo.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie todavía luce pálido. Apenas puede sostenerse después de que entramos al depósito.")
	await novel_interface.show_text_only("Me apresuro a atraparla mientras ella pierde el control de su cuerpo y cae al suelo.")
	await novel_interface.show_dialog("Uf…", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("No hay instalaciones de comunicación en el primer piso. Tenemos que intentar subir las escaleras.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("¿Subir las escaleras?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al oír estas palabras, Heinrich se acerca a los pasamanos.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Murmurando) Hmm... es material que no había visto antes...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Pero no es difícil reconstruirlo…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Recoge el cable roto y saca un trozo de piedra que parece una gema.")
	await novel_interface.show_text_only("La fisura está retorcida, alargada y conectada suavemente, como si fuera dúctil en las manos de Heinrich.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Entonces esto es alquimia...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una mirada de admiración aparece en el rostro altivo de Raphael.")
	await novel_interface.show_text_only("Heinrich toma el cable y su traje de batalla comienza a brillar en diferentes colores.")
	await novel_interface.show_text_only("Luego tira del cable, que se vuelve a apretar. Una docena de escalones regresan a su lugar original.")
	await novel_interface.show_text_only("Vuelve a colocar el cable en la hebilla del suelo, como si fuera sólo un suave ovillo de hilo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Vaya… ¡Maravilloso!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Bueno… Al menos la propiedad de refuerzo de este traje de batalla es bastante útil para los alquimistas.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Después de todo, a veces tenemos que lidiar con problemas... problemas que van más allá de la imaginación.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Poniendo a Annie en el sofá, los tres subimos las escaleras…")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
