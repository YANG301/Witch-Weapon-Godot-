# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("O terremoto no Pólo Sul não dura muito. A camada vazia abaixo da estação de abastecimento, estabelecida como precaução contra nevascas, efetivamente diminui os danos causados ​​pelos tremores.")
	await novel_interface.show_text_only("Em menos de um minuto, a terra retorna ao seu estado anterior de calma.")
	await novel_interface.show_text_only("Eu cresci nas fronteiras do Aegis – um terremoto desse tamanho não me incomoda nem um pouco.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Apenas um pequeno terremoto. Todos bem?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Sim... mas por que segurar a saia foi sua primeira reação?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Tipo, você tem certeza de que essa deveria ser sua prioridade em um terremoto?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, bem,... \\nÉ só...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ah, vamos lá, me dê um tempo!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ainda assim, é estranho. A Antártica é um continente coberto por camadas e mais camadas de gelo espesso. Não é uma zona propensa a terremotos, com certeza.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael franze a testa, olhando para fora da janela.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ou lembrei errado?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Então a Nona Sephira finalmente causou um problema, hein...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Ren, olhe!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie chama de repente, apontando para fora da janela. Eu me inclino mais perto para dar uma olhada.")
	await novel_interface.show_text_only("Uma rachadura gigantesca apareceu na camada plana de gelo. Sob o céu aveludado, parece quase um abismo que leva direto ao Inferno.")
	await novel_interface.show_text_only("De certa forma, é menos uma fenda e mais como um desfiladeiro...")
	await novel_interface.show_text_only("Na borda da abertura, algumas pontas afiadas permanecem eretas. Estruturas anormais em forma de rede surgem das profundezas da espessa camada de gelo.")
	await novel_interface.show_text_only("Os penhascos de gelo de ambos os lados parecem permanecer aproximadamente na mesma altura. É como se alguma força inimaginável tivesse destruído toda a plataforma de gelo.")
	await novel_interface.show_text_only("A enorme fenda serpenteia em direção às terras altas, desaparecendo de vista...")
	await novel_interface.show_text_only("Felizmente estamos aqui no vale. Estamos seguros aqui.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Ei, o que é isso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e Henriette se aproximam para ver o que estou apontando. Ambos suspiram.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Esse prédio... por que não foi afetado?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nas planícies geladas bem à nossa frente, uma enorme estrutura feita pelo homem surge bem no caminho da fenda que se espalha, completamente despreocupada.")
	await novel_interface.show_text_only("Suas paredes escuras parecem deslocadas nesta terra branca e pálida.")
	await novel_interface.show_text_only("Em vez de destruir o edifício como deveria, a fenda o circunavegou na forma de dois arcos, como se houvesse algo na estrutura que não quisesse perturbar.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Esse é o ponto de encontro Mariru que acabamos de mencionar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Parece ser o local certo.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A estática crepitante pode ser ouvida no painel de controle. Parece que a estação de abastecimento está restabelecendo a ligação com o mundo exterior.")
	await novel_interface.show_dialog("Olá? Ren? Você pode me ouvir?", "Mariru")
	await novel_interface.show_text_only("Mariru parece meio nervoso.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Antes que o grupo de satélites de reconhecimento que convocamos termine de mudar de rota, o feed gráfico da Antártica só pode ser atualizado uma vez a cada trinta e cinco minutos em formato estático.")
	await novel_interface.show_text_only("Na tela, mensagens contendo informações que Mariru coletou das principais estações polares continuam aparecendo.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Algo está errado. Este terremoto... não é normal.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Estranho, ainda não consigo receber sinal do pessoal da Base Snedronningen...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru olha de soslaio para o mais recente relatório atualizado do sensor meteorológico da Base de Nuremberg.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Espere, isso é...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru bate freneticamente em seu dispositivo portátil, acessando todos os dados de monitoramento meteorológico e hidrológico em tempo real na Antártida que consegue encontrar.")
	await novel_interface.show_text_only("É fácil ver que os números estão mudando – de forma rápida e consistente. De repente, ela se lembrou de um curso que fez na universidade...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Diga-me, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Hum?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mesmo sem considerar o impacto das armas nucleares e dos objectos estranhos, ainda existem muitos factores naturais à espreita na Terra que podem causar “o fim do mundo”.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Claro. Os humanos, na verdade, só apareceram após a quinta extinção em massa na Terra. Fatores naturais podem ser realmente letais.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("E quando se trata do elemento natural mais perigoso que pode ser encontrado na Antártida...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Droga... é metano!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, você tem certeza de que a rachadura está perto da sua localização?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sim. Mas o que é estranho é que...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Relatei a Lililiu a informação de que a fenda parecia estar contornando deliberadamente a base da Rainha Branca.")
	await novel_interface.show_text_only("Mariru pondera um pouco sobre essa informação. Quando ela fala novamente, seu tom é nítido e profissional.")
	await novel_interface.show_dialog("Ouça, é provável que o metano que esteve selado no subsolo durante milhões de anos esteja atualmente vazando da fenda.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Espere... tipo, sim, eu sei que bilhões de toneladas de metano estão armazenadas no subsolo aqui, mas... eles não são sólidos? Como gelo inflamável?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Eles podem ter vaporizado devido à pressão causada pela ruptura da plataforma de gelo no terremoto. Pelo menos os expostos provavelmente o fizeram.", "Ai")
	await novel_interface.show_dialog("De acordo com os sensores da Base de Nuremberg, os níveis de metano acima da Antártica aumentaram 2,1 ppm em comparação com uma hora atrás, antes do terremoto acontecer.", "Mariru")
	await novel_interface.show_dialog("Os números diferem entre outras estações meteorológicas, mas os resultados são os mesmos: há um aumento dramático no nível de metano, não importa como você olhe para isso.", "Mariru")
	await novel_interface.show_dialog("A área oceânica próxima à plataforma de gelo Amery também apresentou anormalidades. Acreditamos que seja porque o gás metano do fundo do oceano borbulhou, causando uma perturbação nas marés.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Se bem me lembro, o efeito estufa provocado pelo metano é vinte e uma vezes maior que o do dióxido de carbono...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Então... vai ficar mais quente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faço o possível para lembrar o que li naqueles panfletos de preservação ambiental que recebemos na escola.")
	await novel_interface.show_dialog("As marés já estão subindo, enquanto a velocidade do vento diminui. A temperatura subirá... 0,2 graus a cada 12 horas. E não vai parar de subir por um bom tempo.", "Mariru")
	await novel_interface.show_dialog("Isto significa que os nossos oceanos ficarão em breve privados de oxigénio, o que, naturalmente, arruinará todo o ecossistema. A maioria dos seres vivos do nosso planeta será expurgada.", "Mariru")
	await novel_interface.show_text_only("Raphael finalmente parece perceber o quão séria é a situação.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Então... em duas semanas... todas as plantas expostas murcharão...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("E em três semanas, a maioria dos animais enfrentará a extinção. 90% dos humanos não terão água potável. Mesmo os satélites em órbita terrestre baixa não se moverão mais como deveriam devido à mudança em nossa atmosfera...", "Ai")
	await novel_interface.show_dialog("Dentro de quarenta e cinco dias, apenas algumas espécies raras – insetos, todas elas – sobreviverão em tal ambiente.", "Mariru")
	await novel_interface.show_dialog("Se não fizermos alguma coisa, e rápido, logo nos tornaremos alimento para esses insetos.", "Ai")
	await novel_interface.show_text_only("Não consigo evitar o arrepio que percorre minha espinha enquanto olho para a fenda que levará à destruição da humanidade.")
	await novel_interface.show_text_only("Mariru limpa a garganta. Todos os presentes prendem a respiração e aguardam suas ordens.")
	await novel_interface.show_dialog("Não há um minuto a perder. A cada segundo que passa, a rachadura continua a causar mais danos.", "Mariru")
	await novel_interface.show_dialog("Se ficarmos sentados esperando que o Congresso Unido envie sua equipe de emergência, será tarde demais.", "Mariru")
	await novel_interface.show_dialog("Além disso, não é como se a equipe de emergência soubesse como lidar com algo assim...", "Mariru")
	await novel_interface.show_dialog("Então, Henriette...", "Mariru")
	await novel_interface.show_text_only("Todos nos voltamos para o alquimista, que não parece muito surpreso por ter sido chamado por Mariru.")
	await novel_interface.show_dialog("Se isso estiver de alguma forma relacionado à Nona Sephira que você deveria proteger..., então você já encontrou algo que poderia ter repercussões tão sérias quanto esta?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("Veja, isso é o que é mais chato no meu trabalho!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A alquimista loira balança a cabeça com um sorriso pálido enquanto relembra.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("O Único geralmente me teletransporta para o local do incidente e me deixa lá.", "Henriette")
	await novel_interface.show_dialog("Mas se deixarmos “esse tipo de coisa” por aí sem alguém para lidar com isso, o mundo pode muito bem acabar aqui.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 d.C., Monte Huaynaputina, perto da colônia espanhola>", "Henriette")
	await novel_interface.show_dialog("Eu estava me rebelando contra o Único e arrastei minha missão por mais alguns dias. No final, todas as aldeias num raio de poucos quilômetros estavam completamente em ruínas.", "Henriette")
	await novel_interface.show_text_only("Sua expressão é incrivelmente triste.")
	await novel_interface.show_dialog("Eu ainda fiz meu trabalho... mas muitos morreram. Foram mais de sessenta mil vidas humanas que eu poderia ter salvado.", "Henriette")
	await novel_interface.show_dialog("As cinzas do vulcão permaneceram na atmosfera, bloqueando a luz solar da terra por mais de um ano. Aqueles foram os anos mais frios nessas duas décadas.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette olha para baixo, sem querer continuar.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Aquele desastre vulcânico no Peru no final do século XV, hein...", "Ai")
	await novel_interface.show_dialog("—Esta é uma crise da mesma magnitude, de fato.", "Mariru")
	await novel_interface.show_dialog("A temperatura extremamente baixa que assolou o mundo nos anos seguintes provocou fome e guerras em todo o mundo. Alguns impérios até caíram durante esse período.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Parece muito sério...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Essa era uma responsabilidade muito pesada para você carregar sozinho.", "Mariru")
	await novel_interface.show_dialog("Ren, você não mencionou métodos de viagem em climas extremamente frios?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Você quer dizer... você quer que viajemos, dê uma olhada na base? Veja o que podemos fazer para ajudar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Certo. Embora não tenha certeza do que está acontecendo exatamente, acredito que a única maneira de salvar a situação está dentro da própria base.", "Mariru")
	await novel_interface.show_dialog("Precisamos pelo menos coletar dados de lá...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Mas não podemos entrar na área se o nível de metano estiver muito alto lá, não é?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Esse “metano” de que você fala... é a “substância combustível” que sinto atualmente no ar?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Embora eu não tenha muita certeza do que ela está falando, ainda aceno com a cabeça.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Deveria estar bem, então. A densidade da substância combustível no ar ali mostra, de fato, uma espiral descendente.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Lá? Você quer dizer...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette deve estar falando sobre a Base Snedronningen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Fora da Base Snedronningen>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Olá? Annie? Você pode nos ouvir?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parada em frente à estrutura gigantesca, orgulhosa em um mundo de neve e gelo, grito no meu velho walkie-talkie, protegendo-o do vento com uma das mãos.")
	await novel_interface.show_dialog("Entendi... o sinal está bom... \\nUma nevasca está a caminho... tome cuidado...", "Annie")
	await novel_interface.show_text_only("A resposta de Annie é pontuada por estática e mais estática.")
	await novel_interface.show_text_only("Mariru ordenou que apressássemos a coleta de dados meteorológicos e os devolvêssemos para New Opulentia o mais rápido possível.")
	await novel_interface.show_text_only("Enquanto isso, levando em consideração o que Henriette nos contou, algo realmente está errado com esta base. Realmente se destaca do ambiente.")
	await novel_interface.show_text_only("Eu não gostei exatamente, mas ainda assim me aventurei em direção à base gigantesca ao lado de Raphael e Henriette, segurando minha saia contra o vento forte enquanto andava.")
	await novel_interface.show_text_only("Annie ficará para trás, mantendo a comunicação entre nós e Mariru com nossos antigos walkie-talkies.")
	await novel_interface.show_text_only("À medida que avançávamos, podíamos dizer, pelo nosso cromatógrafo de gás, que havia de fato uma quantidade alarmante de gás metano no ar.")
	await novel_interface.show_text_only("Eu estava perto de desmaiar quando Raphael agarrou minha mão.")
	await novel_interface.show_text_only("Não apenas rico e elegante, mas também caloroso e relaxante. A presença dela era a única coisa que me fazia continuar.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Não fique todo arrogante, só estou ajudando você porque prometi ao Mariru que o faria.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Não é como se eu tivesse pedido isso, ok?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eu imediatamente fechei a boca depois de responder, não querendo engolir bocados de neve.")
	await novel_interface.show_text_only("Se não fosse pelo efeito de aquecimento do Fire Jade, eu já teria me transformado em um picolé humano.")
	await novel_interface.show_text_only("Ainda assim, no geral, a base parece muito mais avançada do que as estações de abastecimento em que estivemos anteriormente.")
	await novel_interface.show_text_only("Atravessamos a pista de pouso de aviões de asa fixa e chegamos diante de um monumento de pedra.")
	await novel_interface.show_text_only("Uma caixa de amostras está embutida nela. Ao redor está o nome da base, Snedronningen, em estampa florida.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... espere, como você pronuncia isso?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("É finlandês. Snedronningen, idiota.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Esta base com um nome que não consigo pronunciar já parece incrivelmente grande vista de fora – e é apenas a ponta do iceberg. A maior parte da estrutura nem é visível do topo.")
	await novel_interface.show_text_only("Eu me pergunto quanto dinheiro foi investido na construção de uma estrutura tão impressionante, nada menos que na Antártica.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Vamos!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette avança rapidamente, antes mesmo que eu possa reagir.")
	await novel_interface.show_text_only("A alquimista coloca a mão na fechadura elétrica ao lado da porta. Em vez de deixá-lo escanear a palma da mão, ela simplesmente arranca tudo, com moldura e tudo, da parede.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Que tipo de monstro ela é?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
	await novel_interface.show_text_only("Com o problema da fechadura resolvido, os cabos que prendem a barreira começam a se mover, pequenas engrenagens girando, finalmente revelando a porta.")
	await novel_interface.show_text_only("Espiamos e vemos uma escada que desce.")
	await novel_interface.show_dialog("... Então vamos entrar? Sem avisar ninguém?", "Lian")
	await novel_interface.show_text_only("Não consigo deixar de olhar boquiaberto para o enorme buraco que deixamos na parede.")
	await novel_interface.show_text_only("Fizemos um maldito buraco na parede, mas ninguém apareceu para gritar conosco. Hum.")
	await novel_interface.show_dialog("Vamos apenas... entrar.", "Lian")
	await novel_interface.show_text_only("Vejo uma bala no chão perto do corredor.")
	await novel_interface.show_text_only("Isso não pode ser um bom sinal...")
	print("=== 深海恐惧症篇第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
