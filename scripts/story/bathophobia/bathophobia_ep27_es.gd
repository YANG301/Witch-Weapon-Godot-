# bathophobia_ep27.gd - 深海恐惧症篇第27话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep27_script()

func play_script():
	pass

func bathophobia_ep27_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Beth finalmente cae en un sueño incómodo sobre mi hombro.")
	await novel_interface.show_text_only("Henriette se acerca al tanque destrozado y presiona con una mano el fondo, donde todavía se acumula un líquido azul claro.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("¿Es esto...?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Qué?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Más del 99% es agua, pero ese no es el punto. El punto es...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Da vueltas hacia la parte trasera del tanque y observa cuidadosamente, finalmente rastrea los cables y tuberías hasta un rincón oscuro, donde encuentra un pequeño gabinete.")
	await novel_interface.show_text_only("Está pintado con una capa de metal gris verdoso, que refleja el brillo azul claro de la turmalina.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿Eso es...?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("(¡Ese es el mismo material pintado sobre la maleta que guarda el Witch's Shard de Beatrice!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es una aleación que debilita o bloquea los efectos psicológicos y memes causados por Substance H. Lo que significa que lo que hay dentro del gabinete debe ser...")
	await novel_interface.show_text_only("Antes de que pueda detenerla, el alquimista ya abrió el gabinete y sacó un frasco de vidrio.")
	await novel_interface.show_text_only("Ya se ha consumido una quinta parte del líquido azul del interior.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Eso debe ser lo que el hombre del video se llevó consigo...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("No puedo decir qué es esto exactamente, pero debe haber sido lo que mantuvo viva a la niña y la curó.","Henriette")
	await novel_interface.show_dialog("Según el cronómetro de la cerradura del gabinete, se abrió por última vez hace 167.665 horas y 48 minutos.","Henriette")
	await novel_interface.show_dialog("Después de todo este tiempo, ella no envejeció ni un poco. Guau. Eso es algo extraordinario.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los ojos de Henriette brillan y la voz tiembla de emoción.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Biológicamente, esto significa...","Raphael")
	await novel_interface.show_dialog("... que esta sustancia detiene el proceso de metabolismo y extiende con fuerza la vida útil de las células. Otra posible explicación es que es capaz de suministrar telómeros y acelerar el proceso de apoptosis de las células dañadas.","Raphael")
	await novel_interface.show_dialog("Pero ella todavía respiraba dentro del tanque.","Raphael")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("En ese caso...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Los tres llevamos a Beth hasta la entrada de la base. Ya no estamos en el sueño, pero todavía no nos encontramos con ningún cuerpo en el camino.")
	await novel_interface.show_text_only("Liliu, que había estado esperando aquí durante mucho tiempo, me arrojó al barco sin decir una palabra y dejó que Aiyi me devastara locamente.")
	await novel_interface.show_text_only("Aya levanta una ceja ante mi ropa empapada y me lanza un par de pantalones deportivos rosas con rayas laterales blancas.")
	await novel_interface.show_text_only("En cuanto a lo que pasó después, por favor... ¡olvidémoslo!")
	await novel_interface.show_text_only("Raphael expresa sus sospechas de que el despertar de Beth no fue la razón por la que pudimos abandonar el sueño. Mientras tanto, Aya recoge la ropa que me cambié y declara que realizará algunos estudios sobre ella.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(¿Estudios? ¿Qué tipo de estudios?)","Lian")
	await novel_interface.show_dialog("(Déjame en paz, ¿de acuerdo?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estaba soñando que mi vejiga estallaba... y luego alguien me dio un codazo en el estómago...")
	await novel_interface.show_text_only("¿Quién no se despertaría cuando le pasa algo así, verdad?")
	await novel_interface.show_text_only("Beth, todavía profundamente dormida, es inmediatamente puesta en cuarentena en Medbay. Annie también se queda dormida en el momento en que sube al avión. Ella debe estar agotada.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Aún así, no encontramos una manera de lidiar con la fuga de metano...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Murmuro preocupada, mirando la gigantesca grieta en el hielo desde la ventana.")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("... ¿Crees?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael aparece por detrás y se une a mí para mirar por la ventana. Una sonrisa misteriosa juega en sus labios.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(¿Sabe ella algo que yo no sé? ¿Se está... riéndose de mí?)","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ejem.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael se recupera y comienza a hablar en serio.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Hay dos problemas principales con el plan que sugirió el abuelo, el de los metanófilos resistentes al frío.","Raphael")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Sí?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Asiento, aunque no tengo la menor idea de qué está hablando.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("El problema principal es que los genes de las arqueas metanófilas son bastante inestables. Eso hace que sea difícil cultivarlos a gran escala. Después de unas pocas docenas de ciclos de división, generalmente mutan y ya no funcionan como necesitamos.","Raphael")
	await novel_interface.show_dialog("La división ocurre cada diez, veinte minutos más o menos, lo cual está bien, pero las bacterias mutadas aún pueden multiplicarse y terminar contaminando al resto de ejemplares a una velocidad incontrolable.","Raphael")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Es casi imposible eliminar las cepas mutadas con nuestra tecnología actual. Ésa es la razón principal por la que los metanófilos son difíciles de cultivar.","Raphael")
	await novel_interface.show_dialog("Aún así, si “esta sustancia” es capaz de mantener a alguien con vida durante tanto tiempo, sin siquiera envejecer...","Raphael")
	await novel_interface.show_dialog("Puede ser la clave para solucionar este problema desde el punto de vista de las propias células.","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Suena genial cuando lo pones así... \\nEntonces, ¿significa esto que el proyecto metanófilo está en marcha?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sin embargo, todavía hay otro problema. Los metanófilos mueren en contacto con el oxígeno, por lo que sólo podrán sobrevivir cerca de las fuentes de fuga.","Raphael")
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Si intentamos propagarlos en la atmósfera usando bioaerosol, morirán incluso antes de llegar a la tierra.","Raphael")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Necesitamos algún tipo de recipiente para evitar que entren en contacto con el oxígeno. También debe ser capaz de autodegradarse en un ambiente frío.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya me pellizca y me envía una mirada significativa.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh... ¿te refieres a aerogel?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eso fue lo que usó Annie para sellar la habitación de hotel de esa princesa malcriada. Sin embargo, el grupo de Igor logró atravesarlo con nitrógeno líquido.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Suena como un plan divertido. Eres bastante inteligente, ¿eh?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¿Ella simplemente me elogió...?")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Escuché mal?)","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Oye, por cierto, ¿por qué llevas pantalones deportivos? ¿Te orinaste en los pantalones o algo así?","Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Uh, no, no, definitivamente no!","Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("En el laboratorio de la estación McMurdo se almacenan algunos metanófilos resistentes al frío extraídos del limo enterrado en las profundidades de los glaciares.")
	await novel_interface.show_text_only("Aunque al principio solo logramos obtener unos pocos especímenes, Aya todavía cultiva suficientes cepas activas usando el líquido azul en un par de horas.")
	await novel_interface.show_text_only("Cuando el crucero pasa sobre la Antártida, me doy cuenta de que allí abajo, por encima de las grietas, innumerables drones de diferentes países trabajan juntos.")
	await novel_interface.show_text_only("En el aerosol modificado con estructuras en forma de red, los metanófilos de alta densidad están sellados y esparcidos en los lugares de fuga en forma de innumerables cristales minúsculos.")
	await novel_interface.show_text_only("Doce horas después del terremoto, los datos de diferentes estaciones meteorológicas de la Antártida muestran que el nivel de metano en la atmósfera ya está bajo control.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mariru luego envía al Congreso Unido una solicitud de una tarifa de mantenimiento escandalosa, que será pagada por las seis Ciudades Academia.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Henriette está sentada dentro de la sala de control, con el rostro impasible. Mariru se para frente a la pantalla grande, estudiando las figuras que aparecen en ella.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Henriette Khunrath...","Mariru")
	await novel_interface.show_dialog("Eres algo extraordinario, ¿no? Arrastré a mi equipo a una fluctuación de fase en el momento en que apareciste...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Encantado de conocerte.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sonríe, con el rostro tranquilo.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hemos hablado antes, pero esta es la primera vez que nos encontramos cara a cara.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Al menos esto no parece una sala de interrogatorios. ¿Debería estar agradecido...?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ignora las palabras burlonas de Henriette y continúa mirando su currículum.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ingresó en la Universidad de Leipzig a los diez años. Se convirtió en alquimista certificado a los catorce años.","Mariru")
	await novel_interface.show_dialog("Más tarde fue a la Universität Basel y obtuvo un doctorado en medicina en cuatro meses.","Mariru")
	await novel_interface.show_dialog("La fecha registrada de la muerte fue en 1605. El motivo de la muerte fue una explosión de laboratorio.","Mariru")
	await novel_interface.show_dialog("Según algunos manuscritos, antes de que se produjera la explosión, una empresa registrada en los Países Bajos había pagado generosamente a los habitantes de la zona y les había pedido que se mudaran.","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("El diario del inspector de aquella época nos decía que la potencia de los explosivos utilizados probablemente excedía la de la dinamita de nitroglicerina inventada más de doscientos años después.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Jaja. Ese era simplemente mi plan para escapar de El Único.","Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Aun así, esos alquimistas tardaron más de doscientos años en alcanzarme, ¿eh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette se burla.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Doscientos años después ya no existían los alquimistas. Ahora se les llama químicos.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Los explosivos inventados posteriormente tampoco requerían un sello mágico. Los no alquimistas podrían fabricarlos en grandes lotes. Es bastante rentable.","Mariru")
	await novel_interface.show_dialog("Aunque la gente mataba accidentalmente a sus familiares a tiros de vez en cuando...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sonríe, como si entendiera.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("El único escrito que dejaste fue el manuscrito del Anfiteatro de la Sabiduría. Actualmente forma parte de la colección del Museo Municipal de Newmoridas.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ah, eso. Eso me llevó mucho tiempo. Debería comprobarlo cuando tenga la oportunidad.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Usted era ante todo un coleccionista de gemas, aunque de su colección sólo quedan cinco piezas, que representan los cinco elementos. El Lapislázuli es el más importante de todos los...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, ¿el que Ren destrozó? No es tan importante.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... Realmente no dejaste mucha información. Antes de esta operación, ni siquiera nos dimos cuenta de que eras sólo una niña.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Todo lo que teníamos eran registros dejados por los civiles en aquel entonces, descubiertos por Salmonton durante las investigaciones después de que desaparecieras junto con Raphael y Ren.","Mariru")
	await novel_interface.show_dialog("Si hubiéramos tenido en cuenta esta información desde un principio, ciertamente no habríamos elegido el lapislázuli para experimentar.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Ya es demasiado tarde para lamentarlo. Entonces parece que el Maestro y yo estábamos destinados a encontrarnos, ¿eh?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia estira sus extremidades con pereza.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hay otra cosa sobre la que tengo curiosidad. La grabación de audio de Ren y su descripción mencionaron que el Árbol de la Vida es una especie de sello...","Mariru")
	await novel_interface.show_dialog("... que mantiene a raya al ser que incluso El Uno teme.","Mariru")
	await novel_interface.show_dialog("Según el testimonio de Beth, ese ser... o uno de esos seres... es una enorme criatura parecida a un globo ocular que existe en las profundidades del mar.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("No te obligaré a decirme quién es The One, ni necesito saber qué es exactamente ese globo ocular. Probablemente existieron mucho antes de que los humanos aparecieran por primera vez en la Tierra.","Mariru")
	await novel_interface.show_dialog("Lo único que puedo hacer ahora es tratarlas como las leyes de la física: como condiciones preexistentes.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Una sabia decisión. Bueno, ¿qué quieres saber entonces?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Quiero que me digas... qué causó que el sello se volviera inestable.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una buena pregunta de un táctico práctico. Henriette mira con aprobación los ojos decididos de Mariru.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Sobre esa...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La rubia levanta la mano derecha. En una explosión de luz y símbolos arremolinados, una gema azul se materializa en su palma.")
	await novel_interface.show_text_only("En su centro flota una proyección de un objeto con forma de globo ocular, envuelto por una sustancia fluida similar a un líquido.")
	await novel_interface.show_text_only("La pupila del globo ocular se está dilatando y tiembla erráticamente, como lo haría el globo ocular de un ser humano que entra en sueño REM.")
	await novel_interface.show_text_only("En el líquido flotan lo que parecen nervios periféricos ramificados. Parece tranquilo, inquietantemente.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Tampoco tengo idea de qué es \"eso\".","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette mira fijamente el globo ocular con total fascinación.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Lo que importa es que todo lo que lo había estado restringiendo en su cuerpo ahora ha desaparecido.","Henriette")
	await novel_interface.show_dialog("O bien... ¿realmente crees que un humano podría haber sobrevivido después de pinchar esta cosa... con una sonda?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... Supongo que morirían.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette asiente y lanza la gema al aire antes de volver a cogerla.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("El Noveno Sephira representa el “fundamento” de la vida. Su capacidad para revitalizar a los seres vivos es probablemente lo que mantuvo viva a esa niña durante tanto tiempo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Durante diecinueve años, eh...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Ah, por cierto, lo has recopilado todo, ¿verdad? ¿Los datos más valiosos de la base?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oh, ¿te refieres a los datos del tanque de cultivo?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru toca su dispositivo portátil y recupera la línea de tiempo de los datos vitales de Beth desde la gigantesca base de datos.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("En ese lugar, hace más de setenta días...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Hubo esta... “bamboleo” en la atmósfera. Y luego siguió ganando fuerza...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Quizás fue entonces cuando “ese ser” ya no pudo mantener la estabilidad...","Henriette")
