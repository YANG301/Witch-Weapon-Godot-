# bathophobia_ep27.gd - 深海恐惧症篇第27话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep27_script()

func play_script():
	pass

func bathophobia_ep27_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("В конце концов Бет засыпает у меня на плече.")
	await novel_interface.show_text_only("Генриетта неторопливо подходит к разбитому резервуару и сует руку в дно, где все еще скопилось немного светло-голубой жидкости.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Это __ЭЛЛИПСИС__?","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Что?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Более 99% его составляет вода, но дело не в этом. Дело в том,...","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она обходит заднюю часть резервуара и внимательно наблюдает, наконец прослеживая провода и трубы до темного угла, где находит небольшой шкаф.")
	await novel_interface.show_text_only("Он покрыт слоем серо-зеленого металла, отражающего голубое свечение турмалина.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Это __ЭЛЛИПСИС__","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("(Этот же материал нарисован на чемодане, в котором хранится Ведьмин осколок Beatrice!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это сплав, который ослабляет или блокирует психологические и мемные эффекты, вызываемые Substance H. Это означает, что внутри шкафа должно быть...")
	await novel_interface.show_text_only("Прежде чем я успеваю ее остановить, алхимик уже открыл шкаф и достал стеклянный флакон.")
	await novel_interface.show_text_only("Одна пятая синей жидкости внутри уже израсходована.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Должно быть, именно это взял с собой мужчина на видео...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Я не могу сказать, что именно, но, должно быть, именно это сохранило девочке жизнь и исцелило ее.","Генриетта")
	await novel_interface.show_dialog("Согласно таймеру на замке шкафа, последний раз его открывали 167 665 часов 48 минут назад.","Генриетта")
	await novel_interface.show_dialog("За все это время она ни капельки не постарела. Ух ты. Это нечто.","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Глаза Генриетты сверкают, голос дрожит от волнения.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Биологически это означает....","Raphael")
	await novel_interface.show_dialog("... что это вещество приостанавливает процесс обмена веществ и существенно продлевает продолжительность жизни клеток. Другое возможное объяснение заключается в том, что он способен снабжать теломеры и ускорять процесс апоптоза поврежденных клеток.","Raphael")
	await novel_interface.show_dialog("Но она все еще дышала внутри резервуара.","Raphael")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("В этом случае...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Мы втроем несем Бет обратно ко входу на базу. Мы уже не во сне, но по пути мы по-прежнему не проходили мимо каких-либо тел.")
	await novel_interface.show_text_only("Лилиу, которая ждала здесь долгое время, бросила меня на корабль, не сказав ни слова, и позволила Айи безумно опустошать меня.")
	await novel_interface.show_text_only("Ая поднимает бровь, увидев мой промокший наряд, и бросает в меня пару розовых спортивных штанов с белыми полосками по бокам.")
	await novel_interface.show_text_only("Что касается того, что произошло дальше, пожалуйста,..., давай просто забудем об этом!")
	await novel_interface.show_text_only("Рафилия высказывает подозрения, что пробуждение Бет не было причиной того, что мы смогли выйти из сна.\\nТем временем Айя собирает одежду, в которой я переоделась, заявляя, что проведет над ней некоторые исследования.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(Учёба? Какая учёба?)","Lian")
	await novel_interface.show_dialog("(Просто оставь меня в покое, ладно?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мне снилось, что у меня лопнул мочевой пузырь..., а потом кто-то ударил меня локтем в живот...")
	await novel_interface.show_text_only("Кто бы не просыпался, когда с ним случается что-то подобное, верно?")
	await novel_interface.show_text_only("Бет, все еще глубоко спящая, немедленно помещается на карантин в Медбэй. Annie тоже засыпает, как только садится в самолет. Она должна быть потрачена.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Тем не менее, мы не нашли способа справиться с утечкой метана...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— бормочу я с беспокойством, глядя на гигантскую трещину во льду из окна.")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Вы думаете?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия появляется сзади и присоединяется ко мне, глядя в окно. На ее губах играет загадочная улыбка.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Знает ли она что-то, чего не знаю я? Она __ЭЛЛИПСИС__ смеется надо мной?)","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Кхм.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Рафилия трезвеет и начинает говорить серьезно.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("В плане, который предложил дедушка, есть две основные проблемы: тот, который касается морозостойких метанофилов.","Raphael")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я киваю, хотя понятия не имею, о чем она говорит.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Основная проблема заключается в том, что гены метанофильных архей весьма нестабильны. Это затрудняет их выращивание в больших масштабах. После нескольких десятков циклов деления они обычно мутируют и перестают функционировать так, как нам нужно.","Raphael")
	await novel_interface.show_dialog("Деление происходит каждые десять-двадцать минут или около того, и это хорошо, но мутировавшие бактерии все равно могут размножаться и в конечном итоге заражать остальные образцы с неконтролируемой скоростью.","Raphael")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("С помощью наших нынешних технологий почти невозможно избавиться от мутировавших штаммов. Это основная причина, по которой метанофилы трудно культивировать.","Raphael")
	await novel_interface.show_dialog("И все же, если «это вещество» способно сохранять кому-то жизнь так долго, даже не состарив...","Raphael")
	await novel_interface.show_dialog("Это может быть ключом к решению этой проблемы с точки зрения самих клеток.","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Звучит круто, если так выразиться... \\nЗначит ли это, что проект «Метанофил» реализуется?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Однако есть еще одна проблема. Метанофилы погибают при контакте с кислородом, поэтому они смогут выжить только вблизи источников утечки.","Raphael")
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Если мы попытаемся распространить их в атмосфере с помощью биоаэрозоля, они погибнут еще до того, как достигнут суши.","Raphael")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Нам нужен какой-то сосуд, чтобы предотвратить их контакт с кислородом. Он также должен быть способен к саморазложению в холодной среде.","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая ущипнул меня и многозначительно посмотрел на меня.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Э-э,..., ты имеешь в виду аэрогель?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Это то, что Annie использовал, чтобы опечатать гостиничный номер этой испорченной принцессы. Однако группе Игоря удалось прорваться через него с помощью жидкого азота.")
	novel_interface.show_character("ren_battle","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Звучит как забавный план. Ты довольно умный, да?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она только что... похвалила меня?")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Я ослышался?)","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Эй, кстати, почему ты носишь спортивные штаны? Ты обссался в штаны или что-то в этом роде?","Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("О, нет, нет, определенно нет!","Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("В лаборатории станции МакМердо хранятся некоторые морозостойкие метанофилы, извлеченные из ила, погребенного в недрах ледников.")
	await novel_interface.show_text_only("Хотя поначалу нам удается получить лишь несколько экземпляров, Ая все же культивирует достаточно активных штаммов, используя синюю жидкость, в течение пары часов.")
	await novel_interface.show_text_only("Когда крейсер проходит над Антарктидой, я замечаю, что там, внизу, над трещинами вместе работают бесчисленные дроны из разных стран.")
	await novel_interface.show_text_only("В модифицированном аэрозоле с сетчатой структурой метанофилы высокой плотности уплотнены и рассеяны в местах утечки в виде бесчисленных мельчайших кристаллов.")
	await novel_interface.show_text_only("Через двенадцать часов после землетрясения данные различных метеостанций Антарктиды показывают, что уровень метана в атмосфере теперь снова под контролем.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mariru позже отправляет Объединенному Конгрессу запрос на возмутительную плату за содержание, которую будут платить все шесть Академгородов.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Генриетта сидит в диспетчерской с бесстрастным лицом. Mariru стоит перед большим экраном и изучает изображения на нем.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Генриетта Кунрат...","Mariru")
	await novel_interface.show_dialog("Ты нечто, не так ли. Втянул мою команду в фазовое колебание в тот момент, когда ты появился...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Приятно познакомиться.","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта улыбается, ее лицо спокойно.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Мы уже говорили раньше, но это первый раз, когда мы встречаемся лицом к лицу.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("По крайней мере, это не похоже на комнату для допросов. Должен ли я быть благодарен... ?","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru игнорирует насмешливые слова Генриетты и продолжает смотреть на ее резюме.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Поступил в Лейпцигский университет в десять лет. Стал дипломированным алхимиком в четырнадцать лет.","Mariru")
	await novel_interface.show_dialog("Позже поступил в Базельский университет, где за четыре месяца получил докторскую степень по медицине.","Mariru")
	await novel_interface.show_dialog("Зарегистрированная дата смерти — 1605 год. Причиной смерти стал взрыв в лаборатории.","Mariru")
	await novel_interface.show_dialog("Согласно некоторым рукописям, до того, как произошел взрыв, компания, зарегистрированная в Нидерландах, щедро заплатила местным жителям и попросила их переехать.","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Дневник инспектора того времени сообщил нам, что мощность использованной взрывчатки, вероятно, превышала мощность нитроглицеринового динамита, изобретенного более двухсот лет спустя.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Хаха. Это был просто мой план сбежать от Единственного.","Генриетта")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("И все же эти алхимики потратили более двухсот лет, чтобы догнать меня, да?","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта усмехается.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Двести лет спустя алхимиков уже не было. Их теперь называют химиками.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Изобретённая позже взрывчатка также не нуждалась в магической печати. Неалхимики могли производить их большими партиями. Это довольно выгодно.","Mariru")
	await novel_interface.show_dialog("Хотя люди время от времени случайно взрывали своих родственников насмерть...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта улыбается, как будто понимает.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Единственным письмом, которое ты оставил после себя, была рукопись Амфитеатра Мудрости. В настоящее время он является частью коллекции Муниципального музея Ньюморидаса.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("О, это. Это заняло у меня много времени. Я должен проверить это, когда у меня будет возможность.","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("В первую очередь вы были коллекционером драгоценных камней, хотя в вашей коллекции до сих пор осталось только пять экземпляров, представляющих пять элементов. Лазурит – самый важный из всех...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("О, тот, которого Рен разбил? Это не так важно.","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("... Вы действительно не оставили после себя много информации. До этой операции мы даже не подозревали, что ты всего лишь маленькая девочка.","Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Все, что у нас было, это записи, оставленные тогда гражданскими лицами, обнаруженные Salmonton во время расследования после вашего исчезновения вместе с Рафилией и Реном.","Mariru")
	await novel_interface.show_dialog("Если бы мы изначально приняли эту информацию во внимание, мы бы точно не выбрали лазурит для эксперимента.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Сейчас слишком поздно сожалеть об этом. Так что, похоже, нам с Учителем суждено было встретиться, да?","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка лениво потягивает конечности.")
	novel_interface.show_character("liliu_uniform2","normal2")
