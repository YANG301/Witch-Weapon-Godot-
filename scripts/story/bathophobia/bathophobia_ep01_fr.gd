# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru fait un compte rendu à sens unique lors d'une réunion à huis clos.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… C'est tout ce que nous avons sur l'incident de la délégation Salmonton.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers a rendu une autre visite à New Opulentia pour faire quelques « courses personnelles ».", "Mariru")
	await novel_interface.show_dialog("Désormais, SID l'a incluse dans la liste de protection de niveau A.", "Mariru")
	await novel_interface.show_dialog("Cette fois cependant, Salmonton a soumis tous les détails de la délégation et une liste complète des marchandises restreintes au ministère des Affaires étrangères.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ils ont même fait état de toutes les opérations militaires auxquelles leurs forces de sécurité ont participé dans le passé. Vous ne pouvez pas trouver un seul défaut dans les enregistrements…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Cela ressemble donc à un avertissement selon lequel si quelque chose de grave arrive à la petite-fille du Dr Dekkers, tout sera de notre faute.", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Hum ! Ce renard rusé…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Mais en échange de la sécurité de cette jeune femme, ils ont promis une livraison prioritaire de 20 % de notre contrat d'achat de produits agricoles.", "Éloïse")
	await novel_interface.show_dialog("Selon l'indice NBOT actuel, c'est comme un cadeau.", "Éloïse")
	await novel_interface.show_dialog("J'ai signé un décret pour garder les médias hors de sa piste pour le moment.", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Utilisent-ils le Sénat dans le cadre de leur stratégie de création de marché ?) \\n(Et ils savaient que je resterais en dehors de cela…)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Humph… vieux renard rusé…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("La fille nous est utile. Pouvons-nous lui extraire plus d’intelligence ?", "Bright")
	await novel_interface.show_dialog("Franchement, nous avons été très intéressés par leur technologie d'édition génétique et les systèmes de méga-serres.", "Bright")
	await novel_interface.show_dialog("Si elle pouvait passer quelques heures dans mon laboratoire…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dr Bright…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Vous avez déjà une grande réputation pour vos normes morales « uniques » sur Substance H qui affectent l'esprit humain.", "Mariru")
	await novel_interface.show_dialog("Je crains que Salmonton n'impose immédiatement des sanctions commerciales à New Opulentia une fois que la jeune femme entre dans votre laboratoire.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ma réputation ? Vraiment? \\nHahaha…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Hum, ça suffit !", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("En parlant de ces hommes armés inconnus au Sky Hotel…", "Kirs")
	await novel_interface.show_dialog("Ils ont attaqué la délégation Salmonton et se sont emparés de précieuses œuvres d'art…", "Kirs")
	await novel_interface.show_dialog("SID a-t-il des indices ?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Le vieux renard a caché le papillon d'or au Sénat et a rejeté la faute sur Jacob et sa bande.)", "Mariru")
	await novel_interface.show_dialog("(Ils ont désactivé les caméras de sécurité de l'hôtel avant d'agir.) \\n(Il y a un manque d'informations là-bas...)", "Mariru")
	await novel_interface.show_dialog("Nos mains sont liées dans la zone démilitarisée agréée. Selon différentes sources, nous pensons qu'ils ont utilisé des armes spéciales.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Armes spéciales… vous voulez dire les armes Substance H ? \\nIls ont utilisé les armes à l'intérieur du champ de protection de Aegis ?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("À en juger par les marques de brûlure en forme d'arbre sur le sol, nous pensons qu'ils ont utilisé des dispositifs de décharge de haute puissance avec des circuits de résonance en série.", "Mariru")
	await novel_interface.show_dialog("Un appareil aussi complexe est trop encombrant pour qu’un soldat puisse le transporter seul, et il n’y a pratiquement aucun moyen de le réduire.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Selon les témoignages, il y avait cette nuit-là une dizaine d'hommes armés de la même arme.", "Mariru")
	await novel_interface.show_dialog("Selon les enregistrements Aegis, une dizaine d'identifiants inconnus se sont déconnectés en même temps cette nuit-là. Ils ont dû se retirer du site.", "Mariru")
	await novel_interface.show_dialog("Puisque SID avait bloqué les départs réguliers, ils auraient pu s'enfuir par la voie diplomatique.", "Mariru")
	await novel_interface.show_dialog("(Ou exécutés à cause de leur échec…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Je vois.", "Kirs")
	await novel_interface.show_dialog("Les armes Substance H ne peuvent pas être produites à si grande échelle.", "Kirs")
	await novel_interface.show_dialog("Mais avant que les caméras ne soient éteintes, deux personnes suspectes ont attaqué les gardes dans le couloir.", "Kirs")
	await novel_interface.show_dialog("L'une d'elles s'habillait en femme de chambre de cet hôtel et l'autre portait l'uniforme de Gosakuragawa. Les avez-vous envoyés là-bas ?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un grincement aigu sort de l'écran.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Hahaha… Notre directeur général semble très intéressé par les chatons… Moi aussi.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Des chatons ?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Oh, je l'ai cité de Son Excellence Mme Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Quel mal aux fesses…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie et Ren, n'est-ce pas ? \\nNoms adorables…", "#C")
	await novel_interface.show_dialog("Peut-être qu'il y a d'autres chats que Mikakawa a élevés——", "#C")
	await novel_interface.show_dialog("Ai-je raison, Mariru ?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Hah, merci de ne pas les avoir vendus à l'armée de sécurité. Je t'en dois une.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Ce n'est pas grave. \\nDe toute façon, il semble que vous n’ayez aucune intention de nous cacher quoi que ce soit.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Alors permettez-moi de vous débriefer avec plus de détails.", "Mariru")
	await novel_interface.show_dialog("Le satellite a détecté plusieurs flux spatio-temporels au Sky Hotel, mais SID n'avait aucun droit d'y prendre des mesures.", "Mariru")
	await novel_interface.show_dialog("J'ai donc envoyé deux agents infiltrés là-bas.", "Mariru")
	await novel_interface.show_dialog("Au cours de leur mission, ils ont croisé un groupe d'hommes armés et l'un d'eux a tiré sur Annie avec l'arme spéciale.", "Mariru")
	await novel_interface.show_dialog("Aujourd'hui, l'agent est enfin hors de danger après les traitements d'urgence, et nous avons rassemblé quelques statistiques sur cette arme.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Pourquoi ne nous l'as-tu pas dit plus tôt ?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Monsieur le directeur général, je me demande quelles sont exactement les « œuvres d'art » qui ont disparu ?", "Mariru")
	await novel_interface.show_dialog("Il est peut-être temps que nous soyons tous plus ouverts au partage de renseignements.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Qu'en pensez-vous ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Pourquoi ne pas commencer par le chat que vous avez adopté ?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Déception… Cette information n'était pas suffisante pour le distraire.)", "Mariru")
	await novel_interface.show_dialog("(Quelle douleur au cou…) \\n(Eh bien, il est temps de tester ces faux documents, j'en ai bien peur. L'heure du conte, les gars.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Allons-nous commencer, ma chère ?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Pendant la guerre de Sept Ans, les scientifiques se sont efforcés de développer de nouvelles technologies permettant l’activation du Divine Touch par les humains.", "Mariru")
	await novel_interface.show_dialog("Des rumeurs couraient selon lesquelles des expériences de modification du corps humain auraient été menées secrètement sur des combattants. Je crois que vous avez entendu de telles rumeurs.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Hum-hum.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru rit, les coins de sa lèvre se courbant légèrement vers le haut.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Certaines personnes naissent avec des aptitudes particulières, et l'Académie des sciences New Opulentia et l'Institut de recherche sur le cerveau ont des dossiers qui le prouvent.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("En fait, le Dr Bright peut être considéré comme l’un d’entre eux.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Attendez, je dois vous rappeler que presque toutes ces personnes douées sont des femmes.", "Bright")
	await novel_interface.show_dialog("Cependant, les personnes dotées de talents particuliers comme celui-ci ne sont généralement inscrites que sur la liste de surveillance et aucun contrôle particulier n'est nécessaire.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("C'est vrai. Mais parmi toutes ces personnes douées, personne n’a de pouvoir comparable à la Classe B Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Les résultats des expériences étant inférieurs aux attentes, ce type de recherche a été interrompu pendant la guerre.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ces femmes dotées de super pouvoirs sont également connues sous le nom de « sorcières ». Il y a quelques décennies, personne ne croirait jamais à l’existence de telles choses dans le monde…", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Mais Ren est différente : elle est capable de traverser des zones de flux.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quoi ?!!","Foule")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
