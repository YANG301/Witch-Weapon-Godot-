# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Mariru ยืนอยู่บนโพเดียม รายงานความคืบหน้าการวิจัยล่าสุดอย่างละเอียดในการประชุมทางวิดีโอตามปกติ")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("เกี่ยวกับโครงการ Ark...", "เคอร์ส")
	await novel_interface.show_dialog("จากรายการวัตถุโบราณที่ Salmonton มอบให้ คุณได้เลือกเสาลาพิสเทสไฮม์ ใช่ไหม", "เคอร์ส")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("ใช่แล้วครับ ตอนนี้สิ่งสำคัญคือวิธีสร้างพื้นที่ฟลักซ์ที่ควบคุมได้", "Mariru")
	await novel_interface.show_dialog("กรณีล่าสุดทั้งหมดของ Spacetime Flux ในเมืองการศึกษาทุกแห่งเกิดจากการที่มนุษย์สัมผัสกับรายการที่มีคุณสมบัติ Substance H", "Mariru")
	await novel_interface.show_dialog("สิ่งของเหล่านั้นยังคงสงบนิ่งอยู่เป็นเวลานานแต่ก็ถูกเปิดใช้งานในเวลาเดียวกัน", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(ถ้าให้เจาะจงกว่านี้คือ Witch's Shard และ Grimoire Fragments แต่ฉันควรจะอธิบายเป็นภาษาธรรมดาดีกว่า)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("คุณหมายถึงวันที่ Ross Goblet หายตัวไป...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("เรายังไม่สามารถยืนยันการเชื่อมต่อของพวกเขาได้", "Mariru")
	await novel_interface.show_dialog("เนื่องจากมีปัจจัยที่ไม่สามารถควบคุมได้มากเกินไป เราจึงต้องกรองพระธาตุทั้งหมดตามเกณฑ์สองข้อ", "Mariru")
	await novel_interface.show_dialog("อันดับแรก จะต้องเป็นสารออกฤทธิ์ต่ำซึ่งแสดงคุณสมบัติ Substance H ตามการสแกนสี", "Mariru")
	await novel_interface.show_dialog("ประการที่สอง เจ้าของเดิมสามารถตรวจสอบย้อนกลับได้ในบันทึกทางประวัติศาสตร์ และบุคคลนี้จะต้องไม่มีแนวโน้มว่าจะใช้ความรุนแรงหรือกระทำความผิดทางอาญา", "Mariru")
	await novel_interface.show_dialog("เสา Tesheim Lapis เดิมที Heinrich Khunrath แพทย์และนักเล่นแร่แปรธาตุในยุคเรอเนซองส์เป็นเจ้าของ", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("กิจกรรมต่ำ… น่าเสียดาย… ฉันคาดว่าเราจะรวบรวมข้อมูลที่ใกล้เคียงกับค่าวิกฤตในครั้งนี้ได้", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("ตัวอย่างมีค่าเกินกว่าจะสูญเสีย เป็นการดีกว่าที่จะอยู่ในด้านความปลอดภัย", "เคอร์ส")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(ฉันแค่ต้องพิสูจน์ความสามารถของ Ren ในการผ่านพื้นที่ฟลักซ์ เพื่อสิ่งนั้น เราแค่ต้องลงมือทำ)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(อันที่จริง เสาหินลาพิสของเทไชม์ไม่ใช่ชิ้นส่วนของแม่มด) \\n(เป็นเพียงเสมือน Substance H ที่มีจารึกเวทมนตร์อยู่)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(การสัมผัสเศษแม่มดนั้นอันตรายเกินไปสำหรับคนธรรมดา) \\n(ท้ายที่สุด ฉันไม่ใช่มนุษย์กอริลลา…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เสียงหัวเราะดังออกมาจากหน้าจอ")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("นักเล่นแร่แปรธาตุ… ผู้บุกเบิกวิทยาศาสตร์เหรอ? \\nช่างเป็นตัวเลือกที่น่าสนใจจริงๆ", "#ซี")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("ฉันได้ยินมาว่ามันเป็นชิ้นงานศิลปะที่มีความสำคัญทางประวัติศาสตร์อย่างมาก และเจ้าของ Heinrich ก็เป็นหนึ่งในผู้ก่อตั้ง Rosenkreutz…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Rosenkreutz เป็นเพียงกลุ่มทางศาสนาและไสยศาสตร์ มันไม่เกี่ยวอะไรกับหน่วยข่าวกรองปัจจุบันของ Salmonton", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ฉันเดาว่านักเล่นแร่แปรธาตุสามารถถูกมองว่าเป็นนักวิทยาศาสตร์ในยุคนั้น หวังว่าเขาจะเป็นชายที่น่าเกรงขามต่อสิ่งที่ไม่รู้", "Mariru")
	await novel_interface.show_dialog("แต่คุณรู้จัก ดร. Dekkers ดี เขาจะไม่ให้เรายืมโบราณวัตถุที่สำคัญเช่นนี้โดยไม่เสียค่าใช้จ่าย เว้นแต่...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ความเงียบแปลกๆ ดังขึ้นทั่วทั้งห้อง")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("ถูกต้องแล้ว ฝ่าย Salmonton ต้องการการแบ่งปันข้อมูลพร้อมตัวแทนในทีมของเรา", "เคอร์ส")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(ดังนั้น พวกเขาไม่ยอมแพ้ในการผลิตแม่มดเพิ่ม…) \\n(พวกเขาต้องการใช้เร็นเป็นผู้ควบคุมหรือเปล่า?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("สังเกตได้ดี. ฉันแค่อยากยืนยันว่าทุกคน รวมถึงฝ่าย Salmonton เข้าใจถึงอันตรายของการทดลองนี้", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("ยืนยัน เราได้เปลี่ยนระบบระบายน้ำขนาดใหญ่ใต้ดินของเมืองหลวงเก่าให้เป็น Ark Base เผื่อในกรณีที่เกิดสถานการณ์ที่เลวร้ายที่สุด", "เคอร์ส")
	await novel_interface.show_dialog("ระบบการบุกรุกของน้ำทะเลความเร็วสูงพิเศษสามารถท่วมฐานทั้งหมดได้ภายใน 30 วินาที", "เคอร์ส")
	await novel_interface.show_dialog("หากมีสิ่งใดผิดพลาดในระหว่างการทดลอง...", "เคอร์ส")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("ในกรณีนั้น ฉันหวังว่า Mariru ที่รักของเรามีความกล้าที่จะสตาร์ทอุปกรณ์ทำลายตัวเองในกรณีฉุกเฉิน", "#ซี")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
