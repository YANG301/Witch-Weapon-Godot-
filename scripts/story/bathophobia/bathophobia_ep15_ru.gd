# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ах-чух…", "Бет")
	await novel_interface.show_text_only("Положив голову на стол, девушка могла бы задремать, если бы не этот чих.")
	await novel_interface.show_text_only("За окном подводной лодки полярная ночь, и она не может определить время по цвету неба.")
	await novel_interface.show_text_only("Бет смотрит на экран и понимает, что прошло всего несколько часов после ее встречи с глубоководным монстром.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Правильно ли я поступаю?", "Бет")
	await novel_interface.show_dialog("(Используя ее, чтобы найти правду для себя…)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Не замечая этого, Бет бросает взгляд на блокнот в руке.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Если бы отец был здесь…)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Он никогда не дрогнул бы из-за таких эмоций.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Думая о сильных руках отца, Бет медленно сжимает кулак.")
	await novel_interface.show_text_only("Блокнот, полный непонятных текстов, когда-то принадлежал ее приемному отцу.")
	await novel_interface.show_text_only("Он был высоким, молчаливым и преданным биологом, строгим как с Бет, так и с самим собой.")
	await novel_interface.show_text_only("Из-за особых способностей Бет он организовал для нее тщательное обучение помимо школьных занятий.")
	await novel_interface.show_text_only("Бет вспоминает, что ей приходилось каждый день усердно работать, чтобы достичь целей, поставленных отцом.")
	await novel_interface.show_text_only("Чего она ожидала больше всего, так это случайной улыбки узнавания на его серьезном лице.")
	await novel_interface.show_text_only("Без особой нежности сдержанный мужчина по-своему защищал ее…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("— Словно готовя ее к какой-то неизбежной судьбе…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("На свой 12-й день рождения Бет получила анонимную посылку. Внутри была эта записная книжка — и новость о смерти ее отца.")
	await novel_interface.show_text_only("В результате взрыва газа погибло более 30 человек, включая единственного оставшегося в мире члена семьи Бет.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Бет")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Губы дрожат, Бет беззвучно произносит имя.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Подсказки, скрывающиеся за этим именем, заставили ее понять, что смерть ее отца не была несчастным случаем, как официально сообщалось.")
	await novel_interface.show_text_only("Одинокой девочке пришлось отереть слезы и быстро повзрослеть, чтобы пережить неизведанные опасности.")
	await novel_interface.show_text_only("—Ее отец написал в записной книжке, что ее особые способности подвергнут ее опасности и сделают ее целью банды.")
	await novel_interface.show_text_only("Посылку отправят только тогда, когда он больше не сможет ее защищать…")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Почему люди жаждут… таких способностей…)", "Бет")
	await novel_interface.show_dialog("(Разве это не больше похоже на проклятие...)", "Бет")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Бет смотрит на свою ладонь. Несколько шаров серебряных огней прыгают по ее пальцам.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет знает, что она другая с тех пор, как научилась запоминать разные вещи, но не из-за своих особых способностей.")
	await novel_interface.show_text_only("Еще в детстве у нее была эйдетическая память на числа. Она умеет считать в уме гораздо быстрее, чем другие, и очень интересуется техникой.")
	await novel_interface.show_text_only("Но ее отец попросил ее вести себя сдержанно и вести себя как обычный ребенок, чтобы скрыть свои особые способности.")
	await novel_interface.show_text_only("После его смерти Бет решила больше не скрываться.")
	await novel_interface.show_text_only("Год спустя ее приняли в престижный университет по специальному разрешению, исключение было сделано впервые за многие годы.")
	await novel_interface.show_text_only("Она усердно училась и много читала, но не могла найти ответа ни в книгах, ни на занятиях.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Почему я другой…)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она продолжала учиться и думать, как будто пытаясь одновременно удовлетворить свое давно сдерживаемое любопытство.")
	await novel_interface.show_text_only("Она не осознавала, что ее таким образом заклеймили как высокомерную, равнодушную и неприступную.")
	await novel_interface.show_text_only("Постепенно люди отвернулись от нее, но ей было все равно.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Иначе я бы с тобой не встретился…)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она встретила Сильвию в результате несчастного случая.")
	await novel_interface.show_text_only("Бет потребовалось всего несколько минут, чтобы понять, что Сильвия — следователь, переодетый студенткой. Ее миссия заключалась в поиске незаконных Substance H на территории кампуса.")
	await novel_interface.show_text_only("Она знала, что имя и опыт Сильвии могут быть фальшивыми, но ее все равно привлекал ее беззаботный и веселый характер.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Она… другая.)", "Бет")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Она знает меня лучше, чем кто-либо другой…")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Хотя она привыкла маскироваться перед другими…)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она действительно безоговорочно открыла мне свое сердце.")
	await novel_interface.show_text_only("Но ни один из них не ожидал, что их дружба привлечет внимание организации, стоящей за Милком.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Зная, что она приемная дочь известного биолога, босс Милк пригласил ее присоединиться к антарктической миссии.")
	await novel_interface.show_dialog("(Я намеревался отказаться…)", "Бет")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("На подземной базе Отряда.")
	await novel_interface.show_text_only("Что заставило ее передумать и решить присоединиться, так это символ в руководстве миссии…")
	await novel_interface.show_text_only("Символ, который она увидела в записной книжке отца.")
	await novel_interface.show_text_only("Жуткий черный глаз, представляющий тайную религиозную организацию.")
	await novel_interface.show_text_only("Ее отец записал свои контакты с людьми из этой организации. Они продемонстрировали намерение мобилизовать людей с особыми способностями и создать боевую группу.")
	await novel_interface.show_text_only("План получил название «Проект Нинген».")
	await novel_interface.show_text_only("После того, как в их руки попали документы из ее приюта, Бет оказалась в списке самых разыскиваемых участников проекта «Нинген».")
	await novel_interface.show_text_only("В результате ее отец стал мишенью этой опасной организации.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Нинген… Антарктика.)", "Бет")
	await novel_interface.show_dialog("(База Снежной Королевы в Антарктике…) \\n(Она названа в честь рассказа из сказок Андерсена.)", "Бет")
	await novel_interface.show_dialog("По-датски это Снедроннинген \\nОр Снедрон-Нинген.", "Бет")
	await novel_interface.show_dialog("(Не совпадение.)", "Бет")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Значит, ваш босс и его банда преследуют одно и то же…", "Бет")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Судя по выражению твоего лица… эта банда кажется более крутой, чем другие в «Черном списке»…", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет кивает, но не хочет говорить дальше.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Извините. Я присоединился к этой миссии из корыстных побуждений.", "Бет")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Ну, я это знаю.", "Молоко")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Но Босс просто хочет, чтобы ты продолжил исследования твоего отца в области морской жизни.", "Молоко")
	await novel_interface.show_dialog("Так что это беспроигрышный вариант.", "Молоко")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Что касается твоих корыстных побуждений… Я знаю, что ты настолько очарован мной, что решаешь остаться здесь.", "Молоко")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ох, это слишком сильно для меня!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— сказал Милк и послал Бай Яну воздушный поцелуй, что заставило Бай Чжу улыбнуться.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Чего она не замечает, так это мимолетной мрачности в ясных глазах подруги.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Она до сих пор чувствует себя виноватой, когда думает о моменте подписания документов.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Я… использовал ее.)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет садится за стол, достает ручку и смотрит на открытую тетрадь.")
	await novel_interface.show_text_only("Ценны те, которые полезны.")
	await novel_interface.show_text_only("— Она записывает свою мысль.")
	await novel_interface.show_text_only("Ты мне это говорил… И я всегда с тобой был согласен…")
	await novel_interface.show_text_only("Используйте других или будьте использованы недобросовестно \\n«Это то, что вы считаете само собой разумеющимся…»")
	await novel_interface.show_text_only("Это зависит только от того, у кого ценность выше.")
	await novel_interface.show_text_only("Нет необходимости объяснять. Просто сосредоточьтесь на своей цели.")
	await novel_interface.show_text_only("Только такие простые отношения могут уберечь вас от большинства людей.")
	await novel_interface.show_text_only("Бет делает паузу.")
	await novel_interface.show_text_only("Но вы также сказали мне, что есть еще…")
	await novel_interface.show_text_only("Тот, кто хочет, чтобы вы использовали его, несмотря ни на что. \\n\"И тот, кого ты не захочешь использовать ни при каких обстоятельствах.\"")
	await novel_interface.show_text_only("При мысли об этом на ее губах скользит легкая улыбка.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Вина? Это чувство, от которого необходимо избавиться.)", "Бет")
	await novel_interface.show_dialog("(Тогда это… привязанность?)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет закрывает свой дневник.")
	await novel_interface.show_text_only("Теперь она нашла ответ.")
	await novel_interface.show_text_only("Она смотрит в окно и обнаруживает, что темно-синее небо становится глубже, почти сливаясь с бесконечным морем.")
	await novel_interface.show_text_only("Внезапно на судне срабатывает аварийная сигнализация.")
	await novel_interface.show_text_only("Внимание всему экипажу. Директива изменена. Доберитесь до конференц-зала через десять минут.")
	await novel_interface.show_text_only("Повторите. Директива изменена…")
	await novel_interface.show_text_only("Бет глубоко вздыхает, убирает блокнот и спешит из комнаты.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
