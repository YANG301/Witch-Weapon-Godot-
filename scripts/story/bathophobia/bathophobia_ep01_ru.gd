# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru проводит односторонний доклад на закрытом совещании.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… Это все, что мы получили по поводу инцидента с делегацией Salmonton.", "Mariru")
	await novel_interface.show_dialog("Рафилия Dekkers еще раз посетила New Opulentia, чтобы выполнить некоторые «личные поручения».", "Mariru")
	await novel_interface.show_dialog("Теперь SID включил ее в список защиты уровня А.", "Mariru")
	await novel_interface.show_dialog("Однако на этот раз Salmonton предоставил Министерству иностранных дел полную информацию о делегации и полный список запрещенных товаров.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Они даже сообщили обо всех военных операциях, в которых в прошлом участвовали их сотрудники службы безопасности. В записях не найти ни единого изъяна…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Итак, это звучит как заявление об отказе от ответственности: если с внучкой доктора Dekkers случится что-то плохое, то это будет наша вина.", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Хм! Эта хитрая лиса…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Однако в обмен на безопасность этой молодой леди они пообещали приоритетную поставку нашего контракта на закупку сельскохозяйственной продукции в размере 20%.", "Элоиза")
	await novel_interface.show_dialog("Согласно текущему индексу НБОТ, это как раздача подарков.", "Элоиза")
	await novel_interface.show_dialog("Я подписал распоряжение, чтобы средства массовой информации пока не выслеживали ее след.", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Используют ли они Сенатскую часть своей стратегии создания рынка?) \\n(И они знали, что я буду держаться в стороне…)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Хм… старая хитрая лиса…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Девушка нам пригодится. Можем ли мы получить от нее больше информации?", "Bright")
	await novel_interface.show_dialog("Честно говоря, нас очень интересовали их технологии редактирования генов и мегатепличные системы.", "Bright")
	await novel_interface.show_dialog("Если она сможет провести несколько часов в моей лаборатории…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Доктор Брайт…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Вы уже заслужили хорошую репутацию благодаря своим «уникальным» моральным стандартам на Substance H, которые влияют на человеческий разум.", "Mariru")
	await novel_interface.show_dialog("Боюсь, что Salmonton немедленно введет торговые санкции на New Opulentia, как только молодая леди войдет в вашу лабораторию.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Моя репутация? Действительно? \\nХахаха…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Кхм, этого достаточно!", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Говоря о неизвестных вооруженных людях в отеле «Скай»…", "Кирс")
	await novel_interface.show_dialog("Они напали на делегацию Salmonton и отобрали несколько ценных произведений искусства…", "Кирс")
	await novel_interface.show_dialog("Есть ли у SID какие-нибудь подсказки?", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Старый лис скрыл золотую бабочку от Сената и возложил вину на Джейкоба и его банду.)", "Mariru")
	await novel_interface.show_dialog("(Прежде чем принять меры, они отключили камеры видеонаблюдения в отеле.) \\n(Здесь пробел в информации...)", "Mariru")
	await novel_interface.show_dialog("Наши руки связаны в согласованной демилитаризованной зоне. По разным данным, мы полагаем, что они использовали специальное оружие.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Специальное оружие… вы имеете в виду оружие Substance H? \\nОни использовали оружие внутри защитного поля Aegis?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Судя по древовидным следам ожогов на полу, мы полагаем, что они использовали мощные разрядные устройства с последовательным резонансным контуром.", "Mariru")
	await novel_interface.show_dialog("Такое сложное устройство слишком громоздко, чтобы его мог носить один солдат, и уменьшить его размеры практически невозможно.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("По показаниям свидетелей, в ту ночь там было около 10 мужчин, вооруженных таким же оружием.", "Mariru")
	await novel_interface.show_dialog("Согласно записям Aegis, в ту ночь около десяти неизвестных идентификаторов одновременно отключились от сети. Должно быть, они покинули это место.", "Mariru")
	await novel_interface.show_dialog("Поскольку SID заблокировал регулярные выезды, они могли уйти по дипломатическим каналам.", "Mariru")
	await novel_interface.show_dialog("(Или казнены из-за их провала…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Понятно.", "Кирс")
	await novel_interface.show_dialog("Substance H оружие не может производиться в таких больших масштабах.", "Кирс")
	await novel_interface.show_dialog("Но прежде чем камеры были отключены, двое подозрительных лиц напали на охранников в коридоре.", "Кирс")
	await novel_interface.show_dialog("Одна из них была одета как горничная этого отеля, а другая была в униформе Госакурагавы. Вы их туда отправили?", "Кирс")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Из экрана доносится пронзительный писк.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Ха-ха-ха… Кажется, наш генеральный директор очень интересуется котятами… Я тоже.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Котята?", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("О, я процитировал это Ее Превосходительство г-жи Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Ну и заноза...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie и Рен, да? \\nОчаровательные имена…", "#C")
	await novel_interface.show_dialog("Возможно, есть и другие кошки, которых вырастила Микакава…", "#C")
	await novel_interface.show_dialog("Я прав, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ха, спасибо, что не продали их армии безопасности. Я твой должник.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Это не имеет большого значения. \\nПохоже, что вы и так не намерены ничего от нас скрывать.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Итак, позвольте мне рассказать вам более подробно.", "Mariru")
	await novel_interface.show_dialog("Спутник зафиксировал несколько Пространственно-временных потоков в отеле Sky Hotel, но SID не имел права предпринимать там действия.", "Mariru")
	await novel_interface.show_dialog("Поэтому я отправил туда двух агентов под прикрытием.", "Mariru")
	await novel_interface.show_dialog("Во время своей миссии они наткнулись на группу вооруженных людей, и один из них выстрелил в Annie из специального оружия.", "Mariru")
	await novel_interface.show_dialog("Теперь агент наконец-то вне опасности после оказания неотложной помощи, и мы собрали некоторую статистику об этом оружии.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Почему ты не сказал нам раньше?", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Господин генеральный директор, интересно, какие именно «произведения искусства» пропали?", "Mariru")
	await novel_interface.show_dialog("Возможно, пришло время всем нам стать более открытыми для обмена разведданными.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Что вы думаете?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Кирс")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Почему бы нам не начать с котенка, которого ты взял?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Облом… Этой информации было недостаточно, чтобы отвлечь его.)", "Mariru")
	await novel_interface.show_dialog("(Какая головная боль…) \\n(Что ж, боюсь, пришло время проверить эти поддельные документы. Время рассказывать, ребята.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Начнем, дорогая?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Во время Семилетней войны ученые пытались разработать новые технологии, позволяющие людям активировать Божественное прикосновение.", "Mariru")
	await novel_interface.show_dialog("Ходили слухи, что на комбатантах тайно проводились эксперименты по модификации человеческого тела. Я думаю, вы слышали такие слухи.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Гм-м-м.", "Кирс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru посмеивается, уголки ее губ слегка поднимаются вверх.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Некоторые люди рождаются с особыми способностями, и New Opulentia Академии наук и Института исследований мозга есть записи, подтверждающие это.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Собственно, доктора Брайта можно считать одним из них.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Подожди, я должен напомнить тебе, что почти все эти одаренные люди — женщины.", "Bright")
	await novel_interface.show_dialog("Однако людей с такими особыми талантами обычно ставят только в список наблюдения, и в особом контроле необходимости нет.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Верно. Но среди всех этих одаренных людей никто не обладает силой, сравнимой с силой B-класса Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Поскольку результаты экспериментов оказались ниже ожиданий, в период войны подобные исследования были отменены.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Женщины, обладающие сверхспособностями, также известны как «Ведьмы». Несколько десятилетий назад никто бы и не поверил в существование подобных вещей в мире…", "Элоиза")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Но Рен другая — она способна проходить через области потока.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что?!!","Толпа")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
