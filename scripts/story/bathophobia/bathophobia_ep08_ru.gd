# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Когда Mariru стучит по трубке, из глубины водоема доносится глубокий грохот. Уровень воды падает, когда подводный шлюз открывается.")
	await novel_interface.show_text_only("Судя по всему, глубина водохранилища превышает 30 футов, и плотина мгновенно превратилась в скалу.")
	await novel_interface.show_text_only("Когда уровень воды падает, на платформе на противоположной стороне скалы поднимается синий памятник.")
	await novel_interface.show_text_only("Когда окружающие огни загораются один за другим, форма этого памятника безошибочно узнаётся: это Тесхаймский столп из ляписа.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Вау…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На противоположной стороне находится гигантское пространство, шире стандартного футбольного поля. Ряды колонн высотой в десятки, если не сотни футов, окаймляют пространство во тьме.")
	await novel_interface.show_text_only("На высоте почти 300 футов фонари на крыше едва освещают окружающую местность, а в дальнем конце остается кромешная тьма.")
	await novel_interface.show_text_only("Преувеличенные масштабы сооружения выглядят кошмарно устрашающе.")
	await novel_interface.show_text_only("Мигающие индикаторы по четырем углам платформы напоминают о наличии электромагнитного защитного щита.")
	await novel_interface.show_text_only("Дорожка медленно приближается к нам.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… Потрясающе!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это напоминает мне начальную сцену стрелялки.")
	await novel_interface.show_text_only("Следуем за Mariru и идем по отзывчивой лестнице к диспетчерской.")
	await novel_interface.show_text_only("Ступени, обычно спрятанные в стене, появляются только тогда, когда кто-то собирается на них наступить.")
	await novel_interface.show_text_only("Кажется, что лестница спроектирована таким образом, чтобы люди не могли подойти к стойке управления или покинуть ее.")
	await novel_interface.show_text_only("Я осматриваюсь и замечаю на потолке пару закрытых бойниц для мелкого тяжелого оружия.")
	await novel_interface.show_text_only("Вспоминая, как мы сюда попали, я пытаюсь представить себе структуру этого огромного подземного сооружения.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… Вы, должно быть, вложили в это миллиарды долларов.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ремонт — непростая задача, но это единственный выбор, который у нас есть, если мы хотим соблюсти стандарты безопасности и уложиться в сроки проекта «Ковчег».", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("По стандартам безопасности Mariru означает способность защищаться от возможных угроз, таких как могущественные, но враждебные ведьмы.")
	await novel_interface.show_text_only("Чтобы обеспечить безопасность Академгородов, Сенат требует, чтобы эти объекты были в состоянии управлять такими угрозами и устранять их.")
	await novel_interface.show_text_only("Однако в условиях неизвестных угроз эти стандарты в лучшем случае обеспечат лишь психологическую подушку безопасности.")
	await novel_interface.show_text_only("Вот что сказал Mariru на оперативном совещании.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Чего вы ждете?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда мы приближаемся к пульту управления, я все еще чувствую нерешительность, вступая на лестницу высотой более 30 футов, хотя я знаю, что ступени будут отслеживать движение моих ног.")
	await novel_interface.show_text_only("На платформе впереди стоит Ляписовая колонна, выше меня, поддерживаемая четырьмя большими захватами.")
	await novel_interface.show_text_only("Я чувствую себя совершенно потрясенным, увидев столб лично. Фотографии в Интернете ни с чем не сравнимы.")
	await novel_interface.show_text_only("Поверхность этого полупрозрачного бирюзового памятника наполнена вписанными узорами из тонких линий.")
	await novel_interface.show_text_only("Они кажутся символами, расположенными в определенном логическом порядке, но археологам до сих пор не удалось их расшифровать.")
	await novel_interface.show_text_only("Концентрические круги, валы, контуры. Кажется, что они не содержат осмысленных кодов, а передают концепции более непосредственно.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Должно быть, это национальное достояние… Возможно, нам стоит опробовать в нашем первом эксперименте другие артефакты, менее важные…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("А? Испуганный?", "Raphael")
	await novel_interface.show_dialog("Если ты облажаешься, ты же знаешь, чего ожидать, верно?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия предупреждает.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Нет, конечно нет. Мне это кажется слишком экстравагантным…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Хорошо, теперь давайте деактивируем электромагнитный щит.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru аккуратно дергает красный рычаг на пульте управления. Красные индикаторы по углам защитного устройства сразу гаснут.")
	await novel_interface.show_text_only("Внезапно по моей голове пронзает жужжание, как будто через мозг проходит слабый ток.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Все в порядке?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Возможно, это волшебная надпись, но…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я останавливаю взгляд на Лазуритовой колонне. Что-то не так.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Похоже, твое тело очень чувствительно.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, не перед…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на Рафилию, которая смотрит на меня взглядом «ты извращенец».")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("То, что вы сказали, вводит в заблуждение!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Для нашей безопасности повторю инструкцию по эксплуатации электромагнитного щита.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru указывает Рафилии и Annie на пульт управления, а затем поворачивается ко мне.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Шоу идет?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("На этой станции управления и окружающих колоннах установлены десятки датчиков и камер полного спектра. Они настроены на автоматический запуск при открытии защитного корпуса.", "Mariru")
	await novel_interface.show_dialog("Данные и изображения будут отправлены непосредственно в комнату наблюдения и переданы исследовательским учреждениям на базе Salmonton после эксперимента.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru подмигивает мне.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Черт возьми, да…) \\n(Вы явно подготовили фейковые данные…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я смотрю на смотровую комнату на вершине соседних колонн.")
	await novel_interface.show_text_only("Одностороннее взрывозащищенное стекло не показывает следов присутствия людей и лишь холодно отражает окружающий свет.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Эти сенаторы должны стоять за этим…)", "Lian")
	await novel_interface.show_dialog("(Надеюсь, нам удастся их обмануть…)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Защитным кожухом и причалом можно легко управлять с помощью механического переключателя и рукоятки.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Следуя указаниям Mariru, Annie проверяет все кнопки и переключатели пульта управления.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Я давно не видел механических переключателей, а здесь рукоятка... \\nПочему вы используете эти древние аппараты?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Механические устройства обычно являются наиболее стабильными решениями. Просто выдержите это.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Итак, прежде чем я уйду в командный пункт, вы хотите что-нибудь спросить?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Мы… Мы собираемся начать?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мое сердце бешено стучит. Я делаю несколько глубоких вдохов.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Нервничаешь?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, заметив мое беспокойство, Mariru обнимает меня за спину и нежно говорит:")
	await novel_interface.show_text_only("От такого интимного поведения перед другими у меня горит лицо.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("А... Немного...", "Lian")
	await novel_interface.show_text_only("Мое сердце бьется быстрее!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Устраивать спектакли — это не мое дело! В детстве моей единственной актерской ролью была «Хижина дяди Тома». А я была хижиной.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru смотрит на комнату наблюдения.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Да?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("От ее дыхания у меня немеет ухо. Как будто от задней части моего уха идет нерв, передающий онемение всему телу, спускаясь к пяткам.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Расслабься, сенаторы ничего не заметят.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru шепчет мне на ухо.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Примерно в 70 футах над моей головой находится слой оптического камуфляжа.", "Mariru")
	await novel_interface.show_dialog("А стекла смотровой комнаты обработаны, чтобы они видели только то, что «должны» видеть…", "Mariru")
	await novel_interface.show_dialog("После того, как Рафилия закроет защитный корпус, вы исчезнете перед ними, как будто вошли в зону потока.", "Mariru")
	await novel_interface.show_dialog("После этого вам просто нужно попытаться прикоснуться к Ляписовому столбу. Ничего страшного, если ты не сможешь вызвать ведьм, как мы планировали.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я слышу хихиканье, а затем Mariru дует мне в ухо поток воздуха. \\nНерв, который я только что заметил, снова энергично протестует.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ик!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Но если будет объявлено что-то плохое… \\nВы же знаете, как поступить в худшем случае, верно?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я ненадолго сглатываю.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("В тот момент, когда датчики достигнут порогового значения, сработают программы блокады и разрушения…", "Lian")
	await novel_interface.show_dialog("В течение 5 секунд мы должны взять люк на полу справа от вас и войти в подземную зону сегрегации.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я смотрю на запасной путь, который мы запланировали на оперативном совещании.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Если быть точным, то у вас есть всего 4,8 секунды.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Вся база мгновенно будет затоплена морской водой) \\n(Не говоря уже о системе вооружения над моей головой…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Но согласно моей проверке биографических данных о Ляписовом столбе…", "Mariru")
	await novel_interface.show_dialog("Его бывший владелец был убежденным пацифистом, хотя и был очень скрытным и использовал несколько псевдонимов.", "Mariru")
	await novel_interface.show_dialog("Так что, возможно, вам стоит позвать волосатого мужчину средних лет.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Если да, то просто позвольте Рафилии вернуть его обратно в Salmonton!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("В любом случае, безопасность прежде всего.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru отпускает меня и похлопывает по голове.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Береги себя... Я буду за тобой наблюдать.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("По звуку, сигнализирующему о начале эксперимента, я снова фиксирую взгляд на Лазуритовой колонне, молча стоящей на платформе.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Удастся ли нам добиться успеха?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
