# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("Qu'est-ce que l'âme ?")
	await novel_interface.show_text_only("Une forme d'énergie qui préserve la conscience ? Ou un état quantique inobservable ?")
	await novel_interface.show_text_only("Ou juste un concept…")
	await novel_interface.show_text_only("Tout comme le concept de temps en physique—")
	await novel_interface.show_text_only("C'est peut-être juste une illusion… un rêve.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Alors la question est...")
	await novel_interface.show_text_only("Qui est le rêveur ?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("Le froid mordant de la Convergence Antarctique coupe tout le bruit du monde extérieur.")
	await novel_interface.show_text_only("À 20 000 pieds sous le niveau de la mer se trouve la zone abyssale.")
	await novel_interface.show_text_only("Enveloppé dans une coque pressurisée en titane, un sous-marin des grands fonds descend lentement.")
	await novel_interface.show_text_only("La faible lumière émise par son indicateur d’état est rapidement engloutie dans l’obscurité abyssale.")
	await novel_interface.show_text_only("Sans lumière, il est incapable de percevoir l’espace.")
	await novel_interface.show_text_only("Une effrayante dent de croc tente de heurter la coque, mais elle ne reçoit aucune réponse.")
	await novel_interface.show_text_only("La pression de l'eau de 60 MPa met à l'épreuve la limite de contrainte de compression de la coque.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("Soudain, huit projecteurs préprogrammés s’allument simultanément, projetant huit faisceaux de lumière droits et étroits.") #换行问题
	await novel_interface.show_text_only("Comme des épées tranchantes, les projecteurs éclatent en un éclat éblouissant et transpercent l’obscurité.")
	await novel_interface.show_text_only("Un faisceau de lumière traverse les épaisses vitres de la salle de contrôle et tombe sur le visage d'une jeune fille endormie.")
	await novel_interface.show_text_only("Ses longs cheveux gris foncé, brillants d'éclat bleu, se dispersent sur son visage pâle mais pur.")
	await novel_interface.show_text_only("La jauge de profondeur sur le tableau de bord devant la jeune fille cesse de fonctionner à 4091 pieds.")
	await novel_interface.show_text_only("Les projecteurs à l’extérieur de la pièce s’éteignent progressivement. Mais une faible lueur argentée commence à scintiller autour du corps de la jeune fille.")
	await novel_interface.show_text_only("Des profondeurs de l'océan tant redoutées par les humains, vient une voix grave et lointaine.")
	await novel_interface.show_text_only("Comme l’appel d’un ancien monstre.")
	await novel_interface.show_text_only("La jeune fille endormie semble être réveillée du ventre de sa mère.")
	await novel_interface.show_text_only("Les vertiges et les nausées incontrôlables sont également réveillés…")
	await novel_interface.show_text_only("Bien en dessous de la profondeur de sécurité de 15 000 pieds, la coque métallique commence à émettre un craquement anormal.")
	await novel_interface.show_text_only("Une toux réprimée sort de la gorge de la jeune fille.")
	await novel_interface.show_text_only("Elle a quelques difficultés à respirer au début, mais s'adapte rapidement à la pression sous-marine et stabilise sa respiration.")
	await novel_interface.show_dialog("La collision à l’instant… On dirait qu’elle m’a assommé.", "Fille")
	await novel_interface.show_dialog("Mais je peux encore respirer… Il doit y avoir suffisamment d'oxygène.", "Fille")
	await novel_interface.show_dialog("Je peux voir ma respiration… \\nPrès de 32 °F, bien sûr…", "Fille")
	await novel_interface.show_dialog("Vérification du système. Prêt pour un démarrage à froid. \\nInformations d'identification : Beth.", "Fille")
	await novel_interface.show_text_only("La fille nommée Beth ne semble pas s'inquiéter de la température glaciale. Elle vérifie attentivement le système.")
	await novel_interface.show_text_only("Elle est née avec la capacité de supporter un froid extrême. Lorsque bébé Beth a été retrouvée dans les montagnes en hiver, elle avait déjà passé une nuit entière sur la glace.")
	await novel_interface.show_text_only("Un certain nombre d'examens physiques ont prouvé que la fille miraculeuse peut s'adapter à divers environnements froids.")
	await novel_interface.show_text_only("Sous le froid intense qui pourrait rendre inconscient un adulte en 30 secondes, sa température corporelle est encore normale et ses mains chaudes.")
	await novel_interface.show_text_only("Les médecins n'ont pas pu comprendre pourquoi avant qu'elle ne soit retirée de l'orphelinat par son père adoptif.")
	await novel_interface.show_dialog("Systèmes d'éclairage et de propulsion… démarrage normal. Redémarrage du capteur… tout va bien.", "Beth")
	await novel_interface.show_dialog("Est-ce qu'il fait déjà 20 000 pieds de profondeur ? \"Cette chose\" ne peut pas exister sous une pression d'eau aussi élevée.", "Beth")
	await novel_interface.show_dialog("Je dois économiser de l’énergie pour le voyage de retour… Projecteurs éteints…", "Beth")
	await novel_interface.show_text_only("Au moment où les projecteurs s’éteignent, Beth regarde par la fenêtre.")
	await novel_interface.show_dialog("Quoi…", "Beth")
	await novel_interface.show_text_only("Une scène effrayante lui fait dresser les cheveux.")
	await novel_interface.show_dialog("Qu'est-ce que c'est… ça…", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Juste avant que les projecteurs ne s’éteignent, une gigantesque structure ressemblant à un corail apparaît à l’extérieur de la fenêtre d’observation.")
	await novel_interface.show_text_only("Il s'agit d'une structure centripète semblable à un tissu. Des vaisseaux irréguliers y ressemblent à une cascade écarlate tombant dans un immense trou noir.")
	await novel_interface.show_text_only("Mais aucune structure biologique ou topographique n’a été trouvée lors du scan pour l’instant.")
	await novel_interface.show_text_only("Beth allume immédiatement l'objectif grand angle sur la coque, essayant d'avoir une vue plus large...")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Sur l’écran, il y a une ombre immense et brumeuse. Il s'étend sur plus de 300 pieds et possède des tentacules.")
	await novel_interface.show_dialog("Cela ne peut pas être…", "Beth")
	await novel_interface.show_text_only("Cela ne fait pas partie du paysage, mais bien une sorte de créature. Des taches de lumière rouges brillent dans l'obscurité.")
	await novel_interface.show_dialog("Est-ce… un globe oculaire ?", "Beth")
	await novel_interface.show_text_only("— Si cette chose étrange peut s'appeler un « globe oculaire ».")
	await novel_interface.show_text_only("Le trou noir face à la fenêtre est la pupille du globe oculaire.")
	await novel_interface.show_text_only("C'est trop proche pour déterminer la distance. La coque semble susceptible d'être aspirée dans la pupille à tout moment.")
	await novel_interface.show_text_only("Les taches rouges disparaissent. La jeune fille fait maintenant face à l'objet inconnu dans l'obscurité silencieuse.")
	await novel_interface.show_text_only("Lorsque ses yeux s'adaptent à l'obscurité, elle voit sur l'écran l'énorme globe oculaire émettant une faible lumière rouge, comme s'il s'agissait d'une méduse opaque.")
	await novel_interface.show_text_only("Le globe oculaire est rempli de morceaux de tissus tortueux. \\nIl bat avec son cœur.")
	await novel_interface.show_dialog("(Détendez-vous… détendez-vous !) \\n(Pensez-y…)", "Beth")
	await novel_interface.show_text_only("S’il s’agit d’un globe oculaire, son cristallin doit être sensible à la lumière.")
	await novel_interface.show_text_only("Sur la couche externe du globe oculaire, là où devrait se trouver la choroïde, des essaims de taches blanches scintillent.")
	await novel_interface.show_text_only("Beth remarque que des tentacules en forme de branches sont attachées à l’arrière du globe oculaire.")
	await novel_interface.show_text_only("Les tentacules gris foncé sont immergés dans les profondeurs de l’océan, sans aucune fin en vue.")
	await novel_interface.show_dialog("(… je ne peux pas… bouger…)", "Beth")
	await novel_interface.show_text_only("-Beth ressemble plus à être surveillée par cette chose, au lieu d'affronter cette chose.")
	await novel_interface.show_text_only("Le regard intrusif érode son calme et lui fait peur.")
	await novel_interface.show_dialog("Aide…", "Beth")
	await novel_interface.show_text_only("— Est-ce que ça va tout engloutir ?")
	await novel_interface.show_text_only("L’étrange sensation d’être au fond de l’océan la fait douter de son existence même.")
	await novel_interface.show_dialog("(Est-ce un rêve…?) \\n(Réveillez-vous, vite…)", "Beth")
	await novel_interface.show_text_only("Son corps agit d'instinct avant même que sa conscience ne suive.")
	await novel_interface.show_text_only("Alors que la jeune fille tirait le joystick avec sa main gauche, la chambre de plongée continuait à se déplacer sur une certaine distance vers le globe oculaire.")
	await novel_interface.show_text_only("L'eau devient agitée, comme si cette chose était dérangée.")
	await novel_interface.show_text_only("La pupille se contracte, attendant le prochain mouvement de la jeune fille.")
	await novel_interface.show_dialog("Allô ? Allô ?", "Beth")
	await novel_interface.show_text_only("Beth attrape son casque et essaie de se connecter au pupitre de contrôle.")
	await novel_interface.show_text_only("Mais aucune onde électromagnétique ne peut s’échapper de cette profondeur, et la communication acoustique sous-marine n’est pour l’instant pas viable.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Si elle avait été là… Elle m'aurait crié dessus : \\n\"Arrêtez de vous rapprocher !\"")
	await novel_interface.show_dialog("Ha… pourquoi devrais-je penser à ça…", "Beth")
	await novel_interface.show_dialog("Qui est… « Elle » ?", "Beth")
	await novel_interface.show_dialog("Où… suis-je…", "Beth")
	await novel_interface.show_text_only("Regardée par le globe oculaire géant, Beth est perdue dans un état second. La frontière entre réalité et illusion s’estompe peu à peu.")
	await novel_interface.show_text_only("Elle passe la main sur le tableau de bord.")
	await novel_interface.show_text_only("Elle localise bientôt le contrôleur du bras du robot.")
	await novel_interface.show_dialog("(Est-ce que je dois vraiment le faire…)", "Beth")
	await novel_interface.show_text_only("Elle reprend son souffle, mais la lumière illusoire continue de clignoter devant ses yeux.")
	await novel_interface.show_dialog("Prélevez quelques échantillons… Et puis retirez-vous immédiatement…", "Beth")
	await novel_interface.show_text_only("Tout d’abord, pointez les projecteurs vers l’avant…")
	await novel_interface.show_text_only("Ensuite, configurez le système de propulsion… vitesse maximale. Direction… inverse.")
	await novel_interface.show_text_only("Ayant du mal à terminer la pré-configuration, la jeune fille est presque sur le point de perdre connaissance.")
	await novel_interface.show_dialog("Père, est-ce… une pollution spirituelle… \\nJe suis presque…", "Beth")
	await novel_interface.show_text_only("Beth actionne lentement le manipulateur pour libérer le bras du robot. Une énorme aiguille est révélée.")
	await novel_interface.show_dialog("Mode aspiration activé… Sous une telle pression, un seul tirage rapide suffira…", "Beth")
	await novel_interface.show_text_only("Le bras du robot s'étire vers l'avant jusqu'à ce que l'aiguille soit insérée dans le corps vitré.")
	await novel_interface.show_text_only("Le niveau de concentration du conteneur passe de 0 à 100 % en un instant.") #标点删除
	await novel_interface.show_text_only("Pendant un instant, la pupille est déformée. Si le son avait pu pénétrer dans la coque, elle aurait dû entendre un cri aigu…")
	await novel_interface.show_dialog("(j'entends des choses…)", "Beth")
	await novel_interface.show_text_only("Avec son dernier effort, la jeune fille appuie sur le bouton d'exécution programmée.")
	await novel_interface.show_text_only("Selon le programme prédéfini, les projecteurs projettent huit faisceaux de lumière intenses dans la pupille et l'hélice commence à tourner de manière extravagante.")
	await novel_interface.show_text_only("Le globe oculaire recule sous la stimulation de la lumière, et la coque commence à reculer et à se soulever…")
	await novel_interface.show_text_only("Totalement épuisée, la jeune fille s'évanouit et tombe au sol.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
