# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("An endless expanse of bleak land—dyed a mystic green by the stunning aurora australis.")
	await novel_interface.show_text_only("A string of headlights pierce through the frigid, silent gloom.")
	await novel_interface.show_text_only("They belong to a fleet of snowmobiles. The scooters sweep past the ice plains shrouded in darkness, past the heliport, finally parking at the entrance to the sprawling base.")
	await novel_interface.show_text_only("Standing erect in front of them is a monument shaped like a cocoon. A heavy-duty specimen box, previously used to hold Mt. Grove meteors, is embedded in its rocky surface.")
	await novel_interface.show_text_only("The word “Snedronningen” is painted countless times around the box, gleaming silver under a spotlight.")
	await novel_interface.show_text_only("Snedronningen—the White Queen. The name of the base the riders are seeking.")
	await novel_interface.show_text_only("A heavily-armored squad member, riding in the forefront, rips off her visor.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Aaaand here we are!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Following her lead, the remaining five riders kill their engines and dismount, each picking up their respective supplies.")
	await novel_interface.show_text_only("This is a scientific research team—one in which all members have undergone standard combat training.")
	await novel_interface.show_text_only("Reports of radio waves generated by Substance H being detected in Antarctica two months ago have brought many a curious faction to the area. Most of them came armed.")
	await novel_interface.show_text_only("For the squad, it‘s wise to be cautious in order to keep the specimens safe.")
	await novel_interface.show_text_only("They’ve been lucky so far. The journey to the research base mentioned in the backup plan has gone quite smoothly.")
	await novel_interface.show_dialog("All right. All we gotta do is hand the stuff over.", "Squad Member D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Yes.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Unlike the others, who are bundled in thick, warm layers, Beth is clad in a casual outfit, clearly unaffected by the extreme temperature.")
	await novel_interface.show_text_only("Her self-improved weapons, too, stand out from the crowd.")
	await novel_interface.show_text_only("Their journey had gone exactly as she had expected...")
	await novel_interface.show_text_only("Beth had dove into the depths of the ocean mere hours ago, successfully bringing back live samples she gathered from the body of an unidentified creature.")
	await novel_interface.show_text_only("To conclude the research project, Milk’s supervisor dispatched the Ushuaia Icebreaker to assist the special ops squad.")
	await novel_interface.show_text_only("When the box of samples was being transferred to the Ushuaia, the biolab on the ship happened to “accidentally” experience a power failure.")
	await novel_interface.show_text_only("At the same time, the Snedronningen Base, around an hour’s ride away, offered to temporarily let the team store the samples in their lab, which fits all specifications.")
	await novel_interface.show_text_only("The squad soon received permission to enter the premises, and was tasked to bring the specimens to Snedronningen Base within ninety minutes.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(We’ve come so far...)", "Beth")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Will those scumbags show up?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth clenches her fist.")
	await novel_interface.show_text_only("What bothers her even more is that something in the specimen box seems to have triggered a sort of response in her body.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("...\\n(This feels familiar for some reason...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before she can further contemplate this, the world begins shaking violently.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(Am I just dizzy from the dive?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No, that’s not it.")
	await novel_interface.show_text_only("—This whole land is quaking.")
	await novel_interface.show_text_only("Deep rumbling can be heard from a distance.")
	await novel_interface.show_text_only("Even the most weathered veterans seem shaken.")
	await novel_interface.show_text_only("The tremor that rocks this white continent lasts less than thirty seconds.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Antarctica isn’t in the earthquake zone... is it?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The quake wasn’t too strong. However, it did leave everyone a bit dizzy.")
	await novel_interface.show_dialog("(Mumbling) It's far worse than the tsunami...", "Squad Member B")
	await novel_interface.show_dialog("The ice shelf underneath our feet seems pretty sturdy. If the same quake happened in a highly-populated tropical city, it’d have caused much more damage.", "Squad Leader")
	await novel_interface.show_text_only("The squad members shrug off this small-scale earthquake and continue with their work.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Okay, let’s go.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The box of samples secure in her arms, Beth hops off the back seat of Milk’s snowmobile.")
	await novel_interface.show_dialog("I’m spent. Can’t wait to get home to my bed and hot cocoa.", "Squad Member B")
	await novel_interface.show_text_only("While the squad members are already lowering their guards, the leader remains vigilant, sending meaningful glances in Beth’s way.")
	await novel_interface.show_text_only("If it weren’t for this girl, they would have failed this mission—just like how all the other factions did.")
	await novel_interface.show_text_only("She had to dive into the depths of the ocean, risk decompression sickness, and face unidentified creatures...")
	await novel_interface.show_text_only("The stakes are too high. Not even Milk herself could have guaranteed success in such circumstances.")
	await novel_interface.show_dialog("So all we need to do is hand the stuff over to the scientists here, right?", "Squad Member D")
	await novel_interface.show_dialog("Beth, let us treat you to a beer when we get back to Buenos Aires, eh?", "Squad Member C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("No way! Our Bethy doesn’t drink alcohol!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pulling Beth into her arms, Milk declares.")
	await novel_interface.show_text_only("Bai Zhu pressed his lips together, deliberately suppressing his uneasiness.")
	await novel_interface.show_text_only("Milk sends multiple entry requests at the base’s gate, yet receives no response.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("How strange...", "Milk")
	await novel_interface.show_dialog("Did the earthquake ruin the connection or something?\\nThey were still in touch right before we docked.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Still, though the spikes at the front gate that restrict vehicle entry remain standing, the squad is technically able to enter anyway—they have received the access code in advance, after all.")
	await novel_interface.show_text_only("So they head towards the brightly-lit barrier to the side of the base.")
	await novel_interface.show_text_only("Beth stops in her tracks suddenly and hands the box of specimens to one of her squadmates.")
	await novel_interface.show_text_only("With her free hands, she grips her weapons tightly.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("...What’s up?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noticing Beth’s actions, Milk whips out her weapons as well, eyes alert.")
	await novel_interface.show_text_only("The other members, too, tense up and get into battle mode, moving forward in a fan-shaped formation, watching each other’s backs.")
	await novel_interface.show_dialog("... What the heck?", "Squad Member D")
	await novel_interface.show_dialog("Shh, keep it down.", "Squad Leader")
	await novel_interface.show_text_only("All that can be heard in the deafening silence is the squeaks of snow boots on the surface of the ice and the quiet breathing of the squad members.")
	await novel_interface.show_text_only("Milk approaches the door and punches the code into the security lock.")
	await novel_interface.show_text_only("The system accepts the code and the word ENTER flashes in green on the screen.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Whew... this should be safe, right?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But Beth still can’t quell the unnerving feeling in her gut...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("The barrier to Snedronningen Base finally slides open, along with sounds of whirring cogs and straining cords.")
	await novel_interface.show_text_only("Behind the gate is a flight of stairs that goes straight down towards the dimly-lit lower level.")
	await novel_interface.show_dialog("Anyone?", "Milk")
	await novel_interface.show_text_only("Her question echoes down the narrow passageway.")
	await novel_interface.show_dialog("I get that most of the facilities here are underground, but couldn’t they have sent someone upstairs to welcome us?", "Milk")
	await novel_interface.show_dialog("At least one of those researchers should come over and check the specimens...", "Squad Member B")
	await novel_interface.show_dialog("In battle position!", "Beth")
	await novel_interface.show_text_only("Eyes trained on the far end of the stairs, Beth barks out her order.")
	await novel_interface.show_dialog("Someone’s watching us.", "Beth")
	await novel_interface.show_dialog("The more covert the option, the easier it is to attract attention, I guess...", "Milk")
	await novel_interface.show_dialog("(Are our enemies the ones you’re worried about?)", "Milk")
	await novel_interface.show_text_only("A series of gun safeties popping breaks the fearful silence.")
	await novel_interface.show_text_only("The squad members, all trained soldiers in their own right, look to the girl who holds the position as temporary commander, waiting for her orders.")
	await novel_interface.show_dialog("We’re in a very exposed location right now. We’ll be in danger if they’ve got an ambush set up. We can retreat outside...", "Squad Member D")
	await novel_interface.show_dialog("Can’t. We got a warning, said there’s gonna be a blizzard in an hour’s time.", "Beth")
	await novel_interface.show_dialog("Everyone on high alert. Keep moving.", "Beth")
	await novel_interface.show_dialog("(All) Yes, sir!", "Squad Member")
	await novel_interface.show_text_only("The squad members tiptoe along, keeping their breathing low.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Look out!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The sound of a sharp blade cutting through the air broke the moment of silence.")
	await novel_interface.show_text_only("A creature wielding a heavy scythe-shaped weapon leaps out from the shadows and slashes at Beth’s right side.")
	await novel_interface.show_text_only("Milk’s warning came just in time, allowing Beth to dodge the attack.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("What?!!", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahaha... hahahahaha...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The attacker is a girl—eyes hollow, posture distorted. She slouches forward, her joints clacking, loud and disorienting.")
	await novel_interface.show_text_only("Several others, faces fresh, expressions insane, surge through the previously empty corridor entrance.") 
	await novel_interface.show_text_only("The squad members immediately get into their standard triangle formation, while continuing to fire back at the attackers.")
	await novel_interface.show_text_only("Following Beth’s lead, they surround the member holding the specimen box, guarding her on all sides.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("The team keeps up a steady firing rhythm while seeking cover. Soon, they arrive at a space that seems to be an exhibition room.")
	await novel_interface.show_text_only("The lights are dim here, with the exhibits being mostly animal specimens.")
	await novel_interface.show_text_only("The leader directs the team to form a defense line at the entrance of the room, while the rest of the squad discuss the abnormal qualities they’ve noticed about these enemies.")
	await novel_interface.show_text_only("When hit, they do not bleed. They don’t even seem to feel pain.")
	await novel_interface.show_text_only("The group unfolds their Kevler fiber riot shields, which block the attacks somewhat.")
	await novel_interface.show_text_only("The enemies rushing in from another side, greatswords in hand, are held back at the corner by squad members holding even more riot shields.")
	await novel_interface.show_text_only("Meanwhile, from behind the shield-holders, 9mm bullets continue to rain on the enemies, the smell of gunpowder heavy in the air.")
	await novel_interface.show_dialog("Reload!", "Squad Member C")
	await novel_interface.show_text_only("The gunfire does nothing to deter the strange enemies. Even as the bullets rip through their faces, these ghastly girls continue grinning.")
	await novel_interface.show_text_only("Until one of the girls vaults over a shield and hangs herself upside down, all bat-like, on the passageway ceiling.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Uh... is she even... human?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ink-green liquid pours out of the girl’s bullet wounds. Her neck, nearly shattered in half by the force of bullets, is now dyed a disturbing greenish-purple.")
	await novel_interface.show_dialog("Watch out!", "Squad Member B")
	await novel_interface.show_text_only("More enemies come charging in from the end of the corridor.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Retreat! Retreat!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The squad members have no choice but to split up in two directions and seek other suitable attacking points, which they fortunately find soon.")
	await novel_interface.show_text_only("They haven’t been fighting for long yet, but it’s obvious to them all that the enemies—whatever they are—are every bit as powerful as their own.")
	await novel_interface.show_text_only("And also a hundred percent crazier.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... What are they...?", "Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("What the hell?\\nThey can’t be human!", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("To Beth, it’s obvious that these blade-wielding young girls are just like her—")
	await novel_interface.show_text_only("No, not completely.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(They are more like what their father described...)\\n(\\\"Ningen\\\"'s style)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("They are resilient, recover speedily, with extremely flexible joints that make them less human and more like agile puppets. Too powerful.")
	await novel_interface.show_text_only("And they’ve clearly gone cuckoo. Like program-activated killing machines.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahahaha... Jajajajajaja...", "Patchy Pythoness")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Their nonsensical babble sounds like some kind of demonic chant. Definitely not human.")
	await novel_interface.show_text_only("Suddenly, the squad member holding the specimen box is hit by an arrow. As she crumples to the ground, the box rolls out of her arms.")
	await novel_interface.show_text_only("But the enemies don’t seem to be in a rush to pick it up.")
	await novel_interface.show_dialog("Beth!", "Squad Member D")
	await novel_interface.show_text_only("The squad members, forced all the way to the depths of the exhibition room by the advancing enemies, cry out for their commander to give further instructions.")
	await novel_interface.show_text_only("This is a situation where no normal protocol applies. All Beth can rely on now is her own senses and judgment.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(So they’re not here for the specimens?)", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Darn it!", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Then their goal must be—)", "Beth")
	novel_interface.change_expression("angry")
	await novel_interface.show_text_only("—to annihilate us all.")
	await novel_interface.show_dialog("...\\n(So it’s you guys indeed...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth’s gaze lands on the symbol embroidered on the eye patch of one of those puppet-girls.")
	await novel_interface.show_text_only("She’s seen that symbol countless times while investigating her father’s death.")
	await novel_interface.show_text_only("It’s a creepy, lone eye—an eye with limbs.")
	print("=== 深海恐惧症篇第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
