# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Was ist Realität?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Vielleicht ist die Realität, wie wir sie kennen, nur ein Computerspiel.")
	await novel_interface.show_text_only("Einloggen, die Charaktere wachen auf; Melden Sie sich ab und sie schlafen ein. Wenn Konten geschlossen werden, sterben sie.")
	await novel_interface.show_text_only("Mit der Zeit entwickeln sie die Wahrnehmung der Seele.")
	await novel_interface.show_text_only("Sie glauben, dass all diese vorprogrammierten Handlungen ihrem freien Willen entspringen.")
	await novel_interface.show_text_only("Formeln, Gesetze, Grammatikregeln, Verhaltenskodizes … Jeder Charakter muss diese Regeln befolgen, ohne zu wissen, wer sie erstellt hat … bis er schließlich befreit wird.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Selbst wenn ein großer Teil des Himmels aufgrund eines Renderfehlers verpixelt wird –")
	await novel_interface.show_text_only("Sie rationalisierten es einfach mit Märchen oder religiösen Überzeugungen, anstatt zuzugeben, dass es außerhalb ihres Wissens liegt.")
	await novel_interface.show_text_only("Weil das Akzeptieren des Unbekannten die beunruhigendste Möglichkeit bedeutet –")
	await novel_interface.show_text_only("Dass die sogenannte Realität möglicherweise nichts anderes als eine Illusion ist.")
	await novel_interface.show_text_only("Ein Wunschtraum.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Ich öffne langsam meine Augen und bemerke, dass ich wie benommen bin.")
	await novel_interface.show_text_only("Ich bin vom Nebel umgeben. Seltsamerweise hängen Regentropfenketten mitten in der Luft.")
	await novel_interface.show_text_only("Ich strecke die Hand aus und versuche, sie zu berühren, aber sie verschwinden sofort.")
	await novel_interface.show_dialog("Wo bin ich…", "Lian")
	await novel_interface.show_text_only("Ich stehe auf einer festen Oberfläche und kann die Schwerkraft spüren. Aber ich kann den Boden nicht sehen... als ob mein Blick im Nichts versunken wäre.")
	await novel_interface.show_text_only("Im Hintergrund ist ein ungewöhnliches Summen zu hören. Ohne Bezugsrahmen sind Anweisungen nicht wahrnehmbar.")
	await novel_interface.show_text_only("Ich schaue nach oben und sehe die Umrisse eines baumähnlichen Totems hoch über mir schweben.")
	await novel_interface.show_text_only("Es breitet sich wie eine schimmernde Decke am Himmel aus.")
	await novel_interface.show_text_only("Zehn Ringe auf dem Totem drehen sich langsam, einer strahlt einen rötlichen Strahl aus.")
	await novel_interface.show_text_only("Dann entfaltet sich unter meinen Füßen ein riesiges Muster aus Linien und Inschriften, das den sogenannten Boden bildet.")
	await novel_interface.show_text_only("Das Totem auf dem Boden ist das gleiche wie das in der Luft, sieht aus kurzer Entfernung jedoch viel größer aus.")
	await novel_interface.show_text_only("Die Ringe mit einem Durchmesser von jeweils etwa 15 Fuß sind in einer bestimmten Reihenfolge verbunden. Die Inschriften darauf sehen uralt aus.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Träume ich...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mir wurde beigebracht, Halluzinationen und Träume zu erkennen …")
	await novel_interface.show_text_only("Was ist nochmal die wichtige Frage...")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("—Wie bin ich hierher gekommen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Erinnerungen kommen zurück. Ich war in der Arche-Basis und alles begann zu fallen... Dann...")
	await novel_interface.show_text_only("Nein. Das ist kein Traum.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Hat es etwas mit diesem Mädchen zu tun?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Sie nannte mich Meister und sogar…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aww— \\nNein… Es ist nicht die Zeit für Fantasie…")
	await novel_interface.show_text_only("Wo ist Annie? Und Raphael?")
	await novel_interface.show_text_only("Sie müssen auch in diesen Ort hineingezogen werden!")
	await novel_interface.show_text_only("Ich schaue mich im Nebel nach ihnen um. Unerwartet hält mich ein Paar warme Arme von hinten.")
	await novel_interface.show_dialog("Machen Sie sich keine Sorgen, Meister –", "Blondes Mädchen")
	await novel_interface.show_text_only("Sie ist es! \\nDas nackte Mädchen umarmt mich von hinten!")
	await novel_interface.show_text_only("Ich habe viele Fragen an sie. Aber ich zögere, zurückzublicken...")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Meister... Wie seltsam!) \\n(Genau wie Spinner in Zeichentrickfilmen!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie scheint nach etwas zu suchen. Ihre Hände gleiten über meine Taille und bleiben an meinem flachen Bauch stehen.")
	await novel_interface.show_text_only("In der Stille kann ich hören, wie mein Herz schnell schlägt, während ihr Atem meine Haare kitzelt …")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(Was... wird sie tun?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ach?","Blondes Mädchen")
	await novel_interface.show_text_only("Sie schien etwas Interessantes entdeckt zu haben. Sie drückte leicht mit der Handfläche darauf und mein Magen gab sofort ein unbefriedigendes „Gluckern“ von sich.")
	await novel_interface.show_text_only("In dieser ruhigen Umgebung ist dieses Geräusch besonders auffällig.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Äh? Warum…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ahhhhhhh… So peinlich…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich trenne mich von ihr. Sie kommt auf mich zu und sieht mich neugierig an.")
	await novel_interface.show_dialog("Wurde auch der Körper des Meisters verändert? \\n… Was für ein perfektes Produkt der Alchemie!","Blondes Mädchen")
	await novel_interface.show_text_only("Ich möchte meine Augen bedecken, habe aber gemerkt, dass sie bereits angezogen ist.")
	await novel_interface.show_text_only("Moment, hat sie gerade gesagt, dass mein Körper verändert wurde?! \\nUnd... was trägt sie?")
	await novel_interface.show_text_only("Ein Blick auf Heinrichs Kostüm genügt, um dessen hochmodernes Material zu erkennen.")
	await novel_interface.show_text_only("Der Textur und dem Design nach zu urteilen, kann es nicht aus dem 16. Jahrhundert stammen... Nein, es geht sogar über moderne Handwerkskunst hinaus.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Sind die Informationen von Mariru falsch?) \\n(Und woher weiß sie von meiner Körperverwandlung?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während ich versuche, meine Gedanken in Worte zu fassen, zieht mich jemand plötzlich nach hinten.")
	await novel_interface.show_text_only("Es ist Raphael. Sie packt mich an meiner Kapuze, tritt vor und stellt sich zwischen mich und Heinrich.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Sag mir, wer bist du?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("—Na?", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mit einem verächtlichen Lächeln im Gesicht wendet sich Heinrich an Raphael.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Fragst du mich nach meinem Namen? \\nIch habe Hunderte davon.", "Blondes Mädchen")
	await novel_interface.show_dialog("Aber Sie können mich Henriette Khunrath nennen – so steht es im Vertrag.", "Blondes Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Das ist nicht lustig!", "Raphael")
	await novel_interface.show_dialog("Heinrich ist in allen historischen Aufzeichnungen ein Mann –", "Raphael")
	await novel_interface.show_dialog("Und außerdem: Schauen Sie, was Sie tragen! \\nHaben Sie Unterwäsche mit Oberbekleidung verwechselt?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Beschmutze nicht Heinrich, den großen Alchemisten, du schamloses Mädchen! Hören Sie auf, die Menschen „Meister“ zu nennen und... und ihnen das Wesentliche zu nehmen...", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael errötet, während sie spricht.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… Wer in aller Welt bist du!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während sie gegeneinander antreten, konnte ich nicht anders, als von Raphaels Rücken aus einen Blick auf Heinrich zu werfen.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Aus welchem Material besteht ihr Kostüm …) \\n(Toller Wickel! Wie konnten ihre Brüste in verschiedene Richtungen wackeln?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Unsere Blicke treffen sich und ich werde sofort rot. In Panik schaue ich auf meinen Rock und vermeide weiteren Augenkontakt.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Nun? Ich dachte, der Meister würde von Ihrem eigenen Meisterwerk nicht beeindruckt sein...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nein, nein, nein, ich bin (oder war) ein Junge…")
	await novel_interface.show_text_only("Heinrich zeigt auf ihre Brust.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Größer als früher... Ist das der Geschmack des Meisters?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael schaut zurück und wirft mir einen strengen Blick zu.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Nein! Nicht ich! Ich habe es nicht getan!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ich habe gerade aus Versehen den Nationalschatz von Salmonton zerstört …")
	await novel_interface.show_dialog("Und bitte nennen Sie mich nicht Meister... Nennen Sie mich einfach Ren.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ren...? \\nIch hätte nicht erwartet, dass eine großartige Person wie Sie einen so schönen Namen haben würde...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Was ist mit dir? Bist du wirklich Heinrich?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie zögert, schaut auf die Zahlen an ihrem Handgelenk und seufzt leicht.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Es ist schon 400 Jahre her…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Moment, hat sie eine Uhr oder einen Kalender an ihrem Handgelenk!?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Ich habe mich als Mann ausgegeben, um zu forschen, Artikel zu veröffentlichen oder als Arzt zu praktizieren.", "Henriette")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Daher überrascht es mich nicht, wie die Geschichte mich dokumentiert.", "Henriette")
	await novel_interface.show_dialog("Zu meiner Zeit ließen die Universitäten keine Mädchen zu, und die Kirche verbot Frauen, als Mediziner zu praktizieren –", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ganz zu schweigen davon, Alchemist zu werden... Hmm, ich möchte keinen Ärger mit dem Religionsgericht bekommen.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("… \\\\n", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Irgendwie werde ich jedes Mal empört, wenn ich etwas über die Unterdrückung von Frauen erfahre.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Es ist leicht, diese Hunde vom Hof loszuwerden, aber sie sind meine Zeit nicht wert.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Wow… hört sich cool an…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael sieht Heinrich nachdenklich an.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Moment, wie kamst du als Junge zur Universität? \\n", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich bin plötzlich neugierig, wie sie reingekommen ist. Vielleicht...")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ich habe mir einfach die Haare kurz geschnitten, mehrere Referenzen gefälscht und bin unter einem Pseudonym an die Universität Leipzig gekommen.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Nur ein Haarschnitt?", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_text_only("Ich schaue auf ihre Brust. Sind die Menschen vor 400 Jahren alle blind?")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Da war ich zehn Jahre alt. Die Aufnahmeprüfung für die Universität war zu einfach.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich lächelt verächtlich.")
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Hä? Egal.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Egal wie sich die Welt verändert, Wunderkinder sind immer großartig!")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Wie erklären Sie dann dieses Kostüm?", "Raphael")
	await novel_interface.show_dialog("Heinrich war Arzt und Alchemist, aber deine Rüstung und Waffe sind offensichtlich für den Kampf gedacht.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich tritt lächelnd einen Schritt zurück.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, tut mir leid, es ist meine Schuld.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie drückt ihre rechte Hand auf ihre Brust und das Kostüm beginnt zu knacken.")
	await novel_interface.show_text_only("Ihr Körper, nun umgeben von blauen und weißen Bändern und bunten Kristallen, beginnt zu strahlen.")
	await novel_interface.show_text_only("Als das blaue und goldene Licht zu verblassen beginnt, wird ihr Körper allmählich...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Allmählich... Was?")
	await novel_interface.show_text_only("Raphael stürzt herbei und bedeckt meine Augen fest mit ihren Händen.")
	await novel_interface.show_dialog("Genug! Ich verstehe!", "Raphael")
	await novel_interface.show_dialog("Zieh dich an, Exhibitionist!", "Raphael")
	await novel_interface.show_dialog("Es gibt auch Cross-Dressing, was guckst du dir an!", "Raphael")
	await novel_interface.show_text_only("Ich habe nichts gesehen!!")
	novel_interface.show_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Als Raphael ihre Hände entfernt, trägt Heinrich bereits wieder dasselbe Kostüm. Uff...")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Dies ist ein magischer Kampfanzug, ähnlich dem auf Master. Aber meins ist von überlegenen Wesen gemacht.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Was das Design betrifft... Ich fürchte, The One hat einen schrecklichen Geschmack...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Der Eine?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ich habe den Eingang zu diesem Raum mithilfe alchemistischer Techniken geschaffen.", "Henriette")
	await novel_interface.show_dialog("Sterbliche sollten die Wahrheit nicht kennen... Also musste ich den Preis zahlen. Der Eine zwang mich, einen Vertrag über meine Seele zu unterzeichnen...", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sieht etwas hilflos aus.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Murmelnd) Das letzte Mal wurde mein Körper völlig in Stücke gerissen, aber der Vertrag konnte immer noch mit einem neuen Körper aktiviert werden...", "Henriette")
	await novel_interface.show_dialog("Warum gibst du mir nicht eine Pause...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Während ich mich frage, was Heinrich sagt, ertönt plötzlich die zitternde Stimme von Annie aus dem Nebel.")
	await novel_interface.show_dialog("Ren—", "Annie")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir rennen dorthin, wo die Stimme herkam, und finden Annie ausgestreckt und zitternd auf dem Boden liegen.")
	await novel_interface.show_dialog("H... Hilfe...", "Annie")
	await novel_interface.show_dialog("… Nicht… Bitte…", "Annie")
	await novel_interface.show_text_only("Ich trat schnell vor, um Annie zu trösten, und in dem Moment, als meine Hand ihren Körper berührte –")
	await novel_interface.show_text_only("Eine zähe und heiße Brise strömt durch meine Hand und streicht schnell an mir vorbei.")
	await novel_interface.show_text_only("Ich schaue mich um, finde aber nichts Ungewöhnliches, außer dass Heinrich mich verwirrt ansieht.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Alles wird gut, Annie!", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aus irgendeinem Grund zittert Annie heftig.")
	await novel_interface.show_text_only("Ich verstehe, dass unbekannte Orte Anlass zur Sorge geben... Aber in dem riesigen, leeren Raum gibt es keine Anzeichen von Feinden.")
	await novel_interface.show_text_only("Ich halte Annie fest und versuche, sie zu trösten.")
	await novel_interface.show_text_only("Als Raphael dies sieht, wendet sie sich erneut an Heinrich.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Sie haben diesen Raum erwähnt... Ist es der Spalt der Kausalität?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Das ist der Name, der auf dem Baum des Lebens eingraviert ist...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Baum des Lebens?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Warum hast du uns hierher gebracht? Was wünschen Sie sich von uns?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich zuckt mit den Schultern.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Nicht ich.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Eigentlich hättest du gar nicht hier sein können...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Äh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("… Ohne die Absicht des Einen … oder sogar von höheren Wesen.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Wer ist der Eine?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Ich bin verpflichtet, ihn nicht bei seinem Namen zu nennen... Aber The One hat zu viele Titel...", "Henriette")
	await novel_interface.show_dialog("Die Wahrheit, der Weg, das Tor...", "Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Von Anfang bis Ende.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…?!", "Raphael")
	
	print("=== 深海恐惧篇第11话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
