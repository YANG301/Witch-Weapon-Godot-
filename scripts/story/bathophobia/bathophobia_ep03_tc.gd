# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("莉琉走近盯著螢幕的愛衣，俯身看著螢幕中不斷更新的數據。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("這就是貝阿特麗切的檢查報告嗎？", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("是啊，哈哈──這真的是完美的樣本！", "愛衣")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("如果再結合歷史文獻推演，就更有趣了唷～", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("目前所有資料庫裡都沒有她的資料，但是戰時的資料庫確實存在斷層。", "莉琉")
	await novel_interface.show_dialog("不過，根據她的口述記錄和妳報告的資料看來……", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉在螢幕中調出貝阿特麗切的檔案。")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("才二十四歲啊……\\n真是充滿活力的年齡呢～", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉和愛衣對看一眼，互相確認對方也注意到了同個重點，二人的視線又同時轉回螢幕。")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這是發現她的當晚所檢測的結果？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("那可不？ 體內放射性元素幾乎為零，不過血液中重金屬的含量略高。", "愛衣")
	await novel_interface.show_dialog("可能是因為當年的飲食器皿或中世紀的原始化妝品……", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("看來妳已經有先入為主的判斷了？", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("唉啊，別這麼說～畢竟在她的自述文件中——", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣伸出手指，劃過面前螢幕上某條記錄。")
	await novel_interface.show_text_only("「GMT+9 13:09:11 目標自稱生於西元1265年。 」")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("——我還是第一次見到來自過去的活體樣本呢。", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("有沒有可能和安妮是一樣的情況？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("完完全全不可能哦～\\n貝阿特麗切在自述中十分確定自己的死亡。", "愛衣")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("按照她的說法，導致她死亡的是一杯毒酒，而且是她自願喝下的。", "愛衣")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("雖然史料中也有類似的記錄……但我們不能排除篡改的可能性。", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣調出了另一份檢測報告。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("在中世紀，歐洲有記錄的毒藥種類不多──毒堇、顛茄、番木鱉……", "愛衣")
	await novel_interface.show_dialog("在發現她當晚所抽取的血液樣本中，確實能測出毒性生物鹼的殘留。", "愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("但第二天再檢驗的時候，那些生物鹼和重金屬殘留就幾乎消失了！", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("怪不得妳這麼激動……", "莉琉")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不不不，這還不是最關鍵的！", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣的聲音興奮得發抖。")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("與安妮不同的是，貝阿特麗切的免疫特徵完全像是新生兒，血清免疫蛋白D的檢測呈陰性。", "愛衣")
	await novel_interface.show_dialog("而且……她體內的菌群特徵與小憐幾乎一模一樣！！", "愛衣")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("……妳到底是怎麼想到檢測這些項目的？", "莉琉")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("直覺！本能！還有對異常樣本的熱愛！！", "愛衣")
	await novel_interface.show_dialog("能夠從虛無中瞬間構建出肉體……還精確保留了那個最有趣、只吸引異性的「詛咒」。", "愛衣")
	await novel_interface.show_dialog("小憐真是……太、棒、了、啊！！", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("說著，愛衣緊閉雙眼，雙手交叉抱住自己胸口，露出一副陶醉神情。")
	await novel_interface.show_text_only("莉琉不知從哪抽出一卷報告書，毫不留情地用力敲在愛衣的腦袋上。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("如果靈魂可以獨立存在於異次元空間中的話……", "莉琉")
	await novel_interface.show_dialog("那又是依據什麼來選擇，而形塑成容納靈魂的容器呢？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("是因為那個「黃金蝴蝶」嗎？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("不，如果要與安妮的球棒類比，我倒覺得應該是和那塊綠色寶石有關……", "莉琉")
	await novel_interface.show_dialog("透過某種特定物品，就能夠「召喚」出與物品相關的靈魂。", "莉琉")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("這涉及到時空轉換、物質再造……", "莉琉")
	await novel_interface.show_dialog("（絕對、絕對不能讓元老院知道這件事。）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("還得做到靈魂吸引喔……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣打斷了莉琉的思考。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("嗯？", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("從虛空中帶回特定的靈魂，並為其塑造特殊容器……妳不覺得很像煉金術中禁忌的祕法嗎。", "愛衣")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("如果不是生在現代，我恐怕會像那些煉金術士一樣，嘗試用元素和神做靈魂交易呢。", "愛衣")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("聽起來挺像那些在街頭宣揚宗教的「神之子」，不過那些玩意在新豐洲沒什麼市場。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("「神之子」啊，我倒是比較偏好「聖女」這種稱呼，聽起來就有種令人忍不住想要這個那個的禁欲感呢。", "愛衣")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……唉，我怎麼會有妳這樣的手下……", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("嘿嘿～也算是某種意義上的「靈魂吸引」吧～", "愛衣")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("——所以，就是這樣。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("哈啊！ ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("在保健室內剛完成例行檢查的我，一邊穿衣服一邊和愛衣聊到貝阿特麗切的情況。")
	await novel_interface.show_text_only("如果對她身體狀況的描述是真實的話……")
	await novel_interface.show_text_only("關於「靈魂」的說辭，聽起來完全就像是唬弄人的。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("（還有「聖女」什麼的……）\\n（雖然我曾經在遊戲裡攻略過這樣的類型……）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（但我才不想被這樣稱呼咧！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我不禁抱緊自己打了個冷顫。")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("不、不要！ ！我才不要！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("哦呀呀，妳是不是在想什麼害羞的事情啊～？", "愛衣")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒有！ 咳咳，所以……這就是最近增加檢查項目的原因嗎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("嗯～是啊～", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣看著我，露出一臉不懷好意的壞笑，似乎在盤算著什麼。")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（是她擅自增加的項目也說不定……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("可惜配套的資源還不是很齊全，暫時沒法進行更加「有趣」的檢查，唉……", "愛衣")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("啊，對了，要不要試試看給妳體內晶片的最大功率模式呀？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("不，絕對不要！ ！！", "小憐")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
