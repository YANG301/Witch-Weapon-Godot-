# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Die seltsamen Gestalten, die plötzlich auf dem Flur aufgetaucht sind, kommen schnurstracks auf uns zu.")
	await novel_interface.show_text_only("Sie sind völlig still – abgesehen vom Geräusch raschelnder Stoffe und klappernder Schritte. Müssen sie überhaupt atmen?")
	await novel_interface.show_text_only("Ich halte meine Waffe fest umklammert und bereite mich mental vor. Dann schießen starke Lichtstrahlen aus Henriettes Kampfanzug. Sie verschwindet blitzschnell aus dem Blickfeld und hinterlässt nichts als eine helle Rauchwolke.")
	await novel_interface.show_text_only("Während ich noch fassungslos war, war Heinrich bereits vor einer Person ausgewichen und schlug einer der Frauen mit der Rückseite seines Lapislazuli-Schwerts auf den Brustpanzer.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Boah, sie hat einiges drauf!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das laute, gedämpfte Geräusch, als ihre Waffe ihr Ziel trifft, hallt von den Wänden des Korridors wider. Ich schwöre, meine Brust tut weh, wenn ich es nur höre.")
	await novel_interface.show_text_only("Ihr Ziel fällt wie eine Holzpuppe zu Boden und rollt ein Stück davon.")
	await novel_interface.show_text_only("Jeder Mensch hätte sich instinktiv bewegt, um sich vor weiteren Verletzungen zu schützen – doch dieses Puppenmädchen tut nichts dergleichen.")
	await novel_interface.show_text_only("Sobald sie aufhört zu rollen, springt sie einfach auf, hat eine Beule in der Brust und alles und stürmt auf uns zu.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Henriette erkennt, dass es sich hierbei nicht um gewöhnliche Feinde handelt, dreht sie sich um und durchstößt blitzschnell die Fersen von drei von ihnen.")
	await novel_interface.show_text_only("Mit durchtrennten Sehnen sacken die drei zu Boden – und doch kriechen sie weiterhin mit unheimlich lautlosen, krampfhaften Bewegungen auf uns zu.")
	await novel_interface.show_text_only("Sie sehen auf den ersten Blick nicht besonders gruselig aus, aber die Tatsache, dass sie eindeutig nichtmenschliche Eigenschaften aufweisen, ist, gelinde gesagt, sehr beunruhigend.")
	await novel_interface.show_text_only("Sie sehen menschlich aus. Sie verhalten sich nicht menschlich. Das ist höllisch gruselig.")
	await novel_interface.show_text_only("Nachdem Raphael bestätigt hat, dass die Feinde keine Bedrohung mehr darstellen, geht sie weiter und versucht herauszufinden, was mit ihnen los ist.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Plötzlich beginnt der Boden erneut zu beben.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("Ein weiteres Erdbeben?","Henriette")
	await novel_interface.show_text_only("Dieses Mal ist das Beben stärker und dauert viel länger.")
	await novel_interface.show_text_only("Zusammen mit dem Zittern blinken auch die Lichter im Korridor und folgen einem Geräusch, das wie ein schrilles Kreischen klingt – oder vielleicht, als würde Metall daran zerrissen.")
	await novel_interface.show_text_only("Die Feinde am Boden scheinen sich in... durchsichtige Flüssigkeit zu verwandeln? Schaum? Direkt vor unseren Augen.") #换行问题
	await novel_interface.show_text_only("Anschließend beginnt die Flüssigkeit zu kochen und zu brodeln, als ob sie auf einem Teppanyaki-Brett wäre. Innerhalb von Sekunden waren die ehemals menschlich geformten Figuren zu Nichts verflüchtigt.")
	await novel_interface.show_text_only("Auf den kalten Dielen hinterlassen sie keinerlei Spuren. Es ist, als hätte es diese bizarren Mädchen nie gegeben.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Auch unsere Umgebung scheint sich nach dem Erdbeben verändert zu haben.")
	await novel_interface.show_text_only("Die Holzornamente im Archivraum sind zerfallen und nur noch in der Luft schwebendes Sägemehl geworden. Auch die Farbe an den Wänden ist abgeblättert.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("... Hä?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es ist immer noch derselbe Archivraum...")
	await novel_interface.show_text_only("Aber die Lichter sind aus. Die Fliesen auf dem Boden glänzen nicht mehr. Und die Artikel im Regal – völlig anders arrangiert.")
	await novel_interface.show_text_only("Hinter den dicken, industriell aussehenden Stahlträgern richtete eine weitere Überwachungskamera mit Geräuscherkennung ihre dunkle Linse auf uns.")
	await novel_interface.show_text_only("An der Wand hängt eine detaillierte topografische Karte der Antarktis und auf dem Schreibtisch ein Notizbuch, in dem Änderungen der atmosphärischen Daten aufgezeichnet werden.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Was... was ist das?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("War das, was wir gerade gesehen haben, eine Illusion?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Diese Puppenmädchen auch?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette blickt auf ihre Waffe – nicht blutverschmiert, obwohl es sein sollte. Dann schaut sie nach oben, wo unsere plötzlichen Angreifer scheinbar verschwunden sind.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Vielleicht war das, in dem wir uns befanden,..., nicht die reale Welt.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich wurde plötzlich von Li Tongs Stimme unterbrochen.")
	await novel_interface.show_dialog("Endlich! Eine Verbindung!","Mariru")
	await novel_interface.show_text_only("Die Stimme von Mariru dröhnt aus... in meiner Brust?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Hey, Mariru! Was ist mit dem Signal los?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru summt und klingt erschöpft. Währenddessen starrt Henriette entsetzt auf meine Brust und ist verwirrt darüber, warum die Stimme von Mariru von dort kommt.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Hey, das ist ein Missverständnis, ich schwöre!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Henriette meinen Gesichtsausdruck sieht, nickt sie, als ob sie es verstanden hätte, und beginnt, auch an ihren eigenen Brüsten herumzutasten.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(flüsternd) Hat Meister... auch meinen Körper auf diese Weise verändert?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("Natürlich nicht! Und warum hast du so ausgesehen, als wärst du davon begeistert?")
	await novel_interface.show_dialog("Hey, übrigens, warum hast du uns nicht stattdessen über das Walkie-Talkie kontaktiert?\\nIst Annie in Ordnung?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Der Kommunikationssatellit ist jetzt in Position. Annie sammelt Informationen über die Quellen von Methanlecks. Wie läuft es da drüben?","Mariru")
	await novel_interface.show_text_only("Ich versuche mein Bestes, meine Gedanken zu ordnen und alles, was uns nach dem Betreten der Basis begegnet ist, so prägnant wie möglich zu berichten.")
	await novel_interface.show_dialog("... \\n(Nicht die reale Welt, nicht wahr... )","Mariru")
	await novel_interface.show_dialog("Warte einen Moment, lass mich die Uhrzeit überprüfen.","Mariru")
	await novel_interface.show_dialog("Acht Minuten sind vergangen, seit Sie Annie das letzte Mal am Tor der Basis kontaktiert haben.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("... Nur acht Minuten?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Hätte es nicht mindestens vierzig Minuten dauern sollen?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als wäre ihm etwas klar, beginnt Mariru zu tippen.")
	await novel_interface.show_dialog("Ein Zerstörer der Lebona-Klasse, der im Antarktischen Ozean patrouilliert, hat gerade ein niederfrequentes Signal empfangen.","Mariru")
	await novel_interface.show_dialog("Ich dachte, es käme von einem Nachbeben, aber wenn man bedenkt, wie die Dinge jetzt stehen...","Mariru")
	await novel_interface.show_text_only("Mariru ruft ihr EEG-System auf und führt erneut eine Musteranalyse durch.")
	await novel_interface.show_dialog("Genau wie ich erwartet hatte...","Mariru")
	await novel_interface.show_dialog("Dieses Signal... hat das gleiche Muster wie Gehirnwellen im menschlichen REM-Schlaf...","Mariru")
	await novel_interface.show_dialog("... Aber zweiundsechzig Mal intensiver.","Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("... Machst du Witze?","Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Meinst du, wir haben gerade geträumt?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Die Zeit verlangsamt sich, wenn man träumt, das stimmt...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("Träume spiegeln Erinnerungen wider. Und was gerade passierte,..., fühlte sich tatsächlich wie eine Neukombination verschiedener Erinnerungsfragmente an.","Henriette")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn das ein Traum war, dann war es definitiv ein Albtraum...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich erinnere mich plötzlich an diesen Film, den ich gesehen habe, in dem die Charaktere Totems benutzten, um zu erkennen, ob sie in einem Traum waren oder nicht. Ich wünschte, ich hätte eines davon.")
	await novel_interface.show_dialog("... Vielleicht habt ihr nicht geträumt. Möglicherweise waren Sie im Traum eines anderen.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Der Traum von jemand anderem... ?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Das alles sind natürlich nur Spekulationen, die mich nur noch mehr verunsichern. Mir ist aufgefallen, dass es am Ende von Mariru etwas laut ist – es scheint, dass viele Leute um sie herum bei der Arbeit beschäftigt sind.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Übrigens, wie ist es mit... da draußen?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru bleibt einen Moment lang stumm, als versuche sie zu entscheiden, wie viel sie preisgeben möchte.")
	await novel_interface.show_dialog("Es ist etwas komplizierter, als wir erwartet hatten.","Mariru")
	await novel_interface.show_dialog("Der Vereinigte Kongress diskutiert derzeit darüber, wie das Problem der Methanlecks gelöst werden kann. Aber Sie wissen, wie ihre Leute sind. Mit einem solchen apokalyptischen Ereignis werden sie auf keinen Fall zurechtkommen.","Mariru")
	await novel_interface.show_dialog("Dr. Deckers von Salmonton schlug einen Plan zur Verwendung methanophiler Archaeen vor...","Mariru")
	await novel_interface.show_dialog("Aber davon ist derzeit nicht viel auf Lager, vor allem nicht die Sorte, die in der Kälte überleben kann. Und es ist zu spät, noch mehr von Grund auf zu kultivieren.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Außerdem können anaerobe Bakterien in unserer Atmosphäre nicht viel bewirken, weil Sauerstoff sie tötet.","Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Sogar Opa ist ratlos, nicht wahr...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(Ich habe keine Ahnung, wovon sie überhaupt reden... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Derzeit werden die meisten mittleren und kleinen Forschungsstationen evakuiert, die drei großen Stützpunkte in der Antarktis haben jedoch bereits ein vorübergehendes Notfallteam zusammengestellt.","Mariru")
	await novel_interface.show_dialog("Bisher wurden im südlichen Polarkreis 42 Quellen für Methanlecks identifiziert. Sechs sind bereits angezündet und Fotos dieser Seiten verbreiten sich derzeit wie ein Lauffeuer im Internet.","Mariru")
	await novel_interface.show_dialog("Und auch auf den Nachrichtensendern. Auf allen Fernsehern auf der Welt werden derzeit wahrscheinlich in Endlosschleife Aufnahmen von Flammen gezeigt, die aus Rissen in den Polareisebenen schlagen und Dutzende Meter hoch in die Höhe schießen.","Mariru")
	await novel_interface.show_dialog("Sie können das nicht länger geheim halten. Die Welt weiß es, und sie geraten offensichtlich in Panik – einige veranstalten bereits Feierlichkeiten: ein letztes Hurra, bevor die Welt untergeht.","Mariru")
	await novel_interface.show_text_only("Die Worte von Mariru sind zynisch, ihr Ton hilflos.")
	await novel_interface.show_dialog("Die austretenden Stellen konzentrieren sich in der Nähe mehrerer eisfreier Seen und im Gebiet des Mount Erebus auf Ross Island.","Mariru")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("... Berg Erebus? Das ist ein Vulkan.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was die Princess-Elisabeth-Antarctica-Forschungsstation in Ihrer Nähe betrifft, sind aufgrund der Methanlecks bereits zwei kleine Brände ausgebrochen.","Mariru")
	await novel_interface.show_dialog("Es gibt auch ein Feuer, das von einer Gruppe reicher, hirnloser Mt. Grove-Reisegruppenmitglieder gelegt wurde, die mit Flammensprühern spielten. Idioten.","Mariru")
	await novel_interface.show_dialog("Zumindest ist der Stützpunkt Snedronningen derzeit nicht in unmittelbarer Gefahr.","Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Puh…","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Schön. Zumindest besteht noch keine Gefahr, dass wir... frittiert werden.)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("... Die McMurdo-Station hat jedoch eine großflächige Lavaflussaktivität unter den Rissen festgestellt.","Mariru")
	await novel_interface.show_dialog("Der Riss in der Nähe der Snedronningen-Basis ist der markanteste, und die ihn umgebenden Eisschilde werden mit alarmierender Geschwindigkeit immer instabiler.","Mariru")
	await novel_interface.show_text_only("Ich kann nicht anders, als auf die Metallbretter unter meinen Füßen zu blicken.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Also werden wir sowieso immer noch frittiert, nicht wahr... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein plötzliches, scharfes Geräusch reißt durch die Luft. Meine Brust vibriert und das nächste, was ich weiß, ist, dass wir keine Verbindung mehr haben.") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Aus dem Boden lodernde Flammen, fließende Lava, tödlicher vulkanischer Ruß...","Henriette")
	await novel_interface.show_dialog("Es ist zu ähnlich zu dem, was vor etwa vierhundert Jahren geschah...","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Dies alles sind Vorboten des Zusammenbruchs der „Ursubstanz“.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Du meinst, was im Jahr 1600 geschah?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Das war im Siebten Teilchen, dem Land des Überflusses: dem Gouverneursbezirk von Peru.","Henriette")
	await novel_interface.show_dialog("Ich werde das Meer aus Feuer nie vergessen, den stechenden Geruch von Schwefel in der Luft...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette erinnert sich verbittert, und ich kann nicht anders, als betroffen zu sein – denn ich hatte auch eine sehr ähnliche Erfahrung.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Also... hat das alles mit dem „Einen“ zu tun, den du erwähnt hast?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette nickt.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Damals sammelten meine Freunde im Rosenkreuzer und ich drei mystische Bücher: Das Buch des Streitwagens, das Buch der Schöpfung und das Buch des Lichts.","Henriette")
	await novel_interface.show_dialog("Den Anweisungen in den Büchern folgend, vollbrachten wir die größte Errungenschaft aller Zeiten in der Alchemie: die Schaffung eines „Portals“, das uns in den karmischen Bereich bringen konnte.","Henriette")
	await novel_interface.show_dialog("Da wir naiv waren, glaubten wir ehrlich, dass das Portal uns zu einem gütigen, allsehenden Oberherrn führen würde, der uns alle Wahrheiten der Welt zeigen würde.","Henriette")
	await novel_interface.show_dialog("... Aber es gibt tatsächlich einen Grund, warum die Regeln „Geh nicht durch das Portal“ und „Suche nicht nach der Wahrheit“ existieren...","Henriette")
	await novel_interface.show_dialog("Denn sobald Sie das Portal betreten, werden Sie nie wieder den Ausweg finden.\\nUnd sobald Sie die Wahrheit erkennen, wird sie sich für immer in Ihr Gedächtnis einprägen.","Henriette")
	await novel_interface.show_dialog("Der Mensch ist nur in der Lage, Sprache zu verstehen.","Henriette")
	await novel_interface.show_dialog("Alles, was nicht mit Sprache beschrieben werden kann, liegt außerhalb unserer Reichweite.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Das ist eine Philosophie, die sich jemand im 20. Jahrhundert ausgedacht hat.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ach? Jemand ist zu dieser Schlussfolgerung gekommen, nur weil er philosophiert hat?","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Diese Person muss also große Schmerzen gehabt haben.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Sicherlich. Seine ganze Familie galt als Wahnsinnige.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Ja. Er muss ein weiser Mann gewesen sein. Allerdings dient diese Art von Weisheit lediglich dazu, Ihr Ego zu zerfressen, bis Sie ein Teil davon werden, so ängstlich, so verzweifelt.","Henriette")
	await novel_interface.show_dialog("Auch ich war einmal Teil dieses Prozesses. Und da tauchte The One vor mir auf...","Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ohne ein Wort zu sagen, ließ er mich wählen.","Henriette")
	await novel_interface.show_dialog("Möchte ich verschwinden, wie ein Tropfen im Ozean?","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Oder ein einzelner Tropfen in einer Flasche werden, der für die Ewigkeit aufbewahrt wird und als Hüter des Baumes des Lebens existiert?","Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Sie haben dich ins Visier genommen, als du der Schwächste warst...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Und der sogenannte Baum des Lebens – er ist nicht das, was sie sagen, oder?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette lächelt, ein wenig reumütig.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("... Es ist eine Art Siegel.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Die zehn Sephiroth des Baumes des Lebens fungieren als Siegel, das ein unaussprechliches Wesen – das sogar der Eine fürchtet – in Schach hält.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Ich weiß allerdings nicht genau, was dieses Wesen ist.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Vielleicht sollte ich erleichtert sein, dass ich es nicht tue.","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette macht eine Pause.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Im Krater von Enaptina, der alles auszubrennen scheint) \\n (Ich hatte einmal eine Kostprobe davon...)","Henriette")
	await novel_interface.show_dialog("Der Eine hatte nie ausdrücklich gesagt, was er wollte, aber es ist nicht schwer zu sagen, was es ist, wenn man bedenkt, wie sich unsere Erde verändert hat...","Henriette")
