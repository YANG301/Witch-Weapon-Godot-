# bathophobia_ep09.gd - 深海恐惧篇第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep09_script()

func play_script():
	pass

func bathophobia_ep09_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/liliu_observation.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("De pie en la estación de control en lo alto del banco frente a la plataforma, Mariru puede vernos en el primer piso y en la sala de observación de los senadores.")
	await novel_interface.show_text_only("Tres advertencias profundas y bajas provienen del pasillo, indicando la preparación de Mariru.")
	await novel_interface.show_text_only("Raphael saluda a Mariru. Annie y yo me quedo atentamente junto a ella.")
	await novel_interface.show_dialog("Proyecto Arca, experimento número uno.", "Mariru")
	await novel_interface.show_dialog("El escudo se desactivará en diez segundos.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("En la base del escritorio de operaciones aparece una cuenta atrás con números rojos.")
	await novel_interface.show_text_only("Se cierra la compuerta y los escalones se retraen hacia la pared.")
	await novel_interface.show_text_only("Los sonidos de engranajes chirriando provienen de la parte superior del pasillo, y el conjunto de armas automáticas escondidas en el techo apuntan al escritorio, listas para disparar en cualquier momento.")
	await novel_interface.show_text_only("Yo, como un pez en las profundidades del océano, estoy en medio de la oscuridad.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Me siento como un criminal condenado...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con tantas armas apuntándome, me siento extremadamente tenso.")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Relájate, Ren. ¡Yo te protegeré!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie también parece nerviosa... Sus dedos presionan el bate de béisbol con tanta fuerza que las uñas se ponen pálidas, pero todavía me está consolando.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, cobarde.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el momento en que el cronómetro llega a cero, Raphael rápidamente tira de la palanca.")
	await novel_interface.show_text_only("El escudo transparente que rodea la plataforma se encoge rápidamente hacia el fondo antes de desaparecer.")
	await novel_interface.show_text_only("Cuando el pilar de lapislázuli se levanta ligeramente, me invade una sensación más fuerte.")
	await novel_interface.show_text_only("Siento que mi sangre empieza a hervir, y de repente tengo un impulso inexplicable.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Ay… me duele más la barriga…)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Si pido un descanso para ir al baño, probablemente quieran matarme…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/bedstand.png")
	await novel_interface.show_text_only("El espacio de arriba tiembla de repente y un rayo de luz pasa rápidamente sobre nuestras cabezas y corre hacia el final del pasillo.")
	await novel_interface.show_text_only("Luego, dos zumbidos cortos golpean mi pecho, indicando que se inició el sistema falso.")
	await novel_interface.show_text_only("La capa de camuflaje óptico en lo alto de la sala y el cristal especialmente tratado de la sala de observación garantizan que ningún sonido se filtre a los senadores.")
	await novel_interface.show_text_only("A sus ojos, Raphael, Annie y yo deberíamos desaparecer instantáneamente junto con el Pilar de Lapislázuli.")
	await novel_interface.show_text_only("Después de eso, verán las imágenes que falsificamos.")
	await novel_interface.show_text_only("El espectáculo está en marcha. Justo en el centro del escenario, no tengo otra salida.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Hay que afrontarlo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Doy un paso adelante y con cuidado extiendo mi mano.")
	await novel_interface.show_text_only("Cuando mi mano se acerca al pilar, cierro los ojos nerviosamente y contengo la respiración \\nHasta que mis dedos tocan el pilar.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_awaitOrders.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("… ?")
	await novel_interface.show_text_only("Abro lentamente los ojos.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Parece que… no pasó nada.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Coloco toda mi palma sobre el pilar. Parece mármol.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Mmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intento con otro ángulo y le doy un fuerte empujón. \\nEl pilar, que pesa más de quince mil libras, permanece inmóvil.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¡Tsk!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se burla de mí.")
	await novel_interface.show_text_only("Que no pase nada ha sido el resultado que más deseo entre todas las suposiciones que hicimos durante la reunión preparatoria.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Pero por qué... me siento un poco avergonzado...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mientras mi mano todavía está en el pilar, la atmósfera es incómoda. Justo cuando estaba pensando en presionarlo más fuerte, mi corazón de repente se contrae bruscamente.")
	await novel_interface.show_text_only("Casi al mismo tiempo, el pilar tiembla.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Luego, el pilar se aleja de mi mano, dejando un pequeño espacio que se va ampliando lentamente.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("—¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La plataforma alta y la parte inferior del pilar chirrían, haciendo ruidos bajos y profundos...")
	await novel_interface.show_text_only("El tesoro nacional de Salmonton, un artefacto que simboliza la iluminación de los seres humanos durante el Renacimiento: el pilar de lapislázuli de Tesheim...")
	await novel_interface.show_text_only("... está colapsando lentamente hacia la dirección en la que estoy presionando...")
	await novel_interface.show_text_only("Y está cayendo cada vez más rápido.")
	await novel_interface.show_text_only("¡Boom——!!!")
	await novel_interface.show_text_only("El enorme estallido se produce cuando el pilar choca con la plataforma de metal y se rompe en dos pedazos. La pieza más alejada incluso se desliza unos centímetros hacia adelante.") #缩减符号
	await novel_interface.show_text_only("Pequeños fragmentos se esparcen y el trozo más lejano incluso rueda hacia la piscina de enfrente.")
	await novel_interface.show_text_only("Hay un largo silencio...")
	await novel_interface.show_text_only("Desde hace bastante tiempo, incluso Raphael ha perdido su arrogancia habitual y luce extremadamente sorprendida.")
	await novel_interface.show_text_only("Luego lentamente se vuelve hacia mí.")
	await novel_interface.show_text_only("Puedo ver fuego ardiendo en sus ojos.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("No, yo... yo no...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_flare.png")
	await novel_interface.show_text_only("Cuando lucho por pensar en formas de salvar mi propio trasero, el sonido de una campanilla de viento surge de la nada.")
	await novel_interface.show_text_only("Los fragmentos que yacían en el suelo se dividieron en pedazos aún más pequeños y comenzaron a flotar como hojas de papel arrastradas por una ráfaga de viento.")
	await novel_interface.show_text_only("Reflejando coloridos arcos de luz, los fragmentos del pilar forman varios anillos y flotan hacia arriba.")
	await novel_interface.show_text_only("Finalmente, todos los pedazos rotos se disipan en el aire, dejando numerosos anillos de luz flotantes que iluminan todo el salón.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Vaya...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No puedo evitar tocar un anillo formado por pequeños fragmentos—")
	await novel_interface.show_text_only("El anillo inmediatamente se rompe en puntos dorados de luz.")
	await novel_interface.show_text_only("Los puntos flotantes se dispersan como polvo.")
	await novel_interface.show_text_only("Luego, se concentran y crean una luz cada vez más deslumbrante…")
	await novel_interface.show_text_only("Desde el brillo que duele los ojos, una adolescente de cabello dorado aparece frente a mí.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("…!!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_text_only("Con los brazos abiertos, se para tranquilamente frente a mí… Pero no puedo apartar los ojos de esta glamorosa escena.")
	await novel_interface.show_text_only("Hay un leve aroma a flor de naranja y violeta en el aire.")
	await novel_interface.show_text_only("La niña abre lentamente los ojos.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Qué \"resultado\" tan intrigante y fabuloso...", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ella mira a su alrededor.")
	novel_interface.character_light()
	await novel_interface.show_dialog("¿¡Esto es… tiempo moderno!?", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("En sus ojos, una creciente emoción está reemplazando la pura confusión.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Agua y carbono, cloruro de sodio y azufre, silicio y hierro…", "Blond Girl")
	await novel_interface.show_dialog("Han creado un hermoso...", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ella mira con incredulidad sus manos temblorosas.")
	novel_interface.character_light()
	await novel_interface.show_dialog("El tacto del cuerpo...", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña siente lentamente su cuerpo de arriba a abajo.")
	await novel_interface.show_text_only("De repente me doy cuenta de que no debería mirar, así que inmediatamente me doy la vuelta.")
	await novel_interface.show_text_only("Pero no puedo evitar echarle un vistazo…")
	await novel_interface.show_text_only("¡¡Ella… incluso la está tocando… ella…!!")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Incluso esto… ¿se recrea?", "Blond Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("… ¡La luz era tan fuerte que no vi nada!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tenemos todo tipo de planes de emergencia, pero durante un tiempo ninguno de los tres sabe qué hacer a continuación.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Entonces…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La chica rubia miró a Anne y Raphael, que todavía estaban tensos, y sus ojos se posaron en mí, que parecía aburrido.")
	novel_interface.character_light()
	await novel_interface.show_dialog("¿Hiciste que este milagro sucediera?", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña aterriza lentamente en el suelo y da un paso atrás respetuosamente.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("…¿Eh? \\n(¡¡No sé dónde buscar!!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("¿O hiciste este recipiente para mi alma?", "Blond Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ja… Tal vez… ¿Sí?", "Lian")
	await novel_interface.show_text_only("Lo siento, ¡acabo de darle un pequeño empujón al pilar!")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña pone su mano sobre su pecho y me hace una leve reverencia.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Entonces, si quieres…", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ella me mira a los ojos. \\nLeí un fuerte deseo en sus ojos azules.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Por favor concédeme toda tu esencia...", "Blond Girl")
	await novel_interface.show_dialog("Maestro.", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Maestro?", "Raphael & Annie")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡¿Eeeeesencia?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Detente—!")
	await novel_interface.show_text_only("¡¡¡Detén la extraña imaginación !!!")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("“Alquimia, la búsqueda de la sabiduría de los elementos y de la vida”.", "Blond Girl")
	await novel_interface.show_dialog("El hombre capaz de reconstruir un cuerpo y convocar un alma debe poseer la verdad que Yo no poseo.", "Blond Girl")
	await novel_interface.show_dialog("Yo... Henriette Kunhardt, estoy dispuesta a ser sierva de la verdad...", "Blond Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich se detiene de repente y mira solemnemente un espacio abierto en el pasillo.")
	await novel_interface.show_text_only("Siguiendo su mirada, no veo nada más que pilares.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Espera. ¿Dijo algo sobre el sirviente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña suspira.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Encontrado tan rápido.", "Henriette")
	await novel_interface.show_dialog("Incluso con un cuerpo nuevo, sigo sujeto al contrato...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apenas ha terminado de hablar cuando la sala de repente comienza a distorsionarse mucho.")
	await novel_interface.show_text_only("Los sensores en la carcasa blindada envían alarmas de umbral todos a la vez y los indicadores de estado se vuelven rojos inmediatamente.")
	await novel_interface.show_text_only("Desde arriba se oye un ruido ensordecedor de cristales al romperse.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Dispara... Un flujo espacio-temporal...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Detrás de Heinrich aparece un espejo que gira en el sentido contrario a las agujas del reloj y parece ondas.")
	await novel_interface.show_text_only("La niña cae hacia atrás y poco a poco se sumerge en el vacío.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("¡Ren, corre!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero ya es demasiado tarde")
	novel_interface.change_background("res://assets/images/bg/Baizhu/spaceTransfer.png")
	await novel_interface.show_text_only("El espacio que nos rodea se distorsiona y gira a lo largo de numerosas superficies de espejo.")
	await novel_interface.show_text_only("—Entonces me invade la sensación de ingravidez.")
	await novel_interface.show_text_only("Cuando finalmente vuelvo en mí, me doy cuenta de que hemos estado cayendo.")
	await novel_interface.show_dialog("¡¡Aaaah—!!", "Lian")
	await novel_interface.show_text_only("Lo único que recuerdo antes de desmayarme es...")
	await novel_interface.show_text_only("¡Siento frío en el trasero con el viento y me duele más el estómago!")
	await novel_interface.show_text_only("Esto es…")
	await novel_interface.show_text_only("¡¡¡El peor día de todos!!!")
	
	print("=== 深海恐惧篇第9话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
