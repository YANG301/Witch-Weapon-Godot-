# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Milk regresa a la sala de control y bloquea la puerta principal con una silla.")
	await novel_interface.show_text_only("El grupo de enemigos más cercano llegará en cuestión de minutos. El otro grupo pronto también se encontrará con el escuadrón de Milk en el ala este.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Mmm. Debería haber pensado en esto antes...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si tuviera mi propia tropa de soldados extremadamente ágiles con un oído agudo e increíbles habilidades de autocuración...")
	await novel_interface.show_text_only("¿Por qué equiparlos con espadas y no con armas de fuego?")
	await novel_interface.show_text_only("Estos enemigos se mueven en grupos, no tienen ninguna estrategia, aunque todos son luchadores increíblemente efectivos.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Ya no pueden ser consideradas humanas, estas chicas...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk mira la fila de equipos a la izquierda del panel de control principal. Sobre él se encuentra la caja de muestras que Beth dejó.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("La misión... ya no importa.","Milk")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Supongo que las medidas estratégicas de defensa ofensiva empleadas aquí no son tan malas después de todo...","Milk")
	await novel_interface.show_dialog("Espero que el altavoz todavía funcione...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Respira hondo y se estabiliza antes de teclear una serie de comandos en el panel de control...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Mientras tanto, en el oscuro almacén, Beth revolotea por la habitación, buscando frenéticamente algo que tal vez ni siquiera esté allí.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("La contraseña... \\n¿Cuál es la contraseña?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con los dedos temblorosos, ya casi no tiene idea de qué teclas está presionando en el panel de la cerradura.")
	await novel_interface.show_text_only("Si acierta la contraseña, podrá salir del almacén y luchar junto a su amiga.")
	await novel_interface.show_text_only("Pero Milk, al otro lado del muro, no dejó ninguna pista sobre cuál podría ser la contraseña.")
	await novel_interface.show_text_only("Quizás nunca más le deje otra pista...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("¡No! ¡No!\\n¡No puedo aceptar esto! ¡No aceptaré esto!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frenética, Beth continúa golpeando la puerta con los puños, pero sus intentos de escapar son inútiles.")
	await novel_interface.show_text_only("Todo lo que puede hacer es imaginar lo que sucederá a continuación al otro lado del muro, completamente sola en el espacio oscuro, silencioso y confinado.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Por favor, no...","Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Soy un inútil...)","Beth")
	await novel_interface.show_dialog("(No puedo salvar a nadie...)","Beth")
	await novel_interface.show_dialog("(No Padre... no Leche...)","Beth")
	await novel_interface.show_dialog("(¿Cómo... sucedió esto...?)","Beth")
	await novel_interface.show_dialog("(¿Por qué soy tan débil...?)","Beth")
	await novel_interface.show_dialog("(Tan indefenso...)","Beth")
	await novel_interface.show_dialog("(... Y egoísta.)","Beth")
	await novel_interface.show_dialog("(¿Por qué?)","Beth")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("Lo único que quiero es no sentirme sola, no tener frío...")
	await novel_interface.show_text_only("No estoy pidiendo demasiado, ¿verdad...?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña está sentada sola en la oscuridad, con los hombros temblando por los sollozos.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Apenas se da cuenta de que el intenso y continuo combate ha agotado su cuerpo hasta la médula.")
	await novel_interface.show_text_only("La enfermedad de descompresión está confundiendo su cerebro.")
	await novel_interface.show_text_only("Es como si hubiera agua dando vueltas en su cabeza, alterando su conciencia poco a poco.")
	await novel_interface.show_text_only("Tal vez ella no vio que estar en el océano oscuro y profundo, después de todo...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Se siente como si estuviera encima de un glaciar; mejor dicho, dentro de uno. El hielo, afilado y denso, atraviesa su corazón, su alma.")
	await novel_interface.show_text_only("Su cuerpo flexible se congela, poco a poco, y su sangre comienza a congelarse.") #换行问题
	await novel_interface.show_text_only("Innumerables grupos de luz pura la rodearon hasta cubrir por completo su existencia.")
	await novel_interface.show_text_only("Ya no hay dolor, ya no hay soledad.")
	await novel_interface.show_text_only("No más.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("En este mundo de blanco puro, escucha una melodía familiar.")
	await novel_interface.show_dialog("... ¿Leche?","Beth")
	await novel_interface.show_text_only("Esa es su canción favorita. Su canción.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("En una explosión, cientos de orbes brillantes salen volando del cuerpo de Beth.")
	await novel_interface.show_text_only("La niña parpadea y abre los ojos. La luz blanca cegadora, con un estallido ensordecedor, ha derribado toda la pared.")
	await novel_interface.show_text_only("El altavoz de la sala de control reproduce su canción, que resuena a lo largo del túnel. Milk debe haber usado el archivo de audio que guardó en su reloj.")
	await novel_interface.show_text_only("Decenas de enemigos se han reunido atraídos por el sonido. Muchos de ellos, muchos más de los que habían contado en la pantalla.")
	await novel_interface.show_text_only("Los enemigos han rodeado la entrada de la sala de control.")
	await novel_interface.show_text_only("Beth está ahora a sólo treinta metros de la sala de control.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(Todo lo que necesito son diez segundos... no, cinco...)","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cinco segundos para llegar a su idiota mejor amiga, impedirle hacer lo que sea que vaya a hacer.")
	await novel_interface.show_text_only("Un gran grupo de soldados parásitos se abalanzó inmediatamente hacia Bai Zhu, y varias espadas afiladas atacaron repentinamente detrás de ella.")
	await novel_interface.show_text_only("Se da vuelta y dispara varias rondas de balas en forma de rayos de luz brillantes, haciendo añicos a sus objetivos en la pared.")
	await novel_interface.show_text_only("Ella continúa corriendo hacia la sala de control, su cuerpo brillando con una luz, más brillante que nunca.")
	await novel_interface.show_text_only("Las ondas de energía que irradian su cuerpo arrancan las paredes interiores del túnel. Ella brilla cegadoramente, como un réquiem de los cielos.")
	await novel_interface.show_text_only("Nadie puede detenerla ahora.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("Innumerables rayos blancos se disparan desde la base de Snedronningen, iluminando el cielo estrellado, como si el amanecer hubiera caído sobre el continente dormido.")
	await novel_interface.show_text_only("Casi como un rito de bienvenida a una deidad.")
	await novel_interface.show_text_only("De repente, todo el continente comienza a temblar...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("En apenas unos segundos, Beth ha matado a decenas de enemigos a la vez. Ella cae hacia atrás, con la visión nublada por la luz deslumbrante.")
	await novel_interface.show_text_only("El poder que surge de su cuerpo está a punto de tragársela entera.")
	await novel_interface.show_text_only("Mientras arroja a un enemigo fuera del camino con la espada en su mano derecha...")
	await novel_interface.show_text_only("Una docena de enemigos atraviesan la puerta atascada de la sala de control y entran corriendo.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Espérame... idiota...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("“Ya voy... ”")
	await novel_interface.show_text_only("¡Auge!")
	await novel_interface.show_text_only("Un gigantesco arco eléctrico sale disparado de la sala de control. Luego vienen las explosiones, innumerables explosiones de fuego en un segundo, justo frente a los ojos de Beth.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Es como si el tiempo se hubiera detenido.")
	await novel_interface.show_text_only("Se detiene en seco y cae de rodillas, a sólo unos metros de la sala de control.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("Es entonces cuando este continente helado, despiadado y frío, finalmente abre los ojos de su letargo interminable.")
	await novel_interface.show_text_only("En la oscuridad, una sombra dorada emerge de las capas de hielo subterráneas, atraviesa el suelo del túnel y atraviesa silenciosamente el torso de la niña.")
	await novel_interface.show_text_only("Es una lanza, de apariencia sencilla si no fuera por los intrincados patrones dorados que se arremolinan alrededor de la punta.")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_text_only("Una cálida corriente de calor cruzó la punta del arma, siguió el cuerpo del arma y se fusionó con la sangre.")
	await novel_interface.show_text_only("Sus brazos caen sin fuerzas a los costados. Incluso mientras sus pupilas se dilatan, ella me mira fijamente, como si aún no estuviera lista para darse por vencida.")
	await novel_interface.show_text_only("En el suelo, sangre carmesí.")
	await novel_interface.show_text_only("Goteo. Goteo. Goteo.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La brillante luz que envuelve el continente se desvanece.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
