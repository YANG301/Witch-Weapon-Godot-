# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("Что такое Душа?")
	await novel_interface.show_text_only("Форма энергии, сохраняющая сознание? Или ненаблюдаемое квантовое состояние?")
	await novel_interface.show_text_only("Или просто концепция…")
	await novel_interface.show_text_only("Точно так же, как понятие времени в физике —")
	await novel_interface.show_text_only("Может быть, это всего лишь иллюзия… сон.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Тогда вопрос —")
	await novel_interface.show_text_only("Кто такой мечтатель?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("Жгучий холод Антарктической конвергенции заглушает весь шум внешнего мира.")
	await novel_interface.show_text_only("На высоте 20 000 футов ниже уровня моря находится абиссальная зона.")
	await novel_interface.show_text_only("Глубоководная подводная лодка, завернутая в титановый прочный корпус, медленно погружается.")
	await novel_interface.show_text_only("Слабый свет, излучаемый индикатором состояния, быстро поглощается бездонной тьмой.")
	await novel_interface.show_text_only("Без света он не способен воспринимать пространство.")
	await novel_interface.show_text_only("Жуткий клыказуб пытается ударить по корпусу, но не получает ответа.")
	await novel_interface.show_text_only("Давление воды в 60 МПа является проверкой предела сжимающего напряжения корпуса.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("Внезапно одновременно включаются восемь заранее запрограммированных прожекторов, излучающих восемь прямых узких лучей света.") #换行问题
	await novel_interface.show_text_only("Словно острые мечи, прожекторы вспыхнули ослепительным светом и пронзили тьму.")
	await novel_interface.show_text_only("Луч света проходит сквозь толстые оконные стекла диспетчерской и падает на лицо спящей девушки.")
	await novel_interface.show_text_only("Длинные темно-седые волосы, сияющие голубым блеском, рассыпаются по бледному, но чистому лицу.")
	await novel_interface.show_text_only("Глубиномер на приборной панели перед девушкой перестает работать на высоте 4091 фут.")
	await novel_interface.show_text_only("Прожекторы снаружи комнаты постепенно тускнеют. Но вокруг тела девушки начинает мерцать слабый серебристый отблеск.")
	await novel_interface.show_text_only("Из глубин океана, которого так боятся люди, доносится глубокий и далекий голос.")
	await novel_interface.show_text_only("Как зов древнего монстра.")
	await novel_interface.show_text_only("Спящая девочка словно пробуждается из чрева матери.")
	await novel_interface.show_text_only("Также проснулись неконтролируемые головокружения и тошнота…")
	await novel_interface.show_text_only("Гораздо ниже безопасной глубины в 15 000 футов металлический корпус начинает издавать ненормальный треск.")
	await novel_interface.show_text_only("Из горла девушки вырывается подавленный кашель.")
	await novel_interface.show_text_only("Поначалу у нее возникают некоторые трудности с дыханием, но она быстро адаптируется к подводному давлению и выравнивает дыхание.")
	await novel_interface.show_dialog("Только что столкновение… Кажется, меня вырубило.", "Девушка")
	await novel_interface.show_dialog("Но я еще могу дышать… Кислорода должно быть достаточно.", "Девушка")
	await novel_interface.show_dialog("Я вижу свое дыхание… \\nКонечно, около 32 °F…", "Девушка")
	await novel_interface.show_dialog("Проверка системы. Готов к холодной загрузке. \\nИдентификационная информация: Бет.", "Девушка")
	await novel_interface.show_text_only("Девушку по имени Бет, похоже, не беспокоит низкая температура. Она внимательно проверяет систему.")
	await novel_interface.show_text_only("Она родилась со способностью переносить сильный холод. Когда малышку Бет нашли в зимних горах, она уже провела на льду целую ночь.")
	await novel_interface.show_text_only("Ряд медицинских обследований доказал, что чудесная девочка может адаптироваться к различным холодным условиям.")
	await novel_interface.show_text_only("В условиях сильного холода, который может привести к потере сознания взрослого человека в течение 30 секунд, температура ее тела все еще нормальная, а руки теплые.")
	await novel_interface.show_text_only("Врачи не смогли выяснить причину, прежде чем ее забрал из детского дома приемный отец.")
	await novel_interface.show_dialog("Системы освещения и тяги... штатный запуск. Перезапуск датчиков... всё в норме.", "Бет")
	await novel_interface.show_dialog("Это уже глубина 20 000 футов? «Эта штука» не может существовать под таким высоким давлением воды.", "Бет")
	await novel_interface.show_dialog("Мне нужно сэкономить силы на обратный путь… Прожекторы выключены…", "Бет")
	await novel_interface.show_text_only("Как только прожекторы выключаются, Бет смотрит в окно.")
	await novel_interface.show_dialog("Что…", "Бет")
	await novel_interface.show_text_only("От жуткой сцены у нее волосы встают дыбом.")
	await novel_interface.show_dialog("Что... это...", "Бет")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Прямо перед тем, как погасли прожекторы, за смотровым окном появляется гигантская структура, похожая на коралл.")
	await novel_interface.show_text_only("Это центростремительная тканеподобная структура. На нем сосуды неправильной формы выглядят как алый каскад, падающий в огромную черную дыру.")
	await novel_interface.show_text_only("Но никаких биологических или топографических структур во время сканирования пока обнаружено не было.")
	await novel_interface.show_text_only("Бет тут же включает широкоугольный объектив на корпусе, пытаясь увидеть более широкий обзор…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("На экране огромная и туманная тень. Его длина превышает 300 футов, и у него есть щупальца.")
	await novel_interface.show_dialog("Этого не может быть…", "Бет")
	await novel_interface.show_text_only("Это не часть пейзажа, а какое-то существо точно. Во тьме сияют красные пятна света.")
	await novel_interface.show_dialog("Это... глазное яблоко?", "Бет")
	await novel_interface.show_text_only("— Если эту странную штуку можно назвать «глазным яблоком».")
	await novel_interface.show_text_only("Черная дыра, обращенная к окну, — это зрачок глазного яблока.")
	await novel_interface.show_text_only("Это слишком близко, чтобы определить расстояние. Кажется, что корпус может втянуться в зрачок в любой момент.")
	await novel_interface.show_text_only("Красные пятна исчезают. Девушка теперь сталкивается с неизвестным объектом в молчаливой темноте.")
	await novel_interface.show_text_only("Когда ее глаза адаптируются к темноте, она видит на экране огромное глазное яблоко, излучающее слабый красный свет, словно это непрозрачная медуза.")
	await novel_interface.show_text_only("Глазное яблоко заполнено комками извилистых тканей. \\nОно бьется вместе с ее сердцем.")
	await novel_interface.show_dialog("(Расслабьтесь… расслабьтесь!) \\n(Подумайте об этом…)", "Бет")
	await novel_interface.show_text_only("Если это глазное яблоко, его хрусталик должен быть чувствителен к свету.")
	await novel_interface.show_text_only("На наружном слое глазного яблока, где должна быть сосудистая оболочка, мерцают рои белых пятен.")
	await novel_interface.show_text_only("Бет замечает, что к задней стороне глазного яблока прикреплены ветвистые щупальца.")
	await novel_interface.show_text_only("Темно-серые щупальца погружены в глубину океана, и конца им не видно.")
	await novel_interface.show_dialog("(… я не могу… пошевелиться…)", "Бет")
	await novel_interface.show_text_only("— Бет больше похожа на то, что за ней наблюдают, а не противостоят Этому Существу.")
	await novel_interface.show_text_only("Навязчивый взгляд подрывает ее спокойствие и пугает.")
	await novel_interface.show_dialog("Помогите…", "Бет")
	await novel_interface.show_text_only("— Оно все поглотит?")
	await novel_interface.show_text_only("Странное ощущение пребывания на глубине океана заставляет ее сомневаться в самом своем существовании.")
	await novel_interface.show_dialog("(Это сон…?) \\n(Просыпайся, быстро…)", "Бет")
	await novel_interface.show_text_only("Тело действует инстинктивно, прежде чем сознание успевает среагировать.")
	await novel_interface.show_text_only("Пока девушка левой рукой тянула джойстик, водолазная камера продолжала двигаться на определенное расстояние в сторону глазного яблока.")
	await novel_interface.show_text_only("Вода становится бурной, как будто Это Существо потревожено.")
	await novel_interface.show_text_only("Зрачок сужается, ожидая следующего шага девушки.")
	await novel_interface.show_dialog("Привет? Привет?", "Бет")
	await novel_interface.show_text_only("Бет хватает гарнитуру и пытается подключиться к пульту управления.")
	await novel_interface.show_text_only("Но ни одна электромагнитная волна не может покинуть эту глубину, а подводная акустическая связь на данный момент невозможна.")
	await novel_interface.show_dialog("…", "Бет")
	await novel_interface.show_text_only("Если бы она была там... Она бы кричала на меня — \\n\"Хватит приближаться!\"")
	await novel_interface.show_dialog("Ха… с чего бы мне об этом подумать…", "Бет")
	await novel_interface.show_dialog("Кто такая… «Она»?", "Бет")
	await novel_interface.show_dialog("Где… я…", "Бет")
	await novel_interface.show_text_only("Пристально глядя на гигантское глазное яблоко, Бет теряется в оцепенении. Граница между реальностью и иллюзией постепенно стирается.")
	await novel_interface.show_text_only("Она проводит рукой по приборной панели.")
	await novel_interface.show_text_only("Вскоре она находит контроллер руки робота.")
	await novel_interface.show_dialog("(Действительно ли мне нужно…)", "Бет")
	await novel_interface.show_text_only("Она собирает дыхание, но иллюзорный свет продолжает вспыхивать перед ее глазами.")
	await novel_interface.show_dialog("Взять несколько образцов... И тут же уйти...", "Бет")
	await novel_interface.show_text_only("Сначала направьте прожекторы вперед…")
	await novel_interface.show_text_only("Затем настройте двигательную установку… максимальную скорость. Направление… обратное.")
	await novel_interface.show_text_only("Пытаясь завершить предварительную настройку, девушка почти находится на грани потери сознания.")
	await novel_interface.show_dialog("Отец, это... духовное осквернение... \\nЯ почти...", "Бет")
	await novel_interface.show_text_only("Бет медленно управляет манипулятором, чтобы освободить руку робота. Обнаружена огромная игла.")
	await novel_interface.show_dialog("Режим всасывания включен… При таком давлении одного быстрого отсасывания будет достаточно…", "Бет")
	await novel_interface.show_text_only("Рука робота вытягивается вперед до тех пор, пока игла не войдет в стекловидное тело.")
	await novel_interface.show_text_only("Уровень концентрации контейнера мгновенно подскакивает от 0 до 100%.") #标点删除
	await novel_interface.show_text_only("На мгновение зрачок искажается. Если бы звук мог проникнуть сквозь корпус, она, должно быть, услышала резкий крик…")
	await novel_interface.show_dialog("(Я слышу кое-что…)", "Бет")
	await novel_interface.show_text_only("Из последних сил девушка нажимает запрограммированную кнопку исполнения.")
	await novel_interface.show_text_only("По заданной программе прожекторы проецируют в зрачок восемь интенсивных лучей света, и пропеллер начинает бешено вращаться.")
	await novel_interface.show_text_only("Глазное яблоко отступает под воздействием света, а корпус начинает оттягиваться назад и подниматься…")
	await novel_interface.show_text_only("В полном изнеможении девушка теряет сознание и падает на землю.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
