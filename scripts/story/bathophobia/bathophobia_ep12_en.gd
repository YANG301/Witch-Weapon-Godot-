# bathophobia_ep12.gd - 深海恐惧篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep12_script()

func play_script():
	pass

func bathophobia_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("To be honest, I'm not sure about the true identity of The One, because even if he lies to me, I can't tell.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("And I always wonder, even if it's all true…", "Henriette")
	await novel_interface.show_dialog("He must be a creature far superior to humans. So, why does he bother caring about us?", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Think about it. Maybe The One is no more than a naughty child of his kind, who enjoys using a magnifying glass to burn ants.", "Henriette")
	await novel_interface.show_dialog("However, the ants have no idea of what's going on. They take it as a punishment from god and prostrate themselves before the shadow behind the dazzling light.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Ha-haha…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael gives a perplexing laugh.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("I wouldn’t disagree.", "Raphael")
	await novel_interface.show_dialog("People bowed their heads and prayed to the object of prayer... The first commandment was as willful as a child.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("His intentions are still unknown, but judging from all The One's evil-doing, it's possible that he deliberately got the girls involved.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As she responds to Raphael, Heinrich turns her eyes to Annie and me.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("You mean… us?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Annie has been here before, and during the period she went missing, she was probably trapped in this space…", "Raphael")
	await novel_interface.show_dialog("Annie's identity was discovered by Rose Cross shortly after the Sky Hotel incident. Yet they presumed that she was merely a duplicate.", "Raphael")
	await novel_interface.show_dialog("They were only able to confirm her identity after the cross-checking with SID… She had gone missing for seven years.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","speechless",0.25)
	await novel_interface.show_dialog("Rose Cross… You mean Rosenkreutz?", "Henriette")
	await novel_interface.show_dialog("The secret society that I founded for academic exchange among female alchemists? It has become an intelligence agency now?", "Henriette")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("So, it seems that I've left some interesting \"legacy\".", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich lets out a preening smile and Raphael seems to have an epiphany about something.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("It all makes sense now… The greeting of Rosenkreutz, which is quite popular today, was actually a blasphemy at that time.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("May the Roses Bloom upon Your Cross.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Roses refer to female alchemists… No, not exactly. Roses stand for all females, right?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("I don't quite get it, but it seems incredibly awesome…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Anyway, The One you've been talking about… He is really a bad guy, isn't it?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Seeing Annie totally freaked out, I feel an upsurge of rage inside me.")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("How could he coerce someone into signing a contract and bring us to this strange place?", "Lian")
	await novel_interface.show_dialog("And he must have done something even more terrible to Annie…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("If I see him in person, I'm gonna kick the crap out of him!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In a sudden, a silence falls among them and they all look at me as if I were an idiot.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("What? Why are you staring at me?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("… Nothing. You just sound like an idiot.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("If you say so, Master.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hmm… Now, how can we go back?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("I'm afraid we can't. Maybe you don't feel a thing in this space, but we're now being transferred to the location of our assignment.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("What kind of assignment? Can I quit?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Simply put, I'm obliged to protect ten designated areas in the world according to the contract.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Although it's not my choice, I have to admit that… if no one does the work, there would be devastated.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("The ten areas—do they correspond to the ten circles on the \"Tree of Life\"?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael looks up at the tree-like totem in the sky. Among all the circles, one shines red.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("That location is… Yesod. It stands for the origin of all species and god's creative power. It can be seen as the \"Origin of Life”.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("I've never been there before. But once we get into this space, our destination is non-negotiable.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I guess there's no way to quit then, which suddenly reminds me of our old friend…")
	await novel_interface.show_text_only("I feel my chest for the speaker.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Weird. It has been a long time since Mariru last contacted me…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hearing what we said, Annie seems more nervous now.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("No… No, we can't stay here…", "Annie")
	await novel_interface.show_dialog("The One would swallow all of us up…", "Annie")
	await novel_interface.show_dialog("We'll never get a chance to escape…", "Annie")
	await novel_interface.show_dialog("No… Don’t!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie clutches me tight in despair, but I have no idea what to do.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Don't leave me alone…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("(We can't go on like this…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie is acting like a patient with PTSD. I've seen these symptoms before in hospitalized soldiers who used to guard the border of Ageis.")
	await novel_interface.show_text_only("Wait… Hospital… \\nI've been… hospitalized?")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Never mind. I have no time for this now…)", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Is there any way out?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich shakes her head with palms raised.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("No. To some degree, humans are no more than slaves to The One.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Take me out of here… Ren!", "Annie")
	await novel_interface.show_text_only("Annie cries and grabs my clothes tightly. Her face is already bathed in tears.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("We gotta leave here now!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As I roar with rage, the golden totem around us begins to crack.")
	await novel_interface.show_text_only("Krrr… Krrr… Krrr…")
	await novel_interface.show_text_only("It sounds like glass cracking in the void.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("??", "Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect_collapse.png")
	await novel_interface.show_text_only("In the eyes of Heinrich, the totem fragments keep falling, like falling dominoes, upon the four girls standing in the void.")
	await novel_interface.show_text_only("All the fragments vaporize as they reach the black-haired girl.")
	await novel_interface.show_text_only("The surrounding space begins to twist into fine rectangles, and then split again to form three-dimensional stripes of space.")
	await novel_interface.show_text_only("In the blink of an eye, the absolute stillness is filled with geometric shapes and the only \"ground\" under everyone's feet feels shaky as if a strong gale is blowing.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("What’s…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Fabiola/white_bg.png")
	await novel_interface.show_text_only("Before Heinrich finishes, the last piece of the totem begins to crack.")
	await novel_interface.show_text_only("All the girls fall into the depth of the void.")
	await novel_interface.show_text_only("The sudden fall has obviously startled the blonde girl. In her dilated pupils is an uncanny color—white.")
	await novel_interface.show_text_only("Pure white light.")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("At the moment when the girls disappeared, cracks appear in the almighty bullet-proof glass in front of the monitoring room. It is supposed to be able to shake off electromagnetic sniper rifle attacks.")
	await novel_interface.show_text_only("As per security protocol, the SWAT team immediately assists Senate members in evacuating the area from the backup passage they prepared in advance.")
	await novel_interface.show_text_only("Mariru, who still stays at the Ark Base, is being questioned by the Senate in front of a digital screen.")
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("The relic and the human subjects have all gone missing…", "Eloise")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Well, does that surprise you?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru says calmly through the transceiver.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("This possibility is mentioned in section three of the Spacetime Flux Simulation Report.", "Mariru")
	await novel_interface.show_dialog("If Substance H collapses, it is likely to suck in everything within a hundred-feet radius into the flux area.", "Mariru")
	await novel_interface.show_dialog("And Ren's special talent has raised the probability of Raphael and Annie being brought into the flux area.", "Mariru")
	await novel_interface.show_dialog("Although the experiment site is equipped with an insulating shield…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("It turns out that even the most advanced materials can't withstand such strong gravitation.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A brief silence sweeps across the monitoring room.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Haha… A diplomatic uproar is around the corner, my dear. How can you stay so calm?", "Bright")
	await novel_interface.show_dialog("If Dr. Dekkers knows that his cutie-pie has gone missing, how long do you think it will take before he takes revenge on us?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("No worries.", "Mariru")
	await novel_interface.show_dialog("It is not the first time Ren entered a flux area, and all the records have shown that…", "Mariru")
	await novel_interface.show_dialog("If nothing goes wrong, they'll get out of the flux area within 24 hours and appear in some random location in New Opulentia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ha… I do hope so.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("But then the experimental data may be contaminated…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("They brought recording devices along. Everything happened in that flux area would be recorded.", "Mariru")
	await novel_interface.show_dialog("That's how we used to retrieve information of flux areas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("What about the data on Substance H activation?", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The transceiver gives off a slight noise.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("It has been processed.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As the data on the digital screen begins to refresh, the Senate members gradually loosen up, except for Dr. #C.")
	await novel_interface.show_text_only("He stands there, speechless.")
	await novel_interface.show_text_only("Instead of evacuating the base with others, Dr. #C chooses to stay. Behind the terribly cracked window, he watches Mariru, standing there at the center of the experimental platform.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("What if the kitties get lost and fall into the hands of others…", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("If that really happens, we can use them to test the Ilyanthos.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Whoa, whoa, whoa… I thought you were very kind to your fellows. I guess I'm wrong then.", "#C")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Beep–")
	await novel_interface.show_text_only("Waiting in front of the monitor, Aya picks up the call immediately as the transceiver beeps.")
	await novel_interface.show_dialog("Aya, can you track the location of Ren's chip?", "Mariru")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Damn it! We lost the signal a few minutes ago.", "Ai")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Aya bites her pen and makes a disappointed tsk.")
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("That's weird. The chip is equipped with RBM, which can help us retrieve Ren’s coarse location even within a flux area. And we never lost the signal before…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("It is impossible for the satellite cluster to suddenly lose the signal. Could it be that the cutie was instantly evaporated by the high temperature...", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… It's not funny!", "Mariru")
	await novel_interface.show_text_only("On the other side of the line, Mariru raised her voice with a rare anxiety.")
	await novel_interface.show_dialog("We got some trouble here… From the camera placed down there, the last thing we see is the Lapis Pillar being torn apart by Ren.", "Mariru")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("What a butterfingers…", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Then all of a sudden, all optical, thermal and microwave imaging devices failed simultaneously.", "Mariru")
	await novel_interface.show_dialog("By the time the signals came back, the girls had all gone.", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Something terrible must have happened… Darn it! No data at all!!", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("According to our plan, Ren has to take whoever she brought back from the flux area to the exit before the optical camouflage fades away.", "Mariru")
	await novel_interface.show_dialog("(It is the only way to falsify the data of the flux area. Only then can we keep the Senate in the dark about the real abilities of Ren and Raphael.)", "Mariru")
	await novel_interface.show_dialog("We've collected two sets of data during the experiment, and one of them appeared very close to what we collected when Beatrice came back to life.", "Mariru")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("So… Does it mean the experiment was successful?", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru's voice suddenly turns cold.")
	await novel_interface.show_dialog("Although for the other set… We can’t find a single match.", "Mariru")
	await novel_interface.show_dialog("It's believed that all of them, including the person they brought back, have been sucked into the unknown area.", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Bravo!", "Ai")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Aya exclaims with joy.")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… The details have been transmitted to SID through encrypted channels.", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Ren never ceases to amaze me!", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Keep track of her.", "Mariru")
	await novel_interface.show_dialog("I need an analysis report in 30 minutes.", "Mariru")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Roger that.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On the huge screen in front of Aya, a couple of red letters show up next to where her location marker was last seen–")
	await novel_interface.show_text_only("Offline–")
	
	print("=== 深海恐惧篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
