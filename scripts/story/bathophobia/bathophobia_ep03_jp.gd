# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("マリルはスクリーンを見つめる愛衣に近付く。\\n\\n身を屈めてスクリーンを覗くと、\\nデータがひたすら更新され続けている。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("これがベアトリーチェの検査報告か？", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("はぁぁぁん――なんと素敵なサンプルッ！", "愛衣")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("しかも歴史文献と照合して割り出せば、\\nもっとファンタスティックになるよこれッ。", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("私達のデータベースでは彼女の情報を\\n一切発見できなかった。\\nまあ、戦時に欠落した空白部分が存在するし、\\nそれらは証拠足り得ないだろう。", "マリル")
	await novel_interface.show_dialog("だが彼女の口述と、\\nお前が報告してくれたデータによれば……", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルはスクリーン上にベアトリーチェの\\nプロファイルを表示させた。")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24歳かぁ……\\n色々なものが溢れ出す年齢だね～～", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルと愛衣は顔を見合わせた。\\n\\nお互いの着目点が同じである事を確認してから、\\n2人の目線は再度スクリーンに戻った。")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("これが彼女を発見した夜、実施した検査結果か？", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("体内の放射性元素は限りなくゼロに近いけど、\\n血液中の重金属の含有量は若干高いかな。", "愛衣")
	await novel_interface.show_dialog("おそらく原因は当時に使用されていた食器、\\nまたは中世の原始的な化粧品……", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("先入観に囚われた判断をしているよう思えるが？", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("なにしろ、彼女の情報をまとめた中に──", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣はスクリーン上の1つのファイルを\\nスワイプして表示した。")
	await novel_interface.show_text_only("『GMT+9 13:09:11』\\n『 目標は西暦1265年生まれと自称する』")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("──過去から来た生体サンプルを見るのは、\\n私も初めてだからね。", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("アニーと同じ状況の可能性は？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("それはないかな～～\\n\\n彼女の話を聞く限り、彼女は自らの死に\\n十分な確信を持っている。", "愛衣")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("彼女によると、死亡した原因は一杯の毒酒。\\nしかも、彼女が自ら選択して飲んだって。", "愛衣")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("歴史の資料にも似たような記録があるが、\\n……改竄された可能性は考えられる。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣はもう1つの検測報告を表示した。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("中世ヨーロッパの時代で、記録が残っている\\n毒物の種類はそこまで多くない──\\n──ドクニンジン、ベラドンナ、マチン……", "愛衣")
	await novel_interface.show_dialog("事件の夜の彼女の採血サンプルからは、\\nなんと毒性アルカロイドの残留が検出されたの。", "愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("だけど翌日に再度行った検査の結果だと、\\n彼女の血中からはアルカロイドと──\\n重金属の残留がほとんど消えてしまった。", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("どおりでお前がそんなに興奮しているわけだ……", "マリル")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("いやいやいや！一番肝心な事はそれじゃないッ！", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣の声は興奮で震えている。")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("アニーと違ってベアトリーチェの免疫系統は、\\nまるで完璧なまでの新生児なのよ！\\n免疫グロブリンDの検測結果は陰性……！", "愛衣")
	await novel_interface.show_dialog("しかも……彼女の体内にある菌群の特性は、\\nレンちゃんと高度な一致を示してる！！", "愛衣")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("……お前は一体どんな発想から、\\nその項目を検測しようと思ったんだ……", "マリル")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("直感ッ！\\n本能ッ！\\nそして異常サンプルへの\\nラブッ♡♡♡！！", "愛衣")
	await novel_interface.show_dialog("虚空から瞬時に肉体を構築……\\nさらに、あの異性を惹きつける「呪い」まで\\n精密に再現しちゃうなんて……ッ。", "愛衣")
	await novel_interface.show_dialog("レンちゃんって\\n……ほんっっっと、ワンダホーッ！！", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そう叫ぶと愛衣は目を閉じ、両手を交差して\\n自分を抱きしめながら別世界に浸り始める。")
	await novel_interface.show_text_only("マリルはどこからか取り出した報告書を丸めて、\\n手加減なしで愛衣の頭を叩いた。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("魂が異次元空間中に単独で存在できるなら……", "マリル")
	await novel_interface.show_dialog("何に基づいて、魂の器を選定したのだろうか？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("あの『黄金バタフライ』じゃない？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("いや、アニーのバットを例として考えると、\\nあのエメラルドこそ関係が深いはずだ……", "マリル")
	await novel_interface.show_dialog("ある種の物品を通じて、それに関係する「魂」を\\n「召喚」する。", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("それは時空変換、物質再構成にまで波及している\\nということだ……", "マリル")
	await novel_interface.show_dialog("（この事は絶対、元老院に悟られてはならない）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("そして　魂が引き寄せられる、ね……", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣の一言は、マリルの思考を中断させた。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("ん？", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("虚空から特定の魂を連れ戻して、その魂の器を\\n創り出す……\\nそれって錬金術の禁忌とされた秘法に、\\n類似してるかなって。", "愛衣")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("もし、この時代に生まれていなければ、\\n私も錬金術士みたいに元素を使って、\\n神と魂の取引を試みてたのかな。", "愛衣")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("街角の宗教家がたまに宣伝している\\n『神の子』のようにも聞こえるが、\\nああいった手合いは新豊洲では流行らない。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("まぁ　私は「聖女」的な呼称の方が好きだけど。\\n\\nだって、その響きって汚したくなるタブー感で\\n満載じゃない？", "愛衣")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("はぁ──どうして私の部下に、\\nお前のような人間がいるのか……", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("うふふふ～～～ある意味では、これこそが\\n「魂の引かれ合い」なんじゃないかな～～", "愛衣")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("──という訳だよ。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("はあッッ！？！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("保健室で身体検査が終わったばっかりの俺は、\\n服を着つつ愛衣とベアトリーチェに関して話す。")
	await novel_interface.show_text_only("彼女の身体状況についての説明は、\\nまだギリギリ理解できる範囲の話だけど……")
	await novel_interface.show_text_only("『魂』についての部分の話に関しては、\\n完全な嘘のようにしか聞こえない。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("（それに「聖女」ってなんだよ……）\\n\\n（ゲームでなら攻略した事あるタイプだけど）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（でも、自分にそんな設定が付くのは嫌だっ！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("思わず自分を抱きしめて身震いした。")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("や、やめてくれ！！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("あれれ～～？\\n何か恥ずかしい事、想像しているのかなぁ～～？", "愛衣")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("っていうか……\\nそれが最近検査の項目が増えた理由か？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("うん、そうよ～。", "愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣は何か考えがある様子で、意地悪く笑った。")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（愛衣が勝手に増やした項目もあるんじゃ……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("残念ながら設備が足りてなくて、\\nも～っと「楽しい」検査はできないんだけど……", "愛衣")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("あっ、そうだ。\\n\\n植え付けたチップのマキシマム・パワーモードを\\nちょっとテストしてみない？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("い、い、嫌だッ！\\nや、やめろ～！！", "小憐")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
