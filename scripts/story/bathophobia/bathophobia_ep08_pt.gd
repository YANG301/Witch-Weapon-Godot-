# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Conforme Mariru toca em seu aparelho, um estrondo profundo vem das profundezas do reservatório. O nível da água cai à medida que a eclusa subaquática se abre.")
	await novel_interface.show_text_only("Aparentemente, o reservatório tem mais de 9 metros de profundidade e a barragem tornou-se instantaneamente um penhasco.")
	await novel_interface.show_text_only("À medida que o nível da água desce, um monumento azul surge da plataforma do lado oposto da falésia.")
	await novel_interface.show_text_only("À medida que as luzes circundantes se acendem uma após a outra, a forma deste monumento é inconfundível: é o Pilar Lapis de Tesheim.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Uau…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No lado oposto há um espaço gigantesco, mais largo que um campo de futebol padrão. Fileiras de pilares, com dezenas, senão centenas de metros de altura, alinham o espaço na escuridão.")
	await novel_interface.show_text_only("A quase 300 pés de altura, as luzes do telhado mal conseguem revelar as áreas circundantes, e a extremidade permanece totalmente escura.")
	await novel_interface.show_text_only("A escala exagerada da estrutura parece assustadoramente intimidante.")
	await novel_interface.show_text_only("Os indicadores piscantes nos quatro cantos da plataforma lembram a presença de um escudo de proteção eletromagnética.")
	await novel_interface.show_text_only("Uma passarela se estende lentamente em nossa direção.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… Incrível!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso me lembra a cena de abertura de um jogo de tiro.")
	await novel_interface.show_text_only("Seguimos Mariru e caminhamos por uma escada responsiva em direção à mesa de controle.")
	await novel_interface.show_text_only("Os degraus, geralmente escondidos na parede, só aparecem quando alguém está prestes a pisar neles.")
	await novel_interface.show_text_only("A escada parece ter sido projetada para impedir que pessoas se aproximem ou saiam da mesa de controle.")
	await novel_interface.show_text_only("Olho em volta e noto algumas fendas fechadas para disparo de pequenas armas pesadas no teto.")
	await novel_interface.show_text_only("Pensando em como chegamos aqui, tento visualizar a estrutura desta enorme instalação subterrânea.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… Você deve ter investido bilhões de dólares nisso.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("A renovação não é uma tarefa fácil, mas esta é a única escolha que temos se quisermos cumprir as normas de segurança e cumprir os prazos do Project Ark.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pelos padrões de segurança, Mariru significa a capacidade de defesa contra possíveis ameaças, como bruxas poderosas, porém hostis.")
	await novel_interface.show_text_only("Para garantir a segurança das Cidades Acadêmicas, o Senado exige que essas instalações sejam capazes de gerenciar e eliminar tais ameaças.")
	await novel_interface.show_text_only("No entanto, com ameaças desconhecidas, estes padrões apenas proporcionariam, na melhor das hipóteses, almofadas psicológicas.")
	await novel_interface.show_text_only("Isto é o que Mariru disse na reunião de operação.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("O que você está esperando?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À medida que nos aproximamos da mesa de controle, ainda me sinto hesitante ao subir as escadas com mais de 9 metros de altura, embora saiba que os degraus rastrearão o movimento dos meus pés.")
	await novel_interface.show_text_only("Na plataforma em frente, o Pilar Lapis fica ali, mais alto que eu, e sustentado por quatro grandes garras.")
	await novel_interface.show_text_only("Sinto-me completamente emocionado ao ver o pilar pessoalmente. As fotos online não são nada para comparar.")
	await novel_interface.show_text_only("A superfície deste monumento turquesa translúcido está repleta de padrões inscritos de linhas finas.")
	await novel_interface.show_text_only("Parecem ser símbolos organizados em uma certa ordem lógica, mas até agora os arqueólogos não conseguiram decifrá-los.")
	await novel_interface.show_text_only("Círculos concêntricos, eixos, contornos – em vez de códigos significativos, eles parecem transmitir conceitos de forma mais direta.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Deve ser um tesouro nacional… Talvez devêssemos experimentar outros artefatos de menor importância em nosso primeiro experimento…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Hein? Com medo?", "Raphael")
	await novel_interface.show_dialog("Se você estragar tudo, você sabe o que esperar, certo?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael avisa.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Não, claro que não. Parece-me demasiado extravagante…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("OK, agora vamos desativar o escudo eletromagnético.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru puxa cuidadosamente a alavanca vermelha na mesa de controle. As luzes vermelhas nos cantos do dispositivo de proteção apagam-se todas de uma vez.")
	await novel_interface.show_text_only("Um zumbido de repente atinge meu couro cabeludo, como se uma corrente fraca passasse pelo meu cérebro.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Está tudo bem?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Pode ser a inscrição mágica, mas…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fixo meus olhos no Pilar Lapis. Algo não está certo.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Parece que seu corpo é muito sensível.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, não na frente de…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho para Raphael, que está me dando aquele olhar de “seu pervertido”.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("O que você disse é enganoso!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Para nossa segurança, repetirei as instruções de operação da blindagem eletromagnética.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru aponta para Raphael e Annie até a mesa de controle e depois se vira para mim.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(O encena??o está passando?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Existem dezenas de sensores e câmeras de espectro total nesta estação de controle e nos pilares circundantes. Eles são configurados para funcionar automaticamente quando a caixa de blindagem está aberta.", "Mariru")
	await novel_interface.show_dialog("Os dados e imagens serão enviados diretamente para a sala de observação e compartilhados com instituições de pesquisa baseadas em Salmonton após o experimento.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru pisca para mim.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Como diabos você vai…) \\n(Você obviamente preparou dados falsos…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Olho para a sala de observação no topo dos pilares adjacentes.")
	await novel_interface.show_text_only("O vidro unidirecional à prova de explosão não mostra sinais de pessoas por trás dele e apenas reflete friamente as luzes ao redor.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Esses senadores deveriam estar por trás disso…)", "Lian")
	await novel_interface.show_dialog("(Espero que possamos enganá-los…)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("A caixa de blindagem e o cais podem ser facilmente controlados com este interruptor mecânico e manivela.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Seguindo as instruções de Mariru, Annie passa por cada nó e interruptor da mesa de controle.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Faz um bom tempo que não vejo interruptores mecânicos, e uma manivela aqui... \\nPor que você usa esses aparelhos antigos?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Dispositivos mecânicos são geralmente as soluções mais estáveis. Apenas enfrente isso.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Então, antes de eu ir para a sala de comando, quer perguntar alguma coisa?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Estamos… estamos prestes a começar?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Meu coração está batendo descontroladamente. Respiro fundo algumas vezes.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Nervoso?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parecendo ter notado meu desconforto, Mariru passa o braço em minhas costas e me diz gentilmente.")
	await novel_interface.show_text_only("Esse comportamento íntimo na frente dos outros deixa meu rosto em chamas.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Um... Um pouco...", "Lian")
	await novel_interface.show_text_only("Meu coração acelera mais rápido!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Fazer um encena??o realmente não é minha praia! Quando criança, meu único papel como ator era na Cabana do Tio Tom. E eu era a cabana.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru olha para a sala de observação.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Sim?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sua respiração entorpece meu ouvido. É como se um nervo estivesse saindo da parte de trás da minha orelha, transmitindo a dormência por todo o meu corpo enquanto descia até os calcanhares.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Relaxe, os senadores não notarão nada.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru sussurra em meu ouvido.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Há uma camada de camuflagem óptica a cerca de 21 metros acima da minha cabeça.", "Mariru")
	await novel_interface.show_dialog("E o vidro da sala de observação é tratado, para que só vejam o que “deveriam” ver…", "Mariru")
	await novel_interface.show_dialog("Depois que Raphael fechar a caixa de proteção, você desaparecerá na frente deles como se tivesse entrado na área de fluxo.", "Mariru")
	await novel_interface.show_dialog("Depois disso, basta tentar tocar no Pilar Lapis. Tudo bem se você não puder chamar as bruxas como planejamos.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ouço uma risadinha e então Mariru sopra um sopro de ar em meu ouvido. \\nA coragem que acabei de notar está protestando vigorosamente novamente.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Mas, se algo ruim for revelado... \\nVocê sabe como lidar com o pior caso, certo?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eu engulo brevemente.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No momento em que os sensores atingirem o valor limite, os programas de bloqueio e destruição serão acionados…", "Lian")
	await novel_interface.show_dialog("Dentro de 5 segundos, devemos pegar o alçapão no chão à sua direita e entrar na zona de segregação subterrânea.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dou uma olhada no caminho de emergência que planejamos na reunião de operação.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Para ser mais preciso, você tem apenas 4,8 segundos.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Toda a base será instantaneamente inundada com água do mar) \\n(Sem falar no sistema de armamento acima da minha cabeça…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Mas de acordo com minha verificação de antecedentes no Pilar Lapis…", "Mariru")
	await novel_interface.show_dialog("Seu antigo proprietário era um pacifista devotado, embora fosse muito reservado e usasse vários pseudônimos.", "Mariru")
	await novel_interface.show_dialog("Então talvez seja um homem peludo de meia-idade que você possa chamar.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Se sim, deixe Raphael levá-lo de volta para Salmonton!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("De qualquer forma, segurança em primeiro lugar.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru me solta e dá um tapinha na minha cabeça.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Cuide-se... Estarei de olho em você.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Em um tom que sinaliza o início do experimento, fixo meus olhos novamente no Pilar Lapis, em pé silenciosamente na plataforma.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Teremos sucesso?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
