# bathophobia_ep26.gd - 深海恐惧症篇第26话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep26_script()

func play_script():
	pass

func bathophobia_ep26_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation1.png")
	await novel_interface.show_text_only("¿Quién soy yo?")
	await novel_interface.show_text_only("El ego ocupa la mayor parte del espacio en la conciencia humana.")
	await novel_interface.show_text_only("Todo es siempre más importante si se trata de “mí”.")
	await novel_interface.show_text_only("Mi habitación, mi laptop, mi teléfono, mi mochila, mis sentimientos, mis recuerdos...")
	await novel_interface.show_text_only("Estos conceptos son siempre más especiales para nosotros, porque nuestros cerebros los reempaquetaron meticulosamente, otorgándoles nuevos significados además de sus existencias originales.")
	await novel_interface.show_text_only("“Soy especial”. Eso es lo que tu cerebro quiere que creas.")
	await novel_interface.show_text_only("Para creer verdaderamente en algo, los humanos buscan todo tipo de pruebas.")
	await novel_interface.show_text_only("La evidencia puede provenir de los lugares más aleatorios. Artículos de revistas, exámenes, encuentros, sueños...")
	await novel_interface.show_text_only("Mientras quieras creer que algo es verdad, encontrarás la lógica que buscas dondequiera que mires.")
	await novel_interface.show_text_only("Ése es un efecto que los psicólogos llaman \"validación subjetiva\".")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Por supuesto, puedes decir: “¡Debo ser especial, siempre y cuando crea que lo soy!”")
	await novel_interface.show_text_only("Bueno, entonces aquí está la pregunta:")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation2.png")
	await novel_interface.show_text_only("¿Es tu ego siquiera real?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Los tres permanecemos en silencio mientras caminamos hacia el final del túnel después de salir de la sala de control.")
	await novel_interface.show_text_only("Henriette hace un enorme agujero en la pared, en el lugar por el que pasó el hombre que vimos en las imágenes.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Metal_Corridor.png")
	await novel_interface.show_text_only("Detrás de la pared hay un pasillo largo y estrecho, con una especie de metal amarillo firme que cubre las paredes.")
	await novel_interface.show_text_only("Incluso la turmalina sólo puede iluminar una pequeña sección en el pasaje oscuro como boca de lobo.")
	await novel_interface.show_text_only("Seguimos caminando en silencio, nuestros pasos resuenan en el pasillo. Todo es tan surrealista en este momento.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Estamos... todavía en el “sueño” de... quienquiera que sea?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Probablemente. Y es probable que la situación sea más complicada de lo que esperábamos.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia explica con expresión solemne, agitando la turmalina, que usa como linterna temporal.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("La trampa de explosión eléctrica en la sala de control debe ser “real”. El poder que liberó podría haber quemado nuestros órganos internos.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Mi traje de batalla recibió la mayor parte del daño, pero todavía duele...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Cuando soñamos, ¿no nos despertamos inmediatamente cuando experimentamos una estimulación fuerte y repentina... como el dolor?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Sí. Pero eso probablemente no se aplique en este \"sueño\". Lo más probable es que no despertemos aunque muramos.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Pero mientras uno de nosotros encuentre una manera de despertar, sin importar de qué manera, debería devolvernos a todos a la realidad.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿O simplemente seguiremos... durmiendo en esta pesadilla para siempre...?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz de Raphael tiembla. Ha estado colgando del dobladillo de mi camisa desde que entramos al pasillo.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Probablemente le tiene miedo a la oscuridad...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, mi cuerpo me alerta de un problema totalmente grave.")
	await novel_interface.show_text_only("Me aferro al reloj que trajimos desde la sala de control.")
	await novel_interface.show_text_only("Durante mis investigaciones, encontré accidentalmente información en este reloj.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("(O, en lugar de información, ¿debería decir... una grabación de audio?)","Lian")
	await novel_interface.show_dialog("Espero que podamos encontrar la respuesta que queremos, y pronto.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me obligo a caminar más rápido.")
	await novel_interface.show_text_only("Tengo que darme prisa.")
	await novel_interface.show_text_only("Porque, al fin y al cabo, cualquiera con sentido común debería saber esto...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(Cuando sueñas que estás orinando, esto generalmente significa... )\\n(¡Uf, no puede ser peor que eso!)","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Finalmente llegamos a lo que parece un laboratorio después de abrir una pesada puerta de metal.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Esto debería ser...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A diferencia de las otras áreas de la base, el laboratorio está anormalmente silencioso. Las paredes y el suelo parecen estar hechos de material fonoabsorbente.")
	await novel_interface.show_text_only("Decenas de tanques de cultivo se alzan silenciosamente en el espacio con poca luz. La única fuente de luz son las luces indicadoras de color azul pálido parpadeantes de los dispositivos.")
	await novel_interface.show_text_only("En el techo vemos toneladas de cables y tuberías, dispuestos de forma ordenada.")
	await novel_interface.show_text_only("Incluso para los altos estándares de la Academia de Ciencias New Opulentia, este es un laboratorio bastante bien equipado.")
	await novel_interface.show_text_only("Pronto localizamos el único equipo que todavía funciona...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("La temperatura en la habitación está cerca del punto de congelación. El líquido azul claro en el tanque guarda silenciosa y pacientemente a su protegido.")
	await novel_interface.show_text_only("Cabello largo azabache, piel de porcelana: la niña que duerme en lo que parece un océano azul claro es la misma que vimos en las imágenes de la cámara de vigilancia.")
	await novel_interface.show_text_only("Su piel todavía tiene color y sus extremidades se balancean naturalmente en el líquido. Una corriente de burbujas sale flotando constantemente de su máscara. Todo esto debe significar...")
	await novel_interface.show_dialog("¿Ella está... viva?","Raphael")
	await novel_interface.show_dialog("¿Y ella también está en el sueño? O...","Lian")
	await novel_interface.show_text_only("Henriette se detiene delante del tanque, aprieta el cristal con la mano y sacude la cabeza.")
	await novel_interface.show_dialog("Este dispositivo simplemente la mantiene viva, retrasando lo inevitable.","Henriette")
	await novel_interface.show_dialog("(Susurros) Extraña...","Henriette")
	await novel_interface.show_text_only("La chica rubia observa las máquinas con curiosidad y finalmente da vueltas hacia la parte trasera del tanque.")
	await novel_interface.show_dialog("Ah, tal como esperaba.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Raphael y yo la seguimos para ver que la herida de la niña todavía está presente, visible debajo de su vestido hecho jirones.")
	await novel_interface.show_text_only("Aunque es menos una herida y más una superficie limpia. Como una sección transversal.")
	await novel_interface.show_text_only("Como si lo hubieran abierto con un cuchillo de caja. La piel, los músculos, los huesos..., todos cuidadosamente dispuestos frente a nuestros ojos.")
	await novel_interface.show_text_only("Su cuerpo no parece haberse dado cuenta de esto. No se puede observar ninguna de las reacciones habituales: ni sangrado, ni hiperplasia, y la piel alrededor de la herida ni siquiera está infectada o inflamada.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("La lanza parece haber borrado incluso el concepto mismo de “lesión”. El cuerpo no tiene idea de que necesita intentar curarse.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Muchos de sus órganos y nervios han sido perforados. Ella duraría apenas unos minutos si no estuviera conectada a este dispositivo.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Aunque no puedo decir exactamente cómo sucedió esto, parece que las otras partes de su cuerpo ya deberían haberse recuperado lo suficiente como para que ella recuperara la conciencia).","Henriette")
	await novel_interface.show_dialog("(Si este es su sueño en el que estamos, tenemos que encontrar una manera de despertarla).","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, una mancha de tenue luz blanca aparece parpadeante en el cuerpo de la niña.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una sonrisa astuta se dibuja en el rostro de la chica rubia.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("(La única manera de despertar a la Bella Durmiente...)","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Maestro, compruebe su respiración allí por mí, ¿no?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ah.","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("Regreso al frente y miro a la chica en el tanque. Ella respira, sí, aunque muy lentamente.")
	await novel_interface.show_dialog("Bonita...","Lian")
	await novel_interface.show_text_only("Extiendo la mano instintivamente, los dedos me pican por tocar el tanque, pero Raphael me golpea en la espalda.")
	await novel_interface.show_dialog("Apuesto a que estás pensando en cosas pervertidas otra vez, ¿eh?","Raphael")
	await novel_interface.show_dialog("¡N-no!\\nNo soy ese tipo de persona...","Lian")
	await novel_interface.show_text_only("A través del líquido en el tanque, puedo ver a Henriette al otro lado, jugueteando con algunos cables y tuberías.")
	await novel_interface.show_dialog("(...?)","Lian")
	await novel_interface.show_dialog("¡Ella está despertando!","Henriette")
	await novel_interface.show_dialog("¡¿Eh?!","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesopen.png")
	await novel_interface.show_text_only("Después de una serie de crujidos, los ojos de la chica en el tanque se abren de golpe.")
	await novel_interface.show_text_only("Esos ojos se clavaron directamente en los míos...")
	await novel_interface.show_text_only("Un par de ojos rojos brillantes y sin emociones.")
	await novel_interface.show_text_only("Sin emociones, pero tan tentadora...")
	await novel_interface.show_text_only("De repente, un brillo plateado espumoso irradia de su cuerpo. El líquido en el tanque se hincha, formando lo que parece un remolino...")
	await novel_interface.show_text_only("Y esa chica... ¡está mirando el reloj que tengo en la mano con ojos de depredador!")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Con un fuerte crujido, el tanque se hace añicos.")
	await novel_interface.show_text_only("En una gloriosa explosión plateada, el líquido azul devora a Raphael y a mí como un tsunami.")
	await novel_interface.show_text_only("La niña ya está libre. Y a juzgar por sus ojos, me quiere muerto.")
	await novel_interface.show_text_only("Pero apenas se mueve medio centímetro antes de desplomarse como una cometa con una cuerda rota.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¡Ah, no!","Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡Explosión!")
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(¿Eh? ¿Me caí?) \\n (Me duele la cabeza...)","Lian")
	await novel_interface.show_dialog("(¿Por qué hace tanto frío? Oh, sí, el líquido del tanque... )\\n(Ni siquiera el Fire Jade puede ayudar con esa... )","Lian")
	await novel_interface.show_dialog("(Oh no, ¿ella está... sobre mí?)","Lian")
	await novel_interface.show_dialog("(Espera, si ese es el caso, lo que mis dedos están tocando es el de otra persona—)","Lian")
	await novel_interface.show_text_only("Junto a mi oído, una ráfaga de aire cálido.")
	await novel_interface.show_dialog("¡Tú!","Raphael")
	await novel_interface.show_dialog("¡Arrastrarse! ¡Pervertido! ¡Deja de tocar!","Raphael")
	await novel_interface.show_text_only("¡Golpe!")
	await novel_interface.show_text_only("Me dan un codazo (muy fuerte) en el estómago.")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Me siento en el suelo entre los muchos charcos, empapado y completamente confundido.")
	await novel_interface.show_text_only("Sí, confundido. Pero de alguna manera ya no tengo miedo.")
	await novel_interface.show_dialog("Hola? Ren, ¿me copias?","Mariru")
	await novel_interface.show_text_only("Ah. Es Mariru. Hablando desde el walkie-talkie.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru exhala aliviada cuando escucha mi respuesta cansada.")
	await novel_interface.show_dialog("¿Qué está pasando allí de todos modos? ¿Tienen idea de cuánto tiempo llevan desaparecido?\\n¡Ya nos reunimos con Annie!","Mariru")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Estamos bien, pero un poco ocupados ahora... hablaremos contigo más tarde.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apago el walkie-talkie y me vuelvo a centrar en la chica de pelo negro.")
	await novel_interface.show_text_only("Henriette se sienta a su lado, dejándola apoyarse en su hombro.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("...","Mysterious Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña abre la boca, intentando desesperadamente formar palabras, pero no sale ningún sonido.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Oye, ¿está bien?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("No te preocupes, la herida está sanando.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("¿O debería decir... su cuerpo está... resucitando?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","angry")
	await novel_interface.show_dialog("…","Mysterious Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parece estar buscando a alguien, pero no sale ningún sonido. Parece al borde de las lágrimas.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Oye, tómatelo con calma, Bethy.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intento llamarla por \"ese nombre\".")
	await novel_interface.show_text_only("La chica me mira desconcertada.")
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("¿Cómo... hiciste...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sus cuerdas vocales parecen oxidadas por el desuso.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Beth. Ese es tu nombre, ¿verdad?","Lian")
	await novel_interface.show_dialog("Eso fue lo que capté de la grabación del reloj...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica fija sus ojos en el reloj militar que tengo en la mano.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Esto pertenecía a tu amiga... ¿te acuerdas?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Coloco suavemente el reloj en su mano y cruzo sus dedos sobre él.")
	novel_interface.show_character("baizhu_normal","cry")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sus pupilas se dilatan rápidamente mientras mira el reloj. Las lágrimas brotan sin control.")
	novel_interface.show_character("baizhu_normal","tear")
	await novel_interface.show_dialog("... Leche...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Finalmente logra pronunciar correctamente el nombre. En sus ojos veo angustia, pena, frustración.")
	await novel_interface.show_text_only("Me senté junto a Bai Zhu y quise consolarla. En el momento en que toqué su hombro, la cabeza de la niña ya había caído débilmente sobre mi hombro.")
	await novel_interface.show_text_only("La frente de Beth se arruga mientras se acurruca más cerca de mí, con el reloj todavía apretado con fuerza en su mano.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("(En voz baja) Shh... está bien, ya se acabó todo.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le revuelvo el pelo suavemente.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("... Debe estar agotada.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Bueno…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Después de todo, han pasado diecinueve años.")
	
	print("=== 潜渊症篇第26话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
