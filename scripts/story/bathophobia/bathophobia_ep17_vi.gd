	await novel_interface.show_dialog("Thềm băng dưới chân chúng tôi có vẻ khá chắc chắn. Nếu trận động đất tương tự xảy ra ở một thành phố nhiệt đới đông dân, nó sẽ gây ra nhiều thiệt hại hơn.", "Đội trưởng")
	await novel_interface.show_text_only("Các thành viên trong đội nhún vai trước trận động đất quy mô nhỏ này và tiếp tục công việc của họ.")
