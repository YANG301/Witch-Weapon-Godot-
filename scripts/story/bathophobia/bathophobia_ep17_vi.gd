# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Một vùng đất ảm đạm rộng lớn vô tận—được nhuộm một màu xanh huyền bí bởi cực quang tuyệt đẹp.")
	await novel_interface.show_text_only("Một chuỗi ánh đèn pha chiếu xuyên qua bóng tối tĩnh mịch, lạnh lẽo.")
	await novel_interface.show_text_only("Họ thuộc về một đội xe trượt tuyết. Những chiếc xe tay ga lướt qua vùng đồng bằng băng bị bao phủ trong bóng tối, qua sân bay trực thăng, cuối cùng đậu ở lối vào căn cứ rộng lớn.")
	await novel_interface.show_text_only("Đứng thẳng trước mặt họ là một tượng đài có hình dạng như một cái kén. Một hộp đựng mẫu vật hạng nặng, trước đây được sử dụng để chứa các thiên thạch Mt. Grove, được gắn vào bề mặt đá của nó.")
	await novel_interface.show_text_only("Dòng chữ “Snedronningen” được sơn vô số lần xung quanh chiếc hộp, lấp lánh ánh bạc dưới ánh đèn sân khấu.")
	await novel_interface.show_text_only("Snedronningen—Nữ hoàng Trắng. Tên của căn cứ mà các tay đua đang tìm kiếm.")
	await novel_interface.show_text_only("Một thành viên trong đội mặc áo giáp dày, đi đầu, xé tấm che mặt của cô ấy.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Aaaavà chúng ta đây rồi!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theo sự dẫn dắt của cô, năm tay đua còn lại tắt động cơ và xuống xe, mỗi người lấy đồ tiếp tế tương ứng.")
	await novel_interface.show_text_only("Đây là một nhóm nghiên cứu khoa học—một nhóm trong đó tất cả các thành viên đều đã trải qua quá trình huấn luyện chiến đấu tiêu chuẩn.")
	await novel_interface.show_text_only("Các báo cáo về sóng vô tuyến do Substance H tạo ra được phát hiện ở Nam Cực hai tháng trước đã khiến nhiều phe phái tò mò đến khu vực này. Hầu hết họ đều có vũ trang.")
	await novel_interface.show_text_only("Đối với đội, điều khôn ngoan là phải thận trọng để giữ an toàn cho mẫu vật.")
	await novel_interface.show_text_only("Họ đã may mắn cho đến nay. Hành trình đến căn cứ nghiên cứu nêu trong phương án dự phòng đã diễn ra khá suôn sẻ.")
	await novel_interface.show_dialog("Được rồi. Tất cả những gì chúng ta phải làm là giao đồ cho nó.", "Thành viên đội D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Vâng.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Không giống như những người khác, được mặc những lớp áo dày và ấm áp, Beth mặc một bộ trang phục bình thường, rõ ràng không bị ảnh hưởng bởi nhiệt độ khắc nghiệt.")
	await novel_interface.show_text_only("Những vũ khí tự cải tiến của cô cũng nổi bật giữa đám đông.")
	await novel_interface.show_text_only("Cuộc hành trình của họ đã diễn ra đúng như cô mong đợi...")
	await novel_interface.show_text_only("Beth đã lao xuống vực sâu của đại dương chỉ vài giờ trước, mang về thành công các mẫu sống mà cô thu thập được từ cơ thể của một sinh vật không xác định.")
	await novel_interface.show_text_only("Để kết thúc dự án nghiên cứu, người giám sát của Milk đã cử Tàu phá băng Ushuaia đến hỗ trợ đội đặc nhiệm.")
	await novel_interface.show_text_only("Khi hộp mẫu đang được chuyển đến Ushuaia, phòng thí nghiệm sinh học trên tàu đã “vô tình” gặp sự cố mất điện.")
	await novel_interface.show_text_only("Đồng thời, Căn cứ Snedronningen, cách đó khoảng một giờ đi xe, đề nghị tạm thời cho phép nhóm lưu trữ các mẫu trong phòng thí nghiệm của họ, nơi phù hợp với tất cả các thông số kỹ thuật.")
	await novel_interface.show_text_only("Đội nhanh chóng nhận được sự cho phép vào cơ sở và được giao nhiệm vụ mang các mẫu vật đến Căn cứ Snedronningen trong vòng 90 phút.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Chúng ta đã tiến xa đến mức... )", "Beth")
	novel_interface.change_expression("stare")
