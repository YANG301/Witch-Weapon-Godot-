# bathophobia_ep03.gd - 深海恐惧篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep03_script()

func play_script():
	pass

func bathophobia_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru geht auf Aya zu und beugt sich vor, um die erfrischenden Daten auf dem Bildschirm zu lesen.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Beatrices medizinischer Bericht?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Uh-huh – eine perfekte Probe!", "Ai")
	novel_interface.change_2nd_expression("wink")
	await novel_interface.show_dialog("Und es wäre viel interessanter, wenn wir es mit historischen Aufzeichnungen vergleichen könnten.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aber keine unserer Datenbanken enthält irgendwelche ihrer Informationen. Es könnte an der durch den Krieg verursachten Datenlücke liegen.", "Mariru")
	await novel_interface.show_dialog("Dennoch, ihren Aussagen und Ihrem Bericht zufolge…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ruft das Profil von Beatrice auf dem Bildschirm auf.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("24 Jahre alt… \\nWas für ein bestes Alter!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru und Aya tauschen einen Blick aus, wissend, dass sie dasselbe bemerkt haben. Dann wenden sie sich wieder dem Bildschirm zu.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist ihr Testergebnis in der Nacht, als sie auftauchte?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("In ihrem Körper wurden praktisch keine radioaktiven Elemente gefunden. Obwohl die Schwermetallwerte in ihren Blutproben relativ hoch sind.", "Ai")
	await novel_interface.show_dialog("Es könnte etwas mit den Gebrauchsgegenständen oder groben Kosmetika im Mittelalter zu tun haben …", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sie haben also bereits eine Schlussfolgerung gezogen?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Den Aufzeichnungen ihrer Aussagen zufolge –", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya fährt mit dem Finger über eine Textzeile auf dem Bildschirm.")
	await novel_interface.show_text_only("GMT+9 13:09:11 Target gibt 1265 n. Chr. als Geburtsjahr an.")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("—Dies ist das erste Mal, dass ich eine lebende Probe aus der Antike sehe.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Könnte es bei Annie genauso sein?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Nein! \\nBeatrice sagte, sie sei zu 100 Prozent sicher, dass sie tot sei.", "Ai")
	novel_interface.change_2nd_expression("think")
	await novel_interface.show_dialog("Sie sagte, sie habe absichtlich Gift getrunken.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es gibt historische Aufzeichnungen, die dies belegen … Die Möglichkeit einer Fälschung kann jedoch nicht ausgeschlossen werden.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya klickt, um einen weiteren Testbericht zu öffnen.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Im Mittelalter sind nur wenige Gifte bekannt. Hemlocktanne, Nachtschattengewächs, Brombeerstrauch usw.", "Ai")
	await novel_interface.show_dialog("Wir fanden Rückstände giftiger Alkaloide in ihren Blutproben, die sie in der Nacht, in der sie auftauchte, entnommen hatte.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Aber in dem Blut, das wir am nächsten Tag abnahmen, gab es fast keine Spur von giftigen Alkaloiden oder Schwermetallen.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Kein Wunder, dass du so aufgeregt aussiehst ...", "Mariru")
	novel_interface.character_light(0.35,"dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Moment mal, das ist noch nicht der aufregendste Teil!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ayas Stimme zittert vor Aufregung.")
	novel_interface.show_character("ai","dizzy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Im Gegensatz zu Annie verfügt Beatrice über ein Immunsystem, das bei Neugeborenen zu finden ist. Ihr IgD-Test war negativ.", "Ai")
	await novel_interface.show_dialog("Und… die Eigenschaften des Mikrobioms in ihrem Körper sind fast die gleichen wie bei Ren!!", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("… Wie kamen Sie überhaupt auf die Idee, diese Tests zu machen?", "Mariru")
	novel_interface.character_light(0.35,"blush_dizzy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intuition. Instinkt. Und eine Leidenschaft für seltene Exemplare!!", "Ai")
	await novel_interface.show_dialog("Ein Körper, der aus dem Nichts erschaffen wurde … der den interessantesten „Fluch“ zu diesem Thema genau nachbildet – die Fähigkeit, Liebe anzuziehen.", "Ai")
	await novel_interface.show_dialog("Ren ist einfach... unglaublich!!", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als Aya das sagt, schließt sie die Augen und verschränkt die Arme, um sich selbst zu umarmen. Sie sieht ziemlich berauscht aus von ihren Gedanken.")
	await novel_interface.show_text_only("Mariru zückt eine Rolle Berichte und klopft Aya hart auf die Stirn.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Wenn eine Seele unabhängig in einer anderen Raumzeit existieren kann ...", "Mariru")
	await novel_interface.show_dialog("Wie wählt es dann einen Container aus?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush")
	await novel_interface.show_dialog("Könnte es etwas mit dem goldenen Schmetterling zu tun haben?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Nein, wenn man Annie und ihren Baseballschläger bedenkt, denke ich, dass Beatrice irgendwie mit dem grünen Edelstein verbunden ist …", "Mariru")
	await novel_interface.show_dialog("Es ist, als ob bestimmte Objekte die mit ihnen verbundenen Seelen beschwören können.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Hier geht es um Raumzeitreisen und Körpererschaffung…", "Mariru")
	await novel_interface.show_dialog("(Der Senat sollte davon nie etwas erfahren.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ren kann also sogar eine Seele anziehen ...", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya unterbricht den Gedankengang von Mariru.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Eine bestimmte Seele aus dem Nichts zu holen und einen Körper zu erschaffen, der die Seele beherbergt … Das klingt nach verbotener Alchemie.", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Wenn ich nicht in dieser Zeit gelebt hätte, hätte ich vielleicht versucht, Seelenhandel mit Göttern zu betreiben, indem ich grundlegende Elemente verwendet hätte, genau wie Alchemisten.", "Ai")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wie der sogenannte „Sohn der Götter“, der von kleinen religiösen Gruppen gefördert wird. Aber in New Opulentia gibt es dafür keinen Markt.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_think")
	await novel_interface.show_dialog("Nein, ich bevorzuge weibliche Titel wie „Göttin“. Sie geben mir diesen inneren Drang, der Abstinenz zu trotzen.", "Ai")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Meine Güte – warum um alles in der Welt habe ich jemanden wie Sie eingestellt?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Uh-huh! Vielleicht fühlen sich unsere Seelen einfach zueinander hingezogen.", "Ai")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("—Das ist also alles, was ich gefunden habe.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Hä?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Im Gesundheitszentrum spreche ich nach der regelmäßigen körperlichen Untersuchung mit Aya über Beatrice, während ich mich anziehe.")
	await novel_interface.show_text_only("Ayas Kommentar zum körperlichen Zustand von Beatrice könnte Sinn machen ...")
	await novel_interface.show_text_only("Aber die Seelentheorie klingt völliger Mist …")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("(Besonders die sogenannte „Göttin“…) \\n(Obwohl ich diese Art von Rollen einmal in Videospielen eingefangen habe)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Aber so einen Titel würde ich mir nie wünschen!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich kann nicht anders, als zitternd meine Arme um mich zu legen.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Nein, niemals!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Ooh la la, irgendetwas Unaussprechliches in deinem Kopf?", "Ai")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Also... Aus diesem Grund sind meine Check-up-Punkte gestiegen?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uh-huh.", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya zeigt ein schlaues Lächeln, als würde sie im Geheimen etwas planen.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Vielleicht handelt es sich um eine weitere nicht autorisierte Forschung …)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Schade, dass ich nicht über genügend unterstützende Ausrüstung verfüge. Ansonsten könnte ich noch mehr „interessante“ Tests machen…", "Ai")
	novel_interface.change_expression("blush_wink")
	await novel_interface.show_dialog("Möchten Sie übrigens den Maximalleistungsmodus des in Ihnen eingebauten Chips ausprobieren?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nein! Vielen Dank!!", "Lian")

	print("=== 深海恐惧篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
