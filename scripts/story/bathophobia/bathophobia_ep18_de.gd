# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Das Beben am Südpol hält nicht lange an. Die als Vorsichtsmaßnahme gegen Schneestürme errichtete Leerschicht unter der Versorgungsstation mindert wirksam die durch die Erschütterungen verursachten Schäden.")
	await novel_interface.show_text_only("In weniger als einer Minute kehrt das Land in seinen vorherigen ruhigen Zustand zurück.")
	await novel_interface.show_text_only("Ich bin an der Aegis-Grenze aufgewachsen – ein Erdbeben dieser Stärke macht mir überhaupt nichts aus.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Nur ein kleines Erdbeben. Alles klar?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ja,..., aber warum war es deine erste Reaktion, deinen Rock herunterzuhalten?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Sind Sie sicher, dass dies bei einem Erdbeben Ihre Priorität sein sollte?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Äh, nun ja... \\nEs ist nur...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Oh, komm schon, gib mir eine Pause!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Trotzdem ist es seltsam. Die Antarktis ist ein Kontinent, der schichtweise mit dickem Eis bedeckt ist. Sicherlich keine erdbebengefährdete Zone.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael runzelt die Stirn und starrt aus dem Fenster.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oder habe ich mich falsch daran erinnert?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Die neunte Sephira hat also endlich ein Problem verursacht, nicht wahr?...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Ren, schau!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie ruft plötzlich und zeigt aus dem Fenster. Ich beuge mich näher, um einen Blick darauf zu werfen.")
	await novel_interface.show_text_only("Auf der flachen Eisschicht ist ein riesiger Riss entstanden. Unter dem samtenen Himmel sieht es fast wie ein Abgrund aus, der direkt in die Hölle führt.")
	await novel_interface.show_text_only("In gewisser Weise ist es weniger ein Riss als vielmehr eine Schlucht...")
	await novel_interface.show_text_only("Am Rand der Lücke stehen einige scharfe Stacheln aufrecht. Aus den Tiefen der dicken Eisschicht ragen ungewöhnliche netzförmige Strukturen hervor.")
	await novel_interface.show_text_only("Die Eisklippen auf beiden Seiten scheinen etwa auf gleicher Höhe zu bleiben. Es ist, als hätte eine unvorstellbare Kraft das gesamte Eisgitter auseinandergerissen.")
	await novel_interface.show_text_only("Der riesige Riss schlängelt sich weiter in Richtung Hochland und verschwindet aus dem Blickfeld....")
	await novel_interface.show_text_only("Zum Glück sind wir hier im Tal. Wir sind hier in Sicherheit.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Hey, was ist das?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael und Henriette kommen näher, um zu sehen, worauf ich zeige. Sie schnappen beide nach Luft.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Warum ist dieses Gebäude... nicht betroffen?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf den Eisebenen direkt vor uns ragt ein riesiges, von Menschenhand geschaffenes Bauwerk völlig ungestört in den Weg des sich ausbreitenden Risses.")
	await novel_interface.show_text_only("Seine dunklen Mauern scheinen in diesem blassen, weißen Land fehl am Platz zu sein.")
	await novel_interface.show_text_only("Anstatt das Gebäude auseinanderzureißen, wie es hätte sein sollen, umrundete der Riss das Gebäude in Form von zwei Bögen, als ob es etwas in der Struktur gäbe, das er nicht stören wollte.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ist das der gerade erwähnte Treffpunkt Mariru?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Scheint der richtige Standort zu sein.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf dem Bedienfeld ist ein knisterndes Rauschen zu hören. Es scheint, dass die Versorgungsstation die Verbindung zur Außenwelt wieder herstellt.")
	await novel_interface.show_dialog("Hallo? Ren? Können Sie mich hören?", "Mariru")
	await novel_interface.show_text_only("Mariru klingt irgendwie nervös.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Bevor die von uns einberufene Aufklärungssatellitengruppe den Spurwechsel abgeschlossen hat, kann der grafische Feed der Antarktis nur einmal alle 35 Minuten in statischer Form aktualisiert werden.")
	await novel_interface.show_text_only("Auf dem Bildschirm erscheinen immer wieder Nachrichten mit Informationen, die Mariru von großen Polarstationen gesammelt hat.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Etwas stimmt nicht. Dieses Erdbeben... ist nicht normal.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Seltsam, ich bekomme immer noch kein Signal von den Leuten auf der Snedronningen-Basis...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru schielt auf den neuesten aktualisierten Bericht des Wettersensors am Stützpunkt Nürnberg.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Warte, ist das...?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tippt hektisch auf ihrem Handgerät herum und ruft alle meteorologischen und hydrologischen Echtzeit-Überwachungsdaten der Antarktis auf, die sie finden kann.")
	await novel_interface.show_text_only("Es ist leicht zu erkennen, dass sich die Zahlen ändern – schnell und kontinuierlich. Sie wird plötzlich an einen Kurs erinnert, den sie an der Universität belegt hat...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Sag es mir, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Hmm?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Auch ohne Berücksichtigung der Auswirkungen von Atomwaffen und Fremdkörpern lauern auf der Erde immer noch viele natürliche Faktoren, die zum „Weltuntergang“ führen können.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Natürlich. Tatsächlich tauchten die Menschen erst nach dem fünften Massensterben auf der Erde auf. Natürliche Faktoren können tatsächlich tödlich sein.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("Und wenn es um das gefährlichste Naturelement geht, das in der Antarktis zu finden ist...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Verdammt..., es ist Methan!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, bist du sicher, dass sich der Riss in deiner Nähe befindet?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ja. Aber das Seltsame ist, dass...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich übermittelte Lililiu die Information, dass der Spalt offenbar absichtlich an der Basis der Weißen Königin vorbeiging.")
	await novel_interface.show_text_only("Mariru denkt eine Weile über diese Informationen nach. Als sie das nächste Mal spricht, ist ihr Ton klar und sachlich.")
	await novel_interface.show_dialog("Hören Sie, es ist wahrscheinlich, dass das Methan, das seit Millionen von Jahren im Untergrund eingeschlossen war, derzeit aus dem Spalt austritt.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Moment,..., ja, ich weiß, dass hier Milliarden Tonnen Methan unter der Erde gelagert sind, aber... sind sie nicht fest? Wie brennbares Eis?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Möglicherweise sind sie aufgrund des Drucks, der durch das Aufreißen des Schelfeises beim Erdbeben entstanden ist, verdampft. Zumindest die exponierten Personen hatten das wahrscheinlich getan.", "Ai")
	await novel_interface.show_dialog("Nach Angaben der Sensoren der Nürnberger Basis ist der Methangehalt über der Antarktis im Vergleich zu vor einer Stunde vor dem Erdbeben um 2,1 ppm gestiegen.", "Mariru")
	await novel_interface.show_dialog("Die Zahlen unterscheiden sich bei anderen Wetterstationen, aber die Ergebnisse sind die gleichen: Es gibt dort einen dramatischen Anstieg des Methangehalts, egal aus welcher Perspektive man es betrachtet.", "Mariru")
	await novel_interface.show_dialog("Auch das Meeresgebiet in der Nähe des Amery-Schelfeises wies Auffälligkeiten auf. Wir glauben, dass das daran liegt, dass das Methangas aus dem Meeresgrund aufgequollen ist und die Gezeiten gestört haben.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Wenn ich mich richtig erinnere, ist der Treibhauseffekt von Methan einundzwanzigmal so groß wie der von Kohlendioxid...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Also... wird es heißer?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich versuche mein Bestes, mich an das zu erinnern, was ich in den Umweltschutzbroschüren gelesen habe, die wir in der Schule bekommen haben.")
	await novel_interface.show_dialog("Die Gezeiten steigen bereits, während die Windgeschwindigkeit abnimmt. Die Temperatur wird alle 12 Stunden um... 0,2 Grad steigen. Und der Anstieg wird noch eine ganze Weile anhalten.", "Mariru")
	await novel_interface.show_dialog("Das bedeutet, dass unseren Ozeanen bald Sauerstoff entzogen wird, was natürlich das gesamte Ökosystem zerstören wird. Die meisten Lebewesen auf unserem Planeten werden ausgelöscht.", "Mariru")
	await novel_interface.show_text_only("Raphael scheint endlich zu begreifen, wie ernst die Lage wirklich ist.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Also... in zwei Wochen... werden alle exponierten Pflanzen verdorren...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Und in drei Wochen werden die meisten Tiere vom Aussterben bedroht sein. 90 % der Menschen werden kein Trinkwasser haben. Selbst die Satelliten im niedrigen Erdorbit werden sich aufgrund der Veränderung unserer Atmosphäre nicht mehr so bewegen, wie sie sollten...", "Ai")
	await novel_interface.show_dialog("Innerhalb von 45 Tagen überleben nur wenige Arten – allesamt Insekten – in einer solchen Umgebung.", "Mariru")
	await novel_interface.show_dialog("Wenn wir nichts tun, und zwar schnell, werden wir bald zur Nahrung für diese Insekten.", "Ai")
	await novel_interface.show_text_only("Ich kann den Schauer nicht unterdrücken, der mir über den Rücken läuft, während ich auf den Riss starre, der zum Untergang der Menschheit führen wird.")
	await novel_interface.show_text_only("Mariru räuspert sich. Alle Anwesenden halten den Atem an und warten auf ihre Befehle.")
	await novel_interface.show_dialog("Es gibt keine Minute zu verlieren. Mit jeder Sekunde, die vergeht, verursacht der Riss immer mehr Schaden.", "Mariru")
	await novel_interface.show_dialog("Wenn wir herumsitzen und darauf warten, dass der Vereinigte Kongress sein Notfallteam schickt, ist es zu spät.", "Mariru")
	await novel_interface.show_dialog("Außerdem ist es nicht so, dass ihr Notfallteam wüsste, wie man mit so etwas umgeht...", "Mariru")
	await novel_interface.show_dialog("Also, Henriette...", "Mariru")
	await novel_interface.show_text_only("Wir alle wenden uns an den Alchemisten, der nicht allzu überrascht aussieht, als er von Mariru gerufen wurde.")
	await novel_interface.show_dialog("Wenn dies irgendwie mit der Neunten Sephira zusammenhängt, die Sie schützen sollen..., sind Sie dann jemals auf etwas gestoßen, das so schwerwiegende Auswirkungen haben könnte?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("Sehen Sie, das ist das Ärgerlichste an meinem Job!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Die blonde Alchemistin schüttelt mit einem schwachen Lächeln den Kopf, während sie in Erinnerungen schwelgt.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Der Eine teleportiert mich normalerweise einfach zum Ort des Vorfalls und lässt mich dort zurück.", "Henriette")
	await novel_interface.show_dialog("Aber wenn wir „so etwas“ da draußen lassen, ohne dass sich jemand darum kümmert, könnte die Welt genauso gut hier untergehen.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 n. Chr., Mt. Huaynaputina, in der Nähe der spanischen Kolonie>", "Henriette")
	await novel_interface.show_dialog("Ich rebellierte gegen The One und zog meine Mission um ein paar Tage hinaus. Am Ende lagen alle Dörfer im Umkreis von wenigen Kilometern völlig in Trümmern.", "Henriette")
	await novel_interface.show_text_only("Ihr Gesichtsausdruck ist unglaublich traurig.")
	await novel_interface.show_dialog("Ich habe immer noch meinen Job gemacht..., aber so viele sind gestorben. Das waren über sechzigtausend Menschenleben, die ich hätte retten können.", "Henriette")
	await novel_interface.show_dialog("Die Asche des Vulkans blieb in der Atmosphäre und blockierte über ein Jahr lang das Sonnenlicht vom Land. Das waren die kältesten Jahre dieser paar Jahrzehnte.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette schaut nach unten und will nicht weitermachen.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Diese Vulkankatastrophe in Peru am Ende des fünfzehnten Jahrhunderts, nicht wahr?...", "Ai")
	await novel_interface.show_dialog("„Das ist in der Tat eine Krise der gleichen Größenordnung.“", "Mariru")
	await novel_interface.show_dialog("Die extrem niedrigen Temperaturen, die die Welt in den folgenden Jahren heimsuchten, führten zu weltweiten Hungersnöten und Kriegen. Einige Reiche fielen in dieser Zeit sogar.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Klingt wirklich ernst...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Das war eine zu schwere Verantwortung, als dass Sie sie alleine tragen könnten.", "Mariru")
	await novel_interface.show_dialog("Ren, hast du nicht die Reisemethoden in extrem kalten Klimazonen erwähnt?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Du meinst..., du willst, dass wir rüberfahren und uns die Basis ansehen? Sehen Sie, was wir tun können, um zu helfen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Richtig. Obwohl ich nicht genau weiß, was los ist, glaube ich, dass der einzige Weg, die Situation zu retten, in der Basis selbst liegt.", "Mariru")
	await novel_interface.show_dialog("Wir müssen zumindest Daten von dort sammeln...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Aber wir können das Gebiet nicht betreten, wenn der Methangehalt dort zu hoch ist, oder?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ist dieses „Methan“, von dem Sie sprechen,..., die „brennbare Substanz“, die ich derzeit in der Luft spüre?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Obwohl ich nicht ganz sicher bin, wovon sie spricht, nicke ich trotzdem.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Dann sollte es in Ordnung sein. Tatsächlich zeigt die Dichte des brennbaren Stoffes in der Luft dort eine Abwärtsspirale.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Da drüben? Du meinst...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette muss über die Snedronningen-Basis sprechen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Außerhalb der Snedronningen-Basis>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Hallo? Annie? Kannst du uns hören?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während ich vor dem gigantischen Bauwerk stehe, das stolz in einer Welt aus Schnee und Eis aufragt, schreie ich in mein altes Walkie-Talkie, das ich mit einer Hand vor dem Wind schütze.")
	await novel_interface.show_dialog("Verstanden... Signal ist in Ordnung... \\nEin Schneesturm ist auf dem Weg... Seien Sie vorsichtig...", "Annie")
	await novel_interface.show_text_only("Die Antwort von Annie ist von statischer Aufladung und noch mehr statischer Aufladung durchsetzt.")
	await novel_interface.show_text_only("Mariru hat uns angewiesen, die Wetterdatenerfassung zu beeilen und sie so schnell wie möglich an New Opulentia zurückzusenden.")
	await novel_interface.show_text_only("Unterdessen ist, wenn man bedenkt, was Henriette uns erzählt hat, tatsächlich etwas mit dieser Basis nicht in Ordnung. Es hebt sich wirklich von seiner Umgebung ab.")
	await novel_interface.show_text_only("Ich habe es nicht gerade genossen, aber ich habe mich trotzdem an der Seite von Raphael und Henriette auf die riesige Basis gewagt und dabei meinen Rock im tosenden Wind festgehalten.")
	await novel_interface.show_text_only("Annie bleibt zurück und hält die Kommunikation zwischen uns und Mariru mit unseren alten Walkie-Talkies aufrecht.")
	await novel_interface.show_text_only("Während wir weiter stapften, konnten wir anhand unseres Gaschromatographen erkennen, dass sich tatsächlich eine besorgniserregende Menge Methangas in der Luft befand.")
	await novel_interface.show_text_only("Ich war der Ohnmacht nahe, als Raphael meine Hand ergriff.")
	await novel_interface.show_text_only("Nicht nur reichhaltig und edel, sondern auch warm und beruhigend. Ihre Anwesenheit war das Einzige, was mich am Laufen hielt.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Seien Sie nicht übermütig, ich helfe Ihnen nur, weil ich es Mariru versprochen habe.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Es ist nicht so, dass ich selbst darum gebeten hätte, okay?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nach der Erwiderung schloss ich sofort den Mund, da ich nicht den ganzen Schnee hinunterschlucken wollte.")
	await novel_interface.show_text_only("Ohne die wärmende Wirkung der Feuerjade hätte ich mich bereits in ein menschliches Eis am Stiel verwandelt.")
	await novel_interface.show_text_only("Dennoch sieht die Basis insgesamt viel fortschrittlicher aus als die Versorgungsstationen, in denen wir bisher waren.")
	await novel_interface.show_text_only("Wir überqueren die Landebahn für Starrflügler und kommen vor einem Steinmonument an.")
	await novel_interface.show_text_only("Darin ist eine Präparatebox eingelassen. Umgeben ist der Name des Stützpunkts, Snedronningen, in Blumenschrift.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... Moment, wie spricht man das aus?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Es ist finnisch. Snedronningen, Idiot.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Diese Basis mit einem Namen, den ich nicht aussprechen kann, sieht von außen schon erstaunlich groß aus – und sie ist nur die Spitze des Eisbergs. Der größte Teil der Struktur ist von oben nicht einmal sichtbar.")
	await novel_interface.show_text_only("Ich frage mich, wie viel Geld in den Bau eines so beeindruckenden Bauwerks geflossen ist, nicht weniger in der Antarktis.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Komm schon!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette geht schnell voran, bevor ich überhaupt reagieren kann.")
	await novel_interface.show_text_only("Die Alchemistin legt ihre Hand auf das elektrische Schloss neben der Tür. Anstatt es ihre Handfläche scannen zu lassen, reißt sie einfach das Ganze mitsamt Rahmen von der Wand.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Was für ein Monster ist sie?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
