# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("As Mariru taps on her handset, a deep rumble comes from the depth of the reservoir. Water level drops as the underwater sluice cracks open.")
	await novel_interface.show_text_only("Apparently, the reservoir is over 30 feet deep, and the dam has instantly become a cliff.")
	await novel_interface.show_text_only("As the water level drops, a blue monument arises from the platform on the opposite side of the cliff.")
	await novel_interface.show_text_only("As the surrounding lights snap on one after another, the shape of this monument is unmistakable: it is the Tesheim Lapis Pillar.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Wow…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On the opposite side is a gigantic space wider than a standard soccer field. Rows of pillars, tens if not hundreds of feet tall, line the space into the darkness.")
	await novel_interface.show_text_only("At nearly 300 feet high up, the roof lights can barely reveal their surrounding areas, and the far end remains pitch dark.")
	await novel_interface.show_text_only("The exaggerated scale of the structure looks nightmarishly intimidating.")
	await novel_interface.show_text_only("The indicators flashing at the four corners of the platform remind us of the presence of an electromagnetic protection shield.")
	await novel_interface.show_text_only("A walkway slowly extends itself towards us.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… Awesome!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("This reminds me of the opening scene of a shooting game.")
	await novel_interface.show_text_only("We follow Mariru and walk on a responsive stairway towards the control desk.")
	await novel_interface.show_text_only("The steps, usually hidden in the wall, only appear when someone is about to step on them.")
	await novel_interface.show_text_only("The stairway seems to be designed to prevent people from approaching or leaving the control desk.")
	await novel_interface.show_text_only("I look around and notice a couple of closed firing slits for small heavy weapons on the ceiling.")
	await novel_interface.show_text_only("Thinking back on how we get here, I try to visualize the structure of this massive underground facility.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… You must've poured billions of dollars into this.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Renovation is not an easy task, but this is the only choice we've got if we want to comply with security standards and meet deadlines for Project Ark.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("By security standards, Mariru means the capability to defend against possible threats such as powerful yet hostile witches.")
	await novel_interface.show_text_only("To ensure the security of the Academy Cities, the Senate requires these facilities to be able to manage and eliminate such threats.")
	await novel_interface.show_text_only("With unknown threats, however, these standards would just provide psychological cushions at best.")
	await novel_interface.show_text_only("This is what Mariru said at the operation meeting.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("What are you waiting for?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As we approach the control desk, I still feel hesitant stepping on the stairs hanging more than 30 feet high, even though I know the steps will trace the movement of my feet.")
	await novel_interface.show_text_only("On the platform in front, the Lapis Pillar stands there, taller than myself, and supported by four large grippers.")
	await novel_interface.show_text_only("I feel completely overwhelmed to see the pillar in person. The photos online are nothing to compare.")
	await novel_interface.show_text_only("The surface of this translucent turquoise monument is filled with inscribed patterns of thin lines.")
	await novel_interface.show_text_only("They seem to be symbols arranged in a certain logical order, but so far, archaeologists have not been able to decipher them.")
	await novel_interface.show_text_only("Concentric circles, shafts, contours—Rather than meaningful codes, they seem to be conveying concepts more directly.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("It must be a national treasure… Maybe we should try out other artifacts of less importance in our first experiment…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Huh? Frightened?", "Raphael")
	await novel_interface.show_dialog("If you screw this up, you know what to expect, right?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael warns.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("No, of course not. It just strikes me as too extravagant…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("OK, now let's deactivate the electromagnetic shield.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru neatly yanks the red lever on the control desk. The red lights at the corners of the protective device turn off all at once.")
	await novel_interface.show_text_only("A buzz suddenly strikes my scalp, as if a weak current just goes through my brain.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Everything okay?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("It might be the magic inscription, but…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I fix my eyes at the Lapis Pillar. Something isn’t right.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Looks like your body is very sensitive.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, not in front of…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I glance at Raphael, who is giving me this “you perv” look.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("What you said is misleading!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("For our safety, I'll repeat the instructions on how to operate the electromagnetic shield.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru motions Raphael and Annie to the control desk, and then turns to me.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(The show is on?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("There are dozens of sensors and full-spectrum cameras on this control station and the surrounding pillars. They are set to automatically run when the shielding case is open.", "Mariru")
	await novel_interface.show_dialog("The data and images will be directly sent to the observation room, and shared with Salmonton-based research institutions after the experiment.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru winks at me.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Like hell you will…) \\n(You've obviously prepared fake data…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I look up to the observation room on the top of adjacent pillars.")
	await novel_interface.show_text_only("The one-way explosion-proof glass shows no signs of people behind it, and just coldly reflects the surrounding lights.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Those Senators should be behind it…)", "Lian")
	await novel_interface.show_dialog("(Hope we can trick them…)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("The shielding case and the jetty can be easily controlled with this mechanical switch and hand crank.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Following Mariru's directions, Annie goes through every nob and switch of the control desk.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("I haven't seen mechanic switches for quite a while, and a crank here… \\nWhy do you use these ancient apparatus?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Mechanical devices are usually the most stable solutions. Just brave it out.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("So, before I leave for the command room, anything you wanna ask?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Are… Are we about to begin?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My heart is pounding wildly. I take a few deep breaths.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Nervous?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seeming to have noticed my unease, Mariru wraps her arm around my back and says to me gently.")
	await novel_interface.show_text_only("Such intimate behavior in front of others sets my face burning.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("A… A little bit…", "Lian")
	await novel_interface.show_text_only("My heart races faster!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Putting on a show is really not my thing! As a kid, my only acting role was in Uncle Tom's Cabin. And I was the cabin.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru glances up at the observation room.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Yes?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Her breath numbs my ear. It's like a nerve is running from the back of my ear, transmitting the numbness throughout my body as it runs down to my heels.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Relax, the Senators won't notice anything.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru whispers at my ear.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("There's a layer of optical camouflage about 70 feet above my head.", "Mariru")
	await novel_interface.show_dialog("And the glass of the observation room is treated, so they only see what they \"should\" see…", "Mariru")
	await novel_interface.show_dialog("After Raphael closes the shielding case, you'll disappear in front of them as if you've entered the flux area.", "Mariru")
	await novel_interface.show_dialog("After that, you just need to try and touch the Lapis Pillar. It's OK if you can't call out witches as we planned.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hear a giggle, and then Mariru blows a puff of air into my ear. \\nThe nerve I just noticed is vigorously protesting again.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("But, if something bad is called out… \\nYou know how to handle the worst case, right?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I gulp briefly.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The moment the sensors reach the threshold value, the blockade and destruction programs will be triggered…", "Lian")
	await novel_interface.show_dialog("Within 5 seconds, we must take the trapdoor on the floor to your right and enter the underground segregation zone.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I glance at the emergency path we planned at the operation meeting.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("To be precise, you have only 4.8 seconds.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(The whole base will instantly be flooded with sea water) \\n(Let alone the weaponry system above my head…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("But according to my background check on the Lapis Pillar…", "Mariru")
	await novel_interface.show_dialog("Its former owner was a devoted pacifist, although he was very secretive and used several aliases.", "Mariru")
	await novel_interface.show_dialog("So maybe it's a hairy middle-aged man you might call out.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("If so, just let Raphael take him back to Salmonton!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Anyway, safety first.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru lets go of me, and pats my head.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Take care of yourself… I'll be watching you.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("At a tone which signals the start of the experiment, I fixate my eyes again on the Lapis Pillar silently standing on the platform.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Will we succeed?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
