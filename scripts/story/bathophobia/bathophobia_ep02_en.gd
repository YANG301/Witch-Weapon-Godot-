# bathophobia_ep02.gd - 深海恐惧篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep02_script()

func play_script():
	pass

func bathophobia_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Beatrice died in 1290.) \\n(Her current body should be created by Ren.)", "Mariru")
	await novel_interface.show_dialog("(Building a container for the soul… This is more of a kind of god-like power.)", "Mariru")
	await novel_interface.show_dialog("(I must keep quiet about this…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Haha, interesting… \\nThat's really interesting.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("I suppose you’ve already investigated the other agent in the Sky Hotel operation. Her name is Annie Bass.", "Mariru")
	await novel_interface.show_dialog("She is one of the 50,000 people that went missing in the Light of Freedom Arena incident seven years ago.", "Mariru")
	await novel_interface.show_dialog("Ren pulled her out of another spacetime.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("You don't look surprised.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("In that case… It explains a lot.", "Eloise")
	await novel_interface.show_dialog("Letting Annie carry out operations without even an alias… It seems to me you didn’t intend to hide her from us.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("You can't actually hide such a celebrity as Annie Bass, right, Madam Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("But assigning yourself as Ren's guardian… Is there some ulterior motive at play?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Humph. Of course there is.", "Mariru")
	await novel_interface.show_dialog("I noticed Ren's special ability years ago. But since her parents planned to emigrate to Newmoridas…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("I had to take some action…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("That air crash in which her parents and brother died…", "#C")
	await novel_interface.show_dialog("Was it… you?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Hehe, I wouldn't admit it.", "Mariru")
	await novel_interface.show_dialog("I still want to be the cutie's guardian, you know.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Huh, now I see what it takes to make the head of SID. I feel much more assured!", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("For the peace and stability of New Opulentia, some sacrifices are necessary.", "Kirs")
	await novel_interface.show_dialog("Mariru and SID have always done a good job.", "Kirs")
	await novel_interface.show_dialog("So, I guess SID must have found some information about recent Spacetime Fluxes.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("According to the girl's profile, she is only 15. Would it be too risky to send her to a Flux Area?", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("It's worth the risk.", "Mariru")
	await novel_interface.show_dialog("Based on the information she collected… \\nWe believe that Spacetime Flux is the manifestation of probabilistic turbulence.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("That is, to make an extremely unlikely event happen with 100 percent certainty.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Sounds like magic!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("That's really… an ability people would die for…", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("No. This is only theoretically viable… It would require an extremely competent observer…", "Bright")
	await novel_interface.show_dialog("But such an intensity of observation is impossible, not even if we focus all human attention on it…", "Bright")
	await novel_interface.show_dialog("Unless…", "Bright")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Unless we are talking about the one who created Substance H…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Ugh—", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dr. Kirs sighs deeply. A long silence fills the room.")
	await novel_interface.show_text_only("The creator of Substance H is a topic long avoided by the scientific community.")
	await novel_interface.show_text_only("Just like the question \"who created the big bang\"—without falsifiability, it is beyond the scope of science.")
	await novel_interface.show_text_only("Just like scientists’ attempt to study distant galaxies beyond the capabilities of Hubble, which are moving faster than the speed of light away from Earth due to cosmological expansion.")
	await novel_interface.show_text_only("They believe that the observable universe is only a tiny fraction of the whole thing. We're intentionally avoiding the rest of it.")
	await novel_interface.show_text_only("The most reassuring part of science is that it shuts eyes to the unknown.")
	await novel_interface.show_text_only("If almighty observers do exist, then humans are nothing more than comet dust to them…")
	await novel_interface.show_text_only("And such a god will not bless us… Only we can save ourselves.")
	await novel_interface.show_text_only("In the dark, cold universe… Perhaps this is the most terrifying truth.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("… In summary, the Fluxional Spacetime is an incident of large-scale erratic probability collapse.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("This is triggered by summoning, from within a bounded spacetime with limited dimensions, an all-powerful observer who is beyond human comprehension.", "Mariru")
	await novel_interface.show_dialog("Spacetime Flux, as a result of probabilistic turbulence, is created when the summoner's senses are destroyed by the observer.", "Mariru")
	await novel_interface.show_dialog("But its impact can be effectively eliminated if someone can enter the Flux Area and control the summoner.", "Mariru")
	await novel_interface.show_dialog("I have tested this theory several times in Flux Areas in New Opulentia. It works.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("On the other hand, letting a Flux Area alone evaporate without any intervention will cause local entropy explosion.", "Mariru")
	await novel_interface.show_dialog("One or more psychics are highly likely to lose their sanity within the evaporation spot, causing further damages.", "Mariru")
	await novel_interface.show_dialog("So far, such insanity seems irreversible, and these psychics fit the description of witches in medieval dossiers.", "Mariru")
	await novel_interface.show_dialog("The only good news is that witches can be suppressed by conventional means after a Fluxional Spacetime evaporates.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("That’s all from me.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dead silence follows.")
	await novel_interface.show_text_only("From the other end of the encrypted communication channel, only gasps in shock break the heavy silence.")
	await novel_interface.show_text_only("Even the power elite of New Opulentia can hardly digest this information all at once.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Indeed…", "Kirs")
	await novel_interface.show_dialog("Damages caused by Spacetime Flux in New Opulentia is far less than that in other Academy Cities.", "Kirs")
	await novel_interface.show_dialog("We’ve always been giving all the credits to Aegis…", "Kirs")
	await novel_interface.show_dialog("Now I see… The girl's capability justifies absolute confidentiality.", "Kirs")
	await novel_interface.show_dialog("And Mariru is indeed the best person as her guardian.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("But can you prove what you've said?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("SID has retained all the monitoring data.", "Mariru")
	await novel_interface.show_dialog("And there have been reports of humanlike creatures found near Flux Areas who have massive destructive power and are unable to communicate.", "Mariru")
	await novel_interface.show_dialog("A similar case occurred near Johnson Substation lately.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("I believe Dr. #C has already heard about this.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru stares at the encrypted silhouette on the screen.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("The recollection of Madam Mariru stepping out of the stealth helicopter in triumph—that’s unforgettable.", "#C")
	await novel_interface.show_dialog("I have no other question if the girl named Ren is also in that helicopter.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(It seems Enzo and his men have kept their mouth shut.)", "Mariru")
	await novel_interface.show_dialog("For the same reason, I sent Ren to the Sky Hotel in case Spacetime Flux occurred in the demilitarized zone.", "Mariru")
	await novel_interface.show_dialog("I just didn't expect that someone would take away the key evidence…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("So, right from the start, you were after the Golden B…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("—Mariru was right.", "Kirs")
	await novel_interface.show_dialog("Do you know how Ren triggers her ability? Or have you tested the triggering threshold?", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Kirs quickly interrupts Bright and shifts the subject.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Huh, now you are showing your colors…)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("We haven't arranged for an experiment as we need special protective facilities.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The one on the screen sounds to be annoyed.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("For such a special resource, the Senate will definitely give you full support.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lowers her head, hiding a sly smile.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("For now, we don't know if there's any mortal danger in another spacetime.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("And even if we do bring someone—or something—back, how do we know it won't turn hostile?", "Mariru")
	await novel_interface.show_dialog("After all, there have been a lot of rumors in history blaming witches for the rise of the Black Death…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("But putting Mariru in full charge of such an exciting experiment? I don't think so…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Why not bring that Ren to my lab? \\nHahahahahaha…", "Bright")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bright lets out a buzzing roar of laughter.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("I still can't decide who should take charge of this kitten... If possible, I'd like to raise it myself~", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("As Ren's guardian, I decline all your requests.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru beams a smile.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("But—", "Mariru")
	await novel_interface.show_dialog("Since the Senate cherishes Ren so much, I'd like to make a proposal…", "Mariru")

	print("=== 深海恐惧篇第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
