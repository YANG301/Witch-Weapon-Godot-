# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Cos'è la realtà?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Forse la realtà come la conosciamo non è altro che un gioco per computer.")
	await novel_interface.show_text_only("Accedi, i personaggi si svegliano; disconnettersi e si addormentano. Quando i conti vengono chiusi, muoiono.")
	await novel_interface.show_text_only("Col passare del tempo sviluppano la percezione dell'anima.")
	await novel_interface.show_text_only("Credono che tutte quelle azioni preprogrammate siano intraprese per loro libera volontà.")
	await novel_interface.show_text_only("Formule, leggi, regole grammaticali, codici di condotta... a ogni personaggio vengono date queste regole da seguire senza sapere chi le ha create... finché non verrà finalmente liberato.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Anche se un'enorme porzione di cielo diventa pixelata a causa di un errore di rendering...")
	await novel_interface.show_text_only("Lo hanno semplicemente razionalizzato con favole o credenze religiose, invece di ammettere che va oltre la loro conoscenza.")
	await novel_interface.show_text_only("Perché accettare l'ignoto significa la possibilità più inquietante...")
	await novel_interface.show_text_only("Che la cosiddetta realtà potrebbe non essere altro che un'illusione.")
	await novel_interface.show_text_only("Un sogno irrealizzabile.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Apro gli occhi lentamente e mi ritrovo confuso.")
	await novel_interface.show_text_only("Sono circondato dalla nebbia. Stranamente, fili di gocce di pioggia sono sospesi a mezz'aria.")
	await novel_interface.show_text_only("Allungo la mano e provo a toccarli, ma evaporano immediatamente.")
	await novel_interface.show_dialog("Dove sono…", "Lian")
	await novel_interface.show_text_only("Mi trovo su una superficie solida e sento la gravità. Ma non riesco a vedere il terreno... come se la mia vista fosse assorbita nel vuoto.")
	await novel_interface.show_text_only("C'è un ronzio insolito in sottofondo. Senza alcun quadro di riferimento, le direzioni sono impercettibili.")
	await novel_interface.show_text_only("Alzo lo sguardo e vedo la sagoma di un totem simile ad un albero che fluttua in alto sopra di me.")
	await novel_interface.show_text_only("Si estende come una coltre scintillante nel cielo.")
	await novel_interface.show_text_only("Dieci anelli sul totem ruotano lentamente, uno dei quali emette un raggio rossastro.")
	await novel_interface.show_text_only("Poi un enorme disegno composto da linee e iscrizioni si dispiega sotto i miei piedi, formando quello che può essere chiamato il terreno.")
	await novel_interface.show_text_only("Il totem a terra è uguale a quello in aria, ma molto più grande visto da breve distanza.")
	await novel_interface.show_text_only("Gli anelli, ciascuno di circa 15 piedi di diametro, sono collegati in un certo ordine. Le iscrizioni su di essi sembrano antiche.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Sto... sognando?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sono stato addestrato a identificare allucinazioni e sogni...")
	await novel_interface.show_text_only("Qual è quella domanda importante, ancora una volta...")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("—Come sono arrivato qui?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I ricordi ritornano. Ero nella Base dell'Arca e tutto cominciò a cadere... Poi...")
	await novel_interface.show_text_only("No. Questo non è un sogno.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Ha qualcosa a che fare con quella ragazza?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Mi chiamava Maestro, e anche...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aww— \\nNo... non è il momento della fantasia...")
	await novel_interface.show_text_only("Dov'è Annie? E Raphael?")
	await novel_interface.show_text_only("Anche loro devono essere risucchiati in questo posto!")
	await novel_interface.show_text_only("Li cerco intorno nella nebbia. Inaspettatamente, un paio di calde braccia mi trattengono da dietro.")
	await novel_interface.show_dialog("Non preoccuparti, Maestro...", "Ragazza bionda")
	await novel_interface.show_text_only("È lei! \\nLa ragazza nuda mi abbraccia da dietro!")
	await novel_interface.show_text_only("Ho molte domande per lei. Ma esito a guardare indietro…")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Maestro... che strano!) \\n(Proprio come i tipi strani nei film di cartoni animati!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembra che stia cercando qualcosa. Le sue mani strisciano lungo la mia vita e si fermano sulla mia pancia piatta.")
	await novel_interface.show_text_only("Nel silenzio, posso sentire il mio cuore battere forte mentre il suo respiro mi solletica i capelli...")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(Cosa… farà?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah?","Ragazza bionda")
	await novel_interface.show_text_only("Sembrava aver scoperto qualcosa di interessante. Lo premette leggermente con il palmo della mano e il mio stomaco emise immediatamente un insoddisfacente suono \"gorgogliante\".")
	await novel_interface.show_text_only("In questo ambiente tranquillo, questo suono è particolarmente evidente.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Eh? Perché…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ahhhhhhh… Così imbarazzante…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi stacco da lei. Lei si avvicina a me e mi guarda con curiosità.")
	await novel_interface.show_dialog("Anche il corpo del Maestro è stato modificato? \\n... Che perfetto prodotto dell'alchimia!","Ragazza bionda")
	await novel_interface.show_text_only("Vorrei coprirmi gli occhi, ma mi sono accorto che è già vestita.")
	await novel_interface.show_text_only("Aspetta, ha appena detto che il mio corpo è stato modificato?! \\nE... cosa indossa?")
	await novel_interface.show_text_only("Basta uno sguardo al costume di Heinrich per capire il suo materiale all'avanguardia.")
	await novel_interface.show_text_only("A giudicare dalla struttura e dal design, non può essere stato realizzato nel XVI secolo... No, va addirittura oltre l'artigianato moderno.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Le informazioni di Mariru sono sbagliate?) \\n(E come fa a sapere della trasformazione del mio corpo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre provo a verbalizzare i miei pensieri, qualcuno mi dà un'improvvisa spinta all'indietro.")
	await novel_interface.show_text_only("E' Raphael. Mi afferra per il cappuccio, fa un passo avanti e si mette tra me e Heinrich.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Dimmi, chi sei?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("—Ebbene?", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich si rivolge a Raphael, con un sorriso sprezzante sul viso.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Mi stai chiedendo il mio nome? \\nNe ho centinaia.", "Ragazza bionda")
	await novel_interface.show_dialog("Ma puoi chiamarmi Henriette Khunrath: è quella sul contratto.", "Ragazza bionda")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Non è divertente!", "Raphael")
	await novel_interface.show_dialog("Heinrich è un uomo in tutti i documenti storici...", "Raphael")
	await novel_interface.show_dialog("E poi, guarda cosa indossi! \\nHai scambiato la biancheria intima per i capispalla?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Non contaminare Heinrich il grande alchimista, ragazza spudorata! Smettila di chiamare le persone “maestri” e… e di prendere l’essenza delle persone…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael arrossisce mentre parla.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… Chi diavolo sei?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre si affrontano, non ho potuto fare a meno di sbirciare Heinrich dalle spalle di Raphael.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Di che materiale è il suo costume...) \\n(Incredibile avvolgimento! Come potrebbe il suo seno tremare in direzioni diverse?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I nostri occhi si incontrano e io arrossisco subito. In preda al panico, abbasso lo sguardo sulla mia gonna, evitando un ulteriore contatto visivo.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ebbene? Pensavo che il Maestro non sarebbe rimasto colpito dal tuo capolavoro...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No no no, sono (o ero) un ragazzo…")
	await novel_interface.show_text_only("Heinrich le indica il petto.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Più grandi di prima... sono questi i gusti del Maestro?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael si volta e mi lancia uno sguardo severo.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("No! Non io! Non l'ho fatto!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ho appena rotto per sbaglio il tesoro nazionale di Salmonton...")
	await novel_interface.show_dialog("E, per favore, non chiamarmi maestro... chiamami semplicemente Ren.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Re...? \\nNon mi aspettavo che una persona eccezionale come te avesse un nome così bello...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("E tu? Sei davvero Heinrich?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esita, guarda i numeri sul polso e sospira leggermente.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sono già passati 400 anni...", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Aspetta, ha un orologio o un calendario al polso!?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Mi sono atteggiato a uomo per fare ricerche, pubblicare articoli o esercitare la professione medica.", "Henriette")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Quindi non sono sorpreso dal modo in cui la storia mi registra.", "Henriette")
	await novel_interface.show_dialog("Ai miei tempi, le università non ammettevano le ragazze e la chiesa proibiva alle donne di praticare la medicina...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Per non parlare di diventare un alchimista... Hmm, non voglio avere problemi con il tribunale religioso.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…\\n", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In qualche modo, comincio a sentirmi indignato ogni volta che apprendo dell’oppressione delle donne.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("È facile liberarsi di quei cani di corte, ma non valgono il mio tempo.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ehi... sembra fantastico...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael guarda Heinrich pensierosa.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Aspetta, come sei entrato all'università da ragazzo? \\n", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso sono curioso di sapere come è entrata. Forse...")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Mi sono semplicemente tagliato i capelli, ho falsificato diverse referenze e sono entrato all'Università di Lipsia sotto pseudonimo.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Solo un taglio di capelli?", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_text_only("Le guardo il petto. Le persone di 400 anni fa erano tutte cieche?")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Allora avevo dieci anni. L'esame di ammissione all'università era troppo facile.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sorride sdegnosamente.")
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Eh? Non importa.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Non importa come cambia il mondo, i bambini geniali sono sempre fantastici!")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Allora come spieghi questo costume?", "Raphael")
	await novel_interface.show_dialog("Heinrich era un medico e un alchimista, ma la tua armatura e la tua arma sono ovviamente per le battaglie.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich fa un passo indietro, sorridendo.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, scusa, è colpa mia.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si preme la mano destra sul petto e il costume inizia a rompersi.")
	await novel_interface.show_text_only("Il suo corpo, ora circondato da nastri blu e bianchi e cristalli colorati, comincia a brillare.")
	await novel_interface.show_text_only("Quando la luce blu e dorata inizia a svanire, il suo corpo gradualmente...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("A poco a poco... Eh?")
	await novel_interface.show_text_only("Raphael si precipita verso e mi copre strettamente gli occhi con le mani.")
	await novel_interface.show_dialog("Basta! Vedo!", "Raphael")
	await novel_interface.show_dialog("Mettiti i vestiti, esibizionista!", "Raphael")
	await novel_interface.show_dialog("C'è anche il travestitismo, cosa stai guardando!", "Raphael")
	await novel_interface.show_text_only("non ho visto niente!!")
	novel_interface.show_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Quando Raphael toglie le mani, Heinrich è già vestito di nuovo con lo stesso costume. Uffa...")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Questa è una tuta da battaglia magica, simile a quella di Master. Ma il mio è fatto da esseri superiori.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Per quanto riguarda il design... temo che The One abbia un sapore terribile...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("L'Uno?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ho realizzato la Porta di accesso a questo spazio utilizzando tecniche alchemiche.", "Henriette")
	await novel_interface.show_dialog("I mortali non dovrebbero conoscere la verità... Quindi ho dovuto pagarne il prezzo. L’Uno mi ha costretto a firmare un contratto riguardante la mia anima…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sembra un po' impotente.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Mormorando) L'ultima volta il mio corpo è stato completamente fatto a pezzi, ma il contratto poteva ancora essere attivato con un nuovo corpo...", "Henriette")
	await novel_interface.show_dialog("Perché non mi dai una pausa...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mentre mi chiedo cosa stia dicendo Heinrich, la voce tremante di Annie arriva all'improvviso dalla nebbia.")
	await novel_interface.show_dialog("Ren—", "Annie")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corriamo verso il luogo da cui proveniva la voce e troviamo Annie disteso a terra, tremante.")
	await novel_interface.show_dialog("H... Aiuto...", "Annie")
	await novel_interface.show_dialog("… Non… Per favore…", "Annie")
	await novel_interface.show_text_only("Mi sono fatto avanti velocemente per confortare Annie, e nel momento in cui la mia mano ha toccato il suo corpo...")
	await novel_interface.show_text_only("Una brezza viscosa e calda mi attraversa la mano e mi spazza rapidamente accanto.")
	await novel_interface.show_text_only("Mi guardo intorno ma non trovo nulla di strano, a parte il fatto che Heinrich mi guarda sbalordito.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Starai bene, Annie!", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Per qualche motivo, Annie sta tremando violentemente.")
	await novel_interface.show_text_only("Capisco che i luoghi sconosciuti siano motivo di preoccupazione... Ma non c'è segno di nemici nel vasto spazio vuoto.")
	await novel_interface.show_text_only("Tengo stretto Annie, cercando di consolarla.")
	await novel_interface.show_text_only("Vedendo questo, Raphael si rivolge di nuovo a Heinrich.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hai menzionato questo spazio… È il Crepaccio della Causalità?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Questo è il nome iscritto sull'Albero della Vita...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("L'albero della vita?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Perché ci hai portato qui? Cosa vuoi da noi?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich alza le spalle.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Non io.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("In effetti, non avresti potuto essere qui...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("… Senza l’intento dell’Uno… o anche da esseri più superiori.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Chi è l'Uno?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sono obbligato a non chiamarlo per nome… Ma The One ha troppi titoli…", "Henriette")
	await novel_interface.show_dialog("La Verità, la Via, la Porta...", "Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Dall'inizio... fino alla fine.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…?!", "Raphael")
	
	print("=== 深海恐惧篇第11话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
