# bathophobia_ep10.gd - 深海恐惧篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep10_script()

func play_script():
	pass

func bathophobia_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Альтернативная подводная лодка SS Deepsea скрывается в глубоких водах Антарктики.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	await novel_interface.show_text_only("Девушка в белом платье стоит перед Центральной диспетчерской.")
	await novel_interface.show_dialog("Требуется удостоверение личности посетителя —", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Запиши, Бет.", "Бет")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Девушка выглядит немного уставшей, но стоит прямо, ее длинные мокрые волосы свободно падают на спину…")
	await novel_interface.show_text_only("Она здесь, уверенная в себе, уверенная и гордая.")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Пожалуйста, подтвердите токен безопасности —", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Кеши0415-З.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вход в систему… Режим сканирования включен.", "System")
	await novel_interface.show_text_only("Восемь лучей света, исходящие из стены прохода, начинают сканировать Бет.")
	await novel_interface.show_text_only("По другую сторону усиленной защитной двери группа людей взволнованно наблюдает за происходящим через смотровое окно.")
	await novel_interface.show_text_only("Среди них девушка с каштановыми волосами — подруга Бет Сильвия.")
	await novel_interface.show_text_only("Но она предпочитает, чтобы ее называли Милк, ее кодовое имя.")
	await novel_interface.show_text_only("Лицо Бет смягчается, когда их взгляды встречаются через окно.")
	await novel_interface.show_dialog("Сканирование завершено. Шестизначный пароль, пожалуйста—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет ясно помнит, что до ее ухода такой процедуры проверки не существовало.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(… Ха, они снова подстроили систему безопасности.)", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как внешний эксперт, Бет привыкла к такого рода озорным тестам.")
	await novel_interface.show_text_only("Она является консультантом Отряда, состоящего из высших офицеров армии, но реального боевого опыта не имеет.")
	await novel_interface.show_text_only("А поскольку эта операция связана с экстремальными условиями, консультант также обладает временными полномочиями по принятию стратегических решений.")
	await novel_interface.show_text_only("Это слишком распространенное явление, чтобы его подвергать сомнению, хотя она известна как гений в своей профессиональной области…")
	await novel_interface.show_text_only("Она сможет вписаться, только проявив себя.")
	await novel_interface.show_text_only("Бет очень ясно говорит об этом.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Цифровой пароль… \\nДавно такого не видел.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Взгляд Бай Яня скользнул по молоку за смотровым окном.")
	await novel_interface.show_text_only("Руки прижались к окну, Милк корчит ей рожицы.")
	await novel_interface.show_text_only("Со стороны Бет она могла видеть, как Милк смотрит на табличку за защитной дверью.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_text_only("Номер двери…? \\nZ-100485.")
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Не все так просто…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет вводит шесть цифр как есть.")
	await novel_interface.show_text_only("После долгого гудения дверь остается закрытой.")
	await novel_interface.show_dialog("Неправильный пароль. Первое предупреждение—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("… Я знал это.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("За исключением Милк, возможно, все остальные с нетерпением ждут ее провала.")
	await novel_interface.show_text_only("Бет вздыхает, увидев злорадную улыбку Милка.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Еще одна кодовая игра?", "Бет")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("За смотровым окном стоит группа людей и наблюдает за ней с оттенком удовольствия.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Как вы думаете, сколько времени ей понадобится на этот раз?", "Член отряда А")
	await novel_interface.show_dialog("Существует специальный модуль для предотвращения атаки методом перебора. Расшифровка программ не поможет!", "Член отряда C")
	await novel_interface.show_dialog("О, и Милк, не намекай ей!", "Член отряда Б")
	await novel_interface.show_text_only("Пальцы Милк послушно скользят по ее рту.")
	await novel_interface.show_dialog("Тогда я бы сказал… 60 секунд.", "Член отряда D")
	await novel_interface.show_dialog("Это слишком быстро даже для гения… \\nДержу пари, что минимум десять минут!", "Член отряда C")
	await novel_interface.show_dialog("Не смотри свысока на Бет и эту девушку…", "Член отряда А")
	await novel_interface.show_text_only("Высокий член отряда А гладит Милка по голове сзади.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Да ладно, вы все просмотрели измененный код!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но если это Бет… она обязательно это поймет…")
	await novel_interface.show_text_only("Это маленький секрет между ними.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Умм…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Краем глаза Бет видит, как Милк поднимает правую руку и скрещивает большой и указательный пальцы, образуя сердечко.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("Хм…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это было кодовое слово, когда они впервые встретились.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("100485… \\nЭто соответствует 124155.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Под пристальным наблюдением Бет вводит правильный пароль менее чем за 20 секунд.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Дверь Центральной диспетчерской медленно открывается. Бет расчесывает волосы пальцами и улыбается про себя.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("Хе-хе, я знал, что ты сможешь это сделать…", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Милк хихикает, забирая деньги у тех, кто проиграет пари.")
	await novel_interface.show_dialog("Эй, ты, должно быть, дал ей какой-то намек! \\n… Обманывать нехорошо!", "Член отряда D")
	await novel_interface.show_text_only("Милк пожимает плечами, невинно глядя на них.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("Я не сказал ни слова. Вы это знали.", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Так как же она угадала?", "Член отряда Б")
	await novel_interface.show_dialog("Возможно, мы что-то упустили…", "Член отряда C")
	await novel_interface.show_text_only("Бет откашливается, чтобы прервать их размышления, и сразу же приступает к подведению итогов.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Как мы и думали, Эта Существо действительно существует в зоне бездны.", "Бет")
	await novel_interface.show_dialog("Я внимательно рассмотрел его несколько часов назад. И я собрал несколько образцов жидкости.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	novel_interface.show_character("milk_normal","shock")
	await novel_interface.show_dialog("Э…?", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все сразу замолкают.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Цель этой миссии — это Существо: древнее существо в глубинах океана.")
	await novel_interface.show_text_only("В некоторых религиях оно является источником всей жизни на земле.")
	await novel_interface.show_text_only("Люди еще не выяснили, является ли это простой формой жизни или даже существует ли она физически.")
	await novel_interface.show_text_only("Прежде чем Бет отправилась в путь, большинство членов отряда думали, что это всего лишь миф, вроде Лохнесского чудовища.")
	await novel_interface.show_text_only("Но отчет Бет разбил их надежду завершить миссию и досрочно вернуться домой.")
	await novel_interface.show_text_only("В Южном океане, на глубине 4000-6000 метров подо льдом принцессы Елизаветы...")#文字删除
	await novel_interface.show_text_only("Существует загадочное существо, которое, возможно, существовало задолго до появления людей… и оно сохранилось до наших дней.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Одной мысли об этом достаточно, чтобы волосы встали дыбом.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Датчик успешно уловил электрические нервные сигналы в окружающих водах, хотя и на короткое время.", "Бет")
	await novel_interface.show_dialog("Форма волны сначала была плоской. Но затем частота внезапно возросла и стала больше напоминать бета-волны, обнаруженные в человеческом мозге.", "Бет")
	await novel_interface.show_dialog("Хоть и в сотни тысяч раз интенсивнее…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("При этом Бет вспоминает ужасное оцепенение, когда несколько часов назад за ней наблюдало гигантское глазное яблоко.")
	novel_interface.show_character("milk_normal","solemn")
	await novel_interface.show_dialog("Похоже на состояние, когда люди просыпаются от кошмара…", "Молоко")
	await novel_interface.show_dialog("В руководстве миссии упоминались аномальные радиоволны в воздушном пространстве Антарктики… Значит, это не отказ оборудования.", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ты уверен? На такой глубине вы испытываете огромное давление на поверхность размером всего с ладонь…", "Член отряда А")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Я уверен.", "Бет")
	await novel_interface.show_dialog("Как указали наши источники, у нее огромный корпус, размах которого шире, чем у этой подводной лодки.", "Бет")
	await novel_interface.show_dialog("Я понятия не имею, почему это гигантское существо не раздавилось таким сильным давлением воды.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ух ты, а может ли это быть глубокое море Substance H?!", "Член отряда D")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("Нет.", "Бет")
	await novel_interface.show_dialog("Это не Substance H.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("К всеобщему удивлению, Бет внезапно заговорила твердым голосом.")
	await novel_interface.show_text_only("Она известна своей дотошностью в своих высказываниях. Она не стала бы делать поспешных выводов без конкретных доказательств.")
	await novel_interface.show_text_only("Что делает ее такой уверенной?")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Я имею в виду, что до сих пор никто не нашел ни одного Substance H с сознанием…", "Бет")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Но у этой Существа есть сознание…", "Бет")
	await novel_interface.show_dialog("И очень сильный…", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бай Чжучэнь поджал губы, как будто хотел объяснить, но не мог выразить это словами, но его голос становился все тише и тише.")
	await novel_interface.show_text_only("Ее голос затихает, и тишина наполняет комнату. Слышно лишь слабое дыхание.")
	await novel_interface.show_text_only("Человеческий инстинкт – бояться неизвестного.")
	novel_interface.show_character("milk_normal","laugh")
	await novel_interface.show_dialog("Ну, тогда это не Substance H. Бет всегда права!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Молоко нарушает тишину лестным смехом. Все остальные вынуждают себя улыбнуться.")
	await novel_interface.show_text_only("Только Бай Янь все еще хмурилась, а Милк вздохнула, шагнула вперед и обняла ее за талию.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Ну, по крайней мере, вы сделали первый шаг. \\nНе смотри так мрачно!", "Молоко")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Чтобы образцы оставались активными, нам необходимо как можно скорее отправить их в лабораторию.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бет игнорирует жест Милка и продолжает разговаривать с капитаном.")
	await novel_interface.show_dialog("А как насчет того, что в Буэносе Aires?", "Член отряда А")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("У нас недостаточно времени. Глубоководная среда в нашей нынешней камере для отбора проб может просуществовать еще только четыре часа.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ближайшая квалифицированная лаборатория находится на другой стороне шельфового ледника Эймери. Сначала мне нужно доложиться в штаб.", "Член отряда А")
	await novel_interface.show_dialog("Что? Ненавижу подавать заявки на ледоколы!", "Член отряда Б")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Я думаю, ледокол Ушуайя в этом месяце будет свободен.", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ушуайя…", "Член отряда D")
	await novel_interface.show_text_only("Несколько членов отряда обмениваются взглядами.")
	novel_interface.show_character("baizhu_normal","normal") 
	await novel_interface.show_dialog("Чтобы сэкономить время, мы также можем оборудовать на ледоколе временную лабораторию—", "Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Милк внезапно хватает Бет за руку и перебивает ее.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Почему бы просто не позволить им сообщить Боссу самую свежую информацию? Сохраните документы и для них!", "Молоко")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("— Детка, не будь такой серьезной. Не унывать!", "Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Милк ласково трется о Бет.")
	
	print("=== 深海恐惧篇第10话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
