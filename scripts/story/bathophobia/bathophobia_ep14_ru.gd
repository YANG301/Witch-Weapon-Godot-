	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Круто…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Просто игрушки. Я сделал их с помощью алхимических инструментов и надписи преобразования энергии.", "Генриетта")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("— говорит Генрих скромно, но с выражением удовлетворения на лице.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Нет-нет, это потрясающе!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это действительно здорово… Технология создания таких искусственных материалов со свойствами Substance H до сих пор остается строжайшей тайной.")
	await novel_interface.show_text_only("Я взял теплый нефрит и сунул несколько кусочков в руки Рафаэлю и Энни.")
	await novel_interface.show_text_only("Когда я прикасаюсь к их рукам, я чувствую, как температура их тела быстро повышается.")
	await novel_interface.show_dialog("Кашель… Кашель…", "Raphael")
	await novel_interface.show_dialog("Эмм… Э…", "Annie")
	await novel_interface.show_text_only("С приступом кашля Annie и Рафилия приходят в сознание.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Ты в порядке?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Видя, как они сонно кивают в ответ, я вздыхаю с облегчением.")
