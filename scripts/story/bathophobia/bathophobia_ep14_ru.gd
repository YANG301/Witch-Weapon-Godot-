	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Мастер, вам холодно?", "Генриетта")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Генрих нежно берет меня за руку.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Э…?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я чувствую, как тепло распространяется от кончиков ее пальцев по всему моему телу, как будто я сижу у камина.")
	await novel_interface.show_text_only("С удивлением смотрю на эту девушку, которая носит еще меньше, чем я. Когда она отпускает мои руки, я обнаруживаю в своих ладонях несколько золотых камней.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Что это...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Вы почувствуете себя лучше с этим теплым нефритом.", "Генриетта")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Хотя кристаллы из нефрита не горячие на ощупь, они способны излучать тепло по всему телу.")
	await novel_interface.show_text_only("С этими камнями ледяная и заснеженная пустошь превращается в теплое, уютное место.")
	await novel_interface.show_text_only("Это заставляет меня задуматься, не является ли окружение не чем иным, как студийной сценой.")
