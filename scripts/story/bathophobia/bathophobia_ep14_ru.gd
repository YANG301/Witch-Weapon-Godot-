# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Яркая белизна.")
	await novel_interface.show_text_only("Перед моими глазами постепенно возник размытый контур, и все вокруг меня как будто ускорялось, как будто падало с большой скоростью с высоты 10 000 метров.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Наконец мои ноги коснулись земли, но ожидаемого удара не последовало. Лишь боль в ушах напоминает мне о резком повышении давления воздуха.")
	await novel_interface.show_dialog("Ой…", "Lian")
	await novel_interface.show_text_only("Я вздыхаю и понимаю, что покинул это пространство. Должно быть, это реальный мир, потому что он чертовски…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Оооочень старо!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно меня хлещет морозный воздух, и у меня сильно сводит живот.")
	await novel_interface.show_text_only("Я с трудом открывала воспаленные глаза, словно ресницы все замерзли…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Когда я, наконец, прозрел, я обнаружил, что все занесено снегом. Холодный воздух ощущается как нож, пронзающий мое горло.")
	await novel_interface.show_text_only("Я вдыхаю холодный воздух и не могу удержаться от кашля.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Ух-кхе-кхе!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Сколько времени прошло? Уже темно? \\nГде мы…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В отупляющем холоде температура моего тела быстро падает, и я начинаю непроизвольно дрожать.")
	await novel_interface.show_text_only("Рядом со мной Генрих выглядит каким-то взволнованным. \\???? и Рафилия в изнеможении лежат на снегу.")
