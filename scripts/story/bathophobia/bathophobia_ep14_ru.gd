	await novel_interface.show_text_only("Над белизной висит странное спокойствие, словно пейзаж — всего лишь компьютерная симуляция.")
	await novel_interface.show_text_only("Рядом со мной Генрих что-то бормочет про себя, глубоко задумавшись.")
