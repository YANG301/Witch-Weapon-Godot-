# bathophobia_ep19.gd - 深海恐惧症篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep19_script()

func play_script():
	pass

func bathophobia_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("Следуем по лестнице вниз и попадаем в выставочный зал.")
	await novel_interface.show_text_only("Удивительно, но системы электропитания и вентиляции, похоже, все еще работают нормально. Качество воздуха здесь кажется хорошим.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Это такое большое здание __ЭЛЛИПСИС__, но почему оно кажется таким пустым?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Хотя, кажется, все работает нормально...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Выставки освещены жутким сиянием. Звук работающих вентиляторов слышен издалека.")
	await novel_interface.show_text_only("Здесь темно, достаточно темно, чтобы скрыть потенциальных хищников, прячущихся по углам и наблюдающих за каждым нашим движением __ЭЛЛИПСИС__")
	await novel_interface.show_text_only("Мы внимательно наблюдаем за происходящим вокруг, прежде чем наконец обратить внимание на экспонаты.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Это образцы...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В глаза бросается экспонат в прозрачном футляре, поддерживаемый стойкой из органического стекла. Оно напоминает какое-то морское животное.")
	await novel_interface.show_text_only("У него скользкое блестящее тело полупрозрачного белого цвета. Хвост тоже гладкий. Похоже на животное, которое могло выжить только в глубинах океана.")
	await novel_interface.show_text_only("Если его спина выглядит вот так, интересно, как он выглядит спереди...")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я подхожу к другой стороне, чтобы посмотреть, и задыхаюсь от удивления и отвращения.")
	await novel_interface.show_text_only("У существа восемь толстых, неуклюжих когтей, каждый с двумя суставами, очень похожими на человеческие пальцы.")
	await novel_interface.show_text_only("А на его ладонях что-то вроде маленьких ртов с крошечными зазубренными зубами. На месте губ красная мышечная ткань.")
	await novel_interface.show_text_only("Напоминает мне тех инопланетян, которые цепляются за твое лицо и никогда не отпускают, таких можно увидеть в фильмах ужасов B-класса.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Зачем что-то подобное выставлено на выставке... ?", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это какой-то реквизит из фильма?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Нет. Это образец реального, существующего существа.", "Raphael")
	await novel_interface.show_dialog("Это результат неудачного генетического эксперимента во время войны. Я видел много таких в научно-исследовательском институте Salmonton.", "Raphael")
	await novel_interface.show_dialog("Позже выяснилось, что они бесполезны, и через некоторое время их бросили.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Тем не менее, люди обычно относятся к ним как к биологическим отходам...", "Raphael")
	await novel_interface.show_dialog("Редко можно увидеть что-то подобное на выставке, как будто это произведение искусства.", "Raphael")
	novel_interface.change_2nd_expression("jeer")
	await novel_interface.show_dialog("Владелец этого объекта, должно быть, подонок. Еще больший гад, чем ты!", "Raphael")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я не подлец! Господи!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("В любом случае, эта штука действительно выглядит немного..., знаете ли,... тревожно.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("И что еще хуже, здесь никого нет.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Это как целый пустой город. Вы можете сказать, что некоторые углы ржавеют от неиспользования.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("Эй! Следи за своим шагом!", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("А?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я спотыкаюсь о картридж и падаю вперед в сторону витрины. Как раз в тот момент, когда я собираюсь удариться головой об острый угол…")
	await novel_interface.show_text_only("Рафилия выходит вперед и переносит меня назад во времени.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Какой неуклюжий...", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	await novel_interface.show_dialog("Фу! Это было близко!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Спасибо, Рафилия.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я открываю глаза и оказываюсь в объятиях Рафилии, как будто мы исполняем бальный танец. Я должен признать, что она выглядит... хорошо, вот так. Полный материал для бойфренда.")
	await novel_interface.show_text_only("Рафилия неловко кашляет, отпуская меня из своих объятий.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Мы выходим из выставочного зала и обнаруживаем коридор, пол которого покрыт металлическими досками.")
	await novel_interface.show_text_only("Свет здесь значительно ярче. Атмосфера также значительно более жуткая. Слишком тихо. Мне это не нравится.")
	await novel_interface.show_text_only("Тем не менее, слышен белый шум работающих машин. Что означает—")
	await novel_interface.show_text_only("Эта база не совсем мертва.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Если кто-то еще здесь, чтобы управлять машинами, разве они не должны уже выйти, чтобы поприветствовать нас?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","smile",0.25)
	await novel_interface.show_dialog("Или, если они не дружелюбны, они тоже могли бы уже начать атаку.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Внезапно я заметил светлое пятно, движущееся в темноте. Присмотревшись, я обнаружил, что это камера наблюдения неподалеку, повернутая на нас.")
	await novel_interface.show_text_only("Я машу рукой.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ой, извини...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ты выглядишь такой девчачьей, делая это.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("– комментирует Рафилия.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Да ладно, кто бы там ни был, ты не можешь просто выйти и поговорить с нами?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Тем не менее, у меня нет ощущения, что за нами кто-то наблюдает...", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Возможно, камера наблюдения повернулась к нам, потому что почувствовала наши шаги? Может быть, ее никто не контролирует?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Однако устройства, активируемые звуком, не использовались уже несколько десятилетий назад. Слишком слаб. Даже крошечный ультразвуковой генератор мог их парализовать.")
	await novel_interface.show_text_only("Камера наблюдения все еще работает, но похоже, что за ней никто не следит.")
	await novel_interface.show_text_only("Я немного разочарован и решил немного напугать бедную Рафилию. Претенциозным, зловещим тоном я говорю ей:")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Видите ли, вы можете мне не поверить, но на самом деле...", "Lian")
	await novel_interface.show_dialog("Я вижу мертвых людей...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Ты __ЭЛЛИПСИС__, ты имеешь в виду, что здесь есть призраки?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия визжит нехарактерно высоким голосом.")
	await novel_interface.show_text_only("Затем она понимает, что я просто клоунаду, и бросается ударить меня по голове.")
	await novel_interface.show_text_only("Пытаясь отступить, я падаю на землю, мой Огненный Нефрит выкатывается из рубашки.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Рафилия, я не хотел… ах... аху!\\nИзвини, я не знал, что ты такой пугливый кот...", "Lian")
	await novel_interface.show_dialog("Ух, как холодно...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Хм!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия несколько успокаивается, когда видит меня, свернувшегося на земле, дрожащего от холода без защиты нефрита.")
	await novel_interface.show_text_only("Почему так холодно, хотя мы находимся дома... ?")
	await novel_interface.show_text_only("Я спешу забрать свой Огненный Нефрит.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Не слишком ли холодно? Как люди на базе вообще так живут?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внимательно наблюдая, я обнаружил, что многие места в углах стены уже замерзли...")
	await novel_interface.show_text_only("Мне это отдаленно напоминает игру о выживании во льду и снегу...")
	await novel_interface.show_text_only("В этой игре речь шла о производстве ресурсов или что-то в этом роде. И это имело довольно странный конец.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Подождите __ЭЛЛИПСИС__ )", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта снова кладет ладонь на стену.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Эй, н-не разрушай и эту стену...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она из тех людей, которые выдернули бы целую колонну, если бы не была осторожна.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Что-то не так.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка-алхимик хмурится, ее лицо мрачно.")
	await novel_interface.show_text_only("Кажется, что рябь воздуха течет во всех направлениях, начиная с того места, где прижата ее ладонь.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("…", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Что?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("... Мы в ловушке.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Э?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я бегу до конца коридора. Дверь в выставочный зал не заперта. Неа, у нас все в порядке. Совершенно не в ловушке.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Хватит меня пугать, чувак...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прижав руку к сердцу, я направляюсь к архивной комнате, мимо которой мы только что прошли. Дверь открыта.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room.png")
	await novel_interface.show_text_only("Комната ярко освещена, кажется намного уютнее, чем коридор.")
	await novel_interface.show_text_only("Слишком занятый осмотром, я чуть не споткнулся о трещину в плитке пола.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Следи за своим шагом, неуклюжий.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия стоит в дверях архивной комнаты, с одной стороны наблюдая за мной, а с другой — за Генриеттой. Алхимик, кажется, все еще ломает голову над стеной коридора.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Подожди. Почему я чувствую сквозняк в этой комнате?", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Может ли это быть...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я достаю свой Огненный Нефрит и кладу его на стол, чтобы лучше чувствовать температуру в комнате.")
	await novel_interface.show_text_only("Действительно, температура здесь намного выше, чем в холодном коридоре. Есть отопление — такое тепло, что трудно поверить, что мы в Антарктиде.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Э…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Подожди. Когда мы проходили мимо этой комнаты, я помню, как взглянул на полку.\\nЧто-то выглядит иначе...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Или это просто моя память подшучивает надо мной?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Почесывая голову, я иду к двери.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Следите за своими ногами.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Попался. Я чуть не споткнулся об эту гигантскую трещину на земле. Я больше не совершу ту же ошибку —", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— говорю я, указывая на пол, чтобы прояснить свою точку зрения. Но подожди...")
	await novel_interface.show_text_only("Трещины нет. Плитка вся целая.")
	await novel_interface.show_text_only("Гладкая, гладкая мраморная плитка. Почти как зеркало. В нем даже отражены мои бело-голубые трусики…")
	await novel_interface.show_text_only("Упс. Я сразу сжимаю ноги.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что-то действительно не так.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("... Что-то не так, Рен?", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Что ты там делаешь?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Только что здесь была трещина. Но его больше нет...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не мог ошибиться, потому что чуть не споткнулся об это.")
	await novel_interface.show_text_only("Земля, где должна была быть трещина...")
	await novel_interface.show_text_only("Архивная комната, единственное отапливаемое место...")
	await novel_interface.show_text_only("Полка, на которой предметы как будто поменяли порядок __ЭЛЛИПСИС__")
	await novel_interface.show_text_only("Я чувствую, как мое сердце бешено колотится в груди.")
	await novel_interface.show_text_only("Осторожно делаю шаг вперед.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Эй, что ты имеешь в виду под соединением в трещинах? Ты все еще хочешь, чтобы я помог тебе...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия звучит раздраженно. Она определенно не шутит — она действительно видит трещину на полу.")
	await novel_interface.show_text_only("Но насколько я вижу (и чувствую), трещины нет.")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Что-то не так. То, что вы видите, и то, что я вижу..., они разные.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как это могло быть... ?")
	await novel_interface.show_text_only("Встревоженный, я хватаю рацию, пытаясь связаться с Annie или Mariru. Это, по крайней мере, дало бы мне видимость безопасности.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Привет? Annie? Вы там?", "Lian")
