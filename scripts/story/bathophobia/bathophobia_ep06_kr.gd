# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("평소처럼 단방향 화상회의가 진행 중이다. \\n마리루는 회의실 중앙에 서서 침착하게 연구 진행 상황을 보고하고 있다.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("“방주 계획”에 관해……", "자일즈")
	await novel_interface.show_dialog("살몬톤이 제공한 역사 문물 목록에서 『테스하임 청금석주』를 선택했나요?", "자일즈")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("네. 어떻게 제어 가능한 『변이공간』을 만들지가 중요합니다.", "마리루")
	await novel_interface.show_dialog("최근 각 학원도시에 발생하는 시공 위상 파동은 『이물질』의 물체와 인간이 접촉해서죠.", "마리루")
	await novel_interface.show_dialog("『이물질』들은 계속 침묵상태였다가 동시에 활성화되는 것 같아요.", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（『마도기』와 『마도서 페이지』가 맞지만 익숙한 단어로 설명하는 게 좋겠어.）", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("『로우스 금잔』이 사라진 그날이죠?……", "화음룡")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("현재는 아직 두 사건의 연관성을 확인할 수 없어요.", "마리루")
	await novel_interface.show_dialog("제어 불가능한 요소가 너무 많아 두 가지 조건에 따라 선별할 수 밖에 없어요.", "마리루")
	await novel_interface.show_dialog("하나，색상 스캔이 『이물질』의 특징과 부합하며, 활동성이 높지 않음.", "마리루")
	await novel_interface.show_dialog("둘，역사 문헌을 통해 문물 관련자를 추적, 폭력과 범죄 경향이 없음.", "마리루")
	await novel_interface.show_dialog("『테스하임 청금석주』의 원래 주인은 하인리히 쿤라트, 문예 부흥 시기의 의사이자 연금술사죠.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("활동성이 높지 않다라……더 밀접한 데이터를 수집할 수도 있겠는 걸.", "브렛")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("샘플이 아주 귀하니，너무 성급한 방법은 쓰지 않는 게 좋아요.", "자일즈")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("（렌이 변이 공간에 출입할 수 있다는 걸 원로원에게 증명할 수만 있다면 충분해.）","마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（사실 『테스하임 청금석주』는 『마도기』가 아니라）\\n（일종의 『마법 각인』을 보유한 아이템이다.）","마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（일반인을 『마도기』에 접촉하게 하다니）\\n（난 그 고릴라와 달라……）","마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("스크린에서 낮은 웃음소리가 들려온다.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("연금술사……과학의 기원？\\n정말 흥미로운 선택이군.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("듣자하니，그것은 살몬톤의 중요 역사 예술품이고，하인리히는 『장미십자회』 창시자 중 한 명이라던데…", "화음룡")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("『장미십자회』는 종교와 오컬티즘 단체일 뿐，현재 살몬톤의 정보기구인 『십자장미』와는 관련 없어요.", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("연금술사는 그 시대의 과학자에요. 그 사람이 미지의 사물에 대한 기본적인 경외를 가지길 바랄 뿐입니다.", "마리루")
	await novel_interface.show_dialog("하지만 덱스 박사의 성격이라면，이런 중요한 문물을 쉽게 넘겨주지 않을 거예요…", "마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("회의실에 알 수 없는 침묵이 흐른다.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("맞아요. 살몬톤 쪽에서 우리에게 데이터의 공유와 모든 과정에 참여할 대표자 한 명을 요구했어요.", "자일즈")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("……", "마리루")
	await novel_interface.show_dialog("(마녀 제조 계획을 포기하지 않은 모양이군……)\\n(렌을 『안정기』로 사용하려는 건가?）","마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("그렇다면，마지막으로 확인하고 싶은 게 있어요. 모두들 이 실험의 위험성은 알고 있겠죠?", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("물론. 옛 도읍의 지하 배수 설비를 이용해 개조한 『방주기지』는 최악의 상황에 대응하기 위한 거요.", "자일즈")
	await novel_interface.show_dialog("급속 해수 역류 시스템은 30초 안에 모든 기지를 침몰시킬 수 있어요.", "자일즈")
	await novel_interface.show_dialog("만약 실험 중 예기치 못한 상황이 발생한다면……", "자일즈")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("그 때가 오면 마리루 각하가 긴급 자폭 장치를 가동할 결심을 하길 바랍니다.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
