# bathophobia_ep20.gd - 深海恐惧症篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep20_script()

func play_script():
	pass

func bathophobia_ep20_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("El escuadrón continúa esquivando los ataques de enemigos frenéticos e inidentificables y envía una llamada de socorro tras otra.")
	await novel_interface.show_text_only("Más enemigos están llegando desde la entrada de la base. El equipo se felicita por no retirarse a la tormenta de nieve.")
	await novel_interface.show_text_only("Ciertamente no pueden enfrentarse a estos enemigos extraordinariamente ágiles afuera en la nieve, sin obstáculos detrás de los cuales esconderse.")
	await novel_interface.show_text_only("Sin embargo, esto tampoco les deja otra opción que adentrarse más en la base, buscando una posición estratégicamente ventajosa para pedir apoyo.")
	await novel_interface.show_text_only("Se ven obligados a entrar cada vez más, fuera de la sala de exposición, a un pasillo.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_dialog("Qué mierda. Aquí no hay señal.","Miembro del equipo C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Chicos, diríjanse primero a la sala de comunicaciones. Es posible que encuentre allí algunos dispositivos de transmisión viables.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Entendido!","Miembro del equipo C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Revisé el mapa de diseño 3D de este lugar. Nuestro mejor curso de acción en este momento es dirigirnos... \\n... hacia abajo, en la dirección de las ocho en punto.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todos los miembros del escuadrón resultan heridos en diferentes grados de gravedad. Pero aún así continúan, protegiéndose mutuamente en forma de dos grupos, uno al frente y otro en la retaguardia.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(Estos tipos... se curan muy rápido. Simplemente no parece correcto...)","Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","shock",0.25)
	await novel_interface.show_dialog("¡Cuidado!","Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth se desconecta por solo una fracción de segundo, y es entonces cuando los enemigos que los persiguen por detrás de repente tuercen sus articulaciones, enormes espadas cortan el aire en un ángulo extraño.")
	await novel_interface.show_text_only("Tomada por sorpresa, Milk empuja a Beth a la sala de archivos detrás de ella.")
	await novel_interface.show_text_only("Evaden con éxito la hoja oscilante, aunque todavía deja una grieta gigantesca en las baldosas del suelo.")
	await novel_interface.show_text_only("La grieta no es demasiado ancha, pero sí lo suficientemente ancha como para separar a los dos grupos. Bien podría ser un cañón sin fondo.")
	await novel_interface.show_dialog("¡Ah!","Miembro del equipo D")
	await novel_interface.show_text_only("Un miembro del escuadrón, cuyo nombre en clave es Mute, resulta ser el más cercano al enemigo blandiendo la enorme espada. Desesperada por proteger sus miembros, avanza, dejando que la espada atraviese su cuerpo una y otra vez.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("... ¡Silencio!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mudo, que siempre es tan despreocupado, que ama las camisas hawaianas. Cada vez que Milk inicia uno de sus grupos de apuestas, Mute es ese idiota que termina perdiendo dinero.")
	await novel_interface.show_text_only("Ha pasado mucho tiempo desde la última vez que Milk recuerda haber llamado a Mute por su nombre en clave. Ella nunca esperó que estuviera en tal situación.")
	await novel_interface.show_text_only("Su sangre recién derramada tiñe de rojo las paredes del pasillo.")
	await novel_interface.show_text_only("El MP5K modificado de Mute cae al suelo, patina un poco y finalmente se detiene junto a los pies de Milk.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... ¡Maldita sea!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La metralleta modificada de Milk tiene un retroceso reducido, lo que le permite sostenerla y disparar una gran cantidad de balas con una sola mano.")
	await novel_interface.show_text_only("Saca una daga y fija a su objetivo, cuyo cuerpo está plagado de agujeros de bala y cubierto de un líquido verde asqueroso, en la pared junto al cuello.")
	await novel_interface.show_text_only("Mientras otros miembros del escuadrón saltan con sus escudos antidisturbios para protegerse de los enemigos, Milk redirige su atención a su compañero de equipo caído, presionando la herida que adorna su cuello.")
	await novel_interface.show_text_only("La temperatura aquí es tan baja que la sangre que brota de la aorta de Mute chisporrotea como agua hirviendo.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("¿Dónde está el botiquín de primeros auxilios? ¡Consigue el spray tapón de sangre!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Jaja... ja...","Miembro del equipo D")
	await novel_interface.show_text_only("En el fondo, saben que probablemente ya no podrá salvarla. Pero todavía lo intentan.")
	await novel_interface.show_text_only("El spray hemostático se mezcló con sangre, rápidamente enrojeció el algodón hemostático de la herida y se deslizó hasta el suelo a lo largo de la mano de Milk.")
	await novel_interface.show_text_only("Mientras tanto, cada vez más enemigos se congregan en el pasillo, atraídos por la conmoción.")
	await novel_interface.show_text_only("Los escudos antidisturbios que los retienen han sido golpeados tantas veces que ya se están resquebrajando.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Uf...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tres miembros del escuadrón se acercan para ayudar y abren fuego para cubrirse mientras Milk intenta arrastrar a su compañero caído a la sala de archivos en la esquina más adelante.")
	await novel_interface.show_text_only("A medida que avanzan, dejan un largo rastro de sangre en el frío y brillante suelo del pasillo.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Dark.png")
	await novel_interface.show_text_only("Después de finalmente llevar a Mute a la habitación, Milk le toma el pulso con los dedos.") #换行问题
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("¡Necesitamos algo de adrenalina aquí!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth se apresura, rasga la camisa empapada de sangre de Mute, calcula la mejor posición en el lado izquierdo de su pecho y, con un movimiento rápido, inyecta adrenalina.")
	await novel_interface.show_text_only("El disparo oportuno devuelve alivio y un toque de color al rostro de Mute, pero solo durante unos segundos.")
	await novel_interface.show_dialog("*tosiendo*\\n*jadeando*","Miembro del equipo D")
	await novel_interface.show_text_only("Sin embargo, después de unos segundos, la tasa de pérdida de sangre superó con creces el límite que el cuerpo puede soportar.")
	await novel_interface.show_text_only("El color abandona el rostro de Mute una vez más. Sus pupilas se dilatan.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("…","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las lágrimas brotan de los ojos de Milk.")
	await novel_interface.show_text_only("Beth pone una mano sobre la de Milk, que todavía está firmemente presionada sobre la herida de su compañera de equipo. Intercambian una mirada silenciosa que dice muchas palabras.")
	await novel_interface.show_dialog("¡No podemos contenerlos más! ¡Tenemos que retirarnos!","Miembro del equipo C")
	novel_interface.show_character("baizhu_break","speechless")
	await novel_interface.show_dialog("¡Leche!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk aprieta los dientes y recoge la caja de muestras que Mute había arriesgado su vida para recuperar en la sala de archivos.")
	await novel_interface.show_text_only("El equipo ya está superado en número. Con uno menos, el resto está en problemas aún mayores.")
	await novel_interface.show_text_only("Nadie quiere admitirlo, pero esa es la realidad a la que se enfrentan ahora.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Tomaremos ese pasaje de allí. ¡Retiro!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yo me ocuparé de la retaguardia.","Miembro del equipo B")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BTB.png")
	await novel_interface.show_text_only("Las chicas se paran espalda con espalda, con los ojos alerta.")
	await novel_interface.show_text_only("Milk agarra su arma con fuerza, haciendo todo lo posible por mantener cubierto al resto de su escuadrón.")
	await novel_interface.show_dialog("(¿Cómo... sucedió esto...?)","Beth")
	await novel_interface.show_text_only("Según las investigaciones de Beth, \"Ningen\" no había enviado nada más que un equipo de exploración ordinario a la Antártida.")
	await novel_interface.show_text_only("Sin embargo, los enemigos que ven... no son un equipo de exploración ordinario.")
	await novel_interface.show_dialog("(¿Fue mi culpa por no anticipar esto?)","Beth")
	await novel_interface.show_dialog("(Pero anticipé esto. ¿No es así?)","Beth")
	await novel_interface.show_dialog("(Lo supe desde el principio... )\\n(Siempre supe que solo los estoy usando y que es peligroso... )","Beth")
	await novel_interface.show_dialog("(Sin embargo, todavía dejo que esto suceda...)","Beth")
	await novel_interface.show_text_only("Al darse cuenta de la vacilación de Beth, Milk pone su espalda contra la de ella.")
	await novel_interface.show_text_only("La leche está agrupada en capas gruesas, por lo que no es como si pudieran sentir el calor corporal del otro. Sin embargo, de alguna manera, Beth todavía se siente reconfortada.")
	await novel_interface.show_dialog("Todo estará bien.","Milk")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_dialog("Estoy justo aquí.","Milk")
	await novel_interface.show_text_only("... \"Todo va a estar bien. Estoy aquí\".")
	await novel_interface.show_text_only("Cuando Beth vuelve a la realidad, su mirada se posa en el resto de los miembros de su escuadrón.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Los que llevan los escudos antidisturbios apenas le dedican una segunda mirada mientras los enemigos continúan avanzando. Le hacen un breve gesto: ve, ve.")
	await novel_interface.show_text_only("¿Saben estos valientes guerreros a qué se enfrentan exactamente?")
	await novel_interface.show_text_only("¿Saben siquiera qué están haciendo los que les dan órdenes...?")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_dialog("Lo siento. Fue mi culpa... Juzgué mal la situación...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Este no es el momento de disculparse.","Miembro del equipo B")
	await novel_interface.show_text_only("La otra parte le guiñó un ojo a Bai Zhu y entendió.")
	await novel_interface.show_dialog("Será mejor que me regales tequila para diez años una vez que salgamos de este infierno.","Miembro del equipo C")
	await novel_interface.show_text_only("Beth apenas puede creer que sus compañeros de equipo sigan tratando de consolarla incluso en una situación así.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("—¡Cuidado!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk baja por el hombro izquierdo de Beth, bloqueando una hoz entrante con una metralleta que ya no tiene munición.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("¡Estos tipos son imposibles!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los enemigos, como una horda de leopardos recién liberados, atraviesan fácilmente la zona de amortiguación despejada por los poseedores de los escudos antidisturbios.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Es porque son Ningen... ya sabes, eso significa \"humano\" en japonés.","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Nin... gen... jejejeje... \\n¡Muere! ¡Morir! ¡Morir!","???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es como si la palabra Ningen les divirtiera. El líder de los enemigos sonríe de oreja a oreja con una sonrisa que le parte la cara.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Están locos... \\nDe ninguna manera podremos derrotar a estos monstruos...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Beth, toma a los demás y vete! ¡Los detendremos!","Líder de escuadrón")
	await novel_interface.show_text_only("Antes de que el miembro del escuadrón que sostiene el escudo pueda siquiera terminar su oración, un enemigo que sostiene una guadaña envía su escudo a volar. Habiendo perdido su cobertura, los miembros del escuadrón inmediatamente abren fuego, mientras esquivan los ataques lo mejor que pueden.")
	await novel_interface.show_text_only("De repente, de la nada—")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BaizhuBattle.png")
	await novel_interface.show_text_only("De repente, una espada de forma extraña bloqueó firmemente la hoz que atacaba a Milk.")
	await novel_interface.show_text_only("Beth evoca docenas de manchas de luz plateadas que se acercan a los enemigos, dejando manchas blancas que parecen congelación sobre sus cuerpos.")
	await novel_interface.show_text_only("La baba verde que brota de los cuerpos de los enemigos puede reparar sus heridas, pero no tiene ningún efecto sobre estas manchas blancas. Una vez alcanzados por la metralla, sus cuerpos se hacen añicos.")
	await novel_interface.show_text_only("Beth luego parpadea y aparece junto a Milk. Ella salta en el aire y dispara docenas de balas a los enemigos circundantes en un instante.")
	await novel_interface.show_dialog("Eh... Bethy...?","Milk")
	await novel_interface.show_text_only("Los ojos de Milky, que estaban atónitos, reflejaron el extraño grupo de luz blanca que golpeaba el arma de su amigo.")
	await novel_interface.show_text_only("Más rápido de lo que pueden viajar sus balas, Beth blande la gran espada en su mano izquierda. En su superficie aparecen intrincados patrones en espiral.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Entonces es cuando el continente empieza a temblar una vez más.")
	await novel_interface.show_text_only("Sin embargo, los miembros del escuadrón, demasiado ocupados peleando, apenas notan...")
	
	print("=== 深海恐惧症篇第20话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
