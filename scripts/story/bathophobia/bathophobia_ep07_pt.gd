# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Ao sair do Coupe vermelho de Mariru, sinto o mundo inteiro girando e mal consigo ficar em pé.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… Urgh… \\nO jeito que você dirige!! É uma loucura!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta manhã, eu estava enrolado em um cobertor aconchegante, como sempre. De repente, Annie invadiu e me puxou para fora da cama.")
	await novel_interface.show_text_only("Ainda meio adormecido, fui empurrado para dentro do carro. Naquele momento, eu ainda protestava contra seu comportamento violento.")
	await novel_interface.show_text_only("Mas depois desta viagem horrível, a única coisa que me resta na mente é “graças a Deus ainda estou vivo”…")
	await novel_interface.show_text_only("O Projeto Ark está começando hoje, mas eu realmente quero dizer que estou doente.")
	await novel_interface.show_text_only("Meu estômago está doendo há dias. Caramba!")
	await novel_interface.show_text_only("E sempre tenho vontade de vomitar… Urgh!")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Você está bem, Ren?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aceno para Annie com desdém.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Estou bem, só um pouco doente. E não consigo parar de tremer agora...", "Lian")
	await novel_interface.show_dialog("Posso pegar outro carro quando voltarmos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu pergunto com voz fraca, olhando para Annie suplicante")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Olhe para você. Você está tão acostumada a bancar a senhorita inocente, não é?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Enquanto eu estava encostado na parede para me apoiar, uma voz familiar chega por trás. Poxa! Apenas deixe-me ir...")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Raphael? Por que você está…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Mariru não disse que eu estaria aqui?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Ela não apareceria se eu aparecesse.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olhando para mim como se eu fosse seu animal de estimação à venda, Mariru ignora a pergunta de Raphael.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Deixo Ren com você, \\nSenhorita Dekkers, nossa querida Representante Executiva de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Espere! Me deixando com ela?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorri e nos leva até a entrada da Base da Arca.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Tem certeza de que isso... é a entrada?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À nossa frente está a entrada para uma cave de betão voltada para esta estrada na periferia da cidade. A porta só permite a passagem de uma pessoa.")
	await novel_interface.show_text_only("Não há nenhum edifício num raio de oitocentos metros. Se não fosse pelo logotipo SID gravado na parede, eu deveria ter interpretado aquilo como um esconderijo assustador para algum pervertido.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hee-hee, venha comigo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("Descemos a escada atrás da porta que leva a um grande elevador de carga.")
	await novel_interface.show_text_only("Parece que o elevador foi projetado para ambientes extremos. Quatro roldanas grossas de metal garantem uma operação segura e estável.")
	await novel_interface.show_text_only("À medida que o elevador desce suavemente, o som das engrenagens girando vem de todos os cantos.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("As aberturas de ventilação, as malhas de metal, os rebites e a penumbra… Elementos industriais vintage estão por toda parte.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Confiabilidade acima de tudo... Já vi esses designs no cofre de ouro do Banco Central de Newmoridas.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Uau, você já esteve lá?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Foi um dos maiores projetos de construção do mundo antes da Guerra dos Sete Anos e foi preciso muito trabalho para restaurar este lugar.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru orgulhosamente apresenta esta estrutura subterrânea.")
	await novel_interface.show_text_only("Raphael está certa. O elevador, embora ainda em funcionamento, é tão estável quanto um enorme pedaço de aço sólido. Passa pela minha cabeça que mesmo pular não causaria o menor tremor no elevador.")
	await novel_interface.show_text_only("Tendo acabado de me recuperar do enjôo, estou ansioso para tentar, apenas para encontrar Raphael olhando para mim.")
	await novel_interface.show_text_only("Percebendo que posso estar agindo como um idiota, imediatamente paro com um olhar envergonhado. Mas ela virou o rosto com desdém para a janela de observação.")
	await novel_interface.show_text_only("O que diabos ela pode ver na escuridão?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Por que você está olhando para mim?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O ladrão chora ladrão, né?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ugh… Nunca esperei que Salmonton mandasse você aqui.", "Lian")
	await novel_interface.show_dialog("Afinal, o experimento hoje é bastante perigoso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais importante ainda, sei que este experimento é um programa com dois roteiros.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Você realmente sabe no que se meteu, minha senhora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Viro-me para Mariru impotente.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Superficialmente, é um projeto de pesquisa conjunto entre New Opulentia e Salmonton.", "Mariru")
	await novel_interface.show_dialog("O objetivo é identificar as causas do Fluxo Espaço-Tempo e contramedidas.", "Mariru")
	await novel_interface.show_dialog("Ambos os lados precisam enviar uma pessoa qualificada e confiável como sujeito humano.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Agora que o seu absurdo no Sky Hotel naquela noite revelou sua identidade, você é definitivamente a melhor escolha para New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru lança um olhar para mim, causando um arrepio na minha espinha.")
	await novel_interface.show_text_only("Vamos lá, aprendi minha lição...")
	novel_interface.character_light()
	await novel_interface.show_dialog("Quanto a Raphael, nossa “bem-nascida que se tornou plebeia” em Gosakuragawa, ela se ofereceu para participar do experimento em nome de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Voluntariado?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, o Pilar Lapis é muito importante para Salmonton. Eu nunca deixaria você, perdedor, estragar tudo.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Raphael é capaz de acelerar a autocura no nível celular. Isto foi afirmado por Aya.", "Mariru")
	await novel_interface.show_dialog("Mas de acordo com Beatrice, é melhor que Raphael trabalhe com Ren para colocar seu talento em ação.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente me ocorre que, no estacionamento do Sky Hotel, Raphael curou Annie em um piscar de olhos.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Então Raphael está do nosso lado, certo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, posso imaginar seu olhar patético quando você luta pela sua vida. “Owww… estou morrendo… Cure-me agora…”", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Parece que você mal pode esperar que isso aconteça?!", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Espere, pensei que fosse um experimento secreto. \\nComo ela sabia?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Deixei tudo claro para o Dr. Dekkers.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Como ele testemunhou você ressuscitando Beatrice, ele sentiu que sua cooperação anterior com o Senado estava na direção errada.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Tem algo a ver com religião?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Provavelmente não é tão simples… Mas agora, Salmonton está disposto a trabalhar com SID, desde que Raphael esteja segura conosco.", "Mariru")
	await novel_interface.show_dialog("O Senado não sabe das suas reais capacidades. Essa é a força que devemos aproveitar ao máximo.", "Mariru")
	await novel_interface.show_dialog("Uma bruxa não ativa nada quando toca um Fragmento de Bruxa. É por isso que nosso plano pode funcionar.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Então, eu realmente quero agradecer aos líderes de ambos os lados por fazerem isso acontecer.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Tem certeza de que meu excêntrico avô não se deixou enganar por isso?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Seu avô não é tão ingênuo, querido. A relíquia aqui não é de forma alguma sua escolha aleatória.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Fizemos tudo isso para garantir que o “experimento real” pudesse ser realizado com sucesso.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, se não fosse a ordem do meu avô…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael murmurou algo vagamente, seus olhos passando por mim levemente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Eu nunca concordaria em cooperar com esse pervertido travestido!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Mas o Dr. Dekkers sempre diz que você é aquele que nunca escuta.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Deixe-me adivinhar… Salmonton está realmente interessado em Heinrich, o proprietário original do Pilar Lapis?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Boa sorte, Ren!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O Senado planeja trabalhar com Salmonton na produção de mais bruxas pelas costas de SID. E desta vez querem verificar a viabilidade de me usar como Estabilizador.")
	await novel_interface.show_text_only("Salmonton, entretanto, fez um acordo secreto com Mariru.")
	await novel_interface.show_text_only("Quanto ao Mariru, ela manteve o Senado no escuro sobre nossas reais habilidades.")
	await novel_interface.show_text_only("Está ficando complicado. Isso está me matando…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Podemos realmente lutar lado a lado?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Olho de relance para a senhora autoritária na minha frente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Transferindo Raphael para Gosakuragawa…) \\n(também faz parte do plano deles?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Olhe para aquela cara estúpida. Ela deve estar pensando algo idiota de novo.)", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O elevador finalmente para com um som de batida. \\nUm portão de metal de 10 metros de altura surge à nossa frente.")
	await novel_interface.show_text_only("Um raio laser vermelho percorre meu corpo da cabeça aos pés. \\nEm pouco tempo, um sinal sonoro de confirmação sai do portão.")
	await novel_interface.show_text_only("Mariru avança para uma varredura de íris de acompanhamento.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Eles podem ser antiquados, mas as medidas de segurança aqui são bastante rígidas…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("À medida que terminamos a digitalização, o portão gigante desce lentamente, deixando-nos maravilhados com o espaço impressionante atrás da porta.")
	await novel_interface.show_text_only("O enorme espaço subterrâneo é sustentado por duas fileiras de imponentes pilares de concreto.")
	await novel_interface.show_text_only("A base de cada pilar é coberta por pilhas de fragmentos de armadura que podem ser usados em ambas as direções.")
	await novel_interface.show_text_only("Voltados para fora, esses fragmentos podem proteger a estrutura de ataques devastadores de foguetes. Mas se usados ​​na direção oposta, são capazes de destruir os pilares todos de uma vez.")
	await novel_interface.show_text_only("Durante a Guerra dos Sete Anos, esses fragmentos de armadura foram amplamente utilizados em fortalezas que precisavam ser bloqueadas ou destruídas.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Está bem úmido aqui...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O chão está cheio de manchas de água. No alto, dezenas de novos canos estão montados no teto, emitindo sons de líquido correndo.")
	await novel_interface.show_text_only("Mariru deve ter se esforçado muito para transformar este lugar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("No final da passagem, nos encontramos diante de um espaço cercado por lajes metálicas.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Senhoras.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Bem-vindo à Base Arca.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu só... eu simplesmente não consigo acreditar no que vejo!")
	await novel_interface.show_text_only("O que está diante de nós é um reservatório. Observando a névoa subindo da água brilhante, parece que estou em um cais.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Apenas observe: a escada de embarque está a caminho de nós.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
