# bathophobia_ep22.gd - 潜渊症篇第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep22_script()

func play_script():
	pass

func bathophobia_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("... No hay señal aquí. En absoluto.","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿Significa esto que estamos nuevamente en ese “sueño”?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De cualquier manera, el sistema de ventilación sigue funcionando a pleno rendimiento. Podemos oír a los ventiladores agitarse incluso desde el respiradero de la sala de archivos.")
	await novel_interface.show_text_only("Según el mapa, esta base, a pesar de haber sido construida hace mucho tiempo, fue construida estrictamente de acuerdo con los estándares de las organizaciones ultrasecretas.")
	await novel_interface.show_text_only("El acceso entre secciones está estrictamente restringido. Y hay innumerables unidades independientes, separadas por barreras hechas de aleación reforzada.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("El mapa no dice qué hacen la mayoría de estas habitaciones. ¿Deberíamos buscarlos en todos?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Esto es... tan complejo...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se necesitarían horas para revisar todo el lugar. Además, ni siquiera tenemos idea de lo que estamos buscando.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Y puede que haya otros enemigos locos acechando en las esquinas.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esas extrañas marionetas con las que nos acabamos de encontrar..., solo pensar en ellas me da palpitaciones en el corazón.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Bueno, ¡yo por mi parte me niego a ser un blanco fácil!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael golpea el escritorio con el puño, levantando una nube de polvo.")
	await novel_interface.show_text_only("La cámara de vigilancia con detección de sonido detrás de la viga de metal ajusta ligeramente su ángulo ante el ruido repentino.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quizás este sea un buen momento para hacer la pregunta que me ha estado persiguiendo desde la estación de suministros.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Oye, ¿tu... puedes sentir de qué material está hecho algo?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia sonríe ante mi pregunta.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Por supuesto. Es una habilidad básica para todos los alquimistas de Rosenkreuzer.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Entonces, si... hay un cable metálico aislado muy largo, ¿podrías rastrearlo hasta el final y encontrar a dónde conduce?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Si puedo tocarlo, debería poder hacerlo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Quieres decir...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Asiento hacia Raphael. Juntos, nos damos la vuelta y miramos fijamente el rincón oscuro de la habitación...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Red_Dot.png")
	await novel_interface.show_text_only("Donde el punto rojo de luz parpadea rítmicamente, como si tuviera pulso.")
	await novel_interface.show_text_only("La cámara de vigilancia con detección de sonido.")
	await novel_interface.show_text_only("En la extensa base subterránea, debería haber montones de estos dispositivos.")
	await novel_interface.show_text_only("Todo lo cual debería conducir a un solo lugar:")
	await novel_interface.show_dialog("La sala de control.","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("... ¿La tormenta de nieve cortó la señal?","Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("El chip GPS de Ren ya no transmite.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Si las comunicaciones se pierden hasta este punto, las misiones en áreas cubiertas por partículas cargadas de alta energía también se verán afectadas, ¿verdad?","Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Ustedes en SRD deben mejorar su juego.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pone los ojos en blanco ante Aya, quien saca la lengua.")
	novel_interface.show_character("liliu_uniform1","sigh")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Bueno, después de todo estamos en el Polo Sur. Por supuesto, aquí las condiciones son diferentes.","Ai")
	novel_interface.change_2nd_expression("blush_stare")
	await novel_interface.show_dialog("Aún así, perder la señal así como así... de ninguna manera nuestros dispositivos son tan inútiles.","Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Quieres decir que hay... otras razones que causan la desconexión?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_dizzy")
	await novel_interface.show_dialog("Sí. No sé qué es, pero debe ser poderoso... \\nSeguro que envidio a quien esté detrás de esto...","Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru mira pensativamente el dispositivo que tiene en la mano y la palabra parpadeante, DESCONECTADO, en su pantalla.")
	await novel_interface.show_text_only("Mientras tanto, Aya observa el rostro de Mariru.")
	novel_interface.show_character("liliu_uniform1","serious")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Pareces el dueño de una mascota preocupado por su gatito fugitivo.","Ai")
	novel_interface.character_light(0.35,"sigh")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De todos modos, no podemos hacer nada más que esperar.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya exhala y se vuelve hacia la ventana.")
	novel_interface.show_character("liliu_uniform1","sigh")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Altitud 37.000 metros sobre el nivel del mar. Es como si ya estuviéramos en el espacio exterior.","Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si subimos más, nuestro radar y nuestras comunicaciones dejarán de funcionar.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru echa un vistazo a la estación de trabajo de su crucero, donde más de treinta trabajadores de inteligencia están ocupados clasificando los datos que llegan de todos los rincones del mundo.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Este transportador de alta velocidad y servicio pesado... \\nLo has estado observando desde hace un tiempo, ¿eh?","Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ja. Seguramente el Senado tiene algunas cosas interesantes escondidas.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Otras tres horas antes de llegar a la Antártida...","Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Si alguna de las partes del cuerpo de Ren se rompe, estaríamos en un gran problema.","Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al darse cuenta de que Aya se muerde las uñas con ansiedad, Mariru se golpea la nuca con los nudillos.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Oye.","Mariru")
	await novel_interface.show_dialog("¿Quién creías que entrenó a esos tipos?","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("<Base de Snedronningen>")
	await novel_interface.show_text_only("Siguiendo las instrucciones de Henriette, rastreamos el cable conectado al dispositivo de vigilancia hasta las profundidades de la base.")
	await novel_interface.show_text_only("Aquí los pasillos son cada vez más estrechos. Las paredes están desnudas, como si la construcción aún no estuviera terminada.")
	await novel_interface.show_text_only("Nuestros pasos resuenan en las paredes del túnel. Espeluznante. Demasiado espeluznante. Puedo sentir mi corazón martillando en mi pecho.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Este no es el momento adecuado para esto, pero...")
	await novel_interface.show_text_only("Pero cuanto más nervioso me pongo, más difícil es contenerlo en...")
	await novel_interface.show_text_only("Me detengo en seco, levanto una mano.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Oye...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("¿Y ahora qué?","Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Puedo...?","Lian")
	await novel_interface.show_dialog("¿Ir a... al baño?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aquí estoy, en un túnel aparentemente interminable, sin puertas ni caminos bifurcados, con dos chicas. Y solicito ir al baño. Quiero tirarme por un acantilado.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("…","Raphael")
	novel_interface.change_2nd_expression("subtle")
	await novel_interface.show_dialog("¿Te das cuenta siquiera de la gravedad de la situación?","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Soy... ¡Lo siento! No puedo evitarlo, ¿vale?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Junto mis muslos con más fuerza, tratando de mirar a cualquier lugar menos al rostro claramente disgustado de Raphael.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","subtle",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Cuanto más nervioso me pongo, cuanto más me digo a mí mismo que no piense en ello, peor se siente...)","Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Estoy así de cerca de orinarme en los pantalones...")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("(¿Qué hice para merecer esto?)","Lian")
	await novel_interface.show_dialog("Uh, si alguno de ustedes tiene una botella de plástico o algo así, podría...","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("... ¿Eh?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Uf, ¿de qué estoy hablando?")
	await novel_interface.show_text_only("Raphael solía verme como un pervertido, pero ahora... probablemente me ve como basura.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Quiere algo para contener su orina, ¿eh, Maestro? Bueno, podría intentar falsificar algunos materiales...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette parece estar disfrutando demasiado de esto.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¡Vamos! ¡Sabes que eso no es lo que quiero decir!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al ver la desesperación en mis ojos, el alquimista finalmente se apiada de mí y corta un agujero del tamaño justo en las paredes del túnel.")
	await novel_interface.show_text_only("Detrás de la pared hay lo que parecen habitaciones de trabajadores: oscuras, mohosas y, lo más importante, cuentan con un inodoro.")
	await novel_interface.show_text_only("¡Viva la alquimia!")
	await novel_interface.show_text_only("Me meto por el agujero de inmediato, ya que no quiero permanecer más tiempo bajo los escrutadores ojos de Raphael.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La temperatura parece ser más baja aquí. Hay una fina capa de hielo sobre las paredes y puedo ver mi respiración salir en bocanadas blancas.")
	await novel_interface.show_text_only("Con la luz que sale de los túneles, puedo leer el termómetro de mercurio en la pared. Dice menos treinta y dos grados.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Vaya, en ese caso, ¿mi orina se congelará en el momento en que salga?)","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Probablemente no... ¿verdad?)","Lian")
	await novel_interface.show_dialog("(pero...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("Finalmente regreso al túnel, sonrojándome furiosamente.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Por qué tardaste tanto?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Tu cara está toda roja.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¿Se ha consumido todo el poder de tu Fire Jade? ¿Necesitas uno nuevo?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡No, no, está bien!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lo siento, Henriette... \\n¡Este Fire Jade... de ninguna manera voy a dejar que nadie lo sostenga ahora!")
	await novel_interface.show_text_only("La vejiga ya no me mata, sigo felizmente a Henriette y Raphael mientras continuamos caminando en dirección a los cables.")
	await novel_interface.show_text_only("Intento recordar lo que acabo de ver en las viviendas de los trabajadores. Sobre una mesa había media botella de vodka y en las paredes hielo de color oscuro.")
	await novel_interface.show_text_only("Parecía haber pateado un objeto metálico mientras caminaba en la oscuridad... \\n¿Son casquillos de bala?")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("No, no. Esa debe haber sido mi imaginación.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observo mi entorno. Las paredes del túnel de cemento están en su mayoría desnudas, salvo un par de baldosas.")
	await novel_interface.show_text_only("Espera, ¿... mosaicos? Si este lugar hubiera estado en construcción como pensaba, las losas no estarían colocadas de manera tan desordenada como esta.")
	await novel_interface.show_text_only("Pero ¿qué fuerza desprendió toda la pared interior del túnel? ?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_text_only("(Aquí... qué pasó exactamente).")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Finalmente llegamos a la puerta de la sala de seguimiento. La manija de la puerta atascada parecía no haber sido girada en mucho tiempo.")
	await novel_interface.show_text_only("Eso no disuade a Henriette. Ese monstruo simplemente rompe la perilla, la cerradura y todo.")
	await novel_interface.show_text_only("La puerta de la sala de monitoreo se abre con un chirrido...")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("—¡Cuidado!","Henriette")
	
	print("=== 潜渊症篇第22话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
