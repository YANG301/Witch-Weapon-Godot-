# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Cuando salgo del Coupé rojo de Mariru, siento que el mundo entero da vueltas y apenas puedo mantenerme erguido.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… Puaj… \\n¡¡Tu forma de conducir!! ¡¡Es una locura!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta mañana temprano, estaba acurrucado en una acogedora manta como de costumbre. De repente, Annie irrumpió y me sacó de la cama.")
	await novel_interface.show_text_only("Todavía medio dormido, me metieron en el coche. En ese momento, todavía estaba protestando por su comportamiento violento.")
	await novel_interface.show_text_only("Pero después de este horrendo viaje, lo único que me queda en la mente es \"menos mal que sigo vivo\"...")
	await novel_interface.show_text_only("El Proyecto Ark comienza hoy, pero tengo muchas ganas de decir que estoy enfermo.")
	await novel_interface.show_text_only("Hace días que me duele el estómago. ¡Maldita sea!")
	await novel_interface.show_text_only("Y siempre tengo ganas de vomitar… ¡Puaj!")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("¿Estás bien, Ren?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saludo a Annie con desdén.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Estoy bien, sólo un poco enfermo. Y no puedo dejar de temblar ahora mismo...", "Lian")
	await novel_interface.show_dialog("¿Puedo tomar otro coche cuando volvamos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunto con voz débil, mirando a Annie suplicante.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Mírate. Estás tan acostumbrada a jugar a la señorita inocente, ¿no?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras me apoyaba contra la pared en busca de apoyo, una voz familiar llega desde atrás. ¡Dios mío! Sólo déjame ir...")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¿Raphael? ¿Por qué estás…?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿No te dijo Mariru que estaría aquí?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Ella no aparecería si lo hiciera.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mirándome como si fuera su mascota en venta, Mariru pasa por alto la pregunta de Raphael.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Te dejo a Ren, \\nSeñorita Dekkers, nuestra querida Representante Ejecutiva de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¡Espera! ¿Dejándome con ella?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sonríe y nos lleva a la entrada de la Base Arca.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("¿Estás seguro de que esta… es la entrada?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frente a nosotros hay una entrada a un sótano de hormigón que da a esta calle en las afueras de la ciudad. La puerta sólo permite el paso de una persona.")
	await novel_interface.show_text_only("No hay ningún edificio en un radio de media milla. Si no hubiera sido por el logo SID grabado en la pared, debí haberlo tomado como un escondite espeluznante para algún pervertido.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Je-je, ven conmigo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("Bajamos las escaleras detrás de la puerta que conduce a un gran montacargas.")
	await novel_interface.show_text_only("Parece que el ascensor está diseñado para entornos extremos. Cuatro gruesas poleas metálicas garantizan un funcionamiento seguro y estable.")
	await novel_interface.show_text_only("A medida que el ascensor desciende suavemente, el sonido de los engranajes girando llega desde todos los rincones.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("Las rejillas de ventilación, las mallas metálicas, los remaches y la luz tenue… Los elementos industriales vintage están por todas partes.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Fiabilidad por encima de todo... He visto diseños similares en la bóveda de oro del Banco Central de Newmoridas.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Vaya, ¿has estado allí?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Fue uno de los proyectos de construcción más grandes del mundo antes de la Guerra de los Siete Años y nos llevó mucho trabajo restaurar este lugar.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru presenta con orgullo esta estructura subterránea.")
	await novel_interface.show_text_only("Raphael tiene razón. El ascensor, aunque sigue funcionando, es tan estable como un enorme trozo de acero sólido. Se me pasa por la cabeza que incluso saltar no causaría el más mínimo nerviosismo en el ascensor.")
	await novel_interface.show_text_only("Acabo de recuperarme del mareo y estoy deseando intentarlo, sólo para encontrar a Raphael mirándome.")
	await novel_interface.show_text_only("Al darme cuenta de que podría estar actuando como un tonto, inmediatamente lo dejo con una mirada avergonzada. Pero volvió su rostro con desdén hacia la ventana de observación.")
	await novel_interface.show_text_only("¿Qué diablos puede ver en la oscuridad?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Por qué me miras?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El ladrón grita ladrón, ¿eh?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Uf... Nunca esperé que Salmonton te enviara aquí.", "Lian")
	await novel_interface.show_dialog("Después de todo, el experimento actual es bastante peligroso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Más importante aún, sé que este experimento es un programa con dos guiones.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(¿Sabe realmente en qué se ha metido, mi señora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me dirijo a Mariru impotente.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("A primera vista, es un proyecto de investigación conjunto entre New Opulentia y Salmonton.", "Mariru")
	await novel_interface.show_dialog("El objetivo es identificar las causas del flujo espacio-temporal y las contramedidas.", "Mariru")
	await novel_interface.show_dialog("Ambas partes deben enviar a una persona calificada y confiable como sujeto humano.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ahora que tu absurdo en el Sky Hotel esa noche ha revelado tu identidad, definitivamente eres la mejor opción para New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me lanza una mirada, provocando un escalofrío en mi columna.")
	await novel_interface.show_text_only("Vamos, he aprendido la lección...")
	novel_interface.character_light()
	await novel_interface.show_dialog("En cuanto a Raphael, nuestra “alta cuna convertida en plebeya” en Gosakuragawa, se ofreció como voluntaria para unirse al experimento en nombre de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Voluntariado?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, el pilar de lapislázuli es muy importante para Salmonton. Nunca dejaría que tu perdedor arruinara esto.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Raphael es capaz de acelerar la autocuración a nivel celular. Así lo ha afirmado Aya.", "Mariru")
	await novel_interface.show_dialog("Pero según Beatrice, será mejor que Raphael trabaje con Ren para aprovechar al máximo su talento.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente se me ocurre que, en el estacionamiento del Sky Hotel, Raphael curó a Annie en un abrir y cerrar de ojos.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Entonces Raphael está de nuestro lado, ¿verdad?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, puedo imaginar tu mirada patética cuando luchas por tu vida. \"Owww... me estoy muriendo... Cúrame ahora...\"", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¿Parece que no puedes esperar a que esto suceda?", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Espera, pensé que era un experimento secreto. \\n¿Cómo lo supo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Se lo dejé todo claro al Dr. Dekkers.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Desde que te vio resucitar a Beatrice, sintió que su cooperación anterior con el Senado iba en la dirección equivocada.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("¿Tiene algo que ver con la religión?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Probablemente no sea tan simple... Pero ahora, Salmonton está dispuesto a trabajar con SID, siempre y cuando Raphael esté a salvo con nosotros.", "Mariru")
	await novel_interface.show_dialog("El Senado no conoce tus verdaderas habilidades. Ésa es la fuerza que debemos aprovechar al máximo.", "Mariru")
	await novel_interface.show_dialog("Una bruja no activa nada cuando toca un fragmento de bruja. Por eso nuestro plan puede funcionar.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Por eso, realmente quiero agradecer a los líderes de ambas partes por hacer que esto suceda.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Estás seguro de que mi caprichoso abuelo no se deja engañar por esto?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Tu abuelo no es tan ingenuo, cariño. La reliquia aquí no es de ninguna manera su elección al azar.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Hemos hecho todo esto para asegurarnos de que el \"experimento real\" se pueda llevar a cabo con éxito.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, si no hubiera sido por la orden de mi abuelo…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael murmuró algo vagamente y sus ojos me pasaron ligeramente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("¡Nunca aceptaría cooperar con este pervertido travestido!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Pero el Dr. Dekkers siempre dice que eres tú quien nunca escucha.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Déjame adivinar... ¿Salmonton está realmente interesado en Heinrich, el propietario original del Pilar de Lapislázuli?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("¡Buena suerte, Ren!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El Senado planea trabajar con Salmonton para producir más brujas a espaldas de SID. Y esta vez quieren verificar la viabilidad de utilizarme como Estabilizador.")
	await novel_interface.show_text_only("Salmonton, sin embargo, ha hecho un trato secreto con Mariru.")
	await novel_interface.show_text_only("En cuanto a Mariru, mantuvo al Senado en la ignorancia sobre nuestras capacidades reales.")
	await novel_interface.show_text_only("Se está poniendo complicado. Esto me está matando...")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(¿Podemos realmente luchar lado a lado?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Echo un vistazo a la autoritaria dama frente a mí.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Transferir Raphael a Gosakuragawa…) \\n(¿también es parte de su plan?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Mira esa cara de estúpida. Debe estar pensando en algo tonto otra vez).", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("El ascensor finalmente se detiene con un sonido de golpe. \\nUna puerta de metal de 35 pies de altura se alza frente a nosotros.")
	await novel_interface.show_text_only("Un rayo láser rojo recorre mi cuerpo desde la cabeza hasta los pies. \\nEn poco tiempo, suena un pitido de confirmación desde la puerta.")
	await novel_interface.show_text_only("Mariru avanza para realizar un escaneo de iris de seguimiento.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Puede que sean anticuados, pero las medidas de seguridad aquí son bastante estrictas…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Cuando terminamos con el escaneo, la puerta gigante desciende lentamente, dejándonos asombrados por el asombroso espacio detrás de la puerta.")
	await novel_interface.show_text_only("El enorme espacio subterráneo está sostenido por dos filas de majestuosos pilares de hormigón.")
	await novel_interface.show_text_only("La base de cada pilar está cubierta con montones de fragmentos de armadura que pueden usarse en ambas direcciones.")
	await novel_interface.show_text_only("Mirando hacia afuera, estos fragmentos pueden proteger la estructura de devastadores ataques con cohetes. Pero si se usan en la dirección opuesta, son capaces de destruir los pilares todos a la vez.")
	await novel_interface.show_text_only("Durante la Guerra de los Siete Años, estos fragmentos de armadura se utilizaron ampliamente en fortalezas que necesitaban ser bloqueadas o destruidas.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Está bastante húmedo aquí...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El suelo está plagado de manchas de agua. En lo alto, docenas de tuberías nuevas están montadas en el techo, emitiendo sonidos de líquido corriendo.")
	await novel_interface.show_text_only("Mariru debe haber puesto mucho esfuerzo para transformar este lugar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Hacia el final del pasillo, nos encontramos frente a un espacio cerrado por losas de metal.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Señoras.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Bienvenidos a la Base Arca.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Yo simplemente... ¡No puedo creer lo que veo!")
	await novel_interface.show_text_only("Lo que tenemos delante es un embalse. Al observar la niebla que se eleva desde el agua reluciente, me siento como si estuviera parado en un muelle.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Solo observe: la escalera de embarque está en camino hacia nosotros.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
