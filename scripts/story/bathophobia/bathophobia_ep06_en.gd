# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Standing poised at the podium, Mariru delivers a comprehensive progress report on recent research during a routine video conference.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Regarding Project Ark…", "Kirs")
	await novel_interface.show_dialog("From the list of relics provided by Salmonton, you've chosen the Tesheim Lapis Pillar, right?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Yes, sir. Now the key is how to create a controllable Flux Area.", "Mariru")
	await novel_interface.show_dialog("All recent cases of Spacetime Fluxes in all academic cities were caused by human contact with items having Substance H properties.", "Mariru")
	await novel_interface.show_dialog("Those items had remained dormant for a long time but were activated at almost the same time.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(More precisely, Witch's Shards and Grimoire Fragments. But I'd better explain it in layman's terms.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("You mean the day the Ross Goblet disappeared…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("We cannot confirm their connection yet.", "Mariru")
	await novel_interface.show_dialog("Because there are too many uncontrollable factors, we have to filter all the relics by two criteria.", "Mariru")
	await novel_interface.show_dialog("First, it has to be a low-activity substance exhibiting Substance H properties according to hue scanning.", "Mariru")
	await novel_interface.show_dialog("Second, the original owner is traceable in historical records, and this person must not have any tendencies of violence or committing criminal acts.", "Mariru")
	await novel_interface.show_dialog("The Tesheim Lapis Pillar was originally owned by Heinrich Khunrath, a physician and alchemist during the Renaissance.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Low activity… What a pity… I expected we could collect data closer to the critical value this time.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("The sample is too precious to lose. It’s better to stay on the safe side.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(I just need to prove Ren's ability to pass through flux areas. For that, we just need to put on an act.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(In fact, the Tesheim Lapis Pillar is not a Witch's Shard) \\n(It’s just a quasi Substance H with magic inscriptions on it.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Touching a Witch's Shard is way too dangerous for ordinary people.) \\n(After all, I'm not the gorilla man…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A peal of deep laughter comes out from the screen.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alchemist… A pioneer of science, huh? \\nWhat an interesting choice.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("I heard it was an art piece of great historical significance, and the owner Heinrich was one of the founders of the Rosenkreutz…", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("The Rosenkreutz was just a religious and occult group. It has nothing to do with the current intelligence agency of Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("I guess alchemists can be seen as the scientists of that era. Hopefully, he was a man in awe of the unknown.", "Mariru")
	await novel_interface.show_dialog("But you know Dr. Dekkers well. He would never lend us such an important relic without a cost, unless…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A weird silence fills the room.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("That's right. The Salmonton side wants data sharing plus a representative in our team.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(So, they haven't given up on producing more witches…) \\n(Do they want to use Ren as a Stabilizer?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Well noted. I just want to confirm that everyone, including the Salmonton side, understands the danger of this experiment.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Affirmative. We've transformed the old capital's mega underground drainage facilities into the Ark Base, just in case the worst scenario happens.", "Kirs")
	await novel_interface.show_dialog("The ultra-speed seawater intrusion system can inundate the entire base within 30 seconds.", "Kirs")
	await novel_interface.show_dialog("If anything goes wrong during the experiment…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("In that case, I hope our dear Mariru has the guts to start the emergency self-destruct device.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
