# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("Debout au pupitre, Mariru présente un rapport d'avancement complet sur les recherches récentes lors de la vidéoconférence habituelle.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Concernant le projet Ark…", "Kirs")
	await novel_interface.show_dialog("Dans la liste des reliques fournies par Salmonton, vous avez choisi le pilier Tesheim Lapis, n'est-ce pas ?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Oui, monsieur. La clé est maintenant de savoir comment créer une zone de flux contrôlable.", "Mariru")
	await novel_interface.show_dialog("Tous les cas récents de flux spatio-temporels dans toutes les villes universitaires ont été causés par un contact humain avec des objets ayant des propriétés Substance H.", "Mariru")
	await novel_interface.show_dialog("Ces éléments étaient restés inactifs pendant longtemps mais ont été activés presque en même temps.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Plus précisément, Witch's Shard et Grimoire Fragments. Mais je ferais mieux de l'expliquer en termes simples.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Tu veux dire le jour où le Ross Goblet a disparu…", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Nous ne pouvons pas encore confirmer leur connexion.", "Mariru")
	await novel_interface.show_dialog("Parce qu'il y a trop de facteurs incontrôlables, nous devons filtrer toutes les reliques selon deux critères.", "Mariru")
	await novel_interface.show_dialog("Premièrement, il doit s’agir d’une substance de faible activité présentant les propriétés Substance H selon l’analyse des teintes.", "Mariru")
	await novel_interface.show_dialog("Deuxièmement, le propriétaire d'origine est traçable dans les documents historiques et cette personne ne doit avoir aucune tendance à la violence ou à commettre des actes criminels.", "Mariru")
	await novel_interface.show_dialog("Le pilier de Tesheim Lapis appartenait à l'origine à Heinrich Khunrath, médecin et alchimiste de la Renaissance.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Faible activité… Quel dommage… Je m'attendais cette fois à ce que nous puissions collecter des données plus proches de la valeur critique.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("L'échantillon est trop précieux pour être perdu. Il vaut mieux rester prudent.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Je dois juste prouver la capacité de Ren à traverser les zones de flux. Pour cela, nous devons juste jouer un rôle.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(En fait, le pilier de Tesheim Lapis n'est pas un éclat de sorcière) \\n(C'est juste un quasi Substance H avec des inscriptions magiques dessus.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Toucher un éclat de sorcière est bien trop dangereux pour les gens ordinaires.) \\n(Après tout, je ne suis pas l'homme gorille…)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un éclat de rire profond sort de l'écran.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alchimiste… Un pionnier de la science, hein ? \\nQuel choix intéressant.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("J'ai entendu dire qu'il s'agissait d'une œuvre d'art d'une grande importance historique et que le propriétaire Heinrich était l'un des fondateurs du Rosenkreutz…", "Éloïse")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Les Rosenkreutz n'étaient qu'un groupe religieux et occulte. Cela n'a rien à voir avec l'agence de renseignement actuelle de Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Je suppose que les alchimistes peuvent être considérés comme les scientifiques de cette époque. Espérons que c’était un homme impressionné par l’inconnu.", "Mariru")
	await novel_interface.show_dialog("Mais vous connaissez bien le Dr Dekkers. Il ne nous prêterait jamais une relique aussi importante sans frais, à moins que…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un étrange silence remplit la pièce.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("C'est vrai. Le côté Salmonton souhaite le partage de données ainsi qu'un représentant dans notre équipe.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Donc, ils n'ont pas renoncé à produire plus de sorcières…) \\n(Veuvent-ils utiliser Ren comme stabilisateur ?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Bien noté. Je veux juste confirmer que tout le monde, y compris le côté Salmonton, comprend le danger de cette expérience.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Affirmatif. Nous avons transformé les méga-installations de drainage souterraines de l'ancienne capitale en base Ark, juste au cas où le pire scénario se produirait.", "Kirs")
	await novel_interface.show_dialog("Le système d'intrusion d'eau de mer ultra-rapide peut inonder toute la base en 30 secondes.", "Kirs")
	await novel_interface.show_dialog("Si quelque chose ne va pas pendant l’expérience…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Dans ce cas, j'espère que notre cher Mariru aura le courage de démarrer le dispositif d'autodestruction d'urgence.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
