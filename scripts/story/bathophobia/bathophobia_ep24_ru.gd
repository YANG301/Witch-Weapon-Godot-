# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Милк возвращается в диспетчерскую и запирает главную дверь стулом.")
	await novel_interface.show_text_only("Ближайшая группа врагов прибудет через несколько минут. Другая группа также скоро наткнется на отряд Милка в восточном крыле.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Хм. Мне следовало подумать об этом раньше...","Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Если бы у меня был собственный отряд чрезвычайно ловких солдат с острым слухом и невероятными способностями к самоисцелению...")
	await novel_interface.show_text_only("Зачем вооружать их клинками, а не огнестрельным оружием?")
	await novel_interface.show_text_only("Эти враги движутся группами, не имеют никакой стратегии, хотя все они безумно эффективные бойцы.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Их больше нельзя считать людьми, этих девочек...","Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Милк бросает взгляд на ряд оборудования слева от главной панели управления. На нем стоит коробка с образцами, которую оставила Бет.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Миссия... больше не имеет значения.","Молоко")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Думаю, применяемые здесь меры стратегической наступательной обороны не так уж и плохи...","Молоко")
	await novel_interface.show_dialog("Надеюсь, динамик все еще работает...","Молоко")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она делает глубокий вдох, успокаивается, прежде чем набрать серию команд на панели управления....")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Тем временем на темном складе Бет порхает по комнате, лихорадочно ища то, чего там может даже не быть.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("Пароль... \\nКакой пароль?","Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ее пальцы дрожат, и она уже почти не представляет, какие клавиши нажимает на панели замка.")
	await novel_interface.show_text_only("Если она правильно введет пароль, она сможет выйти из склада и сражаться вместе со своим другом.")
	await novel_interface.show_text_only("Но Милк по ту сторону стены не оставил никаких намеков на то, каким может быть пароль.")
	await novel_interface.show_text_only("Возможно, она больше никогда не оставит ей подсказки...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Нет! Нет!\\nЯ не могу это принять! Я не приму этого!","Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В ярости Бет продолжает стучать в дверь кулаками, но ее попытки вырваться тщетны.")
	await novel_interface.show_text_only("Все, что она может сделать, это представить, что произойдет дальше по другую сторону стены, в одиночестве в темном, тихом, замкнутом пространстве.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Пожалуйста, нет...","Бет")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Я бесполезен... )","Бет")
	await novel_interface.show_dialog("(Невозможно никого спасти... )","Бет")
	await novel_interface.show_dialog("(Не Отец..., не Молоко... )","Бет")
	await novel_interface.show_dialog("(Как... это произошло... ?)","Бет")
	await novel_interface.show_dialog("(Почему я такой слабый... ?)","Бет")
	await novel_interface.show_dialog("(Так беспомощен... )","Бет")
	await novel_interface.show_dialog("(... И эгоистично.)","Бет")
	await novel_interface.show_dialog("(Почему?)","Бет")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("Все, что я хочу, это не быть одиноким и не холодным...")
	await novel_interface.show_text_only("Я не прошу слишком многого, я __ЭЛЛИПСИС__ ?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка сидит одна в темноте, ее плечи трясутся от рыданий.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Она почти не замечает, что непрерывный напряженный бой изнурил ее тело до глубины души.")
	await novel_interface.show_text_only("Декомпрессионная болезнь запутывает ее мозг.")
	await novel_interface.show_text_only("В ее голове как будто бурлит вода, постепенно воздействуя на ее сознание.")
	await novel_interface.show_text_only("Возможно, она не видела этого, находясь в темном глубоком океане, в конце концов...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("У нее такое ощущение, будто она на вершине ледника – нет, внутри одного из них. Лед, острый и плотный, пронзает ее сердце, ее душу.")
	await novel_interface.show_text_only("Ее гибкое тело мало-помалу замерзает, а кровь начинает застывать.") #换行问题
	await novel_interface.show_text_only("Бесчисленные группы чистого света окружали ее, пока полностью не покрыли ее существование.")
	await novel_interface.show_text_only("Больше нет боли, нет одиночества.")
	await novel_interface.show_text_only("Нет больше.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("В этом чисто-белом мире она слышит знакомую мелодию.")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Молоко?","Бет")
	await novel_interface.show_text_only("Это их любимая песня. Их песня.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("Во взрывном взрыве из тела Бет вылетают сотни светящихся шаров.")
	await novel_interface.show_text_only("Девушка моргает, открывает глаза. Ослепительный белый свет оглушительным грохотом снес всю стену.")
	await novel_interface.show_text_only("Из динамика в диспетчерской играет их песня, эхом разносящаяся по всему туннелю. Милк, должно быть, использовала аудиофайл, хранящийся в ее часах.")
	await novel_interface.show_text_only("Собрались десятки врагов, привлеченные звуком. Их так много, гораздо больше, чем они рассчитывали на экране.")
	await novel_interface.show_text_only("Враги окружили вход в диспетчерскую.")
	await novel_interface.show_text_only("Бет сейчас находится всего в тридцати метрах от диспетчерской.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(Все, что мне нужно, это десять секунд... нет, пять... )","Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пять секунд, чтобы связаться с ее лучшей подругой-идиоткой и помешать ей сделать то, что она собирается сделать.")
	await novel_interface.show_text_only("Большая группа солдат-паразитов немедленно кинулась к Бай Чжу, и несколько острых клинков внезапно атаковали ее сзади.")
	await novel_interface.show_text_only("Она разворачивается, выпуская несколько пуль в виде ярких лучей света, разбивая свои цели на стене вдребезги.")
	await novel_interface.show_text_only("Она продолжает мчаться к диспетчерской, ее тело сияет светом, ярче, чем когда-либо прежде.")
	await novel_interface.show_text_only("Энергетические волны, исходящие от ее тела, разрывают внутренние стены туннеля. Она сияет ослепительно, как реквием с Небес.")
	await novel_interface.show_text_only("Теперь никто не сможет остановить ее.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("Бесчисленные ослепительные белые лучи исходят из базы Снедроннинген, освещая звездное небо, как будто на дремлющий континент опустился рассвет.")
	await novel_interface.show_text_only("Почти как обряд приветствия божества.")
	await novel_interface.show_text_only("Внезапно весь континент начинает трястись...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("Всего за несколько секунд Бет уничтожила десятки врагов одновременно. Она падает назад, зрение затуманивает яркий свет.")
	await novel_interface.show_text_only("Сила, исходящая из ее тела, близка к тому, чтобы поглотить ее целиком.")
	await novel_interface.show_text_only("Когда она отбрасывает врага с помощью клинка в правой руке...")
	await novel_interface.show_text_only("Дюжина врагов прорывается через заклинившую дверь диспетчерской и врывается внутрь.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Подожди меня... идиот...","Бет")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("«Я иду __ЭЛЛИПСИС__»")
	await novel_interface.show_text_only("Бум!")
	await novel_interface.show_text_only("Из диспетчерской вылетает гигантская электрическая дуга. Затем происходят взрывы, бесчисленные пылающие взрывы в секунду, прямо перед глазами Бет.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Как будто время остановилось.")
	await novel_interface.show_text_only("Она останавливается как вкопанная, падая на колени всего в нескольких метрах от диспетчерской.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("Именно тогда этот ледяной континент, безжалостный и холодный, наконец, открывает глаза от бесконечного сна.")
	await novel_interface.show_text_only("Во тьме золотая тень вырывается из подземных слоев льда, прорывает землю тоннеля, бесшумно пронзает туловище девушки.")
	await novel_interface.show_text_only("Это копье выглядело бы просто, если бы не замысловатые золотые узоры, кружащиеся вокруг наконечника копья.")
	await novel_interface.show_dialog("…","Бет")
	await novel_interface.show_text_only("Тёплый поток тепла пересек наконечник пистолета, последовал за корпусом пистолета и слился с кровью.")
	await novel_interface.show_text_only("Ее руки безвольно падают по бокам. Несмотря на то, что ее зрачки расширяются, она смотрит так, словно еще не готова сдаваться.")
	await novel_interface.show_text_only("На земле алая кровь.")
	await novel_interface.show_text_only("Капать. Капать. Капать.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Яркий свет, окутывающий континент, меркнет.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
