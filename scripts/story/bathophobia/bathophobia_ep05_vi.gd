# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("Linh hồn là gì?")
	await novel_interface.show_text_only("Một dạng năng lượng bảo tồn ý thức? Hay một trạng thái lượng tử không thể quan sát được?")
	await novel_interface.show_text_only("Hay chỉ là một khái niệm…")
	await novel_interface.show_text_only("Giống như khái niệm thời gian trong vật lý—")
	await novel_interface.show_text_only("Có lẽ đó chỉ là ảo ảnh… một giấc mơ.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Vậy thì câu hỏi là—")
	await novel_interface.show_text_only("Người nằm mơ là ai?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("Cái lạnh buốt giá ở Hội tụ Nam Cực ngăn chặn mọi tiếng ồn từ thế giới bên ngoài.")
	await novel_interface.show_text_only("Ở độ cao 20.000 ft dưới mực nước biển là vùng vực thẳm.")
	await novel_interface.show_text_only("Được bọc trong lớp vỏ chịu áp bằng titan, một chiếc tàu ngầm dưới biển sâu đang từ từ hạ xuống.")
	await novel_interface.show_text_only("Ánh sáng mờ nhạt phát ra từ đèn báo trạng thái của nó nhanh chóng bị nhấn chìm trong bóng tối sâu thẳm.")
	await novel_interface.show_text_only("Không có ánh sáng, nó không thể cảm nhận được không gian.")
	await novel_interface.show_text_only("Một con răng nanh đáng sợ cố gắng đâm vào thân tàu nhưng không nhận được phản hồi.")
	await novel_interface.show_text_only("Áp lực nước 60 MPa đặt giới hạn ứng suất nén của thân tàu vào thử nghiệm.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("Đột nhiên, tám đèn pha được lập trình sẵn được bật đồng thời, chiếu tám chùm ánh sáng hẹp thẳng.") #换行问题
	await novel_interface.show_text_only("Giống như những thanh kiếm sắc bén, đèn pha phát ra ánh sáng chói lóa và xuyên qua bóng tối.")
	await novel_interface.show_text_only("Một tia sáng xuyên qua khung cửa sổ dày của phòng điều khiển và chiếu thẳng vào mặt một cô gái đang ngủ.")
	await novel_interface.show_text_only("Mái tóc dài màu xám đen của cô, tỏa sáng với ánh xanh lam, rải rác trên khuôn mặt nhợt nhạt nhưng trong sáng của cô.")
	await novel_interface.show_text_only("Máy đo độ sâu trên bảng điều khiển phía trước cô gái ngừng hoạt động ở độ cao 4091 ft.")
	await novel_interface.show_text_only("Ánh đèn pha ngoài phòng mờ dần. Nhưng một tia sáng bạc mờ nhạt bắt đầu lập lòe xung quanh cơ thể cô gái.")
	await novel_interface.show_text_only("Từ vực sâu của đại dương mà con người vô cùng sợ hãi, một giọng nói trầm và xa xăm vang lên.")
	await novel_interface.show_text_only("Giống như tiếng gọi của một con quái vật cổ xưa.")
	await novel_interface.show_text_only("Cô gái đang ngủ dường như được đánh thức từ trong bụng mẹ.")
	await novel_interface.show_text_only("Đồng thời thức tỉnh là cảm giác chóng mặt và buồn nôn không thể kiểm soát được…")
	await novel_interface.show_text_only("Ở dưới độ sâu an toàn 15.000 ft, thân tàu kim loại bắt đầu phát ra âm thanh nứt bất thường.")
	await novel_interface.show_text_only("Một cơn ho bị kìm nén phát ra từ cổ họng cô gái.")
	await novel_interface.show_text_only("Ban đầu cô ấy hơi khó thở nhưng nhanh chóng thích nghi với áp lực dưới nước và ổn định hơi thở.")
	await novel_interface.show_dialog("Vụ va chạm vừa rồi… Có vẻ như đã đánh gục tôi.", "cô gái")
	await novel_interface.show_dialog("Nhưng tôi vẫn có thể thở được… Phải có đủ oxy.", "cô gái")
	await novel_interface.show_dialog("Tôi có thể nhìn thấy hơi thở của mình… \\nChắc chắn là gần 32 °F…", "cô gái")
	await novel_interface.show_dialog("Kiểm tra hệ thống. Sẵn sàng khởi động nguội. \\nThông tin nhận dạng: Beth.", "cô gái")
	await novel_interface.show_text_only("Cô gái tên Beth dường như không lo lắng về nhiệt độ lạnh cóng. Cô ấy chăm chú kiểm tra hệ thống.")
	await novel_interface.show_text_only("Cô được sinh ra với khả năng chịu được cái lạnh cực độ. Khi bé Beth được tìm thấy ở vùng núi mùa đông, bé đã trải qua cả đêm trên băng.")
	await novel_interface.show_text_only("Một số cuộc kiểm tra thể chất đã chứng minh rằng cô gái thần kỳ có thể thích nghi với nhiều môi trường lạnh giá khác nhau.")
	await novel_interface.show_text_only("Dưới cái lạnh dữ dội có thể khiến người lớn bất tỉnh trong vòng 30 giây, nhiệt độ cơ thể vẫn bình thường và tay vẫn ấm.")
	await novel_interface.show_text_only("Các bác sĩ không thể tìm ra lý do tại sao trước khi cô bị cha nuôi đưa khỏi trại trẻ mồ côi.")
	await novel_interface.show_dialog("Hệ thống chiếu sáng và động cơ… khởi động bình thường. Khởi động lại cảm biến… tất cả đều tốt.", "Beth")
	await novel_interface.show_dialog("Nó đã sâu 20.000 ft chưa? “Thứ đó” không thể tồn tại dưới áp lực nước cao như vậy được.", "Beth")
	await novel_interface.show_dialog("Tôi phải tiết kiệm năng lượng cho chuyến về… Tắt đèn pha—", "Beth")
	await novel_interface.show_text_only("Ngay khi đèn pha vừa tắt, Beth nhìn ra ngoài cửa sổ.")
	await novel_interface.show_dialog("Cái gì…", "Beth")
	await novel_interface.show_text_only("Một cảnh rùng rợn khiến cô dựng tóc gáy.")
	await novel_interface.show_dialog("Cái gì… cái đó…", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ngay trước khi đèn pha tắt, một cấu trúc giống san hô khổng lồ xuất hiện bên ngoài cửa sổ quan sát.")
	await novel_interface.show_text_only("Nó là một cấu trúc giống như mô hướng tâm. Trên đó, những mạch máu không đều trông giống như một dòng thác đỏ tươi rơi vào một lỗ đen khổng lồ.")
	await novel_interface.show_text_only("Nhưng không có cấu trúc sinh học hoặc địa hình nào được tìm thấy trong quá trình quét vừa rồi.")
	await novel_interface.show_text_only("Beth ngay lập tức bật ống kính góc rộng trên thân tàu, cố gắng chụp một góc nhìn rộng hơn—")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Trên màn hình xuất hiện một cái bóng to lớn và đầy sương mù. Nó dài hơn 300 ft và có các xúc tu.")
	await novel_interface.show_dialog("Điều này không thể được…", "Beth")
	await novel_interface.show_text_only("Nó không phải là một phần của cảnh quan, mà chắc chắn là một loại sinh vật nào đó. Những đốm sáng màu đỏ đang tỏa sáng trong bóng tối.")
	await novel_interface.show_dialog("Đó có phải là… nhãn cầu không?", "Beth")
	await novel_interface.show_text_only("—Nếu thứ kì lạ đó có thể được gọi là \"nhãn cầu\".")
	await novel_interface.show_text_only("Lỗ đen đối diện với cửa sổ chính là con ngươi của nhãn cầu.")
	await novel_interface.show_text_only("Nó quá gần để xác định khoảng cách. Thân tàu dường như có thể bị hút vào con ngươi bất cứ lúc nào.")
	await novel_interface.show_text_only("Những đốm đỏ mờ dần. Cô gái hiện đang đối mặt với vật thể lạ trong bóng tối tĩnh lặng.")
	await novel_interface.show_text_only("Khi mắt cô thích ứng với bóng tối, cô nhìn thấy trên màn hình một nhãn cầu khổng lồ phát ra ánh sáng đỏ nhạt, giống như một con sứa mờ đục.")
	await novel_interface.show_text_only("Nhãn cầu chứa đầy các khối mô vặn vẹo. \\nNó đang đập cùng nhịp tim với cô.")
	await novel_interface.show_dialog("(Thư giãn… thư giãn!) \\n(Hãy nghĩ về điều đó…)", "Beth")
	await novel_interface.show_text_only("Nếu đó là nhãn cầu, thấu kính tinh thể của nó sẽ nhạy cảm với ánh sáng.")
	await novel_interface.show_text_only("Ở lớp ngoài của nhãn cầu, nơi lẽ ra phải có màng mạch, có những đám đốm trắng nhấp nháy.")
	await novel_interface.show_text_only("Beth nhận thấy những xúc tu giống như cành cây được gắn vào mặt sau của nhãn cầu.")
	await novel_interface.show_text_only("Những xúc tu màu xám đen cắm sâu vào đáy biển, không thấy điểm cuối.")
	await novel_interface.show_dialog("(…Tôi không thể…di chuyển…)", "Beth")
	await novel_interface.show_text_only("—Beth có cảm giác mình bị theo dõi, hơn là đang đối đầu với thứ đó.")
	await novel_interface.show_text_only("Ánh mắt xâm phạm làm xói mòn sự bình tĩnh của cô và khiến cô sợ hãi.")
	await novel_interface.show_dialog("Giúp đỡ…", "Beth")
	await novel_interface.show_text_only("—Nó sẽ nuốt chửng mọi thứ à?")
	await novel_interface.show_text_only("Cảm giác kỳ lạ khi ở sâu dưới đại dương khiến cô nghi ngờ chính sự tồn tại của mình.")
	await novel_interface.show_dialog("(Có phải là mơ không…?) \\n(Dậy đi, nhanh lên…)", "Beth")
	await novel_interface.show_text_only("Cơ thể cô phản ứng theo bản năng trước khi ý thức kịp theo.")
	await novel_interface.show_text_only("Khi cô gái kéo cần điều khiển bằng tay trái, buồng lặn tiếp tục di chuyển một khoảng nhất định về phía nhãn cầu.")
	await novel_interface.show_text_only("Dòng nước trở nên dữ dội, như thể thứ đó vừa bị khuấy động.")
	await novel_interface.show_text_only("Đồng tử co lại, chờ đợi động tác tiếp theo của cô gái.")
	await novel_interface.show_dialog("A lô? A lô?", "Beth")
	await novel_interface.show_text_only("Beth chộp lấy tai nghe và cố gắng kết nối với bàn điều khiển.")
	await novel_interface.show_text_only("Nhưng không có sóng điện từ nào có thể thoát khỏi độ sâu này và việc liên lạc bằng âm thanh dưới nước hiện không khả thi.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Nếu cô ấy ở đó… Cô ấy sẽ hét vào mặt tôi— \\n\"Đừng lại gần nữa!\"")
	await novel_interface.show_dialog("Ha… tại sao tôi lại nghĩ đến chuyện này…", "Beth")
	await novel_interface.show_dialog("Ai là... \"Cô ấy\"?", "Beth")
	await novel_interface.show_dialog("tôi… đang ở đâu…", "Beth")
	await novel_interface.show_text_only("Bị con mắt khổng lồ nhìn chằm chằm, Beth ngơ ngác. Ranh giới giữa thực và ảo đang dần mờ đi.")
	await novel_interface.show_text_only("Cô ấy đưa tay sờ khắp bảng điều khiển.")
	await novel_interface.show_text_only("Cô ấy sớm xác định được bộ điều khiển cánh tay robot.")
	await novel_interface.show_dialog("(Tôi có thực sự phải…)", "Beth")
	await novel_interface.show_text_only("Cô lấy lại hơi thở, nhưng ánh sáng ảo ảnh vẫn tiếp tục lóe lên trước mắt cô.")
	await novel_interface.show_dialog("Lấy vài mẫu…Rồi rút ngay…", "Beth")
	await novel_interface.show_text_only("Đầu tiên, hướng đèn pha về phía trước…")
	await novel_interface.show_text_only("Sau đó, thiết lập hệ thống đẩy… tốc độ tối đa. Hướng… đảo ngược.")
	await novel_interface.show_text_only("Đang loay hoay hoàn thành việc cấu hình trước, cô gái gần như sắp bất tỉnh.")
	await novel_interface.show_dialog("Thưa cha, đây có phải là… ô nhiễm tinh thần… \\nCon gần như…", "Beth")
	await novel_interface.show_text_only("Beth vận hành bộ điều khiển từ từ để nhả cánh tay robot. Một cây kim khổng lồ lộ ra.")
	await novel_interface.show_dialog("Bật chế độ hút… Dưới áp lực như vậy, chỉ cần hút nhanh một lần là đủ…", "Beth")
	await novel_interface.show_text_only("Cánh tay robot duỗi về phía trước cho đến khi kim đâm vào thủy tinh thể.")
	await novel_interface.show_text_only("Mức độ tập trung của thùng chứa tăng từ 0 lên 100% ngay lập tức.") #标点删除
	await novel_interface.show_text_only("Trong chốc lát, đồng tử bị méo mó. Nếu âm thanh có thể xuyên qua thân tàu, cô ấy chắc chắn đã nghe thấy một tiếng hét chói tai…")
	await novel_interface.show_dialog("(Tôi đang nghe thấy gì đó…)", "Beth")
	await novel_interface.show_text_only("Với nỗ lực cuối cùng, cô gái nhấn nút thực hiện đã được lập trình.")
	await novel_interface.show_text_only("Theo chương trình cài sẵn, đèn rọi chiếu tám chùm ánh sáng cực mạnh vào đồng tử và cánh quạt bắt đầu quay dữ dội.")
	await novel_interface.show_text_only("Nhãn cầu lùi lại khi có sự kích thích của ánh sáng, và thân tàu bắt đầu lùi lại và nhô lên…")
	await novel_interface.show_text_only("Hoàn toàn kiệt sức, cô gái bất tỉnh và ngã xuống đất.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
