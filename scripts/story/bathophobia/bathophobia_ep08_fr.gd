# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Alors que Mariru tape sur son combiné, un profond grondement vient des profondeurs du réservoir. Le niveau de l’eau baisse à mesure que l’écluse sous-marine s’ouvre.")
	await novel_interface.show_text_only("Apparemment, le réservoir fait plus de 30 pieds de profondeur et le barrage est instantanément devenu une falaise.")
	await novel_interface.show_text_only("À mesure que le niveau de l’eau baisse, un monument bleu surgit de la plate-forme située de l’autre côté de la falaise.")
	await novel_interface.show_text_only("Alors que les lumières environnantes s'allument les unes après les autres, la forme de ce monument est indubitable : il s'agit du pilier de Tesheim Lapis.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Waouh…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De l’autre côté se trouve un espace gigantesque plus large qu’un terrain de football standard. Des rangées de piliers, hauts de plusieurs dizaines, voire centaines de pieds, bordent l’espace dans l’obscurité.")
	await novel_interface.show_text_only("À près de 300 pieds d’altitude, les lucarnes peuvent à peine révéler leurs environs et l’extrémité reste sombre.")
	await novel_interface.show_text_only("L’ampleur exagérée de la structure semble terriblement intimidante.")
	await novel_interface.show_text_only("Les indicateurs clignotants aux quatre coins de la plateforme rappellent la présence d'un bouclier de protection électromagnétique.")
	await novel_interface.show_text_only("Une passerelle s'étend lentement vers nous.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… Génial !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela me rappelle la scène d'ouverture d'un jeu de tir.")
	await novel_interface.show_text_only("Nous suivons Mariru et marchons sur un escalier réactif vers le pupitre de contrôle.")
	await novel_interface.show_text_only("Les marches, généralement cachées dans le mur, n'apparaissent que lorsque quelqu'un s'apprête à marcher dessus.")
	await novel_interface.show_text_only("L'escalier semble être conçu pour empêcher les personnes d'approcher ou de quitter le pupitre de contrôle.")
	await novel_interface.show_text_only("Je regarde autour de moi et remarque au plafond quelques fentes de tir fermées pour de petites armes lourdes.")
	await novel_interface.show_text_only("En repensant à la façon dont nous en sommes arrivés là, j’essaie de visualiser la structure de cette immense installation souterraine.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… Vous avez dû y investir des milliards de dollars.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("La rénovation n'est pas une tâche facile, mais c'est le seul choix que nous avons si nous voulons respecter les normes de sécurité et respecter les délais du projet Ark.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Selon les normes de sécurité, Mariru signifie la capacité de se défendre contre d'éventuelles menaces telles que des sorcières puissantes mais hostiles.")
	await novel_interface.show_text_only("Pour assurer la sécurité des Cités Académies, le Sénat exige que ces installations soient capables de gérer et d'éliminer de telles menaces.")
	await novel_interface.show_text_only("Cependant, face à des menaces inconnues, ces normes ne feraient, au mieux, que fournir des coussins psychologiques.")
	await novel_interface.show_text_only("C'est ce qu'a dit Mariru lors de la réunion d'exploitation.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Qu'est-ce que tu attends ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que nous approchons du pupitre de contrôle, j'hésite encore à monter les escaliers qui mesurent plus de 30 pieds de haut, même si je sais que les marches suivront le mouvement de mes pieds.")
	await novel_interface.show_text_only("Sur la plate-forme devant, le pilier de Lapis se dresse là, plus grand que moi et soutenu par quatre grandes pinces.")
	await novel_interface.show_text_only("Je me sens complètement bouleversé de voir le pilier en personne. Les photos en ligne n'ont rien à comparer.")
	await novel_interface.show_text_only("La surface de ce monument turquoise translucide est remplie de motifs inscrits de fines lignes.")
	await novel_interface.show_text_only("Il s’agit apparemment de symboles disposés selon un certain ordre logique, mais jusqu’à présent, les archéologues n’ont pas réussi à les déchiffrer.")
	await novel_interface.show_text_only("Cercles concentriques, arbres, contours : plutôt que des codes significatifs, ils semblent transmettre des concepts plus directement.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ce doit être un trésor national… Peut-être devrions-nous essayer d’autres artefacts de moindre importance lors de notre première expérience…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Hein ? Effrayé?", "Raphael")
	await novel_interface.show_dialog("Si vous ratez ça, vous savez à quoi vous attendre, n'est-ce pas ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l prévient.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Non, bien sûr que non. Cela me semble trop extravagant…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("OK, désactivons maintenant le bouclier électromagnétique.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru tire doucement sur le levier rouge du pupitre de commande. Les lumières rouges aux coins du dispositif de protection s'éteignent d'un seul coup.")
	await novel_interface.show_text_only("Un bourdonnement frappe soudain mon cuir chevelu, comme si un faible courant traversait mon cerveau.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Tout va bien ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("C'est peut-être l'inscription magique, mais…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fixe mes yeux sur le pilier de Lapis. Quelque chose ne va pas.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("On dirait que votre corps est très sensible.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, pas devant…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je jette un coup d'œil à Rapha?l, qui me lance ce regard de « pervers ».")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Ce que tu dis est trompeur !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Pour notre sécurité, je vais répéter les instructions sur la façon de faire fonctionner le bouclier électromagnétique.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru fait signe à Rapha?l et Annie de se diriger vers le pupitre de commande, puis se tourne vers moi.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Le spectacle est lancé ?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Il y a des dizaines de capteurs et de caméras à spectre complet sur ce poste de contrôle et les piliers environnants. Ils sont configurés pour fonctionner automatiquement lorsque le boîtier de protection est ouvert.", "Mariru")
	await novel_interface.show_dialog("Les données et les images seront directement envoyées à la salle d'observation et partagées avec les instituts de recherche basés sur Salmonton après l'expérience.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru me fait un clin d'œil.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Comme si vous le feriez…) \\n(Vous avez évidemment préparé de fausses données…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je lève les yeux vers la salle d'observation au sommet des piliers adjacents.")
	await novel_interface.show_text_only("Le verre antidéflagrant unidirectionnel ne montre aucune trace de personne derrière lui et reflète simplement froidement les lumières environnantes.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ces sénateurs devraient être derrière tout ça…)", "Lian")
	await novel_interface.show_dialog("(J'espère que nous pourrons les tromper…)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Le boîtier de protection et la jetée peuvent être facilement contrôlés avec cet interrupteur mécanique et cette manivelle.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Suivant les instructions de Mariru, Annie parcourt chaque bouton et interrupteur du pupitre de commande.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Je n'ai pas vu d'interrupteurs mécaniques depuis un moment, et une manivelle ici… \\nPourquoi utilisez-vous ces appareils anciens ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Les dispositifs mécaniques sont généralement les solutions les plus stables. Il suffit de braver le coup.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Alors, avant que je parte pour la salle de commandement, tu veux demander quelque chose ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Sommes-nous… Sommes-nous sur le point de commencer ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mon cœur bat à tout rompre. Je prends quelques respirations profondes.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Nerveux ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Semblant avoir remarqué mon malaise, Mariru enroule son bras autour de mon dos et me dit doucement.")
	await novel_interface.show_text_only("Un tel comportement intime devant les autres me brûle le visage.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Un… Un peu…", "Lian")
	await novel_interface.show_text_only("Mon cœur bat plus vite !")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Monter un spectacle, ce n'est vraiment pas mon truc ! Quand j'étais enfant, mon seul rôle d'acteur était dans La Case de l'oncle Tom. Et j'étais la cabane.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lève les yeux vers la salle d'observation.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oui ?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Son souffle engourdit mon oreille. C'est comme si un nerf partait de l'arrière de mon oreille, transmettant l'engourdissement dans tout mon corps en descendant jusqu'à mes talons.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Détendez-vous, les sénateurs ne remarqueront rien.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me chuchote à l'oreille.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Il y a une couche de camouflage optique à environ 70 pieds au-dessus de ma tête.", "Mariru")
	await novel_interface.show_dialog("Et les vitres de la salle d'observation sont traitées, pour qu'ils ne voient que ce qu'ils « devraient » voir…", "Mariru")
	await novel_interface.show_dialog("Une fois que Rapha?l aura fermé le boîtier de protection, vous disparaîtrez devant eux comme si vous étiez entré dans la zone de flux.", "Mariru")
	await novel_interface.show_dialog("Après cela, il vous suffit d’essayer de toucher le pilier de Lapis. Ce n'est pas grave si vous ne pouvez pas appeler les sorcières comme nous l'avions prévu.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'entends un rire, puis Mariru souffle une bouffée d'air dans mon oreille. \\nLe nerf que je viens de remarquer proteste à nouveau vigoureusement.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Mais si quelque chose de grave est signalé... \\nVous savez comment gérer le pire des cas, n'est-ce pas ?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("J'avale brièvement.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dès que les capteurs atteignent la valeur seuil, les programmes de blocage et de destruction seront déclenchés…", "Lian")
	await novel_interface.show_dialog("Dans les 5 secondes, nous devons emprunter la trappe à l'étage à votre droite et entrer dans la zone de ségrégation souterraine.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je jette un coup d'œil au chemin d'urgence que nous avons prévu lors de la réunion d'opération.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Pour être précis, vous ne disposez que de 4,8 secondes.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(La base entière sera instantanément inondée d'eau de mer) \\n(Sans parler du système d'armement au-dessus de ma tête…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Mais d’après ma vérification des antécédents sur le pilier Lapis…", "Mariru")
	await novel_interface.show_dialog("Son ancien propriétaire était un pacifiste dévoué, même s'il était très secret et utilisait plusieurs pseudonymes.", "Mariru")
	await novel_interface.show_dialog("Alors peut-être que c'est un homme poilu d'âge moyen que vous pourriez appeler.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Si c'est le cas, laissez Rapha?l le ramener à Salmonton !")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Quoi qu'il en soit, la sécurité avant tout.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru me lâche et me tapote la tête.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Prends soin de toi… Je te surveillerai.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sur un ton qui signale le début de l'expérience, je fixe à nouveau mes yeux sur le pilier de Lapis qui se tient silencieusement sur la plate-forme.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Réussirons-nous ?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
