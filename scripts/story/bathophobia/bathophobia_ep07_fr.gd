# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Lorsque je rampe hors du coupé rouge de Mariru, je sens le monde entier tourner et j'arrive à peine à me tenir droit.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… Beurk… \\nLa façon dont vous conduisez !! C'est fou !!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plus tôt ce matin, je me blottis avec une couverture douillette comme d'habitude. Soudain, Annie a fait irruption et m'a tiré du lit.")
	await novel_interface.show_text_only("Encore à moitié endormi, j'ai été poussé dans la voiture. À ce moment-là, je protestais encore contre son comportement violent.")
	await novel_interface.show_text_only("Mais après cette horrible aventure, la seule chose qui me reste à l'esprit est \"Dieu merci, je suis toujours en vie\"...")
	await novel_interface.show_text_only("Le projet Ark démarre aujourd'hui, mais j'ai vraiment envie de me faire porter malade.")
	await novel_interface.show_text_only("J'ai mal au ventre depuis des jours. Bon sang!")
	await novel_interface.show_text_only("Et j'ai toujours envie de vomir… Beurk !")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Est-ce que tu vas bien, Ren ?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fais signe à Annie avec dédain.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Je vais bien, juste un peu malade. Et je ne peux pas arrêter de frissonner en ce moment…", "Lian")
	await novel_interface.show_dialog("Puis-je prendre une autre voiture à notre retour ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je demande d'une voix faible, en regardant Annie d'un air suppliant.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Regardez-vous. Vous avez tellement l'habitude de jouer à Miss Innocente, n'est-ce pas ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que je m'appuyais contre le mur pour me soutenir, une voix familière arrive de derrière. Mon Dieu ! Laisse-moi partir…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Rapha?l ? Pourquoi es-tu…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Mariru ne vous a-t-il pas dit que je serais là ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Elle ne viendrait pas si je le faisais.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me regardant comme si j'étais son animal de compagnie à vendre, Mariru effleure la question de Rapha?l.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Je vous laisse Ren, \\nMlle Dekkers, notre chère représentante exécutive de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Attendez ! Me laisser à elle ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sourit et nous emmène à l'entrée de l'base de l'Arche.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Etes-vous sûr que c'est… l'entrée ?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Devant nous se trouve l’entrée d’un sous-sol en béton face à cette route à la périphérie de la ville. La porte ne laisse passer qu’une seule personne.")
	await novel_interface.show_text_only("Il n’y a aucun bâtiment dans un rayon d’un demi-mile. S'il n'y avait pas eu le logo SID gravé sur le mur, j'aurais dû le prendre comme un refuge effrayant pour un pervers.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hé-hé, viens avec moi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("Nous avons descendu l'escalier derrière la porte qui mène à un grand monte-charge.")
	await novel_interface.show_text_only("Il semble que l’ascenseur soit conçu pour des environnements extrêmes. Quatre réas métalliques épaisses assurent un fonctionnement sûr et stable.")
	await novel_interface.show_text_only("Alors que l'ascenseur descend en douceur, le bruit des engrenages en rotation vient de tous les coins.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("Les aérations, les treillis métalliques, les rivets et la lumière tamisée… Les éléments industriels vintage sont partout.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("La fiabilité avant tout le reste… J'ai vu de tels modèles dans le coffre-fort en or de la Banque centrale de Newmoridas.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ouah, tu y es allé ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("C'était l'un des plus grands projets de construction au monde avant la guerre de Sept Ans, et il nous a fallu beaucoup de travail pour restaurer ce lieu.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru présente fièrement cette structure souterraine.")
	await novel_interface.show_text_only("Rapha?l a raison. L’ascenseur, bien que toujours en marche, est aussi stable qu’un énorme morceau d’acier solide. Il me vient à l’esprit que même sauter ne provoquerait pas la moindre secousse dans l’ascenseur.")
	await novel_interface.show_text_only("Je viens tout juste de me remettre du mal des transports et j'ai hâte d'essayer, seulement pour découvrir Rapha?l qui me regarde.")
	await novel_interface.show_text_only("Réalisant que je pourrais être stupide, je le fais immédiatement tomber avec un air embarrassé. Mais elle tourna son visage avec dédain vers la fenêtre d'observation.")
	await novel_interface.show_text_only("Que peut-elle voir dans l'obscurité ?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Pourquoi tu me regardes ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le voleur crie au voleur, hein ?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ugh… Je ne m'attendais pas à ce que Salmonton vous envoie ici.", "Lian")
	await novel_interface.show_dialog("Après tout, l’expérience d’aujourd’hui est assez dangereuse.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plus important encore, je sais que cette expérience est une série avec deux scénarios.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Savez-vous vraiment dans quoi vous vous embarquez, ma dame ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me tourne vers Mariru, impuissant.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("En apparence, il s'agit d'un projet de recherche conjoint entre New Opulentia et Salmonton.", "Mariru")
	await novel_interface.show_dialog("L’objectif est d’identifier les causes du flux spatio-temporel et les contre-mesures.", "Mariru")
	await novel_interface.show_dialog("Les deux parties doivent envoyer une personne qualifiée et digne de confiance en tant que sujet humain.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Maintenant que votre absurdité au Sky Hotel cette nuit-là a révélé votre identité, vous êtes définitivement le meilleur choix pour New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me lance un regard, me faisant froid dans le dos.")
	await novel_interface.show_text_only("Allez, j'ai appris ma leçon…")
	novel_interface.character_light()
	await novel_interface.show_dialog("Quant à Rapha?l, notre « bien-née devenue roturière » à Gosakuragawa, elle s'est portée volontaire pour rejoindre l'expérience au nom de Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Du bénévolat ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, le pilier Lapis est très important pour Salmonton. Je ne te laisserai jamais, un perdant, tout gâcher.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Rapha?l est capable d’accélérer l’auto-guérison au niveau cellulaire. Cela a été affirmé par Aya.", "Mariru")
	await novel_interface.show_dialog("Mais selon Beatrice, Rapha?l ferait mieux de travailler avec Ren pour mettre pleinement en valeur son talent.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il me vient soudain à l'esprit que, sur le parking du Sky Hotel, Rapha?l a guéri Annie en un clin d'œil.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Donc Rapha?l est de notre côté, non ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, j'imagine ton regard pathétique lorsque tu te bats pour sauver ta vie. \"Owww… je suis en train de mourir… Guéris-moi maintenant…\"", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("On dirait que vous ne pouvez pas attendre que cela se produise ?!", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Attendez, je pensais que c'était une expérience secrète. \\nComment le savait-elle ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("J'ai tout dit clairement au Dr Dekkers.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Depuis qu'il vous a vu ressusciter Béatrice, il a estimé que sa précédente coopération avec le Sénat allait dans la mauvaise direction.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Est-ce quelque chose à voir avec la religion ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ce n'est probablement pas si simple… Mais maintenant, Salmonton est prêt à travailler avec SID, tant que Rapha?l est en sécurité avec nous.", "Mariru")
	await novel_interface.show_dialog("Le Sénat ne connaît pas vos véritables capacités. C'est cette force que nous devrions exploiter pleinement.", "Mariru")
	await novel_interface.show_dialog("Une sorcière ne déclenche rien lorsqu'elle touche un éclat de sorcière. C'est pourquoi notre plan peut fonctionner.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Je tiens donc vraiment à remercier les dirigeants des deux camps d’avoir rendu cela possible.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Êtes-vous sûr que mon grand-père fantasque n'est pas dupe ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ton grand-père n’est pas si naïf, chérie. La relique ici n’est en aucun cas son choix aléatoire.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Nous avons fait tout cela pour garantir que la « véritable expérience » puisse être menée à bien.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, s'il n'y avait pas eu la commande de mon grand-père…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphaël marmonna vaguement quelque chose, ses yeux me passant légèrement.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Je n'accepterais jamais de coopérer avec ce pervers travesti !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Mais le Dr Dekkers dit toujours que c'est vous qui n'écoutez jamais.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Laissez-moi deviner… Salmonton s'intéresse réellement à Heinrich, le propriétaire original du pilier Lapis ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Bonne chance, Ren !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le Sénat prévoit de travailler avec Salmonton pour produire davantage de sorcières dans le dos de SID. Et cette fois, ils veulent vérifier la faisabilité de m’utiliser comme stabilisateur.")
	await novel_interface.show_text_only("Salmonton, cependant, a conclu un accord secret avec Mariru.")
	await novel_interface.show_text_only("Quant à Mariru, elle a gardé le Sénat dans l’ignorance de nos véritables capacités.")
	await novel_interface.show_text_only("Cela devient compliqué. Cela me tue…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Pouvons-nous vraiment combattre côte à côte ?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je jette un coup d’œil à la dame autoritaire devant moi.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Transférer Rapha?l à Gosakuragawa…) \\n(fait également partie de leur plan ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Regardez ce visage stupide. Elle doit encore penser à quelque chose de stupide.)", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("L'ascenseur s'arrête enfin avec un bruit de cognement. \\nUne porte métallique de 10 mètres de haut se dresse devant nous.")
	await novel_interface.show_text_only("Un rayon laser rouge traverse mon corps de la tête aux pieds. \\nAprès peu de temps, un bip de confirmation retentit depuis la porte.")
	await novel_interface.show_text_only("Mariru avance pour un scan de suivi de l'iris.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ils sont peut-être démodés, mais les mesures de sécurité ici sont assez strictes…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Une fois le scan terminé, la porte géante s'abaisse lentement, nous laissant émerveillés par l'espace étonnant derrière la porte.")
	await novel_interface.show_text_only("L'énorme espace souterrain est soutenu par deux rangées de piliers majestueux en béton.")
	await novel_interface.show_text_only("La base de chaque pilier est recouverte de tas d'éclats d'armure pouvant être utilisés dans les deux sens.")
	await novel_interface.show_text_only("Face à l’extérieur, ces éclats peuvent protéger la structure des attaques de roquettes dévastatrices. Mais s’ils sont utilisés dans la direction opposée, ils sont capables de détruire les piliers d’un seul coup.")
	await novel_interface.show_text_only("Pendant la guerre de Sept Ans, ces éclats d'armure étaient largement utilisés dans les forteresses qui devaient être bloquées ou détruites.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("C'est plutôt humide ici…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le sol est criblé de taches d'eau. Au-dessus, des dizaines de nouveaux tuyaux sont montés au plafond, produisant des bruits de liquide qui coule à travers.")
	await novel_interface.show_text_only("Mariru a dû déployer des tonnes d'efforts pour transformer cet endroit.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Au fond du passage, nous nous retrouvons devant un espace délimité par des dalles métalliques.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Mesdames.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Bienvenue à la base de l'Arche.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est juste que… je n'arrive pas à en croire mes yeux !")
	await novel_interface.show_text_only("Ce qui se trouve devant nous est un réservoir. En regardant la brume s'élever de l'eau scintillante, j'ai l'impression d'être debout sur un quai.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Regardez simplement : l’échelle d’embarquement est en route vers nous.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
