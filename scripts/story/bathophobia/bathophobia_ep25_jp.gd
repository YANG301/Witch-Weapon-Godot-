# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("──お気を付けを！！","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("監視室の扉が開いたと同時に、\\nハインリッヒは俺を横へと押しのけた。")
	await novel_interface.show_text_only("瞬く間に耳をつんざくような爆裂音と共に放電が\\n発生し、金髪の少女の胸元に炸裂した。\\n強烈な閃光で俺は目を開けていられない。")
	await novel_interface.show_text_only("しばらくして全てが収まる。髪の毛には大量の\\n静電気が溜まり、空気中に塩素の匂いがする。")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("はあ……っ。\\nハインリッヒっ！　大丈夫か！？","小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("トラップ式の防御武器ですか……\\n中々のものですね。\\n今ので、小型雷撃1回分相当のエネルギーが\\n蓄電されました。","ハインリッヒ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ハインリッヒは半透明な薄青い結晶を持って、\\n監視室の天井照明を熟考しながら観察する。")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("今のはなに！？\\nあと、その手に持っているものは……","小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("一種の電気石ですわ……\\nマスターも試してみますか？","ハインリッヒ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("錬金術士は謎の笑顔を見せ、軽く俺の耳の後ろに\\n結晶を当ててきた。")
	await novel_interface.show_text_only("突然、温かい電流が身体を通り抜け、身の毛が\\n震えるようなゾクゾクした感じが発生した。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("ひゃぁんっ！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("思わず弱々しい叫び声を上げてしまう。")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("ラ？ご主人様の身体はとても敏感なんですね～","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ふんっ……変態め。","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルの俺を見る目が、ゾウリムシを\\n見るかのごとくランクアップしている。")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("お、俺だって……わざとじゃない……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("真っ赤にした顔は下がり、声もだんだん小さく\\nなっていく。")
	await novel_interface.show_text_only("ただ結晶が吸ったのか身体中の静電気は\\n一気に消えており、\\nパサパサしていた髪の毛も滑らかになった。")
	await novel_interface.show_text_only("戻ったらハインリッヒに1個もらおう……\\n大丈夫だよね？")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("俺は錬金術士の後ろに隠れながら、\\n慎重に監視室へ入った。")
	await novel_interface.show_text_only("室内は激しく戦った痕跡が残っていた。\\n\\nスクリーンと設備の大半は破壊され、\\n壁と天井の大部分も既に剥がれ落ちている。")
	await novel_interface.show_text_only("高圧電流による焦げ跡は、メインコンソール左の\\n制御機械を中心に拡散している。\\n露出したコイルは時々、火花を発していた。")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("球形で半径は……5メートルを超えてる……\\n\\n高電圧放電系の武器か……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("採用されていたのが戦略Genuineシステムと\\n仮定すれば、この痕跡は──")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("システムの攻性防御設備が少し改造されてるのか\\n\\n基地内送電網の高圧電力を……\\n化学蓄電池に注ぎ込んだ？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("見分けがつかない程に爆破されているケースを\\n見て、塩素の匂いがどこから来たのか理解した。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("放電による爆発──","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("強大な電流が金属箔を通過すると\\n加熱作用により多量のエネルギーが集中し、\\n激しい爆発と閃光を引き起こす。")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("幾重にも重ねた金属箔を利用したのですね……\\n効率良く殺傷力を増す改造ですわ。","ハインリッヒ")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("しかし、唯一の出口であるゲートの隙間に\\n放電を誘発する金属線を固定するという意味は、\\nこの武器を作成した方……","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("もし監視室の扉が開かれれば、敵を道連れに……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("このシステムのコアパーツには電磁バリアが\\n付属されていたようだ。\\n一部のボタンが破損されている以外は\\nメインコンソールは操作可能な状態だった。")
	await novel_interface.show_text_only("システムにアクセスすると、すでにハッキングが\\n済んでいる。\\n多分メインコンソールに繋がってる軍用腕時計と\\n関係があるのかもしれない。")
	await novel_interface.show_text_only("腕時計のキャッシュはまだ生きており、\\nその内容が持ち主の身元を明かしてくれた。")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("すごいヤツだったんだな……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("監視エリアの一部のモニターも生きており、\\n基地内の状況をリアルタイムで中継している。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("役立つ情報があればいいけど──","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一回深呼吸して、俺はシステム履歴を開けた。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("マジかよ……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さすが機密機関。\\n履歴の情報量が恐ろしいほど多い。\\nVCRで録画した初期の映像さえあるぞ……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("──こんなの全部漁っていたら地球が爆発する！","小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("縁起でもない事を叫ばないで頂戴。\\n\\nシステム設計者は、その点を問題視して解決策を\\n講じているはずよ。","ラファエル")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あ、全ての映像を同時に高速でプレビューする\\nモードとかある……","小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ただ基地内の100個以上の監視カメラに対して\\n作業できる画面は20インチのスクリーンは、\\n1個しかないんだぞ……")
	await novel_interface.show_text_only("タイムスケールの設定を拡大すると、案の定\\n全ての監視映像が数ピクセルまで縮んだ。")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("待って、女装癖。　これって──！","ラファエル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ラファエルが俺の頭をノックして、\\nスクリーン上に映ってる1本の白線を指差した。")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("画面が全部……真っ白？","小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("……\\n……")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("ラファエルが指している時間まで飛び、\\nその映像を冒頭部分まで巻き戻す。")
	await novel_interface.show_text_only("スクリーンに映っているのは、背の高い男。")
	await novel_interface.show_text_only("灰青色の防護服を装着して、身長は190ぐらい。\\n体格も丈夫そうで、足取りは確固として素早い。")
	await novel_interface.show_text_only("カメラを避けているわけではないが、\\nぼんやりしたこの映像から、\\n顔を判別する事は難しい。")
	await novel_interface.show_dialog("この感覚……","小憐")
	await novel_interface.show_dialog("マスターのお知り合いでしょうか？","ハインリッヒ")
	await novel_interface.show_dialog("いや、知らない……","小憐")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("男は何かを探している様子で、基地内部を素早く\\n探索している。")
	await novel_interface.show_text_only("彼は足早に資料室から医務室へ向かった。")
	await novel_interface.show_text_only("寒冷地用の迷彩服を着た兵士2名の死体を\\n通り過ぎる際、\\n男は突然立ち止まり、じっくりと身を屈めて\\n死体を調べ始めた。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("あの兵士……膝から下が……無くなってる？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不鮮明な監視映像だけど、足の切断面辺りに\\n黒い血痕を残しているのが見える。\\nラファエルと俺は息を飲んだ。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("やはり、戦闘があったのね……","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──ふと資料室の床にあった、巨大な亀裂を\\n思い出した。")
	await novel_interface.show_text_only("無表情な男はその後、医務室に入って薬箱から\\n黒いカードを1枚取り出す。\\nそして手にした銃へ弾を込める。")
	await novel_interface.show_text_only("医務室の片隅から奇抜な動きの黒い影が\\n飛び出してきた。\\n男は黒い影に数回発砲すると、\\n相手をカメラの監視範囲外へと退けた。")
	await novel_interface.show_text_only("彼はすぐにナイフを抜き、黒い影の後を追う。\\n\\n数秒後にカメラの監視範囲に戻ってくると、\\n無造作に何かの塊をゴミ箱へ投げ込んだ。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("あ、あれってもしかして……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("いやいやいや、絶対見間違いだ。")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("手順通りで精密な戦闘動作ですわね。","ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("……いいから、続けなさい。","ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("男は医務室から離れる。\\n\\n彼は基地の構造に詳しい様子で、先ほど入手した\\n黒いカードで1つの金属ゲートを開ける。")
	await novel_interface.show_text_only("誰もいない事を確認して、男は足早に監視室の\\n外の通路へと向かった。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("これは……ッ！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("くすんだ監視映像からでも、現場が血生臭い\\n凄絶な戦場になっていた事が分かる。")
	await novel_interface.show_text_only("多くの屍が、輪を描くように放射状に散らばる。\\n\\n屍はまるで何らかの強烈な衝撃を同時に受けて\\n倒されたようだった。")
	await novel_interface.show_text_only("そして屍の輪の中央には、長柄の武器に上半身を\\n貫かれ膝を突く白衣の少女。")
	await novel_interface.show_text_only("極寒の環境下を考えると非常に薄着な彼女は、\\n白い肌を血で汚していた。")
	await novel_interface.show_text_only("それでも、少女の垂れ下がった両手は武器を\\n握り続けていた。\\n意識を失っても、手を離してはいなかった。")
	await novel_interface.show_text_only("──男は少女の前に片膝を屈め、\\n彼女の顔を軽く撫でる。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("（知り合い……なのか？）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そのまま少女の背後に回ると長柄を握り、\\nゆっくりと引き抜いた。\\n金色に包まれた長柄の先が頭を覗かせる。")
	await novel_interface.show_text_only("少女の体は全く動かず、傷口からは血も出なかった。その過程全体に、言葉では言い表せない不服従の感覚がありました。")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("あ……","ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("男はコートを脱ぎ、慎重に銃の頭を取り外し、布で包みスーツの上着の中に入れ、長い柄を脇に放り投げた。")
	await novel_interface.show_text_only("その後、彼は監視室に移動したが室内の映像は\\n表示できない。")
	await novel_interface.show_text_only("設置された頭上のカメラを確認する事で\\n俺達はすぐに事態を理解した。\\nきっと監視室のカメラは放電で完全に壊れて\\nいたのだろう。")
	await novel_interface.show_text_only("しばらくして、男は50センチほどの合金製の\\nアタッシュケースを持って出てきた。")
