# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Il terremoto al Polo Sud non dura a lungo. Lo strato vuoto sotto la stazione di rifornimento, istituito come precauzione contro le bufere di neve, riduce efficacemente i danni causati dalle scosse.")
	await novel_interface.show_text_only("In meno di un minuto, il terreno ritorna al suo precedente stato di calma.")
	await novel_interface.show_text_only("Sono cresciuto ai confini del Aegis: un terremoto di queste dimensioni non mi disturba minimamente.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Solo un piccolo terremoto. Tutti bene?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Sì... ma perché tenere abbassata la gonna è stata la tua prima reazione?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Tipo, sei sicuro che questa dovrebbe essere la tua priorità in caso di terremoto?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, beh... \\nÈ solo...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aw, andiamo, dammi tregua!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Eppure è strano. L'Antartide è un continente ricoperto da strati su strati di spesso ghiaccio. Sicuramente non è una zona a rischio sismico.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael aggrotta la fronte, guardando fuori dalla finestra.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oppure ricordavo male?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Quindi la Nona Sephira ha finalmente causato un problema, eh...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Ren, guarda!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie grida all'improvviso, indicando fuori dalla finestra. Mi avvicino per dare un'occhiata.")
	await novel_interface.show_text_only("Sullo strato piatto di ghiaccio è apparsa una gigantesca crepa. Sotto il cielo di velluto sembra quasi un abisso che conduce direttamente all'Inferno.")
	await novel_interface.show_text_only("In un certo senso, non è tanto una crepa quanto un canyon...")
	await novel_interface.show_text_only("Sul bordo della fessura si ergono eretti alcuni spuntoni aguzzi. Strutture anomale a forma di rete emergono dalle profondità dello spesso strato di ghiaccio.")
	await novel_interface.show_text_only("Le scogliere di ghiaccio su entrambi i lati sembrano rimanere all'incirca alla stessa altezza. È come se una forza inimmaginabile avesse fatto a pezzi l'intera rastrelliera del ghiaccio.")
	await novel_interface.show_text_only("L'enorme fessura si snoda verso gli altopiani, scomparendo alla vista...")
	await novel_interface.show_text_only("Per fortuna siamo qui in valle. Siamo al sicuro qui.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Ehi, che cos'è?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e Henriette si avvicinano per vedere cosa sto indicando. Entrambi sussultano.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Quell'edificio... perché non è interessato?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sulle pianure ghiacciate proprio di fronte a noi, un'enorme struttura artificiale si profila proprio sul percorso della crepa che si allarga, completamente indisturbata.")
	await novel_interface.show_text_only("Le sue mura scure sembrano fuori posto in questa terra bianca e pallida.")
	await novel_interface.show_text_only("Invece di squarciare l’edificio come avrebbe dovuto, la fessura lo ha circumnavigato sotto forma di due archi, come se ci fosse qualcosa nella struttura che non vuole disturbare.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("È il punto d'incontro Mariru appena menzionato?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Sembra essere la posizione giusta.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si sente un crepitio proveniente dal pannello di controllo. Sembra che la stazione di rifornimento stia ristabilendo la connessione con il mondo esterno.")
	await novel_interface.show_dialog("Ciao? Ren? Riesci a sentirmi?", "Mariru")
	await novel_interface.show_text_only("Mariru sembra un po' nervoso.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Prima che il gruppo satellitare di ricognizione che abbiamo chiamato finisca di cambiare rotta, il feed grafico dell'Antartide può essere aggiornato solo una volta ogni trentacinque minuti in forma statica.")
	await novel_interface.show_text_only("Sullo schermo continuano ad apparire messaggi contenenti informazioni che Mariru ha raccolto dalle principali stazioni polari.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Qualcosa non va. Questo terremoto... non è normale.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Strano, non riesco ancora a ricevere il segnale dai ragazzi della base di Snedronningen...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru strizza gli occhi al più recente rapporto aggiornato dal sensore meteorologico della base di Norimberga.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Aspetta, quello è...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tocca freneticamente il suo dispositivo portatile, richiamando tutti i dati di monitoraggio meteorologico e idrologico in tempo reale dell'Antartide che riesce a trovare.")
	await novel_interface.show_text_only("È facile vedere che i numeri stanno cambiando, rapidamente e in modo coerente. All'improvviso le viene in mente un corso che ha seguito all'università...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Dimmi, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Ehm?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anche senza considerare l’impatto delle armi nucleari e degli oggetti estranei, ci sono ancora molti fattori naturali in agguato sulla terra che possono causare “la fine del mondo”.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Naturalmente. L’uomo, infatti, è comparso solo dopo la quinta estinzione di massa sulla terra. I fattori naturali possono essere davvero letali.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("E quando si tratta dell'elemento naturale più pericoloso che si può trovare in Antartide...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Maledizione... è metano!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, sei sicuro che la crepa sia vicina alla tua posizione?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sì. Ma la cosa strana è che...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho riferito a Lililiu che la frattura sembrava aggirare deliberatamente la base della Regina Bianca.")
	await novel_interface.show_text_only("Mariru riflette un po' su queste informazioni. La prossima volta che parla, il suo tono è deciso, professionale.")
	await novel_interface.show_dialog("Ascolta, è probabile che il metano rimasto sigillato sottoterra per milioni di anni stia attualmente fuoriuscendo dalla spaccatura.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Aspetta... tipo, sì, so che miliardi di tonnellate di metano sono immagazzinate sottoterra qui, ma... non sono solidi? Come il ghiaccio infiammabile?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Potrebbero essersi vaporizzati a causa della pressione causata dallo strappo della piattaforma di ghiaccio durante il terremoto. Almeno quelli esposti probabilmente lo avevano fatto.", "Ai")
	await novel_interface.show_dialog("Secondo i sensori della base di Norimberga, il livello di metano sopra l'Antartide è aumentato di 2,1 ppm rispetto a un'ora fa, prima del terremoto.", "Mariru")
	await novel_interface.show_dialog("I numeri differiscono tra le altre stazioni meteorologiche, ma i risultati sono gli stessi: lì c’è un drammatico aumento del livello di metano, non importa da come lo guardi.", "Mariru")
	await novel_interface.show_dialog("Anche l’area oceanica vicino alla piattaforma di ghiaccio di Amery ha mostrato anomalie. Crediamo che ciò sia dovuto al fatto che il gas metano proveniente dagli oceani ha iniziato a ribollire, causando un’interruzione delle maree.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Se non ricordo male l'effetto serra portato dal metano è ventuno volte quello dell'anidride carbonica...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Quindi... farà più caldo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faccio del mio meglio per ricordare ciò che ho letto negli opuscoli sulla conservazione dell'ambiente che abbiamo ricevuto a scuola.")
	await novel_interface.show_dialog("Le maree si stanno già alzando, mentre la velocità del vento sta diminuendo. La temperatura salirà di... 0,2 gradi ogni 12 ore. E non smetterà di salire per un bel po’.", "Mariru")
	await novel_interface.show_dialog("Ciò significa che i nostri oceani saranno presto privati di ossigeno, il che ovviamente rovinerà l’intero ecosistema. La maggior parte degli esseri viventi sul nostro pianeta verranno eliminati.", "Mariru")
	await novel_interface.show_text_only("Raphael sembra finalmente rendersi conto di quanto sia grave la situazione.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Quindi... tra due settimane... tutte le piante esposte appassiranno...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("E tra tre settimane, la maggior parte degli animali rischierà l’estinzione. Il 90% degli esseri umani non avrà acqua potabile. Anche i satelliti in orbita terrestre bassa non si muoveranno più come dovrebbero a causa del cambiamento nella nostra atmosfera...", "Ai")
	await novel_interface.show_dialog("Entro quarantacinque giorni, solo poche specie rare – tutti gli insetti – sopravvivranno in un ambiente del genere.", "Mariru")
	await novel_interface.show_dialog("Se non facciamo qualcosa, e in fretta, presto diventeremo cibo per quegli insetti.", "Ai")
	await novel_interface.show_text_only("Non posso trattenere il brivido che mi corre lungo la schiena mentre guardo la crepa che porterà alla rovina dell’umanità.")
	await novel_interface.show_text_only("Mariru si schiarisce la gola. Tutti i presenti trattengono il fiato e aspettano i suoi ordini.")
	await novel_interface.show_dialog("Non c'è un minuto da perdere. Ogni secondo che passa la crepa continua a causare sempre più danni.", "Mariru")
	await novel_interface.show_dialog("Se restiamo seduti e aspettiamo che il Congresso Unito invii la sua squadra di emergenza, sarà troppo tardi.", "Mariru")
	await novel_interface.show_dialog("Inoltre, non è che la loro squadra di emergenza sappia come affrontare una cosa del genere...", "Mariru")
	await novel_interface.show_dialog("Allora, Henriette...", "Mariru")
	await novel_interface.show_text_only("Ci rivolgiamo tutti all'alchimista, che non sembra troppo sorpreso di essere stato chiamato da Mariru.")
	await novel_interface.show_dialog("Se questo è in qualche modo legato alla Nona Sephira che dovresti proteggere..., allora hai mai incontrato qualcosa che potrebbe avere ripercussioni così gravi?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("Vedi, questa è la cosa più fastidiosa del mio lavoro!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("L'alchimista bionda scuote la testa con un sorriso debole mentre ricorda.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("L'Uno di solito mi teletrasporta semplicemente sul luogo dell'incidente e mi lascia lì.", "Henriette")
	await novel_interface.show_dialog("Ma se lasciamo “quel genere di cose” là fuori senza qualcuno che se ne occupi, il mondo potrebbe anche finire qui.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 d.C., Monte Huaynaputina, vicino alla colonia spagnola>", "Henriette")
	await novel_interface.show_dialog("Mi stavo ribellando a The One e ho trascinato la mia missione per un paio di giorni in più. Alla fine tutti i villaggi nel raggio di pochi chilometri furono completamente distrutti.", "Henriette")
	await novel_interface.show_text_only("La sua espressione è incredibilmente triste.")
	await novel_interface.show_dialog("Ho comunque fatto il mio lavoro... ma tanti sono morti. Avrei potuto salvare più di sessantamila vite umane.", "Henriette")
	await novel_interface.show_dialog("Le ceneri del vulcano rimasero nell'atmosfera, bloccando la luce solare dalla terra per oltre un anno. Quelli furono gli anni più freddi di quei due decenni.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette abbassa lo sguardo, non vuole continuare.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("Quel disastro del vulcano in Perù alla fine del quindicesimo secolo, eh...", "Ai")
	await novel_interface.show_dialog("—Questa è davvero una crisi della stessa portata.", "Mariru")
	await novel_interface.show_dialog("La temperatura estremamente bassa che afflisse il mondo negli anni successivi provocò carestie e guerre in tutto il mondo. Alcuni imperi caddero addirittura in quel periodo.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sembra davvero serio...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Era una responsabilità troppo pesante da sopportare da sola.", "Mariru")
	await novel_interface.show_dialog("Ren, non hai menzionato i metodi di viaggio in climi estremamente freddi?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Vuoi dire... vuoi che viaggiamo, controlliamo la base? Vedi cosa possiamo fare per aiutare?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Giusto. Anche se non posso essere sicuro di cosa stia succedendo esattamente, credo che l'unico modo per salvare la situazione sia all'interno della base stessa.", "Mariru")
	await novel_interface.show_dialog("Dobbiamo almeno raccogliere dati da lì...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Ma non possiamo entrare nella zona se il livello di metano è troppo alto da quelle parti, no?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Questo “metano” di cui parli... è la “sostanza combustibile” che attualmente percepisco nell'aria?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche se non sono del tutto sicuro di cosa stia parlando, annuisco comunque.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Dovrebbe andare bene, allora. La densità della sostanza combustibile nell'aria laggiù infatti mostra una spirale discendente.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Laggiù? Vuoi dire...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette starà parlando della base di Snedronningen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Fuori dalla base di Snedronningen>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ciao? Annie? Riesci a sentirci?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In piedi di fronte alla gigantesca struttura, che incombe orgoglioso in un mondo di neve e ghiaccio, urlo nel mio vecchio walkie-talkie, proteggendolo dal vento con una mano.")
	await novel_interface.show_dialog("Capito... il segnale va bene... \\nÈ in arrivo una bufera di neve... fai attenzione...", "Annie")
	await novel_interface.show_text_only("La risposta di Annie è punteggiata da statico e ancora più statico.")
	await novel_interface.show_text_only("Mariru ci ha ordinato di sbrigarci con la raccolta dei dati meteorologici e di rispedirli a New Opulentia il prima possibile.")
	await novel_interface.show_text_only("Nel frattempo, considerando quello che ci ha detto Henriette, c'è davvero qualcosa che non va in questa base. Si distingue davvero dall'ambiente circostante.")
	await novel_interface.show_text_only("Non mi è piaciuto molto, ma mi sono comunque avventurato verso la gigantesca base insieme a Raphael e Henriette, tenendo abbassata la gonna nel vento impetuoso mentre procedo.")
	await novel_interface.show_text_only("Annie resta indietro, mantenendo la comunicazione tra noi e Mariru con i nostri antichi walkie-talkie.")
	await novel_interface.show_text_only("Mentre procedevamo a fatica, potevamo dire dal nostro gascromatografo che c'era effettivamente una quantità allarmante di gas metano nell'aria.")
	await novel_interface.show_text_only("Ero così vicino allo svenimento quando Raphael mi afferrò la mano.")
	await novel_interface.show_text_only("Non solo ricco e di classe, ma anche caldo e rilassante. La sua presenza era l'unica cosa che mi faceva andare avanti.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Non fare l'arrogante, ti sto aiutando solo perché ho promesso a Mariru che l'avrei fatto.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Non è che l'ho chiesto io, ok?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ho subito chiuso la bocca dopo aver ribattuto, non volendo ingoiare bocconi di neve.")
	await novel_interface.show_text_only("Se non fosse stato per l’effetto riscaldante della Giada di Fuoco, mi sarei già trasformato in un ghiacciolo umano.")
	await novel_interface.show_text_only("Tuttavia, nel complesso, la base sembra molto più avanzata rispetto alle stazioni di rifornimento in cui siamo stati in precedenza.")
	await novel_interface.show_text_only("Attraversiamo la pista di atterraggio per aerei ad ala fissa e arriviamo davanti ad un monumento in pietra.")
	await novel_interface.show_text_only("Al suo interno è incorporata una scatola per campioni. Intorno c'è il nome della base, Snedronningen, in stampa floreale.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... aspetta, come si pronuncia?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("È finlandese. Snedronningen, idiota.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Questa base con un nome che non riesco a pronunciare sembra già sorprendentemente grande dall'esterno ed è solo la punta dell'iceberg. La maggior parte della struttura non è nemmeno visibile dall’alto.")
	await novel_interface.show_text_only("Mi chiedo quanti soldi siano stati spesi per costruire una struttura così imponente, niente meno che in Antartide.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Andiamo!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette si muove velocemente, prima ancora che io possa reagire.")
	await novel_interface.show_text_only("L'alchimista mette la mano sulla serratura elettrica vicino alla porta. Invece di lasciarsi scansionare il palmo della mano, strappa semplicemente il tutto, cornice e tutto, dal muro.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Che tipo di mostro è?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
	await novel_interface.show_text_only("Una volta risolto il problema della serratura, i cavi che tengono chiusa la barriera iniziano a muoversi, i piccoli ingranaggi ronzano, rivelando finalmente la porta.")
	await novel_interface.show_text_only("Sbirchiamo dentro e vediamo una scala che scende.")
	await novel_interface.show_dialog("... Quindi entriamo e basta? Senza informare nessuno?", "Lian")
	await novel_interface.show_text_only("Non posso fare a meno di voltarmi indietro e guardare a bocca aperta l’enorme buco che abbiamo lasciato sul muro.")
	await novel_interface.show_text_only("Abbiamo fatto un dannato buco nel muro, eppure nessuno si è presentato per sgridarci. Hmm.")
