# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-choo…", "Beth")
	await novel_interface.show_text_only("Dựa đầu vào bàn, cô gái có thể đã ngủ gật nếu không có cái hắt hơi này.")
	await novel_interface.show_text_only("Bên ngoài cửa sổ tàu ngầm là màn đêm vùng cực, cô không thể phân biệt được thời gian bằng màu sắc của bầu trời.")
	await novel_interface.show_text_only("Beth nhìn vào màn hình và nhận ra chỉ còn vài giờ sau cuộc chạm trán với quái vật biển sâu.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Tôi có đang làm đúng không?", "Beth")
	await novel_interface.show_dialog("(Dùng cô ấy để tìm ra sự thật cho chính mình…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Không để ý, Beth liếc nhìn cuốn sổ trên tay.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Nếu cha ở đây…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Anh ấy sẽ không bao giờ dao động vì những cảm xúc như vậy.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Nghĩ đến đôi tay khỏe mạnh của cha mình, Beth chậm rãi nắm chặt nắm đấm.")
	await novel_interface.show_text_only("Cuốn sổ ghi đầy những dòng chữ khó hiểu từng thuộc về cha nuôi của cô.")
	await novel_interface.show_text_only("Anh ấy là một nhà sinh vật học cao lớn, ít nói và tận tụy, nghiêm khắc với cả Beth và anh ấy.")
	await novel_interface.show_text_only("Vì khả năng đặc biệt của Beth, anh đã sắp xếp những khóa huấn luyện nghiêm ngặt cho cô ngoài việc học ở trường.")
	await novel_interface.show_text_only("Beth nhớ rằng cô đã phải làm việc chăm chỉ hơn mỗi ngày để đạt được mục tiêu mà cha cô đặt ra.")
	await novel_interface.show_text_only("Điều cô mong đợi nhất là nụ cười nhận biết thỉnh thoảng xuất hiện trên khuôn mặt nghiêm túc của anh.")
	await novel_interface.show_text_only("Không hề dịu dàng, người đàn ông dè dặt đã bảo vệ cô theo cách riêng của mình…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("—Như thể chuẩn bị cho cô ấy một số phận không thể tránh khỏi…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Vào sinh nhật thứ 12 của mình, Beth nhận được một gói hàng nặc danh. Bên trong nó là cuốn sổ này—và tin tức về cái chết của cha cô.")
	await novel_interface.show_text_only("Một vụ nổ khí gas đã giết chết hơn 30 người, trong đó có thành viên gia đình duy nhất còn lại của Beth trên thế giới.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Môi run run, Beth thầm gọi một cái tên.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Manh mối đằng sau cái tên này khiến cô nhận ra cái chết của cha cô không phải là một tai nạn như thông tin chính thức.")
	await novel_interface.show_text_only("Cô gái cô đơn đã phải lau khô nước mắt và nhanh chóng trưởng thành để sống sót trước những nguy hiểm chưa từng biết đến.")
	await novel_interface.show_text_only("—Cha cô nói trong sổ tay rằng khả năng đặc biệt của cô sẽ khiến cô gặp nguy hiểm và khiến cô trở thành mục tiêu của băng đảng.")
	await novel_interface.show_text_only("Gói hàng sẽ chỉ được gửi đi khi anh không thể bảo vệ cô được nữa…")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Tại sao mọi người lại khao khát… loại khả năng như vậy…)", "Beth")
	await novel_interface.show_dialog("(Đây chẳng phải là một lời nguyền hơn sao…)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth nhìn vào lòng bàn tay mình. Vài quả cầu ánh sáng bạc đang nảy lên trên ngón tay cô.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth biết cô ấy khác biệt kể từ khi cô ấy có thể nhớ được mọi thứ—nhưng không phải vì khả năng đặc biệt của cô ấy.")
	await novel_interface.show_text_only("Cô ấy có trí nhớ tuyệt vời về các con số ngay từ khi còn nhỏ. Cô ấy có thể tính nhẩm nhanh hơn nhiều so với những người khác và rất quan tâm đến máy móc.")
	await novel_interface.show_text_only("Nhưng cha cô yêu cầu cô phải giữ im lặng và cư xử như một đứa trẻ bình thường để che giấu khả năng đặc biệt của mình.")
	await novel_interface.show_text_only("Sau khi anh ta chết, Beth quyết định không ẩn náu nữa.")
	await novel_interface.show_text_only("Một năm sau, cô được nhận vào một trường đại học danh tiếng dưới sự cho phép đặc biệt, một ngoại lệ lần đầu tiên sau nhiều năm.")
	await novel_interface.show_text_only("Cô học chăm chỉ và đọc rất nhiều nhưng không thể tìm thấy câu trả lời trong sách hoặc lớp học.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Tại sao tôi lại khác…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô không ngừng học hỏi và suy nghĩ, như thể đang cố gắng thỏa mãn sự tò mò bị kìm nén bấy lâu nay của mình cùng một lúc.")
	await novel_interface.show_text_only("Cô không nhận ra rằng mình bị coi là kiêu ngạo, thờ ơ và khó gần.")
	await novel_interface.show_text_only("Dần dần, mọi người quay lưng lại với cô nhưng cô không quan tâm.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Nếu không thì tôi đã không gặp bạn…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô gặp Silvia trong một vụ tai nạn.")
	await novel_interface.show_text_only("Beth chỉ mất vài phút để nhận ra Silvia là một điều tra viên cải trang thành học sinh. Nhiệm vụ của cô là tìm kiếm Substance H bất hợp pháp trong khuôn viên trường.")
	await novel_interface.show_text_only("Cô biết rằng tên và kinh nghiệm của Silvia đều có thể là giả, nhưng vẫn bị thu hút bởi tính cách vui vẻ và bất cần của cô.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Cô ấy… khác.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Cô ấy hiểu tôi hơn bất kỳ ai khác…")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Mặc dù cô ấy đã quen với việc cải trang trước mặt người khác…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy đã thực sự mở lòng với tôi mà không hề dè dặt.")
	await novel_interface.show_text_only("Nhưng cả hai đều không ngờ rằng tình bạn của họ lại gây được sự chú ý của tổ chức đằng sau Milk.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Biết cô là con gái nuôi của nhà sinh vật học nổi tiếng, ông chủ của Milk đã mời cô tham gia sứ mệnh Nam Cực.")
	await novel_interface.show_dialog("(Tôi đã có ý định từ chối…)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("Trong căn cứ ngầm của Biệt đội.")
	await novel_interface.show_text_only("Điều khiến cô thay đổi ý định và quyết định tham gia là một biểu tượng trên hướng dẫn nhiệm vụ—")
	await novel_interface.show_text_only("Một biểu tượng mà cô nhìn thấy trong cuốn sổ tay của cha cô.")
	await novel_interface.show_text_only("Một nhãn cầu màu đen đáng sợ đại diện cho một tổ chức tôn giáo bí mật.")
	await novel_interface.show_text_only("Cha cô đã ghi lại cuộc liên lạc của ông với những người từ tổ chức đó. Họ đã thể hiện ý định huy động những người có khả năng đặc biệt và thành lập một nhóm chiến binh.")
	await novel_interface.show_text_only("Kế hoạch này được đặt tên là Dự án Ningen.")
	await novel_interface.show_text_only("Sau khi tài liệu từ trại trẻ mồ côi rơi vào tay họ, Beth đã nằm trong danh sách truy nã hàng đầu của Dự án Ningen.")
	await novel_interface.show_text_only("Kết quả là cha cô trở thành mục tiêu của tổ chức nguy hiểm này.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen… Nam Cực.)", "Beth")
	await novel_interface.show_dialog("(Căn cứ Nữ hoàng Tuyết ở Nam Cực…) \\n(Nó được đặt tên theo một câu chuyện trong Truyện cổ tích của Andersen.)", "Beth")
	await novel_interface.show_dialog("Trong tiếng Đan Mạch là Snedronningen \\nHoặc Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(Không phải ngẫu nhiên.)", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Vậy là Boss của bạn và đồng bọn đang theo đuổi cùng một mục tiêu…", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Nhìn vẻ mặt của bạn… băng đảng này có vẻ mạnh hơn những băng khác trong Danh sách đen…", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth gật đầu, nhưng cô không muốn nói thêm nữa.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Xin lỗi. Tôi tham gia sứ mệnh này vì động cơ ích kỷ.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Vâng, tôi biết điều đó.", "Milk")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Nhưng Boss chỉ muốn bạn tiếp tục công việc nghiên cứu về sinh vật biển của cha bạn.", "Milk")
	await novel_interface.show_dialog("Vì vậy, đó là một đôi bên cùng có lợi.", "Milk")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Về động cơ ích kỷ của anh… tôi biết anh bị tôi quyến rũ đến mức quyết định ở lại đây.", "Milk")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ôi, áp lực quá lớn đối với tôi!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk nói rồi hôn gió về phía Bai Yan, khiến Bai Zhu mỉm cười.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Điều cô không nhận thấy là sự u ám thoáng qua trong đôi mắt trong sáng của bạn cô.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Cô vẫn cảm thấy tội lỗi khi nghĩ đến khoảnh khắc mình ký giấy tờ.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Tôi đã… lợi dụng cô ấy.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ngồi xuống bàn, rút bút ra và nhìn chằm chằm vào cuốn sổ đang mở.")
	await novel_interface.show_text_only("Có giá trị là những thứ hữu ích.")
	await novel_interface.show_text_only("–Cô ghi lại suy nghĩ của mình.")
	await novel_interface.show_text_only("Bạn đã nói với tôi điều này… Và tôi luôn đồng ý với bạn…")
	await novel_interface.show_text_only("Sử dụng người khác hoặc bị sử dụng một cách vô đạo đức \\n“Đây là điều bạn coi là đương nhiên…”")
	await novel_interface.show_text_only("Nó chỉ phụ thuộc vào người có giá trị cao hơn.")
	await novel_interface.show_text_only("Không cần phải giải thích. Chỉ cần tập trung vào mục tiêu của bạn.")
	await novel_interface.show_text_only("Chỉ có mối quan hệ đơn giản như vậy mới có thể giúp bạn an toàn trước hầu hết mọi người.")
	await novel_interface.show_text_only("Beth dừng lại.")
	await novel_interface.show_text_only("Nhưng bạn cũng đã nói với tôi rằng vẫn còn—")
	await novel_interface.show_text_only("Một người muốn được bạn lợi dụng bất kể điều gì. \\n\"Và một người mà bạn không muốn sử dụng trong bất kỳ trường hợp nào.\"")
	await novel_interface.show_text_only("Nghĩ đến đây, khóe môi cô nở một nụ cười yếu ớt.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Tội lỗi? Đó là một cảm giác cần phải loại bỏ.)", "Beth")
	await novel_interface.show_dialog("(Vậy là… tình cảm?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth đóng nhật ký của mình lại.")
	await novel_interface.show_text_only("Bây giờ cô đã tìm được câu trả lời cho mình.")
	await novel_interface.show_text_only("Cô nhìn ra ngoài cửa sổ và thấy bầu trời xanh thẫm ngày càng sâu hơn, gần như hòa vào biển cả vô tận.")
	await novel_interface.show_text_only("Đột nhiên, chuông báo động khẩn cấp vang lên khắp tàu.")
	await novel_interface.show_text_only("Tất cả phi hành đoàn chú ý. Chỉ thị đã thay đổi. Báo cáo cho phòng họp trong mười phút nữa.")
	await novel_interface.show_text_only("Lặp lại. Chỉ thị đã thay đổi…")
	await novel_interface.show_text_only("Beth hít một hơi thật sâu, cất cuốn sổ và vội vã ra khỏi phòng.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
