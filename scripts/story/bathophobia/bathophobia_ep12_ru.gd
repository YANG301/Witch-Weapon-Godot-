	await novel_interface.show_dialog("Тот, кто поглотит нас всех…", "Annie")
	await novel_interface.show_dialog("У нас никогда не будет шанса сбежать…", "Annie")
	await novel_interface.show_dialog("Нет... Не надо!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie в отчаянии крепко сжимает меня, но я понятия не имею, что делать.")
	novel_interface.character_light()
