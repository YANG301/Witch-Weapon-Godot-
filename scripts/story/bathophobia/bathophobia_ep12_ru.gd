	await novel_interface.show_text_only("Annie ведет себя как пациент с посттравматическим стрессовым расстройством. Я уже видел подобные симптомы у госпитализированных солдат, охранявших границу Агейса.")
	await novel_interface.show_text_only("Подождите… Больница… \\nМеня… госпитализировали?")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Неважно. Сейчас у меня нет на это времени…)", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Есть ли выход?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генрих качает головой с поднятыми ладонями.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Нет. В какой-то степени люди являются не более чем рабами Единого.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Забери меня отсюда… Рен!", "Annie")
	await novel_interface.show_text_only("Annie плачет и крепко хватает меня за одежду. Ее лицо уже залито слезами.")
	novel_interface.show_character("ren_battle","serious")
