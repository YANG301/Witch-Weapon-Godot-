# bathophobia_ep12.gd - 深海恐惧篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep12_script()

func play_script():
	pass

func bathophobia_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Честно говоря, я не уверен в истинной личности Избранного, потому что даже если он мне лжет, я не могу сказать.", "Генриетта")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("И мне всегда интересно, даже если это все правда…", "Генриетта")
	await novel_interface.show_dialog("Должно быть, он существо, намного превосходящее людей. Так почему же он заботится о нас?", "Генриетта")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Подумайте об этом. Возможно, Избранный — не более чем непослушный ребенок в своем роде, который любит сжигать муравьев с помощью увеличительного стекла.", "Генриетта")
	await novel_interface.show_dialog("Однако муравьи понятия не имеют, что происходит. Они воспринимают это как наказание от Бога и падают ниц перед тенью за ослепительным светом.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Ха-ха-ха…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Рафилия озадаченно смеется.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Я бы не согласился.", "Raphael")
	await novel_interface.show_dialog("Люди склоняли головы и молились объекту молитвы... Первая заповедь была своевольной, как ребенок.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Его намерения пока неизвестны, но, судя по всем злодеяниям Единого, не исключено, что он намеренно втянул в это девушек.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда она отвечает Рафилии, Генрих обращает взгляд на Annie и на меня.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ты имеешь в виду… нас?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Annie уже бывала здесь раньше, и в то время, когда она пропала, она, вероятно, была заперта в этом пространстве…", "Raphael")
	await novel_interface.show_dialog("Личность Annie была раскрыта Розенкрейцером вскоре после инцидента в отеле Sky. Однако они полагали, что она была просто дубликатом.", "Raphael")
	await novel_interface.show_dialog("Подтвердить ее личность смогли только после перекрестной проверки с SID… Она пропадала семь лет назад.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","speechless",0.25)
	await novel_interface.show_dialog("Роза-Крест... Вы имеете в виду Розенкрейца?", "Генриетта")
	await novel_interface.show_dialog("Тайное общество, которое я основал для академического обмена между женщинами-алхимиками? Теперь оно стало разведывательным агентством?", "Генриетта")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Итак, похоже, я оставил какое-то интересное «наследство».", "Генриетта")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Генрих самодовольно улыбается, и Рафилия, кажется, о чем-то озаряет.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Теперь все это имеет смысл… Довольно популярное сегодня приветствие Розенкрейца на самом деле было в то время кощунством.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Пусть розы расцветут на Твоем Кресте.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Розы относятся к женщинам-алхимикам… Нет, не совсем. Розы символизируют всех женщин, верно?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Я этого не совсем понимаю, но это кажется невероятно крутым…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("В любом случае, Тот, о котором ты говорил... Он действительно плохой парень, не так ли?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Видя, что Annie совершенно испугался, я чувствую внутри себя прилив ярости.")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Как он мог заставить кого-то подписать контракт и привезти нас в это странное место?", "Lian")
	await novel_interface.show_dialog("И он, должно быть, сделал что-то еще более ужасное с Annie…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Если я увижу его лично, я выбью из него все дерьмо!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("…", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно среди них воцаряется тишина, и все смотрят на меня, как на идиота.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Что? Почему ты смотришь на меня?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("… Ничего. Ты просто звучишь как идиот.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Если вы так говорите, Мастер.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Хм... Как нам вернуться назад?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Боюсь, мы не сможем. Может быть, вы ничего не чувствуете в этом пространстве, но нас сейчас переносят к месту нашего задания.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
