	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Проще говоря, по контракту я обязан охранять десять отведенных территорий в мире.", "Генриетта")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Хотя это не мой выбор, я должен признать, что… если никто не будет делать работу, будет разорение.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Десять областей — соответствуют ли они десяти кругам «Древа Жизни»?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Рафилия смотрит на древовидный тотем в небе. Среди всех кругов один светится красным.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Это место… Йесод. Он символизирует происхождение всех видов и творческую силу бога. Его можно рассматривать как «Происхождение Жизни».", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Я никогда не был там раньше. Но как только мы попадаем в это пространство, наше место назначения не подлежит обсуждению.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Наверное, тогда уже некуда бросить, что вдруг напоминает мне о нашем старом друге…")
	await novel_interface.show_text_only("Я чувствую грудь к говорящему.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Странно. Прошло много времени с тех пор, как Mariru последний раз связывался со мной…)", "Lian")
	await novel_interface.hide_character()
