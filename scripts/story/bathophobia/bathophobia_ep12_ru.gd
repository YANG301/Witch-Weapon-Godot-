	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда я реву от ярости, золотой тотем вокруг нас начинает трескаться.")
	await novel_interface.show_text_only("Кррр… Кррр… Кррр…")
	await novel_interface.show_text_only("Это похоже на треск стекла в пустоте.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Что?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("??", "Генриетта")
	await novel_interface.hide_character()
