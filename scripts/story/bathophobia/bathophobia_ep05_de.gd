# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("Was ist die Seele?")
	await novel_interface.show_text_only("Eine Energieform, die das Bewusstsein erhält? Oder ein nicht beobachtbarer Quantenzustand?")
	await novel_interface.show_text_only("Oder einfach nur ein Konzept…")
	await novel_interface.show_text_only("Genau wie das Konzept der Zeit in der Physik –")
	await novel_interface.show_text_only("Vielleicht ist es nur eine Illusion ... ein Traum.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Dann ist die Frage:")
	await novel_interface.show_text_only("Wer ist der Träumer?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("Die beißende Kälte in der Antarktischen Konvergenz hält jeglichen Lärm von der Außenwelt fern.")
	await novel_interface.show_text_only("20.000 Fuß unter dem Meeresspiegel liegt die Abgrundzone.")
	await novel_interface.show_text_only("Eingehüllt in einen Titan-Druckrumpf sinkt ein Tiefsee-U-Boot langsam.")
	await novel_interface.show_text_only("Das schwache Licht, das von seiner Statusanzeige ausgeht, wird schnell von der abgrundtiefen Dunkelheit verschlungen.")
	await novel_interface.show_text_only("Ohne Licht ist es nicht in der Lage, den Raum wahrzunehmen.")
	await novel_interface.show_text_only("Ein gruseliger Fangzahn versucht, den Rumpf zu treffen, erhält aber keine Reaktion.")
	await novel_interface.show_text_only("Der Wasserdruck von 60 MPa stellt die Druckspannungsgrenze des Rumpfes auf die Probe.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("Plötzlich werden acht vorprogrammierte Suchscheinwerfer gleichzeitig eingeschaltet und werfen acht gerade, schmale Lichtstrahlen.") #换行问题
	await novel_interface.show_text_only("Wie scharfe Schwerter strahlen die Scheinwerfer in grellem Licht durch die Dunkelheit.")
	await novel_interface.show_text_only("Ein Lichtstrahl dringt durch die dicken Fensterscheiben des Kontrollraums und fällt auf das Gesicht eines schlafenden Mädchens.")
	await novel_interface.show_text_only("Ihr langes dunkelgraues Haar, das in blauem Glanz schimmert, fällt über ihr blasses, aber reines Gesicht.")
	await novel_interface.show_text_only("Der Tiefenmesser auf dem Armaturenbrett vor dem Mädchen funktioniert bei 4091 Fuß nicht mehr.")
	await novel_interface.show_text_only("Die Scheinwerfer außerhalb des Raumes verblassen allmählich. Doch ein schwacher, silberner Schimmer beginnt um den Körper des Mädchens zu flackern.")
	await novel_interface.show_text_only("Aus den Tiefen des von Menschen sehr gefürchteten Ozeans ertönt eine tiefe und ferne Stimme.")
	await novel_interface.show_text_only("Wie der Ruf eines uralten Monsters.")
	await novel_interface.show_text_only("Das schlafende Mädchen scheint aus dem Mutterleib erwacht zu sein.")
	await novel_interface.show_text_only("Auch beim Aufwachen kommt es zu unkontrollierbarem Schwindel und Übelkeit …")
	await novel_interface.show_text_only("Weit unterhalb der Sicherheitstiefe von 15.000 Fuß beginnt der Metallrumpf ein ungewöhnliches Knackgeräusch zu erzeugen.")
	await novel_interface.show_text_only("Ein unterdrückter Husten steigt aus der Kehle des Mädchens.")
	await novel_interface.show_text_only("Anfangs hat sie einige Atembeschwerden, gewöhnt sich aber schnell an den Unterwasserdruck und beruhigt ihren Atem.")
	await novel_interface.show_dialog("Die Kollision gerade ... Scheint mich bewusstlos gemacht zu haben.", "Mädchen")
	await novel_interface.show_dialog("Aber ich kann noch atmen... Es muss genügend Sauerstoff vorhanden sein.", "Mädchen")
	await novel_interface.show_dialog("Ich kann meinen Atem sehen ... \\nNatürlich fast 32 °F ...", "Mädchen")
	await novel_interface.show_dialog("Systemprüfung. Bereit für einen Kaltstart. \\nIdentifikationsinformationen: Beth.", "Mädchen")
	await novel_interface.show_text_only("Das Mädchen namens Beth scheint sich über die eisigen Temperaturen keine Sorgen zu machen. Aufmerksam prüft sie das System.")
	await novel_interface.show_text_only("Sie wurde mit der Fähigkeit geboren, extreme Kälte auszuhalten. Als Baby Beth in den Winterbergen gefunden wurde, hatte sie bereits eine ganze Nacht auf dem Eis verbracht.")
	await novel_interface.show_text_only("Eine Reihe körperlicher Untersuchungen haben gezeigt, dass sich das Wundermädchen an verschiedene kalte Umgebungen anpassen kann.")
	await novel_interface.show_text_only("Unter der starken Kälte, die einen Erwachsenen innerhalb von 30 Sekunden bewusstlos machen könnte, ist ihre Körpertemperatur immer noch normal und ihre Hände warm.")
	await novel_interface.show_text_only("Die Ärzte konnten den Grund nicht herausfinden, bevor sie von ihrem Adoptivvater aus dem Waisenhaus geholt wurde.")
	await novel_interface.show_dialog("Beleuchtungs- und Antriebssysteme... normaler Start. Sensor-Neustart... alles gut.", "Beth")
	await novel_interface.show_dialog("Ist es bereits 20.000 Fuß tief? „Dieses Ding“ kann unter so hohem Wasserdruck nicht existieren.", "Beth")
	await novel_interface.show_dialog("Ich muss Strom für die Rückfahrt sparen … Suchscheinwerfer aus –", "Beth")
	await novel_interface.show_text_only("Gerade als die Scheinwerfer ausgeschaltet werden, wirft Beth einen Blick aus dem Fenster.")
	await novel_interface.show_dialog("Was…", "Beth")
	await novel_interface.show_text_only("Eine gruselige Szene lässt ihr die Haare zu Berge stehen.")
	await novel_interface.show_dialog("Was ist... das...", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Kurz bevor die Suchscheinwerfer losgehen, erscheint außerhalb des Beobachtungsfensters eine riesige korallenähnliche Struktur.")
	await novel_interface.show_text_only("Es handelt sich um eine zentripetale gewebeartige Struktur. Darauf sehen unregelmäßige Gefäße aus wie eine scharlachrote Kaskade, die in ein riesiges Schwarzes Loch fällt.")
	await novel_interface.show_text_only("Bei der aktuellen Untersuchung wurden jedoch keine biologischen oder topografischen Strukturen gefunden.")
	await novel_interface.show_text_only("Beth schaltet sofort das Weitwinkelobjektiv am Rumpf ein und versucht, einen größeren Überblick zu gewinnen –")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Auf dem Bildschirm ist ein riesiger und nebliger Schatten zu sehen. Es erstreckt sich über mehr als 300 Fuß und hat Tentakel.")
	await novel_interface.show_dialog("Das kann nicht sein...", "Beth")
	await novel_interface.show_text_only("Es ist kein Teil der Landschaft, sondern mit Sicherheit eine Art Lebewesen. Rote Lichtflecken leuchten in der Dunkelheit.")
	await novel_interface.show_dialog("Ist das... ein Augapfel?", "Beth")
	await novel_interface.show_text_only("– Wenn man dieses seltsame Ding als „Augapfel“ bezeichnen kann.")
	await novel_interface.show_text_only("Das dem Fenster zugewandte Schwarze Loch ist die Pupille des Augapfels.")
	await novel_interface.show_text_only("Es ist zu nah, um die Entfernung zu bestimmen. Es ist wahrscheinlich, dass der Rumpf jeden Moment in die Pupille gesaugt wird.")
	await novel_interface.show_text_only("Rote Flecken verschwinden. Das Mädchen steht nun in der stillen Dunkelheit dem unbekannten Objekt gegenüber.")
	await novel_interface.show_text_only("Als sich ihre Augen an die Dunkelheit gewöhnen, sieht sie auf dem Bildschirm den riesigen Augapfel, der schwaches rotes Licht ausstrahlt, als wäre er eine undurchsichtige Qualle.")
	await novel_interface.show_text_only("Der Augapfel ist mit Klumpen windigen Gewebes gefüllt. \\nEs schlägt mit ihrem Herzen.")
	await novel_interface.show_dialog("(Entspann dich... entspann dich!) \\n(Denk darüber nach...)", "Beth")
	await novel_interface.show_text_only("Wenn es sich um einen Augapfel handelt, sollte seine Augenlinse lichtempfindlich sein.")
	await novel_interface.show_text_only("Auf der äußeren Schicht des Augapfels, wo sich die Aderhaut befinden sollte, flackern Schwärme weißer Flecken.")
	await novel_interface.show_text_only("Beth bemerkt, dass an der Rückseite des Augapfels astartige Tentakel befestigt sind.")
	await novel_interface.show_text_only("Die dunkelgrauen Tentakel versinken in der Tiefe des Ozeans, ohne dass ein Ende in Sicht ist.")
	await novel_interface.show_dialog("(… ich kann mich nicht… bewegen…)", "Beth")
	await novel_interface.show_text_only("—Beth ist eher so, als würde man von ihm beobachtet, statt sich diesem Ding zu stellen.")
	await novel_interface.show_text_only("Der aufdringliche Blick untergräbt ihre Ruhe und macht ihr Angst.")
	await novel_interface.show_dialog("Hilfe…", "Beth")
	await novel_interface.show_text_only("—Wird es alles verschlingen?")
	await novel_interface.show_text_only("Das seltsame Gefühl, tief unten im Meer zu sein, lässt sie an ihrer Existenz zweifeln.")
	await novel_interface.show_dialog("(Ist es ein Traum...?) \\n(Wach auf, schnell...)", "Beth")
	await novel_interface.show_text_only("Ihr Körper reagiert instinktiv, noch bevor ihr Verstand nachkommt.")
	await novel_interface.show_text_only("Während das Mädchen mit der linken Hand den Joystick zog, bewegte sich die Tauchkammer weiter ein gewisses Stück in Richtung Augapfel.")
	await novel_interface.show_text_only("Das Wasser wird rau, als würde das Ding gestört.")
	await novel_interface.show_text_only("Die Pupille verengt sich und wartet auf die nächste Bewegung des Mädchens.")
	await novel_interface.show_dialog("Hallo? Hallo?", "Beth")
	await novel_interface.show_text_only("Beth schnappt sich ihr Headset und versucht, sich mit dem Kontrollpult zu verbinden.")
	await novel_interface.show_text_only("Aber keine elektromagnetische Welle kann dieser Tiefe entkommen, und eine akustische Kommunikation unter Wasser ist derzeit nicht realisierbar.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Wenn sie da wäre ... Sie hätte mich angeschrien: \\n„Hör auf, näher zu kommen!“")
	await novel_interface.show_dialog("Ha... warum sollte ich daran denken...", "Beth")
	await novel_interface.show_dialog("Wer ist... „Sie“?", "Beth")
	await novel_interface.show_dialog("Wo... bin ich...", "Beth")
	await novel_interface.show_text_only("Beth wird vom riesigen Augapfel angestarrt und ist benommen. Die Grenze zwischen Realität und Illusion verschwimmt langsam.")
	await novel_interface.show_text_only("Sie fährt mit der Hand über das Armaturenbrett.")
	await novel_interface.show_text_only("Bald findet sie die Roboterarmsteuerung.")
	await novel_interface.show_dialog("(Muss ich das wirklich?)", "Beth")
	await novel_interface.show_text_only("Sie holt Luft, doch das illusorische Licht blitzt weiterhin vor ihren Augen auf.")
	await novel_interface.show_dialog("Ein paar Proben nehmen... und dann sofort zurückziehen...", "Beth")
	await novel_interface.show_text_only("Richten Sie die Scheinwerfer zunächst nach vorne ...")
	await novel_interface.show_text_only("Dann richten Sie das Antriebssystem ein ... maximale Geschwindigkeit. Richtung...umkehren.")
	await novel_interface.show_text_only("Das Mädchen kämpft darum, die Vorkonfiguration abzuschließen, und steht kurz davor, das Bewusstsein zu verlieren.")
	await novel_interface.show_dialog("Vater, ist das… spirituelle Verschmutzung… \\nIch bin fast…", "Beth")
	await novel_interface.show_text_only("Beth betätigt den Manipulator langsam, um den Roboterarm freizugeben. Eine riesige Nadel kommt zum Vorschein.")
	await novel_interface.show_dialog("Saugmodus eingeschaltet... Bei diesem Druck reicht ein kurzer Zug aus...", "Beth")
	await novel_interface.show_text_only("Der Roboterarm streckt sich nach vorne, bis die Nadel in den Glaskörper eingeführt wird.")
	await novel_interface.show_text_only("Der Konzentrationsgrad des Behälters springt augenblicklich von 0 auf 100 %.") #标点删除
	await novel_interface.show_text_only("Für einen Moment ist die Pupille verzerrt. Wenn Geräusche den Rumpf durchdringen konnten, musste sie einen lauten Schrei gehört haben …")
	await novel_interface.show_dialog("(Ich höre Dinge…)", "Beth")
	await novel_interface.show_text_only("Mit ihrer letzten Anstrengung drückt das Mädchen den programmierten Ausführungsknopf.")
	await novel_interface.show_text_only("Je nach voreingestelltem Programm projizieren die Suchscheinwerfer acht intensive Lichtstrahlen in die Pupille und der Propeller beginnt wild zu rotieren.")
	await novel_interface.show_text_only("Der Augapfel zieht sich durch die Stimulation des Lichts zurück und die Hülle beginnt sich zurückzuziehen und zu heben ...")
	await novel_interface.show_text_only("Völlig erschöpft verliert das Mädchen das Bewusstsein und fällt zu Boden.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
