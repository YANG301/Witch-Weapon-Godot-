# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-choo…", "Beth")
	await novel_interface.show_text_only("Das Mädchen legte ihren Kopf auf den Schreibtisch und hätte einnicken können, wenn es nicht dieses Niesen gegeben hätte.")
	await novel_interface.show_text_only("Draußen vor dem U-Boot-Fenster herrscht Polarnacht, und an der Farbe des Himmels kann sie die Uhrzeit nicht erkennen.")
	await novel_interface.show_text_only("Beth blickt auf den Bildschirm und stellt fest, dass ihre Begegnung mit dem Tiefseemonster nur wenige Stunden her ist.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Mache ich das Richtige?", "Beth")
	await novel_interface.show_dialog("(Ich benutze sie, um die Wahrheit für mich selbst herauszufinden...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ohne es zu merken, wirft Beth einen Blick auf das Notizbuch in ihrer Hand.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Wenn Vater hier wäre…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("– Er würde niemals wegen solcher Emotionen schwanken.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Beth denkt an die starken Hände ihres Vaters und ballt langsam ihre Faust.")
	await novel_interface.show_text_only("Das Notizbuch voller obskurer Texte gehörte einst ihrem Adoptivvater.")
	await novel_interface.show_text_only("Er war ein großer, stiller und hingebungsvoller Biologe, der sowohl Beth als auch sich selbst gegenüber streng war.")
	await novel_interface.show_text_only("Aufgrund von Beths besonderen Fähigkeiten arrangierte er neben ihren Schulaufgaben auch strenge Schulungen für sie.")
	await novel_interface.show_text_only("Beth erinnert sich, dass sie jeden Tag besonders hart arbeiten musste, um die von ihrem Vater gesetzten Ziele zu erreichen.")
	await novel_interface.show_text_only("Was sie am meisten erwartete, war das gelegentliche Lächeln des Erkennens auf seinem ernsten Gesicht.")
	await novel_interface.show_text_only("Ohne viel Zärtlichkeit hatte der zurückhaltende Mann sie auf seine Weise beschützt...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("– Als würde sie sie auf ein unausweichliches Schicksal vorbereiten …")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("An ihrem 12. Geburtstag erhielt Beth ein anonymes Paket. Darin befand sich dieses Notizbuch – und die Nachricht vom Tod ihres Vaters.")
	await novel_interface.show_text_only("Bei einer Gasexplosion kamen mehr als 30 Menschen ums Leben, darunter Beths einziges verbliebenes Familienmitglied auf der Welt.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mit zitternden Lippen formt Beth einen stummen Namen.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Hinweise hinter diesem Namen machten ihr klar, dass der Tod ihres Vaters kein Unfall war, wie offiziell berichtet wurde.")
	await novel_interface.show_text_only("Das einsame Mädchen musste ihre Tränen trocknen und schnell erwachsen werden, um die unbekannten Gefahren zu überleben.")
	await novel_interface.show_text_only("– Ihr Vater sagte im Notizbuch, dass ihre besondere Fähigkeit sie einer Gefahr aussetzen und sie zum Ziel der Bande machen würde.")
	await novel_interface.show_text_only("Das Paket würde erst verschickt, wenn er sie nicht mehr beschützen konnte...")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Warum sollten sich Menschen nach … einer solchen Fähigkeit sehnen …)", "Beth")
	await novel_interface.show_dialog("(Ist das nicht eher ein Fluch…)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth schaut auf ihre Handfläche. Mehrere Kugeln aus silbernen Lichtern springen über ihre Finger.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth weiß, dass sie anders ist, seit sie sich an Dinge erinnern kann – aber nicht wegen ihrer besonderen Fähigkeit.")
	await novel_interface.show_text_only("Schon als Kind hatte sie ein eidetisches Gedächtnis für Zahlen. Sie kann viel schneller im Kopf rechnen als andere und interessiert sich sehr für Maschinen.")
	await novel_interface.show_text_only("Aber ihr Vater bat sie, sich zurückzuhalten und sich wie ein gewöhnliches Kind zu verhalten, um ihre besonderen Fähigkeiten zu verbergen.")
	await novel_interface.show_text_only("Nach seinem Tod beschloss Beth, sich nicht mehr zu verstecken.")
	await novel_interface.show_text_only("Ein Jahr später wurde sie mit Sondergenehmigung an einer renommierten Universität zugelassen, eine Ausnahme, die zum ersten Mal seit Jahren gemacht wurde.")
	await novel_interface.show_text_only("Sie lernte fleißig und las viel, konnte aber weder in Büchern noch im Unterricht die Antwort finden.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Warum bin ich anders…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie lernte und dachte weiter, als wollte sie ihre lange unterdrückte Neugier auf einmal befriedigen.")
	await novel_interface.show_text_only("Sie wusste nicht, dass sie auf diese Weise als arrogant, gleichgültig und unnahbar abgestempelt wurde.")
	await novel_interface.show_text_only("Allmählich wandten sich die Leute von ihr ab, aber das war ihr egal.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Sonst hätte ich dich nicht kennengelernt…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie lernte Silvia bei einem Unfall kennen.")
	await novel_interface.show_text_only("Beth brauchte nur wenige Minuten, um herauszufinden, dass Silvia eine als Studentin verkleidete Ermittlerin war. Ihre Mission war es, auf dem Campus nach illegalen Substance H zu suchen.")
	await novel_interface.show_text_only("Sie wusste, dass Silvias Name und ihre Erfahrungen allesamt falsch sein konnten, fühlte sich aber dennoch von ihrer sorglosen und fröhlichen Art angezogen.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Sie ist… anders.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sie kennt mich besser als jeder andere...")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Obwohl sie es gewohnt ist, sich vor anderen zu verkleiden …)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie hat mir wirklich und vorbehaltlos ihr Herz geöffnet.")
	await novel_interface.show_text_only("Aber keiner von ihnen hatte damit gerechnet, dass ihre Freundschaft die Aufmerksamkeit der Organisation hinter Milk erregen würde.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Da er wusste, dass sie die Adoptivtochter des berühmten Biologen war, lud Milks Chef sie ein, sich der Antarktismission anzuschließen.")
	await novel_interface.show_dialog("(Ich wollte ablehnen…)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("In einer unterirdischen Basis des Trupps.")
	await novel_interface.show_text_only("Was sie dazu brachte, ihre Meinung zu ändern und sich für den Beitritt zu entscheiden, war ein Symbol auf dem Missionsführer:")
	await novel_interface.show_text_only("Ein Symbol, das sie im Notizbuch ihres Vaters sah.")
	await novel_interface.show_text_only("Ein gruseliger schwarzer Augapfel, der eine geheime religiöse Organisation darstellt.")
	await novel_interface.show_text_only("Ihr Vater zeichnete seine Kontakte mit Leuten dieser Organisation auf. Sie hatten die Absicht gezeigt, Menschen mit besonderen Fähigkeiten zu mobilisieren und eine militante Gruppe zu bilden.")
	await novel_interface.show_text_only("Der Plan erhielt den Namen Projekt Ningen.")
	await novel_interface.show_text_only("Nachdem ihnen Dokumente aus ihrem Waisenhaus in die Hände gefallen waren, stand Beth auf der Fahndungsliste des Projekts Ningen.")
	await novel_interface.show_text_only("Dadurch wurde ihr Vater zum Ziel dieser gefährlichen Organisation.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen… die Antarktis.)", "Beth")
	await novel_interface.show_dialog("(Die Basis der Schneekönigin in der Antarktis…) \\n(Sie ist nach einer Geschichte in Andersens Märchen benannt.)", "Beth")
	await novel_interface.show_dialog("Auf Dänisch heißt es Snedronningen \\nOder Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(Kein Zufall.)", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ihr Chef und die Bande verfolgen also das Gleiche...", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Eurem Gesichtsausdruck nach zu urteilen scheint diese Bande härter zu sein als die anderen auf der Schwarzen Liste …", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth nickt, aber sie will nicht weiter reden.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Entschuldigung. Ich habe mich dieser Mission aus egoistischen Motiven angeschlossen.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Nun, das weiß ich.", "Milch")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Aber Boss möchte nur, dass Sie die Forschungen Ihres Vaters über Meereslebewesen fortsetzen.", "Milch")
	await novel_interface.show_dialog("Es ist also eine Win-Win-Situation.", "Milch")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Was deine egoistischen Beweggründe betrifft... Ich weiß, dass du von mir so fasziniert bist, dass du dich entscheidest, hier zu bleiben.", "Milch")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Oh, das ist zu viel Druck für mich!", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sagte Milk und warf Bai Yan einen Kuss zu, was Bai Zhu zum Lächeln brachte.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Was sie nicht bemerkt, ist ein flüchtiger Düsternis in den klaren Augen ihrer Freundin.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Sie fühlt sich immer noch schuldig, wenn sie an den Moment denkt, als sie den Papierkram unterschrieben hat.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Ich habe sie… benutzt.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth setzt sich an den Schreibtisch, zückt einen Stift und starrt auf das aufgeschlagene Notizbuch.")
	await novel_interface.show_text_only("Wertvoll sind die Nützlichen.")
	await novel_interface.show_text_only("– Sie notiert ihren Gedanken.")
	await novel_interface.show_text_only("Du hast mir das erzählt... Und ich habe dir immer zugestimmt...")
	await novel_interface.show_text_only("Benutze andere oder werde skrupellos ausgenutzt \\n„Das ist etwas, das du für selbstverständlich hältst…“")
	await novel_interface.show_text_only("Es kommt nur darauf an, wer einen höheren Wert hat.")
	await novel_interface.show_text_only("Es besteht kein Grund zur Erklärung. Konzentrieren Sie sich einfach auf Ihr Ziel.")
	await novel_interface.show_text_only("Nur eine so einfache Beziehung kann Sie vor den meisten Menschen schützen.")
	await novel_interface.show_text_only("Beth macht eine Pause.")
	await novel_interface.show_text_only("Aber du hast mir auch gesagt, dass es immer noch …")
	await novel_interface.show_text_only("Jemand, der von dir benutzt werden will, egal was passiert. \\n„Und jemand, den Sie unter keinen Umständen benutzen möchten.“")
	await novel_interface.show_text_only("Als sie daran denkt, huscht ein leichtes Lächeln über ihre Lippen.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Schuld? Es ist ein Gefühl, das abgelegt werden muss.)", "Beth")
	await novel_interface.show_dialog("(Ist es dann … Zuneigung?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth schließt ihr Tagebuch.")
	await novel_interface.show_text_only("Jetzt hat sie ihre Antwort gefunden.")
	await novel_interface.show_text_only("Sie schaut aus dem Fenster und stellt fest, dass der dunkelblaue Himmel immer tiefer wird und fast mit dem unendlichen Meer verschmilzt.")
	await novel_interface.show_text_only("Plötzlich ertönt auf dem Schiff ein Notfallalarm.")
	await novel_interface.show_text_only("Achtung, alle Crew. Richtlinie geändert. Melden Sie sich in zehn Minuten im Besprechungsraum.")
	await novel_interface.show_text_only("Wiederholen. Richtlinie geändert…")
	await novel_interface.show_text_only("Beth holt tief Luft, legt das Notizbuch weg und eilt aus dem Zimmer.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
