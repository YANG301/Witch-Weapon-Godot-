# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Milk ritorna nella sala di controllo e blocca la porta principale con una sedia.")
	await novel_interface.show_text_only("Il gruppo di nemici più vicino arriverà in pochi minuti. Presto anche l’altro gruppo incontrerà la squadra di Milk nell’ala est.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Hmm. Avrei dovuto pensarci prima...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se avessi la mia truppa di soldati estremamente agili con un udito acuto e incredibili capacità di autoguarigione...")
	await novel_interface.show_text_only("Perché equipaggiarli con lame e non con armi da fuoco?")
	await novel_interface.show_text_only("Questi nemici si muovono in gruppi, non hanno alcuna strategia di cui parlare, anche se sono tutti combattenti incredibilmente efficaci.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Non possono più essere considerate umane, queste ragazze...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk lancia un'occhiata alla fila di apparecchiature a sinistra del pannello di controllo principale. Su di esso si trova la scatola dei campioni che Beth ha lasciato dietro di sé.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("La missione... non ha più importanza.","Milk")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Immagino che le misure di difesa offensiva strategica impiegate qui non siano poi così male...","Milk")
	await novel_interface.show_dialog("Spero che l'altoparlante funzioni ancora...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fa un respiro profondo, si calma, prima di digitare una serie di comandi nel pannello di controllo...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Nel frattempo, nel magazzino buio, Beth svolazza per la stanza, cercando freneticamente qualcosa che potrebbe anche non essere lì.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("La password... \\nQual è la password?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con le dita tremanti, non ha più idea di quali tasti stia premendo sul pannello della serratura.")
	await novel_interface.show_text_only("Se ottiene la password giusta, può uscire dal magazzino e combattere al fianco della sua amica.")
	await novel_interface.show_text_only("Ma Milk, dall’altra parte del muro, non ha lasciato alcun indizio su quale possa essere la password.")
	await novel_interface.show_text_only("Forse non le lascerà mai più un altro suggerimento...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("No! No!\\nNon posso accettarlo! Non lo accetterò!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In preda alla frenesia, Beth continua a colpire la porta con i pugni, ma i suoi tentativi di evadere sono inutili.")
	await novel_interface.show_text_only("Tutto quello che può fare è immaginare cosa accadrà dopo dall'altra parte del muro, tutta sola nello spazio buio, silenzioso e angusto.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Per favore, no...","Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Sono inutile... )","Beth")
	await novel_interface.show_dialog("(Non posso salvare nessuno...)","Beth")
	await novel_interface.show_dialog("(Non Padre... non Latte... )","Beth")
	await novel_interface.show_dialog("(Come... è successo... ?)","Beth")
	await novel_interface.show_dialog("(Perché sono così debole...?)","Beth")
	await novel_interface.show_dialog("(Così impotente...)","Beth")
	await novel_interface.show_dialog("(... Ed egoista.)","Beth")
	await novel_interface.show_dialog("(Perché?)","Beth")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("Tutto quello che voglio è non sentirmi solo, non avere freddo...")
	await novel_interface.show_text_only("Non sto chiedendo troppo, vero... ?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza siede da sola nell'oscurità, con le spalle tremanti per i singhiozzi.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Quasi non si accorge che il combattimento intenso e continuo ha esaurito il suo corpo fino al midollo.")
	await novel_interface.show_text_only("La malattia da decompressione le sta confondendo il cervello.")
	await novel_interface.show_text_only("È come se ci fosse dell’acqua che le frullava nella testa, incasinando la sua coscienza un po’ alla volta.")
	await novel_interface.show_text_only("Forse non se ne rendeva conto, dopo tutto, trovarsi nell'oceano oscuro e profondo...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Si sente come se fosse in cima a un ghiacciaio, anzi, dentro uno. Il ghiaccio, tagliente e denso, le trafigge il cuore, la sua anima.")
	await novel_interface.show_text_only("Il suo corpo flessibile si congela, a poco a poco, e il suo sangue comincia a rapprendersi.") #换行问题
	await novel_interface.show_text_only("Innumerevoli gruppi di pura luce la circondarono fino a coprire completamente la sua esistenza.")
	await novel_interface.show_text_only("Non c’è più dolore, non più solitudine.")
	await novel_interface.show_text_only("Non di più.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("In questo mondo di bianco puro, sente una melodia familiare.")
	await novel_interface.show_dialog("... Latte?","Beth")
	await novel_interface.show_text_only("Questa è la loro canzone preferita. La loro canzone.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("In un'esplosione esplosiva, centinaia di sfere luminose volano fuori dal corpo di Beth.")
	await novel_interface.show_text_only("La ragazza sbatte le palpebre e apre gli occhi. L'accecante luce bianca, con un rimbombo assordante, ha spazzato via l'intero muro.")
	await novel_interface.show_text_only("L'altoparlante nella sala di controllo sta suonando la loro canzone, echeggiando lungo tutto il tunnel. Milk deve aver usato il file audio che aveva salvato nell'orologio.")
	await novel_interface.show_text_only("Decine di nemici si sono radunati, attratti dal suono. Erano così tanti, molto più di quanti ne avessero contati sullo schermo.")
	await novel_interface.show_text_only("I nemici hanno circondato l'ingresso della sala di controllo.")
	await novel_interface.show_text_only("Beth è a soli trenta metri dalla sala di controllo adesso.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(Mi servono solo dieci secondi... no, cinque... )","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cinque secondi per raggiungere la sua migliore amica idiota e impedirle di fare qualunque cosa stia per fare.")
	await novel_interface.show_text_only("Un folto gruppo di soldati parassiti sciamò immediatamente verso Bai Zhu e diverse lame affilate attaccarono improvvisamente da dietro di lei.")
	await novel_interface.show_text_only("Si gira, sparando diversi colpi di proiettili sotto forma di raggi di luce brillanti, facendo esplodere i suoi bersagli in mille pezzi sul muro.")
	await novel_interface.show_text_only("Continua a correre verso la sala di controllo, il corpo risplende di una luce, più brillante che mai.")
	await novel_interface.show_text_only("Le onde di energia che si irradiano dal suo corpo squarciano le pareti interne del tunnel. Lei brilla, accecante, come un requiem dai Cieli.")
	await novel_interface.show_text_only("Nessuno può fermarla adesso.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("Innumerevoli raggi bianchi dirompenti fuoriescono dalla base di Snedronningen, illuminando il cielo stellato, come se l'alba fosse caduta sul continente addormentato.")
	await novel_interface.show_text_only("Come un rito di benvenuto per una divinità, quasi.")
	await novel_interface.show_text_only("All'improvviso, l'intero continente inizia a tremare...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("In pochi secondi, Beth ha ucciso dozzine di nemici contemporaneamente. Lei cade all'indietro, la vista offuscata dalla luce abbagliante.")
	await novel_interface.show_text_only("Il potere che emerge dal suo corpo è vicino a inghiottirla completamente.")
	await novel_interface.show_text_only("Mentre scaglia via un nemico con la lama nella mano destra...")
	await novel_interface.show_text_only("Una dozzina di nemici sfondano la porta bloccata della sala di controllo e caricano all'interno.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Aspettami... idiota...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"Sto arrivando... \"")
	await novel_interface.show_text_only("Bum!")
	await novel_interface.show_text_only("Un gigantesco arco elettrico si propaga dalla sala di controllo. Poi arrivano le esplosioni, innumerevoli esplosioni fiammeggianti in un secondo, proprio davanti agli occhi di Beth.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("È come se il tempo si fosse fermato.")
	await novel_interface.show_text_only("Si ferma di colpo, cadendo in ginocchio, a pochi metri dalla sala di controllo.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("È allora che questo continente ghiacciato, spietato e freddo, apre finalmente gli occhi dal suo sonno senza fine.")
	await novel_interface.show_text_only("Nell’oscurità, un’ombra dorata emerge dagli strati di ghiaccio sotterranei, squarcia il terreno del tunnel, trafigge silenziosamente il busto della ragazza.")
	await novel_interface.show_text_only("È una lancia, dall'aspetto semplice se non fosse per gli intricati motivi dorati che turbinano attorno alla punta.")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_text_only("Un caldo flusso di calore attraversò la punta della pistola, seguì il corpo della pistola e si fuse con il sangue.")
	await novel_interface.show_text_only("Le sue braccia cadono mollemente lungo i fianchi. Anche se le sue pupille si dilatano, lei lo fissa, come se non fosse ancora pronta ad arrendersi.")
	await novel_interface.show_text_only("A terra, sangue cremisi.")
	await novel_interface.show_text_only("Gocciolamento. Gocciolare. Gocciolare.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La luce brillante che avvolge il continente svanisce.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
