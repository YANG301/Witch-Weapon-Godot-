	await novel_interface.show_dialog("Tôi e rằng Salmonton sẽ ngay lập tức áp dụng các biện pháp trừng phạt thương mại đối với New Opulentia một khi cô gái trẻ bước vào phòng thí nghiệm của bạn.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Danh tiếng của tôi? Thật sự? \\nHahaha…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ừm, thế là đủ rồi!", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Nói về những người có vũ trang vô danh ở khách sạn Sky…", "Kirs")
	await novel_interface.show_dialog("Họ tấn công phái đoàn Salmonton và cướp đi một số tác phẩm nghệ thuật có giá trị…", "Kirs")
