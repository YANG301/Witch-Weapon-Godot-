	await novel_interface.show_dialog("… Đó là tất cả những gì chúng tôi biết về sự cố của phái đoàn Salmonton.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers đã ghé thăm New Opulentia một lần nữa để thực hiện một số \"việc vặt cá nhân\".", "Mariru")
	await novel_interface.show_dialog("Bây giờ, SID đã đưa cô ấy vào danh sách bảo vệ cấp A.", "Mariru")
	await novel_interface.show_dialog("Tuy nhiên, lần này, Salmonton đã gửi đầy đủ thông tin chi tiết về phái đoàn và danh sách đầy đủ các mặt hàng bị hạn chế cho Bộ Ngoại giao.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Họ thậm chí còn báo cáo tất cả các hoạt động quân sự mà nhân viên an ninh của họ đã tham gia trong quá khứ. Bạn không thể tìm thấy một sai sót nào trong hồ sơ…", "Mariru")
