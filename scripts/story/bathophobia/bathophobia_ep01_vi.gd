	await novel_interface.show_dialog("(Thật tiếc… Thông tin đó không đủ để khiến anh ấy phân tâm.)", "Mariru")
	await novel_interface.show_dialog("(Thật đau đầu quá…) \\n(Chà, tôi e rằng đã đến lúc kiểm tra những tài liệu giả mạo đó. Giờ kể chuyện thôi các bạn.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Chúng ta bắt đầu nhé em yêu?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Trong Chiến tranh Bảy năm, các nhà khoa học đã nỗ lực phát triển các công nghệ mới cho phép con người kích hoạt Divine Touch.", "Mariru")
	await novel_interface.show_dialog("Có tin đồn rằng các thí nghiệm chỉnh sửa cơ thể con người đã được tiến hành bí mật trên các chiến binh. Tôi tin rằng bạn đã nghe những tin đồn như vậy.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Ừm-hưm.", "Kirs")
	await novel_interface.hide_character()
