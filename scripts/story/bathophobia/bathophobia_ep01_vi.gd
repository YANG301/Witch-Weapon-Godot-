	await novel_interface.show_dialog("Theo hồ sơ Aegis, khoảng mười ID không xác định đã ngoại tuyến cùng lúc vào đêm hôm đó. Chắc hẳn họ đã rút lui khỏi hiện trường.", "Mariru")
	await novel_interface.show_dialog("Vì SID đã chặn các chuyến khởi hành thường xuyên nên họ có thể đã trốn thoát qua các kênh ngoại giao.", "Mariru")
	await novel_interface.show_dialog("(Hoặc bị xử tử vì thất bại…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… tôi hiểu rồi.", "Kirs")
	await novel_interface.show_dialog("Substance H vũ khí không thể được sản xuất trên quy mô lớn như vậy.", "Kirs")
