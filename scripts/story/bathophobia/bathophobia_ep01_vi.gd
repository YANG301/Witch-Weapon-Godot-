	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Con cáo già đã giấu con bướm vàng khỏi Thượng viện và đổ lỗi cho Jacob và đồng bọn.)", "Mariru")
	await novel_interface.show_dialog("(Họ đã vô hiệu hóa camera an ninh tại khách sạn trước khi thực hiện hành động.) \\n(Có lỗ hổng thông tin ở đó…)", "Mariru")
	await novel_interface.show_dialog("Bàn tay của chúng tôi bị trói buộc tại Khu phi quân sự đã được thỏa thuận. Theo nhiều nguồn tin khác nhau, chúng tôi tin rằng họ đã sử dụng vũ khí đặc biệt.", "Mariru")
