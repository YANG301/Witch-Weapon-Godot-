	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Họ có đang sử dụng phần Thượng viện trong chiến lược tạo lập thị trường của mình không?) \\n(Và họ biết tôi sẽ đứng ngoài cuộc…)", "Mariru")
	novel_interface.change_expression("normal2")
