	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Không có gì to tát cả. \\nCó vẻ như dù sao thì bạn cũng không có ý định che giấu điều gì với chúng tôi.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vì vậy, cho phép tôi trình bày chi tiết hơn với bạn.", "Mariru")
	await novel_interface.show_dialog("Vệ tinh đã phát hiện ra một số Dòng chảy Không thời gian tại Khách sạn Sky, nhưng SID không có quyền thực hiện hành động ở đó.", "Mariru")
	await novel_interface.show_dialog("Vì vậy tôi đã cử hai đặc vụ chìm tới đó.", "Mariru")
	await novel_interface.show_dialog("Trong khi thực hiện nhiệm vụ, họ tình cờ gặp một nhóm người có vũ trang và một trong số họ đã bắn Annie bằng vũ khí đặc biệt.", "Mariru")
	await novel_interface.show_dialog("Bây giờ đặc vụ cuối cùng đã thoát khỏi nguy hiểm sau khi điều trị khẩn cấp và chúng tôi đã thu thập một số số liệu thống kê về vũ khí đó.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Tại sao bạn không nói với chúng tôi sớm hơn?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Thưa ông Giám đốc điều hành, tôi tự hỏi chính xác thì những “tác phẩm nghệ thuật” bị mất tích là gì?", "Mariru")
	await novel_interface.show_dialog("Có lẽ đã đến lúc tất cả chúng ta trở nên cởi mở hơn trong việc chia sẻ thông tin tình báo.", "Mariru")
