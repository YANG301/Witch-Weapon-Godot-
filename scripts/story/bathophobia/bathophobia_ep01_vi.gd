	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Vũ khí đặc biệt… ý bạn là vũ khí Substance H? \\nHọ đã sử dụng vũ khí bên trong khu vực bảo vệ Aegis?!", "Bright")
