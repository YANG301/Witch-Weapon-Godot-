# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Las extrañas figuras que han aparecido de repente en el pasillo se dirigen directamente hacia nosotros.")
	await novel_interface.show_text_only("Están totalmente en silencio, además del sonido de telas susurrando y pasos. ¿Necesitan siquiera respirar?")
	await novel_interface.show_text_only("Agarro mi arma con fuerza, preparándome mentalmente. Fue entonces cuando fuertes rayos de luz salen disparados del traje de batalla de Henriette. Desaparece de la vista en un instante, dejando tras de sí nada más que una nube de humo brillante.")
	await novel_interface.show_text_only("Mientras todavía estaba aturdido, Heinrich ya había esquivado frente a una persona y golpeó a una de las mujeres en el peto con el dorso de su espada de lapislázuli.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¡Vaya, ella tiene algunos movimientos!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El sonido fuerte y amortiguado de su arma al dar en el blanco resuena en las paredes del pasillo. Juro que me duele el pecho sólo de escucharlo.")
	await novel_interface.show_text_only("Su objetivo cae al suelo como una marioneta de madera y se aleja rodando.")
	await novel_interface.show_text_only("Cualquier humano se habría movido instintivamente para protegerse de mayores daños, pero esta marioneta no hace nada por el estilo.")
	await novel_interface.show_text_only("Una vez que deja de rodar, simplemente salta, con la abolladura en el pecho y todo, y carga contra nosotros.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al darse cuenta de que estos no son enemigos comunes, Henriette se da vuelta y atraviesa los talones de tres de ellos a la velocidad del rayo.")
	await novel_interface.show_text_only("Los tres, con los tendones cortados, caen al suelo; sin embargo, continúan arrastrándose hacia nosotros con movimientos inquietantemente silenciosos y espasmódicos.")
	await novel_interface.show_text_only("No parecen tan aterradores a primera vista, pero el hecho de que muestren características claramente no humanas es... muy inquietante, por decir lo menos.")
	await novel_interface.show_text_only("Parecen humanos. No actúan como humanos. Eso es espeluznante.")
	await novel_interface.show_text_only("Después de confirmar que los enemigos ya no representarán una amenaza, Raphael avanza en un intento de ver qué les pasa.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("De repente, el suelo empieza a temblar de nuevo.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("¿Otro terremoto?","Henriette")
	await novel_interface.show_text_only("Esta vez, el terremoto es más intenso y dura mucho más.")
	await novel_interface.show_text_only("Junto con los temblores, las luces del pasillo parpadean y se encienden, siguiendo lo que suena como un chirrido estridente, o tal vez como si alguien tirara de un metal.")
	await novel_interface.show_text_only("¿Los enemigos en el suelo parecen convertirse en... líquido transparente? ¿Espuma? Justo frente a nuestros ojos.") #换行问题
	await novel_interface.show_text_only("Luego, el líquido comienza a hervir y burbujear, como si estuviera sobre una tabla de teppanyaki. En cuestión de segundos, lo que antes eran figuras con forma humana se habían evaporado en la nada.")
	await novel_interface.show_text_only("No dejan ninguna huella sobre las frías tablas del suelo. Es como si esas chicas extrañas nunca hubieran existido.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Nuestro entorno parece haber cambiado también después del terremoto.")
	await novel_interface.show_text_only("Los adornos de madera de la sala de archivos se han desmoronado y se han convertido en simples serrín flotando en el aire. La pintura de las paredes también se ha despegado.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("... ¿Eh?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sigue siendo la misma sala de archivos...")
	await novel_interface.show_text_only("Pero las luces están apagadas. Las baldosas del suelo ya no brillan. Y los artículos en el estante, dispuestos de manera completamente diferente.")
	await novel_interface.show_text_only("Detrás de las gruesas vigas de acero de aspecto industrial, otra cámara de vigilancia con detección de sonido nos apuntaba con su lente oscura.")
	await novel_interface.show_text_only("En la pared hay un mapa topográfico detallado de la Antártida y sobre el escritorio un cuaderno que registra los cambios en los datos atmosféricos.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¿Qué... qué es esto?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("¿Lo que acabamos de ver... fue una ilusión?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿Esas marionetas también?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette mira su arma, que no está manchada de sangre, aunque debería estarlo. Luego mira hacia donde nuestros repentinos atacantes aparentemente se han evaporado.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Quizás lo que estábamos en... no era el mundo real.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich fue repentinamente interrumpido por la voz de Li Tong.")
	await novel_interface.show_dialog("¡Por fin! ¡Una conexión!","Mariru")
	await novel_interface.show_text_only("¿La voz de Mariru resuena desde... dentro de mi pecho?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("¡Hola, Mariru! ¿Qué pasa con la señal?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tararea, sonando exhausto. Mientras tanto, Henriette mira mi pecho con horror, confundida en cuanto a por qué la voz de Mariru proviene de allí.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(¡Oye, esto es un malentendido, lo juro!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al ver la expresión de mi rostro, Henriette asiente, como si lo entendiera, y comienza a palpar sus propios senos también.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Susurrando) ¿El Maestro... modificó mi cuerpo de esa manera también?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("¡Por supuesto que no! ¿Y por qué parecías entusiasmado con eso?")
	await novel_interface.show_dialog("Oye, por cierto, ¿por qué no nos contactaste con el walkie-talkie?\\n¿Está bien Annie?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("El satélite de comunicaciones ya está en posición. Annie está recopilando información sobre las fuentes de las fugas de metano. ¿Cómo te va por ahí?","Mariru")
	await novel_interface.show_text_only("Hago lo mejor que puedo para ordenar mis pensamientos e informar todo lo que encontramos después de ingresar a la base de la manera más concisa posible.")
	await novel_interface.show_dialog("... \\n(No es el mundo real, eh... )","Mariru")
	await novel_interface.show_dialog("Espera un segundo, déjame comprobar la hora.","Mariru")
	await novel_interface.show_dialog("Han pasado ocho minutos desde la última vez que se comunicó con Annie en la puerta de la base.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("... ¿Sólo ocho minutos?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("¿No deberían haber sido al menos cuarenta minutos?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como si se diera cuenta de algo, Mariru comienza a escribir.")
	await novel_interface.show_dialog("Un destructor clase Lebona que patrulla el Océano Antártico acaba de recibir algún tipo de señal de baja frecuencia.","Mariru")
	await novel_interface.show_dialog("Pensé que era una réplica, pero considerando cómo están las cosas ahora...","Mariru")
	await novel_interface.show_text_only("Mariru activa su sistema EEG y vuelve a ejecutar un análisis de patrón.")
	await novel_interface.show_dialog("Justo como esperaba...","Mariru")
	await novel_interface.show_dialog("Esta señal... tiene el mismo patrón que las ondas cerebrales durante el sueño REM humano...","Mariru")
	await novel_interface.show_dialog("... Pero sesenta y dos veces más intenso.","Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("... ¿Estás bromeando?","Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¿Quieres decir que estábamos soñando hace un momento?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("El tiempo sí se ralentiza cuando sueñas, eso es cierto...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("Los sueños reflejan recuerdos. Y lo que acaba de pasar... de hecho se sintió como una recombinación de diferentes fragmentos de memoria.","Henriette")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si eso fue un sueño, entonces definitivamente fue una pesadilla...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente recuerdo esta película que vi, donde los personajes usaban tótems para saber si estaban en un sueño o no. Ojalá tuviera uno de esos.")
	await novel_interface.show_dialog("... Quizás no fueron ustedes los que estaban soñando. Es posible que hayas estado en el sueño de otra persona.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("¿El sueño de otra persona...?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Todas estas son sólo especulaciones, por supuesto, que sólo sirven para ponerme nervioso aún más. Noto que hay un poco de ruido en el lado de Mariru; parece que mucha gente está ocupada trabajando a su alrededor.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por cierto, ¿cómo es... ahí fuera?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru permanece en silencio por un momento, como si intentara decidir cuánto quiere revelar.")
	await novel_interface.show_dialog("Es un poco más... complicado de lo que esperábamos.","Mariru")
	await novel_interface.show_dialog("El Congreso de los Estados Unidos está discutiendo actualmente cómo resolver el problema de las fugas de metano. Pero ya sabes cómo es su tipo de gente. De ninguna manera podrán hacer frente a un evento apocalíptico como este.","Mariru")
	await novel_interface.show_dialog("El Dr. Deckers de Salmonton propuso un plan para utilizar arqueas metanófilas...","Mariru")
	await novel_interface.show_dialog("Pero actualmente no hay mucho de eso disponible, especialmente del tipo que puede sobrevivir en el frío. Y es demasiado tarde para cultivar más desde cero.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Además, las bacterias anaeróbicas no pueden hacer mucho en nuestra atmósfera porque el oxígeno las mata.","Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Así que incluso el abuelo está perplejo, ¿eh?...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(No tengo idea de qué están hablando...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Actualmente, la mayoría de las estaciones de investigación de mediana y pequeña escala están en proceso de evacuación, aunque las tres principales bases antárticas ya han creado un equipo de emergencia temporal.","Mariru")
	await novel_interface.show_dialog("Hasta el momento se han identificado cuarenta y dos fuentes de fugas de metano en el Círculo Antártico. Seis ya están encendidos, y las fotos de esos sitios se están extendiendo como la pólvora en Internet en este momento.","Mariru")
	await novel_interface.show_dialog("Y en los canales de noticias también. Probablemente todos los televisores del mundo estén transmitiendo imágenes en bucle de llamas que surgen de las grietas de las llanuras de hielo polar y se elevan a decenas de metros de altura.","Mariru")
	await novel_interface.show_dialog("No hay forma de que puedan mantener esto en secreto por más tiempo. El mundo lo sabe y claramente está entrando en pánico; algunos ya están organizando celebraciones: un último hurra antes de que se acabe el mundo.","Mariru")
	await novel_interface.show_text_only("Las palabras de Mariru son cínicas y su tono es impotente.")
	await novel_interface.show_dialog("Los sitios de fugas se concentran cerca de varios lagos sin hielo y en el área del Monte Erebus en la isla Ross.","Mariru")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("... ¿Monte Erebus? Eso es un volcán.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("En cuanto a la Estación de Investigación Antártica Princesa Isabel cerca de su ubicación, ya se han iniciado dos pequeños incendios debido a las fugas de metano.","Mariru")
	await novel_interface.show_dialog("También hay un incendio iniciado por un grupo de miembros ricos y estúpidos del grupo de gira de Mt. Grove que estaban jugando con rociadores de llamas. Idiotas.","Mariru")
	await novel_interface.show_dialog("Al menos la base de Snedronningen no corre ningún peligro inmediato en este momento.","Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Uf…","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Bien. Al menos no corremos peligro de que nos friten... todavía).","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("... Sin embargo, la Estación McMurdo ha detectado actividad de flujo de lava a gran escala debajo de las grietas.","Mariru")
	await novel_interface.show_dialog("La grieta cerca de la base Snedronningen es la más prominente, y las capas de hielo que la rodean se están volviendo cada vez más inestables a una velocidad alarmante.","Mariru")
	await novel_interface.show_text_only("No puedo evitar mirar las tablas de metal bajo mis pies.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Así que de todos modos nos van a freír, eh...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un ruido repentino y agudo rasga el aire. Mi pecho vibra y lo siguiente que sé es que estamos desconectados.") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Llamas que brotan del suelo, lava que fluye, hollín volcánico mortal...","Henriette")
	await novel_interface.show_dialog("Es demasiado similar a lo que sucedió hace unos cuatrocientos años...","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Todos estos son precursores del colapso de la \"sustancia primordial\".","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Te refieres a lo que pasó en 1600?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Eso fue en la Partícula Séptima, la Tierra de la Abundancia: el Distrito de Gobernación del Perú.","Henriette")
	await novel_interface.show_dialog("Nunca olvidaré el mar de fuego, el olor acre a azufre en el aire...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette recuerda, suena amarga, y no puedo evitar sentirme afectado, porque yo también tuve una experiencia muy similar.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Entonces... ¿todo esto tiene que ver con ese tipo “El indicado” que mencionaste?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette asiente.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("En aquel entonces, mis amigos de Rosenkreuzer y yo coleccionamos tres libros místicos: el Libro del Carro, el Libro de la Creación y el Libro de la Luz.","Henriette")
	await novel_interface.show_dialog("Siguiendo las instrucciones de los libros, completamos el mayor logro jamás alcanzado en la alquimia: crear un \"portal\" que podría llevarnos al reino kármico.","Henriette")
	await novel_interface.show_dialog("Siendo ingenuos, creímos honestamente que el portal nos llevaría a un Señor Supremo benévolo y que todo lo ve, que nos mostrará todas las verdades del mundo.","Henriette")
	await novel_interface.show_dialog("... Pero en realidad hay una razón por la cual existen las reglas “no pasar por el portal” y “no buscar la verdad”...","Henriette")
	await novel_interface.show_dialog("Porque una vez que entres al portal, nunca encontrarás la salida.\\nY una vez que veas la verdad, quedará grabada para siempre en tu mente.","Henriette")
	await novel_interface.show_dialog("Los humanos sólo son capaces de comprender el lenguaje.","Henriette")
	await novel_interface.show_dialog("Todo lo que no pueda describirse mediante el lenguaje está fuera de nuestro alcance.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Esa es una filosofía que se le ocurrió a alguien en el siglo XX.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("¿Ah? ¿A alguien se le ocurrió esa conclusión simplemente por... filosofar?","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Entonces esa persona debe haber pasado por mucho dolor.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Claro que sí. Toda su familia era considerada loca.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sí. Debió ser un hombre sabio. Excepto que ese tipo de sabiduría simplemente sirve para devorar tu ego hasta que te vuelves parte de él, tan temeroso, tan desesperado.","Henriette")
	await novel_interface.show_dialog("Yo también fui parte de ese proceso alguna vez. Y fue entonces cuando The One apareció frente a mí...","Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Sin decir una palabra, me hizo elegir.","Henriette")
	await novel_interface.show_dialog("¿Quiero desaparecer, como una gota en el océano?","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("¿O convertirse en una sola gota en una botella, preservada para la eternidad, existiendo como guardián del Árbol de la Vida?","Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Te atacaron cuando eras el más débil...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Y el llamado Árbol de la Vida no es lo que dicen, ¿verdad?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sonríe, un poco arrepentida.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("... Es una especie de sello.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Los Diez Sephiroth del Árbol de la Vida actúan como un sello que mantiene a raya a un ser indescriptible, temido incluso por El Único.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Aunque no sé qué es ese ser exactamente.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Quizás debería sentirme aliviado de no hacerlo.","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette hace una pausa.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(En el cráter de Enaptina, que parece estar a punto de quemarlo todo) \\n (una vez lo probé...)","Henriette")
	await novel_interface.show_dialog("El Único nunca había dicho explícitamente lo que quería, pero no es difícil saber qué es por cómo ha cambiado nuestra tierra...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella se ríe, sin humor.")
	await novel_interface.show_text_only("Un silencio incómodo se apodera de nosotros ante las palabras de Henriette.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... ¡Espera!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saco el cromatógrafo de gases y señalo las cifras que contiene.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Incluso si estamos en un “sueño” en este momento, ¿no es la “realidad” aquí todavía diferente a la de otros lugares?","Lian")
	await novel_interface.show_dialog("Mira, el nivel de metano cerca de la grieta fuera de la base se está disparando, ya supera el 25%. Pero aquí abajo, el nivel de metano sigue siendo mucho más bajo que eso...","Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("¿No es eso contradictorio? ¡Y ni siquiera nos dimos cuenta!","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Espera, ¿a qué te refieres?","Raphael")
