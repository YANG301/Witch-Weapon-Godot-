# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Рафилия нашла на втором этаже несколько баков с дизельным топливом, которых должно хватить на несколько дней.")
	await novel_interface.show_text_only("Когда под грохот генератора снова включили электричество, я немедленно бросился в ванную.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Посещать туалет в темноте определенно было бы последним, что мне хотелось бы делать…)", "Lian")
	await novel_interface.show_dialog("(Слава богу, ванную не сделали прозрачной…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Святое дерьмо…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я выхожу из ванной, живот все еще болит. Annie, кажется, немного поправилась и может снова встать на ноги.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, с тобой все в порядке?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Да, я в порядке. Пойдем проверим комнату связи…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Поскольку она едва может стоять прямо, я помогаю ей подняться на второй этаж.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Коммуникационная комната внутри довольно простовата, Т-образный проход ведет к изогнутой стене смотровой площадки.")
	await novel_interface.show_text_only("Шкафы набиты питьевой водой, консервами и другими нескоропортящимися продуктами.")
	await novel_interface.show_text_only("Воздух здесь кажется довольно свежим. Через окно мы можем видеть полярные сияния, танцующие на ночном небе.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Посмотрим, работает ли система…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она пытается запустить старое оборудование на панели управления. К счастью, все оборудование, отвечающее принципу «надежность прежде всего», по-прежнему работает.")
	await novel_interface.show_text_only("Как хорошо обученный агент SID, Annie хорошо знаком с системой. Антенны, установленные снаружи депо, похоже, не сильно пострадали от экстремальной температуры.")
	await novel_interface.show_text_only("Через вентиляционные отверстия в стене в комнату медленно проникает теплый и влажный поток воздуха.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Похоже, система отопления включена.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на дисплей температуры, закрепленный на стене, который показывает, что температура в помещении неуклонно растет с 32°F.")
	await novel_interface.show_text_only("Но температура на улице… -44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Если бы не топаз Генриха…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(В юбке при температуре -44°F и играя в снегу…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Думаю, я открыл новое достижение, которым могу похвастаться…)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Подождите… Нам лучше связаться с Mariru как можно скорее. Только она сможет вытащить нас отсюда.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Кстати, что не так с чипом?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я инстинктивно прикасаюсь к груди. Никогда еще мне так не хотелось услышать оттуда голос Mariru.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Подключение к спутникам… Готово.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Следуя инструкциям Annie, я ввожу строку цифр, которая давно запечатлелась в моей памяти.")
	await novel_interface.show_text_only("Думаю, мне нужно поблагодарить Mariru за то, что он заставил меня выучить наизусть зашифрованные идентификационные коды SID.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Вот как это работает! Интересно…", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("С тех пор как мы прибыли на склад, Генрих был увлечён наблюдением за хранящимися здесь материалами и предметами.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Мне всегда хотелось почувствовать их в своих руках!", "Генриетта")
	await novel_interface.show_dialog("Какое чудесное сочетание песка, алюминия, кальция, горючих металлов и базальта…", "Генриетта")
	await novel_interface.show_dialog("А процесс волокнообразования изменил все их свойства.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Хм?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Для изготовления этого стекла они использовали новую комбинацию материалов. Это то, о чем я никогда не слышал.", "Генриетта")
	await novel_interface.show_dialog("Их метод может предотвратить потерю тепла… Это действительно разумно.", "Генриетта")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Но мы, алхимики, предпочитаем использовать надписи преобразования энергии, что гораздо проще.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Надписи... Ты имеешь в виду магию?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Кто станет использовать магию, чтобы сделать кусок стекла?! Из-за этого можно потерять рассудок!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Но резиновые изделия в маленьких упаковках действительно поразили меня своей необычайной гибкостью.", "Генриетта")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("А фруктовые ароматы… Для чего они нужны?", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Я… я не знаю!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Это всего лишь жвачка, тупой извращенец.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия закатывает глаза на меня.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ради всего святого, Генрих полностью погрузился в мир алхимии!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Вернувшись в штаб-квартиру, Mariru и Ая ищут Рена.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Чипа Рена по-прежнему нет. Это странно. Кластер спутников охватывает буквально каждый уголок земного шара…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Может ли это быть внеземная телепортация или искажение времени?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Как говорится, «не следует умножать сущности сверх необходимости». Более простые предположения с большей вероятностью будут правильными.", "Mariru")
	await novel_interface.show_dialog("Фактически, так называемые «глобальные спутники» покрывают лишь от 70° с.ш. до 70° ю.ш.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы имеете в виду…", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Подтверждение соединения внезапно выскакивает через зашифрованный канал связи SID.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Хе-привет?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! Это я!! \\nБоже мой, наконец-то...", "Lian")
	await novel_interface.show_text_only("Услышав знакомый голос, Mariru вскоре приходит в себя. Кажется, напряжение мгновенно ушло.")
	await novel_interface.show_text_only("Не сводя глаз с автономного сигнала, она немедленно запускает процедуру обратного отслеживания.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Рен? Сообщите о своем местоположении. \\nТы с другими девушками?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Да, я сейчас на складе с Рафилией и Annie. \\nЗдесь мы в безопасности, но…", "Lian")
	await novel_interface.show_dialog("Мы сейчас… в Антарктиде.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Антарктида?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Очевидно, что ответ превзошёл все ожидания, но на лице Mariru нет и тени удивления.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Похоже, Рен не страдает от переохлаждения.) \\n(Они, должно быть, нашли какое-нибудь безопасное место.)", "Mariru")
	await novel_interface.show_dialog("(Был ли во время эксперимента на базе «Арк» еще один поток пространства-времени?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("На экране появится результат трассировки – Нет. 2 Объединенное депо на Земле Принцессы Елизаветы, Восточная Антарктида.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Теперь все это имеет смысл… Спутники на низкой околоземной орбите не пролетят над этой областью, если их орбиты не будут изменены вручную.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Потому что полярный солнечный ветер прервет передачу данных.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Я совершенно упустил из виду…", "Ai")
	await novel_interface.show_dialog("Подключим спутники над Антарктидой?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Угу. Помните, не будите этих спящих старых собак.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Я не знаю, что произошло… Меня просто внезапно сюда привезли.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Кроме вас троих, есть еще кто-нибудь?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Вы имеете в виду Генриха? \\nОна рядом со мной.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("Я не ожидал, что мы сможем установить контакт с Mariru с помощью такого старинного оборудования. Я должен признать, что голос Mariru принес мне огромное облегчение.")
	await novel_interface.show_text_only("Я информирую ее о текущей ситуации.")
	await novel_interface.show_dialog("… очень хорошо подмечено.", "Mariru")
	await novel_interface.show_dialog("Слушай, ты сейчас очень близко к Южному полюсу, а значит подобрать тебя не так-то просто.", "Mariru")
	await novel_interface.show_dialog("Согласно послевоенной Новой антарктической конвенции, любая страна, желающая отправить экспедиционную группу численностью более 5 человек…", "Mariru")
	await novel_interface.show_dialog("… Или самолет там должен получить разрешение Объединенного Конгресса.", "Mariru")
	await novel_interface.show_dialog("И самолету, вероятно, придется сделать посадку в Новой Австралии…", "Mariru")
	await novel_interface.show_dialog("Так что даже если нам удастся взлететь за 1 час и пройти все процедуры во время полета, то добираться придется около 40 часов.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Это будет хорошо. Генератор здесь может проработать несколько дней, и у нас будет достаточно еды, чтобы выжить.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ближайший к вам перрон — 68°24’ ю.ш. и 76°55’ в.д., примерно в полумиле от вас.", "Mariru")
	await novel_interface.show_dialog("Учитывая непредсказуемые погодные условия в Антарктике, мы можем потерять с вами связь в любой момент. Если это произойдет, помни, я встречу тебя там.", "Mariru")
	await novel_interface.show_dialog("Это большая база под названием Снедроннинген, что буквально означает «снежная королева», и большинство ее объектов построено под землей…", "Mariru")
	await novel_interface.show_dialog("Что касается подробностей… Мы будем держать вас в курсе. Рен,… эта штука рррррр…", "Mariru")
	await novel_interface.show_text_only("Голос Mariru заглушается внезапным электрическим шумом.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? Привет?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Хе-привет? Ты слышишь меня?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Шум в узле связи становится все громче.")
	await novel_interface.show_dialog("Может быть порыв солнечного ветра... Вам лучше... проверить прием сигнала сейчас.", "Mariru")
	await novel_interface.show_text_only("Вау——")
	await novel_interface.show_text_only("По мере того, как электрический шум становится сильнее, голос Mariru исчезает из приемника.")
	await novel_interface.show_text_only("Над нами нависла тишина.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Наверное… мы снова потеряли с ними связь…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Сорок часов? Лучше помолитесь, чтобы сюрприза больше не было.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это вызывает у меня плохие эмоции, но я не знаю почему.")
	await novel_interface.show_text_only("За окном все полярные сияния исчезли вместе с угасающими сигналами, и даже слабый ветер утих.")
	await novel_interface.show_text_only("Единственные звуки, которые мы сейчас слышим, исходят от радиаторов компьютера и вентиляторов кондиционера.")
	await novel_interface.show_text_only("Такая тишина всегда напоминает мне о затишье перед бурей…")
	await novel_interface.show_text_only("Внезапно панель управления слегка трясется.")
	await novel_interface.show_text_only("Нет, это невозможно. Должно быть, я только что потерял равновесие.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Ты это почувствовал?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Вы имеете в виду…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Легкая тряска становится все сильнее и сильнее.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Боже мой… Ты шутишь?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Держа панель управления в поисках поддержки, я чувствую, как мое сердце замирает.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Что это...?", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Из-под наших ног доносится рев.")
	await novel_interface.show_text_only("Здание начинает так сильно трясти, что мы едва можем стоять прямо.")
	await novel_interface.show_text_only("Все на столе подпрыгивает, как поп-роксы, растворяющиеся во рту.")
	await novel_interface.show_text_only("От ледников вдалеке доносится ужасный треск.")
	await novel_interface.show_text_only("Взгляд в окно подтверждает мои опасения…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Это землетрясение!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
