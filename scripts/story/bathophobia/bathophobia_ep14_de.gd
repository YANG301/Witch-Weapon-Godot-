# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Ein grelles Weiß.")
	await novel_interface.show_text_only("Nach und nach tauchte ein verschwommener Umriss vor meinen Augen auf und alles um mich herum schien sich zu beschleunigen, als würde es mit hoher Geschwindigkeit aus einer Höhe von 10.000 Metern fallen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Schließlich berühren meine Füße den Boden, aber der erwartete Aufprall blieb aus. Nur der Schmerz in meinen Ohren erinnert mich an einen starken Luftdruckanstieg.")
	await novel_interface.show_dialog("Autsch…", "Lian")
	await novel_interface.show_text_only("Ich atme ein und merke, dass ich diesen Raum verlassen habe. Das muss die reale Welt sein, denn sie ist so verdammt...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Coooooold!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich peitscht mich die eiskalte Luft und mein Magen verkrampft sich heftig.")
	await novel_interface.show_text_only("Ich konnte meine stechenden Augen kaum öffnen, als ob alle Wimpern eingefroren wären …")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Als ich endlich wieder sehend bin, finde ich alles schneebedeckt vor. Die kalte Luft fühlt sich an, als würde mir ein Messer in die Luftröhre stechen.")
	await novel_interface.show_text_only("Ich atme die kühle Luft ein und muss husten.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Huch – Hust, Hust!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Wie lange ist es her? Ist es schon dunkel? \\nWo sind wir…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In der lähmenden Kälte sinkt meine Körpertemperatur rapide und ich beginne unwillkürlich zu zittern.")
	await novel_interface.show_text_only("Neben mir sieht Heinrich irgendwie aufgeregt aus. \\nAnnie und Raphael liegen erschöpft im Schnee.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Meister, ist dir kalt?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich nimmt sanft meine Hand.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Äh...?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich spüre, wie sich die Wärme von ihren Fingerspitzen auf meinen ganzen Körper ausbreitet, als würde ich an einem Kaminfeuer sitzen.")
	await novel_interface.show_text_only("Überrascht schaue ich auf dieses Mädchen, das noch weniger trägt als ich. Als sie meine Hände loslässt, finde ich einige goldene Steine ​​in meinen Handflächen.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Was sind das...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mit dieser warmen Jade werden Sie sich besser fühlen.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Obwohl sich die Kristalle aus Jade nicht heiß anfühlen, können sie Wärme am ganzen Körper ausstrahlen.")
	await novel_interface.show_text_only("Mit diesen Steinen verwandelt sich die eisige und verschneite Einöde in einen warmen, gemütlichen Ort.")
	await novel_interface.show_text_only("Ich frage mich, ob die Umgebung nichts weiter als eine Studioszene ist.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cool…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Nur ein paar Spielsachen. Ich habe sie mit alchemistischen Werkzeugen und einer Inschrift zur Energieumwandlung hergestellt.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sagt Heinrich bescheiden, aber mit einem zufriedenen Gesichtsausdruck.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Nein, nein, das ist großartig!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das ist wirklich großartig... Die Technologie für solche künstlichen Materialien mit Substance H-Eigenschaften ist auch heute noch streng geheim.")
	await novel_interface.show_text_only("Ich nahm die warme Jade und drückte ein paar Stücke in die Hände von Raphael und Annie.")
	await novel_interface.show_text_only("Wenn ich ihre Hände berühre, spüre ich, wie ihre Körpertemperatur schnell ansteigt.")
	await novel_interface.show_dialog("Husten… Husten…", "Raphael")
	await novel_interface.show_dialog("Ähm... Äh...", "Annie")
	await novel_interface.show_text_only("Mit einem Hustenanfall kommen Annie und Raphael wieder zu Bewusstsein.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Geht es dir gut?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich sehe, dass sie schläfrig zurücknicken, atme ich erleichtert auf.")
	await novel_interface.show_text_only("Als ich mich umschaue, stehe ich auf gefrorenem, kiesigem Boden, der von einer dünnen Schneeschicht bedeckt ist.")
	await novel_interface.show_text_only("Über dem Weiß liegt eine seltsame Ruhe, als wäre die Landschaft nur eine Computersimulation.")
	await novel_interface.show_text_only("Neben mir murmelt Heinrich tief in Gedanken vor sich hin.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Wie konnten wir aus diesem Raum entkommen?", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Nein, es war keine Flucht... Aber die Kluft der Kausalität musste brechen.", "Henriette")
	await novel_interface.show_dialog("Aber wie kommt es? Sogar der Eine sollte bei der Übertragung von Menschen die Regel der Kausalität befolgen –", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("Könnte es sein... sie...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich dreht sich unwillkürlich zu Ren um.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Boah, ist das echter Schnee? Es ist überhaupt nicht kalt.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich habe mit großem Interesse einen Schneeball gesammelt, aber nachdem ich ihn mir angesehen hatte, beschloss ich, den Schneeball auf den Boden zu werfen...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(Ich muss völlig dumm aussehen...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein bitterer Windstoß bläst mir Eiskristalle ins Gesicht.")
	await novel_interface.show_text_only("Dank des Topas ist mir überhaupt nicht kalt.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Wo zum Teufel sind wir...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich stehe auf. Unter mir liegt das flache Schneefeld.")
	await novel_interface.show_text_only("In der Ferne erheben sich gletscherbedeckte Berge vom Rand des Schneefeldes.")
	await novel_interface.show_text_only("Der Himmel hätte mit der Dunkelheit der Nacht erfüllt sein sollen.")
	await novel_interface.show_text_only("Aber –")
	await novel_interface.show_text_only("Es wird von einem bunten Lichtband beleuchtet, das sich bis zum Horizont erstreckt.")
	await novel_interface.show_text_only("Unter den Sternen sind deutlich bunte Lichtstrahlen zu erkennen. Der Himmel wird von einer fluoreszierenden grünlichen Farbe mit violetten und rosa Streifen erleuchtet.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Ist das... Aurora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Betrachten der Fotos im Internet ist nicht zu vergleichen mit der Ehrfurcht, sie persönlich zu sehen.")
	await novel_interface.show_text_only("Zwischen der sternenklaren Nacht und dem reinen Schneefeld schweben Strahlen von strahlendem Glanz.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Befinden wir uns am Polarkreis?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nein... auf keinen Fall?!")
	await novel_interface.show_text_only("Heinrich schüttelt ihren Kopf.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Puh... Es müssen irgendwelche 3D-Bilder sein...)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Der Effekt dieser Simulation ist ziemlich gut, sogar die Temperatur und die Berührung...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Wir sind in der Antarktis.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Warte, sie hat gerade Antarktis gesagt...)\\n(Die mit den Pinguinen...?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("… Äh? Was??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Antarktis?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Der Bereich, der dem neunten Sephirot entspricht.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Ihr habt schon einmal über sie gesprochen, den Baum des Lebens, Sephiroth, bla bla bla, was zum Teufel …", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Der Legende nach nutzte Gott den Baum des Lebens als Blaupause für das Universum. Es ist wie eine Strukturkarte der Welt.", "Henriette")
	await novel_interface.show_dialog("Was die Sephirot betrifft … das sind die zehn Säulen, die den Baum des Lebens stützen.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Laut The One zumindest…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ihrem Gesichtsausdruck nach zu urteilen, glaubt Heinrich die Legende nicht wirklich.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Der neunte Sephirot entspricht also… der Antarktis. Ist dies der Bereich, den wir dieses Mal bewachen müssen?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Aber wogegen? Robben!?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nach unseren bisherigen Erfahrungen können selbst unbereinigte Gebiete Katastrophen hervorrufen.", "Henriette")
	await novel_interface.show_dialog("Streitigkeiten unter Menschen sind nichts im Vergleich zur Kraft der Natur.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aber... es scheint, dass wir nicht am richtigen Ort gelandet sind.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Äh?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Mit anderen Worten: Wir sind vorerst frei.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich lächelt mich an, ihre Augen funkeln.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Es ist das erste Mal seit Hunderten von Jahren, dass ich die Freiheit genieße, selbst dieser Ort ist trostlos und auch nur für eine Weile...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Hahaha… Der Eine muss gerade sehr genervt sein!", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Und – der Dank gebührt dir, Ren!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mit der Hand aufs Herz verneigt sie sich vor mir.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Was, ich? Habe ich etwas getan?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Immer noch keine Ahnung von ihren eigenen Fähigkeiten … Interessant.)", "Henriette")
	await novel_interface.show_dialog("Überwindung der vom Einen festgelegten Regeln –", "Henriette")
	await novel_interface.show_dialog("Sie müssen die Wahrheit in Ihre Seele eingeschrieben haben, Meister.", "Henriette")
	await novel_interface.show_dialog("Das ist das Niveau, nach dem ich mich mein Leben lang gesehnt habe.", "Henriette")
	await novel_interface.show_dialog("Was ist der Preis für das Erreichen dieses Niveaus?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ich verstehe diese Level-Sache nicht...", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Aber der Preis ist riesig!")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Der Wind wird heftiger, sollen wir uns irgendwo verstecken?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Gehen Sie geradeaus... Da ist ein Depot...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie spricht mit schwacher Stimme.")
	await novel_interface.show_text_only("Sie kämpft sich auf die Beine und zeigt mit der Hand gerade nach vorne.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Es gibt eine kreisförmige Architektur. Es ist keineswegs groß, verfügt aber über einen Kriechkeller von über 30 Fuß Höhe, um sich vor Schneestürmen zu schützen.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Doppelt verglastes, kältebeständiges Glas mit großem Metallrahmen …", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Einen solch unpraktischen minimalistischen Stil in der Polarregion zu verwenden … Das müssen diese nordischen Typen sein.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Stahldraht, der die Treppe hält, ist gebrochen und die Stufen sind alle zu Boden gefallen, sodass nur noch zwei Handläufe hängen.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Entschuldigung... ist hier jemand?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Sei klug, Idiot! Niemand wäre so dumm, während der Polarnacht in einem Glashaus mit so hoher Wärmeableitung zu bleiben!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mir wird klar, dass die Nacht am Polarkreis ein halbes Jahr dauert. Jetzt verliere ich wirklich das Zeitgefühl.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sieht immer noch blass aus. Sie kann sich kaum noch halten, nachdem wir das Depot betreten haben.")
	await novel_interface.show_text_only("Ich renne auf sie zu, um sie aufzufangen, als sie die Kontrolle über ihren Körper verliert und zu Boden fällt.")
	await novel_interface.show_dialog("Puh…", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Keine Kommunikationsmöglichkeit im ersten Stock. Wir müssen versuchen, nach oben zu kommen.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Nach oben kommen?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bei diesen Worten geht Heinrich zum Geländer.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Murmelt) Hmm... es ist Material, das ich noch nie zuvor gesehen habe...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Aber es ist nicht schwer, es wieder aufzubauen...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie hebt den kaputten Draht auf und holt ein Stück edelsteinähnlichen Stein heraus.")
	await novel_interface.show_text_only("Der Spalt ist verdreht, verlängert und glatt miteinander verbunden, als ob er in Heinrichs Händen duktil wäre.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Das ist also Alchemie...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf Raphaels hochmütigem Gesicht erscheint ein Ausdruck der Bewunderung.")
	await novel_interface.show_text_only("Heinrich ergreift den Draht, ihr Kampfanzug beginnt in verschiedenen Farben zu blinken.")
	await novel_interface.show_text_only("Dann zieht sie am Draht, der wieder festgezogen wird. Ein Dutzend Stufen werden an ihren ursprünglichen Platz zurückgezogen.")
	await novel_interface.show_text_only("Sie befestigt den Draht wieder an der Schnalle am Boden, als wäre es nur ein weiches Wollknäuel.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wow... Wunderbar!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Nun ja... Zumindest ist die Verstärkungseigenschaft dieses Kampfanzugs für Alchemisten recht nützlich.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Schließlich müssen wir uns manchmal mit Problemen auseinandersetzen... Problemen, die unsere Vorstellungskraft übersteigt.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir legen Annie auf das Sofa und gehen zu dritt die Treppe hinauf…")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
