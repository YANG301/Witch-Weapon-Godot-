# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("¿Qué es la realidad?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Quizás la realidad tal como la conocemos no sea más que un juego de computadora.")
	await novel_interface.show_text_only("Inicia sesión, los personajes se despiertan; cierran sesión y se quedan dormidos. Cuando se cierran las cuentas, mueren.")
	await novel_interface.show_text_only("A medida que pasa el tiempo, desarrollan la percepción del alma.")
	await novel_interface.show_text_only("Creen que todas esas acciones preprogramadas se toman por su libre albedrío.")
	await novel_interface.show_text_only("Fórmulas, leyes, reglas gramaticales, códigos de conducta… cada personaje recibe estas reglas para seguir sin saber quién las creó… hasta que finalmente es liberado.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Incluso si una gran porción del cielo se pixela debido a un error de renderizado...")
	await novel_interface.show_text_only("Simplemente lo racionalizaron con cuentos de hadas o creencias religiosas, en lugar de admitir que está más allá de su conocimiento.")
	await novel_interface.show_text_only("Porque aceptar lo desconocido significa la posibilidad más inquietante...")
	await novel_interface.show_text_only("Que la llamada realidad podría no ser más que una ilusión.")
	await novel_interface.show_text_only("Una quimera.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Abro los ojos lentamente y me encuentro aturdido.")
	await novel_interface.show_text_only("Estoy rodeado por la niebla. Curiosamente, hilos de gotas de lluvia cuelgan en el aire.")
	await novel_interface.show_text_only("Extiendo la mano y trato de tocarlos, pero se evaporan inmediatamente.")
	await novel_interface.show_dialog("¿Dónde estoy…?", "Lian")
	await novel_interface.show_text_only("Estoy parado sobre una superficie sólida y puedo sentir la gravedad. Pero no puedo ver el suelo… como si mi vista fuera absorbida por el vacío.")
	await novel_interface.show_text_only("De fondo se oye un zumbido inusual. Sin ningún marco de referencia, las direcciones son imperceptibles.")
	await novel_interface.show_text_only("Miro hacia arriba y veo el contorno de un tótem con forma de árbol flotando muy por encima de mí.")
	await novel_interface.show_text_only("Se extiende como un manto reluciente en el cielo.")
	await novel_interface.show_text_only("Diez anillos en el tótem giran lentamente y uno emite un rayo rojizo.")
	await novel_interface.show_text_only("Luego, un enorme patrón compuesto de líneas e inscripciones se despliega bajo mis pies, formando lo que se puede llamar el suelo.")
	await novel_interface.show_text_only("El tótem en el suelo es el mismo que el que está en el aire, pero mucho más grande visto desde una distancia corta.")
	await novel_interface.show_text_only("Los anillos, cada uno de unos 15 pies de diámetro, están conectados en un orden determinado. Las inscripciones en ellos parecen antiguas.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(¿Estoy… soñando?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me han entrenado para identificar alucinaciones y sueños...")
	await novel_interface.show_text_only("¿Cuál es esa pregunta importante otra vez...?")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("—¿Cómo llegué aquí?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los recuerdos vuelven. Estaba en la Base Arca y todo empezó a caer… Entonces…")
	await novel_interface.show_text_only("No. Esto no es un sueño.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(¿Tiene algo que ver con esa chica?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ella me llamó Maestro, e incluso…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aww— \\nNo… No es momento para la fantasía…")
	await novel_interface.show_text_only("¿Dónde está Annie? ¿Y Raphael?")
	await novel_interface.show_text_only("¡Ellos también deben ser absorbidos por este lugar!")
	await novel_interface.show_text_only("Miro a mi alrededor en la niebla buscándolos. Inesperadamente, un par de brazos cálidos me sostienen por detrás.")
	await novel_interface.show_dialog("No se preocupe, Maestro...", "Blond Girl")
	await novel_interface.show_text_only("¡Es ella! \\n¡La chica desnuda me abraza por la espalda!")
	await novel_interface.show_text_only("Tengo muchas preguntas para ella. Pero dudo en mirar atrás...")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Maestro… ¡Qué extraño!) \\n(¡Como los bichos raros de las películas de dibujos animados!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parece estar buscando algo a tientas. Sus manos se arrastran por mi cintura y se detienen en mi vientre plano.")
	await novel_interface.show_text_only("En el silencio, puedo escuchar mi corazón latiendo rápido mientras su aliento me hace cosquillas en el cabello...")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(¿Qué… va a hacer ella?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Ah?","Blond Girl")
	await novel_interface.show_text_only("Parecía haber descubierto algo interesante. Lo presionó ligeramente con la palma de la mano y mi estómago inmediatamente dejó escapar un sonido de \"gorgoteo\" insatisfactorio.")
	await novel_interface.show_text_only("En este entorno tranquilo, este sonido se nota especialmente.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(¿Eh? ¿Por qué…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ahhhhhhh... Qué vergonzoso...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me alejo de ella. Ella se acerca a mí y me mira con curiosidad.")
	await novel_interface.show_dialog("¿El cuerpo del Maestro también ha sido modificado? \\n… ¡Qué producto tan perfecto de la alquimia!","Blond Girl")
	await novel_interface.show_text_only("Quiero taparme los ojos, pero me di cuenta de que ya está vestida.")
	await novel_interface.show_text_only("Espera, ¿acaba de decir que mi cuerpo ha sido modificado? \\nY... ¿qué lleva puesto?")
	await novel_interface.show_text_only("Basta con echar un vistazo al traje de Heinrich para darse cuenta de su material de última generación.")
	await novel_interface.show_text_only("A juzgar por la textura y el diseño, no se puede hacer en el siglo XVI... No, está incluso más allá de la artesanía moderna.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(¿La información de Mariru es incorrecta?) \\n(¿Y cómo sabe ella sobre la transformación de mi cuerpo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras trato de verbalizar mis pensamientos, alguien me empuja repentinamente hacia atrás.")
	await novel_interface.show_text_only("Es Raphael. Me agarra por la capucha, da un paso adelante y se interpone entre Heinrich y yo.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Dime ¿quién eres?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("—¿Y bien?", "Blond Girl")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich se vuelve hacia Raphael, con una sonrisa desdeñosa en su rostro.")
	novel_interface.character_light()
	await novel_interface.show_dialog("¿Estás preguntando mi nombre? \\nTengo cientos de ellos.", "Blond Girl")
	await novel_interface.show_dialog("Pero puedes llamarme Henriette Khunrath, así es la que aparece en el Contrato.", "Blond Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("¡Eso no es gracioso!", "Raphael")
	await novel_interface.show_dialog("Heinrich es un hombre en todos los registros históricos.", "Raphael")
	await novel_interface.show_dialog("Y además, ¡mira lo que llevas! \\n¿Has confundido la ropa interior con la ropa exterior?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¡No profanes a Heinrich el gran alquimista, muchacha desvergonzada! Dejen de llamar “maestro” a las personas y… y de tomar la esencia de las personas…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael se sonroja mientras habla.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… ¡Quién diablos eres tú!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras se enfrentan entre sí, no pude evitar mirar a Heinrich desde la espalda de Raphael.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(¿Cuál es el material de su disfraz...) \\n(¡Increíble envoltura! ¿Cómo podrían sus pechos temblar en diferentes direcciones?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nuestros ojos se encuentran y me sonrojo de inmediato. Presa del pánico, miro mi falda, evitando más contacto visual.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("¿Y bien? Pensé que al Maestro no le impresionaría tu propia obra maestra...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No no no, soy (o era) un niño…")
	await novel_interface.show_text_only("Heinrich señala su pecho.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Más grandes de lo que solían ser… ¿Es este el gusto del Maestro?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mira hacia atrás y me lanza una mirada severa.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡No! ¡Yo no! ¡¡No lo hice!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Acabo de romper el tesoro nacional de Salmonton por accidente...")
	await novel_interface.show_dialog("Y, por favor, no me llames maestro... Sólo llámame Ren.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("¿Ren…? \\nNo esperaba que una gran persona como tú tuviera un nombre tan bonito...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Qué hay de ti? ¿Eres realmente Heinrich?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella duda, mira los números en su muñeca y suspira levemente.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Ya son 400 años...", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Espera, ¿¡hay algún reloj o calendario en su muñeca!?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Me hice pasar por un hombre para investigar, publicar artículos o ejercer la medicina.", "Henriette")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Por eso no me sorprende la forma en que la historia me registra.", "Henriette")
	await novel_interface.show_dialog("En mi época, las universidades no admitían niñas y la iglesia prohibía a las mujeres ejercer la medicina.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Y mucho menos convertirme en alquimista... Hmm, no quiero meterme en problemas con el tribunal religioso.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…\\n", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De alguna manera, empiezo a sentirme indignada cada vez que me entero de la opresión de las mujeres.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Es fácil deshacerse de esos perros de la corte, pero no merecen mi tiempo.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Vaya… suena genial…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mira pensativamente a Heinrich.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Espera, ¿cómo llegaste a entrar a la universidad cuando eras niño? \\n", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente siento curiosidad por saber cómo entró. Tal vez…")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Simplemente me corté el pelo, falsifiqué varias referencias y entré en la Universidad de Leipzig bajo un seudónimo.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("¿Solo un corte de pelo?", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_text_only("Miro su pecho. ¿Hace 400 años la gente era totalmente ciega?")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yo tenía entonces diez años. El examen de acceso a la universidad fue demasiado fácil.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sonríe con desdén.")
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("¿Eh? No importa.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("No importa cómo cambie el mundo, ¡los niños genios siempre son increíbles!")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Entonces, ¿cómo explicas este disfraz?", "Raphael")
	await novel_interface.show_dialog("Heinrich era médico y alquimista, pero tu armadura y arma son obviamente para las batallas.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich da un paso atrás, sonriendo.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Oh, lo siento, es mi culpa.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Presiona su mano derecha sobre su pecho y el disfraz comienza a agrietarse.")
	await novel_interface.show_text_only("Su cuerpo, ahora rodeado de cintas azules y blancas y cristales de colores, comienza a brillar.")
	await novel_interface.show_text_only("Cuando la luz azul y dorada comienza a desvanecerse, su cuerpo gradualmente...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Poco a poco… ¿Eh?")
	await novel_interface.show_text_only("Raphael se apresura y me cubre los ojos con fuerza con sus manos.")
	await novel_interface.show_dialog("¡Suficiente! ¡Veo!", "Raphael")
	await novel_interface.show_dialog("¡Ponte la ropa, exhibicionista!", "Raphael")
	await novel_interface.show_dialog("También hay travestismo, ¡qué miras!", "Raphael")
	await novel_interface.show_text_only("¡¡No he visto nada!!")
	novel_interface.show_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Cuando Raphael se quita las manos, Heinrich ya está vestido otra vez con el mismo disfraz. Uf...")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Este es un traje de batalla mágico, similar al del Maestro. Pero la mía está hecha por seres superiores.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("En cuanto al diseño… me temo que The One tiene un sabor terrible…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿El indicado?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Hice la Puerta de Entrada a este espacio utilizando técnicas alquímicas.", "Henriette")
	await novel_interface.show_dialog("Se supone que los mortales no saben la verdad... Así que tuve que pagar el precio. El Único me obligó a firmar un contrato con respecto a mi alma...", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich parece algo indefenso.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Murmurando) La última vez tuve mi cuerpo completamente hecho pedazos, pero el contrato aún se podía activar con un nuevo cuerpo...", "Henriette")
	await novel_interface.show_dialog("¿Por qué no me das un respiro?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mientras me pregunto qué está diciendo Heinrich, la voz temblorosa de Annie de repente surge de la niebla.")
	await novel_interface.show_dialog("Ren—", "Annie")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corremos hacia donde vino la voz y encontramos a Annie tirado en el suelo, temblando.")
	await novel_interface.show_dialog("H… ayuda…", "Annie")
	await novel_interface.show_dialog("… No… Por favor…", "Annie")
	await novel_interface.show_text_only("Rápidamente di un paso adelante para consolar a Annie, y en el momento en que mi mano tocó su cuerpo...")
	await novel_interface.show_text_only("Una brisa viscosa y cálida fluye a través de mi mano y pasa rápidamente a mi lado.")
	await novel_interface.show_text_only("Miro a mi alrededor pero no encuentro nada inusual, excepto que Heinrich me mira desconcertado.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¡Estarás bien, Annie!", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por alguna razón, Annie está temblando violentamente.")
	await novel_interface.show_text_only("Entiendo que los lugares desconocidos traen preocupación... Pero no hay señales de enemigos en el vasto espacio vacío.")
	await novel_interface.show_text_only("Sostengo a Annie cerca, tratando de consolarla.")
	await novel_interface.show_text_only("Al ver esto, Raphael vuelve a mirar a Heinrich.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Mencionaste este espacio… ¿Es la Grieta de la Causalidad?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Ese es el nombre inscrito en el Árbol de la Vida...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("¿Árbol de la vida?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("¿Por qué nos trajiste aquí? ¿Qué quieres de nosotros?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich se encoge de hombros.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Yo no.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("De hecho, no podrías haber estado aquí...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("… Sin la intención de El Único… o incluso de seres más superiores.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("¿Quién es el indicado?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Estoy obligado a no llamarlo por su nombre... Pero The One tiene demasiados títulos...", "Henriette")
	await novel_interface.show_dialog("La Verdad, el Camino, la Puerta…", "Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Desde el principio… hasta el final.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…?!", "Raphael")
	
	print("=== 深海恐惧篇第11话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
