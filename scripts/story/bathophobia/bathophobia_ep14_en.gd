# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("A glaring whiteness.")
	await novel_interface.show_text_only("A blurry outline gradually appeared in front of my eyes, and everything around me seemed to be accelerating, as if it was falling at a high speed from an altitude of 10,000 meters.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Finally, my feet touch the ground, but the expected impact wasn’t there. Only the pain in my ears reminds me of a sharp increase in air pressure.")
	await novel_interface.show_dialog("Ouch…", "Lian")
	await novel_interface.show_text_only("I take a breath and realize that I have left that space. This must be the real world, because it is so damn…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Coooooold!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All at once, I am whipped by the freezing air and my stomach cramps badly.")
	await novel_interface.show_text_only("I could hardly open my stinging eyes, as if the eyelashes are all frozen…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("When I finally recover my sight, I find everything covered in snow. The cold air feels like a knife stabbing my windpipe.")
	await novel_interface.show_text_only("I breathe in the chilly air and couldn't help but cough.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hoo—cough cough!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("How long has it been? Is it dark already? \\nWhere are we…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In the mind-numbing cold, my body temperature drops rapidly, and I begin to shiver involuntarily.")
	await novel_interface.show_text_only("Beside me, Heinrich looks excited somehow. \\nAnnie and Raphael are lying on the snow, exhausted.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Master, do you feel cold?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich takes my hand gently.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Eh…?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I feel the warmth spread from her fingertips to throughout my body, as if I'm sitting by a fireplace.")
	await novel_interface.show_text_only("Surprised, I look at this girl who wears even less than I do. When she lets go of my hands, I find some golden stones resting in my palms.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("What are these…?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You will feel better with these warm jade.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Although the crystals made of jade are not hot to the touch, they can radiate warmth all over the body.")
	await novel_interface.show_text_only("With these stones, the icy and snowy wasteland turns into a warm, cozy place.")
	await novel_interface.show_text_only("It makes me wonder if the surroundings are nothing more than a studio scene.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cool…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Just some toys. I made them with alchemic tools and energy conversion inscription.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich says modestly, but with a look of satisfaction on her face.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("No, no, that's awesome!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That's really awesome… The technology for such man-made materials with Substance H properties is still the top secret even today.")
	await novel_interface.show_text_only("I took the warm jade and stuffed a few pieces into the hands of Raphael and Annie.")
	await novel_interface.show_text_only("As I touch their hands, I can feel their body temperature rising quickly.")
	await novel_interface.show_dialog("Cough… Cough…", "Raphael")
	await novel_interface.show_dialog("Umm… Uh…", "Annie")
	await novel_interface.show_text_only("With a fit of coughing, Annie and Raphael regain consciousness.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Are you OK?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seeing they nod back drowsily, I breathe a sigh of relief.")
	await novel_interface.show_text_only("I start to look around and find myself standing on frozen gravelly ground covered by a thin layer of snow.")
	await novel_interface.show_text_only("Over the whiteness hangs a strange calm, as if the landscape is just a computer simulation.")
	await novel_interface.show_text_only("Beside me, Heinrich is murmuring to herself, deep in thoughts.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("How were we able to escape from that space…", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("No, it was not an escape… But the Crevice of Causality was forced to crack.", "Henriette")
	await novel_interface.show_dialog("But how come? Even The One should follow the Rule of Causality when transmitting people—", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("Could it be… her…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich turns to look at Ren involuntarily.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Wow, is this real snow? It's not cold at all.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I collected a snowball with great interest, but after looking at them, I decided to throw the snowball to the ground...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(I must look utterly stupid…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A gust of bitter wind blows ice crystals to my face.")
	await novel_interface.show_text_only("Thanks to the topaz, I don't feel cold at all.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Where the heck are we…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stand up. Beneath me is the flat snowfield.")
	await novel_interface.show_text_only("In the distance, glacier-capped mountains rise from the edge of the snowfield.")
	await novel_interface.show_text_only("The sky should have been filled with the darkness of the night.")
	await novel_interface.show_text_only("But—")
	await novel_interface.show_text_only("It is lit by a colorful band of light which stretches towards the horizon.")
	await novel_interface.show_text_only("Rays of colorful lights are clearly visible under the stars. The sky is illuminated by a fluorescent greenish color striped with violet and pink.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Is this… aurora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seeing the photos on the Internet is nothing to compare with the awe of seeing it in person.")
	await novel_interface.show_text_only("Between the starry night and pure snowfield float beams of brilliant radiance.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Are we in… the Arctic Circle?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No… no way?!")
	await novel_interface.show_text_only("Heinrich shocks her head.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Phew… It must be some kind of 3D images…)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("The effect of this simulation is pretty good, even the temperature and touch...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("We're in the Antarctic.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Wait, she just said Antarctica...)\\n(The one with the penguins...?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("… Eh? What??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Antarctic?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("The area corresponding to the ninth Sephirot.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("You guys talked about them before, the Tree of Life, Sephiroth, blah blah blah, what on earth…", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Legend has it that god used the Tree of Life as the blueprint for the universe. It's like a structural map of the world.", "Henriette")
	await novel_interface.show_dialog("As for the Sephirot… that's the ten pillars supporting the Tree of Life.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("According to The One, at least…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Judging from her facial expression, Heinrich doesn't really buy the legend.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("So the ninth Sephirot corresponds to… the Antarctic. Is this the area where we need to guard this time?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("But against what? Seals!?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("According to our previous experiences, even untraversed areas can breed catastrophes.", "Henriette")
	await novel_interface.show_dialog("Disputes among humans are nothing compared to the power of nature.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("But… it seems we haven't landed on the right place.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("In other words, we are free for now.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich smiles at me, her eyes twinkling.")
	novel_interface.character_light()
	await novel_interface.show_dialog("It's my first time to enjoy freedom in hundreds of years, even this place is desolate, and even it's only for a while…", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Hahaha… The One must be very annoyed right now!", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("And—the credit goes to you, Ren!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Hand on her heart, she makes a bow to me.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("What, me? Did I do anything?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Still no clue about her own abilities… Interesting.)", "Henriette")
	await novel_interface.show_dialog("Transcending rules set by The One—", "Henriette")
	await novel_interface.show_dialog("You must have inscribed the truth in your soul, Master.", "Henriette")
	await novel_interface.show_dialog("That's the level I yearned for during my lifetime.", "Henriette")
	await novel_interface.show_dialog("What is the price for achieving this level?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("I don't understand this level thing…", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("But the price is huuuuuuge!")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("The wind is getting fierce, shall we find some place to hide?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Go straight ahead… There's a depot…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie speaks in a weak voice.")
	await novel_interface.show_text_only("She struggles to her feet, hand pointing straight forward.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("There is a circular architecture. It's not large by any measure, but has a crawl space of over 30 feet high to keep itself safe from snowstorms.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Double-glazed cold-proof glass with a large metal framework…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Using such an impractical minimalist style in the polar region… It must be those Nordic guys.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The steel wire holding the staircase is broken, and the steps have all fallen to the ground, leaving only two handrails hanging.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Excuse me… anyone here?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Wise up, idiot! No one would be silly enough to stay in such a high heat dissipation glass house during the polar night!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I come to realize that the night in the Antarctic Circle lasts for half a year. Now I really lose track of time.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie still looks pale. She can barely hold herself up after we enter the depot.")
	await novel_interface.show_text_only("I rush up to catch her as she loses control of her body and collapses to the floor.")
	await novel_interface.show_dialog("Phew…", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("No communication facility on the first floor. We need to try to get upstairs.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Getting upstairs?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At these words, Heinrich walks up to the handrails.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Mumbling) Hmm...it's material I haven't seen before...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("But it's not difficult to rebuild it…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She picks up the broken wire and takes out a piece of gem-like stone.")
	await novel_interface.show_text_only("The fissure is twisted, elongated, and connected together smoothly, as if it's ductile in Heinrich's hands.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("So this is alchemy…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A look of admiration appears on Raphael's haughty face.")
	await novel_interface.show_text_only("Heinrich takes up the wire, her battle suit beginning to flash in different colors.")
	await novel_interface.show_text_only("She then gives the wire a yank, which is tightened again. A dozen steps are pulled back to their original place.")
	await novel_interface.show_text_only("She reattaches the wire to the buckle on the floor, as if it's just a soft ball of yarn.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wow… Marvelous!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Well… At least the reinforcement property of this battle suit is quite useful for alchemists.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("After all, sometimes we have to deal with troubles… troubles beyond imagination.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Putting Annie on the sofa, the three of us walk up the stairs…")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
