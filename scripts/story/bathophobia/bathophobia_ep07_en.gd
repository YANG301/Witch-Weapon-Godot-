# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("When crawling out of Mariru's red Coupe, I feel the whole world spinning and I can barely stand up straight.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… Urgh… \\nThe way you drive!! It's crazy!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Earlier this morning, I was curling up with a cozy blanket as usual. Suddenly, Annie barged in and pulled me out of bed.")
	await novel_interface.show_text_only("Still half-asleep, I was thrust into the car. At that moment, I was still protesting about her violent behavior.")
	await novel_interface.show_text_only("But after this horrendous ride, the only thing left in my mind is \"thank goodness I'm still alive\"…")
	await novel_interface.show_text_only("Project Ark is kicking off today, but I really want to call in sick.")
	await novel_interface.show_text_only("My stomach has been hurting for days. Damn it!")
	await novel_interface.show_text_only("And I always feel like vomiting… Urgh!")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Are you all right, Ren?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I wave at Annie dismissively.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("I'm fine, just a little sick. And I can't stop shivering right now…", "Lian")
	await novel_interface.show_dialog("Can I take another car when we go back?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I ask in a feeble voice, looking at Annie pleadingly")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Look at you. You're so used to playing miss innocent, aren't you?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As I was leaning against the wall for support, a familiar voice arrives from behind. Gosh! Just let me go…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Raphael? Why are you…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Didn't Mariru tell you that I'd be here?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("She wouldn't show up if I did.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Looking at me as if I were her pet for sale, Mariru brushes over Raphael's question.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("I'll leave Ren to you, \\nMiss Dekkers, our dear Executive Representative of Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wait! Leaving me to her?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru puts on a smile and takes us to the entrance of the Ark Base.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Are you sure this… is the entrance?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In front of us is an entrance to a concrete basement facing this road on the outskirts of the city. The door only allows one person to pass through.")
	await novel_interface.show_text_only("There are no buildings at all within a half-mile radius. If it had not been for the SID logo engraved on the wall, I must have taken it as a creepy hideaway for some pervert.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hee-hee, come with me.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("We walked down the stairway behind the door that leads to a large freight elevator.")
	await novel_interface.show_text_only("It seems the elevator is designed for extreme environments. Four thick metal sheaves ensure safe and stable operation.")
	await novel_interface.show_text_only("As the elevator descends smoothly, the sound of rotating gears comes from all corners.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("The vents, metal meshes, rivets, and the dim light… Vintage industrial elements are everywhere.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Reliability over everything else… I've seen such designs in the gold vault of the Central Bank of Newmoridas.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Wow, you've been there?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("It was one of the world's biggest construction projects before the Seven Years War, and it took us a lot of work to restore this place.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru proudly introduces this underground structure.")
	await novel_interface.show_text_only("Raphael is right. The elevator, although still running, is as stable as a huge chunk of solid steel. It crosses my mind that even jumping around wouldn’t cause the slightest jitter to the elevator.")
	await novel_interface.show_text_only("Having just recovered from the motion sickness, I'm itching to give it a try, only to find Raphael glaring at me.")
	await novel_interface.show_text_only("Realizing that I might be acting dumb, I immediately knock it off with an embarrassed look. But she turned her face in disdain to the observation window.")
	await novel_interface.show_text_only("What on earth can she see in the darkness?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Why are you staring at me?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pot calling the kettle black, huh?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ugh… Never expected Salmonton would send you here.", "Lian")
	await novel_interface.show_dialog("After all, the experiment today is quite dangerous.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("More importantly, I know this experiment is a show with two scripts.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Do you really know what you've gotten into, my lady?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I turn to Mariru helplessly.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("On the surface, it's a joint research project between New Opulentia and Salmonton.", "Mariru")
	await novel_interface.show_dialog("The aim is to identify the causes of Spacetime Flux and countermeasures.", "Mariru")
	await novel_interface.show_dialog("Both sides need to send a qualified and trustworthy person as a human subject.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Now that your absurdity at the Sky Hotel that night has revealed your identity, you're definitely the best choice for New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru shoots a glance at me, casting a chill over my spine.")
	await novel_interface.show_text_only("Come on, I've learned my lesson…")
	novel_interface.character_light()
	await novel_interface.show_dialog("As for Raphael, our “highborn-turned-commoner” at Gosakuragawa, she volunteered to join the experiment on behalf of Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Volunteering?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, the Lapis Pillar is very important to Salmonton. I'd never let you loser screw this up.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Raphael is capable of accelerating self-healing at the cell level. This has been affirmed by Aya.", "Mariru")
	await novel_interface.show_dialog("But according to Beatrice, Raphael had better work with Ren to bring her talent into full play.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It suddenly occurs to me that, at the parking lot of Sky Hotel, Raphael healed Annie in the blink of an eye.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("So Raphael is on our side, right?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, I can imagine your pathetic look when you scramble for your life. “Owww… I'm dying… Heal me now…\"", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Sounds like you can’t wait for this to happen?!", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Wait, I thought it was a secret experiment. \\nHow did she know?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("I've made it all clear to Dr. Dekkers.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Since he witnessed you resurrecting Beatrice, he felt that his previous cooperation with the Senate was in the wrong direction.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Is it something to do with religion?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("It's probably not that simple… But now, Salmonton is willing to work with SID, as long as Raphael is safe with us.", "Mariru")
	await novel_interface.show_dialog("The Senate doesn't know about your real abilities. That's the strength we should make full use of.", "Mariru")
	await novel_interface.show_dialog("A witch does not trigger anything when she touches a Witch's Shard. That's why our plan can work.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("So, I really want to thank the leaders of both sides for making this happen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Are you sure my whimsical grandpa is not fooled into this?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Your grandfather is not that naïve, sweetheart. The relic here is by no means his random pick.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("We've done all these to make sure the \"real experiment\" can be carried out successfully.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, if it had not been for my grandpa's order…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael mumbled something vaguely, his eyes passing me lightly.")
	novel_interface.character_light()
	await novel_interface.show_dialog("I'd never agree to cooperate with this cross-dressing pervert!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("But Dr. Dekkers always says you're the one who never listens.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Let me guess… Salmonton is actually interested in Heinrich, the original owner of the Lapis Pillar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Good luck, Ren!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The Senate plans to work with Salmonton on producing more witches behind SID's back. And this time, they want to verify the feasibility of using me as a Stabilizer.")
	await novel_interface.show_text_only("Salmonton, however, has made a secret deal with Mariru.")
	await novel_interface.show_text_only("As for Mariru, she kept the Senate in the dark about our real abilities.")
	await novel_interface.show_text_only("It’s getting complicated. This is killing me…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Can we really fight side by side?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I steal a glance at the overbearing lady in front of me.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Transferring Raphael to Gosakuragawa…) \\n(is also part of their plan?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Look at that stupid face. She must be thinking something dumb again.)", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("The elevator finally comes to a stop with a knocking sound. \\nA 35-feet-tall metal gate looms in front of us.")
	await novel_interface.show_text_only("A red laser beam sweeps across my body from head to toe. \\nBefore long, a confirmation beep comes out from the gate.")
	await novel_interface.show_text_only("Mariru moves forward for a follow-up iris scan.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("They may be old-fashioned, but the security measures here are pretty tight…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("As we're done with the scanning, the giant gate slowly lowers, leaving us amazed by the astounding space behind the door.")
	await novel_interface.show_text_only("The enormous underground space is supported by two rows of stately concrete pillars.")
	await novel_interface.show_text_only("The base of each pillar is covered with piles of armor shards which can be used in both directions.")
	await novel_interface.show_text_only("Facing out, these shards can protect the structure from devastating rocket attacks. But if used in the opposite direction, they are capable of destroying the pillars all at once.")
	await novel_interface.show_text_only("During the Seven Years War, these armor shards were widely used in fortresses that need to be either blocked or destroyed.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("It's pretty damp here…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The floor is riddled with water stains. High above, dozens of new pipes are mounted on the ceiling, giving out sounds of liquid rushing through.")
	await novel_interface.show_text_only("Mariru must have put in tons of effort to transform this place.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Deep towards the end of the passageway, we find ourselves standing in front of a space enclosed by metal slabs.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ladies.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Welcome to the Ark Base.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I just… I just can't believe my eyes!")
	await novel_interface.show_text_only("What lies in front of us is a reservoir. Watching the mist rising up from the gleaming water, it feels like I'm standing on a wharf.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Just watch—the Boarding Ladder is on its way to us.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
