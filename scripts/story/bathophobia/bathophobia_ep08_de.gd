# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Als Mariru auf ihr Mobilteil tippt, ertönt ein tiefes Grollen aus der Tiefe des Reservoirs. Der Wasserstand sinkt, als die Unterwasserschleuse aufbricht.")
	await novel_interface.show_text_only("Anscheinend ist der Stausee über 30 Fuß tief und der Damm hat sich sofort in eine Klippe verwandelt.")
	await novel_interface.show_text_only("Wenn der Wasserstand sinkt, erhebt sich auf der Plattform auf der gegenüberliegenden Seite der Klippe ein blaues Denkmal.")
	await novel_interface.show_text_only("Während die umliegenden Lichter nacheinander aufleuchten, ist die Form dieses Denkmals unverkennbar: Es handelt sich um die Tesheimer Lapissäule.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Wow…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf der gegenüberliegenden Seite befindet sich ein riesiger Raum, der breiter ist als ein normales Fußballfeld. Reihen von Säulen, mehrere Dutzend, wenn nicht Hunderte Fuß hoch, säumen den Raum bis in die Dunkelheit.")
	await novel_interface.show_text_only("In fast 300 Fuß Höhe können die Dachlichter ihre Umgebung kaum erkennen und am anderen Ende bleibt es stockfinster.")
	await novel_interface.show_text_only("Die übertriebene Größe des Bauwerks wirkt alptraumhaft einschüchternd.")
	await novel_interface.show_text_only("Die blinkenden Indikatoren an den vier Ecken der Plattform erinnern uns an das Vorhandensein eines elektromagnetischen Schutzschildes.")
	await novel_interface.show_text_only("Langsam erstreckt sich ein Gehweg auf uns zu.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… Großartig!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das erinnert mich an die Eröffnungsszene eines Schießspiels.")
	await novel_interface.show_text_only("Wir folgen Mariru und gehen über eine reaktionsfähige Treppe zum Kontrollpult.")
	await novel_interface.show_text_only("Die meist in der Wand versteckten Stufen kommen erst dann zum Vorschein, wenn jemand gerade darauf tritt.")
	await novel_interface.show_text_only("Das Treppenhaus scheint so gestaltet zu sein, dass es Personen daran hindert, sich dem Kontrollpult zu nähern oder es zu verlassen.")
	await novel_interface.show_text_only("Ich schaue mich um und bemerke an der Decke ein paar geschlossene Schießscharten für kleine schwere Waffen.")
	await novel_interface.show_text_only("Wenn ich daran zurückdenke, wie wir hierher gekommen sind, versuche ich mir die Struktur dieser riesigen unterirdischen Anlage vorzustellen.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… Sie müssen Milliarden von Dollar in diese Sache gesteckt haben.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Eine Renovierung ist keine leichte Aufgabe, aber sie ist die einzige Wahl, die wir haben, wenn wir Sicherheitsstandards einhalten und Fristen für Ark-Projekt einhalten wollen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Im Hinblick auf Sicherheitsstandards bedeutet Mariru die Fähigkeit, sich gegen mögliche Bedrohungen wie mächtige, aber feindselige Hexen zu verteidigen.")
	await novel_interface.show_text_only("Um die Sicherheit der Akademiestädte zu gewährleisten, verlangt der Senat, dass diese Einrichtungen in der Lage sind, solche Bedrohungen zu bewältigen und zu beseitigen.")
	await novel_interface.show_text_only("Bei unbekannten Bedrohungen würden diese Standards jedoch allenfalls als psychologische Polster dienen.")
	await novel_interface.show_text_only("Das sagte Mariru bei der Betriebsbesprechung.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Worauf warten Sie noch?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als wir uns dem Kontrollpult nähern, zögere ich immer noch, die mehr als 30 Fuß hohe Treppe zu betreten, obwohl ich weiß, dass die Stufen die Bewegung meiner Füße nachzeichnen.")
	await novel_interface.show_text_only("Auf der Plattform davor steht die Lapissäule, größer als ich und von vier großen Greifern getragen.")
	await novel_interface.show_text_only("Ich fühle mich völlig überwältigt, die Säule persönlich zu sehen. Die Fotos im Internet sind nicht vergleichbar.")
	await novel_interface.show_text_only("Die Oberfläche dieses durchscheinenden türkisfarbenen Denkmals ist mit eingravierten Mustern aus dünnen Linien gefüllt.")
	await novel_interface.show_text_only("Es scheinen sich dabei um in einer bestimmten logischen Reihenfolge angeordnete Symbole zu handeln, doch bisher konnten Archäologen sie nicht entschlüsseln.")
	await novel_interface.show_text_only("Konzentrische Kreise, Wellen, Konturen – Anstatt bedeutungsvolle Codes scheinen sie Konzepte direkter zu vermitteln.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Es muss ein nationaler Schatz sein … Vielleicht sollten wir in unserem ersten Experiment andere Artefakte von geringerer Bedeutung ausprobieren …", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Hä? Erschrocken?", "Raphael")
	await novel_interface.show_dialog("Wenn Sie das vermasseln, wissen Sie, was Sie erwartet, oder?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael warnt.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Nein, natürlich nicht. Es kommt mir einfach zu extravagant vor...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("OK, jetzt deaktivieren wir den elektromagnetischen Schild.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru zieht vorsichtig den roten Hebel am Steuerpult. Die roten Lichter an den Ecken der Schutzvorrichtung erlöschen auf einmal.")
	await novel_interface.show_text_only("Plötzlich ertönt ein Summen auf meiner Kopfhaut, als ob ein schwacher Strom durch mein Gehirn fließen würde.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Alles in Ordnung?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Es könnte die magische Inschrift sein, aber...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich fixiere meinen Blick auf die Lapissäule. Etwas stimmt nicht.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Es sieht so aus, als ob Ihr Körper sehr empfindlich ist.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, nicht vor…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich werfe einen Blick auf Raphael, die mir diesen „Du Perversling“-Blick zuwirft.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Was Sie gesagt haben, ist irreführend!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Zu unserer Sicherheit wiederhole ich die Anweisungen zur Bedienung der elektromagnetischen Abschirmung.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru winkt Raphael und Annie zum Kontrollpult und dreht sich dann zu mir um.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Die Inszenierung läuft?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Auf dieser Kontrollstation und den umliegenden Säulen befinden sich Dutzende Sensoren und Vollspektrumkameras. Sie sind so eingestellt, dass sie automatisch laufen, wenn das Abschirmgehäuse geöffnet ist.", "Mariru")
	await novel_interface.show_dialog("Die Daten und Bilder werden direkt an den Beobachtungsraum gesendet und nach dem Experiment an Salmonton-basierte Forschungseinrichtungen weitergegeben.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru zwinkert mir zu.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Zum Teufel werden Sie das tun...) \\n(Sie haben offensichtlich gefälschte Daten vorbereitet...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich schaue zum Beobachtungsraum oben auf den angrenzenden Säulen.")
	await novel_interface.show_text_only("Das einseitig explosionsgeschützte Glas zeigt keine Spuren von Menschen dahinter und reflektiert lediglich das Umgebungslicht kalt.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Diese Senatoren sollten dahinterstecken …)", "Lian")
	await novel_interface.show_dialog("(Ich hoffe, wir können sie austricksen...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mit diesem mechanischen Schalter und der Handkurbel können das Abschirmgehäuse und der Steg bequem gesteuert werden.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Den Anweisungen von Mariru folgend, durchläuft Annie jeden Knopf und Schalter des Kontrollpults.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Ich habe seit einiger Zeit keine mechanischen Schalter mehr gesehen, und hier eine Kurbel... \\nWarum benutzt du diese alten Apparate?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Mechanische Geräte sind in der Regel die stabilsten Lösungen. Trau dich einfach.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Also, bevor ich in den Kommandoraum gehe, möchten Sie noch etwas fragen?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(Sind... Beginnen wir gleich?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mein Herz klopft wild. Ich atme ein paar Mal tief durch.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… Nervös?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru scheint mein Unbehagen bemerkt zu haben, legt ihren Arm um meinen Rücken und sagt sanft zu mir:")
	await novel_interface.show_text_only("Solch intimes Verhalten vor anderen lässt mein Gesicht brennen.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("A... Ein bisschen...", "Lian")
	await novel_interface.show_text_only("Mein Herz rast schneller!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Eine Inszenierung zu veranstalten ist wirklich nicht mein Ding! Als Kind hatte ich nur eine Schauspielrolle in Onkel Toms Hütte. Und ich war die Hütte.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru blickt zum Beobachtungsraum hinauf.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ja?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ihr Atem betäubt mein Ohr. Es ist, als ob ein Nerv von der Rückseite meines Ohrs verläuft und das Taubheitsgefühl durch meinen Körper bis zu meinen Fersen überträgt.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Entspannen Sie sich, die Senatoren werden nichts bemerken.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru flüstert mir ins Ohr.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Ungefähr 21 Meter über meinem Kopf befindet sich eine Schicht optischer Tarnung.", "Mariru")
	await novel_interface.show_dialog("Und das Glas des Beobachtungsraums ist behandelt, sodass sie nur das sehen, was sie sehen „sollten“ …", "Mariru")
	await novel_interface.show_dialog("Nachdem Raphael das Abschirmgehäuse geschlossen hat, verschwinden Sie vor ihnen, als ob Sie den Flux-Bereich betreten hätten.", "Mariru")
	await novel_interface.show_dialog("Danach müssen Sie nur noch versuchen, die Lapissäule zu berühren. Es ist in Ordnung, wenn Sie Hexen nicht wie geplant rufen können.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich höre ein Kichern, und dann bläst Mariru mir einen Luftstoß ins Ohr. \\nDer Nerv, den ich gerade bemerkt habe, protestiert wieder energisch.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Aber wenn etwas Schlimmes angekündigt wird... \\nSie wissen, wie man mit dem schlimmsten Fall umgeht, oder?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich schlucke kurz.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sobald die Sensoren den Schwellenwert erreichen, werden die Blockade- und Zerstörungsprogramme ausgelöst…", "Lian")
	await novel_interface.show_dialog("Innerhalb von 5 Sekunden müssen wir die Falltür auf dem Boden zu Ihrer Rechten nehmen und die unterirdische Trennungszone betreten.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich werfe einen Blick auf den Notfallpfad, den wir bei der Einsatzbesprechung geplant haben.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Um genau zu sein, haben Sie nur 4,8 Sekunden Zeit.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Die gesamte Basis wird sofort mit Meerwasser überflutet) \\n(Ganz zu schweigen vom Waffensystem über meinem Kopf...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Aber laut meiner Hintergrundüberprüfung zur Lapissäule...", "Mariru")
	await novel_interface.show_dialog("Sein früherer Besitzer war ein überzeugter Pazifist, obwohl er sehr geheimnisvoll war und mehrere Decknamen verwendete.", "Mariru")
	await novel_interface.show_dialog("Vielleicht ist es also ein haariger Mann mittleren Alters, den Sie nennen könnten.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Wenn ja, lassen Sie ihn einfach von Raphael zurück zu Salmonton bringen!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Wie auch immer, Sicherheit geht vor.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru lässt mich los und tätschelt meinen Kopf.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Passen Sie auf sich auf... Ich werde auf Sie aufpassen.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Bei einem Ton, der den Beginn des Experiments signalisiert, fixiere ich meinen Blick wieder auf die Lapissäule, die schweigend auf der Plattform steht.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Werden wir Erfolg haben?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
