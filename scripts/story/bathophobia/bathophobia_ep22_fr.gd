	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("C'est... si complexe...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il faudrait des heures pour parcourir tout l’endroit. Des chevets, on n’a même pas la moindre idée de ce qu’on cherche.")
