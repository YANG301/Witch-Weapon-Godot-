	await novel_interface.show_dialog("... Le blizzard a-t-il coupé le signal ?","Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La puce GPS de Ren ne transmet plus.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Si les communications sont perdues à ce point, les missions dans les zones couvertes par des particules chargées à haute énergie seront également affectées, n'est-ce pas ?","Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Vous les gars de SRD devez améliorer votre jeu.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lève les yeux au ciel vers Aya, qui tire la langue.")
