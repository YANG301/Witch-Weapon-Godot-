	await novel_interface.show_dialog("Et il pourrait y avoir d’autres ennemis fous qui se cachent dans les coins.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ces étranges marionnettes que nous venons de rencontrer... rien que d'y penser me donne des palpitations cardiaques.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Eh bien, pour ma part, je refuse d’être une cible facile !","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l frappe du poing sur le bureau, soulevant un nuage de poussière.")
	await novel_interface.show_text_only("La caméra de surveillance à détection sonore située derrière la poutre métallique ajuste légèrement son angle en cas de bruit soudain.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est peut-être le bon moment pour poser la question qui me hante depuis mon retour à la station de ravitaillement.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Hé, tu... peux sentir de quel matériau quelque chose est fait ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La fille blonde sourit à ma question.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Bien sûr. C’est une compétence de base pour tous les alchimistes de Rosenkreuzer.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Alors si... il y a un très très long fil métallique isolé, seriez-vous capable de le tracer jusqu'au bout et de trouver où il mène ?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Si je peux le toucher, je devrais pouvoir le faire.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Tu veux dire…","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fais un signe de tête à Rapha?l. Ensemble, nous nous retournons et regardons le coin sombre de la pièce...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Red_Dot.png")
	await novel_interface.show_text_only("Où le point rouge de lumière scintille en rythme, comme s’il avait une impulsion.")
	await novel_interface.show_text_only("La caméra de surveillance à détection sonore.")
	await novel_interface.show_text_only("Dans la base souterraine tentaculaire, il devrait y avoir des tas de ces appareils.")
	await novel_interface.show_text_only("Tout cela devrait mener à un seul endroit :")
	await novel_interface.show_dialog("La salle de contrôle.","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
