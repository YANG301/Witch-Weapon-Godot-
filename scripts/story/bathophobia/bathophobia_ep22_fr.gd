	novel_interface.change_2nd_expression("blush_stare")
	await novel_interface.show_dialog("Pourtant, perdre le signal juste comme ça..., nos appareils ne sont pas si inutiles.","Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous voulez dire qu'il y a... d'autres raisons provoquant la déconnexion ?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush_dizzy")
	await novel_interface.show_dialog("Ouais. Je ne sais pas ce que c'est, mais ça doit être puissant... \\nJ'envie certainement celui qui se cache derrière ça...","Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru regarde pensivement l'appareil dans sa main et le mot clignotant, DÉCONNECTÉ, sur son écran.")
	await novel_interface.show_text_only("Pendant ce temps, Aya observe le visage de Mariru.")
	novel_interface.show_character("liliu_uniform1","serious")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Vous ressemblez à un propriétaire d’animal inquiet pour son chat en fuite.","Ai")
	novel_interface.character_light(0.35,"sigh")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi qu’il en soit, nous ne pouvons rien faire d’autre que d’attendre.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya expire en se tournant vers la fenêtre.")
	novel_interface.show_character("liliu_uniform1","sigh")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Altitude 37 000 mètres au dessus du niveau de la mer. C’est comme si nous étions déjà dans l’espace.","Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si nous montons plus haut, notre radar et nos communications cesseront de fonctionner.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru jette un coup d'œil au poste de travail de leur croiseur, où plus de trente agents du renseignement sont occupés à trier les données arrivant des quatre coins du monde.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ce transporteur lourd à grande vitesse... \\nVous l'avez à l'œil depuis un moment, n'est-ce pas ?","Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ha. Le Sénat a certainement caché des trucs sympas.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Encore trois heures avant d'atteindre l'Antarctique...","Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Si l’une des parties du corps de Ren se brisait, nous aurions de gros problèmes.","Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Remarquant qu'Aya se rongeait anxieusement les ongles, Mariru lui frappe l'arrière de la tête avec sa jointure.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Hé.","Mariru")
	await novel_interface.show_dialog("À votre avis, qui a formé ces gars-là ?","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("<Base de Snedronningen>")
	await novel_interface.show_text_only("En suivant les indications d’Henriette, nous traçons le câble relié au dispositif de surveillance jusqu’au plus profond de la base.")
	await novel_interface.show_text_only("Les couloirs sont ici de plus en plus étroits. Les murs sont nus, comme si la construction n’était pas encore terminée.")
	await novel_interface.show_text_only("Nos pas résonnent sur les parois du tunnel. Effrayant. Trop effrayant. Je sens mon cœur battre dans ma poitrine.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ce n'est pas le bon moment pour ça, mais...")
	await novel_interface.show_text_only("Mais plus je deviens nerveux, plus il est difficile de le retenir en...")
	await novel_interface.show_text_only("Je m’arrête net, lève une main.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hé…","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Et maintenant ?","Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Puis-je...","Lian")
	await novel_interface.show_dialog("Aller à... les toilettes ?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Me voici, dans un tunnel apparemment sans fin, sans portes ni embranchements, avec deux filles. Et je demande à aller aux toilettes. Je veux sauter d'une falaise.")
	novel_interface.show_character("ren_battle","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("…","Raphael")
	novel_interface.change_2nd_expression("subtle")
	await novel_interface.show_dialog("Réalisez-vous seulement la gravité de la situation ?","Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je m'appelle..., je suis désolé ! Je n'y peux rien, d'accord ?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je resserre mes cuisses, essayant de regarder ailleurs que le visage clairement dégoûté de Rapha?l.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","subtle",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Plus je suis nerveux, plus je me dis de ne pas y penser, pire c'est...)","Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je suis sur le point de pisser dans mon pantalon...")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("(Qu'ai-je fait pour mériter ça ?)","Lian")
	await novel_interface.show_dialog("Euh, si l'un de vous a une bouteille en plastique ou quelque chose comme ça, je pourrais...","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("... Hein ?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ugh, de quoi est-ce que je parle ?")
	await novel_interface.show_text_only("Rapha?l me voyait comme un pervers, mais maintenant..., elle me voit probablement comme un déchet.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Vous voulez quelque chose pour retenir votre pipi, hein, Maître ? Eh bien, je pourrais essayer de forger des matériaux...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette semble apprécier un peu trop cela.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Allez! Tu sais, ce n'est pas ce que je veux dire !","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Voyant le désespoir dans mes yeux, l'alchimiste a finalement eu pitié de moi et a découpé un trou de la bonne taille dans les parois du tunnel.")
	await novel_interface.show_text_only("Derrière le mur se trouve ce qui ressemble à des quartiers d'ouvriers : sombres, moisis et, surtout, équipés de toilettes.")
	await novel_interface.show_text_only("Vive l'alchimie !")
	await novel_interface.show_text_only("Je me faufile immédiatement par le trou, ne voulant plus rester sous les yeux scrutateurs de Rapha?l.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La température semble être plus basse ici. Il y a une fine couche de glace sur les murs et je peux voir mes respirations sortir en bouffées blanches.")
	await novel_interface.show_text_only("Avec la lumière provenant des tunnels, je peux lire le thermomètre à mercure accroché au mur. Il est écrit moins trente-deux degrés.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Ouah, dans ce cas, est-ce que ma pisse sera gelée à la seconde où elle sortira ?)","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Probablement pas..., n'est-ce pas ?)","Lian")
	await novel_interface.show_dialog("(mais...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	await novel_interface.show_text_only("Je retourne enfin dans le tunnel en rougissant furieusement.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Qu'est-ce qui t'a pris si longtemps ?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ton visage est tout rouge.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Toute la puissance de votre Fire Jade a-t-elle été consommée ? Besoin d'un nouveau ?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Non, non, ça va !","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Désolé, Henriette... \\nCe Fire Jade..., je ne laisse personne le tenir maintenant !")
	await novel_interface.show_text_only("La vessie ne me tuant plus, je suis joyeusement Henriette et Rapha?l tandis que nous continuons à marcher dans le sens des câbles.")
	await novel_interface.show_text_only("J’essaie de me rappeler ce que je viens de voir dans les quartiers ouvriers. Sur une table se trouvait une demi-bouteille de Vodka et sur les murs de la glace sombre.")
	await novel_interface.show_text_only("J'avais l'impression d'avoir donné un coup de pied dans un objet métallique en me promenant dans le noir... \\nS'agit-il de douilles de balle ?")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Non, non. Cela a dû être mon imagination.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'observe mon environnement. Les murs du tunnel en ciment sont pour la plupart nus, à l'exception de quelques tuiles.")
	await novel_interface.show_text_only("Attendez les tuiles... ? Si cet endroit avait été en construction comme je le pensais, les tuiles ne seraient pas placées de manière aussi aléatoire.")
	await novel_interface.show_text_only("Mais quelle force a décollé toute la paroi intérieure du tunnel ? ?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_text_only("(Ici... que s'est-il passé exactement.)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nous atteignons finalement la porte de la salle de surveillance. La poignée de porte coincée semblait n'avoir pas été tournée depuis longtemps.")
	await novel_interface.show_text_only("Cela ne dissuade pas Henriette. Ce monstre casse simplement le bouton, la serrure et tout.")
	await novel_interface.show_text_only("La porte de la salle de surveillance s'ouvre...")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("— Attention !","Henriette")
	
	print("=== 潜渊症篇第22话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
