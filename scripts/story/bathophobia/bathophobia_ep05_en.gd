# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("What is the Soul?")
	await novel_interface.show_text_only("A form of energy that preserves consciousness? Or an unobservable quantum state?")
	await novel_interface.show_text_only("Or just a concept…")
	await novel_interface.show_text_only("Just like the concept of time in physics—")
	await novel_interface.show_text_only("Maybe it's just an illusion… a dream.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Then the question is—")
	await novel_interface.show_text_only("Who is the dreamer?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("The biting chill in the Antarctic Convergence shuts out all the noise from the outside world.")
	await novel_interface.show_text_only("At 20,000 ft below sea level lies the abyssal zone.")
	await novel_interface.show_text_only("Wrapped in a titanium pressure hull, a deep-sea submarine is descending slowly.")
	await novel_interface.show_text_only("The faint light emitted from its status indicator is quickly engulfed in the abysmal darkness.")
	await novel_interface.show_text_only("Without light, it is unable to perceive space.")
	await novel_interface.show_text_only("A creepy fangtooth tries to hit the hull, but it receives no response.")
	await novel_interface.show_text_only("The water pressure of 60 MPa puts the hull's compressive stress limit to test.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("Suddenly, eight pre-programmed searchlights are turned on simultaneously, casting eight straight narrow beams of light.") #换行问题
	await novel_interface.show_text_only("Like sharp swords, the searchlights burst into a dazzling glare and pierce through the darkness.")
	await novel_interface.show_text_only("A beam of light passes through the thick windowpanes of the control room and falls on the face of a sleeping girl.")
	await novel_interface.show_text_only("Her long dark-gray hair, shining with blue luster, scatters on her pale but pure face.")
	await novel_interface.show_text_only("The depth gauge on the dashboard in front of the girl stops working at 4091 ft.")
	await novel_interface.show_text_only("The searchlights outside the room fade gradually. But a faint, silver gleam starts flickering around the girl's body.")
	await novel_interface.show_text_only("From the depths of the ocean much feared by humans, comes a deep and distant voice.")
	await novel_interface.show_text_only("Like the calling of an ancient monster.")
	await novel_interface.show_text_only("The sleeping girl seems to be awakened from her mother's womb.")
	await novel_interface.show_text_only("Also awakened is the uncontrollable dizziness and nausea…")
	await novel_interface.show_text_only("Far below the safety depth of 15,000 ft, the metal hull begins to make an abnormal cracking sound.")
	await novel_interface.show_text_only("A suppressed cough heaves out from the girl's throat.")
	await novel_interface.show_text_only("She has some difficulties in breathing at first, but quickly adapts to the underwater pressure and steadies her breath.")
	await novel_interface.show_dialog("The collision just now… Seems to have knocked me out.", "Girl")
	await novel_interface.show_dialog("But I can still breathe… There must be enough oxygen.", "Girl")
	await novel_interface.show_dialog("I can see my breath… \\nClose to 32 °F, sure enough…", "Girl")
	await novel_interface.show_dialog("System check. Ready for a cold boot. \\nIdentification information: Beth.", "Girl")
	await novel_interface.show_text_only("The girl named Beth doesn't seem to worry about the freezing temperature. She checks the system attentively.")
	await novel_interface.show_text_only("She was born with the ability to sustain extreme cold. When baby Beth was found in the winter mountains, she had already spent a whole night on the ice.")
	await novel_interface.show_text_only("A number of physical examinations have proved that the miraculous girl can adapt to various cold environments.")
	await novel_interface.show_text_only("Under the intense cold which could render an adult unconscious within 30 seconds, her body temperature is still normal and her hands warm.")
	await novel_interface.show_text_only("Doctors were unable to figure out why before she was taken away from the orphanage by her adoptive father.")
	await novel_interface.show_dialog("Lighting and propulsion systems... startup normal. Sensor restart... all good.", "Beth")
	await novel_interface.show_dialog("Is it 20,000 ft deep already? \"That thing\" can't exist under such high water pressure.", "Beth")
	await novel_interface.show_dialog("I’ve got to save power for the return trip… Searchlights off—", "Beth")
	await novel_interface.show_text_only("Just as the searchlights are turned off, Beth glances outside the window.")
	await novel_interface.show_dialog("What…", "Beth")
	await novel_interface.show_text_only("A creepy scene makes her hair stand on end.")
	await novel_interface.show_dialog("What's… that…", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Right before the searchlights went off, a gigantic coral-like structure appears outside the observation window.")
	await novel_interface.show_text_only("It is a centripetal tissue-like structure. On it, irregular vessels look like a scarlet cascade falling into a huge black hole.")
	await novel_interface.show_text_only("But no biological or topographical structures were found during the scanning just now.")
	await novel_interface.show_text_only("Beth immediately turns on the wide-angle lens on the hull, trying to take a broader view—")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("On the screen, there is a huge and foggy shadow. It spans more than 300 ft and has tentacles.")
	await novel_interface.show_dialog("This can't be…", "Beth")
	await novel_interface.show_text_only("It is not part of the landscape, but some kind of creature for sure. Red flecks of light are shining in the darkness.")
	await novel_interface.show_dialog("Is that… an eyeball?", "Beth")
	await novel_interface.show_text_only("—If that weird thing can be called an \"eyeball\".")
	await novel_interface.show_text_only("The black hole facing the window is the pupil of the eyeball.")
	await novel_interface.show_text_only("It's too close to determine the distance. The hull seems likely to be sucked into the pupil at any moment.")
	await novel_interface.show_text_only("Red flecks fade away. The girl is now facing off against the unknown object in the silent darkness.")
	await novel_interface.show_text_only("When her eyes adapt to the darkness, she sees on the screen the huge eyeball giving off faint red light, as if it's an opaque jellyfish.")
	await novel_interface.show_text_only("The eyeball is filled with lumps of squirmy tissues. \\nIt is beating together with her heart.")
	await novel_interface.show_dialog("(Chill… chill out!) \\n(Think about it…)", "Beth")
	await novel_interface.show_text_only("If that is an eyeball, its crystalline lens should be sensitive to light.")
	await novel_interface.show_text_only("On the outer layer of the eyeball where the choroid should exist, swarms of white spots are flickering.")
	await novel_interface.show_text_only("Beth notices that branch-like tentacles are attached to the back side of the eyeball.")
	await novel_interface.show_text_only("The dark-gray tentacles are immersed in the depth of the ocean, without any end in sight.")
	await novel_interface.show_dialog("(… I can't… move…)", "Beth")
	await novel_interface.show_text_only("—Beth is more like being watched by, instead of facing off That Thing.")
	await novel_interface.show_text_only("The intrusive gaze erodes her calmness and makes her frightened.")
	await novel_interface.show_dialog("Help…", "Beth")
	await novel_interface.show_text_only("—Will it swallow up everything?")
	await novel_interface.show_text_only("The strange feeling of being deep down in the ocean makes her doubt her very existence.")
	await novel_interface.show_dialog("(Is it a dream…?) \\n(Wake up, quick…)", "Beth")
	await novel_interface.show_text_only("Her body breaks free on instinct before her mind can catch up.")
	await novel_interface.show_text_only("As the girl pulled the joystick with her left hand, the diving chamber continued to move a certain distance toward the eyeball.")
	await novel_interface.show_text_only("The water gets rough as if That Thing is being disturbed.")
	await novel_interface.show_text_only("The pupil contracts, waiting to see the girl's next move.")
	await novel_interface.show_dialog("Hello? Hello?", "Beth")
	await novel_interface.show_text_only("Beth grabs her headset and tries to connect with the control desk.")
	await novel_interface.show_text_only("But no electromagnetic wave can escape this depth, and underwater acoustic communication is not viable for the moment.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("If she were there… She would have shouted at me— \\n\"Stop getting any closer!\"")
	await novel_interface.show_dialog("Ha… why would I think of this…", "Beth")
	await novel_interface.show_dialog("Who is… \"She\"?", "Beth")
	await novel_interface.show_dialog("Where… am I…", "Beth")
	await novel_interface.show_text_only("Stared at by the giant eyeball, Beth is lost in a daze. The boundary between reality and illusion is slowly blurring out.")
	await novel_interface.show_text_only("She runs her hand all over the dashboard.")
	await novel_interface.show_text_only("She soon locates the robot arm controller.")
	await novel_interface.show_dialog("(Do I really have to…)", "Beth")
	await novel_interface.show_text_only("She gathers her breath, but the illusionary light continues to flash in front of her eyes.")
	await novel_interface.show_dialog("Take some samples… And then withdraw right away…", "Beth")
	await novel_interface.show_text_only("First, point the searchlights to the front…")
	await novel_interface.show_text_only("Then, set up the propulsion system… maximum speed. Direction… reverse.")
	await novel_interface.show_text_only("Struggling to finish pre-configuration, the girl is almost on the verge of losing her consciousness.")
	await novel_interface.show_dialog("Father, is this… spiritual pollution… \\nI am almost…", "Beth")
	await novel_interface.show_text_only("Beth operates the manipulator slowly to release the robot arm. A huge needle is revealed.")
	await novel_interface.show_dialog("Suction mode on… Under such pressure, one quick draw will be sufficient…", "Beth")
	await novel_interface.show_text_only("The robot arm stretches forward until the needle is inserted into the vitreous.")
	await novel_interface.show_text_only("The concentration level of the container jumps from 0 to 100% in an instant.") #标点删除
	await novel_interface.show_text_only("For a moment, the pupil is distorted. If sound were able to penetrate the hull, she must have heard a harsh scream…")
	await novel_interface.show_dialog("(I'm hearing things…)", "Beth")
	await novel_interface.show_text_only("With her last effort, the girl presses the programmed execution button.")
	await novel_interface.show_text_only("According to the preset program, the searchlights project eight intense beams of light into the pupil, and the propeller begins to rotate wildly.")
	await novel_interface.show_text_only("The eyeball recedes at the stimulation of the light, and the hull begins to pull back and rise…")
	await novel_interface.show_text_only("Completely exhausted, the girl loses consciousness and collapses to the floor.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
