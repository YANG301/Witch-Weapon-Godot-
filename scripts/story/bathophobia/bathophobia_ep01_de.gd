# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru gibt in der nichtöffentlichen Sitzung einen einseitigen Lagebericht.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… Das ist alles, was wir über den Vorfall mit der Salmonton-Delegation erfahren haben.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers stattete New Opulentia einen weiteren Besuch ab, um einige „persönliche Besorgungen“ zu erledigen.", "Mariru")
	await novel_interface.show_dialog("Jetzt hat SID sie in die A-Level-Schutzliste aufgenommen.", "Mariru")
	await novel_interface.show_dialog("Dieses Mal übermittelte Salmonton dem Außenministerium jedoch alle Einzelheiten der Delegation und eine vollständige Liste der eingeschränkten Waren.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Sie haben sogar über alle Militäreinsätze berichtet, an denen ihre Sicherheitskräfte in der Vergangenheit beteiligt waren. Man kann in den Aufzeichnungen keinen einzigen Fehler finden …", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Es klingt also wie ein Haftungsausschluss, dass, wenn der Enkelin von Dr. Dekkers etwas Schlimmes passiert, alles unsere Schuld ist.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Humph! Dieser schlaue Fuchs ...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Als Gegenleistung für die Sicherheit dieser jungen Dame versprachen sie jedoch eine um 20 % bevorzugte Lieferung unseres Kaufvertrags für landwirtschaftliche Produkte.", "Eloise")
	await novel_interface.show_dialog("Laut aktuellem NBOT-Index gleicht es einem Giveaway.", "Eloise")
	await novel_interface.show_dialog("Ich habe eine Durchführungsverordnung unterzeichnet, um die Medien vorerst von ihrer Spur fernzuhalten.", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Benutzen sie den Senat als Teil ihrer Market-Making-Strategie?) \\n(Und sie wussten, dass ich mich da raushalten würde …)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Hmpf... alter schlauer Fuchs...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Das Mädchen ist für uns nützlich. Können wir ihr mehr Informationen entlocken?", "Bright")
	await novel_interface.show_dialog("Ehrlich gesagt waren wir sehr an ihrer Gen-Editing-Technologie und den Mega-Gewächshaussystemen interessiert.", "Bright")
	await novel_interface.show_dialog("Wenn sie ein paar Stunden in meinem Labor verbringen kann ...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dr. Bright…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Sie haben sich bereits einen großen Ruf für Ihre „einzigartigen“ moralischen Standards auf Substance H erworben, die sich auf den menschlichen Geist auswirken.", "Mariru")
	await novel_interface.show_dialog("Ich befürchte, dass Salmonton sofort Handelssanktionen gegen New Opulentia verhängen würde, sobald die junge Dame Ihr Labor betritt.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Mein Ruf? Wirklich? \\nHahaha…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ähm, das reicht!", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Apropos unbekannte bewaffnete Männer im Sky Hotel …", "Kirs")
	await novel_interface.show_dialog("Sie griffen die Salmonton-Delegation an und erbeuteten einige wertvolle Kunstwerke …", "Kirs")
	await novel_interface.show_dialog("Hat SID irgendwelche Hinweise?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Der alte Fuchs verheimlichte den goldenen Schmetterling vor dem Senat und schob die Schuld auf Jacob und seine Bande.)", "Mariru")
	await novel_interface.show_dialog("(Sie haben die Sicherheitskameras im Hotel deaktiviert, bevor sie Maßnahmen ergriffen haben.) \\n(Da besteht eine Informationslücke …)", "Mariru")
	await novel_interface.show_dialog("In der vereinbarten entmilitarisierten Zone sind uns die Hände gebunden. Verschiedenen Quellen zufolge gehen wir davon aus, dass sie Spezialwaffen eingesetzt haben.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Spezialwaffen ... meinst du Substance H-Waffen? \\nSie haben die Waffen innerhalb des Schutzfeldes von Aegis eingesetzt?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Den baumähnlichen Brandspuren auf dem Boden nach zu urteilen, gehen wir davon aus, dass sie Hochleistungsentladungsgeräte mit Serienresonanzkreisen verwendeten.", "Mariru")
	await novel_interface.show_dialog("Ein solch kompliziertes Gerät ist zu sperrig, als dass es ein einzelner Soldat tragen könnte, und es gibt praktisch keine Möglichkeit, es zu verkleinern.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Zeugenaussagen zufolge waren in dieser Nacht etwa zehn Männer mit derselben Waffe bewaffnet.", "Mariru")
	await novel_interface.show_dialog("Laut Aegis-Aufzeichnungen gingen in dieser Nacht etwa zehn unbekannte IDs gleichzeitig offline. Sie müssen sich von der Baustelle zurückgezogen haben.", "Mariru")
	await novel_interface.show_dialog("Da SID regelmäßige Ausreisen blockiert hatte, könnten sie auf diplomatischem Weg davongekommen sein.", "Mariru")
	await novel_interface.show_dialog("(Oder wegen ihres Versagens hingerichtet …)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Ich verstehe.", "Kirs")
	await novel_interface.show_dialog("Substance H Waffen können nicht in so großem Maßstab hergestellt werden.", "Kirs")
	await novel_interface.show_dialog("Doch bevor die Kameras abgeschaltet wurden, griffen zwei verdächtige Personen die Wachen am Korridor an.", "Kirs")
	await novel_interface.show_dialog("Eine von ihnen verkleidete sich als Dienstmädchen dieses Hotels und die andere trug die Uniform von Gosakuragawa. Hast du sie dorthin geschickt?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Auf dem Bildschirm ertönt ein hohes Quietschen.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Hahaha… Unser Vorstandsvorsitzender scheint sehr an Kätzchen interessiert zu sein… Ich auch.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Kätzchen?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Oh, ich habe es aus Ihrer Exzellenz Frau Mariru zitiert.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(So eine Nervensäge…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie und Ren, richtig? \\nEntzückende Namen…", "#C")
	await novel_interface.show_dialog("Vielleicht gibt es noch andere Katzen, die Mikakawa aufgezogen hat——", "#C")
	await novel_interface.show_dialog("Habe ich recht, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Hah, danke, dass du sie nicht an die Sicherheitsarmee verkauft hast. Ich schulde dir etwas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Es ist keine große Sache. \\nEs scheint, dass Sie sowieso nicht die Absicht haben, uns etwas zu verheimlichen.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Erlauben Sie mir also, Sie mit weiteren Einzelheiten zu besprechen.", "Mariru")
	await novel_interface.show_dialog("Der Satellit entdeckte mehrere Raumzeitflüsse im Sky Hotel, aber SID hatte dort kein Recht, Maßnahmen zu ergreifen.", "Mariru")
	await novel_interface.show_dialog("Also habe ich zwei verdeckte Ermittler dorthin geschickt.", "Mariru")
	await novel_interface.show_dialog("Während ihres Einsatzes stießen sie auf eine Gruppe bewaffneter Männer und einer von ihnen schoss mit der Spezialwaffe auf Annie.", "Mariru")
	await novel_interface.show_dialog("Jetzt ist der Agent nach Notfallbehandlungen endlich außer Gefahr und wir haben einige Statistiken über diese Waffe gesammelt.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Warum hast du es uns nicht früher gesagt?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Herr Vorstandsvorsitzender, ich frage mich, was genau die „Kunstwerke“ sind, die verschwunden sind?", "Mariru")
	await novel_interface.show_dialog("Vielleicht ist es an der Zeit, dass wir alle offener für den Austausch von Informationen werden.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Was denkst du?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Warum beginnen wir nicht mit der Katze, die Sie adoptiert haben?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Mist … Diese Information reichte nicht aus, um ihn abzulenken.)", "Mariru")
	await novel_interface.show_dialog("(Was für eine Nervensäge…) \\n(Nun, ich fürchte, es ist Zeit, diese gefälschten Dokumente zu testen. Zeit für Geschichten, Leute.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Sollen wir anfangen, meine Liebe?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Während des Siebenjährigen Krieges bemühten sich Wissenschaftler darum, neue Technologien zu entwickeln, die die Aktivierung der göttlichen Berührung durch den Menschen ermöglichen.", "Mariru")
	await novel_interface.show_dialog("Gerüchten zufolge wurden heimlich Experimente zur Modifikation des menschlichen Körpers an Kombattanten durchgeführt. Ich glaube, Sie haben solche Gerüchte gehört.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Ähm-hm.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru kichert, ihre Lippenwinkel wölben sich leicht nach oben.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Manche Menschen werden mit besonderen Fähigkeiten geboren, und die New Opulentia Academy of Sciences und das Brain Research Institute verfügen über Aufzeichnungen, die dies belegen.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Tatsächlich kann Dr. Bright als einer von ihnen angesehen werden.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Warten Sie, ich muss Sie daran erinnern, dass fast alle diese begabten Menschen weiblich sind.", "Bright")
	await novel_interface.show_dialog("Allerdings werden Menschen mit solchen besonderen Talenten meist nur auf die Beobachtungsliste gesetzt und es bedarf keiner besonderen Kontrolle.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Richtig. Aber unter all diesen begabten Menschen hat niemand eine vergleichbare Kraft wie die B-Klasse Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Da die Versuchsergebnisse hinter den Erwartungen zurückblieben, wurden diese Untersuchungen während der Kriegszeit abgebrochen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Diese Frauen mit Superkräften werden auch als „Hexen“ bezeichnet. Vor ein paar Jahrzehnten hätte niemand an die Existenz solcher Dinge auf der Welt geglaubt …", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Aber Ren ist anders – sie ist in der Lage, Flussgebiete zu durchqueren.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was?!!","Menschenmenge")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
