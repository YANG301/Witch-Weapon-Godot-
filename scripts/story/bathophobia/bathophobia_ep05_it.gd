# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("Cos'è l'Anima?")
	await novel_interface.show_text_only("Una forma di energia che preserva la coscienza? O uno stato quantistico non osservabile?")
	await novel_interface.show_text_only("O solo un concetto...")
	await novel_interface.show_text_only("Proprio come il concetto di tempo in fisica...")
	await novel_interface.show_text_only("Forse è solo un'illusione... un sogno.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Allora la domanda è...")
	await novel_interface.show_text_only("Chi è il sognatore?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("Il freddo pungente della Convergenza Antartica esclude tutti i rumori del mondo esterno.")
	await novel_interface.show_text_only("A 20.000 piedi sotto il livello del mare si trova la zona abissale.")
	await novel_interface.show_text_only("Avvolto in uno scafo a pressione in titanio, un sottomarino degli abissi sta scendendo lentamente.")
	await novel_interface.show_text_only("La debole luce emessa dal suo indicatore di stato viene rapidamente inghiottita dall'abissale oscurità.")
	await novel_interface.show_text_only("Senza luce non è in grado di percepire lo spazio.")
	await novel_interface.show_text_only("Un inquietante dente tenta di colpire lo scafo, ma non riceve risposta.")
	await novel_interface.show_text_only("La pressione dell'acqua di 60 MPa mette alla prova il limite di sollecitazione di compressione dello scafo.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("All'improvviso, otto proiettori preprogrammati vengono accesi simultaneamente, proiettando otto fasci di luce diritti e stretti.") #换行问题
	await novel_interface.show_text_only("Come spade affilate, i riflettori esplodono in un bagliore abbagliante e penetrano nell'oscurità.")
	await novel_interface.show_text_only("Un raggio di luce attraversa i vetri spessi della sala di controllo e cade sul volto di una ragazza addormentata.")
	await novel_interface.show_text_only("I suoi lunghi capelli grigio scuro, splendenti di lucentezza blu, si disperdono sul suo viso pallido ma puro.")
	await novel_interface.show_text_only("Il profondimetro sul cruscotto davanti alla ragazza smette di funzionare a 4091 piedi.")
	await novel_interface.show_text_only("I riflettori fuori dalla stanza si affievoliscono gradualmente. Ma un debole bagliore argentato inizia a tremolare attorno al corpo della ragazza.")
	await novel_interface.show_text_only("Dalle profondità dell'oceano tanto temuto dagli esseri umani, arriva una voce profonda e lontana.")
	await novel_interface.show_text_only("Come il richiamo di un antico mostro.")
	await novel_interface.show_text_only("La ragazza addormentata sembra risvegliarsi dal grembo di sua madre.")
	await novel_interface.show_text_only("Si risvegliano anche vertigini e nausea incontrollabili...")
	await novel_interface.show_text_only("Molto al di sotto della profondità di sicurezza di 15.000 piedi, lo scafo metallico inizia a emettere un rumore anomalo.")
	await novel_interface.show_text_only("Dalla gola della ragazza esce una tosse repressa.")
	await novel_interface.show_text_only("All'inizio ha qualche difficoltà a respirare, ma si adatta rapidamente alla pressione subacquea e stabilizza il respiro.")
	await novel_interface.show_dialog("La collisione proprio adesso... Sembra che mi abbia messo fuori combattimento.", "Ragazza")
	await novel_interface.show_dialog("Ma posso ancora respirare... Ci deve essere abbastanza ossigeno.", "Ragazza")
	await novel_interface.show_dialog("Riesco a vedere il mio respiro... \\nVicino a 32 °F, sicuramente...", "Ragazza")
	await novel_interface.show_dialog("Controllo del sistema. Pronti per un avvio a freddo. \\nInformazioni di identificazione: Beth.", "Ragazza")
	await novel_interface.show_text_only("La ragazza di nome Beth non sembra preoccuparsi della temperatura gelida. Controlla attentamente il sistema.")
	await novel_interface.show_text_only("È nata con la capacità di sopportare il freddo estremo. Quando la piccola Beth fu ritrovata sulle montagne invernali, aveva già trascorso un'intera notte sul ghiaccio.")
	await novel_interface.show_text_only("Numerosi esami fisici hanno dimostrato che la ragazza miracolosa può adattarsi a vari ambienti freddi.")
	await novel_interface.show_text_only("Sotto il freddo intenso che potrebbe far perdere conoscenza a un adulto entro 30 secondi, la sua temperatura corporea è ancora normale e le sue mani calde.")
	await novel_interface.show_text_only("I medici non sono riusciti a capirne il motivo prima che fosse portata via dall'orfanotrofio dal padre adottivo.")
	await novel_interface.show_dialog("Sistemi di illuminazione e propulsione... avvio normale. Riavvio sensori... tutto ok.", "Beth")
	await novel_interface.show_dialog("È già profondo 20.000 piedi? \"Quella cosa\" non può esistere sotto una pressione dell'acqua così elevata.", "Beth")
	await novel_interface.show_dialog("Devo risparmiare energia per il viaggio di ritorno... Proiettori spenti...", "Beth")
	await novel_interface.show_text_only("Proprio mentre i riflettori vengono spenti, Beth guarda fuori dalla finestra.")
	await novel_interface.show_dialog("Cosa…", "Beth")
	await novel_interface.show_text_only("Una scena inquietante le fa rizzare i capelli.")
	await novel_interface.show_dialog("Cos'è... quello...", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Subito prima che i riflettori si spengano, fuori dalla finestra di osservazione appare una gigantesca struttura simile a un corallo.")
	await novel_interface.show_text_only("È una struttura centripeta simile a un tessuto. Su di esso, i vasi irregolari sembrano una cascata scarlatta che cade in un enorme buco nero.")
	await novel_interface.show_text_only("Ma durante la scansione proprio ora non sono state trovate strutture biologiche o topografiche.")
	await novel_interface.show_text_only("Beth accende immediatamente l'obiettivo grandangolare sullo scafo, cercando di avere una visione più ampia...")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Sullo schermo c'è un'ombra enorme e nebbiosa. Si estende per più di 300 piedi e ha tentacoli.")
	await novel_interface.show_dialog("Questo non può essere...", "Beth")
	await novel_interface.show_text_only("Non fa parte del paesaggio, ma sicuramente è una specie di creatura. Punti di luce rossi brillano nell'oscurità.")
	await novel_interface.show_dialog("Quello è... un bulbo oculare?", "Beth")
	await novel_interface.show_text_only("—Se quella cosa strana può essere chiamata \"bulbo oculare\".")
	await novel_interface.show_text_only("Il buco nero rivolto verso la finestra è la pupilla del bulbo oculare.")
	await novel_interface.show_text_only("E' troppo vicino per determinare la distanza. Sembra probabile che lo scafo venga risucchiato nella pupilla da un momento all'altro.")
	await novel_interface.show_text_only("Le macchie rosse svaniscono. La ragazza ora affronta l'oggetto sconosciuto nell'oscurità silenziosa.")
	await novel_interface.show_text_only("Quando i suoi occhi si adattano all'oscurità, vede sullo schermo l'enorme bulbo oculare che emette una debole luce rossa, come se fosse una medusa opaca.")
	await novel_interface.show_text_only("Il bulbo oculare è pieno di grumi di tessuti che si contorcono. \\nBatte insieme al suo cuore.")
	await novel_interface.show_dialog("(Calmati... rilassati!) \\n(Pensaci...)", "Beth")
	await novel_interface.show_text_only("Se quello è un bulbo oculare, il suo cristallino dovrebbe essere sensibile alla luce.")
	await novel_interface.show_text_only("Sullo strato esterno del bulbo oculare, dove dovrebbe esistere la coroide, tremolano sciami di macchie bianche.")
	await novel_interface.show_text_only("Beth nota che tentacoli simili a rami sono attaccati alla parte posteriore del bulbo oculare.")
	await novel_interface.show_text_only("I tentacoli grigio scuro sono immersi nelle profondità dell'oceano, senza alcuna fine in vista.")
	await novel_interface.show_dialog("(…non posso…muovermi…)", "Beth")
	await novel_interface.show_text_only("—Beth è più come essere osservata, invece che affrontare Quella Cosa.")
	await novel_interface.show_text_only("Lo sguardo invadente mina la sua calma e la spaventa.")
	await novel_interface.show_dialog("Aiuto…", "Beth")
	await novel_interface.show_text_only("—Inghiottirà tutto?")
	await novel_interface.show_text_only("La strana sensazione di trovarsi nelle profondità dell'oceano le fa dubitare della sua stessa esistenza.")
	await novel_interface.show_dialog("(È un sogno...?) \\n(Svegliati, presto...)", "Beth")
	await novel_interface.show_text_only("Il suo corpo reagisce d'istinto prima ancora che la coscienza la raggiunga.")
	await novel_interface.show_text_only("Mentre la ragazza tirava il joystick con la mano sinistra, la camera di immersione continuava a spostarsi di una certa distanza verso il bulbo oculare.")
	await novel_interface.show_text_only("L'acqua diventa agitata come se Quella Cosa fosse disturbata.")
	await novel_interface.show_text_only("La pupilla si contrae, in attesa della prossima mossa della ragazza.")
	await novel_interface.show_dialog("Ciao? Ciao?", "Beth")
	await novel_interface.show_text_only("Beth prende le cuffie e prova a connettersi con la postazione di controllo.")
	await novel_interface.show_text_only("Ma nessuna onda elettromagnetica può sfuggire a questa profondità e per il momento la comunicazione acustica subacquea non è possibile.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Se fosse stata lì... mi avrebbe gridato: \\n\"Smettila di avvicinarti!\"")
	await novel_interface.show_dialog("Ah... perché dovrei pensare a questo...", "Beth")
	await novel_interface.show_dialog("Chi è... \"Lei\"?", "Beth")
	await novel_interface.show_dialog("Dove… sono…", "Beth")
	await novel_interface.show_text_only("Fissata dal gigantesco bulbo oculare, Beth è persa in uno stato di stordimento. Il confine tra realtà e illusione sta lentamente sfumando.")
	await novel_interface.show_text_only("Fa scorrere la mano su tutto il cruscotto.")
	await novel_interface.show_text_only("Presto individua il controller del braccio robotico.")
	await novel_interface.show_dialog("(Devo davvero...)", "Beth")
	await novel_interface.show_text_only("Raccoglie il respiro, ma la luce illusoria continua a lampeggiare davanti ai suoi occhi.")
	await novel_interface.show_dialog("Preleva dei campioni… E poi ritira subito…", "Beth")
	await novel_interface.show_text_only("Innanzitutto, punta i riflettori in avanti...")
	await novel_interface.show_text_only("Quindi, imposta il sistema di propulsione... velocità massima. Direzione... inversa.")
	await novel_interface.show_text_only("Lottando per completare la preconfigurazione, la ragazza è quasi sul punto di perdere conoscenza.")
	await novel_interface.show_dialog("Padre, è questo... inquinamento spirituale... \\nSono quasi...", "Beth")
	await novel_interface.show_text_only("Beth aziona lentamente il manipolatore per rilasciare il braccio del robot. Viene rivelato un enorme ago.")
	await novel_interface.show_dialog("Modalità di aspirazione attiva... Con tale pressione, sarà sufficiente una rapida aspirazione...", "Beth")
	await novel_interface.show_text_only("Il braccio del robot si allunga in avanti finché l'ago non viene inserito nel vitreo.")
	await novel_interface.show_text_only("Il livello di concentrazione del contenitore passa dallo 0 al 100% in un istante.") #标点删除
	await novel_interface.show_text_only("Per un momento la pupilla è distorta. Se il suono fosse riuscito a penetrare nello scafo, avrebbe dovuto sentire un grido aspro...")
	await novel_interface.show_dialog("(Sto sentendo cose...)", "Beth")
	await novel_interface.show_text_only("Con il suo ultimo sforzo la ragazza preme il pulsante dell'esecuzione programmata.")
	await novel_interface.show_text_only("Secondo il programma preimpostato, i proiettori proiettano otto intensi fasci di luce nella pupilla e l'elica inizia a ruotare all'impazzata.")
	await novel_interface.show_text_only("Il bulbo oculare si allontana sotto la stimolazione della luce, e lo scafo comincia a tirarsi indietro e a sollevarsi...")
	await novel_interface.show_text_only("Completamente esausta, la ragazza perde i sensi e cade a terra.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
