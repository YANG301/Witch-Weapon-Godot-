# bathophobia_ep20.gd - 深海恐惧症篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep20_script()

func play_script():
	pass

func bathophobia_ep20_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("The squad continues to dodge the attacks from the frenzied, unidentifiable enemies and send one distress call after another.")
	await novel_interface.show_text_only("More enemies are pouring in from the base entrance. The squad congratulates themselves for not retreating outside into the raging blizzard.")
	await novel_interface.show_text_only("They certainly can’t deal with these extraordinarily nimble enemies outside in the snow, without obstacles to hide behind.")
	await novel_interface.show_text_only("However, this also leaves them with no choice but to move deeper into the base, seeking a strategically advantageous position for them to call for support.")
	await novel_interface.show_text_only("They’re forced further and further inside, out of the exhibition room, into a corridor.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_dialog("Shucks. There’s no signal here.","Squad Member C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("You guys, head to the comms room first. You might find some workable transmission devices there.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Got it!","Squad Member C")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("I checked the 3D layout map of this place. Our best course of action right now is to head...\\n... downward, eight-o-clock direction.","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All squad members are wounded in different degrees of seriousness. But they still continue on, providing each other cover in the form of two groups, one leading and one taking up the rear.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("(These guys... they heal so rapidly. It just doesn’t seem right...)","Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","shock",0.25)
	await novel_interface.show_dialog("Watch out!","Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Beth zones out for just a split second, an that’s when the enemies pursuing them from behind suddenly twist their joints, enormous blades come slicing through the air in a bizarre angle.")
	await novel_interface.show_text_only("Caught by surprise, Milk shoves Beth into the archive room behind her.")
	await novel_interface.show_text_only("They successfully evade the swinging blade, though it still leaves a gigantic crack on the tiles on the ground.")
	await novel_interface.show_text_only("The crack isn’t too wide, but still wide enough to separate the two groups. Might as well be a bottomless canyon.")
	await novel_interface.show_dialog("Ahh!","Squad Member D")
	await novel_interface.show_text_only("A squad member, codename Mute, happens to be standing the closest to the enemy swinging the huge blade. Desperate to shield her members, she moves forward, letting the blade pierce her body again and again.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("... Mute!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mute, who is always so happy-go-lucky, who loves Hawaiian shirts. Every time Milk starts one of her betting pools, Mute is that idiot who ends up losing money.")
	await novel_interface.show_text_only("It’s been a long time since Milk remembers last calling Mute by her codename. She never expected it to be in such a situation.")
	await novel_interface.show_text_only("Her freshly-spilt blood paints the corridor walls red.")
	await novel_interface.show_text_only("Mute’s modified MP5K falls to the ground, skids a bit, finally stopping beside Milk’s feet.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Darn it!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk’s modified submachine gun has reduced recoil, enabling her to hold it and fire a whole hail of bullets with just one hand.")
	await novel_interface.show_text_only("She pulls out a dagger, pinning her target, whose body is ridden with bullet holes and covered with gross green liquid, on the wall by the neck.")
	await novel_interface.show_text_only("As other squad members jump in with their riot shields to ward off the enemies, Milk redirects her attention to her fallen teammate, pressing down on the wound decorating her neck.")
	await novel_interface.show_text_only("The temperature here is so low that the blood gushing from Mute’s aorta is fizzling like boiling water.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Where’s the first aid kit? Get the blood stopper spray!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Haah... hah...","Squad Member D")
	await novel_interface.show_text_only("Deep down inside, they know she’s likely beyond saving. But they still try.")
	await novel_interface.show_text_only("The hemostatic spray mixed with blood, quickly turning the hemostatic cotton at the wound red, and sliding down to the ground along Milk's hand.")
	await novel_interface.show_text_only("Meanwhile, more and more enemies are congregating outside in the corridor, attracted by the commotion.")
	await novel_interface.show_text_only("The riot shields holding them back have been slammed into for so many times that they’re already cracking.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Ugh...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Three squad members circle over to help, opening fire to provide cover while Milk attempts to drag her fallen teammate into the archive room at the corner up ahead.")
	await novel_interface.show_text_only("As they go, they leave a long trail of blood on the cold, glossy corridor floor.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Dark.png")
	await novel_interface.show_text_only("After finally getting Mute into the room, Milk checks her pulse with her fingers.") #换行问题
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("We need some adrenaline here!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth hurries over, ripping open Mute’s blood-soaked shirt, estimates the best position on the left side of her chest and, in a swift movement, stabs in the adrenaline pen.")
	await novel_interface.show_text_only("The timely shot brings relief and a hint of color back to Mute’s face—but only for a few seconds.")
	await novel_interface.show_dialog("*coughing*\\n*gasping*","Squad Member D")
	await novel_interface.show_text_only("However, after a few seconds, the blood loss rate has far exceeded the limit that the body can bear.")
	await novel_interface.show_text_only("The color leaves Mute’s face once again. Her pupils dilate.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("…","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tears well up in Milk’s eyes.")
	await novel_interface.show_text_only("Beth lays one hand over Milk’s, which is still firmly pressed over her teammate’s wound. They exchange a silent glance that says many words.")
	await novel_interface.show_dialog("We can’t hold them off any longer! We gotta retreat!","Squad Member C")
	novel_interface.show_character("baizhu_break","speechless")
	await novel_interface.show_dialog("Milk!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk grits her teeth and picks up the specimen box Mute had risked her life to retrieve in the archive room.")
	await novel_interface.show_text_only("The squad is already outnumbered as it is. With one down, the rest are in even bigger trouble.")
	await novel_interface.show_text_only("No one wants to admit it, but that’s the reality they’re facing now.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("We’ll take that passage over there. Retreat!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I’ll take up the rear.","Squad Member B")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BTB.png")
	await novel_interface.show_text_only("The girls stand back-to-back, eyes alert.")
	await novel_interface.show_text_only("Milk grips her gun tight, trying her best to keep the rest of her squad covered.")
	await novel_interface.show_dialog("(How... did this happen...?)","Beth")
	await novel_interface.show_text_only("According to Beth’s investigations, “Ningen” had sent nothing but an ordinary scouting team to Antarctica.")
	await novel_interface.show_text_only("However, the enemies they see... that’s no ordinary scouting team.")
	await novel_interface.show_dialog("(Was it my fault for not anticipating this?)","Beth")
	await novel_interface.show_dialog("(But I did anticipate this. Didn’t I?)","Beth")
	await novel_interface.show_dialog("(I knew all along...)\\n(I knew all along that I’m just using them, and it’s dangerous...)","Beth")
	await novel_interface.show_dialog("(Yet I still let this happen...)","Beth")
	await novel_interface.show_text_only("Noticing Beth’s hesitation, Milk puts her own back against hers.")
	await novel_interface.show_text_only("Milk is bundled up in thick layers, so it’s not like they can feel each other’s body heat. Yet, somehow, Beth still feel comforted.")
	await novel_interface.show_dialog("It’s gonna be okay.","Milk")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_dialog("I’m right here.","Milk")
	await novel_interface.show_text_only("... “It’s gonna be okay. I’m right here.”")
	await novel_interface.show_text_only("When Beth snaps back to reality, her gaze falls on the rest of her squad members.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("The ones carrying the riot shields barely spare her a second glance as the enemies continue to surge in. They gesture at her briefly: go, go.")
	await novel_interface.show_text_only("Do these valiant warriors even know what exactly they’re dealing with?")
	await novel_interface.show_text_only("Do they even know what the ones giving them orders are doing...?")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_dialog("I’m sorry. It was my fault... I misjudged the situation...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("This isn’t the time to apologize.","Squad Member B")
	await novel_interface.show_text_only("The other party gave Bai Zhu a wink that he understood.")
	await novel_interface.show_dialog("You’d better treat me to ten years’ worth of tequila once we get outta this hell hole.","Squad Member C")
	await novel_interface.show_text_only("Beth can hardly believe that her teammates are still trying to comfort her even in such a situation.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("—Look out!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk forces down Beth’s left shoulder, blocking an incoming sickle with an already ammo-less submachine gun.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("These guys are impossible!","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The enemies, like a horde of leopards just set free, easily traverse the buffer zone cleared out by the riot-shield holders.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("It’s because they’re Ningen... you know, that means “human” in Japanese.","Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Nin... gen... heeheehee...\\nDie! Die! Die!","???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s as if the word Ningen amuses them. The leader of the enemies grins ear-to-ear in a face-splitting smile.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("They’re crazy...\\nNo way we can defeat these monsters...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Beth, take the others and go! We’ll hold them off!","Squad Leader")
	await novel_interface.show_text_only("Before the shield-holding squad member can even finish her sentence, her shield is sent flying by a scythe-holding enemy. Having lost their cover, the squad members immediately open fire, while dodging the attacks to the best of their ability.")
	await novel_interface.show_text_only("Suddenly, out of nowhere—")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BaizhuBattle.png")
	await novel_interface.show_text_only("Suddenly, a strange-shaped sword blade firmly blocked the sickle that was attacking Milk.")
	await novel_interface.show_text_only("Beth conjures up dozens of silver blobs of light, which zoom towards the enemies, leaving white spots resembling frostbite over their bodies.")
	await novel_interface.show_text_only("The green slime that pours from the enemies’ bodies can repair their wounds—but they have no effect on these white splotches. Once hit by shrapnel, their bodies shatter into pieces.")
	await novel_interface.show_text_only("Beth then blinks into sight next to Milk. She flips into the air, firing dozens of bullets at the surrounding enemies in an instant.")
	await novel_interface.show_dialog("Uh... Bethy...?","Milk")
	await novel_interface.show_text_only("Milky's eyes, which were stunned, reflected the strange white light group that was beating on his friend's weapon.")
	await novel_interface.show_text_only("Faster than her bullets can even travel, Beth swings the greatsword in her left hand. Intricate, spiraling patterns appear on its surface.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("That’s when the continent begins shaking once more.")
	await novel_interface.show_text_only("Yet the squad members, too busy fighting, barely notice...")
	
	print("=== 深海恐惧症篇第20话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
