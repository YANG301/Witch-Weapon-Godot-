# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("—Cuidado!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette me empurra para o lado no segundo em que a porta da sala de controle se abre.")
	await novel_interface.show_text_only("Bem a tempo, também, para a próxima coisa que sei, incontáveis ​​arcos elétricos estão atingindo implacavelmente o peito da garota loira, acompanhados por rajadas fortes e ensurdecedoras. A luz é ofuscante – mal consigo manter os olhos abertos.")
	await novel_interface.show_text_only("E em alguns segundos, tudo acaba. Tudo está quieto mais uma vez. Meu cabelo está em pé – uma enorme quantidade de estática deve ter se acumulado ali. O ar cheira a cloro.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Uau... \\nHenriette, você está bem?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("É uma armadilha, eu acho. Algum tipo de arma defensiva.\\nMuito impressionante, provavelmente contém tanta energia quanto um pequeno radar.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette fica de pé, estudando pensativamente as luzes do teto da sala de controle. Em sua mão está um cristal azul claro translúcido.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Afinal, o que foi isso?\\nE o que é isso na sua mão?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("É uma turmalina. Quer tentar, Mestre?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A alquimista me lança um sorriso enigmático, estende a mão direita e coloca o cristal suavemente na parte de trás da minha orelha.")
	await novel_interface.show_text_only("Uma corrente repentina, quente e difusa percorre meu corpo, fazendo todos os meus cabelos se arrepiarem.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ah!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não posso deixar de soltar um gemido delicado.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Ah? O corpo do mestre é muito sensível~","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Você está gemendo? Aqui? Realmente?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me encara como se eu fosse um lixo.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Ei, não foi como se eu tivesse feito isso de propósito...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Murmuro, abaixando a cabeça e corando furiosamente.")
	await novel_interface.show_text_only("Pelo menos a estática acumulada na minha cabeça desapareceu. Meu cabelo está bonito e macio agora.")
	await novel_interface.show_text_only("Eu deveria pedir a Henriette um daqueles cristais quando voltarmos... \\nEla não vai se importar, certo?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Sigo timidamente o alquimista até a sala de controle.")
	await novel_interface.show_text_only("O lugar parece destruído. A maioria das telas e equipamentos foram danificados em vários graus. O teto e as paredes também estão desmoronando.")
	await novel_interface.show_text_only("Marcas pretas de queimadura deixadas por choques de alta tensão se espalham do painel de controle principal para ambos os lados. Os circuitos expostos ainda estão cheios de faíscas.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("O raio esférico tem mais de quinze pés... \\nAlguém deve ter usado uma arma de descarga de alta tensão aqui...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se eles estivessem usando o sistema de segurança genuíno padrão, significa que esta marca aqui...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Alguém deve ter religado grosseiramente o equipamento de defesa ofensiva do sistema e forçado a instalação de uma bateria química secundária usando o sistema de alta tensão da intranet da base...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho para a concha, quase irreconhecível após a explosão, e finalmente entendo por que o ar cheira a cloro.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Uma explosão elétrica...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando uma corrente poderosa passa através de uma folha metálica, o aumento do calor faz com que uma enorme quantidade de energia se reúna, o que leva a violentas explosões e flashes.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Então, quem fez isso usou as camadas de folha metálica dobrada a seu favor. De fato, uma engenhoca muito eficaz e mortal.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mas... para que isso funcione, alguém tem que colocar o fio de metal guiando a corrente na fresta embaixo da porta, que é a única saída deste lugar...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Então, quem fez isso explodiria ao lado dos inimigos no segundo em que a porta da sala fosse aberta.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O hardware principal deste sistema de segurança parece estar protegido por barreiras eletromagnéticas. Percebo que o painel de controle principal ainda pode ser ativado. Apenas alguns botões estão danificados.")
	await novel_interface.show_text_only("Entramos no sistema de segurança e descobrimos que ele foi hackeado. Pode ter algo a ver com o relógio militar conectado ao painel de controle principal.")
	await novel_interface.show_text_only("O armazenamento flash no relógio ainda está acessível. É fácil identificar a identidade de seu proprietário pelo conteúdo.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Parece ser alguém realmente durão.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algumas telas da estação de vigilância ainda estão funcionando, reproduzindo obedientemente imagens em tempo real capturadas pelas câmeras de vigilância.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Espero que possamos encontrar algumas informações úteis aqui.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Respiro fundo e acesso os registros históricos.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hum…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como esperado de um estabelecimento ultrassecreto, há registros demais para serem contados. Alguns dos vídeos anteriores são armazenados em arquivos VCR.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Encontrar algo útil em toda essa bagunça levará anos!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Pare de choramingar. Deveria haver uma maneira fácil de executar uma pesquisa, caso contrário o designer da UI já teria sido demitido.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bem, existe de fato um modo que nos permite visualizar com eficiência todas as gravações de uma só vez, mas...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Existem centenas de câmeras de vigilância na base, e o sistema vem coletando dados desde que a base foi construída. Apenas uma única tela de vinte polegadas à minha frente ainda funciona. Exibir tudo de uma vez... é impossível.")
	await novel_interface.show_text_only("Em desespero, continuo diminuindo o zoom, até que as miniaturas da filmagem sejam reduzidas a meros pixels.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ei! Veja isso!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael me dá um tapa na cabeça e aponta para uma linha reta e vertical branca na tela.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Todas as filmagens capturadas neste momento... são todas... brancas?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Eu pulo para o momento ao qual Raphael está se referindo e chamo o primeiro quadro após a parte com toda a brancura que contém algum conteúdo.")
	await novel_interface.show_text_only("Aparecendo um homem alto e largo.")
	await novel_interface.show_text_only("Ele está vestido com um traje anti-perigo cor cobalto e parece ter mais de um metro e oitenta de altura. Ele avança em um ritmo constante e rápido.")
	await novel_interface.show_text_only("Ele não parece se importar em ser filmado – mas a resolução é muito baixa para que possamos ver claramente seu rosto.")
	await novel_interface.show_dialog("Há algo sobre ele...","Lian")
	await novel_interface.show_dialog("Você o conhece, Mestre?","Henriette")
	await novel_interface.show_dialog("Não __ELIPSIS__","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("O homem examina o local enquanto avança, como se procurasse alguma coisa.")
	await novel_interface.show_text_only("Seus passos aceleram enquanto ele sai da sala de arquivo para a enfermaria.")
	await novel_interface.show_text_only("Ao passar por dois cadáveres de soldados empacotados, ele para de repente e se abaixa para estudá-los.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Aquele soldado... está sentindo falta de um bezerro?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e eu prendemos a respiração, horrorizadas com o ferimento na perna do soldado e o sangue escuro nas bordas.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Então aconteceu uma briga aqui, hein...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não consigo deixar de lembrar da gigantesca rachadura no chão da sala de arquivo.")
	await novel_interface.show_text_only("Com o rosto impassível, o homem entra na enfermaria e pega um cartão preto do armário de remédios. Do nada, ele carrega sua arma.")
	await novel_interface.show_text_only("Do canto da enfermaria, uma sombra escura ataca. O homem atira várias vezes sem perder o ritmo, fazendo-o voar para fora do enquadramento.")
	await novel_interface.show_text_only("Ele então puxa uma adaga e desaparece do quadro também. Ele reaparece em alguns segundos e joga um monte de itens indistinguíveis no lixo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Isso é... é isso...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De jeito nenhum. Não pode ser.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Seguindo um protocolo claro, entendo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... Não importa. Continue assistindo.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O homem fecha calmamente a porta da enfermaria e depois passa o cartão para abrir um portão de metal. Ele parece muito familiarizado com o layout da base.")
	await novel_interface.show_text_only("Depois de verificar se está vazio (está), o homem marcha para o túnel fora da sala de controle.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("O que é isso... ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os gráficos na tela são meio granulados, mas ainda é fácil dizer que o túnel na filmagem foi definitivamente o local de um banho de sangue.")
	await novel_interface.show_text_only("Dezenas de cadáveres jazem aleatoriamente em uma formação radial, como se uma poderosa explosão os tivesse destruído todos de uma vez.")
	await novel_interface.show_text_only("E no centro de tudo isso está ajoelhada uma garota vestida de branco, com a parte superior do corpo ereta, perfurada por uma arma de cabo longo.")
	await novel_interface.show_text_only("Ela está usando poucas camadas, considerando que está na Antártica. Sua pele leitosa está tingida de vermelho sangrento.")
	await novel_interface.show_text_only("Ela tem uma arma em cada mão, segurando-as com força, apesar de ter perdido a consciência.")
	await novel_interface.show_text_only("O homem se ajoelha diante dela e acaricia seu rosto com uma das mãos.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Eles se conhecem?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ele então circula até as costas dela, agarra o punho e lentamente puxa a arma, revelando uma ponta de lança forrada de ouro.")
	await novel_interface.show_text_only("O corpo da garota não se moveu e não saiu mais sangue do ferimento. Houve uma sensação indescritível de desobediência em todo o processo.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Sussurros) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O homem tirou o casaco, retirou com cuidado a cabeça da arma, embrulhou-a em um pano e colocou-a dentro do paletó, jogando o cabo longo para o lado.")
	await novel_interface.show_text_only("Ele então entra na sala de controle. Tentamos verificar o que ele está fazendo trocando de câmera, mas a tela que mostra a sala de controle mostra apenas estática.")
	await novel_interface.show_text_only("Olhamos para cima e vemos que a câmera da sala já foi completamente destruída por um choque elétrico.")
	await novel_interface.show_text_only("Depois de um momento, o homem reaparece no corredor, carregando uma mala de liga leve com cerca de 50 centímetros de largura.")
	await novel_interface.show_text_only("A fechadura da mala parece estar quebrada. Ele abre a caixa e tira três recipientes de vidro.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... O que exatamente ele está fazendo?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um dos recipientes de vidro está quebrado. O homem olha para ele, hesita um pouco e depois coloca os dois intactos no bolso.")
	await novel_interface.show_text_only("Gentilmente, ele tenta recuperar as armas dos punhos cerrados da garota. É quando um caderno cai de algum lugar de sua camisa.")
	await novel_interface.show_text_only("O homem o pega, folheia e depois coloca de volta na roupa da garota.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Como se estivesse carregando um bebê, ele pega cuidadosamente a garota esbelta e frágil em seus braços. Seus movimentos são amorosos e ternos.")
	await novel_interface.show_text_only("Ele a carrega como uma noiva até o fim do túnel, onde bate o cartão preto na parede.")
	await novel_interface.show_text_only("A parede desliza para o lado e os dois, juntos, desaparecem na escuridão...")
	await novel_interface.show_text_only("... É aí que terminam as gravações.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Há um longo período de branco em todas as gravações de vídeo posteriores. E o homem nunca reaparece no resto da filmagem.")
	await novel_interface.show_text_only("Na verdade, não há nada que valha a pena ver nas filmagens a seguir. Nada, até que nós três apareçamos na entrada da base.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Isso é estranho...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Espere, olhe.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael aponta para a tela que mostra a enfermaria.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Não havia um cadáver ali?... se foi.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Na verdade, todos os cadáveres desapareceram...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Isso significa que durante os períodos em branco nas filmagens, os locais de batalha foram completamente arrumados.")
	await novel_interface.show_text_only("Começamos a verificar novamente, examinando os registros anteriores.")
	await novel_interface.show_text_only("Conseguimos encontrar imagens registrando o que aconteceu com a garota e seu esquadrão.")
	await novel_interface.show_text_only("O último quadro que vemos, capturado pela câmera da sala de controle, é uma senhora com um traje de neve, forçando a garota de cabelos pretos a sair pela porta com uma arma.")
	await novel_interface.show_text_only("É aí que a gravação termina.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... Então foi isso que aconteceu aqui...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saio da interface de dados e acesso as imagens de vigilância em tempo real.")
	await novel_interface.show_text_only("Temos cobertura da entrada principal, da sala de exposição, dos corredores, do arquivo, dos túneis... e de alguns outros locais que não visitamos.")
	await novel_interface.show_text_only("Enquanto examino a tela que mostra imagens em tempo real, de repente me ocorre que a batalha que tivemos fora da sala de arquivo não foi gravada. De forma alguma.")
	await novel_interface.show_text_only("Segundo o vídeo, nós três entramos na sala de arquivo pelo corredor e nunca mais saímos. Em vez disso, chegamos ao túnel por uma abertura do outro lado.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Então essa luta aconteceu em um “sonho”? Que estranho...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("E quem limpou o lugar?","Raphael")
	await novel_interface.show_dialog("... Alguém deve ter mexido na filmagem também.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Não conseguimos nem encontrar imagens do homem alto saindo do local.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Examino mecanicamente as telas de vigilância em tempo real, enquanto nós três debatemos as identidades da garota e do homem que acabamos de ver.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Espere...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É razoável pensarmos que alguém pode ter mexido nas gravações e que estávamos num “sonho”.")
	await novel_interface.show_text_only("O que não é razoável é—")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Por que podemos ver as imagens em tempo real da sala de arquivo?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e Henriette congelam instantaneamente.")
	await novel_interface.show_text_only("A sala fica estranhamente silenciosa por alguns segundos.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Nós não...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... retire o cabo antes de sair da sala?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Qual é aquela pergunta importante de novo…")
	await novel_interface.show_text_only("—Como vim parar aqui?")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Minha bexiga está exigindo atenção novamente. Droga.")
	
	print("=== 潜渊症篇第25话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
