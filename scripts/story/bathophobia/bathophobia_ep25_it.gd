# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("—Attento!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette mi spinge da parte non appena la porta della sala di controllo si apre cigolando.")
	await novel_interface.show_text_only("Giusto in tempo, e subito dopo, innumerevoli archi elettrici lampeggianti si abbattono spietatamente sul petto della ragazza bionda, accompagnati da esplosioni aspre e assordanti. La luce è accecante, riesco a malapena a tenere gli occhi aperti.")
	await novel_interface.show_text_only("E in pochi secondi è tutto finito. Tutto è di nuovo tranquillo. Mi si sono rizzati i capelli: lì deve essersi accumulata un'enorme quantità di elettricità statica. L'aria puzza di cloro.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Wow... \\nHenriette, tutto bene?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("È una trappola, penso. Una specie di arma difensiva.\\nAbbastanza impressionante, probabilmente contiene la stessa energia di un piccolo radar.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette è in piedi, studiando pensierosa le luci sul soffitto della sala di controllo. Nella sua mano c'è un cristallo azzurro traslucido.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Comunque, cos'era quello?\\nE quello che hai in mano?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("È una tormalina. Vuoi provare, Maestro?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'alchimista mi rivolge un sorriso criptico, allunga la mano destra e posiziona delicatamente il cristallo dietro il mio orecchio.")
	await novel_interface.show_text_only("Un'improvvisa corrente calda e indistinta attraversa il mio corpo, facendomi rizzare tutti i peli.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ah!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non posso fare a meno di emettere un lieve gemito.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("La? Il corpo del maestro è molto sensibile~","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Stai gemendo? Qui? Veramente?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mi lancia un'occhiataccia come se fossi spazzatura.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Ehi, non è che l'abbia fatto apposta...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mormoro, abbassando la testa e arrossendo furiosamente.")
	await novel_interface.show_text_only("Almeno l'elettricità statica accumulata sulla mia testa è scomparsa. I miei capelli sono belli e lisci adesso.")
	await novel_interface.show_text_only("Dovrei chiedere a Henriette uno di quei cristalli quando torniamo... \\nNon le dispiacerà, vero?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Seguo timidamente l'alchimista nella sala di controllo.")
	await novel_interface.show_text_only("Il posto sembra distrutto. La maggior parte degli schermi e delle apparecchiature sono stati danneggiati a vari livelli. Anche il soffitto e le pareti si stanno sgretolando.")
	await novel_interface.show_text_only("Segni neri di bruciatura lasciati da scariche ad alta tensione si sono diffusi dal pannello di controllo principale su entrambi i lati. I circuiti esposti sono ancora pieni di scintille.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Il raggio sferico è di oltre quindici piedi... \\nQualcuno deve aver usato un'arma a scarica ad alto voltaggio qui...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se stavano usando il sistema di sicurezza originale standard, significa che questo segno qui...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Qualcuno deve aver ricablato grossolanamente l'equipaggiamento di difesa offensiva del sistema e inserito una batteria chimica secondaria utilizzando il sistema ad alta tensione dell'intranet della base...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fisso la granata, appena riconoscibile dopo l'esplosione, e finalmente capisco perché l'aria puzza di cloro.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Un'esplosione elettrica...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando una corrente potente passa attraverso una lamina metallica, l'aumento del calore provoca l'aggregazione di un'enorme quantità di energia, che porta a violente esplosioni e lampi.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Quindi chiunque abbia fatto questo ha sfruttato gli strati di lamina metallica piegata a proprio vantaggio. Un aggeggio molto efficace e mortale davvero.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ma... affinché funzioni, qualcuno deve posizionare il filo metallico che guida la corrente nella fessura sotto la porta, che è l'unica uscita di questo posto...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Quindi, chiunque lo abbia fatto, esploderebbe insieme ai nemici nel momento in cui la porta della stanza verrà aperta.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'hardware chiave di questo sistema di sicurezza sembra essere protetto da barriere elettromagnetiche. Noto che è ancora possibile attivare il pannello di controllo principale. Solo pochi pulsanti sono danneggiati.")
	await novel_interface.show_text_only("Entriamo nel sistema di sicurezza per scoprire che è stato violato. Potrebbe avere qualcosa a che fare con l'orologio militare collegato al pannello di controllo principale.")
	await novel_interface.show_text_only("La memoria flash dell'orologio è ancora accessibile. È facile individuare l'identità del proprietario dal contenuto.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sembra essere qualcuno davvero tosto.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alcuni schermi della stazione di sorveglianza sono ancora funzionanti e riproducono diligentemente filmati in tempo reale catturati dalle telecamere di sorveglianza.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Speriamo di poter trovare qualche informazione utile qui.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faccio un respiro profondo e richiamo i registri della storia.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hmm…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Come ci si aspetta da un'istituzione top secret, ci sono troppi documenti da contare. Alcuni dei video precedenti sono addirittura archiviati in file VCR.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Ci vorranno anni per trovare qualcosa di utile in tutto questo caos!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Smettila di lamentarti. Dovrebbe esserci un modo semplice per eseguire una ricerca, altrimenti il ​​progettista dell'interfaccia utente sarebbe già stato licenziato.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bene, esiste effettivamente una modalità che ci consente di visualizzare in anteprima in modo efficiente tutte le registrazioni contemporaneamente, ma...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ci sono centinaia di telecamere di sorveglianza nella base e il sistema raccoglie dati da quando la base è stata costruita. Davanti a me funziona ancora solo un unico schermo da venti pollici. Visualizzare tutto su di esso in una volta... è impossibile.")
	await novel_interface.show_text_only("Disperato, continuo a zoomare indietro, finché le miniature del filmato non vengono tutte ridotte a semplici pixel.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Ehi! Guardalo!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael mi dà un colpo in testa e indica una linea bianca verticale sullo schermo.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tutti i filmati catturati in questo momento... sono tutti... bianchi?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Salto al punto temporale a cui si riferisce Raphael e richiamo il primo fotogramma dopo la parte con tutto il candore che contiene qualche contenuto.")
	await novel_interface.show_text_only("In vista c'è un uomo alto e largo.")
	await novel_interface.show_text_only("Indossa una tuta ignifuga color cobalto e sembra essere alto più di un metro e ottanta. Avanza con un ritmo costante e veloce.")
	await novel_interface.show_text_only("Non sembra che gli dispiaccia essere filmato, ma la risoluzione è troppo bassa per permetterci di vedere chiaramente il suo volto.")
	await novel_interface.show_dialog("C'è qualcosa in lui...","Lian")
	await novel_interface.show_dialog("Lo conosci, maestro?","Henriette")
	await novel_interface.show_dialog("No...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("L'uomo osserva il luogo mentre cammina in avanti, come se cercasse qualcosa.")
	await novel_interface.show_text_only("I suoi passi accelerano mentre si dirige dall'archivio all'infermeria.")
	await novel_interface.show_text_only("Mentre passa accanto a due cadaveri di soldati infagottati, si ferma improvvisamente e si china per studiarli.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Quel soldato... le manca un vitello?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e io tratteniamo il fiato, inorriditi dalla ferita alla gamba del soldato e dal sangue scuro sui bordi.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Quindi qui è avvenuta una rissa, eh...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non posso fare a meno di ricordare la gigantesca crepa nel pavimento dell'archivio.")
	await novel_interface.show_text_only("Con volto impassibile, l'uomo entra impettito nell'infermeria e recupera un cartoncino nero dall'armadietto dei medicinali. Dal nulla, carica la sua pistola.")
	await novel_interface.show_text_only("Dall'angolo dell'infermeria si avventa un'ombra oscura. L'uomo spara più volte senza perdere un colpo, facendolo volare fuori dall'inquadratura.")
	await novel_interface.show_text_only("Quindi estrae un pugnale e scompare anche lui fuori dall'inquadratura. Riappare dopo pochi secondi e getta nella spazzatura un fascio di oggetti indistinguibili.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Quello è... è quello...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Assolutamente no. Non può essere.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Seguendo un protocollo chiaro, vedo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... Non importa. Continua a guardare.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'uomo chiude con calma la porta dell'infermeria, poi fa scorrere la tessera per aprire un cancello di metallo. Sembra avere molta familiarità con la disposizione della base.")
	await novel_interface.show_text_only("Dopo aver controllato se è vuoto (lo è), l'uomo marcia nel tunnel fuori dalla sala di controllo.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Cos'è questo...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La grafica sullo schermo è un po' sgranata, ma è comunque facile capire che il tunnel nel filmato è stato sicuramente il luogo di un bagno di sangue.")
	await novel_interface.show_text_only("Decine di cadaveri giacciono disordinatamente in formazione radiale, come se una potente esplosione li avesse falciati tutti in una volta.")
	await novel_interface.show_text_only("E al centro di tutto è inginocchiata una ragazza vestita di bianco, con la parte superiore del corpo eretta, trafitta da un'arma dalla lunga elsa.")
	await novel_interface.show_text_only("Indossa troppi pochi strati considerando che è in Antartide. La sua pelle lattiginosa è tinta di rosso sangue.")
	await novel_interface.show_text_only("Ha un'arma in ciascuna mano e le stringe saldamente nonostante abbia perso conoscenza.")
	await novel_interface.show_text_only("L'uomo si inginocchia davanti a lei, le accarezza il viso con una mano.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Si conoscono?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quindi gira intorno alla sua schiena, afferra l'elsa ed estrae lentamente l'arma, rivelando una punta di lancia rivestita d'oro.")
	await novel_interface.show_text_only("Il corpo della ragazza non si mosse affatto e dalla ferita non uscì più sangue. C’era un indescrivibile senso di disobbedienza in tutto il processo.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Sussurra) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'uomo si tolse il cappotto, rimosse con cura la testa della pistola, la avvolse in un panno e la infilò nella giacca, gettando da parte il lungo manico.")
	await novel_interface.show_text_only("Poi entra nella sala di controllo. Cerchiamo di controllare cosa sta facendo cambiando telecamera, ma lo schermo che mostra la sala di controllo mostra solo immagini statiche.")
	await novel_interface.show_text_only("Alziamo lo sguardo e vediamo che la telecamera nella stanza è già stata completamente distrutta da una scossa elettrica.")
	await novel_interface.show_text_only("Dopo un attimo, l'uomo riemerge nel corridoio, portando una valigia di lega larga circa 1,6 piedi.")
	await novel_interface.show_text_only("La serratura della valigia sembra rotta. Apre la custodia e tira fuori tre recipienti di vetro.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Cosa sta facendo esattamente?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uno dei vasi di vetro è in frantumi. L'uomo lo fissa, esita un po', poi si mette in tasca i due intatti.")
	await novel_interface.show_text_only("Con delicatezza, tenta di recuperare le armi dai pugni chiusi della ragazza. È allora che un taccuino le cade da qualche parte nella maglietta.")
	await novel_interface.show_text_only("L’uomo lo raccoglie, lo sfoglia e poi lo infila di nuovo nel vestito della ragazza.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Come se trasportasse un bambino, prende con cura tra le sue braccia la ragazza snella e fragile. I suoi movimenti sono amorevoli e teneri.")
	await novel_interface.show_text_only("La trasporta in stile nuziale fino alla fine del tunnel, dove sbatte la carta nera contro il muro.")
	await novel_interface.show_text_only("Il muro scivola di lato e i due, insieme, scompaiono nell'oscurità...")
	await novel_interface.show_text_only("... Ecco dove finiscono le registrazioni.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("C'è un lungo periodo di vuoto in tutte le registrazioni video successive. E l'uomo non riappare mai nel resto del filmato.")
	await novel_interface.show_text_only("In effetti, non c'è nulla che valga la pena vedere nel filmato che segue. Niente, finché non ci presentiamo noi tre all'ingresso della base.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("È strano...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Aspetta, guarda.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael indica lo schermo che mostra l'infermeria.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Non c'era un cadavere proprio lì? È... sparito.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In effetti, tutti i cadaveri sono spariti...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ciò significa che durante i periodi vuoti nel filmato, i luoghi della battaglia erano stati completamente ripuliti.")
	await novel_interface.show_text_only("Iniziamo a controllare, esaminando i record precedenti.")
	await novel_interface.show_text_only("Riusciamo a trovare filmati che registrano quello che è successo alla ragazza e alla sua squadra.")
	await novel_interface.show_text_only("L'ultimo fotogramma che vediamo, catturato dalla telecamera della sala di controllo, è una donna in tuta da neve che costringe la ragazza dai capelli neri a uscire dalla porta con una pistola.")
	await novel_interface.show_text_only("È qui che finisce la registrazione.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... Quindi è quello che è successo qui...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esco dall'interfaccia dati e richiamo il filmato della sorveglianza in tempo reale.")
	await novel_interface.show_text_only("Abbiamo la copertura dell'ingresso principale, della sala espositiva, dei corridoi, dell'archivio, dei tunnel... e di alcuni altri luoghi in cui non siamo stati.")
	await novel_interface.show_text_only("Mentre scruto lo schermo che mostra filmati in tempo reale, all'improvviso mi viene in mente che la battaglia che abbiamo avuto fuori dall'archivio non è stata registrata. Affatto.")
	await novel_interface.show_text_only("Secondo il video noi tre siamo entrati nell'archivio dal corridoio e non ne siamo più usciti. Invece siamo arrivati ​​nel tunnel da un'apertura dall'altra parte.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Quindi quella lotta è avvenuta in un “sogno”? Che strano...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("E chi ha ripulito il posto?","Raphael")
	await novel_interface.show_dialog("... Qualcuno deve essersi intromesso anche nel filmato.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Non riusciamo nemmeno a trovare il filmato dell'uomo alto che lascia il locale.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Scruto meccanicamente gli schermi di sorveglianza in tempo reale, mentre noi tre discutiamo sull'identità della ragazza e dell'uomo che abbiamo appena visto.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Aspetta...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È ragionevole per noi pensare che qualcuno possa aver manomesso le registrazioni e che fossimo in un “sogno”.")
	await novel_interface.show_text_only("Ciò che è irragionevole è...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Perché possiamo vedere le riprese in tempo reale della sala archivio?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael e Henriette si bloccano all'istante.")
	await novel_interface.show_text_only("La stanza rimane stranamente silenziosa per alcuni secondi.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Non abbiamo...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... estrarre il cavo prima di uscire dalla stanza?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Qual è quella domanda importante, ancora una volta...")
	await novel_interface.show_text_only("—Come sono arrivato qui?")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("La mia vescica richiede di nuovo attenzione. Cavolo.")
	
	print("=== 潜渊症篇第25话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
