# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Странные фигуры, внезапно появившиеся в коридоре, направляются к нам.")
	await novel_interface.show_text_only("В них полная тишина, если не считать шороха ткани и топота шагов. Им вообще нужно дышать?")
	await novel_interface.show_text_only("Я крепко сжимаю свое оружие, мысленно готовясь. В этот момент из боевого костюма Генриетты вырываются сильные лучи света. Она в мгновение ока исчезает из поля зрения, не оставляя после себя ничего, кроме пучка яркого дыма.")
	await novel_interface.show_text_only("Пока я все еще был ошеломлен, Генрих уже увернулся от одного человека и ударил одну из женщин по нагруднику тыльной стороной своего лазуритового меча.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ух ты, какие у нее движения!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Громкий, приглушенный звук попадания ее оружия в цель эхом отдается от стен коридора. Клянусь, у меня болит грудь, просто когда я это слышу.")
	await novel_interface.show_text_only("Ее цель падает на землю, как деревянная марионетка, и откатывается на некоторое расстояние.")
	await novel_interface.show_text_only("Любой человек инстинктивно двинулся бы вперед, чтобы защитить себя от дальнейших травм, но эта девочка-марионетка не делает ничего подобного.")
	await novel_interface.show_text_only("Как только она перестает катиться, она просто подпрыгивает, с вмятиной на груди и всем остальным, и бросается на нас.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Поняв, что это не обычные враги, Генриетта оборачивается, молниеносно пронзает пятки троих из них.")
	await novel_interface.show_text_only("Все трое с перерезанными сухожилиями падают на землю, но продолжают ползти к нам устрашающе бесшумными, судорожными движениями.")
	await novel_interface.show_text_only("На первый взгляд они не выглядят такими уж пугающими, но тот факт, что они демонстрируют явно нечеловеческие характеристики,... очень тревожит, если не сказать больше.")
	await novel_interface.show_text_only("Они выглядят как люди. Они не ведут себя по-человечески. Это чертовски жутко.")
	await novel_interface.show_text_only("Убедившись, что враги больше не представляют угрозы, Рафилия движется вперед, пытаясь понять, в чем дело.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Внезапно земля снова начинает дрожать.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("Еще одно землетрясение?","Генриетта")
	await novel_interface.show_text_only("На этот раз землетрясение будет более сильным и продлится гораздо дольше.")
	await novel_interface.show_text_only("Наряду с толчками, огни в коридоре мигают и гаснут, что звучит как пронзительный визг – или, может быть, дерганье металла.")
	await novel_interface.show_text_only("Враги на земле, кажется, превращаются в... прозрачную жидкость? Мыло? Прямо на наших глазах.") #换行问题
	await novel_interface.show_text_only("Затем жидкость начинает кипеть и пузыриться, как если бы она находилась на доске теппаньяки. За считанные секунды то, что раньше было фигурами в форме людей, испарилось в небытие.")
	await novel_interface.show_text_only("Они не оставляют вообще следов на холодных половицах. Как будто этих странных девушек никогда не существовало.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Наше окружение, кажется, тоже изменилось после землетрясения.")
	await novel_interface.show_text_only("Деревянные украшения в архивной комнате рассыпались, превратившись в парящие в воздухе опилки. Краска на стенах тоже облупилась.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ А?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это всё та же архивная комната...")
	await novel_interface.show_text_only("Но свет выключен. Плитка на земле больше не блестит. А предметы на полке — совершенно по-другому расставлены.")
	await novel_interface.show_text_only("За толстыми стальными балками индустриального вида на нас направила темную линзу еще одна звукочувствительная камера наблюдения.")
	await novel_interface.show_text_only("На стене — подробная топографическая карта Антарктиды, а на столе блокнот, в котором фиксируются изменения атмосферных данных.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Что... что это?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("Было ли то, что мы только что видели..., иллюзией?","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Те девочки-марионетки тоже?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта смотрит на свое оружие — оно не запятнано кровью, хотя так и должно быть. Затем она смотрит вверх, туда, где, казалось бы, испарились наши внезапные нападавшие.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Возможно, то, чем мы были в..., не было реальным миром.","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриха внезапно прервал голос Ли Тонга.")
	await novel_interface.show_dialog("Наконец! Связь!","Mariru")
	await novel_interface.show_text_only("Голос Mariru доносится из... у меня в груди?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Привет, Mariru! Что там с сигналом?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru мычит устало. Тем временем Генриетта в ужасе смотрит на мою грудь, не понимая, почему оттуда доносится голос Mariru.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Эй, это недоразумение, клянусь!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Увидев выражение моего лица, Генриетта кивает, как будто понимающая это, и начинает ощупывать и свою грудь.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Шепотом) Мастер... тоже изменил моё тело таким же образом?","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("Конечно нет! И почему ты выглядел так, будто тебя это взволновало?")
	await novel_interface.show_dialog("Эй, кстати, почему вместо этого вы не связались с нами по рации?\\nС Annie все в порядке?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Спутник связи уже на месте. Annie собирает информацию об источниках утечек метана. Как там дела?","Mariru")
	await novel_interface.show_text_only("Я изо всех сил стараюсь разобраться в своих мыслях и максимально кратко сообщить обо всем, с чем мы столкнулись после входа на базу.")
	await novel_interface.show_dialog("... \\n(Не реальный мир, да... )","Mariru")
	await novel_interface.show_dialog("Подождите секунду, позвольте мне проверить время.","Mariru")
	await novel_interface.show_dialog("Прошло восемь минут с тех пор, как вы в последний раз связывались с Annie у ворот базы.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Всего восемь минут?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Разве это не должно было длиться хотя бы сорок минут?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Словно что-то поняв, Mariru начинает печатать.")
	await novel_interface.show_dialog("Эсминец класса Лебона, патрулирующий Антарктический океан, только что получил какой-то низкочастотный сигнал.","Mariru")
	await novel_interface.show_dialog("Я думал, это от афтершока, но учитывая, как обстоят дела сейчас...","Mariru")
	await novel_interface.show_text_only("Mariru вызывает свою систему ЭЭГ и повторно запускает анализ закономерностей.")
	await novel_interface.show_dialog("Как я и ожидал...","Mariru")
	await novel_interface.show_dialog("Этот сигнал... имеет ту же структуру, что и мозговые волны во время быстрого сна человека...","Mariru")
	await novel_interface.show_dialog("... Но в шестьдесят два раза интенсивнее.","Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("... Ты шутишь?","Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Вы имеете в виду, что мы только что мечтали?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Время замедляется, когда ты мечтаешь, это правда...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("Сны отражают воспоминания. И то, что только что произошло,..., действительно было похоже на рекомбинацию разных фрагментов воспоминаний.","Генриетта")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если это был сон, то это точно был кошмар __ЭЛЛИПСИС__","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мне внезапно вспомнился фильм, который я смотрел, где персонажи использовали тотемы, чтобы определить, были они во сне или нет. Жаль, что у меня не было одного из них.")
	await novel_interface.show_dialog("__ЭЛЛИПСИС__ Может, это не вам снилось, ребята. Возможно, вы были в чужом сне.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Чужая мечта __ЭЛЛИПСИС__ ?","Генриетта")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Все это, конечно, лишь предположения, которые только еще больше меня нервируют. Я заметил, что на конце Mariru довольно шумно — кажется, вокруг нее много людей занято работой.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Кстати, а как там...?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru какое-то время молчит, словно пытаясь решить, как много она хочет рассказать.")
	await novel_interface.show_dialog("Это немного сложнее, чем мы ожидали.","Mariru")
	await novel_interface.show_dialog("В настоящее время Объединенный Конгресс обсуждает, как решить проблему утечки метана. Но вы знаете, какие у них люди. Они ни в коем случае не смогут справиться с событием уровня апокалипсиса, подобным этому.","Mariru")
	await novel_interface.show_dialog("Доктор Декерс из Salmonton предложил план использования метанофильных архей....","Mariru")
	await novel_interface.show_dialog("Но в настоящее время на складе не так уж много такого, особенно того, что может выжить на морозе. И уже слишком поздно выращивать больше с нуля.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Кроме того, анаэробные бактерии мало что могут сделать в нашей атмосфере, потому что кислород убивает их.","Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Так что даже дедушка в тупике, да...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(Я понятия не имею, о чем они вообще говорят... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("В настоящее время большинство средних и мелких научно-исследовательских станций находятся в процессе эвакуации, хотя на трех крупных антарктических базах уже создана временная аварийная группа.","Mariru")
	await novel_interface.show_dialog("На данный момент за Полярным кругом выявлено сорок два источника утечки метана. Шесть из них уже загорелись, и фотографии этих объектов сейчас распространяются в Интернете со скоростью лесного пожара.","Mariru")
	await novel_interface.show_dialog("И на новостных каналах тоже. Все телевизоры в мире, вероятно, сейчас показывают зацикленные кадры пламени, вырывающегося из трещин на полярных ледяных равнинах и поднимающегося на десятки метров в высоту.","Mariru")
	await novel_interface.show_dialog("Они больше не смогут держать это в тайне. Мир знает, и они явно паникуют — некоторые уже устраивают праздники: последнее ура перед концом света.","Mariru")
	await novel_interface.show_text_only("Слова Mariru циничны, ее тон беспомощен.")
	await novel_interface.show_dialog("Места утечек сконцентрированы вблизи нескольких незамерзающих озер, а также в районе горы Эребус на острове Росс.","Mariru")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("... Гора Эребус? Это вулкан.","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что касается расположенной рядом с вами антарктической исследовательской станции принцессы Елизаветы, то из-за утечек метана уже начались два небольших пожара.","Mariru")
	await novel_interface.show_dialog("Еще есть пожар, устроенный группой богатых, безмозглых участников туристической группы Mt. Grove, которые играли с огнеметами. Идиоты.","Mariru")
	await novel_interface.show_dialog("По крайней мере, база Снедроннинген сейчас не находится в непосредственной опасности.","Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Уф…","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Хорошо. По крайней мере, нам пока не грозит опасность поджариться....)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("... Однако станция МакМердо обнаружила под трещинами крупномасштабную активность потока лавы.","Mariru")
	await novel_interface.show_dialog("Трещина возле базы Снедроннинген является самой заметной, а окружающие ее ледяные щиты становятся все более нестабильными с угрожающей скоростью.","Mariru")
	await novel_interface.show_text_only("Я не могу не смотреть на металлические доски под ногами.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Значит, нас все равно поджарят, а... )","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапный резкий шум пронзил воздух. Моя грудь вибрирует, и следующее, что я помню, — мы разрываем связь.") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Пламя, бьющее из-под земли, текущая лава, смертельная вулканическая сажа...","Генриетта")
	await novel_interface.show_dialog("Это слишком похоже на то, что произошло около четырехсот лет назад...","Генриетта")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Все это предвестники распада «первозданной субстанции».","Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Вы имеете в виду то, что произошло в 1600 году?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Это было в Седьмой Частице, Стране Изобилия: Губернаторском округе Перу.","Генриетта")
	await novel_interface.show_dialog("Я никогда не забуду огненное море, резкий запах серы в воздухе...","Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта вспоминает горько, и я не могу не расчувствоваться, потому что у меня тоже был очень похожий опыт.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Итак,..., все это имеет отношение к тому чуваку, которого ты упомянул?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генриетта кивает.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Тогда мы с друзьями из «Розенкройцера» собрали три мистические книги: «Книгу Колесницы», «Книгу Творения» и «Книгу Света».","Генриетта")
	await novel_interface.show_dialog("Следуя инструкциям в книгах, мы совершили величайшее достижение за всю историю алхимии: создали «портал», который мог бы привести нас в кармический мир.","Генриетта")
	await novel_interface.show_dialog("Будучи наивными, мы искренне верили, что портал приведет нас к доброжелательному, всевидящему Повелителю, который покажет нам все истины мира.","Генриетта")
	await novel_interface.show_dialog("... Но на самом деле есть причина, по которой существуют правила «не проходить через портал» и «не искать истину»...","Генриетта")
