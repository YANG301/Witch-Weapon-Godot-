# bathophobia_ep18.gd - 深海恐惧症篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep18_script()

func play_script():
	pass

func bathophobia_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("The quake in the South Pole does not last long. The empty layer underneath the supply station, established as a precaution against blizzards, effectively lessens the damage brought by the tremors.")
	await novel_interface.show_text_only("In less than a minute, the land returns to its previous calm state.")
	await novel_interface.show_text_only("I grew up at the Aegis borders—an earthquake this size doesn’t bother me a bit.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Just a small earthquake. Everyone okay?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Yeah... but why was holding down your skirt your first reaction?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Like, are you sure that should be your priority in an earthquake?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh, well...\\nIt’s just...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aw, come on, give me a break!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Still, it’s strange. Antarctica is a continent covered in layer upon layer of thick ice. Not an earthquake-prone zone for sure.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael frowns, glaring outside the window.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Or did I remember it wrong?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("So the Ninth Sephira has finally caused an issue, huh...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("Ren, look!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie calls out suddenly, pointing outside the window. I lean closer to take a look.")
	await novel_interface.show_text_only("A gigantic crack has appeared on the flat layer of ice. Under the velvet skies, it looks almost like an abyss that leads straight to Hell.")
	await novel_interface.show_text_only("In a sense, it’s less a crack and more like a canyon...")
	await novel_interface.show_text_only("At the edge of the gap, some sharp spikes stand erect. Abnormal net-shaped structures come piercing out from the depths of the thick layer of ice.")
	await novel_interface.show_text_only("The ice cliffs on either side seem to remain at about the same height. It’s like some unimaginable force has torn the whole ice rack apart.")
	await novel_interface.show_text_only("The ginormous crack meanders onward towards the highlands, disappearing from sight...")
	await novel_interface.show_text_only("Luckily we’re here in the valley. We’re safe here.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Hey, what’s that?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael and Henriette move closer to look at what I’m pointing at. They both gasp.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("That building... why isn’t it affected?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On the ice plains right in front of us, a huge manmade structure looms smack in the path of the spreading crack, completely unbothered.")
	await novel_interface.show_text_only("Its dark walls seem out of place in this pale, white land.")
	await novel_interface.show_text_only("Instead of ripping apart the building like it should have, the crack circumnavigated it in the form of two arcs, as if there’s something in the structure it doesn’t want to disturb.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Is that the meeting point Mariru just mentioned?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Seems to be the right location.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Crackling static can be heard from the control panel. It seems that the supply station is reestablishing connection with the outside world.")
	await novel_interface.show_dialog("Hello? Ren? Can you hear me?", "Mariru")
	await novel_interface.show_text_only("Mariru sounds kind of nervous.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Before the reconnaissance satellite group we’ve called up finishes switching tracks, the graphic feed of Antarctica can only be refreshed once every thirty-five minutes in static form.")
	await novel_interface.show_text_only("On the screen, messages containing information Mariru has gathered from major polar stations keep popping up.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Something’s wrong. This earthquake... it’s not normal.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Strange, I still can’t get a signal from the guys at Snedronningen Base...", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru squints at the newest updated report from the weather sensor at the Nuremberg Base.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Wait, is that...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru taps away frantically at her hand-held device, calling up all the real-time meteorological and hydrological monitoring data in Antarctica she can find.")
	await novel_interface.show_text_only("It’s easy to see that the numbers are changing—rapidly, consistently. She’s suddenly reminded of a course she took in university...")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Tell me, Aya...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Hmm?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Even without considering the impact of nuclear weapons and foreign objects, there are still many natural factors lurking on the earth that can cause \"the end of the world\".", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Of course. Humans, in fact, appeared only after the fifth mass extinction on earth. Natural factors can be lethal indeed.", "Ai")
	novel_interface.change_2nd_expression("normal")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_dialog("And when it comes to the most dangerous natural element that can be found in Antarctica...", "Ai")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("Dammit... it’s methane!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ren, are you sure the crack is near your location?", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Yeah. But what’s weird is that...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I reported the information to Lililiu that the rift seemed to be deliberately bypassing the White Queen's base.")
	await novel_interface.show_text_only("Mariru ponders this information for a bit. When she next speaks, her tone is crisp, businesslike.")
	await novel_interface.show_dialog("Listen, it’s likely that the methane that’s been sealed underground for millions of years is currently leaking from the rift.", "Mariru")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Wait... like, yeah, I know billions of tons of methane are stored underground here, but... aren’t they solid? Like flammable ice?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("They may have vaporized due to the pressure caused by the ice shelf ripping in the earthquake. At least the exposed ones likely had.", "Ai")
	await novel_interface.show_dialog("According to the sensors from the Nuremberg Base, the methane levels above Antarctica has risen by 2.1ppm compared to an hour ago, before the earthquake happened.", "Mariru")
	await novel_interface.show_dialog("The numbers differ among other weather stations, but the results are the same: there’s a dramatic rise in methane level there no matter how you look at it.", "Mariru")
	await novel_interface.show_dialog("The ocean area near the Amery ice shelf has also shown abnormalities. We believe it’s because the methane gas from under the ocean have bubbled up, causing a disruption in the tides.", "Mariru")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("If I remember correctly, the greenhouse effect brought by methane is twenty-one times that of carbon dioxide...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("So... it’s gonna get hotter?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I try my best to recall what I read in those environment preservation pamphlets we received in school.")
	await novel_interface.show_dialog("The tides are already rising, while the wind speed is decreasing. The temperature will be going up... 0.2 degrees every 12 hours. And won’t stop going up for quite a while.", "Mariru")
	await novel_interface.show_dialog("This means that our oceans will soon be deprived of oxygen, which will of course ruin the whole ecosystem. Most living beings on our planet will be purged.", "Mariru")
	await novel_interface.show_text_only("Raphael finally seems to realize just how serious the situation really is.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("So... in two weeks... all exposed plants will wither...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("And in three weeks, most animals will face extinction. 90% of humans will have no drinking water. Even the satellites in low earth orbit will no longer move the way they should due to the change in our atmosphere...", "Ai")
	await novel_interface.show_dialog("Within forty-five days, only a rare few species—insects, all of them—will survive in such an environment.", "Mariru")
	await novel_interface.show_dialog("If we don’t do something, and fast, we’ll soon become food for those insects.", "Ai")
	await novel_interface.show_text_only("I can’t help the shiver that runs down my spine as I stare at the crack that will lead to the doom of mankind.")
	await novel_interface.show_text_only("Mariru clears her throat. Everyone present holds their breath and waits for her orders.")
	await novel_interface.show_dialog("There’s not a minute to lose. With every passing second, the crack continues to cause more damage.", "Mariru")
	await novel_interface.show_dialog("If we sit around and wait for the United Congress to send their emergency team, it’ll be too late.", "Mariru")
	await novel_interface.show_dialog("Besides, it’s not like their emergency team would know how to deal with something like this...", "Mariru")
	await novel_interface.show_dialog("So, Henriette...", "Mariru")
	await novel_interface.show_text_only("We all turn to the alchemist, who doesn’t look too surprised to have been called out by Mariru.")
	await novel_interface.show_dialog("If this is somehow related to the Ninth Sephira you’re supposed to protect... then have you ever encountered something that could have repercussions as serious as this?", "Mariru")
	novel_interface.show_character("heinrich_battle","speechless")
	await novel_interface.show_dialog("See, that’s what’s most annoying about my job!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The blonde alchemist shakes her head with a wan smile as she reminisces.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("The One usually just teleports me to the site of the incident and leaves me there.", "Henriette")
	await novel_interface.show_dialog("But if we leave “that kind of thing” out there without someone to deal with it, the world might as well just end here.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Baizhu/Heinrich_Memory.png")
	await novel_interface.show_dialog("<1600 A.D., Mt. Huaynaputina, near the Spanish colony>", "Henriette")
	await novel_interface.show_dialog("I was rebelling against The One and dragged my mission out for a couple extra days. In the end, all the villages within the range of a few kilometers were completely in ruins.", "Henriette")
	await novel_interface.show_text_only("Her expression is impossibly sad.")
	await novel_interface.show_dialog("I still did my job... but so many died. That was over sixty thousand human lives I could have saved.", "Henriette")
	await novel_interface.show_dialog("The ashes of the volcano remained in the atmosphere, blocking sunlight from land for over a year. Those were the coldest few years in those couple decades.", "Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Henriette looks down, not wanting to continue.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_dialog("That volcano disaster in Peru in the end of the fifteenth century, huh...", "Ai")
	await novel_interface.show_dialog("—This is a crisis of the same magnitude, indeed.", "Mariru")
	await novel_interface.show_dialog("The extreme low temperature that plagued the world for the following few years brought about worldwide famine and wars. Some empires even fell during that period.", "Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sounds really serious...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("That was too heavy a responsibility for you to bear alone.", "Mariru")
	await novel_interface.show_dialog("Ren, didn’t you mention methods of travel in extremely cold climates?", "Mariru")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("You mean... you want us to travel over, check out the base? See what we can do to help?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Right. While I can’t be sure exactly what's going on, I believe the only way to salvage the situation lies inside the base itself.", "Mariru")
	await novel_interface.show_dialog("We need to at least collect data from there...", "Ai")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("But we can’t enter the area if the methane level is too high over there, can we?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("This “methane” you talk about... is it the “combustible substance” I currently sense in the air?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("While I’m not entirely sure what she's talking about, I still nod.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("It should be fine, then. The density of the combustible substance in the air over there in fact shows a downward spiral.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Over there? You mean...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette must be talking about Snedronningen Base.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("<Outside Snedronningen Base>")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen2.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Hello? Annie? Can you hear us?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Standing in front of the gigantic structure, looming proud in a world of snow and ice, I yell into my old walkie-talkie, shielding it from the wind with one hand.")
	await novel_interface.show_dialog("Got it... signal’s fine...\\nA blizzard is on the way... be careful...", "Annie")
	await novel_interface.show_text_only("Annie’s reply is punctured by static and more static.")
	await novel_interface.show_text_only("Mariru has ordered us to hurry with the weather data collection and send it back to New Opulentia ASAP.")
	await novel_interface.show_text_only("Meanwhile, taking into consideration what Henriette told us—something is indeed off with this base. It really stands out from its surroundings.")
	await novel_interface.show_text_only("I didn’t exactly enjoy it, but I still ventured out towards the gigantic base alongside Raphael and Henriette, holding down my skirt in the raging wind as I go.")
	await novel_interface.show_text_only("Annie is staying behind, maintaining the communication between us and Mariru with our ancient walkie-talkies.")
	await novel_interface.show_text_only("As we trudged on, we could tell from our gas chromatograph that there was indeed an alarming amount of methane gas in the air.")
	await novel_interface.show_text_only("I was this close to fainting when Raphael grabbed my hand.")
	await novel_interface.show_text_only("Not only rich and classy, but also warm and soothing. Her presence was the only thing that kept me going.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Don’t get all cocky, I’m just helping you because I promised Mariru I would.", "Raphael")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... It’s not like I asked for this myself, okay?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I immediately closed my mouth after retorting, not wanting to swallow mouthfuls of snow.")
	await novel_interface.show_text_only("If it weren’t for the Fire Jade’s warming effect, I would’ve turned into a human popsicle already.")
	await novel_interface.show_text_only("Still, overall, the base does look much more advanced than the supply stations we’ve previously been in.")
	await novel_interface.show_text_only("We cross the airstrip for fixed-wing aeroplanes and arrive in front of a stone monument.")
	await novel_interface.show_text_only("A specimen box is embedded in it. Surrounding it is the name of the base, Snedronningen, in flowery print.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("S... wait, how do you pronounce that?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("It’s Finnish. Snedronningen, idiot.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("This base with a name I can’t pronounce looks already astoundingly big from the outside—and it’s just the tip of the iceberg. Most of the structure isn’t even visible from the top.")
	await novel_interface.show_text_only("I wonder how much money went into building such an impressive structure, in Antarctica, no less.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Come on!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette moves along quickly, before I can even react.")
	await novel_interface.show_text_only("The alchemist places her hand on the electric lock by the door. Instead of letting it scan her palm, she simply rips the whole thing, frame and all, off the wall.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(What kind of monster is she?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianBase.png")
	await novel_interface.show_text_only("With the lock problem taken care of, the cables holding the barrier close begin moving, little cogs whirring, finally revealing the doorway.")
	await novel_interface.show_text_only("We peer in to see a stairway leading down.")
	await novel_interface.show_dialog("... So we just go in? Without informing anyone?", "Lian")
	await novel_interface.show_text_only("I can’t help turning back to gape at the huge hole we left on the wall.")
	await novel_interface.show_text_only("We made a freaking hole in the wall—yet no one showed up to yell at us. Hmm.")
	await novel_interface.show_dialog("Let’s just... go inside.", "Lian")
	await novel_interface.show_text_only("I spot a bullet shell on the ground by the corridor.")
	await novel_interface.show_text_only("That can’t be a good sign...")
	print("=== 深海恐惧症篇第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
