# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("— Attention !","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette me bouscule dès que la porte de la salle de contrôle s'ouvre en grinçant.")
	await novel_interface.show_text_only("Juste à temps aussi, pour la prochaine chose que je sais, d'innombrables arcs électriques clignotants s'enfoncent impitoyablement dans la poitrine de la jeune fille blonde, accompagnés d'explosions violentes et déchirantes. La lumière est aveuglante, j’arrive à peine à garder les yeux ouverts.")
	await novel_interface.show_text_only("Et en quelques secondes, tout est fini. Tout est à nouveau calme. Mes cheveux se dressent – ​​une énorme quantité d’électricité statique doit s’y être accumulée. L’air empeste le chlore.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Wow... \\nHenriette, ça va ?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("C'est un piège, je pense. Une sorte d'arme défensive.\\nAssez impressionnante, elle contient probablement autant d'énergie qu'un petit radar.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette se lève et étudie pensivement les plafonniers de la salle de contrôle. Dans sa main se trouve un cristal bleu clair translucide.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Qu'est-ce que c'était, d'ailleurs ?\\nEt qu'est-ce que c'est dans ta main ?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("C'est une tourmaline. Voulez-vous essayer, Maître ?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'alchimiste m'adresse un sourire énigmatique, tend sa main droite et place doucement le cristal derrière mon oreille.")
	await novel_interface.show_text_only("Un courant soudain, chaud et flou, traverse mon corps, faisant dresser tous mes poils.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahh !","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne peux m'empêcher de laisser échapper un délicat gémissement.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("La? Le corps du maître est très sensible~","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Tu gémis ? Ici? Vraiment?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l me regarde comme si j'étais une poubelle.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Hé, ce n'est pas comme si j'avais fait ça exprès...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je marmonne en baissant la tête et en rougissant furieusement.")
	await novel_interface.show_text_only("Au moins, l'électricité statique accumulée au-dessus de ma tête a disparu. Mes cheveux sont beaux et lisses maintenant.")
	await novel_interface.show_text_only("Je devrais demander un de ces cristaux à Henriette à notre retour... \\nÇa ne la dérangera pas, n'est-ce pas ?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Je suis timidement l'alchimiste dans la salle de contrôle.")
	await novel_interface.show_text_only("L'endroit a l'air détruit. La plupart des écrans et des équipements ont été endommagés à des degrés divers. Le plafond et les murs s'effondrent également.")
	await novel_interface.show_text_only("Les marques de brûlure noires laissées par les chocs à haute tension se sont propagées du panneau de commande principal aux deux côtés. Les circuits exposés pétillent encore d’étincelles.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Le rayon sphérique est supérieur à quinze pieds... \\nQuelqu'un a dû utiliser une arme à décharge à haute tension ici...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("S'ils utilisaient le système de sécurité authentique standard, cela signifie que cette marque ici...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Quelqu’un a dû recâbler grossièrement l’équipement de défense offensive du système et insérer une batterie secondaire chimique en utilisant le système haute tension de l’intranet de la base... ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je regarde l'obus, à peine reconnaissable après l'explosion, et je comprends enfin pourquoi l'air pue le chlore.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Une explosion électrique...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lorsqu’un courant puissant traverse une feuille métallique, la chaleur croissante provoque la accumulation d’une énorme quantité d’énergie, ce qui entraîne de violentes explosions et des éclairs.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Celui qui a fait cela a donc utilisé les couches de feuilles métalliques pliées à son avantage. Un engin très efficace et mortel en effet.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais... pour que ça marche, il faut que quelqu'un place le fil métallique guidant le courant dans la fente sous la porte, qui est la seule issue de cet endroit...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ainsi, celui qui a fait cela exploserait aux côtés des ennemis à la seconde où la porte de la pièce serait ouverte.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le matériel clé de ce système de sécurité semble être protégé par des barrières électromagnétiques. Je remarque que le panneau de contrôle principal peut toujours être activé. Seuls quelques boutons sont endommagés.")
	await novel_interface.show_text_only("Nous entrons dans le système de sécurité et constatons qu’il a été piraté. Cela pourrait avoir quelque chose à voir avec la montre militaire connectée au panneau de contrôle principal.")
	await novel_interface.show_text_only("Le stockage flash dans la montre est toujours accessible. Il est facile de déterminer l'identité de son propriétaire à partir du contenu.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("On dirait que c'est quelqu'un de vraiment dur à cuire.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quelques écrans du poste de surveillance fonctionnent toujours, diffusant consciencieusement les images en temps réel capturées par les caméras de surveillance.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("J'espère que nous pourrons trouver des informations utiles ici.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je prends une profonde inspiration et j'appelle les archives historiques.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hum…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comme on peut s'y attendre d'un établissement top secret, il y a trop de dossiers pour qu'on puisse les compter. Certaines des vidéos précédentes sont même stockées dans des fichiers VCR.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Trouver quelque chose d’utile dans tout ce désordre prendra des années !","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Arrêtez de pleurnicher. Il devrait y avoir un moyen simple d'exécuter une recherche, sinon le concepteur d'interface utilisateur aurait déjà été licencié.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh bien, il existe effectivement un mode qui nous permet de prévisualiser efficacement tous les enregistrements en même temps, mais...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Il y a des centaines de caméras de surveillance dans la base et le système collecte des données depuis la construction de la base. Seul un seul écran de vingt pouces devant moi fonctionne encore. Tout afficher dessus d'un coup... c'est impossible.")
	await novel_interface.show_text_only("Désespéré, je continue à effectuer un zoom arrière, jusqu'à ce que les vignettes des images soient toutes réduites à de simples pixels.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Hé! Regardez ça !","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Rapha?l me frappe à la tête et désigne une ligne blanche droite et verticale sur l’écran.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Toutes les images filmées à ce moment-là... sont toutes... blanches ?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Je passe au moment auquel Rapha?l fait référence et j'appelle la première image après la partie avec toute la blancheur qu'elle contient.")
	await novel_interface.show_text_only("Un homme grand et large apparaît.")
	await novel_interface.show_text_only("Il porte une combinaison de protection contre les matières dangereuses de couleur cobalt et semble mesurer plus de six pieds. Il avance d’un pas régulier et rapide.")
	await novel_interface.show_text_only("Cela ne semble pas le déranger d'être filmé, mais la résolution est trop faible pour que nous puissions voir clairement son visage.")
	await novel_interface.show_dialog("Il y a quelque chose chez lui...","Lian")
	await novel_interface.show_dialog("Vous le connaissez, Maître ?","Henriette")
	await novel_interface.show_dialog("Non...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("L'homme inspecte les lieux en avançant, comme s'il cherchait quelque chose.")
	await novel_interface.show_text_only("Ses pas s'accélèrent alors qu'il se dirige de la salle des archives vers l'infirmerie.")
	await novel_interface.show_text_only("Alors qu'il passe devant deux cadavres de soldats emmitouflés, il s'arrête brusquement et se penche pour les étudier.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ce soldat... il lui manque un veau ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l et moi retenons notre souffle, horrifiées par la blessure à la jambe du soldat et le sang noir qui coule sur ses bords.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Donc une bagarre a eu lieu ici, hein...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne peux m'empêcher de penser à la gigantesque fissure dans le sol de la salle des archives.")
	await novel_interface.show_text_only("Le visage impassible, l'homme se pavane dans l'infirmerie et récupère une carte noire dans l'armoire à pharmacie. Sorti de nulle part, il charge son arme.")
	await novel_interface.show_text_only("Du coin de l'infirmerie, une ombre noire surgit. L'homme tire plusieurs fois sans perdre un instant, l'envoyant voler hors du cadre.")
	await novel_interface.show_text_only("Il sort alors un poignard et disparaît également du cadre. Il réapparaît au bout de quelques secondes et jette un paquet d'objets indiscernables à la poubelle.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Est-ce que... est-ce que...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pas question. C'est impossible.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Suivant un protocole clair, je vois.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... Cela n'a pas d'importance. Continuez à regarder.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'homme ferme calmement la porte de l'infirmerie, puis glisse la carte pour ouvrir un portail métallique. Il semble très familier avec l’agencement de la base.")
	await novel_interface.show_text_only("Après avoir vérifié s’il est vide (c’est le cas), l’homme entre dans le tunnel à l’extérieur de la salle de contrôle.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Qu'est-ce que c'est... ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les graphismes à l’écran sont plutôt granuleux, mais il est toujours facile de dire que le tunnel dans les images a définitivement été le lieu d’un bain de sang.")
	await novel_interface.show_text_only("Des dizaines de cadavres gisent au hasard dans une formation radiale, comme si une puissante explosion les avait tous fauchés en même temps.")
	await novel_interface.show_text_only("Et au centre de tout cela est agenouillée une jeune fille vêtue de blanc, le haut du corps droit, transpercé par une arme à longue garde.")
	await novel_interface.show_text_only("Elle porte beaucoup trop peu de couches étant donné qu’elle est en Antarctique. Sa peau laiteuse est teinte d'un rouge sanglant.")
	await novel_interface.show_text_only("Elle a une arme dans chaque main, les serrant fermement même si elle a perdu connaissance.")
	await novel_interface.show_text_only("L'homme s'agenouille devant elle, lui caresse le visage d'une main.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Est-ce qu'ils se connaissent ?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il tourne ensuite vers son dos, saisit la poignée et retire lentement l'arme, révélant un fer de lance doublé d'or.")
	await novel_interface.show_text_only("Le corps de la jeune fille ne bougeait pas du tout et aucun sang ne sortait de la blessure. Il y avait un sentiment indescriptible de désobéissance dans tout le processus.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Chuchote) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'homme a enlevé son manteau, a soigneusement retiré la tête du pistolet, l'a enveloppé dans un tissu et l'a mis dans sa veste de costume, puis a jeté le long manche de côté.")
	await novel_interface.show_text_only("Il entre ensuite dans la salle de contrôle. Nous essayons de vérifier ce qu’il fait en changeant de caméra, mais l’écran montrant la salle de contrôle n’affiche que du statique.")
	await novel_interface.show_text_only("Nous levons les yeux et constatons que la caméra dans la pièce a déjà été complètement détruite par un choc électrique.")
	await novel_interface.show_text_only("Au bout d'un moment, l'homme réapparaît dans le couloir, portant une valise en alliage d'environ 1,6 pied de large.")
	await novel_interface.show_text_only("La serrure de la valise semble cassée. Il ouvre le boîtier et en sort trois récipients en verre.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Que fait-il exactement ?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'un des récipients en verre est brisé. L'homme le regarde, hésite un peu, puis place les deux intacts dans sa poche.")
	await novel_interface.show_text_only("Doucement, il tente de récupérer les armes des poings fermés de la jeune fille. C’est alors qu’un cahier tombe de quelque part dans sa chemise.")
	await novel_interface.show_text_only("L’homme le ramasse, le feuillette, puis le remet dans la tenue de la fille.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Comme s’il portait un bébé, il prend délicatement dans ses bras la jeune fille mince et frêle. Ses mouvements sont affectueux et tendres.")
	await novel_interface.show_text_only("Il la porte en style nuptial jusqu'au bout du tunnel, où il tape la carte noire contre le mur.")
	await novel_interface.show_text_only("Le mur s'écarte et les deux, ensemble, disparaissent dans l'obscurité...")
	await novel_interface.show_text_only("... C'est là que se terminent les enregistrements.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Il y a une longue période de silence dans tous les enregistrements vidéo qui suivent. Et l’homme ne réapparaît jamais dans le reste des images.")
	await novel_interface.show_text_only("En fait, il n’y a rien à voir dans les images à suivre. Rien, jusqu'à ce que nous arrivions tous les trois à l'entrée de la base.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("C'est bizarre...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Attends, regarde.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l montre l'écran montrant l'infirmerie.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("N'y avait-il pas un cadavre là-bas ? C'est... parti.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("En fait, tous les cadavres ont disparu...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Cela signifie que pendant les périodes vides des images, les sites de combat étaient complètement rangés.")
	await novel_interface.show_text_only("Nous commençons à vérifier, à parcourir les enregistrements antérieurs.")
	await novel_interface.show_text_only("Nous parvenons à trouver des images montrant ce qui est arrivé à la jeune fille et à son équipe.")
	await novel_interface.show_text_only("La dernière image que nous voyons, capturée par la caméra de la salle de contrôle, est une dame en habit de neige, forçant la jeune fille aux cheveux noirs à sortir de la porte avec une arme à feu.")
	await novel_interface.show_text_only("C’est là que se termine l’enregistrement.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... C'est donc ce qui s'est passé ici...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je quitte l'interface de données et j'appelle les images de surveillance en temps réel.")
	await novel_interface.show_text_only("Nous couvrons l’entrée principale, la salle d’exposition, les couloirs, les archives, les tunnels... et quelques autres endroits où nous ne sommes pas allés.")
	await novel_interface.show_text_only("Alors que je parcoure l’écran affichant des images en temps réel, je réalise soudain que la bataille que nous avons eue devant la salle des archives n’a pas été enregistrée. Du tout.")
	await novel_interface.show_text_only("D’après la vidéo, nous sommes entrés tous les trois dans la salle des archives par le couloir et n’en sommes jamais sortis. Au lieu de cela, nous sommes arrivés dans le tunnel par une ouverture de l’autre côté.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Alors, ce combat s’est-il produit dans un « rêve » ? Comme c'est étrange...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Et qui a nettoyé les lieux ?","Raphael")
	await novel_interface.show_dialog("... Quelqu'un a dû également se mêler des images.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Nous ne pouvons même pas trouver d’images de l’homme de grande taille quittant les lieux.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je passe machinalement au crible les écrans de surveillance en temps réel, tandis que nous débattons tous les trois de l'identité de la fille et de l'homme que nous venons de voir.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Attendez...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il est raisonnable pour nous de penser que quelqu’un a pu gâcher les enregistrements et que nous étions dans un « rêve ».")
	await novel_interface.show_text_only("Ce qui est déraisonnable, c'est...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Pourquoi pouvons-nous voir les images en temps réel de la salle des archives ?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rapha?l et Henriette se figent instantanément.")
	await novel_interface.show_text_only("La pièce reste étrangement silencieuse pendant quelques secondes.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("N'avons-nous pas...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... retire le câble avant de quitter la pièce ?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Quelle est cette question importante encore…")
	await novel_interface.show_text_only("— Comment suis-je arrivé ici ?")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ma vessie exige à nouveau de l'attention. Merde.")
	
	print("=== 潜渊症篇第25话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
