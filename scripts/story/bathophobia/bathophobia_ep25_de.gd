# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("– Achtung!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette schiebt mich beiseite, als sich die Tür zum Kontrollraum knarrend öffnet.")
	await novel_interface.show_text_only("Pünktlich zum nächsten Moment, an dem ich mich erinnere, rammen unzählige zuckende elektrische Lichtbögen rücksichtslos in die Brust des blonden Mädchens, begleitet von harten, ohrenbetäubenden Druckstößen. Das Licht ist blendend – ich kann meine Augen kaum offen halten.")
	await novel_interface.show_text_only("Und in wenigen Sekunden ist alles vorbei. Alles ist wieder ruhig. Mir stehen die Haare zu Berge – da muss sich eine Menge statischer Elektrizität angesammelt haben. Die Luft stinkt nach Chlor.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Wow... \\nHenriette, geht es dir gut?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Es ist eine Falle, denke ich. Eine Art Verteidigungswaffe.\\nZiemlich beeindruckend, sie hat wahrscheinlich so viel Energie wie ein kleines Radar.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette steht da und betrachtet nachdenklich die Deckenbeleuchtung des Kontrollraums. In ihrer Hand hält sie einen durchscheinenden hellblauen Kristall.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was war das überhaupt?\\nUnd was hast du da in der Hand?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Es ist ein Turmalin. Willst du es versuchen, Meister?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Die Alchemistin wirft mir ein geheimnisvolles Lächeln zu, streckt ihre rechte Hand aus und platziert den Kristall sanft hinter meinem Ohr.")
	await novel_interface.show_text_only("Ein plötzlicher warmer, flauschiger Strom strömt durch meinen Körper und lässt mir die Haare zu Berge stehen.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahh!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich kann mir ein leises Stöhnen nicht verkneifen.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("La? Der Körper des Meisters ist sehr empfindlich","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Du stöhnst? Hier? Wirklich?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael starrt mich an, als wäre ich Müll.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Hey, es ist nicht so, dass ich das mit Absicht gemacht habe...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich murmele, senke meinen Kopf und erröte vor Wut.")
	await novel_interface.show_text_only("Zumindest ist die statische Aufladung, die sich über meinem Kopf angesammelt hat, verschwunden. Meine Haare sind jetzt schön glatt.")
	await novel_interface.show_text_only("Ich sollte Henriette um einen dieser Kristalle bitten, wenn wir zurückkommen... \\nEs wird ihr nichts ausmachen, oder?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Ich folge dem Alchemisten verlegen in den Kontrollraum.")
	await novel_interface.show_text_only("Der Ort sieht zerstört aus. Die meisten Bildschirme und Geräte wurden in unterschiedlichem Ausmaß beschädigt. Auch die Decke und die Wände bröckeln.")
	await novel_interface.show_text_only("Schwarze Brandflecken, die durch Hochspannungsstöße entstanden sind, breiten sich vom Hauptbedienfeld auf beide Seiten aus. Die freiliegenden Schaltkreise sprühen immer noch vor Funken.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Der Kugelradius beträgt über fünfzehn Fuß... \\nJemand muss hier eine Hochspannungsentladungswaffe verwendet haben...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wenn sie das standardmäßige Original-Sicherheitssystem verwendet haben, bedeutet das, dass dieses Zeichen hier... ist.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Jemand muss die Offensivverteidigungsausrüstung des Systems grob neu verkabelt und mithilfe des Hochspannungssystems des Intranets der Basis... eine chemische Sekundärbatterie eingebaut haben?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich starre auf die Muschel, die nach der Explosion kaum wiederzuerkennen ist, und verstehe endlich, warum die Luft nach Chlor stinkt.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Eine elektrische Explosion...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wenn ein starker Strom durch Metallfolie fließt, sammelt sich durch die zunehmende Hitze eine große Energiemenge an, die zu heftigen Explosionen und Blitzen führt.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Wer auch immer dies tat, nutzte die Lagen gefalteter Metallfolie zu seinem Vorteil. In der Tat eine sehr effektive und tödliche Erfindung.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aber... damit das funktioniert, muss jemand den Metalldraht, der den Strom leitet, in den Spalt unter der Tür legen, der der einzige Ausgang dieses Ortes ist...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Wer auch immer das getan hat, würde neben den Feinden explodieren, sobald die Tür zum Raum geöffnet wird.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Schlüsselhardware dieses Sicherheitssystems scheint durch elektromagnetische Barrieren geschützt zu sein. Ich stelle fest, dass das Hauptbedienfeld weiterhin aktiviert werden kann. Nur ein paar Knöpfe sind beschädigt.")
	await novel_interface.show_text_only("Wir betreten das Sicherheitssystem und stellen fest, dass es gehackt wurde. Könnte etwas mit der Militäruhr zu tun haben, die an das Hauptbedienfeld angeschlossen ist.")
	await novel_interface.show_text_only("Der Flash-Speicher in der Uhr ist weiterhin zugänglich. Anhand des Inhalts lässt sich leicht die Identität des Besitzers erkennen.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Scheint jemand zu sein, der wirklich knallhart ist.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Einige Bildschirme in der Überwachungsstation sind noch in Betrieb und spielen pflichtbewusst Echtzeitaufnahmen der Überwachungskameras ab.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ich hoffe, wir finden hier einige nützliche Informationen.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich atme tief durch und rufe die Geschichtsaufzeichnungen auf.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hm...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wie man es von einer streng geheimen Einrichtung erwartet, gibt es zu viele Aufzeichnungen, um sie zu zählen. Einige der früheren Videos werden sogar in VCR-Dateien gespeichert.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Es wird Jahre dauern, in diesem ganzen Chaos etwas Nützliches zu finden!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Hör auf zu jammern. Es sollte eine einfache Möglichkeit geben, eine Suche durchzuführen, sonst wäre der UI-Designer bereits gefeuert worden.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nun, es gibt tatsächlich einen Modus, mit dem wir alle Aufnahmen effizient auf einmal ansehen können, aber...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("In der Basis gibt es Hunderte von Überwachungskameras, und das System sammelt seit dem Bau der Basis Daten. Nur ein einziger 20-Zoll-Bildschirm vor mir funktioniert noch. Es ist unmöglich, alles auf einmal anzuzeigen....")
	await novel_interface.show_text_only("In meiner Verzweiflung zoome ich weiter heraus, bis die Miniaturansichten des Filmmaterials alle auf bloße Pixel geschrumpft sind.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Hey! Schau dir das an!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael schlägt mir auf den Kopf und zeigt auf eine gerade, vertikale weiße Linie auf dem Bildschirm.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alle zu diesem Zeitpunkt aufgenommenen Aufnahmen... sind alle... weiß?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Ich springe zu dem Zeitpunkt, auf den sich Raphael bezieht, und rufe das erste Bild nach dem Teil mit all dem Weiß auf, der überhaupt Inhalt enthält.")
	await novel_interface.show_text_only("In Sicht kommt ein großer, breiter Mann.")
	await novel_interface.show_text_only("Er trägt einen kobaltfarbenen Schutzanzug und scheint etwa über 1,80 Meter groß zu sein. Er schreitet in gleichmäßigem, schnellem Tempo voran.")
	await novel_interface.show_text_only("Es scheint ihm nichts auszumachen, gefilmt zu werden – aber die Auflösung ist zu niedrig, als dass wir sein Gesicht klar erkennen könnten.")
	await novel_interface.show_dialog("Da ist etwas an ihm...","Lian")
	await novel_interface.show_dialog("Kennen Sie ihn, Meister?","Henriette")
	await novel_interface.show_dialog("Nein...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Der Mann betrachtet den Ort, während er vorwärts schlendert, als suche er nach etwas.")
	await novel_interface.show_text_only("Seine Schritte werden schneller, als er vom Archivraum zur Krankenstation geht.")
	await novel_interface.show_text_only("Als er an zwei gebündelten Soldatenleichen vorbeikommt, bleibt er plötzlich stehen und beugt sich vor, um sie zu betrachten.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Dieser Soldat..., ihr fehlt ein Kalb?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael und ich halten den Atem an, entsetzt über die Beinwunde des Soldaten und das dunkle Blut an den Rändern.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hier ist also ein Kampf passiert, nicht wahr...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich muss mich an den riesigen Riss im Boden des Archivraums erinnern.")
	await novel_interface.show_text_only("Mit ausdrucksloser Miene stolziert der Mann in die Krankenstation und holt eine schwarze Karte aus dem Medikamentenschrank. Aus dem Nichts lädt er seine Waffe.")
	await novel_interface.show_text_only("Aus der Ecke der Krankenstation stürzt sich ein dunkler Schatten. Der Mann feuert mehrere Male, ohne einen Schuss zu verpassen, sodass das Bild aus dem Bild fliegt.")
	await novel_interface.show_text_only("Dann zückt er einen Dolch und verschwindet ebenfalls aus dem Bild. Nach ein paar Sekunden taucht er wieder auf und wirft ein Bündel ununterscheidbarer Gegenstände in den Müll.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ist das... ist das...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf keinen Fall. Das kann nicht sein.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Ich verstehe, dass ich einem klaren Protokoll folge.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... Spielt keine Rolle. Beobachten Sie weiter.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Mann schließt ruhig die Tür zur Krankenstation und öffnet dann mit der Karte ein Metalltor. Er scheint mit dem Aufbau der Basis sehr vertraut zu sein.")
	await novel_interface.show_text_only("Nachdem er überprüft hat, ob es leer ist (was es ist), marschiert der Mann in den Tunnel vor dem Kontrollraum.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Was ist das für eine...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Grafiken auf dem Bildschirm sind etwas körnig, aber es ist immer noch leicht zu erkennen, dass der Tunnel im Filmmaterial definitiv Schauplatz eines Blutbads war.")
	await novel_interface.show_text_only("Dutzende Leichen liegen willkürlich in einer strahlenförmigen Formation da, als ob eine gewaltige Explosion sie alle auf einmal niedergemäht hätte.")
	await novel_interface.show_text_only("Und mittendrin kniet ein weiß gekleidetes Mädchen mit aufgerichtetem Oberkörper, durchbohrt von einer Waffe mit langem Griff.")
	await novel_interface.show_text_only("Sie trägt viel zu wenige Schichten, wenn man bedenkt, dass sie sich in der Antarktis befindet. Ihre milchige Haut ist blutrot gefärbt.")
	await novel_interface.show_text_only("Sie hat in jeder Hand eine Waffe und hält sie fest, obwohl sie das Bewusstsein verloren hat.")
	await novel_interface.show_text_only("Der Mann kniet vor ihr nieder und streichelt ihr Gesicht mit einer Hand.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... Kennen sie sich?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dann dreht er sich zu ihrem Rücken, ergreift den Griff und zieht langsam die Waffe heraus, wobei er eine goldgefütterte Speerspitze zum Vorschein bringt.")
	await novel_interface.show_text_only("Der Körper des Mädchens bewegte sich überhaupt nicht und es kam kein Blut mehr aus der Wunde. Während des gesamten Prozesses herrschte ein unbeschreibliches Gefühl des Ungehorsams.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(flüstert) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Mann zog seinen Mantel aus, entfernte vorsichtig den Pistolenkopf, wickelte ihn in Stoff, steckte ihn in seine Anzugjacke und warf den langen Griff beiseite.")
	await novel_interface.show_text_only("Dann betritt er den Kontrollraum. Wir versuchen zu überprüfen, was er vorhat, indem wir die Kameras wechseln, aber auf dem Bildschirm des Kontrollraums ist nur Rauschen zu sehen.")
	await novel_interface.show_text_only("Wir blicken nach oben und sehen, dass die Kamera im Raum bereits durch einen Stromschlag völlig zerstört wurde.")
	await novel_interface.show_text_only("Nach einem Moment taucht der Mann wieder auf dem Flur auf, mit einem etwa 1,6 Fuß breiten Alu-Koffer in der Hand.")
	await novel_interface.show_text_only("Das Schloss des Koffers scheint kaputt zu sein. Er öffnet den Koffer und holt drei Glasgefäße heraus.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... Was genau macht er?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eines der Glasgefäße ist zerbrochen. Der Mann starrt darauf, zögert ein wenig, dann steckt er die beiden unversehrten in die Tasche.")
	await novel_interface.show_text_only("Vorsichtig versucht er, die Waffen aus den geballten Fäusten des Mädchens zu befreien. Da fällt irgendwo aus ihrem T-Shirt ein Notizbuch heraus.")
	await novel_interface.show_text_only("Der Mann hebt es auf, blättert es durch und stopft es dann wieder in das Outfit des Mädchens.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Als würde er ein Baby tragen, nimmt er das schlanke, gebrechliche Mädchen vorsichtig in seine Arme. Seine Bewegungen sind liebevoll und zärtlich.")
	await novel_interface.show_text_only("Er trägt sie im Brautstil bis zum Ende des Tunnels, wo er die schwarze Karte gegen die Wand klopft.")
	await novel_interface.show_text_only("Die Wand gleitet zur Seite und die beiden verschwinden gemeinsam in der Dunkelheit...")
	await novel_interface.show_text_only("... Hier enden die Aufnahmen.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("In allen darauffolgenden Videoaufnahmen herrscht eine längere Zeit der Leerstelle. Und der Mann taucht im Rest des Filmmaterials nie wieder auf.")
	await novel_interface.show_text_only("Tatsächlich gibt es in dem Filmmaterial nichts Sehenswertes, dem man folgen könnte. Nichts, bis wir drei am Eingang der Basis auftauchen.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Das ist seltsam...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Warte, schau.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael zeigt auf den Bildschirm, der die Krankenstation zeigt.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("War dort nicht eine Leiche? Es ist... weg.","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tatsächlich sind alle Leichen verschwunden...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Das bedeutet, dass die Kampfschauplätze während der Leerstellen im Filmmaterial vollständig aufgeräumt waren.")
	await novel_interface.show_text_only("Wir fangen an, noch einmal nachzuschauen und sehen uns frühere Aufzeichnungen an.")
	await novel_interface.show_text_only("Es gelingt uns, Filmmaterial zu finden, das dokumentiert, was mit dem Mädchen und ihrer Truppe passiert ist.")
	await novel_interface.show_text_only("Das letzte Bild, das wir sehen und das von der Kamera im Kontrollraum aufgenommen wurde, zeigt eine Dame in einem Schneeanzug, die das schwarzhaarige Mädchen mit einer Waffe aus der Tür drängt.")
	await novel_interface.show_text_only("Hier endet die Aufnahme.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... Das ist also hier passiert...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich verlasse die Datenschnittstelle und rufe die Echtzeit-Überwachungsaufnahmen auf.")
	await novel_interface.show_text_only("Wir berichten über den Haupteingang, den Ausstellungsraum, die Korridore, das Archiv, die Tunnel... und einige andere Orte, an denen wir noch nicht waren.")
	await novel_interface.show_text_only("Als ich den Bildschirm überfliege, auf dem Echtzeitaufnahmen zu sehen sind, fällt mir plötzlich ein, dass der Kampf, den wir draußen vor dem Archivraum ausgetragen haben, nicht aufgezeichnet wurde. Überhaupt.")
	await novel_interface.show_text_only("Dem Video zufolge betraten wir drei den Archivraum vom Flur aus und verließen ihn nie wieder. Stattdessen kamen wir durch eine Öffnung auf der anderen Seite in den Tunnel.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Fand dieser Kampf also in einem „Traum“ statt? Wie seltsam...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Und wer hat den Ort aufgeräumt?","Raphael")
	await novel_interface.show_dialog("... Jemand muss sich auch in das Filmmaterial eingemischt haben.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Wir können nicht einmal Aufnahmen von dem großen Mann finden, der das Gelände verlässt.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich durchsuche mechanisch die Echtzeitüberwachungsbildschirme, während wir drei über die Identität des Mädchens und des Mannes diskutieren, die wir gerade gesehen haben.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Warte...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es liegt für uns nahe zu glauben, dass jemand die Aufnahmen manipuliert hat und wir uns in einem „Traum“ befanden.")
	await novel_interface.show_text_only("Was unvernünftig ist, ist –")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Warum können wir das Echtzeitmaterial des Archivraums sehen?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael und Henriette erstarren sofort.")
	await novel_interface.show_text_only("Für ein paar Sekunden ist es im Raum unheimlich still.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Haben wir nicht...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... Ziehen Sie das Kabel heraus, bevor Sie den Raum verlassen?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
