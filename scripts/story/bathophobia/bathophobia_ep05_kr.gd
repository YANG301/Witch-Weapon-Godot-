# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("『영혼』이란 무엇일까？")
	await novel_interface.show_text_only("의식이 기록되어 있는 에너지 혹은 측정 불가능한 양자 상태의 존재일까?")
	await novel_interface.show_text_only("어쩌면 『영혼』은 그저 일종의 개념일 수도 있다.")
	await novel_interface.show_text_only("마치 물리학에서 말하는 『시간』이라는 개념처럼──")
	await novel_interface.show_text_only("단순한 환각이나……꿈일 수도 있다.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("그렇다면 남은 문제는──")
	await novel_interface.show_text_only("꿈의 주인은 누구일까?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("남극 수렴대 구역，뼈를 찌르는 추위가 외부의 모든 것을 배척하는 것 같다.")
	await novel_interface.show_text_only("해수면 6100미터 아래，심연의 바다.")
	await novel_interface.show_text_only("티타늄합금 장갑으로 둘러싸인 잠수함이 천천히 가라앉고 있다.")
	await novel_interface.show_text_only("선체의 상태표시등이 미약한 빛이 10센티미터 밖을 나가지 못하고 어둠에 삼켜진다.")
	await novel_interface.show_text_only("한 줄기 빛조차 없는 곳，아무것도 감지할 수 없는 공간이 되어버린다.")
	await novel_interface.show_text_only("괴이한 색채의 귀신고기가 선체에 충돌했지만 어떠한 반응도 없다.")
	await novel_interface.show_text_only("60Mpa의 거대한 수압이 잠수함의 한계를 시험하고 있다.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("갑자기 잠수정에 장착된 8개의 탐조등이 동시에 켜지면서 여덟 개의 기다란 빛기둥을 형성한다.") #换行问题
	await novel_interface.show_text_only("어둠을 꿰뚫는 장검처럼 갑자기 눈부신 빛을 뿜는다.")
	await novel_interface.show_text_only("한줄기 빛이 두꺼운 창을 뚫고 선체에 잠들어있는 소녀를 비춘다. ")
	await novel_interface.show_text_only("잿빛의 긴 머리카락에 하늘색이 반사되어 옥처럼 맑고 깨끗한 소녀의 얼굴에 부드럽게 흩어진다.")
	await novel_interface.show_text_only("그녀 앞 조작대 위의 깊이 탐측기는 이미 고장이 나，여전히 1247M에 멈춰 있다.")
	await novel_interface.show_text_only("외부 탐조등의 빛이 천천히 어두워지고 소녀의 몸 주위에 미세한 은백색 빛이 반짝인다.")
	await novel_interface.show_text_only("인간의 무서운 상상을 불러일으키기 충분한 바다 깊은 곳，저 멀리서 은은한 목소리가 들린다.")
	await novel_interface.show_text_only("마치 고대의 부름인 것처럼.")
	await novel_interface.show_text_only("깊이 잠들었던 소녀가 깨어난 것 같다.")
	await novel_interface.show_text_only("잠에서 깨어나자 현기증과 참을 수 없는 구토감이 몰려온다……")
	await novel_interface.show_text_only("깊이 4500M의 설계 안전선을 초과한 잠수함의 금속 장갑이 괴음을 내기 시작한다.")
	await novel_interface.show_text_only("소녀가 폐부가 억눌리는 기침을 쏟아낸다.")
	await novel_interface.show_text_only("몇 번의 호흡 후 호흡이 안정되기 시작했다.")
	await novel_interface.show_dialog("방금 충돌로…정신을 잃은 것 같아.", "소녀")
	await novel_interface.show_dialog("호흡과 산소 함량도 정상이다.", "소녀")
	await novel_interface.show_dialog("입김이 서리는 걸 보니…역시\\n선내는 이미 0도에 가까워진 걸까?", "소녀")
	await novel_interface.show_dialog("메인 시스템 점검，콜드 부팅 준비\\n식별 정보: 바이츄.", "소녀")
	await novel_interface.show_text_only("바이츄는 저온으로 몸이 상하는 것은 아랑곳하지 않고 각 시스템을 점검하기 시작한다.")
	await novel_interface.show_text_only("이것은 그녀의 타고난 능력으로，\\n아직 아기였던 그녀를 처음 발견했을 때，\\n얼음으로 뒤덮힌 산에서 밤을 보낸 적도 있다.")
	await novel_interface.show_text_only("이후 한 차례 검사를 통해 이 기적 같은 소녀가 혹한의 환경에 적응할 수 있다는 것을 발견했다.")
	await novel_interface.show_text_only("성인이 30초 안에 의식을 잃는 극한 저온에서도 그녀는 정상 체온을 유지할 수 있으며，심지어 손이 따듯하기까지 하다.")
	await novel_interface.show_text_only("양부모가 바이츄를 고아원에서 거둬들일 때까지 병원조차 원인을 찾아내지 못했다.")
	await novel_interface.show_dialog("조명 동력 시스템 정상，센서 장치도 OK.", "바이츄")
	await novel_interface.show_dialog("6000미터 아래로 가라앉다니…『그것』이 이렇게 수압이 높은 곳에 있지는 않겠지?", "바이츄")
	await novel_interface.show_dialog("돌아가려면 전기를 아껴야해…우선 탐조등을 모두 끄자──", "바이츄")
	await novel_interface.show_text_only("탐조등이 꺼지기 직전，바이츄는 잔광으로 창문 밖을 관찰했다.")
	await novel_interface.show_dialog("뭐지…", "바이츄")
	await novel_interface.show_text_only("그 놀라운 장면은 순식간의 소녀를 바짝 굳게 만들었다.")
	await novel_interface.show_dialog("저건…뭐야…?", "바이츄")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("탐조등이 꺼지기 직전 창문 밖에 거대한 산호형 조직을 비췄다.")
	await novel_interface.show_text_only("울툴불퉁한 선홍색 조직은 \\n마치 폭포처럼 중앙이 움푹 파여，\\n거대하고도 깊은 동굴이 형성됐다.")
	await novel_interface.show_text_only("하지만 방금 주위 지역을 스캔했을 때 생물이나 지형 구조를 발견하지 못했다.")
	await novel_interface.show_text_only("바이츄는 더 자세히 보기 위해 즉시 선체 밖의 광각 렌즈를 열었다.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("스크린에 가로 길이 90미터 이상의 촉수가 자란 거대하고도 모호한 그림자가 보인다.")
	await novel_interface.show_dialog("어떻게 이럴수가…", "바이츄")
	await novel_interface.show_text_only("저건 지형 구조가 아니라 생물이 확실하다. 어둠 속에서 움직이는 붉은색 광반이 보인다.")
	await novel_interface.show_dialog("저건…눈인가?", "바이츄")
	await novel_interface.show_text_only("──만약 저 말도 안되는 물건이 \"눈\"이라면.")
	await novel_interface.show_text_only("관찰창 맞은편의 움푹 들어간 동굴은 눈동자일 것이다.")
	await novel_interface.show_text_only("거대한 물체와 밀접한 나머지 거리를 판단할 수 없다. \\n언제든지 빨려들어갈 것만 같다.")
	await novel_interface.show_text_only("움직이던 광반이 점점 사라지자，\\n조용한 어둠 속에서 소녀와 말로 설명할 수 없는 물체가 대치하게 되었다.")
	await novel_interface.show_text_only("어두운 환경에 적응하니，거대한 눈이 발하는 미약한 붉은 빛이 보인다. 마치 불투명한 해파리 같다.")
	await novel_interface.show_text_only("눈 안에 언제든 튀어나올 것 같은 조직물이 가득 차 있다.\\n움직일 때마다 소녀의 심장소리와 겹친다. ")
	await novel_interface.show_dialog("（진정……진정해야 해！）\\n（잘 생각해보자……）", "바이츄")
	await novel_interface.show_text_only("저게 정말 눈이라면 수정제 위치는 광선에 굉장히 민감할 것이다.")
	await novel_interface.show_text_only("안구 아래，맥락막 구조의 위치에서 촘촘한 하얀 빛이 어둠 속에서도 빛나고 있다.")
	await novel_interface.show_text_only("안구 뒤에 나뭇가지 같은 촉수가 연결된 것이 보인다.")
	await novel_interface.show_text_only("밝은 검정색의 촉수가 바다 깊은 곳에 잠겨 끝이 보이지 않는다.")
	await novel_interface.show_dialog("（……몸을……움직일 수 없어……）", "바이츄")
	await novel_interface.show_text_only("——대치라기 보다는，\"그 물건\"이 일방적으로 소녀를 관찰하고 있다고 해야 할 것이다.")
	await novel_interface.show_text_only("극심한 압박감에 당황한 소녀의 의식이 점점 흐려지고 있다.")
	await novel_interface.show_dialog("하…", "바이츄")
	await novel_interface.show_text_only("——삼켜질까?")
	await novel_interface.show_text_only("심해가 주는 이상한 느낌이 그녀가 스스로의 존재를 의심하게 만든다.")
	await novel_interface.show_dialog("（꿈일까……）\\n（꿈이라면 빨리 깨어나고 싶어……）", "바이츄")
	await novel_interface.show_text_only("몸이 본능에 의지해 의식보다 빨리 구속에서 벗어났다.")
	await novel_interface.show_text_only("소녀가 왼손으로 조이스틱을 당기자 잠수실은 안구를 향해 일정 거리만큼 계속해서 움직였다.")
	await novel_interface.show_text_only("물의 파동이 \"그것\"이 깜짝 놀랐다는 것을 보여준다.")
	await novel_interface.show_text_only("동공이 수축하며 소녀의 다음 행동을 관찰한다.")
	await novel_interface.show_dialog("저기요? 저기요?", "바이츄")
	await novel_interface.show_text_only("바이츄가 끼고 있던 헤드셋을 만지며 안내 카운터 너머의 사람과 소통을 시도한다.")
	await novel_interface.show_text_only("깊은 바다는 그 어떤 전자파도 차단하기에 충분했다. 또 다시 수중 통신이 끊어졌다.")
	await novel_interface.show_dialog("……", "바이츄")
	await novel_interface.show_text_only("만약 그녀라면 꼭 내게 외쳤을 것이다——\\n“더 이상 가지 마！”")
	await novel_interface.show_dialog("하하…왜 이런 생각을 하고 있는 거야…", "바이츄")
	await novel_interface.show_dialog("그녀는 또 누구지?", "바이츄")
	await novel_interface.show_dialog("여긴…어디야…?", "바이츄")
	await novel_interface.show_text_only("안구가 주시하고 있다는 압박에 바이츄의 정신이 흐려지고 진실과 허구의 경계가 애매해져 간다.")
	await novel_interface.show_text_only("소녀의 손이 긴장한 듯 콘솔 위를 훑는다.")
	await novel_interface.show_text_only("그녀가 빠르게 표본 기계팔의 조작기기를 찾아냈다.")
	await novel_interface.show_dialog("(정말 이렇게 해야 하는 걸까…?)", "바이츄")
	await novel_interface.show_text_only("바이츄는 정신을 붙잡았다. 하지만 환각같은 광반이 전과 같이 그녀의 눈앞에 나타났다.")
	await novel_interface.show_dialog("샘플을 추출해서 빨리 떠나야해…", "바이츄")
	await novel_interface.show_text_only("우선 탐조등을 정면 방향으로 모두 조정한다.")
	await novel_interface.show_text_only("동력 시스템을 최대 항속으로，방향은…후퇴로 설정한다.")
	await novel_interface.show_text_only("소녀가 정신을 억지로 다잡고 모든 사전 설정을 마치자，곧 기절할 지경이다.")
	await novel_interface.show_dialog("아버지 이게 바로…정신 오염일까요…\\n곧…", "바이츄")
	await novel_interface.show_text_only("바이츄가 천천히 조작기를 조정한다. 기계팔을 천천히 뻗어 거대한 주사 바늘을 꺼냈다.")
	await novel_interface.show_dialog("샘플 추출 모드…이 정도 압력이라면…", "바이츄")
	await novel_interface.show_text_only("주사 바늘이 기계팔 이동을 따라 안구의 유리체를 찔렀다.")
	await novel_interface.show_text_only("표본 용기의 함유량이\\n 순식간에 0%에서 100%으로 올라갔다.") #标点删除
	await novel_interface.show_text_only("안구의 동공이 변형되기 시작한다. 소리가 있다면 분명 뼈를 찌르는 비명소리일 것이다.")
	await novel_interface.show_dialog("(환청인가…?)", "바이츄")
	await novel_interface.show_text_only("소녀가 마지막 힘을 다해 시스템 실행 버튼을 누른다.")
	await novel_interface.show_text_only("방금 전의 설정에 따라 \\n잠수함의 8개 전조등이 동시에 안구의 동공에 강한 빛을 쏘며，프로펠러가 빠른 속도로 회전한다.")
	await novel_interface.show_text_only("자극과 강한 빛에 안구가 뒤로 물러나고 잠수함은 유유히 떠오른다…")
	await novel_interface.show_text_only("기력을 모두 소진한 소녀는 눈 앞이 깜깜해지며 그대로 쓰러졌다.")
	
