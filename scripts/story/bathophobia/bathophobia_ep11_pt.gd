# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("O que é a realidade?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Talvez a realidade como a conhecemos seja apenas um jogo de computador.")
	await novel_interface.show_text_only("Faça login, os personagens acordam; saia e eles adormecem. Quando as contas são encerradas, eles morrem.")
	await novel_interface.show_text_only("Com o passar do tempo, eles desenvolvem a percepção da alma.")
	await novel_interface.show_text_only("Eles acreditam que todas essas ações pré-programadas são realizadas por livre arbítrio.")
	await novel_interface.show_text_only("Fórmulas, leis, regras gramaticais, códigos de conduta… cada personagem recebe essas regras para seguir sem saber quem as criou… até que sejam finalmente libertados.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Mesmo que uma grande parte do céu fique pixelizada devido a um erro de renderização—")
	await novel_interface.show_text_only("Eles apenas racionalizaram isso com contos de fadas ou crenças religiosas, em vez de admitir que isso está além do seu conhecimento.")
	await novel_interface.show_text_only("Porque aceitar o desconhecido significa a possibilidade mais perturbadora –")
	await novel_interface.show_text_only("Que a chamada realidade pode não passar de uma ilusão.")
	await novel_interface.show_text_only("Um sonho impossível.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Abro os olhos lentamente e me encontro em uma névoa.")
	await novel_interface.show_text_only("Estou cercado pela névoa. Estranhamente, fios de gotas de chuva estão pendurados no ar.")
	await novel_interface.show_text_only("Estendo a mão e tento tocá-los, mas eles evaporam imediatamente.")
	await novel_interface.show_dialog("Onde estou…", "Lian")
	await novel_interface.show_text_only("Estou em uma superfície sólida e posso sentir a gravidade. Mas não consigo ver o chão... como se minha visão estivesse absorvida pelo vazio.")
	await novel_interface.show_text_only("Há um zumbido incomum ao fundo. Sem qualquer quadro de referência, as direções são imperceptíveis.")
	await novel_interface.show_text_only("Eu olho para cima e vejo o contorno de um totem parecido com uma árvore flutuando bem acima de mim.")
	await novel_interface.show_text_only("Ele se espalha como um cobertor brilhante no céu.")
	await novel_interface.show_text_only("Dez anéis no totem giram lentamente, um deles emitindo um raio avermelhado.")
	await novel_interface.show_text_only("Então, um enorme padrão composto de linhas e inscrições se desdobra sob meus pés, formando o que pode ser chamado de chão.")
	await novel_interface.show_text_only("O totem no chão é igual ao que está no ar, mas parece muito maior a curta distância.")
	await novel_interface.show_text_only("Os anéis, cada um com cerca de 4,5 metros de diâmetro, são conectados em uma determinada ordem. As inscrições neles parecem antigas.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Estou... sonhando?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fui treinado para identificar alucinações e sonhos...")
	await novel_interface.show_text_only("Qual é aquela pergunta importante de novo…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("—Como vim parar aqui?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As memórias voltam. Eu estava na Base Ark e tudo começou a cair… Aí…")
	await novel_interface.show_text_only("Não. Isto não é um sonho.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Isso tem alguma coisa a ver com aquela garota?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ela me chamou de Mestre, e até…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aww— \\nNão… Não é hora para fantasias…")
	await novel_interface.show_text_only("Onde está Annie? E Raphael?")
	await novel_interface.show_text_only("Eles também devem ser sugados para este lugar!")
	await novel_interface.show_text_only("Olho em volta na névoa em busca deles. Inesperadamente, um par de braços quentes me segura por trás.")
	await novel_interface.show_dialog("Não se preocupe, Mestre—", "Garota loira")
	await novel_interface.show_text_only("É ela! \\nA garota nua está me abraçando pelas costas!")
	await novel_interface.show_text_only("Tenho muitas perguntas para ela. Mas hesito em olhar para trás...")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Mestre… Que estranho!) \\n(Assim como os esquisitos nos filmes de desenho animado!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela parece estar tateando em busca de alguma coisa. Suas mãos rastejam pela minha cintura e param na minha barriga lisa.")
	await novel_interface.show_text_only("No silêncio, posso ouvir meu coração batendo rápido enquanto sua respiração faz cócegas em meu cabelo...")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(O que... ela vai fazer?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah?","Garota loira")
	await novel_interface.show_text_only("Ela parecia ter descoberto algo interessante. Ela pressionou levemente com a palma da mão e meu estômago imediatamente soltou um som insatisfatório de “gorgolejo”.")
	await novel_interface.show_text_only("Neste ambiente silencioso, este som é particularmente perceptível.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Eh? Por que…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ahhhhhhh… Tão embaraçoso…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me afasto dela. Ela caminha até mim e me olha com curiosidade.")
	await novel_interface.show_dialog("O corpo do Mestre também foi modificado? \\n… Que produto perfeito da alquimia!","Garota loira")
	await novel_interface.show_text_only("Quero cobrir os olhos, mas percebi que ela já está vestida.")
	await novel_interface.show_text_only("Espere, ela acabou de dizer que meu corpo foi modificado?! \\nE… o que ela está vestindo?")
	await novel_interface.show_text_only("Uma olhada no traje de Heinrich é suficiente para revelar seu material de última geração.")
	await novel_interface.show_text_only("A julgar pela textura e design, não pode ser feito no século 16... Não, está além do artesanato moderno.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(As informações de Mariru estão erradas?) \\n(E como ela sabe sobre a transformação do meu corpo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Enquanto tento verbalizar meus pensamentos, alguém me dá um puxão repentino para trás.")
	await novel_interface.show_text_only("É Raphael. Ela me agarra pelo capuz, dá um passo à frente e fica entre mim e Heinrich.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Me conta, quem é você?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("—Bem?", "Garota loira")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich se vira para Raphael com um sorriso desdenhoso no rosto.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Você está perguntando meu nome? \\nTenho centenas deles.", "Garota loira")
	await novel_interface.show_dialog("Mas você pode me chamar de Henriette Khunrath – é essa que está no Contrato.", "Garota loira")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Isso não é engraçado!", "Raphael")
	await novel_interface.show_dialog("Heinrich é um homem em todos os registros históricos -", "Raphael")
	await novel_interface.show_dialog("E além disso, olha o que você está vestindo! \\nVocê confundiu roupa íntima com agasalhos?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Não contamine Heinrich, o grande alquimista, sua garota sem-vergonha! Pare de chamar as pessoas de “mestre” e… e pegue a essência das pessoas…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael cora enquanto fala.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… Quem diabos é você!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Enquanto eles se enfrentavam, não pude deixar de espiar Heinrich pelas costas de Raphael.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Qual é o material da fantasia dela…) \\n(Envoltório incrível! Como os seios dela podiam tremer em direções diferentes?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nossos olhos se encontram e eu coro imediatamente. Em pânico, olho para minha saia, evitando mais contato visual.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Bem? Achei que o Mestre não ficaria impressionado com sua própria obra-prima…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não, não, não, eu sou (ou fui) um menino...")
	await novel_interface.show_text_only("Heinrich aponta para o peito dela.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Maiores do que eram... Esse é o gosto do Mestre?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael olha para trás e me lança um olhar severo.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Não! Eu não! Eu não!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Acabei de quebrar o tesouro nacional de Salmonton por acidente…")
	await novel_interface.show_dialog("E, por favor, não me chame de mestre... Apenas me chame de Ren.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ren...? \\nEu não esperava que uma pessoa incrível como você tivesse um nome tão lindo…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("E você? Você é mesmo Heinrich?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela hesita, olha os números em seu pulso e suspira levemente.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Já são 400 anos…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Espere, há algum relógio ou calendário no pulso dela!?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Eu me passei por homem para fazer pesquisas, publicar artigos ou praticar medicina.", "Henriette")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Portanto, não estou surpreso com a forma como a história me registra.", "Henriette")
	await novel_interface.show_dialog("Na minha época, as universidades não admitiam meninas e a igreja proibia as mulheres de praticar medicina.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Muito menos me tornar um alquimista... Hmm, não quero ter problemas com o tribunal religioso.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…\\n", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De alguma forma, começo a ficar indignado cada vez que aprendo sobre a opressão das mulheres.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("É fácil livrar-me desses cães da corte, mas eles não valem o meu tempo.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Uau… parece legal…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael olha para Heinrich pensativa.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Espere, como você entrou na universidade quando era menino? \\n", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, estou curioso para saber como ela entrou. Talvez...")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Simplesmente cortei o cabelo curto, forjei várias referências e entrei na Universidade de Leipzig sob pseudônimo.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Apenas um corte de cabelo?", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_text_only("Eu olho para o peito dela. As pessoas de 400 anos atrás eram todas cegas?")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu tinha dez anos então. O vestibular foi muito fácil.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich sorri com desdém.")
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Hein? Deixa para lá.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Não importa como o mundo mude, crianças prodígios são sempre incríveis!")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Então como você explica essa fantasia?", "Raphael")
	await novel_interface.show_dialog("Heinrich era médico e alquimista, mas sua armadura e arma são obviamente para batalhas.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich dá um passo para trás, sorrindo.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ah, desculpe, a culpa é minha.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela pressiona a mão direita no peito e a fantasia começa a rachar.")
	await novel_interface.show_text_only("Seu corpo, agora rodeado por fitas azuis e brancas e cristais coloridos, começa a brilhar.")
	await novel_interface.show_text_only("Quando a luz azul e dourada começa a desaparecer, seu corpo gradualmente…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Gradualmente… Eh?")
	await novel_interface.show_text_only("Raphael corre e cobre meus olhos firmemente com as mãos.")
	await novel_interface.show_dialog("Chega! Eu vejo!", "Raphael")
	await novel_interface.show_dialog("Vista sua roupa, exibicionista!", "Raphael")
	await novel_interface.show_dialog("Tem também travesti, o que você está olhando!", "Raphael")
	await novel_interface.show_text_only("Eu não vi nada!!")
	novel_interface.show_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Quando Raphael tira as mãos, Heinrich já está vestido com a mesma fantasia novamente. Ugh…")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Este é um traje de batalha mágico, semelhante ao do Master. Mas o meu é feito por seres superiores.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Quanto ao design… receio que The One tenha um gosto terrível…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Aquele?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Eu fiz a Porta para este espaço usando técnicas alquímicas.", "Henriette")
	await novel_interface.show_dialog("Os mortais não deveriam saber a verdade... Então tive que pagar o preço. Aquele me forçou a assinar um contrato referente à minha alma…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich parece um tanto desamparado.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Resmungando) Da última vez meu corpo foi completamente feito em pedaços, mas o contrato ainda pode ser ativado com um novo corpo...", "Henriette")
	await novel_interface.show_dialog("Por que você não me dá um tempo...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Enquanto me pergunto o que Heinrich está dizendo, a voz trêmula de Annie de repente vem da névoa.")
	await novel_interface.show_dialog("Ren—", "Annie")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Skuld?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corremos em direção ao local de onde veio a voz e encontramos Annie caído no chão, tremendo.")
	await novel_interface.show_dialog("H... Socorro...", "Annie")
	await novel_interface.show_dialog("… Não… Por favor…", "Annie")
	await novel_interface.show_text_only("Eu rapidamente dei um passo à frente para confortar Annie, e no momento em que minha mão tocou seu corpo——")
	await novel_interface.show_text_only("Uma brisa viscosa e quente flui pela minha mão e passa rapidamente por mim.")
	await novel_interface.show_text_only("Olho em volta, mas não encontro nada de incomum, exceto que Heinrich está me olhando perplexo.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Você ficará bem, Annie!", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Skuld?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por alguma razão, Annie está tremendo violentamente.")
	await novel_interface.show_text_only("Entendo que lugares desconhecidos trazem preocupação… Mas não há sinal de inimigos no vasto espaço vazio.")
	await novel_interface.show_text_only("Eu seguro Annie perto, tentando confortá-la.")
	await novel_interface.show_text_only("Vendo isso, Raphael volta-se para Heinrich novamente.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Você mencionou este espaço… É a Fenda da Causalidade?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Esse é o nome inscrito na Árvore da Vida…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Árvore da Vida?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Por que você nos trouxe aqui? O que você quer de nós?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich dá de ombros.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Eu não.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Na verdade, você não poderia estar aqui...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("… Sem a intenção do Único… ou mesmo de seres mais superiores.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Quem é o único?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sou obrigado a não chamá-lo pelo nome… Mas O Único tem títulos demais…", "Henriette")
	await novel_interface.show_dialog("A Verdade, o Caminho, a Porta…", "Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Do começo… ao fim.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…?!", "Raphael")
	
	print("=== 深海恐惧篇第11话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
