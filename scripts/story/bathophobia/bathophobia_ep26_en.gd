# bathophobia_ep26.gd - 深海恐惧症篇第26话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep26_script()

func play_script():
	pass

func bathophobia_ep26_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation1.png")
	await novel_interface.show_text_only("Who am I?")
	await novel_interface.show_text_only("The ego takes up most of the space in a human’s consciousness.")
	await novel_interface.show_text_only("Everything is always more important if it concerns “me”.")
	await novel_interface.show_text_only("My room, my laptop, my phone, my backpack, my feelings, my memories...")
	await novel_interface.show_text_only("These concepts are always more special to us, because our brains repackaged them meticulously, granting them new meanings besides their original existences.")
	await novel_interface.show_text_only("“I am special”. That’s what your brain wants you to believe.")
	await novel_interface.show_text_only("In order to truly believe in something, humans seek all types of evidence.")
	await novel_interface.show_text_only("The evidence can come from the most random places. Magazine articles, exams, encounters, dreams...")
	await novel_interface.show_text_only("As long as you want to believe something is true, you’ll find the logic you’re seeking for everywhere you look.")
	await novel_interface.show_text_only("That’s an effect psychologists call “subjective validation”.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Of course, you’re allowed to say: “I must be special, as long as I believe I am!”")
	await novel_interface.show_text_only("Well, then, here’s the question:")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Subjective_Validation2.png")
	await novel_interface.show_text_only("Is your ego even real?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("All three of us remain quiet as we trek towards the end of the tunnel after exiting the control room.")
	await novel_interface.show_text_only("Henriette slices a huge hole in the wall, in the spot the man we saw in the footage passed through.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Metal_Corridor.png")
	await novel_interface.show_text_only("Behind the wall is a long, narrow passageway, with some sort of firm, yellow metal papering the walls.")
	await novel_interface.show_text_only("Even the tourmaline can only light up a small section in the pitch-black passage.")
	await novel_interface.show_text_only("We walk on in silence, our footsteps echoing in the corridor. Everything is so surreal right now.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Are we... still in the “dream” of... whoever it is?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Probably. And the situation is likely messier than we expected.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl explains with a solemn expression, shaking the tourmaline, which she’s using as a temporary flashlight.")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("The electric explosion trap in the control room must have be “real”. The power it released could have roasted our internal organs.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("My battle suit took the brunt of the damage, but it still hurts...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("When we’re dreaming, don’t we wake up immediately when we experience sudden, strong stimulation... such as pain?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Yeah. But that probably doesn’t apply in this “dream”. We most likely won’t wake up even if we die.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("But as long as one of us finds a way to wake up—no matter what way—it should bring all of us back to reality.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Or else we’ll just... continue sleeping in this nightmare forever...?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael’s voice trembles. She’s been hanging on to the hem of my shirt ever since we entered the passageway.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(She’s probably afraid of the dark...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, my body alerts me to a totally serious issue.")
	await novel_interface.show_text_only("I clutch at the watch that we’ve brought with us from the control room.")
	await novel_interface.show_text_only("During my investigations, I accidentally found some information in this watch.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("(Or, instead of information, should I say... an audio recording?)","Lian")
	await novel_interface.show_dialog("I hope we can find the answer we want, and soon.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I force myself to walk faster.")
	await novel_interface.show_text_only("Gotta hurry.")
	await novel_interface.show_text_only("Because, after all, anyone with common sense should know this...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("(When you dream that you’re peeing, this usually means...)\\n(Ugh, it can’t get any worse than that!)","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("We finally arrive at what looks like a lab after shoving open a heavy metal door.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("This should be it...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Unlike the other areas of the base, the lab is abnormally quiet. The walls and floor seem to be made of sound-absorbing material.")
	await novel_interface.show_text_only("Dozens of culture tanks loom silently in the dimly-lit space. The only source of light is the flickering pale blue indicator lights on the devices.")
	await novel_interface.show_text_only("On the ceiling, we see tons of cables and pipes, arranged in an orderly way.")
	await novel_interface.show_text_only("Even by the high standards of New Opulentia Academy of Sciences, this is quite a well-equipped lab.")
	await novel_interface.show_text_only("We soon locate the only piece of equipment that is still working...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("The temperature in the room is close to the freezing point. The light blue liquid in the tank silently, patiently keeps guard over its protege.")
	await novel_interface.show_text_only("Long raven hair, porcelain skin—the girl slumbering in what looks like a light blue ocean is the same one we saw in the surveillance camera footage.")
	await novel_interface.show_text_only("Her skin still has color, limbs swaying naturally in the liquid. A stream of bubbles come steadily floating from her mask. All this must mean—")
	await novel_interface.show_dialog("She’s... alive?","Raphael")
	await novel_interface.show_dialog("And she’s in the dream too? Or...","Lian")
	await novel_interface.show_text_only("Henriette stops in front of the tank, presses her hand on the glass and shakes her head.")
	await novel_interface.show_dialog("This device is simply keeping her alive, delaying the inevitable.","Henriette")
	await novel_interface.show_dialog("(Whispers) Strange...","Henriette")
	await novel_interface.show_text_only("The blond girl observes the machines curiously and finally circles to the back of the tank.")
	await novel_interface.show_dialog("Ah, just like I expected.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("Raphael and I follow to see that the girl’s wound is still present, visible under her tattered dress.")
	await novel_interface.show_text_only("Though it’s less of a wound and more of a clean-cut surface. Like a cross section.")
	await novel_interface.show_text_only("Like it’s been sliced open by a box knife. The skin, muscles, bones... all neatly laid out in front of our eyes.")
	await novel_interface.show_text_only("Her body doesn’t seem to have realized this. None of the usual reactions can be seen—no bleeding, no hyperplasia, the skin around the wound isn’t even infected or swollen.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("The spear seems to have erased even the concept of “injury” itself. The body has no idea it needs to attempt to heal.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Too many of her organs and nerves have been pierced through. She would last mere minutes if not attached to this device.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Though I can’t tell how exactly this happened, it seems that the other parts of her body should have already recovered enough for her to regain consciousness.)","Henriette")
	await novel_interface.show_dialog("(If this is her dream we’re in, we have to find a way to wake her.)","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, a blob of faint white light flickers into sight on the girl’s body.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("…","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A shrewd smile creeps upon the blond girl’s face.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("(The only way to wake the Sleeping Beauty...)","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Master, check her breathing over there for me, won’t you?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Oh.","Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesclosed.png")
	await novel_interface.show_text_only("I return to the front and look up at the girl in the tank. She’s breathing, yes, though very slowly.")
	await novel_interface.show_dialog("Pretty...","Lian")
	await novel_interface.show_text_only("I reach out instinctively, fingers itching to touch the tank, but Raphael whacks me on the back.")
	await novel_interface.show_dialog("Bet you’re thinking about pervy stuff again, huh?","Raphael")
	await novel_interface.show_dialog("N-no!\\nI’m not that kind of person...","Lian")
	await novel_interface.show_text_only("Through the liquid in the tank, I can see Henriette on the other side, fiddling with a few wires and pipes.")
	await novel_interface.show_dialog("(...?)","Lian")
	await novel_interface.show_dialog("She’s waking up!","Henriette")
	await novel_interface.show_dialog("Huh?!","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Baizhu_eyesopen.png")
	await novel_interface.show_text_only("Following a series of crackling sounds, the eyes of the girl in the tank snap open.")
	await novel_interface.show_text_only("Those eyes bore straight into mine...")
	await novel_interface.show_text_only("A pair of bright red, emotionless eyes.")
	await novel_interface.show_text_only("Emotionless, yet so enticing...")
	await novel_interface.show_text_only("Suddenly, a foamy silver glow radiates from her body. The liquid in the tank swells, forming what looks like a whirlpool...")
	await novel_interface.show_text_only("And that girl—she’s glaring at the watch in my hand with the eyes of a predator!")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("With a loud crack, the tank shatters.")
	await novel_interface.show_text_only("In a glorious, silvery explosion, the blue liquid devours Raphael and I like a tsunami.")
	await novel_interface.show_text_only("The girl is free now. And judging from her eyes, she wants me dead.")
	await novel_interface.show_text_only("But she barely moves half an inch before crumpling like a kite with a broken string.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, no!","Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Eh? Did I fall?) \\n (My head hurts...)","Lian")
	await novel_interface.show_dialog("(Why is it so cold? Oh, yeah, the liquid from the tank...)\\n(Not even the Fire Jade can help with that...)","Lian")
	await novel_interface.show_dialog("(Oh no, is she... on me?)","Lian")
	await novel_interface.show_dialog("(Wait, if that’s the case, what my fingers are touching is someone else’s—)","Lian")
	await novel_interface.show_text_only("By my ear, a warm blast of air.")
	await novel_interface.show_dialog("You!","Raphael")
	await novel_interface.show_dialog("Creep! Perv! Stop touching!","Raphael")
	await novel_interface.show_text_only("Thump!")
	await novel_interface.show_text_only("I am elbowed (very heavily) in the stomach.")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Laboratory.png")
	await novel_interface.show_text_only("I sit on the floor amidst the many puddles, dripping wet and utterly confused.")
	await novel_interface.show_text_only("Yes, confused. But somehow, I’m no longer afraid.")
	await novel_interface.show_dialog("Hello? Ren, you copy me?","Mariru")
	await novel_interface.show_text_only("Oh. It’s Mariru. Speaking from the walkie-talkie.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru exhales in relief when she hears my weary response.")
	await novel_interface.show_dialog("What’s going on over there anyway? Do you guys have any idea how long you’ve been MIA?\\nWe’ve already met up with Annie!","Mariru")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("We’re fine, but kind of busy now... we’ll talk to you later.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I turn off the walkie-talkie and refocus on the black-haired girl.")
	await novel_interface.show_text_only("Henriette sits at her side, letting her lean on her shoulder.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("...","Mysterious Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl opens her mouth, desperately trying to form words, but no sound comes out.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Hey, is she okay?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Don’t worry, the wound is healing.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Or, should I say... her body is... resurrecting?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","angry")
	await novel_interface.show_dialog("…","Mysterious Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She seems to be seeking someone, yet no sound will come out. She looks close to tears.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Hey, take it easy, Bethy.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I try to call her by “that name”.")
	await novel_interface.show_text_only("The girl looks at me, puzzled.")
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("How... did you...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her vocal cords seem rusty from disuse.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Beth. That’s your name, right?","Lian")
	await novel_interface.show_dialog("That was what I caught from the recording in the watch...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","shock")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl trains her eyes on the military watch in my hand.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("This belonged to your friend... do you remember?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I gently place the watch into her hand and fold her fingers over it.")
	novel_interface.show_character("baizhu_normal","cry")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her pupils dilate rapidly as she gazes at the watch. Tears pour out uncontrollably.")
	novel_interface.show_character("baizhu_normal","tear")
	await novel_interface.show_dialog("... Milk...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She finally manages to properly utter the name. In her eyes, I see anguish, grief, frustration.")
	await novel_interface.show_text_only("I sat next to Bai Zhu and wanted to comfort her. The moment I touched her shoulder, the girl's head had already dropped weakly to my shoulder.")
	await novel_interface.show_text_only("Beth’s brow crinkles as she snuggles closer into me, watch still tightly clutched in her hand.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("(Softly) Shh... it’s okay, it’s all over now.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I ruffle her hair gently.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("... She must be exhausted.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Well…","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("After all, it’s been nineteen years.")
	
	print("=== 潜渊症篇第26话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
