# bathophobia_ep01.gd - 深海恐惧症篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep01_script()

func play_script():
	pass

func bathophobia_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	await novel_interface.show_text_only("Mariru está fazendo um relatório unilateral em uma reunião a portas fechadas.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("… Isso é tudo que temos sobre o incidente da delegação Salmonton.", "Mariru")
	await novel_interface.show_dialog("Raphilia Dekkers fez outra visita a New Opulentia para fazer algumas “tarefas pessoais”.", "Mariru")
	await novel_interface.show_dialog("Agora, SID a incluiu na lista de proteção de nível A.", "Mariru")
	await novel_interface.show_dialog("Desta vez, porém, Salmonton apresentou todos os detalhes da delegação e uma lista completa de produtos restritos ao Ministério das Relações Exteriores.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Eles até relataram todas as operações militares em que o seu pessoal de segurança se envolveu no passado. Você não consegue encontrar uma única falha nos registros…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Então, parece um aviso de que se algo de ruim acontecer com a neta do Dr. Dekkers, será tudo culpa nossa.", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Humph! Aquela raposa astuta…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Em troca da segurança daquela jovem aqui, porém, eles prometeram uma entrega priorizada de 20% do nosso contrato de compra de produtos agrícolas.", "Eloísa")
	await novel_interface.show_dialog("De acordo com o índice NBOT atual, é como uma oferta.", "Eloísa")
	await novel_interface.show_dialog("Assinei uma ordem executiva para manter a mídia fora de seu rastro por enquanto.", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Eles estão usando o Senado como parte de sua estratégia de criação de mercado?) \\n(E eles sabiam que eu ficaria fora disso…)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Humph… velha raposa astuta…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("A garota é útil para nós. Podemos extrair mais informações dela?", "Bright")
	await novel_interface.show_dialog("Falando francamente, temos estado muito interessados na sua tecnologia de edição genética e nos mega sistemas de estufa.", "Bright")
	await novel_interface.show_dialog("Se ela puder passar algumas horas no meu laboratório...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Dr. Brilhante…", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Você já tem uma grande reputação por seus padrões morais “únicos” em Substance H que afetam a mente humana.", "Mariru")
	await novel_interface.show_dialog("Receio que Salmonton imponha imediatamente sanções comerciais a New Opulentia assim que a jovem entrar em seu laboratório.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Minha reputação? Realmente? \\nHahaha…", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Aham, isso é o suficiente!", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Falando sobre aqueles homens armados desconhecidos no Sky Hotel…", "Kirs")
	await novel_interface.show_dialog("Eles atacaram a delegação Salmonton e pegaram algumas peças de arte valiosas…", "Kirs")
	await novel_interface.show_dialog("SID tem alguma pista?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(A velha raposa escondeu a borboleta dourada do Senado e colocou a culpa em Jacob e sua gangue.)", "Mariru")
	await novel_interface.show_dialog("(Eles desativaram as câmeras de segurança do hotel antes de tomar medidas.) \\n(Há uma lacuna de informação aí…)", "Mariru")
	await novel_interface.show_dialog("Nossas mãos estão atadas na Zona Desmilitarizada Acordada. Segundo diversas fontes, acreditamos que utilizaram armas especiais.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Armas especiais… você quer dizer armas Substance H? \\nEles usaram as armas dentro do campo de proteção de Aegis?!", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("A julgar pelas marcas de queimaduras no chão, acreditamos que eles usaram dispositivos de descarga de alta potência com circuitos de ressonância em série.", "Mariru")
	await novel_interface.show_dialog("Um dispositivo tão complicado é muito volumoso para ser carregado por um soldado individual e praticamente não há como reduzi-lo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("De acordo com depoimentos de testemunhas, naquela noite havia cerca de 10 homens armados com a mesma arma.", "Mariru")
	await novel_interface.show_dialog("De acordo com os registros Aegis, cerca de dez IDs desconhecidos ficaram offline ao mesmo tempo naquela noite. Eles devem ter se retirado do local.", "Mariru")
	await novel_interface.show_dialog("Como SID bloqueou as partidas regulares, eles poderiam ter escapado pelos canais diplomáticos.", "Mariru")
	await novel_interface.show_dialog("(Ou executado por causa de seu fracasso…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… entendo.", "Kirs")
	await novel_interface.show_dialog("As armas Substance H não podem ser produzidas em tão grande escala.", "Kirs")
	await novel_interface.show_dialog("Mas antes que as câmeras fossem desligadas, duas pessoas suspeitas atacaram os guardas no corredor.", "Kirs")
	await novel_interface.show_dialog("Uma delas vestida como empregada daquele hotel, e a outra vestia o uniforme de Gosakuragawa. Você os enviou para lá?", "Kirs")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Um rangido agudo sai da tela.")
	novel_interface.character_light()
	await novel_interface.show_dialog("?!", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Hahaha… Nosso Chefe do Executivo parece muito interessado em gatinhos… Eu também.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Gatinhos?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Ah, citei de Sua Excelência Sra. Mariru.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("(Que dor na bunda…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Annie e Ren, certo? \\nNomes adoráveis…", "#C")
	await novel_interface.show_dialog("Talvez existam outros gatos que Mikakawa criou——", "#C")
	await novel_interface.show_dialog("Estou certo, Mariru?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Hah, obrigado por não vendê-los ao exército de segurança. Eu te devo uma.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Não é grande coisa. \\nParece que você não tem intenção de esconder nada de nós de qualquer maneira.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Então, permita-me interrogá-lo com mais detalhes.", "Mariru")
	await novel_interface.show_dialog("O satélite detectou vários fluxos de espaço-tempo no Sky Hotel, mas SID não tinha o direito de realizar ações lá.", "Mariru")
	await novel_interface.show_dialog("Então enviei dois agentes disfarçados para lá.", "Mariru")
	await novel_interface.show_dialog("Durante a missão, eles se depararam com um grupo de homens armados e um deles atirou em Annie com a arma especial.", "Mariru")
	await novel_interface.show_dialog("Agora o agente está finalmente fora de perigo após tratamentos de emergência, e coletamos algumas estatísticas sobre essa arma.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Por que você não nos contou antes?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Senhor Chefe do Executivo, pergunto-me quais são exactamente as “peças de arte” que desapareceram?", "Mariru")
	await novel_interface.show_dialog("Talvez seja hora de todos nos tornarmos mais abertos ao compartilhamento de inteligência.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("O que você acha?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Por que não começamos com o gatinho que você adotou?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Que chatice… Essa informação não foi suficiente para distraí-lo.)", "Mariru")
	await novel_interface.show_dialog("(Que pé no saco…) \\n(Bem, é hora de testar esses documentos falsos, infelizmente. Hora da história, pessoal.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Vamos começar, meu caro?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Durante a Guerra dos Sete Anos, os cientistas lutaram para desenvolver novas tecnologias que permitissem a ativação do Toque Divino pelos humanos.", "Mariru")
	await novel_interface.show_dialog("Havia rumores de que experimentos de modificação do corpo humano foram conduzidos secretamente em combatentes. Acredito que você já ouviu esses rumores.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("… Hum-hum.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ri, os cantos dos lábios curvando-se ligeiramente para cima.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Algumas pessoas nascem com aptidões especiais, e a New Opulentia Academy of Sciences e o Brain Research Institute têm registros que comprovam isso.", "Mariru")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Na verdade, o Dr. Bright pode ser considerado um deles.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Espere, devo lembrá-lo de que quase todas essas pessoas talentosas são mulheres.", "Bright")
	await novel_interface.show_dialog("No entanto, pessoas com talentos especiais como esse geralmente são colocadas apenas na lista de observação e não há necessidade de controle especial.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Certo. Mas entre todas essas pessoas talentosas, ninguém tem qualquer poder comparável ao Classe B Substance H.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Como os resultados dos experimentos ficaram abaixo das expectativas, esse tipo de pesquisa foi cancelada durante o período da guerra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Essas mulheres com superpoderes também são conhecidas como “Bruxas”. Algumas décadas atrás, ninguém jamais acreditaria na existência de tais coisas no mundo…", "Eloísa")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Mas Ren é diferente – ela é capaz de passar por áreas de fluxo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O que?!!","Multidão")

	print("=== 深海恐惧症篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
