	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒは手を広げ、首を横に振った。")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("脱出は不可能です。\\n\\nある意味人類は『あの方』の\\nただの奴隷にすぎませんから。", "ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ここから出して、レンちゃん──ッ！", "アニー")
	await novel_interface.show_text_only("アニーは叫びながら俺の胸を掴み、\\n頬からは涙が零れ落ちていた。")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("ダメだ───！！早くここを出なきゃッ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーの様子に気持ちが昂って、\\n俺は割れんばかりの大声を上げた。\\nすると、周囲を囲む金色の紋章が崩壊を始める。")
	await novel_interface.show_text_only("ガシャン──ガシャン──ガシャン──")
	await novel_interface.show_text_only("ガラスのように虚空の中で砕けていく。")
	novel_interface.show_character("ren_battle","panic")
