# bathophobia_ep12.gd - 深海恐惧篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep12_script()

func play_script():
	pass

func bathophobia_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("もちろん、わたくしには『あの方』の正体を\\nはっきりと識別できませんわ。\\nたとえ嘘をつかれても、わたくしには\\n見分けようがありません。", "ハインリッヒ")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("それに、いつも考えております。\\n全てが真実であるとしても……", "ハインリッヒ")
	await novel_interface.show_dialog("真なる上位存在は人間のような矮小な種族など\\n気にもかけてはくれないのです。", "ハインリッヒ")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("もう1つの角度から考えますと、人間は\\n『あの方』にとってアリのような存在であり、\\n彼はただ虫眼鏡を使ってアリを燃やすような事を\\n好む子供なのかもしれません。", "ハインリッヒ")
	await novel_interface.show_dialog("アリからすればそれは神の戒めであり、\\nその背後に潜む黒い影にひれ伏す事となります。", "ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("はっ、ははっ……", "ラファエル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ラファエルは意味深く笑った。")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("そういう話なら、納得したわ。", "ラファエル")
	await novel_interface.show_dialog("人々は頭を下げて祈りの対象に祈りました...最初の戒めは子供のように意志的でした。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("はっきりとした意志は表明されておりませんが、\\n『あの方』の性格の劣悪さを考えますと、\\n故意にあなた達を巻き込んだのも、\\n有り得なくはないんです。", "ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ハインリッヒはラファエルに話しながら、\\n俺とアニーの方へ視線を向けた。")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("……俺達？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("アニーはかつてここに来た事がある。\\nそして彼女が消えていた空白の時間は、\\nこの場所にいた事で生み出されたモノ……\\nという事かしら？", "ラファエル")
	await novel_interface.show_dialog("スカイホテルの事件後『十字薔薇』の情報班が、\\nすぐに彼女の身元を調べ上げたわ。\\n当初はクローン体と判断されていたけど……", "ラファエル")
	await novel_interface.show_dialog("だけどその後、SIDと情報共有をして知ったわ。\\n……彼女が7年間消えていた事を。", "ラファエル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","speechless",0.25)
	await novel_interface.show_dialog("『十字薔薇』……Rosenkreuzer？", "ハインリッヒ")
	await novel_interface.show_dialog("わたくしが女性の錬金術士達と、研究成果の\\n交流を行っていた秘密結社ではありませんか？\\n今は情報組織になりましたの？", "ハインリッヒ")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("どうやらわたくしは、面白い「遺産」を\\n残せたようですね。", "ハインリッヒ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ハインリッヒは誇らしげに微笑んだ。隣にいる\\nラファエルも突然何かを納得したようだった。")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("そういう事ね……\\n今まで受け継がれてる『十字薔薇』のあの挨拶。\\n当時であればあまりにも教会に不敬だもの。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("『薔薇があなたの十字に咲きますように』", "ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("「薔薇」は女性の錬金術士を指している……\\n……いいえ、単に女性を意味するのかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("良く分かんないけど、なんかすごい感じだな……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("とにかく2人が言っている『あの方』ってのが、\\nやばい奴なんだろ？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("怯えたアニーを見て、心の底から怒りが湧く。")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("勝手に契約を迫って、俺達をこんな変な場所まで\\n連れて来やがって。", "小憐")
	await novel_interface.show_dialog("もっとムカツクのは、あいつが何か酷い事をして\\nアニーにこんなトラウマを植え付けた事だ……", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("俺が会ったら、ぶん殴ってやる！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…………", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("…………", "ハインリッヒ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女達は急に静かになって、\\n馬とか鹿とかを見るような目で俺を見た。")
