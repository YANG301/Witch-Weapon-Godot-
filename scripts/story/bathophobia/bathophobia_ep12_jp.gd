	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("……本当にあんたって、バカが言いそうな言葉を\\n泉のように吐き出すわね。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("マスターのお言葉であれば、\\nわたくしは期待していますわ。", "ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("うっ……そ、そのためにもだ！\\nどうやって、俺達は帰ればいいのかな……？", "小憐")
