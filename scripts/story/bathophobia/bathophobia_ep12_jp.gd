	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("今のアニーは俺が昔、病院で見た\\nイージスの境界線を守る兵士と同じだ。\\n心的外傷後ストレス障害ってやつの様子と非常に\\n似ている。")
	await novel_interface.show_text_only("ん？まってよ……病院？ \\n\\n俺は……入院した事がある……？")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("（いや、今はそんな事を考えてる時じゃない…）", "小憐")
	novel_interface.change_expression("normal1")
