	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("簡単に言いますと、わたくしの契約は地球上の\\n特定エリアである10か所を守り抜く事です。", "ハインリッヒ")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("嫌ですけど、やらざるを得ません……\\n\\n誰もやらなければ、取り返しのつかない災難を\\n招いてしまいます。", "ハインリッヒ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("その10のエリアに相当するものが、\\n『セフィロトの樹』の10個の円環というわけ？", "ラファエル")
