	await novel_interface.show_text_only("Von oben ertönt ein ohrenbetäubendes Geräusch knackenden Glases.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Schießen… Ein Raumzeitfluss…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hinter Heinrich erscheint ein Spiegel, der sich gegen den Uhrzeigersinn dreht und wie Wellen aussieht.")
