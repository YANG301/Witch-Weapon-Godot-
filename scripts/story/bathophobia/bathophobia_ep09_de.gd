	await novel_interface.show_text_only("Der uns umgebende Raum wird verzerrt und rotiert entlang zahlreicher Spiegelflächen.")
	await novel_interface.show_text_only("—Dann überkommt mich das Gefühl der Schwerelosigkeit.")
	await novel_interface.show_text_only("Als ich endlich zu mir komme, wird mir klar, dass wir gestürzt sind.")
