	await novel_interface.show_text_only("Das Mädchen seufzt.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("So schnell gefunden.", "Henriette")
	await novel_interface.show_dialog("Auch mit einer neuen Karosserie bin ich weiterhin an den Vertrag gebunden…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie hat kaum zu Ende gesprochen, als sich der Saal plötzlich stark verzerrt.")
