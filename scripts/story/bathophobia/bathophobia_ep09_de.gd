	await novel_interface.show_dialog("– Äh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die hohe Plattform und der Fuß der Säule knirschen und machen tiefe, leise Geräusche...")
	await novel_interface.show_text_only("Salmontons Nationalschatz, ein Artefakt, das die Erleuchtung der Menschen während der Renaissance symbolisiert – die Tesheimer Lapissäule …")
	await novel_interface.show_text_only("… kollabiert langsam in die Richtung, in die ich drücke …")
	await novel_interface.show_text_only("Und es fällt immer schneller.")
	await novel_interface.show_text_only("Boom——!!!")
	await novel_interface.show_text_only("Der gewaltige Knall entsteht, als die Säule mit der Metallplattform zusammenstößt und in zwei Teile zerbricht. Das weiter entfernte Stück rutscht sogar ein paar Zentimeter nach vorne.") #缩减符号
	await novel_interface.show_text_only("Kleine Bruchstücke verstreuen sich, und das am weitesten entfernte Stück rollt sogar in das davor liegende Becken.")
	await novel_interface.show_text_only("Es herrscht langes Schweigen …")
	await novel_interface.show_text_only("Selbst Raphael hat seit geraumer Zeit ihre gewohnte Arroganz verloren und wirkt äußerst schockiert.")
	await novel_interface.show_text_only("Dann dreht sie sich langsam zu mir um.")
	await novel_interface.show_text_only("Ich kann Feuer in ihren Augen brennen sehen.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Nein, ich... ich habe nicht...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_flare.png")
	await novel_interface.show_text_only("Als ich mir nicht vorstellen kann, wie ich meinen eigenen Hintern retten kann, ertönt aus dem Nichts der Klang eines Windspiels.")
	await novel_interface.show_text_only("Die auf dem Boden liegenden Fragmente zersplittern in noch kleinere Stücke und beginnen zu schweben wie von einem Windstoß weggeblasene Papierbögen.")
	await novel_interface.show_text_only("Die Säulenfragmente, die bunte Lichtbögen reflektieren, bilden mehrere Ringe und schweben nach oben.")
	await novel_interface.show_text_only("Schließlich lösen sich alle Bruchstücke in der Luft auf und hinterlassen zahlreiche schwebende Lichtringe, die die gesamte Halle erhellen.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Wow…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich kann nicht anders, als einen Ring zu berühren, der aus kleinen Fragmenten besteht –")
	await novel_interface.show_text_only("Der Ring zerfällt sofort in goldene Lichtpunkte.")
	await novel_interface.show_text_only("Die schwebenden Punkte zerstreuen sich wie Staub.")
	await novel_interface.show_text_only("Dann konzentrieren sie sich und erzeugen ein immer grelleres Licht...")
	await novel_interface.show_text_only("In der augenschmerzenden Helligkeit erscheint vor mir ein goldhaariges Teenager-Mädchen.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("… !!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_text_only("Mit ausgebreiteten Armen steht sie ruhig vor mir... Aber ich kann meine Augen einfach nicht von dieser glamourösen Szene abwenden.")
	await novel_interface.show_text_only("Ein schwacher Duft von Orangenblüten und Veilchen liegt in der Luft.")
	await novel_interface.show_text_only("Das Mädchen öffnet langsam die Augen.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Was für ein faszinierendes, fabelhaftes „Ergebnis“…", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sie schaut sich um.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Ist das… moderne Zeit!?", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("In ihren Augen ersetzt zunehmende Aufregung die leere Verwirrung.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Wasser und Kohlenstoff, Natriumchlorid und Schwefel, Silizium und Eisen …", "Blondes Mädchen")
	await novel_interface.show_dialog("Sie haben so ein wunderschönes… geschaffen.", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sie blickt ungläubig auf ihre zitternden Hände.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Die Berührung des Körpers…", "Blondes Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Mädchen betastet langsam ihren Körper von oben bis unten.")
	await novel_interface.show_text_only("Plötzlich wird mir klar, dass ich nicht hinsehen sollte, also wende ich mich sofort ab.")
	await novel_interface.show_text_only("Aber ich kann nicht anders, als einen verstohlenen Blick auf sie zu werfen...")
	await novel_interface.show_text_only("Sie... berührt sie sogar... sie...!!")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Auch das... wird nachgebildet?", "Blondes Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("… Das Licht war so stark, dass ich nichts sah!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir haben alle möglichen Notfallpläne, aber eine Zeit lang weiß keiner von uns dreien, was als nächstes zu tun ist.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Also…", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Das blonde Mädchen warf einen Blick auf Anne und Raphael, die immer noch angespannt waren, und ihr Blick fiel auf mich, der ausdruckslos aussah.")
