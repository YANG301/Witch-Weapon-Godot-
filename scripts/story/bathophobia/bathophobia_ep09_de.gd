	await novel_interface.show_text_only("Raphael winkt Mariru zu. Annie und ich stehen wachsam neben ihr.")
	await novel_interface.show_dialog("Projekt Ark, Experiment Nummer eins.", "Mariru")
	await novel_interface.show_dialog("Der Schild wird in zehn Sekunden deaktiviert.", "Mariru")
