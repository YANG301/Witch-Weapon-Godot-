	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie scheint auch nervös zu sein... Ihre Finger drücken so fest auf den Baseballschläger, dass die Nägel blass werden, aber sie tröstet mich immer noch.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, Feigling.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In dem Moment, in dem der Timer auf Null herunterzählt, drückt Raphael schnell den Hebel.")
