	await novel_interface.show_dialog("Sieht so aus, als wäre … nichts passiert.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich lege meine gesamte Handfläche auf die Säule. Es fühlt sich an wie Marmor.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Hm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich versuche es aus einem anderen Winkel und stoße kräftig an. \\nDie Säule, die über fünfzehntausend Pfund wiegt, bleibt bewegungslos.")
