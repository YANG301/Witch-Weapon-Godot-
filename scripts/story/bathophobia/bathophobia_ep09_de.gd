	await novel_interface.show_text_only("Wenn die Lapissäule leicht angehoben wird, überkommt mich ein stärkeres Gefühl.")
	await novel_interface.show_text_only("Es kommt mir vor, als ob mein Blut zu kochen beginnt und ich plötzlich einen unerklärlichen Impuls verspüre.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Autsch... Mein Bauch tut noch mehr weh...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Wenn ich um eine Toilettenpause bitte, wollen sie mich wahrscheinlich umbringen …)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/bedstand.png")
	await novel_interface.show_text_only("Plötzlich bebt der Raum darüber, und ein Lichtstrahl streicht schnell über unsere Köpfe und rast zum Ende der Halle.")
	await novel_interface.show_text_only("Dann ertönen zwei kurze Summtöne auf meiner Brust, die signalisieren, dass das Fake-System aktiviert ist.")
	await novel_interface.show_text_only("Die optische Tarnschicht hoch oben im Saal und das speziell behandelte Glas des Beobachtungsraums sorgen dafür, dass kein Ton an die Senatoren dringt.")
