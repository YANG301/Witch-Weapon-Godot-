	await novel_interface.show_dialog("Haben Sie dieses Wunder möglich gemacht?", "Blondes Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Mädchen landet langsam auf dem Boden und tritt respektvoll einen Schritt zurück.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("… Äh? \\n(Ich weiß nicht, wo ich suchen soll!!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Oder hast du diesen Behälter für meine Seele gemacht?", "Blondes Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ha... Vielleicht... Ja?", "Lian")
	await novel_interface.show_text_only("Tut mir leid, ich habe der Säule nur einen ganz kleinen Stoß gegeben!")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Mädchen legt ihre Hand auf ihre Brust und verbeugt sich leicht vor mir.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Also, wenn Sie möchten...", "Blondes Mädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sie schaut mir in die Augen. \\nIch las starkes Verlangen in ihren blauen Augen.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Bitte schenke mir deine ganze Essenz...", "Blondes Mädchen")
	await novel_interface.show_dialog("Meister.", "Blondes Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Meister?", "Raphael & Annie")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eeeeessence?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hör auf –!")
	await novel_interface.show_text_only("Schluss mit der seltsamen Fantasie!!!")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("„Alchemie, die Suche nach der Weisheit der Elemente und des Lebens.“", "Blondes Mädchen")
	await novel_interface.show_dialog("Der Mann, der in der Lage ist, einen Körper wieder aufzubauen und eine Seele zu beschwören, muss an der Wahrheit festhalten, die ich nicht besitze.", "Blondes Mädchen")
	await novel_interface.show_dialog("Ich… Henriette Kunhardt, bin bereit, eine Dienerin der Wahrheit zu sein…", "Blondes Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich bleibt Heinrich stehen und blickt feierlich auf eine freie Fläche im Saal.")
	await novel_interface.show_text_only("Wenn ich ihrem Blick folge, sehe ich nichts als Säulen.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Warte. Hat sie etwas über S...Diener gesagt?", "Lian")
