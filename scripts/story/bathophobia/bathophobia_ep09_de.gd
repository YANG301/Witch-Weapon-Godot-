	await novel_interface.show_text_only("Die Schleuse ist geschlossen und die Stufen versenken sich in der Wand.")
	await novel_interface.show_text_only("Geräusche von mahlenden Zahnrädern ertönen von oben im Saal, und die in der Decke versteckten automatischen Waffen sind auf den Schreibtisch gerichtet und jederzeit schussbereit.")
	await novel_interface.show_text_only("Ich stehe wie ein Fisch im tiefen Ozean mitten in der Dunkelheit.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ich fühle mich wie ein verurteilter Verbrecher...", "Lian")
