	await novel_interface.show_dialog("(Aber warum... ist es mir ein bisschen peinlich...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Während meine Hand noch auf der Säule liegt, ist die Atmosphäre unangenehm. Gerade als ich darüber nachdenke, stärker zu drücken, zuckt mein Herz plötzlich heftig.")
