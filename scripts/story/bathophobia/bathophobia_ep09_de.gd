	await novel_interface.show_text_only("Danach werden sie die Bilder sehen, die wir gefälscht haben.")
	await novel_interface.show_text_only("Die Inszenierung läuft. Mitten auf der Bühne gibt es für mich keinen anderen Ausweg.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Ich muss es durchstehen...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich trete vor und strecke vorsichtig meine Hand aus.")
	await novel_interface.show_text_only("Als sich meine Hand der Säule nähert, schließe ich nervös die Augen und halte den Atem an, bis meine Fingerspitzen die Säule berühren.") #换行问题
