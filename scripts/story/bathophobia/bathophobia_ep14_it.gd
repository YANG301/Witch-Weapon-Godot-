# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Un candore abbagliante.")
	await novel_interface.show_text_only("Un contorno sfocato apparve gradualmente davanti ai miei occhi e tutto intorno a me sembrava accelerare, come se stesse cadendo ad alta velocità da un'altitudine di 10.000 metri.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Alla fine i miei piedi toccano terra, ma l’impatto atteso non c’è stato. Solo il dolore alle orecchie mi ricorda un forte aumento della pressione atmosferica.")
	await novel_interface.show_dialog("Ahi…", "Lian")
	await novel_interface.show_text_only("Prendo fiato e mi rendo conto di aver lasciato quello spazio. Questo deve essere il mondo reale, perché è così dannatamente...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Coooooold!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso mi sento sferzare dall'aria gelida e mi vengono forti i crampi allo stomaco.")
	await novel_interface.show_text_only("Riuscivo a malapena ad aprire gli occhi che mi pizzicavano, come se le ciglia fossero tutte congelate...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Quando finalmente recupero la vista, trovo tutto coperto di neve. L'aria fredda sembra un coltello che mi trafigge la trachea.")
	await novel_interface.show_text_only("Respiro l'aria fredda e non posso fare a meno di tossire.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hoo... tosse tosse!", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Quanto tempo è passato? È già buio? \\nDove siamo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel freddo che mi opprime la mente, la mia temperatura corporea scende rapidamente e comincio a tremare involontariamente.")
	await novel_interface.show_text_only("Accanto a me Heinrich sembra in qualche modo emozionato. \\nAnnie e Raphael sono distesi sulla neve, esausti.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Maestro, hai freddo?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich mi prende delicatamente la mano.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Eh…?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sento il calore diffondersi dalle sue dita a tutto il mio corpo, come se fossi seduto accanto a un caminetto.")
	await novel_interface.show_text_only("Sorpreso, guardo questa ragazza che indossa ancora meno di me. Quando lascia andare le mie mani, trovo alcune pietre dorate appoggiate sui miei palmi.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Cosa sono questi...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ti sentirai meglio con questa calda giada.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sebbene i cristalli di giada non siano caldi al tatto, possono irradiare calore su tutto il corpo.")
	await novel_interface.show_text_only("Con queste pietre, la terra desolata ghiacciata e innevata si trasforma in un luogo caldo e accogliente.")
	await novel_interface.show_text_only("Mi chiedo se l'ambiente circostante non sia altro che una scena in studio.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bello…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Solo alcuni giocattoli. Li ho realizzati con strumenti alchemici e iscrizioni di conversione energetica.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("dice Heinrich con modestia, ma con un'espressione soddisfatta sul viso.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("No, no, è fantastico!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È davvero fantastico... La tecnologia per tali materiali artificiali con proprietà Substance H è ancora oggi top secret.")
	await novel_interface.show_text_only("Ho preso la giada calda e ne ho messo alcuni pezzi nelle mani di Raphael e Annie.")
	await novel_interface.show_text_only("Quando tocco le loro mani, posso sentire la loro temperatura corporea aumentare rapidamente.")
	await novel_interface.show_dialog("Tosse… Tosse…", "Raphael")
	await novel_interface.show_dialog("Uhm... ehm...", "Annie")
	await novel_interface.show_text_only("Con un attacco di tosse, Annie e Raphael riprendono conoscenza.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Stai bene?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedendo che annuiscono assonnati, tiro un sospiro di sollievo.")
	await novel_interface.show_text_only("Comincio a guardarmi intorno e mi ritrovo su un terreno ghiaioso ghiacciato, coperto da un sottile strato di neve.")
	await novel_interface.show_text_only("Sul biancore aleggia una strana calma, come se il paesaggio fosse solo una simulazione al computer.")
	await novel_interface.show_text_only("Accanto a me Heinrich mormora tra sé, immerso nei suoi pensieri.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Come siamo riusciti a fuggire da quello spazio…", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("No, non era una via di fuga… Ma la Fessura della Causalità fu costretta a rompersi.", "Henriette")
	await novel_interface.show_dialog("Ma come mai? Anche l'Uno dovrebbe seguire la regola della causalità quando trasmette le persone—", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("Potrebbe essere... lei...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich si gira involontariamente a guardare Ren.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ehi, è vera questa neve? Non fa affatto freddo.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ho raccolto con grande interesse una palla di neve, ma dopo averla guardata ho deciso di lanciarla a terra...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(Devo sembrare assolutamente stupido...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una folata di vento pungente mi soffia cristalli di ghiaccio in faccia.")
	await novel_interface.show_text_only("Grazie al topazio non sento affatto freddo.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Dove diavolo siamo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi alzo. Sotto di me c'è il piatto nevaio.")
	await novel_interface.show_text_only("In lontananza, le montagne ricoperte di ghiacciai si innalzano dal bordo del nevaio.")
	await novel_interface.show_text_only("Il cielo avrebbe dovuto essere riempito dall'oscurità della notte.")
	await novel_interface.show_text_only("Ma...")
	await novel_interface.show_text_only("È illuminato da una fascia di luce colorata che si estende verso l'orizzonte.")
	await novel_interface.show_text_only("Raggi di luci colorate sono chiaramente visibili sotto le stelle. Il cielo è illuminato da un colore verdastro fluorescente striato di viola e rosa.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(È questa... l'aurora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedere le foto su Internet non è paragonabile allo stupore di vederle di persona.")
	await novel_interface.show_text_only("Tra la notte stellata e il puro nevaio fluttuano raggi di brillante splendore.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Siamo nel... Circolo Polare Artico?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No... assolutamente no?!")
	await novel_interface.show_text_only("Heinrich le scuote la testa.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Uff... devono essere una specie di immagini 3D...)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("L'effetto di questa simulazione è piuttosto buono, anche la temperatura e il tocco...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Siamo in Antartide.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Aspetta, ha appena detto Antartide...)\\n(Quello con i pinguini...?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("…Eh? Che cosa??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Antartide?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("L'area corrispondente alle none Sephirot.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Ragazzi, ne avete già parlato, l'Albero della Vita, Sephiroth, blah blah blah, cosa diavolo...", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La leggenda narra che Dio usò l'Albero della Vita come progetto per l'universo. È come una mappa strutturale del mondo.", "Henriette")
	await novel_interface.show_dialog("Per quanto riguarda le Sephirot... sono i dieci pilastri che sostengono l'Albero della Vita.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Secondo The One, almeno...", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A giudicare dalla sua espressione facciale, Heinrich non crede davvero alla leggenda.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Quindi la nona Sephirot corrisponde… all’Antartide. È questa l'area che dobbiamo presidiare questa volta?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Ma contro cosa? Sigilli!?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Secondo le nostre esperienze precedenti, anche le aree non attraversate possono generare catastrofi.", "Henriette")
	await novel_interface.show_dialog("Le controversie tra gli esseri umani non sono nulla in confronto alla forza della natura.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ma... sembra che non siamo arrivati nel posto giusto.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("In altre parole, per ora siamo liberi.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich mi sorride, i suoi occhi brillano.")
	novel_interface.character_light()
	await novel_interface.show_dialog("È la prima volta che godo della libertà dopo centinaia di anni, anche questo posto è desolato, e anche se è solo per un po'...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Hahaha... The One deve essere molto seccato in questo momento!", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("E il merito va a te, Ren!", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mano sul cuore, mi fa un inchino.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Cosa, io? Ho fatto qualcosa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Ancora nessun indizio sulle sue capacità... Interessante.)", "Henriette")
	await novel_interface.show_dialog("Trascendere le regole stabilite dall'Uno—", "Henriette")
	await novel_interface.show_dialog("Devi aver inscritto la verità nella tua anima, Maestro.", "Henriette")
	await novel_interface.show_dialog("Questo è il livello che desideravo durante la mia vita.", "Henriette")
	await novel_interface.show_dialog("Qual è il prezzo per raggiungere questo livello?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Non capisco questa cosa del livello...", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Ma il prezzo è colossale!")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Il vento sta diventando forte, troveremo un posto dove nasconderci?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Vai dritto... C'è un deposito...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie parla con voce debole.")
	await novel_interface.show_text_only("Lei lotta per alzarsi in piedi, con la mano puntata in avanti.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("C'è un'architettura circolare. Non è affatto grande, ma ha uno spazio per strisciare alto più di 30 piedi per tenersi al sicuro dalle tempeste di neve.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Vetro doppio vetro resistente al freddo con ampia struttura metallica...", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Usare uno stile minimalista così poco pratico nella regione polare... Devono essere quei ragazzi nordici.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il cavo d'acciaio che sostiene la scala è rotto e i gradini sono tutti caduti a terra, lasciando pendenti solo due corrimano.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Mi scusi... c'è qualcuno qui?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Saggio, idiota! Nessuno sarebbe così sciocco da restare in una casa di vetro ad alta dissipazione del calore durante la notte polare!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi rendo conto che la notte nel circolo polare antartico dura sei mesi. Adesso perdo davvero la cognizione del tempo.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sembra ancora pallido. Riesce a malapena a reggersi in piedi dopo essere entrati nel deposito.")
	await novel_interface.show_text_only("Mi precipito per prenderla mentre perde il controllo del suo corpo e crolla a terra.")
	await novel_interface.show_dialog("Uff...", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Nessuna struttura di comunicazione al primo piano. Dobbiamo provare a salire di sopra.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Salire di sopra?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A queste parole Heinrich si avvicina al corrimano.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Mormorando) Hmm... è materiale che non ho mai visto prima...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ma non è difficile ricostruirlo...", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raccoglie il filo rotto ed estrae un pezzo di pietra simile a una gemma.")
	await novel_interface.show_text_only("La fessura è contorta, allungata e collegata insieme in modo fluido, come se fosse duttile nelle mani di Heinrich.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Quindi questa è alchimia...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uno sguardo di ammirazione appare sul volto altezzoso di Raphael.")
	await novel_interface.show_text_only("Heinrich prende il filo, la sua tuta da battaglia inizia a lampeggiare in diversi colori.")
	await novel_interface.show_text_only("Quindi dà uno strattone al filo, che viene nuovamente stretto. Una dozzina di gradini vengono riportati al loro posto originario.")
	await novel_interface.show_text_only("Riattacca il filo alla fibbia sul pavimento, come se fosse solo un morbido gomitolo.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wow… Meraviglioso!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Beh... Almeno la proprietà di rinforzo di questa tuta da battaglia è abbastanza utile per gli alchimisti.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Dopotutto, a volte dobbiamo affrontare problemi... problemi oltre ogni immaginazione.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mettendo Annie sul divano, noi tre saliamo le scale...")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
