# bathophobia_ep11.gd - 深海恐惧篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep11_script()

func play_script():
	pass

func bathophobia_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Что такое реальность?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/game.png")
	await novel_interface.show_text_only("Возможно, реальность, какой мы ее знаем, — это всего лишь компьютерная игра.")
	await novel_interface.show_text_only("Заходите, персонажи просыпаются; выйти из системы, и они засыпают. Когда счета закрываются, они умирают.")
	await novel_interface.show_text_only("Со временем у них развивается восприятие души.")
	await novel_interface.show_text_only("Они верят, что все эти заранее запрограммированные действия совершаются по их свободной воле.")
	await novel_interface.show_text_only("Формулы, законы, грамматические правила, кодексы поведения… каждому персонажу даны эти правила, которым он должен следовать, не зная, кто их создал… пока он наконец не будет освобожден.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/unknowm.png")
	await novel_interface.show_text_only("Даже если огромный участок неба станет пиксельным из-за ошибки рендеринга…")
	await novel_interface.show_text_only("Они просто рационализировали это сказками или религиозными убеждениями, вместо того, чтобы признать, что это находится за пределами их знаний.")
	await novel_interface.show_text_only("Потому что принятие неизвестного означает самую тревожную возможность…")
	await novel_interface.show_text_only("Что так называемая реальность может быть не чем иным, как иллюзией.")
	await novel_interface.show_text_only("Несбыточная мечта.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Я медленно открываю глаза и оказываюсь в тумане.")
	await novel_interface.show_text_only("Я окружен туманом. Как ни странно, в воздухе висят ниточки капель дождя.")
	await novel_interface.show_text_only("Я протягиваю руку и пытаюсь дотронуться до них, но они тут же испаряются.")
	await novel_interface.show_dialog("Где я…", "Lian")
	await novel_interface.show_text_only("Я стою на твердой поверхности и чувствую гравитацию. Но я не вижу земли… как будто мой взгляд поглощен пустотой.")
	await novel_interface.show_text_only("На заднем плане слышен необычный шум. Без какой-либо системы отсчета направления незаметны.")
	await novel_interface.show_text_only("Я поднимаю глаза и вижу очертания древовидного тотема, плывущего высоко надо мной.")
	await novel_interface.show_text_only("Он распространяется, как мерцающее одеяло в небе.")
	await novel_interface.show_text_only("Десять колец на тотеме медленно вращаются, одно испускает красноватый луч.")
	await novel_interface.show_text_only("Затем под моими ногами разворачивается огромный узор, состоящий из линий и надписей, образуя то, что можно назвать землей.")
	await novel_interface.show_text_only("Тотем на земле такой же, как и в воздухе, но с небольшого расстояния он выглядит намного больше.")
	await novel_interface.show_text_only("Кольца диаметром около 15 футов каждое соединены в определенном порядке. Надписи на них выглядят древними.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Я… сплю?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Меня научили распознавать галлюцинации и сны…")
	await novel_interface.show_text_only("Что это за важный вопрос еще раз?")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("— Как я сюда попал?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Воспоминания возвращаются. Я был на базе «Арк», и все начало рушиться… Потом…")
	await novel_interface.show_text_only("Нет. Это не сон.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Это имеет какое-то отношение к той девушке?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Она называла меня Мастером и даже…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Оу— \\nНет… Сейчас не время для фантазий…")
	await novel_interface.show_text_only("Где Annie? А Рафилия?")
	await novel_interface.show_text_only("Их тоже должно быть засосало в это место!")
	await novel_interface.show_text_only("Я осматриваюсь в тумане в поисках их. Неожиданно меня сзади обнимает пара теплых рук.")
	await novel_interface.show_dialog("Не волнуйтесь, Мастер…", "Блондинка")
	await novel_interface.show_text_only("Это она! \\nОбнаженная девушка обнимает меня сзади!")
	await novel_interface.show_text_only("У меня к ней много вопросов. Но я не решаюсь оглянуться назад…")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Мастер... Как странно!) \\n(Как чудаки в мультфильмах!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, она что-то ищет. Ее руки скользят по моей талии и останавливаются на моем плоском животе.")
	await novel_interface.show_text_only("В тишине я слышу, как быстро бьется мое сердце, как ее дыхание щекочет мои волосы…")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("(Что… она собирается делать?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("О?","Блондинка")
	await novel_interface.show_text_only("Кажется, она обнаружила что-то интересное. Она слегка надавила на него ладонью, и мой живот тут же издал неудовлетворительный «булькающий» звук.")
	await novel_interface.show_text_only("В такой тихой обстановке этот звук особенно заметен.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Э? Почему…)", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("(Ааааа… Так неловко…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я отрываюсь от нее. Она подходит ко мне и с любопытством смотрит на меня.")
	await novel_interface.show_dialog("Тело Мастера тоже было изменено? \\n… Какой совершенный продукт алхимии!","Блондинка")
	await novel_interface.show_text_only("Я хочу закрыть глаза, но понимаю, что она уже одета.")
	await novel_interface.show_text_only("Подождите, она только что сказала, что мое тело было изменено?! \\nИ… что на ней надето?")
	await novel_interface.show_text_only("Одного взгляда на костюм Генриха достаточно, чтобы оценить его современный материал.")
	await novel_interface.show_text_only("Судя по фактуре и рисунку, это не XVI век... Нет, это даже за пределами современного мастерства.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Информация Mariru неверна?) \\n(И откуда она знает о трансформации моего тела?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда я пытаюсь выразить свои мысли, кто-то внезапно тянет меня назад.")
	await novel_interface.show_text_only("Это Рафилия. Она хватает меня за капюшон, делает шаг вперед и становится между мной и Генрихом.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Скажи мне, кто ты?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("— Ну?", "Блондинка")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Генрих поворачивается к Рафилии с презрительной улыбкой на лице.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Ты спрашиваешь мое имя? \\nУ меня их сотни.", "Блондинка")
	await novel_interface.show_dialog("Но ты можешь звать меня Генриеттой Кунрат — так указано в контракте.", "Блондинка")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Это не смешно!", "Raphael")
	await novel_interface.show_dialog("Генрих — человек во всех исторических записях.", "Raphael")
	await novel_interface.show_dialog("И кроме того, посмотри, что на тебе надето! \\nВы перепутали нижнее белье с верхней одеждой?", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Не оскверняй Генриха, великого алхимика, бессовестная девица! Перестаньте называть людей «господинами» и… и принимать суть людей…", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Рафилия краснеет, говоря это.")
	novel_interface.character_light()
	await novel_interface.show_dialog("… Кто ты такой!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пока они противостоят друг другу, я не мог не взглянуть на Генриха со спины Рафилии.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Из какого материала сделан ее костюм…) \\n(Потрясающая накидка! Как могла ее грудь трястись в разные стороны?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Наши глаза встречаются, и я сразу краснею. В панике я смотрю на свою юбку, избегая дальнейшего зрительного контакта.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ну? Я думал, Мастера не поразит твой собственный шедевр…", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Нет-нет-нет, я (или был) мальчиком…")
	await novel_interface.show_text_only("Генрих указывает на ее грудь.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Больше, чем раньше… Это вкус Мастера?", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия оглядывается и бросает на меня строгий взгляд.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Нет! Не я! Я не сделал!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Я только что случайно разбил национальное достояние Salmonton…")
	await novel_interface.show_dialog("И, пожалуйста, не называй меня хозяином… Просто зови меня Рен.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Рен…? \\nЯ не ожидал, что у такого замечательного человека, как ты, будет такое прекрасное имя…", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("А ты? Ты правда Генрих?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она колеблется, смотрит на цифры на запястье и слегка вздыхает.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Прошло уже 400 лет…", "Генриетта")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Подождите, а у нее на запястье есть часы или календарь!?")
	novel_interface.character_light()
	await novel_interface.show_dialog("Я изображал из себя человека, который занимается исследованиями, публикует статьи или занимается медицинской практикой.", "Генриетта")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Поэтому меня не удивляет то, как меня записывает история.", "Генриетта")
	await novel_interface.show_dialog("В мое время в университеты не принимали девушек, а церковь запрещала женщинам заниматься медицинской практикой…", "Генриетта")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Не говоря уже о том, чтобы стать алхимиком… Хм, я не хочу иметь проблемы с религиозным судом.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("… \\п", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Почему-то я начинаю возмущаться каждый раз, когда узнаю об угнетении женщин.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("От этих придворных собак легко избавиться, но они не стоят моего времени.", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Вау… звучит круто…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия задумчиво смотрит на Генриха.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Подожди, а как ты мальчиком поступил в университет? \\п", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мне вдруг стало любопытно, как она сюда попала. Может быть…")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Я просто коротко постригся, подделал несколько рекомендаций и поступил в Лейпцигский университет под псевдонимом.", "Генриетта")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Просто стрижка?", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_text_only("Я смотрю на ее грудь. Неужели люди 400 лет назад были слепы?")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Мне тогда было десять лет. Вступительный экзамен в университет оказался слишком простым.", "Генриетта")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Генрих презрительно улыбается.")
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("А? Неважно.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Как бы ни менялся мир, одаренные дети всегда замечательные!")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Тогда как вы объясните этот костюм?", "Raphael")
	await novel_interface.show_dialog("Генрих был врачом и алхимиком, но ваши доспехи и оружие явно предназначены для сражений.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Генрих делает шаг назад, улыбаясь.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Ой, извини, это моя вина.", "Генриетта")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она прижимает правую руку к груди, и костюм начинает трескаться.")
	await novel_interface.show_text_only("Ее тело, теперь окруженное бело-голубыми лентами и разноцветными кристаллами, начинает сиять.")
	await novel_interface.show_text_only("Когда синий и золотой свет начинает тускнеть, ее тело постепенно…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Постепенно… Э?")
	await novel_interface.show_text_only("Рафилия подбегает и крепко закрывает мне глаза руками.")
	await novel_interface.show_dialog("Хватит! Я понимаю!", "Raphael")
	await novel_interface.show_dialog("Одевайся, эксгибиционист!", "Raphael")
	await novel_interface.show_dialog("Еще есть переодевание, что вы смотрите!", "Raphael")
	await novel_interface.show_text_only("Я ничего не видел!!")
	novel_interface.show_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("Когда Рафилия убирает руки, Генрих уже снова одет в тот же костюм. Ух…")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Это волшебный боевой костюм, похожий на тот, что был на Мастере. Но мое создано высшими существами.", "Генриетта")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Что касается дизайна… Боюсь, у The One ужасный вкус…", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Тот самый?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Я создал Дверь в это пространство, используя алхимические методы.", "Генриетта")
	await novel_interface.show_dialog("Смертным не положено знать правду… Так что мне пришлось заплатить цену. Тот заставил меня подписать контракт относительно моей души…", "Генриетта")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Генрих выглядит несколько беспомощным.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Бормочет) В прошлый раз мое тело полностью разлетелось на куски, но контракт все еще можно было активировать с новым телом...", "Генриетта")
	await novel_interface.show_dialog("Почему бы тебе не дать мне передохнуть…", "Генриетта")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Пока я раздумываю, что говорит Генрих, из тумана внезапно доносится дрожащий голос Annie.")
	await novel_interface.show_dialog("Рен—", "Annie")
	novel_interface.character_light(0.35,"solemn")
	await novel_interface.show_dialog("Annie?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бежим туда, откуда раздался голос, и находим Annie распростертым на земле и дрожащим.")
	await novel_interface.show_dialog("Х… Помогите…", "Annie")
	await novel_interface.show_dialog("… Не… Пожалуйста…", "Annie")
	await novel_interface.show_text_only("Я быстро шагнул вперед, чтобы успокоить Энни, и в тот момент, когда моя рука коснулась ее тела…")
	await novel_interface.show_text_only("Вязкий и горячий ветерок проходит сквозь мою руку и быстро проносится мимо меня.")
	await novel_interface.show_text_only("Я оглядываюсь по сторонам, но не нахожу ничего необычного, кроме того, что Генрих смотрит на меня с недоумением.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("С тобой все будет хорошо, Annie!", "Lian")
	novel_interface.change_expression("solemn")
