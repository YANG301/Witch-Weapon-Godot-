# bathophobia_ep25.gd - 深海恐惧症篇第25话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep25_script()

func play_script():
	pass

func bathophobia_ep25_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling.png")
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("—¡Cuidado!","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette me empuja a un lado en el momento en que la puerta de la sala de control se abre con un chirrido.")
	await novel_interface.show_text_only("Justo a tiempo, también, cuando lo siguiente que supe, innumerables arcos eléctricos parpadeantes chocan despiadadamente contra el pecho de la chica rubia, acompañados de explosiones duras y ensordecedoras. La luz es cegadora; apenas puedo mantener los ojos abiertos.")
	await novel_interface.show_text_only("Y en unos segundos todo habrá terminado. Todo vuelve a estar en silencio. Se me ponen los pelos de punta: debe haberse acumulado una enorme cantidad de estática allí. El aire apesta a cloro.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Vaya... \\nHenriette, ¿estás bien?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("Es una trampa, creo. Algún tipo de arma defensiva.\\nBastante impresionante, probablemente contenga tanta energía como un radar pequeño.","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Henriette se levanta y estudia pensativamente las luces del techo de la sala de control. En su mano hay un cristal azul claro translúcido.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué fue eso de todos modos?\\n¿Y qué es eso que tienes en la mano?","Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Es una turmalina. ¿Quieres intentarlo, Maestro?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La alquimista me lanza una sonrisa críptica, extiende su mano derecha y coloca el cristal suavemente detrás de mi oreja.")
	await novel_interface.show_text_only("Una repentina corriente cálida y difusa surge a través de mi cuerpo, haciendo que todos mis pelos se pongan de punta.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Ah!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No puedo evitar dejar escapar un delicado gemido.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("¿La? El cuerpo del maestro es muy sensible ~","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Estás gimiendo? ¿Aquí? ¿En realidad?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me mira como si fuera basura.")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Oye, no es que lo haya hecho a propósito...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Murmuro, bajando la cabeza y sonrojándome furiosamente.")
	await novel_interface.show_text_only("Al menos la estática acumulada sobre mi cabeza ha desaparecido. Mi cabello es bonito y suave ahora.")
	await novel_interface.show_text_only("Debería pedirle a Henriette uno de esos cristales cuando regresemos... \\nA ella no le importará, ¿verdad?")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Tímidamente sigo al alquimista hasta la sala de control.")
	await novel_interface.show_text_only("El lugar parece destrozado. La mayoría de las pantallas y equipos han sufrido daños en diversos grados. El techo y las paredes también se están desmoronando.")
	await novel_interface.show_text_only("Las marcas de quemaduras negras dejadas por descargas de alto voltaje se extendieron desde el panel de control principal a ambos lados. Los circuitos expuestos todavía están emitiendo chispas.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("El radio esférico es de más de quince pies... \\nAlguien debe haber usado un arma de descarga de alto voltaje aquí...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si estaban usando el sistema de seguridad genuino estándar, significa que esta marca aquí...")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("¿Alguien debe haber reconectado toscamente el equipo de defensa ofensivo del sistema y forzado la instalación de una batería secundaria química utilizando el sistema de alto voltaje de la intranet de la base...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro fijamente el caparazón, apenas reconocible después de la explosión, y finalmente entiendo por qué el aire apesta a cloro.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Una explosión eléctrica...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando una potente corriente atraviesa una lámina metálica, el aumento de calor provoca que se congregue una enorme cantidad de energía, lo que provoca violentas explosiones y destellos.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Entonces, quien hizo esto utilizó las capas de lámina metálica doblada a su favor. Un artilugio muy eficaz y mortal por cierto.","Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Pero... para que esto funcione, alguien tiene que colocar el cable metálico que guía la corriente en la rendija debajo de la puerta, que es la única salida de este lugar...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Entonces, quien haya hecho eso explotará junto a los enemigos en el momento en que se abra la puerta de la habitación.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hardware clave de este sistema de seguridad parece estar protegido por barreras electromagnéticas. Noto que el panel de control principal aún se puede activar. Sólo unos pocos botones están dañados.")
	await novel_interface.show_text_only("Entramos al sistema de seguridad y descubrimos que ha sido pirateado. Podría tener algo que ver con el reloj militar conectado al panel de control principal.")
	await novel_interface.show_text_only("Aún se puede acceder al almacenamiento flash del reloj. Es fácil distinguir la identidad de su propietario a partir del contenido.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Parece ser alguien realmente rudo.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algunas pantallas en la estación de vigilancia todavía están funcionando, reproduciendo diligentemente imágenes en tiempo real capturadas por las cámaras de vigilancia.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Espero que podamos encontrar información útil aquí.","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Respiro profundamente y consulto los registros históricos.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Mmmm...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como se esperaba de un establecimiento ultrasecreto, hay demasiados registros para contarlos. Algunos de los vídeos anteriores incluso se almacenan en archivos VCR.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¡Encontrar algo útil en todo este lío llevará años!","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Deja de quejarte. Debería haber una manera fácil de ejecutar una búsqueda; de lo contrario, el diseñador de la interfaz de usuario ya habría sido despedido.","Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bueno, de hecho existe un modo que nos permite obtener una vista previa eficiente de todas las grabaciones a la vez, pero...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Hay cientos de cámaras de vigilancia en la base y el sistema ha estado recopilando datos desde que se construyó la base. Sólo una pantalla de veinte pulgadas frente a mí sigue funcionando. Mostrar todo lo que contiene... a la vez es imposible.")
	await novel_interface.show_text_only("Desesperado, sigo alejándome, hasta que las miniaturas del metraje se reducen a meros píxeles.")
	novel_interface.show_character("ren_battle","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("¡Oye! ¡Mira eso!","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael me golpea en la cabeza y señala una línea blanca vertical y recta en la pantalla.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Todas las imágenes captadas en este momento... son todas... blancas?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("... \\n...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan1.png")
	await novel_interface.show_text_only("Salto al punto de tiempo al que se refiere Raphael y invoco el primer fotograma después de la parte con toda la blancura que tiene contenido.")
	await novel_interface.show_text_only("Aparece un hombre alto y ancho.")
	await novel_interface.show_text_only("Está vestido con un traje de materiales peligrosos de color cobalto y parece medir más de seis pies de altura. Avanza a un ritmo constante y rápido.")
	await novel_interface.show_text_only("No parece importarle que lo filmen, pero la resolución es demasiado baja para que podamos ver claramente su rostro.")
	await novel_interface.show_dialog("Hay algo en él...","Lian")
	await novel_interface.show_dialog("¿Lo conoce, Maestro?","Henriette")
	await novel_interface.show_dialog("Sin...","Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("El hombre observa el lugar mientras avanza, como si buscara algo.")
	await novel_interface.show_text_only("Sus pasos se aceleran mientras se dirige desde la sala de archivos a la enfermería.")
	await novel_interface.show_text_only("Al pasar junto a dos cadáveres de soldados envueltos, de repente se detiene y se inclina para estudiarlos.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿A ese soldado... le falta una pantorrilla?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael y yo contenemos la respiración, horrorizados por la herida en la pierna del soldado y la sangre oscura en sus bordes.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Entonces aquí ocurrió una pelea, eh...","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No puedo evitar recordar la gigantesca grieta en el suelo de la sala de archivos.")
	await novel_interface.show_text_only("Con rostro impasible, el hombre entra pavoneándose en la enfermería y saca una tarjeta negra del botiquín. De la nada, carga su arma.")
	await novel_interface.show_text_only("Desde un rincón de la enfermería, salta una sombra oscura. El hombre dispara varias veces sin perder el ritmo, enviándolo a volar fuera del marco.")
	await novel_interface.show_text_only("Luego saca una daga y también desaparece del cuadro. Reaparece en unos segundos y arroja un montón de artículos indistinguibles a la basura.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Es esa...? ¿Es esa...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De ninguna manera. No puede ser.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Siguiendo un protocolo claro, ya veo.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("... No importa. Sigue mirando.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hombre cierra tranquilamente la puerta de la enfermería y luego pasa la tarjeta para abrir una puerta de metal. Parece muy familiarizado con el diseño de la base.")
	await novel_interface.show_text_only("Después de comprobar si está vacío (lo está), el hombre entra en el túnel fuera de la sala de control.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿Qué es esta...?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los gráficos en la pantalla son un poco granulados, pero aún así es fácil decir que el túnel en el metraje definitivamente había sido el lugar de un baño de sangre.")
	await novel_interface.show_text_only("Decenas de cadáveres yacen al azar en una formación radial, como si una poderosa explosión los hubiera derribado a todos a la vez.")
	await novel_interface.show_text_only("Y en el centro de todo esto se arrodilla una niña vestida de blanco, con la parte superior del cuerpo erguida y atravesada por un arma de empuñadura larga.")
	await novel_interface.show_text_only("Lleva muy pocas capas teniendo en cuenta que está en la Antártida. Su piel lechosa está teñida de un rojo sangre.")
	await novel_interface.show_text_only("Tiene un arma en cada mano, agarrándolas con fuerza a pesar de haber perdido el conocimiento.")
	await novel_interface.show_text_only("El hombre se arrodilla frente a ella y le acaricia el rostro con una mano.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(... ¿Se conocen?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Luego gira hacia su espalda, agarra la empuñadura y lentamente saca el arma, revelando una punta de lanza forrada de oro.")
	await novel_interface.show_text_only("El cuerpo de la niña no se movió en absoluto y no salió más sangre de la herida. Hubo una sensación indescriptible de desobediencia en todo el proceso.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Susurros) Ahh...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hombre se quitó el abrigo, sacó con cuidado la punta del arma, la envolvió en una tela, la metió dentro de la chaqueta del traje y arrojó el mango largo a un lado.")
	await novel_interface.show_text_only("Luego ingresa a la sala de control. Intentamos comprobar qué está haciendo cambiando de cámara, pero la pantalla que muestra la sala de control solo muestra estática.")
	await novel_interface.show_text_only("Miramos hacia arriba y vemos que la cámara de la habitación ya ha quedado completamente destruida por una descarga eléctrica.")
	await novel_interface.show_text_only("Después de un momento, el hombre reaparece en el pasillo, llevando una maleta de aleación de aproximadamente 1,6 pies de ancho.")
	await novel_interface.show_text_only("La cerradura de la maleta parece estar rota. Abre la caja y saca tres recipientes de vidrio.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... ¿Qué está haciendo exactamente?)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uno de los recipientes de cristal está hecho añicos. El hombre lo mira fijamente, duda un poco y luego guarda los dos intactos en su bolsillo.")
	await novel_interface.show_text_only("Gentilmente, intenta recuperar las armas de los puños cerrados de la niña. Entonces es cuando se le cae un cuaderno de algún lugar de la camisa.")
	await novel_interface.show_text_only("El hombre lo levanta, lo hojea y luego lo vuelve a meter en el traje de la niña.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/TheMan2.png")
	await novel_interface.show_text_only("Como si llevara un bebé, levanta con cuidado a la esbelta y frágil niña en sus brazos. Sus movimientos son cariñosos y tiernos.")
	await novel_interface.show_text_only("La lleva al estilo nupcial hasta el final del túnel, donde golpea la tarjeta negra contra la pared.")
	await novel_interface.show_text_only("La pared se desliza hacia un lado y los dos, juntos, desaparecen en la oscuridad...")
	await novel_interface.show_text_only("... Ahí terminan las grabaciones.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Hay un largo período de silencio en todas las grabaciones de vídeo que vienen después. Y el hombre nunca reaparece en el resto del metraje.")
	await novel_interface.show_text_only("De hecho, no hay nada que valga la pena ver en las imágenes que siguen. Nada, hasta que nos presentamos los tres en la entrada de la base.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Eso es raro...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Espera, mira.","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael señala la pantalla que muestra la enfermería.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("¿No había un cadáver allí mismo? Se acabó....","Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De hecho, todos los cadáveres han desaparecido...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Esto significa que durante los períodos en blanco del metraje, los lugares de batalla habían sido completamente ordenados.")
	await novel_interface.show_text_only("Empezamos a revisar, revisando registros anteriores.")
	await novel_interface.show_text_only("Logramos encontrar imágenes que registran lo que le sucedió a la niña y su escuadrón.")
	await novel_interface.show_text_only("El último cuadro que vemos, capturado por la cámara de la sala de control, es una señora con un traje de nieve, obligando a la chica de cabello negro a salir por la puerta con una pistola.")
	await novel_interface.show_text_only("Ahí termina la grabación.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("... Entonces eso fue lo que pasó aquí...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Salgo de la interfaz de datos y accedo a las imágenes de vigilancia en tiempo real.")
	await novel_interface.show_text_only("Tenemos cobertura de la entrada principal, la sala de exposiciones, los pasillos, el archivo, los túneles... y algunos otros lugares en los que no hemos estado.")
	await novel_interface.show_text_only("Mientras escaneo la pantalla que muestra imágenes en tiempo real, de repente se me ocurre que la batalla que tuvimos fuera de la sala de archivos no ha sido grabada. En absoluto.")
	await novel_interface.show_text_only("Según el video, los tres entramos a la sala de archivos por el pasillo y nunca salimos. En cambio, llegamos al túnel por una abertura al otro lado.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Entonces, ¿esa pelea ocurrió en un “sueño”? Que extraño...","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Y quién limpió el lugar?","Raphael")
	await novel_interface.show_dialog("... Alguien también debe haber entrometido con las imágenes.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Ni siquiera podemos encontrar imágenes del hombre alto saliendo del local.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Examino mecánicamente las pantallas de vigilancia en tiempo real, mientras los tres debatimos las identidades de la chica y el hombre que acabamos de ver.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Espera...","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es razonable que pensemos que alguien pudo haber alterado las grabaciones y que estábamos en un “sueño”.")
	await novel_interface.show_text_only("Lo que no es razonable es...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿Por qué podemos ver las imágenes en tiempo real de la sala de archivos?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael y Henriette se congelan al instante.")
	await novel_interface.show_text_only("La habitación queda inquietantemente en silencio durante unos segundos.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿No hicimos...?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("... ¿saca el cable antes de salir de la habitación?","Henriette")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¿Cuál es esa pregunta importante otra vez...?")
	await novel_interface.show_text_only("—¿Cómo llegué aquí?")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Mi vejiga vuelve a exigir atención. Maldita sea.")
	
	print("=== 潜渊症篇第25话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
