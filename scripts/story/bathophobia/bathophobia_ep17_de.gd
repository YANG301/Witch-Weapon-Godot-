# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Eine endlose Weite öden Landes – von der atemberaubenden Aurora Australis in ein mystisches Grün gefärbt.")
	await novel_interface.show_text_only("Eine Reihe von Scheinwerfern durchdringt die kalte, stille Dunkelheit.")
	await novel_interface.show_text_only("Sie gehören zu einer Flotte von Schneemobilen. Die Roller fegen vorbei an den in Dunkelheit gehüllten Eisebenen, vorbei am Hubschrauberlandeplatz und parken schließlich am Eingang der weitläufigen Basis.")
	await novel_interface.show_text_only("Vor ihnen steht ein Denkmal in Form eines Kokons. In seiner felsigen Oberfläche ist eine robuste Probenbox eingebettet, die früher zur Aufbewahrung von Mt.-Grove-Meteoriten verwendet wurde.")
	await novel_interface.show_text_only("Das Wort „Snedronningen“ ist unzählige Male rund um die Schachtel aufgemalt und glänzt im Scheinwerferlicht silbern.")
	await novel_interface.show_text_only("Snedronningen – die Weiße Königin. Der Name der Basis, die die Fahrer suchen.")
	await novel_interface.show_text_only("Ein schwer gepanzertes Truppmitglied, das an vorderster Front reitet, reißt ihr das Visier ab.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Uuuuund hier sind wir!", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die restlichen fünf Fahrer folgen ihrem Beispiel, stellen ihre Motoren ab und steigen ab, wobei jeder seine jeweiligen Vorräte einsammelt.")
	await novel_interface.show_text_only("Hierbei handelt es sich um ein wissenschaftliches Forschungsteam, bei dem alle Mitglieder eine Standard-Kampfausbildung absolviert haben.")
	await novel_interface.show_text_only("Berichte über die Entdeckung von Radiowellen, die von Substance H erzeugt wurden, vor zwei Monaten in der Antarktis, haben viele neugierige Fraktionen in die Region gebracht. Die meisten von ihnen kamen bewaffnet.")
	await novel_interface.show_text_only("Für die Truppe ist es ratsam, vorsichtig zu sein, um die Exemplare sicher aufzubewahren.")
	await novel_interface.show_text_only("Bisher hatten sie Glück. Die Reise zur im Backup-Plan genannten Forschungsbasis verlief recht reibungslos.")
	await novel_interface.show_dialog("Alles klar. Wir müssen das Zeug nur abgeben.", "Squad-Mitglied D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Ja.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Im Gegensatz zu den anderen, die in dicke, warme Schichten gehüllt sind, trägt Beth ein legeres Outfit, dem die extremen Temperaturen offenbar nichts anhaben können.")
	await novel_interface.show_text_only("Auch ihre selbst verbesserten Waffen heben sich von der Masse ab.")
	await novel_interface.show_text_only("Ihre Reise war genau so verlaufen, wie sie es erwartet hatte...")
	await novel_interface.show_text_only("Beth war erst vor wenigen Stunden in die Tiefen des Ozeans getaucht und hatte erfolgreich lebende Proben zurückgebracht, die sie aus dem Körper einer unbekannten Kreatur gesammelt hatte.")
	await novel_interface.show_text_only("Zum Abschluss des Forschungsprojekts entsandte Milks Vorgesetzter den Ushuaia-Eisbrecher, um die Spezialeinheit zu unterstützen.")
	await novel_interface.show_text_only("Als die Probenkiste zur Ushuaia transportiert wurde, kam es im Biolabor auf dem Schiff „zufällig“ zu einem Stromausfall.")
	await novel_interface.show_text_only("Gleichzeitig bot die Snedronningen-Basis, etwa eine Autostunde entfernt, dem Team an, die Proben vorübergehend in ihrem Labor lagern zu lassen, was allen Spezifikationen entsprach.")
	await novel_interface.show_text_only("Die Truppe erhielt bald die Erlaubnis, das Gelände zu betreten, und wurde beauftragt, die Exemplare innerhalb von neunzig Minuten zum Stützpunkt Snedronningen zu bringen.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Wir sind so weit gekommen... )", "Beth")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Werden diese Drecksäcke auftauchen?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ballt ihre Faust.")
	await novel_interface.show_text_only("Was sie noch mehr stört, ist, dass irgendetwas in der Probenschachtel eine Art Reaktion in ihrem Körper ausgelöst zu haben scheint.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("... \\n(Das kommt mir aus irgendeinem Grund bekannt vor... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bevor sie weiter darüber nachdenken kann, beginnt die Welt heftig zu beben.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(Ist mir vom Tauchgang nur schwindelig?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nein, das ist es nicht.")
	await novel_interface.show_text_only("– Dieses ganze Land bebt.")
	await novel_interface.show_text_only("Aus der Ferne ist ein tiefes Grollen zu hören.")
	await novel_interface.show_text_only("Selbst die erfahrensten Veteranen scheinen erschüttert zu sein.")
	await novel_interface.show_text_only("Das Beben, das diesen weißen Kontinent erschüttert, dauert weniger als dreißig Sekunden.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Die Antarktis liegt nicht in der Erdbebenzone..., oder?", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Beben war nicht allzu stark. Es war jedoch allen ein wenig schwindelig.")
	await novel_interface.show_dialog("(Murmelnd) Es ist viel schlimmer als der Tsunami...", "Squad-Mitglied B")
	await novel_interface.show_dialog("Das Schelfeis unter unseren Füßen scheint ziemlich stabil zu sein. Wenn das gleiche Beben in einer dicht besiedelten tropischen Stadt passiert wäre, hätte es viel mehr Schaden angerichtet.", "Truppführer")
	await novel_interface.show_text_only("Die Truppmitglieder ignorieren dieses kleine Erdbeben und setzen ihre Arbeit fort.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Okay, lass uns gehen.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth hält die Probenschachtel sicher in ihren Armen und springt vom Rücksitz von Milks Schneemobil.")
	await novel_interface.show_dialog("Ich bin erschöpft. Ich kann es kaum erwarten, nach Hause zu meinem Bett und heißem Kakao zu kommen.", "Squad-Mitglied B")
	await novel_interface.show_text_only("Während die Truppmitglieder ihre Wachen bereits senken, bleibt der Anführer wachsam und wirft Beth vielsagende Blicke zu.")
	await novel_interface.show_text_only("Ohne dieses Mädchen wären sie bei dieser Mission gescheitert – genau wie alle anderen Fraktionen.")
	await novel_interface.show_text_only("Sie musste in die Tiefen des Ozeans tauchen, eine Dekompressionskrankheit riskieren und sich unbekannten Kreaturen stellen...")
	await novel_interface.show_text_only("Der Einsatz ist zu hoch. Unter solchen Umständen hätte nicht einmal Milk selbst den Erfolg garantieren können.")
	await novel_interface.show_dialog("Alles, was wir tun müssen, ist, das Zeug den Wissenschaftlern hier zu übergeben, oder?", "Squad-Mitglied D")
	await novel_interface.show_dialog("Beth, lass uns dich mit einem Bier verwöhnen, wenn wir zurück in Buenos Aires sind, oder?", "Kadermitglied C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("Auf keinen Fall! Unsere Bethy trinkt keinen Alkohol!", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk zieht Beth in ihre Arme, erklärt Milk.")
	await novel_interface.show_text_only("Bai Zhu presste die Lippen aufeinander und unterdrückte bewusst sein Unbehagen.")
	await novel_interface.show_text_only("Milk sendet am Tor der Basis mehrere Einreiseanfragen, erhält jedoch keine Antwort.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Wie seltsam...", "Milch")
	await novel_interface.show_dialog("Hat das Erdbeben die Verbindung zerstört oder so etwas?\\nSie hatten noch Kontakt, kurz bevor wir anlegten.", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auch wenn die Stacheln am Eingangstor, die den Zutritt von Fahrzeugen verhindern, bestehen bleiben, ist die Truppe technisch gesehen trotzdem in der Lage, hineinzukommen – schließlich haben sie den Zugangscode im Voraus erhalten.")
	await novel_interface.show_text_only("Also gehen sie auf die hell erleuchtete Barriere an der Seite der Basis zu.")
	await novel_interface.show_text_only("Beth bleibt plötzlich stehen und gibt die Schachtel mit den Proben einem ihrer Teamkameraden.")
	await novel_interface.show_text_only("Mit ihren freien Händen umklammert sie ihre Waffen fest.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... Was ist los?", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Milk Beths Aktionen bemerkt, zückt sie ebenfalls ihre Waffen und blickt aufmerksam.")
	await novel_interface.show_text_only("Auch die anderen Mitglieder spannen sich an und geraten in den Kampfmodus. Sie bewegen sich in einer fächerförmigen Formation vorwärts und achten dabei einander auf den Rücken.")
	await novel_interface.show_dialog("... Was zum Teufel?", "Squad-Mitglied D")
	await novel_interface.show_dialog("Pssst, lass es ruhig bleiben.", "Truppführer")
	await novel_interface.show_text_only("In der ohrenbetäubenden Stille sind nur das Quietschen der Schneestiefel auf der Eisoberfläche und das leise Atmen der Truppmitglieder zu hören.")
	await novel_interface.show_text_only("Milk nähert sich der Tür und gibt den Code in das Sicherheitsschloss ein.")
	await novel_interface.show_text_only("Das System akzeptiert den Code und das Wort ENTER blinkt grün auf dem Bildschirm.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Puh... das sollte sicher sein, oder?", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber Beth kann das beunruhigende Gefühl in ihrem Bauch immer noch nicht unterdrücken...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("Endlich öffnet sich die Barriere zum Stützpunkt Snedronningen, begleitet vom Geräusch surrender Zahnräder und gespannter Seile.")
	await novel_interface.show_text_only("Hinter dem Tor führt eine Treppe direkt nach unten in die schwach beleuchtete untere Ebene.")
	await novel_interface.show_dialog("Jemand?", "Milch")
	await novel_interface.show_text_only("Ihre Frage hallt durch den schmalen Gang.")
	await novel_interface.show_dialog("Ich verstehe, dass die meisten Einrichtungen hier unter der Erde liegen, aber hätten sie nicht jemanden nach oben schicken können, um uns zu begrüßen?", "Milch")
	await novel_interface.show_dialog("Mindestens einer dieser Forscher sollte vorbeikommen und die Proben überprüfen...", "Squad-Mitglied B")
	await novel_interface.show_dialog("In Kampfposition!", "Beth")
	await novel_interface.show_text_only("Beth blickt auf das andere Ende der Treppe und bellt ihren Befehl.")
	await novel_interface.show_dialog("Jemand beobachtet uns.", "Beth")
	await novel_interface.show_dialog("Je verdeckter die Option, desto einfacher ist es, Aufmerksamkeit zu erregen, schätze ich...", "Milch")
	await novel_interface.show_dialog("(Sind unsere Feinde diejenigen, um die Sie sich Sorgen machen?)", "Milch")
	await novel_interface.show_text_only("Eine Reihe knallender Waffensicherungen durchbricht die beängstigende Stille.")
	await novel_interface.show_text_only("Die Truppmitglieder, allesamt selbst ausgebildete Soldaten, blicken auf das Mädchen, das die Position des vorübergehenden Kommandeurs innehat, und warten auf ihre Befehle.")
	await novel_interface.show_dialog("Wir befinden uns derzeit an einem sehr exponierten Ort. Wir sind in Gefahr, wenn sie einen Hinterhalt planen. Wir können uns nach draußen zurückziehen...", "Squad-Mitglied D")
	await novel_interface.show_dialog("Kann nicht. Wir haben eine Warnung bekommen, dass es in einer Stunde einen Schneesturm geben wird.", "Beth")
	await novel_interface.show_dialog("Alle in höchster Alarmbereitschaft. Bleiben Sie in Bewegung.", "Beth")
	await novel_interface.show_dialog("(Alle) Ja, Sir!", "Squad-Mitglied")
	await novel_interface.show_text_only("Die Truppmitglieder gehen auf Zehenspitzen und atmen tief.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Achtung!", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Geräusch einer scharfen Klinge, die durch die Luft schnitt, durchbrach den Moment der Stille.")
	await novel_interface.show_text_only("Eine Kreatur mit einer schweren, sichelförmigen Waffe springt aus dem Schatten hervor und schlägt auf Beths rechte Seite ein.")
	await novel_interface.show_text_only("Milks Warnung kam gerade noch rechtzeitig und ermöglichte Beth, dem Angriff auszuweichen.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("Was?!!", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahaha... hahahahaha...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Angreifer ist ein Mädchen – die Augen sind hohl und die Körperhaltung verzerrt. Sie beugt sich vor, ihre Gelenke klappern laut und verwirrend.")
	await novel_interface.show_text_only("Mehrere andere strömen mit frischen Gesichtern und verrückten Gesichtsausdrücken durch den zuvor leeren Korridoreingang.") 
	await novel_interface.show_text_only("Die Truppmitglieder nehmen sofort ihre Standard-Dreiecksformation ein, während sie weiterhin auf die Angreifer schießen.")
	await novel_interface.show_text_only("Sie folgen Beths Beispiel, umzingeln das Mitglied, das die Probenschachtel hält, und beschützen sie von allen Seiten.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("Das Team behält einen gleichmäßigen Schussrhythmus bei und sucht gleichzeitig nach Deckung. Bald erreichen sie einen Raum, der wie ein Ausstellungsraum aussieht.")
	await novel_interface.show_text_only("Hier ist das Licht gedämpft und die Ausstellungsstücke bestehen hauptsächlich aus Tierexemplaren.")
	await novel_interface.show_text_only("Der Anführer weist das Team an, am Eingang des Raums eine Verteidigungslinie zu bilden, während der Rest des Trupps die ungewöhnlichen Eigenschaften bespricht, die ihnen an diesen Feinden aufgefallen sind.")
	await novel_interface.show_text_only("Wenn sie getroffen werden, bluten sie nicht. Sie scheinen nicht einmal Schmerzen zu spüren.")
	await novel_interface.show_text_only("Die Gruppe entfaltet ihre Schutzschilde aus Kevler-Faser, die die Angriffe etwas abwehren.")
	await novel_interface.show_text_only("Die Feinde, die von einer anderen Seite mit Großschwertern in der Hand herbeistürmen, werden an der Ecke von Truppmitgliedern zurückgehalten, die noch mehr Schutzschilde halten.")
	await novel_interface.show_text_only("Währenddessen prasseln hinter den Schildhaltern weiterhin 9-mm-Kugeln auf die Feinde ein, und der Geruch von Schießpulver liegt in der Luft.")
	await novel_interface.show_dialog("Neu laden!", "Kadermitglied C")
	await novel_interface.show_text_only("Die Schüsse können die seltsamen Feinde nicht abschrecken. Auch wenn die Kugeln ihre Gesichter durchbohren, grinsen diese grässlichen Mädchen weiter.")
	await novel_interface.show_text_only("Bis eines der Mädchen über einen Schild springt und sich kopfüber, ganz wie eine Fledermaus, an der Decke des Durchgangs hängt.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Äh... ist sie überhaupt ein Mensch?", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aus den Schusswunden des Mädchens strömt tintengrüne Flüssigkeit. Ihr Hals, der durch die Wucht der Kugeln fast in zwei Hälften zerschmettert worden wäre, ist jetzt in einem beunruhigenden Grün-Lila verfärbt.")
	await novel_interface.show_dialog("Achtung!", "Squad-Mitglied B")
	await novel_interface.show_text_only("Vom Ende des Korridors stürmen weitere Feinde herein.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Rückzug! Rückzug!", "Milch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Den Truppmitgliedern bleibt nichts anderes übrig, als sich in zwei Richtungen aufzuteilen und nach anderen geeigneten Angriffspunkten zu suchen, die sie glücklicherweise bald finden.")
	await novel_interface.show_text_only("Sie kämpfen noch nicht lange, aber es ist ihnen allen klar, dass die Feinde – was auch immer sie sein mögen – genauso mächtig sind wie ihre eigenen.")
	await novel_interface.show_text_only("Und auch noch hundertprozentig verrückter.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... Was sind sie... ?", "Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("Was zum Teufel?\\nSie können keine Menschen sein!", "Milch")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Für Beth ist es offensichtlich, dass diese klingenschwingenden jungen Mädchen genau wie sie sind –")
	await novel_interface.show_text_only("Nein, nicht ganz.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Sie ähneln eher dem, was ihr Vater beschrieben hat...)\\n(\\\"Ningen\\\"s Stil)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie sind widerstandsfähig, erholen sich schnell und verfügen über extrem flexible Gelenke, die sie weniger menschlich, sondern eher zu beweglichen Marionetten machen. Zu mächtig.")
	await novel_interface.show_text_only("Und sie haben ganz offensichtlich den Kuckuck gemacht. Wie programmgesteuerte Tötungsmaschinen.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahahaha... Jajajajajaja...", "Patchy Pythoness")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ihr unsinniges Geplapper klingt wie eine Art dämonischer Gesang. Definitiv kein Mensch.")
	await novel_interface.show_text_only("Plötzlich wird das Truppmitglied, das die Probenschachtel hält, von einem Pfeil getroffen. Während sie zu Boden fällt, rollt ihr die Kiste aus den Armen.")
	await novel_interface.show_text_only("Aber die Feinde scheinen es nicht eilig zu haben, es aufzuheben.")
	await novel_interface.show_dialog("Beth!", "Squad-Mitglied D")
	await novel_interface.show_text_only("Die Truppmitglieder, von den vorrückenden Feinden bis in die Tiefen des Ausstellungsraums gezwungen, schreien nach weiteren Anweisungen ihres Kommandanten.")
	await novel_interface.show_text_only("Dies ist eine Situation, in der kein normales Protokoll gilt. Alles, worauf sich Beth jetzt verlassen kann, sind ihre eigenen Sinne und ihr Urteilsvermögen.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Sie sind also nicht wegen der Proben hier?)", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Verdammt!", "Milch")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Dann muss ihr Ziel sein –)", "Beth")
	novel_interface.change_expression("angry")
	await novel_interface.show_text_only("– um uns alle zu vernichten.")
	await novel_interface.show_dialog("... \\n(Ihr seid es also tatsächlich... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beths Blick landet auf dem Symbol, das auf die Augenklappe eines dieser Puppenmädchen gestickt ist.")
	await novel_interface.show_text_only("Sie hat dieses Symbol unzählige Male gesehen, als sie den Tod ihres Vaters untersuchte.")
	await novel_interface.show_text_only("Es ist ein gruseliges, einsames Auge – ein Auge mit Gliedmaßen.")
	print("=== 深海恐惧症篇第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
