# bathophobia_ep05.gd - 深海恐惧篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep05_script()

func play_script():
	pass

func bathophobia_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_sleeping.png")
	await novel_interface.show_text_only("O que é a Alma?")
	await novel_interface.show_text_only("Uma forma de energia que preserva a consciência? Ou um estado quântico inobservável?")
	await novel_interface.show_text_only("Ou apenas um conceito…")
	await novel_interface.show_text_only("Assim como o conceito de tempo na física—")
	await novel_interface.show_text_only("Talvez seja apenas uma ilusão... um sonho.")
	await novel_interface.hide_background() 
	await novel_interface.show_text_only("Então a questão é—")
	await novel_interface.show_text_only("Quem é o sonhador?")
	novel_interface.show_background("res://assets/images/bg/Baizhu/submarineDetector.png")
	novel_interface.change_music("res://assets/audio/music/Sonar.mp3")
	await novel_interface.show_text_only("O frio cortante na Convergência Antártica bloqueia todo o ruído do mundo exterior.")
	await novel_interface.show_text_only("A 20.000 pés abaixo do nível do mar encontra-se a zona abissal.")
	await novel_interface.show_text_only("Envolto em um casco pressurizado de titânio, um submarino de águas profundas desce lentamente.")
	await novel_interface.show_text_only("A luz fraca emitida pelo seu indicador de status é rapidamente engolida pela escuridão abismal.")
	await novel_interface.show_text_only("Sem luz, é incapaz de perceber o espaço.")
	await novel_interface.show_text_only("Um assustador Fangtooth tenta atingir o casco, mas não recebe resposta.")
	await novel_interface.show_text_only("A pressão da água de 60 MPa coloca à prova o limite de tensão de compressão do casco.") #换行问题
	novel_interface.change_background("res://assets/images/bg/Baizhu/submarineDetector_Lighting.png")
	await novel_interface.show_text_only("De repente, oito holofotes pré-programados são ligados simultaneamente, lançando oito feixes de luz retos e estreitos.") #换行问题
	await novel_interface.show_text_only("Como espadas afiadas, os holofotes explodiram em um brilho deslumbrante e perfuraram a escuridão.")
	await novel_interface.show_text_only("Um feixe de luz passa pelas grossas vidraças da sala de controle e atinge o rosto de uma garota adormecida.")
	await novel_interface.show_text_only("Seus longos cabelos grisalhos escuros, brilhando com brilho azul, se espalham por seu rosto pálido, mas puro.")
	await novel_interface.show_text_only("O medidor de profundidade no painel em frente à garota para de funcionar a 4.091 pés.")
	await novel_interface.show_text_only("Os holofotes fora da sala desaparecem gradualmente. Mas um leve brilho prateado começa a cintilar pelo corpo da garota.")
	await novel_interface.show_text_only("Das profundezas do oceano, tão temido pelos humanos, surge uma voz profunda e distante.")
	await novel_interface.show_text_only("Como o chamado de um monstro antigo.")
	await novel_interface.show_text_only("A menina adormecida parece ter despertado do ventre da mãe.")
	await novel_interface.show_text_only("Também despertam tonturas e náuseas incontroláveis…")
	await novel_interface.show_text_only("Muito abaixo da profundidade de segurança de 15.000 pés, o casco de metal começa a emitir um som anormal de estalo.")
	await novel_interface.show_text_only("Uma tosse reprimida sai da garganta da garota.")
	await novel_interface.show_text_only("Ela tem algumas dificuldades para respirar no início, mas rapidamente se adapta à pressão subaquática e estabiliza a respiração.")
	await novel_interface.show_dialog("A colisão agora há pouco… Parece ter me nocauteado.", "Garota")
	await novel_interface.show_dialog("Mas ainda consigo respirar… Deve haver oxigênio suficiente.", "Garota")
	await novel_interface.show_dialog("Posso ver minha respiração… \\nPerto de 32 °F, com certeza…", "Garota")
	await novel_interface.show_dialog("Verificação do sistema. Pronto para uma inicialização a frio. \\nInformações de identificação: Beth.", "Garota")
	await novel_interface.show_text_only("A garota chamada Beth não parece se preocupar com a temperatura congelante. Ela verifica o sistema com atenção.")
	await novel_interface.show_text_only("Ela nasceu com a capacidade de suportar frio extremo. Quando a bebê Beth foi encontrada nas montanhas de inverno, ela já havia passado uma noite inteira no gelo.")
	await novel_interface.show_text_only("Vários exames físicos provaram que a menina milagrosa pode se adaptar a vários ambientes frios.")
	await novel_interface.show_text_only("Sob o frio intenso que pode deixar um adulto inconsciente em 30 segundos, a temperatura do corpo ainda está normal e as mãos quentes.")
	await novel_interface.show_text_only("Os médicos não conseguiram descobrir o porquê antes de ela ser levada do orfanato por seu pai adotivo.")
	await novel_interface.show_dialog("Sistemas de iluminação e propulsão… inicialização normal. Reinicialização do sensor… tudo bem.", "Beth")
	await novel_interface.show_dialog("Já tem 20.000 pés de profundidade? “Aquela coisa” não pode existir sob uma pressão de água tão alta.", "Beth")
	await novel_interface.show_dialog("Preciso economizar energia para a viagem de volta... Holofotes desligados...", "Beth")
	await novel_interface.show_text_only("Assim que os holofotes são desligados, Beth olha pela janela.")
	await novel_interface.show_dialog("O que…", "Beth")
	await novel_interface.show_text_only("Uma cena assustadora deixa seus cabelos em pé.")
	await novel_interface.show_dialog("O que é... isso...", "Beth")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Pouco antes dos holofotes se acenderem, uma gigantesca estrutura semelhante a um coral aparece do lado de fora da janela de observação.")
	await novel_interface.show_text_only("É uma estrutura centrípeta semelhante a um tecido. Nele, os vasos irregulares parecem uma cascata escarlate caindo em um enorme buraco negro.")
	await novel_interface.show_text_only("Mas nenhuma estrutura biológica ou topográfica foi encontrada durante a varredura agora.")
	await novel_interface.show_text_only("Beth imediatamente liga a lente grande angular do casco, tentando ter uma visão mais ampla...")
	novel_interface.show_background("res://assets/images/bg/Baizhu/sea_eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Na tela, há uma sombra enorme e nebulosa. Ele se estende por mais de 300 pés e tem tentáculos.")
	await novel_interface.show_dialog("Isso não pode ser…", "Beth")
	await novel_interface.show_text_only("Não faz parte da paisagem, mas com certeza é algum tipo de criatura. Manchas vermelhas de luz brilham na escuridão.")
	await novel_interface.show_dialog("Isso é... um globo ocular?", "Beth")
	await novel_interface.show_text_only("—Se essa coisa estranha pode ser chamada de “globo ocular”.")
	await novel_interface.show_text_only("O buraco negro voltado para a janela é a pupila do globo ocular.")
	await novel_interface.show_text_only("Está muito perto para determinar a distância. Parece provável que o casco seja sugado pela pupila a qualquer momento.")
	await novel_interface.show_text_only("As manchas vermelhas desaparecem. A garota agora está enfrentando o objeto desconhecido na escuridão silenciosa.")
	await novel_interface.show_text_only("Quando seus olhos se adaptam à escuridão, ela vê na tela o enorme globo ocular emitindo uma leve luz vermelha, como se fosse uma água-viva opaca.")
	await novel_interface.show_text_only("O globo ocular está cheio de pedaços de tecidos contorcidos. \\nEstá batendo junto com o coração dela.")
	await novel_interface.show_dialog("(Calma… relaxa!) \\n(Pense nisso…)", "Beth")
	await novel_interface.show_text_only("Se for um globo ocular, seu cristalino deve ser sensível à luz.")
	await novel_interface.show_text_only("Na camada externa do globo ocular, onde deveria existir a coróide, enxames de manchas brancas piscam.")
	await novel_interface.show_text_only("Beth percebe que tentáculos em forma de galhos estão presos na parte de trás do globo ocular.")
	await novel_interface.show_text_only("Os tentáculos cinza-escuros estão imersos nas profundezas do oceano, sem fim à vista.")
	await novel_interface.show_dialog("(... eu não consigo... me mover...)", "Beth")
	await novel_interface.show_text_only("—Beth é mais como ser observada, em vez de enfrentar Aquela Coisa.")
	await novel_interface.show_text_only("O olhar intrusivo corrói sua calma e a assusta.")
	await novel_interface.show_dialog("Ajuda…", "Beth")
	await novel_interface.show_text_only("—Vai engolir tudo?")
	await novel_interface.show_text_only("A estranha sensação de estar no fundo do oceano a faz duvidar de sua própria existência.")
	await novel_interface.show_dialog("(É um sonho…?) \\n(Acorde rápido…)", "Beth")
	await novel_interface.show_text_only("O corpo reage por instinto antes mesmo de a consciência acompanhar.")
	await novel_interface.show_text_only("Enquanto a garota puxava o joystick com a mão esquerda, a câmara de mergulho continuou a se mover uma certa distância em direção ao globo ocular.")
	await novel_interface.show_text_only("A água fica agitada como se Aquela Coisa estivesse sendo perturbada.")
	await novel_interface.show_text_only("A pupila se contrai, aguardando o próximo movimento da garota.")
	await novel_interface.show_dialog("Olá? Olá?", "Beth")
	await novel_interface.show_text_only("Beth pega seu fone de ouvido e tenta se conectar à mesa de controle.")
	await novel_interface.show_text_only("Mas nenhuma onda eletromagnética pode escapar desta profundidade e a comunicação acústica subaquática não é viável no momento.")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.show_text_only("Se ela estivesse lá... Ela teria gritado comigo— \\n\"Pare de se aproximar!\"")
	await novel_interface.show_dialog("Ha… por que eu pensaria nisso…", "Beth")
	await novel_interface.show_dialog("Quem é… \"Ela\"?", "Beth")
	await novel_interface.show_dialog("Onde... estou...", "Beth")
	await novel_interface.show_text_only("Observada pelo globo ocular gigante, Beth está perdida em transe. A fronteira entre realidade e ilusão está lentamente se esvaindo.")
	await novel_interface.show_text_only("Ela passa a mão por todo o painel.")
	await novel_interface.show_text_only("Ela logo localiza o controlador do braço do robô.")
	await novel_interface.show_dialog("(Eu realmente preciso...)", "Beth")
	await novel_interface.show_text_only("Ela recupera o fôlego, mas a luz ilusória continua a piscar diante de seus olhos.")
	await novel_interface.show_dialog("Pegue algumas amostras… E retire imediatamente…", "Beth")
	await novel_interface.show_text_only("Primeiro, aponte os holofotes para a frente…")
	await novel_interface.show_text_only("Então, configure o sistema de propulsão… velocidade máxima. Direção… reversa.")
	await novel_interface.show_text_only("Lutando para terminar a pré-configuração, a garota está quase à beira de perder a consciência.")
	await novel_interface.show_dialog("Pai, isso é… poluição espiritual… \\nEstou quase…", "Beth")
	await novel_interface.show_text_only("Beth opera o manipulador lentamente para liberar o braço do robô. Uma enorme agulha é revelada.")
	await novel_interface.show_dialog("Modo de sucção ativado… Sob tal pressão, uma aspiração rápida será suficiente…", "Beth")
	await novel_interface.show_text_only("O braço do robô se estende para frente até que a agulha seja inserida no vítreo.")
	await novel_interface.show_text_only("O nível de concentração do recipiente salta de 0 a 100% num instante.") #标点删除
	await novel_interface.show_text_only("Por um momento, a pupila fica distorcida. Se o som conseguiu penetrar no casco, ela deve ter ouvido um grito áspero…")
	await novel_interface.show_dialog("(Estou ouvindo coisas…)", "Beth")
	await novel_interface.show_text_only("Com seu último esforço, a garota pressiona o botão de execução programado.")
	await novel_interface.show_text_only("De acordo com o programa predefinido, os holofotes projetam oito feixes intensos de luz na pupila e a hélice começa a girar descontroladamente.")
	await novel_interface.show_text_only("O globo ocular recua com o estímulo da luz, e o casco começa a recuar e subir…")
	await novel_interface.show_text_only("Totalmente exausta, a menina desmaia e cai no chão.")
	
	print("=== 深海恐惧篇第5话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
