# bathophobia_ep02.gd - 深海恐惧篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep02_script()

func play_script():
	pass

func bathophobia_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("（歴史上のベアトリーチェは1290年に死亡）\\n\\n（今の彼女の肉体はレンの能力で創られたはず）", "マリル")
	await novel_interface.show_dialog("（魂を担う器を作るとは……）\\n\\n（もはや『神の領域』だな）", "マリル")
	await novel_interface.show_dialog("（この事実は絶対にバラしてはならない……）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("フハハハハハ……面白い……\\n実に面白いですねぇ……", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("そして、すでに調査済みかとは思われますが、\\n\\nスカイホテルでレンと一緒に行動していた\\n捜査員の名前はアニー・バースと言います。", "マリル")
	await novel_interface.show_dialog("彼女は、7年前の『自由光スタジアム事件』で\\n消失した5万人に及ぶ被害者の中の1人です。", "マリル")
	await novel_interface.show_dialog("それをレンが、異空間の中から救い出しました。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…………", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("おや、皆様あまり驚かれない様子で。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("確かに、それなら筋が通る……", "華音瀧")
	await novel_interface.show_dialog("彼女を堂々と本名のままで活動させているのは、\\n君が秘密にするつもりがないからだな。", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("マリル殿が秘密にする必要もありません。\\n\\n現在に至ってもアニーさんの当時の記録は、\\nネット上に多く残っておりますから。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("しかし、レンと言う少女の保護者となったのは、\\n完全に君の私情ではないのか？", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("ふふっ、もちろんです。", "マリル")
	await novel_interface.show_dialog("私は数年前からレンの能力に気付いてましたが…\\n\\n以前より彼女の両親が、第二学園都市への移住を\\n考えておりましてね……", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("やむを得ず『いくつか』の行動を\\n取らせて頂きました。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("彼女の両親と兄が遭遇したと言う航空事故……", "#C")
	await novel_interface.show_dialog("まさか……マリル殿が──？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("クククッ、……私は知りませんよ。", "マリル")
	await novel_interface.show_dialog("あの可愛い子猫の優しい保護者で\\n在りたいですからね──", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…………", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("さすがはSIDを主管する者の手腕。\\n実に合理的ですな。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("新豊洲の平和と安定のために、\\n一部の犠牲はやむを得ん。", "ギアーズ")
	await novel_interface.show_dialog("マリルとSID各員は実に完璧な仕事を\\n毎度こなしてくれている。", "ギアーズ")
	await novel_interface.show_dialog("では各国で昨今猛威を振っている時空位相波動\\nに関しても、\\n既に多くの情報をSIDは把握しているのだな？", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("記録によると、あの少女はたったの15歳だ。\\n\\nそんな少女をあのようなリスクの高いエリアに\\n派遣するのは……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("おっしゃる通りリスクは確かに高いですが、\\nその代価に見合う価値はあります。", "マリル")
	await novel_interface.show_dialog("レンが収集してくれた情報から推定できるのは、\\n時空異変の本質は確率の乱流ということです。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("確率が1兆分の1にも満たない事象すらも、\\n100%確定した形で示せる──", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("それは、まるで魔法ではないか！", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("なんとなんと……\\n是非とも手に入れたい夢の能力でありますな……", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("いや違うな。\\nその状況が成立するのは理論上だけだ。\\nそれは非常に強大な観測者を必要とするだろう。\\nそんな事を実現するとしたら……", "ブライト")
	await novel_interface.show_dialog("──やはり有り得ない。\\n\\n全人類の注意をたった1つの物体に集中させたと\\nしても、必要となる観測強度には到達できない。", "ブライト")
	await novel_interface.show_dialog("唯一できるのは……", "ブライト")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("唯一できるのは、\\n異質物を創り出した存在…………ですね。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…………", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("はぁ～～", "ギアーズ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ギアーズ博士が長い溜め息を吐くと、\\nしばしの沈黙が訪れた。")
	await novel_interface.show_text_only("「誰が異質物を作り出したのか」に関しては、\\n長きに渡り科学界が故意に避けてきた話題だ。")
	await novel_interface.show_text_only("それは「宇宙のビッグバンは誰が起こしたのか」\\nと同義である。\\n反証可能性がないモノ。\\nこれらは科学にとって議論の範囲外である。")
	await novel_interface.show_text_only("例えばハッブル距離より遠方の場所。\\n\\n宇宙空間の膨張によって、地球から超光速で\\n離れる星系を研究しようとした科学者がいた。")
	await novel_interface.show_text_only("彼らは主張した。\\n『観測可能な宇宙』は氷山の一角にしか過ぎない\\n私達はわざと「見えない部分」を避けているだけ\\nであると。")
	await novel_interface.show_text_only("当たり前のように避ける。\\n\\nそれこそ科学が人間に安心感をもたらしてくる\\n真の正体なのかもしれない。")
	await novel_interface.show_text_only("もし、本当に『神』に匹敵するほどの観測者が\\nこの世にいるのであれば。\\nその存在の前では地球上の人類など\\n彗星の尾にある塵埃も同然である。")
	await novel_interface.show_text_only("そんな『神』は私達を目にかけない……\\n\\n人類は自分で自分を救うしかない……")
	await novel_interface.show_text_only("これは、黒く冷たい広大な宇宙の中で、\\n一番恐ろしい事実であろう。")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("……以上により『位相波動空間』は、\\n不規則かつ大規模な確率崩壊による事象である\\nと思われます。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("この事象は有限なる時空の中、人知を超越した\\n観測者を召喚する事で発生します。", "マリル")
	await novel_interface.show_dialog("召喚者の理性が観測者に呑み込まれた場合、\\n確率乱流の発生によって、\\n時空異変が生じるようです。", "マリル")
	await novel_interface.show_dialog("しかし、異変区域に入り召喚者を抑制する事で\\n根本的な影響を排除する事が可能となるようで、", "マリル")
	await novel_interface.show_dialog("既に新豊洲の異変区域で複数回と試しましたが、\\nそれが有効な対策だと実証済みです。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("干渉をしなければ、異変空間は完全に蒸発。\\n\\n範囲内にエントロピーの爆増を\\n引き起こしてしまう以外に──", "マリル")
	await novel_interface.show_dialog("蒸発が発生した地点で1人、または複数人の\\n理性が崩壊した超能力者が出現。\\nさらなる破壊に繋がる可能性が急増します。", "マリル")
	await novel_interface.show_dialog("現時点では理性の喪失は不可逆的な物であり、\\n\\n攻撃者の特徴も中世の歴史文献に記述されている\\n『ドール』に対する記述と一致しています。", "マリル")
	await novel_interface.show_dialog("唯一の幸いは異変空間が蒸発した後であれば、\\n\\n一般的な手段でもドールの鎮圧が可能である。\\nという点でしょうか。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("……以上となります。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("静まり返る────")
	await novel_interface.show_text_only("機密通信の向こう側から、少し間を置こうとする\\nような深呼吸の音が聞こえる。\\n──それ以外は静寂のみ。")
	await novel_interface.show_text_only("いくら新豊洲の権力の頂点に立つ人間でも、\\nこのような情報を即座に処理するなど困難だ。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("確かに……", "ギアーズ")
	await novel_interface.show_dialog("新豊洲での時空位相波動による破壊被害は、\\n他の学園都市に比べ遥かに少ない。", "ギアーズ")
	await novel_interface.show_dialog("今まで我々はイージスの効果だと考えていたが…", "ギアーズ")
	await novel_interface.show_dialog("……こうなると、その少女の能力は\\n確かに『機密』にする必要がある。", "ギアーズ")
	await novel_interface.show_dialog("マリルが直に監視保護下に置く判断も、\\n正しい選択だ。", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("しかし君が言った全てに証拠があるのだろうか？", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("SIDはモニタリングデータを完璧な形で\\n残しています。", "マリル")
	await novel_interface.show_dialog("また、他の学園都市の異変区域近くで現れた\\n意思の疎通が図れない強大な破壊能力を持つ、\\n人型生物の情報も数多くあがっています。", "マリル")
	await novel_interface.show_dialog("先日、江森変電所においても似たような状況が\\n発生しました。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("この情報ついては、#C博士もご存知ですね？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルがスクリーン上の暗号化によって\\n隠蔽された顔を見つめている。")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("アンチスキャンモジュールが搭載されたヘリで、\\n江森変電所からマリル殿が凱旋する時の雄姿は\\n決して忘れる事はありませんとも。", "#C")
	await novel_interface.show_dialog("もしあのヘリに『レンさん』がいたとしても\\n私めは何の疑問にも思いませんな。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（南哲の部下も、情報を漏らしていないようだ）", "マリル")
	await novel_interface.show_dialog("レンをスカイホテルに派遣したのも、\\n中立エリアで異変が起こる状況を防ぐためです。", "マリル")
	await novel_interface.show_dialog("まさか肝心な証拠品が、別の集団によって\\n奪われる事になるとは思いませんでしたが……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("と言う事は、君は最初から黄金バタ──", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("──マリルの判断は正しい。", "ギアーズ")
	await novel_interface.show_dialog("その『レン』と呼ぶ娘の能力。\\nその起動方法や限界をテストした事はあるかね？", "ギアーズ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ギアーズは素早くブライトの話を途中で遮り、\\n話題をそらした。")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("…………", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("（ふん、ボロが出たな）", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("特殊な防護設備が必要なため、当面は実験計画を\\n立ててはおりません。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("モニターの向こう側は、少々不満気のようだ。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("これほど特別な素材は珍しい。\\n協力が必要なら元老院に申請したまえ。", "ギアーズ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは頭を下げ、狡猾な笑顔を浮かべた。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("現時点では別次元の空間に、私達が対処不能な\\n危険が存在するかどうかを確認できません。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("たとえ『人物』や『物品』などの回収に\\n成功したとしても、\\nそれらに攻撃性がない事をどうやって\\n保証できるのでしょうか？", "マリル")
	await novel_interface.show_dialog("歴史上には「黒死病は魔女の力で起きた」なんて\\n噂もありましたからね……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("しかし、こんなに面白い研究を全てマリルに\\n任せるわけにはいかんなっ。", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("…………", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("あの『レン』を是非とも、私の実験室に\\n連れて来てはくれないだろうかっ？\\nフッハハハハハ──", "ブライト")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ブライトは電流の音のような笑いを爆発させる。")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("この子猫を誰に引き取ってもらいたいか迷っています…できれば私も育ててみたいです〜", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("…………", "ギアーズ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("…………", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("レンの保護者としてお二人のリクエストは、\\n丁重に拒否させて頂きます。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──マリルは軽く笑う。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("しかし──", "マリル")
	await novel_interface.show_dialog("元老院の方々がこれほどまでに、\\nレンを重要視されるのであれば。\\nここは私に1つ提案があります……", "マリル")

	print("=== 深海恐惧篇第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
