# bathophobia_ep21.gd - 深海恐惧症篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep21_script()

func play_script():
	pass

func bathophobia_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("As estranhas figuras que apareceram de repente no corredor vêm direto para nós.")
	await novel_interface.show_text_only("Eles estão totalmente silenciosos – além do som de tecidos farfalhando e passos. Eles ainda precisam respirar?")
	await novel_interface.show_text_only("Seguro minha arma com força, me preparando mentalmente. É quando fortes raios de luz saem do traje de batalha de Henriette. Ela desaparece de vista num piscar de olhos, deixando para trás nada além de uma nuvem de fumaça brilhante.")
	await novel_interface.show_text_only("Enquanto eu ainda estava atordoado, Heinrich já havia se esquivado na frente de uma pessoa e atingido uma das mulheres no peitoral com as costas de sua espada de lápis-lazúli.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Uau, ela tem alguns movimentos!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O som alto e abafado de sua arma atingindo o alvo ecoa pelas paredes do corredor. Juro que meu peito dói só de ouvir isso.")
	await novel_interface.show_text_only("Seu alvo cai no chão como uma marionete de madeira e rola para longe.")
	await novel_interface.show_text_only("Qualquer ser humano teria se movido instintivamente para se proteger de mais ferimentos – mas essa garota-fantoche não faz nada disso.")
	await novel_interface.show_text_only("Assim que ela para de rolar, ela simplesmente salta, com amassado no peito e tudo, e ataca nós.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…!","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebendo que não se trata de inimigos comuns, Henriette se vira e atravessa os calcanhares de três deles na velocidade da luz.")
	await novel_interface.show_text_only("Os três, com os tendões cortados, caem no chão – mas continuam rastejando em nossa direção em movimentos assustadoramente silenciosos e espasmódicos.")
	await novel_interface.show_text_only("Eles não parecem tão assustadores à primeira vista, mas o fato de mostrarem características claramente não humanas é... muito perturbador, para dizer o mínimo.")
	await novel_interface.show_text_only("Eles parecem humanos. Eles não agem como humanos. Isso é assustador como o inferno.")
	await novel_interface.show_text_only("Após confirmar que os inimigos não representarão mais uma ameaça, Raphael avança na tentativa de ver o que há com eles.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("De repente, o chão começa a tremer novamente.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Second_Earthquake.png")
	await novel_interface.show_dialog("Outro terremoto?","Henriette")
	await novel_interface.show_text_only("Desta vez, o terremoto é mais intenso e dura muito mais tempo.")
	await novel_interface.show_text_only("Junto com os tremores, as luzes no corredor acendem e apagam, seguindo o que parece ser um grito estridente – ou talvez metal sendo puxado.")
	await novel_interface.show_text_only("Os inimigos no terreno parecem se transformar em... líquido transparente? Espuma? Bem diante dos nossos olhos.") #换行问题
	await novel_interface.show_text_only("O líquido então começa a ferver e borbulhar, como se estivesse em uma tábua de teppanyaki. Em segundos, o que antes eram figuras em forma humana evaporaram-se no nada.")
	await novel_interface.show_text_only("Eles não deixam vestígios nas tábuas frias do piso. É como se aquelas garotas bizarras nunca tivessem existido.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	await novel_interface.show_text_only("Nosso entorno também parece ter mudado depois do terremoto.")
	await novel_interface.show_text_only("Os ornamentos de madeira da sala de arquivo desmoronaram, tornando-se mera serragem flutuando no ar. A pintura das paredes também descascou.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("__ELIPSIS__ Hein?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ainda é a mesma sala de arquivo...")
	await novel_interface.show_text_only("Mas as luzes estão apagadas. Os ladrilhos do chão não brilham mais. E os itens na prateleira – organizados de maneira completamente diferente.")
	await novel_interface.show_text_only("Atrás das grossas vigas de aço de aparência industrial, outra câmera de vigilância com sensor de som apontou suas lentes escuras para nós.")
	await novel_interface.show_text_only("Na parede há um mapa topográfico detalhado da Antártica, e sobre a mesa um caderno registrando mudanças nos dados atmosféricos.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("O que... o que é isso?","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("O que acabamos de ver... foi uma ilusão?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Essas garotas fantoches também?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette olha para sua arma – não está manchada de sangue, embora devesse estar. Ela então olha para onde nossos atacantes repentinos aparentemente evaporaram.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Talvez o que estávamos em... não fosse o mundo real.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich foi subitamente interrompido pela voz de Li Tong.")
	await novel_interface.show_dialog("Finalmente! Uma conexão!","Mariru")
	await novel_interface.show_text_only("A voz de Mariru explode em... dentro do meu peito?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Ei, Mariru! O que há com o sinal?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru cantarola, parecendo exausto. Enquanto isso, Henriette está olhando horrorizada para meu peito, confusa sobre por que a voz de Mariru está vindo de lá.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Ei, isso é um mal-entendido, eu juro!)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vendo a expressão em meu rosto, Henriette balança a cabeça, como se entendesse, e começa a apalpar os próprios seios também.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Sussurrando) O Mestre... modificou meu corpo dessa forma também?","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_text_only("Claro que não! E por que você parecia animado com isso?")
	await novel_interface.show_dialog("Ei, a propósito, por que você não nos contatou pelo walkie-talkie?\\nAnnie está bem?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O satélite de comunicações está em posição agora. Annie está coletando informações sobre as fontes dos vazamentos de metano. Como está indo aí?","Mariru")
	await novel_interface.show_text_only("Eu tento o meu melhor para organizar meus pensamentos e relatar tudo o que encontramos depois de entrar na base da forma mais concisa possível.")
	await novel_interface.show_dialog("... \\n(Não é o mundo real, hein... )","Mariru")
	await novel_interface.show_dialog("Espere um segundo, deixe-me verificar a hora.","Mariru")
	await novel_interface.show_dialog("Oito minutos se passaram desde a última vez que você contatou Annie no portão da base.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("... Apenas oito minutos?","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("Não deveria ter passado pelo menos quarenta minutos?","Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como se percebesse algo, Mariru começa a digitar.")
	await novel_interface.show_dialog("Um contratorpedeiro da classe Lebona patrulhando o Oceano Antártico acaba de receber algum tipo de sinal de baixa frequência.","Mariru")
	await novel_interface.show_dialog("Achei que fosse um tremor secundário, mas considerando como as coisas estão agora...","Mariru")
	await novel_interface.show_text_only("Mariru acessa seu sistema EEG e executa novamente uma análise de padrão.")
	await novel_interface.show_dialog("Assim como eu esperava...","Mariru")
	await novel_interface.show_dialog("Este sinal... tem o mesmo padrão das ondas cerebrais durante o sono REM humano...","Mariru")
	await novel_interface.show_dialog("... Mas sessenta e duas vezes mais intenso.","Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("... Você está brincando comigo?","Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Você quer dizer que estávamos sonhando agora há pouco?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("O tempo fica mais lento quando você sonha, isso é verdade...","Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","normal",0.25)
	await novel_interface.show_dialog("Os sonhos refletem memórias. E o que aconteceu... realmente pareceu uma recombinação de diferentes fragmentos de memória.","Henriette")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se isso foi um sonho, então foi definitivamente um pesadelo...","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente, me lembrei de um filme que assisti, onde os personagens usavam totens para saber se estavam sonhando ou não. Gostaria de ter um desses.")
	await novel_interface.show_dialog("... Talvez não fossem vocês que estavam sonhando. Você pode estar no sonho de outra pessoa.","Mariru")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	await novel_interface.show_dialog("O sonho de outra pessoa...?","Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tudo isso são apenas especulações, é claro, servindo apenas para me enervar ainda mais. Percebo que está meio barulhento do lado de Mariru - parece que muitas pessoas estão ocupadas trabalhando perto dela.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","serious",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("A propósito, como é... por aí?","Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru permanece em silêncio por um momento, como se estivesse tentando decidir o quanto ela quer revelar.")
	await novel_interface.show_dialog("É um pouco mais... complicado do que esperávamos.","Mariru")
	await novel_interface.show_dialog("O Congresso Unido está actualmente a discutir como resolver o problema do vazamento de metano. Mas você sabe como é o tipo de pessoa deles. De jeito nenhum eles serão capazes de lidar com um evento de nível apocalíptico como este.","Mariru")
	await novel_interface.show_dialog("Deckers de Salmonton propôs um plano para usar archaea metanófila...","Mariru")
	await novel_interface.show_dialog("Mas não há muito disso em estoque atualmente, especialmente do tipo que pode sobreviver no frio. E é tarde demais para cultivar mais do zero.","Mariru")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Além disso, as bactérias anaeróbicas não podem fazer muita coisa na nossa atmosfera porque o oxigénio as mata.","Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Então até o vovô está perplexo, hein...","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("(Não tenho ideia do que eles estão falando...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Actualmente, a maioria das estações de investigação de média e pequena escala estão em processo de evacuação, embora uma equipa de emergência temporária já tenha sido criada pelas três principais bases antárcticas.","Mariru")
	await novel_interface.show_dialog("Até agora, foram identificadas quarenta e duas fontes de vazamento de metano no Círculo Antártico. Seis já foram acionados e as fotos desses sites estão se espalhando como um incêndio na internet neste momento.","Mariru")
	await novel_interface.show_dialog("E nos canais de notícias também. Todas as televisões do mundo provavelmente estão agora a transmitir imagens de chamas expelidas de fendas nas planícies de gelo polares, atingindo dezenas de metros de altura.","Mariru")
	await novel_interface.show_dialog("Não há como eles manterem isso em segredo por mais tempo. O mundo sabe, e eles estão claramente em pânico – alguns já estão celebrando: um último grito antes do fim do mundo.","Mariru")
	await novel_interface.show_text_only("As palavras de Mariru são cínicas, seu tom desamparado.")
	await novel_interface.show_dialog("Os locais de vazamento estão concentrados perto de vários lagos sem gelo e na área do Monte Erebus, na Ilha Ross.","Mariru")
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("... Monte Érebo? Isso é um vulcão.","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quanto à Estação de Pesquisa Princesa Elisabeth na Antártica, perto de sua localização, dois pequenos incêndios já começaram devido aos vazamentos de metano.","Mariru")
	await novel_interface.show_dialog("Há também um incêndio iniciado por um grupo de membros ricos e desmiolados do grupo de turismo do Monte Grove que estavam brincando com pulverizadores de chamas. Idiotas.","Mariru")
	await novel_interface.show_dialog("Pelo menos a Base Snedronningen não está em perigo imediato neste momento.","Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ufa…","Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Legal. Pelo menos não corremos o risco de sermos fritos... ainda.)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("... No entanto, a Estação McMurdo detectou atividade de fluxo de lava em grande escala sob as fissuras.","Mariru")
	await novel_interface.show_dialog("A fissura perto da Base de Snedronningen é a mais proeminente e as camadas de gelo que a rodeiam estão a tornar-se cada vez mais instáveis a uma velocidade alarmante.","Mariru")
	await novel_interface.show_text_only("Não consigo deixar de olhar para as tábuas de metal sob meus pés.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("(Então ainda vamos fritar de qualquer maneira, hein...)","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um barulho repentino e agudo rasga o ar. Meu peito vibra e a próxima coisa que sei é que estamos desconectados.") #换行问题
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Chamas jorrando do chão, lava fluindo, fuligem vulcânica mortal...","Henriette")
	await novel_interface.show_dialog("É muito parecido com o que aconteceu há cerca de quatrocentos anos...","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Todos estes são precursores do colapso da “substância primordial”.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Você quer dizer o que aconteceu em 1600?","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Isso foi na Sétima Partícula, a Terra da Abundância: o Distrito do Governador do Peru.","Henriette")
	await novel_interface.show_dialog("Nunca esquecerei o mar de fogo, o cheiro pungente de enxofre no ar...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette relembra, parecendo amarga, e não posso deixar de ficar emocionada, pois também tive uma experiência muito semelhante.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Então... tudo isso tem a ver com aquele cara “The One” que você mencionou?","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette assente.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/Ampthitheatre.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Naquela época, meus amigos do Rosenkreuzer e eu coletamos três livros místicos: Livro da Carruagem, Livro da Criação e Livro da Luz.","Henriette")
	await novel_interface.show_dialog("Seguindo as instruções dos livros, completamos a maior conquista de todos os tempos na alquimia: criar um “portal” que poderia nos levar ao reino cármico.","Henriette")
	await novel_interface.show_dialog("Sendo ingênuos, acreditamos honestamente que o portal nos levaria a um Overlord benevolente e onisciente, que nos mostraria todas as verdades do mundo.","Henriette")
	await novel_interface.show_dialog("... Mas na verdade há uma razão pela qual existem as regras “não passar pelo portal” e “não buscar a verdade”...","Henriette")
	await novel_interface.show_dialog("Pois uma vez que você entrar no portal, você nunca encontrará a saída.\\nE uma vez que você veja a verdade, ela ficará gravada para sempre em sua mente.","Henriette")
	await novel_interface.show_dialog("Os humanos só são capazes de compreender a linguagem.","Henriette")
	await novel_interface.show_dialog("Qualquer coisa que não possa ser descrita pela linguagem está além de nós.","Henriette")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Essa é uma filosofia que alguém criou no século XX.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("Ah? Alguém chegou a essa conclusão apenas por... filosofar?","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Essa pessoa deve ter passado por muita dor, então.","Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Claro que sim. Toda a sua família era considerada lunática.","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("Sim. Ele deve ter sido um homem sábio. Exceto que esse tipo de sabedoria serve simplesmente para corroer o seu ego até que você se torne parte dele, tão medroso, tão desesperado.","Henriette")
	await novel_interface.show_dialog("Eu também fiz parte desse processo uma vez. E foi aí que The One apareceu na minha frente...","Henriette")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Sem dizer uma palavra, ele me fez escolher.","Henriette")
	await novel_interface.show_dialog("Quero desaparecer como uma gota no oceano?","Henriette")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ou tornar-se uma única gota numa garrafa, preservada para a eternidade, existindo como guardiã da Árvore da Vida?","Henriette")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room_Old.png")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…","Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Eles miraram em você quando você era o mais fraco...","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("E a chamada Árvore da Vida – não é o que dizem que é, certo?","Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette sorri, um pouco triste.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("... É uma espécie de selo.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("As Dez Sephiroth da Árvore da Vida atuam como um selo que mantém um ser indescritível – temido até mesmo pelo Único – à distância.","Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Eu não sei exatamente o que esse ser é.","Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Talvez eu devesse ficar aliviado por não saber.","Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Henriette faz uma pausa.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("(Na cratera de Enaptina, que parece estar prestes a queimar tudo) \\n (Uma vez eu provei isso...)","Henriette")
	await novel_interface.show_dialog("O Único nunca disse explicitamente o que queria, mas não é difícil dizer o que é pela forma como a nossa terra mudou...","Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela ri, sem humor.")
	await novel_interface.show_text_only("Um silêncio incômodo se apodera de nós com as palavras de Henriette.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Espere!","Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pego o cromatógrafo gasoso e aponto para os números nele.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Mesmo que estejamos num “sonho” agora, a “realidade” aqui ainda não é diferente de outros lugares?","Lian")
	await novel_interface.show_dialog("Veja, o nível de metano próximo à rachadura fora da base está disparando, já ultrapassando 25%. Mas aqui embaixo, o nível de metano ainda é muito menor do que isso...","Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Isso não é contraditório? E nem percebemos!","Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Espere, o que você quer dizer?","Raphael")
