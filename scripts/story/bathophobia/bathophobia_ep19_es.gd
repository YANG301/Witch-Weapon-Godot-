# bathophobia_ep19.gd - 深海恐惧症篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep19_script()

func play_script():
	pass

func bathophobia_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("Bajamos las escaleras y llegamos a una sala de exposiciones.")
	await novel_interface.show_text_only("Sorprendentemente, los sistemas de energía y ventilación todavía parecen funcionar bien. La calidad del aire aquí parece buena.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Es un edificio tan grande... pero ¿por qué se siente tan vacío?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Aunque todo parece estar funcionando bien...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las exposiciones están iluminadas con un brillo espeluznante. El sonido de los ventiladores funcionando se puede escuchar desde lejos.")
	await novel_interface.show_text_only("Está oscuro, lo suficientemente oscuro como para ocultar a cualquier depredador potencial, escondiéndose en los rincones, observando cada uno de nuestros movimientos...")
	await novel_interface.show_text_only("Observamos atentamente nuestro entorno antes de dirigir finalmente nuestra atención a los objetos expuestos.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("¿Son estos especímenes...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me llama la atención una pieza expuesta en una vitrina transparente, sostenida por una rejilla de vidrio orgánico. Se parece a una especie de animal marino.")
	await novel_interface.show_text_only("Tiene un cuerpo resbaladizo y brillante de color blanco translúcido. La cola también es elegante. Parece el tipo de animal que sólo podría sobrevivir en las profundidades del océano.")
	await novel_interface.show_text_only("Si su espalda se ve así, me pregunto cómo se verá de frente...")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("... !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me acerco al otro lado para echar un vistazo y jadeo de sorpresa y disgusto.")
	await novel_interface.show_text_only("La criatura tiene ocho garras gruesas e impropias, cada una con dos articulaciones, muy parecidas a los dedos humanos.")
	await novel_interface.show_text_only("Y en sus palmas hay lo que parecen pequeñas bocas que contienen minúsculos dientes con púas. En lugar de los labios hay tejido musculoso rojo.")
	await novel_interface.show_text_only("Me recuerda a esos extraterrestres que se aferran a tu cara y nunca te sueltan, de esos que ves en las películas de terror de serie B.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","perspire",0.25)
	await novel_interface.show_dialog("¿Por qué algo como esto estaría en exhibición...?", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Es esto algún tipo de accesorio de película?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("No. Este es un espécimen de una criatura real y existente.", "Raphael")
	await novel_interface.show_dialog("Fue el resultado de un experimento genético fallido durante la guerra. He visto muchos de ellos en el Instituto de Investigación Salmonton.", "Raphael")
	await novel_interface.show_dialog("Más tarde se demostró que no valían nada y fueron abandonados después de un tiempo.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Aun así, la gente suele tratarlos como residuos biológicos...", "Raphael")
	await novel_interface.show_dialog("Es raro ver algo así en exhibición, como si fuera una obra de arte.", "Raphael")
	novel_interface.change_2nd_expression("jeer")
	await novel_interface.show_dialog("El dueño de esta instalación debe ser un canalla. ¡Incluso más asqueroso que tú!", "Raphael")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡No soy un asqueroso! ¡Caray!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De todos modos, esto realmente parece un poco... ya sabes... inquietante.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Y lo que es peor, aquí no hay nadie.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Es como una ciudad enteramente vacía. Se nota que algunas esquinas se están oxidando por el desuso.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","shout")
	await novel_interface.show_dialog("¡Oye! ¡Cuida tus pasos!", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¡¿Eh?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tropiezo con un cartucho y caigo hacia la vitrina. Justo cuando estoy a punto de golpearme la cabeza con la esquina afilada...")
	await novel_interface.show_text_only("Raphael da un paso adelante y me hace retroceder en el tiempo.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Que torpe...", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	await novel_interface.show_dialog("¡Uf! ¡Eso estuvo cerca!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Gracias, Raphael.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Abro los ojos y me encuentro en los brazos de Raphael, como si estuviéramos realizando un baile de salón. Tengo que admitir que se ve... agradable, así. Material de novio total.")
	await novel_interface.show_text_only("Raphael tose torpemente y me libera de sus manos.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Corridor.png")
	await novel_interface.show_text_only("Salimos de la sala de exposiciones para encontrarnos con un pasillo, con el suelo cubierto por tablas metálicas.")
	await novel_interface.show_text_only("Aquí las luces son mucho más brillantes. El ambiente también es mucho más inquietante. Demasiado silencioso. No me gusta.")
	await novel_interface.show_text_only("Aún así, se oye el ruido blanco de las máquinas en funcionamiento. Lo que significa—")
	await novel_interface.show_text_only("Esta base no está completamente muerta.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Si todavía hay alguien cerca para manejar las máquinas, ¿no debería haber salido ya a recibirnos?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","smile",0.25)
	await novel_interface.show_dialog("O, si no son del tipo amigable, también podrían haber lanzado un ataque.", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("De repente noté un punto de luz que se movía en la oscuridad. Después de mirar más de cerca, descubrí que era una cámara de vigilancia no muy lejos la que estaba orientada hacia nosotros.")
	await novel_interface.show_text_only("Lo saludo con la mano.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Uh, disculpe...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Te ves tan femenina haciendo esto.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comenta Raphael.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Vamos, quienquiera que esté ahí, ¿no podrías simplemente salir y hablar con nosotros?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Aún así, no siento que alguien nos esté mirando...", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(¿Quizás la cámara de vigilancia se había vuelto hacia nosotros porque detectó nuestros pasos? ¿Quizás nadie la está controlando?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sin embargo, los dispositivos activados por sonido no se utilizan desde hace décadas. Demasiado débil. Incluso un pequeño generador ultrasónico podría paralizarlos.")
	await novel_interface.show_text_only("La cámara de vigilancia sigue encendida, pero no parece que nadie la esté manejando.")
	await novel_interface.show_text_only("Estoy un poco decepcionado y decido asustar un poco a la pobre Raphael. En tono pretencioso y siniestro le digo:")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Mira, puede que no me creas, pero en realidad...", "Lian")
	await novel_interface.show_dialog("Puedo ver gente muerta...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿... quieres decir que hay fantasmas aquí?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael chilla con una voz inusualmente aguda.")
	await novel_interface.show_text_only("Luego se da cuenta de que solo estoy haciendo una payasada y corre para golpearme en la cabeza.")
	await novel_interface.show_text_only("En un intento de retroceder, caigo al suelo y mi Fire Jade se sale de mi camisa.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Raphael, no era mi intención... ¡ah... achu!\\nLo siento, no sabía que eras un gato tan asustadizo...", "Lian")
	await novel_interface.show_dialog("Uf, qué frío...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¡Mmm!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se calma un poco cuando me ve acurrucada en el suelo, temblando de frío sin la protección del jade.")
	await novel_interface.show_text_only("¿Por qué hace tanto frío aunque estamos adentro...?")
	await novel_interface.show_text_only("Me apresuro a recoger mi Fire Jade.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿No hace demasiado frío? ¿Cómo es que la gente de la base vive así?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observando atentamente, descubrí que muchos lugares en las esquinas de la pared ya estaban congelados...")
	await novel_interface.show_text_only("Me recuerda vagamente a un juego sobre supervivencia en el hielo y la nieve...")
	await novel_interface.show_text_only("Ese juego trataba de producir recursos o algo así. Y tuvo un final bastante extraño.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("(Espera...)", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Henriette vuelve a colocar la palma de la mano en la pared.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oye, no destruyas esa pared también...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella es el tipo de persona que arrancaría un pilar entero si no tuviera cuidado.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("Algo no se siente bien.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El alquimista rubio frunce el ceño, con rostro solemne.")
	await novel_interface.show_text_only("Una onda de aire parece fluir en todas direcciones, comenzando desde donde presiona su palma.")
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("…", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","serious")
	await novel_interface.show_dialog("... Estamos atrapados.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("¿Eh?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corro hasta el final del pasillo. La puerta de la sala de exposiciones no está cerrada con llave. No, estamos bien. Totalmente no atrapado.")
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Deja de asustarme, caray...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con una mano sobre mi corazón, me dirijo hacia la sala de archivos por la que acabamos de pasar. La puerta está abierta.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Reference_Room.png")
	await novel_interface.show_text_only("La habitación está muy iluminada y parece mucho más acogedora que el pasillo.")
	await novel_interface.show_text_only("Demasiado ocupado mirando a mi alrededor, casi tropiezo con una grieta en las baldosas del piso.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Cuida tus pasos, torpe.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael está parada en la puerta de la sala de archivos, mirándome con una mano y vigilando a Henriette con la otra. El alquimista todavía parece estar desconcertado sobre la pared del pasillo.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Espera. ¿Por qué siento una corriente de aire en esta habitación?", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("¿Podría ser...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saco mi Fire Jade y lo coloco sobre la mesa, para poder sentir mejor la temperatura en la habitación.")
	await novel_interface.show_text_only("Efectivamente, la temperatura aquí es mucho más alta que en el gélido corredor. Hay calefacción, tan cálida que cuesta creer que estemos en la Antártida.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿Eh…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Espera. Cuando pasamos por esta habitación, recuerdo haber echado un vistazo al estante.\\nAlgo se ve diferente...")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(... ¿O es solo mi memoria jugándome una mala pasada?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rascándome la cabeza, camino hacia la puerta.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Cuida tus pies.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Te tengo. Casi tropecé con esa gigantesca grieta en el suelo hace un momento. No volveré a cometer el mismo error.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—digo, señalando hacia el suelo para dejar claro mi punto. Pero espera...")
	await novel_interface.show_text_only("No hay ninguna grieta. Los azulejos están todos intactos.")
	await novel_interface.show_text_only("Baldosas de mármol lisas y elegantes. Casi como un espejo. Incluso refleja mis bragas azules y blancas.")
	await novel_interface.show_text_only("Vaya. Inmediatamente cierro las piernas.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algo realmente no está bien.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("... ¿Algo malo, Ren?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Qué estás haciendo ahí?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hubo una grieta aquí hace un momento. Pero se ha ido...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No pude haberlo recordado mal, porque casi tropecé con él.")
	await novel_interface.show_text_only("El suelo, donde debería haber habido una grieta...")
	await novel_interface.show_text_only("La sala de archivos, el único lugar con calefacción...")
	await novel_interface.show_text_only("El estante, en el que los objetos parecen haber cambiado de orden...")
	await novel_interface.show_text_only("Puedo sentir mi corazón latiendo locamente en mi pecho.")
	await novel_interface.show_text_only("Con cautela, doy un paso adelante.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Oye, ¿a qué te refieres con conectar en las grietas? ¿Todavía quieres que te ayude...?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael suena molesta. Definitivamente no está bromeando; realmente ve una grieta en el suelo.")
	await novel_interface.show_text_only("Pero hasta donde puedo ver (y sentir), no hay ninguna grieta.")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("... Algo no está bien. Lo que ves y lo que veo... son diferentes.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Cómo podría ser eso...?")
	await novel_interface.show_text_only("Nervioso, tomo mi walkie-talkie en un intento de comunicarme con Annie o Mariru. Eso al menos me daría una apariencia de seguridad.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hola? Annie? ¿Tú allí?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No hay respuesta. Después de todo, estamos bajo tierra, la señal probablemente no llegue tan lejos.")
	await novel_interface.show_text_only("Al notar la confusión en mi rostro, Raphael y Henriette también entran a la sala de archivos.")
	await novel_interface.show_text_only("La sala de archivos que se ve completamente diferente a la que acabamos de pasar.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Siento que estoy soñando, pero sé que no.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Esta habitación y la que pasamos por... no son la misma habitación.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, escuchamos chasquidos extraños e inquietantes que provienen del pasillo exterior.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("¿Quién está ahí?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/xiaolianContact.png")
	await novel_interface.show_text_only("Raphael y Henriette entran en modo batalla de inmediato.")
	await novel_interface.show_text_only("Justo detrás de mí viene corriendo toda una horda de enemigos con miradas siniestras en sus rostros y espadas en sus manos.")
	await novel_interface.show_text_only("No hay nada en sus ojos excepto pura hostilidad.")
	await novel_interface.show_text_only("Agarro fuerte mi bate de béisbol...")
	print("=== 深海恐惧症篇第19话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
