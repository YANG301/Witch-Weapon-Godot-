# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Quando esco dalla Coupé rossa di Mariru, sento il mondo intero girare e riesco a malapena a stare in piedi.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru… Bleah… \\nIl modo in cui guidi!! È pazzesco!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stamattina presto mi stavo rannicchiando con una coperta accogliente come al solito. All'improvviso, Annie ha fatto irruzione e mi ha tirato giù dal letto.")
	await novel_interface.show_text_only("Ancora mezzo addormentato, fui spinto in macchina. In quel momento stavo ancora protestando per il suo comportamento violento.")
	await novel_interface.show_text_only("Ma dopo questa corsa orrenda, l'unica cosa rimasta nella mia mente è \"meno male che sono ancora vivo\"...")
	await novel_interface.show_text_only("Oggi inizia il Progetto Arca, ma vorrei davvero darmi malata.")
	await novel_interface.show_text_only("Mi fa male lo stomaco da giorni. Accidenti!")
	await novel_interface.show_text_only("E mi viene sempre da vomitare... Bleah!")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Stai bene, Ren?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saluto il Annie in modo sprezzante.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Sto bene, sono solo un po' malato. E non riesco a smettere di tremare in questo momento...", "Lian")
	await novel_interface.show_dialog("Posso prendere un'altra macchina quando torniamo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiedo con voce flebile, guardando Annie implorante")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Guardati. Sei così abituato a fare la signorina innocente, vero?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre mi appoggiavo al muro per sostenermi, una voce familiare arriva da dietro. Accidenti! Lasciami andare e basta...")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Raphael? Perché sei...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Mariru non ti aveva detto che sarei stato qui?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Non si presenterebbe se lo facessi.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Guardandomi come se fossi il suo animale domestico in vendita, Mariru ignora la domanda di Raphael.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Lascio Ren a te, \\nSignorina Dekkers, la nostra cara rappresentante esecutiva di Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Aspetta! Lasciarmi a lei?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorride e ci porta all'ingresso della Base dell'Arca.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Sei sicuro che questo... sia l'ingresso?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Di fronte a noi c'è l'ingresso in un seminterrato di cemento che si affaccia su questa strada alla periferia della città. La porta consente il passaggio di una sola persona.")
	await novel_interface.show_text_only("Non ci sono edifici nel raggio di mezzo miglio. Se non fosse stato per il logo SID inciso sul muro, avrei dovuto prenderlo come un inquietante nascondiglio per qualche pervertito.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ih ih, vieni con me.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("Scendemmo le scale dietro la porta che conduce a un grande montacarichi.")
	await novel_interface.show_text_only("Sembra che l'ascensore sia progettato per ambienti estremi. Quattro spesse pulegge metalliche garantiscono un funzionamento sicuro e stabile.")
	await novel_interface.show_text_only("Mentre l'ascensore scende dolcemente, il rumore degli ingranaggi rotanti arriva da tutti gli angoli.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("Le prese d'aria, le reti metalliche, i rivetti e la luce fioca… Elementi industriali vintage sono ovunque.")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Affidabilità sopra ogni altra cosa... Ho visto progetti del genere nel caveau d'oro della Banca Centrale di Newmoridas.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ehi, ci sei stato?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("È stato uno dei più grandi progetti di costruzione del mondo prima della Guerra dei Sette Anni e ci è voluto molto lavoro per restaurare questo posto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru presenta con orgoglio questa struttura sotterranea.")
	await novel_interface.show_text_only("Raphael ha ragione. L'ascensore, sebbene sia ancora in funzione, è stabile come un enorme pezzo di solido acciaio. Mi viene in mente che anche saltare qua e là non causerebbe il minimo tremolio all'ascensore.")
	await novel_interface.show_text_only("Mi sono appena ripreso dal mal d'auto e non vedo l'ora di provarlo, solo per scoprire che Raphael mi fissa.")
	await novel_interface.show_text_only("Rendendomi conto che potrei comportarmi da stupido, smetto immediatamente con uno sguardo imbarazzato. Ma lei guardò con disprezzo verso la finestra di osservazione.")
	await novel_interface.show_text_only("Cosa diavolo può vedere nell'oscurità?")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Perché mi stai fissando?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il ladro grida al ladro, eh?")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Uffa... non mi sarei mai aspettato che Salmonton ti mandasse qui.", "Lian")
	await novel_interface.show_dialog("Dopotutto, l'esperimento oggi è piuttosto pericoloso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ancora più importante, so che questo esperimento è uno spettacolo con due copioni.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Sai davvero in cosa ti sei cacciata, mia signora?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi rivolgo a Mariru impotente.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("In superficie, è un progetto di ricerca congiunto tra New Opulentia e Salmonton.", "Mariru")
	await novel_interface.show_dialog("Lo scopo è identificare le cause del flusso spaziotemporale e le contromisure.", "Mariru")
	await novel_interface.show_dialog("Entrambe le parti devono inviare una persona qualificata e affidabile come soggetto umano.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ora che la tua assurdità allo Sky Hotel quella notte ha rivelato la tua identità, sei sicuramente la scelta migliore per New Opulentia.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru mi lancia un'occhiata, provocandomi un brivido lungo la schiena.")
	await novel_interface.show_text_only("Andiamo, ho imparato la lezione...")
	novel_interface.character_light()
	await novel_interface.show_dialog("Per quanto riguarda Raphael, la nostra \"discendente diventata cittadina comune\" a Gosakuragawa, si è offerta volontaria per partecipare all'esperimento per conto di Salmonton.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Volontariato?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, il Pilastro di Lapislazzuli è molto importante per Salmonton. Non permetterò mai che tu, perdente, rovini tutto.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Raphael è in grado di accelerare l'autoguarigione a livello cellulare. Questo è stato affermato da Aya.", "Mariru")
	await novel_interface.show_dialog("Ma secondo Beatrice, Raphael farebbe meglio a lavorare con Ren per mettere in campo il suo talento.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso mi viene in mente che, nel parcheggio dello Sky Hotel, Raphael è guarita Annie in un batter d'occhio.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Quindi Raphael è dalla nostra parte, giusto?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Pff, posso immaginare il tuo sguardo patetico quando combatti per la tua vita. \"Owww... sto morendo... guariscimi adesso...\"", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Sembra che tu non veda l'ora che ciò accada?!", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Aspetta, pensavo fosse un esperimento segreto. \\nCome faceva a saperlo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ho chiarito tutto al dottor Dekkers.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Dato che ti ha visto resuscitare Beatrice, ha pensato che la sua precedente collaborazione con il Senato fosse nella direzione sbagliata.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Ha qualcosa a che fare con la religione?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Probabilmente non è così semplice... Ma ora, Salmonton è disposto a lavorare con SID, purché Raphael sia al sicuro con noi.", "Mariru")
	await novel_interface.show_dialog("Il Senato non conosce le tue reali capacità. Questa è la forza di cui dovremmo sfruttare appieno.", "Mariru")
	await novel_interface.show_dialog("Una strega non attiva nulla quando tocca un frammento di strega. Ecco perché il nostro piano può funzionare.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Quindi, voglio davvero ringraziare i leader di entrambe le parti per aver reso possibile tutto ciò.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Sei sicuro che il mio capriccioso nonno non si sia lasciato ingannare?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Tuo nonno non è così ingenuo, tesoro. La reliquia qui non è affatto una sua scelta casuale.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Abbiamo fatto tutto questo per assicurarci che il \"vero esperimento\" possa essere portato a termine con successo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Humph, se non fosse stato per l'ordine di mio nonno...", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael mormorò qualcosa di vago, i suoi occhi mi sfiorarono leggermente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Non accetterei mai di collaborare con questo pervertito travestito!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Ma il Dr. Dekkers dice sempre che sei tu quello che non ascolta mai.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Fammi indovinare... Salmonton è effettivamente interessato a Heinrich, il proprietario originale del Lapis Pillar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Buona fortuna, Ren!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il Senato prevede di collaborare con Salmonton per produrre più streghe alle spalle di SID. E questa volta vogliono verificare la fattibilità di utilizzarmi come Stabilizzatore.")
	await novel_interface.show_text_only("Salmonton, tuttavia, ha stretto un accordo segreto con Mariru.")
	await novel_interface.show_text_only("Per quanto riguarda Mariru, ha tenuto il Senato all'oscuro delle nostre reali capacità.")
	await novel_interface.show_text_only("Sta diventando complicato. Questo mi sta uccidendo…")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Possiamo davvero combattere fianco a fianco?)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Lancio uno sguardo alla prepotente signora di fronte a me.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Trasferire Raphael a Gosakuragawa...) \\n(anche questo fa parte del loro piano?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("(Guarda quella faccia stupida. Deve pensare di nuovo a qualcosa di stupido.)", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("L'ascensore finalmente si ferma con un rumore di colpi. \\nUn cancello di metallo alto 35 piedi si profila davanti a noi.")
	await novel_interface.show_text_only("Un raggio laser rosso mi attraversa il corpo dalla testa ai piedi. \\nNon passa molto tempo che dal cancello esce un segnale acustico di conferma.")
	await novel_interface.show_text_only("Mariru va avanti per una scansione di controllo successivo dell'iride.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Potrebbero essere antiquati, ma le misure di sicurezza qui sono piuttosto rigide...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Una volta terminata la scansione, il cancello gigante si abbassa lentamente, lasciandoci stupiti dallo straordinario spazio dietro la porta.")
	await novel_interface.show_text_only("L'enorme spazio sotterraneo è sostenuto da due file di maestosi pilastri in cemento.")
	await novel_interface.show_text_only("La base di ciascun pilastro è ricoperta da pile di frammenti di armatura che possono essere utilizzati in entrambe le direzioni.")
	await novel_interface.show_text_only("Rivolti verso l'esterno, questi frammenti possono proteggere la struttura da devastanti attacchi missilistici. Ma se usati nella direzione opposta, sono capaci di distruggere i pilastri tutti in una volta.")
	await novel_interface.show_text_only("Durante la Guerra dei Sette Anni, questi frammenti di armatura furono ampiamente utilizzati nelle fortezze che dovevano essere bloccate o distrutte.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("È piuttosto umido qui...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il pavimento è pieno di macchie d'acqua. In alto, sul soffitto, sono montati dozzine di nuovi tubi, che emettono suoni di liquidi che scorrono attraverso.")
	await novel_interface.show_text_only("Mariru deve aver fatto molti sforzi per trasformare questo posto.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Verso la fine del passaggio ci troviamo di fronte ad uno spazio racchiuso da lastre metalliche.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_cistern.png")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Signore.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Benvenuti alla Base dell'Arca.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È solo che... non riesco proprio a credere ai miei occhi!")
	await novel_interface.show_text_only("Ciò che abbiamo davanti è un serbatoio. Guardando la nebbia che si alza dall'acqua scintillante, mi sento come se fossi su un molo.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Stai attento: la scaletta d'imbarco è in viaggio verso di noi.", "Mariru")
	
	print("=== 深海恐惧篇第7话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
