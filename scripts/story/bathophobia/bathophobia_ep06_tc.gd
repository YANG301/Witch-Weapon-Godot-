# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("一如往常，單向視訊會議正在進行中，莉琉站在會議台中央，冷靜地報告著各項研究進展。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("關於「方舟計劃」……", "基爾斯")
	await novel_interface.show_dialog("在薩蒙頓提供的歷史文物清單中，妳確定選用「特斯海姆青金石柱」了嗎？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("是的，關鍵在於如何製造可控制的「異變空間」。", "莉琉")
	await novel_interface.show_dialog("最近各學園都市頻繁爆發的時空相位波動，都是因為特徵類似「異質物」的物品與人類接觸造成的。", "莉琉")
	await novel_interface.show_dialog("這類「異質物」之前一直處於沉睡狀態，但幾乎在同一時間被喚醒了。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（其實應該區分為「魔導器」和「魔導書殘頁」，不過還是用他們熟悉的名詞來解釋吧。）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("就是「洛斯金杯」消失的那一天吧……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("目前還不能確認兩個事件的相關性。", "莉琉")
	await novel_interface.show_dialog("由於不可控制的因素過多，只能根據兩個條件篩選。", "莉琉")
	await novel_interface.show_dialog("一，色相掃描符合此類「異質物」特徵，但活性不高。", "莉琉")
	await novel_interface.show_dialog("二，有歷史文獻可以追溯到該文物的關係人，並確認其沒有暴力及犯罪傾向。", "莉琉")
	await novel_interface.show_dialog("「特斯海姆青金石柱」的原主人是海因里希·昆哈特，是文藝復興時期的醫生和煉金術士。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("活性不高啊……我還以為能收集到更接近臨界值的數據呢。", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("樣本很珍貴，還是不要用太激進的方案比較好。", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("（只要證明小憐能自由進出異變空間，演一場戲給元老院看就可以了。）","莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（其實「特斯海姆青金石柱」並不是「魔導器」，）\\n（而是特徵類似且擁有「魔法刻印」的物品）","莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（讓普通人接觸「魔導器」這麼危險的事情，）\\n（我又不是那個大猩猩……）","莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("螢幕中傳來低沉的笑聲。")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("煉金術士……科學的起源嗎？ \\n呵呵，真是有趣的選擇。", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("我聽說那是薩蒙頓的重要歷史藝術品，而且海因里希是「玫瑰十字會」的創辦人之一……", "華音瀧")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("「玫瑰十字會」只是個宗教和神祕學團體，與現在薩蒙頓的情報機構「十字玫瑰」沒有關係。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("而且，煉金術士也可說是當時的科學家，希望那個人能對未知事物保有基本的敬畏吧。", "莉琉")
	await novel_interface.show_dialog("不過以戴克斯博士的性格，不會白白把這種重要文物借給我們吧，除非……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("會議室中出現了一陣詭異的沉默。")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("沒錯，薩蒙頓方面要求我們共享研究成果，而且要派一位代表全程參與。", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("……", "莉琉")
	await novel_interface.show_dialog("（看來他們還沒放棄製造魔女的計劃……）\\n（想用小憐作為「穩定器」嗎？）","莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("瞭解，那麼我想最後再確認一下，薩蒙頓和各位都明白這次實驗的危險性吧？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("是的，利用舊都的巨型地下排水設施改造的「方舟基地」就是為了應對最糟糕的情況。", "基爾斯")
	await novel_interface.show_dialog("極速海水倒灌系統可以在30秒內淹沒整個基地。", "基爾斯")
	await novel_interface.show_dialog("如果實驗當中發生什麼意外的話……", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("希望那時候，莉琉閣下能有啟動緊急自毀裝置的決心。", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
