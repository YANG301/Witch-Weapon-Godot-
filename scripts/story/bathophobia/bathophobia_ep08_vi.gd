	await novel_interface.show_text_only("Tuy nhiên, với những mối đe dọa chưa xác định, những tiêu chuẩn này tốt nhất chỉ mang lại tấm đệm tâm lý.")
	await novel_interface.show_text_only("Đây là những gì Mariru đã nói tại cuộc họp hoạt động.")
