# bathophobia_ep24.gd - 深海恐惧症篇第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep24_script()

func play_script():
	pass

func bathophobia_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Control_Room.png")
	await novel_interface.show_text_only("Milk retorna para a sala de controle e bloqueia a porta principal com uma cadeira.")
	await novel_interface.show_text_only("O grupo de inimigos mais próximo chegará em poucos minutos. O outro grupo também encontrará o esquadrão de Milk na ala leste.")
	novel_interface.show_character("milk_battle","gratified")
	await novel_interface.show_dialog("Hum. Eu deveria ter pensado nisso antes...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se eu tivesse minha própria tropa de soldados extremamente ágeis, com audição aguçada e incríveis habilidades de autocura...")
	await novel_interface.show_text_only("Por que equipá-los com lâminas e não com armas de fogo?")
	await novel_interface.show_text_only("Esses inimigos se movem em grupos, não têm nenhuma estratégia digna de nota, embora sejam todos lutadores incrivelmente eficazes.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Elas não podem mais ser consideradas humanas, essas garotas...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk olha para a fileira de equipamentos à esquerda do painel de controle principal. Nele está a caixa de espécimes que Beth deixou para trás.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("A missão... não importa mais.","Milk")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Acho que as medidas estratégicas de defesa ofensiva empregadas aqui não são tão ruins, afinal...","Milk")
	await novel_interface.show_dialog("Espero que o alto-falante ainda funcione...","Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela respira fundo, se estabiliza, antes de digitar uma série de comandos no painel de controle...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	await novel_interface.show_text_only("Enquanto isso, no armazém escuro, Beth anda pela sala, procurando freneticamente por algo que talvez nem esteja lá.")
	novel_interface.show_character("baizhu_break","stare")
	await novel_interface.show_dialog("A senha... \\nQual é a senha?","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com os dedos tremendo, ela mal tem ideia de quais teclas está pressionando no painel da fechadura.")
	await novel_interface.show_text_only("Se ela acertar a senha, ela pode sair do armazém e lutar ao lado da amiga.")
	await novel_interface.show_text_only("Mas Milk, do outro lado do muro, não deixou nenhuma pista sobre qual poderia ser a senha.")
	await novel_interface.show_text_only("Talvez ela nunca mais deixe outra dica...")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Não! Não!\\nNão posso aceitar isso! Eu não vou aceitar isso!","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frenética, Beth continua batendo na porta com os punhos, mas suas tentativas de escapar são inúteis.")
	await novel_interface.show_text_only("Tudo o que ela consegue fazer é imaginar o que acontecerá a seguir, do outro lado da parede, sozinha no espaço escuro, silencioso e confinante.")
	novel_interface.show_character("baizhu_break","puzzled")
	await novel_interface.show_dialog("Por favor, não...","Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Eu sou inútil...)","Beth")
	await novel_interface.show_dialog("(Não é possível salvar ninguém...)","Beth")
	await novel_interface.show_dialog("(Não Pai... não Leite...)","Beth")
	await novel_interface.show_dialog("(Como... isso aconteceu...?)","Beth")
	await novel_interface.show_dialog("(Por que sou tão fraco...?)","Beth")
	await novel_interface.show_dialog("(Tão indefeso...)","Beth")
	await novel_interface.show_dialog("(... E egoísta.)","Beth")
	await novel_interface.show_dialog("(Por quê?)","Beth")
	novel_interface.show_character("baizhu_break","sad")
	await novel_interface.show_text_only("Tudo que eu quero é não ficar sozinho, não sentir frio...")
	await novel_interface.show_text_only("Não estou pedindo muito, estou...?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A garota fica sentada sozinha no escuro, os ombros tremendo de soluços.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Storehouse.png")
	novel_interface.change_music("res://assets/audio/music/Wind.mp3")
	await novel_interface.show_text_only("Ela mal percebe que o intenso combate contínuo exauriu seu corpo até a medula.")
	await novel_interface.show_text_only("A doença da descompressão está confundindo seu cérebro.")
	await novel_interface.show_text_only("É como se houvesse água agitando sua cabeça, mexendo com sua consciência pouco a pouco.")
	await novel_interface.show_text_only("Talvez ela não tenha percebido que estava no oceano escuro e profundo, afinal...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Ela se sente como se estivesse no topo de uma geleira – não, dentro de uma. O gelo, afiado e denso, atravessa seu coração, sua alma.")
	await novel_interface.show_text_only("Seu corpo flexível congela, pouco a pouco, e seu sangue começa a congelar.") #换行问题
	await novel_interface.show_text_only("Incontáveis ​​grupos de luz pura a cercaram até cobrirem completamente sua existência.")
	await novel_interface.show_text_only("Não há mais dor, não há mais solidão.")
	await novel_interface.show_text_only("Não mais.")
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	await novel_interface.show_text_only("Neste mundo de branco puro, ela ouve uma melodia familiar.")
	await novel_interface.show_dialog("... Leite?","Beth")
	await novel_interface.show_text_only("Essa é a música favorita deles. A música deles.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("Em uma explosão explosiva, centenas de orbes brilhantes voam para fora do corpo de Beth.")
	await novel_interface.show_text_only("A garota pisca e abre os olhos. A ofuscante luz branca, num estrondo ensurdecedor, destruiu toda a parede.")
	await novel_interface.show_text_only("O alto-falante na sala de controle está tocando a música deles, ecoando por todo o túnel. Milk deve ter usado o arquivo de áudio que armazenou em seu relógio.")
	await novel_interface.show_text_only("Dezenas de inimigos se reuniram, atraídos pelo som. Muitos deles, muito mais do que contavam na tela.")
	await novel_interface.show_text_only("Os inimigos cercaram a entrada da sala de controle.")
	await novel_interface.show_text_only("Beth está a apenas trinta metros da sala de controle agora.")
	novel_interface.show_character("baizhu_break","cry")
	await novel_interface.show_dialog("(Tudo que preciso são dez segundos... não, cinco... )","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cinco segundos para alcançar sua melhor amiga idiota e impedi-la de fazer o que quer que ela vá fazer.")
	await novel_interface.show_text_only("Um grande grupo de soldados parasitas imediatamente avançou em direção a Bai Zhu, e várias lâminas afiadas atacaram repentinamente por trás dela.")
	await novel_interface.show_text_only("Ela se vira, disparando vários tiros na forma de feixes de luz brilhantes, explodindo seus alvos em pedacinhos na parede.")
	await novel_interface.show_text_only("Ela continua correndo em direção à sala de controle, o corpo brilhando em uma luz, mais brilhante do que nunca.")
	await novel_interface.show_text_only("As ondas de energia que irradiam de seu corpo arrancam as paredes internas do túnel. Ela brilha cegamente, como um réquiem dos céus.")
	await novel_interface.show_text_only("Ninguém pode detê-la agora.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Light.png")
	await novel_interface.show_text_only("Incontáveis ​​raios brancos estilhaçados saem da Base de Snedronningen, iluminando os céus estrelados, como se o amanhecer tivesse caído no continente adormecido.")
	await novel_interface.show_text_only("Quase como um rito de boas-vindas a uma divindade.")
	await novel_interface.show_text_only("De repente, todo o continente começa a tremer...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling2.png")
	await novel_interface.show_text_only("Em apenas alguns segundos, Beth matou dezenas de inimigos de uma só vez. Ela cai para trás, a visão nublada pela luz brilhante.")
	await novel_interface.show_text_only("O poder que surge de seu corpo está perto de engoli-la inteira.")
	await novel_interface.show_text_only("Enquanto ela joga um inimigo para fora do caminho com a lâmina na mão direita...")
	await novel_interface.show_text_only("Uma dúzia de inimigos atravessa a porta emperrada da sala de controle e entra.")
	novel_interface.show_character("baizhu_break","angry")
	await novel_interface.show_dialog("Espere por mim... idiota...","Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("“Estou indo...”")
	await novel_interface.show_text_only("Bum!")
	await novel_interface.show_text_only("Um gigantesco arco elétrico sai da sala de controle. Então vêm as explosões, incontáveis ​​explosões de fogo em um segundo, bem na frente dos olhos de Beth.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("É como se o tempo estivesse parado.")
	await novel_interface.show_text_only("Ela para e cai de joelhos, a poucos metros da sala de controle.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Base_Tunneling3.png")
	await novel_interface.show_text_only("É quando este continente gelado, implacável e frio, finalmente abre os olhos do seu sono sem fim.")
	await novel_interface.show_text_only("Na escuridão, uma sombra dourada irrompe das camadas subterrâneas de gelo, rasga o chão do túnel e perfura silenciosamente o torso da garota.")
	await novel_interface.show_text_only("É uma lança, de aparência simples, se não fosse pelos intrincados padrões dourados girando em torno da ponta da lança.")
	await novel_interface.show_dialog("…","Beth")
	await novel_interface.show_text_only("Uma corrente quente de calor atravessou a ponta da arma, seguiu o corpo da arma e se fundiu com o sangue.")
	await novel_interface.show_text_only("Seus braços caem frouxamente ao lado do corpo. Mesmo com as pupilas dilatadas, ela olha, como se ainda não estivesse pronta para desistir.")
	await novel_interface.show_text_only("No chão, sangue carmesim.")
	await novel_interface.show_text_only("Gotejamento. Pingar. Pingar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("A luz brilhante que envolve o continente desaparece.")
	
	print("=== 深海恐惧症篇第24话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
