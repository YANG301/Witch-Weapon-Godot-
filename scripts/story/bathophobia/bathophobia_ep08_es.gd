# bathophobia_ep08.gd - 深海恐惧症篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep08_script()

func play_script():
	pass

func bathophobia_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Mientras Mariru toca su teléfono, un profundo estruendo proviene de las profundidades del depósito. El nivel del agua desciende a medida que se abre la esclusa submarina.")
	await novel_interface.show_text_only("Aparentemente, el embalse tiene más de 30 pies de profundidad y la presa se convirtió instantáneamente en un acantilado.")
	await novel_interface.show_text_only("A medida que el nivel del agua baja, un monumento azul surge de la plataforma en el lado opuesto del acantilado.")
	await novel_interface.show_text_only("A medida que las luces circundantes se encienden una tras otra, la forma de este monumento es inconfundible: se trata del pilar de lapislázuli de Tesheim.")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("Vaya...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el lado opuesto hay un espacio gigantesco, más ancho que un campo de fútbol estándar. Filas de pilares, de decenas, si no cientos, de pies de altura, bordean el espacio en la oscuridad.")
	await novel_interface.show_text_only("A casi 300 pies de altura, las luces del techo apenas pueden revelar las áreas circundantes y el otro extremo permanece completamente oscuro.")
	await novel_interface.show_text_only("La escala exagerada de la estructura parece terriblemente intimidante.")
	await novel_interface.show_text_only("Los indicadores que parpadean en las cuatro esquinas del andén nos recuerdan la presencia de un escudo de protección electromagnética.")
	await novel_interface.show_text_only("Una pasarela se extiende lentamente hacia nosotros.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("(… ¡Impresionante!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esto me recuerda a la escena inicial de un juego de disparos.")
	await novel_interface.show_text_only("Seguimos Mariru y caminamos por una escalera sensible hacia el escritorio de control.")
	await novel_interface.show_text_only("Los escalones, normalmente escondidos en la pared, sólo aparecen cuando alguien está a punto de pisarlos.")
	await novel_interface.show_text_only("La escalera parece estar diseñada para evitar que las personas se acerquen o salgan del puesto de control.")
	await novel_interface.show_text_only("Miro a mi alrededor y noto un par de rendijas cerradas para disparar armas pequeñas y pesadas en el techo.")
	await novel_interface.show_text_only("Pensando en cómo llegamos aquí, trato de visualizar la estructura de esta enorme instalación subterránea.")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("… Debes haber invertido miles de millones de dólares en esto.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("La renovación no es una tarea fácil, pero es la única opción que tenemos si queremos cumplir con los estándares de seguridad y cumplir con los plazos del Proyecto Ark.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Según los estándares de seguridad, Mariru significa la capacidad de defenderse contra posibles amenazas, como brujas poderosas pero hostiles.")
	await novel_interface.show_text_only("Para garantizar la seguridad de las Ciudades Academia, el Senado requiere que estas instalaciones puedan gestionar y eliminar tales amenazas.")
	await novel_interface.show_text_only("Sin embargo, ante amenazas desconocidas, estas normas sólo proporcionarían, en el mejor de los casos, protecciones psicológicas.")
	await novel_interface.show_text_only("Esto es lo que dijo Mariru en la reunión de operación.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¿Qué estás esperando?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A medida que nos acercamos al escritorio de control, todavía me siento indeciso al pisar las escaleras que cuelgan a más de 30 pies de altura, aunque sé que los escalones seguirán el movimiento de mis pies.")
	await novel_interface.show_text_only("En la plataforma de enfrente, está el Pilar de Lapislázuli, más alto que yo y sostenido por cuatro grandes pinzas.")
	await novel_interface.show_text_only("Me siento completamente abrumado al ver el pilar en persona. Las fotos en línea no son nada para comparar.")
	await novel_interface.show_text_only("La superficie de este monumento turquesa translúcido está llena de patrones inscritos de líneas finas.")
	await novel_interface.show_text_only("Parecen ser símbolos dispuestos en un cierto orden lógico, pero hasta ahora los arqueólogos no han podido descifrarlos.")
	await novel_interface.show_text_only("Círculos concéntricos, ejes, contornos... Más que códigos significativos, parecen transmitir conceptos de manera más directa.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Debe ser un tesoro nacional... Tal vez deberíamos probar otros artefactos de menor importancia en nuestro primer experimento...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¿Eh? ¿Atemorizado?", "Raphael")
	await novel_interface.show_dialog("Si arruinas esto, sabes qué esperar, ¿verdad?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael advierte.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("No, por supuesto que no. Simplemente me parece demasiado extravagante...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Bien, ahora desactivemos el escudo electromagnético.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru tira cuidadosamente de la palanca roja en el escritorio de control. Las luces rojas en las esquinas del dispositivo protector se apagan todas a la vez.")
	await novel_interface.show_text_only("De repente, un zumbido golpea mi cuero cabelludo, como si una corriente débil atravesara mi cerebro.")
	novel_interface.character_light(0.35,"serious")
	await novel_interface.show_dialog("¿Todo bien?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Podría ser la inscripción mágica, pero…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fijo mis ojos en el Pilar de Lapislázuli. Algo no está bien.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Parece que tu cuerpo es muy sensible.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Mariru, no delante de…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a Raphael, que me está dando esa mirada de \"pervertido\".")
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("¡Lo que dijiste es engañoso!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Por nuestra seguridad, repetiré las instrucciones sobre cómo operar el escudo electromagnético.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru hace un gesto a Raphael y Annie hacia el escritorio de control, y luego se vuelve hacia mí.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿El programa está en marcha?)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hay docenas de sensores y cámaras de espectro completo en esta estación de control y en los pilares circundantes. Están configurados para ejecutarse automáticamente cuando la caja protectora está abierta.", "Mariru")
	await novel_interface.show_dialog("Los datos y las imágenes se enviarán directamente a la sala de observación y se compartirán con las instituciones de investigación con sede en Salmonton después del experimento.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru me guiña un ojo.")
	novel_interface.character_light(0.35,"speechless")
	await novel_interface.show_dialog("(Por supuesto que lo harás...) \\n(Obviamente has preparado datos falsos...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Miro hacia la sala de observación en lo alto de los pilares adyacentes.")
	await novel_interface.show_text_only("El cristal unidireccional a prueba de explosiones no muestra señales de que haya personas detrás y simplemente refleja fríamente las luces circundantes.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Esos senadores deberían estar detrás de esto…)", "Lian")
	await novel_interface.show_dialog("(Espero que podamos engañarlos...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("La caja protectora y el embarcadero se pueden controlar fácilmente con este interruptor mecánico y manivela.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Siguiendo las instrucciones de Mariru, Annie pasa por cada noble e interruptor del escritorio de control.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Hace bastante tiempo que no veo interruptores mecánicos, y aquí hay una manivela... \\n¿Por qué utilizas estos aparatos antiguos?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Los dispositivos mecánicos suelen ser las soluciones más estables. Simplemente atrévete.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Entonces, antes de irme a la sala de mando, ¿algo que quieras preguntar?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("(¿Estamos… estamos a punto de comenzar?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi corazón late salvajemente. Respiro profundamente unas cuantas veces.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("… ¿Nervioso?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pareciendo haber notado mi inquietud, Mariru me rodea la espalda con el brazo y me dice suavemente.")
	await novel_interface.show_text_only("Un comportamiento tan íntimo delante de los demás me hace arder la cara.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Un…un poquito…", "Lian")
	await novel_interface.show_text_only("¡Mi corazón se acelera!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(¡Montar un espectáculo realmente no es lo mío! Cuando era niño, mi único papel actoral fue en La cabaña del tío Tom. Y yo era la cabaña).", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mira hacia la sala de observación.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("¿Sí?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Su aliento me adormece la oreja. Es como si un nervio corriera desde la parte posterior de mi oreja, transmitiendo el entumecimiento por todo mi cuerpo mientras baja hasta mis talones.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Tranquilo, los senadores no notarán nada.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me susurra al oído.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Hay una capa de camuflaje óptico a unos 70 pies por encima de mi cabeza.", "Mariru")
	await novel_interface.show_dialog("Y el cristal de la sala de observación está tratado, para que sólo vean lo que \"deberían\" ver...", "Mariru")
	await novel_interface.show_dialog("Después de que Raphael cierre la caja protectora, desaparecerás frente a ellos como si hubieras ingresado al área de flujo.", "Mariru")
	await novel_interface.show_dialog("Después de eso, sólo tienes que intentar tocar el pilar de lapislázuli. Está bien si no puedes llamar a las brujas como lo planeamos.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Escucho una risita y luego Mariru sopla una bocanada de aire en mi oído. \\nEl descaro que acabo de notar está protestando vigorosamente otra vez.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Eek!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Pero, si se anuncia algo malo... \\nSabes cómo manejar el peor de los casos, ¿verdad?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Trago brevemente.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("En el momento en que los sensores alcancen el valor umbral, se activarán los programas de bloqueo y destrucción…", "Lian")
	await novel_interface.show_dialog("En 5 segundos, debemos tomar la trampilla del piso a nuestra derecha y entrar en la zona de segregación subterránea.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Miro el camino de emergencia que planeamos en la reunión de operación.")
	novel_interface.show_character("ren_battle","solemn")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Para ser precisos, sólo tienes 4,8 segundos.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Toda la base se inundará instantáneamente con agua de mar) \\n(Y mucho menos el sistema de armamento sobre mi cabeza...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Pero según mi verificación de antecedentes sobre el Pilar de Lapislázuli...", "Mariru")
	await novel_interface.show_dialog("Su antiguo propietario era un pacifista devoto, aunque era muy reservado y utilizaba varios alias.", "Mariru")
	await novel_interface.show_dialog("Así que tal vez sea un hombre peludo de mediana edad al que podrías llamar.", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Si es así, ¡deja que Raphael lo lleve de regreso a Salmonton!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("De todos modos, la seguridad es lo primero.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru me suelta y me acaricia la cabeza.")
	novel_interface.show_character("ren_battle","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Cuídate… te estaré vigilando.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("En un tono que señala el inicio del experimento, vuelvo a fijar mis ojos en el Pilar de Lapislázuli que se encuentra en silencio en la plataforma.")
	novel_interface.show_character("ren_battle","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Lo lograremos?", "Lian")
	# 在这里添加剧情脚本内容
	
	print("=== 深海恐惧症篇第8话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
