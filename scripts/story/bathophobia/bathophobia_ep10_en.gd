# bathophobia_ep10.gd - 深海恐惧篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep10_script()

func play_script():
	pass

func bathophobia_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Alternative powered submarine SS Deepsea lurks in the deep waters of the Antarctic.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	await novel_interface.show_text_only("A girl in a white dress is standing in front of the Central Control Room.")
	await novel_interface.show_dialog("Visitor identification required—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Record, Beth.", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The girl looks a bit tired, but she stands upright, her long wet hair falling freely down her back—")
	await novel_interface.show_text_only("She’s there, confident, assured, and proud.")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Please confirm security token—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Keshi0415-Z.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Logging in… Scan mode on.", "System")
	await novel_interface.show_text_only("Eight beams of light, emitted from the passage wall, begin to scan Beth.")
	await novel_interface.show_text_only("On the other side of the reinforced protective door, a group of people are watching excitedly through the observation window.")
	await novel_interface.show_text_only("Among them, a girl with brown hair is Beth's friend Silvia.")
	await novel_interface.show_text_only("But she prefers to be called Milk, her code name.")
	await novel_interface.show_text_only("Beth's face softens when their eyes meet through the window.")
	await novel_interface.show_dialog("Scan completed. Six-digit passcode please—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth remembers clearly that such verification procedure was not in place before she left.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(… Hah, they've rigged the security system again.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As an external expert, Beth is accustomed to such kind of mischievous tests.")
	await novel_interface.show_text_only("She is a consultant to the Squad consisting of top military officers, but doesn't have any real battle experience.")
	await novel_interface.show_text_only("And because this operation involves extreme environments, the consultant also has temporary strategic decision-making power.")
	await novel_interface.show_text_only("It's all too common to be questioned, even though she is known as a genius in her professional field…")
	await novel_interface.show_text_only("She can only fit in by proving herself.")
	await novel_interface.show_text_only("Beth is very clear about this.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Digital passcode… \\nHaven't seen this for a long time.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bai Yan's gaze swept across the milk behind the observation window.")
	await novel_interface.show_text_only("Hands pressed against the window, Milk is making faces to her.")
	await novel_interface.show_text_only("From Beth's angle, she could see Milk peeking at the plate outside the protective door.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_text_only("Door number…? \\nZ-100485.")
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Not that simple…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth enters the six digits as they are.")
	await novel_interface.show_text_only("After a long buzz, the door remains shut.")
	await novel_interface.show_dialog("Wrong passcode. First warning—", "System")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("… I knew it.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Except for Milk, perhaps everyone else is eager to see her fail.")
	await novel_interface.show_text_only("Beth heaves a sigh at Milk's gloating smile.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Another code game?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Behind the observation window, the group of people stand there, watching her with a hint of enjoyment.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("How long do you think she will take this time?", "Squad Member A")
	await novel_interface.show_dialog("There's a special module to prevent brute-force attack. Decrypting programs won't work!", "Squad Member C")
	await novel_interface.show_dialog("Oh, and Milk, don't you give her hints!", "Squad Member B")
	await novel_interface.show_text_only("Milk's fingers zip across her mouth obediently.")
	await novel_interface.show_dialog("Then I would say… 60 seconds.", "Squad Member D")
	await novel_interface.show_dialog("That's too fast even for a genius… \\nI would bet at least ten minutes!", "Squad Member C")
	await novel_interface.show_dialog("Don't look down upon Beth and this girl…", "Squad Member A")
	await novel_interface.show_text_only("The tall Squad Member A rubs Milk's head from behind.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Come on, you've all reviewed the modified code!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But if it's Beth… she would definitely get it…")
	await novel_interface.show_text_only("That's a little secret between them.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_door.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("Umm—", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Out of the corner of her eye, Beth sees Milk raise her right hand, and cross her thumb and index finger to form a finger heart.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("Hmm…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That was the code word when they first met.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("100485… \\nIt corresponds to 124155.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Under close watch, Beth enters the correct passcode within less than 20 seconds.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("The door of the Central Control Room opens slowly. Beth combs her hair with her fingers and smiles to herself.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("Hehe, I knew you can do it…", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk sniggers as she collects cash from those who lose the bet.")
	await novel_interface.show_dialog("Hey— you must have given her some hint! \\n… Cheating is not good!", "Squad Member D")
	await novel_interface.show_text_only("Milk shrugs, looking at them innocently.")
	novel_interface.show_character("milk_normal","pleased")
	await novel_interface.show_dialog("I didn't say a word. You knew it.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("So how did she guess it right?", "Squad Member B")
	await novel_interface.show_dialog("Maybe we've missed something…", "Squad Member C")
	await novel_interface.show_text_only("Beth clears her throat to interrupt their speculation and begins debriefing right away.")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("As we've thought, That Thing does exist in the abyssal zone.", "Beth")
	await novel_interface.show_dialog("I got a close look at it a few hours ago. And I've collected some liquid samples.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	novel_interface.show_character("milk_normal","shock")
	await novel_interface.show_dialog("Eh…?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Everyone falls quiet immediately.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/eyeball.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("That Thing is the goal of this mission: an ancient creature in the depth of the ocean.")
	await novel_interface.show_text_only("In some religions, it is the origin of all life on earth.")
	await novel_interface.show_text_only("People haven't figured out yet whether it is a simple life form, or even whether it exists physically.")
	await novel_interface.show_text_only("Before Beth set out, most of the Squad Members thought it was only a myth like the Loch Ness Monster.")
	await novel_interface.show_text_only("But Beth's report shattered their hope of wrapping up the mission and returning home early.")
	await novel_interface.show_text_only("In the Southern Ocean, in the deep sea water 4,000-6,000 meters beneath the ice of Princess Elizabeth...")#文字删除
	await novel_interface.show_text_only("There is a mysterious creature that might have been around long before humans ever existed… and it has survived to this day.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Just the thought of this is enough to make the hair stand on end.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("The sensor successfully captured electrical nerve signals in the surrounding waters, although just for a short time.", "Beth")
	await novel_interface.show_dialog("The waveform was flat at first. But then the frequency shot up suddenly and looked more like beta waves found in human brains.", "Beth")
	await novel_interface.show_dialog("Though hundreds of thousands of times more intense…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At this, Beth recalls the terrible daze when being watched by the gigantic eyeball a few hours ago.")
	novel_interface.show_character("milk_normal","solemn")
	await novel_interface.show_dialog("Sounds like the state where people get woken up by a nightmare…", "Milk")
	await novel_interface.show_dialog("The mission guide has mentioned abnormal radio waves in the Antarctic airspace… It’s not equipment failure then.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You sure? At that depth, you get tons of pressure on just a palm-sized surface…", "Squad Member A")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("I'm sure.", "Beth")
	await novel_interface.show_dialog("Just as our sources indicated, it has a huge body that spans wider than this submarine.", "Beth")
	await novel_interface.show_dialog("I have no idea why this gigantic creature is not crushed under such extreme water pressure.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Wow, could it be a deep sea Substance H?!", "Squad Member D")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("No.", "Beth")
	await novel_interface.show_dialog("It's not Substance H.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("To everyone's surprise, Beth suddenly speaks with a firm voice.")
	await novel_interface.show_text_only("She is known for being meticulous about her statements. She wouldn’t jump to any conclusion without concrete evidence.")
	await novel_interface.show_text_only("What makes her so assured?")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("I mean, so far, no one has found any Substance H with consciousness…", "Beth")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("But That Thing does have consciousness…", "Beth")
	await novel_interface.show_dialog("And a very strong one…", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bai Zhuchen pursed his lips, as if he wanted to explain, but he couldn't express it in words, but his voice became smaller and smaller.")
	await novel_interface.show_text_only("Her voice trails away, and silence fills the room. Only weak breaths can be heard.")
	await novel_interface.show_text_only("It is a human instinct to fear the unknown.")
	novel_interface.show_character("milk_normal","laugh")
	await novel_interface.show_dialog("Well, it's not Substance H then. Beth is always right!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk breaks the silence with a flattering laughter. Everyone else forces a smile.")
	await novel_interface.show_text_only("Only Bai Yan was still frowning, and Milk sighed, stepped forward and hugged her waist.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Well, at least you've taken the first step. \\nDon't look so grim!", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("To keep the samples active, we need to send them to a lab ASAP.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth ignores Milk’s gesture and continues to talk to the captain.")
	await novel_interface.show_dialog("What about the one in Buenos Aires?", "Squad Member A")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("We don't have enough time. The deep sea environment in our current sampling chamber can only last for four more hours.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("The nearest qualified lab is on the other side of the Amery Ice Shelf. I need to report to the Headquarters first.", "Squad Member A")
	await novel_interface.show_dialog("What? I hate applying for icebreakers!", "Squad Member B")
	novel_interface.show_character("baizhu_normal","normal")
	await novel_interface.show_dialog("I think the Ushuaia icebreaker is free this month.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ushuaia…", "Squad Member D")
	await novel_interface.show_text_only("Several Squad Members exchange looks.")
	novel_interface.show_character("baizhu_normal","normal") 
	await novel_interface.show_dialog("To save time, we can also set up a temporary lab on the icebreaker—", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk suddenly grabs Beth by the arm and interrupts her.")
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Why not just let them update Boss with the latest information? Save the paperwork for them too!", "Milk")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("—Babe, don't be so serious. Cheer up!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Milk rubs herself against Beth fawningly.")
	
	print("=== 深海恐惧篇第10话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
