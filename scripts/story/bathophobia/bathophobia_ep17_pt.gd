# bathophobia_ep17.gd - 深海恐惧症篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep17_script()

func play_script():
	pass

func bathophobia_ep17_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Snedronningen.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Uma extensão infinita de terra desolada – tingida de um verde místico pela deslumbrante aurora austral.")
	await novel_interface.show_text_only("Uma série de faróis atravessa a escuridão frígida e silenciosa.")
	await novel_interface.show_text_only("Eles pertencem a uma frota de motos de neve. As scooters passam pelas planícies geladas envoltas em escuridão, passam pelo heliporto e finalmente estacionam na entrada da extensa base.")
	await novel_interface.show_text_only("Ereto diante deles está um monumento em forma de casulo. Uma caixa de espécimes resistente, anteriormente usada para armazenar meteoros do Monte. Grove, está embutida em sua superfície rochosa.")
	await novel_interface.show_text_only("A palavra “Snedronningen” é pintada inúmeras vezes ao redor da caixa, brilhando em prata sob um holofote.")
	await novel_interface.show_text_only("Snedronningen – a Rainha Branca. O nome da base que os pilotos procuram.")
	await novel_interface.show_text_only("Um membro do esquadrão com armadura pesada, cavalgando na vanguarda, arranca sua viseira.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("—Aaa e aqui estamos!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguindo seu exemplo, os cinco pilotos restantes desligam os motores e desmontam, cada um pegando seus respectivos suprimentos.")
	await novel_interface.show_text_only("Esta é uma equipe de pesquisa científica – na qual todos os membros passaram por treinamento de combate padrão.")
	await novel_interface.show_text_only("Relatos de ondas de rádio geradas por Substance H detectadas na Antártica há dois meses trouxeram muitas facções curiosas para a área. A maioria deles veio armada.")
	await novel_interface.show_text_only("Para a equipe, é aconselhável ser cauteloso para manter os espécimes seguros.")
	await novel_interface.show_text_only("Eles tiveram sorte até agora. A jornada para a base de pesquisa mencionada no plano de backup ocorreu sem problemas.")
	await novel_interface.show_dialog("Tudo bem. Tudo o que temos que fazer é entregar as coisas.", "Membro do Esquadrão D")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Sim.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ao contrário das outras, que estão enroladas em camadas grossas e quentes, Beth está vestida com uma roupa casual, claramente não afetada pela temperatura extrema.")
	await novel_interface.show_text_only("Suas armas autoaperfeiçoadas também se destacam da multidão.")
	await novel_interface.show_text_only("A jornada deles foi exatamente como ela esperava...")
	await novel_interface.show_text_only("Beth mergulhou nas profundezas do oceano há poucas horas, trazendo de volta amostras vivas que coletou do corpo de uma criatura não identificada.")
	await novel_interface.show_text_only("Para concluir o projeto de pesquisa, o supervisor de Milk despachou o quebra-gelo Ushuaia para auxiliar o esquadrão de operações especiais.")
	await novel_interface.show_text_only("Quando a caixa de amostras estava sendo transferida para o Ushuaia, o biolaboratório do navio sofreu “acidentalmente” uma falha de energia.")
	await novel_interface.show_text_only("Ao mesmo tempo, a Base Snedronningen, a cerca de uma hora de viagem, ofereceu-se para deixar temporariamente a equipe armazenar as amostras em seu laboratório, que atende a todas as especificações.")
	await novel_interface.show_text_only("O esquadrão logo recebeu permissão para entrar nas instalações e foi encarregado de trazer os espécimes para a Base Snedronningen em noventa minutos.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("(Chegamos tão longe...)", "Beth")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Esses canalhas aparecerão?", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth cerra o punho.")
	await novel_interface.show_text_only("O que a incomoda ainda mais é que algo na caixa de amostras parece ter desencadeado uma espécie de resposta em seu corpo.")
	novel_interface.show_character("baizhu_battle","sad")
	await novel_interface.show_dialog("... \\n(Isso parece familiar por algum motivo... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que ela possa contemplar isso ainda mais, o mundo começa a tremer violentamente.")
	novel_interface.show_character("baizhu_battle","speechless")
	await novel_interface.show_dialog("(Estou tonto por causa do mergulho?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não, não é isso.")
	await novel_interface.show_text_only("—Esta terra inteira está tremendo.")
	await novel_interface.show_text_only("Um estrondo profundo pode ser ouvido à distância.")
	await novel_interface.show_text_only("Até os veteranos mais experientes parecem abalados.")
	await novel_interface.show_text_only("O tremor que sacode este continente branco dura menos de trinta segundos.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("A Antártica não está na zona do terremoto..., está?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O terremoto não foi muito forte. No entanto, isso deixou todos um pouco tontos.")
	await novel_interface.show_dialog("(Resmungando) É muito pior que o tsunami...", "Membro do Esquadrão B")
	await novel_interface.show_dialog("A plataforma de gelo sob nossos pés parece bastante resistente. Se o mesmo terremoto acontecesse em uma cidade tropical altamente povoada, teria causado muito mais danos.", "Líder de esquadrão")
	await novel_interface.show_text_only("Os membros do esquadrão ignoram este terremoto de pequena escala e continuam com seu trabalho.")
	novel_interface.show_character("baizhu_battle","normal")
	await novel_interface.show_dialog("Ok, vamos lá.", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com a caixa de amostras segura em seus braços, Beth salta do banco de trás do snowmobile de Milk.")
	await novel_interface.show_dialog("Estou exausto. Mal posso esperar para chegar em casa, para minha cama e tomar chocolate quente.", "Membro do Esquadrão B")
	await novel_interface.show_text_only("Enquanto os membros do esquadrão já baixam a guarda, o líder permanece vigilante, lançando olhares significativos na direção de Beth.")
	await novel_interface.show_text_only("Se não fosse por essa garota, eles teriam falhado nesta missão – assim como todas as outras facções falharam.")
	await novel_interface.show_text_only("Ela teve que mergulhar nas profundezas do oceano, correr o risco da doença descompressiva e enfrentar criaturas não identificadas...")
	await novel_interface.show_text_only("As apostas são muito altas. Nem mesmo a própria Milk poderia ter garantido o sucesso em tais circunstâncias.")
	await novel_interface.show_dialog("Então tudo o que precisamos fazer é entregar o material aos cientistas daqui, certo?", "Membro do Esquadrão D")
	await novel_interface.show_dialog("Beth, vamos oferecer uma cerveja para você quando voltarmos para Buenos Aires, hein?", "Membro do Esquadrão C")
	novel_interface.show_character("milk_battle","sprite")
	await novel_interface.show_dialog("De jeito nenhum! Nossa Bethy não bebe álcool!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Puxando Beth em seus braços, Milk declara.")
	await novel_interface.show_text_only("Bai Zhu apertou os lábios, suprimindo deliberadamente seu desconforto.")
	await novel_interface.show_text_only("Milk envia vários pedidos de entrada no portão da base, mas não recebe resposta.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Que estranho...", "Milk")
	await novel_interface.show_dialog("O terremoto arruinou a conexão ou algo assim?\\nEles ainda estavam em contato antes de atracarmos.", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ainda assim, embora as travas no portão da frente que restringem a entrada de veículos permaneçam de pé, o esquadrão é tecnicamente capaz de entrar de qualquer maneira – afinal, eles receberam o código de acesso antecipadamente.")
	await novel_interface.show_text_only("Então eles se dirigem em direção à barreira bem iluminada ao lado da base.")
	await novel_interface.show_text_only("Beth para de repente e entrega a caixa de espécimes para um de seus companheiros de esquadrão.")
	await novel_interface.show_text_only("Com as mãos livres, ela segura as armas com força.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("... E aí?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebendo as ações de Beth, Milk saca suas armas também, com os olhos alertas.")
	await novel_interface.show_text_only("Os outros membros também ficam tensos e entram em modo de batalha, avançando em formação em forma de leque, observando as costas uns dos outros.")
	await novel_interface.show_dialog("... Que diabos?", "Membro do Esquadrão D")
	await novel_interface.show_dialog("Shh, fale baixo.", "Líder de esquadrão")
	await novel_interface.show_text_only("Tudo o que se ouve no silêncio ensurdecedor são os rangidos das botas de neve na superfície do gelo e a respiração silenciosa dos membros do esquadrão.")
	await novel_interface.show_text_only("Milk se aproxima da porta e digita o código na fechadura de segurança.")
	await novel_interface.show_text_only("O sistema aceita o código e a palavra ENTER pisca em verde na tela.")
	novel_interface.show_character("milk_battle","normal")
	await novel_interface.show_dialog("Uau... isso deve ser seguro, certo?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas Beth ainda não consegue acabar com a sensação enervante em seu estômago...")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhuBase.png")
	await novel_interface.show_text_only("A barreira para a Base Snedronningen finalmente se abre, junto com sons de engrenagens zumbindo e cabos tensos.")
	await novel_interface.show_text_only("Atrás do portão há um lance de escadas que desce direto em direção ao nível inferior mal iluminado.")
	await novel_interface.show_dialog("Alguém?", "Milk")
	await novel_interface.show_text_only("Sua pergunta ecoa pela passagem estreita.")
	await novel_interface.show_dialog("Eu entendo que a maioria das instalações aqui são subterrâneas, mas eles não poderiam ter enviado alguém para nos receber lá em cima?", "Milk")
	await novel_interface.show_dialog("Pelo menos um desses pesquisadores deveria vir verificar as amostras...", "Membro do Esquadrão B")
	await novel_interface.show_dialog("Em posição de batalha!", "Beth")
	await novel_interface.show_text_only("Com os olhos voltados para o outro lado da escada, Beth grita sua ordem.")
	await novel_interface.show_dialog("Alguém está nos observando.", "Beth")
	await novel_interface.show_dialog("Quanto mais secreta a opção, mais fácil é atrair a atenção, eu acho...", "Milk")
	await novel_interface.show_dialog("(Nossos inimigos são aqueles com quem você está preocupado?)", "Milk")
	await novel_interface.show_text_only("Uma série de seguranças de armas estourando quebra o silêncio assustador.")
	await novel_interface.show_text_only("Os integrantes do esquadrão, todos soldados treinados por direito próprio, olham para a garota que ocupa o cargo de comandante temporária, aguardando suas ordens.")
	await novel_interface.show_dialog("Estamos em um local muito exposto agora. Estaremos em perigo se eles armarem uma emboscada. Podemos recuar para fora de...", "Membro do Esquadrão D")
	await novel_interface.show_dialog("Não posso. Recebemos um aviso, dissemos que dentro de uma hora haveria uma nevasca.", "Beth")
	await novel_interface.show_dialog("Todos em alerta máximo. Continue andando.", "Beth")
	await novel_interface.show_dialog("(Todos) Sim, senhor!", "Membro do Esquadrão")
	await novel_interface.show_text_only("Os membros do esquadrão andam na ponta dos pés, mantendo a respiração baixa.")
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Cuidado!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O som de uma lâmina afiada cortando o ar quebrou o momento de silêncio.")
	await novel_interface.show_text_only("Uma criatura empunhando uma arma pesada em forma de foice salta das sombras e ataca o lado direito de Beth.")
	await novel_interface.show_text_only("O aviso de Milk chegou bem a tempo, permitindo que Beth se esquivasse do ataque.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("O que?!!", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahaha... hahahahaha...", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O agressor é uma garota – olhos vazios, postura distorcida. Ela se inclina para frente, suas juntas estalando, alto e desorientador.")
	await novel_interface.show_text_only("Vários outros, rostos frescos e expressões insanas, surgem pela entrada do corredor anteriormente vazio.") 
	await novel_interface.show_text_only("Os membros do esquadrão imediatamente entram em sua formação triangular padrão, enquanto continuam a atirar contra os atacantes.")
	await novel_interface.show_text_only("Seguindo o exemplo de Beth, eles cercam o membro que segura a caixa de espécimes, protegendo-a por todos os lados.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Snedronningen_Exhibition_Room.png")
	await novel_interface.show_text_only("A equipe mantém um ritmo de tiro constante enquanto busca cobertura. Logo chegam a um espaço que parece ser uma sala de exposições.")
	await novel_interface.show_text_only("As luzes são fracas aqui, com as exposições sendo principalmente espécimes de animais.")
	await novel_interface.show_text_only("O líder orienta a equipe a formar uma linha de defesa na entrada da sala, enquanto o restante do esquadrão discute as qualidades anormais que notaram nesses inimigos.")
	await novel_interface.show_text_only("Quando atingidos, eles não sangram. Eles nem parecem sentir dor.")
	await novel_interface.show_text_only("O grupo desdobra seus escudos de fibra Kevler, que bloqueiam um pouco os ataques.")
	await novel_interface.show_text_only("Os inimigos que avançam do outro lado, com grandes espadas em mãos, são retidos na esquina por membros do esquadrão segurando ainda mais escudos de choque.")
	await novel_interface.show_text_only("Enquanto isso, por trás dos porta-escudos, balas de 9 mm continuam a chover sobre os inimigos, com o cheiro de pólvora pesado no ar.")
	await novel_interface.show_dialog("Recarregar!", "Membro do Esquadrão C")
	await novel_interface.show_text_only("O tiroteio não faz nada para deter os estranhos inimigos. Mesmo quando as balas atravessam seus rostos, essas garotas horríveis continuam sorrindo.")
	await novel_interface.show_text_only("Até que uma das garotas salta sobre um escudo e se pendura de cabeça para baixo, como um morcego, no teto da passagem.")
	novel_interface.show_character("milk_battle","shock")
	await novel_interface.show_dialog("Uh... ela é mesmo... humana?", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um líquido verde-tinta escorre dos ferimentos de bala da garota. Seu pescoço, quase quebrado ao meio pela força das balas, está agora tingido de um perturbador roxo-esverdeado.")
	await novel_interface.show_dialog("Cuidado!", "Membro do Esquadrão B")
	await novel_interface.show_text_only("Mais inimigos vêm atacando do final do corredor.")
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Retire-se! Retiro!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os membros do esquadrão não têm escolha a não ser se dividir em duas direções e buscar outros pontos de ataque adequados, que felizmente encontram em breve.")
	await novel_interface.show_text_only("Eles ainda não lutam há muito tempo, mas é óbvio para todos eles que os inimigos – sejam eles quais forem – são tão poderosos quanto os seus.")
	await novel_interface.show_text_only("E também cem por cento mais louco.")
	novel_interface.show_character("baizhu_battle","angry")
	await novel_interface.show_dialog("... O que são...?", "Beth")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("milk_battle","solemn",0.25)
	await novel_interface.show_dialog("Que diabos?\\nEles não podem ser humanos!", "Milk")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Para Beth, é óbvio que essas jovens empunhando lâminas são exatamente como ela—")
	await novel_interface.show_text_only("Não, não completamente.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Eles são mais parecidos com o que seu pai descreveu...)\\n(\\\"Estilo de Ningen\\\")", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("São resilientes, recuperam-se rapidamente, com articulações extremamente flexíveis que os tornam menos humanos e mais parecidos com marionetes ágeis. Muito poderoso.")
	await novel_interface.show_text_only("E eles claramente enlouqueceram. Como máquinas de matar ativadas por programas.")
	novel_interface.show_character("witch_third")
	await novel_interface.show_dialog("Hahahaha... Jajajajajaja...", "Pitonisa irregular")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seu balbucio absurdo soa como algum tipo de canto demoníaco. Definitivamente não é humano.")
	await novel_interface.show_text_only("De repente, o membro do esquadrão que segurava a caixa de espécimes é atingido por uma flecha. Quando ela cai no chão, a caixa rola para fora de seus braços.")
	await novel_interface.show_text_only("Mas os inimigos não parecem ter pressa em pegá-lo.")
	await novel_interface.show_dialog("Bete!", "Membro do Esquadrão D")
	await novel_interface.show_text_only("Os membros do esquadrão, forçados até as profundezas da sala de exibição pelos inimigos que avançam, clamam para que seu comandante dê mais instruções.")
	await novel_interface.show_text_only("Esta é uma situação em que nenhum protocolo normal se aplica. Tudo em que Beth pode confiar agora são seus próprios sentidos e julgamento.")
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Então eles não estão aqui pelos espécimes?)", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_battle","solemn")
	await novel_interface.show_dialog("Droga!", "Milk")
	await novel_interface.hide_character()
	novel_interface.show_character("baizhu_battle","stare")
	await novel_interface.show_dialog("(Então o objetivo deles deve ser—)", "Beth")
	novel_interface.change_expression("angry")
	await novel_interface.show_text_only("– para aniquilar todos nós.")
	await novel_interface.show_dialog("... \\n(Então são vocês mesmo... )", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O olhar de Beth pousa no símbolo bordado no tapa-olho de uma daquelas marionetes.")
	await novel_interface.show_text_only("Ela viu esse símbolo inúmeras vezes enquanto investigava a morte de seu pai.")
	await novel_interface.show_text_only("É um olho solitário e assustador – um olho com membros.")
	print("=== 深海恐惧症篇第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
