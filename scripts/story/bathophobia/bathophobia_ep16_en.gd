# bathophobia_ep16.gd - 深海恐惧症篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep16_script()

func play_script():
	pass

func bathophobia_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	await novel_interface.show_text_only("Raphael found a few tanks of diesel on the second floor, which should be able to keep the depot running for a few days.")
	await novel_interface.show_text_only("As the power is back on amid the rumbling sound of the generator, I rush into the bathroom immediately.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Using a toilet in the dark would definitely be the last thing I want to do…)", "Lian")
	await novel_interface.show_dialog("(Thank god they didn't make it a see-through bathroom…)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Holy crap…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I pull myself out of the bathroom, my stomach still in pain. Annie seems recovered a bit and is able to get back on her feet.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Annie, are you all right?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal2",0.25)
	await novel_interface.show_dialog("Yeah, I'm fine. Let's go check the communication room…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As she can barely stand up straight, I help her all the way to the second floor.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("The communication room is pretty rustic inside, where a T-shaped aisle leads all the way to the curved wall of the observation area.")
	await novel_interface.show_text_only("The cabinets are stuffed with drinking water, canned food and other non-perishable food.")
	await novel_interface.show_text_only("The air here seems pretty fresh. Through the window we can see the auroras dancing across the night sky.")
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Let's see if the system works…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She tries to start the old equipment on the operation panel. Fortunately, all the “reliability first\" hardware still works.")
	await novel_interface.show_text_only("As a well-trained SID agent, Annie is quite familiar with the system. The antennas installed outside the depot seems not much affected by the extreme temperature.")
	await novel_interface.show_text_only("Through the vents in the wall, a warm and moist flow of air slowly streams into the room.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Looks like the heating system is on.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I glance at the temperature display fixed on the wall, which shows the indoor temperature is steadily rising from 32°F.")
	await novel_interface.show_text_only("But the outdoor temperature… -44°F?!")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Had it not been for Heinrich's topaz…", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Wearing a skirt at a temperature of -44°F and playing in the snow…)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Guess I have unlocked a new achievement to brag about…)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Wait… We'd better make contact with Mariru as soon as possible. Only she can get us out of here.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Speaking of this, what's wrong with the chip?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I touch my chest instinctively. Never have I ever been so eager to hear Mariru's voice from there.")
	novel_interface.show_character("anne_normal","normal1")
	await novel_interface.show_dialog("Connecting to satellites… Done.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Following Annie's instructions, I enter a string of numbers which is long etched in my mind.")
	await novel_interface.show_text_only("Guess I need to thank Mariru for forcing me to learn the encrypted identification codes of SID by heart.")
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("That's how it works! Interesting…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Since we arrived at the depot, Heinrich has been so caught up in observing the materials and items stored here.")
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("I've always wanted to feel them in my hands!", "Henriette")
	await novel_interface.show_dialog("What a wonderful combination of sand, aluminum, calcium, combustible metals and basalt…", "Henriette")
	await novel_interface.show_dialog("And the fiberization process has changed all their properties.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Hmm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("They used a new combination of materials to make this glass. It’s something I’ve never heard of.", "Henriette")
	await novel_interface.show_dialog("Their method can prevent heat loss… That's really smart.", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("But we alchemists would rather use the energy conversion inscriptions, which is much easier.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Inscriptions… You mean the magic?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Who would use magic to make a piece of glass?! You may lose your mind for it!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("But the rubber products in the small packs there have truly impressed me with its extraordinary flexibility.", "Henriette")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("And the fruity fragrances… What are they used for?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("I… I don't know!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("It’s just chewing gum, you stupid perv.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael rolls her eyes at me.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("For goodness' sake, Heinrich has fully absorbed herself in the world of alchemy!")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Back in the headquarters, Mariru and Aya are searching for Ren.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Still no sign of Ren's chip. That's weird. The satellite cluster literally covers every corner of the globe…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Could it be extraterrestrial teleportation or time warp?", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("As the saying goes, \"entities should not be multiplied beyond necessity\". Simpler assumptions are more likely to be correct.", "Mariru")
	await novel_interface.show_dialog("In fact, the so-called \"global satellites\" cover only between 70 °N to 70°S.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You mean…", "Ai")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A connection confirmation suddenly pops out through SID's encrypted communication channel.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("He-hello?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru! It's me!! \\nOh my god, finally…", "Lian")
	await novel_interface.show_text_only("Hearing the familiar voice, Mariru soon comes to herself. The tension seems instantly gone.")
	await novel_interface.show_text_only("With her eyes fixed on the offline signal, she immediately starts the trace-back procedure.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ren? Report your location. \\nAre you with the other girls?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yes, I'm now at a depot with Raphael and Annie. \\nWe're safe here, but…", "Lian")
	await novel_interface.show_dialog("We're now… in Antarctica.", "Lian")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Antarctica?!", "Ai")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Clearly it's an answer beyond expectation, but there's no flicker of surprise on Mariru's face.")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Sounds like Ren is not suffering hypothermia.) \\n(They must have found someplace safe.)", "Mariru")
	await novel_interface.show_dialog("(Was there another Spacetime Flux during the experiment at the Ark Base?)", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The tracing result pops up on the screen–No. 2 Joint Depot in Princess Elizabeth Land, East Antarctica.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("It all makes sense now… Low Earth Orbiting satellites will not pass over that area unless their orbits are manually altered.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Because the polar solar wind will interrupt data transmission.", "Ai")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("I completely overlooked…", "Ai")
	await novel_interface.show_dialog("Shall we hook up the satellites above Antarctica?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-hum. Remember, do not wake those sleeping old dogs.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("I don't know what happened… I was just brought here all of a sudden.", "Lian")
	novel_interface.show_character("liliu_uniform2","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("ai","normal",0.25)
	novel_interface.character_2nd_dark(0)
	await novel_interface.show_dialog("Besides you three, is there anyone else?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("You mean Heinrich? \\nShe is right beside me.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot2.png")
	await novel_interface.show_text_only("I didn't expect we could make contact with Mariru through such antique equipment. I have to admit that Mariru's voice has given me great relief.")
	await novel_interface.show_text_only("I brief her about the current situation.")
	await novel_interface.show_dialog("… very well noted.", "Mariru")
	await novel_interface.show_dialog("Listen, you're now very close to the South Pole, which means picking you up is not so easy.", "Mariru")
	await novel_interface.show_dialog("According to the post-war New Antarctic Convention, any country who wants to send an expedition team of more than 5 members…", "Mariru")
	await novel_interface.show_dialog("… Or an aircraft there, has to seek permission from the United Congress.", "Mariru")
	await novel_interface.show_dialog("And the aircraft will probably need to make a stopover in New Australia…", "Mariru")
	await novel_interface.show_dialog("So even if we manage to take off in 1 hour and run through all the procedures during the flight, it'll take about 40 hours to get there.", "Mariru")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("That'll be fine. The generator here can last for a few days and we have enough food to survive.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("The closest apron to you guys is 68° 24' S and 76° 55' E, about half a mile away from you.", "Mariru")
	await novel_interface.show_dialog("Given the unpredictable weather conditions in the Antarctic, we may lose touch with you guys at any time. If that happens, remember I'll meet you there.", "Mariru")
	await novel_interface.show_dialog("It's a large base named Snedronningen, which literally means the snow queen\\nand most of its facilities were built underground…", "Mariru")
	await novel_interface.show_dialog("As for the details… We will keep you posted. Ren,… thisshig rrrerrk…", "Mariru")
	await novel_interface.show_text_only("Mariru's voice is swallowed in a sudden electricity noise.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Mariru? Hello?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("He-hello? Can you hear me?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The noise at the communication center is growing louder.")
	await novel_interface.show_dialog("There may be a solar wind blast… You'd better…  check the signal reception now.", "Mariru")
	await novel_interface.show_text_only("Wow——")
	await novel_interface.show_text_only("As the electricity noise grows stronger, Mariru's voice vanishes from the receiver.")
	await novel_interface.show_text_only("A silence looms over us.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("I guess… we've lost touch with them again…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Forty hours? You'd better pray that there will be no more surprise.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It gives me bad vibes but I don't know why.")
	await novel_interface.show_text_only("Outside the window, auroras have all gone with the fading signals and even the faint wind has died down.")
	await novel_interface.show_text_only("The only sounds we hear now come from the computer radiators and the A/C fans.")
	await novel_interface.show_text_only("Such a silence always reminds me of the calm before the storm…")
	await novel_interface.show_text_only("Suddenly, the operation panel shakes a little bit.")
	await novel_interface.show_text_only("No, that's impossible. I must have lost my footing just now.")
	novel_interface.show_character("anne_normal","panic")
	await novel_interface.show_dialog("… Did you feel that?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("You mean the…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The slight shaking is growing more and more violent.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Oh my god… Are you kidding me?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Holding the operation panel for support, I feel my heart skipping a beat.")
	novel_interface.show_character("heinrich_battle","perspire")
	await novel_interface.show_dialog("What are these…?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A roaring noise comes from the ground under our feet.")
	await novel_interface.show_text_only("The building begins to shake so violently that we can barely stand up straight.")
	await novel_interface.show_text_only("Everything on the table bounces like Pop Rocks dissolving in the mouth.")
	await novel_interface.show_text_only("A horrible cracking sound travels from the glaciers in the distance.")
	await novel_interface.show_text_only("A glance at the out of the window confirms my fear–")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("It's an earthquake!", "Lian")
	print("=== 深海恐惧症篇第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
