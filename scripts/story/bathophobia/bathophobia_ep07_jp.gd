	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("着いたぞ。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("──『方舟基地』へようこそ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("なんてこった……\\nここまで徹底的に改造していたのか──！")
	await novel_interface.show_text_only("目の前に現れたのは、巨大な貯水池。\\n\\nきらきらと輝く池の水は、\\nまるで波止場にいるかのようだ。")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("よく見ておくんだぞ。\\n『方舟搭乗ブリッジ』の初正式ドッキングだ。", "マリル")

