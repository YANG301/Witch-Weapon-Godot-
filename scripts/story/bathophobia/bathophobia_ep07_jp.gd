# bathophobia_ep07.gd - 深海恐惧篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep07_script()

func play_script():
	pass

func bathophobia_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_entrance.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("マリルの赤いクーペからようやく降りられたが、\\n俺の眩暈は止まらず……\\n両足もまるで綿を踏んでるかの如く\\n……正直　フラフラだ。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("マリル……うぷッ……\\nお前の運転！！　ヤバすぎるだろ……ッ！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("とある週末の爽やかな朝、俺は暖かい布団の中で\\nキノコのように丸まっていたが、\\n突然アニーが部屋に入ってきて、\\n強引に布団から掘り起こされた。")
	await novel_interface.show_text_only("寝起き状態でスポーツカーに放り込まれた時は、\\nアニーの暴力的な採掘行為に憤慨していた。")
	await novel_interface.show_text_only("だが、マリルの驚天動地の運転技術を\\n体験した現在では、頭の中に──\\n「本当、生きてて良かった」とうワードしか\\n思い浮かんでいない。")
	await novel_interface.show_text_only("今日は『方舟実験』ということであるが、\\nここは病欠を申請するか……")
	await novel_interface.show_text_only("ここ数日間、お腹も痛み続けていて……くそっ。")
	await novel_interface.show_text_only("気持ち悪い……うぷッ。")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("レンちゃん、大丈夫？", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺はアニーに手を振った。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("大丈夫。\\n少し吐き気がして、身体が震えてるだけ……", "小憐")
	await novel_interface.show_dialog("帰る時は、この車に乗らなくてもいいよな……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は弱々しい声と祈るようなまなざしを\\nアニーに対して向けた。")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("あんた未だに心の底から、その少女設定を\\n信じ込んで拗らせているみたいね。", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("壁を支えにゆっくり体調を整えている\\n俺の背後から、馴染みの声が聞こえてきた。\\nおいおい、勘弁してくれよ……")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("ラファエル……！　どうして君が……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("マリルに教えてもらっていないのかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("事前に伝えていたら、余計に来たくないと\\n駄々をこねるだろうからな。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ペット売りが自分の商品を見ているかのように、\\nマリルは淡々とした口調で話した。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("それじゃレンを頼んだぞ。\\n\\n『サモントン執行代表』\\n──ラファエル・デックス殿。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("えっ！？　頼むってっ！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは微笑みながら、\\n俺達を『方舟基地』の入り口まで案内した。")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("ここ……なの？", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("郊外の道端には、コンクリート製の地下への\\n入口があった。\\n1人しか通れないぐらいの小さなドアが、\\nその中にポツンとついている。")
	await novel_interface.show_text_only("ここより周囲1キロメートル以内に建造物は\\n存在せず、SIDと刻んでる標識がなければ、\\n変なおじさんが住み着いてもおかしくは\\nないだろう。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("入れば分かるさ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator_overlook.png")
	await novel_interface.show_text_only("ドアを開けて、下へと伸びる階段を通り、\\n大型の工業エレベーターに乗った。")
	await novel_interface.show_text_only("極度の環境でも正常に動作するよう、\\nエレベーターは4つの分厚い金属ローラーで\\n駆動している。\\n構造は異常なぐらいまでに頑丈そうだ。")
	await novel_interface.show_text_only("エレベーターが徐々に降下している間、\\n周囲から歯車の回転する音が聞こえる。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_elevator.png")
	await novel_interface.show_text_only("薄暗い明かり、排気口、金属網とリベット。\\n所々が旧式的な工場の雰囲気を漂わせている。")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("安定性を追求した設計……\\n\\n以前、ニューモリダス中央銀行の地下金庫でも\\n見た事があるわ。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("そんなところに行った事あるのかッ！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ここは戦前、世界的に有名だった\\nスーパープロジェクト跡地の1つだ。\\n修復には随分と手間取ったが。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは得意げに紹介を始める。")
	await novel_interface.show_text_only("下降中のエレベーターは大きな鉄塊を、\\n踏んでるかのように安定していた。\\n飛び上がってもビクともしない感じだ。")
	await novel_interface.show_text_only("車酔いから復活した俺は飛び跳ねようとしたが、\\nラファエルが睨みつけている事に気付く。")
	await novel_interface.show_text_only("バカっぽい行動に自ら羞恥心を感じて、\\n申し訳ない表情を浮かべる。\\nだが、彼女は軽蔑するようにそっぽ向いて\\n窓の外に視線を向けていた。")
	await novel_interface.show_text_only("……真っ暗だし、何も見えないと思うけどね。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("なぜ、私をずっと見つめているのかしら？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こっちのセリフだよッ！　\\n先に見てたのそっちだろッ！？")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("あっ、いや……まさか君がサモントン側の代表になるとは思わなかったよ。", "小憐")
	await novel_interface.show_dialog("今回の実験って、結構危険じゃんか？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さらに重要な事は、今回の実験には\\n「2つのシナリオ」が存在する事だ。")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("（君がどっちの脚本を持っているのか\\n　分からないんだよ、お嬢様っ！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不安に満ちた俺は、マリルに視線を向けた。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("表向きだと今回は新豊洲とサモントン。\\n2つの学園都市による共同研究プロジェクトだ。", "マリル")
	await novel_interface.show_dialog("目標は『異変空間』の生成原因の研究。\\nそして、解決策を探す事。", "マリル")
	await novel_interface.show_dialog("双方とも身分と能力が適しており、\\nかつ信頼できる人間が実験サンプルを務める。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("まあ、新豊洲側の人選はスカイホテルで\\n一連のバカ騒ぎを起こし、\\n身元を露呈してしまったお前となるわけで──", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは俺に視線を向ける。その視線の強大な\\nプレッシャーには冷え汗が止まらないぜ！")
	await novel_interface.show_text_only("もう……充分に罰は受けたじゃないか……")
	novel_interface.character_light()
	await novel_interface.show_dialog("そして貴族出身であり現在御桜川在学中の\\n「一般人」ラファエルが、\\nサモントン側代表として自らの参加を志願した。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("……志願しただって！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("ふんっ。\\n『青金石柱』はサモントンの重要な歴史文化財。\\nあんたみたいなヘタレが原因で、\\n召喚の実験を失敗させるわけにはいかないわ。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("ラファエルは細胞の自己再生を加速させる能力を\\n持っている。\\nこの点は愛衣がすでに検証済だ。", "マリル")
	await novel_interface.show_dialog("ベアトリーチェによると、\\nこの再生能力を最大限に発揮するには、\\nレンが最も媒体に適しているのだそうだ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スカイホテルの駐車場でラファエルがアニーの\\n傷を一瞬で治療した、あの場面を思い出した。")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("召喚の実験って……\\nつまりラファエルは味方側か！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("ふんっ。あんたって本当\\n「アアーモウ持タナイ早ク回復オォー」とかいう\\n軟弱なセリフが相変わらず似合うわよね。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("なんか、そんな場面が来るのを\\n期待していないか！？", "小憐")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("というかこれ、機密実験だったんじゃ？\\n\\nなぜラファエルが裏の事情を知ってるんだ……？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("もちろん、私がデックス博士に伝えたからだよ。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("彼はあなたがベアトリスを復活させるのを目撃して以来、元老院とのこれまでの協力が間違った方向にあったと感じていました。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("宗教的な原因か……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("そんな簡単な話ではないと思うが──\\nまぁともかく、少なくともラファエルの安全を\\n保証する限り、今のサモントンはSID側に\\n寄っていると考えていいだろう。", "マリル")
	await novel_interface.show_dialog("元老院はレンとラファエルの本当の能力を\\n把握してはいない。\\nこれは私達の有利な点である。", "マリル")
	await novel_interface.show_dialog("『魔女』となった人間が他の魔導器に触れても、\\n狂ってしまうような効果は発現しない。\\nこれも私達の作戦を成立させるに大事な情報だ。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("双方のお偉様方の協力を感謝しないとな～～", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("……奇想天外な発想を持つ私のお爺様を、\\nあんたが誘導したんじゃないの？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("おじいちゃんをそう簡単に考えない方がいいぞ。\\nこの文化財も適当に選んだものじゃない。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("これも「本当の実験」を順調に進めるための\\n手配ってやつだ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("チッ、お爺様の命令でなければ……", "ラファエル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ラファエルはぼんやりと何かをつぶやき、彼の目は軽く私を通過した。")
	novel_interface.character_light()
	await novel_interface.show_dialog("この女装癖と芝居なんてごめんよッ！", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("しかしデックス博士がいつも言っているぞ？\\n家の中で最も言う事を聞かないのはお前だとな～", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("ふん……っ！", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("本当の実験…………\\n\\nサモントンが興味を持っているのは、\\n青金石柱の元持ち主であるハインリッヒなのか？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("頑張ってね、レンちゃん！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("元老院はSIDに対して内密に、サモントンと\\n人造魔女の研究を進めようとしている。\\n俺の「安定装置」としての可能性を\\n試したいのだろう。　")
	await novel_interface.show_text_only("だが、サモントンは元老院に背いて\\nマリルと取引をしている。")
	await novel_interface.show_text_only("そしてマリルは元老院に、俺とラファエルの\\n事情を隠した。")
	await novel_interface.show_text_only("この関係性を考えるだけでも\\n頭が痛くなってくる……")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("（本当に上手くいくのかな……）", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("不機嫌そうなお嬢様をこっそりと見た。")
	novel_interface.character_light()
	await novel_interface.show_dialog("（ラファエルが御桜川に転入した事も……）\\n\\n（まさか最初から計画の一部、なのか……？）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("（このバカ、\\n　またある事ない事を考えているわね）", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…………")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("「ドン！」というロックを掛けるような音と共にようやくエレベーターが止まった。\\n俺達の目の前に現れたのは、\\nおおよそ10メートルほどの金属の扉。")
	await novel_interface.show_text_only("赤い光を放つスキャナーが、上から下へと俺の\\n身体をかすめ、扉の内側から確認の音が流れる。")
	await novel_interface.show_text_only("次にマリルが前に進み、虹彩認証を行った。")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("古い感じのセキュリティシステムだけど、\\n厳しいんだな……", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_corridor.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("スキャンがようやく終わると、扉がゆっくりと\\n下に降りて驚愕の空間が目の前に広がった。")
	await novel_interface.show_text_only("冷たい色調の巨大な地下空間に、この金属扉と\\n同じぐらいの高さの柱が両列に伸びている。")
	await novel_interface.show_text_only("各コンクリートの柱の根元には、\\n大量の双方向反射式アーマープレートを増設。")
	await novel_interface.show_text_only("外側はロケットランチャーを悠々と防御する\\nとてつもない硬さを誇る一方で、\\n内側は包まれた物を一瞬で粉々にする\\n破壊力を持つ。")
	await novel_interface.show_text_only("この装甲は七年戦争中に、封鎖や自爆の必要性がある建造物に良く使われていた。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("ここはジメジメしてるなぁ……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("床には水の跡があり、頭上の何十本と交錯した\\n複雑なパイプから液体の流れる音が響く。")
	await novel_interface.show_text_only("マリルがここを改造したらしいが、\\n相当工夫したのだろうか。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("キョロキョロと辺りを見回しながら奥へ\\n進んでいくと、\\nその道の果てに金属プレートで完全に包まれた\\n空間が見えてきた。")
