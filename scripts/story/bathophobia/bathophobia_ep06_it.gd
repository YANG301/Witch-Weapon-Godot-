# bathophobia_ep06.gd - 深海恐惧篇第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep06_script()

func play_script():
	pass

func bathophobia_ep06_script():
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	await novel_interface.show_text_only("In piedi sul podio, Mariru presenta un rapporto completo sui progressi delle ricerche recenti durante la consueta videoconferenza.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Per quanto riguarda il Progetto Arca...", "Kirs")
	await novel_interface.show_dialog("Dall'elenco delle reliquie fornito da Salmonton, hai scelto il Pilastro di lapislazzuli di Tesheim, giusto?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Sì, signore. Ora la chiave è come creare un'area di flusso controllabile.", "Mariru")
	await novel_interface.show_dialog("Tutti i casi recenti di flussi spaziotemporali in tutte le città accademiche sono stati causati dal contatto umano con oggetti aventi proprietà Substance H.", "Mariru")
	await novel_interface.show_dialog("Questi elementi erano rimasti dormienti per molto tempo ma si erano attivati quasi contemporaneamente.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Più precisamente, Frammento della strega e Frammenti del grimorio. Ma è meglio spiegarlo in parole povere.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Intendi il giorno in cui il Calice di Ross scomparve...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Non possiamo ancora confermare la loro connessione.", "Mariru")
	await novel_interface.show_dialog("Poiché ci sono troppi fattori incontrollabili, dobbiamo filtrare tutte le reliquie in base a due criteri.", "Mariru")
	await novel_interface.show_dialog("Innanzitutto, deve essere una sostanza a bassa attività che mostra proprietà Substance H secondo la scansione della tonalità.", "Mariru")
	await novel_interface.show_dialog("In secondo luogo, il proprietario originale è rintracciabile nei documenti storici e questa persona non deve avere tendenze alla violenza o commettere atti criminali.", "Mariru")
	await novel_interface.show_dialog("Il Pilastro di Tesheim Lapis era originariamente di proprietà di Heinrich Khunrath, un medico e alchimista del Rinascimento.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Bassa attività... Che peccato... Mi aspettavo che questa volta potessimo raccogliere dati più vicini al valore critico.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Il campione è troppo prezioso per perderlo. È meglio restare sul sicuro.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("(Devo solo dimostrare la capacità di Ren di passare attraverso le aree di flusso. Per questo, dobbiamo solo recitare.)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(In effetti, il Pilastro di lapislazzuli di Tesheim non è un frammento della strega) \\n(È solo un quasi Substance H con iscrizioni magiche su di esso.)","Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Toccare il frammento di una strega è troppo pericoloso per la gente comune.) \\n(Dopo tutto, non sono l'uomo gorilla...)","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dallo schermo esce uno scoppio di risate profonde.")
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("Alchimista... Un pioniere della scienza, eh? \\nChe scelta interessante.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_taki")
	await novel_interface.show_dialog("Ho sentito dire che si trattava di un'opera d'arte di grande significato storico e che il proprietario Heinrich era uno dei fondatori del Rosenkreutz...", "Eloise")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Il Rosenkreutz era semplicemente un gruppo religioso e occulto. Non ha nulla a che fare con l'attuale agenzia di intelligence di Salmonton.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Immagino che gli alchimisti possano essere visti come gli scienziati di quell'epoca. Si spera che fosse un uomo in soggezione verso l'ignoto.", "Mariru")
	await novel_interface.show_dialog("Ma conosci bene il dottor Dekkers. Non ci presterebbe mai una reliquia così importante senza pagare, a meno che...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uno strano silenzio riempie la stanza.")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Esatto. La parte Salmonton vuole la condivisione dei dati e un rappresentante nel nostro team.", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("…", "Mariru")
	await novel_interface.show_dialog("(Quindi, non hanno rinunciato a produrre altre streghe...) \\n(Vogliono usare Ren come stabilizzatore?)","Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ben notato. Voglio solo confermare che tutti, compreso il lato Salmonton, comprendono il pericolo di questo esperimento.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Affermativo. Abbiamo trasformato i mega impianti di drenaggio sotterraneo della vecchia capitale nella Base dell'Arca, nel caso in cui si verificasse lo scenario peggiore.", "Kirs")
	await novel_interface.show_dialog("Il sistema anti-intrusione dell'acqua di mare ultraveloce può inondare l'intera base entro 30 secondi.", "Kirs")
	await novel_interface.show_dialog("Se qualcosa va storto durante l'esperimento...", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("In tal caso, spero che il nostro caro Mariru abbia il coraggio di avviare il dispositivo di autodistruzione di emergenza.", "#C")
	
	print("=== 深海恐惧篇第6话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
