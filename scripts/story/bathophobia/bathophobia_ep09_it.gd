	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Spara... Un flusso spaziotemporale...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dietro Heinrich appare uno specchio che ruota in senso antiorario, assomigliando a delle onde.")
	await novel_interface.show_text_only("La ragazza cade all'indietro e gradualmente si immerge nel vuoto.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ren, corri!", "Annie")
