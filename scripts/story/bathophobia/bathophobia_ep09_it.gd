	await novel_interface.show_dialog("Sei stato tu a realizzare questo miracolo?", "Ragazza bionda")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza atterra lentamente sul pavimento e fa rispettosamente un passo indietro.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("…Eh? \\n(Non so dove guardare!!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Oppure hai realizzato tu questo contenitore per la mia anima?", "Ragazza bionda")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ah... forse... sì?", "Lian")
	await novel_interface.show_text_only("Scusa, ho appena dato una piccolissima spinta al pilastro!")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza si mette una mano sul petto e si inchina leggermente verso di me.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Quindi, se vuoi...", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mi guarda negli occhi. \\nLeggo un forte desiderio nei suoi occhi azzurri.")
