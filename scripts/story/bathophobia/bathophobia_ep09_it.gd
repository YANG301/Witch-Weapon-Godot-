	await novel_interface.show_text_only("E sta cadendo sempre più velocemente.")
	await novel_interface.show_text_only("Bum——!!!")
	await novel_interface.show_text_only("L'enorme scoppio avviene quando il pilastro si scontra con la piattaforma metallica e si rompe in due pezzi. Il pezzo più lontano scivola anche qualche centimetro in avanti.") #缩减符号
	await novel_interface.show_text_only("Piccoli frammenti si sparpagliano e il pezzo più lontano rotola addirittura nella pozza di fronte.")
	await novel_interface.show_text_only("C'è un lungo silenzio...")
	await novel_interface.show_text_only("Da un po' di tempo, anche Raphael ha perso la sua solita arroganza, apparendo estremamente scioccata.")
	await novel_interface.show_text_only("Poi si gira lentamente verso di me.")
	await novel_interface.show_text_only("Posso vedere il fuoco che arde nei suoi occhi.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("No, io... io non...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Ark_base_flare.png")
	await novel_interface.show_text_only("Quando faccio fatica a pensare a come salvarmi il sedere, il suono di un campanello a vento arriva dal nulla.")
