	await novel_interface.show_text_only("…?")
	await novel_interface.show_text_only("Apro lentamente gli occhi.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Sembra che... non sia successo niente.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Appoggio tutto il palmo della mano sul pilastro. Sembra marmo.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Mhm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Provo un'altra angolazione e gli do una spinta forte.\\nIl pilastro, che pesa più di quindicimila libbre, rimane immobile.")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Tsk!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mi disprezza.")
	await novel_interface.show_text_only("Che non accada nulla è stato il risultato che desidero di più tra tutte le ipotesi che abbiamo fatto durante la riunione preparatoria:")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("(Ma perché… mi sento un po’ in imbarazzo…)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mentre la mia mano è ancora sul pilastro, l’atmosfera è imbarazzante. Proprio mentre sto pensando di premere più forte, il mio cuore improvvisamente si contrae bruscamente.")
	await novel_interface.show_text_only("Quasi nello stesso tempo il pilastro trema.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Poi, il pilastro si stacca dalla mia mano, lasciando un piccolo spazio che si sta lentamente allargando.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("—Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'alta piattaforma e la base del pilastro scricchiolano, producendo rumori profondi e sommessi...")
