	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eeeeeessenza?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fermare-!")
	await novel_interface.show_text_only("Ferma la strana immaginazione!!!")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("“Alchimia, la ricerca della saggezza degli elementi e della vita.”", "Ragazza bionda")
	await novel_interface.show_dialog("L'uomo in grado di ricostruire un corpo ed evocare un'anima deve possedere la verità che non possiedo.", "Ragazza bionda")
	await novel_interface.show_dialog("Io… Henriette Kunhardt, sono pronta ad essere una serva della verità…", "Ragazza bionda")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich si ferma improvvisamente e guarda solennemente uno spazio aperto nell'atrio.")
	await novel_interface.show_text_only("Seguendo il suo sguardo non vedo altro che pilastri.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("(Aspetta. Ha detto qualcosa riguardo s...servo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza sospira.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Trovato così in fretta.", "Henriette")
	await novel_interface.show_dialog("Anche con un nuovo corpo, sono ancora vincolato dal contratto...", "Henriette")
