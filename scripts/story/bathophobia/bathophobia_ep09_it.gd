	await novel_interface.show_text_only("Il mio sedere è freddo nel vento e mi fa ancora più male lo stomaco!")
	await novel_interface.show_text_only("Questo è…")
	await novel_interface.show_text_only("Il giorno peggiore di sempre!!!")
	
