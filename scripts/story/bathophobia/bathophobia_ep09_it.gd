	await novel_interface.show_text_only("Riflettendo archi colorati di luce, i frammenti del pilastro formano diversi anelli e fluttuano verso l'alto.")
	await novel_interface.show_text_only("Alla fine, tutti i pezzi rotti si dissipano nell'aria, lasciando numerosi anelli di luce fluttuanti che illuminano l'intera sala.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Ehi...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non posso fare a meno di toccare un anello formato da piccoli frammenti—")
	await novel_interface.show_text_only("L'anello si rompe immediatamente in punti di luce dorati.")
	await novel_interface.show_text_only("I punti fluttuanti si disperdono come polvere.")
	await novel_interface.show_text_only("Poi si concentrano e creano una luce sempre più abbagliante...")
	await novel_interface.show_text_only("Dalla luminosità che fa male agli occhi, davanti a me appare un'adolescente dai capelli dorati.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("…!!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_text_only("Con le braccia spalancate, sta tranquillamente di fronte a me... Ma non riesco proprio a distogliere lo sguardo da questa scena affascinante.")
	await novel_interface.show_text_only("C'è un vago profumo di fiori d'arancio e viola nell'aria.")
	await novel_interface.show_text_only("La ragazza apre lentamente gli occhi.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Che \"risultato\" intrigante e favoloso...", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Si guarda intorno.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Siamo… tempi moderni!?", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ai suoi occhi, una crescente eccitazione sta sostituendo la vuota confusione.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Acqua e carbonio, cloruro di sodio e zolfo, silicio e ferro…", "Ragazza bionda")
	await novel_interface.show_dialog("Hanno creato un posto così bello...", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Guarda incredula le sue mani tremanti.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Il tocco del corpo…", "Ragazza bionda")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza sente lentamente il suo corpo da cima a fondo.")
	await novel_interface.show_text_only("All'improvviso mi rendo conto che non dovrei guardare, quindi mi giro immediatamente dall'altra parte.")
	await novel_interface.show_text_only("Ma non posso fare a meno di lanciarle uno sguardo...")
	await novel_interface.show_text_only("Lei... la sta addirittura toccando... lei...!!")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Anche questo... viene ricreato?", "Ragazza bionda")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("…La luce era così forte che non vedevo nulla!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abbiamo tutti i tipi di piani di emergenza, ma per un po' nessuno di noi tre sa cosa fare dopo.")
	novel_interface.show_character("heinrich_naked")
	await novel_interface.show_dialog("Quindi...", "Ragazza bionda")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La ragazza bionda guardò Anne e Raphael, che erano ancora tesi, e il suo sguardo cadde su di me, che avevo un'aria spenta.")
