# bathophobia_ep15.gd - 深海恐惧篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep15_script()

func play_script():
	pass

func bathophobia_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_dialog("Ah-ciu…", "Beth")
	await novel_interface.show_text_only("Appoggiando la testa sulla scrivania, la ragazza avrebbe potuto appisolarsi se non fosse stato per questo starnuto.")
	await novel_interface.show_text_only("Fuori dall'oblò del sottomarino c'è la notte polare e lei non riesce a capire l'ora dal colore del cielo.")
	await novel_interface.show_text_only("Beth guarda lo schermo e si rende conto che sono passate solo poche ore dal suo incontro con il mostro degli abissi.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("… Sto facendo la cosa giusta?", "Beth")
	await novel_interface.show_dialog("(Usandola per trovare la verità da solo...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Senza accorgersene, Beth dà un'occhiata al taccuino che ha in mano.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Se il padre fosse qui…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Non vacillerebbe mai a causa di questo tipo di emozioni.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/baizhu_father.png")
	await novel_interface.show_text_only("Pensando alle mani forti di suo padre, Beth stringe lentamente il pugno.")
	await novel_interface.show_text_only("Il quaderno, pieno di testi oscuri, apparteneva una volta al padre adottivo.")
	await novel_interface.show_text_only("Era un biologo alto, silenzioso e devoto, severo sia con Beth che con se stesso.")
	await novel_interface.show_text_only("A causa dell'abilità speciale di Beth, ha organizzato per lei corsi di formazione rigorosi oltre ai suoi compiti scolastici.")
	await novel_interface.show_text_only("Beth ricorda che ha dovuto lavorare duro ogni giorno per raggiungere gli obiettivi fissati da suo padre.")
	await novel_interface.show_text_only("Ciò che si aspettava di più era l'occasionale sorriso di riconoscimento sul suo volto serio.")
	await novel_interface.show_text_only("Senza molta tenerezza, l'uomo riservato l'aveva protetta a modo suo...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("—Come se la preparasse per un destino inevitabile...")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Nel giorno del suo dodicesimo compleanno, Beth ha ricevuto un pacco anonimo. Dentro c'era questo taccuino... e la notizia della morte di suo padre.")
	await novel_interface.show_text_only("Un'esplosione di gas ha ucciso più di 30 persone, incluso l'unico membro della famiglia di Beth rimasto al mondo.")
	novel_interface.show_character("baizhu_normal","puzzled")
	await novel_interface.show_dialog("…", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Con le labbra tremanti, Beth pronuncia un nome silenzioso.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gli indizi dietro questo nome le fecero capire che la morte di suo padre non era stata un incidente come riportato ufficialmente.")
	await novel_interface.show_text_only("La ragazza solitaria ha dovuto asciugarsi le lacrime e crescere in fretta per sopravvivere a pericoli sconosciuti.")
	await novel_interface.show_text_only("—Suo padre ha detto nel taccuino che la sua abilità speciale l'avrebbe esposta al pericolo e l'avrebbe resa il bersaglio della banda.")
	await novel_interface.show_text_only("Il pacco sarebbe stato spedito solo quando lui non avrebbe più potuto proteggerla...")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Perché le persone dovrebbero desiderare... questo tipo di abilità...)", "Beth")
	await novel_interface.show_dialog("(Non è più una maledizione...)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beth si guarda il palmo della mano. Diverse sfere di luci argentate rimbalzano sulle sue dita.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth sa di essere diversa fin da quando riesce a ricordare le cose, ma non a causa della sua abilità speciale.")
	await novel_interface.show_text_only("Ha una memoria eidetica per i numeri fin da bambina. Può fare calcoli mentali molto più velocemente degli altri ed è molto interessata ai macchinari.")
	await novel_interface.show_text_only("Ma suo padre le ha chiesto di mantenere un profilo basso e di comportarsi come una ragazzina normale in modo da nascondere la sua abilità speciale.")
	await novel_interface.show_text_only("Dopo la sua morte, Beth ha deciso di non nascondersi più.")
	await novel_interface.show_text_only("Un anno dopo, fu ammessa in una prestigiosa università con un permesso speciale, un'eccezione fatta per la prima volta dopo anni.")
	await novel_interface.show_text_only("Studiava molto e leggeva molto, ma non riusciva a trovare la risposta né nei libri né nelle lezioni.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(Perché sono diverso…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continuò a imparare e a pensare, come se cercasse di soddisfare tutta in una volta la sua curiosità a lungo repressa.")
	await novel_interface.show_text_only("Non si rendeva conto di essere così etichettata come arrogante, indifferente e inavvicinabile.")
	await novel_interface.show_text_only("A poco a poco, la gente le voltò le spalle, ma a lei non importava.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Altrimenti non ti avrei incontrato…)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ha conosciuto Silvia in un incidente.")
	await novel_interface.show_text_only("A Beth bastarono pochi minuti per capire che Silvia era un'investigatrice travestita da studentessa. La sua missione era cercare Substance H illegali nel campus.")
	await novel_interface.show_text_only("Sapeva che il nome e le esperienze di Silvia potevano essere tutte false, ma era comunque attratta dalla sua personalità spensierata e allegra.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Lei è... diversa.)", "Beth")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Lei mi conosce meglio di chiunque altro...")
	novel_interface.character_light()
	await novel_interface.show_dialog("(Anche se è abituata a travestirsi davanti agli altri...)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi ha davvero aperto il suo cuore senza alcuna riserva.")
	await novel_interface.show_text_only("Ma nessuno dei due si aspettava che la loro amicizia avrebbe attirato l'attenzione dell'organizzazione dietro Milk.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sapendo che era la figlia adottiva del famoso biologo, il capo di Milk la invitò a unirsi alla missione in Antartide.")
	await novel_interface.show_dialog("(Avevo intenzione di rifiutare...)", "Beth")
	novel_interface.show_background("res://assets/images/bg/Baizhu/milkBase.png")
	await novel_interface.show_text_only("In una base sotterranea della Squadra.")
	await novel_interface.show_text_only("Ciò che le ha fatto cambiare idea e decidere di unirsi è stato un simbolo sulla guida della missione:")
	await novel_interface.show_text_only("Un simbolo che ha visto nel taccuino di suo padre.")
	await novel_interface.show_text_only("Un inquietante bulbo oculare nero che rappresenta un'organizzazione religiosa segreta.")
	await novel_interface.show_text_only("Suo padre ha registrato i suoi contatti con persone di quell'organizzazione. Avevano mostrato l'intenzione di mobilitare persone con abilità speciali e di creare un gruppo militante.")
	await novel_interface.show_text_only("Il piano è stato chiamato Progetto Ningen.")
	await novel_interface.show_text_only("Dopo che i documenti del suo orfanotrofio finirono nelle loro mani, Beth era in cima alla lista dei ricercati del Progetto Ningen.")
	await novel_interface.show_text_only("Di conseguenza, suo padre è diventato un bersaglio di questa pericolosa organizzazione.")
	novel_interface.show_character("baizhu_normal","stare")
	await novel_interface.show_dialog("(Ningen... l'Antartide.)", "Beth")
	await novel_interface.show_dialog("(La base della regina delle nevi nell'Antartico...) \\n(Prende il nome da una storia delle fiabe di Andersen.)", "Beth")
	await novel_interface.show_dialog("In danese si dice Snedronningen\\nO Snedron-Ningen", "Beth")
	await novel_interface.show_dialog("(Non è una coincidenza.)", "Beth")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Quindi il tuo capo e la banda stanno perseguendo la stessa cosa...", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Dall'espressione sulla tua faccia... questa banda sembra essere più dura delle altre sulla lista nera...", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth annuisce, ma non vuole parlare oltre.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("Mi dispiace. Mi sono unito a questa missione per motivi egoistici.", "Beth")
	await novel_interface.hide_character()
	novel_interface.show_character("milk_normal","sprite")
	await novel_interface.show_dialog("Beh, lo so.", "Milk")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Ma Boss vuole solo che tu porti avanti le ricerche di tuo padre sulla vita marina.", "Milk")
	await novel_interface.show_dialog("Quindi è una vittoria per tutti.", "Milk")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Per quanto riguarda i tuoi motivi egoistici... so che sei così affascinato da me che decidi di restare qui.", "Milk")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Oh, è troppa pressione per me!", "Milk")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("disse Milk e mandò un bacio a Bai Yan, cosa che fece sorridere Bai Zhu.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ciò che non nota è una fugace tristezza negli occhi limpidi della sua amica.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/BG_Submarine_centralControlRoom.png")
	await novel_interface.show_text_only("Si sente ancora in colpa quando pensa al momento in cui ha firmato i documenti.")
	novel_interface.show_character("baizhu_normal","sad")
	await novel_interface.show_dialog("(La stavo... usando.)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth si siede alla scrivania, tira fuori una penna e fissa il taccuino aperto.")
	await novel_interface.show_text_only("Quelli utili sono preziosi.")
	await novel_interface.show_text_only("—Annota il suo pensiero.")
	await novel_interface.show_text_only("Me lo hai detto tu... e sono sempre stato d'accordo con te...")
	await novel_interface.show_text_only("Usa gli altri o fatti usare senza scrupoli \\n\"Questa è una cosa che dai per scontata...\"")
	await novel_interface.show_text_only("Dipende solo da chi ha un valore più alto.")
	await novel_interface.show_text_only("Non c'è bisogno di spiegare. Concentrati solo sul tuo obiettivo.")
	await novel_interface.show_text_only("Solo una relazione così semplice può tenerti al sicuro dalla maggior parte delle persone.")
	await novel_interface.show_text_only("Beth fa una pausa.")
	await novel_interface.show_text_only("Ma mi hai anche detto che ci sono ancora...")
	await novel_interface.show_text_only("Qualcuno che vuole essere usato da te, qualunque cosa accada. \\n\"E qualcuno che non vuoi usare in nessuna circostanza.\"")
	await novel_interface.show_text_only("Pensando a questo, un debole sorriso si forma sulle sue labbra.")
	novel_interface.show_character("baizhu_normal","smile")
	await novel_interface.show_dialog("(Colpa? È un sentimento che deve essere scartato.)", "Beth")
	await novel_interface.show_dialog("(Allora è... affetto?)", "Beth")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beth chiude il suo diario.")
	await novel_interface.show_text_only("Ora ha trovato la sua risposta.")
	await novel_interface.show_text_only("Guarda fuori dalla finestra e scopre che il cielo blu scuro diventa più profondo, quasi fondendosi con il mare infinito.")
	await novel_interface.show_text_only("All'improvviso, un allarme di emergenza suona in tutta la nave.")
	await novel_interface.show_text_only("Attenzione, tutto l'equipaggio. La direttiva è cambiata. Presentati in sala riunioni tra dieci minuti.")
	await novel_interface.show_text_only("Ripeti. La direttiva è cambiata...")
	await novel_interface.show_text_only("Beth fa un respiro profondo, mette via il taccuino e corre fuori dalla stanza.")

	print("=== 深海恐惧篇第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
