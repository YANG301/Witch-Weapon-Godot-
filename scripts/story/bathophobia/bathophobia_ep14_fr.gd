# bathophobia_ep14.gd - 深海恐惧篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	bathophobia_ep14_script()

func play_script():
	pass

func bathophobia_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Baizhu/falling.png")
	await novel_interface.show_text_only("Une blancheur éclatante.")
	await novel_interface.show_text_only("Un contour flou est progressivement apparu devant mes yeux, et tout autour de moi semblait s'accélérer, comme s'il tombait à grande vitesse d'une altitude de 10 000 mètres.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Finalement, mes pieds touchent le sol, mais l’impact escompté n’est pas là. Seule la douleur dans mes oreilles me rappelle une forte augmentation de la pression atmosphérique.")
	await novel_interface.show_dialog("Aïe…", "Lian")
	await novel_interface.show_text_only("Je respire et réalise que j'ai quitté cet espace. Cela doit être le monde réel, parce que c'est tellement foutu...")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Coooooold !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout d’un coup, je suis fouetté par l’air glacial et j’ai de violentes crampes d’estomac.")
	await novel_interface.show_text_only("J’avais du mal à ouvrir mes yeux brûlants, comme si mes cils étaient tous gelés…")
	novel_interface.change_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Quand je retrouve enfin la vue, je trouve tout recouvert de neige. L’air froid ressemble à un couteau qui me transperce la trachée.")
	await novel_interface.show_text_only("Je respire l'air froid et je ne peux m'empêcher de tousser.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hoo, toux, toux !", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Cela fait combien de temps ? Il fait déjà nuit ? \\nOù sommes-nous…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dans le froid abrutissant, la température de mon corps chute rapidement et je commence à frissonner involontairement.")
	await novel_interface.show_text_only("À côté de moi, Heinrich a l’air excité. \\nAnnie et Rapha?l sont allongées sur la neige, épuisées.")
	novel_interface.show_character("ren_battle","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	await novel_interface.show_dialog("… Maître, avez-vous froid ?", "Henriette")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Heinrich me prend doucement la main.")
	novel_interface.character_light(0.35,"blush")
	await novel_interface.show_dialog("Hein… ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je sens la chaleur se propager du bout de ses doigts à tout mon corps, comme si j'étais assis près d'une cheminée.")
	await novel_interface.show_text_only("Surpris, je regarde cette fille qui en porte encore moins que moi. Lorsqu'elle lâche mes mains, je trouve des pierres dorées posées dans mes paumes.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Qu'est-ce que c'est… ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Vous vous sentirez mieux avec ce jade chaud.", "Henriette")
	novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Bien que les cristaux de jade ne soient pas chauds au toucher, ils peuvent rayonner de la chaleur sur tout le corps.")
	await novel_interface.show_text_only("Avec ces pierres, la friche glacée et enneigée se transforme en un lieu chaleureux et douillet.")
	await novel_interface.show_text_only("Je me demande si l’environnement n’est rien d’autre qu’une scène de studio.")
	novel_interface.show_character("ren_battle","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("heinrich_battle","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cool…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Juste quelques jouets. Je les ai fabriqués avec des outils alchimiques et une inscription de conversion d'énergie.", "Henriette")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Heinrich dit modestement, mais avec un air de satisfaction sur le visage.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Non, non, c'est génial !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est vraiment génial… La technologie permettant de créer de tels matériaux artificiels dotés de propriétés Substance H est encore aujourd'hui top secrète.")
	await novel_interface.show_text_only("J'ai pris le jade chaud et j'en ai fourré quelques morceaux entre les mains de Raphaël et d'Annie.")
	await novel_interface.show_text_only("Lorsque je touche leurs mains, je sens leur température corporelle augmenter rapidement.")
	await novel_interface.show_dialog("Toux… Toux…", "Raphael")
	await novel_interface.show_dialog("Euh… Euh…", "Annie")
	await novel_interface.show_text_only("Avec une quinte de toux, Annie et Rapha?l reprennent conscience.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Est-ce que ça va ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En les voyant hocher la tête en retour, je pousse un soupir de soulagement.")
	await novel_interface.show_text_only("Je commence à regarder autour de moi et me retrouve sur un sol graveleux gelé recouvert d'une fine couche de neige.")
	await novel_interface.show_text_only("Au-dessus de la blancheur plane un calme étrange, comme si le paysage n’était qu’une simulation informatique.")
	await novel_interface.show_text_only("À côté de moi, Heinrich murmure, plongé dans ses pensées.")
	novel_interface.show_character("heinrich_battle","worry")
	await novel_interface.show_dialog("Comment avons-nous pu nous échapper de cet espace…", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Non, ce n’était pas une évasion… Mais la Crevasse de la Causalité a dû se fissurer.", "Henriette")
	await novel_interface.show_dialog("Mais comment se fait-il ? Même Celui qui doit suivre la règle de causalité lorsqu'il transmet des personnes...", "Henriette")
	novel_interface.change_expression("perspire")
	await novel_interface.show_dialog("Serait-ce… elle…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heinrich se tourne involontairement vers Ren.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ouah, c'est de la vraie neige ? Il ne fait pas froid du tout.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("J'ai ramassé une boule de neige avec beaucoup d'intérêt, mais après les avoir regardées, j'ai décidé de jeter la boule de neige par terre...")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("(je dois avoir l'air complètement stupide…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une rafale de vent aigre souffle des cristaux de glace sur mon visage.")
	await novel_interface.show_text_only("Grâce à la topaze, je n'ai pas froid du tout.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Où diable sommes-nous…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me lève. En dessous de moi se trouve le champ de neige plat.")
	await novel_interface.show_text_only("Au loin, des montagnes coiffées de glaciers s'élèvent au bord du champ de neige.")
	await novel_interface.show_text_only("Le ciel aurait dû être rempli de l'obscurité de la nuit.")
	await novel_interface.show_text_only("Mais—")
	await novel_interface.show_text_only("Il est éclairé par une bande de lumière colorée qui s'étend vers l'horizon.")
	await novel_interface.show_text_only("Des rayons de lumières colorées sont clairement visibles sous les étoiles. Le ciel est illuminé d’une couleur verdâtre fluorescente rayée de violet et de rose.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Est-ce… une aurore ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Voir les photos sur Internet n’a rien de comparable avec la crainte de les voir en personne.")
	await novel_interface.show_text_only("Entre la nuit étoilée et le pur champ de neige flottent des rayons d'un éclat brillant.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sommes-nous dans… le cercle polaire arctique ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non… pas question ?!")
	await novel_interface.show_text_only("Heinrich lui choque la tête.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("(Ouf… Ça doit être une sorte d’images 3D…)", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("L'effet de cette simulation est plutôt bon, même la température et le toucher...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Nous sommes en Antarctique.", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Attendez, elle vient de dire Antarctique...)\\n(Celui avec les pingouins... ?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("… Hein ? Quoi??", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Antarctique ?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","normal")
	await novel_interface.show_dialog("La zone correspondant à la neuvième Séphirot.", "Henriette")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Vous en avez déjà parlé, l'Arbre de Vie, Sephiroth, bla bla bla, que diable…", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La légende raconte que Dieu a utilisé l'Arbre de Vie comme modèle pour l'univers. C'est comme une carte structurelle du monde.", "Henriette")
	await novel_interface.show_dialog("Quant aux Sephirot… ce sont les dix piliers qui soutiennent l'Arbre de Vie.", "Henriette")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Selon The One, au moins…", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("À en juger par l’expression de son visage, Heinrich n’adhère pas vraiment à la légende.")
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("La neuvième Séphirot correspond donc à… l’Antarctique. Est-ce la zone que nous devons garder cette fois-ci ?", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Mais contre quoi ? Scellés!?")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("D’après nos expériences précédentes, même des zones non traversées peuvent engendrer des catastrophes.", "Henriette")
	await novel_interface.show_dialog("Les conflits entre humains ne sont rien comparés au pouvoir de la nature.", "Henriette")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais… il semble que nous ne soyons pas tombés au bon endroit.", "Henriette")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_move_right(0)
	novel_interface.change_expression("smile")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("En d’autres termes, nous sommes libres pour l’instant.", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Heinrich me sourit, les yeux pétillants.")
	novel_interface.character_light()
	await novel_interface.show_dialog("C'est la première fois que je profite de la liberté depuis des centaines d'années, même cet endroit est désolé, et même ce n'est que pour un moment…", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Hahaha… The One doit être très énervé en ce moment !", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Et… c'est à toi que revient le mérite, Ren !", "Henriette")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La main sur le cœur, elle me salue.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Quoi, moi ? Ai-je fait quelque chose ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("(Toujours aucune idée de ses propres capacités… Intéressant.)", "Henriette")
	await novel_interface.show_dialog("Transcender les règles établies par The One—", "Henriette")
	await novel_interface.show_dialog("Vous devez avoir inscrit la vérité dans votre âme, Maître.", "Henriette")
	await novel_interface.show_dialog("C'est le niveau auquel j'aspirais au cours de ma vie.", "Henriette")
	await novel_interface.show_dialog("Quel est le prix pour atteindre ce niveau ?", "Henriette")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Je ne comprends pas cette histoire de niveau…", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Mais le prix est énorme !")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Le vent devient violent, allons-nous trouver un endroit où nous cacher ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","upset")
	await novel_interface.show_dialog("Allez tout droit… Il y a un dépôt…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie parle d'une voix faible.")
	await novel_interface.show_text_only("Elle se relève péniblement, la main pointée vers l'avant.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Depot1.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Il y a une architecture circulaire. Il n'est en aucun cas grand, mais dispose d'un vide sanitaire de plus de 30 pieds de haut pour se protéger des tempêtes de neige.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Verre à double vitrage résistant au froid avec une grande ossature métallique…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Utiliser un style minimaliste si peu pratique dans la région polaire… Ce doit être ces gars nordiques.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le fil d'acier qui maintient l'escalier est cassé et les marches sont toutes tombées au sol, ne laissant que deux rampes suspendues.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Excusez-moi… quelqu'un ici ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Sois sage, idiot ! Personne ne serait assez idiot pour rester dans une maison de verre à telle dissipation thermique pendant la nuit polaire !", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je réalise que la nuit dans le cercle antarctique dure six mois. Maintenant, je perds vraiment la notion du temps.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("—Skuld ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie a toujours l'air pâle. Elle parvient à peine à se tenir debout une fois que nous sommes entrés dans le dépôt.")
	await novel_interface.show_text_only("Je me précipite pour la rattraper alors qu'elle perd le contrôle de son corps et s'effondre au sol.")
	await novel_interface.show_dialog("Ouf…", "Annie")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Aucun moyen de communication au premier étage. Nous devons essayer de monter à l'étage.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","smile")
	await novel_interface.show_dialog("Monter à l'étage ?", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A ces mots, Heinrich s'approche des rampes.")
	novel_interface.show_character("heinrich_battle","bored")
	await novel_interface.show_dialog("(Marmonne) Hmm... c'est du matériel que je n'ai jamais vu auparavant...", "Henriette")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mais ce n'est pas difficile de le reconstruire…", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle ramasse le fil cassé et en sort un morceau de pierre ressemblant à une pierre précieuse.")
	await novel_interface.show_text_only("La fissure est tordue, allongée et reliée en douceur, comme si elle était ductile entre les mains de Heinrich.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("C'est donc de l'alchimie…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un air d'admiration apparaît sur le visage hautain de Rapha?l.")
	await novel_interface.show_text_only("Heinrich prend le fil, sa combinaison de combat commençant à clignoter de différentes couleurs.")
	await novel_interface.show_text_only("Elle tire ensuite sur le fil, qui est resserré à nouveau. Une douzaine de marches sont ramenées à leur place d'origine.")
	await novel_interface.show_text_only("Elle rattache le fil à la boucle au sol, comme s'il s'agissait simplement d'une pelote de laine douce.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Waouh… Merveilleux !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("heinrich_battle","mock")
	await novel_interface.show_dialog("Eh bien… Au moins, la propriété de renforcement de cette armure de combat est très utile pour les alchimistes.", "Henriette")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Après tout, nous devons parfois faire face à des problèmes… des problèmes qui dépassent l'imagination.", "Henriette")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En mettant Annie sur le canapé, nous montons tous les trois les escaliers…")

	print("=== 深海恐惧篇第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
