# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Ella se ríe, inclinándose hacia mí casualmente y finalmente dejando caer su cabeza sobre mi hombro.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Gracias, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Podríamos hacer que Aya te examine...\nElla es muy hábil, ¿sabes? Ella definitivamente encontrará una manera...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya de repente coloca su dedo índice izquierdo en mis labios y niega con la cabeza. Me calmo en un instante y ella se recuesta sobre mi hombro nuevamente.")
	await novel_interface.show_text_only("Nos sentamos allí juntos, simplemente observando los coloridos acontecimientos que suceden allí abajo. Se supone que las protestas son ruidosas, pero no podemos oír nada desde donde estamos. Es pacífico, relajante.")
	await novel_interface.show_text_only("¿Cómo debería describir a esta chica...?")
	await novel_interface.show_text_only("¿Un pionero? ¿Vanguardia? ¿Aventurero?")
	await novel_interface.show_text_only("Todos esos son términos que se me ocurrieron. Pero no parecen del todo correctos.")
	await novel_interface.show_text_only("Ya sea Sonya o nuestros antepasados... debieron haber sentido un miedo insuperable cuando abandonaron sus hogares familiares y se aventuraron hacia lo desconocido.")
	await novel_interface.show_text_only("Debieron estar aterrorizados, pero también emocionados, ansiosos...")
	await novel_interface.show_text_only("Observando atentamente su entorno, eligiendo el mejor camino, limpiando las zarzas que se interponían en el camino...")
	await novel_interface.show_text_only("Definitivamente estaban demasiado ocupados para pensar en el significado que tenían sus acciones para la raza humana y la historia.")
	await novel_interface.show_text_only("Esas personas ahí abajo, posando y tomándose selfies entre la multitud, son las que están tratando desesperadamente de demostrar su propia importancia, ¿no es así?")
	await novel_interface.show_text_only("Todos quieren verse diferentes. Sin embargo, sin darse cuenta, todos se unieron como uno solo para formar este enorme monstruo...")
	await novel_interface.show_text_only("De camino hacia aquí, escuchamos a un periodista entrevistar por radio a los presentes en la manifestación.")
	await novel_interface.show_text_only("El periodista eligió veintitrés peatones al azar. De todos ellos, sólo uno pudo señalar la ubicación estimada de Masada Ford en el mapa mundial.")
	await novel_interface.show_text_only("La mitad de ellos ni siquiera sabía exactamente contra qué protestaban.")
	await novel_interface.show_text_only("... Entonces, ¿es realmente tan importante el significado de su existencia?")
	await novel_interface.show_text_only("Mi teléfono vibrante me devuelve a la realidad. Mientras lo levanto, pongo el teléfono en transmisión para que Sonya también pueda escuchar.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("¿Marirú?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Oh, ustedes dos... se están portando mal, ¿eh?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("¿Aya?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Qué están haciendo ustedes en la Primera Avenida?\n¿Y tan alto? ¿Estás mirando a la gente pasar o algo así?", "Ai")
	await novel_interface.show_text_only("Aya suena sorprendentemente preocupada. Entonces es cuando noto un dron flotando en diagonal, frente a nosotros.")
	await novel_interface.show_dialog("No sé dónde se ha ido Mariru. De todos modos, estoy aquí para contarles los resultados que obtuvimos después de analizar la batería que Beatrice envió...", "Ai")
	await novel_interface.show_dialog("Iré directo al grano.", "Ai")
	await novel_interface.show_dialog("Se confirma que la batería tiene algo que ver con la Sustancia H. Y fue creada por un fabricante militar de Masada Ford.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Entonces... ¿un arma de Sustancia H?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cuando se fabricó ese líquido brillante y pegajoso, la Sustancia H definitivamente estuvo involucrada. Aún no podemos estar seguros de los ingredientes.", "Ai")
	await novel_interface.show_dialog("Básicamente, podemos verlo como una especie de pila de combustible. El líquido sellado en la caja de la batería se consume a medida que la batería libera energía.", "Ai")
	await novel_interface.show_dialog("Por alguna razón, tal vez para cumplir con la fecha límite de envío o algo así, volvieron a instalar el producto sin siquiera borrar el número de serie de fábrica de MMI.", "Ai")
	await novel_interface.show_dialog("Incluso el regulador de voltaje está colocado en el exterior, en la caja de la batería.", "Ai")
	await novel_interface.show_text_only("Aya suena confundida.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("¿Caja de batería...? ¿Regulador de voltaje?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, no sabes cómo se ve, ¿verdad? Déjame describirlo...", "Ai")
	await novel_interface.show_dialog("Un cilindro de metal, de casi siete centímetros de alto. Totalmente cubierto con una capa aislante, excepto en los electrodos de ambos lados. Es como una batería AA, pero más grande.", "Ai")
	await novel_interface.show_dialog("A su lado se encuentra un tablero estructurado mecánicamente. Ábrelo y verás dos contactos metálicos.", "Ai")
	await novel_interface.show_dialog("Si aplicamos un voltaje extremadamente bajo a los contactos, podemos controlar el nivel de electricidad liberada.", "Ai")
	await novel_interface.show_dialog("En el exterior, en la caja de la batería, hay un regulador de cuarenta microvoltios. Está en la posición perfecta para sostener la placa y restringir el voltaje aplicado a los contactos.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("¿Por qué suena como una batería alimentada por una batería...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Se utiliza como fuente de energía de respaldo para una linterna de energía luminosa o algo así?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Es porque estas baterías no fueron diseñadas para ser baterías...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya parece sombría.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Es como... la seguridad mecánica de las armas... y un dispositivo de ignición.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Intento calcular la energía contenida en dicha batería.", "Ai")
	await novel_interface.show_dialog("Según nos informó la compañía eléctrica, una batería como esta puede mantener en funcionamiento un dispositivo de microvigilancia de 6W durante unos veinte días.", "Ai")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("No parece gran cosa...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(¿Cómo se calcula la potencia? ¿Aprendimos eso en clase? Lo olvidé...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya suspira ante mi desesperanza en lo que respecta a la física.")
	await novel_interface.show_dialog("Una batería de 2,88 KW podría mantener tu teléfono móvil funcionando durante medio año.", "Ai")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("¡Guau! ¿Tanto tiempo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me he acostumbrado a usar Elluka para cargar mi teléfono y mi consola de juegos estos días. Annie me regaña mucho por eso.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Espera... ¿qué pasa si no hay regulador de voltaje?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("De hecho, por eso te llamé.", "Ai")
	await novel_interface.show_dialog("Descubrí que dentro del rango de entrada de 1 a 500 microvoltios, la potencia generada por la batería aumenta junto con la entrada. Pero cuando supera los 500, no pasa nada. Ninguna salida en absoluto.", "Ai")
	await novel_interface.show_dialog("Entonces subí el voltaje a 32V, y de repente esta luz blanca cegadora salió disparada de la batería...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Según captó nuestra cámara de alta velocidad, el líquido de la batería se consumió en menos de un milisegundo.", "Ai")
	await novel_interface.show_dialog("La explosión de poder casi incineró el techo de la sala de aislamiento. Hay marcas de quemaduras que se entrecruzan por toda la pared y el suelo.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente recuerdo que, cuando Igor nos atacó en el Sky Hotel, uno de sus lacayos usó un arma eléctrica...")
	await novel_interface.show_text_only("Después de una explosión de luz poderosa, también había marcas de quemaduras entrecruzadas que se ramificaban por toda la habitación.")
	await novel_interface.show_dialog("Aún así, el arma que golpeó a Annie en ese entonces no parecía ser tan poderosa. Y estaba programado para apuntar a una sola persona, o de lo contrario todos en la habitación estarían muertos.", "Ai")
	await novel_interface.show_dialog("Y 32 V es en realidad el voltaje de excitación mínimo para los encendedores de pulsos electrónicos utilizados por el ejército de defensa nacional de Masada Ford.", "Ai")
	await novel_interface.show_text_only("Aya hace una pausa.")
	await novel_interface.show_dialog("La energía generada por una batería de 2,88 KW es igual a la de 5,5 libras de TNT...", "Ai")
	await novel_interface.show_dialog("Aunque las baterías no pueden generar ondas de choque tan destructivas como el TNT, aún pueden ser fatales para todos los seres vivos en un radio de 33 pies.", "Ai")
	await novel_interface.show_dialog("Y ahora mismo, tenemos una de esas cosas en cada farola de la Zona Desmilitarizada Acordada...", "Ai")
	await novel_interface.show_text_only("Jadeo, mirando las gigantescas hordas que hay allí abajo.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Maldita sea... Igor... ¿cómo pudo...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("¡Espera!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonia interviene.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Si es así, seguramente Masada Ford no querría que esas baterías explotaran, ¿verdad?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Eso es cierto.", "Ai")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Las baterías se fabricaron con prisas, los números de serie aún son visibles. Y se agregó un regulador de voltaje simple como una especie de solución rápida...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Parece que estaban desesperados por cumplir con la enorme cantidad de pedidos realizados por el Congreso Unido.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Si las baterías explotan, las autoridades podrían saber quién las fabricó a partir de los números de serie. Sería una medida estúpida por parte de Masada.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Además, se trata de un proyecto de renovación de la ciudad a gran escala. Innumerables personas estarían involucradas en la logística, implementación y mantenimiento. Sería imposible mantener en secreto un secreto tan mortal.", "Ai")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Eso es verdad...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Lo realmente sospechoso son los pacientes que mencionó Beatrice.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru ya había alertado al centro de control de enfermedades para que publicara una advertencia de contaminación de clase cuatro. Actualmente, los veinte casos se encuentran concentrados en la Zona Desmilitarizada Acordada.", "Ai")
	await novel_interface.show_dialog("Sin embargo, estas baterías no tienen ningún efecto sobre el estado mental de las personas. Y los resultados de la detección de memes muestran que tampoco contienen fuentes de infección de tipo meme...", "Ai")
	await novel_interface.show_text_only("Miro hacia abajo, sin palabras. Tantas preguntas, pero ninguna respuesta.")
	await novel_interface.show_text_only("Miro a la multitud allí abajo. Hay una farola cada doce metros...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Espera. ¿Qué nos pareció extraño a Sonya y a mí cuando estábamos allí?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Que las “fronteras” de las multitudes que se reúnen están demasiado definidas...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Mmmm?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Qué quieres decir...?", "Ai")
	await novel_interface.show_text_only("Quizás la respuesta haya estado frente a nosotros todo el tiempo. Simplemente no lo vimos porque había demasiadas distracciones en la calle...")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("¿No dijo Mariru que TODOS los sistemas de iluminación y vigilancia de las farolas de la ciudad habían sido reemplazados por el Congreso Unido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sí.", "Ai")
	await novel_interface.show_dialog("En ese caso, ¿por qué las farolas vienen en dos colores?", "Lian")
	await novel_interface.show_text_only("En la Primera Avenida, las farolas brillan en un amarillo cálido, iluminando los límites claros de la multitud.")
	await novel_interface.show_text_only("Mientras tanto, en las callejuelas desiertas, las farolas brillan de blanco.")
	await novel_interface.show_text_only("Desde el otro extremo del receptor llega el sonido de una escritura furiosa.")
	await novel_interface.show_dialog("Acabo de comprobarlo. Las nuevas bombillas que agregaron deberían ser luces LED sostenibles con una temperatura de color de 4500 K, por lo que se supone que deben verse blancas. No estoy seguro de qué pasa con los amarillos...", "Ai")
	await novel_interface.show_text_only("Sonya y yo intercambiamos miradas, en un intento de recordar todas las luces que vimos en las últimas horas.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Las imágenes de la línea de defensa frente al Congreso Unido que acabamos de ver eran amarillentas. Es probable que la zona esté iluminada por una gran cantidad de lámparas amarillas.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Las farolas de Electronics Street también eran amarillas, creo...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("La calle era caótica, llena de deslumbrantes carteles de neón y vallas publicitarias iluminadas. Nadie notaría las lámparas amarillas.")
	await novel_interface.show_dialog("De hecho, el ambiente en Electronics Street estaba un poco apagado hoy... todos parecían anormalmente emocionados.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Por el contrario, las calles con iluminación blanca parecían estar en su mayoría desiertas.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("La calle afuera de la estación de policía de la que escapamos...", "Soya")
	await novel_interface.show_dialog("También...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("Esa calle tranquila a las afueras de Newell Central Park...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Podría ser...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Esa luz dorada...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Mmmm?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Desde detrás de la puerta...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("¿Fue...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya no se molesta en terminar la frase. Ella toma mi mano y corre hacia el ascensor.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
