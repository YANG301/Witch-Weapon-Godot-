	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Хм?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что ты имеешь в виду...?", "Ай")
	await novel_interface.show_text_only("Возможно, ответ все это время был прямо перед нами. Мы просто этого не видели, потому что на улице было слишком много отвлекающих факторов…")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Разве Мариру не говорила, что ВСЕ системы освещения и наблюдения на уличных фонарях в городе были заменены Объединённым Конгрессом?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ага.", "Ай")
	await novel_interface.show_dialog("Тогда почему уличные фонари бывают двух цветов?", "Лиан")
	await novel_interface.show_text_only("На Первой авеню уличные фонари светятся теплым желтым светом, освещая четкие границы толпы.")
