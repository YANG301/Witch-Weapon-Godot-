	await novel_interface.show_text_only("Подожди. Что нам с Соней показалось странным, когда мы были там?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Что «границы» сплачивающихся толп слишком определены…", "Лиан")
