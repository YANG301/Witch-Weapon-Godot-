# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Она смеется, небрежно наклоняясь ко мне и наконец позволяя своей голове упасть мне на плечо.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Спасибо, Рен.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Мы могли бы попросить Айю осмотреть тебя...\nОна очень опытная, понимаешь? Она обязательно найдет способ…", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня вдруг прикладывает указательный палец левой руки к моим губам и качает головой. Я мгновенно успокаиваюсь, и она снова откидывается мне на плечо.")
	await novel_interface.show_text_only("Мы сидим там вместе и просто наблюдаем за красочными происходящими там событиями. Протесты должны быть громкими, но мы ничего не слышим там, где находимся. Это мирное, успокаивающее.")
	await novel_interface.show_text_only("Как мне описать эту девушку...")
	await novel_interface.show_text_only("Первопроходец? Авангард? Авантюрист?")
	await novel_interface.show_text_only("Это все термины, которые пришли мне в голову. Но они кажутся не совсем правильными.")
	await novel_interface.show_text_only("Будь то Соня или наши предки... они, должно быть, испытывали непреодолимый страх, когда покидали привычные дома и отправлялись в неизведанное.")
	await novel_interface.show_text_only("Должно быть, они были напуганы, но в то же время взволнованы и нетерпеливы...")
	await novel_interface.show_text_only("Внимательно наблюдая за происходящим вокруг, выбирая лучший путь, расчищая ежевику, стоящую на пути...")
	await novel_interface.show_text_only("Они определенно были слишком заняты, чтобы думать о том, какое значение их действия имели для человечества и истории.")
	await novel_interface.show_text_only("Те люди там внизу, позирующие и делающие селфи в толпе, — это те, кто отчаянно пытается доказать свою значимость, не так ли?")
	await novel_interface.show_text_only("Все они хотят выглядеть по-другому. Однако, сами того не осознавая, они все объединились в одно целое, чтобы образовать этого огромного монстра...")
	await novel_interface.show_text_only("По дороге сюда мы услышали, как по радио репортер брал интервью у присутствующих на митинге.")
	await novel_interface.show_text_only("Репортер выбрал двадцать три случайных пешехода. Из них только один смог указать предполагаемое местоположение Масады Форда на карте мира.")
	await novel_interface.show_text_only("Половина из них даже не знала, против чего именно они протестуют.")
	await novel_interface.show_text_only("... Так действительно ли так важен смысл их существования?")
	await novel_interface.show_text_only("Вибрирующий телефон возвращает меня в реальность. Как беру трубку, ставлю телефон на трансляцию, чтобы Соня тоже слышала.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Мариру?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ох, вы двое... плохо себя ведете, да?", "Ай")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Ая?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что вы, ребята, делаете на Первой авеню?\nИ так высоко? Вы наблюдаете за людьми или что-то в этом роде?", "Ай")
	await novel_interface.show_text_only("Ая кажется удивительно обеспокоенным. Именно тогда я замечаю дрон, зависший по диагонали лицом к нам.")
	await novel_interface.show_dialog("Я не знаю, куда пропала Мариру. В любом случае, я здесь, чтобы рассказать вам о результатах, которые мы получили после анализа батареи, которую прислала Беатрис...", "Ай")
	await novel_interface.show_dialog("Я сразу перейду к делу.", "Ай")
	await novel_interface.show_dialog("Подтверждено, что аккумулятор имеет какое-то отношение к Substance H. И создан он военным производителем из Масады Форд.", "Ай")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Итак... оружие из вещества H?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("При изготовлении этой светящейся липкой жидкости определенно участвовало Вещество H. Мы пока не можем быть уверены в составе.", "Ай")
	await novel_interface.show_dialog("По сути, мы можем рассматривать эту штуку как своего рода топливный элемент. Жидкость, находящаяся в корпусе батареи, расходуется по мере того, как батарея высвобождает энергию.", "Ай")
	await novel_interface.show_dialog("По какой-то причине — может быть, чтобы уложиться в срок отгрузки или что-то в этом роде — они переустановили продукт, даже не скочив заводской серийный номер от MMI.", "Ай")
	await novel_interface.show_dialog("Даже регулятор напряжения крепится снаружи, на аккумуляторном ящике.", "Ай")
	await novel_interface.show_text_only("Айя звучит растерянно.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Батарейный ящик...? Регулятор напряжения?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ах, ты не знаешь, как это выглядит, да? Позвольте мне описать это...", "Ай")
	await novel_interface.show_dialog("Металлический цилиндр высотой почти три дюйма. Полностью покрыт изоляционным слоем, за исключением электродов с обеих сторон. Это как батарейка АА, только большего размера.", "Ай")
	await novel_interface.show_dialog("На его стороне находится доска с механической структурой. Нажмите на него, и вы увидите два металлических контакта.", "Ай")
	await novel_interface.show_dialog("Если подать на контакты чрезвычайно низкое напряжение, мы сможем контролировать уровень выделяемого электричества.", "Ай")
	await novel_interface.show_dialog("На аккумуляторном ящике снаружи находится регулятор на сорок микровольт. Он находится в идеальном положении, чтобы удерживать плату и ограничивать напряжение, подаваемое на контакты.", "Ай")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Почему это звучит как батарея, питаемая от батареи...?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Используется ли он как резервный источник питания для светового энергетического фонаря или чего-то еще?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Это потому, что эти батареи не были созданы для того, чтобы быть батареями...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня выглядит мрачной.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Это как... механическая безопасность оружия... и устройство зажигания.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Я пытаюсь посчитать энергию, содержащуюся в такой батарее.", "Ай")
	await novel_interface.show_dialog("Согласно сообщению электроэнергетической компании, такая батарея может обеспечить работу устройства микронаблюдения мощностью 6 Вт около двадцати дней.", "Ай")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Звучит не так уж и важно...", "Лиан")
