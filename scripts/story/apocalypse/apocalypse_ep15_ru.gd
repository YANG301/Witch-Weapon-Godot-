	await novel_interface.show_dialog("Возможно, это напоминание миру о том, что мы не должны позволять войнам уничтожать наши славные цивилизации...", "Эльгана")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N_Door.png")
	novel_interface.show_character("ren_fishnet","gratified")
