	await novel_interface.show_dialog("Резьба такая сложная!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я подхожу ближе и замечаю пять металлических гравюр квадратной формы по обе стороны от входа, каждая из которых рассказывает свою историю.")
