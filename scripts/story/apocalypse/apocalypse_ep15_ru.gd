	await novel_interface.hide_character()
	await novel_interface.show_text_only("Согласно тому, что я слышал от Мариру, именно покойный Папа даровал Соне титул Рыцаря Правосудия.")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Эй, Соня, ты не придешь?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка отстает, наблюдая, как мы входим в церковь, послушными оленьими глазами.")
