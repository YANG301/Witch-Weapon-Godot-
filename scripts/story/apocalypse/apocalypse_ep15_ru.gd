	await novel_interface.show_dialog("Я не приду...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она остается на месте. В теплом свете наружного освещения ее лицо кажется мирным и нежным. Такое выражение я видел только однажды на ее непослушном лице — и тогда я впервые увидел ее через двустороннее зеркало.")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("?", "Лиан")
