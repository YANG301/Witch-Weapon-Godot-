# apocalypse_ep05.gd - 天启篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第05话剧本
	apocalypse_ep05_script()

func play_script():
	pass

# 天启篇第05话 - 正式剧本
func apocalypse_ep05_script():
	# scene1 - 盲点序章
	novel_interface.show_background("res://assets/images/bg/Soya/Blindspot.png")
	await novel_interface.show_text_only("Un punto cieco è il punto in cui arterie, vene e nervi si incrociano sulla retina. In questa sezione non sono presenti cellule fotosensibili e quindi le stimolazioni visive non possono attivarla.")
	await novel_interface.show_text_only("Tuttavia, non possiamo dire dove sia il punto cieco quando guardiamo qualcosa, perché il cervello riempie automaticamente ciò che manca.")
	await novel_interface.show_text_only("È così che funziona il nostro cervello. Fa tutto il possibile per far sembrare ragionevole ogni situazione.")
	await novel_interface.show_text_only("Pertanto, molte persone credono che ciò che sembra loro naturale debba essere indiscutibilmente corretto.")
	await novel_interface.show_text_only("Ma lo è davvero?")
	await novel_interface.show_text_only("Nella storia, c’è stata una persona che non si è accorta di essere cieca fino all’età di sette anni.")
	await novel_interface.show_text_only("I nati senza udito penserebbero che il mondo tace se nessuno dicesse loro il contrario.")
	await novel_interface.show_text_only("Se un evento anomalo è in qualche modo diventato predefinito, lo accetteremo così com'è.")
	await novel_interface.show_text_only("E non conosceremo mai la verità finché un giorno non saremo costretti ad affrontare le contraddizioni davanti ai nostri occhi.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("In tal caso... è possibile che ci sia un difetto innato con cui tutti gli esseri umani nascono. Ma poiché è l’impostazione predefinita per tutti, nessuno lo mette mai in dubbio…")
	novel_interface.show_background("res://assets/images/bg/Soya/Doomsday1.png")
	await novel_interface.show_text_only("Finché, un giorno...")
	await novel_interface.show_text_only("Sono costretti ad affrontare le contraddizioni proprio davanti ai loro occhi...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	
	# scene2 - 美术馆继续
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Sto ancora cercando di venire a patti con la notizia che ha scosso il mondo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(È davvero grave, ovviamente, solo che non so cosa pensare...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche se New Opulentia sopravvivesse al primo round di attacchi nucleari, la popolazione dovrebbe comunque fare i conti con l’inquinamento nucleare, i problemi ambientali e la carestia. Tutto fatale.")
	await novel_interface.show_text_only("\"Un'apocalisse di classe XK non lascia sopravvissuti.\"")
	await novel_interface.show_text_only("Questa è una citazione che si sente spesso nelle notizie di questi giorni. Fu anche la base su cui il Congresso Unito riuscì a porre fine alla guerra e a mantenere la pace.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Un sistema di contrattacco nucleare indiscriminato non è davvero nulla di nuovo. Qualcuno aveva già progettato qualcosa del genere durante la Guerra Fredda.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wow, tanto tempo fa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("È solo che la gente raramente ne parla.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Sai perché?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non provo nemmeno a rispondere, so di essere senza speranza in storia. Quindi mi siedo semplicemente lì e sorrido educatamente mentre Raphilia mi lancia un'occhiataccia.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Il motivo era che i vertici di tutti i paesi avevano questo accordo silenzioso: non sarebbe stato il caso di annunciare pubblicamente l’esistenza di questo genere di cose.", "Raphael")
	await novel_interface.show_dialog("Questo è sempre stato un argomento tabù, non importa nei paesi con una censura severa o in quelli che sostengono la libertà di stampa.", "Raphael")
	await novel_interface.hide_character()
	
	# 背景切换
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Quando fu istituito il Congresso Unito e la guerra finì, l’opinione pubblica pensò che ciò riguardasse “il futuro dell’umanità e della civiltà”.")
	await novel_interface.show_text_only("Per quanto riguarda la sostanza H di classe XK, nessuno ne parla mai, anche se è stata quella che ha effettivamente posto fine alla guerra.")
	await novel_interface.show_text_only("Per ispirare fiducia nel grande pubblico, il Consiglio ha lanciato un progetto chiamato “Nuova porta girevole” nella trasmissione sulla fine della guerra.")
	await novel_interface.show_text_only("Un progetto in cui i sei paesi membri avevano deciso all'unanimità di chiamare le loro capitali “Città Accademia”.")
	
	novel_interface.change_background("res://assets/images/bg/Soya/Guidepost.png")
	await novel_interface.show_text_only("Il movimento ha influenzato molte cose. I governi furono riformati, furono emessi nuova valuta e nuovi debiti nazionali, gli aeroporti e i monumenti furono rinominati e la segnaletica stradale dovette essere sostituita su larga scala.")
	await novel_interface.show_text_only("Tecnicamente si è trattato di un semplice cambio di nome. Ma il sistema creditizio in ciascuno di questi paesi si riprese miracolosamente dalla guerra nel giro di un paio di mesi.")
	await novel_interface.show_text_only("Anche le società quotate in borsa iniziarono a richiedere un cambio di nome: finché il nome della società avesse qualcosa a che fare con \"Città Accademia\", le azioni sarebbero aumentate vertiginosamente.")
	novel_interface.change_background("res://assets/images/bg/Soya/galleries.png")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Perché il termine “Città Accademia” rappresentava un futuro luminoso e felice...", "Raphael")
	await novel_interface.show_dialog("E tutti gli esseri umani hanno bisogno di qualcosa in cui potersi fidare, qualcosa che rappresenti le loro speranze e i loro sogni.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("È come i ragazzi e le loro... “bacchette”, giusto?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Ehm?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia alza una mano, sembrando molto pronta a fare a pezzi Sonya.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("In effetti, questo annuncio pubblico deve essere stato pianificato già da un bel po’.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Di solito qualcosa del genere verrebbe semplicemente annunciato in una riunione a porte chiuse tra i pezzi grossi.")
	await novel_interface.show_text_only("Le nazioni più piccole non partecipanti e persino i terroristi sarebbero comunque in grado di ottenere informazioni come queste.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("E proprio adesso, tutti i funzionari dei sei paesi che hanno abbastanza potere per vietare ai media di diffondere la notizia stanno tenendo una riunione a porte chiuse.", "Raphael")
	await novel_interface.show_dialog("I canali mediatici di tutto il mondo, naturalmente, vorrebbero sfruttare al massimo questa notizia scioccante per ottenere il maggior numero di follower e traffico.", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Diffonderanno panico e caos in tutto il mondo, senza freni...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia lancia un'occhiata alla folla fuori, con le sopracciglia aggrottate.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Questo posto... di solito è così affollato?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Questa è una strada fortemente orientata verso un certo gruppo di nicchia di clienti e non ha nulla a che fare con la politica, ma è vero che è davvero più affollata del normale.")
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Beh, non credo che ci sia nulla di cui preoccuparsi.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya guarda fuori dalla parete di vetro dell'atrio del secondo piano dove ci troviamo attualmente e conferma.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Le aure di queste persone sembrano carine. Non sono in colori arrabbiati. Alcuni hanno un odore di fumo e di ansia, ma ciò può facilmente essere dovuto al fatto che sono circondati da troppe persone.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Quindi è questo il significato della “sinestesia” nel tuo profilo?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Immagino di sì.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("E allora dicci: come sono le nostre aure?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia si avvicina, curiosa.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hm... Sei un po' contraddittorio.", "Soya")
	await novel_interface.show_dialog("Hai l'odore di una strada di campagna dopo la pioggia e ti senti... caldo. Anche quando provi emozioni negative, la pioggia le lava via tutte all’istante.", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","perspire1",0.25)
	await novel_interface.show_dialog("(... Allora è per questo che Sonya non è riuscita a schivare quando Raphilia l'ha colpita? Perché non sentiva più l'odore della sua furia?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya inclina la testa di lato, sembrando confusa.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Di solito, le persone che hanno questo odore sono gentili e rassicuranti, ma tu sei violento e irritabile e...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se fossi quello con la sinestesia, scommetto che vedrei fiamme infuriate sopra la testa di Raphilia proprio in questo momento.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Uh, voglio dire, gli odori non mentono, quindi devi essere dolce, indulgente, gentile, benevolo e non violento, giusto?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tenta rapidamente di correggere e cambia argomento.")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Ehm, comunque, Ren... ha il colore più puro che abbia mai visto!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Respirare?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ah?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia alza un sopracciglio, la curiosità la spinge a mettere da parte la rabbia.")#文字错误
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Ad esempio, quando stavamo mangiando semifreddi nel negozio di dolci, ad ogni boccone che mangiava, potevo sentirla strillare \"Eeeee! Buonissimo!\" dal profondo del suo cuore.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Oh, davvero?\n(È così imbarazzante!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Non prende il boccone successivo finché non finisce di strillare. È davvero interessante da guardare.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ah, davvero un idiota.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Per quanto riguarda Elluka, è come un criceto. Mangia e mangia e basta.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Ehehe!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka ridacchia, come se Sonya la stesse lodando.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Quando Ren vede una ragazza carina per strada, inizia a brillare di rosa. Fa del suo meglio per non fissarla, ma i suoi occhi la tradiscono sempre...", "Soya")
	await novel_interface.show_dialog("A volte finge di guardare lontano dietro la ragazza e poi gira la testa in un'altra direzione nella speranza di sembrare meno un mostro.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Lo sapevo, è totalmente materiale da stalker.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia mi lancia un'occhiataccia.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Oh, andiamo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pensavo di aver fatto bene a nascondere il mio sguardo... doveva osservarmi così attentamente?")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Quando Ren vede dei bei vestiti, la sua aura sfoggia due colori diversi e contrastanti. Di solito, però, vince la parte rosa.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ah?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia mi lancia un'occhiata e alla fine il suo sguardo si posa sulle mie gambe.")
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("(Sono innocente! Non so davvero niente!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("A proposito, se attenua la sua aura come se volesse semplicemente scomparire, significa che deve aggiustare la spallina del reggiseno o le calze a rete.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","hungry")
	await novel_interface.show_dialog("Ah, bella osservazione!", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Esatto!", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka e Sonya sembrano divertirsi come non mai, il che rende Sonya ancora più felice di dire loro di più.")#文字错误
	await novel_interface.show_text_only("Questo è tutto. Non posso restare qui ad ascoltare queste calunnie...")
	await novel_interface.show_text_only("Trattengo il respiro, indietreggio—")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ah, giusto, quando Ren vuole andare in bagno, lei...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che Sonya possa finire la frase, la spia sulla sua cavigliera inizia a lampeggiare.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Eh?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si sente un clic, poi un grazioso arco azzurro lampeggia oltre la finestra dell'atrio della galleria d'arte.")
	await novel_interface.show_text_only("La ragazza dai capelli argentati crolla a terra, un soffio di fumo bianco si alza dal suo corpo.")
	await novel_interface.show_text_only("Elluka si inginocchia accanto a lei e colpisce la sua forma immobile, con il viso innocente. Raphilia dovrebbe essere immediatamente in grado di dire che non è stata Elluka.")
	await novel_interface.show_text_only("Quando finalmente la ragazza bionda si ricorda che esisto, ho già raggiunto le scale.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Mi spiace, questo è l'unico modo in cui posso farla stare zitta!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bam!")
	await novel_interface.show_text_only("Nella fretta di scappare, mi schianto contro qualcuno.")
	await novel_interface.show_text_only("Invece di cadere, quel “qualcuno” mi aiuta dolcemente ad alzarmi, sostenendo il mio peso con i suoi... beni.")
	novel_interface.show_character("ren_fishnet","timid")
	await novel_interface.show_dialog("(Sono... così elastici!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Attento, piccolo.", "Donna dai capelli neri")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La signora dai capelli corvini mi rivolge un rimprovero, poi sbadiglia.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Uh, sc-scusa...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tiene in mano una katana giapponese con un'impugnatura intricata e una lama dal design artistico.")#文字错误
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Tu sei Ren, vero?", "Donna dai capelli neri")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Che faccino adorabile!", "Donna dai capelli neri")
	await novel_interface.hide_character()

	print("=== 天启篇第05话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
