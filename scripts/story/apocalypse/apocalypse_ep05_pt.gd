# apocalypse_ep05.gd - 天启篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第05话剧本
	apocalypse_ep05_script()

func play_script():
	pass

# 天启篇第05话 - 正式剧本
func apocalypse_ep05_script():
	# scene1 - 盲点序章
	novel_interface.show_background("res://assets/images/bg/Soya/Blindspot.png")
	await novel_interface.show_text_only("Um ponto cego é o local onde artérias, veias e nervos se cruzam na retina. Não há células sensíveis à luz nesta seção e, portanto, os estímulos visuais não podem acioná-la.")
	await novel_interface.show_text_only("No entanto, não podemos dizer onde está o ponto cego quando olhamos para alguma coisa, porque o cérebro preenche automaticamente o que está faltando.")
	await novel_interface.show_text_only("É assim que nosso cérebro funciona. Faz tudo o que pode para fazer com que cada situação pareça razoável.")
	await novel_interface.show_text_only("Portanto, muitas pessoas acreditam que o que lhes parece natural deve ser indiscutivelmente correto.")
	await novel_interface.show_text_only("Mas é mesmo?")
	await novel_interface.show_text_only("Na história, houve uma pessoa que só percebeu que era cega aos sete anos.")
	await novel_interface.show_text_only("Aqueles que nasceram sem audição pensariam que o mundo estava em silêncio se ninguém lhes dissesse o contrário.")
	await novel_interface.show_text_only("Se uma ocorrência anormal se tornar de alguma forma o padrão, nós a aceitaremos como ela é.")
	await novel_interface.show_text_only("E nunca aprenderemos a verdade até que um dia sejamos forçados a enfrentar as contradições diante dos nossos olhos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Nesse caso... é possível que exista uma falha inata com a qual todos os humanos nascem. Mas como é o padrão para todos, ninguém questiona isso...")
	novel_interface.show_background("res://assets/images/bg/Soya/Doomsday1.png")
	await novel_interface.show_text_only("Até que, um dia...")
	await novel_interface.show_text_only("Eles são forçados a enfrentar as contradições bem diante de seus olhos...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	
	# scene2 - 美术馆继续
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Ainda estou tentando aceitar as notícias que abalaram o mundo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(É muito sério, claro, só não sei o que pensar...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mesmo que a Nova Opulência sobreviva à primeira ronda de ataques nucleares, o povo ainda teria de lidar com a poluição nuclear, as questões ambientais e a fome. Tudo fatal.")
	await novel_interface.show_text_only("“Um apocalipse da classe XK não deixa sobreviventes.”")
	await novel_interface.show_text_only("Esta é uma frase frequentemente ouvida nos noticiários hoje em dia. Foi também a base sobre a qual o Congresso Unido conseguiu pôr fim à guerra e manter a paz.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Um sistema de contra-ataque nuclear indiscriminado não é nada de novo. Alguém já projetou algo assim durante a Guerra Fria.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Uau, há muito tempo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Acontece que as pessoas raramente mencionam isso.", "Rafael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Você sabe por quê?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nem tento responder, sei que sou um fracasso na história. Então eu simplesmente sento lá e sorrio educadamente enquanto Raphilia olha para mim.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("A razão foi que os altos escalões de todos os países tinham este acordo silencioso: não seria adequado anunciar publicamente a existência deste tipo de coisa.", "Rafael")
	await novel_interface.show_dialog("Este sempre foi um tema tabu, não importa em países com censura estrita ou naqueles que defendem a liberdade de imprensa.", "Rafael")
	await novel_interface.hide_character()
	
	# 背景切换
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Quando o Congresso Unido foi estabelecido e a guerra terminou, o público pensava que era para “o futuro da humanidade e da civilização”.")
	await novel_interface.show_text_only("Quanto à Substância H da classe XK, ninguém nunca fala sobre isso, embora tenha sido o que realmente encerrou a guerra.")
	await novel_interface.show_text_only("Para inspirar confiança no público em geral, o Conselho lançou um projecto denominado “Nova Porta Giratória” na transmissão do fim da guerra.")
	await novel_interface.show_text_only("Um projeto em que os seis países membros concordaram por unanimidade em nomear as suas capitais como “Cidades Academia”.")
	
	novel_interface.change_background("res://assets/images/bg/Soya/Guidepost.png")
	await novel_interface.show_text_only("O movimento afetou muitas coisas. Os governos foram reformados, novas moedas e novas dívidas nacionais foram emitidas, aeroportos e pontos de referência foram renomeados e os sinais de trânsito tiveram de ser substituídos em larga escala.")
	await novel_interface.show_text_only("Tecnicamente, foi apenas uma simples mudança de nomes. Mas o sistema de crédito em cada um destes países ainda recuperou milagrosamente da guerra dentro de alguns meses.")
	await novel_interface.show_text_only("Até as empresas cotadas começaram a solicitar mudanças de nome – desde que o nome da empresa tivesse algo a ver com “Cidade Academia”, as ações disparariam imediatamente.")
	novel_interface.change_background("res://assets/images/bg/Soya/galleries.png")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Porque o termo “Cidade Acadêmica” representava um futuro brilhante e feliz—", "Rafael")
	await novel_interface.show_dialog("E todos os humanos precisam de algo em que possam confiar, algo que represente as suas esperanças e sonhos.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("É como os caras e suas... “varinhas”, certo?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Hum?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia levanta a mão, parecendo pronta para despedaçar Sonya.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Na verdade, este anúncio público deve estar sendo planejado há algum tempo.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Normalmente, algo assim seria simplesmente anunciado em uma reunião fechada entre altos executivos.")
	await novel_interface.show_text_only("As nações não participantes mais pequenas e até mesmo os terroristas seriam capazes de obter informações como esta de qualquer maneira.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("E neste momento, todos os responsáveis dos seis países com poder suficiente para proibir a comunicação social de divulgar a notícia estão a realizar uma reunião à porta fechada.", "Rafael")
	await novel_interface.show_dialog("Os canais de mídia em todo o mundo, naturalmente, gostariam de aproveitar ao máximo essas notícias chocantes para obter o máximo de seguidores e tráfego.", "Rafael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Eles estarão espalhando pânico e caos por todo o mundo, desenfreadamente...", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia olha para a multidão lá fora, com as sobrancelhas franzidas.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Este lugar... costuma estar lotado?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Esta é uma rua fortemente voltada para um determinado nicho de clientes e não tem nada a ver com política – mas é verdade que está mais lotada do que o normal.")
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Bem, não acho que haja nada com que se preocupar.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya olha pela parede de vidro do saguão do segundo andar, onde estamos atualmente, e confirma.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("As auras dessas pessoas são lindas. Eles não estão com cores raivosas. Alguns cheiram a fumaça e a ansiedade, mas isso pode ser facilmente porque estão cercados por muitas pessoas.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Então é isso que significa “sinestesia” no seu perfil?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Acho que sim.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Pois bem, diga-nos então: como são as nossas auras?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia se aproxima, curiosa.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hm... Você é um pouco contraditório.", "Soya")
	await novel_interface.show_dialog("Você cheira como uma estrada rural depois da chuva e se sente... quente. Mesmo quando você tem emoções negativas, a chuva leva tudo embora instantaneamente.", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","perspire1",0.25)
	await novel_interface.show_dialog("(... Então é por isso que Sonya não conseguiu se esquivar quando Raphilia bateu nela? Porque ela não sentiu mais o cheiro de sua fúria?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya inclina a cabeça para o lado, parecendo confusa.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Normalmente, as pessoas que cheiram assim são gentis e calmantes, mas você é violento e irritadiço e...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se eu tivesse sinestesia, aposto que veria chamas violentas acima da cabeça de Raphilia neste exato momento.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Uh, quero dizer, os cheiros não mentem, então você deve ser doce, misericordioso, gentil, benevolente e não violento, certo?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya rapidamente tenta se corrigir e muda de assunto.")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Ahem, de qualquer forma, Ren... ela tem a cor mais pura que eu já vi!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Respire?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ah?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia levanta uma sobrancelha, a curiosidade a leva a deixar sua raiva de lado.")#文字错误
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Por exemplo, quando estávamos comendo parfaits na loja de sobremesas, a cada mordida que ela dava, eu podia ouvi-la gritar “Eeeee! Que delícia!” do fundo de seu coração.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Ah, sério?\n(Isso é tão embaraçoso!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ela não dá a próxima mordida até terminar de gritar. É muito interessante assistir.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ha, um idiota mesmo.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Quanto a Elluka, ela é como um hamster. Ela apenas come e come.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Ehehe!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka ri, como se Sonya a estivesse elogiando.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Quando Ren vê uma linda garota na rua, ela começa a brilhar em rosa. Ela faz o possível para não olhar, mas seus olhos sempre a traem...", "Soya")
	await novel_interface.show_dialog("Ela às vezes finge olhar para longe atrás da garota e depois vira a cabeça em outra direção na esperança de parecer menos uma canalha.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Eu sabia, ela é totalmente perseguidora.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia me lança um olhar.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Ah, vamos lá...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Achei que estava fazendo um bom trabalho escondendo meu olhar... ela tinha que me observar com tanto cuidado?")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Quando Ren vê roupas bonitas, sua aura exibe duas cores diferentes e contrastantes. Normalmente, o lado rosa vence.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ah?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia me dá uma olhada, seu olhar eventualmente pousando em minhas pernas.")
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("(Sou inocente! Realmente não sei de nada!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("A propósito, se ela suavizar sua aura como se quisesse simplesmente desaparecer, isso significa que ela precisa ajustar a alça do sutiã ou as meias arrastão.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","hungry")
	await novel_interface.show_dialog("Ah, boa observação!", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Isso mesmo!", "Rafael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka e Sonya parecem estar se divertindo muito, o que deixa Sonya ainda mais feliz em contar mais a elas.")#文字错误
	await novel_interface.show_text_only("É isso. Não posso ficar aqui ouvindo essa calúnia...")
	await novel_interface.show_text_only("Prendo a respiração, recuo...")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ah, certo, quando Ren quer ir ao banheiro, ela—", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que Sonya possa terminar a frase, a luz indicadora em sua tornozeleira começa a piscar.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Hein?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ouve-se um clique e, em seguida, um gracioso arco azul-claro passa pela janela do lobby da galeria de arte.")
	await novel_interface.show_text_only("A garota de cabelos grisalhos cai no chão, uma lufada de fumaça branca subindo de seu corpo.")
	await novel_interface.show_text_only("Elluka se ajoelha ao lado dela e cutuca sua forma imóvel, com cara de inocente. Raphilia deveria ser capaz de dizer imediatamente que Elluka não fez isso.")
	await novel_interface.show_text_only("Quando a loira finalmente se lembra que eu existo, já cheguei à escada.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Desculpe, esta é a única maneira de calá-la!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bam!")
	await novel_interface.show_text_only("Na pressa de fugir, bato direto em alguém.")
	await novel_interface.show_text_only("Em vez de ser derrubado, esse “alguém” gentilmente me ajuda a levantar, sustentando meu peso com seus... bens.")
	novel_interface.show_character("ren_fishnet","timid")
	await novel_interface.show_dialog("(Eles são... tão elásticos!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Cuidado, pequenino.", "Mulher de cabelos pretos")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A senhora de cabelos negros faz uma careta para mim e depois boceja.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Uh, desculpe...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela está segurando uma katana japonesa com cabo complexo e lâmina artisticamente desenhada.")#文字错误
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Você é Ren, não é?", "Mulher de cabelos pretos")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Que rostinho adorável!", "Mulher de cabelos pretos")
	await novel_interface.hide_character()

	print("=== 天启篇第05话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
