	await novel_interface.show_text_only("Aya thở dài trước sự vô vọng của tôi khi nói đến vật lý.")
	await novel_interface.show_dialog("Pin 2,88 KW có thể giúp điện thoại của bạn hoạt động được nửa năm.", "Ai")
