	await novel_interface.hide_character()
	await novel_interface.show_dialog("Có vẻ như họ đang tuyệt vọng để đáp ứng số lượng lớn các đơn đặt hàng do Quốc hội Thống nhất đặt ra.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Nếu pin phát nổ, chính quyền sẽ có thể biết ai đã tạo ra chúng từ số sê-ri. Đó sẽ là một bước đi ngu ngốc của Masada.", "Soya")
