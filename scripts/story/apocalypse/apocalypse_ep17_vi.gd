	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Điều đó đúng...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Điều thực sự đáng ngờ là những bệnh nhân mà Beatrice đề cập.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru đã thông báo cho trung tâm kiểm soát dịch bệnh để đăng cảnh báo ô nhiễm cấp độ bốn. Hiện tại, tất cả 20 trường hợp đều tập trung tại Khu phi quân sự đã thỏa thuận.", "Ai")
	await novel_interface.show_dialog("Tuy nhiên, những loại pin này không có bất kỳ ảnh hưởng nào đến trạng thái tinh thần của con người. Và kết quả phát hiện meme cho thấy chúng cũng không chứa nguồn lây nhiễm loại meme...", "Ai")
	await novel_interface.show_text_only("Tôi nhìn xuống, không nói nên lời. Rất nhiều câu hỏi, nhưng không có câu trả lời.")
