	await novel_interface.show_text_only("Sonya trông có vẻ buồn bã.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Nó giống như... độ an toàn cơ học của vũ khí... và thiết bị đánh lửa.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tôi cố gắng tính toán năng lượng chứa trong một cục pin như vậy.", "Ai")
