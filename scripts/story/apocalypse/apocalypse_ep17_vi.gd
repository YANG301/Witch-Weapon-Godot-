	await novel_interface.show_dialog("Ôi! Dài thế à?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gần đây tôi đã quen với việc sử dụng Elluka để sạc điện thoại và máy chơi game của mình. Annie mắng tôi rất nhiều vì điều đó.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Đợi đã... chuyện gì sẽ xảy ra nếu không có bộ điều chỉnh điện áp?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đó thực sự là lý do tại sao tôi gọi cho bạn.", "Ai")
	await novel_interface.show_dialog("Tôi phát hiện ra rằng trong phạm vi đầu vào từ 1 đến 500 micro-volt, công suất tạo ra của pin sẽ tăng cùng với đầu vào. Nhưng khi nó vượt quá 500 thì không có gì xảy ra. Không có đầu ra nào cả.", "Ai")
	await novel_interface.show_dialog("Vì vậy, tôi tăng điện áp lên 32V, và đột nhiên ánh sáng trắng chói mắt này bắn ra từ pin...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Theo những gì camera tốc độ cao của chúng tôi ghi lại được, chất lỏng trong pin đã bị tiêu hao trong vòng chưa đầy một phần nghìn giây.", "Ai")
	await novel_interface.show_dialog("Vụ nổ sức mạnh gần như thiêu rụi trần phòng cách ly. Có những vết cháy lan khắp tường và mặt đất.", "Ai")
