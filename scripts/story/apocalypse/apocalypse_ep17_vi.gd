# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Cô ấy cười, thản nhiên nghiêng người về phía tôi, cuối cùng tựa đầu vào vai tôi.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Cảm ơn, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Chúng tôi có thể nhờ Aya kiểm tra cậu...\nCô ấy thực sự có tay nghề cao, bạn biết không? Cô ấy chắc chắn sẽ tìm ra cách—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya đột nhiên đặt ngón trỏ trái lên môi tôi và lắc đầu. Tôi im lặng ngay lập tức, và cô ấy lại tựa vào vai tôi.")
	await novel_interface.show_text_only("Chúng tôi ngồi đó cùng nhau, chỉ ngắm nhìn những hoạt động đầy màu sắc diễn ra ở dưới đó. Các cuộc biểu tình lẽ ra phải rất ồn ào, nhưng chúng tôi không thể nghe thấy bất cứ điều gì ở nơi chúng tôi đang ở. Thật yên bình, nhẹ nhàng.")
	await novel_interface.show_text_only("Tôi nên miêu tả cô gái này như thế nào nhỉ...")
	await novel_interface.show_text_only("Người tiên phong? Tiên phong? Nhà thám hiểm?")
	await novel_interface.show_text_only("Đó là tất cả những điều khoản xảy ra với tôi. Nhưng họ có vẻ không hoàn toàn đúng.")
	await novel_interface.show_text_only("Dù là Sonya hay tổ tiên của chúng ta... chắc hẳn họ đã cảm thấy nỗi sợ hãi không thể vượt qua khi rời khỏi ngôi nhà quen thuộc của mình và dấn thân vào những điều chưa biết.")
	await novel_interface.show_text_only("Chắc hẳn họ vừa sợ hãi, vừa phấn khích, háo hức...")
	await novel_interface.show_text_only("Quan sát xung quanh một cách cẩn thận, chọn con đường tốt nhất, dọn sạch những bụi gai cản đường...")
	await novel_interface.show_text_only("Họ chắc chắn quá bận rộn để nghĩ về tầm quan trọng của hành động của họ đối với loài người và lịch sử.")
	await novel_interface.show_text_only("Những người ở dưới đó, tạo dáng và chụp ảnh selfie giữa đám đông—đó là những người đang cố gắng hết sức để chứng minh tầm quan trọng của chính mình, phải không?")
	await novel_interface.show_text_only("Tất cả họ đều muốn trông khác biệt. Tuy nhiên, không hề nhận ra, tất cả họ đã tập hợp lại thành một để tạo thành con quái vật khổng lồ này...")
	await novel_interface.show_text_only("Trên đường đến đây, chúng tôi nghe phóng viên phỏng vấn những người có mặt tại cuộc mít tinh trên đài phát thanh.")
	await novel_interface.show_text_only("Phóng viên chọn ngẫu nhiên 23 người đi bộ. Trong số họ, chỉ có một người có thể chỉ ra vị trí ước tính của Masada Ford trên bản đồ thế giới.")
	await novel_interface.show_text_only("Một nửa trong số họ thậm chí còn không biết chính xác họ đang phản đối điều gì.")
	await novel_interface.show_text_only("... Vậy ý nghĩa sự tồn tại của họ có thực sự quan trọng đến vậy không?")
	await novel_interface.show_text_only("Tôi bị kéo về thực tại bởi chiếc điện thoại rung của mình. Khi nhấc máy, tôi đặt điện thoại ở chế độ phát sóng để Sonya cũng có thể nghe thấy.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ồ, hai người... cư xử không đúng mực nhỉ?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Aya?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Các bạn đang làm gì ở Đại lộ số 1?\nVà lên cao như vậy? Bạn đang quan sát mọi người hay gì đó?", "Ai")
	await novel_interface.show_text_only("Aya có vẻ lo lắng một cách đáng ngạc nhiên. Đó là lúc tôi nhận thấy một chiếc máy bay không người lái đang bay chéo hướng về phía chúng tôi.")
	await novel_interface.show_dialog("Tôi không biết Mariru đã đi đâu. Dù sao thì, tôi ở đây để cho bạn biết kết quả chúng tôi nhận được sau khi phân tích cục pin mà Beatrice gửi tới...", "Ai")
	await novel_interface.show_dialog("Tôi sẽ đi thẳng vào vấn đề.", "Ai")
	await novel_interface.show_dialog("Người ta xác nhận rằng pin có liên quan đến Chất H. Và nó được tạo ra bởi một nhà sản xuất quân sự từ Masada Ford.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Vậy... vũ khí Chất H?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Khi chất lỏng dính, phát sáng đó được sản xuất, Chất H chắc chắn có liên quan. Chúng tôi chưa thể chắc chắn về thành phần.", "Ai")
	await novel_interface.show_dialog("Về cơ bản, chúng ta có thể coi thứ đó giống như một loại pin nhiên liệu. Chất lỏng bịt kín trong hộp pin sẽ bị tiêu hao khi pin giải phóng năng lượng.", "Ai")
	await novel_interface.show_dialog("Vì lý do nào đó—có thể là để đáp ứng thời hạn giao hàng hay gì đó—họ đã lắp lại sản phẩm mà không hề xóa bỏ số sê-ri xuất xưởng khỏi MMI.", "Ai")
	await novel_interface.show_dialog("Thậm chí, bộ điều chỉnh điện áp cũng được gắn ở bên ngoài, trên hộp pin.", "Ai")
	await novel_interface.show_text_only("Aya có vẻ bối rối.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Hộp pin...? Bộ điều chỉnh điện áp?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("À, bạn không biết nó trông như thế nào phải không? Hãy để tôi mô tả nó...", "Ai")
	await novel_interface.show_dialog("Một hình trụ bằng kim loại, cao gần ba inch. Được bao phủ hoàn toàn bằng một lớp cách nhiệt, ngoại trừ các điện cực ở hai bên. Nó giống như pin AA nhưng lớn hơn.", "Ai")
	await novel_interface.show_dialog("Bên cạnh nó là một tấm ván có kết cấu cơ khí. Đẩy nó mở ra và bạn sẽ thấy hai điểm tiếp xúc bằng kim loại.", "Ai")
	await novel_interface.show_dialog("Nếu chúng ta đặt điện áp cực thấp vào các điểm tiếp xúc, chúng ta có thể kiểm soát mức điện giải phóng.", "Ai")
	await novel_interface.show_dialog("Trên hộp pin bên ngoài có bộ điều chỉnh điện áp 40 micro-volt. Nó ở vị trí hoàn hảo để giữ bảng mạch và hạn chế điện áp đặt vào các điểm tiếp xúc.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Sao nghe như tiếng pin chạy bằng pin...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nó dùng làm nguồn điện dự phòng cho đèn pin năng lượng phát sáng hay gì đó?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Đó là bởi vì những cục pin này không được thiết kế để làm pin...", "Soya")
