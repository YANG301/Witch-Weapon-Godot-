	await novel_interface.show_text_only("Sau một luồng ánh sáng mạnh mẽ, những vết cháy đan chéo nhau cũng lan ra khắp phòng.")
	await novel_interface.show_dialog("Tuy nhiên, vũ khí tấn công Annie lúc đó dường như không mạnh đến thế. Và nó được lập trình để chỉ nhắm vào một người, nếu không mọi người trong phòng sẽ chết.", "Ai")
	await novel_interface.show_dialog("Và 32V thực tế là điện áp kích thích tối thiểu cho thiết bị đánh lửa xung điện tử được quân đội quốc phòng của Masada Ford sử dụng.", "Ai")
	await novel_interface.show_text_only("Aya dừng lại.")
	await novel_interface.show_dialog("Năng lượng được tạo ra bởi pin 2,88KW tương đương với 5,5 pound TNT...", "Ai")
	await novel_interface.show_dialog("Mặc dù pin không thể tạo ra sóng xung kích có sức tàn phá như TNT nhưng nó vẫn có thể gây tử vong cho mọi sinh vật trong bán kính 33 feet.", "Ai")
	await novel_interface.show_dialog("Và ngay bây giờ, chúng tôi có một trong những thứ đó trên mỗi cột đèn trong Khu phi quân sự đã thỏa thuận...", "Ai")
