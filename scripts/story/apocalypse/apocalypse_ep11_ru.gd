# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Нет. Эти идиоты — они все мужчины!", "Беатрис")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На правой руке Беатрис браслет, сделанный из мшисто-зеленого металла, мягко поблескивающего голубым оттенком.")
	await novel_interface.show_text_only("Изобретение Аи. Изготовлен из специального сплава, блокирующего эффекты мема «Вещество H». Может использоваться для подавления эффектов «проклятия» Беатрис.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Подожди, что ты планируешь…", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Я помню, как Мариру рассказывала мне пару недель назад о «проклятии». Любой мужчина, увидевший Беатрис, тут же влюбляется в нее по уши.")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("Точнее, именно ее лицо вызывает эффект.", "Мариру")
	await novel_interface.show_dialog("В ходе серии тестов, проведенных Аей, они обнаружили, что взгляд прямо на лицо Беатрис сильно стимулирует веретенообразную извилину и миндалевидное тело в мужском мозге.", "Мариру")
	await novel_interface.show_dialog("Однако это эффективно только в том случае, если цель смотрит прямо на нее в радиусе 260 футов. Фотографии, видео или отражения не оказывают такого эффекта.", "Мариру")
	await novel_interface.show_dialog("После того, как эта стимуляция подействует в течение определенного периода времени, в мозге пострадавшего человека произойдут необратимые изменения. Это коренным образом изменит их поведение.", "Мариру")
	await novel_interface.show_dialog("Они отчаянно пытаются сделать Беатрис своей. Но, так как не могут, то становятся тревожными, раздражительными, обидчивыми. Это может даже привести к членовредительству, поджогам или склонности к насилию.", "Мариру")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Как грустно, а? Безответная любовь...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру вздыхает.")
	await novel_interface.show_text_only("Я открываю рот, чтобы спросить, как именно Ая провел этот ужасный эксперимент, но снова закрываю его. Лучше, если я останусь в неведении.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(К счастью, я не был одним из ее подопытных...)", "Лиан")
	await novel_interface.show_dialog("…", "Лиан")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Подожди! Когда вчера ты заставил меня объяснять вещи одной Беатрис в «этом наряде»…", "Лиан")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Это тоже был эксперимент Аи?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Ты только сейчас понял?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Так это было?")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Хм, значит, ты, наверное, еще не понял, что браслет, который вчера носила Беатрис, оказался подделкой, да?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— пошутила Мариру, выглядя слегка разочарованной отсутствием у меня наблюдательности.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Причина, по которой я заставил тебя надеть этот наряд, заключалась в том, чтобы твои субъективные мысли не испортили результаты наших тестов. «Смущение», которое вы испытывали, фактически аннулировало ваши «желания».", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("И…", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она протягивает руку и кладет обе руки мне на плечи. На ее лице легкая ухмылка.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Ты выглядела очень хорошо в костюме кролика из журнала Playboy!", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Аааааааа!\nРазве мы не можем просто перестать поднимать эту тему?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Этот адский час я провел в костюме кролика-плейбоя, наедине с Беатрис, в закрытой комнате.")
	await novel_interface.show_text_only("Я так нервничал, что едва мог выговорить целое предложение. Я даже не мог нормально ходить.")
	await novel_interface.show_text_only("И Беатрис провела целый час, утешая меня, хотя, я уверен, она была на грани того, чтобы рассмеяться.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Айя сказала, что 3D-сканы вашего мозга тогда были похожи на фейерверк. Ей это очень понравилось, и она бы позволила этому продолжаться гораздо дольше, если бы у тебя не было слишком высокого мозгового давления.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("В любом случае, теперь мы знаем, что, хотя ваш мозг реагирует на проклятие Беатрис так же, как и мозг любого нормального мужчины, никакой травмы после него не останется.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("С другой стороны, другие мужчины будут страдать от необратимого повреждения мозга после того, как какое-то время будут смотреть на лицо Беатрис. Период варьируется от сорока секунд до восьми минут.", "Мариру")
	await novel_interface.show_dialog("Так что вы в безопасности. Разве ты не успокоился?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Я конечно не испытываю облегчения!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ах, это еще одно из моих воспоминаний, которое мне хотелось бы просто стереть.")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Итак... если она здесь снимет браслет...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Беатрис мило улыбается мне, затем обнимает меня.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Передо мной все темнеет, когда мое лицо прижимается к ее груди.")
	await novel_interface.show_dialog("А?", "Лиан")
	await novel_interface.show_dialog("Я скажу «иди». После этого у вас есть тридцать секунд.", "Беатрис")
	await novel_interface.show_dialog("Хватай Эллуку, и мы разделимся и встретимся в Центральном парке Ньюэлла. Протестующих там меньше.", "Беатрис")
	await novel_interface.show_dialog("Понял?", "Беатрис")
	await novel_interface.show_text_only("Я киваю, изо всех сил стараясь не думать о мягкой груди на моем лице.")
	await novel_interface.show_dialog("Эй, я тоже хочу очередь!", "Соя")
	await novel_interface.show_text_only("«Нажмите»")
	await novel_interface.show_text_only("Застежка браслета расстегивается. Проклятие теперь в силе.")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("В глазах Сони улица Электроники теперь стала розовым миром.")
	await novel_interface.show_text_only("Тот же розовый оттенок, который она видела в некоторых книгах откровенного содержания, когда они сегодня днем делали покупки в книжном магазине.")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Ты тоже ведьма?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ах. Вы можете сказать?", "Беатрис")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Но ты не Эллука или Рафилия...", "Соя")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("У тебя, как и у Рена, аура чистая, как у младенца!", "Соя")
	await novel_interface.show_dialog("... Это увлекательно!", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— восклицает Соня, от волнения тряся меня за плечи.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Ваааа!\n(Прекрати! Не могу дышать!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Кажется, ты весишь меньше, чем я помнил.\nРазве ты не милашка?", "Беатрис")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Грудастая дама прижимает Рена еще крепче.")
	await novel_interface.show_text_only("Тем временем Рен отчаянно дергается, пытаясь вырваться из ее удушающих объятий.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("... И вообще, кто ты?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Упс, забыл представиться.\nЯ Беатрис Портинари.", "Беатрис")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<90 минут назад>")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Согласованная демилитаризованная зона, отель New Opulentia Stork Garden>")
	await novel_interface.show_text_only("<Снаружи Зала Пения птиц, банкетный зал на верхнем этаже>")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ого, у них здесь на 99 этаже есть сад. Люди в Парящем дворце постоянно наслаждаются такой роскошью?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру осматривает стеклянные крыши, вяло ухмыляясь.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Может быть, чем выше сад, тем он кажется роскошнее? А может быть, 99 – счастливое число владельца?", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка в замешательстве чешет голову.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Как вы вообще решили, что этот аукцион – то, что нам нужно?", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру пристально смотрит на нарисованный баллончиком рекламный щит у входа в банкетный зал.")
	await novel_interface.show_text_only("На нем заголовок «Осенний аукцион в Музее Джонсона».\nДалее следует подзаголовок: «Там, где искусство встречается с финансами».")
	await novel_interface.show_text_only("Белый текст кажется особенно резким на синем фоне. Ничего художественного в этом нет.")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("Это действительно аукцион произведений искусства? Мне это кажется не очень эстетичным.", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру кивает и ухмыляется.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Но все пятьсот мест заняты. Из шестидесяти трех экспонатов шестьдесят уже проданы.", "Мариру")
	await novel_interface.show_dialog("Всего было сделано 1,5 миллиарда.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Так много? Тогда этот аукцион должен быть огромным.\nНо я ничего об этом не слышал...", "Скульд")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Счета с электронным зашифрованием, о которых вы нам сообщили... на них хранятся средства на миллиарды.", "Мариру")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Это много, но достаточно, чтобы построить два таких небоскреба.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Чтобы использовать эту сумму денег для оказания влияния на триллионы фондов восстановления, которыми владеет Объединенный Конгресс, должен быть только один способ...", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Взятка? Вот почему они выбрали зашифрованную валюту?", "Скульд")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Учетные записи могут быть зашифрованы, но любые совершенные транзакции могут быть видны всем в сети. А транзакция такого размера — люди ни за что ее не заметят.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Вот почему им нужна веская причина для сделки...", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд склонила голову набок, размышляя. Потом она восклицает:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("О, вот почему они проводят аукцион!", "Скульд")
	await novel_interface.show_dialog("Антиквариат без фиксированной цены — хороший повод для сделок на крупную сумму. Такие вещи, как фарфор, нефрит, старые картины... никто бы и глазом не моргнул, если бы увидел, что кто-то предлагает за них миллионы.", "Скульд")
	await novel_interface.show_dialog("Причем сделка проводится и на международной территории. Делает невозможным сбор налогов налоговыми органами разных стран.", "Скульд")
	await novel_interface.show_dialog("Все, что им нужно, это связаться с обеими сторонами сделки и продать какой-то хлам под именем какого-нибудь частного музея.", "Скульд")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Но настоящих ценителей искусства на площадку пустить не могут, потому что они с первого взгляда поймут, что что-то не так.", "Скульд")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Так вот почему все места заняты!\nОни заполнили места своими людьми!", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру одобрительно похлопывает Скулда по голове.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Очень умный. Тебе, наверное, очень скучно в школе, да?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Что вы думаете?", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд с гордостью смотрит на Мариру.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Тогда позвольте мне сказать вам еще кое-что.", "Мариру")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("«Фонды послевоенного восстановления» — это, по сути, кредиты, предоставленные Объединенным Конгрессом. Правительства, которые взяли у них займы, должны вернуть деньги, иначе они столкнутся с гневом шести крупнейших стран.", "Мариру")
	await novel_interface.show_dialog("Но исторически ни одна страна никогда не была в состоянии погасить кредит такого размера в установленные сроки. Вот здесь и появляется простор для переговоров.", "Мариру")
	await novel_interface.show_dialog("Комитет неприлично богат. Все, что они хотят для себя, это, вероятно, самый прибыльный сектор, например базовая инфраструктура, такая как энергетика и связь.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Они могут просто сделать предложение главам правительств, взявших деньги в долг: им не нужно будет возвращать заемную сумму, если они навсегда отдадут Комитету 30% акций своей телекоммуникационной сети.", "Мариру")
	await novel_interface.show_dialog("Правительства, неспособные выплатить кредиты, обычно соглашаются. Некоторые национальные лидеры могут даже активно просить о скидках в частном порядке.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Так как же Комитету получить контроль над «секторами», которые ему нужны?", "Скульд")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Они должны убедить Объединенный Конгресс позволить транснациональным корпорациям владеть фондами и иметь определенную степень автономии...", "Скульд")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Это очень многого. Действительно ли они согласятся?", "Скульд")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вместо ответа Мариру просто задает еще один вопрос.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Эта картина, нарисованная баллончиками, выглядит так, как будто ее сделал детский сад. Что это вам говорит?", "Мариру")
