# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice levanta una pierna, apoya el pie en la barandilla y grita por el micrófono.")
	await novel_interface.show_text_only("El estéreo, a todo volumen, lleva su voz hasta el final de Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("¡Sois basura, todos vosotros!", "Beatriz")
	await novel_interface.show_dialog("¡Váyanse al infierno, pervertidos!", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Eh...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ella sólo... dice eso para llamar la atención, ¿verdad? No lo dice en serio, ¿verdad?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Y llamar la atención lo hizo. Todos los ojos están puestos en ella ahora.")
	await novel_interface.show_text_only("En el momento en que ven el rostro de Beatrice, los peatones ya no pueden apartar la mirada. Se quedan de pie, con la boca abierta, asombrados por sus brillantes tacones rojos y la tentadora sombra bajo su minifalda.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("¡Basura, todos ustedes! ¡Bichos asquerosos! Os encantaría que os matara a patadas, ¿no?", "Beatriz")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¿No te da vergüenza?", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Tal vez ella realmente lo dice en serio...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mayoría de la gente en la calle ahora está mirando. Incluso las mascotas que bailaban sobre los techos de otros camiones hacen una pausa en sus actuaciones para contemplar el espectáculo.")
	await novel_interface.show_text_only("Sonya y yo aprovechamos la oportunidad para subir la escalera al costado de la camioneta de Elluka.")
	await novel_interface.show_text_only("La niña está sentada en su trono, dándose palmaditas en su abultado vientre con satisfacción. Decenas de platos vacíos yacen sobre la mesa de ofrendas frente a ella.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("¿Ella... se comió todo esto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Examino el área, calculando la mejor manera de sacar a este pequeño y gordito glotón de todo este lío, pero Elluka simplemente se arroja sobre mí.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("¡Señorita Ren!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me llevo un dedo a los labios y le hago un gesto para que lo mantenga presionado.")
	await novel_interface.show_text_only("Sin embargo, ella ya saltó en el aire, apuntando directamente a mi cara...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Ah, claro. La primera vez que vi a Elluka, ella estaba luchando contra brujas en el aire, ¿no?")
	await novel_interface.show_text_only("Recuerdo que Aya me dijo que esta niña, de entre once y doce años a juzgar por la edad de sus huesos, había sido sometida a decenas de operaciones y tenía innumerables piezas mecánicas instaladas en su cuerpo.")
	await novel_interface.show_text_only("Le han borrado la memoria demasiadas veces; ni siquiera recuerda cuándo su propio ojo izquierdo fue reemplazado por una prótesis ocular electrónica de grado militar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Con todas esas partes mecánicas dentro de ella, a pesar de que es capaz de flotar aprovechando el campo electromagnético, su peso real es de hecho el doble que el mío...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("¡Golpe!")
	await novel_interface.show_text_only("Elluka aterriza sobre mí, sus muslos aprietan mis costillas y su suave vientre cubre mi cara. Sus manos regordetas se aferran a mi nuca.")
	await novel_interface.show_text_only("Juro que pude escuchar mi columna romperse por la presión.")
	await novel_interface.show_text_only("Envuelve todo su cuerpo alrededor de mi pecho, mi cabeza, acariciando su mejilla con mi cabello como un gato muy entusiasta.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("¡La señorita Ren es mi favorita! *hip*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por su alegre rostro rojo y el tono de su voz, uno habría pensado que estaba borracha.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Escuché este fuerte crujido... ¿eran tus huesos?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me quedo rígido, congelado en el lugar. Siento como si mi cuello se partiera por la mitad si me muevo aunque sea un poquito.")
	await novel_interface.show_text_only("La conmoción parece haber atraído la atención de las hembras cercanas. Algunos incluso nos señalan y preguntan \"¿qué es eso?\"")
	await novel_interface.show_text_only("Ahora mismo parezco un monstruo cabezón con medias de red. No es de extrañar que estén confundidos.")
	await novel_interface.show_text_only("Al darse cuenta de nuestra situación, Beatrice levanta la voz, como para darnos más tiempo para evacuar.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("¡Todos ustedes pertenecen al depósito de chatarra! ¡Ni una pizca de decencia en vuestras cabezas! ¡Gusanos! ¡Grima! ¡Cerdo!", "Beatriz")
	await novel_interface.show_dialog("Todos ustedes—", "Beatriz")
	await novel_interface.show_dialog("¡Muere!", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los dos oradores cantan a coro con una electricidad chisporroteante mientras el apasionado discurso de Beatrice alcanza su clímax.")
	await novel_interface.show_text_only("Y finalmente explotan, junto a las bombillas de los carteles iluminados cercanos.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Toda la calle cae en un silencio inquietante.")
	await novel_interface.show_text_only("La multitud sigue mirando, estupefacta, a la dama pelirroja, parada en todo su esplendor encima del camión.")
	await novel_interface.show_text_only("Sonya usa la breve distracción para quitarme a Elluka de encima y luego la empuja sobre su espalda.")
	await novel_interface.show_text_only("La niña más joven, que se había pegado a mí como un chicle, se queda dormida en un instante.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Uf... no esperaba que el mocoso pesara tanto...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suspiro, finalmente logro recuperar el aliento y me masajeo la cintura mientras observo la escena. Todavía hay un silencio inquietante.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("¿Están estos tipos petrificados o algo así?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero momentos después, los vítores comienzan a resonar entre la multitud. Aplausos fuertes y maravillosos.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("¡Ahhh! ¡Ella es maravillosa! ¡Eres maravillosa!", "Transeúnte A")
	await novel_interface.show_dialog("¡Pásame, mi reina!", "Transeúnte B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olas y oleadas de vítores exultantes explotan por toda la calle.")
	await novel_interface.show_text_only("La multitud se está amotinando de pura emoción.")
	await novel_interface.show_text_only("De los camiones blindados negros al otro lado de la calle, saltan varios soldados con armas automáticas, observando confundidos el repentino alboroto.")
	await novel_interface.show_text_only("Hago un gesto en su dirección, tratando de alertar a Beatrice, y es entonces cuando accidentalmente veo su rostro...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Dios mío—", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Ella es... ¡tan hermosa!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una corriente cálida y hormigueante que se parece mucho al deseo se extiende por mi cuerpo al instante.")
	await novel_interface.show_text_only("Mis mejillas arden, mis piernas fallan...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(La quiero...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("... ¿Ren?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Las multitudes se están saliendo de control. Se lanzan hacia la camioneta de Beatrice como uno solo, cantando en voz alta mientras avanzan, hasta el punto de que el endeble vehículo está a punto de volcarse.")
	await novel_interface.show_text_only("Algunos chicos intentan escalar el camión desde un costado, pero Beatrice simplemente les pisotea las manos y los patea hacia abajo.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(¡Sí! ¡Más! ¡Pisame a mí también! ¡Por favor, mi reina!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sonríe y sacude la cabeza ante la expresión de pura idiotez en mi rostro, luego vuelve a ponerse el brazalete.")
	await novel_interface.show_text_only("Luego saca de sus pechos una cápsula plateada del tamaño de un pulgar y la arroja a la multitud enloquecida bajo sus pies.")
	await novel_interface.show_text_only("En una nube de humo blanco, la bella Beatriz desaparece sin dejar rastro.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Sin embargo, todavía no puedo olvidar su impresionante rostro... hasta que Sonya tira de mi brazo.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("¡Sal de ahí! ¡Ya vienen los soldados! Además...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A medida que el humo se disipa, la multitud comienza a murmurar confundida, al darse cuenta de que su objeto de atención ya no está allí.")
	await novel_interface.show_text_only("Sonya y yo apenas logramos alejarnos unos pasos de la multitud antes de que el club de fans de Elluka se dé cuenta de que su propio ídolo se ha ido.")
	await novel_interface.show_dialog("¿Dónde está Lady Elluka?", "Guardia Real A")
	await novel_interface.show_dialog("¡Por allá! ¡Ese de medias de rejilla se llevó a nuestra Señora Elluka!", "Guardia Real B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(¿Medias de red? ¿Lady Elluka?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Secuestrador! ¡Llame a la policía!", "Guardia Real C")
	await novel_interface.show_dialog("¡Después de ellos!", "Guardia Real A")
	await novel_interface.show_text_only("Un grupo de hombres furiosos se dirige directamente hacia nosotros, seguidos por algunos policías de seguridad.")
	await novel_interface.show_text_only("Vamos, ¿qué clase de secuestrador usa medias de red?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("¡Corre!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero nos resulta difícil deshacernos de la multitud, sobre todo porque Sonya lleva en brazos a la regordeta Elluka y mi cintura todavía me duele.")
	await novel_interface.show_text_only("Lo que es peor, hay algunos policías patrullando más adelante...")
	await novel_interface.show_text_only("No podemos pelear. No podemos correr. Es inútil.")
	await novel_interface.show_text_only("De repente, detrás de nosotros, se oye el sonido de cristales rotos.")
	await novel_interface.show_text_only("Un chico rubio con una cazadora negra ha derribado un cartel iluminado de la vieja escuela junto a la calle.")
	await novel_interface.show_text_only("Los fragmentos de las bombillas de los carteles cubren el suelo. Los peatones, haciendo todo lo posible por evitarlos, efectivamente ralentizan el club de fans de Elluka.")
	await novel_interface.show_text_only("El chico rubio nos sonríe a Sonya y a mí, con cara inocente y dulce.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Hay un atajo más adelante. ¿Venga conmigo?", "Niño con gafas")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya y yo intercambiamos miradas. ¿Por qué esto suena como una especie de escenario de una película?")
	await novel_interface.show_text_only("El joven con gafas, cabello rubio esponjoso, camisa a cuadros y ojos azules, parece bastante tímido.")
	await novel_interface.show_text_only("Parece casi avergonzado por nuestra falta de reacción y se apresura a explicar:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Yo... trabajo medio tiempo en una tienda por aquí... Acabo de salir del trabajo...", "Niño con gafas")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Él mira mis piernas, traga saliva y se da vuelta.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Vaya, de hecho esta no es una buena manera de mirar furtivamente a las chicas...)\n(Es demasiado obvio...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Tú... parecía que te estaban persiguiendo unos malos, así que pensé...", "Niño con gafas")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hombro de Sonya se hunde mientras baja la guardia brevemente.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("A juzgar por su aura, no quiere hacernos daño.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En realidad, considerando todo, SOMOS los malos aquí...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("¡Dirige el camino!", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
