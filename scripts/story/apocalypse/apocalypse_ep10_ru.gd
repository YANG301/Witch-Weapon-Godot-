# apocalypse_ep10.gd - 天启篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第10话剧本
	apocalypse_ep10_script()

func play_script():
	pass

# 天启篇第10话 - 正式剧本
func apocalypse_ep10_script():
	# 场景：秋叶原夜晚
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Мы с Соней возвращаемся на ярко освещенную улицу Электроники.")
	await novel_interface.show_text_only("На огромном подвесном экране на внешней стене флагманского здания Nekomaru Electronics крутится рекламный ролик спонсора.")
	await novel_interface.show_text_only("Несколько мобильных грузовиков с рекламными щитами аккуратно припаркованы в ряд в центре пешеходной дорожки.")
	await novel_interface.show_text_only("По обеим сторонам каждого грузовика размещены гигантские рекламные объявления, нарисованные аэрозольной краской. На крышах машин украшены рейлинги, и к ним прислоняются рабочие, проводя саунд-чек с причудливым на вид оборудованием.")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("Они собираются проводить здесь какое-то мероприятие?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Улица Электроники стала еще более многолюдной, чем когда мы покинули ее раньше. Еще больше людей все еще прибывают.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Ох, сегодня должно быть...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я помню, как увидел нечто подобное в Интернете и вытащил телефон, чтобы выполнить поиск.")
	await novel_interface.show_text_only("Это верно. Это ежегодный фестиваль Electronics Street.")
	await novel_interface.show_text_only("Пять лет назад, когда Новая Опулентия постепенно оправилась от войны, Сенат объявил об отмене нескольких законов, регулирующих культурную деятельность, включая Закон об общественном порядке.")
	await novel_interface.show_text_only("За полночь до принятия решения огромная толпа собралась под этим самым экраном перед Nekomaru Electronics и отсчитывала секунды, ведущие к этой «великой победе».")
	await novel_interface.show_text_only("После этого некоторые пользователи сети внесли забавные изменения, создав целый короткометражный фильм, рассказывающий эпическую историю о том, как храбрые пионеры отаку выступили против репрессивного правительства и, наконец, спасли мир.")
	await novel_interface.show_text_only("Это вдохновило многих упомянутых «пионеров» на внесение собственных забавных правок, добавляющих фрагменты в историю «той войны», как если бы это было реально существующее событие.")
	await novel_interface.show_text_only("Некоторые даже утверждали, что после инцидента правительство стерло память всем в мире, оставив нетронутыми воспоминания лишь нескольких отважных «пионеров».")
	await novel_interface.show_text_only("И обратный отсчет на самом деле представлял собой сбор группы выживших, чтобы почтить память этих отважных «пионеров» в ночь перед тем, как их память была стерта.")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("(Что это за глупая история? Кто вообще на это купится?)", "Лиан")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Хотя мне очень понравилось пролистывать изменения...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В любом случае, предприятия в этом районе воспользовались возможностью превратить этот день в ежегодный фестиваль, на котором покупатели получают безумные скидки. Это также привлекло множество спонсоров.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("Неудивительно, что сегодня днем они раздавали бесплатные товары...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я с завистью наблюдаю, как мимо проходят покупатели, держа в руках маленькие желтые флажки.")
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Если мероприятие продлится до полуночи... не слишком ли рано людям так волноваться?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я проверяю часы. Еще нет восьми, но толпа на улице, кажется, уже гудит от ожидания.")
	await novel_interface.show_text_only("Число участников сегодня неожиданно велико. Плохая полиция безопасности, следящая за порядком, едва может заставить себя быть услышанной.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Э-э... разве мы не беглецы?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я украдкой поглядываю на копов поблизости, гадая, понадобится ли Соне расправиться и с ними с помощью какой-нибудь другой сумасшедшей штуки.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Просто ведите себя сдержанно.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня щипает меня и показывает на какие-то машины напротив.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("Видите эти два черных бронированных грузовика?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вижу их. Кажется, они держат солдат службы безопасности, ожидающих приказов – вероятно, от отряда специального назначения Ньюморидаса.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Если мы привлечем внимание этих ребят, я не буду защищать тебя от пуль!", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня с презрительной ухмылкой смотрит на мои мягкие, лишенные мускулов бедра. Она, наверное, думает, что я бесполезный ребенок, который даже не умеет уворачиваться от пуль. И она не ошибается.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Как нам найти Эллуку среди такого количества людей?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я оглядываюсь на болтающую толпу, чувствуя боль в сердце, когда представляю маленькую Эллуку, потерянную среди всего этого, напуганную и беспомощную.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("О, эта девушка? Она здесь.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("А?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня кивает на грузовик с рекламными щитами впереди нас, украшенный как своего рода храм. А девушка, сидящая в позе почитаемого бога? Эллука.")
	await novel_interface.show_text_only("Трудно сказать, кто спонсировал этот грузовик. На его голове висит гигантский фонарь, а прямо за ним двое мужчин играют на барабанах тайко.")
	await novel_interface.show_text_only("Сотни людей столпились вокруг грузовика, указывая на Эллуку и воркуя над ее привлекательностью.")
	await novel_interface.show_text_only("Дюжина парней, одетых в воту, стоят в очереди, размахивают желтыми флагами и исполняют фанчанты под бой барабанов.")
	await novel_interface.show_text_only("На столе для подношений перед Эллукой лежит рулет с шоколадным кремом, который она съедает за несколько секунд.")
	
	# 显示伊露卡，使用iluka_hide而不是iluka_uniform
	await novel_interface.show_dialog("Мвахаха…", "Эллука")
	await novel_interface.show_text_only("А потом она сияет, такая счастливая, такая бессердечная.")
	await novel_interface.show_text_only("Толпа аплодирует, когда она заканчивает «подношение», а ее «поклонники» начинают скандировать громче.")
	await novel_interface.show_text_only("Глаза, полные звезд, Эллука выбирает свое следующее «подношение».")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Лиан")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Какого черта?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Кажется, они прекрасно проводят время.", "Соя")
	await novel_interface.hide_character()
	
	# 场景转换
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Мы проталкиваемся сквозь толпу, наблюдая за грузовиком со всех сторон.")
	await novel_interface.show_text_only("Преданные фанаты сгрудились у грузовика, и мы не можем подобраться ближе, не прибегнув к насилию.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Но мы не можем поднимать шум, потому что придут менты...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("По крайней мере, Эллуке, кажется, ничего не угрожает. Она просто сидит и ест. Тогда нет смысла волноваться.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Эй, как ты думаешь, почему эти парни поклоняются милым маленьким девочкам? В Европе мы считаем это ненормальным.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— спрашивает меня Соня с ухмылкой на лице.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Ненормально?\nЭто не так уж и плохо...", "Лиан")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Видите, это похоже на то, как люди находят котят и щенков милыми, верно? Девочки простые, какие-то неуклюжие, и всегда стараются, как могут...", "Лиан")
	await novel_interface.show_dialog("Это напоминает людям о той частичке невинности, которую они потеряли, и они хотят защитить ее...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я пытаюсь объяснить, но чем больше я говорю, тем страннее это кажется.")
	novel_interface.show_character("ren_fishnet", "shy_left")
	await novel_interface.show_dialog("Кроме того, когда дело доходит до ненормальности, разве ты сам не хуже?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Что ж, насколько я понимаю, быть ненормальным – это не так уж и плохо.", "Соя")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Если «нормальное» определяется как среднее состояние людей в определенной среде, то те, кто не является средним, будут считаться «ненормальными».", "Соя")
	await novel_interface.show_dialog("Значит, те, кто выдающиеся, тоже «ненормальные», верно? Совсем не плохо!", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня прижимает руку к груди с весьма гордым видом.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Быть ненормальным — это нормально, не нужно объяснять свою ненормальность этим приземленным простолюдинам. Вы можете просто признать это, а не пытаться найти этому оправдания.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня похлопывает меня по плечу, как будто она только что ушла с какой-то великой мудростью.")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("(Что это за интерпретация?)\n(И значит ли это, что она тоже считает меня ненормальной?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Причина, по которой европейцы считают людей с лоликоновым комплексом ненормальными, вероятно, заключается в том, что среднестатистическому европейцу больше нравятся женщины с большой грудью. Например...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня кладет руку мне на грудь и зажимает сосок.")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("Дышать?", "Лиан")
	await novel_interface.hide_character()
	
	# 贝阿特丽切出场，使用beatrice_show_hide效果
	await novel_interface.show_dialog("Еще не очень созрел, да.", "Женский голос")
	await novel_interface.show_text_only("Позади нас раздается знакомый голос.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Б-Беатрис?\nЧто ты здесь делаешь?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Прошло много времени, милашка!", "Беатрис")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Ваа!", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня собирается прыгнуть на грудь Беатрис, но я вовремя отдергиваю ее назад.")
	novel_interface.show_character("soya_uniform", "cry")
	await novel_interface.show_dialog("Л-отпусти меня!", "Соя")
	await novel_interface.show_dialog("Она пахнет так же чисто, как Рен, но ее запах намного больше...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заткнись!")
	await novel_interface.show_text_only("Беатрис просто элегантно расчесывает волосы и поправляет узкую рубашку.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Мариру просила меня тайно выследить тебя и обеспечить твою безопасность.", "Беатрис")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Было очень трудно оставаться вне поля зрения весь день! Тем более, что вы, ребята, столкнулись с этой Терезой...", "Беатрис")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("Следовать за нами? Тайно?", "Лиан")
