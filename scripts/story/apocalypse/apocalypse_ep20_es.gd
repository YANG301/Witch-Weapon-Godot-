# apocalypse_ep20.gd - 天启篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第20话剧本
	apocalypse_ep20_script()

func play_script():
	pass

# 天启篇第20话 - 正式剧本
func apocalypse_ep20_script():
	# 开场宇宙哲学思考
	novel_interface.show_background("res://assets/images/bg/Soya/Universe.png")
	await novel_interface.show_text_only("Solía encontrar atractivas las teorías que suenan épicas y muy imaginativas.")
	await novel_interface.show_text_only("Los humanos en realidad son cerebros que flotan en un tanque de cultivo. No somos más que meras simulaciones. El planeta entero fue creado como un experimento infantil. Teorías como estas.")
	await novel_interface.show_text_only("Era adicto a estas ideas. Embriagado. Me pusieron la piel de gallina.")
	await novel_interface.show_text_only("Hasta que un día comencé a preguntarme...")
	await novel_interface.show_text_only("Ese tanque de cultivo, ese programador que creó la simulación, ese niño que hizo el experimento... ¿en qué clase de mundo viven ELLOS?")
	await novel_interface.show_text_only("¿No estamos todos atrapados en este mismo universo, sin forma de escapar?")
	await novel_interface.show_text_only("Como esa letra de Hotel California: puedes salir cuando quieras, pero nunca podrás irte.")
	await novel_interface.show_text_only("Cuando los dioses miran el cielo estrellado, ¿no sienten la misma curiosidad, asombro y miedo que nosotros?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("¡Ren!")
	
	# 小怜醒来
	novel_interface.show_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("—!", "Lian")
	await novel_interface.show_text_only("Abro los ojos y percibo una especie de olor fuerte y acre y me encuentro sobre un colchón blando.")
	await novel_interface.show_text_only("Aya está parada a mi lado, oliendo sales en la mano, mientras Mariru aparece a los pies de la cama, filmándome con su teléfono.")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.show_text_only("Rápidamente me limpio la baba y los mocos de la cara y noto con horror la gran mancha húmeda en la almohada.")
	await novel_interface.show_text_only("Se siente como si hubiera dormido mucho tiempo. Y tuve un sueño muy triste...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("¡Te ves adorable cuando duermes!", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sonríe, guarda su teléfono y se acerca, colocando una mano sobre mi frente.")
	novel_interface.show_character("liliu_research","smile")
