# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Lei ride, chinandosi verso di me con nonchalance, lasciando finalmente cadere la testa sulla mia spalla.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Grazie, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Potremmo chiedere ad Aya di esaminarti...\nÈ davvero abile, sai? Troverà sicuramente un modo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya all'improvviso mi mette l'indice sinistro sulle labbra e scuote la testa. Mi calmo subito e lei si appoggia di nuovo sulla mia spalla.")
	await novel_interface.show_text_only("Ci sediamo lì insieme, semplicemente osservando ciò che accade laggiù. Le proteste dovrebbero essere forti, ma da dove siamo non riusciamo a sentire nulla. È pacifico, rilassante.")
	await novel_interface.show_text_only("Come dovrei descrivere questa ragazza...")
	await novel_interface.show_text_only("Un pioniere? Avanguardia? Avventuriero?")
	await novel_interface.show_text_only("Questi sono tutti termini che mi sono venuti in mente. Ma non sembrano del tutto giusti.")
	await novel_interface.show_text_only("Che si tratti di Sonya o dei nostri antenati... devono aver provato una paura insormontabile quando hanno lasciato le loro case familiari e si sono avventurati nell'ignoto.")
	await novel_interface.show_text_only("Dovevano essere terrorizzati, ma anche eccitati, impazienti...")
	await novel_interface.show_text_only("Osservare attentamente l'ambiente circostante, scegliere il percorso migliore, eliminare i rovi che ostacolavano...")
	await novel_interface.show_text_only("Erano decisamente troppo occupati per pensare al significato che le loro azioni avevano sulla razza umana e sulla storia.")
	await novel_interface.show_text_only("Quelle persone laggiù, che si mettono in posa e si scattano selfie in mezzo alla folla, sono quelle che stanno cercando disperatamente di dimostrare la propria importanza, non è vero?")
	await novel_interface.show_text_only("Tutti vogliono sembrare diversi. Eppure, senza rendersene conto, si unirono tutti per formare questo enorme mostro...")
	await novel_interface.show_text_only("Mentre venivamo qui, abbiamo sentito un giornalista intervistare alla radio i presenti alla manifestazione.")
	await novel_interface.show_text_only("Il giornalista ha scelto ventitré pedoni a caso. Di tutti, solo uno è stato in grado di indicare la posizione stimata di Masada Ford sulla mappa del mondo.")
	await novel_interface.show_text_only("La metà di loro non sapeva nemmeno contro cosa stessero protestando.")
	await novel_interface.show_text_only("... Quindi il significato della loro esistenza è davvero così importante?")
	await novel_interface.show_text_only("Sono riportato alla realtà dalla vibrazione del mio telefono. Mentre prendo la cornetta, metto il telefono in modalità trasmissione in modo che anche Sonya possa sentire.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ooh, voi due... vi comportate male, eh?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Sì?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ragazzi, cosa state facendo sulla First Avenue?\nE così in alto? Stai osservando la gente o qualcosa del genere?", "Ai")
	await novel_interface.show_text_only("Aya sembra sorprendentemente preoccupata. È in quel momento che noto un drone che si libra diagonalmente di fronte a noi.")
	await novel_interface.show_dialog("Non so dove sia andata Mariru. Comunque sono qui per raccontarvi i risultati che abbiamo ottenuto dopo aver analizzato la batteria che Beatrice ci ha inviato...", "Ai")
	await novel_interface.show_dialog("Andrò dritto al punto.", "Ai")
	await novel_interface.show_dialog("È confermato che la batteria ha qualcosa a che fare con la sostanza H. Ed è stata creata da un produttore militare di Masada Ford.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Quindi... un'arma a base di sostanza H?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quando fu prodotto quel liquido luminoso e appiccicoso, la sostanza H era sicuramente coinvolta. Non possiamo ancora essere sicuri degli ingredienti.", "Ai")
	await novel_interface.show_dialog("Fondamentalmente possiamo vedere quella cosa come una sorta di cella a combustibile. Il liquido sigillato nella custodia della batteria viene consumato quando la batteria rilascia energia.", "Ai")
	await novel_interface.show_dialog("Per qualche motivo, forse per rispettare la scadenza della spedizione o qualcosa del genere, hanno rimontato il prodotto senza nemmeno cancellare il numero di serie di fabbrica da MMI.", "Ai")
	await novel_interface.show_dialog("Anche il regolatore di tensione è fissato all'esterno, sulla scatola della batteria.", "Ai")
	await novel_interface.show_text_only("Aya sembra confusa.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Scatola batteria...? Regolatore di tensione?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, non sai che aspetto ha, vero? Lasciamelo descrivere...", "Ai")
	await novel_interface.show_dialog("Un cilindro di metallo, alto quasi tre pollici. Completamente ricoperto da uno strato isolante, tranne che sugli elettrodi su entrambi i lati. È come una batteria AA, ma più grande.", "Ai")
	await novel_interface.show_dialog("Al suo fianco c'è una tavola strutturata meccanicamente. Spingilo per aprirlo e vedrai due contatti metallici.", "Ai")
	await novel_interface.show_dialog("Se applichiamo una tensione estremamente bassa ai contatti, possiamo controllare il livello di elettricità rilasciata.", "Ai")
	await novel_interface.show_dialog("Sulla scatola della batteria all’esterno c’è un regolatore da quaranta microvolt. È nella posizione perfetta per sostenere la scheda e limitare la tensione applicata ai contatti.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Perché sembra una batteria alimentata da una batteria...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Viene utilizzato come fonte di alimentazione di riserva per una torcia a energia luminosa o qualcosa del genere?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("È perché queste batterie non sono state progettate per essere batterie...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sembra cupa.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("È come... la sicura meccanica delle armi... e un dispositivo di accensione.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Provo a calcolare l'energia contenuta in una batteria del genere.", "Ai")
	await novel_interface.show_dialog("Secondo quanto ci ha detto la compagnia elettrica, una batteria come questa può far funzionare un dispositivo di microsorveglianza da 6W per una ventina di giorni.", "Ai")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Non sembra un grosso problema...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Come si calcola la potenza? L'abbiamo imparato a lezione? Dimenticavo...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sospira per la mia disperazione quando si tratta di fisica.")
	await novel_interface.show_dialog("Una batteria da 2,88 KW potrebbe far funzionare il tuo cellulare per sei mesi.", "Ai")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wow! Così a lungo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In questi giorni mi sono abituato a usare Elluka per caricare il mio telefono e la mia console di gioco. Annie mi rimprovera spesso per questo.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Aspetta... cosa succede se non c'è il regolatore di tensione?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("È per questo che ti ho chiamato, in realtà.", "Ai")
	await novel_interface.show_dialog("Ho scoperto che nell'intervallo di ingresso compreso tra 1 e 500 microvolt, la potenza generata dalla batteria aumenta insieme all'ingresso. Ma quando si supera quota 500, non succede nulla. Nessuna uscita.", "Ai")
	await novel_interface.show_dialog("Così ho aumentato la tensione a 32 V e all'improvviso dalla batteria è uscita questa luce bianca accecante...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Secondo quanto catturato dalla nostra fotocamera ad alta velocità, il liquido nella batteria si è consumato in meno di un millisecondo.", "Ai")
	await novel_interface.show_dialog("L'esplosione di energia ha quasi incenerito il soffitto della stanza di isolamento. Ci sono segni di bruciature che si incrociano su tutto il muro e sul terreno.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Cosa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso ricordo che, quando Igor ci attaccò allo Sky Hotel, uno dei suoi lacchè usò un'arma elettrica...")
	await novel_interface.show_text_only("Dopo un'esplosione di luce potente, c'erano anche segni di bruciature incrociati che si ramificavano per tutta la stanza.")
	await novel_interface.show_dialog("Tuttavia, l’arma che colpì Annie allora non sembrava essere così potente. Ed era programmato per prendere di mira solo una persona, altrimenti tutti nella stanza sarebbero morti.", "Ai")
	await novel_interface.show_dialog("E 32 V è in realtà la tensione di eccitazione minima per gli accenditori elettronici utilizzati dall'esercito di difesa nazionale di Masada Ford.", "Ai")
	await novel_interface.show_text_only("Aya fa una pausa.")
	await novel_interface.show_dialog("L'energia generata da una batteria da 2,88KW è pari a quella di 5,5 chili di TNT...", "Ai")
	await novel_interface.show_dialog("Sebbene le batterie non possano generare onde d'urto distruttive come il TNT, possono comunque essere fatali per tutti gli esseri viventi in un raggio di 33 piedi.", "Ai")
	await novel_interface.show_dialog("E proprio adesso, abbiamo una di quelle cose su ogni singolo lampione nella Zona Demilitarizzata Concordata...", "Ai")
	await novel_interface.show_text_only("Sussulto, fissando le orde gigantesche laggiù.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Maledizione... Igor... come ha potuto...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("Aspetta!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("interviene Sonya.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Se è così, sicuramente Masada Ford non vorrebbe che quelle batterie esplodessero, giusto?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("È vero.", "Ai")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Le batterie sono state prodotte in fretta, i numeri di serie sono ancora visibili. E come soluzione rapida è stato aggiunto un semplice regolatore di tensione...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sembra che fossero alla disperata ricerca di soddisfare l'enorme numero di ordini effettuati dal Congresso Unito.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Se le batterie esplodessero, le autorità sarebbero in grado di capire chi le ha fabbricate dai numeri di serie. Sarebbe una mossa stupida da parte di Masada.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Inoltre, questo è un progetto di rinnovamento della città su larga scala. Innumerevoli persone sarebbero coinvolte nella logistica, nell’implementazione e nella manutenzione. Sarebbe impossibile tenere nascosto un segreto così mortale.", "Ai")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("È vero...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Ciò che è veramente sospetto sono i pazienti menzionati da Beatrice.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru aveva già allertato il centro di controllo delle malattie per pubblicare un avviso di contaminazione di classe quattro. Attualmente, tutti i venti casi sono raccolti nella zona demilitarizzata concordata.", "Ai")
	await novel_interface.show_dialog("Tuttavia, queste batterie non hanno alcun effetto sullo stato mentale delle persone. E i risultati del rilevamento dei meme mostrano che non contengono nemmeno fonti di infezione di tipo meme...", "Ai")
	await novel_interface.show_text_only("Abbasso lo sguardo, senza parole. Tante domande, ma nessuna risposta.")
	await novel_interface.show_text_only("Guardo la folla laggiù. C’è un lampione ogni quaranta piedi...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Aspetta. Cosa abbiamo trovato di strano io e Sonya quando eravamo laggiù?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Che i “confini” delle folle in manifestazione sono troppo definiti...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Ehm?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cosa intendi con...?", "Ai")
	await novel_interface.show_text_only("Forse la risposta è sempre stata davanti a noi. Semplicemente non l’abbiamo visto perché c’erano troppe distrazioni per strada…")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Mariru non ha detto che TUTTI i sistemi di illuminazione e di sorveglianza dei lampioni della città sono stati sostituiti dal Congresso Unito?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sì.", "Ai")
	await novel_interface.show_dialog("In tal caso, perché i lampioni sono bicolori?", "Lian")
	await novel_interface.show_text_only("Sulla First Avenue, i lampioni brillano di un giallo caldo, illuminando i confini netti della folla.")
	await novel_interface.show_text_only("Intanto, sui vicoli deserti, i lampioni brillano di bianco.")
	await novel_interface.show_text_only("Dall'altro capo del ricevitore arriva il suono di una digitazione frenetica.")
	await novel_interface.show_dialog("Ho appena controllato. Le nuove lampadine aggiunte dovrebbero essere luci LED sostenibili con una temperatura di colore di 4500K, quindi dovrebbero apparire bianche. Non sono sicuro di cosa succede con quelli gialli...", "Ai")
	await novel_interface.show_text_only("Io e Sonya ci scambiamo uno sguardo, nel tentativo di ricordare tutte le luci che abbiamo visto nelle ultime ore.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Il filmato della linea di difesa davanti al Congresso Unito che abbiamo appena visto era giallastro. L'area è probabilmente illuminata da un gran numero di lampade gialle.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Anche i lampioni di Electronics Street erano gialli, credo...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("La strada era caotica, piena di abbaglianti insegne al neon e cartelloni pubblicitari illuminati. Nessuno noterebbe le lampade gialle.")
	await novel_interface.show_dialog("L'atmosfera in Electronics Street era davvero un po' strana oggi... tutti sembravano insolitamente eccitati.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Le strade illuminate di bianco, invece, sembravano per lo più deserte.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("La strada fuori dalla stazione di polizia da cui siamo scappati...", "Soya")
	await novel_interface.show_dialog("Inoltre...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("Quella strada tranquilla fuori Newell Central Park...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Potrebbe essere...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Quella luce dorata...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Ehm?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Da dietro la porta...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("Era...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya non si preoccupa di finire la frase. Mi prende la mano e si lancia verso l'ascensore.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
