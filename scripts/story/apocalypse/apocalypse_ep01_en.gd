# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("We’re taught all sorts of virtues to live by.")
	await novel_interface.show_text_only("I’m sure most of us have read that story about Marie Curie and her extraordinary concentration abilities.")
	await novel_interface.show_text_only("She was studying, and her sister and classmates came up with a prank. They stacked several chairs up behind her. If she moved, the whole stack would come crashing down.")
	await novel_interface.show_text_only("But the stack remained in place even until Marie Curie finished reading the whole book.")
	await novel_interface.show_text_only("Her great focus was what enabled her to become the first scientist to have received the Nobel Prize twice.")
	await novel_interface.show_text_only("But this question might have occurred to you:")
	await novel_interface.show_text_only("“Does everyone feel the same way regarding the same subject? Ever since they were born?”")
	await novel_interface.show_text_only("Some people are born with the ability to absorb knowledge nonstop and barely need to sleep.")
	await novel_interface.show_text_only("They can memorize lots of information and remain concentrated for a long time.")
	await novel_interface.show_text_only("It’s easy for them. But for many others, it’s neigh impossible.")
	await novel_interface.show_text_only("Perhaps, to Marie Curie, reading physics books is easier than reading manga.")
	await novel_interface.show_text_only("So, striving towards the same “virtues”, to most people, is like struggling against the genetic traits they were born with.")
	await novel_interface.show_text_only("Perhaps you haven’t considered this question before?")
	await novel_interface.show_text_only("But now you have. The seed’s been planted in your head.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("So...")
	await novel_interface.show_text_only("The next time you ask yourself this question, whose voice will be asking it?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Click.")
	await novel_interface.show_text_only("The sound of a firearm being loaded.")
	await novel_interface.show_text_only("After the NTBC News opening sequence, comes the familiar voice of the female announcer.")
	await novel_interface.show_dialog("“The fourth annual International Forum of Peace will be held in the Agreed Demilitarized Zone in New Opulentia in three days.”", "News")
	await novel_interface.show_dialog("“As the neutral city with the largest scientific research system, New Opulentia will be welcoming guests from the other five Academy Cities this week.”", "News")
	await novel_interface.show_dialog("“This year’s Forum of Peace will be centered on the development of Substance H as a power resource, the Rebuild Project, and other important issues.”", "News")
	await novel_interface.show_dialog("“The Speaker of Masada Ford has declared in a recent non-formal speech that the city will soon be publishing a brand-new set of military plans in order to reestablish order in the Middle East.”", "News")
	await novel_interface.show_dialog("“The Representative of Salmonton News Department has declined to comment on this topic.”", "News")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("In the old warehouse, the dimly-lit ceiling lamp hangs, emitting small fizzling sounds of electricity.")
	await novel_interface.show_text_only("At one side, a silver-haired man sits under the harsh white light.")
	await novel_interface.show_text_only("He’s tied on a sturdy chair whose legs have been welded to the ground.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("The man is still adjusting to the brightness around him, as the sack over his head had just been yanked off. The rough ship reinforcement wires rub against his expensive customized suit, leaving coarse, fraying ends.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noticing the sound of a firearm being cocked, he slowly raises his head.")
	await novel_interface.show_text_only("Right in front of him, a camera is mounted. And beside it, a kidnapper in a black mask stands, pointing at him with a gun.")
	await novel_interface.show_text_only("The man desperately tries to look around. He spots a guard at the far end of the warehouse, holding an assault rifle.")
	await novel_interface.show_text_only("From the black bandanna covering their faces and the camouflage outfits, it’s quite obvious where these guys are from.")
	await novel_interface.show_text_only("The silver-haired man twists himself around to the best of his ability. At the periphery of his view, he sees a black flag...")
	await novel_interface.show_text_only("On the video-camera in front of him, a cell phone is mounted, playing the news at the highest volume.")
	await novel_interface.show_dialog("“Sir Lumbert, executive secretary of the Substance H Weapon Experiment Prohibition Treaty Organization, held a press conference today.”", "News")
	await novel_interface.show_dialog("“The organization plays an important part in keeping Substance H from being weaponized. It’s established based on the Universal Substance H Weapon Experiment Prohibition Treaty.”", "News")
	await novel_interface.show_dialog("“Sir Lumbert states that the organization has currently established a large number of monitoring stations all around the world, in order to oversee all Substance H experiments.”", "News")
	await novel_interface.show_dialog("“Lumbert believes that military cooperation between Academy Cities should become a normalized part of their diplomatic relations.”", "News")
	await novel_interface.show_dialog("“He claims to support Masada Ford’s development and experimenting of their passive riposte system. He explains that a reasonable amount of intimidation is the true basis of maintaining peace.”", "News")
	await novel_interface.show_dialog("“He also publicly asks for an opportunity to have a conversation with Dr. Mariru Von Braun of New Opulentia Academy of Sciences...”", "News")
	await novel_interface.show_text_only("Hearing this, the man tied on the chair smirks slightly.")
	await novel_interface.show_text_only("His impeccable silver hair is combed back. Cerulean eyes gaze nonchalantly at a few photos tacked on the wall across.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("On a faded photo, a few workers in hazmat suits are dealing with piles of dead bodies.")
	await novel_interface.show_text_only("Judging from the low resolution of the photos, they must have been taken with an SLR camera and old-fashioned film.")
	await novel_interface.show_text_only("He clearly remembers that, back at that time, they had used strong electromagnetic interference waves within a radius of several miles to keep others from filming the area.")
	await novel_interface.show_text_only("According to the date on the bottom left, the photo was taken three years ago by the shore of Churun River, at the Guyana Shield...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Click!")
	await novel_interface.show_text_only("The man in black snaps the phone shut and, out of nowhere, kicks the silver-haired man on the stomach.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Ugh! *coughing*", "Man in Suit")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Can’t stand how fake you look on TV, eh, Sir?", "Kidnapper")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Fake?\nI was... sincere.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The man in black approaches Lumbert, grabs his hair and yanks his head backward, forcing him to directly face the one light source in the room.")
	await novel_interface.show_text_only("He then pulls out a scythe and aims it at Lumbert’s eye.")
	await novel_interface.show_dialog("Well, I wonder how much your face is worth?", "Kidnapper")
	await novel_interface.show_text_only("With the light shining directly in the man’s eyes, his cerulean pupils dilute rapidly.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("So, what do you say? Name your price.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert sneaks a glance at the Damascus Steel blade pointing at his eyeball.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("You sneaked into New Opulentia, got hold of my full schedule, and finished off all my bodyguards within two minutes...", "Lumbert")
	await novel_interface.show_dialog("And even managed to obtain those photos...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("No way you did all that just to film a video of me being beheaded. You must have some other motive.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert’s clear-headed reasoning takes the man in black by surprise.")
	await novel_interface.show_text_only("He releases Lumbert from his chokehold, and slaps a sheet of paper onto his face.")
	await novel_interface.show_dialog("Well, let’s get the ball rolling then. I’ll give you sixty seconds to answer me. Deal or no deal?", "Kidnapper")
	await novel_interface.show_text_only("The paper slides onto Lumbert’s pants. He looks down—printed on it is twelve encrypted currency accounts and actual prices.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Hmm. You’ve got some degree of self control. That’s good to see.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert glances outside the window. The day seems to be dawning.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(After keeping me hostage for twelve hours, they began a negotiation with a clear objective in mind.)")
	await novel_interface.show_text_only("(Only experienced kidnappers do that. They must be well-trained...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert squints down at the figures listed on the sheet of paper.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("If I take the exchange rate into account, it seems that these numbers are in accord with the bail for the list of terrorists the United Council has recently posted...", "Lumbert")
	await novel_interface.show_dialog("You’re not from the Resistance, huh?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert’s sudden question catches the kidnapper off guard.")
	await novel_interface.show_dialog("Huh?", "Kidnapper")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("I applaud you for your effort to act like terrorists, but I bet you’re sent by Menorah from Masada Ford—", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Shut it!", "Kidnapper")
	await novel_interface.show_text_only("The man in black marches briskly towards Lumbert, ready to knock him out.")
	await novel_interface.show_text_only("And the latter suddenly raises his voice, shouts in Hebrew:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(Hebrew) Bomb! Get down!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The guard at the far end of the warehouse instinctively raises his arms to cover his head and, after realizing it’s a trap, grabs his weapon and aims at Lumbert.")
	await novel_interface.show_text_only("The man in black certainly did not expect this. But it’s obvious that their cover is blown from his comrade’s reflexive actions.")
	await novel_interface.show_text_only("Lumbert smiles, mockingly.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("So is this the script you’re following? I’ve been kidnapped by terrorists from the Resistance, who claim to be in possession of evidence of the United Congress performing illegal Substance H experiments...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert glances at the photos on the wall once again.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("I’m currently the only person who’s publicly shown support towards Masada Ford for constructing automatic counterattack systems for intimidation purposes. It’s reasonable for the Resistance to abduct me.", "Lumbert")
	await novel_interface.show_dialog("I’m quite a well-known figure, so this will be all over the news. More will begin to see the Resistance as crazy terrorists.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("And you can also use those photos to force the United Congress to cough up money in the form of encrypted currency... killing three birds with one stone.", "Lumbert")
	await novel_interface.show_dialog("The transaction of encrypted currency is fully visible on the public channel. Once they pay up, it’ll be like they’ve publicly admitted that they’ve conducted illegal Substance H experiments before.", "Lumbert")
	await novel_interface.show_dialog("In the future, Masada Ford will be able to use this to threaten the other Academy Cities to support your passive riposte system. No one will dare to refuse any of your requests.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("His analysis is 100% accurate. The man in black freezes in shock, unsure what to do.")
	await novel_interface.show_text_only("Despite being restrained, Lumbert now has the upper hand.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("You chose to use edited news footage so that you won’t have to talk much and I won’t notice your accent.", "Lumbert")
	await novel_interface.show_dialog("But the brand of the camera... the black flag behind me... that Damascus scythe... that’s overkill, don’t you think?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert pauses, smirking at the flustered man in black.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("As far as I can tell, you guys must have been ex-recruits who worked under Menorah before you were kicked out.", "Lumbert")
	await novel_interface.show_dialog("I heard that even those who didn’t pass their tests can still work as special mercenaries of sorts, as long as they pass the “ideology review”.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("So disposable minions like you are tasked with carrying out politically-controversial operations such as this one. That way, if you die, it won’t affect them anyway.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Kidnapper")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("You’re probably under strict orders to not harm me. After all, I’m Masada Ford’s only supporter right now.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("But hey, I’ve got a good opportunity for you and your buddy—", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("From what I know about the standard Menorah combat squad composition, you and that guard over there aren’t the only ones on the team.", "Lumbert")
	await novel_interface.show_dialog("Outside this warehouse, there should be one technical combat member, one heavy firepower support, and one sniper. Am I correct?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert asks the man in black, every word clearly enunciated, eyes sharp and shrewd.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Share what you know with me, and I’ll agree to pretend to suspect nothing and continue playing along following this script you’ve got.", "Lumbert")
	await novel_interface.show_dialog("If you don’t, well, you’ll fail this mission. And who knows how the people in your organization will punish you if that happens?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh, okay! We... we’ll work with you!", "Kidnapper")
	await novel_interface.show_text_only("The man in black makes the decision right away. He turns around, seeking a wrench to free Lumbert with.")
	await novel_interface.show_text_only("Suddenly, out of nowhere, comes the sound of something slicing through the air—")
	await novel_interface.show_text_only("The man in black freezes in place, as if petrified.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("What—", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Before Lumbert can finish his question, all lights in the warehouse blow out.")
	await novel_interface.show_text_only("From outside comes several loud bangs.")
	await novel_interface.show_text_only("Boom!\nCrash!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("A powerful blast of air sends all windows of the old warehouse flying. Multiple blinding spotlights invade the space all at once.")
	await novel_interface.show_dialog("Nobody move!", "Defense Bureau Soldier")
	await novel_interface.show_text_only("Under the early morning sky, a dozen of Metropolitan MD special police come pouring in. They take down the guards outside the warehouse in seconds and rush towards Lumbert.")
	await novel_interface.show_text_only("The loud noise of the helicopter propeller blocks out all other sounds.")
	await novel_interface.show_text_only("Lumbert is helped to his feet by the rescue team, calmly shaking his sore arms and legs.")
	await novel_interface.show_text_only("A team member snaps a picture of what used to be the man in black. His body has been cleanly sliced in two from the waist. With a dull thump, the top half slides to the ground.")
	await novel_interface.show_text_only("While the bottom half—his two legs—are still standing there.")
	await novel_interface.show_text_only("The surrounding rescue team members stare in confusion at this strange corpse.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("So they weren’t the ones who killed him. Therefore, it must be...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("—Wait, the pictures!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert turns to the wall, previously covered by photos. The photos are all gone.")
	await novel_interface.show_text_only("In a dark corner, a blind spot free from the surveillance cameras, a long, bloody strand of black hair silently disappears into the night...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
