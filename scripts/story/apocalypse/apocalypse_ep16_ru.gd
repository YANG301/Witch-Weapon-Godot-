	await novel_interface.show_dialog("Месть?", "Лиан")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Что ж, этот секрет я должен сохранить.", "Беатрис")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Беатрис смотрит вверх, на звездное небо.")
