# apocalypse_ep16.gd - 天启篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第16话剧本
	apocalypse_ep16_script()

func play_script():
	pass

# 天启篇第16话 - 正式剧本
func apocalypse_ep16_script():
	novel_interface.show_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Лицо Сони краснеет в тусклом желтом свете. Капли воды стекают по ее стройным голым икрам, оставляя на земле лужу.")
	await novel_interface.show_text_only("Она сидит на мраморном краю фонтана, как беспомощное животное. Она смотрит на меня невинными, но такими завораживающими глазами…")
	await novel_interface.show_text_only("Мое сердце подпрыгивает, и я чувствую, как мое лицо горит.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Соня...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я был в ужасе, когда услышал ее предысторию, и мне больше ничего не хотелось, чтобы найти ее и немедленно утешить. Но сейчас мой мозг совершенно пуст.")
	await novel_interface.show_text_only("Что-то вроде тех неуклюжих идиотов, которых вы видите в манге: они идут к своему возлюбленному, чтобы признаться в порыве фальшивой бравады, а затем забывают все, что они репетировали, как только видят влюбленного.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Мозг, сделай что-нибудь! Боже!)", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","smile",0.25)
	await novel_interface.show_dialog("Эй...", "Соя")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Соня облизывает губы и тихо улыбается.")
	novel_interface.show_character("ren_fishnet","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Ты пахнешь... интересно...", "Соя")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она ползет в мою сторону по мраморной ступеньке. Я вижу узор в виде улья на ее браслете, отражающийся от света.")
	await novel_interface.show_text_only("Это браслет, изготовленный нашим SRD из броневых материалов Substance H. Выглядит хлипко, но на самом деле очень прочно.")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("Как я и ожидал...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня хватает меня за руку, прижимает нос к моему животу и жадно вдыхает.")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Рен действительно лучший!", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("Ч-что?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В замешательстве я делаю несколько шагов назад. Что с ней случилось в те минуты, когда меня не было?")
	await novel_interface.show_text_only("Соня лениво садится на мраморную ступеньку и приглаживает волосы.")
	novel_interface.show_character("ren_fishnet","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","smile",0.25)
	await novel_interface.show_dialog("Эльгана рассказала тебе, да?", "Соя")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Твое тело... просто... что с тобой случилось?", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Я не хотел, чтобы ты знал.", "Соя")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Соня отворачивается, голос становится тише.")
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("Все, кто знает мою тайну, в конечном итоге отдаляются от меня...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не могу не вспомнить, как недавно Эльгана разговаривала с Соней.")
	await novel_interface.show_text_only("Она знает, что Соня долго не проживет, и, наверное, подумала, что лучше держаться подальше. Когда произойдет неизбежное, будет меньше боли, верно?")
	await novel_interface.show_text_only("Кроме того, Эльгана религиозна. Девушка, которой запрещено входить в святые здания, могла показаться ей дурным предзнаменованием.")
	await novel_interface.show_text_only("Удостоверение личности, подтверждающее ее титул Рыцаря Правосудия, вместо того, чтобы предоставлять ей высший иммунитет, на самом деле действует как своего рода приказ об изгнании...")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Но это нормально. Я знаю, ты не будешь таким, как они...", "Соя")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Верно?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— осторожно спрашивает Соня, глядя на меня. Мои губы слегка дрожат, и я приближаюсь, чтобы погладить ее по голове.")
	await novel_interface.show_text_only("Соня улыбается, закрывает глаза и толкается в мою ладонь.")
	await novel_interface.show_text_only("Затем она потягивается и смотрит на фреску наверху церкви, такую великолепную под ночным небом.")
	await novel_interface.show_dialog("Наверное, он меня теперь ненавидит...", "Соя")
	await novel_interface.show_dialog("Хотя, думаю, он меня все равно никогда не любил.", "Соя")
	await novel_interface.show_text_only("Я собираюсь спросить ее, кто такой «он», когда Соня взглянула на мое платье и ухмыльнулась.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Ну, у тебя много своих секретов, не так ли?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Что?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она обнимает меня прежде, чем я успеваю среагировать.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Знаешь, почему я некоторое время назад не спросил Мариру о твоей личности?", "Соя")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("Потому что я хочу сам найти ответ на эту увлекательную загадку!", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("Эй!", "Лиан")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Н-не-", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мой телефон внезапно звонит. Беатрис. Соня все еще обнимает меня, даже когда я отвечаю на звонок.")
	await novel_interface.show_text_only("Мне приходится одной рукой держать телефон, а другой пихать Соню, тщетно пытаясь удержать ее руки от меня. Моя ладонь приземляется на ее нос и рот.")
	await novel_interface.show_dialog("Мммфф! Ммфф!", "Соя")
	await novel_interface.show_dialog("Рен? Я в больнице.", "Беатрис")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Беатрис! Как Джон?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня вскакивает и выхватывает мой телефон, включив его в режим трансляции.")
	await novel_interface.show_dialog("Они подключили его к аппарату... нужно ввести ему немного жидкости. Его жизни ничего не угрожает. Он сейчас спит, ему вкололи обезболивающее.", "Беатрис")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("... О, так он чувствует боль?", "Соя")
	await novel_interface.hide_character()
