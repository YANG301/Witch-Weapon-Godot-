# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Беатрис поднимает одну ногу, ставит ее на перила, и кричит в микрофон.")
	await novel_interface.show_text_only("Стереосистема, включенная на полную громкость, доносит ее голос до самого конца улицы Электроники.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Вы все мусор!", "Беатрис")
	await novel_interface.show_dialog("Идите к черту, извращенцы!", "Беатрис")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("Что?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Э-э...", "Соя")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Она просто... говорит это, чтобы привлечь внимание, верно? Она не это имеет в виду, верно?)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("И привлечь внимание ей удалось. Все взгляды сейчас прикованы к ней.")
	await novel_interface.show_text_only("Как только пешеходы видят лицо Беатрис, они уже не могут отвести взгляд. Они стоят с открытыми ртами, восхищаясь ее блестящими красными высокими каблуками и соблазнительной тенью под ее мини-юбкой.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Фигня вы все! Грязные ошибки! Вам бы хотелось, чтобы я затоптал вас всех до смерти, не так ли?", "Беатрис")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Тебе не стыдно?", "Беатрис")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Может быть, она действительно это имеет в виду...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Сейчас большинство людей на улице смотрят. Даже талисманы, которые танцевали на крышах других грузовиков, останавливаются в своих выступлениях, чтобы посмотреть зрелище.")
	await novel_interface.show_text_only("Мы с Соней пользуемся возможностью подняться по лестнице на борту грузовика Эллуки.")
	await novel_interface.show_text_only("Девушка сидит на троне, удовлетворенно поглаживая свой выпуклый живот. Перед ней на столе для подношений лежат десятки пустых тарелок.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Она... съела все это?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я осматриваю окрестности, прикидывая, как лучше вынести этого пухлого обжору из всей этой каши, но Эллука просто бросается на меня.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Мисс Рен!", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я прижимаю палец к губам, показывая ей, чтобы она прижимала его…")
	await novel_interface.show_text_only("А она уже подскочила в воздух, целясь прямо мне в лицо...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("О, верно. Когда я впервые увидел Эллуку, она сражалась с ведьмами в воздухе, не так ли?")
	await novel_interface.show_text_only("Я помню, как Ая рассказывал мне, что эта девочка, лет одиннадцати-двенадцати, судя по возрасту ее костей, перенесла десятки операций и в ее тело было установлено бесчисленное количество механических деталей.")
	await novel_interface.show_text_only("Ее память стиралась слишком много раз — она даже не помнит, когда ее собственный левый глаз был заменен электронным глазным протезом военного уровня.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Со всеми этими механическими деталями внутри нее, хотя она и способна плавать, используя преимущества электромагнитного поля, ее реальный вес на самом деле вдвое больше моего…")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Туп!")
	await novel_interface.show_text_only("Эллука приземляется на меня, сжимая бедрами мои ребра, мягкий живот прикрывает мое лицо. Ее пухлые руки сжимают мою шею сзади.")
	await novel_interface.show_text_only("Клянусь, я слышал, как мой позвоночник сломался от давления.")
	await novel_interface.show_text_only("Она обхватывает всем своим телом мою грудь, мою голову, уткнувшись щекой в мои волосы, как восторженная кошка.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Мисс Рен моя любимая! *ик*", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Судя по ее ликующему красному лицу и невнятному голосу, можно было подумать, что она пьяна.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Я услышал этот громкий треск... это твои кости?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я стою, застыв на месте. Такое ощущение, что моя шея сломается пополам, если я сдвинусь хотя бы на малейшее движение.")
	await novel_interface.show_text_only("Кажется, суматоха привлекла внимание находящихся поблизости женщин. Некоторые даже указывают на нас пальцем, спрашивая: «Что это?»")
	await novel_interface.show_text_only("Я сейчас выгляжу как большеголовый монстр в сетчатых чулках. Неудивительно, что они в замешательстве.")
	await novel_interface.show_text_only("Заметив наше затруднительное положение, Беатрис повышает голос, как будто желая выиграть нам еще немного времени для эвакуации.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Вам всем место на свалке! Ни грамма порядочности в ваших головах! Личинки! Жутко! Свинья!", "Беатрис")
	await novel_interface.show_dialog("Все вы—", "Беатрис")
	await novel_interface.show_dialog("Умри!", "Беатрис")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Два динамика хором сверкают, когда страстная речь Беатрис достигает своего апогея.")
	await novel_interface.show_text_only("И, наконец, они взрываются вместе с лампочками на близлежащих освещенных рекламных щитах.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Вся улица погружается в жуткую тишину.")
	await novel_interface.show_text_only("Толпа все еще потрясенно смотрит на рыжеволосую даму, стоящую во всей своей красе на крыше грузовика.")
	await novel_interface.show_text_only("Соня использует кратковременное отвлечение, чтобы оторвать Эллуку от меня, а затем толкает ее себе на спину.")
	await novel_interface.show_text_only("Младшая девочка, прилипшая ко мне, как жвачка, мгновенно засыпает.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Ух... не ожидал, что этот паршивец будет так много весить...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вздыхаю, наконец успев отдышаться, массируя талию и осматривая сцену. Оно по-прежнему пугающе тихо.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Эти ребята окаменели или что?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но несколько мгновений спустя по толпе раздаются аплодисменты. Громкие, чудесные аплодисменты.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Аааа! Она замечательная! Ты замечательный!", "Прохожий А")
	await novel_interface.show_dialog("Наступи на меня, моя королева!", "Прохожий Б")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("Что?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Волны и волны восторженных аплодисментов разносятся по всей улице.")
	await novel_interface.show_text_only("Толпа бунтует от чистого волнения.")
	await novel_interface.show_text_only("Из черных бронированных грузовиков на другой стороне улицы выпрыгивают несколько солдат с автоматическим оружием, в замешательстве наблюдая за внезапным шумом.")
	await novel_interface.show_text_only("Я жестикулирую в их сторону, пытаясь предупредить Беатрис, и тут случайно замечаю ее лицо...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("О, дорогая...", "Лиан")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Она... такая красивая!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Теплый покалывающий поток, очень похожий на желание, мгновенно распространяется по моему телу.")
	await novel_interface.show_text_only("Щеки горят, ноги подкашиваются...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Я хочу ее...)", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("... Рен?", "Соя")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Толпа выходит из-под контроля. Они как один набрасываются на грузовик Беатрис, громко напевая на ходу, до такой степени, что хлипкая машина вот-вот опрокинется.")
	await novel_interface.show_text_only("Некоторые парни пытаются взобраться на грузовик сбоку, но Беатрис просто наступает на их цепкие руки и пинает их обратно.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Да! Еще! Топни и меня! Пожалуйста, моя королева!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Беатрис улыбается и качает головой, увидев выражение явного идиотизма на моем лице, затем снова застегивает браслет.")
	await novel_interface.show_text_only("Затем она вытаскивает из груди серебряную капсулу размером с большой палец и бросает ее в обезумевшую толпу под ее ногами…")
	await novel_interface.show_text_only("В облаке белого дыма бесследно исчезает прекрасная Беатрис.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Однако я до сих пор не могу забыть ее потрясающее лицо — пока Соня не тянет меня за руку.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Вылезай из этого! Солдаты идут! Кроме того...", "Соя")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Когда дым рассеивается, толпа начинает в замешательстве роптать, понимая, что объекта их внимания больше нет.")
	await novel_interface.show_text_only("Мы с Соней едва успеваем отойти от толпы на несколько шагов, как фан-клуб Эллуки замечает, что их кумир исчез.")
	await novel_interface.show_dialog("Где леди Эллука?", "Королевская гвардия А")
	await novel_interface.show_dialog("Там! Этот в чулках в сеточку забрал нашу Леди Эллуку!", "Королевская гвардия Б")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Чулки в сеточку? Леди Эллука?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Похититель! Вызовите полицию!", "Королевская гвардия С")
	await novel_interface.show_dialog("После них!", "Королевская гвардия А")
	await novel_interface.show_text_only("К нам мчится группа разъяренных мужчин, за ней следует несколько полицейских.")
	await novel_interface.show_text_only("Да ладно, какой похититель носит чулки в сетку?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Беги!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но нам сложно стряхнуть толпу, тем более, что Соня несет пухленькую Эллуку, а моя поясница все еще пульсирует от боли.")
	await novel_interface.show_text_only("Что еще хуже, впереди патрулируют копы...")
	await novel_interface.show_text_only("Мы не можем драться. Мы не можем бежать. Это безнадежно.")
	await novel_interface.show_text_only("Внезапно позади нас раздается звук бьющегося стекла.")
	await novel_interface.show_text_only("Блондин в черной ветровке опрокинул на улице светящийся рекламный щит старой школы.")
	await novel_interface.show_text_only("Осколки рекламных лампочек покрывают землю. Пешеходы, изо всех сил стараясь их избежать, эффективно тормозят фан-клуб Эллуки.")
	await novel_interface.show_text_only("Блондин улыбается нам с Соней с невинным и милым лицом.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Впереди есть короткий путь. Пойдем со мной?", "Мальчик в очках")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мы с Соней переглядываемся. Почему это похоже на сценарий из фильма?")
	await novel_interface.show_text_only("Молодой человек в очках, с пышными светлыми волосами, клетчатой рубашкой и лазурными глазами кажется довольно застенчивым.")
	await novel_interface.show_text_only("Он выглядит почти смущенным нашим отсутствием реакции и спешит объяснить:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Я... Я работаю неполный рабочий день в магазине здесь... Я только что закончил работу...", "Мальчик в очках")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Он смотрит на мои ноги, сглатывает и отворачивается.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Ух ты, это действительно не лучший способ украдкой поглядывать на девушек...)\n(Это слишком очевидно...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Ты... ты выглядел так, будто тебя преследовали какие-то злодеи, поэтому я подумал...", "Мальчик в очках")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Плечо Сони опускается, и она ненадолго теряет бдительность.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("Судя по его ауре, он не хочет нам зла.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На самом деле, учитывая все обстоятельства, МЫ здесь злодеи...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Прокладывайте путь!", "Соя")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
