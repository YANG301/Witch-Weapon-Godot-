	novel_interface.show_character("cereza","smile")
	await novel_interface.show_dialog("Ладно-ладно, оставим догадки на потом. Пойдем сейчас.", "Тереза")
	await novel_interface.show_dialog("Первая авеню, где находится штаб-квартира Объединенного Конгресса, уже затоплена протестующими. Ситуация скоро выйдет из-под контроля.", "Тереза")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Кроме того, разве ты уже не обещал дедушке?", "Тереза")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тереза похлопывает Рафилию по спине и что-то шепчет ей на ухо.")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("(Тереза не выглядит европейкой...)\n(И катану несет в торговом районе, вот так? Почти как будто выставляет ее напоказ...)", "Лиан")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Хотя правда, что оружие такого типа в этой зоне не запрещено...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("После того, как они заканчивают свой небольшой разговор шепотом, Рафилия кивает Терезе и жестом предлагает всем вместе спуститься вниз.")
	
	# scene2 - 夜晚电器街
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Мы покидаем художественную галерею и выходим на улицу.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Солнце едва зашло. Уличные фонари уже горят, освещая шумную улицу Электроники своим теплым желтым светом.")#不确定
	novel_interface.show_character("iluka_uniform","speechless")
	await novel_interface.show_dialog("Ого...", "Эллука")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Это много людей...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Здесь происходит какое-то событие?", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Я только что проверил онлайн. Похоже, многим магазинам пришлось временно закрыться из-за недавнего ограничения движения...", "Антураж")
	await novel_interface.show_dialog("Но вчера вечером ограничение было снято, и грандиозное мероприятие по открытию, запланированное на следующий понедельник, тоже перенесено на сегодня.", "Антураж")
	await novel_interface.show_dialog("Участники мероприятия получат бесплатный ограниченный мерч из некоторых аниме.", "Антураж")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("К-может быть...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я заметил, что многие пешеходы держат маленький желтый флажок с надписью «Доступ ограничен». Этот предмет часто можно увидеть в одном из самых популярных аниме в наши дни.")
	await novel_interface.show_text_only("Это аниме состояло из очаровательных девочек в форме детского сада, усердно работающих с флажками в руках. Многие зрители влюбились в эту явную привлекательность, включая меня.")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("(О, это из того сериала!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не могу не волноваться.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Хм?", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Э-э, ничего, ничего...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я быстро скрываю свое волнение. Теперь я в значительной степени профессионал в этом.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Я должен идти. Ребята, вам тоже лучше уйти.", "Рафаэль")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Такое ощущение, что сегодня вечером произойдет что-то безумное.", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия сует мне в руку зеленый драгоценный камень размером с мрамор.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Генриетта сделала это. Это может пригодиться, если кто-то пострадает.", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия решительно избегает моего взгляда, выглядя очень смущенной.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Ох... Генриетта, да...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прошло много времени с тех пор, как я в последний раз слышал об этом алхимике, который настаивал на том, чтобы называть меня «Мастером».")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Интересно, что бы она подумала, если бы узнала, что теперь именно мне приходится называть других Мастером в костюме горничной...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("В любом случае, берегите себя.", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем я успеваю ответить, Рафилия исчезает вместе с Терезой и ее свитой.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Я наблюдаю, как они исчезают в толпе на улице Электроники.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Хм, она все еще обнимает ту книгу, которой только что ударила меня по голове...", "Соя")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Неудивительно, что она так торопится уйти!")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Эй, а что, если мы тоже проверим это событие, прежде чем отправиться обратно?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я бы тоже хотел получить свой собственный маленький желтый флаг. Но прежде чем я успеваю закончить предложение, Соня швыряет меня о стену.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Тебе это нравилось, да? Думаешь, шокировать меня браслетом - это очень весело, да?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("О, нет...\nП-прости!", "Лиан")
	# removed legacy empty placeholder comment
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я понимаю, что, возможно, слишком рано ослабил бдительность.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Я задавался вопросом с сегодняшнего дня...", "Соя")
	await novel_interface.show_dialog("…", "Лиан")
	await novel_interface.show_dialog("Тереза, Рафилия и Эллука...", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(Они трое? Что у них общего?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Их ауры пахнут ведьмами, но имеют человеческие цвета.", "Соя")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Это не то, чего я ожидал.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня сильно тычет указательным и средним пальцами мне в сердце. Ее глаза стальные, холодные и решительные. Ясно одно:")
	await novel_interface.show_text_only("Если я солгу, я умру.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Ты имеешь в виду... Тереза тоже одна из таких людей?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Один из тех людей?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не спускаю глаз с лица Сони, пытаясь подобрать нужные слова.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Мол, девушки, получившие «информацию» магии, но еще в здравом уме.", "Лиан")
	await novel_interface.show_dialog("Некоторые из них не могут нести бремя знаний и теряют рассудок, становясь тем самым теми ведьмами, которых хочется убить.", "Лиан")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Между ними есть разница.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня, не спуская с меня глаз, говорит:")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Итак, те, кто потерял рассудок... смогут ли они выздороветь?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Теоретически нет. По крайней мере, так сказала Ая...", "Лиан")
	await novel_interface.hide_character()
	
