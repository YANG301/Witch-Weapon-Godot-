# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Não. Esses idiotas são todos homens!", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No braço direito de Beatrice há uma pulseira feita de metal verde musgo, brilhando suavemente em um tom azul claro.")
	await novel_interface.show_text_only("Uma invenção de Aya. Feito de uma liga especial que bloqueia os efeitos da Substância H do meme. Pode ser usado para suprimir os efeitos da “maldição” de Beatrice.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Espere, o que você está planejando—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Lembro-me de Mariru me contando há algumas semanas sobre a “maldição”. Qualquer homem que vir Beatrice imediatamente se apaixonará perdidamente por ela.")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("Para ser exato, é o rosto dela que desencadeia o efeito.", "Mariru")
	await novel_interface.show_dialog("Através de uma série de testes conduzidos por Aya, eles descobriram que olhar diretamente para o rosto de Beatrice estimula fortemente o giro fusiforme e a amígdala no cérebro masculino.", "Mariru")
	await novel_interface.show_dialog("No entanto, só é eficaz se o alvo estiver olhando diretamente para ela em um raio de 260 pés. Fotos, vídeos ou reflexos não têm esse efeito.", "Mariru")
	await novel_interface.show_dialog("Depois que essa estimulação estiver em vigor por um período de tempo, o cérebro da pessoa afetada sofrerá mudanças irreversíveis. Isto mudará fundamentalmente a forma como agem.", "Mariru")
	await novel_interface.show_dialog("Eles ficam desesperados para tornar Beatrice deles. Mas, como não conseguem, ficam ansiosos, irritados, ressentidos. Isto pode até levar a automutilação, incêndio criminoso ou tendências violentas.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Que triste, hein? Amor não correspondido...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru solta um suspiro.")
	await novel_interface.show_text_only("Abro a boca para perguntar como exatamente Aya conduziu aquele experimento horrível, mas fecho novamente. É melhor se eu permanecer ignorante.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Felizmente eu não fui uma de suas cobaias...)", "Lian")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Espere! Quando você me fez explicar coisas para Beatrice sozinha com “aquela roupa” ontem...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Isso também foi um experimento de Aya?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Você só percebeu agora?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Então foi?")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hmm, então você provavelmente ainda não percebeu que a pulseira que Beatrice usou ontem era falsa, né?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru brinca, parecendo um pouco desapontada com minha falta de habilidade de observação.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("A razão pela qual fiz você usar essa roupa foi para evitar que seus pensamentos subjetivos atrapalhassem os resultados dos nossos testes. O “constrangimento” que você estava sentindo cancelaria efetivamente seus “desejos”.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("E…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela estende a mão e coloca ambas as mãos em meus ombros. Em seu rosto há um sorriso sutil.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Você ficou muito bem com uma roupa de coelhinha da playboy!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aaaaaaaaa!\nNão podemos simplesmente parar de tocar nisso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Passei aquela hora infernal vestida de coelhinha da playboy, sozinha com Beatrice, em uma sala fechada.")
	await novel_interface.show_text_only("Eu estava tão nervoso que mal conseguia pronunciar uma frase inteira. Eu não conseguia nem andar direito.")
	await novel_interface.show_text_only("E Beatrice passou a hora me confortando, embora estivesse prestes a cair na gargalhada, tenho certeza.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aya disse que as imagens 3D do seu cérebro eram como um show de fogos de artifício. Ela realmente gostou, teria deixado aquilo continuar por muito mais tempo se sua pressão cerebral não estivesse um pouco alta.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("De qualquer forma, agora sabemos que, embora o seu cérebro reaja à maldição de Beatrice como o de qualquer homem normal, nenhum trauma será deixado para trás.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Por outro lado, outros homens sofrerão danos cerebrais permanentes após um período olhando para o rosto de Beatrice. O período varia de quarenta segundos a oito minutos.", "Mariru")
	await novel_interface.show_dialog("Então você está seguro. Você não está aliviado?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Certamente não estou aliviado!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ah, essa é outra das minhas memórias que eu gostaria de poder apagar.")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Então... se ela tirar a pulseira aqui...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sorri docemente para mim e depois me puxa para um abraço.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Tudo fica escuro na minha frente enquanto meu rosto é esmagado em seu peito.")
	await novel_interface.show_dialog("Hein?", "Lian")
	await novel_interface.show_dialog("Eu direi “vai”. Depois disso, você tem trinta segundos.", "Beatriz")
	await novel_interface.show_dialog("Pegue Elluka e nos separaremos e nos encontraremos no Newell Central Park. Menos manifestantes lá.", "Beatriz")
	await novel_interface.show_dialog("Entendeu?", "Beatriz")
	await novel_interface.show_text_only("Concordo com a cabeça, tentando o meu melhor para não pensar no peito macio em meu rosto.")
	await novel_interface.show_dialog("Ei, eu também quero uma vez!", "Soya")
	await novel_interface.show_text_only("“Clique”")
	await novel_interface.show_text_only("O fecho da pulseira se abre. A maldição está agora em vigor.")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("Aos olhos de Sonya, a Electronics Street agora é um mundo rosa.")
	await novel_interface.show_text_only("O mesmo tipo de rosa que ela viu cobrindo certos livros com conteúdo explícito quando eles estavam fazendo compras na livraria esta tarde.")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Você também é uma bruxa?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ah. Você pode dizer?", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Mas você não é como Elluka ou Raphilia...", "Soya")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("Você, assim como Ren, tem uma aura tão pura quanto a de um bebê!", "Soya")
	await novel_interface.show_dialog("... Isso é fascinante!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya exclama, balançando meus ombros de excitação.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Uau!\n(Pare com isso! Não consigo respirar!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Você parece pesar menos do que eu lembrava.\nVocê não é uma gracinha?", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A senhora peituda segura Ren ainda mais forte.")
	await novel_interface.show_text_only("Enquanto isso, Ren se debate desesperadamente, tentando escapar de seu abraço sufocante.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("... Enfim, quem é você?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ops, esqueci de me apresentar.\nMeu nome é Beatriz Portinari.", "Beatriz")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<90 minutos atrás>")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Zona Desmilitarizada Acordada, New Opulentia Stork Garden Hotel>")
	await novel_interface.show_text_only("<Fora do Birdsong Hall, o salão de banquetes no último andar>")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Uau, eles têm um jardim aqui no 99º andar. As pessoas no Palácio Hovering desfrutam de luxos como esse o tempo todo?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru examina os telhados de vidro, sorrindo sem entusiasmo.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Talvez quanto mais alto o jardim, mais luxuoso ele pareça? Ou talvez 99 seja o número da sorte do proprietário?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A loira coça a cabeça, confusa.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Como você decidiu que este leilão é o que estamos procurando?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fixa seu olhar no outdoor pintado com spray na entrada do salão de banquetes.")
	await novel_interface.show_text_only("Nele está o título “Leilão de outono do Museu Johnson”,\nseguido do subtítulo: onde a arte encontra as finanças.")
	await novel_interface.show_text_only("O texto branco parece especialmente chocante sobre o fundo azul. Nada de artístico nisso.")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("Este é realmente um leilão de obras de arte? Não me parece muito esteticamente agradável.", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru acena com a cabeça e sorri.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Mas todos os quinhentos assentos estão ocupados. Dos sessenta e três itens, sessenta já foram vendidos.", "Mariru")
	await novel_interface.show_dialog("Um total de 1,5 bilhão foi feito.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Tanto? Este leilão deve ser enorme, então.\nMas não ouvi nada sobre isso...", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("As contas criptografadas eletronicamente que você nos deu... contêm fundos no valor de bilhões.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("É muito, mas apenas o suficiente para construir dois arranha-céus deste tipo.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Para usar esta quantia de dinheiro para criar um impacto nos triliões de fundos de reconstrução que o Congresso Unido possui, só deveria haver uma maneira...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Suborno? É por isso que escolheram a moeda criptografada?", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("As contas podem ser criptografadas, mas quaisquer transações realizadas podem ser vistas por todos na rede. E uma transação desse tamanho – de jeito nenhum as pessoas não perceberão.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("É por isso que eles precisam de um motivo viável para a transação...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld inclina a cabeça para o lado, pensando. Então ela exclama:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Ah, é por isso que eles estão realizando um leilão!", "Skuld")
	await novel_interface.show_dialog("Antiguidades sem preço definido são uma boa desculpa para transações de grande valor. Coisas como porcelana, jade, pinturas antigas... ninguém piscaria se visse alguém oferecendo milhões por elas.", "Skuld")
	await novel_interface.show_dialog("E a transação também é realizada em território internacional. Torna impossível para os departamentos fiscais de diferentes nações coletar impostos.", "Skuld")
	await novel_interface.show_dialog("Tudo o que precisam é contactar ambos os lados do comércio e vender algum lixo sob o nome de algum museu privado.", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Mas eles não podem permitir que verdadeiros conhecedores de arte entrem no local, porque eles serão capazes de perceber algo que está acontecendo num piscar de olhos.", "Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("É por isso que todos os assentos estão ocupados!\nEles preencheram os assentos com seu próprio povo!", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dá um tapinha na cabeça de Skuld com aprovação.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Muito inteligente. Você provavelmente fica muito entediado na escola, né?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("O que você acha?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sorri para Mariru, parecendo orgulhoso.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Deixe-me dizer-lhe outra coisa, então.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Os “fundos de reconstrução do pós-guerra” são basicamente empréstimos concedidos pelo Congresso Unido. Os governos que lhes pediram empréstimos devem devolver o dinheiro ou enfrentarão a ira das seis principais nações.", "Mariru")
	await novel_interface.show_dialog("Mas, historicamente, nenhuma nação conseguiu reembolsar um empréstimo deste montante dentro do prazo. É aí que entra o espaço para negociação.", "Mariru")
	await novel_interface.show_dialog("O Comitê é podre de rico. Tudo o que desejam para si próprios é provavelmente o sector mais lucrativo, por exemplo infra-estruturas básicas como energia e comunicações.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Eles podem simplesmente fazer uma proposta aos chefes dos governos que pediram dinheiro emprestado: que não precisarão de devolver o montante emprestado desde que entreguem permanentemente ao Comité 30% das acções da sua rede de telecomunicações.", "Mariru")
	await novel_interface.show_dialog("Os governos, incapazes de pagar os empréstimos, normalmente concordarão. Alguns dos líderes nacionais podem até solicitar descontos activamente em privado.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Então, como é que o Comité ganha controlo sobre os “setores” que deseja?", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Eles têm que convencer o Congresso Unido a permitir que as empresas multinacionais possuam fundos e tenham um certo grau de autonomia...", "Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Isso é pedir muito. Eles realmente concordarão?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Em vez de responder, Mariru simplesmente faz outra pergunta.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Esta arte pintada com spray parece que foi feita por um aluno do jardim de infância. O que isso lhe diz?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Que quem fez isso não estava se esforçando o suficiente para esconder o fato de que é tudo falso.", "Skuld")
	await novel_interface.hide_character()
	
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Muito dinheiro está envolvido, no entanto. Tiveram que alugar o último andar do hotel e contratar centenas de pessoas. Eles já gastaram muito – então por que não gastaram muito com gráficos também?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Bem…", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld faz beicinho, perplexo com todas as novas informações.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Bem, é porque isso não é novidade para eles. Já aconteceu inúmeras vezes. Tanto aqui como em outro lugar.", "Mariru")
	await novel_interface.show_dialog("Ninguém jamais suspeitou ou os denunciou. Então eles não se preocupam mais em esconder isso.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("O suborno é uma arte em si, especialmente este tipo dissimulado de suborno. Eles precisam coletar uma quantidade imensa de informações e garantir que todos os envolvidos estejam satisfeitos em todos os níveis.", "Mariru")
	await novel_interface.show_dialog("Muitas investigações precisam ser feitas. Inúmeras pessoas passam a fazer parte da operação. Trocas de benefícios, como esta que vemos hoje, já aconteceram inúmeras vezes.", "Mariru")
	await novel_interface.show_dialog("Eles terão que negociar com muitas pessoas. Funcionários, canais de comunicação social, alianças de trabalhadores, organizações não governamentais, mesmo aqueles que ocupam posições elevadas no crime organizado.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("É assim que influenciam as principais decisões tomadas pelo Congresso Unido.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru acena para a porta fechada do salão de banquetes.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Isso é o que realmente vale mais neste leilão.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld abaixa a cabeça e suspira.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Isso é péssimo... parece tão desonesto...", "Skuld")
	novel_interface.change_expression("talk")
	await novel_interface.show_dialog("Espere, foi isso que você planejou desde o início?", "Skuld")
	await novel_interface.show_dialog("Você não queria prender aqueles mentores que manipulavam o projeto de reconstrução...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, a porta do salão de banquetes se abre por uma pequena fresta. Fabella estende a mão, dando-lhes um sinal de OK.")
	await novel_interface.show_text_only("É o sinal de que todos os itens foram vendidos e que a transação entre as contas criptografadas eletronicamente está prestes a acontecer.")
	await novel_interface.show_text_only("Mariru pega seu walkie-talkie.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Equipe de resgate, bloqueiem todas as entradas do 99º andar, incluindo o poço do elevador. Alerte o hotel que uma grande dose de substâncias radioativas poluentes foi detectada no 98º andar.", "Mariru")
	await novel_interface.show_dialog("Corte todos os sinais de rede e meios de comunicação do edifício. Assim que eu disser vá, imponha silêncio no rádio.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Vá!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# scene6 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice finalmente me deixa respirar. Ela me incentiva a me virar para ficar de costas para ela e sussurra em meu ouvido.")
	novel_interface.show_character("beatrice_regular","smile1")
