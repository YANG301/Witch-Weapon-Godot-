# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("優秀な品格を学べと、私達はずっと\nそう教わってきた。")
	await novel_interface.show_text_only("キュリー夫人が幼い頃、読書で凄まじい集中力を\n見せた逸話は今でも多くの人々に知られている。")
	await novel_interface.show_text_only("ある日、姉やクラスメートがイタズラで\nこっそりと彼女の後ろに椅子を積み重ねた。\nほんの少しでも動くと椅子は落ちてしまう。\nそんな状況に彼女は知らずと陥った。")
	await novel_interface.show_text_only("しかし彼女が本を読み終わっても積み重ねた\n椅子は、どれ一つとして崩れなかったのだ。")
	await novel_interface.show_text_only("このような品格を持ってして、その後に夫人は\n史上初の2度のノーベル賞獲得を成し遂げる──")
	await novel_interface.show_text_only("……では、貴方に質問をしよう。\n\n今までの人生でこう思った事はないだろうか？")
	await novel_interface.show_text_only("「人々が1つの物事に対して感じる情報量は\n　生まれつき同じなのだろうか？」")
	await novel_interface.show_text_only("知識を吸収し続けて、毎日の睡眠時間は短く……")
	await novel_interface.show_text_only("大量の情報を脳に記憶し……\n\n長時間の集中力を持続させる……")
	await novel_interface.show_text_only("多くの人々が挫折、あるいは継続の難しい事を\n生まれながら簡単にできてしまう人がいる。\nそんな可能性はあるのだろうか？")
	await novel_interface.show_text_only("もしかすると、あのポーランド人の幼い少女が\n物理学の本を読んでいる時と、\nあなたが集中してマンガを読んでいる感覚は\n同じなのかもしれない。")
	await novel_interface.show_text_only("いわゆる「品格を磨く」とは、遺伝子レベルで\n決められた「好みや苦手」に対し、\n無駄な抵抗をするという事に他ならないのだ。")
	await novel_interface.show_text_only("あなたは今までこのような思考を持った事が\n無かったかもしれない──")
	await novel_interface.show_text_only("だが今、この瞬間あなたの脳内に新たな思考が\nひとつ植え付けられた。")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("さて……")
	await novel_interface.show_text_only("次に同じ思考が頭の中によぎった時、\nそれは本当にあなた自身の思考なのだろうか？\n\nそれとも……")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…………")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("カシャン。")
	await novel_interface.show_text_only("――銃に弾丸を込めた音がする。")
	await novel_interface.show_text_only("NTBCニュースチャンネルの軽やかな\nオープニングに合わせて、\nおなじみの女性アナウンサーの声が\n聞こえてきた。")
	await novel_interface.show_dialog("「第4回国際平和フォーラムは3日後、\n　新豊洲の協定非武装地域内で行われます」", "ニュース")
	await novel_interface.show_dialog("「新豊洲市は最大の科学研究システムを保有する\n　中立都市として──」\n「今週中に他五大学園都市からの交流団を\n　迎える事となりました」", "ニュース")
	await novel_interface.show_dialog("「今回の平和フォーラムにおいては異質物の\n　エネルギー活用や、」\n「『再建計画』など各種の重要な議題について\n　話し合いが行われる模様です」", "ニュース")
	await novel_interface.show_dialog("「また、マサダブルクの議長は近日行われた\n　非公式演説において、」\n「西アジアの秩序の再建を図るため、新たなる\n　軍事方針を近く公表すると宣言しております」", "ニュース")
	await novel_interface.show_dialog("「これに対し、サモントンニュース部門の\n　担当者はコメントを控えており……」", "ニュース")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("──旧式の倉庫内\n\n薄暗いランプから電流の音がした。")
	await novel_interface.show_text_only("白き灯りが片隅にいる銀髪の男を照らす。")
	await novel_interface.show_text_only("彼は頑丈な椅子に縛られていた。\n\n椅子の脚は地面の鋼鉄板にしっかりと溶接され、\n微動だにできない様子である。")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("覆っていた顔のカバーが外されると\n彼の視界は光を感じ取る。\n質の悪い船舶用ワイヤーが擦れて、\nオーダーメイドのスーツを不躾に傷付けた。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼はゆっくりと顔を上げ、そして状況を\n確認し始める。")
	await novel_interface.show_text_only("最初に目に入ったのは銃をこちらに向けた\n黒いマスクの誘拐犯らしき人物だ。\n目の前にはビデオカメラが備え付けられている。")
	await novel_interface.show_text_only("周囲を懸命に見渡すと、離れた場所にもう１人、\nライフルを所持した人間が確認できた。")
	await novel_interface.show_text_only("彼らの着用している覆面のデザインと\n迷彩服の組み合わせは、\nまるであの悪評名高きテロ組織のメンバーの\nようだ。")
	await novel_interface.show_text_only("後ろを確認すると、壁に飾られている黒い旗が\n存在感を主張している。")
	await novel_interface.show_text_only("前方のカメラの上には1つの携帯電話が\n固定されており、\nそこからは大音量のニュースが流れていた。")
	await novel_interface.show_dialog("「『異質物武器実験禁止条約組織』の執行部総長\n　を務めるランボット士爵は本日、」\n「マスメディアによる取材を受けました」", "ニュース")
	await novel_interface.show_dialog("「彼らは《異質物武器実験の全面禁止条約》に\n　基づいて設立された組織であり、」\n「異質物の軍事転用を阻止する重要な役割を\n　担っています」", "ニュース")
	await novel_interface.show_dialog("「ランボット士爵は現在、世界中に大量の\n　監視測定ステーションを建設し、」\n「全世界における異質物実験を監視している\n　と説明しており」", "ニュース")
	await novel_interface.show_dialog("「各学園都市は互いの平和のために軍事均衡を\n　保つべきであると、主張しています」", "ニュース")
	await novel_interface.show_dialog("「また合理的な威嚇こそが平和維持の基礎である\n　ともランボット士爵は述べており、」\n「マサダブルクの反撃システムの研究開発と\n　テストについてを全面的に支持」", "ニュース")
	await novel_interface.show_dialog("「近日、新豊洲科学院のSS級科学者である\n　マリル・フォン・ブラウン博士に対しては、」\n「是非話し合う場を設けたいと……」", "ニュース")
	await novel_interface.show_text_only("それを聞くと、椅子に縛られている銀髪の男は\n軽く口角を上げた。")
	await novel_interface.show_text_only("彼の水色の瞳は横の壁にあった何枚かの写真を\nじっと見つめている。")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("写真には防護服を着た何人もの作業員が、\n山積みの死体を処理している様子が写っていた。")
	await novel_interface.show_text_only("画素の荒さから察するに古いカメラとフィルムで\n撮影されたものだろう。")
	await novel_interface.show_text_only("当時は撮影を防止するため、周囲数キロ圏内の\nエリアに対して、\n強力な電磁干渉を実施した事を彼は\n未だはっきりと覚えていた。")
	await novel_interface.show_text_only("左下に記載されている文字によれば\nこの写真は3年前の物。\nギアナ高地、チュルン川の畔で撮影された\nようだ……")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("カチャ………………………ドスッ――！！")
	await novel_interface.show_text_only("黒ずくめの男は携帯電話を閉じ、銀髪の男の腹を\n蹴り上げた。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("ぐッ──ゴホゴホッ……", "スーツの男性")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("テレビ用の偽りの顔は、ご自身でもそれほど\n我慢ならないモノなのですかな？", "誘拐犯")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("ふんっ、偽りだと？\n私は……いつも誠実だが。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("黒ずくめの男はランボットに近付くと\n彼の髪を後ろに引っ張り、\n顔面を天井のランプへと強引に向けさせた。")
	await novel_interface.show_text_only("そして曲刀を取り出し、刃先をランボットの\n眼球へ合わせる。")
	await novel_interface.show_dialog("では誠実と呼称するあなたの顔には\nどれほどの価値があるのですかね……", "誘拐犯")
	await novel_interface.show_text_only("強い光によって、水色の瞳が急激に収縮する。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("それならば、君の言い値にしてあげよう。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは直視しながら鼻で笑うように\n告げた。")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("君達は新豊洲に潜入し、私の予定を前もって\n把握していた。\n2分もかけずに私のボディーガードを\nあっさりと倒した上、", "ランバート")
	await novel_interface.show_dialog("そしてその写真まで手にしている。", "ランバート")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("……それほど入念に準備しているのだ。\n\n首切りの動画だけを撮影するためだけでは\nないのだろう？", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットの余裕ある返答に虚を突かれる。")
	await novel_interface.show_text_only("黒ずくめは動揺を隠し、刃を収めて彼の顔へと\n1枚のリストを被せた。")
	await novel_interface.show_dialog("無駄口はよせ……60秒で取引をするか決めろ。", "誘拐犯")
	await novel_interface.show_text_only("被された紙がランボットのズボンへ向かって\nゆっくりと滑り落ちる。\nその内容は12種類の暗号化通貨のアカウントと\n金額の詳細だった。")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("やるじゃないか。\n即座に感情のコントロールができるなんて……", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは窓の外を見る。\n\n……空は夜明けに近い色をしていた。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("（誘拐相手を12時間監禁した後に\n　明確な取引交渉か……）")
	await novel_interface.show_text_only("（専門的な訓練を受けているな……？）")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは顔を下げ、目を細めながらリストの\n数字を一瞥した。")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("為替レートで換算すると、それぞれの金額は\n連合議会が最近公開した、\n特定のテロリストの保釈金と一致している。", "ランバート")
	await novel_interface.show_dialog("だが、君達は『レジスタンス』の人間ではない\nのだろう？", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットの突然の質問に、誘拐犯達は更なる\n動揺に掻き立てられた。")
	await novel_interface.show_dialog("ーーッ！？", "誘拐犯")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("細部まで工夫してテロリストに偽装している\n様だね……\nしかし私はマサダブルクの「マノーラ」だと\n睨んでいるのだが──", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("無駄口を叩くなと言ったッ！！", "誘拐犯")
	await novel_interface.show_text_only("黒ずくめは逆上し、ランボットを気絶させようと\n試みた。")
	await novel_interface.show_text_only("しかしランボットが突然、ヘブライ語で叫ぶ。")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("פצצה,לסרב！！ \n（爆弾だッ！！ 伏せろッ！！）", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("遠く離れた場所にいた男が無意識に頭を守った。\n\nすぐにブラフだと気付くと、慌てて銃を構え直し\nランボットに狙いを定める。")
	await novel_interface.show_text_only("予想だにしていなかったランボットの動きに\nよって仲間が反射的な動きを晒し、\n正体がバレてしまった事を黒ずくめは悟った。")
	await novel_interface.show_text_only("ランボットは挑発的な笑みを浮かべる。")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("レジスタンスが私を誘拐し、連合議会による\n不法異質物実験の証拠を握っていると宣言……\n……そのような筋書きかな？", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは横の壁にある写真に再び\n視線を移す。")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("マサダブルクの自動反撃システムを抑止力として\n表立って支持しているのは、今は唯一私だけ。\nレジスタンスが私を誘拐するのも理に適う。", "ランバート")
	await novel_interface.show_dialog("私を利用すればレジスタンスの顔へと十分に\n泥を塗る事ができるだろう。\nさらに血迷った様子を演出して彼らを狂った\n「テロリスト」と印象付ける。", "ランバート")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("最後に写真を使って暗号化通貨の身代金を\n連合議会に要求……\n一石三鳥の計画だったな。", "ランバート")
	await novel_interface.show_dialog("暗号化通貨の取引はパブリックチェーンで公開。\n連合議会が金を支払った瞬間、\n不当に異質物実験を行った事を認めたとして\n事実関係を公にする。", "ランバート")
	await novel_interface.show_dialog("そして事件を口実としてマサダブルクが後日に\n他の学園都市を脅迫。\n自動反撃システムは支持さえあれば\n各方面の制裁を免れるというわけだ。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("恐ろしいほどの正確な分析で、黒ずくめ達は\n唖然とし、\nいかに対処すれば良いのか判断がつかなくなる。")
	await novel_interface.show_text_only("ランボットは身動きが出来ないにも関わらず、\n完全にこの場の主導権を握っていた。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("わざわざ編集したニュースを使ってでも\n自分達の言葉で説明しないのは、\n君達の本場の訛りを隠すため。", "ランバート")
	await novel_interface.show_dialog("だがカメラや私の後ろの黒い旗、\nわざと見せつけてきたダマスカス曲刀……\n蛇足的な部分が多すぎた……", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("行き詰まった顔をしている黒ずくめを見て、\nランボットは故意に間を開ける。")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("行動の節々に訓練された匂いを感じる……\n\nおそらく、君達はマノーラから淘汰された者\nというところか？", "ランバート")
	await novel_interface.show_dialog("淘汰された訓練生は「意志審査」に合格すれば\n特殊編成人員として取り入る事が可能だ。", "ランバート")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("このような政治紛争に成り兼ねない任務ばかりを\n専門としてる部隊なのだろう？\n君達は切り捨てる事が簡単な駒か……", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…………", "誘拐犯")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("もう良いじゃないか。\n君達が私を殺せはしない事も証明されたのだ。\nなにしろ私は現在、唯一のマサダブルクの\n支持者なのだからな。", "ランバート")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("それでは今から、君と君の仲間に1つチャンスを\n与えよう──", "ランバート")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("マノーラの通常作戦の編成を考えると\n人員はお前と向こうの歩哨だけではないはずだ。", "ランバート")
	await novel_interface.show_dialog("技術作戦員が1名、重火器支援が1名\n狙撃手が1名……\n外で待機しているのではないかね？", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは獲物を狙うかのような視線で、\n黒ずくめを刺しながら一言一言を紡いでいく。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("私の要求は情報の共有だ。\nもし君達が殊勝であるのならば──\n最初から私は何も知らなかった事として\n芝居に付き合ってあげよう。", "ランバート")
	await novel_interface.show_dialog("さもなくば任務失敗だ。\n\n……帰ってから、組織に処分されるのを座して\n待つがいい。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("も、もちろん……協力、協力しようっ！", "誘拐犯")
	await novel_interface.show_text_only("ランボットの言葉に対して黒ずくめは迷わず\n判断を下す。\nすぐに工具を手に持ちランボットの拘束を\n解こうとした。")
	await novel_interface.show_text_only("しかし突然「ブン」と空気を裂くような\n音がする。")
	await novel_interface.show_text_only("瞬間、黒ずくめはまるで石化したように\nその場で固まってしまった。")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("──どうしたのかね？", "ランバート")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("ランボットが何かを言い終わる前に\n倉庫内のランプが消えた。")
	await novel_interface.show_text_only("……しばらくして\n外から大きな音が聞こえてくる。")
	await novel_interface.show_text_only("ゴウゥゥ――――ッ！\n\nドォォォォ――――ンッッ！！！")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("あらゆる警報が響き渡り、舞い降りたヘリの\nプロペラ回転音がそれを遮る。")
	await novel_interface.show_dialog("──全員動くなッ！！！", "防衛庁兵士")
	await novel_interface.show_text_only("宵闇の空、完全武装した都市防衛庁の特警が\n倉庫外を制圧して扉から入ってきたのだ。")
	await novel_interface.show_text_only("レスキュー隊まで駆け付け、瞬時にランボットの\n身柄を確保して拘束を解いた。")
	await novel_interface.show_text_only("まさに刹那の出来事だ。\nこの状況に黒ずくめは一切の抵抗が出来ない……")
	await novel_interface.show_text_only("……いや、様子がおかしい。\n\n解放されたランボットは軽く服の埃を払い\n黒ずくめの様子を確認する。")
	await novel_interface.show_text_only("……固まった黒ずくめは未だ動かない。\n\n特警の隊員が試しに肩に触れる──")
	await novel_interface.show_text_only("ずるりっ…………上半身と下半身が分離した。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("この死体の切り口は……", "ランバート")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──いや、それよりも写真は！？", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("写真の貼り付いていた壁をすぐさま見る。\n\nすでに1枚も……\n何もかもが無くなって……")
	await novel_interface.show_text_only("光のない監視の死角。\n\n血にまみれた長い黒髪が宵闇に溶けていく──")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
