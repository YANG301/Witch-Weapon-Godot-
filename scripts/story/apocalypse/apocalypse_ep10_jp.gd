# apocalypse_ep10.gd - 天启篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第10话剧本
	apocalypse_ep10_script()

func play_script():
	pass

# 天启篇第10话 - 正式剧本
func apocalypse_ep10_script():
	# 场景：秋叶原夜晚
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("俺とソヤは明るく照らされた電気街へと\n戻ってきた。")
	await novel_interface.show_text_only("猫丸電器本店ビル備え付けの大スクリーンには、\nスポンサー企業のCMがループ再生されている。")
	await novel_interface.show_text_only("トラックを改造した数台のパレードカーが、\n歩行者天国の中央を一列に陣取って並んでいた。")
	await novel_interface.show_text_only("主張の激しい広告が車両の両面に描かれており、\n派手な飾りのフェンスが屋根に装備されている。\nその後ろでスタッフらしき人物が音響設備を\n調整しているようだ。")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("……これは、何かのイベントですの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("電気街は先ほど俺達がいた時よりも人口密度が\n増していた。\nどうやら観光客らしき人達が続々と押し寄せて\nいるようだ。")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("あっ！ もしかして今日は……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は携帯を取り出して、すぐさま検索をかける。")
	await novel_interface.show_text_only("やっぱり！！\n今夜は年に一度だけ行われる電気街の祭りだ。")
	await novel_interface.show_text_only("5年前、新豊洲の情勢が安定するにつれて、\n元老院は《社会公序法案》を含む、\n多くの文化規制法案を撤廃した。")
	await novel_interface.show_text_only("法案撤廃が開始される日の前夜、多くの人々が\n自主的に猫丸電器のモニター前に集まり、\n「偉大なる勝利」を祝うためのカウントダウンを\n行った。")
	await novel_interface.show_text_only("この話は後ほどネット上でパロディ化される。\n\nオタクの先輩達が暴政に抗い、最終的には世界を\n救うという物語に脚色された。")
	await novel_interface.show_text_only("さらに「その抗争に参加した戦士達」が昔話を\nするという設定が生まれると、\n図らずも集団創作と化した。")
	await novel_interface.show_text_only("戦いの終結後、政府は世界規模での記憶消去を\n行ったらしく、\n一部の功労者だけが記憶を消されずに\n今も覚えているという展開に……")
	await novel_interface.show_text_only("カウントダウンの夜は記憶消去の前夜だった。\n\n生き残った人々は涙を流しながら秒を数え、\nあの戦争に殉じた戦士達を追悼したと言う。")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("（バカバカしい！）\n\n（そんな話、誰が信じるんだよ！！）", "レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（昔の俺を盛り上げさせやがって……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ともかく、この突発的な大規模イベントを\n業者が見過ごすはずがない。\nこの日を毎年の大セール感謝祭にして、\n多くのスポンサーを集める事に成功する。")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("どうりで午後から無料グッズが配布されてた\nわけだ……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("道行く人達が持っている黄色の小旗を見ると、\nちょっと羨ましい。")
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("イベントの主題はカウントダウン…ですのよね？\n0時近くからが本番なのでしょうけど……\n現時点でこの雰囲気だと少々盛り上がり過ぎでは\nありませんこと？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("時計を見てみるが現在は20時にも満たない。\n\nカウントダウンはまだ先なのに、集まっている\n人達の熱気が高すぎる。")
	await novel_interface.show_text_only("今年の参加人数は予想を遥かに上回ったようで、\n現場の警備を担う保安警察もお手上げの様子だ。")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("そういえば、俺達って逃亡犯なんだよな？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("今回のソヤはどんな恐ろしい手を使うのか……\n警察官の彼らを見ていると心配になってきた。")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("し――っ……静かにしてくださいまし──", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは俺を軽くつねると、街の向こう側を指す。")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("あそこに2台の黒い装甲車がありますわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤの指差す方向には、装甲車が停まっていた。\n\nあの装甲車は待機中の保安軍か……もしくは\nニューモリダスの特殊攻撃部隊かもしれない。")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("あなたを銃弾から守るのはさすがに不可能……\n\n万が一あの人達を引き付けてしまいましたら\nヤバイですわね。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは筋肉のない俺の太ももを触り、\n小馬鹿にした笑みでニヤつく。\nいや弾丸を避けられないのは筋肉と\n関係ないだろ！？")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("そもそも、こんなに人がいる中でちゃんと\nイルカを見つけられるかどうか……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──見渡す限り人の群れ。\n\nこの中でイルカが心細そうに助けを待っている\n姿を考えると、胸が締め付けられる。")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("あの子なら、あそこにいますわよ？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("なんだってっ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは神輿のように装飾されたパレードカーへと\n顔を向ける。\nその神輿に座っている幼い少女は、紛れもなく\nイルカだった。")
	await novel_interface.show_text_only("一体アレは誰が提供したパレードカーなのか。\n\n前方に巨大な提灯が1つ飾られており、\nその後ろで太鼓を叩く人達が2人。")
	await novel_interface.show_text_only("神輿は100人以上の人間に囲まれていて全員が\n神を見るような目でイルカに注目していた。")
	await novel_interface.show_text_only("はっぴを着ている人達が黄色の小旗を持って\n太鼓のリズムに合わせながらコール。")
	await novel_interface.show_text_only("コールに合わせてイルカが目の前の供物台から\nチョコロールケーキ1つを持ち、\nほんの数口で完食。")
	
	# 显示伊露卡，使用iluka_hide而不是iluka_uniform
	await novel_interface.show_dialog("えっへっへ～～！", "イルカ")
	await novel_interface.show_text_only("……何も考えてないっぽい幸せそうな顔を\nしている。")
	await novel_interface.show_text_only("彼女の完食した表情を見ると周囲はライブ会場の\nような歓声を上げ、一気に盛り上がった。")
	await novel_interface.show_text_only("そして目をキラキラさせたイルカは、\n次の「貢ぎ物」を選び始める──")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("………………………………", "レン")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("なんじゃありゃぁッ！！？？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("おやおやぁ、大盛況なご様子ですわねぇ。", "ソヤ")
	await novel_interface.hide_character()
	
	# 场景转换
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…………")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("俺達はパレードカーの周囲を1周して調べる。")
	await novel_interface.show_text_only("「親衛隊？」による完全包囲網が組まれており、\nどうやら強行突破するしか方法はなさそうだ。")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("だけど逃亡犯扱いの俺達にとって、保安軍の\n注意を引く行動は非常にリスクが高い。", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("車の上で大食い神と化したイルカを眺めてみる。\n\n彼女に危険がないと分かった以上、\n取り急ぎ行動する必要はなさそうだけど……")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("ねえ、あのような小さな子に夢中になるのは\nどうしてですの？\n欧州だと変態だと思われますわよ？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは意地悪な笑みで尋ねてきた。")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("へ、変態？\nま、まさか！", "レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("ほ、ほら、動物の赤ちゃんが可愛く見えるのと\n同じさ～～\n単純で、真面目で、少し不器用で……", "レン")
	await novel_interface.show_dialog("そういう素敵な、傷つかないように、\n守ってあげたい気持ちが……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("自分を含めて色々な紳士達のために弁解を\n試みてはいるけども。\n言えば言うほど墓穴を掘り進めているような\n気がする。")
	novel_interface.show_character("ren_fishnet", "shy_left")
	await novel_interface.show_dialog("そもそも変態って言うけど、君のレベルだって\n相当なモノだろう！？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("うへへへへ……変態で何が悪いですのよ～～？", "ソヤ")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("「普通」が特定環境における全員の平均値だと\n考えますと、\n平均から大きく離れている人ほど変態と\n見なされますわよね？", "ソヤ")
	await novel_interface.show_dialog("つまり変態は他人より抜きん出ていると言う事で\n隠す必要なんてありませんわ♪", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは誇らしげに手を自分の胸に置く──")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("変態は変態ですし恥じる事などありませんッ！\n素直に変態と認めればいいのですッ！\n一般人のロジックで自分の変態を解釈する\n必要なんて変態には必要はありませんのッ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("人生の先輩気取りのソヤは俺の肩を軽く叩いた。")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("（そんな図々しい自己解釈があってたまるか！）\n\n（あと勝手に同類にしないでっ！）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("欧州の人達はロリコンを変態だと思って\nおりますわ。\n何故なら彼らは豊満な女性が好きだからですの。\n\n例えば……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは言葉の流れに乗りながら俺の胸を\n揉み始めた。")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("──はふんッ！？", "レン")
	await novel_interface.hide_character()
	
	# 贝阿特丽切出场，使用beatrice_show_hide效果
	await novel_interface.show_dialog("あらあら……彼女が熟す時はまだ先と思うわよ。", "女性の声")
	await novel_interface.show_text_only("突然のセクハラを受けている直後、\n俺達の背後から馴染みの声が伝わってきた。")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("べ、ベアトリーチェっ！？\nなんでここに……？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("久しぶりね、可愛い子ちゃん──", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("おっほおおおお──────ッ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェの胸に飛びかかろうとしたソヤを\n俺は止めた。")
	novel_interface.show_character("soya_uniform", "cry")
	await novel_interface.show_dialog("は、放せですのッ！！", "ソヤ")
	await novel_interface.show_dialog("この方もレンさんと同じ純粋な匂いを\nしていますわッ！\nしかし、圧倒的ッ！\n圧倒的な大きさ────", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("何がだよ！！！")
	await novel_interface.show_text_only("ベアトリーチェは優雅に髪を整えると、\nついでにパツパツになってたシャツを調整する。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("あなた達を尾行して警護するように、\nマリルからお願いされたの。", "ベアトリーチェ")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("今まで隠し通すのは結構大変だったのよ？\nあなた達は、あのセレサとも会っていたし……", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("び、尾行？", "レン")
	# 显示双角色位置移动
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "afraid", 0.25)
	await novel_interface.show_dialog("まさか、いつから跡をつけておりましたの？\n全く気づきませんでしたわ……\nこんなに甘ったるい匂いをしてるのに！！", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは俺に首を引っ張られながらも、\n必死にベアトリーチェへ鼻を向ける。\nもはや犬みたいだ。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("今日の午後から、ずっとあなた達の近くに\nいたわよ？", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェの妖艶な微笑みに、\n俺の頬が少し熱くなったような気がした。")
	await novel_interface.show_text_only("彼女がSIDの「特殊な業務」を手伝っているのは\n聞いていたけど……")
	await novel_interface.show_text_only("自称700年前に死んだこのお姉さんは、\nラファエルの家に代々伝わるペンダントを介し、\nこの時代に魔女として召喚された。")
	await novel_interface.show_text_only("どうやらベアトリーチェは異性を自分の虜にする\n「呪い」にかかっているらしい。")
	await novel_interface.show_text_only("呪いを制御できるブレスレットを彼女は貰ってた\nはずだけど……\nきっと呪いのせいだ。\n俺が彼女を見ると慌てふためいてしまうのは……")
	novel_interface.show_character("ren_fishnet", "shy")
	await novel_interface.show_dialog("ずっと近くにいたって、\nそれじゃ、さっき俺達が逮捕された時は……", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("逮捕された直後、マリルには連絡したのだけど、\n忙しいのか情報遮断エリアにいるのか……\nずっと返事がこないの……", "ベアトリーチェ")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("ソヤもいるから脱出してくるだろうと判断して、\nここに残ってイルカを監視し続けていたわ。", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "shy_right")
	await novel_interface.show_dialog("その……イルカは一体どうやってあそこに？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェと会話する時はいつも視線を\n逸らしてしまう。\nどこに目をやればいいのか分からないし！")
	await novel_interface.show_text_only("それに、もがくのを止めたのはいいんだけど……\n楽しそうに俺の表情をチェックするなソヤ！ \nもう何なんだよ……")
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("ソヤがあなたを壁に押し付けていた時、あの子は\nお菓子の配達員に釣られてしまったみたいね。", "ベアトリーチェ")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("いくら人混みから外れた場所と言っても、\nあなた達ったら…………はぁ。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは意味深に溜め息を吐いた。\n\n俺達がまるで如何わしい事をしていたような\n雰囲気にするのはやめてくれ！")
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("その後、イルカはみんなが午後に行った\nスイーツ店へとたどり着いたわ。\n店主はご馳走するどころが、今夜のキャンペーン\nガールとして推薦したみたいよ。", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("（あの店主、意外と見る目あるな。）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("あの子の事はあまり知らないから、\n最初は子供が欲しがっているだけと思ったわ。\nでも……どうも違うような雰囲気がするわね。", "ベアトリーチェ")
	await novel_interface.show_dialog("ソヤから見て彼女に何も問題はない？", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("ん～～ないとは思いますけど──", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤはイルカの方を見た。")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("脅迫されているようでも、投薬されている\nようでもありませんわ。", "ソヤ")
	await novel_interface.show_dialog("不快感や苦痛も感じていない様子ですし、\n行動も自身の精神や欲求と一致していますわよ。", "ソヤ")
	novel_interface.change_expression("wordless")
