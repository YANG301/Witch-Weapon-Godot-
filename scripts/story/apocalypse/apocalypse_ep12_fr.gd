# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Béatrice lève une jambe, le pied sur la balustrade, et crie dans son micro.")
	await novel_interface.show_text_only("La chaîne stéréo, portée à plein volume, porte sa voix jusqu'au bout d'Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Vous êtes tous des déchets !", "Béatrice")
	await novel_interface.show_dialog("Allez au diable, les pervers !", "Béatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Euh...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Elle dit juste ça pour attirer l’attention, n’est-ce pas ? Elle ne le pense pas, n’est-ce pas ?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Et elle a attiré l’attention. Tous les regards sont désormais tournés vers elle.")
	await novel_interface.show_text_only("À la seconde où ils voient le visage de Béatrice, les piétons ne peuvent plus détourner le regard. Ils se lèvent, bouche bée, impressionnés par ses talons hauts rouges brillants et l'ombre séduisante sous sa minijupe.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Déchets, vous tous ! Sale bugs ! Vous aimeriez que je vous piétine à mort, n'est-ce pas ?", "Béatrice")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("N'as-tu pas honte ?", "Béatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Peut-être qu'elle le pense vraiment...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La plupart des gens dans la rue nous regardent maintenant. Même les mascottes qui dansaient sur les toits des autres camions s'arrêtent dans leur performance pour regarder le spectacle.")
	await novel_interface.show_text_only("Sonya et moi en profitons pour escalader l’échelle située sur le côté du camion d’Elluka.")
	await novel_interface.show_text_only("La jeune fille est assise sur son trône, tapotant son ventre bombé avec satisfaction. Des dizaines d’assiettes vides reposent sur la table d’offrandes devant elle.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Elle... a mangé tout ça ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'arpente les environs, calculant la meilleure façon de sortir ce petit glouton potelé de tout ce désordre, mais Elluka se jette simplement sur moi.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Mademoiselle Ren !", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je pose un doigt sur mes lèvres, lui faisant signe de le baisser...")
	await novel_interface.show_text_only("Pourtant, elle a déjà bondi dans les airs, visant droit vers mon visage...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Oh, c'est vrai. La première fois que j’ai vu Elluka, elle combattait des sorcières dans les airs, n’est-ce pas ?")
	await novel_interface.show_text_only("Je me souviens qu'Aya m'avait dit que cette fille, âgée d'environ onze à douze ans à en juger par l'âge de ses os, avait subi des dizaines d'opérations et avait d'innombrables pièces mécaniques installées dans son corps.")
	await novel_interface.show_text_only("Sa mémoire a été effacée trop de fois – elle ne se souvient même pas du moment où son œil gauche a été remplacé par une prothèse oculaire électronique de qualité militaire.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Avec toutes ces pièces mécaniques à l'intérieur d'elle, même si elle est capable de flotter en profitant du champ électromagnétique, son poids réel est en fait le double du mien...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Boum !")
	await novel_interface.show_text_only("Elluka atterrit sur moi, les cuisses serrant mes côtes, le ventre mou couvrant mon visage. Ses mains potelées s’agrippent à ma nuque.")
	await novel_interface.show_text_only("Je jure que je pouvais entendre ma colonne vertébrale se briser sous la pression.")
	await novel_interface.show_text_only("Elle enroule tout son corps autour de ma poitrine, de ma tête, frottant sa joue contre mes cheveux comme un chat très enthousiaste.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Miss Ren est ma préférée ! *hic*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À en juger par son visage rouge et joyeux et l’insulte de sa voix, on aurait pu penser qu’elle était ivre.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("J'ai entendu ce grand craquement... c'était tes os ?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je reste raide, figé sur place. J'ai l'impression que mon cou va se briser en deux si je bouge ne serait-ce qu'un tout petit peu.")
	await novel_interface.show_text_only("L'agitation semble avoir attiré l'attention des femelles à proximité. Certains nous montrent même du doigt en nous demandant « qu’est-ce que c’est ? »")
	await novel_interface.show_text_only("Je ressemble à un monstre à grosse tête en bas résille en ce moment. Pas étonnant qu’ils soient confus.")
	await novel_interface.show_text_only("Constatant notre situation difficile, Béatrice élève la voix, comme pour nous donner encore plus de temps pour évacuer.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Votre place est à la casse ! Pas une once de décence dans vos têtes ! Des asticots ! C'est flippant ! Porc!", "Béatrice")
	await novel_interface.show_dialog("Vous tous...", "Béatrice")
	await novel_interface.show_dialog("Meurs !", "Béatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les deux orateurs chorissent avec une électricité pétillante alors que le discours passionné de Béatrice atteint son paroxysme.")
	await novel_interface.show_text_only("Et finalement, ils explosent, aux côtés des ampoules des panneaux publicitaires lumineux à proximité.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("La rue entière tombe dans un silence étrange.")
	await novel_interface.show_text_only("Les foules regardent toujours, sous le choc, la dame aux cheveux roux, debout dans toute sa splendeur au sommet du camion.")
	await novel_interface.show_text_only("Sonya profite de cette brève distraction pour retirer Elluka de moi, puis la pousse sur son dos.")
	await novel_interface.show_text_only("La plus jeune, qui s'était collée sur moi comme un morceau de chewing-gum, s'endort en un instant.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Ouf... je ne m'attendais pas à ce que ce gamin pèse autant...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je soupire, parvenant enfin à reprendre mon souffle, me massant la taille tout en observant la scène. C’est toujours d’un silence troublant.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Ces gars sont pétrifiés ou quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais quelques instants plus tard, les acclamations commencent à se propager dans la foule. Des acclamations fortes et merveilleuses.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Aahhh ! Elle est merveilleuse ! Tu es merveilleux !", "Passant A")
	await novel_interface.show_dialog("Marche sur moi, ma reine !", "Passant B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Des vagues et des vagues d’acclamations extatiques explosent dans toute la rue.")
	await novel_interface.show_text_only("Les foules se déchaînent sous l’effet de l’excitation.")
	await novel_interface.show_text_only("Depuis les camions blindés noirs de l'autre côté de la rue, plusieurs soldats armés d'armes automatiques descendent, observant le tumulte soudain avec confusion.")
	await novel_interface.show_text_only("Je fais un geste dans leur direction, essayant d'alerter Béatrice, et c'est là que j'aperçois par hasard son visage...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Oh mon Dieu...", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Elle est... si belle !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un courant chaud et picotant qui ressemble beaucoup au désir se propage instantanément dans mon corps.")
	await novel_interface.show_text_only("Mes joues me brûlent, mes jambes lâchent...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(je la veux...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("... Ren ?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Les foules deviennent incontrôlables. Ils se ruent sur le camion de Béatrice en chantant fort, au point que le véhicule fragile est sur le point de basculer.")
	await novel_interface.show_text_only("Certains gars tentent d'escalader le camion par le côté, mais Béatrice piétine simplement leurs mains agrippantes et les repousse.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Oui ! Plus ! Piétinez-moi aussi ! S'il vous plaît, ma reine !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Béatrice sourit et secoue la tête devant l'air de pure idiotie sur mon visage, puis remet son bracelet en place.")
	await novel_interface.show_text_only("Puis elle sort de ses seins une capsule en argent de la taille d'un pouce et la lance à la foule déchaînée sous ses pieds...")
	await novel_interface.show_text_only("Dans un nuage de fumée blanche, la belle Béatrice disparaît sans laisser de trace.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Cependant, je n’arrive toujours pas à oublier son magnifique visage, jusqu’à ce que Sonya me tire par le bras.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Sortez-en ! Les soldats arrivent ! En plus...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Alors que la fumée se dissipe, la foule commence à murmurer de confusion, réalisant que l'objet de sa concentration n'est plus là.")
	await novel_interface.show_text_only("Sonya et moi parvenons à peine à nous éloigner de la foule avant que le fanclub d’Elluka ne remarque que leur propre idole a disparu.")
	await novel_interface.show_dialog("Où est Dame Elluka ?", "Garde royale A")
	await novel_interface.show_dialog("Là-bas ! Celui en bas résille a pris notre Dame Elluka !", "Garde Royale B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Bas résille ? Lady Elluka ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Kidnappeur ! Appelez la police!", "Garde Royale C")
	await novel_interface.show_dialog("Après eux !", "Garde royale A")
	await novel_interface.show_text_only("Un groupe d’hommes enragés se dirige droit vers nous, suivi de quelques agents de sécurité.")
	await novel_interface.show_text_only("Allez, quel genre de ravisseur porte des bas résille ?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Courez !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais il nous est difficile de secouer la foule, d'autant plus que Sonya porte la grosse Elluka et que ma taille me palpite encore de douleur.")
	await novel_interface.show_text_only("Le pire, c'est que des flics patrouillent devant...")
	await novel_interface.show_text_only("Nous ne pouvons pas nous battre. Nous ne pouvons pas courir. C’est désespéré.")
	await novel_interface.show_text_only("Soudain, derrière nous, un bruit de verre brisé retentit.")
	await novel_interface.show_text_only("Un type blond vêtu d’un coupe-vent noir a renversé un panneau publicitaire rétro lumineux au bord de la rue.")
	await novel_interface.show_text_only("Les éclats des ampoules des panneaux publicitaires recouvrent le sol. Les piétons, faisant de leur mieux pour les éviter, ralentissent efficacement le fan-club d’Elluka.")
	await novel_interface.show_text_only("Le blond sourit à Sonya et moi, le visage innocent et doux.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Il y a un raccourci devant nous. Viens avec moi?", "Garçon avec des lunettes")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya et moi échangeons des regards. Pourquoi cela ressemble-t-il à une sorte de scénario tiré d’un film ?")
	await novel_interface.show_text_only("Le jeune homme à lunettes, aux cheveux blonds duveteux, à la chemise à carreaux et aux yeux azur, semble plutôt timide.")
	await novel_interface.show_text_only("Il a l'air presque gêné par notre absence de réaction et s'empresse d'expliquer :")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Je... je travaille à temps partiel dans un magasin par ici... je viens de sortir du travail...", "Garçon avec des lunettes")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il regarde mes jambes, déglutit et se détourne.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Wow, ce n'est en effet pas une bonne façon de jeter un coup d'œil furtif aux filles...)\n(C'est beaucoup trop évident...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Tu... tu avais l'air d'être poursuivi par des méchants, alors j'ai pensé...", "Garçon avec des lunettes")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L’épaule de Sonya s’affaisse alors qu’elle baisse brièvement sa garde.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("À en juger par son aura, il ne veut pas nous faire de mal.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En fait, tout bien considéré, NOUS SOMMES les méchants ici...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Montrez la voie !", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
