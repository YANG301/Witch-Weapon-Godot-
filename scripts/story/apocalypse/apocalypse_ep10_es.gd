# apocalypse_ep10.gd - 天启篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第10话剧本
	apocalypse_ep10_script()

func play_script():
	pass

# 天启篇第10话 - 正式剧本
func apocalypse_ep10_script():
	# 场景：秋叶原夜晚
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Sonya y yo regresamos a la brillantemente iluminada Electronics Street.")
	await novel_interface.show_text_only("La enorme pantalla suspendida en la pared exterior del Nekomaru Electronics Flagship Building transmite un comercial de un patrocinador.")
	await novel_interface.show_text_only("Unos cuantos camiones con vallas publicitarias móviles están estacionados ordenadamente en fila en el centro de la pasarela peatonal.")
	await novel_interface.show_text_only("A ambos lados de cada camión hay gigantescos anuncios pintados con spray. En el techo de los vehículos hay rieles decorados y algunos trabajadores se apoyan en ellos realizando pruebas de sonido con equipos de aspecto elegante.")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("¿Van a realizar algún tipo de evento aquí?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Electronics Street está aún más concurrida que cuando la dejamos anteriormente. Sigue llegando más gente.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Oh, hoy debe ser...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Recuerdo haber visto algo similar en línea y saqué mi teléfono para realizar una búsqueda.")
	await novel_interface.show_text_only("Así es. Es el festival anual de Electronics Street.")
	await novel_interface.show_text_only("Hace cinco años, mientras Nueva Opulentia se recuperaba gradualmente de la guerra, el Senado anunció la abolición de varias leyes que regulaban las actividades culturales, incluida la Ley de Orden Social.")
	await novel_interface.show_text_only("La medianoche antes de que se tomara la decisión, una gran multitud se reunió bajo esta misma pantalla frente a Nekomaru Electronics y contó los segundos que conducían a esta “gran victoria”.")
	await novel_interface.show_text_only("Posteriormente, algunos internautas hicieron ediciones divertidas, creando un cortometraje completo que cuenta una historia épica de cómo los valientes pioneros otaku se enfrentaron al gobierno opresivo y finalmente salvaron al mundo.")
	await novel_interface.show_text_only("Esto inspiró a muchos de dichos \"pioneros\" a hacer sus propias ediciones divertidas, agregando fragmentos a la historia de \"esa guerra\", como si fuera un evento real.")
	await novel_interface.show_text_only("Algunos incluso afirmaron que, después del incidente, el gobierno borró la memoria de todas las personas en el mundo, dejando intactas sólo las de unos pocos valientes “pioneros”.")
	await novel_interface.show_text_only("Y la cuenta regresiva fue, de hecho, un grupo de sobrevivientes reunidos para conmemorar a esos valientes “pioneros” la noche antes de que se borraran sus recuerdos.")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("(¿Qué clase de historia estúpida es esa? ¿Quién se la creería de todos modos?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Aunque disfruté mucho revisando las ediciones...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De todos modos, las empresas de la zona aprovecharon la oportunidad para hacer del día un festival anual donde los compradores obtienen increíbles descuentos. Esto también atrajo a muchos patrocinadores.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("No es de extrañar que estuvieran repartiendo productos gratis esta tarde...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observo con envidia cómo pasan algunos compradores con sus banderitas amarillas.")
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Si el evento va a durar hasta la medianoche... ¿no es demasiado pronto para que la gente se emocione tanto?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro mi reloj. Aún no son las ocho, pero la multitud en la calle ya parece estar llena de anticipación.")
	await novel_interface.show_text_only("El número de participantes hoy es inesperadamente alto. La pobre policía de seguridad que mantiene el orden apenas puede hacerse oír.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Uh... ¿no somos fugitivos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Echo un vistazo a los policías que están cerca y me pregunto si Sonya también necesitará acabar con ellos con algún otro artilugio loco.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Sólo mantén un perfil bajo.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya me pellizca y señala algunos vehículos al otro lado de la calle.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("¿Ves esos dos camiones blindados negros?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Yo los veo. Parecen contener soldados de seguridad esperando órdenes, probablemente del escuadrón de operaciones especiales de Newmoridas.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("¡Si atraemos la atención de esos tipos, no te protegeré de las balas!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mira mis muslos suaves y sin músculos con una sonrisa desdeñosa. Probablemente piensa que soy un niño inútil que ni siquiera sabe esquivar las balas. Y ella no se equivoca.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("¿Cómo encontramos a Elluka entre tanta gente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a mi alrededor, a la multitud que parlotea, y siento una punzada en el corazón al imaginarme a la pequeña Elluka, perdida en medio de todo, aterrorizada e indefensa.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Ah, ¿esa chica? Ella está ahí.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya señala con la cabeza el camión con vallas publicitarias que tenemos delante, decorado como una especie de santuario. ¿Y la muchacha sentada en la posición del dios adorado? Elluka.")
	await novel_interface.show_text_only("Es difícil saber quién patrocinó este camión. De su cabeza cuelga una linterna gigantesca y justo detrás de ella hay dos hombres tocando tambores taiko.")
	await novel_interface.show_text_only("Cientos de personas se apiñan alrededor del camión, señalando a Elluka y arrullando su ternura.")
	await novel_interface.show_text_only("Una docena de tipos vestidos con ropa de wota están parados en fila, ondeando sus banderas amarillas y haciendo fanchants al ritmo de los tambores.")
	await novel_interface.show_text_only("En la mesa de ofrendas frente a Elluka hay un panecillo de crema de chocolate, que devora en unos segundos.")
	
	# 显示伊露卡，使用iluka_hide而不是iluka_uniform
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.show_text_only("Y luego ella sonríe, tan feliz, tan desalmada.")
	await novel_interface.show_text_only("La multitud aplaude cuando ella termina la “ofrenda” y sus “fanáticos” comienzan a cantar con más fuerza.")
	await novel_interface.show_text_only("Con los ojos llenos de estrellas, Elluka elige su próxima “ofrenda”.")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("¿Qué diablos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Parecen estar pasando el mejor momento de sus vidas.", "Soya")
	await novel_interface.hide_character()
	
	# 场景转换
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Nos empujamos entre la multitud, observando el camión desde todos los ángulos.")
	await novel_interface.show_text_only("Los fanáticos dedicados se amontonan contra el camión, lo que nos hace imposible acercarnos sin recurrir a la violencia.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Pero no podemos armar un escándalo, porque vendrá la policía...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al menos Elluka no parece estar en peligro. Ella simplemente está sentada ahí, comiendo. Entonces no tiene sentido preocuparse.")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Oye, ¿por qué crees que esos tipos adoran a las niñas lindas? En Europa esto nos parece anormal.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me pregunta Sonya, con una sonrisa en su rostro.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("¿Anormal?\nNo es tan malo...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Mira, es como la gente encuentra lindos los gatitos y los cachorros, ¿verdad? Las niñas pequeñas son sencillas, algo torpes y siempre hacen lo mejor que pueden...", "Lian")
	await novel_interface.show_dialog("Les recuerda a las personas ese pedazo de inocencia que han perdido y quieren protegerlo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intento explicarlo, pero cuanto más digo, más extraño se siente.")
	novel_interface.show_character("ren_fishnet", "shy_left")
	await novel_interface.show_dialog("Además, cuando se trata de ser anormal, ¿no eres aún peor?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Bueno, en lo que a mí respecta, ser anormal no es algo malo.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Si se define “normal” como el estado promedio de las personas en un determinado entorno, entonces aquellos que no sean promedio se considerarán “anormales”.", "Soya")
	await novel_interface.show_dialog("Entonces aquellos que son sobresalientes también son “anormales”, ¿verdad? ¡No está nada mal!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya coloca una mano frente a su pecho, luciendo bastante orgullosa.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Ser anormal está bien, no es necesario explicar tu anormalidad a esos plebeyos mundanos. Puedes simplemente admitirlo en lugar de tratar de encontrar excusas para ello.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya me da una palmada en el hombro, como si acabara de partir con una gran sabiduría.")
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("(¿Qué tipo de interpretación es esa?)\n(¿Y esto significa que ella también piensa que soy anormal?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("La razón por la que los europeos encuentran anormales a las personas con complejos de lolicon es probablemente que al europeo promedio le gustan más las mujeres con senos grandes. Por ejemplo...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mueve una mano hacia mi pecho y pellizca un pezón.")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("¿Respirar?", "Lian")
	await novel_interface.hide_character()
	
	# 贝阿特丽切出场，使用beatrice_show_hide效果
	await novel_interface.show_dialog("Aún no está muy maduro, eh.", "Voz femenina")
	await novel_interface.show_text_only("Una voz familiar viene detrás de nosotros.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("¿B-Beatrice?\n¿Qué estás haciendo aquí?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("¡Ha pasado un tiempo, cariño!", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("¡Guau!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya está a punto de dar un salto volador sobre el pecho de Beatrice, pero tiro de ella hacia atrás justo a tiempo.")
	novel_interface.show_character("soya_uniform", "cry")
	await novel_interface.show_dialog("¡D-déjame ir!", "Soya")
	await novel_interface.show_dialog("Huele tan puro como Ren, pero los suyos son mucho más grandes...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Cállate!")
	await novel_interface.show_text_only("Beatrice simplemente se revuelve el cabello con elegancia y se ajusta la camisa ajustada.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Mariru me pidió que te siguiera en secreto y te mantuviera a salvo.", "Beatriz")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("¡Fue bastante difícil permanecer fuera de la vista toda la tarde! Especialmente desde que ustedes se toparon con esa Theresa...", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("¿Seguirnos? ¿En secreto?", "Lian")
	# 显示双角色位置移动
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "afraid", 0.25)
	await novel_interface.show_dialog("¿Desde cuándo nos sigues? Ni siquiera me di cuenta... ¡aunque hueles tan dulce!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya se inclina cerca de Beatrice y olfatea como un cachorro ansioso al que sujetan el collar (soy yo quien sostiene el collar).")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Te sigo desde esta tarde.", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sonríe, toda refinada y con clase, y no puedo evitar sonrojarme.")
	await novel_interface.show_text_only("Es cierto que he oído que ella ha estado ayudando con algunos “asuntos especiales” en el SID.")
	await novel_interface.show_text_only("Esta encantadora dama que afirma haber muerto hace más de setecientos años es una bruja a quien invoqué usando el colgante de la familia de Raphilia en el Sky Hotel.")
	await novel_interface.show_text_only("Se dice que Beatrice es víctima de una “maldición” que hace que todos los humanos del sexo opuesto se enamoren de ella.")
	await novel_interface.show_text_only("Me siento muy nervioso cada vez que la veo. Debe ser por esa maldición.")
	novel_interface.show_character("ren_fishnet", "shy")
	await novel_interface.show_dialog("Espera... cuando nos retuvieron en la comisaría...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("Me comuniqué con Mariru tan pronto como te arrestaron, pero ella parecía estar ocupada o en algún lugar con mala señal y no respondió a mi mensaje.", "Beatriz")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Decidí que ustedes dos deberían poder escapar pronto de todos modos ya que Sonya estaba allí, así que me quedé aquí y vigilé a Elluka.", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "shy_right")
	await novel_interface.show_dialog("Uh... entonces, ¿cómo llegó Elluka hasta allí?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando hablo con Beatrice, nunca sé dónde mirar; de alguna manera, estoy demasiado nervioso para mirarla a los ojos.")
	await novel_interface.show_text_only("Sonya, por otro lado, estudia mis expresiones con mucho interés. ¿Por qué ese mocoso es tan molesto?")
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("Cuando Sonya te tenía contra la pared, esa niña se escapó para seguir a un tipo que vendía postres.", "Beatriz")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Ustedes dos...", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice suspira profundamente, como si estuviéramos totalmente desesperados. Lo cual no somos. ¡Ni siquiera hice nada malo!")
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("Después de eso, como Elluka no pudo encontrarlos, fue a la tienda de postres donde comieron esta tarde. El comerciante no sólo le dejó comer gratis sino que también le dio un papel en el evento promocional de esta noche.", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("(¡Vaya, ese comerciante calvo tiene buen ojo para detectar los posibles favoritos del público!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("No estaba familiarizado con Elluka, así que supuse que a ella simplemente le gustaban los dulces. Pero ahora que la estoy mirando, algo no está bien...", "Beatriz")
	await novel_interface.show_dialog("Tú también puedes saberlo, ¿verdad, Sonya?", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Realmente no...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mira en dirección a Elluka.")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("No parece haber sido amenazada ni drogada.", "Soya")
	await novel_interface.show_dialog("No parece herido por ninguna parte. Simplemente actuando según sus deseos, de una manera adecuada para un niño de su edad.", "Soya")
	novel_interface.change_expression("wordless")
	await novel_interface.show_dialog("Lo único inusual es que seguro está comiendo mucho, pero aun así...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "grieved")
	await novel_interface.show_dialog("Según la noticia, ya se han producido enfrentamientos violentos entre manifestantes en seis zonas diferentes de la Zona Desmilitarizada Acordada.", "Beatriz")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Y este podría convertirse en el séptimo, incluso si todavía no hay ningún conflicto, simplemente hay demasiadas personas para considerarlas seguras.", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("No es de extrañar que el ejército esté aquí.\n¡Entonces tenemos que irnos con Elluka lo antes posible!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Pero, ¿cómo deberíamos superar a sus fanáticos locos?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Puedo ayudar a desviar su atención, pero hay tanta gente alrededor, que probablemente no podré mantenerlos ocupados durante más de treinta segundos.", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "worry")
	await novel_interface.show_dialog("¿Cómo vas a...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pueda terminar mi pregunta, Beatrice interrumpe.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Hay algo que todos los ávidos fans de Elluka tienen en común.", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Están todos... ¿muy emocionados?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sonríe y levanta el brazo derecho.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("No. Estos idiotas... ¡son todos hombres!", "Beatriz")
	await novel_interface.hide_character()
	
	print("=== 天启篇第10话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
