# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("И как румянее всего горит сияние над волной,\nВот и ждёт восходящая команда, которую Фаэтон\nЯ знал, как вести, и в каждой части свет")
	await novel_interface.show_text_only("Уменьшение исчезновения, наиболее интенсивное посередине;\nТак сожгла мирная Орифлэйм и ослабила\nСо всех сторон затухло живое пламя.")
	await novel_interface.show_text_only("И среди этой среды развевались их спортивные вымпелы\nТысячи Ангелов; в великолепии каждый")
	await novel_interface.show_text_only("Необычное и необычное украшение...")
	await novel_interface.show_text_only("—Песнь XXXI, «Рай», «Божественная комедия».")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Мариру стоит, играя с фотографией в руках, внимательно наблюдая за седым мужчиной перед ней.")
	await novel_interface.show_text_only("Об этом человеке не так уж и много информации. Никто даже не знает, настоящее ли у него имя Ламберт, не говоря уже о том, какова его фамилия.")
	await novel_interface.show_text_only("Но фактом является то, что он был посвящен в рыцари под этим именем за «выдающийся вклад в дело мира во всем мире».")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Акико уже подтвердила, что с ним можно вести переговоры.)", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Большинство людей считают, что причина, по которой Объединенный Конгресс обладает наибольшей властью над нашей планетой, заключается в том, что именно здесь собираются лидеры стран всего мира.", "Мариру")
	await novel_interface.show_dialog("Правда, такой тип организации когда-то существовал в истории. Но структура была хлипкой, и члены никогда не могли перестать спорить. Председатель действовал скорее как миротворец-попрошайка.", "Мариру")
	await novel_interface.show_dialog("Но тот Объединенный Конгресс, который у нас сейчас есть, совсем не такой. Гораздо более влиятельный. И гораздо богаче.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру с бесстрастным лицом кладет фотографию обратно в карман.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Из интереса рождается доверие. Из доверия рождается сила. А власть за счет расстановки и распределения ресурсов порождает еще больший интерес...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ламберт поднимает бровь.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Это базовая модель общества Уокера.", "Ламберт")
	await novel_interface.show_dialog("Политики выбираются группами интересов в качестве агентов, пользующихся доверием общественности.", "Ламберт")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Если эти агенты не смогут поддерживать или создавать более крупные интересы, их полномочия будут отняты, и их место займет кто-то другой.", "Ламберт")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Это верно для макроистории, но общественность никогда не была разумной. Как однажды сказал Ле Бон...", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Массы никогда не жаждали истины. Тот, кто может снабдить их иллюзиями, легко становится их хозяином; тот, кто пытается разрушить их иллюзии, всегда становится их жертвой.", "Ламберт")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— бормочет Ламберт, заканчивая за нее цитату. Мариру улыбается и кивает.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Существует слишком много способов пропустить часть интересов и напрямую завоевать доверие общественности.", "Мариру")
	await novel_interface.show_dialog("Лидеры этого типа не боятся идти на огромные жертвы, если в конечном итоге добиваются успеха.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Однако после Семилетней войны те, кто обеспечивает безопасность жизни масс и управляемых наций, начинают переосмысливать всю ситуацию.", "Мариру")
	await novel_interface.show_dialog("И таким образом они сформировали Объединенный Конгресс. Организация, которая сотрудничает и ведет переговоры напрямую с заинтересованными группами.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Итак, на самом деле все наоборот. Объединенный Конгресс не обладает властью, потому что он состоит из национальных лидеров. На самом деле, правда в том, что только те, кто находится в Конгрессе, имеют право стать национальными лидерами.", "Мариру")
	await novel_interface.show_dialog("Эта организация сделала свой первый шаг три года назад...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру делает паузу. Ламберт смотрит на нее, затаив дыхание.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Три года назад Объединенный Конгресс и церковь работали вместе над испытанием вещества H класса EX в Южной Америке. Они оказали давление на тамошних полевых командиров мафии, чтобы те работали с ними.", "Мариру")
	await novel_interface.show_dialog("Однако эксперимент вышел из-под контроля. Погибло более сорока шести тысяч местных жителей.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Они подкупили всех, кто знал правду, чтобы те заткнули им рот, и заклеймили все это как резню на реке Чурун, возложив вину на Карлоса Бранко, единственного военачальника, который отказался сотрудничать.", "Мариру")
	await novel_interface.show_dialog("Новость об инциденте стала вирусной. СМИ это понравилось. Общественность ненавидела это и в больших масштабах демонстрировала свое отвращение и ненависть к войне.", "Мариру")
	await novel_interface.show_dialog("А Объединенный Конгресс получил широкое признание как организация, которая участвовала в совместной военной операции по убийству Бранко. Никто даже не удосужился усомниться в законности существования этой организации.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Но не слишком ли это неестественно? Тысячи тел, расположенных в виде массива, с церковью в центре...", "Мариру")
	await novel_interface.show_dialog("Я считаю, что Конгресс применил там оружие с веществом H, способное разрушить радиоволны в радиусе двух миль, чтобы скрыть правду.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Похожая аномалия произошла и на поле боя в Западной Азии. Вот почему все изображения, снятые спутниками там, были искажены — в конце концов, свет тоже был разновидностью волны.", "Мариру")
	await novel_interface.show_dialog("Именно поэтому сбои в работе радиоволн в этом районе сохранялись неделями даже после того, как «ворота» были закрыты.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру делает сильный акцент на словах «ворота». Ламберт закрывает глаза, смирившись.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Мариру изучает фотографию в своей руке.")
	await novel_interface.show_dialog("Для вывоза всех этих тел потребовалось много рабочих. Должно быть, было трудно гарантировать, что ни один из них ничего не утечет.", "Мариру")
	await novel_interface.show_dialog("Могу поспорить, вы никогда не ожидали, что кто-то сфотографирует это место старой механической камерой и рулоном гнилой пленки.", "Мариру")
	await novel_interface.show_dialog("Фон изображения был размыт. Это произошло из-за свойств искажения света оружия Вещества H, которое использовали ваши люди.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Интересно. Но почему вы так уверены, что я в этом замешан?", "Ламберт")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("За месяц до инцидента вы были назначены генеральным секретарем Организации Договора о запрещении экспериментов с оружием с веществом H.", "Мариру")
	await novel_interface.show_dialog("На первый взгляд, цель этой организации — запретить эксперименты с оружием с веществом H. Это мощное учреждение с большим количеством ресурсов и отличными возможностями сбора информации.", "Мариру")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Вы не можете не знать об инциденте такого масштаба. Причина, по которой вы решили не говорить об этом, заключалась в том, что вы, по сути, были тем, кто все это спланировал.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ламберт не пытается протестовать, а Мариру воспринимает его молчание как знак того, что можно продолжать двигаться вперед.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("В конце концов, церковь послала своих людей, чтобы найти вещество H, вызвавшее все проблемы. Впоследствии они получили ненормальное количество средств и привилегий от Объединенного Совета.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Вещество H, о котором идет речь, представляет собой полуоткрытую черную дверь. За ним ослепительный золотой свет —", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Хватит! Я понимаю!", "Ламберт")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ламберт прерывает его, поднимая обе руки в знак капитуляции.")
	await novel_interface.show_text_only("Он дергает воротник костюма и прочищает горло.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Действительно, миссия нашей организации состоит в том, чтобы гарантировать, что у общественности не будет легкого доступа к оружию с веществом H, не говоря уже о его использовании в экспериментах.", "Ламберт")
	await novel_interface.show_dialog("Вещество H слишком опасно. Если не соблюдать осторожность, это может уничтожить нашу цивилизацию. Но тот эксперимент, который мы провели... он был неизбежен. Кто-то должен был это сделать, возможно, это были мы.", "Ламберт")
	await novel_interface.show_dialog("Кто-то... что-то... стучалось в дверь изнутри. Всё срочно. У нас не было выбора...", "Ламберт")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Стук...?", "Мариру")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Да, стучится в дверь рая.", "Ламберт")
	await novel_interface.show_dialog("Небеса существуют во всех религиях и мифологических системах в разных формах. Определения могут различаться в каждой системе верований, но, возможно, все они родились из одного и того же источника.", "Ламберт")
	await novel_interface.show_dialog("В исторических записях говорится, что прямо перед тем, как дверь откроется, в нее постучат три раза подряд.", "Ламберт")
	await novel_interface.show_dialog("Глубокие, гулкие удары. Словно стучится в душу слушателя...", "Ламберт")
	await novel_interface.show_dialog("После того, как стук раздастся впервые, на неделю наступит тишина, а затем стук начнется снова. Интервалы между ударами постепенно становятся короче...", "Ламберт")
	await novel_interface.show_dialog("Когда между каждым ударом пройдет не более девяноста секунд, мы узнаем, что дверь рая готова открыться.", "Ламберт")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Вы можете определять «существо» за дверью как угодно, но факт остается фактом: оно обладает силами, которые могут привести к катастрофе уровня апокалипсиса.", "Ламберт")
	await novel_interface.show_dialog("Массивное наводнение, например, да...", "Мариру")
	await novel_interface.show_dialog("Согласно церковным рукописям, единственный способ сохранить дверь закрытой — это собрать около десяти тысяч человек в хребте, окружающем дверь...", "Ламберт")
	await novel_interface.show_dialog("Своего рода жертва, да?", "Мариру")
	await novel_interface.show_text_only("Ламберт игнорирует замечание Мариру и продолжает.")
	await novel_interface.show_dialog("Подобные вещи происходили каждые несколько сотен лет. Трупы всегда располагались радиальным рядом, в центре которого была дверь.", "Ламберт")
	await novel_interface.show_dialog("Этот вид ритуала обычно проводился тайно. Однако, поскольку между одним ритуалом и другим всегда проходили сотни лет, некоторые люди из определенных эпох использовали их в своих целях...", "Ламберт")
	await novel_interface.show_dialog("Например, Варфоломеевская бойня в Париже 1572 года.", "Ламберт")
	await novel_interface.show_dialog("В ночь перед Варфоломеевским днем того года произошла ужасная религиозная резня, самая ужасная за всю историю, унесшая жизни более семидесяти тысяч человек.", "Ламберт")
	await novel_interface.show_dialog("Париж, да...", "Мариру")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Подождите, радиальный массив с дверью в центре?", "Мариру")
	await novel_interface.show_text_only("Мариру сразу вспоминается, как устроены дороги в городе романтики.")
	await novel_interface.show_dialog("Иронично, не правда ли...", "Ламберт")
	await novel_interface.show_text_only("Ламберт невесёло смеётся.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("И все же в дверь нельзя постучать, если она не имеет конкретной формы. Почему бы вам просто не уничтожить его или не выбросить куда-нибудь в космос?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Дверь рая — это всего лишь концепция. Вначале дверь никогда не появлялась в одном и том же месте дважды.", "Ламберт")
	await novel_interface.show_dialog("Он появлялся даже там, где не должно было быть двери. Например, на поверхности древних городских стен.", "Ламберт")
	await novel_interface.show_dialog("Они всегда приносили с собой несчастья, но также были своего рода божественными реликвиями, доказательством существования существования за пределами нашего понимания.", "Ламберт")
	await novel_interface.show_dialog("Религиозные группировки в истории никогда не прекращали воевать из-за этой концепции, желая объявить ее своей.", "Ламберт")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Как именно можно заявить о концепции?", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Исторические записи говорят нам, что собор Святой Софии долгое время был официальным «владельцем» небесной двери.", "Ламберт")
	await novel_interface.show_dialog("Затем, в пятнадцатом веке, скульптор Лоренцо Гиберти из Флоренции заявил, что владеет этой концепцией через произведение искусства, над которым он работал всю свою жизнь.", "Ламберт")
	await novel_interface.show_dialog("Это произведение искусства, завершенное в 1452 году, использовалось в качестве главного входа во Флорентийский собор. Мир согласился, что с этого момента она будет называться дверью рая.", "Ламберт")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Я вижу.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Самый древний метод, который люди использовали, чтобы заявить о своей собственности на концепцию, заключался в том, чтобы доказать свою ценность посредством создания величественных, экстравагантных произведений искусства.")
	await novel_interface.show_text_only("Пирамиды, храмы, дворцы, короны, троны...")
	await novel_interface.show_text_only("Все способы доказать, что автор — истинный, достойный владелец концепции.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Подождите… разве Константинополь, где находится собор Святой Софии, не был захвачен и оккупирован через год после завершения работы Гиберти? Было ли это потому, что...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ламберт качает головой.")
