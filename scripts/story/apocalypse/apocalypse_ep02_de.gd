# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Aufnahmen der Geiselrettungsmission sind überall in den Frühnachrichten am Freitag zu sehen.")
	await novel_interface.show_text_only("Da der SID alle Fluchtwege im Aegis-Gebiet gesperrt hat, blieb den Entführern keine andere Wahl, als ihre Geisel vorübergehend in einem verlassenen Lagerhaus festzuhalten.")
	await novel_interface.show_text_only("Vier Terroristen, die im Verdacht stehen, einen hochrangigen Vertreter des UN-Rats entführt zu haben, wurden festgenommen. Ein zufriedenstellendes Ende dieses Vorfalls.")
	await novel_interface.show_dialog("Mord und Entführung am helllichten Tag auf internationalem Territorium – es ist, als würden sie alle Mitgliedsstaaten des Vereinigten Kongresses zum Krieg auffordern!", "Lumbert")
	await novel_interface.show_dialog("Dieser Vorfall ist ein Beweis dafür, dass der Terrorismus uns überall umgibt. Auch die jüngsten Spacetime-Flux-Aktivitäten könnten etwas mit den Terroristen zu tun haben.", "Lumbert")
	await novel_interface.show_dialog("Als Überlebender des Krieges bin ich fest davon überzeugt, dass Einschüchterung ein wichtiges Mittel zur Gewährleistung von Sicherheit und Frieden ist.", "Lumbert")
	await novel_interface.show_text_only("Ich spotte, während ich das Interview überspringe, bei dem es sich offensichtlich um Drehbuch-Quatsch handelt, während ich den achtzigsten Kartoffelchip in einer Stunde esse.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Dieser Kerl... wäre er fast gestorben? (Munch, munch)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ja. Haben sie ihn nicht erst vor wenigen Stunden gerettet? Und er hält bereits eine Rede. Hmm. Verdächtig...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Dennoch war der Teil mit den Helikoptern und dem Rettungsteam ziemlich knallhart. Fast wie ein Film.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mm, so cool!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka nickt mit ernstem Gesicht.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Es handelt sich hauptsächlich um einen hervorragenden Schnitt und eine großartige Hintergrundmusik. Wer mag keine filmischen Effekte, oder?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aufgrund der wichtigen Veranstaltung in der Stadt beginnt die Schule heutzutage ziemlich spät, nämlich gegen halb zehn. Außerdem verlassen wir den Unterricht viel früher.")
	await novel_interface.show_text_only("Annie, Elluka und ich liegen zusammengerollt wie kleine Hamster auf der Couch und teilen uns Chips (eher so, als hätte Annie sie mir gestohlen).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("War die Aufklärung des SID nicht der Hauptgrund dafür, dass die Rettung so erfolgreich war?\nDie Nachricht hat uns nicht einmal die Ehre erwiesen ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Geheimdienste brauchen schließlich Anonymität, um zu überleben. Ich muss unter dem Radar fliegen.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Fräulein Ren...\nWillst du Schokolade...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ellukas kleiner Kopf ragt plötzlich zwischen Annie und mir hervor.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Schokoladen-Pocky?\nDer Supermarkt unten scheint leer zu sein. Wir haben alles gekauft.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Das nächste Mal, wenn wir in den Supermarkt gehen, hole ich dir noch etwas mehr.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Aber... ich will es... jetzt...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka schmollt und schüttelt die leere Schachtel vor meinem Gesicht, während ihre Unterlippe wackelt.")
	await novel_interface.show_text_only("Aber jetzt ist es zu heiß, um nach draußen zu gehen. Ich möchte nur drinnen bleiben, die Klimaanlage genießen und eine Kartoffel sein.")
	await novel_interface.show_text_only("Mariru war in diesen Tagen beschäftigt. Immerhin sind unzählige wichtige Persönlichkeiten in der vereinbarten entmilitarisierten Zone eingetroffen, um am vierten Internationalen Friedensforum teilzunehmen.")
	await novel_interface.show_text_only("Der Umfang des Forums in diesem Jahr ist wirklich beeindruckend. Die fünf Akademiestädte außer New Opulentia haben jeweils Hunderte von Vertretern entsandt.")
	await novel_interface.show_text_only("Eine Konferenz hochrangiger Regierungschefs obendrein. Natürlich hat es viele Probleme im Alltag der Menschen verursacht.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Viele Bereiche in der Stadt sind mittlerweile vorübergehend fahrradfreie Zonen. Bei der Bestellung der Lieferung war es für uns wirklich umständlich.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie beschwert sich, während sie auf ihrem Telefon scrollt, das unordentlich auf der Couch liegt.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Gut, gut, ich hole euch ein paar Snacks.\nAnnie, soll ich irgendetwas mitbringen?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Hehe...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Die beiden listen prompt Dutzende von Artikeln auf und sehen dabei völlig selbstgefällig aus.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Warum ist es so heiß?", "Lian")
	await novel_interface.show_dialog("Ich schmelze...", "Lian")
	await novel_interface.show_text_only("Es ist noch früh am Tag, der Supermarkt hat gerade erst eröffnet, aber draußen ist es bereits schwül.")
	await novel_interface.show_text_only("Ich stapfe weiter und schleppe eine riesige Tüte Junkfood mit mir herum. Heutzutage scheint sich eine Menge Sicherheitspersonal auf den Straßen zu bewegen.")
	await novel_interface.show_text_only("Es wurden zahlreiche Transportbeschränkungszonen eingerichtet. Bürger müssen jederzeit einen Personalausweis mit sich führen.")
	await novel_interface.show_text_only("Polizeiautos und Sicherheitskräfte sind an jeder Haltestelle des öffentlichen Nahverkehrs zu finden.")
	await novel_interface.show_text_only("Der Transport ist in der vereinbarten entmilitarisierten Zone größtenteils eingeschränkt. An allen Straßenlaternen der Hauptverkehrsstraße wurden brandneue Überwachungsgeräte angebracht.")
	await novel_interface.show_text_only("Ich habe gehört, dass der Vereinigte Kongress alle Söldner einstellen muss, die Ritnalap zu bieten hat, da die Stadt nicht über genügend Sicherheitssoldaten verfügt.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Trotzdem denke ich, dass es verständlich ist, wachsam zu sein ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue von der erhöhten Kreuzung herunter und sehe eine Gruppe von Demonstranten vorbeigehen. Ein Kameramann eines Nachrichtensenders folgt ihnen und filmt die Prozession.")
	await novel_interface.show_text_only("Es ist noch nicht lange her, dass der Krieg zu Ende war. Natürlich würden sich alle möglichen Organisationen, Gruppen und Medienkanäle freuen, während einer so wichtigen Veranstaltung ein Publikum in New Opulentia zu finden.")
	await novel_interface.show_text_only("Die Organisationen haben alle unterschiedliche Ziele – regionale Konflikte, Rassenprobleme, Flüchtlingsprobleme, religiöse Unterdrückung, wirtschaftliche Probleme … was auch immer, es gibt eine Organisation, die darüber schreit.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Es gibt hier sogar Missionarsgruppen, die neue Anhänger suchen. Hätte man sich dafür nicht eine weniger chaotische Zeit aussuchen können?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hat mir erzählt, dass auch die letzten drei Internationalen Friedensforen nicht ganz reibungslos verliefen.")
	await novel_interface.show_text_only("Die vorherige Veranstaltung sollte in Masada Ford stattfinden, aber aufgrund der häufigen Terroranschläge an den Grenzen mussten sie nach Salmonton umziehen.")
	await novel_interface.show_text_only("Dann kündigte Dr. Deckers auf dem letztjährigen Forum aus dem Nichts an, dass Salmonton nun seine Türen für alle Flüchtlinge öffnen werde. Das führte natürlich zu viel Geschrei und Aufruhr.")
	await novel_interface.show_text_only("Raphilia hatte danach einen politisch inkorrekten Kommentar abgegeben, weshalb ihre Familie sie schließlich nach New Opulentia schickte.")
	await novel_interface.show_text_only("Was das Jahr davor betrifft, haben Terroristen einen ganzen Häuserblock in Newmoridas bombardiert. Sogar Militärhubschrauber geschickt.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Das muss schrecklich gewesen sein...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Vor zwei Tagen wurde Skuld zu einer Wohltätigkeitsveranstaltung im Botschaftsbereich eingeladen und spendete großzügig an hungernde Kinder in Südamerika.")
	await novel_interface.show_text_only("Zufälligerweise protestierte eine vegane Organisation aus Europa gegen das Schlachten von Tieren außerhalb des Veranstaltungsortes.")
	await novel_interface.show_text_only("Einige von ihnen zogen sich aus und legten sich auf den Boden, um Steakstücke zu simulieren.")
	await novel_interface.show_text_only("Wir sahen zu, wie ein Dienstmädchen einen Topf violetter Soße mit Tintenfischtentakeln auf ein „Steak“ aus der Live-Übertragung im Fernsehen goss.")
	await novel_interface.show_text_only("Das unglückliche „Steak“ kletterte auf allen Vieren davon und kreischte aus vollem Halse.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("Und heute veröffentlichte die offizielle Website der Organisation eine Erklärung, in der behauptet wurde, dass ihre Mitglieder schwer traumatisiert seien.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Hahaha...\n(Ich hoffe, Fabella erkennt jetzt, wie schrecklich ihre Kochkünste sind!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich vibriert mein Telefon in meiner Tasche.\nMariru hat eine Nachricht gesendet.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Hm. Melden Sie sich heute im Hauptquartier, nicht wahr?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Vor zehn Stunden>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, SID-Kontrollraum>")
	await novel_interface.show_text_only("Eine rothaarige Frau in Militärkleidung steht mit vor der Brust verschränkten Armen da und starrt wütend auf die Dutzenden roten Klammern, die sich schnell auf dem Schwarzweißbildschirm bewegen.")
	await novel_interface.show_text_only("Plötzlich erscheint im unteren Teil des Bildschirms ein Chat-Fenster.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Boss, unseren Unterlagen zufolge befindet sich die Geisel Sir Lumbert immer noch irgendwo im Schutz der Aegis.", "SID-Agent")
	await novel_interface.show_dialog("Unsere Analyse der Überwachungsrückverfolgung zeigt uns, dass sich der Entführer höchstwahrscheinlich in einem dieser drei Gebiete aufhält. Ein verlassenes Lagerhaus in der Bay Area weist ungewöhnliche Stromverbrauchsaktivitäten auf ...", "SID-Agent")
	await novel_interface.show_dialog("Sollten wir das Verteidigungsbüro informieren?", "SID-Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Noch nicht. Umzingeln Sie die Gegend und warten Sie auf meine Befehle.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Verstehen Sie das.", "SID-Agent")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru schließt das Fenster und wechselt zum Militär-Chat-Kanal.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Das bergige Gebiet liegt vor uns. Halten Sie den Helikopter auf einer sicheren Höhe, damit wir nicht bemerkt werden.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verstanden. Wir haben klare Bilder vom Wärmemesssatelliten.", "Soldat A")
	await novel_interface.show_dialog("Sie bewegen sich so schnell ... sind das wirklich Menschen?", "Soldat A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Technisch gesehen waren sie einst Menschen. Einfach nicht mehr.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wurden alle in der Richtung, in die sie gehen, evakuiert? Wenn etwas Ungewöhnliches auftritt –", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Unsere Kanonen und regionalen Vernichtungswaffen stehen bereit.", "Soldat B")
	await novel_interface.show_text_only("Mariru nickt. Sie möchte dem Militär nicht zu viel verraten.")
	await novel_interface.show_text_only("Außerdem hatte sie seit Beginn dieser Verfolgungsmission ein ungutes Gefühl dabei ...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Normalerweise gehen wir gegen die „Hexen“ vor, die außerhalb der Innenstadt von New Opulentia auftauchen, indem wir sie mit den schweren Schusswaffen, die das Militär im Voraus in der Gegend stationiert hat, gewaltsam vernichten.)", "Mariru")
	await novel_interface.show_dialog("(Erfahrungen aus der Vergangenheit zufolge greifen diese Dinger normalerweise zufällig Lebewesen oder Einrichtungen in der Nähe an, nachdem ihre Hexenkokons verschwunden sind.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Aber in den letzten zwei Wochen scheinen sie eine Art identisches Muster zu zeigen ...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Warte... da vorne ist jemand!", "Soldat A")
	await novel_interface.show_dialog("Habe auch eine Kettensäge dabei. Vielleicht ein Holzfäller?", "Soldat B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiot, welcher Holzfäller arbeitet um 23 Uhr?\nWas sind die Ergebnisse des Meme-Tests?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Grün. Es ist menschlich!", "Soldat A")
	await novel_interface.show_dialog("Und... auch ein menschliches Mädchen?", "Soldat B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru zoomt sofort auf das aufgenommene Filmmaterial heran.")
	await novel_interface.show_text_only("Auf dem Wärmebildschirm ist ein kleines Mädchen zu sehen, das ein Kopftuch trägt und eine Kettensäge in der Hand hält, die fast so groß ist wie sie.")
	await novel_interface.show_text_only("Und sie winkt diesen rasanten Hexen zu.")
	await novel_interface.show_text_only("Die führenden Hexen, alarmiert durch das Geräusch der surrenden Kettensäge, ändern ihren Kurs und führen das Rudel in ihre Richtung.")
	await novel_interface.show_text_only("Eine Hexenkolonie dieser Größe kann normalerweise nur von einer Gruppe schwer gepanzerter und erfahrener Maschinengewehrschützen niedergeschlagen werden. Das Mädchen hat keine Chance.")
	await novel_interface.show_text_only("Doch bevor Mariru überhaupt das Aufräumteam alarmieren kann, um die Leiche des Mädchens später einzusammeln, dreht sich das Mädchen einfach zu den Hexen um, strahlend und mit der Kettensäge in der Hand.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Sie passt ihr Tempo und ihre Haltung an, während unzählige Hexen vorbeistürmen, weicht ihren Angriffen geschickt aus und schneidet gleichzeitig die ankommenden Hexen auseinander.")
	await novel_interface.show_text_only("Die Hexen sind wie frisches Fleisch, das in einen Hochleistungszerkleinerer gestopft wird, am Ende winzige Fleischstückchen.")
	await novel_interface.show_text_only("Das Mädchen bewegt sich sanft und greift an, wobei es die Gesetze der Trägheit und der Zentrifugalkraft zu seinem Vorteil nutzt. Sie scheint nicht besonders stark zu sein – sie hat nur die Physik auf ihrer Seite.")
	await novel_interface.show_text_only("Wahrscheinlich hatte sie zuvor einige Berechnungen angestellt und aufgrund der Eigenschaften der Ziele und ihrer eigenen Stärke die Kettensäge als effektivste Waffe ausgewählt.")
	await novel_interface.show_text_only("Innerhalb von dreißig Sekunden sind die Dutzenden Hexen, die der SID und das Militär vier Tage lang verfolgt hatten, nur noch zerfetztes Fleisch.")
	await novel_interface.show_dialog("W-was machen wir jetzt?", "Soldat A")
	await novel_interface.show_text_only("Mariru seufzt.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Verdammt...", "Mariru")
	await novel_interface.show_dialog("Spotlights an. Höllenfeuerrakete bereit –", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Versuchen Sie, über einen Lautsprecher mit ihr zu sprechen. Sag ihr, dass sie umzingelt ist. Wenn sie es wagt, sich zu bewegen, sprenge sie zusammen mit diesem Berg in Stücke.", "Mariru")
	await novel_interface.show_dialog("Bring sie lebendig zurück!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<Ein paar Stunden später, SID-Verhörraum>")
	await novel_interface.show_text_only("Neben dem Einwegspiegel blättert Mariru auf ihrem Handgerät durch die Datei des Ziels.")
	await novel_interface.show_text_only("Name: Sonya Angeles")
	await novel_interface.show_text_only("Alter: 14...?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organisation...", "Mariru")
	await novel_interface.show_dialog("Sonderbezirk Salmonton Church, CDF.", "Mariru")
	await novel_interface.show_dialog("Das war mal ein religiöses Gerichtsgebäude, oder?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru tippt auf einen Knopf und das Glas wird klar. Auf der anderen Seite begegnet ihr ein Mädchen im Nonnenkostüm mit stillen, gefügigen Augen.")
	await novel_interface.show_text_only("Ihr zierlicher Körper ist unter ihrem schweren schwarzen Samtkleid verborgen, das von einer dunkelroten Brosche zusammengehalten wird.")
	await novel_interface.show_text_only("Anstelle einer Nonnenmütze trägt sie ein Paar Katzenohren auf dem Kopf. Scheint ihr gut zu stehen.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Langes, glattes silbernes Haar, azurblaue Augen. Hätte süß sein sollen, aber dieses unheimlich kalte und lässige Lächeln auf ihrem Gesicht – scharf, gruselig.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru überfliegt die zugehörigen Berichte und bemerkt die Zeile mit roter Schrift unten:")
	await novel_interface.show_text_only("Diese Person ist durch die besonderen Bedingungen des Salmonton-Abkommens geschützt und kann von keiner Organisation, die einem Mitgliedsstaat des Vereinigten Kongresses angehört, länger als zwölf Stunden festgehalten werden.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Hallo. Der Ermittlungsbefehl des New Opulentia-Militärs gegen Sie wurde bereits aufgehoben.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("Ach? Gut.\nIch hatte solche Angst!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Sie sollten diejenigen sein, die Angst haben. Der Soldat, der Sie gerade eingeliefert hat, hat sich sogar um eine Gedächtnisentfernungsoperation der Stufe C beworben ...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das silberhaarige Mädchen leckt sich mit gefesselten Händen die Lippen und grinst aufgeregt.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Äh, sie haben einfach so gestunken, weißt du? Aber ich habe ihnen nicht einmal wehgetan.", "Soya")
	novel_interface.change_expression("jest")
