# apocalypse_ep13.gd - 天启篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第13话剧本
	apocalypse_ep13_script()

func play_script():
	pass

# 天启篇第13话 - 正式剧本
func apocalypse_ep13_script():
	# 开场序章 - 关于疼痛的感受
	novel_interface.show_background("res://assets/images/bg/Soya/Hypnosis2.png")
	await novel_interface.show_text_only("──こんな話を聞いた事があると思う。")
	await novel_interface.show_text_only("自らの身体に酷い怪我を負っても、\n例え腹部に穴を開けられたとしても、\n兵士は殺し合いが終わるまで気付かない。")
	await novel_interface.show_text_only("登山家は寒さで壊死した指を目視してから、\n初めて凍傷による激しい痛みを感じる。")
	await novel_interface.show_text_only("催眠を使用すれば、相手の痛覚を一時的に\n遮断する事さえもできる。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──なぜなら痛みは、主観的な感覚なのだから。")
	# 场景转移到小巷
	novel_interface.show_background("res://assets/images/bg/Soya/Dark_alley.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("案内すると言うだけあって、メガネの男は\nこの辺りに詳しいようだ。")
	await novel_interface.show_text_only("俺達を連れて道端のレストランに入ると、\n女将さんと挨拶をして、\nキッチンから裏門へと抜けていく。")
	await novel_interface.show_text_only("狭く長い路地を何度も回り込み、ようやく\nあの執念深い親衛隊員どもを振り切った。")
	await novel_interface.show_text_only("路地の両側の壁には空調の換気扇が、\nたくさん取り付けられていた。\n道端にはゴミ箱が並んでおり、誰も利用しないで\nあろう自販機がなぜか設置されてある。")
	await novel_interface.show_text_only("賑やかな電気街の裏に、こんな迷路みたいな\n複雑な場所があるなんて……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("数分後、鉄線網のフェンスゲートを通って、\nようやく大通りへと到達する。")
	
	# 到达新井中心公园外
	novel_interface.show_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("あそこが目的地の新井センターパークだと\n思います。", "眼鏡の男子")
	novel_interface.show_character("ren_fishnet", "happy")
	await novel_interface.show_dialog("すごい、こんなに早く着くのか！\n\n携帯のマップだと、かなり遠回りしないと\n到着しないって表示されるのに……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("道路の向こう側にある、明かりを灯した\n巨大なアーチは新井センターパークの東門だ。")
	await novel_interface.show_text_only("賑やかな電気街と比べれば、この大通りは民家や\nショップもないし、かなり閑散としている。")
	await novel_interface.show_text_only("無機質な街灯からジジ……ッと電流の音が響き、\n空気中にうっすらと血の臭いを感じた。")
	novel_interface.show_character("ren_fishnet", "gratified")
	await novel_interface.show_dialog("早く行こう……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一刻も早くここから離れたい……\n\nそう思った矢先、熟睡中のイルカを背負っている\nソヤから抗議が飛んできた。")
	novel_interface.show_character("soya_uniform", "cry")
	await novel_interface.show_dialog("この小娘、本当に重いのですわ……っ！", "ソヤ")
	await novel_interface.show_dialog("男性として進んで手を貸すべきじゃ\nありませんの……！？", "ソヤ")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("ご、ごめん……", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("john", "worry", 0.25)
	await novel_interface.show_dialog("あ、すみません。\n走ってばかりで、僕が気付くべきでした……", "眼鏡の男子")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("無意識に謝ってしまった俺を見て、\n少年は不思議そうにしている。\n一方、ソヤは嫌な笑顔を浮かべた。")#文字错误
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("おやおや～～？", "ソヤ")
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("（え？ まさか……）", "レン")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("まあ良いですわよ、彼女の重さはわたくしに\nとって大した枷ではありませんわ。", "ソヤ")
	await novel_interface.show_dialog("そんな事よりも誰かさぁ～～ん？\n\n先ほどのお姉様にメロメロで、鼻血まで流してた\nみたいですが……♡", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("やっぱり見られてたのか！？")
	await novel_interface.show_text_only("でも、さすがに鼻血は流してないぞ！！")
	
	# 贝阿特丽切出现
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("──メロメロだったの？", "女性の声")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺達の背後の影から、ベアトリーチェが現れる。")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("結構早かったわね、あなた達……", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("い、いつの間に、ここに？", "レン")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("ちょっとあなた……気配を隠す能力が、\n凄過ぎますわよ……", "ソヤ")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("小さい頃から慣れてるのよ。\n\n男の人にジロジロ見られたくないから、\n上手に自分を隠す方法を身に着けて……", "ベアトリーチェ")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("──しっ！ 隠れて。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェが俺達を暗い場所に引き寄せる。\n\n遠くから装甲車が走ってきて、目の前を\n通り過ぎていった。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("この道は軍隊の車両が良く通るわ。\n場所を変えましょう。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…………")
	
	# 进入公园主干道
	novel_interface.show_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("俺達は新井センターパークのメインストリートに\n着いた。\nソヤはぐっすり眠っているイルカをベンチに\nそっと下ろす。")
	await novel_interface.show_text_only("人の姿が見えない場所だけど、遠くから子供や\nペットの遊ぶ声がかすかに聞こえてくる。\nようやく安心できる場所に着いたんだと\n実感が持てた。")
	await novel_interface.show_text_only("ベアトリーチェは俺達を助けてくれた案内人を\nじっくりと観察する。")
	novel_interface.show_character("beatrice_regular", "normal")
	await novel_interface.show_dialog("この方は──？", "ベアトリーチェ")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("あっ！自己紹介が遅れました……", "眼鏡の男子")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少年はベアトリーチェを前に、どこを見たら\n良いのか分からず慌てている様子だ。")
	await novel_interface.show_text_only("なんとか顔を直視しようと頑張るが、\n胸元の立派なモノが気になってしまい、\n目線を逸らして誤魔化そうとしても、それが\nかえって目立ってしまう。")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("（うんうん、分かるぞ！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しかし、ここまであからさまに分かって\nしまうとは……")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("（もうこの手は使えないな……）", "レン")
	novel_interface.show_character("john", "worry")
	await novel_interface.show_dialog("ぼ、僕の名前はジョンと言います。\n電気街のお店でアルバイトしてまして。", "眼鏡の男子")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("ジョン？\n\n教科書とかに登場しそうな、没個性的な名前を\nお持ちですのね？", "ソヤ")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("た、確かに良くある感じの名前ですが……", "ジョン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ジョンは恥ずかしそうにメガネを上げた。")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("ご、ごめんなさい！ \n\nさっきパレードカーで叫んでいたあなたの姿が\n格好良かったので、つい……", "ジョン")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("つい？", "ベアトリーチェ")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("こっそり携帯で録画……しました……", "ジョン")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("あら……帰ってから、じっくりと味わう\nおつもりかしら～～？", "ソヤ")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("（気持ちは分かるけど……）\n\n（そういう事は白状しちゃダメだぞ！）", "レン")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("たまたま隣のパレードカーを撮っていた時、\n君達が追いかけられていたのを見まして。\nど、どこから勇気が湧き上がってきたのか、\n僕自身にも分かりませんが……", "ジョン")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ジョンは俺の方をチラッと見ると、\n顔から首の付け根まで真っ赤にして……\n声もだんだん小さくなっていった……")
	novel_interface.show_character("ren_fishnet", "speechless")
	await novel_interface.show_dialog("…………", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("昔オンラインゲームでネカマをやっていた時、\n仲間の男性が俺に告白してきたのを思い出した。")
	await novel_interface.show_text_only("俺はただ、ゲームをする際にずっと男キャラの\n尻を眺めるのが嫌なだけだったんだけど……")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("（まぁ、あの時は申し訳ないと思ったけどな…）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは彼に近づき、頭を下げて\n優しく話し始める──")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("男の子だもの……可愛い女の子が困っているのを\n見て、勇気が湧いちゃったのよね。", "ベアトリーチェ")
	novel_interface.show_character("john", "perspire")
	await novel_interface.show_dialog("ご、ごめんなさい、動画は削除します。\n壊した看板もお店の人に謝ってきますから！！", "ジョン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("お辞儀して謝るジョン。\n新豊洲育ちだって事がすぐ分かる行儀の良さだ。")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("本当に良い子ですわね……", "ソヤ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet", "stare", 0.25)
	await novel_interface.show_dialog("さっきは手伝ってくれなかった事を\n怒っていた癖に……", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("今の彼を見ている限り、看板を派手に壊して\n親衛隊を足止めするなんていう、\n大胆な事ができる人物とは思えないぐらいに\n良い奴である。")
	await novel_interface.show_text_only("あのシーンはとても印象に残っている。\n\nガラスの破片が地面に散らばり、ショートした\n電線が看板の中で音を立てていた。")
	novel_interface.show_character("ren_fishnet", "bored")
	await novel_interface.show_dialog("（彼自身も実行する前はそこまで大騒ぎになる\n　なんて思わなかったんじゃないかな……）", "レン")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("うふふ、消さなくても大丈夫よ。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは彼の肩を優しく叩く。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("あれは私が長年ずっと我慢していた事だから。\n\n今日は初めて発散できて、\n気分がとてもすっきりしたわ～～", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("あれが初めてって素質が半端ないな！？")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("今後も時折やってみようかしら……", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet", "sprite")
	await novel_interface.show_dialog("（そのたびに暴動が起きるぞ！）", "レン")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("あ、そうだわ──", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェが俺の方に来ると、\n片手で俺の腰を支える。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("さっきあなたの歩いていた姿を見たけど……\n腰を怪我したの？", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女が軽く抑えただけで、腰の痛みによって\n涙が出そうになった。")
	await novel_interface.show_text_only("俺は本能的に避けようとして、彼女の腕の中に\n倒れてしまう。\nベアトリーチェは慈むような優しい表情で、\n俺の頭を撫でながら言った。")
	novel_interface.show_character("beatrice_regular", "sad")
	await novel_interface.show_dialog("捻挫のようね、悪化する前に早く手当しないと。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは自分の手を見て確かめる。")
	novel_interface.show_character("beatrice_regular", "sad")
	await novel_interface.show_dialog("血は……出ていないわね……", "ベアトリーチェ")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("本部はここから遠いし、近くの病院まで\n送りましょうか？", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("この近くの病院は保安軍と繋がりがあるかも。\n\n今の俺達は指名手配されていると思うから……", "レン")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("捻挫でしたら、エルガノのマザーが何とかして\nくれますわ。", "ソヤ")
	novel_interface.show_character("beatrice_regular", "normal")
	await novel_interface.show_dialog("エルガノ？", "ベアトリーチェ")
	novel_interface.show_character("john", "worry")
	await novel_interface.show_dialog("指名手配……マザー……？", "ジョン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ジョンは俺達の話を聞いているが、\nまったく状況をつかめていない様子である。")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("わたくしが小さい頃にいた修道院のマザーで、\n先週、新しく建った教会に異動されましたの。\n場所は新豊洲教区、ここから近いですわ。", "ソヤ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("マザーは昔、信理部と内赦院のために\n薬を調合していましたの。\n筋肉や腱損傷については、病院の通常薬品よりも\n効果が高い事を私が保証しますわ。", "ソヤ")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("とにかく凄いお医者さんなんですよね？ \nそれじゃあ、早く行きましょう！", "ジョン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは俺よりも焦っているジョンを\n意味深く見つめる。")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("え、えっと……\nぼ、僕も同行してもよろしいですかね……？", "ジョン")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("あなたの事が心配みたいよ？\nう・さ・ぎちゃん♡", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("うおああぁぁ言わないでくれえぇぇッ！！", "レン")
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("なんですの！？　なんですのッ！？？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは尻尾を振りながら擦り寄ってくる。")
	novel_interface.show_character("ren_fishnet", "shy_left")
	await novel_interface.show_dialog("何でもない！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……そんなこんなのひと悶着をした後。\n\nベアトリーチェは咳払いをして、真剣な表情で\n現在の状況をまとめる。")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("ではまず、教会に行ってみましょう。\n\nそちらに車を手配させるから、もしダメだったら\nその車で本部までね。", "ベアトリーチェ")
