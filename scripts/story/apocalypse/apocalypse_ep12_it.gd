# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice solleva una gamba, il piede sulla ringhiera e urla nel microfono.")
	await novel_interface.show_text_only("Lo stereo, al massimo volume, porta la sua voce fino alla fine di Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Siete spazzatura, tutti voi!", "Beatrice")
	await novel_interface.show_dialog("Andate al diavolo, pervertiti!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("Cosa?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Ehm...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Lo sta solo... dicendo per attirare l'attenzione, giusto? Non lo dice sul serio, vero?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("E ha attirato l'attenzione. Tutti gli occhi sono puntati su di lei adesso.")
	await novel_interface.show_text_only("Nel momento in cui vedono il volto di Beatrice, i pedoni non riescono più a distogliere lo sguardo. Rimangono in piedi, a bocca aperta, intimoriti dai suoi tacchi alti rossi lucenti e dall'ombra seducente sotto la minigonna.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Spazzatura, tutti quanti! Bug sporchi! Ti piacerebbe che vi calpestassi a morte, vero?", "Beatrice")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Non ti vergogni?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Forse lo pensa davvero...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La maggior parte della gente per strada adesso mi sta fissando. Anche le mascotte che ballavano sui tetti degli altri camion si fermano durante le loro esibizioni per assistere allo spettacolo.")
	await novel_interface.show_text_only("Sonya e io ne approfittiamo per salire sulla scala sul lato del camion di Elluka.")
	await novel_interface.show_text_only("La ragazza è seduta sul trono e si dà una pacca soddisfatta sulla pancia gonfia. Decine di piatti vuoti giacciono sul tavolo delle offerte davanti a lei.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Lei... ha mangiato tutto questo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Osservo la zona, calcolando il modo migliore per tirare fuori questo piccolo ghiottone paffuto da tutto questo caos, ma Elluka si lancia semplicemente su di me.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Signorina Ren!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi metto un dito sulle labbra, facendole cenno di abbassarlo...")
	await novel_interface.show_text_only("Eppure è già saltata in aria, mirando dritta al mio viso...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Oh, giusto. La prima volta che ho visto Elluka, stava combattendo le streghe in aria, non è vero?")
	await novel_interface.show_text_only("Ricordo che Aya mi disse che questa ragazza, dagli undici ai dodici anni circa, a giudicare dall'età delle sue ossa, aveva subito dozzine di operazioni e aveva innumerevoli parti meccaniche installate nel suo corpo.")
	await novel_interface.show_text_only("La sua memoria è stata cancellata troppe volte: non ricorda nemmeno quando il suo occhio sinistro è stato sostituito da una protesi elettronica di livello militare.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Con tutte quelle parti meccaniche al suo interno, nonostante sia in grado di galleggiare sfruttando il campo elettromagnetico, il suo peso reale è infatti il doppio del mio...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Colpo!")
	await novel_interface.show_text_only("Elluka atterra su di me, le cosce mi stringono le costole, il ventre morbido mi copre il viso. Le sue mani paffute si aggrappano alla mia nuca.")
	await novel_interface.show_text_only("Giuro che potevo sentire la mia spina dorsale spezzarsi per la pressione.")
	await novel_interface.show_text_only("Avvolge tutto il suo corpo attorno al mio petto, alla mia testa, strofinando la guancia sui miei capelli come un gatto molto entusiasta.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("La signorina Ren è la mia preferita! *hic*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dalla sua faccia rossa e allegra e dall'insulto nella sua voce, si sarebbe potuto pensare che fosse ubriaca.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Ho sentito questo forte schiocco... erano le tue ossa?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Resto rigido, congelato sul posto. Mi sento come se il mio collo si spezzasse a metà se mi muovo anche di poco.")
	await novel_interface.show_text_only("Il trambusto sembra aver attirato l'attenzione delle femmine vicine. Alcuni addirittura ci indicano, chiedendo “che cos’è quello?”")
	await novel_interface.show_text_only("Sembro un mostro con la testa grande in calze a rete in questo momento. Non c’è da stupirsi che siano confusi.")
	await novel_interface.show_text_only("Notando la nostra situazione, Beatrice alza la voce, come per darci altro tempo per evacuare.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Appartenete tutti alla discarica! Non un grammo di decenza nelle vostre teste! Vermi! Inquietanti! Suino!", "Beatrice")
	await novel_interface.show_dialog("Tutti voi—", "Beatrice")
	await novel_interface.show_dialog("Muori!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I due oratori coro con elettricità frizzante mentre il discorso appassionato di Beatrice raggiunge il suo culmine.")
	await novel_interface.show_text_only("E infine esplodono, insieme alle lampadine dei vicini cartelloni pubblicitari illuminati.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Tutta la strada cade in un silenzio inquietante.")
	await novel_interface.show_text_only("La folla sta ancora fissando, scioccata, la signora dai capelli rossi, in piedi in tutta la sua gloria sul tetto del camion.")
	await novel_interface.show_text_only("Sonya sfrutta la breve distrazione per strapparmi di dosso Elluka, poi se la spinge sulla schiena.")
	await novel_interface.show_text_only("La ragazza più giovane, che mi si era incollata addosso come una gomma, si addormenta in un attimo.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Wow... non mi aspettavo che il moccioso pesasse così tanto...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sospiro, riuscendo finalmente a riprendere fiato, massaggiandomi la vita mentre osservo la scena. È ancora inquietantemente silenzioso.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Questi ragazzi sono pietrificati o qualcosa del genere?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma pochi istanti dopo, gli applausi iniziano a diffondersi tra la folla. Applausi forti e meravigliosi.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Aahhh! È meravigliosa! Sei meraviglioso!", "Passante A")
	await novel_interface.show_dialog("Calpestami, mia regina!", "Passante B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("Cosa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Onde e ondate di applausi estatici esplodono per tutta la strada.")
	await novel_interface.show_text_only("La folla si sta ribellando per pura eccitazione.")
	await novel_interface.show_text_only("Dai camion blindati neri dall'altra parte della strada scendono diversi soldati armati di armi automatiche, osservando confusi l'improvviso tumulto.")
	await novel_interface.show_text_only("Faccio un gesto nella loro direzione, cercando di allertare Beatrice, ed è in quel momento che intravedo per sbaglio il suo viso...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Oh caro...", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Lei è... così bella!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una calda corrente formicolio che assomiglia molto al desiderio si diffonde istantaneamente attraverso il mio corpo.")
	await novel_interface.show_text_only("Mi bruciano le guance, mi cedono le gambe...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(La voglio...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("...Ren?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La folla sta andando fuori controllo. Si lanciano insieme sul camion di Beatrice, cantando ad alta voce mentre procedono, al punto che il fragile veicolo è sul punto di ribaltarsi.")
	await novel_interface.show_text_only("Alcuni ragazzi tentano di scalare il camion da un lato, ma Beatrice semplicemente calpesta le loro mani e li respinge con un calcio.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Sì! Di più! Calpesta anche me! Per favore, mia regina!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sorride e scuote la testa vedendo l'espressione di pura idiozia sul mio viso, poi si rimette il braccialetto.")
	await novel_interface.show_text_only("Poi tira fuori dal seno una capsula d'argento grande quanto un pollice e la lancia alla folla sfrenata sotto i suoi piedi...")
	await novel_interface.show_text_only("In una nuvola di fumo bianco, la bella Beatrice scompare senza lasciare traccia.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Tuttavia, non riesco ancora a dimenticare il suo viso meraviglioso, finché Sonya non mi tira per il braccio.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Scatta via! I soldati stanno arrivando! Inoltre...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mentre il fumo si dissipa, la folla inizia a mormorare confusa, rendendosi conto che il loro oggetto di attenzione non è più lì.")
	await novel_interface.show_text_only("Io e Sonya riusciamo a malapena ad allontanarci dalla folla prima che il fanclub di Elluka si accorga che il loro idolo se n'è andato.")
	await novel_interface.show_dialog("Dov'è Lady Elluka?", "Guardia reale A")
	await novel_interface.show_dialog("Laggiù! Quello con le calze a rete ha preso la nostra Lady Elluka!", "Guardia reale B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Calze a rete? Lady Elluka?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Rapitore! Chiama la polizia!", "Guardia reale C")
	await novel_interface.show_dialog("Dopo di loro!", "Guardia reale A")
	await novel_interface.show_text_only("Un gruppo di uomini infuriati si dirige verso di noi, seguito da alcuni agenti della sicurezza.")
	await novel_interface.show_text_only("Andiamo, che razza di rapitore indossa le calze a rete?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Corri!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma è difficile per noi scrollarci di dosso la folla, soprattutto perché Sonya trasporta la grassoccia Elluka e la mia vita pulsa ancora dal dolore.")
	await novel_interface.show_text_only("Quel che è peggio, ci sono alcuni poliziotti che pattugliano più avanti...")
	await novel_interface.show_text_only("Non possiamo combattere. Non possiamo scappare. È senza speranza.")
	await novel_interface.show_text_only("All'improvviso, alle nostre spalle, arriva il rumore di vetri in frantumi.")
	await novel_interface.show_text_only("Un ragazzo biondo con una giacca a vento nera ha rovesciato un cartellone pubblicitario illuminato vecchio stile lungo la strada.")
	await novel_interface.show_text_only("I cocci delle lampadine dei cartelloni pubblicitari ricoprono il terreno. I pedoni, facendo del loro meglio per evitarli, rallentano di fatto il fanclub di Elluka.")
	await novel_interface.show_text_only("Il ragazzo biondo sorride a me e Sonya, con un viso innocente e dolce.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("C'è una scorciatoia più avanti. Venga con me?", "Ragazzo con gli occhiali")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Io e Sonya ci scambiamo uno sguardo. Perché sembra una specie di scenario tratto da un film?")
	await novel_interface.show_text_only("Il giovane occhialuto, con vaporosi capelli biondi, camicia a quadri e occhi azzurri, sembra piuttosto timido.")
	await novel_interface.show_text_only("Sembra quasi imbarazzato per la nostra mancanza di reazione e si affretta a spiegare:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Io... lavoro part-time in un negozio qui intorno... sono appena uscito dal lavoro...", "Ragazzo con gli occhiali")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi guarda le gambe, deglutisce e si volta.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Wow, questo non è davvero un buon modo per lanciare sguardi furtivi alle ragazze...)\n(È fin troppo ovvio...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Sembravi che fossi inseguito da dei cattivi, quindi ho pensato...", "Ragazzo con gli occhiali")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La spalla di Sonya si abbassa mentre abbassa brevemente la guardia.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("A giudicare dalla sua aura, non vuole farci del male.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In realtà, tutto sommato, i cattivi SIAMO NOI qui...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Apri la strada!", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
