# apocalypse_ep16.gd - 天启篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第16话剧本
	apocalypse_ep16_script()

func play_script():
	pass

# 天启篇第16话 - 正式剧本
func apocalypse_ep16_script():
	novel_interface.show_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("朧げな光の下、彼女が頬を紅潮させている。\n\n水滴が彼女の足を伝ってゆっくりと滑り落ち、\n地面を濡らした。")
	await novel_interface.show_text_only("無防備な小動物のように噴水の縁に座って、\n虚ろな目で俺を見つめてくる……")
	await novel_interface.show_text_only("心臓が激しく鼓動し、顔が熱くなってきた。")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("ソヤ……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目の前の光景を見ると、彼女の過去を聞いた時の\n衝動が込み上げて、頭が真っ白になってしまう。")
	await novel_interface.show_text_only("凄まじい勢いで相手に向かって告白しようと\nしたけど、\n結局、肝心な部分で詰まってしまう漫画の\nおバカなキャラみたいだ──")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("（あああ、さっきの勢いはどこに行ったんだ！）\n\n（早く戻ってきてくれ！！）", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","smile",0.25)
	await novel_interface.show_dialog("ねぇ……", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは唇を舐めて微笑んだ。")
	novel_interface.show_character("ren_fishnet","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("今のあなたの気配……とても興味深いですの……", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("噴水の縁に沿って俺の方に近付いてくる。\n\nその動きに伴って、彼女の足輪はハニカム模様の\n光を反射させた。")
	await novel_interface.show_text_only("足輪は戦術研究部が異質物装甲で作ったもので、\n薄いが硬度は折り紙付き。\n装甲の独特な模様と彼女の白い肌に合わせて\n滴る雫が、やけに目立っているように見えた。")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("……やっぱり", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは手を掴んで俺のお腹に鼻を宛がうと、\nうっとりしながら深呼吸をする──")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("レンさんは……最高ですわぁ……♡", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("きゅ、急にどうしたんだよ？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("慌てて後ろに下がった俺。\n\nなぜかソヤの態度が積極的になっていて、\nぎこちない反応を見せるしかできない。")
	await novel_interface.show_text_only("ソヤは気だるそうに縁に座り、髪を整えた。")
	novel_interface.show_character("ren_fishnet","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","smile",0.25)
	await novel_interface.show_dialog("マザーエルガノから聞きましたわよね……", "ソヤ")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("君の身体は……一体どうなってる……？", "レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("本来であれば、あなたには知られたくなかった\nのですが……", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは軽く首を傾げると、小さな声で話す。")
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("……秘密を聞いた人は全員、態度が冷たく\nなりますの。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤに対してのエルガノの態度を思い出した。")
	await novel_interface.show_text_only("残された時間はもう長くないと知って、\n彼女に感情を注ぐのを止めたのだろうか……")
	await novel_interface.show_text_only("もしくは聖域に入れない彼女は、教皇庁の\n人間にとって一種のタブーなのかもしれない。")
	await novel_interface.show_text_only("最高免責特権を持つ『審判騎士』の資格も、\n彼女に対する一種の「追放令」と同義……")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("でも、そんな事はどうでもいいのですわ。\n\nレンさんは他の人間と違うって、\nわたくし知っていますもの……", "ソヤ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("……そうでしょう？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("確信がありながらも、不安そうに尋ねるソヤ。\n\n俺は唇をわずかに震わせながら、彼女の傍に\n近寄って頭を撫でた。")
	await novel_interface.show_text_only("ソヤは微笑みながら目を瞑って、俺の手のひらへ\n頭を擦り付ける。")
	await novel_interface.show_text_only("それから両手を広げて身体を伸ばした。\n\n彼女は俺の手を掴みながら、夜の帳に覆われた\n教会の最上部に描かれている壁画を眺める。")
	await novel_interface.show_dialog("わたくしは多分、「あいつ」に嫌われて\nいますわ……", "ソヤ")
	await novel_interface.show_dialog("そもそも彼がわたくしを好きになった事なんて、\n一度もなかったのですけどね。", "ソヤ")
	await novel_interface.show_text_only("「あいつ」とは誰なのか聞こうと思ったけど……\n\n……その前に俺のスカートを覗きつつニヤニヤ\nしているソヤが言葉を重ねた。")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("──レンさんにも、\n秘密がたくさんありますわよね？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("え？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不味い話の流れだと思った途端、彼女に思い切り\n抱きしめられた。")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("さっきマリルさんに「ソレ」を直接聞かなかった\n理由は分かりまして？", "ソヤ")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("一番面白い謎は、自分で解き明かしたい\nモノですので……♡", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("お、おいっ！！", "レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("そ、そこは……\n\n──Prrrrr！ Prrrr！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("タイミング良く俺の携帯が鳴った。\n\nそれでもソヤは気にせず手を離してくれない。")
	await novel_interface.show_text_only("俺は片方の手で電話に出て、もう片方の手で\n強引に迫ってくるソヤの顔を抑え続ける。")
	await novel_interface.show_dialog("む――ふごぅ――ッ！？", "ソヤ")
	await novel_interface.show_dialog("もしもし、レンちゃん？ 今病院なのだけど。", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("ベアトリーチェ？　 ジョンの様子は！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤが俺の手を振り払うと、俺から携帯を奪って\nスピーカー音声に切り替えた。")
	await novel_interface.show_dialog("今は点滴中で、鎮痛薬の注射を受けてからは\n安静に眠っているわ。\n命に別状はなかったわよ。", "ベアトリーチェ")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("……彼は痛みを感じるようになりましたの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……ええ。\nだけど不可解な事を聞いたわ。\n看護師さんによると、短期的な痛覚喪失の症例が\n今夜は彼を含めて4人も発生してるらしいの。", "ベアトリーチェ")
	await novel_interface.show_dialog("それぞれの患者の状況を説明していくわね？\n\nまず1人目は灼熱に晒された車のボンネットに、\n素足のまま立っていた中年男性。\n電気街の暴動を見るために登ったらしいけど――", "ベアトリーチェ")
	await novel_interface.show_dialog("焦げ臭さを感じた周囲の人々が、彼の容態に\n気付いたみたい。\n発見時はなぜか足だけでなく髪の毛まで焼けてた\nらしくて、原因については調査中よ。", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("（まさかイルカの電撃を喰らったオッサン\n　じゃないよな……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("次にニューモリダスの女性ジャーナリスト。\n\n彼女はデモ隊を撮っている時にシャッターを\n押せないと感じて、\nその時点で自分の指が骨折している事に\n初めて気付いたらしいわ。", "ベアトリーチェ")
	await novel_interface.show_dialog("後は華雲宮城の整備士ね。\n\n作業時に感電して内出血を起こしていたのに、\n電話で同僚と30分も元気に話をしていて……", "ベアトリーチェ")
	await novel_interface.show_dialog("片方の目が充血で見えなくなるまで、\n彼も異常を感じなかったようね。", "ベアトリーチェ")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェの説明に背筋がゾッとした。")
	await novel_interface.show_text_only("年齢、性別、国籍、職業、全く繋がりのない\n人間に同じ症状が出るなんて……")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("今夜の暴動は、異質物と関係があるかもしれない\nってマリルが言ってたけど……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("確かに、その可能性は否定できないかしら……", "ベアトリーチェ")
	await novel_interface.show_dialog("すでに愛衣さんが保安軍の監視データへ接続を\n完了させているわ。\nあなたの携帯も一時的な権限をもらって\nいるわよね？", "ベアトリーチェ")
	await novel_interface.show_dialog("彼ら患者の行動履歴を記録データから\n追って確認した結果、\n全員が7つの暴動エリア内のどこかしらに\n足を運んでいたみたい。", "ベアトリーチェ")
	await novel_interface.show_dialog("整備士の患者は江森重工の安全視察主任\nなのだけど……", "ベアトリーチェ")
	await novel_interface.show_dialog("彼の映っている監視映像を探してみたところ、\n午後6時過ぎに電気街付近で、\nコートを着た怪しい男と5分ぐらい会話している\n姿を見つけたわ。", "ベアトリーチェ")
	await novel_interface.show_dialog("怪しい男は意図的に監視カメラを避けていたよう\nだけれど路地を曲がった時、気が緩んだようね。\n一瞬だけ彼の顔を捕捉する事に成功したの。", "ベアトリーチェ")
	await novel_interface.show_text_only("ベアトリーチェはそこから、強調するかのように\n言葉を放つ。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("──映ったのはスカイホテルで私達を襲った\n「この男」よ。", "ベアトリーチェ")
	novel_interface.show_background("res://assets/images/bg/Soya/Monitor_Y.png")
	await novel_interface.show_text_only("同時に、彼女から画像を受け取った。")
	await novel_interface.show_dialog("ヤコブッ！！？", "レン")
	await novel_interface.show_text_only("──ヤコブ・シュミット。\n\n第三学園都市であるマサダブルクが連合議会に\n駐在させた武官。")
	await novel_interface.show_text_only("イルカの事を兵器や道具と同じように扱っていた\n「管理人」だ。")
	await novel_interface.show_text_only("彼は部隊を率いてスカイホテルにいた俺達を襲い\n異質物武器まで使ってきた。")
	await novel_interface.show_text_only("奴らの武器が放つ電撃は、アニーを重傷にまで\n追い込んで……\nあの時はラファエルがいてくれたおかげで\n助かったけど……")
	await novel_interface.show_text_only("事件後、奴に関するデータを集めようとしたが\nマリルですら見つけられず……\nおそらく第三学園都市の情報機関マノーラに\n所属しているだろうとしか推測できていない。")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("待って、江森重工……江森変電所の視察って事？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("最初にヤコブと出会ったのが江森変電所だった。\n\nマリルの助けがなかったら、俺とアニーは\n無事で済まなかったはずだ。")
	await novel_interface.show_dialog("整備士本人に少し話を聞いてみたのだけど、\n本社と取引している会社の代表って事しか、\n彼も知らなかったみたいだわ。", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("……どんな取引を彼らはヤコブとしてたの？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("平和フォーラムを開催するに際して連合議会が\n監視システムの全面強化を急遽決定した事で、\n取引が始まったみたいよ。", "ベアトリーチェ")
	await novel_interface.show_dialog("カメラの用意はできたけど、市の照明は独立して\n電力供給をしているから、\nそれを拡張する時間的余裕なんて、彼らには\n無かったらしいの。", "ベアトリーチェ")
	await novel_interface.show_dialog("だから取引先が用意した電池を使って、\n一時的に電力を賄うしか他なかったようね。", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("電池？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("大きさが親指くらいの透明容器よ。\n\n両端が電極になっていて、中には蛍光緑の\nドロドロした液体が入っているわ。\nあんな小さな物でも、監視設備を20日間維持\nできる電力が備わってるみたいね。", "ベアトリーチェ")
	await novel_interface.show_dialog("サンプルを本部に送って、すでに検査して\nもらっているわ。", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("イルカが交換ですって、俺に食べ物として\nくれた物と同じやつかもしれない……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("チョコをあげたお礼にもらったんだけど、\nとりあえず食べ物には見えなかった。")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("そのヤコブって方は確か……\n\nベアトリーチェさんにボコボコにお仕置き\nされた方ですわよね？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("待てなくなった様子のソヤは、会話に割って入り\n質問を投げかけた。")
	await novel_interface.show_dialog("レンちゃん……", "ベアトリーチェ")
	await novel_interface.show_dialog("あなた達2人が「親しそう」で何よりだけど、\nちょっと情報を漏らし過ぎじゃないかしら？", "ベアトリーチェ")
	await novel_interface.show_text_only("「親しそう」って強調するな！！")
	await novel_interface.show_dialog("マリルにお仕置きされちゃうわよ……？", "ベアトリーチェ")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("俺は別に──", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("──ふごぅ──ッ！？", "レン")
	await novel_interface.show_text_only("ソヤは片方の手で携帯を高く持ち上げて、\nもう片方の手で俺の顔を抑えた。")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("えっへんっ！\nレンさんが全部教えてくれましたわよ～～っ！！", "ソヤ")
	await novel_interface.show_dialog("あなたがダンテの詩に登場する人物という事も、\n全てレンさんからお聞きしましたわ～～！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("電話の先の騒ぎ声を聞いて、ベアトリーチェは\nくすりと笑った。")
	novel_interface.change_background("res://assets/images/bg/Soya/University_Hospital.png")
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("そこまで知っているなら、マリルから許可を\nもらったのね。", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("でっ？ でっ？ どうなんですのっ？", "ソヤ")
	await novel_interface.show_text_only("ソヤは尻尾を振りながら彼女の返事を待つ。")
	novel_interface.show_character("beatrice_regular","smile3")
	await novel_interface.show_dialog("そう……私はあなたが想像している通りの\nベアトリーチェよ。\n私の父はフォルコ・ポルティナーリ。", "ベアトリーチェ")#文字错误
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("でも実際、私はダンテと一度しか会った事が\nないの。\n5月祭の家族パーティーだったのだけれど、\n当時の私は今のイルカよりも幼かったわ。", "ベアトリーチェ")
	novel_interface.change_expression("grieved")
	await novel_interface.show_dialog("後から知ったのだけど彼が《神曲》を\n執筆したのは、\n私が毒のお酒を飲んで10年以上の歳月が\n流れてから……", "ベアトリーチェ")
	await novel_interface.show_dialog("愛って……片思いが多いわね……", "ベアトリーチェ")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("でもね、彼の詩は好きだわ。", "ベアトリーチェ")
	await novel_interface.show_dialog("作品を使って教皇を侮蔑するなんて、\nとても勇気のある行動よ。\nそして天国の扉の待ち人として私を選び、\n至高天まで彼を導くと描いてくれたわ。", "ベアトリーチェ")
	novel_interface.change_expression("smile1")
	await novel_interface.show_dialog("それは彼の理想であり、ひとつの復讐だったの\nかもしれないけど……", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……復讐？", "レン")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("ふふ、秘密よ。", "ベアトリーチェ")
	await novel_interface.hide_character()
