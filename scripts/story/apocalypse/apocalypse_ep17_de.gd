# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Sie lacht, beugt sich lässig zu mir und lässt schließlich ihren Kopf auf meine Schulter fallen.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Danke, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Wir könnten Aya bitten, dich zu untersuchen ...\nSie ist wirklich talentiert, wissen Sie? Sie wird bestimmt einen Weg finden –", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya legt plötzlich ihren linken Zeigefinger auf meine Lippen und schüttelt den Kopf. Ich beruhige mich augenblicklich und sie lehnt sich wieder auf meine Schulter.")
	await novel_interface.show_text_only("Wir sitzen dort zusammen und beobachten einfach das bunte Treiben dort unten. Die Proteste sollen laut sein, aber wir können dort oben nichts hören. Es ist friedlich, beruhigend.")
	await novel_interface.show_text_only("Wie soll ich dieses Mädchen beschreiben...")
	await novel_interface.show_text_only("Ein Pionier? Vorhut? Abenteurer?")
	await novel_interface.show_text_only("Das sind alles Begriffe, die mir eingefallen sind. Aber sie scheinen nicht ganz richtig zu sein.")
	await novel_interface.show_text_only("Sei es Sonya oder unsere Vorfahren ... sie müssen unüberwindliche Angst verspürt haben, als sie ihre vertrauten Häuser verließen und sich ins Unbekannte wagten.")
	await novel_interface.show_text_only("Sie müssen verängstigt gewesen sein, gleichzeitig aber auch aufgeregt und eifrig ...")
	await novel_interface.show_text_only("Die Umgebung genau beobachten, den besten Weg wählen, das Brombeergestrüpp beseitigen, das im Weg stand ...")
	await novel_interface.show_text_only("Sie waren definitiv zu beschäftigt, um über die Bedeutung ihres Handelns für die Menschheit und die Geschichte nachzudenken.")
	await novel_interface.show_text_only("Diese Leute da unten, die in der Menge posieren und Selfies machen – das sind diejenigen, die verzweifelt versuchen, ihre eigene Bedeutung zu beweisen, nicht wahr?")
	await novel_interface.show_text_only("Sie alle wollen anders aussehen. Doch ohne es zu merken, kamen sie alle zusammen und bildeten dieses riesige Monster ...")
	await novel_interface.show_text_only("Auf unserem Weg hierher hörten wir im Radio, wie ein Reporter die Anwesenden der Kundgebung interviewte.")
	await novel_interface.show_text_only("Der Reporter wählte dreiundzwanzig zufällige Fußgänger aus. Von allen war nur einer in der Lage, den geschätzten Standort von Masada Ford auf der Weltkarte anzuzeigen.")
	await novel_interface.show_text_only("Die Hälfte von ihnen wusste nicht einmal genau, wogegen sie protestierten.")
	await novel_interface.show_text_only("... Ist die Bedeutung ihrer Existenz also wirklich so wichtig?")
	await novel_interface.show_text_only("Mein vibrierendes Telefon holt mich in die Realität zurück. Während ich es abhebe, schalte ich das Telefon auf Sendung, damit Sonya es auch hören kann.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ooh, ihr zwei... benimmt euch daneben, oder?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Aya?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was macht ihr auf der First Avenue?\nUnd so hoch? Beobachten Sie die Leute oder so etwas?", "Ai")
	await novel_interface.show_text_only("Aya klingt überraschend besorgt. Da bemerke ich eine Drohne, die schräg über uns schwebt und uns gegenübersteht.")
	await novel_interface.show_dialog("Ich weiß nicht, wohin Mariru gegangen ist. Wie auch immer, ich bin hier, um Ihnen die Ergebnisse zu erzählen, die wir nach der Analyse der von Beatrice geschickten Batterie erhalten haben ...", "Ai")
	await novel_interface.show_dialog("Ich komme gleich zur Sache.", "Ai")
	await novel_interface.show_dialog("Es ist bestätigt, dass die Batterie etwas mit der Substanz H zu tun hat. Und sie wurde von einem Militärhersteller aus Masada Ford hergestellt.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Also... eine Substanz-H-Waffe?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bei der Herstellung dieser leuchtenden, klebrigen Flüssigkeit war eindeutig Substanz H im Spiel. Über die Inhaltsstoffe können wir uns noch nicht sicher sein.", "Ai")
	await novel_interface.show_dialog("Im Grunde können wir das Ding als eine Art Brennstoffzelle betrachten. Die im Batteriegehäuse eingeschlossene Flüssigkeit wird verbraucht, wenn die Batterie Strom abgibt.", "Ai")
	await novel_interface.show_dialog("Aus irgendeinem Grund – vielleicht um die Lieferfrist einzuhalten oder so – haben sie das Produkt wieder eingebaut, ohne auch nur die Werksseriennummer von MMI abzuschleifen.", "Ai")
	await novel_interface.show_dialog("Sogar der Spannungsregler ist außen am Batteriekasten angebracht.", "Ai")
	await novel_interface.show_text_only("Aya klingt verwirrt.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Batteriekasten...? Spannungsregler?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, Sie wissen nicht, wie es aussieht, oder? Lass es mich beschreiben...", "Ai")
	await novel_interface.show_dialog("Ein Metallzylinder, fast sieben Zentimeter hoch. Vollständig mit einer Isolierschicht bedeckt, außer auf den Elektroden auf beiden Seiten. Es ist wie eine AA-Batterie, aber größer.", "Ai")
	await novel_interface.show_dialog("Auf seiner Seite befindet sich eine mechanisch strukturierte Platine. Schieben Sie es auf und Sie werden zwei Metallkontakte sehen.", "Ai")
	await novel_interface.show_dialog("Wenn wir eine extrem niedrige Spannung an die Kontakte anlegen, können wir die Menge der freigesetzten Elektrizität kontrollieren.", "Ai")
	await novel_interface.show_dialog("An der Außenseite des Batteriekastens befindet sich ein 40-Mikrovolt-Regler. Es befindet sich in der perfekten Position, um die Platine zu halten und die an die Kontakte angelegte Spannung zu begrenzen.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Warum klingt es wie eine Batterie, die von einer Batterie angetrieben wird ...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wird es als Notstromquelle für eine Taschenlampe mit leuchtender Energie oder ähnliches verwendet?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Das liegt daran, dass diese Batterien nicht als Batterien konzipiert wurden ...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sieht düster aus.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Es ist wie... die mechanische Sicherheit von Waffen... und einer Zündvorrichtung.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ich versuche die Energie zu berechnen, die in einer solchen Batterie enthalten ist.", "Ai")
	await novel_interface.show_dialog("Nach Angaben des Elektrizitätsunternehmens kann eine solche Batterie ein 6-W-Mikroüberwachungsgerät etwa zwanzig Tage lang am Laufen halten.", "Ai")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Klingt nicht nach einer großen Sache...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wie berechnet man die Leistung? Haben wir das im Unterricht gelernt? Ich habe es vergessen...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya seufzt über meine Hoffnungslosigkeit, wenn es um Physik geht.")
	await novel_interface.show_dialog("Ein 2,88-kW-Akku könnte Ihr Mobiltelefon ein halbes Jahr lang am Laufen halten.", "Ai")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wow! So lange?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Heutzutage habe ich mich daran gewöhnt, Elluka zum Aufladen meines Telefons und meiner Spielekonsole zu verwenden. Annie schimpft oft mit mir.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Moment... was passiert, wenn kein Spannungsregler vorhanden ist?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Deshalb habe ich dich eigentlich angerufen.", "Ai")
	await novel_interface.show_dialog("Ich habe herausgefunden, dass im Eingangsbereich von 1 bis 500 Mikrovolt die von der Batterie erzeugte Leistung mit der Eingangsspannung zunimmt. Aber wenn es über 500 geht, passiert nichts. Überhaupt keine Ausgabe.", "Ai")
	await novel_interface.show_dialog("Also habe ich die Spannung auf 32 V erhöht, und plötzlich schoss dieses blendend weiße Licht aus der Batterie ...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Den Aufnahmen unserer Hochgeschwindigkeitskamera zufolge war die Flüssigkeit im Akku in weniger als einer Millisekunde verbraucht.", "Ai")
	await novel_interface.show_dialog("Die Energieexplosion verbrannte beinahe die Decke des Isolierraums. Überall an der Wand und am Boden sind kreuz und quer Brandspuren zu sehen.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Was?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich erinnere mich plötzlich daran, dass einer seiner Lakaien, als Igor uns im Sky Hotel angriff, eine elektrische Waffe benutzte ...")
	await novel_interface.show_text_only("Nach einem starken Lichtstrahl waren überall im Raum kreuz und quer verlaufende Brandflecken zu sehen.")
	await novel_interface.show_dialog("Dennoch schien die Waffe, die Annie damals traf, nicht so mächtig zu sein. Und es war so programmiert, dass es nur eine Person ins Visier nahm, sonst wären alle im Raum tot.", "Ai")
	await novel_interface.show_dialog("Und 32 V ist tatsächlich die minimale Erregerspannung für elektronische Impulszünder, die von der nationalen Verteidigungsarmee von Masada Ford verwendet werden.", "Ai")
	await novel_interface.show_text_only("Aya macht eine Pause.")
	await novel_interface.show_dialog("Die von einer 2,88-kW-Batterie erzeugte Energie entspricht der von 5,5 Pfund TNT...", "Ai")
	await novel_interface.show_dialog("Obwohl Batterien keine so zerstörerischen Stoßwellen wie TNT erzeugen können, können sie dennoch für alle Lebewesen in einem Umkreis von 33 Fuß tödlich sein.", "Ai")
	await novel_interface.show_dialog("Und im Moment haben wir eines dieser Dinger an jedem einzelnen Laternenpfahl in der vereinbarten entmilitarisierten Zone ...", "Ai")
	await novel_interface.show_text_only("Ich schnappe nach Luft und starre auf die gigantischen Horden dort unten.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Verdammt... Igor... wie konnte er...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("Warte!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya wirft ein.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Wenn das so ist, würde Masada Ford doch sicher nicht wollen, dass diese Batterien explodieren, oder?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Das stimmt.", "Ai")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Die Batterien wurden in Eile hergestellt, die Seriennummern sind noch sichtbar. Und als eine Art Schnelllösung wurde ein einfacher Spannungsregler hinzugefügt ...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Es hört sich so an, als ob sie verzweifelt versuchten, die große Zahl an Befehlen des Vereinigten Kongresses zu erfüllen.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Sollten die Batterien explodieren, könnten die Behörden anhand der Seriennummern erkennen, wer sie hergestellt hat. Das wäre ein dummer Schachzug von Masada.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Außerdem handelt es sich um ein groß angelegtes Stadterneuerungsprojekt. Unzählige Menschen wären an der Logistik, Implementierung und Wartung beteiligt. Es wäre unmöglich, ein so tödliches Geheimnis geheim zu halten.", "Ai")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Das stimmt...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Was wirklich verdächtig ist, sind die Patienten, die Beatrice erwähnt hat.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru hatte das Seuchenkontrollzentrum bereits alarmiert, um eine Kontaminationswarnung der Klasse 4 auszuhängen. Derzeit sind alle zwanzig Fälle in der vereinbarten entmilitarisierten Zone gesammelt.", "Ai")
	await novel_interface.show_dialog("Diese Batterien haben jedoch keinen Einfluss auf den Geisteszustand der Menschen. Und die Ergebnisse der Meme-Erkennung zeigen, dass sie auch keine Meme-artigen Infektionsquellen enthalten …", "Ai")
	await novel_interface.show_text_only("Ich schaue sprachlos nach unten. So viele Fragen, aber keine Antworten.")
	await novel_interface.show_text_only("Ich schaue auf die Menschenmenge dort unten. Alle zwölf Meter steht eine Straßenlaterne ...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Warte. Was fanden Sonya und ich seltsam, als wir dort unten waren?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Dass die „Grenzen“ der sich versammelnden Massen viel zu definiert sind ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hmm?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was meinst du...?", "Ai")
	await novel_interface.show_text_only("Vielleicht lag die Antwort schon immer direkt vor uns. Wir haben es einfach nicht gesehen, weil es zu viele Ablenkungen auf der Straße gab ...")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Hat Mariru nicht gesagt, dass ALLE Beleuchtungs- und Überwachungssysteme an den Straßenlaternen in der Stadt vom Vereinigten Kongress ersetzt wurden?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ja.", "Ai")
	await novel_interface.show_dialog("Warum gibt es dann die Straßenlaternen in zwei Farben?", "Lian")
	await novel_interface.show_text_only("Auf der First Avenue leuchten die Straßenlaternen in einem warmen Gelb und erhellen die klaren Grenzen der Menschenmenge.")
	await novel_interface.show_text_only("In den menschenleeren Gassen leuchten derweil die Straßenlaternen weiß.")
	await novel_interface.show_text_only("Am anderen Ende des Hörers ertönt das Geräusch wütenden Tippens.")
	await novel_interface.show_dialog("Ich habe es gerade überprüft. Die neuen Glühbirnen, die sie hinzugefügt haben, sollten nachhaltige LED-Leuchten mit einer Farbtemperatur von 4500 K sein, sodass sie weiß aussehen sollten. Ich bin mir nicht sicher, was mit den Gelben los ist ...", "Ai")
	await novel_interface.show_text_only("Sonya und ich tauschen Blicke aus und versuchen uns an all die Lichter zu erinnern, die wir in den letzten Stunden gesehen haben.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Das Filmmaterial der Verteidigungslinie vor dem United Congress, das wir gerade gesehen haben, war gelblich. Der Bereich wird wahrscheinlich von einer großen Anzahl gelber Lampen beleuchtet.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Die Straßenlaternen in der Electronics Street waren meiner Meinung nach auch von der gelben Sorte …", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Die Straße war chaotisch, voller greller Neonreklamen und beleuchteter Werbetafeln. Niemand würde die gelben Lampen bemerken.")
	await novel_interface.show_dialog("Die Atmosphäre in der Electronics Street war heute tatsächlich etwas aus dem Ruder gelaufen... alle schienen ungewöhnlich aufgeregt zu sein.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Andererseits schienen die Straßen mit weißer Beleuchtung größtenteils menschenleer zu sein.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("Die Straße vor der Polizeistation, aus der wir geflohen sind ...", "Soya")
	await novel_interface.show_dialog("Auch...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("Diese ruhige Straße außerhalb des Newell Central Park ...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Könnte es sein...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Dieses goldene Licht...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Hmm?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hinter der Tür...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("War es...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya macht sich nicht die Mühe, ihren Satz zu beenden. Sie ergreift meine Hand und rennt zum Aufzug.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
