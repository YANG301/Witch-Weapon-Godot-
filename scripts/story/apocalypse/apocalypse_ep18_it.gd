	await novel_interface.show_dialog("Forse c'è un messaggio nascosto su questo paralume? Non posso dirlo, però...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche Sonya solleva il paralume contro la luce esterna e scuote la testa con aria sconfitta.")
