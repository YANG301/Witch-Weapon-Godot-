	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya si lamenta con chiunque sia dall'altra parte della conversazione.")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("Volevo assolutamente lasciare vivi quei ragazzi! Li ho semplicemente colpiti con la mia lama... volevo dare loro la possibilità di apprezzare le mie mosse fantastiche...", "Teresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("E poi sono semplicemente esplosi!", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sospira, pulendo la lama con il tessuto che ha tagliato, poi getta lo straccio sporco sulla faccia del cadavere, sempre che possa ancora essere chiamato faccia.")
