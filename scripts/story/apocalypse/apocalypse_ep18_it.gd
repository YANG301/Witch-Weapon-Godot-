	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Avevo dimenticato che dovevo lasciarli vivi...", "Teresa")
	await novel_interface.show_dialog("Andiamo, non è colpa mia! I loro cervelli sono esplosi tutti all'improvviso. Sono stato colto di sorpresa, quindi li ho uccisi tutti.", "Teresa")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("Inoltre, anche se li riportassi indietro vivi, non potremmo scoprire niente di interessante da questi tizi, giusto?", "Teresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Brucia tutte le impronte digitali... impianti di dinamite nei denti... non appena sono in punto di morte, il meccanismo si attiva e l'intero viso viene fatto saltare...", "Teresa")
