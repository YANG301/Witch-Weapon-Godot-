# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Usciamo dall'edificio e troviamo la nostra macchina parcheggiata all'ingresso. L'autista grassoccio ci porge due microauricolari a conduzione ossea.")
	await novel_interface.show_dialog("Il capo mi ha detto di darteli.", "Autista")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Il b-boss?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Io e Sonya indossiamo gli auricolari e sentiamo Aya parlare dall'altra parte.")
	await novel_interface.show_dialog("È troppo rumoroso tra la folla. Potresti avere difficoltà a sentirmi se parliamo al telefono.", "Ai")
	await novel_interface.show_dialog("Ho appena controllato. Dell'intera zona demilitarizzata concordata, solo le sette aree in cui sono avvenuti gli scontri hanno lampioni gialli.", "Ai")
	await novel_interface.show_dialog("Queste sono tutte aree trafficate con molti cartelloni pubblicitari e altre fonti di luce, quindi anche chi controlla le riprese aeree non noterebbe la differenza.", "Ai")
	await novel_interface.show_dialog("Abbiamo inviato la nostra squadra di recupero, ma credo di non riuscire a convincerti a restare indietro. Tieni Ren al sicuro.", "Ai")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Restare indietro? Eh? Stare lontano da cosa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya si limita ad annuire al drone che ci segue e mi trascina tra la folla.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("Arriviamo sotto un lampione giallo che per fortuna non è circondato da troppa gente. Il palo della lampada si eleva per quasi venticinque piedi.")
	await novel_interface.show_text_only("Ai tempi dei corsi di formazione al SID ero un totale fallimento negli esercizi di arrampicata.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Ho preso una F per tutti.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Di solito dovevo affrontare il palo con un salto volante per guadagnare un po' di altezza, ma finivo comunque per scivolare giù.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Eheh...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tira fuori dalla borsa una scatola di metallo cadente. È sorprendentemente grande, con i lati delle dimensioni di un normale foglio di carta per appunti e uno spessore di circa tre pollici.")
	await novel_interface.show_text_only("Una linea argentata lucida corre lungo la superficie della scatola, evidenziando un componente girevole. E sul lato c'è una striscia metallizzata rosa.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Indovina cosa ho qui!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("esclama Sonya con orgoglio, sollevandomi la scatola perché la vedessi.")
	await novel_interface.show_text_only("Hmm. A giudicare dalle dimensioni, dalla lavorazione artigianale, dal grande componente girevole a forma di ventaglio e da quella striscia metallica scintillante...")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Uh, una specie di scheda grafica inutilmente enorme?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tira semplicemente la maniglia e il lato a strisce rosa della scatola si apre come una fisarmonica.")
	await novel_interface.show_text_only("E dall'interno spuntano fuori una serie di componenti meccanici neri, insieme ad una lunga “tavola”. Mettili tutti insieme e si estende per quasi quaranta pollici.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Che diavolo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("È un'arma esclusiva di Judgment Knights. Alimentato dalla sostanza H!", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Il Penitenziere me lo ha realizzato secondo i miei desideri.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya gira la maniglia e lungo il bordo della lunga tavola appare una fila di scintillanti denti di sega.")
	await novel_interface.show_text_only("La fila di denti arriva fino all'arco all'estremità della tavola e infine rientra nella scatola.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Una motosega?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Qualcosa del genere. Non è alimentato dall'elettricità, però. È la mia arma preferita!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya sorride e accende la \"motosega\". I denti iniziano a ruotare a una velocità sorprendente, ma è sorprendentemente silenzioso.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("Hai intenzione di...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Senza esitazione, Sonya inizia a tagliare il palo della luce in metallo. Volano scintille ovunque e il palo d'argento stride in segno di protesta.")#多字问题
	await novel_interface.show_text_only("Il rumore attira un intero pubblico. Alcuni uomini di mezza età, pur non avendo la minima idea di cosa stia succedendo, cominciano a gridare ed esultare.")
	await novel_interface.show_text_only("Ben presto si sentono due esplosioni dall'interno del palo e Sonya recupera con calma la sua motosega.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alza lo sguardo verso il lampione, che non brilla più. La colonna, di circa otto pollici di diametro, è quasi tranciata.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Legname!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Questo è più simile!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sorride, dando un colpo al palo nella direzione opposta alla folla.")
	await novel_interface.show_text_only("E finalmente il palo cede, ribaltandosi con un grido assordante.")
	await novel_interface.show_text_only("Bum! Il lampione sbatte contro il terreno, spaccando il catrame in superficie e facendo volare macerie.")
	await novel_interface.show_text_only("La folla circostante rimane interdetta per qualche secondo, poi scoppia un applauso sfrenato.")
	await novel_interface.show_dialog("Alla libertà!\nAlla pace!", "Folla")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("Cosa c’entra questo con la libertà e il ritmo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corriamo verso quella che una volta era la parte superiore del lampione. Sonya interrompe rapidamente la parte con la luce, mentre il drone che ci segue atterra accanto allo spettacolo.")
	await novel_interface.show_dialog("Non riesco a vedere molto da qui. Sbarazzati del paralume e avvicina la lampadina al drone. Voglio vedere il modello LED.", "Ai")
	await novel_interface.show_text_only("Per evitare la folla eccitata, prendo la lampadina e mi precipito in direzione del nostro SUV.")#换行问题
	await novel_interface.show_text_only("Non appena arriviamo, Sonya analizza il tutto secondo le istruzioni di Aya. Troviamo una microcamera, le batterie, il filamento e l'alimentatore elettrico.")
	await novel_interface.show_dialog("I numeri di serie di questi componenti e del LED sembrano tutti corretti e corretti.", "Ai")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Ehi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alzo il paralume contro la fonte di luce proveniente da qualche parte all'esterno del veicolo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Se il paralume è giallo, non è possibile che la lampada produca luce bianca, giusto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La trama gialla che ricopre il paralume sembra intricata, con rilievi dettagliati. Deve aver richiesto molto lavoro.")
