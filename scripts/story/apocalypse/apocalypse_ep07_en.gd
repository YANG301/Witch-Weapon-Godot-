# apocalypse_ep07.gd - 天启篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第07话剧本
	apocalypse_ep07_script()

func play_script():
	pass

# 天启篇第07话 - 正式剧本
func apocalypse_ep07_script():
	# scene1 - 继续美术馆对话
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("The speaker of Masada Ford committed suicide? But that’s impossible!", "Raphael")
	await novel_interface.show_dialog("He looked so smug on the press conference... instead of eating a bullet, celebrating with champagne is much more likely. Couldn’t someone else have shot him?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Well, Menorah’s special services team sounds like a capable bunch...", "Theresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("But not capable enough to sneak into the suite, shoot the target and make it look like suicide.", "Theresa")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Or maybe he was being blackmailed?", "Raphael")
	await novel_interface.show_dialog("Or, perhaps, he was simply a chess piece the people up there no longer needed...", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("cereza","smile")
	await novel_interface.show_dialog("All right, all right, let’s leave the guesswork for later. Come along now.", "Theresa")
	await novel_interface.show_dialog("First Avenue—that’s where the United Congress’s headquarters is—is already flooded by protesters. The situation will soon be out of control.", "Theresa")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Besides, didn’t you already promise your grandfather?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa pats Raphilia on her back and whispers something into her ear.")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("(Theresa doesn’t look European...)\n(And she’s carrying a katana in a shopping district, just like that? It’s almost as if she’s flaunting it...)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(It’s true that weapons of this type aren’t forbidden in this area though...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("After they finish their little whisper-session, Raphilia nods at Theresa and gestures at everyone to head downstairs together.")
	
	# scene2 - 夜晚电器街
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("We leave the art gallery and arrive on the streets.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("The sun’s barely set. The street lamps are already on, lighting up the bustling Electronics Street with their warm, yellow glow.")#不确定
	novel_interface.show_character("iluka_uniform","speechless")
	await novel_interface.show_dialog("Whoa...", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("That’s a lot of people...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Is some kind of event going on around here?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("I just checked online. Seems that a lot of stores had to close temporarily during the recent traffic restriction...", "Entourage")
	await novel_interface.show_dialog("But the restriction was lifted yesterday night, and the grand reopening event scheduled for next Monday has been moved to today too.", "Entourage")
	await novel_interface.show_dialog("Participants of the event will receive free limited merchandise from some anime.", "Entourage")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("C-could it be...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I notice that a lot of pedestrians are holding a small yellow flag that says “Restricted Access” on it. It’s an item often seen in one of the hottest animes these days.")
	await novel_interface.show_text_only("That anime consisted of adorable girls in kindergartener uniforms, working hard with little flags in their hands. A lot of viewers had fallen for the sheer cuteness—including me.")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("(Oh, it’s from that show!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I can’t help getting a bit excited.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hmm?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Uh, nothing, nothing...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I quickly conceal my excitement. I’m pretty much a pro at it now.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("I gotta go. You guys had better leave too.", "Raphael")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Feels like something crazy’s gonna happen tonight.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia stuffs a green gem the size of a marble into my hand.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Henriette made this. It could come in useful if someone gets hurt.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia resolutely avoids my eyes, looking super embarrassed.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Oh... Henriette, huh...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s been a while since I last heard of that alchemist who insisted on calling me “Master”.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(I wonder what she’d think if she knew that now I’m the one who has to call others Master in a maid outfit...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Anyway, take care.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before I can even reply, Raphilia disappears along with Theresa and her entourage.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("I watch them disappear into the crowds on Electronics Street.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hm, she’s still hugging that book she just whacked me on the head with...", "Soya")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No wonder she’s in such a hurry to leave!")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Hey, what if we check out that event too before we head back—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I’d love to get my own little yellow flag too. But before I can finish my sentence, Sonya slams me onto a wall.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("You were enjoying it, huh? You think shocking me with the anklet is totally fun, huh?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Oh, no...\nS-sorry!", "Lian")
	#await novel_interface.show_dialog("", "小怜")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I realize that I may have let down my guard too soon.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("I’ve been wondering since this afternoon...", "Soya")
	await novel_interface.show_dialog("Theresa, Raphilia and Elluka...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(The three of them? What do they have in common?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Their auras smell witch-like, but have human-like colors.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("That’s not what I expected.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya pokes her index and middle fingers over my heart, hard. Her eyes are steely, cold, determined. One thing is clear:")
	await novel_interface.show_text_only("If I lie, I die.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("You mean... Theresa is one of those people too?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("One of those people?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I keep my eyes on Sonya’s face as I attempt to find the right words.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Like, girls who received the “information” of magic, but are still sane.", "Lian")
	await novel_interface.show_dialog("Some of those are unable to bear the burden of knowledge, and lose their sanity, thus becoming the kind of witches you want to kill.", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("There’s a difference between the two.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya keeps her eyes trained on mine as she speaks:")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("So, those who lose their sanity... can they recover?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Theoretically no. At least that’s what Aya said...", "Lian")
	await novel_interface.hide_character()
	
	# scene3 - 回忆场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<A few weeks ago>")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Harima Tech’s finished scanning our witch specimens. They’ve found something interesting...", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Specimens? You mean those the military captured from the northern hills “for a huge price”?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Luckily I’m only in charge of anomalies under Aegis coverage...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Well, making binds to keep them in place did take some time...\nAnyway, I won’t bore you with the details. I’ll go straight to the results we found.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("First, the body of a witch is controlled by the brain. However, it does not take in account its own physical limits.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Hypnosis.png")
	await novel_interface.show_dialog("Usually, a human would set a sort of subconscious limit on their own bodies for self-protection purposes. This limit can be temporarily canceled via hypnotism and similar methods.", "Ai")
	await novel_interface.show_dialog("For example, a hypnotized person can lie still like a stiff plank with only their head and feet supported by a rack, while there’s nothing supporting them in the middle.", "Ai")
	await novel_interface.show_dialog("And they won’t even flinch when over twenty pounds of weight is placed on their stomach. A fully conscious human would not be able to do that.", "Ai")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("A witch’s brain treats the body as a consumable. That’s why they can move in abnormally powerful bursts, but this may of course damage their bodies.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(So that’s why they can twist their joints in creepy ways, huh...)", "Lian")#换行问题
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Second, a witch’s brain keeps receiving information from an unknown source, even in an environment that is blocked by electromagnetic waves. The speed in which they receive the info keeps rising with every second.", "Ai")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("It’s like they’re a hard disc, in which data is entered and then deleted again and again. Theoretically, the max bandwidth is determined by the speed in which info is entered into and then deleted from their brain cells.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("But this places a huge load on the cells, which die as a result. The remaining cells will have to take an even bigger load, so they’ll die even faster.", "Ai")
	await novel_interface.show_dialog("What’s remaining of their consciousness would simply dissipate like a drop in the ocean.", "Ai")#换行问题
	await novel_interface.show_dialog("All in all, witches do have limits—the human body can only take so much, after all. Their magical powers are restricted by their physical body and their brain.", "Ai")
	await novel_interface.show_dialog("We can say a witch’s body and brain are both simply batteries that are meant to be drained.", "Ai")
	await novel_interface.show_dialog("And the performance limit of these batteries are determined by the highest level of discharge they can endure while in a short-circuited state.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I know Aya had read through the full profiles of those “witches”, back when they were still alive. She must have tried various ways to bring them back to consciousness as well.")
	await novel_interface.show_text_only("She described them as if they were objects without personalities, but it was probably her way to tell me it’s okay to give it my all when fighting them and I don’t need to feel guilty about it.")
	await novel_interface.show_text_only("Human reason is like a dam—as sturdy as it looks, the moment it breaks, there can be only one outcome.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("And Sonya’s job is to minimize the damage the second the dam breaks.")
	await novel_interface.show_text_only("It mustn’t have been easy for her.")
	
	# scene4 - 回到现在
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Sonya slowly releases me from her hold, relieved, after hearing my reply.")
	await novel_interface.show_dialog("... Is that so?", "Soya")
	await novel_interface.show_text_only("Her voice is small, trembling.")
	await novel_interface.show_dialog("You know what...? When Theresa guided you to “fire an invisible arrow” with your arm...", "Soya")
	await novel_interface.show_dialog("I thought you’d kill me for sure...", "Soya")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("When she touched your body and you began “charging up”, I could feel the auras of both of you increasing in power, at least ten... no, hundreds of times the original.", "Soya")
	await novel_interface.show_dialog("Anyone would have been devoured by power like that.", "Soya")
	await novel_interface.show_dialog("But I watched that crimson aura, so powerful it penetrated the whole building, shoot right through me. And yet, I wasn’t hurt at all...", "Soya")
	await novel_interface.show_text_only("When Sonya lifts her head to face me, I see that she’s blushing pink.")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("—I’ve never seen something as beautiful as that aura in my life!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("(... What kind of reaction is that?)", "Lian")
	await novel_interface.hide_character()

	print("=== 天启篇第07话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
