# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("E mentre il bagliore arde più rossastro sull’onda,\nQuesto attende la squadra in ascesa, ovvero Phaëton\nSapevo guidare, e da ogni parte la luce")
	await novel_interface.show_text_only("Sfumature diminuite, più intense nel mezzo;\nCosì ardeva la pacifica fiamma dell'orifizio, e si allentava\nDa ogni parte la fiamma viva si spegneva.")
	await novel_interface.show_text_only("E in mezzo sventolavano i loro allegri stendardi\nMigliaia di angeli; in splendore ciascuno")
	await novel_interface.show_text_only("Ornamento distintivo e caratteristico...")
	await novel_interface.show_text_only("—Canto XXXI, Paradiso, La Divina Commedia")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru è in piedi, gioca con la foto tra le mani, mentre osserva attentamente l'uomo dai capelli grigi di fronte a lei.")
	await novel_interface.show_text_only("Non ci sono molte informazioni da trovare su quest'uomo. Nessuno sa nemmeno se Lumbert è il suo vero nome, tanto meno quale sia il suo cognome.")
	await novel_interface.show_text_only("Ma è pur sempre un dato di fatto che è stato nominato cavaliere con questo nome per il suo “eccezionale contributo alla pace nel mondo”.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko ha già confermato che è sicuro negoziare con lui.)", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Molte persone credono che la ragione per cui il Congresso Unito detiene il maggior potere sul nostro pianeta è che è il luogo in cui si riuniscono i leader nazionali di tutto il mondo.", "Mariru")
	await novel_interface.show_dialog("È vero, questo tipo di organizzazione esisteva una volta nella storia. Ma la struttura era fragile e i membri non riuscivano mai a smettere di discutere. Il presidente si è comportato più come un pacificatore-mendicante.", "Mariru")
	await novel_interface.show_dialog("Ma il Congresso Unito che abbiamo adesso non è affatto così. Molto più influente. E molto più ricco.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru rimette la foto in tasca, con espressione impassibile.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Dall’interesse nasce la fiducia. Dalla fiducia nasce il potere. E il potere, attraverso la disposizione e la distribuzione delle risorse, suscita ancora più interesse...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert alza un sopracciglio.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Questo è il modello base della società di Walker.", "Lumbert")
	await novel_interface.show_dialog("I politici sono scelti dai gruppi di interesse come agenti che godono della fiducia del pubblico.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Se questi agenti non sono in grado di mantenere o creare interessi più grandi, i loro poteri verranno privati e qualcun altro prenderà il loro posto.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Questo è vero nella macrostoria, ma il pubblico non è mai stato ragionevole. Come disse una volta Le Bon...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Le masse non hanno mai avuto sete di verità. Chiunque possa fornire loro illusioni diventa facilmente il loro padrone; chiunque tenti di distruggere le loro illusioni è sempre la loro vittima.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("mormora Lumbert, finendo la citazione per lei. Mariru sorride e annuisce.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ci sono troppi modi per saltare la parte dell’interesse e guadagnare direttamente la fiducia del pubblico.", "Mariru")
	await novel_interface.show_dialog("I leader di questo tipo non hanno paura di fare enormi sacrifici purché alla fine abbiano successo.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tuttavia, dopo la Guerra dei Sette Anni, coloro che tengono al sicuro la vita delle masse e le nazioni in corsa iniziano a ripensare l’intera situazione.", "Mariru")
	await novel_interface.show_dialog("E così formarono il Congresso Unito. Un'organizzazione che collabora e contratta direttamente con i gruppi di interesse.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Quindi, in realtà è il contrario. Il Congresso Unito non è potente perché è composto da leader nazionali. In realtà, la verità è che solo i membri del Congresso sono qualificati per diventare leader nazionali.", "Mariru")
	await novel_interface.show_dialog("Questa organizzazione ha fatto il suo primo passo tre anni fa...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fa una pausa. Lumbert la fissa, trattenendo il respiro.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Tre anni fa, il Congresso Unito e la chiesa hanno lavorato insieme per testare un tipo di sostanza H di classe EX in Sud America. Hanno fatto pressione sui signori della guerra mafiosi perché lavorassero con loro.", "Mariru")
	await novel_interface.show_dialog("Tuttavia, l’esperimento è sfuggito di mano. Morirono oltre quarantaseimila abitanti del posto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Hanno corrotto tutti quelli che sapevano la verità per farli tacere e hanno bollato l'intera faccenda come il massacro del fiume Churun, attribuendo la colpa a Carlos Branco, l'unico signore della guerra che si è rifiutato di collaborare.", "Mariru")
	await novel_interface.show_dialog("La notizia dell'incidente è diventata virale. I media lo hanno adorato. Il pubblico la odiava e mostrava il proprio disgusto e il proprio odio per la guerra su larga scala.", "Mariru")
	await novel_interface.show_dialog("E il Congresso Unito divenne ampiamente apprezzato come l’organizzazione che lavorò in un’operazione militare congiunta per uccidere Branco. Nessuno si è nemmeno preso la briga di chiedersi se l’esistenza di questa organizzazione fosse legale.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ma non è troppo innaturale? Migliaia di corpi, disposti a schiera, con la chiesa al centro...", "Mariru")
	await novel_interface.show_dialog("Credo che il Congresso abbia sparato lì con un'arma di sostanza H, capace di disturbare le onde radio in un raggio di due miglia, per nascondere la verità.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Un’anomalia simile si è verificata anche sul campo di battaglia dell’Asia occidentale. Ecco perché le immagini catturate dai satelliti laggiù erano tutte distorte: dopotutto anche la luce è una specie di onda.", "Mariru")
	await novel_interface.show_dialog("Per questo motivo le perturbazioni delle onde radio nella zona sono continuate per settimane anche dopo la chiusura del “cancello”.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pone molta enfasi sulle parole “il cancello”. Lumbert chiude gli occhi, rassegnato.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru studia la foto che ha in mano.")
	await novel_interface.show_dialog("Per ripulire tutti quei corpi ci sono voluti molti lavoratori. Deve essere stato difficile garantire che nessuno di loro lasciasse trapelare qualcosa.", "Mariru")
	await novel_interface.show_dialog("Scommetto che non ti saresti mai aspettato che qualcuno scattasse questa foto della scena con una vecchia macchina fotografica meccanica e un rullino di pellicola marcia.", "Mariru")
	await novel_interface.show_dialog("Lo sfondo dell'immagine era sfocato. Ciò era dovuto alle proprietà di distorsione della luce dell'arma della Sostanza H utilizzata dalla tua gente.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Interessante. Ma perché sei così convinto che fossi coinvolta?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un mese prima dell'incidente, sei stato nominato Segretario Generale dell'Organizzazione del Trattato per la Proibizione degli Esperimenti sulle Armi sulla Sostanza H.", "Mariru")
	await novel_interface.show_dialog("In apparenza, lo scopo di questa organizzazione è quello di vietare gli esperimenti con armi con la Sostanza H. È una struttura potente con molte risorse a portata di mano ed eccellenti capacità di raccolta delle informazioni.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("È impossibile che tu non sia a conoscenza di un incidente di questa portata. Il motivo per cui hai scelto di non parlare è che, in effetti, sei stato tu a pianificare tutto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert non cerca di protestare e Mariru prende il suo silenzio come un segno che è sicuro andare avanti.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Alla fine, la chiesa inviò alcuni di loro a recuperare la sostanza H che causava tutti i guai. In seguito ricevettero un numero anormale di fondi e privilegi dal Consiglio Unito.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("La Sostanza H in questione è una porta nera semiaperta. Dietro c'è un'accecante luce dorata—", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Basta! Ho capito!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert lo interrompe, alzando entrambe le braccia in un atto di resa.")
	await novel_interface.show_text_only("Si tira il bavero del vestito e si schiarisce la gola.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("In effetti, la missione della nostra organizzazione è quella di garantire che il pubblico non abbia un facile accesso alle armi della sostanza H, per non parlare del loro utilizzo negli esperimenti.", "Lumbert")
	await novel_interface.show_dialog("La sostanza H è semplicemente troppo pericolosa. Se non si presta attenzione, potrebbe distruggere la nostra civiltà. Ma l'esperimento che abbiamo condotto... era inevitabile. Qualcuno doveva farlo, potevamo anche essere noi.", "Lumbert")
	await novel_interface.show_dialog("Qualcuno... qualcosa... stava bussando alla porta dall'interno. Sempre più urgente. Non avevamo scelta...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bussare...?", "Mariru")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Bussare alla porta del paradiso, sì.", "Lumbert")
	await novel_interface.show_dialog("Il paradiso esiste in tutte le religioni e sistemi mitologici, in forme diverse. Le definizioni possono differire in ogni sistema di credenze, ma forse sono nate tutte dalla stessa fonte.", "Lumbert")
	await novel_interface.show_dialog("Nei documenti storici si dice che, subito prima che la porta venga aperta, verrà bussato tre volte consecutive.", "Lumbert")
	await novel_interface.show_dialog("Colpi profondi ed echeggianti. Come se bussasse all’anima dell’ascoltatore…", "Lumbert")
	await novel_interface.show_dialog("Dopo che si sentiranno i colpi per la prima volta, ci sarà silenzio per una settimana, poi i colpi ricominceranno. Gli intervalli tra i colpi si accorciano gradualmente...", "Lumbert")
	await novel_interface.show_dialog("Quando non passano più di novanta secondi tra ogni serie di colpi, sapremo che la porta del paradiso è pronta ad aprirsi.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Puoi definire l '\"essere\" dietro la porta come preferisci, ma resta il fatto che possiede poteri che possono portare a un disastro di livello apocalittico.", "Lumbert")
	await novel_interface.show_dialog("Una massiccia alluvione, per esempio, eh...", "Mariru")
	await novel_interface.show_dialog("Secondo i manoscritti della chiesa, l'unico modo per tenere la porta chiusa è radunare circa diecimila persone attorno alla porta...", "Lumbert")
	await novel_interface.show_dialog("Una specie di sacrificio, eh?", "Mariru")
	await novel_interface.show_text_only("Lumbert ignora l'osservazione di Mariru e prosegue.")
	await novel_interface.show_dialog("Questo genere di cose accadeva ogni poche centinaia di anni. I cadaveri finivano sempre disposti in ordine radiale, con la porta come punto centrale.", "Lumbert")
	await novel_interface.show_dialog("Questo tipo di rituale veniva solitamente eseguito in segreto. Tuttavia, poiché passavano sempre centinaia di anni tra un rituale e l'altro, alcune persone di certe epoche li usavano a proprio vantaggio...", "Lumbert")
	await novel_interface.show_dialog("Ad esempio, il massacro del giorno di San Bartolomeo a Parigi, 1572.", "Lumbert")
	await novel_interface.show_dialog("Quell'anno, la notte prima del giorno di San Bartolomeo, ci fu un orribile massacro religioso, il peggiore degli ultimi secoli, con oltre settantamila morti.", "Lumbert")
	await novel_interface.show_dialog("Parigi, eh...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Aspetta, un sistema radiale con una porta come punto centrale?", "Mariru")
	await novel_interface.show_text_only("A Mariru viene subito in mente il modo in cui sono disposte le strade nella città romantica.")
	await novel_interface.show_dialog("Ironico, non è vero...", "Lumbert")
	await novel_interface.show_text_only("Lumbert ride, senza allegria.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Tuttavia, non è possibile bussare a una porta a meno che non abbia una forma concreta. Perché non lo distruggi o lo scarichi da qualche parte nello spazio?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("La porta del paradiso non è che un concetto. All'inizio la porta non appariva mai due volte nello stesso punto.", "Lumbert")
	await novel_interface.show_dialog("È comparso anche in posti dove non avrebbe dovuto esserci una porta. Ad esempio, sulla superficie delle antiche mura della città.", "Lumbert")
	await novel_interface.show_dialog("Portavano sempre con sé disastri, ma erano anche una sorta di reliquie divine, la prova dell'esistenza di un'esistenza oltre la nostra comprensione.", "Lumbert")
	await novel_interface.show_dialog("Le fazioni religiose della storia non hanno mai smesso di scontrarsi su questo concetto, volendo rivendicarlo come proprio.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Come si rivendica un concetto, esattamente?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("I documenti storici ci dicono che Santa Sofia è stata la \"proprietaria\" ufficiale della porta del paradiso per il periodo di tempo più lungo.", "Lumbert")
	await novel_interface.show_dialog("Poi, nel XV secolo, lo scultore Lorenzo Ghiberti di Firenze rivendicò la proprietà dell'idea attraverso un'opera d'arte su cui lavorò per tutta la vita.", "Lumbert")
	await novel_interface.show_dialog("Tale opera, dopo il completamento nel 1452, venne utilizzata come ingresso principale del Duomo di Firenze. Il mondo ha convenuto che da quel momento in poi sarà conosciuta come la porta del paradiso.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Capisco.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il metodo più antico utilizzato dagli esseri umani per rivendicare la proprietà di un concetto era quello di dimostrare il proprio valore attraverso la creazione di opere d'arte maestose e stravaganti.")
	await novel_interface.show_text_only("Piramidi, templi, palazzi, corone, troni...")
	await novel_interface.show_text_only("Tutti modi per dimostrare che il creatore è il vero, meritevole proprietario di un concetto.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aspetta... Costantinopoli, dove si trova la Basilica di Santa Sofia, non fu invasa e occupata l'anno successivo al completamento dell'opera di Ghiberti? È stato perché...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert scuote la testa.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Non lo sappiamo. Non è stata trovata alcuna prova diretta in quel periodo.", "Lumbert")
	await novel_interface.show_dialog("Ciò di cui POSSIAMO essere sicuri è che l'opera di Ghiberti fu distrutta durante la Guerra dei Sette Anni.", "Lumbert")
	await novel_interface.show_dialog("Pertanto, per determinare quando apparirà la \"porta\" e assicurarsi che si trovi in un'area sufficientemente remota da causare solo danni minimi la prossima volta che si apre...", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Abbiamo dovuto collaborare con la chiesa per creare una sorta di copia.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ma qualcosa è andato storto nell’esperimento. Non siamo riusciti a chiudere i cancelli come dovremmo. Questo è il motivo per cui la Chiesa ha dovuto fare così tanto...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questo spiega tutto. Per Mariru è come se finalmente mettessi insieme gli indizi e vedessi l'intero puzzle così com'è.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Quindi... hai poi insabbiato tutto con una bugia ingegnosa, l'aiuto dei media e il capro espiatorio perfetto...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert ridacchia cupamente alle parole di Mariru.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Grazie per il complimento, immagino.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("No. Non è un complimento. Se un giorno l’umanità non avrà altra scelta se non quella di affrontare un potere di portata così schiacciante...", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Considero stupido cercare di nascondere tutto con una bugia, diffondere l'ignoranza sotto forma di speranza.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Ma non vedi? Gli esseri umani sono deboli così. Preferiamo rinunciare alla nostra sicurezza per un senso di sicurezza.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorride e alza la voce.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ecco perché in un certo senso l’“etica” ha valore.", "Mariru")
	await novel_interface.show_dialog("Nascondere la verità su quell'esperimento fa parte del tuo lavoro. E la verità ora è nelle mie mani...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Hai ragione. Quindi, dai un nome ai tuoi termini.", "Lumbert")
	await novel_interface.show_dialog("Ma ricorda che io stesso non sono altro che un rappresentante e non ho alcuna influenza sulle decisioni del Congresso Unito. Non so nemmeno chi prende le decisioni.", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Non preoccuparti, non nominerò nulla che vada oltre il tuo potere.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("La mia condizione è questa: il successore di Scheinermann, primo ministro della Terza Città Accademia, non può essere un militare.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert sembra sorpreso dalla richiesta.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("In superficie, almeno dal punto di vista finanziario, finché il Congresso Unito autorizzerà Masada a vendere armi, non avranno mai bisogno di preoccuparsi che i loro produttori di armi falliscano.", "Mariru")
	await novel_interface.show_dialog("Tuttavia, la politica non è solo una questione di soldi. Anche la gente desidera il potere...", "Mariru")
	await novel_interface.show_dialog("Una volta che il pubblico inizierà a stancarsi di guerre inutili, non ci sarà più una solida base su cui costruire un esercito su larga scala.", "Mariru")
	await novel_interface.show_dialog("Non avete notato che ultimamente sempre più canali mediatici di Masada hanno cominciato a chiamare la propria capitale \"Città Accademia\" anziché Masada Ford?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert non risponde.")
	await novel_interface.show_text_only("All'improvviso, l'ascensore nero sul lato sinistro suona. Una donna con gli occhiali esce dalla porta, con una piccola valigetta in mano.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Akiko?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Hai incontrato quel vecchio facocero nel pomeriggio senza avvisarmi. Per questa volta ti lascio fuori dai guai...", "Akiko")
