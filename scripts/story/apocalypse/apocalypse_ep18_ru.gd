	await novel_interface.show_dialog("Ха-ха-ха...", "Тереза")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тереза сонно зевает.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Ты должен перестать меня постоянно будить так рано. Я просто хочу вернуться в свою кровать.", "Тереза")
	await novel_interface.show_dialog("В любом случае, у вас есть вся необходимая информация, верно?", "Тереза")
	await novel_interface.hide_character()
	
	# Scene 6 - 莉琉与伦伯特对话
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("С другой стороны доносится уверенный женский голос.")
	await novel_interface.show_dialog("Да, у меня есть все, что мне нужно для победы в этих переговорах.", "Женский голос")
