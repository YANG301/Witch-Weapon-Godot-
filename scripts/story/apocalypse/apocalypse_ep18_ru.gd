	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("У Сони браслет на щиколотке прослушивается. Я слышал все, что она сказала Рену. И это, плюс то, что вы нашли...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру смотрит на выцветшую фотографию в своей руке, расхаживая по закрытому подвалу.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Молодец, Тереза.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Или лучше сказать... Мачида Ринко?", "Мариру")
