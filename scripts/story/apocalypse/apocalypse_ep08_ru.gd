# apocalypse_ep08.gd - 天启篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第08话剧本
	apocalypse_ep08_script()

func play_script():
	pass

