# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("And as the glow burns ruddiest o’er the wave,\nThat waits the ascending team, which Phaëton\nIll knew to guide, and on each part the light")
	await novel_interface.show_text_only("Diminish’d fades, intensest in the midst;\nSo burn’d the peaceful oriflame, and slack’d\nOn every side the living flame decay’d.")
	await novel_interface.show_text_only("And in that midst their sportive pennons waved\nThousands of Angels; in resplendence each")
	await novel_interface.show_text_only("Distinct, and quaint adornment...")
	await novel_interface.show_text_only("—Canto XXXI, Paradiso, The Divine Comedy")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru stands, playing with the photo in her hands, while keenly observing the grey-haired man in front of her.")
	await novel_interface.show_text_only("There isn’t much information to be found concerning this man. No one even knows if Lumbert is his real name, let alone what his last name is.")
	await novel_interface.show_text_only("But it’s still a fact that he got knighted under this name due to “outstanding contribution to world peace”.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko’s already confirmed that it’s safe to negotiate with him.)", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Most people believe that the reason the United Congress holds the most power over our planet is that it’s where nation leaders around the world are congregated.", "Mariru")
	await novel_interface.show_dialog("True, this type of organization existed in history once upon a time. But the structure was flimsy and members could never stop arguing. The chairman acted more like a peacemaker-slash-beggar.", "Mariru")
	await novel_interface.show_dialog("But the United Congress we have now isn’t like that at all. Much more influential. And much richer.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru puts the photo back in her pocket, face impassive.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("From interest, trust is born. From trust, power is born. And power, through the arrangement and distribution of resources, generates even more interest...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert raises an eyebrow.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("That’s Walker’s basic model of society.", "Lumbert")
	await novel_interface.show_dialog("Politicians are chosen by interest groups as agents who have the trust of the public.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("If these agents are unable to maintain or create bigger interests, their powers will get ripped away and someone else will take their place.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("That’s true in macrohistory, but the public has never been reasonable. As Le Bon once said...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("The masses have never thirsted after truth. Whoever can supply them with illusions is easily their master; whoever attempts to destroy their illusions is always their victim.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert murmurs, finishing the quote for her. Mariru smiles and nods.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("There are too many ways to skip the interest part and directly gain the trust of the public.", "Mariru")
	await novel_interface.show_dialog("Leaders of this type aren’t afraid of making huge sacrifices as long as they succeed in the end.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("However, after the Seven Years War, the actual ones who keep the lives of the masses safe and the nations running begin to rethink the whole situation.", "Mariru")
	await novel_interface.show_dialog("And thus they formed the United Congress. An organization which collaborates and bargains directly with interest groups.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("So, it’s actually the other way around. The United Congress is not powerful because it consists of nation leaders. In fact, the truth is only those in the Congress are qualified to become nation leaders.", "Mariru")
	await novel_interface.show_dialog("This organization made their first move three years ago...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pauses. Lumbert stares at her, holding his breath.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Three years ago, the United Congress and the church worked together to test a type of EX-class Substance H in South America. They pressured the mafia warlords there to work with them.", "Mariru")
	await novel_interface.show_dialog("However, the experiment got out of hand. Over forty-six thousand locals died.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("They bribed everyone who knew the truth to shut them up, and branded the whole thing as the Churun River Massacre, pinning the blame on Carlos Branco, the only warlord who refused to cooperate.", "Mariru")
	await novel_interface.show_dialog("News of the incident went viral. The media loved it. The public hated it, and showed their disgust and hatred for war in a large scale.", "Mariru")
	await novel_interface.show_dialog("And the United Congress became widely appreciated as the organization that worked in a joint military operation to kill Branco. No one even bothered to question whether this organization’s existence was legal in the first place.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("But isn’t it too unnatural? Thousands of bodies, arranged in an array-like formation, with the church as center...", "Mariru")
	await novel_interface.show_dialog("I believe that the Congress fired a Substance H weapon there, one capable of disrupting the radio waves in a two-mile radius, in order to conceal the truth.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("A similar anomaly occurred on the West Asia battlefield too. That was why the images captured by the satellites over there were all distorted—light was a type of wave too, after all.", "Mariru")
	await novel_interface.show_dialog("That was why the radio wave disruptions in the area persisted for weeks even after “the gate” was closed.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru places heavy emphasis on the words “the gate”. Lumbert closes his eyes, resigned.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru studies the photo in her hand.")
	await novel_interface.show_dialog("Clearing all those bodies out required lots of workers. It must have been hard to ensure that none of them would leak anything.", "Mariru")
	await novel_interface.show_dialog("I bet you never expected someone to snap this photo of the scene with an old mechanical camera and a roll of rotted film.", "Mariru")
	await novel_interface.show_dialog("The background of the picture was blurry. That was due to the light distortion properties of the Substance H weapon your people used.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Interesting. But why are you so convinced I was involved?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("A month before the incident, you were named Secretary General of the Substance H Weapon Experiment Prohibition Treaty Organization.", "Mariru")
	await novel_interface.show_dialog("On the surface, the purpose of this organization is to prohibit Substance H weapon experiments. It’s a powerful establishment with lots of resources at hand and excellent information-collecting capabilities.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("It’s impossible for you not know about an incident of this scale. The reason you chose not to speak up was that you, in fact, was the one who planned it all.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert does not try to protest, and Mariru takes his silence as a sign that it’s safe to push on.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("In the end, the church sent some of their own to recover the Substance H causing all the trouble. They received an abnormal number of funds and privileges from the United Council afterwards.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("The Substance H in question is a half-open black door. Behind it is blinding golden light—", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Enough! I get it!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert interrupts, raising both arms in an act of surrender.")
	await novel_interface.show_text_only("He tugs at his suit collar and clears his throat.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Indeed, the mission of our organization is to make sure the public does not have easy access to Substance H weapons, let alone use them in experiments.", "Lumbert")
	await novel_interface.show_dialog("Substance H is just too dangerous. If not careful, it could destroy our civilization. But that experiment we conducted... it was unavoidable. Someone had to do it, might as well be us.", "Lumbert")
	await novel_interface.show_dialog("Someone... something... was knocking on the door from the inside. Increasingly urgently. We had no choice...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Knocking...?", "Mariru")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Knocking on heaven's door, yes.", "Lumbert")
	await novel_interface.show_dialog("Heaven exists in all religions and mythology systems, in different forms. The definitions may differ in each belief system, but perhaps they were all born from the same source.", "Lumbert")
	await novel_interface.show_dialog("In history records, they say that, right before the door is opened, it will be knocked on three times, consecutively.", "Lumbert")
	await novel_interface.show_dialog("Deep, echoing knocks. As if knocking on the listener’s soul...", "Lumbert")
	await novel_interface.show_dialog("After the knocks are first heard, there will be silence for a week, and the knocking starts again. The intervals between the knocks become gradually shorter...", "Lumbert")
	await novel_interface.show_dialog("When there is no more than ninety seconds between each set of knocks, we'll know that heaven's door is ready to open.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("You can define the “being” behind the door however you like, but the fact stands that it holds powers that can bring by an apocalypse-grade disaster.", "Lumbert")
	await novel_interface.show_dialog("A massive flood, for example, huh...", "Mariru")
	await novel_interface.show_dialog("According to the church's manuscripts, the only way to keep the door shut is to gather some ten thousand people in the range, surrounding the door...", "Lumbert")
	await novel_interface.show_dialog("A sacrifice of a sort, huh?", "Mariru")
	await novel_interface.show_text_only("Lumbert ignores Mariru's remark and goes on.")
	await novel_interface.show_dialog("This kind of thing happened every few hundred years. Always, the corpses ended up arranged in a radial array, with the door as the center point.", "Lumbert")
	await novel_interface.show_dialog("This kind of ritual was usually carried out in secret. However, as there were always hundreds of years between one ritual and the next, certain people from certain eras would use them to their own advantage...", "Lumbert")
	await novel_interface.show_dialog("For example, the St. Bartholomew's Day massacre in Paris, 1572.", "Lumbert")
	await novel_interface.show_dialog("The night before St. Bartholomew's Day that year, there was a horrible religious massacre, the worst out of centuries, with over seventy thousand deaths.", "Lumbert")
	await novel_interface.show_dialog("Paris, huh...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Wait, a radial array with a door as the center point?", "Mariru")
	await novel_interface.show_text_only("Mariru is immediately reminded of the way the roads are arranged in the city of romance.")
	await novel_interface.show_dialog("Ironic, isn't it...", "Lumbert")
	await novel_interface.show_text_only("Lumbert laughs, humorlessly.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Still, a door can’t be knocked on unless it’s got a concrete form. Why don't you just destroy it or dump it somewhere in outer space?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Heaven's door is but a concept. In the beginning, the door never appeared in the same spot twice.", "Lumbert")
	await novel_interface.show_dialog("It showed up in places where there wasn't supposed to be a door, even. For example, on the surface of ancient city walls.", "Lumbert")
	await novel_interface.show_dialog("They always brought disaster with them, but were also divine relics of a sort, proof of there being an existence beyond our understanding.", "Lumbert")
	await novel_interface.show_dialog("Religious factions in history had never stopped warring over this concept, wanting to claim it as their own.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("How does one claim a concept, exactly?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Historical records tell us that Hagia Sofia had been the official \"owner\" of heaven's door for the longest period of time.", "Lumbert")
	await novel_interface.show_dialog("Then, in the fifteenth century, sculptor Lorenzo Ghiberti of Florence claimed ownership of the concept via a piece of art he spent his whole life working on.", "Lumbert")
	await novel_interface.show_dialog("Said piece of artwork, after completion in 1452, was used as the main entrance of the Florence Cathedral. The world agreed that it shall be known as heaven's door from then on.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("I see.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The most ancient method humans used to claim ownership of a concept was to prove their own worth through creating majestic, extravagant artworks.")
	await novel_interface.show_text_only("Pyramids, temples, palaces, crowns, thrones...")
	await novel_interface.show_text_only("All ways to prove that the creator is the true, deserving owner of a concept.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Wait... wasn’t Constantinopole, where the Hagia Sofia is, invaded and occupied the year after Ghiberti's artwork was completed? Was it because...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert shakes his head.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("We don't know. No direct evidence could be found in that period.", "Lumbert")
	await novel_interface.show_dialog("What we CAN be sure of is that Ghiberti's work was destroyed in the Seven Years War.", "Lumbert")
	await novel_interface.show_dialog("Therefore, in order to determine when the \"door\" will next appear and ensure that it's in a remote enough area to cause only minimal damage the next time it opens...", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("We had to work with the church to create a copy of sorts.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("But something went awry in the experiment. We weren't able to close the gates like we should. That was why the church had to go to such lengths...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("This explains everything.To Mariru, it feels like finally piecing together the clues and seeing the whole puzzle as it is.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("So... you covered up everything afterwards with an ingenious lie, the help of the media, and the perfect scapegoat...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert chuckles grimly at Mariru's words.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Thanks for the compliment, I guess.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Nope. Not a compliment. If mankind will one day have no choice but to face power of such an overwhelming scale...", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("I'd consider it stupid to just try to cover everything up with a lie, to spread ignorance in the guise of hope.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("But don't you see? Humans are weak like that. We'd rather give up our safety for a sense of security.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru smirks and raises her voice.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("That’s why \"ethics\" are valuable in a way.", "Mariru")
	await novel_interface.show_dialog("Covering up the truth of that experiment is part of your job. And the truth is now in my hands...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("You're right. So, name your terms.", "Lumbert")
	await novel_interface.show_dialog("But do remember that I'm no more than a representative myself and have no influence over the decisions of the United Congress. I don't even know who makes the decisions.", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Don't worry, I won't name anything beyond your power.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("My condition is: the successor of Scheinermann, Prime Minister of the Third Academy City, cannot be someone from the military.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert looks taken aback at the request.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("On the surface, at least financially, as long as the United Congress authorizes Masada to sell weapons, they won’t ever need to worry about their weapon manufacturers going broke.", "Mariru")
	await novel_interface.show_dialog("However, politics isn't all about money. People desire power too...", "Mariru")
	await novel_interface.show_dialog("Once the public begins to grow tired of pointless wars, there will no longer be a firm foundation for a large-scale military to build on.", "Mariru")
	await novel_interface.show_dialog("Haven't you noticed that, recently, more and more media channels from Masada have begun to refer to their own capital as \"Academy City\" instead of Masada Ford?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert does not reply.")
	await novel_interface.show_text_only("Suddenly, the black elevator on the left side dings. A bespectacled female emerges from its doors, small briefcase in hand.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Akiko?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("You met that old warthog in the afternoon without notifying me. I’ll let you off the hook this once—", "Akiko")
	await novel_interface.show_dialog("But shouldn't you have at least told me you're meeting Mariru? Especially since I was the one who introduced you to each other!", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert turns to give Mariru a look of incredulity, and Mariru shrugs.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("She asked a lot of questions. I had to tell her.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Ugh...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Old fox.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko opens her briefcase, revealing a dozen batteries, held neatly in place with foam rubber.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("I'm sure you already know all about the parameters of these little guys.", "Mariru")
	await novel_interface.show_dialog("Masada had been working nonstop for days in order to show the world their high-density power storage products during the Forum of Peace.", "Mariru")
	await novel_interface.show_dialog("Kind of like how electricity-powered lamps were exhibited on the 1900 Paris Expo in order to show the world how military technologies can be applied for the use of the general public.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("After all, Prime Minister Scheinermann himself was the one who first launched and promoted this project.", "Mariru")
	await novel_interface.show_dialog("And according to our intelligence, Scheinermann won’t last till the next Passover with his current health condition.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert’s expression becomes grim at this.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("As for keeping canal transport unimpeded...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru takes a step closer and stares straight into Lumbert’s eyes.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Shouldn’t it be the best for “both benefiting parties” to take care of the budget together?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Fine...", "Lumbert")
	await novel_interface.show_dialog("But how does that benefit you in any way?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru does not reply. Instead, she simply takes out a battery from the case and sniffs at it, as if it were a cigar.")
	novel_interface.show_character("akiko","perspire")
	await novel_interface.show_dialog("Creep.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru reaches out and runs a hand, still holding the battery, through Akiko’s hair. The lady snorts and turns away.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Oh, you’re still wearing those non-prescription glasses?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Non-prescription glasses?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Anyway, you’ll get a lot out of working with us too. If Masada’s plans come into fruition, they’ll need a lot of funds from Newmoridas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("… I see.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("As for the perfect candidate, we still have time to decide.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru returns the battery to the case and extends her right hand towards Lumbert.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("So, deal?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert grasps Mariru’s hand firmly to accept the deal, then realizes after a few seconds that she shows no sign of wanting to let go.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Well, moving on to our next topic...", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("The test trial you’re running today...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
