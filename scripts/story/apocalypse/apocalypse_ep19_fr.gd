# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("Et tandis que la lueur brûle le plus rouge sur la vague,\nCela attend l'équipe ascendante, que Phaëton\nJ'ai su guider, et sur chaque partie la lumière")
	await novel_interface.show_text_only("Les fondus diminuent, les plus intenses au milieu ;\nAlors j'ai brûlé le paisible oriflame et je me suis relâché\nDe tous côtés, la flamme vivante s’éteignait.")
	await novel_interface.show_text_only("Et au milieu de cela leurs fanions sportifs s'agitaient\nDes milliers d'anges ; dans la splendeur chacun")
	await novel_interface.show_text_only("Une décoration distincte et pittoresque...")
	await novel_interface.show_text_only("—Chant XXXI, Paradiso, La Divine Comédie")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru se lève, jouant avec la photo dans ses mains, tout en observant attentivement l'homme aux cheveux gris devant elle.")
	await novel_interface.show_text_only("Il n’y a pas beaucoup d’informations disponibles sur cet homme. Personne ne sait même si Lumbert est son vrai nom, encore moins quel est son nom de famille.")
	await novel_interface.show_text_only("Mais il n’en demeure pas moins qu’il a été fait chevalier sous ce nom en raison de sa « contribution exceptionnelle à la paix mondiale ».")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko a déjà confirmé qu'il est sécuritaire de négocier avec lui.)", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("La plupart des gens pensent que la raison pour laquelle le Congrès uni détient le plus de pouvoir sur notre planète est que c’est là que se rassemblent les dirigeants des nations du monde entier.", "Mariru")
	await novel_interface.show_dialog("Il est vrai que ce type d’organisation a existé autrefois dans l’histoire. Mais la structure était fragile et les membres ne pouvaient cesser de se disputer. Le président s’est comporté plutôt comme un pacificateur-mendiant.", "Mariru")
	await novel_interface.show_dialog("Mais le Congrès uni que nous avons aujourd’hui n’est pas du tout comme ça. Beaucoup plus influent. Et bien plus riche.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru remet la photo dans sa poche, le visage impassible.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("De l’intérêt naît la confiance. De la confiance naît le pouvoir. Et le pouvoir, à travers l’agencement et la répartition des ressources, suscite encore plus d’intérêt…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert lève un sourcil.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("C’est le modèle de base de la société de Walker.", "Lumbert")
	await novel_interface.show_dialog("Les hommes politiques sont choisis par des groupes d’intérêt en tant qu’agents bénéficiant de la confiance du public.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Si ces agents sont incapables de maintenir ou de créer des intérêts plus importants, leurs pouvoirs leur seront retirés et quelqu’un d’autre prendra leur place.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("C’est vrai en macrohistoire, mais le public n’a jamais été raisonnable. Comme le disait Le Bon...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Les masses n’ont jamais eu soif de vérité. Celui qui peut leur fournir des illusions est facilement leur maître ; quiconque tente de détruire leurs illusions est toujours leur victime.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("» murmure Lumbert, finissant la citation pour elle. Mariru sourit et hoche la tête.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Il existe trop de façons de sauter la partie intérêt et de gagner directement la confiance du public.", "Mariru")
	await novel_interface.show_dialog("Les dirigeants de ce type n’ont pas peur de faire d’énormes sacrifices tant qu’ils réussissent au final.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Cependant, après la guerre de Sept Ans, ceux qui assurent la sécurité de la vie des masses et les nations en marche commencent à repenser la situation dans son ensemble.", "Mariru")
	await novel_interface.show_dialog("Et c’est ainsi qu’ils formèrent le Congrès Uni. Une organisation qui collabore et négocie directement avec des groupes d'intérêt.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Donc c’est en fait l’inverse. Le Congrès uni n’est pas puissant parce qu’il est composé de dirigeants nationaux. En fait, la vérité est que seuls les membres du Congrès sont qualifiés pour devenir des dirigeants nationaux.", "Mariru")
	await novel_interface.show_dialog("Cette organisation a fait son premier pas il y a trois ans...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fait une pause. Lumbert la regarde en retenant son souffle.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Il y a trois ans, le Congrès Uni et l’Église ont travaillé ensemble pour tester un type de substance H de classe EX en Amérique du Sud. Ils ont fait pression sur les chefs de guerre mafieux pour qu'ils travaillent avec eux.", "Mariru")
	await novel_interface.show_dialog("Cependant, l’expérience est devenue incontrôlable. Plus de quarante-six mille habitants sont morts.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Ils ont soudoyé tous ceux qui connaissaient la vérité pour les faire taire et ont qualifié tout cela de massacre de la rivière Churun, rejetant la faute sur Carlos Branco, le seul chef de guerre qui a refusé de coopérer.", "Mariru")
	await novel_interface.show_dialog("La nouvelle de l'incident est devenue virale. Les médias ont adoré. Le public détestait cela et montrait à grande échelle son dégoût et sa haine pour la guerre.", "Mariru")
	await novel_interface.show_dialog("Et le Congrès uni est devenu largement apprécié en tant qu’organisation ayant participé à une opération militaire conjointe visant à tuer Branco. Personne n’a même pris la peine de se demander si l’existence de cette organisation était légale.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Mais n’est-ce pas trop contre nature ? Des milliers de corps, disposés en forme de réseau, avec l'église comme centre...", "Mariru")
	await novel_interface.show_dialog("Je crois que le Congrès y a tiré avec une arme de substance H, capable de perturber les ondes radio dans un rayon de trois kilomètres, afin de cacher la vérité.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Une anomalie similaire s’est également produite sur le champ de bataille d’Asie occidentale. C’est pourquoi les images capturées par les satellites là-bas étaient toutes déformées : la lumière était aussi une sorte d’onde, après tout.", "Mariru")
	await novel_interface.show_dialog("C’est pourquoi les perturbations des ondes radio dans la région ont persisté pendant des semaines, même après la fermeture du « portail ».", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru met fortement l'accent sur les mots « la porte ». Lumbert ferme les yeux, résigné.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru étudie la photo qu'elle tient à la main.")
	await novel_interface.show_dialog("Éliminer tous ces corps a nécessité beaucoup de travailleurs. Il a dû être difficile de s’assurer qu’aucun d’entre eux ne divulguerait quoi que ce soit.", "Mariru")
	await novel_interface.show_dialog("Je parie que vous ne vous attendiez pas à ce que quelqu'un prenne cette photo de la scène avec un vieil appareil photo mécanique et un rouleau de film pourri.", "Mariru")
	await novel_interface.show_dialog("L'arrière-plan de la photo était flou. Cela était dû aux propriétés de distorsion de la lumière de l’arme Substance H utilisée par votre peuple.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Intéressant. Mais pourquoi es-tu si convaincu que j'étais impliqué ?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un mois avant l’incident, vous avez été nommé secrétaire général de l’Organisation du Traité d’interdiction des expériences sur les armes à substances H.", "Mariru")
	await novel_interface.show_dialog("En apparence, le but de cette organisation est d’interdire les expériences sur les armes à base de substance H. C’est un établissement puissant doté de nombreuses ressources et d’excellentes capacités de collecte d’informations.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Il est impossible que vous ne soyez pas au courant d’un incident d’une telle ampleur. La raison pour laquelle vous avez choisi de ne pas parler, c’est qu’en fait, c’est vous qui avez tout planifié.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert n’essaie pas de protester et Mariru considère son silence comme le signe qu’il peut continuer en toute sécurité.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Finalement, l'église envoya certains des siens pour récupérer la Substance H à l'origine de tous les ennuis. Ils ont ensuite reçu un nombre anormal de fonds et de privilèges du Conseil unifié.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("La Substance H en question est une porte noire entrouverte. Derrière, il y a une lumière dorée aveuglante—", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Assez ! Je comprends!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert l'interrompt en levant les deux bras en signe de capitulation.")
	await novel_interface.show_text_only("Il tire sur le col de son costume et s'éclaircit la gorge.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("En effet, la mission de notre organisation est de veiller à ce que le public n’ait pas facilement accès aux armes à substance H, et encore moins à leur utilisation à des fins expérimentales.", "Lumbert")
	await novel_interface.show_dialog("La substance H est tout simplement trop dangereuse. Si nous n’y prenons pas garde, cela pourrait détruire notre civilisation. Mais cette expérience que nous avons menée... était inévitable. Quelqu’un devait le faire, autant être nous.", "Lumbert")
	await novel_interface.show_dialog("Quelqu'un... quelque chose... frappait à la porte de l'intérieur. De plus en plus urgent. Nous n'avions pas le choix...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Frapper...?", "Mariru")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Frapper à la porte du paradis, oui.", "Lumbert")
	await novel_interface.show_dialog("Le paradis existe dans toutes les religions et systèmes mythologiques, sous différentes formes. Les définitions peuvent différer selon chaque système de croyance, mais peut-être sont-elles toutes nées de la même source.", "Lumbert")
	await novel_interface.show_dialog("Dans les archives historiques, on dit que juste avant que la porte ne soit ouverte, on frappera trois fois de suite.", "Lumbert")
	await novel_interface.show_dialog("Des coups profonds et résonnants. Comme pour frapper l'âme de l'auditeur...", "Lumbert")
	await novel_interface.show_dialog("Après que les coups auront été entendus pour la première fois, il y aura un silence pendant une semaine et les coups recommenceront. Les intervalles entre les coups deviennent progressivement plus courts...", "Lumbert")
	await novel_interface.show_dialog("Lorsqu’il ne s’écoulera pas plus de quatre-vingt-dix secondes entre chaque série de coups, nous saurons que la porte du paradis est prête à s’ouvrir.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Vous pouvez définir « l’être » derrière la porte comme bon vous semble, mais le fait est qu’il détient des pouvoirs qui peuvent provoquer un désastre de type apocalypse.", "Lumbert")
	await novel_interface.show_dialog("Une inondation massive, par exemple, hein...", "Mariru")
	await novel_interface.show_dialog("D'après les manuscrits de l'église, la seule façon de garder la porte fermée est de rassembler une dizaine de milliers de personnes dans le rang, entourant la porte...", "Lumbert")
	await novel_interface.show_dialog("Une sorte de sacrifice, hein ?", "Mariru")
	await novel_interface.show_text_only("Lumbert ignore la remarque de Mariru et continue.")
	await novel_interface.show_dialog("Ce genre de chose se produisait tous les quelques centaines d’années. Toujours, les cadavres étaient disposés en rangée radiale, avec la porte comme point central.", "Lumbert")
	await novel_interface.show_dialog("Ce genre de rituel se déroulait généralement en secret. Cependant, comme il y avait toujours des centaines d'années entre un rituel et le suivant, certaines personnes de certaines époques les utilisaient à leur avantage...", "Lumbert")
	await novel_interface.show_dialog("Par exemple, le massacre de la Saint-Barthélemy à Paris, 1572.", "Lumbert")
	await novel_interface.show_dialog("La veille de la Saint-Barthélemy cette année-là, il y eut un horrible massacre religieux, le pire depuis des siècles, faisant plus de soixante-dix mille morts.", "Lumbert")
	await novel_interface.show_dialog("Paris, hein...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Attendez, un réseau radial avec une porte comme point central ?", "Mariru")
	await novel_interface.show_text_only("Mariru se souvient immédiatement de la façon dont les routes sont aménagées dans la ville romantique.")
	await novel_interface.show_dialog("Ironique, n'est-ce pas...", "Lumbert")
	await novel_interface.show_text_only("Lumbert rit sans humour.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Pourtant, on ne peut frapper à une porte que si elle a une forme concrète. Pourquoi ne pas simplement le détruire ou le jeter quelque part dans l'espace ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("La porte du paradis n'est qu'un concept. Au début, la porte n’apparaissait jamais deux fois au même endroit.", "Lumbert")
	await novel_interface.show_dialog("Il est apparu même dans des endroits où il n’était pas censé y avoir de porte. Par exemple, à la surface des anciens murs de la ville.", "Lumbert")
	await novel_interface.show_dialog("Ils apportaient toujours des désastres avec eux, mais étaient aussi en quelque sorte des reliques divines, preuve de l’existence d’une existence au-delà de notre compréhension.", "Lumbert")
	await novel_interface.show_dialog("Les factions religieuses de l’histoire n’ont jamais cessé de se battre autour de ce concept, voulant se l’approprier.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Comment revendiquer un concept, exactement ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Les documents historiques nous disent que Sainte-Sophie était la « propriétaire » officielle de la porte du paradis pendant la plus longue période.", "Lumbert")
	await novel_interface.show_dialog("Puis, au XVe siècle, le sculpteur florentin Lorenzo Ghiberti s'est approprié le concept à travers une œuvre d'art sur laquelle il a travaillé toute sa vie.", "Lumbert")
	await novel_interface.show_dialog("Cette œuvre d'art, une fois achevée en 1452, servait d'entrée principale à la cathédrale de Florence. Le monde a convenu qu'elle serait désormais connue comme la porte du ciel.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Je vois.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La méthode la plus ancienne utilisée par les humains pour revendiquer la propriété d’un concept était de prouver leur propre valeur en créant des œuvres d’art majestueuses et extravagantes.")
	await novel_interface.show_text_only("Pyramides, temples, palais, couronnes, trônes...")
	await novel_interface.show_text_only("Autant de moyens de prouver que le créateur est le véritable propriétaire méritant d’un concept.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Attendez... Constantinopole, où se trouve Hagia Sofia, n'a-t-elle pas été envahie et occupée l'année suivant l'achèvement de l'œuvre de Ghiberti ? Était-ce parce que...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert secoue la tête.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Nous ne le savons pas. Aucune preuve directe n'a pu être trouvée à cette époque.", "Lumbert")
	await novel_interface.show_dialog("Ce dont nous pouvons être sûrs, c'est que l'œuvre de Ghiberti a été détruite pendant la guerre de Sept Ans.", "Lumbert")
	await novel_interface.show_dialog("Par conséquent, afin de déterminer quand la « porte » apparaîtra la prochaine fois et de s’assurer qu’elle se trouve dans une zone suffisamment éloignée pour ne causer que des dommages minimes lors de sa prochaine ouverture…", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Nous avons dû travailler avec l’église pour créer une sorte de copie.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Mais quelque chose s’est mal passé au cours de l’expérience. Nous n’avons pas pu fermer les portes comme nous le devrions. C'est pourquoi l'Église a dû aller si loin...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela explique tout. Pour Mariru, c'est comme si elle avait enfin rassemblé les indices et vu l'ensemble du puzzle tel qu'il est.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Alors... vous avez tout dissimulé par la suite avec un mensonge ingénieux, l'aide des médias et le parfait bouc émissaire...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert rit sombrement aux paroles de Mariru.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Merci pour le compliment, je suppose.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Non. Pas un compliment. Si l’humanité n’avait un jour d’autre choix que de faire face à un pouvoir d’une telle ampleur…", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Je trouverais stupide d’essayer de tout dissimuler sous un mensonge, de répandre l’ignorance sous couvert d’espoir.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Mais tu ne vois pas ? Les humains sont faibles comme ça. Nous préférons abandonner notre sécurité pour un sentiment de sécurité.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sourit et élève la voix.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("C’est pourquoi « l’éthique » est précieuse d’une certaine manière.", "Mariru")
	await novel_interface.show_dialog("Dissimuler la vérité sur cette expérience fait partie de votre travail. Et la vérité est désormais entre mes mains...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Vous avez raison. Alors, nommez vos termes.", "Lumbert")
	await novel_interface.show_dialog("Mais n'oubliez pas que je ne suis moi-même qu'un représentant et que je n'ai aucune influence sur les décisions du Congrès uni. Je ne sais même pas qui prend les décisions.", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ne vous inquiétez pas, je ne nommerai rien au-delà de votre pouvoir.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ma condition est la suivante : le successeur de Scheinermann, Premier ministre de la Troisième Cité Académie, ne peut pas être un militaire.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert semble interloqué par cette demande.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("En apparence, au moins financièrement, tant que le Congrès américain autorise Massada à vendre des armes, ils n’auront jamais à s’inquiéter de la faillite de leurs fabricants d’armes.", "Mariru")
	await novel_interface.show_dialog("Cependant, la politique n’est pas qu’une question d’argent. Les gens aussi désirent le pouvoir…", "Mariru")
	await novel_interface.show_dialog("Une fois que l’opinion publique commencera à se lasser des guerres inutiles, il n’y aura plus de fondation solide sur laquelle bâtir une armée à grande échelle.", "Mariru")
	await novel_interface.show_dialog("N'avez-vous pas remarqué que, récemment, de plus en plus de chaînes médiatiques de Massada ont commencé à appeler leur propre capitale « la Ville Académie » au lieu de Massada Ford ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert ne répond pas.")
	await novel_interface.show_text_only("Soudain, l’ascenseur noir sur la gauche sonne. Une femme à lunettes émerge de ses portes, une petite mallette à la main.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Akiko ?", "Lumbert")
	await novel_interface.hide_character()
