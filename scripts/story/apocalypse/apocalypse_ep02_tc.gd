# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("週五清晨，電視新聞就開始輪番播放當天凌晨營救人質的跟拍片段。")
	await novel_interface.show_text_only("由於SID及時封鎖了埃癸斯內所有的對外道路，綁匪只能臨時選擇將人質囚禁在一座老式倉庫內。")
	await novel_interface.show_text_only("毫無意外地，四名涉嫌綁架聯合議會高層官員的恐怖分子遭到逮捕。")
	await novel_interface.show_dialog("在國際領土上明目張膽的犯下綁架和謀殺，是對聯合議會所有成員國的公然挑釁！", "倫伯特")
	await novel_interface.show_dialog("這次事件充分說明了這世界上不該存在恐怖主義，最近頻繁發生的時空相位波動也可能與恐怖活動有關。", "倫伯特")
	await novel_interface.show_dialog("身為那場戰爭的倖存者，我始終認為……威脅是維護安全與和平最重要的手段。", "倫伯特")
	await novel_interface.show_text_only("我忍不住跳過那段看起來像鬼扯的採訪，一邊嚼著洋芋片一邊說道。")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("這傢伙好像差點屎掉欸！（嚼）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("剛被救出來就這麼慷慨激昂啊～還真是政治人……嗯……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("不過懸吊攻入倉庫那段好酷，簡直像在拍警匪片！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("嗯嗯──好酷！", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡一臉認真地點頭。")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("那是後製和配樂的功勞啦，現在大家都喜歡這種誇張的效果。", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("由於這幾天市區內有重大活動，學校都延到10點半才開始上課，放學的時間也提早很多。")
	await novel_interface.show_text_only("所以，我、安妮和伊露卡就像倉鼠一樣窩在沙發裡，安妮還從我手中搶走了洋芋片。")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("這次主要是靠SID的情報才能順利救出人質吧？\n但是新聞裡一個字都沒提……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("情報機構需要保密呀，還是低調點比較好～", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("小憐姐姐、小憐姐姐……\n巧克力，沒有了……", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡的小腦袋突然從我和安妮之間冒了出來。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("巧克力口味的Pocky嗎？\n樓下便利商店的貨好像被我們掃光了……", "小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("下次我去超市再幫妳買～", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("可是……可是，現在就沒有了……", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡舉著空蕩蕩的盒子，一邊搖晃盒子一邊用小狗眼神看著我。")
	await novel_interface.show_text_only("不過，這一陣子天氣莫名燥熱，我實在懶得出門，只想在冷氣房裡當沙發馬鈴薯。")
	await novel_interface.show_text_only("因為舉辦了第四屆國際和平論壇，協議非武裝區來了不少大人物，莉琉最近也忙得不可開交。")
	await novel_interface.show_text_only("而且這次論壇規模空前絕後，新豐洲之外的五大學園都市都派了上百人的代表團前來。")
	await novel_interface.show_text_only("這種高規格的政府領導人會議，實在為大家的日常生活帶來了許多不便！")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("現在好多地方都臨時變成單向道，騎車得繞來繞去，搞得連叫外賣都沒人想送……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮一邊看手機，一邊倒向沙發另一側，把頭埋進抱枕裡。")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("知道啦知道啦，我去買就是了……\n安妮想買什麼嗎？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("哼哼～", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("欸嘿嘿嘿……", "伊露卡")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("她們兩人一臉詭計得逞的樣子，毫不客氣地列出一長串購物清單。")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("……")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("熱──", "小憐")
	await novel_interface.show_dialog("好熱啊────", "小憐")
	await novel_interface.show_text_only("超市才剛開門，但室外已經叫人悶熱難耐。")
	await novel_interface.show_text_only("我提著一大袋食物，這幾天街上的警衛人數明顯比平時多了好幾倍。")
	await novel_interface.show_text_only("動不動就交通管制，還必須隨身攜帶身分證應付臨檢……")
	await novel_interface.show_text_only("大眾交通工具各站附近也都有防衛廳的巡邏車和安保助理。")
	await novel_interface.show_text_only("協議非武裝區周邊大範圍交管，主幹道的路燈上全都加裝了新的監視器。")
	await novel_interface.show_text_only("據說因為保安警察人手不足，聯合議會還把帕蘭蒂爾的傭兵都雇好雇滿了……")
