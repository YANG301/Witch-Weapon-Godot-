	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（那些新豐洲市區外出沒的「女巫」，處理方式通常是由軍方以提前佈置好的重火力強行殲滅。）", "莉琉")
	await novel_interface.show_dialog("（根據以往經驗，那些東西在魔女之繭消失後，會隨機對周圍生物及設施進行攻擊。）", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（但最近兩週開始，這些照理來說應該毫無理智的東西，突然表現出某種規律的行為……）", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("等等，前方……有人影！", "士兵A")
