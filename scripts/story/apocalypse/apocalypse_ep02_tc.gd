	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("SID指揮室，23點15分。")
	await novel_interface.show_text_only("紅髮的女性身著軍裝，雙手抱在胸前，緊盯著螢幕上黑白畫面中的十幾個紅色方框。")
	await novel_interface.show_text_only("螢幕下方忽然彈出一個對話窗──")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("報告長官，根據編號記錄，被綁架的倫伯特還在埃癸斯範圍內。", "SID探員")
	await novel_interface.show_dialog("依照監視影片的分析，綁匪最可能就在這三個區域中，而且灣區裡某個老式倉庫用電異常……", "SID探員")
	await novel_interface.show_dialog("要通知防衛廳進行營救嗎？", "SID探員")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
