	await novel_interface.show_text_only("Ich reibe mir die Augen und finde mich auf dem Rücksitz unseres SUV wieder. Was habe ich gerade ausgespuckt? Ich schaue auf meine Hand.")
	novel_interface.show_character("ren_fishnet","upset")
