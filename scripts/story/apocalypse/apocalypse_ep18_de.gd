	await novel_interface.show_dialog("War es...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa hält inne und wartet auf die Bestätigung von der anderen Seite.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Ah, richtig, ich wusste, dass sie es war! Als ich sie heute traf, spürte ich es auch.", "Theresa")
