# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Als wir das Gebäude verlassen, finden wir unser Fahrzeug am Eingang geparkt. Der stämmige Fahrer reicht uns zwei Mikro-Knochenleitungs-Ohrhörer.")
	await novel_interface.show_dialog("Der Chef hat mir gesagt, ich soll dir die geben.", "Fahrer")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Der B-Boss?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya und ich setzen die Ohrhörer auf und hören Aya am anderen Ende sprechen.")
	await novel_interface.show_dialog("Es ist zu laut in der Menge. Es kann sein, dass Sie Schwierigkeiten haben, mich zu hören, wenn wir telefonieren.", "Ai")
	await novel_interface.show_dialog("Ich habe es gerade überprüft. Von der gesamten vereinbarten entmilitarisierten Zone gibt es nur in den sieben Gebieten, in denen es zu den Unruhen kam, gelbe Straßenlaternen.", "Ai")
	await novel_interface.show_dialog("Das sind alles belebte Bereiche mit vielen Werbetafeln und anderen Lichtquellen, sodass selbst diejenigen, die sich Luftaufnahmen ansehen, den Unterschied nicht bemerken würden.", "Ai")
	await novel_interface.show_dialog("Wir haben unser Bergungsteam geschickt, aber ich schätze, ich kann Sie nicht davon überzeugen, zurückzubleiben. Passen Sie einfach auf, dass Ren in Sicherheit ist.", "Ai")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Zurückbleiben? Hä? Von was fernbleiben?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya nickt einfach der Drohne zu, die uns verfolgt hat, und zerrt mich in die Menge.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("Wir kommen unter einer gelben Straßenlaterne an, die zum Glück nicht von allzu vielen Menschen umgeben ist. Der Lampenmast reicht fast fünfundzwanzig Fuß in die Höhe.")
	await novel_interface.show_text_only("Damals in den Trainingskursen bei SID war ich bei den Kletterübungen ein totaler Versager.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Ich habe für alle ein F bekommen.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Normalerweise musste ich die Stange mit einem fliegenden Sprung angreifen, um etwas an Höhe zu gewinnen – aber am Ende rutsche ich trotzdem nach unten.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hehe...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya holt eine durchhängende Metallschachtel aus ihrer Handtasche. Es ist überraschend groß, die Seiten haben die Größe eines durchschnittlichen Notizpapiers und sind etwa sieben Zentimeter dick.")
	await novel_interface.show_text_only("Über die Oberfläche der Box verläuft eine glänzende silberne Linie, die ein drehbares Bauteil markiert. Und an der Seite befindet sich ein rosafarbener Metallic-Streifen.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Ratet mal, was ich hier habe!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ruft Sonya stolz aus und hält die Schachtel hoch, damit ich sie sehen kann.")
	await novel_interface.show_text_only("Hmm. Gemessen an der Größe, der Handwerkskunst, der großen fächerartigen drehbaren Komponente und dem glitzernden Metallstreifen –")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Äh, eine Art unnötig große Grafikkarte?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya zieht einfach den Verschluss am Griff und die rosa gestreifte Seite der Box öffnet sich wie eine Ziehharmonika.")
	await novel_interface.show_text_only("Und aus dem Inneren kommen eine Reihe schwarzer mechanischer Komponenten sowie ein langes „Brett“ zum Vorschein. Wenn Sie sie alle zusammenfügen, ist die Länge fast 100 cm groß.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Was zum Teufel?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Es handelt sich um eine Waffe, die es nur bei Judgement Knights gibt. Unterstützt von Substanz H!", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Die Strafvollzugsanstalt hat es nach meinen Wünschen für mich gemacht.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya dreht den Griff und eine Reihe glänzender Sägezähne erscheint am Rand des langen Bretts.")
	await novel_interface.show_text_only("Die Zahnreihe reicht bis zum Bogen am Ende des Bretts und schließlich bis zurück in den Kasten.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Eine Kettensäge?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("So etwas in der Art. Es wird jedoch nicht mit Strom betrieben. Es ist meine Lieblingswaffe!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya grinst und schaltet die „Kettensäge“ ein. Die Zähne beginnen sich mit erstaunlicher Geschwindigkeit zu drehen, aber es ist überraschend leise.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("Wirst du –", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ohne zu zögern beginnt Sonya, den metallenen Lichtmast zu durchschneiden. Überall fliegen Funken und die silberne Stange kreischt protestierend.")#多字问题
	await novel_interface.show_text_only("Der Lärm lockt ein ganzes Publikum an. Ein paar Männer mittleren Alters beginnen zu johlen und zu jubeln, obwohl sie nicht die geringste Ahnung haben, was vor sich geht.")
	await novel_interface.show_text_only("Sehr bald sind zwei Knallgeräusche aus dem Inneren der Stange zu hören und Sonya holt ruhig ihre Kettensäge hervor.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie schaut zur Straßenlaterne hinauf, die nicht mehr leuchtet. Die Säule mit einem Durchmesser von etwa zwanzig Zentimetern ist fast durchschnitten.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Holz!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Das ist eher so!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya grinst und versetzt der Stange einen Schlag in die entgegengesetzte Richtung der Menge.")
	await novel_interface.show_text_only("Und schließlich gibt die Stange nach und fällt mit einem ohrenbetäubenden Kreischen um.")
	await novel_interface.show_text_only("Boom! Der Laternenpfahl knallt in den Boden, reißt die Teeroberfläche auf und schleudert Trümmer durch die Luft.")
	await novel_interface.show_text_only("Die umstehenden Menschenmassen bleiben für ein paar Sekunden sprachlos, dann bricht wilder Applaus aus.")
	await novel_interface.show_dialog("Zur Freiheit!\nZum Frieden!", "Menschenmenge")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("Was hat das mit Freiheit und Tempo zu tun?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir sprinten zu dem Platz, der einst die Spitze der Straßenlaterne war. Sonya schneidet schnell den Teil mit dem Licht ab, während die Drohne, die uns verfolgt, neben dem Spektakel landet.")
	await novel_interface.show_dialog("Von hier aus kann ich nicht viel sehen. Entfernen Sie den Lampenschirm und halten Sie die Glühbirne näher an die Drohne. Ich möchte das LED-Modell sehen.", "Ai")
	await novel_interface.show_text_only("Um den aufgeregten Menschenmassen auszuweichen, nehme ich die Glühbirne und renne in Richtung unseres SUV.")#换行问题
	await novel_interface.show_text_only("Sobald wir ankommen, analysiert Sonya das Ganze gemäß Ayas Anweisungen. Wir finden eine Mikrokamera, Batterien, das Filament und das elektrische Vorschaltgerät.")
	await novel_interface.show_dialog("Die Seriennummern dieser Komponenten und der LED scheinen alle in Ordnung und einwandfrei zu sein.", "Ai")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Hey...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich halte den Lampenschirm von irgendwo außerhalb des Fahrzeugs gegen die Lichtquelle.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Wenn der Lampenschirm gelb ist, kann die Lampe auf keinen Fall weißes Licht erzeugen, oder?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die gelbe Textur, die den Lampenschirm bedeckt, wirkt kompliziert und weist eine detaillierte Prägung auf. Muss eine Menge Arbeit gekostet haben.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Vielleicht ist auf diesem Lampenschirm eine Botschaft versteckt? Ich kann es allerdings nicht sagen...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auch Sonya hält den Lampenschirm gegen das Licht draußen und schüttelt geschlagen den Kopf.")
	await novel_interface.show_dialog("Im Transporter befindet sich ein 3D-Scangerät. Legen Sie den Lampenschirm hinein und senden Sie mir die Ergebnisse.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Wow, wir haben so etwas am Auto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Natürlich! Alle SID-Fahrzeuge sind mit einem vollständigen Satz automatisierter Waffen ausgestattet.", "Ai")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("Achtung!", "Soya")
	await novel_interface.hide_character()
	
