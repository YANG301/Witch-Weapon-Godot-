	await novel_interface.show_dialog("Hahahaha...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa gähnt schläfrig.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Du musst aufhören, mich ständig so früh zu wecken. Ich möchte einfach zurück in mein Bett.", "Theresa")
	await novel_interface.show_dialog("Wie auch immer, Sie haben doch alle Informationen, die Sie brauchen, oder?", "Theresa")
	await novel_interface.hide_character()
	
