	await novel_interface.show_dialog("Tsk...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa schneidet geschickt ein schwarzes Stück Stoff aus der Kleidung eines toten Soldaten am Boden aus und spricht dabei träge in ihr Headset.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Sind diese Jungs wirklich nur ein Ersatzteam?\nSie haben sicher viel für ihre Ausrüstung ausgegeben.", "Theresa")
	await novel_interface.show_dialog("Hä? Sie am Leben lassen?", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("... Ups!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa schlägt sich auf den Kopf.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Ich habe vergessen, dass ich sie am Leben lassen sollte ...", "Theresa")
	await novel_interface.show_dialog("Komm schon, es ist nicht meine Schuld! Ihre Gehirne explodierten plötzlich. Ich wurde überrascht und habe sie alle getötet.", "Theresa")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("Außerdem ist es doch nicht so, dass wir von diesen Kerlen irgendetwas Interessantes herausfinden können, selbst wenn ich sie lebend zurückbringe, oder?", "Theresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Verbrenne alle Fingerabdrücke ... Dynamitimplantate in Zähnen ... sobald sie kurz vor dem Tod stehen, wird der Mechanismus ausgelöst und das ganze Gesicht wird gesprengt ...", "Theresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("... Ja! Sehen? Nicht meine Schuld!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya beschwert sich bei der Person am anderen Ende des Gesprächs.")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("Ich hätte diese Kerle am liebsten am Leben gelassen! Ich habe sie einfach mit meiner Klinge getroffen ... Ich wollte ihnen die Chance geben, meine coolen Bewegungen zu schätzen –", "Theresa")
