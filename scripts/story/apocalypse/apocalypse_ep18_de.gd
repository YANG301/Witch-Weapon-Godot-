	await novel_interface.show_dialog("Und dann sind sie einfach explodiert!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie seufzt, reinigt ihre Klinge mit dem Stoff, den sie abgeschnitten hat, und wirft dann den schmutzigen Lappen auf das Gesicht der Leiche – falls man es überhaupt noch als Gesicht bezeichnen kann.")
