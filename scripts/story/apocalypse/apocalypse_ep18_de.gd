	await novel_interface.show_dialog("Ein Haufen Verlierer.", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa steckt ihr glänzendes Katana zurück in die Scheide.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Aus dem Nichts tauchten aus einer Gasse zwei Rettungskräfte auf. Kein Nummernschild. Da es mehr als ein Dutzend waren, konnte ich sie nicht alle auf einmal nehmen ...", "Theresa")
