	await novel_interface.show_dialog("Ren...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/Wakingup.png")
	await novel_interface.show_text_only("Ich zwinge mich dazu, die Augen zu öffnen, obwohl alles immer noch verschwommen ist.")
	await novel_interface.show_dialog("Ren—", "Soya")
	await novel_interface.show_dialog("Du bist wach?", "Soya")
	await novel_interface.show_text_only("Sonya klingt aufgeregt. Sind das Tränen, die ich in ihren Augen sehe?")
	await novel_interface.show_dialog("Was ist passiert...?", "Lian")
	await novel_interface.show_dialog("Urgh...", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ich spüre etwas Hartes in meinem Mund. Etwas, das nicht da sein sollte. Ich spucke es reflexartig aus.")
