	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Hallo, Sir Lumbert.\nSehen Sie, unsere beiden Identitäten sind... sensibel, also müssen wir uns heimlich treffen.", "Mariru")
