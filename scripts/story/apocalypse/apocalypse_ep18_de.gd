	await novel_interface.show_dialog("Warte, was?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa drückt das Headset näher an ihr Ohr, als würde das das Gehörte verändern.")
	novel_interface.show_character("cereza","uneasy")
	await novel_interface.show_dialog("Die Angreifer... alle vernichtet?", "Theresa")
	await novel_interface.show_dialog("Und ihr Blut spritzte so hoch, dass es den fünften Stock eines nahegelegenen Bürogebäudes erreichte?", "Theresa")#多符号
