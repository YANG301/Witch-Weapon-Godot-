# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Uns werden alle möglichen Tugenden beigebracht, nach denen wir leben können.")
	await novel_interface.show_text_only("Ich bin mir sicher, dass die meisten von uns die Geschichte über Marie Curie und ihre außergewöhnliche Konzentrationsfähigkeit gelesen haben.")
	await novel_interface.show_text_only("Sie lernte und ihre Schwester und ihre Klassenkameraden ließen sich einen Streich einfallen. Sie stapelten mehrere Stühle hinter ihr. Wenn sie sich bewegte, würde der ganze Stapel zusammenbrechen.")
	await novel_interface.show_text_only("Aber der Stapel blieb an Ort und Stelle, bis Marie Curie das ganze Buch zu Ende gelesen hatte.")
	await novel_interface.show_text_only("Ihr großer Fokus war es, der es ihr ermöglichte, die erste Wissenschaftlerin zu werden, die zweimal den Nobelpreis erhielt.")
	await novel_interface.show_text_only("Aber diese Frage könnte Ihnen schon einmal in den Sinn gekommen sein:")
	await novel_interface.show_text_only("„Sind alle gleich zu dem gleichen Thema? Seit ihrer Geburt?“")
	await novel_interface.show_text_only("Manche Menschen verfügen von Geburt an über die Fähigkeit, ununterbrochen Wissen aufzunehmen, und brauchen kaum Schlaf.")
	await novel_interface.show_text_only("Sie können sich viele Informationen merken und bleiben lange konzentriert.")
	await novel_interface.show_text_only("Es ist einfach für sie. Aber für viele andere ist es nahezu unmöglich.")
	await novel_interface.show_text_only("Für Marie Curie ist das Lesen von Physikbüchern vielleicht einfacher als das Lesen von Mangas.")
	await novel_interface.show_text_only("Das Streben nach den gleichen „Tugenden“ ist für die meisten Menschen wie ein Kampf gegen die genetischen Merkmale, mit denen sie geboren wurden.")
	await novel_interface.show_text_only("Vielleicht haben Sie sich mit dieser Frage noch nie beschäftigt?")
	await novel_interface.show_text_only("Aber jetzt hast du es. Der Samen wurde in deinen Kopf gepflanzt.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Also...")
	await novel_interface.show_text_only("Wenn Sie sich das nächste Mal diese Frage stellen, wessen Stimme wird sie stellen?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Klicken Sie.")
	await novel_interface.show_text_only("Das Geräusch einer Waffe, die geladen wird.")
	await novel_interface.show_text_only("Nach der Eröffnungssequenz von NTBC News ertönt die bekannte Stimme der weiblichen Ansagerin.")
	await novel_interface.show_dialog("„Das vierte jährliche Internationale Friedensforum wird in drei Tagen in der vereinbarten entmilitarisierten Zone in New Opulentia stattfinden.“", "Nachrichten")
	await novel_interface.show_dialog("„Als neutrale Stadt mit dem größten wissenschaftlichen Forschungssystem wird New Opulentia diese Woche Gäste aus den anderen fünf Akademiestädten begrüßen.“", "Nachrichten")
	await novel_interface.show_dialog("„Das diesjährige Friedensforum wird sich auf die Entwicklung von Substanz H als Energieressource, das Rebuild-Projekt und andere wichtige Themen konzentrieren.“", "Nachrichten")
	await novel_interface.show_dialog("„Der Sprecher von Masada Ford hat kürzlich in einer inoffiziellen Rede erklärt, dass die Stadt bald eine Reihe brandneuer Militärpläne veröffentlichen wird, um die Ordnung im Nahen Osten wiederherzustellen.“", "Nachrichten")
	await novel_interface.show_dialog("„Der Vertreter der Nachrichtenabteilung von Salmonton hat es abgelehnt, sich zu diesem Thema zu äußern.“", "Nachrichten")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("In der alten Lagerhalle hängt die schwach beleuchtete Deckenlampe, die kleine zischende Elektrizitätsgeräusche von sich gibt.")
	await novel_interface.show_text_only("Auf der einen Seite sitzt ein silberhaariger Mann im grellen weißen Licht.")
	await novel_interface.show_text_only("Er ist an einen stabilen Stuhl gefesselt, dessen Beine am Boden festgeschweißt sind.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("Der Mann muss sich immer noch an die Helligkeit um ihn herum gewöhnen, da der Sack über seinem Kopf gerade abgerissen wurde. Die rauen Schiffsverstärkungsdrähte reiben an seinem teuren maßgeschneiderten Anzug und hinterlassen raue, ausgefranste Enden.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als er das Geräusch einer Waffe bemerkt, die gespannt wird, hebt er langsam den Kopf.")
	await novel_interface.show_text_only("Direkt vor ihm ist eine Kamera montiert. Und daneben steht ein Entführer mit schwarzer Maske und zeigt mit einer Waffe auf ihn.")
	await novel_interface.show_text_only("Der Mann versucht verzweifelt, sich umzusehen. Am anderen Ende des Lagerhauses entdeckt er einen Wachmann mit einem Sturmgewehr in der Hand.")
	await novel_interface.show_text_only("Anhand der schwarzen Kopftücher, die ihre Gesichter verdecken, und der Tarnkleidung ist es ziemlich offensichtlich, woher diese Jungs kommen.")
	await novel_interface.show_text_only("Der silberhaarige Mann dreht sich, so gut er kann. Am Rande seines Sichtfeldes sieht er eine schwarze Flagge ...")
	await novel_interface.show_text_only("Auf der Videokamera vor ihm ist ein Mobiltelefon montiert, das die Nachrichten in höchster Lautstärke abspielt.")
	await novel_interface.show_dialog("„Sir Lumbert, Exekutivsekretär der Organisation zum Verbot von Waffenexperimenten mit Substanz-H, hat heute eine Pressekonferenz abgehalten.“", "Nachrichten")
	await novel_interface.show_dialog("„Die Organisation spielt eine wichtige Rolle dabei, zu verhindern, dass Substanz H als Waffe eingesetzt wird. Sie wurde auf der Grundlage des Universal Substance H Weapon Experiment Prohibition Treaty gegründet.“", "Nachrichten")
	await novel_interface.show_dialog("„Sir Lumbert gibt an, dass die Organisation derzeit eine große Anzahl von Überwachungsstationen auf der ganzen Welt eingerichtet hat, um alle Experimente mit Substanz H zu überwachen.“", "Nachrichten")
	await novel_interface.show_dialog("„Lumbert glaubt, dass die militärische Zusammenarbeit zwischen Akademiestädten ein normalisierter Teil ihrer diplomatischen Beziehungen werden sollte.“", "Nachrichten")
	await novel_interface.show_dialog("„Er behauptet, Masada Fords Entwicklung und Erprobung ihres passiven Gegenreaktionssystems zu unterstützen. Er erklärt, dass ein angemessenes Maß an Einschüchterung die wahre Grundlage für die Aufrechterhaltung des Friedens sei.“", "Nachrichten")
	await novel_interface.show_dialog("„Er bittet auch öffentlich um eine Gelegenheit zu einem Gespräch mit Dr. Mariru Von Braun von der New Opulentia Academy of Sciences …“", "Nachrichten")
	await novel_interface.show_text_only("Als er das hört, grinst der Mann, der an den Stuhl gefesselt ist, leicht.")
	await novel_interface.show_text_only("Sein makelloses silbernes Haar ist zurückgekämmt. Himmelblaue Augen blicken lässig auf ein paar Fotos, die an der Wand gegenüber angebracht sind.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Auf einem verblassten Foto sind ein paar Arbeiter in Schutzanzügen zu sehen, die sich mit Leichenbergen befassen.")
	await novel_interface.show_text_only("Der geringen Auflösung der Fotos nach zu urteilen, müssen sie mit einer Spiegelreflexkamera und einem altmodischen Film aufgenommen worden sein.")
	await novel_interface.show_text_only("Er erinnert sich noch gut daran, dass sie damals in einem Umkreis von mehreren Kilometern starke elektromagnetische Störwellen eingesetzt hatten, um andere davon abzuhalten, die Gegend zu filmen.")
	await novel_interface.show_text_only("Dem Datum unten links zufolge wurde das Foto vor drei Jahren am Ufer des Churun-Flusses am Guyana-Schild aufgenommen ...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Klick!")
	await novel_interface.show_text_only("Der Mann in Schwarz klappt das Telefon zu und tritt dem Silberhaarigen aus dem Nichts auf den Bauch.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Ugh! *hustet*", "Mann im Anzug")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sie können es nicht ertragen, wie falsch Sie im Fernsehen aussehen, nicht wahr, Sir?", "Entführer")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Gefälscht?\nIch war... aufrichtig.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Mann in Schwarz geht auf Lumbert zu, packt ihn an den Haaren und reißt seinen Kopf nach hinten, sodass er sich direkt der einzigen Lichtquelle im Raum zuwenden muss.")
	await novel_interface.show_text_only("Dann holt er eine Sense heraus und zielt damit auf Lumberts Auge.")
	await novel_interface.show_dialog("Nun, ich frage mich, wie viel dein Gesicht wert ist?", "Entführer")
	await novel_interface.show_text_only("Da das Licht direkt in die Augen des Mannes scheint, verdünnen sich seine himmelblauen Pupillen schnell.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Also, was sagen Sie? Nennen Sie Ihren Preis.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert wirft einen heimlichen Blick auf die Klinge aus Damaststahl, die auf seinen Augapfel zeigt.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Du hast dich nach New Opulentia geschlichen, hast dir meinen vollen Terminkalender geschnappt und alle meine Leibwächter innerhalb von zwei Minuten erledigt ...", "Lumbert")
	await novel_interface.show_dialog("Und es ist mir sogar gelungen, diese Fotos zu bekommen ...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Auf keinen Fall hast du das alles getan, nur um ein Video von meiner Enthauptung zu drehen. Sie müssen ein anderes Motiv haben.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumberts klare Argumentation überrascht den Mann in Schwarz.")
	await novel_interface.show_text_only("Er befreit Lumbert aus seinem Würgegriff und schlägt ihm ein Blatt Papier ins Gesicht.")
	await novel_interface.show_dialog("Dann lasst uns den Ball ins Rollen bringen. Ich gebe Ihnen sechzig Sekunden Zeit, um mir zu antworten. Deal or no deal?", "Entführer")
	await novel_interface.show_text_only("Das Papier rutscht auf Lumberts Hose. Er schaut nach unten – darauf sind zwölf verschlüsselte Währungskonten und tatsächliche Preise aufgedruckt.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Hmm. Du hast ein gewisses Maß an Selbstbeherrschung. Das ist gut zu sehen.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert wirft einen Blick aus dem Fenster. Der Tag scheint anzubrechen.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Nachdem sie mich zwölf Stunden lang als Geisel gehalten hatten, begannen sie eine Verhandlung mit einem klaren Ziel vor Augen.)")
	await novel_interface.show_text_only("(Das machen nur erfahrene Entführer. Sie müssen gut ausgebildet sein...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert blickt mit zusammengekniffenen Augen auf die auf dem Blatt Papier aufgeführten Zahlen.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Wenn ich den Wechselkurs berücksichtige, scheinen diese Zahlen mit der Kaution für die Liste der Terroristen im Einklang zu stehen, die der UN-Rat kürzlich veröffentlicht hat ...", "Lumbert")
	await novel_interface.show_dialog("Du bist doch nicht vom Widerstand, oder?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumberts plötzliche Frage überrascht den Entführer.")
	await novel_interface.show_dialog("Hä?", "Entführer")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Ich begrüße Sie für Ihre Bemühungen, sich wie Terroristen zu verhalten, aber ich wette, Sie werden von Menorah von Masada Ford geschickt –", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Halt die Klappe!", "Entführer")
	await novel_interface.show_text_only("Der Mann in Schwarz marschiert zügig auf Lumbert zu, bereit, ihn niederzuschlagen.")
	await novel_interface.show_text_only("Und dieser erhebt plötzlich seine Stimme und ruft auf Hebräisch:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(Hebräisch) Bombe! Runter!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Wachmann am anderen Ende des Lagerhauses hebt instinktiv die Arme, um seinen Kopf zu bedecken, und als er erkennt, dass es sich um eine Falle handelt, greift er nach seiner Waffe und zielt auf Lumbert.")
	await novel_interface.show_text_only("Damit hatte der Mann in Schwarz sicherlich nicht gerechnet. Aber es ist offensichtlich, dass ihre Tarnung durch die reflexartigen Handlungen seines Kameraden aufgeflogen ist.")
	await novel_interface.show_text_only("Lumbert lächelt spöttisch.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Ist das also das Skript, dem Sie folgen? Ich wurde von Terroristen des Widerstands entführt, die behaupten, im Besitz von Beweisen dafür zu sein, dass der Vereinigte Kongress illegale Substanz-H-Experimente durchgeführt hat ...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert wirft noch einmal einen Blick auf die Fotos an der Wand.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Ich bin derzeit die einzige Person, die Masada Ford öffentlich seine Unterstützung für die Entwicklung automatischer Gegenangriffssysteme zu Einschüchterungszwecken zum Ausdruck gebracht hat. Es ist vernünftig, dass der Widerstand mich entführt.", "Lumbert")
	await novel_interface.show_dialog("Ich bin eine ziemlich bekannte Persönlichkeit, daher wird dies in allen Nachrichten zu finden sein. Immer mehr Menschen werden den Widerstand als verrückte Terroristen betrachten.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Und Sie können diese Fotos auch verwenden, um den Vereinigten Kongress zu zwingen, Geld in Form einer verschlüsselten Währung auszuspucken – und damit drei Fliegen mit einer Klappe zu schlagen.", "Lumbert")
	await novel_interface.show_dialog("Die Transaktion der verschlüsselten Währung ist im öffentlichen Kanal vollständig sichtbar. Sobald sie zahlen, wird es so sein, als hätten sie öffentlich zugegeben, dass sie schon einmal illegale Substanz-H-Experimente durchgeführt haben.", "Lumbert")
	await novel_interface.show_dialog("In Zukunft wird Masada Ford dies nutzen können, um die anderen Akademiestädte zu bedrohen und Ihr passives Gegensystem zu unterstützen. Niemand wird es wagen, eine Ihrer Anfragen abzulehnen.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seine Analyse ist zu 100 % korrekt. Der Mann in Schwarz erstarrt vor Schock und weiß nicht, was er tun soll.")
	await novel_interface.show_text_only("Trotz seiner Zurückhaltung hat Lumbert nun die Oberhand.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Sie haben sich dafür entschieden, bearbeitetes Nachrichtenmaterial zu verwenden, damit Sie nicht viel reden müssen und ich Ihren Akzent nicht bemerke.", "Lumbert")
	await novel_interface.show_dialog("Aber die Marke der Kamera ... die schwarze Flagge hinter mir ... diese Damaskus-Sense ... das ist übertrieben, finden Sie nicht?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert hält inne und grinst den nervösen Mann in Schwarz an.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Soweit ich das beurteilen kann, müssen Sie ehemalige Rekruten gewesen sein, die unter Menorah gearbeitet haben, bevor Sie rausgeschmissen wurden.", "Lumbert")
	await novel_interface.show_dialog("Ich habe gehört, dass selbst diejenigen, die ihre Prüfungen nicht bestanden haben, immer noch als eine Art Spezialsöldner arbeiten können, solange sie die „Ideologieüberprüfung“ bestehen.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Wegwerf-Lakaien wie Sie haben also die Aufgabe, politisch kontroverse Operationen wie diese durchzuführen. Auf diese Weise hat ein Tod ohnehin keine Auswirkungen auf sie.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Entführer")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Sie haben wahrscheinlich den strengen Befehl, mir nichts anzutun. Schließlich bin ich derzeit der einzige Unterstützer von Masada Ford.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aber hey, ich habe eine gute Gelegenheit für dich und deinen Kumpel –", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Soweit ich über die Standardzusammensetzung des Menorah-Kampftrupps weiß, sind Sie und die Wache dort drüben nicht die Einzigen im Team.", "Lumbert")
	await novel_interface.show_dialog("Außerhalb dieses Lagerhauses sollte es einen technischen Kampfangehörigen, einen schweren Feuerkraftunterstützungskämpfer und einen Scharfschützen geben. Liege ich richtig?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("fragt Lumbert den Mann in Schwarz, jedes Wort klar ausgesprochen, die Augen scharf und klug.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Teilen Sie mir mit, was Sie wissen, und ich bin damit einverstanden, so zu tun, als hätte ich nichts zu ahnen, und weiterzuspielen, indem ich Ihrem Drehbuch folge.", "Lumbert")
	await novel_interface.show_dialog("Wenn Sie das nicht tun, werden Sie diese Mission scheitern lassen. Und wer weiß, wie die Leute in Ihrer Organisation Sie bestrafen, wenn das passiert?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Äh, okay! Wir...wir arbeiten mit Ihnen zusammen!", "Entführer")
	await novel_interface.show_text_only("Der Mann in Schwarz trifft die Entscheidung sofort. Er dreht sich um und sucht nach einem Schraubenschlüssel, mit dem er Lumbert befreien kann.")
	await novel_interface.show_text_only("Plötzlich, aus dem Nichts, ertönt das Geräusch von etwas, das durch die Luft schneidet –")
	await novel_interface.show_text_only("Der Mann in Schwarz erstarrt wie versteinert.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Was –", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bevor Lumbert seine Frage beenden kann, gehen alle Lichter im Lagerhaus aus.")
	await novel_interface.show_text_only("Von draußen ertönt mehrere laute Knallgeräusche.")
	await novel_interface.show_text_only("Boom!\nAbsturz!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("Ein kräftiger Luftstoß lässt alle Fenster der alten Lagerhalle fliegen. Mehrere blendende Scheinwerfer dringen gleichzeitig in den Raum ein.")
	await novel_interface.show_dialog("Niemand bewegt sich!", "Soldat des Verteidigungsbüros")
	await novel_interface.show_text_only("Unter dem frühen Morgenhimmel strömen ein Dutzend Spezialpolizisten der Metropolitan MD herein. Sie schalten die Wachen vor dem Lagerhaus in Sekundenschnelle aus und stürmen auf Lumbert zu.")
	await novel_interface.show_text_only("Das laute Geräusch des Hubschrauberpropellers übertönt alle anderen Geräusche.")
	await novel_interface.show_text_only("Das Rettungsteam hilft Lumbert auf die Beine und schüttelt ruhig seine schmerzenden Arme und Beine.")
	await novel_interface.show_text_only("Ein Teammitglied macht ein Foto von dem, was früher der Mann in Schwarz war. Sein Körper wurde von der Taille an sauber in zwei Teile geschnitten. Mit einem dumpfen Knall rutscht die obere Hälfte zu Boden.")
	await novel_interface.show_text_only("Während die untere Hälfte – seine beiden Beine – immer noch dort steht.")
	await novel_interface.show_text_only("Die umstehenden Mitglieder des Rettungsteams starren verwirrt auf diese seltsame Leiche.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Sie waren also nicht diejenigen, die ihn getötet haben. Deshalb muss es sein...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("– Warte, die Bilder!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert dreht sich zur Wand, die zuvor mit Fotos bedeckt war. Die Fotos sind alle weg.")
	await novel_interface.show_text_only("In einer dunklen Ecke, einem toten Winkel ohne Überwachungskameras, verschwindet eine lange, blutige schwarze Haarsträhne lautlos in der Nacht ...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
