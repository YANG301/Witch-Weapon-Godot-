# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("親切な運転手さんが迎えに来てくれたようで、\nビルを出ると入り口には車が止まっていた。\n運転手さんは俺達に超小型の骨伝導イヤホンを\n2つ渡してくれる。")
	await novel_interface.show_dialog("ボスからこれを渡すように言われたんだ。", "運転手")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("ボ、ボス？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺とソヤがイヤホンを装着すると、\n愛衣の声が聞こえてきた。")
	await novel_interface.show_dialog("デモ隊の周りは騒音だらけで煩いだろうし、\n携帯通話だと聞こえないと思ってね。", "アイ")
	await novel_interface.show_dialog("協定非武装地域全体を調べてみたけど、暴動が\n発生した7つのエリアだけが黄色の街灯だった。", "アイ")
	await novel_interface.show_dialog("いずれの場所も繫華街だったから邪魔な光源が\n多すぎて、\n航空写真を見るだけじゃ問題に気付けなかったと\n思う……", "アイ")
	await novel_interface.show_dialog("回収チームはすでに出動したけど、\nどうせ君は止めても止まらないだろう？\nそれなら、レンちゃんだけは絶対に守ってね。", "アイ")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("……ソヤ、行くのか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは愛衣の話を聞くと、俺達に追随していた\nドローンに頷く。\nそして彼女はいつものように俺を引っ張って、\n人混みの中へと駆け出した。")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…………")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("……俺は引っ張られながら比較的周囲に人が\n少ない黄色の街灯へと到着する。\n7、8メートルはある街灯をじっくり見上げた。")
	await novel_interface.show_text_only("これまで受けたSIDの訓練カリキュラムに、\nフィジカル系のものはたくさんあった。\n鍛えられている身としては運動能力に関して\n全てに自信があったけど……")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("（棒のぼりだけは、0点だったな……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("助走してから棒に勢い良くジャンプをして、\nコアラのように抱きつき、\nそして毎回絶望的にゆっくりと滑り落ちる……")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("うっふっふ……♪", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは鞄の中から重そうな金属箱を取り出した。\n\n側面から見るとA4サイズぐらいの大きさで、\n厚さは大体7～8センチぐらいだろうか。")
	await novel_interface.show_text_only("空調パーツのように回転しそうな部分が、\n箱の中央で明るく銀色に目立っており、\n装飾されたピンク色の金属ラインが良く映える。")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("これ、何だと思います？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは箱の取っ手を掴み、得意げに聞いてきた。")
	await novel_interface.show_text_only("あの銀色の部分が大きな冷却ファンだとして、\nそこが帯状のライトで光って綺麗だし……\n大きさと見た目からすれば──")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("──最新型のグラボ？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤが取っ手にあるスイッチを押すと、ピンクの\n金属ラインに沿って箱がハサミのように開いた。")
	await novel_interface.show_text_only("中から次々と黒い機械パーツが弾き出されて、\n元の姿から形態を変えていく。\n最後に伸びるように出てきた長い板を含めると、\n1メートル近くにまで箱の長さが伸びた。")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("何これッ！？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("これは『審判騎士』のみ使用を許可されている、\n異質物を動力コアとした武器なのですわ！", "ソヤ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("内赦院に頼んだ、わたくしのオーダーメイド\nなのですわよ――！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("取っ手を捻じると、金属光沢で輝く無数の刃が\n箱の中から長い板に沿って波打つように現れる。")
	await novel_interface.show_text_only("刃の波は板の先端まで伝うと弧を描いて折り返し\nやがて板の縁の全てが凶悪なブレードと化した。")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("チェ、チェーンソーッ！？！？", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("似たような物ですけど、ただのチェーンソーでは\nありませんわ。\nわたくしの一番お気に入りの武器ですの♪", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは笑いながら「チェーンソー」を起動すると\n伸びたブレードが高速回転を始める。\n一見して唸り声のような爆音が響くと思ったけど\nソヤの武器は俺の予想よりも遥かに静かだ。")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("ソ、ソヤ……まさか……", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("迷いなんて一切なし……ソヤは金属の柱に向けて\nチェンソーを振り下ろした。\n瞬時に火花が飛び散り柱から引き裂かれるような\n悲鳴が聞こえてくる。")#多字问题
	await novel_interface.show_text_only("一変して騒音を生み出し始めると、付近の人々が\n引き寄せられるように見物しに集まってきた。\nついでに何故かおっさん達が興奮しながら\n横で叫んでいる。")
	await novel_interface.show_text_only("数秒後、街灯の柱からガキンッと2回鳴り響くと\nソヤは動きを止めた。")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("──────？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは光の消えた街灯を見上げた。\n\n直径20センチの柱は削られ、現在わずかな\n金属だけで辛うじて直立の状態を保っている。")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("た…………", "レン")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("倒れるぞ――――ッ！！！！", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("そうでなくては行けませんわッ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤはニヤリと笑うと、人がいない方へ向けて\n柱をぶっ叩いた。")
	await novel_interface.show_text_only("懸命に支えていた金属がとうとう抵抗を諦め、\n悲鳴の中で徐々に倒れていく。")
	await novel_interface.show_text_only("そして路面にヒビを生み出し、無数の砂利を\n跳ね返した……\nズドォーーーーーーーン！！！\n\n巨大な音と共に、街灯はアスファルトの地面に\n叩き付けられたのだ。")
	await novel_interface.show_text_only("──数秒間の沈黙。\n\nそれから見物している人々が嵐のような\n大歓声を上げた。")
	await novel_interface.show_dialog("自由万歳――ッッ！！！！\n\n平和万歳──ッッ！！！！", "デモ隊")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("もう何がどうなってるんだよッ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ともかく、そんな周りの状況は無視して街灯の\n照明部分を急いで調べに入る。\nソヤが迅速に先端の灯具と柱を切り離すと、\nドローンも地面くらいの高さまで降下した。")
	await novel_interface.show_dialog("このドローンのカメラ解像度は普通なんだ。\n\nとりあえず照明カバーを外してLEDの型番を\n見せてもらえないかな？", "アイ")
	await novel_interface.show_text_only("集まってきた人達の熱狂的な目線を避けるため、\n俺達は素早く街灯の先端を持ち去り、\n待機中のSUVの方向へ退散する。")#换行问题
	await novel_interface.show_text_only("それからソヤは愛衣の指示に従って街灯の先端を\nバラバラに解体する。\n中には超小型カメラ、照明カバー、電池、\nランプコア、安定装置が収納されていた。")
	await novel_interface.show_dialog("おかしい……パーツとLEDのシリアル番号に\n問題はないわ……", "アイ")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("それよりも──", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は取り外された照明カバーを持ちながら、\n遠くの光源へと向けてみた。")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("カバーが黄色いなら、白い光も黄色く\n見えないか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("密集した黄色い模様が照明カバーに刻まれており\n触ってみると模様に沿って起伏を感じる。\nこれは精密な加工でしか出来ない代物だ。")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("何か秘密でもありそうだけど、肉眼じゃ\n分かりにくいな……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤも照明カバーを持って光にかざしてみるが、\n首を横に振るだけだった。")
	await novel_interface.show_dialog("車内に3Dスキャン装置があるわ。\nカバーを入れて私に送信して。", "アイ")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("そんな物まで車の中にあるの！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("もちろん～～SIDの乗り物にはフルセットの\n自動武──", "アイ")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("危ないッ！！！", "ソヤ")
	await novel_interface.hide_character()
	
	# Scene 4 - 被攻击场景
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("ピカッ────！！！！")
	novel_interface.show_background("res://assets/images/bg/Soya/Beingshot.png")
	await novel_interface.show_text_only("角から眩しい白光が射出され、俺の胸元に\n直撃した。")
	await novel_interface.show_text_only("瞬時に甲高い電流音が俺の耳の横から流れ落ち、\n心臓が止まったかのようになる。")
	await novel_interface.show_text_only("突然の衝撃の中で俺の目に映ったのは……\n\nサブマシンガンを構えながら向かってくる\n黒い特殊な戦闘服を着た7、8人の襲撃者。")
	await novel_interface.show_text_only("後ろに倒れた俺を運転手のおじさんが、\n受け止めてくれた。\nそこからソヤが俺を車の反対側まで引っ張る。")
	await novel_interface.show_text_only("周囲の全てが不鮮明な色で映っているのに、\n全員の動きがスローモーションに見えるぐらい、\n俺の意識は異常にはっきりとしていた。")
	await novel_interface.show_text_only("ソヤと愛衣が俺の名前を叫んでるみたいだけど、\nその声は厚い壁に隔てられたかのようで……")
	await novel_interface.show_text_only("運転手さんは車の荷台から散弾銃を抜き出し、\n慣れた手つきで弾丸を込め、\n防弾仕様のドアを盾にしながら連中へと\n発砲している。")
	await novel_interface.show_text_only("おじさん……そんなに強かったのか……")
	await novel_interface.show_text_only("だが連中も良く訓練されている様子だ。\n\n武器や戦術を見る限り、端から俺達を\n生かして帰す気はない事が分かる。\nいくら……ソヤだとしても……")
	await novel_interface.show_text_only("気を失う……最後に覚えているのは……\n\nソヤがチェーンソーを持って……\n俺の手を握っていた事……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("そして…連続して恐怖を帯びた甲高い悲鳴が……\n聞こえた事……")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("……………………")
	
	# Scene 5 - 瑟蕾莎场景
	novel_interface.change_background("res://assets/images/bg/Soya/Backstreet.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("──中央通りから300メートル離れた場所。")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("へえ～～", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサはイヤホンで誰かと通話をしながら\n気怠そうに地面に倒れている兵士を確認し、\n彼らの服から黒い生地を切り取った。")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("こいつらただの後方支援のBチームなの？\nにしては、豪勢な装備してるわねぇ……", "テレサ")
	await novel_interface.show_dialog("生け捕り？", "テレサ")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("……あっ。", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサは自分の頭を叩いて、その場で5秒間ほど\n固まった。")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("いや……忘れてたわ……", "テレサ")
	await novel_interface.show_dialog("私のせいじゃないし！ \n\nこいつの頭が急に花火みたく爆発するもんだから\nびっくりして全員切っちゃったのよ！！", "テレサ")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("それに生け捕っても、こいつらから何の情報も\n出てこないでしょ……", "テレサ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("全員指紋を焼いてるし、両奥歯に特別な爆薬を\n詰め込んでたっぽい。\nバイタルサインが瀕死であると検知したら、\n即刻ボカァーンよ。", "テレサ")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("──まったくざけんなよぉ！", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサはイヤホンの向こう側の人物に\n文句を言い始める。")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("想像してみなさいな？\n\n背後から一撃を浴びた敵は、振り向くと私の\n女神のようなご尊顔を拝む……\nそこから楽にしてあげようと思ったのに！", "テレサ")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("頭が爆発！ 漫画かってのっ！！", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は切り取った生地で刀の血を拭うと、\n半壊している死体の顔に向けて投げ捨てた。")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("ったく、品位の欠片もないわ……", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサは青白く光る日本刀を鞘に収めた。")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("さっき急に路地からナンバープレートの無い\n武装車両が2台飛び出してったわ。\nたぶん総勢10名以上、奴らを真正面から\n止めるのは私でも無理ね。", "テレサ")
	await novel_interface.show_dialog("それでも連中から逃げ切っちゃうなんて、\nあの運転手も中々やるじゃない……", "テレサ")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("……え？ 今なんて言った？", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサはイヤホンを手で抑え、自分の聞き間違い\nでないかを確認した。")
	novel_interface.show_character("cereza","uneasy")
	await novel_interface.show_dialog("メインのAチームも全滅したって！？", "テレサ")
	await novel_interface.show_dialog("血が……隣のオフィスビルの5階の外壁まで\n飛び散っていた……？", "テレサ")#多符号
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("まさか──", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサはイヤホンの向こう側の人物から、\n状況の確認が取れた様子だ。")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("やっぱりあの子か？ \n今日あの子と接触した時に私も感じた……", "テレサ")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("ふゎーあ――", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサは気怠そうにあくびをした。")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("朝っぱらから起こされて、私は眠いのよ……", "テレサ")
	await novel_interface.show_dialog("とにかく、これで終わりって事で良いでしょう？\nあんたの欲しい情報は全部揃ったのよね？", "テレサ")
	await novel_interface.hide_character()
	
