	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("イヤホンから、自信に満ちた女性の声がする。")
	await novel_interface.show_dialog("そうだな……今回の交渉の駄賃にしては十分だ。", "女性の声")
	novel_interface.show_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("足輪には盗聴装置を備えていた。\n\nソヤの詳しい説明とお前が見つけたものを\n加えれば──", "マリル")
