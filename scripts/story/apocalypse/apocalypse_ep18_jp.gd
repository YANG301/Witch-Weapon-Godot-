	await novel_interface.show_text_only("マリルは携帯で通話をしながら、地下室の中央に\n立っていた。\n彼女は手中にある黄ばんだ写真をちらりと見る。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("ご苦労だったな、セレサ。", "マリル")
	novel_interface.change_expression("happy")
