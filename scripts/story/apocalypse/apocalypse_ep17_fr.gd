# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Elle rit, se penchant vers moi avec désinvolture, laissant finalement sa tête tomber sur mon épaule.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Merci, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Nous pourrions demander à Aya de vous examiner...\nElle est vraiment douée, tu sais ? Elle trouvera certainement un moyen...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya pose soudain son index gauche sur mes lèvres et secoue la tête. Je me calme instantanément et elle s'appuie à nouveau sur mon épaule.")
	await novel_interface.show_text_only("Nous sommes assis là ensemble, regardant simplement les événements colorés qui se déroulent tout au long du chemin. Les manifestations sont censées être bruyantes, mais nous n’entendons rien là où nous sommes. C'est paisible, apaisant.")
	await novel_interface.show_text_only("Comment devrais-je décrire cette fille...")
	await novel_interface.show_text_only("Un pionnier ? Avant-garde ? Aventurier?")
	await novel_interface.show_text_only("Ce sont tous des termes qui me sont venus à l’esprit. Mais ils ne semblent pas tout à fait exacts.")
	await novel_interface.show_text_only("Que ce soit Sonya ou nos ancêtres... ils ont dû ressentir une peur insurmontable lorsqu'ils ont quitté leur foyer familier et se sont aventurés dans l'inconnu.")
	await novel_interface.show_text_only("Ils devaient être terrifiés, mais aussi excités, impatients...")
	await novel_interface.show_text_only("Observer attentivement son environnement, choisir le meilleur chemin, dégager les ronces qui gênent...")
	await novel_interface.show_text_only("Ils étaient définitivement trop occupés pour réfléchir à l’importance de leurs actions sur la race humaine et sur l’histoire.")
	await novel_interface.show_text_only("Ces gens là-bas, qui posent et prennent des selfies dans la foule, sont ceux-là qui tentent désespérément de prouver leur propre importance, n'est-ce pas ?")
	await novel_interface.show_text_only("Ils veulent tous paraître différents. Pourtant, sans s’en rendre compte, ils se sont tous réunis pour former cet énorme monstre…")
	await novel_interface.show_text_only("En chemin, nous avons entendu un journaliste interviewer à la radio les personnes présentes au rassemblement.")
	await novel_interface.show_text_only("Le journaliste a choisi vingt-trois piétons au hasard. Parmi eux, un seul a pu indiquer l’emplacement estimé de Massada Ford sur la carte du monde.")
	await novel_interface.show_text_only("La moitié d’entre eux ne savaient même pas contre quoi exactement ils protestaient.")
	await novel_interface.show_text_only("... Alors, la signification de leur existence est-elle vraiment si importante ?")
	await novel_interface.show_text_only("Je suis ramené à la réalité par mon téléphone vibrant. Pendant que je décroche, je mets le téléphone en mode diffusion pour que Sonya puisse également entendre.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ooh, vous deux... vous vous conduisez mal, hein ?", "Aï")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Ouais ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Que faites-vous sur la Première Avenue ?\nEt si haut ? Tu regardes les gens ou quoi ?", "Aï")
	await novel_interface.show_text_only("Aya semble étonnamment inquiète. C’est alors que je remarque un drone planant en diagonale, face à nous.")
	await novel_interface.show_dialog("Je ne sais pas où est allée Mariru. Quoi qu'il en soit, je suis là pour vous faire part des résultats que nous avons obtenus après avoir analysé la batterie envoyée par Béatrice...", "Aï")
	await novel_interface.show_dialog("J'irai droit au but.", "Aï")
	await novel_interface.show_dialog("Il est confirmé que la batterie a quelque chose à voir avec la substance H. Et elle a été créée par un fabricant militaire de Massada Ford.", "Aï")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Alors... une arme Substance H ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lorsque ce liquide brillant et collant a été fabriqué, la substance H était définitivement impliquée. Nous ne pouvons pas encore être sûrs des ingrédients.", "Aï")
	await novel_interface.show_dialog("Fondamentalement, nous pouvons voir cela comme une sorte de pile à combustible. Le liquide scellé dans le boîtier de la batterie est consommé au fur et à mesure que la batterie libère de l'énergie.", "Aï")
	await novel_interface.show_dialog("Pour une raison quelconque (peut-être pour respecter le délai d'expédition ou autre), ils ont réinstallé le produit sans même effacer le numéro de série d'usine de MMI.", "Aï")
	await novel_interface.show_dialog("Même le régulateur de tension est fixé à l’extérieur, sur le boîtier de batterie.", "Aï")
	await novel_interface.show_text_only("Aya semble confuse.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Boîtier de batterie...? Régulateur de tension ?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, tu ne sais pas à quoi ça ressemble, n'est-ce pas ? Laissez-moi le décrire...", "Aï")
	await novel_interface.show_dialog("Un cylindre métallique de près de trois pouces de haut. Entièrement recouvert d'une couche isolante, sauf sur les électrodes de chaque côté. C'est comme une pile AA, mais plus grosse.", "Aï")
	await novel_interface.show_dialog("Sur son côté se trouve une planche structurée mécaniquement. Poussez-le pour l’ouvrir et vous verrez deux contacts métalliques.", "Aï")
	await novel_interface.show_dialog("Si nous appliquons une tension extrêmement basse sur les contacts, nous pouvons contrôler le niveau d’électricité libérée.", "Aï")
	await novel_interface.show_dialog("Sur le boîtier de batterie à l’extérieur, il y a un régulateur de quarante microvolts. Il est dans la position idéale pour maintenir la carte et limiter la tension appliquée aux contacts.", "Aï")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Pourquoi cela ressemble-t-il à une batterie alimentée par une batterie... ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Est-il utilisé comme source d'alimentation de secours pour une lampe de poche à énergie lumineuse ou quelque chose du genre ?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("C'est parce que ces batteries n'ont pas été conçues pour être des batteries...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya a l'air sombre.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("C'est comme... la sécurité mécanique des armes... et d'un dispositif d'allumage.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("J'essaie de calculer l'énergie contenue dans une telle batterie.", "Aï")
	await novel_interface.show_dialog("D’après ce que nous a dit la compagnie d’électricité, une telle batterie peut faire fonctionner un appareil de micro-surveillance de 6 W pendant une vingtaine de jours.", "Aï")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Cela n'a pas l'air grave...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Comment calcule-t-on la puissance ? On a appris ça en classe ? J'ai oublié...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya soupire face à mon désespoir en matière de physique.")
	await novel_interface.show_dialog("Une batterie de 2,88 KW pourrait permettre à votre téléphone portable de fonctionner pendant six mois.", "Aï")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Waouh ! Si longtemps ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ces jours-ci, je me suis habitué à utiliser Elluka pour recharger mon téléphone et ma console de jeu. Annie me gronde souvent pour ça.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Attendez... que se passe-t-il s'il n'y a pas de régulateur de tension ?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("C'est pour ça que je t'ai appelé, en fait.", "Aï")
	await novel_interface.show_dialog("J'ai découvert que dans la plage d'entrée de 1 à 500 microvolts, la puissance générée par la batterie augmente avec l'entrée. Mais quand on dépasse 500, rien ne se passe. Aucune sortie du tout.", "Aï")
	await novel_interface.show_dialog("J'ai donc augmenté la tension à 32V, et soudain cette lumière blanche aveuglante a jailli de la batterie...", "Aï")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("D’après ce que notre caméra haute vitesse a capturé, le liquide contenu dans la batterie a été consommé en moins d’une milliseconde.", "Aï")
	await novel_interface.show_dialog("L’explosion de puissance a presque incinéré le plafond de la salle d’isolement. Des traces de brûlures sillonnent tout le mur et le sol.", "Aï")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me souviens soudain que, lorsque Igor nous a attaqués au Sky Hotel, un de ses laquais a utilisé une arme électrique...")
	await novel_interface.show_text_only("Après une explosion de lumière puissante, des marques de brûlure entrecroisées se sont également répandues dans toute la pièce.")
	await novel_interface.show_dialog("Pourtant, l’arme qui avait frappé Annie à l’époque ne semblait pas être aussi puissante. Et il était programmé pour cibler une seule personne, sinon toutes les personnes présentes dans la pièce seraient mortes.", "Aï")
	await novel_interface.show_dialog("Et 32 V est en fait la tension d’excitation minimale pour les allumeurs électroniques à impulsions utilisés par l’armée de défense nationale de Massada Ford.", "Aï")
	await novel_interface.show_text_only("Aya fait une pause.")
	await novel_interface.show_dialog("L'énergie générée par une batterie de 2,88 kW est égale à celle de 5,5 livres de TNT...", "Aï")
	await novel_interface.show_dialog("Bien que les batteries ne puissent pas générer d’ondes de choc aussi destructrices que le TNT, elles peuvent néanmoins être mortelles pour tous les êtres vivants dans un rayon de 33 pieds.", "Aï")
	await novel_interface.show_dialog("Et en ce moment, nous avons une de ces choses sur chaque lampadaire de la Zone Démilitarisée Agréée...", "Aï")
	await novel_interface.show_text_only("Je halete en regardant les hordes gigantesques là-bas.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Bon sang... Igor... comment a-t-il pu...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("Attendez !", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya intervient.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Si tel est le cas, Masada Ford ne voudrait sûrement pas que ces batteries explosent, n’est-ce pas ?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("C'est vrai.", "Aï")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Les batteries ont été fabriquées dans la précipitation, les numéros de série sont encore visibles. Et un simple régulateur de tension a été ajouté comme une sorte de solution rapide...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("On dirait qu’ils étaient désespérés de répondre au grand nombre de commandes passées par le Congrès uni.", "Aï")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Si les batteries explosaient, les autorités seraient en mesure de déterminer qui les a fabriquées grâce aux numéros de série. Ce serait une décision stupide de la part de Massada.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Il s’agit en outre d’un projet de rénovation urbaine à grande échelle. D’innombrables personnes seraient impliquées dans la logistique, la mise en œuvre et la maintenance. Il serait impossible de garder secret un secret aussi mortel.", "Aï")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("C'est vrai...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Ce qui est vraiment suspect, ce sont les patients mentionnés par Béatrice.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru avait déjà alerté le centre de contrôle des maladies pour qu'il affiche un avertissement de contamination de classe quatre. Actuellement, les vingt cas sont regroupés dans la zone démilitarisée agréée.", "Aï")
	await novel_interface.show_dialog("Cependant, ces batteries n’ont aucun effet sur l’état mental des gens. Et les résultats de détection des mèmes montrent qu’ils ne contiennent pas non plus de sources d’infection de type mème…", "Aï")
	await novel_interface.show_text_only("Je baisse les yeux, sans voix. Tant de questions, mais pas de réponses.")
	await novel_interface.show_text_only("Je regarde la foule là-bas. Il y a un lampadaire tous les quarante pieds...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Attendez. Qu'est-ce que Sonya et moi avons trouvé étrange quand nous étions là-bas ?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Que les « frontières » des foules qui se mobilisent sont bien trop définies…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hum ?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Que veux-tu dire... ?", "Aï")
	await novel_interface.show_text_only("Peut-être que la réponse était sous nos yeux depuis le début. Nous ne l'avons tout simplement pas vu parce qu'il y avait trop de distractions dans la rue...")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Mariru n’a-t-elle pas dit que TOUS les systèmes d’éclairage et de surveillance des lampadaires de la ville avaient été remplacés par le Congrès uni ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ouais.", "Aï")
	await novel_interface.show_dialog("Dans ce cas, pourquoi les lampadaires sont-ils disponibles en deux couleurs ?", "Lian")
	await novel_interface.show_text_only("Sur la Première Avenue, les lampadaires brillent d’un jaune chaud, illuminant les limites claires de la foule.")
	await novel_interface.show_text_only("Pendant ce temps, dans les ruelles désertes, les lampadaires brillent de blanc.")
	await novel_interface.show_text_only("De l’autre bout du combiné, on entend le bruit d’une frappe furieuse.")
	await novel_interface.show_dialog("Je viens de vérifier. Les nouvelles ampoules qu’ils ont ajoutées doivent être des lampes LED durables avec une température de couleur de 4 500 K, elles sont donc censées paraître blanches. Je ne sais pas ce qui se passe avec les jaunes...", "Aï")
	await novel_interface.show_text_only("Sonya et moi échangeons des regards pour tenter de nous rappeler toutes les lumières que nous avons vues ces dernières heures.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Les images de la ligne de défense devant le Congrès uni que nous venons de voir étaient jaunâtres. La zone est probablement éclairée par un grand nombre de lampes jaunes.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Les lampadaires d'Electronics Street étaient aussi du type jaune, je pense...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("La rue était chaotique, pleine d’enseignes au néon éblouissantes et de panneaux d’affichage lumineux. Personne ne remarquerait les lampes jaunes.")
	await novel_interface.show_dialog("L'ambiance sur Electronics Street était effectivement un peu décalée aujourd'hui... tout le monde semblait anormalement excité.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("En revanche, les rues éclairées en blanc semblaient pour la plupart désertes.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("La rue devant le commissariat d'où nous nous sommes échappés...", "Soya")
	await novel_interface.show_dialog("Aussi...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("Cette route tranquille à l'extérieur de Newell Central Park...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Serait-ce...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Cette lumière dorée...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Hum ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De derrière la porte...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("Était-ce...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya ne prend pas la peine de finir sa phrase. Elle me prend la main et se précipite vers l’ascenseur.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
