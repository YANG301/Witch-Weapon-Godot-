# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Đoạn phim về nhiệm vụ giải cứu con tin tràn ngập các bản tin sáng sớm thứ Sáu.")
	await novel_interface.show_text_only("Vì SID đã phong tỏa mọi lối thoát trong khu vực được bao phủ bởi Aegis, những kẻ bắt cóc không còn lựa chọn nào khác ngoài việc tạm thời giữ con tin trong một nhà kho bỏ hoang.")
	await novel_interface.show_text_only("Bốn kẻ khủng bố bị tình nghi bắt cóc một quan chức cấp cao của Hội đồng Liên hợp quốc đã bị bắt giữ. Một kết thúc thỏa đáng cho sự việc này.")
	await novel_interface.show_dialog("Giết người và bắt cóc dưới ánh sáng ban ngày trên lãnh thổ quốc tế—giống như chúng đang yêu cầu gây chiến với tất cả các quốc gia thành viên của Quốc hội Thống nhất!", "Lumbert")
	await novel_interface.show_dialog("Vụ việc này là bằng chứng cho thấy chủ nghĩa khủng bố đang hoành hành xung quanh chúng ta như thế nào. Các hoạt động của Dòng chảy Không thời gian gần đây cũng có thể liên quan đến bọn khủng bố.", "Lumbert")
	await novel_interface.show_dialog("Là người sống sót sau chiến tranh, tôi tin chắc rằng đe dọa là một phương tiện quan trọng để đảm bảo an ninh và hòa bình.", "Lumbert")
	await novel_interface.show_text_only("Tôi chế giễu khi bỏ qua cuộc phỏng vấn, rõ ràng là một cuộc phỏng vấn nhảm nhí theo kịch bản, trong khi tôi nhai miếng khoai tây chiên thứ tám mươi trong một giờ.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Anh chàng này... có phải anh ta sắp chết không? (Ăn nhai)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Vâng. Không phải họ đã giải cứu anh ấy chỉ vài giờ trước sao? Và anh ấy đã có bài phát biểu rồi. Ừm. đáng ngờ...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Tuy nhiên, phần về máy bay trực thăng và đội cứu hộ khá tệ. Gần giống như một bộ phim.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mm, hay quá!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka gật đầu theo, vẻ mặt trang trọng.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Nó chủ yếu chỉ là phần chỉnh sửa xuất sắc và nhạc nền tuyệt vời. Ai lại không thích hiệu ứng điện ảnh, phải không?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Do sự kiện quan trọng được tổ chức trong thành phố nên những ngày này trường học bắt đầu khá muộn, vào khoảng 10 giờ 30. Chúng tôi cũng tan học sớm hơn nhiều.")
	await novel_interface.show_text_only("Annie, Elluka và tôi đều cuộn tròn trên ghế như những chú chuột hamster nhỏ, chia sẻ khoai tây chiên (giống như Annie đã lấy trộm chúng từ tôi hơn).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Chẳng phải thông tin tình báo từ SID là lý do chính khiến cuộc giải cứu thành công sao?\nTin tức thậm chí còn không ghi nhận chúng tôi...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Rốt cuộc thì các cơ quan tình báo cần phải ẩn danh để tồn tại. Phải bay dưới radar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Cô Ren...\nMuốn sô cô la...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cái đầu nhỏ của Elluka đột nhiên thò ra giữa Annie và tôi.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Sô cô la Pocky?\nCửa hàng tiện lợi ở tầng dưới có vẻ đã hết hàng. Chúng tôi đã mua tất cả.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tôi sẽ lấy thêm cho bạn lần sau khi chúng ta đi siêu thị.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Nhưng... tôi muốn nó... bây giờ...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka bĩu môi, lắc chiếc hộp trống trước mặt tôi, môi dưới run run.")
	await novel_interface.show_text_only("Nhưng bây giờ trời quá nóng để ra ngoài. Tất cả những gì tôi muốn là ở trong nhà, tận hưởng điều hòa và trở thành một củ khoai tây.")
	await novel_interface.show_text_only("Mariru dạo này bận quá. Rốt cuộc, hàng tấn nhân vật quan trọng đã đến Khu phi quân sự đã được thỏa thuận để tham dự Diễn đàn hòa bình quốc tế lần thứ tư.")
	await novel_interface.show_text_only("Quy mô của Diễn đàn năm nay thực sự ấn tượng. Năm Thành phố Học viện ngoài New Opulentia đều cử hàng trăm đại diện đến.")
	await novel_interface.show_text_only("Một hội nghị lãnh đạo chính phủ cấp cao nhất sắp bắt đầu. Đương nhiên, nó đã gây ra rất nhiều vấn đề trong cuộc sống hàng ngày của người dân.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Nhiều khu vực trong thành phố hiện là khu vực tạm thời cấm xe đạp. Thực sự bất tiện cho chúng tôi khi đặt hàng giao hàng.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie phàn nàn trong khi lướt điện thoại, nằm dài trên ghế một cách lộn xộn.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Được rồi, được rồi, tôi sẽ đi lấy đồ ăn nhẹ cho các cậu.\nAnnie, bạn có cần tôi mang gì không?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Hehe...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Hai người họ nhanh chóng liệt kê hàng tá món đồ, trông họ có vẻ hoàn toàn tự mãn.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Tại sao nó lại nóng như vậy?", "Lian")
	await novel_interface.show_dialog("Tôi đang tan chảy...", "Lian")
	await novel_interface.show_text_only("Trời vẫn còn sớm, siêu thị mới mở cửa nhưng ngoài trời đã oi bức.")
	await novel_interface.show_text_only("Tôi lê bước, mang theo một túi đồ ăn vặt khổng lồ. Có vẻ như có rất nhiều nhân viên an ninh xuất hiện trên đường phố những ngày này.")
	await novel_interface.show_text_only("Nhiều khu vực hạn chế vận chuyển đã được thiết lập. Người dân phải luôn mang theo CMND.")
	await novel_interface.show_text_only("Xe cảnh sát và trợ lý an ninh có thể được tìm thấy ở mọi trạm giao thông công cộng.")
	await novel_interface.show_text_only("Giao thông vận tải hầu hết bị hạn chế trong Khu phi quân sự đã thỏa thuận. Các thiết bị giám sát hoàn toàn mới đã được gắn trên tất cả các đèn đường trên đường phố chính.")
	await novel_interface.show_text_only("Tôi nghe nói rằng, vì thành phố không có đủ lính an ninh nên Quốc hội Thống nhất phải thuê tất cả lính đánh thuê mà Ritnalap cung cấp.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Tuy nhiên, tôi đoán việc cảnh giác là điều dễ hiểu...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn xuống từ ngã tư trên cao và thấy một nhóm người tuần hành đi ngang qua. Một người quay phim từ một kênh tin tức nào đó đang đi theo họ, quay phim đám rước.")
	await novel_interface.show_text_only("Chưa được bao lâu kể từ khi chiến tranh kết thúc. Đương nhiên, tất cả các loại tổ chức, nhóm và kênh truyền thông sẽ rất vui mừng khi tìm được khán giả ở New Opulentia trong một sự kiện quan trọng như vậy.")
	await novel_interface.show_text_only("Tất cả các tổ chức đều có những mục tiêu khác nhau - xung đột khu vực, vấn đề chủng tộc, vấn đề người tị nạn, áp bức tôn giáo, các vấn đề kinh tế... bạn có thể đặt tên cho nó, có một tổ chức đang la hét về điều đó.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Thậm chí có những nhóm truyền giáo ở đây đang tìm kiếm tín đồ mới. Họ không thể chọn một khoảng thời gian ít hỗn loạn hơn để làm điều đó sao?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theo những gì Mariru nói với tôi, ba Diễn đàn Hòa bình Quốc tế vừa qua cũng không diễn ra suôn sẻ cho lắm.")
	await novel_interface.show_text_only("Lần trước sẽ được tổ chức ở Masada Ford, nhưng họ phải chuyển đến Salmonton do thường xuyên xảy ra các cuộc tấn công khủng bố ở biên giới.")
	await novel_interface.show_text_only("Sau đó, Tiến sĩ Deckers bất ngờ tuyên bố trên Diễn đàn năm ngoái rằng Salmonton giờ đây sẽ mở cửa đón tất cả những người tị nạn. Tất nhiên, điều đó đã dẫn đến rất nhiều tiếng la hét và bạo loạn.")
	await novel_interface.show_text_only("Raphilia sau đó đã đưa ra một nhận xét không chính xác về mặt chính trị, đó là lý do tại sao gia đình cô lại gửi cô đến New Opulentia.")
	await novel_interface.show_text_only("Như năm trước đó... bọn khủng bố đã đánh bom cả một khu nhà ở Newmoridas. Thậm chí còn gửi trực thăng quân sự.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Điều đó hẳn là khủng khiếp...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Hai ngày trước, Skuld được mời tham dự một sự kiện từ thiện ở khu vực đại sứ quán và quyên góp hào phóng cho trẻ em đang chết đói ở Nam Mỹ.")
	await novel_interface.show_text_only("Thật trùng hợp, một tổ chức thuần chay đến từ Châu Âu tình cờ phản đối việc giết mổ động vật bên ngoài địa điểm.")
	await novel_interface.show_text_only("Một số người trong số họ cởi đồ và nằm trên mặt đất, mô phỏng những miếng bít tết.")
	await novel_interface.show_text_only("Chúng tôi đã xem một người giúp việc đổ một nồi nước sốt màu tía, có cả xúc tu mực, lên miếng “bít tết” được phát sóng trực tiếp trên TV.")
	await novel_interface.show_text_only("Con “bít tết” xui xẻo bò đi bằng bốn chân, kêu ù ù đến tận phổi.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("Và hôm nay, trang web chính thức của tổ chức đã đăng một tuyên bố, khẳng định rằng các thành viên của họ đã bị tổn thương nặng nề.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Hahaha...\n(Tôi hy vọng Fabella nhận ra việc nấu ăn của cô ấy tệ đến mức nào!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên, điện thoại trong túi tôi rung lên.\nMariru đã gửi một tin nhắn.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Ừm. Hôm nay báo cáo ở trụ sở phải không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Mười giờ trước>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, phòng điều khiển SID>")
	await novel_interface.show_text_only("Một người phụ nữ tóc đỏ trong bộ quân phục đứng khoanh tay trước ngực, nhìn chằm chằm vào hàng chục dấu ngoặc đỏ đang di chuyển nhanh chóng trên màn hình đen trắng.")
	await novel_interface.show_text_only("Một cửa sổ trò chuyện đột nhiên bật lên từ phần dưới của màn hình.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Sếp, theo hồ sơ của chúng tôi, con tin Ngài Lumbert vẫn đang ở đâu đó được Aegis bao phủ.", "Đại lý SID")
	await novel_interface.show_dialog("Phân tích quay lại giám sát của chúng tôi cho chúng tôi biết rằng kẻ bắt cóc rất có thể ở một trong ba khu vực này. Một nhà kho bỏ hoang ở Vùng Vịnh đang có hoạt động tiêu thụ điện bất thường...", "Đại lý SID")
	await novel_interface.show_dialog("Chúng ta có nên thông báo cho Cục Quốc phòng không?", "Đại lý SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Chưa. Bao vây khu vực và chờ lệnh của tôi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Roger đó.", "Đại lý SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đóng cửa sổ lại, Mariru chuyển sang kênh trò chuyện quân sự.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Vùng núi phía trước. Giữ trực thăng ở độ cao an toàn, đừng để họ phát hiện ra chúng ta.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hiểu rồi. Chúng tôi đã có được hình ảnh rõ nét từ vệ tinh cảm nhận nhiệt.", "Người lính A")
	await novel_interface.show_dialog("Họ di chuyển rất nhanh... đó có thực sự là con người không?", "Người lính A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Về mặt kỹ thuật, họ đã từng là con người. Chỉ là không còn nữa.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Mọi người ở hướng họ đang tới đã được sơ tán chưa? Nếu có điều gì đó bất thường xảy ra—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đại bác và vũ khí hủy diệt khu vực của chúng tôi đã sẵn sàng.", "Người lính B")
	await novel_interface.show_text_only("Mariru gật đầu. Cô ấy không muốn tiết lộ quá nhiều cho quân đội.")
	await novel_interface.show_text_only("Hơn nữa, cô ấy đã có linh cảm xấu về chuyện này kể từ khi bắt đầu nhiệm vụ theo dõi này…")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Chúng tôi thường đối phó với những “phù thủy” xuất hiện bên ngoài trung tâm thành phố New Opulentia bằng cách tiêu diệt chúng bằng vũ khí hạng nặng mà quân đội đã bố trí trước trong khu vực.)", "Mariru")
	await novel_interface.show_dialog("(Theo kinh nghiệm trong quá khứ, những thứ đó thường tấn công ngẫu nhiên những sinh vật hoặc cơ sở gần đó sau khi kén phù thủy của chúng biến mất.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Nhưng trong suốt hai tuần qua, họ dường như đang thể hiện một kiểu mẫu giống hệt nhau...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đợi đã... có ai đó ở phía trước!", "Người lính A")
	await novel_interface.show_dialog("Mang theo cả cưa máy nữa. Có lẽ là một người tiều phu?", "Người lính B")
	novel_interface.show_character("liliu_uniform1","angry")
