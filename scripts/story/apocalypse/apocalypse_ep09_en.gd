# apocalypse_ep09.gd - 天启篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第09话剧本
	apocalypse_ep09_script()

func play_script():
	pass

# 天启篇第09话 - 正式剧本
func apocalypse_ep09_script():
	# scene1 - 拘留室越狱
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Cells.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("I stare at the needle in confusion, then remember the keyhole on the metal door.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("You want to use it to pick the lock or something?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I don’t think that’ll work. Those locks probably don’t give easily, and besides there are at least four security cameras in the room.")
	await novel_interface.show_text_only("Sonya doesn’t reply. She skips cheerfully to a muscular man leaning against the wall, and studies his face with the eyes of a curious little girl.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Huh?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Uh, there’s something on your face...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya explains, pointing at her own face, expression sweet and innocent.")
	await novel_interface.show_text_only("The man blinks, confused, and attempts to wipe at his face.")
	await novel_interface.show_text_only("The silver-haired girl shakes her head and beams, reaching out as if to help the man. This seems to embarrass him a little judging from the shy grin that appears on his face.")
	await novel_interface.show_text_only("She leans forward—and swiftly slaps the button-needle into the muscular man’s thigh.")
	await novel_interface.show_text_only("He screams, tries to stand up, but is paralyzed in place. His wide-open mouth can no longer utter a word.")
	await novel_interface.show_text_only("Sonya has the audacity to look terrified and helpless. She squeals:")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("H-help! Something’s wrong with him! Look!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She leans onto the man, causing his body to topple to a side, and she uses the distraction to easily retrieve her button.")
	await novel_interface.show_text_only("The man’s body is all rigid now, lying stiffly on the cold ground. The temporary detention room descends into chaos.")
	await novel_interface.show_text_only("Two delinquents poke their heads over to see what’s the matter, while the skimpily-dressed ladies hold back, screaming.")
	await novel_interface.show_text_only("Sonya drags me away from the commotion to the wall near the barrier, so that my back is facing the gate.")
	await novel_interface.show_text_only("We exchange a glance—")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("(What did you do?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("(Hehehe...)", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Very soon, three cops rush in. Two of them check the muscular man while another stands on guard outside the door.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Someone’s watching the door, eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya smirks and hooks her foot around mine, then shoves me on the belly—")
	await novel_interface.show_dialog("(Huh?)", "Lian")
	await novel_interface.show_text_only("Noticing that I’m about to fall, the cop at the door reflexively reaches out to catch me.")
	await novel_interface.show_text_only("I try to thank him, but he’s already crumpled to the ground unconscious, for Sonya has taken the opportunity to karate-chop him on the neck.")
	await novel_interface.show_text_only("Apologizing hard inside my head, I join Sonya in placing the poor dude on the bench by the door of the detention room.")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("(I’m so sorry! I’m really really sorry!)\n(But what matters the most now is to find Elluka!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("The two of us sneak quietly out of the detention room.")
	await novel_interface.show_text_only("Sonya presses the fire alarm at the corner, then sprints to the cubicles, yelling “the prisoners are rioting”, thus attracting the attention of most of the police officers.")
	await novel_interface.show_dialog("(Seems like this isn’t the first time she did this!)", "Lian")
	
	# scene2 - 逃出警局
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("When we finally leave the police station safely, it’s already dark outside.")
	await novel_interface.show_text_only("Sonya pulls me across the street. I turn back to glimpse at the police station, concealed behind the street lamp’s blinding white light, sirens blaring.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("They’ve probably noticed we’ve escaped...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We’re on international territory, and I’m not immune to laws like Sonya. If the security soldiers find me...")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("(Assault of police officers, jailbreaking, destruction of public assets...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No matter how I see it, I’ll end up behind bars, dressed in striped prison gowns and wallowing in self-pity...")
	await novel_interface.show_dialog("Hey, you, what are you doing over there?", "Security Guard")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A patrolling police officer approaches me. Only then do I notice that heartless Sonya has disappeared into the shadows.")
	await novel_interface.show_text_only("The security police gives me a once-over, eyes narrowed.")
	await novel_interface.show_dialog("They’re getting younger, huh...\nShow me your ID!", "Security Guard")
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("(He must think that I’m one of those—)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hesitate, hoping for Sonya to appear and take him down for me...")
	await novel_interface.show_text_only("But she doesn’t seem interested in helping.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Um...\nActually...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All I can do is to slap on my cutest face, fingers clutching the hem of my skirt, fear and distress evident in my shaking voice.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("I... I’m here shopping with my classmates... but I got lost...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I begin to fake-sob, trying to make myself seem as harmless as possible.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("If... if I don’t get home soon... Mommy will worry...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Still, if I return without Elluka, Mariru will definitely kill me!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The cop certainly hasn’t expected this. He stares, jaw tight, and swallows.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("(What the heck am I doing?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, the security police jerks forward, as if stung by something on the back. He crumples into a heap, revealing Sonya standing proud behind him.")
	await novel_interface.show_text_only("She retrieves her button-needle from his back and imitates my voice:")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("If... if I don’t get home soon... Mommy will worry...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("Why didn’t you help sooner? Geez!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("And how many cops have we paralyzed today? If they catch us—", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("If they catch us, you can just say I kidnapped you and forced you into this. They can’t do anything to me anyway.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya says, easily pinning her button back in place on her cape.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("What’s on the needle?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("Well... it’s puffer fish toxin extract. Paralyzes muscles, but won’t affect the heart and aspiration system.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya explains, looking quite proud.")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("While the effects last, the poisoned target can’t move nor speak, but they can still think and feel everything that’s going on.", "Soya")
	novel_interface.change_expression("relieve")
	await novel_interface.show_dialog("A perfect time to do whatever you want with them!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Why does she look so excited?")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Shouldn’t Mariru have confiscated such a dangerous item?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Tch, she sent someone even more dangerous to watch over me, didn’t she?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Oh... Elluka...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s getting late. I can’t help being worried knowing that little Elluka is roaming the streets alone.")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("Should we check Electronics Street? Seems that there’s a commotion over there.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya trains her gaze on the neon-lit street in a distance, where the auras of the gathering crowds seem to shine in an abnormal color.")
	await novel_interface.hide_background()
	novel_interface.change_music("")
	await novel_interface.show_text_only("<Meanwhile, inside the Agreed Demilitarized Zone>")
	await novel_interface.show_text_only("<Sky Hotel>")
	
	# scene3 - 天空酒店对话
	novel_interface.show_background("res://assets/images/bg/SkyHotel/Soya_Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("An elderly man in white priest robes arrives in the lounge. He tells his two young attendants to wait at the entrance.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("You must be tired from traveling all the way from Chennai. Here, let me congratulate you on your promotion, Archbishop Miller from the Anglican Church of Southern India.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Ah, Lumbert. I’m sure you already know all about what happened today...", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The overweight archbishop sighs as he eases himself into a chair.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("I already voiced my support for the Third Academy City some time ago—", "Lumbert")
	novel_interface.change_expression("usually")
	await novel_interface.show_dialog("But I certainly didn’t expect them to make an announcement about the passive riposte system at this time point. And the speaker committed suicide immediately after...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Perhaps “certain people” want the news to be out during the closed meeting?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("We can’t be sure if there’s someone behind all this yet, but as far as I know this is not Prime Minister Scheinermann’s idea.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Even if we disregard the unfortunate timing of the announcement, the fact that this system has been built already means a lot of things. I’m sure you understand, eh?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("That’s what’s brought me to see you today—", "Lumbert")
	novel_interface.change_expression("usually")
	await novel_interface.show_dialog("They willingly gave up access to military-grade Substance H and instead applied it to a passive riposte system which the country itself has no control over...", "Lumbert")
	await novel_interface.show_dialog("That, along with the current financial situation of Masada Ford, tells us...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("This country must have really gotten tired of war now.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("It’s their own fault the Resistance existed in the first place.", "Miller")#文字错误
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Archbishop Miller shakes his head with a snort.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Still, if Prime Minister Scheinermann orders a disarmament, the range Masada Ford has control over will decrease in size. In that case, they’ll probably no longer hold power over the Sinai Peninsula.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("That’s not ideal, is it?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("You mean... they’ll lose the Suez Canal?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("I’m sure neither Dr. Deckers nor His Holiness would be willing to yield the Canal to someone else.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert smiles, leaning back into the chair.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("I’m hoping to find a transportation method that will continue to be safe and reliable, so that Masada Ford will have enough resources and power to maintain peace in Western Asia.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Archbishop Miller nods silently.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("With the current international agreement, Africa and South America are the only places Masada Ford can export their “national defense solutions”.", "Lumbert")
	await novel_interface.show_dialog("Meanwhile, member nations of the United Congress and their subordinate areas are not allowed to buy from them. The lack of income makes it hard to keep the Masada Ford defense army running.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("But if mule-headed Scheinermann really decides on disarmament...", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("He’s already old—", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert interrupts.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("But his son and nephews still hold positions in the defense army.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert pauses deliberately, and Miller breaks the silence after a bit of thinking.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Scheinermann has already promised a new election after he resigns from his post. I’m sure you know that.", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert raises his glass and gazes at the swaying bamboo shadows on the lounge wall. There aren’t actually any bamboos here—it’s simply an effect created by the lights.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("One cannot hold power without winning the trust of the public. And to win their trust, you’ll have to first win their hearts.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("“Security” and “sense of security” are very much like actual bamboos and these fake bamboo shadows on the wall.", "Lumbert")
	await novel_interface.show_dialog("The public often gives up “real security” just to gain a “sense of security”. They like to feel safe, and if they have to sacrifice actual defense measures to feel safe, then so be it.", "Lumbert")
	await novel_interface.show_dialog("All I’m hoping for is that Salmonton and the Church would be willing to show support to the next Prime Minister of Masada Ford.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("After all—", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("We’re the ones who invented elections.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert raises his glass towards Miller, and downs his drink in one gulp.")

	print("=== 天启篇第09话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
