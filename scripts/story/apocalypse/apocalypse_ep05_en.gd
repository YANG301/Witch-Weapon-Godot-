# apocalypse_ep05.gd - 天启篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第05话剧本
	apocalypse_ep05_script()

func play_script():
	pass

# 天启篇第05话 - 正式剧本
func apocalypse_ep05_script():
	# scene1 - 盲点序章
	novel_interface.show_background("res://assets/images/bg/Soya/Blindspot.png")
	await novel_interface.show_text_only("A blind spot is the spot where arteries, veins and nerves crisscross on the retina. There are no light-sensing cells in this section and therefore visual stimulations can’t trigger it.")
	await novel_interface.show_text_only("However, we can’t tell where the blind spot is when we’re looking at something, because the brain automatically fills in what’s missing.")
	await novel_interface.show_text_only("That’s how our brain works. It does all it can to make every situation seem reasonable.")
	await novel_interface.show_text_only("Therefore, a lot of people believe that what feels natural to them must be indisputably correct.")
	await novel_interface.show_text_only("But is it really?")
	await novel_interface.show_text_only("In history, there was a person who didn’t realize he was blind until he was seven.")
	await novel_interface.show_text_only("Those born without hearing would think the world was silent if no one told them otherwise.")
	await novel_interface.show_text_only("If an abnormal occurrence has somehow become the default, we’ll accept it as it is.")
	await novel_interface.show_text_only("And we’ll never learn the truth until we’re one day forced to face the contradictions in front of our eyes.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("In that case... it’s possible that there’s an innate flaw all humans are born with. But since it’s the default for everyone, no one ever questions it...")
	novel_interface.show_background("res://assets/images/bg/Soya/Doomsday1.png")
	await novel_interface.show_text_only("Until, one day...")
	await novel_interface.show_text_only("They’re forced to face the contradictions right in front of their eyes...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	
	# scene2 - 美术馆继续
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("I’m still trying to come to terms with the news that shook the world.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(It’s really serious, of course, I just don’t know what to think...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Even if New Opulentia survives the first round of the nuclear attacks, the people would still have to deal with nuclear pollution, environmental issues and famine. All fatal.")
	await novel_interface.show_text_only("“An XK-class apocalypse leaves no survivors.”")
	await novel_interface.show_text_only("This is a quote often heard in the news these days. It was also the basis on which the United Congress was able to end the war and maintain peace.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("An indiscriminate nuclear counterattack system isn’t really anything new. Someone already designed something like that during the Cold War.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wow, so long ago?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("It’s just that people rarely mention it.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("You know why?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I don’t even try to answer, I know I’m hopeless at history. So I simply sit there and smile politely while Raphilia glares at me.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("The reason was that the high-ups in all countries had this silent agreement: it wouldn’t do to publicly announce the existence of this kind of thing.", "Raphael")
	await novel_interface.show_dialog("This has always been a taboo topic no matter in countries with strict censorship or those big on freedom of the press.", "Raphael")
	await novel_interface.hide_character()
	
	# 背景切换
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("When the United Congress was first established and war ended, the public thought it was for “the future of mankind and civilization”.")
	await novel_interface.show_text_only("As for the XK-class Substance H—no one ever talks about it, even though it was what actually ended the war.")
	await novel_interface.show_text_only("To inspire trust in the general public, the Council launched a project called the “New Revolving Door” in the end-of-war broadcast.")
	await novel_interface.show_text_only("A project in which the six member nations had unanimously agreed to name their capitals “Academy Cities”.")
	
	novel_interface.change_background("res://assets/images/bg/Soya/Guidepost.png")
	await novel_interface.show_text_only("The movement affected a lot of things. Governments were reformed, new currency and new national debts were issued, airports and landmarks were renamed, and road signs had to be replaced on a wide scale.")
	await novel_interface.show_text_only("Technically, it was just a simple change of names. But the credit system in each of these countries still bounced back miraculously from the war within a couple months.")
	await novel_interface.show_text_only("Even listed companies began applying for name changes—as long as the company name had something to do with “Academy City”, the stocks would shoot straight up.")
	novel_interface.change_background("res://assets/images/bg/Soya/galleries.png")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Because the term “Academy City” stood for a bright, happy future—", "Raphael")
	await novel_interface.show_dialog("And humans all need something they could trust in, something that represents their hopes and dreams.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("It’s like guys and their... “wands”, right?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Hmm?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia lifts a hand, looking very ready to rip Sonya to pieces.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Indeed, this public announcement must have been under planning for quite a while.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Usually something like this would simply be announced in a closed meeting among high-ups.")
	await novel_interface.show_text_only("The smaller non-participant nations and even terrorists would be able to get a hold of information like this anyway.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("And right now, all officials in the six countries with enough power to forbid the media from spreading the news are holding a closed meeting.", "Raphael")
	await novel_interface.show_dialog("The media channels all over the world, naturally, would want to milk this shocking news as much as possible in order to get the most followers and traffic.", "Raphael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("They’ll be spreading panic and chaos all across the globe, unbridled...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia glances at the crowds outside, brows furrowed.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Is this place... usually this crowded?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("This is a street heavily geared towards a certain niche group of customers and has nothing to do with politics at all—but it’s true that it’s indeed more crowded than normal.")
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Well, I don’t think there’s anything to worry about.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya gazes out of the glass wall of the second-floor lobby where we’re currently located and confirms.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("These people’s auras look nice. They’re not in angry colors. Some do smell smoky and anxious, but that can easily be because they’re surrounded by too many people.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("So that’s what the “synesthesia” in your profile means?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Guess so.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Well, then, tell us: what are our auras like?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia leans closer, curious.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hm... You’re a bit of a contradictory one.", "Soya")
	await novel_interface.show_dialog("You smell like a country road after the rain, and you feel... warm. Even when you have negative emotions, the rain washes it all away instantly.", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","perspire1",0.25)
	await novel_interface.show_dialog("(... So that’s why Sonya wasn’t able to dodge when Raphilia hit her? Because she no longer smelled her fury?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya cocks her head to one side, looking confused.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Usually, people who smell like this are gentle and soothing, but you’re violent and cranky and—", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("If I were the one with synesthesia, I bet I would see raging flames above Raphilia’s head this very moment.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Uh, I mean, smells don’t lie so you must be sweet and forgiving and kind and benevolent and non-violent, right?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya quickly attempts to amend, and changes the subject.")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Ahem, anyway, Ren... she has the purest color I’ve ever seen!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Breathe?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Oh?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia raises an eyebrow, curiosity prompting her to put her anger aside.")#文字错误
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("For example, when we were having parfaits in the dessert shop, with every bite she took, I could hear her squeal “Eeeee! Yummy!” from deep inside her heart.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Aw, really?\n(That’s so embarrassing!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("She doesn’t take the next bite until she finishes squealing. It’s really interesting to watch.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ha, an idiot indeed.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("As for Elluka, she’s like a hamster. She just eats and eats.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Ehehe!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka giggles, as if Sonya were praising her.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("When Ren sees a cute girl on the street, she starts glowing in pink. She tries her best not to stare, but her eyeballs always betray her...", "Soya")
	await novel_interface.show_dialog("She sometimes pretends to stare far into the distance behind the girl and then twists her head in another direction in hopes that she’ll seem less like a creep.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("I knew it, she’s totally stalker material.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia shoots me a glare.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Aw, come on...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I thought I was doing a good job concealing my staring... did she have to observe me so carefully?")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("When Ren sees pretty clothes, her aura sports two different, clashing colors. Usually the pink side wins, though.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oh?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia gives me a once-over, her gaze eventually landing on my legs.")
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("(I’m innocent! I really don’t know a thing!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("By the way, if she tones down her aura as if she wants to just disappear, it means she needs to adjust her bra strap or fishnet stockings.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","hungry")
	await novel_interface.show_dialog("Ah, good observation!", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("That’s right!", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka and Sonya seem to be having the time of their lives, which makes Sonya even happier to tell them more.")#文字错误
	await novel_interface.show_text_only("This is it. I can’t stay here and listen to this slander...")
	await novel_interface.show_text_only("I hold my breath, backs up—")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ah, right, when Ren wants to go to the toilet, she—", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before Sonya can finish her sentence, the indicator light on her anklet starts blinking.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Huh?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("There’s a click, then a graceful light-blue arc flashes past the art gallery lobby window.")
	await novel_interface.show_text_only("The silver-haired girl collapses to the ground, a waft of white smoke drifting up from her body.")
	await novel_interface.show_text_only("Elluka kneels beside her and pokes at her motionless form, face all innocent. Raphilia should immediately be able to tell that Elluka didn’t do it.")
	await novel_interface.show_text_only("When the blond girl finally remembers that I exist, I’ve already reached the stairs.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Sorry, this is the only way I can shut her up!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bam!")
	await novel_interface.show_text_only("In my rush to get away, I crash straight into someone.")
	await novel_interface.show_text_only("Instead of being knocked over, that “someone” gently helps me up, supporting my weight with her... assets.")
	novel_interface.show_character("ren_fishnet","timid")
	await novel_interface.show_dialog("(They’re... so springy!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Watch it, little one.", "Black-haired Woman")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The raven-haired lady tuts at me, then yawns.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Uh, s-sorry...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She’s holding a Japanese katana with an intricate hilt and an artistically designed blade.")#文字错误
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("You’re Ren, aren’t you?", "Black-haired Woman")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("What an adorable little face!", "Black-haired Woman")
	await novel_interface.hide_character()

	print("=== 天启篇第05话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
