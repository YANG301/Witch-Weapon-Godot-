# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Aprendemos todos os tipos de virtudes pelas quais viver.")
	await novel_interface.show_text_only("Tenho certeza de que a maioria de nós já leu essa história sobre Marie Curie e suas extraordinárias habilidades de concentração.")
	await novel_interface.show_text_only("Ela estava estudando e sua irmã e colegas de classe fizeram uma pegadinha. Eles empilharam várias cadeiras atrás dela. Se ela se movesse, toda a pilha desabaria.")
	await novel_interface.show_text_only("Mas a pilha permaneceu no lugar até Marie Curie terminar de ler o livro inteiro.")
	await novel_interface.show_text_only("Seu grande foco foi o que lhe permitiu se tornar a primeira cientista a receber o Prêmio Nobel duas vezes.")
	await novel_interface.show_text_only("Mas esta pergunta pode ter ocorrido a você:")
	await novel_interface.show_text_only("\"Todos sentem o mesmo em relação ao mesmo assunto? Desde que nasceram?\"")
	await novel_interface.show_text_only("Algumas pessoas nascem com a capacidade de absorver conhecimento sem parar e mal precisam dormir.")
	await novel_interface.show_text_only("Eles podem memorizar muitas informações e permanecer concentrados por muito tempo.")
	await novel_interface.show_text_only("É fácil para eles. Mas para muitos outros, é quase impossível.")
	await novel_interface.show_text_only("Talvez, para Marie Curie, ler livros de física seja mais fácil do que ler mangás.")
	await novel_interface.show_text_only("Assim, lutar pelas mesmas “virtudes”, para a maioria das pessoas, é como lutar contra as características genéticas com as quais nasceram.")
	await novel_interface.show_text_only("Talvez você não tenha considerado essa questão antes?")
	await novel_interface.show_text_only("Mas agora você tem. A semente foi plantada em sua cabeça.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Então...")
	await novel_interface.show_text_only("Na próxima vez que você se fizer essa pergunta, de quem será a voz que a fará?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Clique.")
	await novel_interface.show_text_only("O som de uma arma de fogo sendo carregada.")
	await novel_interface.show_text_only("Após a sequência de abertura do NTBC News, vem a voz familiar da locutora.")
	await novel_interface.show_dialog("“O quarto Fórum Internacional Anual da Paz será realizado na Zona Desmilitarizada Acordada em Nova Opulência dentro de três dias.”", "Notícias")
	await novel_interface.show_dialog("“Como a cidade neutra com o maior sistema de pesquisa científica, Nova Opulentia receberá visitantes das outras cinco Cidades Acadêmicas esta semana.”", "Notícias")
	await novel_interface.show_dialog("“O Fórum da Paz deste ano será centrado no desenvolvimento da Substância H como recurso energético, no Projeto de Reconstrução e em outras questões importantes.”", "Notícias")
	await novel_interface.show_dialog("“O Presidente de Masada Ford declarou num recente discurso informal que a cidade publicará em breve um novo conjunto de planos militares, a fim de restabelecer a ordem no Médio Oriente.”", "Notícias")
	await novel_interface.show_dialog("“O representante do Departamento de Notícias de Salmonton se recusou a comentar sobre este assunto.”", "Notícias")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("No antigo armazém, a luminária mal iluminada do teto está pendurada, emitindo pequenos sons crepitantes de eletricidade.")
	await novel_interface.show_text_only("De um lado, um homem de cabelos grisalhos está sentado sob a forte luz branca.")
	await novel_interface.show_text_only("Ele está amarrado a uma cadeira resistente cujas pernas foram soldadas ao chão.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("O homem ainda está se adaptando à luminosidade ao seu redor, pois o saco que carregava sobre sua cabeça acabara de ser arrancado. Os ásperos fios de reforço do navio roçam em seu caro traje personalizado, deixando pontas ásperas e desgastadas.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebendo o som de uma arma de fogo sendo engatilhada, ele levanta lentamente a cabeça.")
	await novel_interface.show_text_only("Bem na frente dele, uma câmera está montada. E ao lado dele, um sequestrador com máscara preta está de pé, apontando para ele com uma arma.")
	await novel_interface.show_text_only("O homem tenta desesperadamente olhar em volta. Ele avista um guarda no outro extremo do armazém, segurando um rifle de assalto.")
	await novel_interface.show_text_only("Pela bandana preta cobrindo seus rostos e pelas roupas camufladas, fica bastante óbvio de onde esses caras são.")
	await novel_interface.show_text_only("O homem de cabelos prateados se vira com o melhor de sua capacidade. Na periferia de sua visão, ele vê uma bandeira negra...")
	await novel_interface.show_text_only("Na câmera de vídeo à sua frente está montado um celular que reproduz as notícias no volume mais alto.")
	await novel_interface.show_dialog("“Sir Lumbert, secretário executivo da Organização do Tratado de Proibição de Experimentos de Armas com Substância H, deu uma entrevista coletiva hoje.”", "Notícias")
	await novel_interface.show_dialog("\"A organização desempenha um papel importante para evitar que a Substância H seja transformada em arma. Ela foi estabelecida com base no Tratado Universal de Proibição de Experimentos com Armas com Substância H.\"", "Notícias")
	await novel_interface.show_dialog("“Sir Lumbert afirma que a organização estabeleceu atualmente um grande número de estações de monitoramento em todo o mundo, a fim de supervisionar todos os experimentos com a Substância H.”", "Notícias")
	await novel_interface.show_dialog("“Lumbert acredita que a cooperação militar entre as Cidades Acadêmicas deve se tornar uma parte normalizada de suas relações diplomáticas.”", "Notícias")
	await novel_interface.show_dialog("\"Ele afirma apoiar o desenvolvimento e a experimentação do seu sistema de resposta passiva por Masada Ford. Ele explica que uma quantidade razoável de intimidação é a verdadeira base para manter a paz.\"", "Notícias")
	await novel_interface.show_dialog("“Ele também pede publicamente uma oportunidade de ter uma conversa com a Dra. Mariru Von Braun da Academia de Ciências da Nova Opulentia…”", "Notícias")
	await novel_interface.show_text_only("Ao ouvir isso, o homem amarrado na cadeira dá um leve sorriso.")
	await novel_interface.show_text_only("Seu impecável cabelo prateado está penteado para trás. Olhos cerúleos olham com indiferença para algumas fotos pregadas na parede.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Em uma foto desbotada, alguns trabalhadores em trajes anti-risco lidam com pilhas de cadáveres.")
	await novel_interface.show_text_only("A julgar pela baixa resolução das fotos, elas devem ter sido tiradas com câmera SLR e filme antigo.")
	await novel_interface.show_text_only("Ele lembra claramente que, naquela época, eles usaram fortes ondas de interferência eletromagnética num raio de vários quilômetros para impedir que outros filmassem a área.")
	await novel_interface.show_text_only("De acordo com a data no canto inferior esquerdo, a foto foi tirada há três anos às margens do rio Churun, no Escudo das Guianas...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Clique!")
	await novel_interface.show_text_only("O homem de preto desliga o telefone e, do nada, chuta o homem de cabelos grisalhos na barriga.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Ufa! *tossindo*", "Homem de terno")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Não suporto o quão falso você parece na TV, hein, senhor?", "Sequestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Falso?\nEu fui... sincero.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O homem de preto se aproxima de Lumbert, agarra seu cabelo e puxa sua cabeça para trás, forçando-o a encarar diretamente a única fonte de luz na sala.")
	await novel_interface.show_text_only("Ele então puxa uma foice e aponta para o olho de Lumbert.")
	await novel_interface.show_dialog("Bem, eu me pergunto quanto vale o seu rosto?", "Sequestrador")
	await novel_interface.show_text_only("Com a luz brilhando diretamente nos olhos do homem, suas pupilas azuis se diluíram rapidamente.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Então, o que você diria? Nomeie seu preço.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert dá uma olhada rápida na lâmina de Aço Damasco apontada para seu globo ocular.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Você entrou furtivamente em Nova Opulentia, controlou minha agenda completa e acabou com todos os meus guarda-costas em dois minutos...", "Lumbert")
	await novel_interface.show_dialog("E ainda consegui obter essas fotos...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("De jeito nenhum você fez tudo isso só para filmar um vídeo meu sendo decapitado. Você deve ter algum outro motivo.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O raciocínio lúcido de Lumbert pega o homem de preto de surpresa.")
	await novel_interface.show_text_only("Ele libera Lumbert do estrangulamento e coloca uma folha de papel em seu rosto.")
	await novel_interface.show_dialog("Bem, vamos fazer a bola rolar então. Vou te dar sessenta segundos para me responder. Acordo ou não acordo?", "Sequestrador")
	await novel_interface.show_text_only("O papel desliza para as calças de Lumbert. Ele olha para baixo: estão impressas doze contas em moeda criptografada e preços reais.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Hum. Você tem algum grau de autocontrole. É bom ver isso.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert olha pela janela. O dia parece estar amanhecendo.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Depois de me manterem refém por doze horas, eles iniciaram uma negociação com um objetivo claro em mente.)")
	await novel_interface.show_text_only("(Apenas sequestradores experientes fazem isso. Eles devem ser bem treinados...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert semicerra os olhos para ver os números listados na folha de papel.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Se levarmos em conta a taxa de câmbio, parece que estes números estão de acordo com a fiança da lista de terroristas que o Conselho Unido publicou recentemente...", "Lumbert")
	await novel_interface.show_dialog("Você não é da Resistência, hein?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A pergunta repentina de Lumbert pega o sequestrador desprevenido.")
	await novel_interface.show_dialog("Hein?", "Sequestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Eu aplaudo vocês por seu esforço em agir como terroristas, mas aposto que vocês foram enviados pela Menorá de Masada Ford...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cale a boca!", "Sequestrador")
	await novel_interface.show_text_only("O homem de preto marcha rapidamente em direção a Lumbert, pronto para nocauteá-lo.")
	await novel_interface.show_text_only("E este último de repente levanta a voz e grita em hebraico:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(Hebraico) Bomba! Abaixe-se!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O guarda do outro lado do armazém levanta instintivamente os braços para cobrir a cabeça e, ao perceber que é uma armadilha, pega sua arma e aponta para Lumbert.")
	await novel_interface.show_text_only("O homem de preto certamente não esperava por isso. Mas é óbvio que o disfarce deles foi descoberto pelas ações reflexivas de seu camarada.")
	await novel_interface.show_text_only("Lumbert sorri, zombeteiramente.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Então este é o script que você está seguindo? Fui sequestrado por terroristas da Resistência, que afirmam estar na posse de provas de que o Congresso Unido realizou experiências ilegais com a Substância H...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert olha mais uma vez para as fotos na parede.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Atualmente sou a única pessoa que demonstrou publicamente apoio a Masada Ford pela construção de sistemas automáticos de contra-ataque para fins de intimidação. É razoável que a Resistência me rapte.", "Lumbert")
	await novel_interface.show_dialog("Sou uma figura bastante conhecida, então isso estará em todos os noticiários. Mais pessoas começarão a ver a Resistência como terroristas malucos.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("E você também pode usar essas fotos para forçar o Congresso Unido a desembolsar dinheiro na forma de moeda criptografada... matando três coelhos com uma cajadada só.", "Lumbert")
	await novel_interface.show_dialog("A transação de moeda criptografada é totalmente visível no canal público. Assim que pagarem, será como se tivessem admitido publicamente que já conduziram experiências ilegais com a Substância H.", "Lumbert")
	await novel_interface.show_dialog("No futuro, Masada Ford poderá usar isso para ameaçar as outras Cidades Acadêmicas para apoiar seu sistema de resposta passiva. Ninguém se atreverá a recusar nenhum dos seus pedidos.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sua análise é 100% precisa. O homem de preto congela em estado de choque, sem saber o que fazer.")
	await novel_interface.show_text_only("Apesar de contido, Lumbert agora está em vantagem.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Você optou por usar imagens de notícias editadas para não ter que falar muito e eu não notar seu sotaque.", "Lumbert")
	await novel_interface.show_dialog("Mas a marca da câmera... a bandeira preta atrás de mim... aquela foice de Damasco... isso é um exagero, não acham?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert faz uma pausa, sorrindo para o homem confuso de preto.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Pelo que posso dizer, vocês devem ter sido ex-recrutas que trabalharam sob a Menorá antes de serem expulsos.", "Lumbert")
	await novel_interface.show_dialog("Ouvi dizer que mesmo aqueles que não passaram nos testes ainda podem trabalhar como uma espécie de mercenários especiais, desde que passem na “revisão de ideologia”.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Assim, lacaios descartáveis como você têm a tarefa de realizar operações politicamente controversas como esta. Dessa forma, se você morrer, isso não os afetará de qualquer maneira.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Sequestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Você provavelmente está sob ordens estritas de não me machucar. Afinal, sou o único apoiador de Masada Ford no momento.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Mas ei, tenho uma boa oportunidade para você e seu amigo—", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Pelo que sei sobre a composição padrão do esquadrão de combate da Menorá, você e aquele guarda ali não são os únicos no time.", "Lumbert")
	await novel_interface.show_dialog("Fora deste armazém, deve haver um membro técnico de combate, um suporte de poder de fogo pesado e um atirador de elite. Estou correto?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert pergunta ao homem de preto, cada palavra claramente pronunciada, olhos afiados e perspicazes.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Compartilhe o que você sabe comigo e concordarei em fingir que não suspeito de nada e continuar seguindo o roteiro que você tem.", "Lumbert")
	await novel_interface.show_dialog("Se não o fizer, bem, você falhará nesta missão. E quem sabe como as pessoas da sua organização irão puni-lo se isso acontecer?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, tudo bem! Nós... nós trabalharemos com você!", "Sequestrador")
	await novel_interface.show_text_only("O homem de preto toma a decisão imediatamente. Ele se vira, procurando uma chave inglesa para libertar Lumbert.")
	await novel_interface.show_text_only("De repente, do nada, surge o som de algo cortando o ar—")
	await novel_interface.show_text_only("O homem de preto congela no lugar, como se estivesse petrificado.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("O que—", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Antes que Lumbert possa terminar sua pergunta, todas as luzes do armazém se apagam.")
	await novel_interface.show_text_only("Do lado de fora vêm vários estrondos.")
	await novel_interface.show_text_only("Bum!\nColidir!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("Uma poderosa rajada de ar faz voar todas as janelas do antigo armazém. Vários holofotes ofuscantes invadem o espaço ao mesmo tempo.")
	await novel_interface.show_dialog("Ninguém se mexa!", "Soldado do Bureau de Defesa")
	await novel_interface.show_text_only("Sob o céu da manhã, uma dúzia de policiais especiais do Metropolitan MD chegam. Eles derrubam os guardas do lado de fora do armazém em segundos e correm em direção a Lumbert.")
	await novel_interface.show_text_only("O barulho alto da hélice do helicóptero bloqueia todos os outros sons.")
	await novel_interface.show_text_only("Lumbert é ajudado pela equipe de resgate a se levantar, balançando calmamente os braços e as pernas doloridos.")
	await novel_interface.show_text_only("Um membro da equipe tira uma foto do que costumava ser o homem de preto. Seu corpo foi cortado em dois na cintura. Com um baque surdo, a metade superior desliza para o chão.")
	await novel_interface.show_text_only("Enquanto a metade inferior – suas duas pernas – ainda está lá.")
	await novel_interface.show_text_only("Os membros da equipe de resgate ao redor olham confusos para este estranho cadáver.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Então não foram eles que o mataram. Portanto, deve ser...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("—Espere, as fotos!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se volta para a parede, anteriormente coberta por fotos. As fotos desapareceram.")
	await novel_interface.show_text_only("Num canto escuro, um ponto cego livre das câmeras de vigilância, uma longa e ensanguentada mecha de cabelo preto desaparece silenciosamente na noite...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
