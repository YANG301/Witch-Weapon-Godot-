	await novel_interface.show_dialog("Os participantes do evento receberão mercadorias gratuitas e limitadas de alguns animes.", "Entourage")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("C-poderia ser...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebo que muitos pedestres seguram uma pequena bandeira amarela que diz “Acesso restrito”. É um item frequentemente visto em um dos animes mais quentes da atualidade.")
	await novel_interface.show_text_only("Esse anime consistia em garotas adoráveis ​​em uniformes de jardim de infância, trabalhando duro com bandeirinhas nas mãos. Muitos espectadores se apaixonaram pela fofura – inclusive eu.")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("(Oh, é daquele show!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não posso deixar de ficar um pouco animado.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hum?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Ah, nada, nada...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu rapidamente escondo minha excitação. Sou praticamente um profissional nisso agora.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Eu tenho que ir. É melhor vocês irem embora também.", "Rafael")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Parece que algo louco vai acontecer esta noite.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia coloca uma joia verde do tamanho de uma bola de gude na minha mão.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Henriette fez isso. Pode ser útil se alguém se machucar.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia evita meus olhos resolutamente, parecendo super envergonhada.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Ah... Henriette, hein...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Já faz um tempo que não ouço falar daquele alquimista que insistia em me chamar de “Mestre”.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Eu me pergunto o que ela pensaria se soubesse que agora sou eu quem tem que chamar os outros de Mestre com roupa de empregada...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("De qualquer forma, tome cuidado.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que eu possa responder, Raphilia desaparece junto com Theresa e sua comitiva.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Eu os vejo desaparecer na multidão na Electronics Street.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hm, ela ainda está abraçando aquele livro com o qual acabou de me bater na cabeça...", "Soya")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não admira que ela esteja com tanta pressa para sair!")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Ei, e se dermos uma olhada nesse evento também antes de voltarmos—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu adoraria ganhar minha própria bandeirinha amarela também. Mas antes que eu possa terminar a frase, Sonya me joga contra a parede.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Você estava gostando, né? Você acha que me dar um choque com a tornozeleira é totalmente divertido, né?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Ah, não...\nDesculpe!", "Lian")
	# removed legacy empty placeholder comment
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebo que posso ter baixado a guarda cedo demais.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Estou pensando desde hoje à tarde...", "Soya")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("Theresa, Raphilia e Elluka...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(Os três? O que eles têm em comum?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Suas auras têm cheiro de bruxa, mas têm cores semelhantes às humanas.", "Soya")
