	await novel_interface.show_dialog("Não era isso que eu esperava.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya enfia os dedos indicador e médio no meu coração, com força. Seus olhos são de aço, frios e determinados. Uma coisa é clara:")
