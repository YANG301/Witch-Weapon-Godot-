	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Harima Tech terminou de escanear nossos espécimes de bruxa. Eles encontraram algo interessante...", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Espécimes? Você quer dizer aqueles que os militares capturaram nas colinas do norte “por um preço enorme”?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Felizmente, sou responsável apenas pelas anomalias sob a cobertura do Aegis...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Bem, fazer amarras para mantê-los no lugar levou algum tempo...\nDe qualquer forma, não vou aborrecê-lo com os detalhes. Irei direto aos resultados que encontramos.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Primeiro, o corpo de uma bruxa é controlado pelo cérebro. No entanto, não leva em conta os seus próprios limites físicos.", "Ai")
