	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Quer dizer... Theresa também é uma dessas pessoas?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Uma dessas pessoas?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mantenho meus olhos no rosto de Sonya enquanto tento encontrar as palavras certas.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Tipo, garotas que receberam a “informação” da magia, mas ainda estão sãs.", "Lian")
	await novel_interface.show_dialog("Algumas delas são incapazes de suportar o fardo do conhecimento e perdem a sanidade, tornando-se assim o tipo de bruxas que você deseja matar.", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Há uma diferença entre os dois.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mantém os olhos fixos nos meus enquanto fala:")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Então, aqueles que perdem a sanidade... podem se recuperar?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Teoricamente não. Pelo menos foi o que Aya disse...", "Lian")
	await novel_interface.hide_character()
	
