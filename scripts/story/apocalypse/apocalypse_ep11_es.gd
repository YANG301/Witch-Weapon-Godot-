# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("No. Estos idiotas... ¡son todos hombres!", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el brazo derecho de Beatrice hay un brazalete, hecho de metal verde musgo, que brilla suavemente en un tono azul claro.")
	await novel_interface.show_text_only("Un invento de Aya. Hecho de una aleación especial que bloquea los efectos de la sustancia meme H. Puede usarse para suprimir los efectos de la \"maldición\" de Beatrice.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Espera, ¿qué estás planeando...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Recuerdo que Mariru me habló hace un par de semanas de la “maldición”. Cualquier hombre que vea a Beatrice inmediatamente se enamorará perdidamente de ella.")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("Para ser exactos, es su rostro el que desencadena el efecto.", "Marirú")
	await novel_interface.show_dialog("A través de una serie de pruebas realizadas por Aya, descubrieron que mirar directamente a la cara de Beatrice estimula en gran medida la circunvolución fusiforme y la amígdala en el cerebro masculino.", "Marirú")
	await novel_interface.show_dialog("Sin embargo, sólo es efectivo si el objetivo la mira directamente en un radio de 260 pies. Las fotos, vídeos o reflejos no tienen ese efecto.", "Marirú")
	await novel_interface.show_dialog("Después de que esta estimulación esté vigente durante un período de tiempo, el cerebro de la persona afectada sufrirá cambios irreversibles. Esto cambiará fundamentalmente su forma de actuar.", "Marirú")
	await novel_interface.show_dialog("Se desesperan por hacer suya a Beatrice. Pero, como no pueden, se vuelven ansiosos, irritables, resentidos. Esto puede incluso provocar autolesiones, incendios intencionales o tendencias violentas.", "Marirú")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Que triste, ¿eh? Amor no correspondido...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru suspira.")
	await novel_interface.show_text_only("Abro la boca para preguntar cómo exactamente Aya llevó a cabo ese horrible experimento, pero la cierro de nuevo. Es mejor si sigo siendo ignorante.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Afortunadamente yo no fui uno de sus sujetos de prueba...)", "Lian")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¡Espera! Cuando ayer me hiciste explicarle cosas a Beatrice sola con \"ese traje\"...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("¿Fue ese también un experimento de Aya?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("¿Te diste cuenta recién ahora?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Así fue?")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hmm, entonces probablemente no te hayas dado cuenta de que el brazalete que Beatrice usó ayer era falso todavía, ¿eh?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru bromea, luciendo un poco decepcionada por mi falta de habilidades de observación.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("La razón por la que te hice usar ese traje fue para evitar que tus pensamientos subjetivos arruinaran los resultados de nuestras pruebas. La “vergüenza” que sentía anularía efectivamente sus “deseos”.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Y…", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella extiende la mano y coloca ambas manos sobre mis hombros. En su rostro hay una sutil sonrisa.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... ¡Te veías muy bien con un traje de conejita playboy!", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¡Aaaaaaaaaa!\n¿No podemos simplemente dejar de mencionar eso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pasé esa hora infernal vestida de conejita playboy, sola con Beatrice, en una habitación cerrada.")
	await novel_interface.show_text_only("Estaba tan nervioso que apenas podía pronunciar una frase completa. Ni siquiera podía caminar correctamente.")
	await novel_interface.show_text_only("Y Beatrice pasó la hora consolándome, aunque estaba a punto de estallar en carcajadas, estoy segura.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aya dijo que las imágenes escaneadas en 3D de tu cerebro eran como un espectáculo de fuegos artificiales. Ella realmente lo disfrutó, lo habría dejado continuar por mucho más tiempo si su presión cerebral no hubiera sido un poco alta.", "Marirú")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("De todos modos, ahora sabemos que, aunque tu cerebro reacciona a la maldición de Beatrice como el de cualquier hombre normal, ningún trauma quedará atrás.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Por otro lado, otros hombres sufrirán daño cerebral permanente después de un período de mirar el rostro de Beatrice. El período oscila entre cuarenta segundos y ocho minutos.", "Marirú")
	await novel_interface.show_dialog("Entonces estás a salvo. ¿No te sientes aliviado?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("¡Ciertamente no me siento aliviado!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ah, ese es otro de mis recuerdos que desearía poder borrar.")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Entonces… si se quita el brazalete aquí…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice me sonríe dulcemente y luego me abraza.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Todo se vuelve oscuro frente a mí cuando mi cara se aplasta contra su pecho.")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.show_dialog("Diré \"vete\". Después de eso, tienes treinta segundos.", "Beatriz")
	await novel_interface.show_dialog("Coge a Elluka y nos dividiremos y nos reuniremos en Newell Central Park. Menos manifestantes allí.", "Beatriz")
	await novel_interface.show_dialog("¿Entendido?", "Beatriz")
	await novel_interface.show_text_only("Asiento, haciendo lo mejor que puedo para no pensar en el pecho blando en mi cara.")
	await novel_interface.show_dialog("¡Oye, yo también quiero un turno!", "Soya")
	await novel_interface.show_text_only("“Hacer clic”")
	await novel_interface.show_text_only("El cierre de la pulsera se abre. La maldición ya está en vigor.")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("A los ojos de Sonya, Electronics Street es ahora un mundo rosa.")
	await novel_interface.show_text_only("El mismo tipo de rosa que vio cubriendo ciertos libros con contenido explícito cuando estaban comprando en la librería esta tarde.")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("¿Tú también eres una bruja?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ah. ¿Puedes decirlo?", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Pero no eres como Elluka o Raphilia...", "Soya")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("¡Tú, como Ren, tienes un aura tan pura como la de un bebé!", "Soya")
	await novel_interface.show_dialog("... ¡Esto es fascinante!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("exclama Sonya, sacudiendo mis hombros con emoción.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("¡Wahhhh!\n(¡Basta! ¡No puedo respirar!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Pareces pesar menos de lo que recordaba.\n¿No eres una monada?", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mujer tetona abraza a Ren aún más fuerte.")
	await novel_interface.show_text_only("Mientras tanto, Ren se agita desesperadamente, tratando de escapar de su abrazo asfixiante.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("... De todos modos, ¿quién eres tú?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ups, olvidé presentarme.\nSoy Beatriz Portinari.", "Beatriz")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<hace 90 minutos>")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Zona Desmilitarizada Acordada, Nuevo Hotel Opulentia Stork Garden>")
	await novel_interface.show_text_only("<Afuera de Birdsong Hall, el salón de banquetes en el último piso>")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Vaya, tienen un jardín aquí en el piso 99. ¿La gente en Hovering Palace disfruta de lujos como este todo el tiempo?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru examina los tejados de cristal, sonriendo a medias.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("¿Quizás cuanto más alto es el jardín, más lujoso parece? ¿O tal vez el 99 es el número de la suerte del propietario?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia se rasca la cabeza, confundida.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("¿Cómo decidiste que esta subasta es lo que estábamos buscando?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fija su mirada en el cartel pintado con spray en la entrada del salón de banquetes.")
	await novel_interface.show_text_only("En él está el título \"Subasta de otoño del Museo Johnson\",\nseguido del subtítulo: donde el arte se encuentra con las finanzas.")
	await novel_interface.show_text_only("El texto blanco parece especialmente discordante sobre el fondo azul. No tiene nada de artístico.")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("¿Es esto realmente una subasta de obras de arte? No me parece muy agradable estéticamente.", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru asiente y sonríe.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Pero los quinientos asientos están ocupados. De los sesenta y tres artículos, sesenta ya se han vendido.", "Marirú")
	await novel_interface.show_dialog("Se han fabricado un total de 1.500 millones.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("¿Tanto? Entonces esta subasta debe ser enorme.\nPero no he oído nada al respecto...", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Las cuentas cifradas electrónicamente sobre las que nos avisó... contienen fondos por valor de miles de millones.", "Marirú")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Eso es mucho, pero sólo lo suficiente para construir dos rascacielos de este tipo.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Para utilizar esta cantidad de dinero para crear un impacto en los billones de fondos de reconstrucción que posee el Congreso Unido, solo debería haber una manera...", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("¿Soborno? ¿Por eso eligieron moneda cifrada?", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Las cuentas pueden estar cifradas, pero todas las transacciones realizadas pueden ser vistas por todos en la red. Y una transacción de este tamaño es imposible que la gente no la note.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Es por eso que necesitan una razón factible para la transacción...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld inclina la cabeza hacia un lado, pensando. Luego ella exclama:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("¡Oh, por eso están realizando una subasta!", "Skuld")
	await novel_interface.show_dialog("Las antigüedades sin precio fijo son una buena excusa para transacciones por valor elevado. Cosas como porcelana, jade, cuadros antiguos... nadie se inmutaría si viera a alguien pujando millones por ellos.", "Skuld")
	await novel_interface.show_dialog("Y la transacción también se realiza en territorio internacional. Hace imposible que los departamentos de impuestos de diferentes naciones recauden impuestos.", "Skuld")
	await novel_interface.show_dialog("Todo lo que necesitan es ponerse en contacto con ambas partes del negocio y vender algunos trastos bajo el nombre de algún museo de propiedad privada.", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Pero no pueden permitir la entrada a verdaderos conocedores del arte, porque de un vistazo podrán ver algo que pasa.", "Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¡Por eso todos los asientos están ocupados!\n¡Han llenado los asientos con su propia gente!", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru acaricia la cabeza de Skuld con aprobación.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Muy inteligente. Probablemente te aburras mucho en la escuela, ¿eh?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¿Qué opinas?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld le sonríe a Mariru, luciendo orgulloso.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Entonces déjame decirte algo más.", "Marirú")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Los “fondos de reconstrucción de posguerra” son básicamente préstamos proporcionados por el Congreso Unido. Los gobiernos que les pidieron prestado deben devolver el dinero o enfrentarse a la ira de las seis naciones principales.", "Marirú")
	await novel_interface.show_dialog("Pero históricamente ninguna nación fue capaz de pagar un préstamo de esta magnitud dentro del plazo. Ahí es donde entra en juego el margen de negociación.", "Marirú")
	await novel_interface.show_dialog("El Comité es inmensamente rico. Lo único que quieren para sí es probablemente el sector más lucrativo, por ejemplo infraestructuras básicas como energía y comunicaciones.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Simplemente pueden hacer una propuesta a los jefes de gobierno que pidieron dinero prestado: que no tendrán que devolver la cantidad prestada siempre que entreguen permanentemente al Comité el 30% de las acciones de su red de telecomunicaciones.", "Marirú")
	await novel_interface.show_dialog("Los gobiernos, incapaces de pagar los préstamos, normalmente estarán de acuerdo. Algunos de los líderes nacionales pueden incluso solicitar activamente reembolsos en privado.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Entonces, ¿cómo consigue el Comité controlar los “sectores” que quiere?", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Tienen que convencer al Congreso Unido de que permita que las corporaciones multinacionales posean fondos y tengan un cierto grado de autonomía...", "Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Eso es mucho pedir. ¿Estarán realmente de acuerdo?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En lugar de responder, Mariru simplemente hace otra pregunta.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Este arte pintado con aerosol parece que lo hizo un niño de jardín de infantes. ¿Qué te dice eso?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Que quienquiera que lo haya hecho no se esforzó lo suficiente en ocultar el hecho de que todo es falso.", "Skuld")
	await novel_interface.hide_character()
	
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Pero hay mucho dinero en juego. Tuvieron que alquilar el último piso del hotel y contratar a cientos de personas. Ya gastaron mucho, así que ¿por qué no gastaron mucho también en los gráficos?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Bueno…", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld hace pucheros, perplejo por toda la nueva información.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Bueno, es porque esto no es nuevo para ellos. Ya ha sucedido innumerables veces. Tanto aquí como en otros lugares.", "Marirú")
	await novel_interface.show_dialog("Nadie los ha sospechado ni denunciado jamás. Por eso ya no se molestan en ocultarlo.", "Marirú")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("El soborno es un arte en sí mismo, especialmente este tipo de soborno clandestino. Necesitan recopilar una inmensa cantidad de información y asegurarse de que todos los involucrados estén satisfechos en todos los niveles.", "Marirú")
	await novel_interface.show_dialog("Hay que hacer un montón de investigaciones. Innumerables personas pasan a formar parte de la operación. Los intercambios de beneficios, como este que vemos hoy, se han producido en numerosas ocasiones.", "Marirú")
	await novel_interface.show_dialog("Tendrán que negociar con mucha gente. Funcionarios, canales de medios, alianzas de trabajadores, organizaciones no gubernamentales, incluso aquellos que ocupan altos cargos en el crimen organizado.", "Marirú")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Así es como influyen en las decisiones clave tomadas por el Congreso Unido.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru asiente hacia la puerta cerrada del salón de banquetes.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Eso es lo que realmente vale más en esta subasta.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld baja la cabeza y suspira.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Esto apesta... se siente tan deshonesto...", "Skuld")
	novel_interface.change_expression("talk")
	await novel_interface.show_dialog("Espera, ¿era eso lo que has estado planeando desde el principio?", "Skuld")
	await novel_interface.show_dialog("No querías arrestar a los autores intelectuales que manipularon el proyecto de reconstrucción...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, la puerta del salón de banquetes se abre por una pequeña rendija. Fabella extiende una mano y les hace una señal de OK.")
	await novel_interface.show_text_only("Es la señal de que todos los artículos se han vendido y que la transacción entre las cuentas cifradas electrónicamente está a punto de realizarse.")
	await novel_interface.show_text_only("Mariru coge su walkie-talkie.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Equipo de recuperación, bloqueen todas las entradas al piso 99, incluido el hueco del ascensor. Avise al hotel de que se ha detectado una gran dosis de sustancias contaminantes radiactivas en el piso 98.", "Marirú")
	await novel_interface.show_dialog("Cortar todas las señales de red y medios de comunicación del edificio. Una vez que diga ir, imponga silencio de radio.", "Marirú")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¡Vaya!", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# scene6 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice finalmente me deja respirar. Ella me empuja a darme la vuelta para que mi espalda quede frente a ella y me susurra al oído.")
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Espere hasta que diga \"ir\". ¡Y no mires!", "Beatriz")
