	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "afraid", 0.25)
	await novel_interface.show_dialog("Da quando ci segui? Non me ne sono nemmeno accorto... anche se hai un profumo così dolce!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya si avvicina a Beatrice, annusando come un cucciolo impaziente che viene trattenuto per il collare (sono io quello che tiene il collare).")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Ti seguo da questo pomeriggio.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sorride, tutta raffinata e di classe, e non posso fare a meno di arrossire.")
	await novel_interface.show_text_only("È vero che ho sentito che ha aiutato con alcuni \"affari speciali\" al SID.")
	await novel_interface.show_text_only("Questa adorabile signora che afferma di essere morta più di settecento anni fa è una strega che ho evocato utilizzando il ciondolo della famiglia di Raphilia nello Sky Hotel.")
	await novel_interface.show_text_only("Si dice che Beatrice sia vittima di una “maledizione” che fa innamorare di lei tutti gli esseri umani del sesso opposto.")
	await novel_interface.show_text_only("Mi sento così nervoso ogni volta che la vedo. Dev'essere a causa di quella maledizione.")
	novel_interface.show_character("ren_fishnet", "shy")
	await novel_interface.show_dialog("Aspetta... quando siamo stati trattenuti alla stazione di polizia...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("Ho contattato Mariru non appena sei stato arrestato, ma sembrava essere occupata o in qualche posto con un segnale difettoso e non ha risposto al mio messaggio.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Ho deciso che voi due sareste comunque riusciti a scappare presto, dato che Sonya era lì, quindi sono rimasto qui e ho tenuto d'occhio Elluka.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "shy_right")
	await novel_interface.show_dialog("Uh... allora come ha fatto Elluka ad arrivare lassù?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando parlo con Beatrice, non so mai dove guardare: in qualche modo sono troppo agitato per incontrare il suo sguardo.")
	await novel_interface.show_text_only("Sonya, invece, studia le mie espressioni con molto interesse. Perché quel moccioso è così fastidioso?")
	novel_interface.show_character("beatrice_regular", "worry")
	await novel_interface.show_dialog("Mentre Sonya ti teneva contro il muro, quel bambino è scappato per seguire un ragazzo che vendeva dolci.", "Beatrice")
	novel_interface.change_expression("bored")
	await novel_interface.show_dialog("Voi due...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sospira pesantemente, come se fossimo totalmente senza speranza. Cosa che non siamo. Non ho nemmeno fatto niente di male!")
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("Dopodiché, poiché Elluka non è riuscita a trovarvi, è andata al negozio di dolci dove avete mangiato questo pomeriggio. Il negoziante non solo le ha permesso di mangiare gratis, ma le ha anche assegnato un ruolo nell'evento promozionale di stasera.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("(Wow, quel negoziante calvo ha un buon occhio per i potenziali favoriti della folla!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("Non avevo familiarità con Elluka, quindi ho pensato che le piacessero davvero i dolci. Ma ora che la guardo, qualcosa davvero non va...", "Beatrice")
	await novel_interface.show_dialog("Puoi dirlo anche tu, vero, Sonya?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Non proprio...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya alza lo sguardo in direzione di Elluka.")
	novel_interface.show_character("soya_uniform", "speechless")
	await novel_interface.show_dialog("Non sembra che sia stata minacciata o drogata.", "Soya")
	await novel_interface.show_dialog("Non sembra ferito da nessuna parte. Agire semplicemente in base ai suoi desideri, in un modo adatto a un bambino della sua età.", "Soya")
