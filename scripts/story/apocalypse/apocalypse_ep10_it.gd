	novel_interface.show_character("ren_fishnet", "worry")
	await novel_interface.show_dialog("Come farai...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che possa finire la domanda, Beatrice mi interrompe.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("C'è qualcosa che tutti gli accaniti fan di Elluka hanno in comune.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Sono tutti... molto emozionati?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sorride, alza il braccio destro.")
