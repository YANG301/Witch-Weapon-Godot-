	await novel_interface.show_dialog("L'unica cosa insolita è che sicuramente mangia molto, ma comunque...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "grieved")
	await novel_interface.show_dialog("Secondo le notizie, ci sono già stati violenti scontri tra manifestanti in sei diverse aree della Zona Demilitarizzata Concordata.", "Beatrice")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("E questo potrebbe diventare il settimo, anche se non c’è ancora alcun conflitto, semplicemente troppe persone per essere considerate al sicuro.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("Non c'è da stupirsi che l'esercito sia qui.\nAllora dobbiamo partire con Elluka il più presto possibile!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "wordless")
	await novel_interface.show_dialog("Ma come dovremmo superare i suoi fan pazzi?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Posso aiutarli a distogliere la loro attenzione, ma ci sono così tante persone in giro, quindi probabilmente non riuscirò a tenerli occupati per più di trenta secondi.", "Beatrice")
