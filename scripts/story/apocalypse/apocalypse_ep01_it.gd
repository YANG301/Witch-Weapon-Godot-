# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Ci vengono insegnati tutti i tipi di virtù con cui vivere.")
	await novel_interface.show_text_only("Sono sicuro che molti di noi hanno letto quella storia su Marie Curie e sulle sue straordinarie capacità di concentrazione.")
	await novel_interface.show_text_only("Stava studiando e sua sorella e i suoi compagni di classe hanno inventato uno scherzo. Accatastarono diverse sedie dietro di lei. Se si fosse mossa, l'intero mucchio sarebbe crollato.")
	await novel_interface.show_text_only("Ma la pila rimase al suo posto anche finché Marie Curie non finì di leggere l’intero libro.")
	await novel_interface.show_text_only("Il suo obiettivo principale è stato ciò che le ha permesso di diventare la prima scienziata ad aver ricevuto due volte il Premio Nobel.")
	await novel_interface.show_text_only("Ma forse ti sarà venuta in mente questa domanda:")
	await novel_interface.show_text_only("\"Tutti si sentono allo stesso modo riguardo allo stesso argomento? Da quando sono nati?\"")
	await novel_interface.show_text_only("Alcune persone nascono con la capacità di assorbire la conoscenza senza sosta e hanno a malapena bisogno di dormire.")
	await novel_interface.show_text_only("Possono memorizzare molte informazioni e rimanere concentrati per molto tempo.")
	await novel_interface.show_text_only("È facile per loro. Ma per molti altri è quasi impossibile.")
	await novel_interface.show_text_only("Forse, per Marie Curie, leggere libri di fisica è più facile che leggere manga.")
	await novel_interface.show_text_only("Quindi, tendere verso le stesse “virtù”, per la maggior parte delle persone, è come lottare contro i tratti genetici con cui si nasce.")
	await novel_interface.show_text_only("Forse non hai considerato questa domanda prima?")
	await novel_interface.show_text_only("Ma ora sì. Il seme è stato piantato nella tua testa.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Quindi...")
	await novel_interface.show_text_only("La prossima volta che ti farai questa domanda, quale voce la farà?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Fare clic.")
	await novel_interface.show_text_only("Il rumore di un'arma da fuoco che viene caricata.")
	await novel_interface.show_text_only("Dopo la sequenza di apertura di NTBC News, arriva la voce familiare dell'annunciatrice.")
	await novel_interface.show_dialog("“Il quarto Forum internazionale annuale di pace si terrà nella zona demilitarizzata concordata a New Opulentia tra tre giorni”.", "Novità")
	await novel_interface.show_dialog("\"Essendo la città neutrale con il più grande sistema di ricerca scientifica, Nuova Opulentia accoglierà ospiti dalle altre cinque Città Accademia questa settimana.\"", "Novità")
	await novel_interface.show_dialog("“Il Forum di Pace di quest’anno sarà incentrato sullo sviluppo della sostanza H come risorsa energetica, sul progetto di ricostruzione e su altre questioni importanti”.", "Novità")
	await novel_interface.show_dialog("“Il presidente di Masada Ford ha dichiarato in un recente discorso informale che la città pubblicherà presto una nuova serie di piani militari per ristabilire l’ordine in Medio Oriente”.", "Novità")
	await novel_interface.show_dialog("\"Il rappresentante del dipartimento di notizie di Salmonton ha rifiutato di commentare questo argomento.\"", "Novità")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Nel vecchio magazzino pende la lampada da soffitto fiocamente illuminata, che emette piccoli crepitii di elettricità.")
	await novel_interface.show_text_only("Da un lato, un uomo dai capelli argentati siede sotto la forte luce bianca.")
	await novel_interface.show_text_only("È legato su una sedia robusta le cui gambe sono state saldate al suolo.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("L'uomo si sta ancora abituando alla luce intorno a lui, dato che il sacco che gli copre la testa è stato appena strappato via. I fili grezzi di rinforzo della nave sfregano contro la sua costosa tuta personalizzata, lasciando estremità ruvide e sfilacciate.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Notando il suono di un'arma da fuoco armata, alza lentamente la testa.")
	await novel_interface.show_text_only("Proprio di fronte a lui è montata una telecamera. E accanto c'è un rapitore con una maschera nera, che lo punta con una pistola.")
	await novel_interface.show_text_only("L'uomo cerca disperatamente di guardarsi intorno. Vede una guardia in fondo al magazzino, con in mano un fucile d'assalto.")
	await novel_interface.show_text_only("Dalla bandana nera che copre i loro volti e dagli abiti mimetici, è abbastanza ovvio da dove vengono questi ragazzi.")
	await novel_interface.show_text_only("L'uomo dai capelli argentati si gira al meglio delle sue capacità. Alla periferia del suo campo visivo, vede una bandiera nera...")
	await novel_interface.show_text_only("Sulla videocamera davanti a lui è montato un cellulare che trasmette il notiziario ad altissimo volume.")
	await novel_interface.show_dialog("\"Sir Lumbert, segretario esecutivo dell'Organizzazione del Trattato sulla proibizione degli esperimenti sulle armi con la sostanza H, ha tenuto oggi una conferenza stampa.\"", "Novità")
	await novel_interface.show_dialog("\"L'organizzazione svolge un ruolo importante nell'impedire che la sostanza H venga utilizzata come arma. È stabilita sulla base del trattato universale sulla proibizione degli esperimenti con armi sulla sostanza H.\"", "Novità")
	await novel_interface.show_dialog("\"Sir Lumbert afferma che l'organizzazione ha attualmente creato un gran numero di stazioni di monitoraggio in tutto il mondo, al fine di supervisionare tutti gli esperimenti sulla sostanza H.\"", "Novità")
	await novel_interface.show_dialog("“Lumbert ritiene che la cooperazione militare tra le Città Accademia dovrebbe diventare una parte normalizzata delle loro relazioni diplomatiche”.", "Novità")
	await novel_interface.show_dialog("\"Afferma di sostenere lo sviluppo di Masada Ford e la sperimentazione del loro sistema di risposta passiva. Spiega che una ragionevole quantità di intimidazione è la vera base per mantenere la pace\".", "Novità")
	await novel_interface.show_dialog("\"Chiede anche pubblicamente l'opportunità di avere una conversazione con il dottor Mariru Von Braun della New Opulentia Academy of Sciences...\"", "Novità")
	await novel_interface.show_text_only("Sentendo questo, l'uomo legato alla sedia sorride leggermente.")
	await novel_interface.show_text_only("I suoi impeccabili capelli argentati sono pettinati all'indietro. Occhi cerulei fissano con nonchalance alcune foto attaccate al muro di fronte.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("In una foto sbiadita, alcuni lavoratori in tute ignifughe hanno a che fare con mucchi di cadaveri.")
	await novel_interface.show_text_only("A giudicare dalla bassa risoluzione delle foto, devono essere state scattate con una fotocamera reflex e una pellicola vecchio stile.")
	await novel_interface.show_text_only("Si ricorda chiaramente che, a quel tempo, avevano usato forti onde di interferenza elettromagnetica entro un raggio di diverse miglia per impedire ad altri di filmare la zona.")
	await novel_interface.show_text_only("Secondo la data in basso a sinistra, la foto è stata scattata tre anni fa sulla riva del fiume Churun, presso il Guyana Shield...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Clicca!")
	await novel_interface.show_text_only("L'uomo in nero chiude il telefono e, dal nulla, dà un calcio allo stomaco all'uomo dai capelli argentati.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Uffa! *tosse*", "L'uomo in giacca e cravatta")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non sopporti quanto sembri falso in TV, eh, signore?", "Rapitore")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Impostore?\nEro... sincero.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'uomo in nero si avvicina a Lumbert, gli afferra i capelli e gli tira la testa all'indietro, costringendolo a guardare direttamente l'unica fonte di luce nella stanza.")
	await novel_interface.show_text_only("Quindi tira fuori una falce e la punta all'occhio di Lumbert.")
	await novel_interface.show_dialog("Beh, mi chiedo quanto vale la tua faccia?", "Rapitore")
	await novel_interface.show_text_only("Con la luce che splende direttamente negli occhi dell'uomo, le sue pupille cerulee si diluiscono rapidamente.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Allora, cosa ne dici? Dai un nome al tuo prezzo.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert lancia un'occhiata alla lama d'acciaio di Damasco puntata verso il suo bulbo oculare.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Ti sei intrufolato a New Opulentia, ti sei impossessato della mia agenda piena e hai ucciso tutte le mie guardie del corpo in due minuti...", "Lumbert")
	await novel_interface.show_dialog("E sono anche riuscito a ottenere quelle foto...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Non è possibile che tu abbia fatto tutto questo solo per filmare un video in cui venivo decapitato. Devi avere qualche altro motivo.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il ragionamento lucido di Lumbert coglie di sorpresa l’uomo in nero.")
	await novel_interface.show_text_only("Libera Lumbert dalla presa e gli schiaffeggia un foglio di carta in faccia.")
	await novel_interface.show_dialog("Bene, allora diamo il via alla palla. Ti do sessanta secondi per rispondermi. Accordo o non accordo?", "Rapitore")
	await novel_interface.show_text_only("Il foglio scivola sui pantaloni di Lumbert. Abbassa lo sguardo: sopra sono stampati dodici conti in valuta crittografati e i prezzi effettivi.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Hmm. Hai un certo grado di autocontrollo. È bello da vedere.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert guarda fuori dalla finestra. Sembra che il giorno stia albeggiando.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Dopo avermi tenuto in ostaggio per dodici ore, iniziarono una trattativa con un obiettivo chiaro in mente.)")
	await novel_interface.show_text_only("(Solo i rapitori esperti lo fanno. Devono essere ben addestrati...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert abbassa gli occhi per osservare le cifre elencate sul foglio di carta.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Se prendo in considerazione il tasso di cambio, sembra che questi numeri siano in accordo con la cauzione per la lista dei terroristi che il Consiglio Unito ha recentemente pubblicato...", "Lumbert")
	await novel_interface.show_dialog("Non sei della Resistenza, eh?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La domanda improvvisa di Lumbert coglie il rapitore alla sprovvista.")
	await novel_interface.show_dialog("Eh?", "Rapitore")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Ti applaudo per i tuoi sforzi di comportarti da terrorista, ma scommetto che sei stato mandato da Menorah da Masada Ford...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Chiudilo!", "Rapitore")
	await novel_interface.show_text_only("L'uomo in nero marcia rapidamente verso Lumbert, pronto a metterlo KO.")
	await novel_interface.show_text_only("E quest'ultimo alza improvvisamente la voce, grida in ebraico:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(Ebraico) Bomba! Scendere!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La guardia all'estremità del magazzino alza istintivamente le braccia per coprirsi la testa e, dopo aver realizzato che si tratta di una trappola, afferra la sua arma e mira a Lumbert.")
	await novel_interface.show_text_only("L’uomo in nero di certo non se lo aspettava. Ma è ovvio che la loro copertura è saltata dalle azioni istintive del suo compagno.")
	await novel_interface.show_text_only("Lumbert sorride, beffardo.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Quindi è questa la sceneggiatura che stai seguendo? Sono stato rapito da terroristi della Resistenza, che affermano di essere in possesso di prove dell'esecuzione di esperimenti illegali sulla sostanza H da parte del Congresso Unito...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert guarda ancora una volta le foto sul muro.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Attualmente sono l’unica persona che ha mostrato pubblicamente sostegno nei confronti di Masada Ford per la costruzione di sistemi di contrattacco automatico a scopo intimidatorio. È ragionevole che la Resistenza mi rapisca.", "Lumbert")
	await novel_interface.show_dialog("Sono una figura piuttosto nota, quindi questo sarà su tutti i notiziari. Molti inizieranno a considerare la Resistenza come un gruppo di terroristi pazzi.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("E puoi anche usare quelle foto per costringere il Congresso Unito a sborsare denaro sotto forma di valuta criptata... prendendo tre piccioni con una fava.", "Lumbert")
	await novel_interface.show_dialog("La transazione di valuta crittografata è completamente visibile sul canale pubblico. Una volta pagato, sarà come se avessero ammesso pubblicamente di aver già condotto esperimenti illegali sulla sostanza H.", "Lumbert")
	await novel_interface.show_dialog("In futuro, Masada Ford potrà usarlo per minacciare le altre Città Accademia affinché supportino il tuo sistema di risposta passiva. Nessuno oserà rifiutare nessuna delle tue richieste.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La sua analisi è accurata al 100%. L'uomo in nero si blocca sotto shock, incerto su cosa fare.")
	await novel_interface.show_text_only("Nonostante sia trattenuto, Lumbert ora ha il sopravvento.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Hai scelto di utilizzare filmati di notizie modificati in modo da non dover parlare molto e non notare il tuo accento.", "Lumbert")
	await novel_interface.show_dialog("Ma la marca della macchina fotografica... la bandiera nera dietro di me... quella falce di Damasco... è eccessivo, non credi?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert fa una pausa, sorridendo all'agitato uomo in nero.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Per quanto ne so, voi ragazzi dovevate essere state ex reclute che lavoravano per Menorah prima di essere cacciati.", "Lumbert")
	await novel_interface.show_dialog("Ho sentito che anche coloro che non hanno superato i test possono comunque lavorare come una sorta di mercenari speciali, purché superino la “revisione ideologica”.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Quindi i servitori usa e getta come te hanno il compito di portare a termine operazioni politicamente controverse come questa. In questo modo, se muori, ciò non li influenzerà comunque.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Rapitore")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Probabilmente hai l'ordine severo di non farmi del male. Dopotutto, sono l’unico sostenitore di Masada Ford in questo momento.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ma ehi, ho una buona opportunità per te e il tuo amico...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Da quello che so sulla composizione standard della squadra da combattimento di Menorah, tu e quella guardia non siete gli unici nella squadra.", "Lumbert")
	await novel_interface.show_dialog("Fuori da questo magazzino dovrebbero esserci un membro tecnico del combattimento, un supporto con potenza di fuoco pesante e un cecchino. Ho ragione?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiede Lumbert all'uomo in nero, ogni parola chiaramente pronunciata, lo sguardo acuto e perspicace.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Condividi ciò che sai con me e accetterò di far finta di nulla e continuare a stare al gioco seguendo il copione che hai.", "Lumbert")
	await novel_interface.show_dialog("Se non lo fai, beh, fallirai questa missione. E chissà come ti puniranno le persone della tua organizzazione se ciò accade?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh, va bene! Noi... lavoreremo con te!", "Rapitore")
	await novel_interface.show_text_only("L'uomo in nero prende subito la decisione. Si gira, cercando una chiave inglese con cui liberare Lumbert.")
	await novel_interface.show_text_only("All'improvviso, dal nulla, arriva il suono di qualcosa che fende l'aria...")
	await novel_interface.show_text_only("L'uomo in nero si blocca sul posto, come pietrificato.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Cosa...", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Prima che Lumbert possa finire la sua domanda, tutte le luci del magazzino si spengono.")
	await novel_interface.show_text_only("Dall'esterno giungono numerosi colpi forti.")
	await novel_interface.show_text_only("Bum!\nIncidente!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("Un potente soffio d'aria fa volare tutte le finestre del vecchio magazzino. Molteplici faretti accecanti invadono lo spazio tutti in una volta.")
	await novel_interface.show_dialog("Nessuno si muova!", "Soldato dell'Ufficio Difesa")
	await novel_interface.show_text_only("Sotto il cielo del primo mattino, una dozzina di agenti della polizia speciale del Metropolitan MD si riversano lì. Abbattono le guardie fuori dal magazzino in pochi secondi e si precipitano verso Lumbert.")
	await novel_interface.show_text_only("Il forte rumore dell'elica dell'elicottero blocca tutti gli altri suoni.")
	await novel_interface.show_text_only("Lumbert viene aiutato a rimettersi in piedi dalla squadra di soccorso, scuotendo con calma le braccia e le gambe doloranti.")
	await novel_interface.show_text_only("Un membro della squadra scatta una foto di quello che era l'uomo in nero. Il suo corpo è stato tagliato di netto in due dalla vita. Con un tonfo sordo, la metà superiore scivola a terra.")
	await novel_interface.show_text_only("Mentre la metà inferiore, le sue due gambe, sono ancora lì.")
	await novel_interface.show_text_only("I membri della squadra di soccorso circostanti fissano confusi questo strano cadavere.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Quindi non sono stati loro a ucciderlo. Pertanto, deve essere...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("—Aspetta, le foto!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert si gira verso il muro, precedentemente coperto di foto. Le foto sono tutte sparite.")
	await novel_interface.show_text_only("In un angolo buio, un angolo cieco libero dalle telecamere di sorveglianza, una lunga ciocca di capelli neri e insanguinati scompare silenziosamente nella notte...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
