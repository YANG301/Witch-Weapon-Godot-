	await novel_interface.show_dialog("Possiamo dire che il corpo e il cervello di una strega sono entrambi semplicemente batterie destinate a essere scaricate.", "Ai")
	await novel_interface.show_dialog("E il limite prestazionale di queste batterie è determinato dal massimo livello di scarica che possono sopportare mentre sono in cortocircuito.", "Ai")
