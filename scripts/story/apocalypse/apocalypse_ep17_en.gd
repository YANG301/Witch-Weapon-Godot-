# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("She laughs, leaning towards me casually, finally letting her head fall on my shoulder.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Thank you, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("We could get Aya to examine you...\nShe’s really skilled, you know? She’ll definitely find a way—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya suddenly places her left index finger on my lips and shakes her head. I quiet down in an instant, and she leans back onto my shoulder again.")
	await novel_interface.show_text_only("We sit there together, just watching the colorful goings-on all the way down there. The protests are supposed to be loud, but we can’t hear anything up where we are. It’s peaceful, soothing.")
	await novel_interface.show_text_only("How should I describe this girl...")
	await novel_interface.show_text_only("A pioneer? Vanguard? Adventurer?")
	await novel_interface.show_text_only("Those are all terms that occurred to me. But they don’t seem entirely right.")
	await novel_interface.show_text_only("Be it Sonya or our ancestors... they must have felt insurmountable fear when they left their familiar homes and ventured into the unknown.")
	await novel_interface.show_text_only("They must have been terrified, while also excited, eager...")
	await novel_interface.show_text_only("Observing their surroundings carefully, choosing the best path, clearing out the brambles that stood in the way...")
	await novel_interface.show_text_only("They were definitely too busy to think about the significance their actions had on the human race and the history.")
	await novel_interface.show_text_only("Those people down there, posing and snapping selfies in the crowd—those are the ones who are desperately trying to prove their own significance, aren’t they?")
	await novel_interface.show_text_only("They all want to look different. Yet, without realizing, they all came together as one to form this enormous monster...")
	await novel_interface.show_text_only("On our way here, we heard a reporter interviewing those present at the rally on the radio.")
	await novel_interface.show_text_only("The reporter chose twenty-three random pedestrians. Out of them all, only one was able to point out the estimated location of Masada Ford on the world map.")
	await novel_interface.show_text_only("Half of them didn’t even know what exactly they were protesting against.")
	await novel_interface.show_text_only("... So is the significance of their existence really that important?")
	await novel_interface.show_text_only("I’m pulled back to reality by my vibrating phone. As I pick it up, I put the phone on broadcast so that Sonya can hear too.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ooh, you two... misbehaving, huh?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Aya?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What are you guys doing on First Avenue?\nAnd up so high? Are you people-watching or something?", "Ai")
	await novel_interface.show_text_only("Aya sounds surprisingly worried. That’s when I notice a drone hovering diagonally across, facing us.")
	await novel_interface.show_dialog("I don’t know where Mariru’s gone. Anyway, I’m here to tell you the results we got after analyzing the battery Beatrice sent over...", "Ai")
	await novel_interface.show_dialog("I’ll get straight to the point.", "Ai")
	await novel_interface.show_dialog("It’s confirmed that the battery has something to do with Substance H. And it was created by a military manufacturer from Masada Ford.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("So... a Substance H weapon?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("When that glowing, sticky liquid was manufactured, Substance H was definitely involved. We can’t be sure of the ingredients yet.", "Ai")
	await novel_interface.show_dialog("Basically, we can see that thing as a sort of fuel cell. The liquid sealed in the battery case is consumed as the battery releases power.", "Ai")
	await novel_interface.show_dialog("For some reason—maybe to meet the shipment deadline or something—they re-fitted the product without even grinding off the factory serial number from MMI.", "Ai")
	await novel_interface.show_dialog("Even the voltage regulator is attached on the outside, on the battery box.", "Ai")
	await novel_interface.show_text_only("Aya sounds confused.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Battery box...? Voltage regulator?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, you don’t know what it looks like, right? Let me describe it...", "Ai")
	await novel_interface.show_dialog("A metal cylinder, almost three inches tall. Fully covered with an insulation layer, except on the electrodes on either side. It’s like an AA battery, but bigger.", "Ai")
	await novel_interface.show_dialog("On its side is a mechanically-structured board. Push it open and you’ll see two metal contacts.", "Ai")
	await novel_interface.show_dialog("If we apply extremely low voltage onto the contacts, we can control the level of electricity released.", "Ai")
	await novel_interface.show_dialog("On the battery box outside, there’s a forty-micro-volt regulator. It’s in the perfect position to hold up the board and restrict the voltage applied to the contacts.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Why does it sound like a battery powered by a battery...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Is it used as a backup power source for a luminous energy flashlight or something?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("It’s because these batteries weren’t designed to be batteries...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya looks somber.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("It’s like... the mechanical safety of weapons... and an ignition device.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I try to calculate the energy contained in such a battery.", "Ai")
	await novel_interface.show_dialog("According to what the electricity company told us, a battery like this can keep a 6W micro-surveillance device running for around twenty days.", "Ai")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Doesn’t sound like a big deal...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(How do you calculate power? Did we learn that in class? I forgot...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sighs at my hopelessness when it comes to physics.")
	await novel_interface.show_dialog("A 2.88 KW battery could keep your cellphone going for half a year.", "Ai")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wow! That long?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I’ve become used to using Elluka to charge my phone and gaming console these days. Annie scolds me for it a lot.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Wait... what happens if there’s no voltage regulator?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("That’s why I called you, actually.", "Ai")
	await novel_interface.show_dialog("I’ve discovered that within the input range of 1 to 500 micro-volts, the battery’s generated power increases along with the input. But when it goes above 500, nothing happens. No output at all.", "Ai")
	await novel_interface.show_dialog("So I raised the voltage to 32V, and suddenly this blinding white light shot out from the battery...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("According to what our high-speed camera captured, the liquid in the battery was consumed in less than a millisecond.", "Ai")
	await novel_interface.show_dialog("The blast of power nearly incinerated the ceiling of the isolation room. There are burn marks criss-crossing all over the wall and the ground.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I suddenly recall that, back when Igor attacked us in Sky Hotel, one of his lackeys used an electric weapon...")
	await novel_interface.show_text_only("After a blast of powerful light, there were criss-crossing burn marks branching out all over the room as well.")
	await novel_interface.show_dialog("Still, the weapon that hit Annie back then didn’t seem to be this powerful. And it was programmed to target only one person, or else everyone in the room would be dead.", "Ai")
	await novel_interface.show_dialog("And 32V is actually the minimum excitation voltage for electronic pulse igniters used by the national defense army of Masada Ford.", "Ai")
	await novel_interface.show_text_only("Aya pauses.")
	await novel_interface.show_dialog("The energy generated by a 2.88KW battery is equal to that of 5.5 pounds of TNT...", "Ai")
	await novel_interface.show_dialog("Though batteries cannot generate shockwaves as destructive as TNT, it can still be fatal for all living beings in a 33-feet radius.", "Ai")
	await novel_interface.show_dialog("And right now, we have one of those things on every single lamp post in the Agreed Demilitarized Zone...", "Ai")
	await novel_interface.show_text_only("I gasp, staring at the gigantic hordes down there.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Dammit... Igor... how could he...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("Wait!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya interjects.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("If that’s so, surely Masada Ford wouldn’t want those batteries to explode, right?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("That’s true.", "Ai")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("The batteries were manufactured in a hurry, the serial numbers are still visible. And a simple voltage regulator was added as a sort of quick fix...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sounds like they were desperate to meet the huge number of orders placed by the United Congress.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("If the batteries explode, authorities would be able to tell who made them from the serial numbers. That would be a stupid move on Masada’s part.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Besides, this is a large-scale city renovation project. Countless people would be involved in the logistics, implementation and maintenance. It’d be impossible to keep such a deadly secret under wraps.", "Ai")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("That’s true...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("What’s really suspicious is the patients Beatrice mentioned.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru had already alerted the disease control center to post a class four contamination warning. Currently, all twenty cases are gathered in the Agreed Demilitarized Zone.", "Ai")
	await novel_interface.show_dialog("However, these batteries don’t have any effect on people’s mental state. And the meme detection results show that they don’t contain meme-type infection sources either...", "Ai")
	await novel_interface.show_text_only("I look down, speechless. So many questions, but no answers.")
	await novel_interface.show_text_only("I gaze at the crowds down there. There’s a street lamp every forty feet...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Wait. What did Sonya and I find strange when we were down there?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("That the “borders” of the rallying crowds are way too defined...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hmm?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What do you mean...?", "Ai")
	await novel_interface.show_text_only("Perhaps the answer has been right in front of us all along. We simply didn’t see it because there were too many distractions on the street...")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Didn’t Mariru say that ALL lighting and surveillance systems on the street lamps in the city had been replaced by the United Congress?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yup.", "Ai")
	await novel_interface.show_dialog("In that case, why do the street lamps come in two colors?", "Lian")
	await novel_interface.show_text_only("On First Avenue, the street lamps glow in a warm yellow, illuminating the clear borders of the crowds.")
	await novel_interface.show_text_only("Meanwhile, on the deserted alleys, the street lamps shine in white.")
	await novel_interface.show_text_only("From the other end of the receiver comes the sound of furious typing.")
	await novel_interface.show_dialog("I just checked. The new light bulbs they added should be sustainable LED lights with 4500K color temperature, so they’re supposed to look white. Not sure what’s up with the yellow ones...", "Ai")
	await novel_interface.show_text_only("Sonya and I exchange looks, in attempt to recall all the lights we saw in the past few hours.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("The footage of the defense line in front of the United Congress we just saw was yellowish. The area is likely lit by a large number of yellow lamps.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("The street lamps on Electronics Street were the yellow kind too, I think...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("The street was chaotic, full of dazzling neon signs and illuminated billboards. No one would notice the yellow lamps.")
	await novel_interface.show_dialog("The atmosphere on Electronics Street was indeed a bit off today... everyone seemed abnormally excited.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("On the other hand, the streets with white lighting seemed to be mostly deserted.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("The street outside the police station we escaped from...", "Soya")
	await novel_interface.show_dialog("Also...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("That quiet road outside Newell Central Park...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Could it be...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("That golden light...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Hmm?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("From behind the door...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("Was it...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya doesn’t bother finishing her sentence. She grabs my hand and darts towards the elevator.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
