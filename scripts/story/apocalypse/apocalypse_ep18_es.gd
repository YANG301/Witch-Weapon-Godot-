# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Salimos del edificio para encontrar nuestro vehículo estacionado en la entrada. El conductor rechoncho nos entrega dos microauriculares de conducción ósea.")
	await novel_interface.show_dialog("El jefe me dijo que te los diera.", "Conductor")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("¿El b-jefe?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya y yo nos ponemos los auriculares y escuchamos a Aya hablar al otro lado de la línea.")
	await novel_interface.show_dialog("Hay demasiado ruido entre la multitud. Es posible que tengas problemas para escucharme si hablamos por teléfono.", "Ai")
	await novel_interface.show_dialog("Acabo de comprobarlo. De toda la Zona Desmilitarizada Acordada, sólo las siete zonas donde ocurrieron los disturbios tienen farolas amarillas.", "Ai")
	await novel_interface.show_dialog("Todas esas son áreas concurridas con muchos carteles publicitarios y otras fuentes de luz, por lo que incluso aquellos que revisan imágenes aéreas no notarían la diferencia.", "Ai")
	await novel_interface.show_dialog("Hemos enviado a nuestro equipo de recuperación, pero supongo que no puedo convencerte de que te quedes atrás. Solo mantén a Ren a salvo.", "Ai")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("¿Quedarse atrás? ¿Eh? ¿Alejarte de qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simplemente asiente con la cabeza hacia el dron que nos sigue y me arrastra entre la multitud.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("Llegamos bajo una farola amarilla que por suerte no está rodeada de demasiada gente. El poste de la lámpara se eleva casi ocho metros.")
	await novel_interface.show_text_only("En los cursos de formación en SID, fui un fracaso total en los ejercicios de escalada.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Obtuve una F para todos ellos).", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por lo general, tenía que abordar el poste con un salto volador para ganar algo de altura, pero termino deslizándome hacia abajo de todos modos.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Jeje...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya saca una caja de metal combada de su bolso. Es sorprendentemente grande, con lados del tamaño de un papel de notas promedio y alrededor de tres pulgadas de grosor.")
	await novel_interface.show_text_only("Una línea plateada brillante recorre la superficie de la caja, marcando un componente giratorio. Y en el lateral hay una franja metálica rosa.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("¡Adivina lo que tengo aquí!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya exclama con orgullo, levantando la caja para que la vea.")
	await novel_interface.show_text_only("Mmm. A juzgar por el tamaño, la artesanía, el gran componente giratorio en forma de abanico y esa franja metálica brillante...")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("¿Algún tipo de tarjeta gráfica innecesariamente grande?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simplemente tira del pestillo del asa y el lado de la caja con rayas rosas se abre como un acordeón.")
	await novel_interface.show_text_only("Y del interior salen una serie de componentes mecánicos negros, junto con un largo “tablero”. Póngalos todos juntos y se extiende por casi cuarenta pulgadas.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("¿Qué diablos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Es un arma exclusiva de Judgement Knights. ¡Impulsado por la Sustancia H!", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("La Penitenciaría me lo hizo según mis deseos.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya gira el mango y aparece una hilera de dientes de sierra relucientes a lo largo del borde de la tabla larga.")
	await novel_interface.show_text_only("La fila de dientes llega hasta el arco al final del tablero y finalmente regresa a la caja.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("¿Una motosierra?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Algo así. Aunque no funciona con electricidad. ¡Es mi arma favorita!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya sonríe y enciende la \"motosierra\". Los dientes comienzan a girar a una velocidad asombrosa, pero es sorprendentemente silencioso.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("¿Vas a...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sin dudarlo, Sonya comienza a cortar el poste de luz de metal. Saltan chispas por todas partes y el poste plateado chirría en señal de protesta.")#多字问题
	await novel_interface.show_text_only("El ruido atrae a todo un público. Unos cuantos hombres de mediana edad, a pesar de no tener la menor idea de lo que está pasando, empiezan a gritar y vitorear.")
	await novel_interface.show_text_only("Muy pronto, se escuchan dos explosiones desde el interior del poste y Sonya recupera tranquilamente su motosierra.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella mira la farola, que ya no brilla. La columna, de unos veinte centímetros de diámetro, está casi cortada.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¡Madera!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("¡Eso es más parecido!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sonríe y le da un golpe al poste en dirección opuesta a la multitud.")
	await novel_interface.show_text_only("Y el poste finalmente cede, cayendo con un chirrido ensordecedor.")
	await novel_interface.show_text_only("¡Auge! El poste de luz se estrella contra el suelo, agrietando la superficie de alquitrán y haciendo volar escombros.")
	await novel_interface.show_text_only("La multitud que los rodea permanece estupefacta durante unos segundos, luego estalla un aplauso salvaje.")
	await novel_interface.show_dialog("¡A la libertad!\n¡A la paz!", "Multitud")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("¿Qué tiene esto que ver con la libertad y el ritmo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corremos hacia lo que una vez fue la parte superior de la farola. Sonya corta rápidamente la parte con la luz, mientras el dron que nos sigue aterriza junto al espectáculo.")
	await novel_interface.show_dialog("No puedo ver mucho desde aquí. Deshazte de la pantalla y acerca la bombilla al dron. Quiero ver el modelo LED.", "Ai")
	await novel_interface.show_text_only("Para evitar las multitudes emocionadas, tomo la bombilla y salgo corriendo en dirección a nuestro SUV.")#换行问题
	await novel_interface.show_text_only("Tan pronto como llegamos, Sonya analiza todo según las instrucciones de Aya. Nos encontramos con una microcámara, pilas, el filamento y el balastro eléctrico.")
	await novel_interface.show_dialog("Los números de serie de estos componentes y el LED parecen correctos y correctos.", "Ai")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Oye...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sostengo la pantalla de la lámpara contra la fuente de luz desde algún lugar fuera del vehículo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Si la pantalla es amarilla, no hay forma de que la lámpara produzca luz blanca, ¿verdad?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La textura amarilla que cubre la pantalla parece intrincada, con un relieve detallado. Debe haber costado mucho trabajo.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("¿Quizás haya un mensaje escondido en esta pantalla? Aunque no puedo decirlo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya también sostiene la pantalla de la lámpara contra la luz del exterior y sacude la cabeza en señal de derrota.")
	await novel_interface.show_dialog("Hay un dispositivo de escaneo 3D en la camioneta. Pon la pantalla dentro y envíame los resultados.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Vaya, ¿tenemos algo así en el auto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Por supuesto! Todos los vehículos SID vienen con un conjunto completo de armas automatizadas.", "Ai")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("¡Cuidado!", "Soya")
	await novel_interface.hide_character()
	
	# Scene 4 - 被攻击场景
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("¡Zing!")
	novel_interface.show_background("res://assets/images/bg/Soya/Beingshot.png")
	await novel_interface.show_text_only("Una repentina y cegadora ráfaga de luz blanca sale disparada desde la esquina y choca directamente contra mi pecho.")
	await novel_interface.show_text_only("Por un segundo, todo lo que puedo escuchar es el agudo chirrido de la electricidad. ¿Mi corazón ha dejado de latir? Parece que sí.")
	await novel_interface.show_text_only("Alguien me atrapa mientras caigo hacia atrás: probablemente el conductor. Con la ayuda de Sonya, me arrastra al otro lado detrás de la furgoneta.")
	await novel_interface.show_text_only("Siete hombres musculosos con trajes de combate especiales negros se abalanzan sobre nosotros con metralletas...")
	await novel_interface.show_text_only("Todo a mi alrededor parece estar envuelto en una neblina, como si alguien hubiera colocado un filtro espantoso. Pero mi cerebro permanece alerta, de manera casi extraordinaria. Es como si pudiera ver lo que está pasando en cámara lenta.")
	await novel_interface.show_text_only("Están Sonya y Aya, gritando mi nombre. Pero no puedo escucharlos claramente. Es como si hubiera un muro entre nosotros...")
	await novel_interface.show_text_only("El conductor saca ágilmente una escopeta del maletero, la carga con una mano y comienza a disparar contra nuestros atacantes, utilizando la puerta blindada del coche como cobertura.")
	await novel_interface.show_text_only("Así que este tipo gordito es realmente rudo, eh...")
	await novel_interface.show_text_only("Lástima que tengan ventaja numérica y estén bien entrenados. Tienen excelentes armas y, por la forma en que atacan, es obvio que no planean dejarnos escapar con vida. Ni siquiera Sonya, una niña...")
	await novel_interface.show_text_only("Lo último que recuerdo antes de que mi conciencia se desvanezca es a Sonya apretando mi mano una vez y luego levantando su motosierra...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Lo que sigue es una serie de gritos animales aterrorizados de hombres moribundos.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# Scene 5 - 瑟蕾莎场景
	novel_interface.change_background("res://assets/images/bg/Soya/Backstreet.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("<A unos trescientos metros de la Primera Avenida>")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Tsk...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa corta hábilmente un trozo de tela negra del traje de un soldado muerto en el suelo, mientras habla perezosamente por sus auriculares.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("¿Son estos muchachos realmente solo un equipo de respaldo?\nSeguro que gastaron mucho en su equipo.", "Theresa")
	await novel_interface.show_dialog("¿Eh? ¿Dejarlos con vida?", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("... ¡Ups!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa se golpea la cabeza.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Olvidé que se suponía que debía dejarlos con vida...", "Theresa")
	await novel_interface.show_dialog("¡Vamos, no es mi culpa! Todos sus cerebros explotaron de repente. Me tomaron por sorpresa así que los maté a todos.", "Theresa")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("Además, incluso si los traigo vivos, no es que podamos descubrir nada interesante de estos tipos, ¿verdad?", "Theresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Quemar todas las huellas dactilares... implantes de dinamita en los dientes... tan pronto como están al borde de la muerte, el mecanismo se activa y toda la cara explota...", "Theresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("... ¡Sí! ¿Ver? ¡No es mi culpa!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya se queja con quien esté al otro lado de la conversación.")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("¡Iba a dejar a esos tipos con vida! Simplemente los golpeé con mi espada... Quería darles la oportunidad de apreciar mis geniales movimientos.", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("¡Y luego simplemente explotaron!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suspira, limpia su espada con la tela que cortó, luego arroja el trapo sucio sobre la cara del cadáver, si es que ya se le puede llamar cara.")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Un montón de perdedores.", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa vuelve a guardar su reluciente katana en su funda.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Dos unidades de emergencia aparecieron de la nada desde un callejón. Sin matrícula. Había más de una docena de ellos, así que no podía tomarlos todos a la vez...", "Theresa")
	await novel_interface.show_dialog("Pero los tres lograron escapar bien de esos atacantes, ¿eh? Ese conductor debe ser hábil.", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Espera, ¿qué?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa se acerca el auricular a la oreja, como si eso fuera a cambiar lo que había oído.")
	novel_interface.show_character("cereza","uneasy")
	await novel_interface.show_dialog("Los atacantes... ¿todos aniquilados?", "Theresa")
	await novel_interface.show_dialog("¿Y su sangre salpicó tan alto que llegó al quinto piso de un edificio de oficinas cercano?", "Theresa")#多符号
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("¿Fue...?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa hace una pausa, esperando la confirmación del otro lado.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Ah, claro, ¡sabía que era obra de ella! Cuando la conocí hoy, yo también lo sentí.", "Theresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("Jajajaja...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa bosteza, adormilada.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Tienes que dejar de despertarme tan temprano todo el tiempo. Sólo quiero volver a mi cama.", "Theresa")
	await novel_interface.show_dialog("De todos modos, tienes toda la información que quieres, ¿verdad?", "Theresa")
	await novel_interface.hide_character()
	
	# Scene 6 - 莉琉与伦伯特对话
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Del otro lado llega una voz femenina segura de sí misma.")
	await novel_interface.show_dialog("Sí, tengo todo lo que necesito para ganar en esta negociación.", "Voz femenina")
	novel_interface.show_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("La tobillera de Sonya tiene micrófonos. Escuché todo lo que le dijo a Ren. Y eso, más lo que has encontrado...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mira la foto descolorida que tiene en la mano, mientras camina por el sótano cerrado.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Bien hecho, Teresa.", "Marirú")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("O debería decir... ¿Machida Rinko?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa simplemente se ríe irónicamente y cuelga.")
	await novel_interface.show_text_only("Segundos después, se abre uno de los dos juegos de puertas negras del ascensor que conducen al sótano. Un hombre con un traje impecable sale a zancadas.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Que diseño tan impresionante...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Dos ascensores, ubicados en calles diferentes, en dos edificios espalda con espalda. Sin embargo, conducen al mismo sótano oculto.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Hola, señor Lumbert.\nMira, nuestras identidades son... sensibles, así que tenemos que reunirnos en secreto.", "Marirú")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¿No dijiste hace dos días en la televisión que querías tener una conversación pública conmigo?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Supongo que ya no hay necesidad de eso.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert señala la foto descolorida en la mano de Mariru.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Ahora dímelo. ¿Cuanto sabes?", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 7 - 小怜醒来
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("No puedo decir cuánto tiempo ha pasado mientras lentamente recupero la sensación en mis extremidades. Escucho el ruido de un vehículo... ¿estoy en un auto?")
	await novel_interface.show_text_only("Hay una mano acariciando suavemente mi frente. Se siente como en casa.")
	await novel_interface.show_dialog("Ren...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/Wakingup.png")
	await novel_interface.show_text_only("Fuerzo mis ojos a abrir, aunque todo todavía está borroso.")
	await novel_interface.show_dialog("Ren—", "Soya")
	await novel_interface.show_dialog("¿Estás despierto?", "Soya")
	await novel_interface.show_text_only("Sonya parece agitada. ¿Son esas lágrimas que veo en sus ojos?")
	await novel_interface.show_dialog("¿Qué pasó...?", "Lian")
	await novel_interface.show_dialog("Urgh...", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Siento algo duro en mi boca. Algo que se supone que no debería estar ahí. Lo escupo por reflejo.")
	novel_interface.show_background("res://assets/images/bg/Soya/Backseat.png")
	await novel_interface.show_text_only("Me froto los ojos y me encuentro en el asiento trasero de nuestra camioneta. ¿Qué fue lo que acabo de escupir? Miro mi mano.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("¿Qué es…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es una gema transparente, del tamaño de una canica. Se parece al que me había entregado Raphilia, aunque el color se ha desvanecido.")
	await novel_interface.show_dialog("¡Guau! ¿Ya te levantaste?", "Conductor")
	await novel_interface.show_dialog("¡Quédate quieto, no te muevas! Realmente pensamos que te habíamos perdido allí. No tengo idea de cómo íbamos a decírselo al jefe.", "Conductor")
	await novel_interface.show_dialog("Y no te preocupes, pronto llegaremos al hospital.", "Conductor")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("¿Hospitales?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hago lo mejor que puedo para recordar qué pasó exactamente. Fuimos atacados, ¿no? Y luego—")
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("¿Estás bien? ¿Duele en alguna parte?", "Soya")
