	await novel_interface.show_text_only("Хотя сейчас закон уже не действует, эта улица на границе Согласованной демилитаризованной зоны стала своего рода Меккой для отаку всего мира.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("(В любом случае, почему Мариру заставила меня надеть этот наряд...)", "Лиан")
