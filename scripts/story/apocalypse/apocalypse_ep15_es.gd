# apocalypse_ep15.gd - 天启篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第15话剧本
	apocalypse_ep15_script()

func play_script():
	pass

