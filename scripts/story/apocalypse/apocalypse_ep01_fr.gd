# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("On nous enseigne toutes sortes de vertus à respecter.")
	await novel_interface.show_text_only("Je suis sûr que la plupart d’entre nous ont lu cette histoire sur Marie Curie et ses extraordinaires capacités de concentration.")
	await novel_interface.show_text_only("Elle étudiait et sa sœur et ses camarades de classe ont inventé une farce. Ils empilèrent plusieurs chaises derrière elle. Si elle bougeait, toute la pile s’effondrerait.")
	await novel_interface.show_text_only("Mais la pile est restée en place jusqu'à ce que Marie Curie ait fini de lire le livre en entier.")
	await novel_interface.show_text_only("Sa grande concentration lui a permis de devenir la première scientifique à avoir reçu deux fois le prix Nobel.")
	await novel_interface.show_text_only("Mais cette question vous est peut-être venue à l'esprit :")
	await novel_interface.show_text_only("\"Est-ce que tout le monde ressent la même chose sur le même sujet ? Depuis leur naissance ?\"")
	await novel_interface.show_text_only("Certaines personnes naissent avec la capacité d’absorber des connaissances sans arrêt et ont à peine besoin de dormir.")
	await novel_interface.show_text_only("Ils peuvent mémoriser de nombreuses informations et rester concentrés longtemps.")
	await novel_interface.show_text_only("C'est facile pour eux. Mais pour beaucoup d’autres, c’est quasiment impossible.")
	await novel_interface.show_text_only("Peut-être que, pour Marie Curie, lire des livres de physique est plus facile que lire des mangas.")
	await novel_interface.show_text_only("Ainsi, pour la plupart des gens, lutter vers les mêmes « vertus » revient à lutter contre les traits génétiques avec lesquels ils sont nés.")
	await novel_interface.show_text_only("Peut-être n’avez-vous jamais réfléchi à cette question auparavant ?")
	await novel_interface.show_text_only("Mais maintenant c’est fait. La graine a été plantée dans votre tête.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Alors...")
	await novel_interface.show_text_only("La prochaine fois que vous vous poserez cette question, quelle voix la posera ?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Cliquez.")
	await novel_interface.show_text_only("Le bruit d'une arme à feu qu'on charge.")
	await novel_interface.show_text_only("Après la séquence d'ouverture de NTBC News, vient la voix familière de la présentatrice.")
	await novel_interface.show_dialog("« Le quatrième Forum international annuel pour la paix se tiendra dans la zone démilitarisée agréée de New Opulentia dans trois jours. »", "Actualités")
	await novel_interface.show_dialog("\"En tant que ville neutre dotée du plus grand système de recherche scientifique, New Opulentia accueillera cette semaine des invités des cinq autres villes universitaires.\"", "Actualités")
	await novel_interface.show_dialog("\"Le Forum pour la paix de cette année sera centré sur le développement de la substance H en tant que ressource énergétique, le projet Rebuild et d'autres questions importantes.\"", "Actualités")
	await novel_interface.show_dialog("« Le président de Massada Ford a déclaré récemment dans un discours informel que la ville publierait bientôt une toute nouvelle série de plans militaires afin de rétablir l'ordre au Moyen-Orient. »", "Actualités")
	await novel_interface.show_dialog("\"Le représentant du département de presse de Salmonton a refusé de commenter ce sujet.\"", "Actualités")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Dans l’ancien entrepôt, le plafonnier faiblement éclairé est suspendu, émettant de petits bruits électriques pétillants.")
	await novel_interface.show_text_only("D’un côté, un homme aux cheveux argentés est assis sous la dure lumière blanche.")
	await novel_interface.show_text_only("Il est attaché sur une chaise solide dont les pieds ont été soudés au sol.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("L'homme est encore en train de s'adapter à la luminosité qui l'entoure, car le sac au-dessus de sa tête vient d'être arraché. Les fils de renfort rugueux du navire frottent contre sa coûteuse combinaison personnalisée, laissant des extrémités grossières et effilochées.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Remarquant le bruit d'une arme à feu qu'on arme, il relève lentement la tête.")
	await novel_interface.show_text_only("Juste devant lui, une caméra est installée. Et à côté, un ravisseur portant un masque noir se tient debout, le pointant avec une arme à feu.")
	await novel_interface.show_text_only("L'homme essaie désespérément de regarder autour de lui. Il aperçoit un garde à l'extrémité de l'entrepôt, tenant un fusil d'assaut.")
	await novel_interface.show_text_only("D’après le bandana noir couvrant leurs visages et les tenues de camouflage, il est assez évident d’où viennent ces gars.")
	await novel_interface.show_text_only("L'homme aux cheveux argentés se tortille du mieux qu'il peut. A la périphérie de son champ de vision, il aperçoit un drapeau noir...")
	await novel_interface.show_text_only("Sur la caméra vidéo devant lui, un téléphone portable est monté, diffusant les informations au volume le plus élevé.")
	await novel_interface.show_dialog("\"Sir Lumbert, secrétaire exécutif de l'Organisation du Traité d'interdiction des expériences sur les armes à substance H, a tenu une conférence de presse aujourd'hui.\"", "Actualités")
	await novel_interface.show_dialog("\"L'organisation joue un rôle important en empêchant la substance H d'être utilisée comme arme. Elle est établie sur la base du Traité universel d'interdiction des expériences sur les armes avec la substance H.\"", "Actualités")
	await novel_interface.show_dialog("\"Sir Lumbert déclare que l'organisation a actuellement établi un grand nombre de stations de surveillance partout dans le monde, afin de superviser toutes les expériences sur la substance H.\"", "Actualités")
	await novel_interface.show_dialog("\"Lumbert estime que la coopération militaire entre les villes universitaires devrait devenir un élément normalisé de leurs relations diplomatiques.\"", "Actualités")
	await novel_interface.show_dialog("\"Il prétend soutenir le développement et l'expérimentation par Masada Ford de son système de riposte passive. Il explique qu'un niveau raisonnable d'intimidation est la véritable base du maintien de la paix.\"", "Actualités")
	await novel_interface.show_dialog("\"Il demande également publiquement l'opportunité d'avoir une conversation avec le Dr Mariru Von Braun de la New Opulentia Academy of Sciences...\"", "Actualités")
	await novel_interface.show_text_only("En entendant cela, l’homme attaché à la chaise sourit légèrement.")
	await novel_interface.show_text_only("Ses cheveux argentés impeccables sont peignés en arrière. Des yeux azurés regardent nonchalamment quelques photos punaises sur le mur d'en face.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Sur une photo décolorée, quelques ouvriers en combinaison de protection contre les matières dangereuses s'occupent de tas de cadavres.")
	await novel_interface.show_text_only("À en juger par la faible résolution des photos, elles doivent avoir été prises avec un appareil photo reflex et une pellicule à l'ancienne.")
	await novel_interface.show_text_only("Il se souvient très bien qu'à cette époque, ils avaient utilisé de fortes ondes électromagnétiques d'interférence dans un rayon de plusieurs kilomètres pour empêcher les autres de filmer la zone.")
	await novel_interface.show_text_only("D'après la date en bas à gauche, la photo a été prise il y a trois ans au bord de la rivière Churun, au niveau du bouclier guyanais...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Cliquez !")
	await novel_interface.show_text_only("L'homme en noir ferme le téléphone et, sorti de nulle part, donne un coup de pied à l'homme aux cheveux argentés sur le ventre.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Pouah ! *toux*", "Homme en costume")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vous ne supportez pas à quel point vous avez l'air faux à la télé, hein, monsieur ?", "Kidnappeur")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Faux?\nJ'étais... sincère.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'homme en noir s'approche de Lumbert, lui attrape les cheveux et tire sa tête vers l'arrière, le forçant à faire face directement à l'unique source de lumière dans la pièce.")
	await novel_interface.show_text_only("Il sort alors une faux et la pointe sur l’œil de Lumbert.")
	await novel_interface.show_dialog("Eh bien, je me demande combien vaut ton visage ?", "Kidnappeur")
	await novel_interface.show_text_only("Avec la lumière brillant directement dans les yeux de l’homme, ses pupilles céruléennes se diluent rapidement.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Alors, qu'en dis-tu ? Nommez votre prix.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert jette un coup d'œil à la lame en acier Damas pointée vers son globe oculaire.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Vous vous êtes faufilé dans la Nouvelle Opulentia, avez mis la main sur mon emploi du temps complet et avez éliminé tous mes gardes du corps en deux minutes...", "Lumbert")
	await novel_interface.show_dialog("Et j'ai même réussi à obtenir ces photos...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Pas question que vous ayez fait tout ça juste pour filmer une vidéo de ma décapitation. Vous devez avoir un autre motif.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le raisonnement lucide de Lumbert surprend l’homme en noir.")
	await novel_interface.show_text_only("Il libère Lumbert de son étranglement et lui met une feuille de papier sur le visage.")
	await novel_interface.show_dialog("Eh bien, commençons le bal alors. Je vous donne soixante secondes pour me répondre. Accord ou pas d’accord ?", "Kidnappeur")
	await novel_interface.show_text_only("Le papier glisse sur le pantalon de Lumbert. Il baisse les yeux : douze comptes en devises cryptés et les prix réels y sont imprimés.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Hum. Vous avez un certain degré de maîtrise de soi. C'est bon à voir.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert regarde par la fenêtre. Le jour semble se lever.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Après m’avoir gardé en otage pendant douze heures, ils ont entamé une négociation avec un objectif clair en tête.)")
	await novel_interface.show_text_only("(Seuls les ravisseurs expérimentés font cela. Ils doivent être bien entraînés...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert plisse les yeux vers les chiffres inscrits sur la feuille de papier.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Si je prends en compte le taux de change, il semble que ces chiffres soient en accord avec la liste de cautionnement des terroristes que le Conseil unifié a récemment publiée...", "Lumbert")
	await novel_interface.show_dialog("Vous n’êtes pas de la Résistance, hein ?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La question soudaine de Lumbert prend le ravisseur au dépourvu.")
	await novel_interface.show_dialog("Hein ?", "Kidnappeur")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Je vous félicite pour vos efforts pour agir comme des terroristes, mais je parie que vous êtes envoyé par Menorah de Massada Ford...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ferme-la !", "Kidnappeur")
	await novel_interface.show_text_only("L'homme en noir marche d'un pas vif vers Lumbert, prêt à l'assommer.")
	await novel_interface.show_text_only("Et ce dernier élève soudain la voix, crie en hébreu :")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(hébreu) ​​Bombe ! Descendre!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le gardien au fond de l’entrepôt lève instinctivement les bras pour se couvrir la tête et, après avoir réalisé qu’il s’agit d’un piège, saisit son arme et vise Lumbert.")
	await novel_interface.show_text_only("L’homme en noir ne s’y attendait certainement pas. Mais il est évident que leur couverture est détruite par les actions réflexives de son camarade.")
	await novel_interface.show_text_only("Lumbert sourit, moqueur.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Alors, est-ce le script que vous suivez ? J'ai été kidnappé par des terroristes de la Résistance, qui prétendent être en possession de preuves démontrant que le Congrès américain effectuait des expériences illégales sur la substance H...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert jette un nouveau coup d'œil aux photos accrochées au mur.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Je suis actuellement la seule personne à avoir publiquement manifesté son soutien à Masada Ford pour la construction de systèmes de contre-attaque automatique à des fins d’intimidation. Il est raisonnable que la Résistance m’enlève.", "Lumbert")
	await novel_interface.show_dialog("Je suis une personnalité assez connue, donc cela fera la une des journaux. De plus en plus de gens commenceront à considérer la Résistance comme des terroristes fous.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Et vous pouvez également utiliser ces photos pour forcer le Congrès uni à cracher de l’argent sous forme de monnaie cryptée… faisant d’une pierre trois coups.", "Lumbert")
	await novel_interface.show_dialog("La transaction en monnaie cryptée est entièrement visible sur la chaîne publique. Une fois qu’ils auront payé, ce sera comme s’ils avaient publiquement admis avoir déjà mené des expériences illégales sur la substance H.", "Lumbert")
	await novel_interface.show_dialog("À l'avenir, Masada Ford pourra l'utiliser pour menacer les autres villes universitaires afin de soutenir votre système de riposte passive. Personne n’osera refuser aucune de vos demandes.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Son analyse est précise à 100%. L'homme en noir se fige sous le choc, ne sachant pas quoi faire.")
	await novel_interface.show_text_only("Malgré sa retenue, Lubert a désormais le dessus.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Vous avez choisi d’utiliser des images d’actualité montées pour ne pas avoir à parler beaucoup et pour que je ne remarque pas votre accent.", "Lumbert")
	await novel_interface.show_dialog("Mais la marque de l’appareil photo… le drapeau noir derrière moi… cette faux de Damas… c’est exagéré, tu ne trouves pas ?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert fait une pause, souriant à l'homme en noir troublé.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Pour autant que je sache, vous deviez être d'anciennes recrues qui travaillaient sous Menorah avant d'être expulsées.", "Lumbert")
	await novel_interface.show_dialog("J’ai entendu dire que même ceux qui n’ont pas réussi leurs tests peuvent toujours travailler comme mercenaires spéciaux, à condition qu’ils réussissent « l’examen idéologique ».", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Ainsi, des serviteurs jetables comme vous sont chargés de mener des opérations politiquement controversées comme celle-ci. De cette façon, si vous mourez, cela ne les affectera pas de toute façon.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Kidnappeur")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Vous avez probablement reçu l’ordre strict de ne pas me faire de mal. Après tout, je suis actuellement le seul partisan de Massada Ford.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Mais bon, j'ai une bonne opportunité pour toi et ton copain...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("D’après ce que je sais de la composition standard d’une escouade de combat de la Menorah, vous et ce garde là-bas n’êtes pas les seuls dans l’équipe.", "Lumbert")
	await novel_interface.show_dialog("À l'extérieur de cet entrepôt, il devrait y avoir un combattant technique, un appui de puissance de feu lourd et un tireur d'élite. Ai-je raison ?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("» Lumbert demande à l'homme en noir, chaque mot clairement énoncé, les yeux perçants et astucieux.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Partagez ce que vous savez avec moi, et j'accepterai de faire semblant de ne rien soupçonner et de continuer à jouer en suivant ce scénario que vous avez.", "Lumbert")
	await novel_interface.show_dialog("Si vous ne le faites pas, eh bien, vous échouerez dans cette mission. Et qui sait comment les membres de votre organisation vous puniront si cela se produit ?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Euh, d'accord ! Nous... nous travaillerons avec vous !", "Kidnappeur")
	await novel_interface.show_text_only("L’homme en noir prend immédiatement la décision. Il se retourne, cherchant une clé pour libérer Lumbert.")
	await novel_interface.show_text_only("Soudain, sorti de nulle part, le bruit de quelque chose fendant l'air...")
	await novel_interface.show_text_only("L’homme en noir se fige sur place, comme pétrifié.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Quoi...", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Avant que Lumbert puisse terminer sa question, toutes les lumières de l'entrepôt s'éteignent.")
	await novel_interface.show_text_only("De l’extérieur arrivent plusieurs détonations bruyantes.")
	await novel_interface.show_text_only("Boum !\nAccident!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("Un puissant souffle d’air fait voler toutes les fenêtres de l’ancien entrepôt. Plusieurs spots aveuglants envahissent l’espace en même temps.")
	await novel_interface.show_dialog("Personne ne bouge !", "Soldat du Bureau de la Défense")
	await novel_interface.show_text_only("Sous le ciel du petit matin, une douzaine de policiers spéciaux du Metropolitan MD affluent. Ils éliminent les gardes à l'extérieur de l'entrepôt en quelques secondes et se précipitent vers Lumbert.")
	await novel_interface.show_text_only("Le bruit fort de l’hélice de l’hélicoptère bloque tous les autres sons.")
	await novel_interface.show_text_only("Lumbert est aidé à se relever par l'équipe de secours, secouant calmement ses bras et ses jambes endoloris.")
	await novel_interface.show_text_only("Un membre de l'équipe prend une photo de ce qui était autrefois l'homme en noir. Son corps a été nettement coupé en deux à partir de la taille. Avec un bruit sourd, la moitié supérieure glisse vers le sol.")
	await novel_interface.show_text_only("Tandis que la moitié inférieure – ses deux jambes – sont toujours là.")
	await novel_interface.show_text_only("Les membres de l’équipe de secours environnante regardent avec confusion cet étrange cadavre.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Ce ne sont donc pas eux qui l’ont tué. Il faut donc que ce soit...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("—Attends, les photos !", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se tourne vers le mur, préalablement recouvert de photos. Les photos ont toutes disparu.")
	await novel_interface.show_text_only("Dans un coin sombre, un angle mort dégagé des caméras de surveillance, une longue mèche de cheveux noirs ensanglantée disparaît silencieusement dans la nuit...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
