# apocalypse_ep20.gd - 天启篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第20话剧本
	apocalypse_ep20_script()

func play_script():
	pass

