	novel_interface.show_background("res://assets/images/bg/Soya/Universe.png")
	await novel_interface.show_text_only("I used to find epic-sounding, highly imaginative theories attractive.")
	await novel_interface.show_text_only("Humans are actually brains floating in a cultivation tank. We’re nothing but mere simulations. The whole planet is created as a child’s experiment. Theories like these.")
	await novel_interface.show_text_only("I was addicted to these ideas. Intoxicated. They gave me goosebumps.")
	await novel_interface.show_text_only("Until one day, I started wondering...")
	await novel_interface.show_text_only("That cultivation tank, that programmer who created the simulation, that child who did the experiment... what kind of world are THEY living in?")
	await novel_interface.show_text_only("Aren’t all of us trapped in this same universe, with no means of escape?")
	await novel_interface.show_text_only("Like that lyric in Hotel California: you can check out any time you like, but you can never leave.")
	await novel_interface.show_text_only("When gods look into the starry sky, don’t they feel the same curiosity, awe and fear that we do?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ren!")
	
