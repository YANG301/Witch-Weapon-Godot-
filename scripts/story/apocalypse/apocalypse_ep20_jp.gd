# apocalypse_ep20.gd - 天启篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第20话剧本
	apocalypse_ep20_script()

func play_script():
	pass

# 天启篇第20话 - 正式剧本
func apocalypse_ep20_script():
	# 开场宇宙哲学思考
	novel_interface.show_background("res://assets/images/bg/Soya/Universe.png")
	await novel_interface.show_text_only("――小さい頃、壮大で想像力に溢れる仮説に\n俺は魅せられていた。")
	await novel_interface.show_text_only("人類は単なる水槽内の脳ミソである説とか。\n\nこの世界は仮想プログラムで構成されていて、\nその中で俺達は生活しているだけと言う説とか。\n地球は、とある子供の実験場だったりする説も。")
	await novel_interface.show_text_only("これらの仮説は人々を夢中にさせ、魅了して、\n鳥肌すらも立てせてくれる。\n……少なくとも俺は夢中になった。")
	await novel_interface.show_text_only("だけど……ある日、俺は考え始めた──")
	await novel_interface.show_text_only("水槽の脳の世界、仮想プログラムの外の世界、\nとある子供の世界……\n俺達の先にある実際の世界はどうなっているの\nだろうか？")
	await novel_interface.show_text_only("先にある世界も、またその先の世界だって同じ、\n実は全ての世界の住民が──\nこの宇宙に閉じ込められた逃げられない存在\nなのかもしれない。")
	await novel_interface.show_text_only("あの名曲《ホテルカリフォルニア》の歌詞と\n同じだ。\n「あなたはいつでもチェックアウトできる、\n　だが決してここから離れられない」")
	await novel_interface.show_text_only("──神々が星空を眺めている時。\n\n俺達と同じ好奇心があって、同じ憧れがあって、\nきっと同じ恐怖を持っている……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("……レンちゃんッ！")
	
	# 小怜醒来
	novel_interface.show_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("――――ッ！！！！", "レン")
	await novel_interface.show_text_only("刺激臭で目覚めたら、自分が柔らかいベッドで\n寝かされている事に気付いた。")
	await novel_interface.show_text_only("隣には気つけ薬を持っている愛衣。\n\n足元には携帯で俺の姿を録画しているマリル。")
	await novel_interface.show_dialog("は、はぇ――っ？？", "レン")
	await novel_interface.show_text_only("慌てて顔のヨダレと涙を拭くと、\n枕が濡れまくってる事にも気付いた。")
	await novel_interface.show_text_only("長い間寝ていたようだ。\n\nしかも、とっても悲しい夢を見たような……")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("レンちゃんの寝顔、あほ可愛かったよぉ～～♪", "アイ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは微笑みながら携帯を閉じると、\nベッドの隣に移動して俺の額を撫でた。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("今日は土曜日、\nお前はもう10時間以上は寝ている。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("……10時間……ここはどこだ？", "レン")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("──ソヤッ！？！？", "レン")
	await novel_interface.hide_character()
	
	# 回忆爆炸
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N2.png")
	await novel_interface.show_text_only("思い出した。\n\n電光の後、火の玉と化したヘリは教会の後ろに\n墜落した。")
	await novel_interface.show_text_only("燃え盛る炎を唖然と眺めるしかできなかった。\n叫びたくても声すら出せなかったのだ。")
	await novel_interface.show_text_only("数秒後、さらに激しい2回目の爆発が起きた……")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("その爆発の衝撃でレンちゃんは気絶したのさ。", "アイ")
	novel_interface.show_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("給油タンクが電撃に貫かれてヘリは大爆発！\nエルガノや兵士5名は全員消し炭になったわよ。", "アイ")
	await novel_interface.show_dialog("同時に天国の扉のレプリカも焼き払われたから、\n街に設置されていた照明カバーの効果も、\n全て消失しちゃったけど……", "アイ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は少し残念そうに言った。")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("ソヤ……ソヤはどうなったんだっ！？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("あの場にいた捜査員によれば、ソヤは確実に\nヘリに乗ったようだ。\nそして離陸後にヘリから脱出した人間は\n誰もいなかった……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("それを聞いて、胸が締め付けられる。")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("しかし、残骸の中からソヤの遺体は発見され\nなかった。\n爆発時には電池を持っていたはずなのだが、\n一切の生物的な痕跡すら検出されていない。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("……どういう……事？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("残骸の後片付けはSIDが担当したわけではないが\n情報は信頼できるものだ。", "マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("なにせ私達は保安軍指揮官の娘を既に\n回収しているからな～～", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは得意げな顔をした。")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("（かい、回収……？）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("それに異質物で強化された足輪は、\nあの程度の爆発では破壊できないはずなのに、\n何故か足輪からの信号が突然消えたんだよね。", "アイ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は少し間をおいてマリルの方を見た。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("まるで前回、レンちゃんが「方舟基地」から\n消えた時と同じみたいに……", "アイ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("それを聞いて、俺は思わずドキッとする。")
	await novel_interface.show_text_only("元は戦前に建てられた巨大な地下排水施設だけど\nマリルが元老院の経費で実験施設に改造した……\nそれが方舟基地だ。")
	await novel_interface.show_text_only("かつて俺は、あそこで16世紀の錬金術士\nハインリッヒ・クンラートを召喚した事がある。")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("召喚後、俺は彼女と共に因果の挟間というやつに\n巻き込まれた。\n時間と方位の概念が存在しない異様な空間に\n放り込まれたんだ。")
	await novel_interface.show_text_only("その空間から無事離脱はできたんだけど……\n\n気付けば俺達は南極にワープしていた……")
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("彼女の計画とは少々違うんだが、まだ一縷の\n望みがあるかもしれん。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("一縷の望みって……どういう？\n\n俺にも何かできる事があるのか！？", "レン")
	await novel_interface.show_dialog("それに……彼女の計画って！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺が問い詰めるとマリルは、やたらと深い\n溜め息を吐いた。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("……まだ分からないのか？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("分からないから聞いてるんだよ――！！")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("あの足輪は元々、仮釈放された囚人の逃亡を\n防ぐために設計された。", "マリル")
	await novel_interface.show_dialog("足輪には盗聴機能が付いている。\nもちろん、この事をソヤは知っていた。", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("つまり私に聞かれている事を重々承知で、\n彼女はお前と話してたってわけだ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("疑問が解けないまま、とりあえず頷く。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("昨日のお前達の行動をよく思い出してみろ。", "マリル")
	await novel_interface.show_dialog("午後に買い物へ行っていた時……\n\nソヤはお前とイルカの事を細かく観察\nしていただろう？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("（確か、ソヤとラファエルが美術館で\n　会話していた時……）", "レン")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("街中で綺麗な女の子を見かけますとレンさんから\n急に薄いピンクの気配がしますのよ。\n首は動かさず目だけを動かして覗いて\nおりましたわ。", "ソヤ")
	await novel_interface.show_dialog("他にも後ろの景色を見るフリをしつつ、\nそこから目線をそらして……\n滑稽にも見てない感じを装えば疑いが晴れると\n思っておりますのよ？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("美術館から出た後、彼女はドールと魔導書に\nついてお前を問い詰めている。", "マリル")
	await novel_interface.show_dialog("その際、彼女も私達に教えてくれたのさ。\n\n教皇庁がどのようにしてドールから回収した\n魔導書の残ページを処理しているのかを。", "マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("魔導……書？ \nそれって書物みたいなモノですわよね……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤがハッと何かを思い出す。")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("この前ドールを殲滅する際、確かに本のページ\nみたいな物を見かけましたわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤが回想しながらそう言った。")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("でもあれは感染性が強すぎますので……\n\n後始末の際に内赦院の者がまとめて燃やすと、\n修道院のマザーは言っておりましたわ。", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("内赦院……？\n（どこかで聞いたような？）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("電気街でベアトリーチェと合流した時、\n彼女は「純粋な匂いがしています」と\nお前達2人に言ったよな？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("迷いのない言葉で語るマリルの間を割って、\n愛衣も口を挟み始める。")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("以前発見していた事だけど、レンちゃんと\nベアトリーチェの体内の放射性同位体は、\n産まればかりの赤ちゃんよりも低かった。", "アイ")
	novel_interface.change_2nd_expression("dizzy")
	await novel_interface.show_dialog("共感覚ってそんな事も分かるのかな？\n\nこれはもう色々実験しなきゃだね……っ！！", "アイ")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("彼女が出してくれた情報を鑑みれば\n推察も容易い。\n\n教会の外で取引を持ち掛けられた時点で、\n私も彼女の意図を汲み取って行動していた。\n考えてみれば悪い事ではないのだが。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは「？？？」になっている俺の頭を\n適当にトントンと叩きながら告げた。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("あの時点で彼女は魔女になると決意して\nいたのだろうな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("――ッ！！？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("最初の内は愛衣に検査されるぐらいならと\n私達に協力的だった。\n自分の身体の秘密がバレる事を恐れて\nいたからだ。", "マリル")
	await novel_interface.show_dialog("しかし後々から、彼女はその秘密と引き換えに、\n2つの要求を改めて提案した。", "マリル")
	await novel_interface.show_dialog("1つ目は自分の行動できる範囲を広めるようにと\n足輪の最大拘束距離の調整を願った。", "マリル")
	await novel_interface.show_dialog("2つ目に彼女はお前とベアトリーチェの関係を\n知りたがった。\nしかも情報の信憑性を確定させるため、\nお前の口から直接な。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("おそらく彼女は気付いたのだろう。\n\n教皇庁は後始末で燃やすと言いながらも、\n裏で封印と称して魔導書を保管している事に。", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("エルガノがお前を治療していた際の、\nあのタイミング──", "マリル")
	await novel_interface.show_dialog("彼女はエルガノの部屋に潜入し、保管していた\n魔導書の残ページを盗み出した。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("ええっ！？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("エルガノの私物を押収しようとした際に\n禁忌の箱と呼ばれているモノの中身が、\n空っぽだったと捜査員から報告を受けている。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("そう言えば、エルガノがソヤに言ってたな……", "レン")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N_Door.png")
	novel_interface.show_character("el","normal")
	await novel_interface.show_dialog("ソヤ……内赦院が封じていた禁忌の箱を\n開いたのはあなたでしたか。", "エルガナ")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("…………", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("……？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("el","normal")
	await novel_interface.show_dialog("あなたはいつも、自身の好奇心を抑えられないの\nですね……", "エルガナ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("衛星の観測記録によると、新豊洲記念教会に\n時空位相波動が発生したんだけど──\n──持続時間はわずか5秒未満。", "アイ")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("魔女の繭を一瞬で蒸発させるなんて……\nあの子やっぱ才能があるんだね～～", "アイ")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("その後も彼女は電話で、ベアトリーチェの\n正体について本人に問い詰めていた。", "マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("えっへんっ！\nレンさんが全部教えてくれましたわよ～～っ！！", "ソヤ")
	await novel_interface.show_dialog("あなたがダンテの詩に登場する人物という事も、\n全てレンさんからお聞きしましたわ～～っ！", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("とは言え、それは彼女にとって本気の\n大博打だったのだろうな……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("まあ、上手くいってくれて良かったよ……", "アイ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("よかった……のか……？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("魔女になるのは相当な覚悟がいるだろう……")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("中央通りでレンちゃんが黒い戦闘服を着た\n連中から奇襲を受けた時、\n何を頼りに包囲を突破したと思う！？", "アイ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣の声が興奮で昂り始める。")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("前回の反省で色々と改造してなかったら、\nまたドローンに搭載したボルツマン探針が、\n爆発を観測して壊れちゃうところだったよ！", "アイ")
