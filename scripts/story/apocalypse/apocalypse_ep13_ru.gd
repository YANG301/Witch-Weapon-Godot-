	await novel_interface.show_dialog("Ой, извини, я не подумал...", "Мальчик в очках")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я сглатываю, понимая, что теперь я девочка и мне не следовало извиняться. Блондин растерянно смотрит вверх, а Соня просто понимающе ухмыляется.")#文字错误
