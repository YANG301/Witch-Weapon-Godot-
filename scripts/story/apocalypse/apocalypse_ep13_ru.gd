	await novel_interface.show_dialog("О?", "Соя")
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Черт, я что, раскрыл свою личность?)", "Лиан")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Ах, ладно, я могу ее нести. Я сильный.", "Соя")
	await novel_interface.show_dialog("Я не бесполезен, как некоторые люди...\nКоторый по уши влюбился в хорошенькую даму... даже пошла кровь из носа...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ой, она точно увидела мой неловкий эпизод!")
