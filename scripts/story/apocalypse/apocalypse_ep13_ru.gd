# apocalypse_ep13.gd - 天启篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第13话剧本
	apocalypse_ep13_script()

func play_script():
	pass

# 天启篇第13话 - 正式剧本
func apocalypse_ep13_script():
	# 开场序章 - 关于疼痛的感受
	novel_interface.show_background("res://assets/images/bg/Soya/Hypnosis2.png")
	await novel_interface.show_text_only("Возможно, вы уже слышали подобные истории...")
	await novel_interface.show_text_only("Солдат замечает, что он уже тяжело ранен, внутренности по всей земле, только после окончания боя. До этого он ничего не чувствовал.")
	await novel_interface.show_text_only("Путешественник чувствует боль в пальцах только после того, как посмотрит вниз и поймет, что они замерзли. До этого он ничего не чувствовал.")
	await novel_interface.show_text_only("Некоторые специалисты по гипнозу могут даже временно «отключить» способность своей цели чувствовать боль.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Потому что боль, в конце концов, субъективна.")
	# 场景转移到小巷
	novel_interface.show_background("res://assets/images/bg/Soya/Dark_alley.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Парень в очках, верный своему слову, хорошо знаком с местностью.")
	await novel_interface.show_text_only("Он ведет нас в ресторан, спрятанный в переулке, приветствует продавца и проводит через кухню к задней двери.")
	await novel_interface.show_text_only("Затем мы проходим еще несколько темных узких переулков, наконец сумев избавиться от настойчивых членов фан-клуба.")
	await novel_interface.show_text_only("Переулки окружены обшарпанными стенами, на которых установлены вентиляторы кондиционеров. Вдоль тропы стоят мусорные баки и торговые автоматы, которые выглядят так, будто в них давно не было никаких действий.")
	await novel_interface.show_text_only("Я не знал, что за яркой улицей Электроники находится целый лабиринт ветхих переулков.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Через несколько минут мы проходим через забор из колючей проволоки и выходим на главную дорогу.")
	
