# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Footage of the hostage rescue mission is all over the Friday early morning news.")
	await novel_interface.show_text_only("As the SID has closed off all escape routes in the area covered by the Aegis, the kidnappers had no choice but to temporarily keep their hostage in an abandoned warehouse.")
	await novel_interface.show_text_only("Four terrorists, suspected for kidnapping a high-up of the United Council, have been arrested. A satisfying end to this incident.")
	await novel_interface.show_dialog("Murder and kidnapping under broad daylight in an international territory—it’s like they’re asking for war with all member nations of the United Congress!", "Lumbert")
	await novel_interface.show_dialog("This incident is evidence to how terrorism is all around us. The recent Spacetime Flux activities may also have something to do with the terrorists.", "Lumbert")
	await novel_interface.show_dialog("As a survivor of the war, I firmly believe that intimidation is an important means to ensure security and peace.", "Lumbert")
	await novel_interface.show_text_only("I scoff as I skip over the interview, which is obviously scripted bullcrap, while I munch on the eightieth potato chip in an hour.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Thith guy... di’n he almosht die? (Munch munch)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Yeah. Didn’t they rescue him just hours ago? And he’s already giving a speech. Hmm. Suspicious...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Still, that part with the helicopters and the rescue team was pretty badass. Like a movie almost.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mm, so cool!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka nods along, face solemn.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("It’s mostly just excellent editing and a great BGM. Who doesn’t like cinematic effects, right?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Due to the important event being held in the city, school starts pretty late these days, at around ten thirty. We also get off classes much earlier.")
	await novel_interface.show_text_only("Annie, Elluka and I are all curled up together on the couch like little hamsters, sharing chips (more like Annie stole them from me).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Wasn’t the intelligence from SID the main reason the rescue was so successful?\nThe news didn’t even credit us...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Intelligence agencies need anonymity to survive, after all. Gotta fly under the radar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Miss Ren...\nWant chocolate...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka’s small head suddenly pokes out between Annie and I.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Chocolate Pocky?\nThe convenience store downstairs seems to have run out. We bought it all.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("I’ll get you some more next time we go to the supermarket.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("But... I want it... now...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pouts, shaking the empty box in front of my face, lower lip wobbling.")
	await novel_interface.show_text_only("But it’s too hot to go outside now. All I want is to stay indoors and enjoy the air conditioning and be a potato.")
	await novel_interface.show_text_only("Mariru has been busy these days. Tons of important figures have arrived in the Agreed Demilitarized Zone after all, to attend the fourth International Forum of Peace.")
	await novel_interface.show_text_only("The scale of the Forum this year is truly impressive. The five Academy Cities besides New Opulentia have each sent hundreds of representatives.")
	await novel_interface.show_text_only("A top-level governmental leader conference to boot. Naturally, it has caused lots of problems in the people’s everyday lives.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("A lot of areas in the city are now temporary bike-free zones. Really inconvenient for us when ordering delivery.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie complains as she scrolls on her phone, sprawled over the couch messily.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Fine, fine, I’ll go get you guys some snacks.\nAnnie, you need me to bring anything?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Hehe...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The two of them promptly list dozens of items, looking totally smug as they do.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Why is it so hot?", "Lian")
	await novel_interface.show_dialog("I’m melting...", "Lian")
	await novel_interface.show_text_only("It’s still early in the day, the supermarket’s just opened, but it’s already sweltering outdoors.")
	await novel_interface.show_text_only("I trudge along, lugging a huge bag of junk food. There seems to be a lot of security personnel milling about on the streets these days.")
	await novel_interface.show_text_only("Lots of transportation restriction zones have been established. Citizens have to carry ID cards at all times.")
	await novel_interface.show_text_only("Police cars and security assistants can be found at every public transport station.")
	await novel_interface.show_text_only("Transportation is mostly restricted in the Agreed Demilitarized Zone. Brand-new surveillance devices have been mounted on all street lamps on main thoroughfare.")
	await novel_interface.show_text_only("I heard that, since the city doesn’t have enough security soldiers, the United Congress has to hire all the mercenaries Ritnalap has to offer.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Still, I guess it’s understandable to be vigilant...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look down from the elevated crossway to see a group of marchers passing by. A cameraman from some news channel is following them, filming the procession.")
	await novel_interface.show_text_only("It hasn’t been long since the war ended. Naturally, all sorts of organizations, groups, and media channels would be excited to find an audience in New Opulentia during such an important event.")
	await novel_interface.show_text_only("The organizations all have different objectives—regional conflicts, racial issues, refugee problems, religion oppression, economic troubles... you name it, there’s an organization that’s screaming about it.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("There are even missionary groups here seeking new followers. Couldn’t they have picked some less chaotic period to do that?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("According to what Mariru told me, the past three International Fora of Peace didn’t go very smoothly either.")
	await novel_interface.show_text_only("The previous one was going to be held in Masada Ford, but they had to move to Salmonton due to the frequent terrorist attacks at the borders.")
	await novel_interface.show_text_only("Then Dr. Deckers announced out of nowhere on last year’s Forum that Salmonton would now be opening its doors to all refugees. That led to a lot of screaming and rioting, of course.")
	await novel_interface.show_text_only("Raphilia had made a politically incorrect comment afterwards, which was why her family ended up sending her to New Opulentia.")
	await novel_interface.show_text_only("As for the year before that... terrorists bombed a whole block in Newmoridas. Even sent military helicopters.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("That must have been horrible...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Two days ago, Skuld was invited to a charity event in the embassy area and made a generous donation to starving children in South America.")
	await novel_interface.show_text_only("Coincidentally, a vegan organization from Europe happened to be protesting the slaughtering of animals outside the venue.")
	await novel_interface.show_text_only("Some of them stripped down and lay on the ground, simulating pieces of steak.")
	await novel_interface.show_text_only("We watched a maid pour a pot of purplish sauce, complete with squid tentacles, on a “steak” from the live coverage on TV.")
	await novel_interface.show_text_only("The unfortunate “steak” clambered away on all fours, screeching on the top of her lungs.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("And today, the organization’s official website posted a statement, claiming that their members have been heavily traumatized.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Hahaha...\n(I hope Fabella realizes how terrible her cooking is now!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, my phone vibrates in my bag.\nMariru has sent a message.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Hm. Report in at the headquarters today, huh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Ten hours ago>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, SID control room>")
	await novel_interface.show_text_only("A redheaded woman in a military outfit stands with her arms crossed over her chest, glaring at the dozen red brackets moving rapidly on the black-and-white screen.")
	await novel_interface.show_text_only("A chat window suddenly pops up from the lower part of the screen.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Boss, according to our records, the hostage Sir Lumbert is still located somewhere covered by the Aegis.", "SID Agent")
	await novel_interface.show_dialog("Our surveillance backtrack analysis tells us that the kidnapper is most likely in one of these three areas. An abandoned warehouse in the Bay Area has been displaying abnormal electricity consumption activity...", "SID Agent")
	await novel_interface.show_dialog("Should we inform the Defense Bureau?", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Not yet. Surround the area and wait for my orders.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Roger that.", "SID Agent")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Closing the window, Mariru switches to the military chat channel.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("The mountainous area is up ahead. Keep the helicopter at a safe altitude, don’t let them notice us.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Got it. We’ve got clear images from the heat-sensing satellite.", "Soldier A")
	await novel_interface.show_dialog("They’re moving so quickly... are those really humans?", "Soldier A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Technically.. they were once humans. Just not anymore.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Has everyone in the direction they’re heading in been evacuated? If something abnormal occurs—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Our cannons and regional destruction weapons are at the ready.", "Soldier B")
	await novel_interface.show_text_only("Mariru nods. She doesn’t want to leak too much to the military.")
	await novel_interface.show_text_only("Besides, she’s had a bad feeling about this ever since the beginning of this tracking mission...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(We usually deal with those “witches” that appear outside downtown New Opulentia by forcefully annihilating them with the heavy firearms the military’s set in the area in advance.)", "Mariru")
	await novel_interface.show_dialog("(According to past experiences, those things usually randomly attack nearby living beings or facilities after their witch cocoons disappear.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(But during the past two weeks, they seem to be displaying a sort of identical pattern...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Wait... there’s someone up ahead!", "Soldier A")
	await novel_interface.show_dialog("Carrying a chainsaw too. Maybe a lumberjack?", "Soldier B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiot, what lumberjack works at eleven p.m.?\nWhat are the results of the meme test?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Green. It’s human!", "Soldier A")
	await novel_interface.show_dialog("And... a human girl, too?", "Soldier B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru immediately zooms in on the captured footage.")
	await novel_interface.show_text_only("On the thermal imaging screen, there’s a little girl wearing a bandanna and carrying a chainsaw almost as big as she is.")
	await novel_interface.show_text_only("And she’s waving at those speedily dashing witches.")
	await novel_interface.show_text_only("The leading witches, alerted by the sound of the whirring chainsaw, change coure and lead the pack over in her direction.")
	await novel_interface.show_text_only("A witch colony this size can usually only be taken down by a squad of heavily armored and experienced machine-gun wielders. The girl doesn’t stand a chance.")
	await novel_interface.show_text_only("But before Mariru can even alert the cleanup team to collect the girl’s corpse later, the girl simply turns to face the witches, beaming, chainsaw in hand.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("She adjusts her pace and posture as countless witches come zooming by, dodging their attacks skillfully while also cutting the incoming witches apart.")
	await novel_interface.show_text_only("The witches, like fresh meat stuffed into a heavy-duty shredder, end up as tiny bits of flesh.")
	await novel_interface.show_text_only("The girl smoothly moves and attacks, utilizing the laws of inertia and centrifugal force to her advantage. She doesn’t seem to be extraordinarily strong—just has physics on her side.")
	await novel_interface.show_text_only("She had probably done some calculation beforehand and selected the chainsaw as the most effective weapon according to the characteristics of the targets and her own strength.")
	await novel_interface.show_text_only("Within thirty seconds, those dozens of witches, which the SID and the military had been tracking for four days, are now nothing but shredded meat.")
	await novel_interface.show_dialog("W-what do we do now?", "Soldier A")
	await novel_interface.show_text_only("Mariru heaves a sigh.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Dang...", "Mariru")
	await novel_interface.show_dialog("Spotlights on. Hellfire missile ready—", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Try to talk to her with a loudspeaker. Tell her she’s surrounded. If she dares to move, blast her to pieces along with this mountain.", "Mariru")
	await novel_interface.show_dialog("Bring her back alive!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<A few hours later, SID interrogation room>")
	await novel_interface.show_text_only("Next to the one-way mirror, Mariru flips through the file of the target on her handheld device.")
	await novel_interface.show_text_only("Name: Sonya Angeles")
	await novel_interface.show_text_only("Age: 14...?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organization...", "Mariru")
	await novel_interface.show_dialog("Salmonton Church Special District, CDF.", "Mariru")
	await novel_interface.show_dialog("That used to be a religious courthouse, right?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru taps a button and the glass goes clear. A girl, clad in a nun outfit, meets her with silent, docile eyes on the other side.")
	await novel_interface.show_text_only("Her petite body is concealed under her heavy black velvet dress, held together with a dark-red brooch.")
	await novel_interface.show_text_only("Instead of a nun’s hat, she has a pair of cat ears on her head. Seems to suit her well.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Long, sleek silver hair, azure eyes. Should’ve been cute, but that eerily cold and nonchalant smile on her face—sharp, chilling.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru skims through the related reports and notes the row of red font in the bottom—")
	await novel_interface.show_text_only("This person is protected under the special conditions of the Salmonton Agreement and cannot be held by any organization belonging to a United Congress member nation for over twelve hours.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Hey. The investigation order the New Opulentia military has against you is already cancelled.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("Oh? Good.\nI was so scared!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("They should be the ones who are scared. That soldier who just brought you in even applied for a C-grade memory removal operation...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The silver-haired girl, hands chained, licks her lips, grinning in excitement.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Eh, they just stank so bad, you know? But I didn’t even hurt them.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Anyway, are you gonna interrogate me? At least you smell really nice!", "Soya")# 换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl studies Mariru with much interest.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Oh? Sonya, right?", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Interrogating people is my... “expertise”.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru starts looking excited too.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("But still, before that...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl cocks her head to one side, watching Mariru pull out her ID from a file bag in innocent curiosity.")
	await novel_interface.show_text_only("The card is framed in a classy, retro-style pattern, completely different from that of Academy City ID cards. The card itself is black, carved with golden symbols that represent the religious courthouse.")
	await novel_interface.show_text_only("On the flip side, the information section is all blank, the data only visible via biology fingerprint technology.")
	await novel_interface.show_text_only("Mariru taps a sample of Sonya’s prints on the ID card, and a row of intricate, elegant golden font materializes on the card’s smooth surface.")
	await novel_interface.show_text_only("“Reason, order, conquest.”")
	await novel_interface.show_text_only("The script fades away, and three additional rows of text appear.")
	await novel_interface.show_text_only("“A knight who carries out the will of the god—”")
	await novel_interface.show_text_only("“Sonya Angeles”")
	await novel_interface.show_text_only("“Issued by: Callistus IV”")
	await novel_interface.show_text_only("An ID card boasting a signature from the Pope himself. No wonder Sonya isn’t afraid of anything.")
	await novel_interface.show_text_only("This fourteen-year-old girl in front of Mariru is an officially certified professional in dealing with Substance H contaminations and related issues.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("A Judgment Knight. Authorized to directly remove all infected targets that can potentially be dangerous, without needing permission.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Yep. That’s me!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At the end of the Seven Years War, due to the church’s special contribution to dealing with Substance H contaminations...")
	await novel_interface.show_text_only("The United Congress has decided to grant certain agents the highest immunity ever seen in the six Academy Cities.")
	await novel_interface.show_text_only("According to the Salmonton Agreement, this type of religious “purification” cannot be regulated by laws in our world.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("So, like a special agent working under the church, huh...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Solving the tricky “Substance H contamination” issue troubling all nations, in the name of God. A very clever design indeed.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Yeah...\nWitches, werewolves, zombies, demons, vampires, all that riff-raff...", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("I purify them all!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya smiles, innocent, sweet, utterly chilling.")
	
	print("=== 天启篇第02话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
