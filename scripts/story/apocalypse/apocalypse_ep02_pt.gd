# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Imagens da missão de resgate de reféns estão em todos os noticiários da manhã de sexta-feira.")
	await novel_interface.show_text_only("Como o SID fechou todas as rotas de fuga na área coberta pelo Aegis, os sequestradores não tiveram escolha senão manter temporariamente os seus reféns num armazém abandonado.")
	await novel_interface.show_text_only("Quatro terroristas, suspeitos de sequestrar um alto escalão do Conselho Unido, foram presos. Um final satisfatório para este incidente.")
	await novel_interface.show_dialog("Assassinatos e sequestros em plena luz do dia num território internacional – é como se estivessem pedindo guerra a todas as nações membros do Congresso Unido!", "Lumbert")
	await novel_interface.show_dialog("Este incidente é uma prova de como o terrorismo está ao nosso redor. As recentes atividades do Spacetime Flux também podem ter algo a ver com os terroristas.", "Lumbert")
	await novel_interface.show_dialog("Como sobrevivente da guerra, acredito firmemente que a intimidação é um meio importante para garantir a segurança e a paz.", "Lumbert")
	await novel_interface.show_text_only("Eu zombo enquanto pulo a entrevista, que é obviamente uma besteira roteirizada, enquanto mastigo a octogésima batata frita em uma hora.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Esse cara... ele quase morreu? (Mastigar, mastigar)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Sim. Eles não o resgataram há poucas horas? E ele já está fazendo um discurso. Hum. Suspeito...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Ainda assim, aquela parte com os helicópteros e a equipe de resgate foi bem foda. Quase como um filme.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Hum, que legal!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka acena com a cabeça, com expressão solene.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Na maior parte, é apenas uma edição excelente e um ótimo BGM. Quem não gosta de efeitos cinematográficos, certo?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Devido ao importante evento que está sendo realizado na cidade, as aulas começam bem tarde hoje em dia, por volta das dez e meia. Também saímos das aulas muito mais cedo.")
	await novel_interface.show_text_only("Annie, Elluka e eu estamos todos enrolados no sofá como pequenos hamsters, compartilhando batatas fritas (mais como se Annie as tivesse roubado de mim).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Não foi a informação do SID a principal razão pela qual o resgate foi tão bem-sucedido?\nA notícia nem nos deu crédito...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Afinal, as agências de inteligência precisam do anonimato para sobreviver. Tenho que voar sob o radar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Senhorita Ren...\nQuer chocolate...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A cabecinha de Elluka de repente aparece entre Annie e eu.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Pocky de chocolate?\nA loja de conveniência lá embaixo parece ter acabado. Compramos tudo.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Vou pegar mais para você na próxima vez que formos ao supermercado.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Mas... eu quero... agora...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka faz beicinho, balançando a caixa vazia na frente do meu rosto, o lábio inferior balançando.")
	await novel_interface.show_text_only("Mas está muito quente para sair agora. Tudo que eu quero é ficar em casa e aproveitar o ar condicionado e ser uma batata.")
	await novel_interface.show_text_only("Mariru tem estado ocupada ultimamente. Afinal, toneladas de figuras importantes chegaram à Zona Desmilitarizada Acordada, para participar no quarto Fórum Internacional da Paz.")
	await novel_interface.show_text_only("A escala do Fórum este ano é verdadeiramente impressionante. As cinco Cidades Acadêmicas, além de Nova Opulentia, enviaram centenas de representantes cada uma.")
	await novel_interface.show_text_only("Para começar, uma conferência de líderes governamentais de alto nível. Naturalmente, tem causado muitos problemas na vida quotidiana das pessoas.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Muitas áreas da cidade são agora zonas temporárias livres de bicicletas. Realmente inconveniente para nós ao solicitar a entrega.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie reclama enquanto mexe no telefone, esparramada no sofá de maneira bagunçada.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Tudo bem, tudo bem, vou pegar alguns lanches para vocês.\nAnnie, você precisa que eu traga alguma coisa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Hehe...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Os dois prontamente listam dezenas de itens, parecendo totalmente presunçosos.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Por que está tão quente?", "Lian")
	await novel_interface.show_dialog("Estou derretendo...", "Lian")
	await novel_interface.show_text_only("Ainda é cedo, o supermercado acabou de abrir, mas já está um calor lá fora.")
	await novel_interface.show_text_only("Ando em frente, carregando um enorme saco de junk food. Parece haver muito pessoal de segurança circulando pelas ruas atualmente.")
	await novel_interface.show_text_only("Muitas zonas de restrição de transporte foram estabelecidas. Os cidadãos devem portar carteiras de identidade o tempo todo.")
	await novel_interface.show_text_only("Carros de polícia e assistentes de segurança podem ser encontrados em todas as estações de transporte público.")
	await novel_interface.show_text_only("O transporte é principalmente restrito na Zona Desmilitarizada Acordada. Dispositivos de vigilância totalmente novos foram montados em todos os postes de iluminação das vias principais.")
	await novel_interface.show_text_only("Ouvi dizer que, como a cidade não tem soldados de segurança suficientes, o Congresso Unido tem de contratar todos os mercenários que Ritnalap tem para oferecer.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Ainda assim, acho que é compreensível estar vigilante...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho para baixo do cruzamento elevado e vejo um grupo de manifestantes passando. Um cinegrafista de algum canal de notícias os segue, filmando a procissão.")
	await novel_interface.show_text_only("Não faz muito tempo que a guerra terminou. Naturalmente, todos os tipos de organizações, grupos e canais de mídia ficariam entusiasmados em encontrar um público na Nova Opulência durante um evento tão importante.")
	await novel_interface.show_text_only("Todas as organizações têm objectivos diferentes – conflitos regionais, questões raciais, problemas de refugiados, opressão religiosa, problemas económicos... você escolhe, há uma organização que está gritando sobre isso.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Existem até grupos missionários aqui em busca de novos seguidores. Eles não poderiam ter escolhido um período menos caótico para fazer isso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Segundo o que Mariru me contou, os últimos três Fóruns Internacionais de Paz também não correram muito bem.")
	await novel_interface.show_text_only("O anterior seria realizado em Masada Ford, mas tiveram que se mudar para Salmonton devido aos frequentes ataques terroristas nas fronteiras.")
	await novel_interface.show_text_only("Então o Dr. Deckers anunciou do nada no Fórum do ano passado que Salmonton abriria agora as suas portas a todos os refugiados. Isso gerou muitos gritos e tumultos, é claro.")
	await novel_interface.show_text_only("Raphilia fez um comentário politicamente incorreto depois, e foi por isso que sua família acabou mandando-a para Nova Opulentia.")
	await novel_interface.show_text_only("Quanto ao ano anterior... terroristas bombardearam um quarteirão inteiro em Newmoridas. Até enviou helicópteros militares.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Deve ter sido horrível...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Há dois dias, Skuld foi convidado para um evento de caridade na área da embaixada e fez uma doação generosa para crianças famintas na América do Sul.")
	await novel_interface.show_text_only("Coincidentemente, uma organização vegana da Europa estava protestando contra o abate de animais fora do local.")
	await novel_interface.show_text_only("Alguns deles despiram-se e deitaram-se no chão, simulando pedaços de bife.")
	await novel_interface.show_text_only("Vimos uma empregada derramar uma panela de molho arroxeado, com tentáculos de lula, em um “bife” da cobertura ao vivo da TV.")
	await novel_interface.show_text_only("O infeliz “bife” saiu de quatro, gritando a plenos pulmões.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("E hoje, o site oficial da organização publicou um comunicado, alegando que seus membros ficaram gravemente traumatizados.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Hahaha...\n(Espero que Fabella perceba o quão terrível é sua comida agora!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, meu telefone vibra na minha bolsa.\nMariru enviou uma mensagem.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Hum. Apresente-se na sede hoje, hein?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Dez horas atrás>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23h15, sala de controle do SID>")
	await novel_interface.show_text_only("Uma mulher ruiva em traje militar está com os braços cruzados sobre o peito, olhando para a dúzia de colchetes vermelhos que se movem rapidamente na tela em preto e branco.")
	await novel_interface.show_text_only("Uma janela de bate-papo aparece repentinamente na parte inferior da tela.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Chefe, de acordo com nossos registros, o refém Sir Lumbert ainda está localizado em algum lugar coberto pelo Aegis.", "Agente SID")
	await novel_interface.show_dialog("Nossa análise de vigilância nos diz que o sequestrador provavelmente está em uma dessas três áreas. Um armazém abandonado na Bay Area tem apresentado atividade anormal de consumo de eletricidade...", "Agente SID")
	await novel_interface.show_dialog("Devemos informar o Departamento de Defesa?", "Agente SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ainda não. Cerque a área e aguarde minhas ordens.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Rogério isso.", "Agente SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fechando a janela, Mariru muda para o canal de chat militar.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("A área montanhosa está à frente. Mantenha o helicóptero em uma altitude segura, não deixe que nos notem.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Entendi. Temos imagens nítidas do satélite com detecção de calor.", "Soldado A")
	await novel_interface.show_dialog("Eles estão se movendo tão rapidamente... serão realmente humanos?", "Soldado A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Tecnicamente... eles já foram humanos. Só que não mais.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Todos na direção em que estão indo foram evacuados? Se algo anormal ocorrer—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nossos canhões e armas de destruição regional estão prontos.", "Soldado B")
	await novel_interface.show_text_only("Mariru assente. Ela não quer vazar muito para os militares.")
	await novel_interface.show_text_only("Além disso, ela tem um mau pressentimento sobre isso desde o início desta missão de rastreamento...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Normalmente lidamos com aquelas “bruxas” que aparecem fora do centro de Nova Opulentia, aniquilando-as à força com as armas de fogo pesadas que os militares colocaram na área com antecedência.)", "Mariru")
	await novel_interface.show_dialog("(De acordo com experiências anteriores, essas coisas geralmente atacam aleatoriamente seres vivos ou instalações próximas depois que seus casulos de bruxa desaparecem.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Mas durante as últimas duas semanas, eles parecem estar exibindo um padrão idêntico...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Espere... tem alguém na frente!", "Soldado A")
	await novel_interface.show_dialog("Carregando uma motosserra também. Talvez um lenhador?", "Soldado B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiota, que lenhador trabalha às onze da noite?\nQuais são os resultados do teste do meme?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verde. É humano!", "Soldado A")
	await novel_interface.show_dialog("E... uma garota humana também?", "Soldado B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru imediatamente amplia a filmagem capturada.")
	await novel_interface.show_text_only("Na tela de imagem térmica, há uma garotinha usando bandana e carregando uma motosserra quase do seu tamanho.")
	await novel_interface.show_text_only("E ela está acenando para aquelas bruxas velozes e arrojadas.")
	await novel_interface.show_text_only("As bruxas líderes, alertadas pelo som do zumbido da motosserra, mudam de coragem e conduzem o bando em sua direção.")
	await novel_interface.show_text_only("Uma colônia de bruxas desse tamanho geralmente só pode ser derrubada por um esquadrão de usuários de metralhadoras experientes e fortemente blindados. A garota não tem chance.")
	await novel_interface.show_text_only("Mas antes que Mariru possa alertar a equipe de limpeza para recolher o cadáver da garota mais tarde, a garota simplesmente se vira para encarar as bruxas, radiante, com a motosserra na mão.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ela ajusta seu ritmo e postura conforme inúmeras bruxas passam voando, esquivando-se de seus ataques habilmente e ao mesmo tempo separando as bruxas que chegam.")
	await novel_interface.show_text_only("As bruxas, como carne fresca enfiada em um triturador resistente, acabam como pedacinhos de carne.")
	await novel_interface.show_text_only("A garota se move e ataca suavemente, utilizando as leis da inércia e da força centrífuga a seu favor. Ela não parece ser extraordinariamente forte – apenas tem a física ao seu lado.")
	await novel_interface.show_text_only("Ela provavelmente já havia feito alguns cálculos e selecionado a motosserra como a arma mais eficaz de acordo com as características dos alvos e sua própria força.")
	await novel_interface.show_text_only("Em trinta segundos, aquelas dezenas de bruxas, que o SID e os militares vinham rastreando há quatro dias, agora não passam de carne desfiada.")
	await novel_interface.show_dialog("O-o que fazemos agora?", "Soldado A")
	await novel_interface.show_text_only("Mariru solta um suspiro.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Droga...", "Mariru")
	await novel_interface.show_dialog("Holofotes acesos. Míssil Hellfire pronto—", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Tente falar com ela pelo alto-falante. Diga a ela que ela está cercada. Se ela se atrever a se mover, destrua-a em pedaços junto com esta montanha.", "Mariru")
	await novel_interface.show_dialog("Traga-a de volta viva!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<Algumas horas depois, sala de interrogatório do SID>")
	await novel_interface.show_text_only("Ao lado do espelho unidirecional, Mariru folheia o arquivo do alvo em seu dispositivo portátil.")
	await novel_interface.show_text_only("Nome: Sonya Angeles")
	await novel_interface.show_text_only("Idade: 14...?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organização...", "Mariru")
	await novel_interface.show_dialog("Distrito Especial da Igreja de Salmonton, CDF.", "Mariru")
	await novel_interface.show_dialog("Aquilo costumava ser um tribunal religioso, certo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru aperta um botão e o vidro fica transparente. Uma menina, vestida de freira, encontra-a com olhos silenciosos e dóceis do outro lado.")
	await novel_interface.show_text_only("Seu corpo pequeno está escondido sob seu pesado vestido de veludo preto, preso por um broche vermelho escuro.")
	await novel_interface.show_text_only("Em vez de um chapéu de freira, ela tem um par de orelhas de gato na cabeça. Parece combinar bem com ela.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Cabelo prateado longo e elegante, olhos azuis. Deveria ter sido fofo, mas aquele sorriso estranhamente frio e indiferente em seu rosto era afiado, arrepiante.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru folheia os relatórios relacionados e observa a linha de fonte vermelha na parte inferior—")
	await novel_interface.show_text_only("Esta pessoa está protegida pelas condições especiais do Acordo de Salmonton e não pode ser detida por qualquer organização pertencente a um país membro do Congresso Unido por mais de doze horas.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Ei. A ordem de investigação que os militares da Nova Opulentia têm contra você já foi cancelada.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("Ah? Bom.\nEu estava com tanto medo!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Eles deveriam ser os que estão com medo. Aquele soldado que acabou de trazer você até solicitou uma operação de remoção de memória de grau C...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A garota de cabelos grisalhos, com as mãos acorrentadas, lambe os lábios, sorrindo de excitação.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Eh, eles fediam tanto, sabe? Mas eu nem os machuquei.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("De qualquer forma, você vai me interrogar? Pelo menos você cheira muito bem!", "Soya")# 换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A menina estuda Mariru com muito interesse.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ah? Sônia, certo?", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Interrogar pessoas é a minha... “expertise”.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru também começa a ficar animada.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Mas ainda assim, antes disso...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A garota inclina a cabeça para o lado, observando Mariru tirar sua identidade de uma pasta de arquivo com uma curiosidade inocente.")
	await novel_interface.show_text_only("O cartão é emoldurado em um padrão elegante de estilo retrô, completamente diferente dos cartões de identificação da Academy City. O cartão em si é preto, esculpido com símbolos dourados que representam o tribunal religioso.")
