	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("まあ、マノーラによる仕業って可能性も\n考えられるけど……", "テレサ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("忍び込んで殺害した上、自殺に偽装するなんて\nあいつらレベルにできるわけがないわね。", "テレサ")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("まさか脅されていた……？", "ラファエル")
	await novel_interface.show_dialog("それとも最初から彼は捨て駒だったのか……", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("cereza","smile")
	await novel_interface.show_dialog("根拠のない推測はするもんじゃないさ……\n\n……とにかく。\nお利口さんは私の言う事を聞いてね～～", "テレサ")
	await novel_interface.show_dialog("連合議会本部が在る中央通りは抗議の群衆で、\nもうそろそろ制御不能になるわ。", "テレサ")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("それに……\nあんたはお爺さんと約束したじゃないか……", "テレサ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("セレサはラファエルの背中を叩き、\n耳元でささやく。")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("（セレサって見た感じだとヨーロッパの人\n　じゃないよね？）\n（しかも日本刀を持って街を歩くなんて、\n　人目を引くどころじゃ……）", "レン")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("（大使館区域の周辺なら、こういうのに関する\n　チェックは厳しくないけどさ）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルはセレサへ頷くと、みんなに1階へ\n降りるよう合図をした。")
	
