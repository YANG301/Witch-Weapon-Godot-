	await novel_interface.show_dialog("……そうですの。", "ソヤ")
	await novel_interface.show_text_only("彼女の声はとても小さい。\n下を向いて、声が少し震えていた。")
	await novel_interface.show_dialog("私もお教えしますね。先ほどセレサさんによって\nあなたが腕を振るった時……", "ソヤ")
