	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("──数週間前。")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("前に捕獲したドールなんだけど播磨脳研が脳を\nスキャンしてみたらしいわ。\nそのスキャン結果で面白い事が分かったよ～～", "アイ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("この間、北の方の山がある所で捕まえた奴らか？\n\n捕獲するのに軍部が「かなりの代償」を払った\nって聞いたけど……", "レン")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（俺の任務はイージス範囲内の異変を処理する\n　事だけで本当に良かったよ……）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("拘束具を作成するのには苦労したんだけどね……\n\n過程はさておき、結果から教えて進ぜよう～～", "アイ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("その1。ドールは脳に身体を支配されているけど\n脳は身体の物理限界を全く考慮しない。", "アイ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Hypnosis.png")
	await novel_interface.show_dialog("通常の人間は自己を保護するために、意識的な\n限界値を身体に設定するの。\nまあ催眠などの方法を用いると、一時的に解除は\nできるけどね。", "アイ")
	await novel_interface.show_dialog("限界を超えた力があれば、頭と足の先っぽだけに\n支えを置いたとしても、\n宙に浮いてるのかと勘違いできるぐらい\n寝そべる事が可能よ。", "アイ")
	await novel_interface.show_dialog("同時に数10キロの圧力を腹部にかけても、\nきっと耐えられると思うわね。\n意識がある時の人間には到底できない芸当だわ。", "アイ")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("ドールの脳は身体を消耗品として見ている。\n\n超人的な瞬発力は得られるけど、\n結果として肉体の損耗は計り知れないわ。", "アイ")
