# apocalypse_ep07.gd - 天启篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第07话剧本
	apocalypse_ep07_script()

func play_script():
	pass

# 天启篇第07话 - 正式剧本
