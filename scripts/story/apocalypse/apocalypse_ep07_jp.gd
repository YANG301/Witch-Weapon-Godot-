	await novel_interface.hide_character()
	await novel_interface.show_text_only("自分は少し調子に乗り過ぎていた事に気付いた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("今日の午後からは興味が尽きない事ばかりで\n仕方ありませんわ……", "ソヤ")
	await novel_interface.show_dialog("あのセレサさん、\nラファエルさんにイルカちゃん……", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("（あの……3人？）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("彼女達はドールと似たような気配を持って\nいますのに……\n人間としての色も保っておりますの。", "ソヤ")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("──今までわたくしが知っていた存在とは、\n少し彼女達は違いますわよね？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは人差し指と中指で俺の心臓の位置を指す。\n\nその冷たい視線は明確なメッセージを\n含んでいた。")
	await novel_interface.show_text_only("「嘘を吐いたら、覚悟しなさい」と。")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("つまりセレサも……魔女だというのか？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("……魔女？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤの顔を見ながら、俺は慎重に言葉を紡ぐ。")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("魔法の『知識』を手に入れたと同時に、\n理性を保つ事ができている女性の呼び名だよ。", "レン")
	await novel_interface.show_dialog("多くの人は魔法の知識の情報量に耐えられず、\n理性を失ってドールへとなってしまう。", "レン")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("それが両者の違い……かな、多分。", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤはしばらく俺の目を見つめると、\n続けて尋ねる。")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("理性を失った人というのは、元に戻せませんの？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("確か理論上は不可能だって愛衣が言ってた。", "レン")
	await novel_interface.hide_character()
	
