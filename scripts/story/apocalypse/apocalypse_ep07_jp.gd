	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("外はちょうど暗くなり始めたばかりで、\n街灯がライトアップを開始していた。\n暖色の灯りが電気街の賑わいを引き立てている。")#不确定
	novel_interface.show_character("iluka_uniform","speechless")
	await novel_interface.show_dialog("わぁお──", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("人だらけだ……", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("この近くで何かイベントでもやっているの\nかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("先ほど調べてみましたが、先日から行われていた\n交通制限によって、\nこの街では休業になっていた店舗が多く\nありました。", "随行員")
	await novel_interface.show_dialog("昨晩、予定より早く規制が解除されたため、\n来週の月曜日に予定していた、\n営業再開イベントが本日に早まった\nとの事です。", "随行員")
	await novel_interface.show_dialog("イベント内容は、とあるアニメの限定グッズを\n無料で配布しているみたいですね。", "随行員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("ま、まさか……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("街中の多くの人が「通行止め」と書かれた\n黄色い旗を持っている事に俺は気付いた。\nそれは最近、物凄く人気があるアニメの小道具。")
	await novel_interface.show_text_only("幼稚園児の服装で旗を持って、懸命に仕事を\n頑張る可愛い少女達。\nその姿は多くの人の心を魅了した。\n……例えば俺の。")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("（ああ、あの作品だよアレは！！！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──思わず興奮してくる。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("んん？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("（や、やっぱり黙っておこう……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は手慣れた感じに息をひそめて引っ込んだ。")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("それじゃあ、私はもう帰るわね？ \n\nあんた達もこの辺をうろつくのは、ほどほどで\n止めときなさい。", "ラファエル")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("今夜は恐らく……平和には終わらないわよ……", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルはビー玉ぐらいの大きさをした、\n緑色の宝石を俺の手に押し込んできた。")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("それはハインリッヒが作った物よ。\n多少の怪我を治すぐらいには使えるわ。", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは少し恥ずかしそうに視線を背ける。")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("あ……ハインリッヒか……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言えば俺の事を「マスター」って呼んでくる\nあの錬金術士には、しばらく会ってないな。")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("（最近メイド服を着て「ご主人様」って言う\n　俺を見たら、彼女はどう思うだろうか……）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("とにかく気を付けなさい。", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の返事も待たずに、お嬢様とセレサ達は\n足早に去っていった。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("彼女達の後ろ姿が電気街の人混みに\n消えていくのを、俺達は見送る。")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("あらまぁ……彼女、わたくしを叩く時に\n使った本をしっかりと握っていますわね。", "ソヤ")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("歩くのが早かったわけだ！！\n(え、あの本どうするの！?)")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("あ、ところでさ、俺達はイベントを見てから\n帰るって感じ────ゴハッ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("限定グッズの入手を企んでいた俺だったが、\n突然ソヤに街角の壁へと押し付けられた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("ね～え？ 先ほどの電撃はと～っても\n楽しかったですわよねぇ～～……", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("ひィィィィっ！？\nご、ごめんなさいぃっ！！", "レン")
