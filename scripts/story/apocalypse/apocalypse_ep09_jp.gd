	await novel_interface.hide_character()
	await novel_interface.show_text_only("パトロールから帰ってきたであろう保安警察が\nこちらへと接近してきた。\nソヤはすでに察知していたのか、気が付くと\n道端の影に消えている。")
	await novel_interface.show_text_only("警察官が訝しげな目で俺を上から下と眺める。")
	await novel_interface.show_dialog("全く……最近じゃこういう事をする女性の\n年齢がどんどん若くなってきているな……\n君、身分証明書を提示しなさい！", "警備員")
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("（おいおい俺は違うぞ！！）\n\n（あんたが考えているソレとは違うから！！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("どうしよう……\nソヤの奇襲に期待しているんだけど……")
	await novel_interface.show_text_only("……彼女から動く気配は一切感じられない。")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("えっと……\nあの……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こうなったら可愛い子ぶるしかない。\n\nもじもじとスカートの裾を掴み、困ったような\n顔をして小さく話し始める──")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("わたし……クラスメートと遊びに来たら……\nはぐれちゃって……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("今まで培ってきたブリっ子技術を駆使し、\n泣きそうな声色に調整。\n必死の無害アピールだ。")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("は、早く帰らないと、ママが心配しちゃう……", "レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（このままイルカがいない状態で帰っても\n　絶対マリルママに殺されちゃうけどね！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そんな俺の反応を彼は予期してなかったようだ。\n\n潤んだ瞳を見て、彼は戸惑いを隠せない。")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("（一体何してるんだろう……俺……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そうしている内に後ろに隠れていたソヤが\nやっと姿を現した。\n保安警察の背中に針を突き刺して、\n彼を無力化する。")
	await novel_interface.show_text_only("針を回収すると、猫撫で声で俺の真似をした──")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("は、早く帰らないと、\nママが心配しちゃうぅ～～♡", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("うるさい！！ わざと見ていたなッ！？", "レン")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("また1人警察を倒しちゃったし……\nこれでもう一度捕まりでもしたら……ッ！", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("捕まったら、わたくしに誘拐されたと言えば\n宜しいのですわよ？\nあの方々がわたくしをどうこうするなど\n不可能ですもの～～♪", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言いながら、針を折り畳んでマントに\n付け直すソヤ。")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("その針に何を仕込んでいるんだ……？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("この針にはフグから抽出した毒素を塗って\nおりますの。\n人の筋肉を麻痺させますけど、心臓や呼吸器官に\n影響は及ぼしませんわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは得意げに説明してくれる。")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("毒が継続する間は動けないし喋れませんが……\n\n頭は完全に覚醒しておりまして、\n五感もちゃんと正常なまま──", "ソヤ")
	novel_interface.change_expression("relieve")
	await novel_interface.show_dialog("つまり感じる事はできますが、身動きは取れない\n状態なのですわ……♡", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("なんて言いながら期待した目でこっちを\n見ないでくれっ！")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("そんな危険物…マリルに没収されなかったのか？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("あのメスゴリラ！！ \n\nもっと危険な奴を用意して、わたくしを監視して\nいたじゃありませんのっ！", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("そうだ！ イルカ……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("もうこんな時間だし、イルカが今も1人で街中を\n彷徨ってると考えたら心配になってくる。")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("電気街を探してみませんこと？ \nあそこは騒ぎになっているようですわねぇ……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ネオン通りを指差すソヤ。\nどうやら人波から異様な色を感知したようだ……")
	await novel_interface.hide_background()
	novel_interface.change_music("")
	await novel_interface.show_text_only("──同時刻、協定非武装地域内。")
	await novel_interface.show_text_only("──スカイホテル。")
	
	# scene3 - 天空酒店对话
	novel_interface.show_background("res://assets/images/bg/SkyHotel/Soya_Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("白い法衣を纏った老体がラウンジに到着すると、\n若き従者の2人に外で待つよう合図を送った。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("チェンナイから遥々お越しいただき、\n誠にありがとうございます。\n貴殿のご昇進をお祝いする機会が中々ありません\nでしたので──\n──南インド聖公会、ミラー大主教……", "ランバート")
