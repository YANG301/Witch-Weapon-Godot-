# apocalypse_ep09.gd - 天启篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第09话剧本
	apocalypse_ep09_script()

func play_script():
	pass

# 天启篇第09话 - 正式剧本
func apocalypse_ep09_script():
	# scene1 - 拘留室越狱
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Cells.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("ソヤが持っているボタンの針を見る。\n\n続けて金属扉の鍵穴を観察する。")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("鍵穴を……こじ開けるつもりなのか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("留置施設内には少なくとも4台の監視カメラが\n設置されており、\nあの鍵も針1本で簡単にこじ開けられる代物\nじゃないと思うけど……")
	await novel_interface.show_text_only("ソヤは俺を無視して壁際に座っている\n筋肉男の前へ軽やかに歩いていく。\nそして相手の顔を無垢な目で見つめた。")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("……はっ？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("あらま、あなたのお顔に……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは自分の頬を指差して、\n「あなたのここに何か付いてますよ」と\n伝えるかのようなジェスチャーをした。")
	await novel_interface.show_text_only("ジェスチャーが伝わったのか、男は自分の頬を\n擦る。")
	await novel_interface.show_text_only("それに対してソヤは首を横に振り、\n拭いてあげるからと微笑みながら手を伸ばす。\n筋肉質な男が少し照れくさそうな表情になった。")
	await novel_interface.show_text_only("ソヤは身を乗り出して手を伸ばし……\n\nもう片方の手を使い、男の太ももにボタンの針を\n打ち込んだ。")
	await novel_interface.show_text_only("気付いた男は大声でソヤを罵倒しようとする。\n\nしかし針を打たれた瞬間に立ち上がれなくなり、\n口からも声が出なくなってしまっていた。")
	await novel_interface.show_text_only("それからソヤは突然の出来事に慌てふためく、\nか弱い女性を演じ始める──")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("こ、この方、何か様子がおかしいですわっ！\n見てくださいましっ！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は叫びながら男の上半身を傾け、\n太ももに刺したボタンの針を回収した。")
	await novel_interface.show_text_only("筋肉男は全身を硬直させて床に倒れる。\nそれにより留置所施設内は大騒ぎとなった。")
	await novel_interface.show_text_only("2人のチンピラが様子を見るため近付いてくる。\n\n艶やかなお姉さん達は筋肉男から遠ざかりながら\n悲鳴を上げていた。")
	await novel_interface.show_text_only("どさくさが巻き起こる最中……\nソヤは扉付近の壁際まで俺を引っ張る。")
	await novel_interface.show_text_only("無言のアイコンタクト──")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("またやらかしてくれたなッ！！？\n（目で語る）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("えへへへ……\n（目で語る）", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("騒ぎを聞き付け3人の警備員が駆け寄ってくる。\n\n1人は扉の前で警戒しつつ、残りの2人が\n筋肉男の様子を確認しようと中に入った。")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("開いたけど、扉を守っている奴がいて\n通れないぞ……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("嫌な予感も束の間、俺の身体を押して\n足首を引っ掛けてきた──")
	await novel_interface.show_dialog("（あぅッ！？！？）", "レン")
	await novel_interface.show_text_only("仰向けに倒れそうになる俺……\nそれに気付いたのは扉の前にいる警備員だ。\n彼は無意識に2歩前に踏み出して、\n俺を支えてくれた。")
	await novel_interface.show_text_only("その隙にソヤが無慈悲にも彼の首を後から打つ。\n\n俺がお礼を告げる間もなく、彼は白目を剥いて\n倒れてしまった。")
	await novel_interface.show_text_only("俺は心の中で一生懸命に謝った。\n\n伝わってないと思うけど、謝った。\n\nソヤと一緒に倒れた警備員を起こし、\n扉の前の椅子に座らせる。")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("（ごめんなさいごめんなさいごめんなさいっ！）\n\n（でも今はイルカを探すのが大事なんです！！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("だから、ここでジッとはしていられない。\n今の内に留置施設からの逃亡を図る俺達2人。")
	await novel_interface.show_text_only("ソヤは廊下の角にあった火災警報器を鳴らした。\n\n「あちらの犯人が暴動を起こしました！！」\nと彼女はオフィスエリアに向かって叫び始める。\nすると更なる混乱が巻き起こって、\n警察官の注意はそちらに向かった。")
	await novel_interface.show_dialog("（何でこんなに手馴れてるんだよッ！！）", "レン")
	
	# scene2 - 逃出警局
