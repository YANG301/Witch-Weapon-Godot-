	await novel_interface.show_text_only("ミラー大主教には納得できる様子もなく、\n首を横に振る。")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("しかしシャイネルマン首相が軍縮を始めれば、\nマサダの支配範囲は必然的に縮小され──\nシナイ半島の制御も放棄せざるを得ない可能性が\n浮上しますが……", "ランバート")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("……それでも構わないのですかね？", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("つまり、スエズ運河は……", "ミラー")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("デックス博士も教皇様も、そのような事態は\n望んでいないと私は考えておりますが。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは背もたれに身体を預けると、\n笑みを浮かべた。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("マサダが定常的な資源とエネルギーを確保する。\nそれが西アジアの安定を目指すための第一歩。\n持続性のある未来を私は探したいのです。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ミラー大主教は無言で頷いた。")
	novel_interface.show_character("lambert","serious")
