	await novel_interface.show_dialog("マサダの経済形態からすれば……", "ランバート")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("……あの国は戦争を嫌がり始めたわけですな。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("ふんっ！ あのレジスタンス共は今さら何を！\n彼ら自らが撒いた種ではないか！", "ミラー")#文字错误
