	novel_interface.show_character("miller")
	await novel_interface.show_dialog("ランボットよ、君は今日の事を知って\nいたのだろう……", "ミラー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ふくよかな身体をしている大主教様が、\n溜め息を吐いてゆっくりと着席した。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("私は昔から第三学園都市への支持を表明して\n参りましたが──", "ランバート")
	novel_interface.change_expression("usually")
	await novel_interface.show_dialog("まさかこのタイミングで彼らが反撃システムの\n情報を公表し、\nしかも直後に議長が自殺するとは夢にも\n思いませんでした。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("では今回の閉鎖会議中の時間を狙った公表に\n関して、君は……\n……「誰かが」仕組んだ方策と言いたいのか？", "ミラー")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("現時点では個人による行為かどうかは\n不明ですが……\n状況を鑑みるに、シャイネルマン首相の\nご意思とは思えませんな。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("タイミングの問題ではない。\n\nあれが作られた事、それ自体が何を意味するか、\n君が理解していないわけがなかろう？", "ミラー")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("それこそ私が、本日あなたとお会いさせて頂いた\n目的でもあります──", "ランバート")
	novel_interface.change_expression("usually")
