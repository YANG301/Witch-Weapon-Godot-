	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("ですが彼の息子と2人の甥は、まだ国防軍に\n在籍しております。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そしてランボットはわざと話をそこで止めた。\n\nしばらく考え込み……それからミラーが\n沈黙を破る。")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("シャイネルマンは退任後の後継者に関して、\n選挙により決定する事を約束していた。\nこの点を君は知らないはずがない……", "ミラー")
