	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("あの人達、もう俺達の事に気付いただろうな……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ここは国際領土であり、俺はソヤみたいな\n免責特権を持っていない。\nもし保安軍に捕まったら──")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("（故意の傷害、警察官への暴行、脱獄、\n　公共財産の破壊……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("縞模様の囚人服を着た自分が鉄格子に囲まれ、\nポロポロと涙を流す場面が容易に想像できる……")
	await novel_interface.show_dialog("おい君、そこで何をしている？", "警備員")
