# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("金曜日の朝の報道番組は、夜明けに行われた\n人質救出に関連する映像ばかり流れていた。")
	await novel_interface.show_text_only("SIDがイージスの範囲内全ての道路を\n封鎖したため、\n誘拐犯はその場しのぎの古い倉庫を使って、\n人質を監禁する事しかできなかったようだ。")
	await novel_interface.show_text_only("連合議会の高官を拉致したと見られる4人の\nテロリストは結局逃げ場所を失った挙句、\nそのまま逮捕される結果となった。")
	await novel_interface.show_dialog("国際領土で大胆にも殺人や誘拐行為を行うなど\n連合議会の加盟国全てに対する明らかな挑発だ！", "ランバート")
	await novel_interface.show_dialog("今回の事件で各学園都市に対するテロリズムの\n活発化が十分に証明された！\n近日、頻発する時空位相波動もテロ活動と\n関係してるかもしれない！！", "ランバート")
	await novel_interface.show_dialog("あの戦争を生き残った者として、私にはずっと\n考えている想いがある……\n現代において、威嚇こそが安全と平和を保障する\n最も適切な手段であると！！", "ランバート")
	await novel_interface.show_text_only("あらかじめ決まっていたかのようなセリフを\n連発するインタビューをスキップし、\n俺はポテトチップスを頬張りながら喋った。")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("ほいふ人質にさへて（モグモグ）\n危うふ死ぬとこふぁったはひいぞ！（モグモグ）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("ほんと救出された直後に、良くこんなに\n意気揚々と演説ができるよね～～\n……本当に大した大物よ～モグモグ……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("だけど防衛庁の人がラペリングで突入した\nシーンは超格好よかったな！\nまるでスパイ映画みたいだった！", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("うん～～かっこいい！", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは真面目に頷く。")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("あれは特殊効果と音楽のおかげよ。\nみんな大げさな編集って好きだもん。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("重大なイベントの開催に合わせて、\nここ数日の学校は10時半から授業が始まり、\n下校時間も通常より早くなっている。")
	await novel_interface.show_text_only("俺とアニーとイルカはハムスターのように\n寄り添ってソファーでくつろいでいる。\nアニーは俺の手に持っていたポテチを、\n半分くらい口で奪ってきた。")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("今回の救出劇が成功したのって、主にSIDの\n情報支援があったからこそだろ？\nニュースでは全然触れてなかったけど……", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("仕方ないよ、情報機関は秘密であるべきだから。\n\n影の立役者ってやつだね。", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("レンお姉ちゃん……\nチョコ、なくなった……", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺とアニーの間から、イルカの顔がひょっこりと\n出てきた。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Packyのチョコ味？\n\n確かすぐ近くのコンビニは俺達が買い占めて\n品切れだったっけ……", "レン")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("今度スーパーで買っとくよ～～", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("でも、でも……今……ない……", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは空っぽの箱を持ち上げ、悲しげに\n箱を揺らしながら俺を見つめてくる。")
	await novel_interface.show_text_only("可愛いけど残念ながら、俺はエアコンが効いた\n部屋で引きこもっていたい。\n俺の外に出る意志は最近の猛暑と、開催される\nイベントのせいで既に溶けている。")
	await novel_interface.show_text_only("第4回国際平和フォーラム。\n協定非武装地域には多く著名人が集まる。\nそれに合わせてマリルも多忙を極め、\n最近はろくに話せてもいない。")
	await novel_interface.show_text_only("今回のフォーラムはかつてない規模で\n開催され、\n新豊洲以外の5大学園都市は、\nそれぞれ100人以上の代表団を派遣している。")
	await novel_interface.show_text_only("これほどまでの大掛かりな政府首脳会議は、\n一般市民の日常生活にすら影響を及ばす。")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("今だとスクーターすら通行禁止になってるから、\n出前も全然届かないし……", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーはソファーの反対側に寝そべり、\n携帯を見ながら顔を抱き枕にうずめた。")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("分かった、分かったよ。\n俺がおやつ買いに行くから……\nアニーも何か欲しいものある？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("ふっふっふっふっ……", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("えへへ～～……", "イルカ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("2人は「チャンスだ」という表情をして、\n遠慮なく長ぁ～～い買い物リストを作り始めた。")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("………………")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("あ～～つ～～ぅっ～～", "レン")
	await novel_interface.show_dialog("暑すぎるだろぉ……", "レン")
	await novel_interface.show_text_only("スーパーが開店したばかりの時間だというのに、\n外はもう蒸し暑くてたまらない。")
	await novel_interface.show_text_only("俺は食料が入った大きな袋を持ち、\n灼熱の道中を歩く。\n街中の警備の数は普段より数倍多い。")
	await novel_interface.show_text_only("所々に交通規制が敷かれており、臨時検査に\n備えてIDカードを持ち歩かなければならない。")
	await novel_interface.show_text_only("公共交通の各駅にも、防衛庁のパトカーと\n警備人員がきっちりと配備されていた。")
	await novel_interface.show_text_only("協定非武装地域周辺の大規模交通規制に合わせ、\n幹線道路の街灯にも監視装置が設置されている。")
	await novel_interface.show_text_only("保安軍だけでは人数が足りないので、連合議会は\nパランティアの傭兵すらも雇っているらしい。")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("（まあ、物々しくなるのも仕方ないか……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("歩道橋から見下ろすと、ちょうど十数人の\nデモ行進が通りかかった。\nそれをマスコミの人間がカメラで撮影している。")
	await novel_interface.show_text_only("終戦したと言っても未だ熱は冷めていない。\n\nフォーラムとあらば世界中の記者や様々な組織が\n新豊洲に押し寄せてくる。")
	await novel_interface.show_text_only("彼らの訴えは、地域紛争、民族矛盾、難民問題、\n宗教圧迫、経済制裁──\n──もはやマシマシぐらいに沢山である。")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("宣教しようとしてる人までいるなぁ……\n\nアイツらは火に油を注ぎたいのか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルによると過去3回の国際平和フォーラムも\n平和とは程遠い状況だったらしい。")
	await novel_interface.show_text_only("前回のフォーラムなんて本来はマサダブルクで\n開催予定だったのに、\n相次ぐテロが多発した結果、結局サモントンで\n開催する事になった。")
	await novel_interface.show_text_only("無事開催はできたものの、デックス博士が難民を\n全面的に受け入れるとまさかの電撃発表。\nフォーラムという『火薬庫』に爆弾を投下した。")
	await novel_interface.show_text_only("さらに後日、孫娘であるラファエルお嬢様が\n否定的な意見で追加爆撃を開始する。\n「それは政治的に正しくない」的な発言を\n彼女的マイルドな表現で言ったもんだから、\n更なる波紋を呼んで、彼女は新豊洲に来る\n羽目となった。")
	await novel_interface.show_text_only("2年前のフォーラムでも、テロリストが\nニューモリダスの市街地を直接襲撃し、\n武装ヘリまで投入したとかなんとか。")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("はぁぁ……想像もつかないな。", "レン")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("先日はスクルドが大使館エリアの公益活動に\n参加していたようだ。\n南米の飢餓に苦しむ子供達に寄付をしていた。")
	await novel_interface.show_text_only("そんな最中にヨーロッパの菜食主義者\nグループが抗議活動を開始。\n動物の屠殺を禁止するよう呼びかけ始める……")
	await novel_interface.show_text_only("全裸で地面に横たわり「ステーキのコスプレ」\nみたいな事をする人間もいた。")
	await novel_interface.show_text_only("とあるメイドがその「ステーキ」に、触手などの\n具材が入った紫色のソースを真顔でかけ始める。")
	await novel_interface.show_text_only("可哀そうなステーキおばさんは「あっあっ」と\n悲鳴をあげながら逃げていった……")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("そのグループは現在、自らのwebサイトを\n通じて声明を発表。\nメンバーが深刻な心的外傷を受けたと\n憤慨している。")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("ははははっ……\n\n（ファビオラは自分の料理が武器になるぐらい\n　凶悪だと知っているみたいだ）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("などと空笑いをしていると、突然ポケットに\n入っていた携帯が震えた。\nマリルからのメッセージだ──")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("うん……？今日の昼、本部に来いって？", "レン")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("──10時間前")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("──SID指令室、23時15分。")
	await novel_interface.show_text_only("マリルは腕を組み、スクリーン上にポップアップ\nされたモノクロ映像の中で、\n表示された数個の赤い枠を見つめている。")
	await novel_interface.show_text_only("突然、スクリーンの下方に会話ウィンドウが\n表示された。")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("報告します、長官。\n\n記録番号によると、誘拐されたランボット氏は\n未だイージスの範囲内にいる模様です。", "SID捜査官")
	await novel_interface.show_dialog("監視データを分析した結果、誘拐犯達の居場所を\n3地点まで絞りました。\nその中で港区の旧式倉庫に異常な通電を\n確認しております。", "SID捜査官")
	await novel_interface.show_dialog("防衛庁に救助を要請しましょうか？", "SID捜査官")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("まだだ。\n包囲網を縮小して、私の命令を待て。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("了解しました。", "SID捜査官")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ウィンドウが閉じられると、すぐにマリルは\n軍用通信チャンネルに切り替えた。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("その先は山岳地帯だ、ヘリの高度に注意しろ。\n不用意に藪蛇を突っつくなよ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("──了解。\n衛星のサーモグラフィーは完璧です。", "兵士A")
	await novel_interface.show_dialog("しかし、この移動速度……\n\n彼ら本当に人間なのでしょうか？", "兵士A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("正確には……人間「だった」だ。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("奴らが向かっている先の避難勧告は済ませている\nだろうな？ \nもしアクシデントが起きれば──", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("火砲と大規模破壊兵器は既に待機しております！", "兵士B")
	await novel_interface.show_text_only("マリルは言葉を噤んで頷いた。\n\nこれ以上は軍に情報を漏らしたくないようだ。")
	await novel_interface.show_text_only("今回の追跡作戦が始まってからというもの、\nマリルは嫌な予感を抱いていた。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("（新豊洲市街の外に現れたドールであれば……）\n\n（処理方法として軍が事前に重火器武装を配置、\n　強行殲滅するというのが定石。）", "マリル")
	await novel_interface.show_dialog("（これまでの経験則であれば、奴らは魔女の繭が\n　消失すると同時に、）\n（周囲の生物や建物を無差別に攻撃し始める。）", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（だが先々週からか理性が無いにも関わらず\n　突如、行動に規則性が生まれ始めた……）", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……待ってください。\n\nぜ、前方に……人がいます！", "兵士A")
	await novel_interface.show_dialog("なんだあいつ……\n\n電動チェーンソーを持っているようだが、\nこの辺に住んでる木こりか？", "兵士B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("馬鹿者ッ！！ \n23時の夜中に木を切るヤツがどこにいる！？\nミーム検査の結果は！？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("色相、グリーン！　人間ですッ！！", "兵士A")
	await novel_interface.show_dialog("しょ、少女のようですが……！？", "兵士B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("マリルは画面を近距離モードへ切り替えた。")
	await novel_interface.show_text_only("画面に映るサーモグラフィーでは、頭巾のような\n物を被る少女が映っており、\n小さな身体にそぐわない電動チェーンソーを\n持っている事も確認できる。")
	await novel_interface.show_text_only("彼女はなんと、超高速で移動しているドール達に\n向かって余裕の手招きをしていた。")
	await novel_interface.show_text_only("先頭の数匹が叫ぶと、すぐさま彼女の方へと\n飛びかかる。")
	await novel_interface.show_text_only("同規模の集団をマリルは対処した経験がある。\n\n完全武装の重機関銃で隊列を組まないと、\n無傷で殲滅するのは不可能だ。")
	await novel_interface.show_text_only("もはや助かる見込みはない。\n死体処理班に少女の死体回収を命じようとした。\nしかし躊躇なく迎え撃つ彼女の行動に\nマリルは驚愕する事となる。")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("電動チェーンソーを振るう角度に合わせて\n歩調を整える。\n攻撃を避けると同時に相手の身体を\n切り裂ける位置へと刃を合わせた。")
	await novel_interface.show_text_only("大型スライサーの中に押し込めた生肉のように、\nドール達が無数の肉塊に成り果てていく。")
	await novel_interface.show_text_only("少女の慣性と遠心力を利用した流暢な攻撃は、\n決して超人的な力を利用した技には見えない。")
	await novel_interface.show_text_only("言わば常人の中に潜む何かの技術。\n\n彼女のチェーンソーも敵の特性と自身の力を\n計算した上で、最も効率的な選択なのであろう。")
	await novel_interface.show_text_only("気付けばSIDと軍部が三日三晩と追跡していた\nドール達の群れは──\n全てが原型を留めず地面に散らばっていた。")
	await novel_interface.show_dialog("ど、どうしましょう……？", "兵士A")
	await novel_interface.show_text_only("マリルは仕方なく溜め息を吐いた。")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("ちっ……", "マリル")
	await novel_interface.show_dialog("サーチライトを開け、ヘルファイアミサイルの\n照準を合わせろ！", "マリル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("加えてスピーカーで自分の立場をわきまえるよう\n呼びかけるんだ。\n山ごと跡形も無く吹き飛ばされたくなければ、\n軽はずみな行動は控えろとな。", "マリル")
	await novel_interface.show_dialog("そして……あいつを私の元へ連れてこいッ！！！", "マリル")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("………………")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
