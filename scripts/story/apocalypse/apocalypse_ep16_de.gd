# apocalypse_ep16.gd - 天启篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第16话剧本
	apocalypse_ep16_script()

func play_script():
	pass

