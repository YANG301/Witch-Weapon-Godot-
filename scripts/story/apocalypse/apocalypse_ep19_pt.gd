# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("E enquanto o brilho queima mais avermelhado sobre a onda,\nIsso aguarda a equipe ascendente, que Phaëton\nEu saberia guiar, e em cada parte a luz")
	await novel_interface.show_text_only("Desvanecimentos diminutos, mais intensos no meio;\nEntão queimou a pacífica oriflame e relaxou\nPor todos os lados a chama viva decaiu.")
	await novel_interface.show_text_only("E naquele meio suas flâmulas esportivas balançavam\nMilhares de Anjos; em resplendor cada")
	await novel_interface.show_text_only("Adorno distinto e pitoresco...")
	await novel_interface.show_text_only("—Canto XXXI, Paradiso, A Divina Comédia")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru fica de pé, brincando com a foto nas mãos, enquanto observa atentamente o homem grisalho à sua frente.")
	await novel_interface.show_text_only("Não há muita informação a ser encontrada sobre este homem. Ninguém sabe se Lumbert é seu nome verdadeiro, muito menos qual é seu sobrenome.")
	await novel_interface.show_text_only("Mas ainda é um facto que ele foi nomeado cavaleiro com este nome devido à “notável contribuição para a paz mundial”.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko já confirmou que é seguro negociar com ele.)", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("A maioria das pessoas acredita que a razão pela qual o Congresso Unido detém o maior poder sobre o nosso planeta é que é onde os líderes das nações em todo o mundo estão reunidos.", "Mariru")
	await novel_interface.show_dialog("É verdade que esse tipo de organização existiu na história uma vez. Mas a estrutura era frágil e os membros nunca paravam de discutir. O presidente agiu mais como um mendigo pacificador.", "Mariru")
	await novel_interface.show_dialog("Mas o Congresso Unido que temos agora não é nada disso. Muito mais influente. E muito mais rico.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru guarda a foto de volta no bolso, com o rosto impassível.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Do interesse nasce a confiança. Da confiança nasce o poder. E o poder, através do arranjo e distribuição de recursos, gera ainda mais interesse...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert levanta uma sobrancelha.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Esse é o modelo básico de sociedade de Walker.", "Lumbert")
	await novel_interface.show_dialog("Os políticos são escolhidos pelos grupos de interesse como agentes que contam com a confiança do público.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Se estes agentes não conseguirem manter ou criar interesses maiores, os seus poderes serão destruídos e alguém tomará o seu lugar.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Isso é verdade na macro-história, mas o público nunca foi razoável. Como Le Bon disse uma vez...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("As massas nunca tiveram sede da verdade. Quem pode fornecer-lhes ilusões é facilmente seu mestre; quem tenta destruir suas ilusões é sempre sua vítima.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert murmura, terminando a citação para ela. Mariru sorri e acena com a cabeça.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Existem muitas maneiras de pular a parte do interesse e ganhar diretamente a confiança do público.", "Mariru")
	await novel_interface.show_dialog("Líderes desse tipo não têm medo de fazer grandes sacrifícios, desde que tenham sucesso no final.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("No entanto, após a Guerra dos Sete Anos, os verdadeiros que mantêm as vidas das massas seguras e as nações em funcionamento começam a repensar toda a situação.", "Mariru")
	await novel_interface.show_dialog("E assim formaram o Congresso Unido. Uma organização que colabora e negocia diretamente com grupos de interesse.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Então, na verdade é o contrário. O Congresso Unido não é poderoso porque é composto por líderes nacionais. Na verdade, a verdade é que apenas aqueles que estão no Congresso estão qualificados para se tornarem líderes nacionais.", "Mariru")
	await novel_interface.show_dialog("Esta organização deu o seu primeiro passo há três anos...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru faz uma pausa. Lumbert olha para ela, prendendo a respiração.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Há três anos, o Congresso Unido e a Igreja trabalharam juntos para testar um tipo de Substância H da classe EX na América do Sul. Eles pressionaram os senhores da guerra da máfia para trabalharem com eles.", "Mariru")
	await novel_interface.show_dialog("No entanto, o experimento saiu do controle. Mais de quarenta e seis mil moradores morreram.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Subornaram todos os que conheciam a verdade para os calarem e rotularam tudo isto como o Massacre do Rio Churun, atribuindo a culpa a Carlos Branco, o único senhor da guerra que se recusou a cooperar.", "Mariru")
	await novel_interface.show_dialog("A notícia do incidente se tornou viral. A mídia adorou. O público odiou-o e mostrou a sua repulsa e ódio pela guerra em grande escala.", "Mariru")
	await novel_interface.show_dialog("E o Congresso Unido tornou-se amplamente apreciado como a organização que trabalhou numa operação militar conjunta para matar Branco. Ninguém sequer se preocupou em questionar se a existência desta organização era legal em primeiro lugar.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Mas não é muito antinatural? Milhares de corpos, dispostos em formação de matriz, tendo a igreja como centro...", "Mariru")
	await novel_interface.show_dialog("Acredito que o Congresso disparou ali uma arma de Substância H, capaz de perturbar as ondas de rádio num raio de três quilómetros, a fim de ocultar a verdade.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Uma anomalia semelhante ocorreu também no campo de batalha da Ásia Ocidental. Por isso as imagens captadas pelos satélites ali estavam todas distorcidas – afinal, a luz também era uma espécie de onda.", "Mariru")
	await novel_interface.show_dialog("Foi por isso que as perturbações das ondas de rádio na área persistiram durante semanas, mesmo depois de “o portão” ter sido fechado.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dá grande ênfase às palavras “o portão”. Lumbert fecha os olhos, resignado.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru estuda a foto em sua mão.")
	await novel_interface.show_dialog("A remoção de todos esses corpos exigiu muitos trabalhadores. Deve ter sido difícil garantir que nenhum deles vazaria alguma coisa.", "Mariru")
	await novel_interface.show_dialog("Aposto que você nunca esperava que alguém tirasse essa foto da cena com uma câmera mecânica velha e um rolo de filme podre.", "Mariru")
	await novel_interface.show_dialog("O fundo da imagem estava desfocado. Isso se deveu às propriedades de distorção da luz da arma Substância H que seu pessoal usou.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Interessante. Mas por que você está tão convencido de que eu estava envolvido?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Um mês antes do incidente, você foi nomeado secretário-geral da Organização do Tratado de Proibição de Experimentos com Armas com Substância H.", "Mariru")
	await novel_interface.show_dialog("Superficialmente, o objetivo desta organização é proibir experimentos com armas da Substância H. É um estabelecimento poderoso, com muitos recursos disponíveis e excelentes capacidades de coleta de informações.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("É impossível você não saber de um incidente dessa escala. A razão pela qual você optou por não falar foi que, na verdade, foi você quem planejou tudo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert não tenta protestar e Mariru interpreta seu silêncio como um sinal de que é seguro seguir em frente.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No final, a igreja enviou alguns dos seus para recuperar a Substância H que estava causando todos os problemas. Posteriormente, eles receberam um número anormal de fundos e privilégios do Conselho Unido.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("A Substância H em questão é uma porta preta entreaberta. Atrás dela está uma luz dourada ofuscante -", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Chega! Entendo!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert interrompe, levantando os dois braços num ato de rendição.")
	await novel_interface.show_text_only("Ele puxa a gola do terno e limpa a garganta.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Na verdade, a missão da nossa organização é garantir que o público não tenha acesso fácil às armas da Substância H, muito menos que as utilize em experiências.", "Lumbert")
	await novel_interface.show_dialog("A substância H é muito perigosa. Se não tomarmos cuidado, isso poderá destruir a nossa civilização. Mas aquela experiência que conduzimos... era inevitável. Alguém tinha que fazer isso, poderíamos muito bem ser nós.", "Lumbert")
	await novel_interface.show_dialog("Alguém... alguma coisa... estava batendo na porta por dentro. Cada vez mais urgentemente. Não tivemos escolha...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Batendo...?", "Mariru")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Batendo na porta do céu, sim.", "Lumbert")
	await novel_interface.show_dialog("O céu existe em todas as religiões e sistemas mitológicos, em diferentes formas. As definições podem diferir em cada sistema de crenças, mas talvez todas tenham nascido da mesma fonte.", "Lumbert")
	await novel_interface.show_dialog("Nos registros históricos, dizem que, pouco antes de a porta ser aberta, ela será batida três vezes, consecutivamente.", "Lumbert")
	await novel_interface.show_dialog("Batidas profundas e ecoantes. Como se batesse na alma do ouvinte...", "Lumbert")
	await novel_interface.show_dialog("Depois que as batidas forem ouvidas pela primeira vez, haverá silêncio por uma semana e as batidas recomeçarão. Os intervalos entre as batidas tornam-se gradualmente mais curtos...", "Lumbert")
	await novel_interface.show_dialog("Quando não houver mais de noventa segundos entre cada série de batidas, saberemos que a porta do céu está pronta para ser aberta.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Você pode definir o “ser” atrás da porta como quiser, mas o fato é que ele possui poderes que podem provocar um desastre do tipo apocalíptico.", "Lumbert")
	await novel_interface.show_dialog("Uma grande enchente, por exemplo, hein...", "Mariru")
	await novel_interface.show_dialog("Segundo os manuscritos da igreja, a única forma de manter a porta fechada é reunir cerca de dez mil pessoas no pátio, cercando a porta...", "Lumbert")
	await novel_interface.show_dialog("Uma espécie de sacrifício, hein?", "Mariru")
	await novel_interface.show_text_only("Lumbert ignora o comentário de Mariru e continua.")
	await novel_interface.show_dialog("Esse tipo de coisa acontecia a cada centenas de anos. Sempre, os cadáveres acabavam dispostos em uma disposição radial, tendo a porta como ponto central.", "Lumbert")
	await novel_interface.show_dialog("Esse tipo de ritual geralmente era realizado em segredo. Porém, como sempre havia centenas de anos entre um ritual e outro, certas pessoas de certas épocas os usavam em seu próprio benefício...", "Lumbert")
	await novel_interface.show_dialog("Por exemplo, o massacre do Dia de São Bartolomeu em Paris, 1572.", "Lumbert")
	await novel_interface.show_dialog("Na noite anterior ao dia de São Bartolomeu daquele ano, houve um horrível massacre religioso, o pior em séculos, com mais de setenta mil mortes.", "Lumbert")
	await novel_interface.show_dialog("Paris, hein...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Espere, uma matriz radial com uma porta como ponto central?", "Mariru")
	await novel_interface.show_text_only("Mariru imediatamente se lembra da forma como as estradas são organizadas na cidade do romance.")
	await novel_interface.show_dialog("Irônico, não é...", "Lumbert")
	await novel_interface.show_text_only("Lumbert ri, sem humor.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ainda assim, não se pode bater numa porta a menos que tenha uma forma concreta. Por que você simplesmente não o destrói ou joga em algum lugar do espaço sideral?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("A porta do céu é apenas um conceito. No início, a porta nunca aparecia duas vezes no mesmo lugar.", "Lumbert")
	await novel_interface.show_dialog("Aparecia em lugares onde nem deveria haver porta. Por exemplo, na superfície das antigas muralhas da cidade.", "Lumbert")
	await novel_interface.show_dialog("Eles sempre traziam desastres com eles, mas também eram uma espécie de relíquias divinas, prova de que existe uma existência além da nossa compreensão.", "Lumbert")
	await novel_interface.show_dialog("As facções religiosas da história nunca pararam de guerrear por causa deste conceito, querendo reivindicá-lo como seu.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Como alguém reivindica um conceito, exatamente?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Os registros históricos nos dizem que Hagia Sofia foi a “dona” oficial da porta do céu por muito tempo.", "Lumbert")
	await novel_interface.show_dialog("Então, no século XV, o escultor Lorenzo Ghiberti, de Florença, reivindicou a propriedade do conceito através de uma obra de arte na qual passou toda a vida trabalhando.", "Lumbert")
	await novel_interface.show_dialog("A referida obra de arte, após concluída em 1452, serviu de entrada principal da Catedral de Florença. O mundo concordou que a partir de então ela será conhecida como a porta do céu.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Eu vejo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O método mais antigo que os humanos usavam para reivindicar a propriedade de um conceito era provar seu próprio valor através da criação de obras de arte majestosas e extravagantes.")
	await novel_interface.show_text_only("Pirâmides, templos, palácios, coroas, tronos...")
	await novel_interface.show_text_only("Todas as formas de provar que o criador é o verdadeiro e merecedor dono de um conceito.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Espere... Constantinopole, onde fica a Hagia Sofia, não foi invadida e ocupada um ano após a conclusão da obra de Ghiberti? Foi porque...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert balança a cabeça.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Nós não sabemos. Nenhuma evidência direta foi encontrada nesse período.", "Lumbert")
	await novel_interface.show_dialog("O que PODEMOS ter certeza é que a obra de Ghiberti foi destruída na Guerra dos Sete Anos.", "Lumbert")
	await novel_interface.show_dialog("Portanto, para determinar quando a \"porta\" aparecerá em seguida e garantir que ela esteja em uma área remota o suficiente para causar danos mínimos na próxima vez que for aberta...", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Tivemos que trabalhar com a igreja para criar uma espécie de cópia.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Mas algo deu errado no experimento. Não conseguimos fechar os portões como deveríamos. Foi por isso que a igreja teve que ir tão longe...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso explica tudo. Para Mariru, é como finalmente juntar as peças e ver todo o quebra-cabeça como ele é.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Então... você encobriu tudo depois com uma mentira engenhosa, a ajuda da mídia e o bode expiatório perfeito...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert ri severamente com as palavras de Mariru.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Obrigado pelo elogio, eu acho.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Não. Não é um elogio. Se um dia a humanidade não tiver escolha senão enfrentar um poder de uma escala tão avassaladora...", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Eu consideraria estúpido tentar encobrir tudo com uma mentira, espalhar a ignorância sob o disfarce de esperança.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Mas você não vê? Os humanos são fracos assim. Preferimos abrir mão da nossa segurança por uma sensação de segurança.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorri e levanta a voz.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("É por isso que a “ética” é valiosa de certa forma.", "Mariru")
	await novel_interface.show_dialog("Encobrir a verdade dessa experiência faz parte do seu trabalho. E a verdade agora está em minhas mãos...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Você está certo. Então, nomeie seus termos.", "Lumbert")
	await novel_interface.show_dialog("Mas lembre-se de que não sou mais do que um representante e não tenho influência sobre as decisões do Congresso Unido. Eu nem sei quem toma as decisões.", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Não se preocupe, não vou citar nada além do seu poder.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Minha condição é: o sucessor de Scheinermann, primeiro-ministro da Terceira Cidade Acadêmica, não pode ser militar.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert parece surpreso com o pedido.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Superficialmente, pelo menos financeiramente, enquanto o Congresso Unido autorizar Masada a vender armas, eles nunca precisarão de se preocupar com a falência dos seus fabricantes de armas.", "Mariru")
	await novel_interface.show_dialog("No entanto, a política não envolve apenas dinheiro. As pessoas também desejam poder...", "Mariru")
	await novel_interface.show_dialog("Quando o público começar a ficar cansado de guerras inúteis, não haverá mais uma base sólida para a construção de forças armadas em grande escala.", "Mariru")
	await novel_interface.show_dialog("Você não percebeu que, recentemente, cada vez mais canais de mídia de Masada começaram a se referir à sua própria capital como “Cidade Academia” em vez de Masada Ford?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert não responde.")
	await novel_interface.show_text_only("De repente, o elevador preto do lado esquerdo apita. Uma mulher de óculos emerge de sua porta, com uma pequena pasta na mão.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("Akiko?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Você conheceu aquele velho javali à tarde sem me avisar. Vou deixar você fora de perigo desta vez—", "Akiko")
	await novel_interface.show_dialog("Mas você não deveria pelo menos ter me contado que iria conhecer Mariru? Principalmente porque fui eu quem apresentou vocês um ao outro!", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se vira para lançar a Mariru um olhar de incredulidade, e Mariru dá de ombros.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ela fez muitas perguntas. Eu tive que contar a ela.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Ugh...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Raposa velha.", "Akiko")
