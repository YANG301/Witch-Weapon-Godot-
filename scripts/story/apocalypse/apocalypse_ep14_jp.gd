# apocalypse_ep14.gd - 天启篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第14话剧本
	apocalypse_ep14_script()

func play_script():
	pass

# 天启篇第14话 - 正式剧本
func apocalypse_ep14_script():
	# 开场设置
	novel_interface.show_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("イルカを乗せた車が遠ざかっていくのを見て、\nさっきの場面をまた思い出した。")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("ジョン、大丈夫かな……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは持っている血まみれのガラスの破片を\n見つめながら、疑念を浮かべるように言った──")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("この破片は筋肉組織を切断しておりましたけど、\n重要な血管は傷付けていないようでしたわ。\nすぐに治療さえすれば、大した問題にはならない\nでしょう……", "ソヤ")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("ですが、あんな傷を負いながら彼は20分以上も\n歩いていましたの。\n普通の人間なら痛みで気絶していたはずですわ。", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("……まさか『無痛症』とか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("以前見たアニメやドラマで、似たような症状を\n持つ登場人物がいた事を思い出した。")
	await novel_interface.show_text_only("痛みを感じないから通常の盲腸炎でも放置して\nしまい、\n穿孔性腹膜炎とかいう致命傷にまで、\n悪化してしまうケースがあるらしい。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("それであれば、少なくとも触覚はあるはず\nですわ。", "ソヤ")
	await novel_interface.show_dialog("ズボンにあれだけ固まった血液が付着して\nいましたら、何かしらを感じるはずですわね。\nしかしながら、彼は少しも不快にしているように\n見えませんでした……これは…………", "ソヤ")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("…………なんと面白いのでしょうッッ！！！", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("えっ？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("事態が落ち着きましたら病院に行きませんこと？\nどんな刺激で彼が反応するか試したいですわ……", "ソヤ")
	await novel_interface.show_dialog("まさか、レンさんが原因っ！？", "ソヤ")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("であれば、あのメスゴリラの目を何とか騙して\nレンさんを誘拐しなくてはいけませんわね……\n成功の暁にはレンさんのお身体にイッロイロ\n聞いてみませんと……♪", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤが物騒な独り言を呟いている最中、\n急に胸に痺れを感じた。")
	await novel_interface.show_dialog("ほう、メスゴリラとは誰の事かな～～？", "マリル")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("マ、マリルさんッ！？！？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは慌てて周囲を見渡すが誰もいない。\n\n胸を押さえてコソコソしている俺以外は。")
	await novel_interface.show_dialog("レン、私に会いたかっただろう？", "マリル")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("普通に携帯を使ってくれ！", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","laugh",0.25)
	await novel_interface.show_dialog("ま、まさか……", "ソヤ")
	await novel_interface.show_text_only("音の発信源を特定してしまったソヤが、すぐさま\n「胸をチェックさせろ」という表情を浮かべる。")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("尻尾を振り俺に飛びかかってくる様は、\n飼い主の帰宅を迎える大型犬のごとく──")
	await novel_interface.show_text_only("──しかし忘れた頃に足首から眩い光が発生。\n\n宙を飛んでいた彼女の身体は、強烈な電撃に\n襲われ、瞬時に叩き落されてしまう。")
	await novel_interface.show_text_only("顔から落ちて滅茶苦茶に痛そうだったが、\n右の手足が微かに動くと、\nすぐにソヤは右半身の力だけで起き上がった。")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("（なんか復活速度が早くなっているような？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("回復していない左腕を摩りながら、\n涙を浮かべつつ空へ向かってソヤは文句を叫ぶ。")
	novel_interface.show_character("soya_uniform","cry")
	await novel_interface.show_dialog("ちょっとッ！！\nこの足輪は遠隔操作もできますの！？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/UAV.png")
	await novel_interface.show_text_only("ソヤが見上げた方向を眺めると、弱々しい\n赤い光が宙に浮かんでいた。")
	await novel_interface.show_dialog("……ドローン？", "レン")
	await novel_interface.show_dialog("ここら辺って飛行制限エリアじゃ……", "レン")
	await novel_interface.show_text_only("こういう制限の無視をよく行うSIDだけど、\n国際平和フォーラム期間中は、\nレッドラインを越える真似をするなって、\nこの前マリル自身が強調して言っていたのに……")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("（あっ…………）\n\n（警察官への暴行、脱獄、暴動の扇動……）\n\n（そもそも俺ら既にレッドラインなんて余裕で\n　超えている可能性が……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("今日の状況は特殊だ。\n\n現在、中央通りに集まっているデモ隊の人数は\n5万人を超えている。", "マリル")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("そんなに！？！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("合わせて7つのエリアで暴動が発生中だな。\n流石の保安軍本部も混乱状態だ。", "マリル")
	await novel_interface.show_dialog("このまま処理できなければ新豊洲の全域にまで\n波及する可能性が高いと彼らの指揮官に告げた。", "マリル")
	await novel_interface.show_dialog("ついでに、ほんの少し彼と彼の家族に\nプレッシャーをかけたら……\nSIDとの安保権限の共有をあっさりと\n認めてくれたぞ。", "マリル")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("（家族にプレッシャーかけてる時点で「少し」\n　じゃない！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("彼らは今回の平和フォーラムのためにコストを\n惜しまなかったようだ。\n協定非武装地域内の照明と監視システムの\n改修まで行っていたよ。", "マリル")
	await novel_interface.show_dialog("全ての街灯を監視カメラに変えて、対応する\nネットワークと制御ユニットを設置している。", "マリル")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("街灯の監視範囲だけでは限りがありますわよね？\n\nだから結局、ドローンを使っているのじゃ\nありませんの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ここぞとばかりにソヤは指摘をするが、\nマリルはあっさりと認めてしまう。")
	await novel_interface.show_dialog("確かにこんな監視システムではコストと収益が\n比例しないばかりか、\nかなりの政治的リスクがあるな。", "マリル")
	await novel_interface.show_dialog("万が一メディアに露見でもしたら、\nジョージ・オーウェルの言葉なんかを引用して、\n容赦なく連合議会を批判するに違いない。", "マリル")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("──だがそれこそが、私の欲しかった情報だ。", "マリル")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("ごく一部の人間に少し影響を与えるだけで──\n\n世界で最も権威を持つ機関に、明らかな愚策へと\n走ってもらう事ができる。", "マリル")
	await novel_interface.show_dialog("大事なのは、その一部の人間をどうやって\n見つけ出すかだ……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが満足げに眺めるているタブレットには、\n登録されたばかりの多数のファイルが存在する。\nそして1000件以上になるであろうデータ全てに\n身分、アカウント、金額などが明記されていた。")
	await novel_interface.show_dialog("どういう意味だ……？", "レン")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("新豊洲連邦の最高権力を持つ機関は元老院だが、\n彼らが無限に権力を持っているとは思わんだろ？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("そんなに権力ないよな？\nだってマリルは言う事をあまり聞いてないし……", "レン")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("そうだ。だからこそ国という単位には\n複雑な権力構造があるわけだな。\n経済、軍事、歴史、文化、宗教など……\n影響には色々な要因がある。", "マリル")
	await novel_interface.show_dialog("国の元首って言うのはな？\n\n各勢力が面倒くさい小競り合いをする中で、\n均衡を維持するため選出された代理人に過ぎん。", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("過去から現在も、民主、独裁、共和、あるいは\n学院政体だとしても、\n本物の王なんてものは存在しないのだ。", "マリル")
	await novel_interface.show_dialog("存在するのは、次から次へ来る二者択一の選択を\n妥協しながら民衆の代わりに選択し、\nたった1人で人格すらも否定されながら\n罵倒を浴びる責任者だけ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは少し動きを止め、避難者を導いている\n放射線防護服を着た回収員達を見た。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("それら全てを背負う人間は強く見えるが──\n\n──本当は傷だらけだ。", "マリル")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("…………", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("片手で胸を抑え黙って何も言わないソヤと、\n何を言っているかさっぱり分からない俺。")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("えっと、結局……何が言いたいの……？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("あなたに言い聞かせたわけじゃありませんわ。\n……おバカさん。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは息を整えてから、真剣に質問する。")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("要するにパズルの完成を間近に控えましたが\n大事な最後のピースが足りない……\n……ですから、わたくしと取引をしたいと？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("そうだ。", "マリル")
	await novel_interface.show_text_only("マリルはきっぱりと返事した。")
	await novel_interface.show_dialog("私の知る限り『審判騎士』の本来の意味は\n「真理の印を所持する黒衣の修道士」であり、\nその特別な栄誉を得たのは500年間で20人にも\n満たない。", "マリル")
	await novel_interface.show_dialog("歴史上、優れた戦闘素質を持っている\n黒衣の修道士は多く存在した。", "マリル")
	await novel_interface.show_dialog("だが、神の国の最高免責特権を象徴する\n真理の印を得るためには、\n多大なる貢献をして教皇庁に認められなければ\nならない。", "マリル")
	await novel_interface.show_dialog("お前の真理の印は、2年前に今は亡き前教皇、\nカリストゥス4世から授かった物──", "マリル")
	await novel_interface.show_dialog("その時のお前は……\nまだ12歳にもなっていなかったのだろう？", "マリル")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("まったく……良く調べていますわね……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("単刀直入に聞こう。", "マリル")
	await novel_interface.show_dialog("3年前、ギアナ高地で行われた「浄化」の任務中\nお前は一体何をした？", "マリル")
	await novel_interface.show_text_only("ソヤはしばらく沈黙してから、顔を上げた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("あなたの埋められないパズルのピースを、\nわたくしは知っております。\nそれを知りたいのであれば条件がありますわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……言ってみろ。", "マリル")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("まずは1つ……\nこの足輪を今すぐ解除してくださいましッ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("それはできない。", "マリル")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("はうんッ！？！？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("足輪の解除にはSIDの特殊設備が必要だ。\n\n現時点では、お前とレンの安全距離を\n最大200メートルに設定する事しかできない。", "マリル")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("ま、まあいいでしょう……\n10メートルよりはマシですわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しばらくすると、足輪のランプが数回点滅した。")
	await novel_interface.show_dialog("……設定完了だ。", "マリル")
	await novel_interface.show_text_only("ソヤは俺を見つめながら用心深く離れていく。\n\n10メートル以上の距離を超えても\n何も起きない事が分かり、ほっと一息吐いた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("2つ目は、ベアトリーチェさんとレンさんの\n関係性をお教えいただけますでしょうか？ \nこれはレンさんから直接お伺いしたいですわね。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルはしばらく考えてから、口を開く。")
	await novel_interface.show_dialog("構わないが、秘密の厳守を約束してもらいたい。", "マリル")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("お、教えてあげて大丈夫か？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェ本人は13世紀に亡くなってる。\n\n愛衣によると、今の彼女の身体は俺が召喚した時\n創ったモノらしい。")#换行问题
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("（あんな素敵な身体を俺が創った事に\n　なるんだよな？）\n\n（実感ないんだけど……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("その事実は機密事項とされていて、元老院にさえ\n明かしてはいない。")
	await novel_interface.show_text_only("俺、アニー、ベアトリーチェ、ラファエル、\nデックス博士、マリル、愛衣、ハインリッヒ……\nこの8名だけが、今の所それを知っている。")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("（2人が今から交換しようとしている情報って、\n　一体どれぐらいの機密なんだろう……）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("他言は無用って事ですわね。\n分かりましたわ。", "ソヤ")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("嘘は、わたくしには通用しませんからね？ \n\nもしレンさんが嘘をつきましたら……\nわたくし何をしでかすか分かりませんわよ♡", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("分かった。分かったよ！\nはいはい～～すごいすごい……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺はスカイホテルで起きた事件の経緯を\nソヤに伝えた。\nラファエルの宝石を使いベアトリーチェを召喚、\n……そんな話をソヤは興味津々で聞いている。")
	await novel_interface.show_text_only("ベアトリーチェがヤコブを撃退した時の事、\n彼女の身を苛む呪いの事、\nマリルの黙認の下で洗いざらい全てを話した。")
	await novel_interface.show_text_only("ソヤは目を輝かせ、物語を聞く子供のように\n1つの言葉に何度も声を上げて反応していた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("つまりラファエルさんが持っているペンダントの\nエメラルドが、\n元々ベアトリーチェさんの剣に装飾されていた\n物であったと……", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("うん、愛衣が鑑定して確認した。", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("ベアトリーチェ・ポルティナーリ……\n\nダンテの詩に描かれている、あの方が\n魔女だなんて……", "ソヤ")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("なんとも……身悶えしてしまうほどに、\n興味が尽きませんわ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ゴホン──", "マリル")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("あーーはいはい、あなたの欲しい証拠は\nわたくしの身体の中にありますわよ。\nあの愛衣とかいう人が検査すれば分かる事\nでしょうね。", "ソヤ")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("ですが、もう少しレンさんと遊びたいですの。\n\n明日のお昼12時までには、レンさんと一緒に\n帰還しますわ。", "ソヤ")
