# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("貝阿特麗切拿著麥克風，一隻腳踩在護欄上。")
	await novel_interface.show_text_only("功率開到最大的音箱將她的聲音傳遍了整條電器街。")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("你們這群雜碎──", "貝阿特麗切")
	await novel_interface.show_dialog("不折不扣的變態！！", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("什麼？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("哦呀呀……", "索婭")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（是、是為了轉移注意力才這麼說的吧……？）", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("貝阿特麗切的勁爆發言果然讓大家紛紛將目光轉向她。")
	await novel_interface.show_text_only("她看著車下面那群張著嘴仰著頭，對自己紅色高跟鞋底和短裙陰影產生幻想的傢伙──")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("你們這些垃圾、又髒又臭的蟑螂！其實一直在等著被踩死的那一天吧？", "貝阿特麗切")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("──你們不覺得羞恥嗎！？", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("（怎、怎麼聽起來像積怨已久的爆發……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("多數人的注意力都被她吸引了過去，連其他花車上唱唱跳跳的吉祥物也都停止了動作。")
	await novel_interface.show_text_only("我和索婭把握空檔鑽進去，順著花車側面的樓梯上到車頂，一眼就看到了伊露卡。")
	await novel_interface.show_text_only("她正坐在神龕的御座上，一臉滿足地摸著自己鼓成小山的肚子，面前貢台上還散落著幾十個空盤。")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("天哪……也吃太多了吧！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我環顧四周，盤算著要如何神不知鬼不覺地把這個小吃貨帶走，卻沒注意到伊露卡已經撲了過來。")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("小憐姐姐！！", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我緊張地回過頭，想做出「噓」的動作要她小聲些──")
	await novel_interface.show_text_only("卻發現她已經高高躍起，張開手腳，從半空中朝著我的臉下墜……")

