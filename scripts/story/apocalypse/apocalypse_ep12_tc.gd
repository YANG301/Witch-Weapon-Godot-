	await novel_interface.show_dialog("妳的骨頭……好像發出了奇怪的聲音？", "索婭")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我僵直地站在原地，總覺得一旦隨便移動，頭就會失去頸部的支撐而向後倒。")
	await novel_interface.show_text_only("剛才的動靜似乎引起了一些人的注意，還聽到一些人說「那是什麼？」。")
	await novel_interface.show_text_only("那是一隻穿著網襪的藍色大頭怪。")
	await novel_interface.show_text_only("貝阿特麗切見狀突然提高了音調，像是在為我們爭取最後的撤離時間。")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("你們這群滿腦子都是齷齪幻想的垃圾！雜種！變態！豬！", "貝阿特麗切")
	await novel_interface.show_dialog("全都給我──", "貝阿特麗切")
	await novel_interface.show_dialog("去死吧！！！！", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("罵到最高潮時，那兩台大功率音箱也終於撐不住地發出了尖鋭的爆音。")
	await novel_interface.show_text_only("喇叭正對面的廣告燈箱燈管也「啪！啪！」地炸裂開來。")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("──整條電器街一片詭異的寧靜。")
	await novel_interface.show_text_only("人們對著花車上英姿煥發的紅髮女王看傻了眼。")
	await novel_interface.show_text_only("索婭費了一番功夫才把像年糕一樣黏在我臉上的伊露卡扒下來，背到自己背上。")
	await novel_interface.show_text_only("而她居然已經呼呼大睡了。")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("這小鬼……未免也太重了吧！", "索婭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("終於鬆了口氣的我揉著腰觀察四周，沉默的氛圍著實讓人不安。")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("是不是罵得太狠了……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("但沒過多久，一陣騷動突然由遠而近地傳來──")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("啊啊啊啊啊啊好棒！！！！", "路人A")
	await novel_interface.show_dialog("請盡情辱罵我吧！！！！", "路人B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("什麼？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("接著，整條電器街爆發出了一波又一波的狂歡聲浪！！")
	await novel_interface.show_text_only("──人群，徹底沸騰了。")
	await novel_interface.show_text_only("一群拿著自動武器的士兵從對面的黑色裝甲車上跑了下來，一臉疑惑地看著這邊突然暴動的人群。")
	await novel_interface.show_text_only("我轉頭想提醒貝阿特麗切，卻不小心看到了她的臉──")

