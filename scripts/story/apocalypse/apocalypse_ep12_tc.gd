	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("……小憐？", "索婭")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("眾人的情緒隨著有節奏的歡呼聲越來越激烈，貝阿特麗切所在的花車也被推擠到搖晃起來。")
	await novel_interface.show_text_only("幾個傢伙試圖從側面爬上車頂，卻一一被她從臉踹了下去。")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("（好想被踐踏啊！！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她看到我花痴般的蠢樣後，微笑著搖搖頭，然後重新扣上了那個手環。")
	await novel_interface.show_text_only("接著，她從胸部抽出一個拇指大小的銀色膠囊，猛然朝著自己腳下一丟──")
	await novel_interface.show_text_only("一陣白煙過後，貝阿特麗切已消失得無影無蹤。")
