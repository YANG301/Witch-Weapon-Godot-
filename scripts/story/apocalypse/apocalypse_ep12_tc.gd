	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("糟──", "小憐")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("……好、好漂亮！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("看到她臉龐的一瞬間，我感覺小腹有一股溫熱的暖流傳遍全身。")
	await novel_interface.show_text_only("只覺兩頰發燙、雙腿酥軟……")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("（好想──）", "小憐")
