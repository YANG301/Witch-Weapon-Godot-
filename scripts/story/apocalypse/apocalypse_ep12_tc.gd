	await novel_interface.show_text_only("咔──")
	await novel_interface.show_text_only("伊露卡從空中落下，雙腿夾住我的兩肋，鼓起的肚子貼在我的臉上，雙手則緊緊抱住我的後頸。")
	await novel_interface.show_text_only("我的頸椎、腰椎和肩膀瞬間感到了巨大的壓力。")
	await novel_interface.show_text_only("她用整個身體包住了我的胸和頭，還很開心地用臉磨蹭我的頭頂。")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("欸嘿嘿，最喜歡小憐姐姐了嗝～", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡紅著臉說話，支支吾吾地好像喝醉了一樣。")
