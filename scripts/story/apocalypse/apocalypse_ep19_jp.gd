# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("あの平穏のオリフラムは中心が激しく\n燃え輝いていると言うのに──")
	await novel_interface.show_text_only("その周囲は火勢が等しく和らいでいる姿に\n似ていた──")
	await novel_interface.show_text_only("中心にて何千もの天使達が讃美歌のような喜びを\n翼を広げて表現し──")
	await novel_interface.show_text_only("各々の趣きを尊重し合い、天の祭事を\n楽しんでいた──")
	await novel_interface.show_text_only("──《神曲》天国編-XXXI")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("マリルは指で写真を弄びながら、目の前にいる\n銀髪の男をじっくりと観察する。")
	await novel_interface.show_text_only("彼に関する情報は極めて少なく、\nランボット（Lambot）という苗字のない名前が\n本名なのかすら誰も把握できていない。")
	await novel_interface.show_text_only("分かるのは「平和事業に対し優れた貢献をした」\nその事実を今の名前で叙勲した事だけである。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("（秋子との関係を鑑みるには、交渉可能な\n　人間のはずだが……）", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("今の連合議会が世界の中枢部になれた理由を、\nそこに各国の元首が集まっているからだと、\nほとんどの人々はそう思っているだろう。", "マリル")
	await novel_interface.show_dialog("歴史上には、確かにそんな組織も存在していた。\n\nただ組織自体はバラバラで口論が絶えず、\n議長はただの調停者みたいなものだった。", "マリル")
	await novel_interface.show_dialog("しかし連合議会の予算規模と影響力のレベルは、\nそれらの組織とは一線を画する。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは写真を収めると、厳しい表情をして\n話し始める。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("……利益から生まれる信頼、信頼から生まれる\n権力。\nそして権力は資源の調和と分配によって、\nより大きな利益に繋がる。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──ランボットは眉を上げた。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("それは……ボルカーの基礎社会モデルかね。", "ランバート")
	await novel_interface.show_dialog("政治家は利益団体により選ばれ、民衆の信頼を\n支える代理人とされる。", "ランバート")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("選ばれた代理人の手腕により、利益の維持と\n上昇が見込めない場合、\nその権力は剥奪され新たな代理人が選定される。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("歴史全体の観点から見れば確かにそうだが、\n民衆は決して合理的なわけではない。\nル・ボンが言っていたようにな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("民衆が求めて信じるのは、真相や理念ではない。\n\n盲目的で、残忍で、偏執と熱狂に駆られた、\n単純かつ極端な感情だけだ。", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは独り言のように話すと、\nマリルは微笑みながら頷いた。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("利益はなくとも、民衆の信頼を直接的に\n得る手段はたくさんある。", "マリル")
	await novel_interface.show_dialog("そう考える指導者は、自分の功績を成すためなら\n巨大な犠牲を払う事すら厭わない。", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("しかし、七年戦争の影響によって狂信だけでは\n国の存続を維持できなくなって、\n指導者達は考えを改め始めた。", "マリル")
	await novel_interface.show_dialog("そして最終的には「利害関係者」で構成された\n『連合議会』と言う組織が誕生し、\n互いに協力と策謀の卓上ゲームを\n繰り返すようになった。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("つまり、真実としては逆だ。\n\n連合議会に認められた「利害関係者」こそが、\n国の元首になる資格があると呼べる。", "マリル")
	await novel_interface.show_dialog("組織の初めての行動は、3年前のあの時──", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは間を開けて、息を深く吸い込む。\n\nランボットは彼女を静かに見つめた。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("3年前、連合議会と教皇庁が南米で密かに\nEX級の異質物のテストを行っていた。\n激しい圧力をかけられた地元の軍閥も、\n大人しく協力する他なかった。", "マリル")
	await novel_interface.show_dialog("実験は失敗して暴走。結果、4万6千人が死亡。", "マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("その事件を『チュルン川大虐殺』とし、\n唯一あなた方に協力しなかった軍閥──\n──カルロス・ブランコに罪を擦り付けた。", "マリル")
	await novel_interface.show_dialog("凄惨な事件は世界中のメディアに注目され、\n連日連夜に渡って報道される。\n民衆の高まった厭戦感情はこの事件を契機に\nついに爆発。", "マリル")
	await novel_interface.show_dialog("そして合同軍事作戦を実行し、ブランコの軍閥を\n見せしめとして処刑した。\n連合議会が正義の組織である事の証明にもなり、\nまさに一石二鳥だ。", "マリル")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("まあ、今更そこを咎めても仕方がないからな、\n私が気になっている点を聞こう。\n実験現場の数万人の死体は……教会を中心に\n6方向へ均等に拡散して倒れていたのだろう？", "マリル")
	await novel_interface.show_dialog("あなた達は半径3キロ圏内のあらゆる電磁波を\n妨害する異質物兵器も投入した。\n万全を期して真実の隠蔽を図ったわけだな？", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("似たような異常は西アジアの戦場でも\n起きた事例がある。\n光も電磁波の1種であるから、遠くの衛星ですら\n正常な映像を撮影する事はできない。", "マリル")
	await novel_interface.show_dialog("『あの扉』が閉じた後、エリア全体の電磁妨害が\n数週間続いたのはそれしか考えられん。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("わざと『あの扉』という言葉を強調するマリル。\nそれを聞いたランボットはゆっくり目を閉じた。")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("マリルは手に持っている写真を見つめる。")
	await novel_interface.show_dialog("大量の死体を清掃するには、作業員も比例して\n必要になり、\n厳格な管理は人数が増えるほど難しくなる。", "マリル")
	await novel_interface.show_dialog("……思いも寄らなかったのだろう？ \n\n骨董品のカメラとカビの生えたフィルムで、\n誰かがこんな写真を撮影するなんて。", "マリル")
	await novel_interface.show_dialog("写真の遠景部分が不自然にぼやけている原因は、\n異質物武器が光を歪めていたからだな。", "マリル")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("……どうして私があの事件に参加していたと\n思うのかね？", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("この事件の1ヵ月前、あなたは連合議会により\n『異質物武器実験禁止条約組織』の\n執行部総長に任命された。", "マリル")
	await novel_interface.show_dialog("組織の表向きは全ての異質物武器の実験禁止を\nマニフェストに掲げている。\n連合議会の直属ゆえに、非常に大きな資源と\n強い情報能力を有しているみたいだな。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("そんな組織の総長様として行動しているのならば\nあれほどの巨大事件を知らないわけがない。 \nだが、批判的な活動もせず黙り続けた\nということは……\nあの実験の主導者はあなたかもしれないと、\n少なくとも疑うだろう？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──ランボットは反論をしない。\n\nマリルは一方的な追撃をかける。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("最終的には教皇庁が例の異質物を回収した。\n\nだからこそ連合議会は教皇庁側に特別な援助と\n権限を与えざるを得なくなった。", "マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("異質物がどんなモノであるか私が教えようか？\n\nそれは半開した純黒の扉で、中から眩しい\n金色の光が──", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("はっ、降参だ！ これ以上は言わなくて結構！", "ランバート")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットはマリルの責め句を制止すると、\n両手を上げて負けを認めた。")
	await novel_interface.show_text_only("それからスーツの襟を締めて、少し声のトーンを\n調整しながら話し始める。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("私達の仕事は、確かに異質物武器の実験を\n誰にもさせないよう尽力する事だ。", "ランバート")
	await novel_interface.show_dialog("異質物は危険すぎる。\n\n少しの誤りで文明を破滅へと導くリスクを\n内包しているからな。\nしかし……あの実験だけは、せざる他なかった。", "ランバート")
	await novel_interface.show_dialog("ノックの音が、あの扉の向こう側から\n伝わってきたのだよ。\nそれは時が経つごとに激しさを増していった……\n\n扉が開かれる事は、もはや避けられない\n状態だったのだ。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("……ノック？", "マリル")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("──『天国の扉』", "ランバート")
	await novel_interface.show_dialog("現存する各宗教と神話体系にはそれぞれの\n定義した天国が存在するが、\nその全ては同じ根源から来たのかもしれん。", "ランバート")
	await novel_interface.show_dialog("歴史の記述によると、あの扉が開かれる前は\n「トントントン――」と\nノックの音が3回連なって聞こえてくるようだ。", "ランバート")
	await novel_interface.show_dialog("その響きは低く、奥底から疼くかのような……\n聞いた者の魂を叩くかのような音らしい。", "ランバート")
	await novel_interface.show_dialog("最初は1週間おきにノックの音が鳴り始め、\nそこから次第に間隔は短くなっていく。", "ランバート")
	await novel_interface.show_dialog("間隔が90秒より短くなると、\n扉はいつでも開かれる可能性が生まれ……", "ランバート")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("扉の存在をどう定義するかは君の自由だが……\n\n「アレ」には世界終末レベルの厄災を引き起こす\n力があると断言できる。\nこの点に関して疑う余地はない。", "ランバート")
	await novel_interface.show_dialog("例えるなら超大型の洪水のようなものか……", "マリル")
	await novel_interface.show_dialog("教皇庁の文献の中に、唯一「扉」を制御する\n方法が記載されていた。\n扉を中心にした狭い範囲に数万人を集め……", "ランバート")
	await novel_interface.show_dialog("何かの生贄か？", "マリル")
	await novel_interface.show_text_only("ランボットはその言い方を否定せず、続ける。")
	await novel_interface.show_dialog("このような事件は数百年のペースで繰り返し\n発生している。\nその度に「扉」を中心として放射状に\n死体の山が築かれた。", "ランバート")
	await novel_interface.show_dialog("基本的に「儀式」は秘密裏に行われるらしいが\n歴史的な事件に利用される場合もあった。", "ランバート")
	await novel_interface.show_dialog("──例えば1572年\nパリで起きたサン・バルテルミの虐殺。", "ランバート")
	await novel_interface.show_dialog("サン・バルテルミの祝日の前夜。\n\n「数世紀内で最も恐ろしい虐殺」と言われる\n事件が起き、死者は7万にも及んだ。", "ランバート")
	await novel_interface.show_dialog("パリ……", "マリル")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("扉を中心に……放射状に……？", "マリル")
	await novel_interface.show_text_only("パリにある最も有名な名所の地形を、\nマリルは思い出す。")
	await novel_interface.show_dialog("歴史的な象徴として揶揄されたのかも\nしれんな。", "ランバート")
	await novel_interface.show_text_only("ランボットの声は少し皮肉を帯びていた。")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("ノックができるのであれば形ある物質のはずだ。\n\n破壊、もしくはロケットで太陽系から\n放り捨てる事はできなかったのか？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("『天国の扉』はただの概念に過ぎない。\n\n人々の概念として自ら居場所を選ぶ。", "ランバート")
	await novel_interface.show_dialog("神聖な扉に出現するケースが多いようだが、\n城壁にも出現した例もあるな。\n如何にしても必ず人間の身近に現れるのだ。\n物理的な方法で逃れる事は不可能だろう。", "ランバート")
	await novel_interface.show_dialog("ある意味では最も神の力を表現している\n聖物と言えるか……\n人類滅亡の一端を担う厄介な存在ではあるが、\n力の象徴とするならば絶対的にも見えよう。", "ランバート")
	await novel_interface.show_dialog("故に歴史上において各宗教派閥は、この概念の\n所有権を争い続けてきた。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("概念なのだろう？ どうやって奪い合うんだ？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("歴史上ではハギア・ソフィア大聖堂が最も長い\n期間、天国の扉の所有権を持っていたそうだ。", "ランバート")
	await novel_interface.show_dialog("後に15世紀フィレンツェの彫刻家ギベルティが\n生涯をかけて作り上げた作品によって、\nその「概念」を奪った。", "ランバート")
	await novel_interface.show_dialog("作品は1452年にサン・ジョヴァンニ洗礼堂の\n正門となり、\n世界の誰もが認める『天国の扉』となる。\n\n遂に『天国の扉』がその場所に定着したのだ。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("そういう事か……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("豪勢かつ壮大な作品を使い、自己の証明を\n行う事……\nそれが概念を奪い合う人間にとっての\n最古の方法だ。")
	await novel_interface.show_text_only("ピラミッド、寺院、宮殿、王冠、玉座、\n全てがそうであったように。\n自己の正当性という概念は、最も認められている\n人物は自分だと証明する事が1番の近道である。")
	await novel_interface.show_text_only("──いわば人々の認識だ。\n\n「あれは『天国の扉』だ」と多くの人が概念的に\n認めた物質が『天国の扉』と化すのだ。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("作品が完成した翌年、ハギア・ソフィア大聖堂を\n擁するコンスタンティノープルは占領された。\n原因は象徴であった『天国の扉』が\n無くなったからか……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ランボットは首を横に振る。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("あの頃の歴史はずっと謎のままで、\n直接的な証拠は一切ない。", "ランバート")
	await novel_interface.show_dialog("私が結論として言える事は1つだけだ。\n\n七年戦争時にギベルティの作品が破壊された。\nその際の顛末……", "ランバート")
	await novel_interface.show_dialog("次の扉の出現場所を正確に把握した後、\n制御可能なエリアへ留める事を保障するには──", "ランバート")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("教皇庁と協力して複製品を作る以外に、\n方法は存在しなかったのだ。", "ランバート")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("しかし実験は失敗。\n扉は予定通りに閉じる事ができなかった。\n教皇庁があれほど代償を惜しまなかったのは、\nそれが理由か……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ようやくバラバラだったピースが繋がってきた。\n\n一連の行動の背後にある合理性が、\nやっと見えてきたのだ。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("その後の情報の上書きとメディアの誘導は、\nまさに芸術と言っていいほどの素晴らしさだ。\n選んだ身代わりも完璧だったな……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルの言葉を聞いたランボットは肩をすくめて\n仕方のない感じに笑った。")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("それは喜ぶべきかね？\n\nそれとも皮肉と取るべきかね？", "ランバート")
	await novel_interface.hide_character()
