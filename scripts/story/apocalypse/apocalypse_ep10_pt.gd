	await novel_interface.show_dialog("Se atrairmos a atenção desses caras, não estarei protegendo você das balas!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya olha para minhas coxas macias e sem músculos com um sorriso desdenhoso. Ela provavelmente pensa que sou uma criança inútil que nem sabe se esquivar de balas. E ela não está errada.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Como encontramos Elluka entre tantas pessoas?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho em volta para a multidão tagarela, sentindo uma pontada no coração ao imaginar a pequena Elluka, perdida no meio de tudo isso, aterrorizada e indefesa.")
