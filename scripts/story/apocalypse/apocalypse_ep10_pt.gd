	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("Uau!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya está prestes a dar um salto voador sobre o peito de Beatrice, mas eu a puxo de volta bem a tempo.")
