	await novel_interface.show_text_only("Sonya passa a mão no meu seio e aperta um mamilo.")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("Respire?", "Lian")
	await novel_interface.hide_character()
	
