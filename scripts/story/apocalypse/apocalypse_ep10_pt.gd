	await novel_interface.show_dialog("(Que tipo de história estúpida é essa? Quem compraria isso, afinal?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Eu realmente gostei de percorrer as edições...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De qualquer forma, as empresas da região aproveitaram a oportunidade para fazer do dia um festival anual onde os compradores ganham descontos incríveis. Isso atraiu muitos patrocinadores também.")
