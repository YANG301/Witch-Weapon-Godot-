	await novel_interface.show_dialog("(Que tipo de interpretação é essa?)\n(E isso significa que ela também acha que sou anormal?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("A razão pela qual os europeus consideram anormais aqueles com complexos de lolicon é provavelmente porque o europeu médio gosta mais de mulheres com seios grandes. Por exemplo...", "Soya")
