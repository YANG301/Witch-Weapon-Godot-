	await novel_interface.show_dialog("Uh... não somos fugitivos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dou uma espiada nos policiais próximos, me perguntando se Sonya precisará derrubá-los com algum outro dispositivo maluco também.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Basta manter a discrição.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya me belisca e aponta para alguns veículos do outro lado da rua.")
	novel_interface.show_character("soya_uniform", "smile")
