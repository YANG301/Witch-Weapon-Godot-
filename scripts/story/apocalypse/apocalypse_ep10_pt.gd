	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya coloca a mão na frente do peito, parecendo bastante orgulhosa.")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Ser anormal é bom, não há necessidade de explicar sua anormalidade para aqueles plebeus mundanos. Você pode simplesmente admitir isso em vez de tentar encontrar desculpas para isso.", "Soya")
