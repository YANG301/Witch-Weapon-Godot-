	await novel_interface.show_dialog("Ah, aquela garota? Ela está bem ali.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Hein?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya aponta para o caminhão com cartazes à nossa frente, decorado como uma espécie de santuário. E a menina sentada na posição do deus adorado? Elluka.")
