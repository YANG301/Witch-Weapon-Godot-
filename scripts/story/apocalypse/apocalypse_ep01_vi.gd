# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Chúng ta được dạy đủ loại đức tính để sống theo.")
	await novel_interface.show_text_only("Tôi chắc rằng hầu hết chúng ta đều đã đọc câu chuyện về Marie Curie và khả năng tập trung phi thường của bà.")
	await novel_interface.show_text_only("Cô đang học bài thì chị gái và các bạn cùng lớp đã bày ra một trò đùa. Họ xếp vài chiếc ghế lên phía sau cô. Nếu cô ấy di chuyển, toàn bộ chồng sách sẽ đổ sụp xuống.")
	await novel_interface.show_text_only("Nhưng chồng sách vẫn ở nguyên đó cho đến khi Marie Curie đọc xong toàn bộ cuốn sách.")
	await novel_interface.show_text_only("Trọng tâm lớn của cô là điều đã giúp cô trở thành nhà khoa học đầu tiên hai lần nhận được giải thưởng Nobel.")
	await novel_interface.show_text_only("Nhưng câu hỏi này có thể đã xảy ra với bạn:")
	await novel_interface.show_text_only("\"Có phải mọi người đều cảm thấy giống nhau về cùng một chủ đề không? Kể từ khi họ được sinh ra?\"")
	await novel_interface.show_text_only("Một số người sinh ra đã có khả năng tiếp thu kiến thức không ngừng nghỉ và hầu như không cần ngủ.")
	await novel_interface.show_text_only("Họ có thể ghi nhớ rất nhiều thông tin và duy trì sự tập trung trong thời gian dài.")
	await novel_interface.show_text_only("Thật dễ dàng cho họ. Nhưng đối với nhiều người khác, điều đó là không thể.")
	await novel_interface.show_text_only("Có lẽ, với Marie Curie, đọc sách vật lý dễ hơn đọc truyện tranh.")
	await novel_interface.show_text_only("Vì vậy, đối với hầu hết mọi người, việc phấn đấu hướng tới những “đức tính” giống nhau cũng giống như việc đấu tranh chống lại những đặc điểm di truyền mà họ sinh ra đã có.")
	await novel_interface.show_text_only("Có lẽ bạn chưa từng xem xét câu hỏi này trước đây?")
	await novel_interface.show_text_only("Nhưng bây giờ bạn có. Hạt giống đã được gieo vào đầu bạn.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Vậy...")
	await novel_interface.show_text_only("Lần tới khi bạn tự hỏi mình câu hỏi này, giọng nói của ai sẽ hỏi nó?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Bấm vào.")
	await novel_interface.show_text_only("Tiếng súng được nạp đạn.")
	await novel_interface.show_text_only("Sau đoạn mở đầu của NTBC News là giọng nói quen thuộc của nữ phát thanh viên.")
	await novel_interface.show_dialog("“Diễn đàn hòa bình quốc tế thường niên lần thứ tư sẽ được tổ chức tại Khu phi quân sự đã được thỏa thuận ở New Opulentia trong ba ngày nữa.”", "Tin tức")
	await novel_interface.show_dialog("“Là thành phố trung lập có hệ thống nghiên cứu khoa học lớn nhất, New Opulentia sẽ chào đón các vị khách từ năm Thành phố Học viện khác trong tuần này.”", "Tin tức")
	await novel_interface.show_dialog("“Diễn đàn Hòa bình năm nay sẽ tập trung vào việc phát triển Chất H như một nguồn năng lượng, Dự án Tái thiết và các vấn đề quan trọng khác.”", "Tin tức")
	await novel_interface.show_dialog("“Chủ tịch Masada Ford đã tuyên bố trong một bài phát biểu không chính thức gần đây rằng thành phố sẽ sớm công bố một loạt kế hoạch quân sự hoàn toàn mới nhằm thiết lập lại trật tự ở Trung Đông.”", "Tin tức")
	await novel_interface.show_dialog("“Đại diện của Sở Tin tức Salmonton đã từ chối bình luận về chủ đề này.”", "Tin tức")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Trong căn nhà kho cũ, ngọn đèn trần treo lờ mờ, phát ra những tiếng điện xèo xèo nhỏ.")
	await novel_interface.show_text_only("Ở một bên, một người đàn ông tóc bạc đang ngồi dưới ánh sáng trắng gắt.")
	await novel_interface.show_text_only("Anh ta bị trói trên một chiếc ghế chắc chắn có chân được hàn vào đất.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("Người đàn ông vẫn đang làm quen với ánh sáng xung quanh vì chiếc bao tải trên đầu anh ta vừa được cởi ra. Những sợi dây gia cố thô ráp của con tàu cọ xát vào bộ đồ tùy chỉnh đắt tiền của anh ta, để lại những đầu thô ráp, sờn.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhận thấy tiếng súng được lên cò, anh từ từ ngẩng đầu lên.")
	await novel_interface.show_text_only("Ngay trước mặt anh là một chiếc camera được gắn. Và bên cạnh đó, một kẻ bắt cóc đeo mặt nạ đen đang đứng, chĩa súng vào anh.")
	await novel_interface.show_text_only("Người đàn ông cố gắng nhìn xung quanh một cách tuyệt vọng. Anh ta phát hiện một người bảo vệ ở cuối nhà kho, tay cầm một khẩu súng trường tấn công.")
	await novel_interface.show_text_only("Từ chiếc khăn rằn đen che mặt cho đến bộ trang phục rằn ri, khá rõ ràng những kẻ này đến từ đâu.")
	await novel_interface.show_text_only("Người đàn ông tóc bạc vặn vẹo hết khả năng của mình. Ở rìa tầm nhìn của anh ta, anh ta nhìn thấy một lá cờ đen...")
	await novel_interface.show_text_only("Trên chiếc máy quay trước mặt anh có gắn một chiếc điện thoại di động đang phát tin tức ở mức âm lượng cao nhất.")
	await novel_interface.show_dialog("“Ngài Lumbert, thư ký điều hành của Tổ chức Hiệp ước cấm thử nghiệm vũ khí chất H, đã tổ chức một cuộc họp báo ngày hôm nay.”", "Tin tức")
	await novel_interface.show_dialog("\"Tổ chức này đóng một vai trò quan trọng trong việc ngăn chặn Chất H bị biến thành vũ khí. Nó được thành lập dựa trên Hiệp ước cấm thử nghiệm vũ khí Chất H phổ quát.\"", "Tin tức")
	await novel_interface.show_dialog("“Ngài Lumbert tuyên bố rằng tổ chức hiện đã thành lập một số lượng lớn các trạm giám sát trên toàn thế giới để giám sát tất cả các thí nghiệm về Chất H.”", "Tin tức")
	await novel_interface.show_dialog("“Lumbert tin rằng hợp tác quân sự giữa các Thành phố Học viện nên trở thành một phần bình thường hóa trong quan hệ ngoại giao của họ.”", "Tin tức")
	await novel_interface.show_dialog("\"Anh ấy tuyên bố hỗ trợ Masada Ford phát triển và thử nghiệm hệ thống chống trả thụ động của họ. Anh ấy giải thích rằng mức độ đe dọa hợp lý là cơ sở thực sự để duy trì hòa bình.\"", "Tin tức")
	await novel_interface.show_dialog("“Ông ấy cũng công khai yêu cầu một cơ hội được trò chuyện với Tiến sĩ Mariru Von Braun của Học viện Khoa học New Opulentia…”", "Tin tức")
	await novel_interface.show_text_only("Nghe vậy, người đàn ông bị trói trên ghế khẽ nhếch mép.")
	await novel_interface.show_text_only("Mái tóc bạc hoàn hảo của anh được chải ngược ra sau. Đôi mắt màu xanh lam thờ ơ nhìn vào vài bức ảnh treo trên tường đối diện.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Trên một bức ảnh mờ, một vài công nhân mặc đồ bảo hộ đang xử lý đống xác chết.")
	await novel_interface.show_text_only("Đánh giá từ độ phân giải thấp của các bức ảnh, chúng hẳn được chụp bằng máy ảnh SLR và phim lỗi thời.")
	await novel_interface.show_text_only("Anh nhớ rõ ràng rằng, vào thời điểm đó, họ đã sử dụng sóng giao thoa điện từ mạnh trong bán kính vài dặm để ngăn cản người khác quay phim khu vực đó.")
	await novel_interface.show_text_only("Theo ngày tháng ở phía dưới bên trái, bức ảnh được chụp cách đây ba năm bên bờ sông Churun, tại Guyana Shield...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("Bấm vào!")
	await novel_interface.show_text_only("Người đàn ông mặc đồ đen tắt điện thoại và bất ngờ đá vào bụng người đàn ông tóc bạc.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Ờ! *ho*", "Người đàn ông mặc vest")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Không thể chịu nổi vẻ ngoài giả tạo của ông trên TV phải không, thưa ông?", "Kẻ bắt cóc")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Giả mạo?\nTôi đã... chân thành.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người đàn ông mặc đồ đen đến gần Lumbert, túm tóc và kéo đầu anh về phía sau, buộc anh phải đối mặt trực tiếp với nguồn sáng duy nhất trong phòng.")
	await novel_interface.show_text_only("Sau đó anh ta rút ra một chiếc lưỡi hái và nhắm vào mắt Lumbert.")
	await novel_interface.show_dialog("Chà, tôi tự hỏi khuôn mặt của bạn đáng giá bao nhiêu?", "Kẻ bắt cóc")
	await novel_interface.show_text_only("Với ánh sáng chiếu thẳng vào mắt người đàn ông, đồng tử màu xanh lam của anh ta mờ đi nhanh chóng.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Vì vậy, bạn nói gì? Đặt tên cho giá của bạn.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert lén liếc nhìn lưỡi dao Thép Damascus đang chĩa vào nhãn cầu của mình.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Anh lẻn vào New Opulentia, nắm được toàn bộ lịch trình của tôi và kết liễu tất cả vệ sĩ của tôi trong vòng hai phút...", "Lumbert")
	await novel_interface.show_dialog("Và thậm chí còn có được những bức ảnh đó...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Không thể nào bạn làm tất cả những điều đó chỉ để quay đoạn video tôi bị chặt đầu. Bạn phải có động cơ nào đó khác.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lý luận sáng suốt của Lumbert khiến người đàn ông mặc đồ đen phải ngạc nhiên.")
	await novel_interface.show_text_only("Anh ta thả Lumbert ra khỏi vòng cổ và tát một tờ giấy lên mặt anh ta.")
	await novel_interface.show_dialog("Chà, vậy thì hãy bắt đầu lăn bóng thôi. Tôi sẽ cho bạn sáu mươi giây để trả lời tôi. Thỏa thuận hay không thỏa thuận?", "Kẻ bắt cóc")
	await novel_interface.show_text_only("Tờ giấy trượt xuống quần của Lumbert. Anh ta nhìn xuống - trên đó có in mười hai tài khoản tiền tệ được mã hóa và giá thực tế.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Ừm. Bạn đã có một mức độ tự chủ nào đó. Thật tốt khi thấy điều đó.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert liếc nhìn ra ngoài cửa sổ. Ngày dường như đang rạng đông.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Sau khi giữ tôi làm con tin suốt 12 tiếng đồng hồ, họ bắt đầu đàm phán với một mục tiêu rõ ràng.)")
	await novel_interface.show_text_only("(Chỉ những kẻ bắt cóc có kinh nghiệm mới làm điều đó. Họ phải được đào tạo bài bản...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert nheo mắt nhìn những con số được liệt kê trên tờ giấy.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Nếu tính đến tỷ giá hối đoái, có vẻ như những con số này phù hợp với khoản bảo lãnh cho danh sách những kẻ khủng bố mà Hội đồng Liên Hợp Quốc vừa công bố...", "Lumbert")
	await novel_interface.show_dialog("Bạn không đến từ quân Kháng chiến phải không?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Câu hỏi bất ngờ của Lumbert khiến kẻ bắt cóc mất cảnh giác.")
	await novel_interface.show_dialog("Hả?", "Kẻ bắt cóc")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Tôi hoan nghênh bạn vì nỗ lực hành động như những kẻ khủng bố, nhưng tôi cá rằng bạn được Menorah từ Masada Ford cử đến—", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Im đi!", "Kẻ bắt cóc")
	await novel_interface.show_text_only("Người đàn ông mặc đồ đen tiến nhanh về phía Lumbert, sẵn sàng hạ gục anh ta.")
	await novel_interface.show_text_only("Và người sau đột nhiên lên tiếng, hét lên bằng tiếng Do Thái:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(tiếng Do Thái) Bom! Xuống đi!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người bảo vệ ở cuối nhà kho theo bản năng giơ tay lên che đầu và sau khi nhận ra đó là một cái bẫy, anh ta chộp lấy vũ khí và nhắm vào Lumbert.")
	await novel_interface.show_text_only("Người đàn ông mặc đồ đen chắc chắn không mong đợi điều này. Nhưng rõ ràng là vỏ bọc của họ đã bị thổi bay bởi hành động phản xạ của đồng đội anh.")
	await novel_interface.show_text_only("Lumbert mỉm cười chế giễu.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Vậy đây có phải là kịch bản bạn đang theo dõi không? Tôi đã bị bắt cóc bởi những kẻ khủng bố từ quân Kháng chiến, những kẻ tuyên bố đang sở hữu bằng chứng về việc Quốc hội Hoa Kỳ thực hiện các thí nghiệm Chất H bất hợp pháp...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert liếc nhìn những bức ảnh trên tường một lần nữa.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Tôi hiện là người duy nhất công khai thể hiện sự ủng hộ đối với Masada Ford trong việc xây dựng hệ thống phản công tự động nhằm mục đích đe dọa. Việc quân Kháng chiến bắt cóc tôi là điều hợp lý.", "Lumbert")
	await novel_interface.show_dialog("Tôi là một nhân vật khá nổi tiếng nên chuyện này sẽ xuất hiện trên khắp các bản tin. Nhiều người sẽ bắt đầu coi phe Kháng chiến là những kẻ khủng bố điên cuồng.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Và bạn cũng có thể dùng những bức ảnh đó để buộc Quốc hội Thống nhất ho ra tiền dưới dạng tiền mã hóa... một mũi tên trúng ba con chim.", "Lumbert")
	await novel_interface.show_dialog("Giao dịch tiền tệ được mã hóa được hiển thị đầy đủ trên kênh công khai. Sau khi họ trả tiền, có vẻ như họ đã công khai thừa nhận rằng trước đây họ đã tiến hành các thí nghiệm về Chất H bất hợp pháp.", "Lumbert")
	await novel_interface.show_dialog("Trong tương lai, Masada Ford sẽ có thể sử dụng điều này để đe dọa các Thành phố Học viện khác nhằm hỗ trợ hệ thống phản đòn thụ động của bạn. Sẽ không ai dám từ chối bất kỳ yêu cầu nào của bạn.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Phân tích của anh ấy chính xác 100%. Người đàn ông mặc đồ đen sững người vì sốc, không biết phải làm gì.")
	await novel_interface.show_text_only("Dù bị kiềm chế nhưng Lumbert hiện đã chiếm thế thượng phong.")
