# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("ここにいる人達の全員が『男性』よ♡", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは微笑みながら右手を上げ、\n薄青く光る灰緑色のブレスレットを俺に見せた。")
	await novel_interface.show_text_only("ミーム類に属する異質物の影響を遮断できる\n特殊合金で愛衣が特別に作った代物……\nあれが彼女の『呪い』の効果を制御できる\nアイテムだ。")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("待って、まさか……", "レン")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──自分を見た人間を惚れさせてしまう能力。\n\nそんな『呪い』についてマリルが数週間前に\n詳しく説明してくれた。")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("正確に言うと、彼女の顔だ。", "マリル")
	await novel_interface.show_dialog("愛衣の一連の実験によると、\nベアトリーチェの顔を直視した男性の脳は、\n紡錘状回と扁桃体領域が極度の興奮状態に\n陥ってしまうらしい。", "マリル")
	await novel_interface.show_dialog("それは80メートル以内の直視のみに\n限定されている。\n写真、動画、鏡面反射で効果は発生しない。", "マリル")
	await novel_interface.show_dialog("この興奮状態がしばらく続くと、脳に不可逆的な\n変化が起こり行動パターンまでもが変わる。", "マリル")
	await novel_interface.show_dialog("彼女に対して心から独占欲が沸き上がり──\n\nそれが手に入らなければ焦燥、狂乱、憎しみへと\n変換されていく……\n最後には自傷行為や放火などの暴力的傾向まで\n持つように……", "マリル")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("まさに恋愛の現実を正確に表現しているな……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルがやれやれといった様子で溜め息を吐く。")
	await novel_interface.show_text_only("愛衣がどうやってそんな実験結果を、\n導き出したのか聞いてみようと思ったけど……\n考えると恐ろしくなって、\nやっぱ知らない方がいいやと自己完結した。")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("（とにかく今回、愛衣のモルモットが\n　俺じゃなくて本当に良かったよ……）", "レン")
	await novel_interface.show_dialog("昨日の命令が「とある服装」でベアトリーチェに\n歴史を教えて貰うって変な任務だったけど……\n……………………", "レン")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("いや、ちょっと待てよマリル？\n昨日の命令ってもしかしてさ？", "レン")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("まさかアレって愛衣の実験じゃないよな……", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("おいおい、今さら気付いたのか？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("やっぱりか！？")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("その様子では……\n\n昨日装着していたブレスレットが偽物だった\nという事も気付けていないみたいだな。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは呆れた顔で、驚愕の俺を見る。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("あの服を指定したのは、お前の主観的な感覚が\n実験データを汚染しないように、\n『羞恥心』を使って『恋愛感情』を\n紛らわせるためだ。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("そして……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は急に俺の肩を両手で握って妙な笑顔を\n浮かべた。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("バニーガールのお前は……最高だったぞ♡", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("うぎゃああああああぁぁ――ッッッ！！！\n\n記憶から消せええぇぇぇ――――ッッッ！！！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バニーガール衣装の俺とベアトリーチェが\n1時間も対峙した、あの地獄のような密閉空間。")
	await novel_interface.show_text_only("緊張で歩く時は手と足が一緒に出てしまうし、\n顔が真っ赤になったまま何も喋れなくて。")
	await novel_interface.show_text_only("ベアトリーチェも辛かっただろう。\n\n俺を慰めつつ笑いを1時間も堪え続けなければ\nならない状態なんてさ……")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("あの時の脳を3Dスキャンにかけて確認すると、\n花火みたいだったと愛衣は言っていたな。\nもう少しデータが欲しかったが、緊張で脳圧が\n高まり過ぎて実験を中断せざるを得なかった。", "マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("だが途中経過だけでも重要な事が判明している。\n\nお前の脳は男性のようにベアトリーチェに対して\n興奮はするが、特に変質したりはしない！", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("他の人間ならば短くて40秒、長くて8分で\n永久に烙印が押されてしまうが……", "マリル")
	await novel_interface.show_dialog("これで非常に安心しただろう？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("何が安心だあああぁぁぁ――――！！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……………………")
	await novel_interface.show_text_only("……最近消したい記憶が多すぎる。")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("（……ま、まあともかくだ。）\n\n（つまりは、もしここでベアトリーチェが\n　ブレスレットを外してしまえば──）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェは優しく微笑むと俺を抱きしめ、\n両手を俺の背中に回した。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("俺の視界が遮られて目の前は真っ暗になる。")
	await novel_interface.show_dialog("──むぐぅっ？", "レン")
	await novel_interface.show_dialog("私が「スタート」と言ったら、あなた達には\n30秒間の猶予が与えられるわ。", "ベアトリーチェ")
	await novel_interface.show_dialog("イルカちゃんを救出したら私と別行動よ。\n\n近くの新井センターパークならデモは起きて\nないし、そこで落ち合いましょう。", "ベアトリーチェ")
	await novel_interface.show_dialog("──いいわね？", "ベアトリーチェ")
	await novel_interface.show_text_only("俺は少しだけ頷いて、なるべく目の前の柔らかい\n感触を意識しないようにする。")
	await novel_interface.show_dialog("わ、わたくしにもッ！！\n是非わたくしにもッ！！", "ソヤ")
	await novel_interface.show_text_only("「カチッ」")
	await novel_interface.show_text_only("金属の留め具から音がなると、ブレスレットが\n解除される。")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("ソヤの目にはピンク色のカーテンが、\n一瞬で電気街全体を覆っていくように映った。")
	await novel_interface.show_text_only("午後に本屋で買い物をしていた時、\n見えていた物と同じ色だ。\nこの色をしている物は「自分の欲しかった内容」\nの匂いを放っている。")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("もしやあなたも……魔女ですの！？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("あら？ あなたは魔女の特徴を見分けられるの？", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("雰囲気はイルカちゃんやラファエルさんとは\nまた違いますの……", "ソヤ")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("だけど気配はレンさんと限りなく近い……！\nまるで赤ん坊のように純粋ですわ！！", "ソヤ")
	await novel_interface.show_dialog("…………なんて、本当に面白いのでしょうッ！！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("声を跳ね上げて異常な興奮を見せるソヤ。\n\n必死に俺の背中を揺らし始める。")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("ううあうぐぇっ！！\n（息ができないってッ！！）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("この身体は確かに、私の記憶の身体より\n軽いわね──\nこの可愛い子ちゃんのおかげよ～～", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("巨乳のお姉さんは、腕の中の俺を更に強く\n抱き締めた。")
	await novel_interface.show_text_only("感激……………\n\n……じゃなくて。\n俺は手を振るって必死にもがく。")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("……あなたは一体、何者ですのっ！？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("あら、そういえば自己紹介を忘れていたわ。\n私の名前はベアトリーチェ・ポルティナーリ。\nよろしくね？", "ベアトリーチェ")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("──90分間前。")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("──協定非武装地域内、新豊洲鷺華園ホテル。")
	await novel_interface.show_text_only("最上階の宴会場──聴鸝堂の外。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("99階に屋外庭園を造るとは……\n\n華雲宮城の奴ら、みんなこんなのが趣味なのか？", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは庭園の上部に取り付けられていた\nガラス屋根を見て嘲笑する。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("高ければ高いほど尊敬されると思って\nいるのかも……\nそれに99という数字は縁起担ぎかしら？", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髪の少女は困ったように頭を掻いた。")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("それにしても、どうやってこのオークションを\n特定したの？", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは宴会場の前にある広告に視線を向けた。")
	await novel_interface.show_text_only("見出しには「致元博物館、秋のオークション」\nと記載されており、\n下部には「芸術と金融の新たな交流パターン」\nと小さい字が書かれてある。")
	await novel_interface.show_text_only("青地に白い文字のデザインがとても派手で、\n芸術品のオークション会場だとは信じられない。")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("目立つだけで雑よね？ \n詐欺師が作った広告みたいだし……", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは笑いながら頷いた。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("だが実際は満員御礼、用意されていた\n500席全てが埋まっている。\n全63件の競売品もすでに60件が出品され、\n売れ残りは1つもなし。", "マリル")
	await novel_interface.show_dialog("この60件の成立総額を合わせれば、\nすでに15億を超えている。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("そんなに！？ もう世界規模で動くような\nオークションじゃない！\nそんなオークションを、あたしが知らない\nなんて……", "スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("君が以前提供してくれた暗号通貨の口座には、\n数十億の資金が入っていた。", "マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("少ない額ではないが、これぐらいのビルを\n2軒建てる程度で関の山と言ったところか。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("これっぽちの金額で連合議会の数兆にも及ぶ、\n再建基金の行方を影響させる方法はただ1つ──", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("わざわざ電子暗号通貨を使っているって事は……\n……賄賂？", "スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("口座は暗号化されているが取引自体は全員に\n公開される。\nそれほどの大規模な資金移動を誰にも気付かれず\n行う事は不可能だ──", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("となると合理的な説明で誤魔化す必要がある……", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは首を傾げながらも、\nすぐに答えを導き出した。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("オークション！", "スクルド")
	await novel_interface.show_dialog("値段が固定化されていない骨董品なら、\n高額の資金を動かしやすいって事ね。\n磁器や玉器、古画の芸術品なら100万円単位で\n出品されても違和感なんてないし。", "スクルド")
	await novel_interface.show_dialog("そして国際領土での取引なら、税金を徴収する\n権利は各国全ての税務部門が持つ事になるわ。\n分割での徴収は複雑化するし、奪い合いは火種に\nなるしで誰も権利を行使できなくなるわね。", "スクルド")
	await novel_interface.show_dialog("事前に取引する人同士で連絡をしておいて、\n適当な品物を個人博物館の名義で売買すれば、\n容易く堂々とお金の移動ができる。", "スクルド")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("でも事情を知らない熟練バイヤーがいた場合は\n通用しないかも？\n下手するとバレちゃうし……", "スクルド")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("あっ、だから空席がないんだ！\n全員が自分達の手配した人間だって事？", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルはスクルドの頭を撫でた。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("御桜川中等部の授業は、君にとって退屈じゃ\nないか？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("秘密だよ～～♪", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは得意げにマリルを見つめる。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("今日は特別授業として、少し補足してやろう──", "マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("『戦後再建基金』の本質は連合議会が用意した\n貸付金だな。\n金を借りた政府が返済しなかった場合は、\n六大学園都市を丸ごと敵に回す事になる。", "マリル")
	await novel_interface.show_dialog("しかし借金を背負った者が時間通り返済するなど\nできる事の方が歴史上では稀だ。\n間に合わなかった場合に起こるのは、\n大いなる交渉の余地。", "マリル")
	await novel_interface.show_dialog("理事会の奴らは電力や通信といったインフラなど\n最も利益のある『一部』を欲しがるだろう。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("電力施設に関する借金は返済しなくてもいいが、\n条件として永久に施設の30%の株を譲渡しろ、\nと相手の首脳にそう言えばいい。", "マリル")
	await novel_interface.show_dialog("抵抗を見せるならまだマシだが、返済できない\n政府は条件を飲まざるを得ないだろう。\n不正な売上割戻を裏で提案すれば、\n即座に国を売る国家元首も現れるだろうな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("でも、その『一部』を連合議会の同意の下で、\n交渉するって至難の業じゃない？", "スクルド")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("再建基金に関与する権利を与える事、\nある程度の自主選択権を国際企業に与える事、\nそれぞれを連合議会に認めさせないと\nいけないし……", "スクルド")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("この譲歩は大き過ぎるわ。そんな事ができるの？", "スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは質問に答えはせず、逆に質問を返した。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("君はこの雑な広告が何を意味すると思う？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("偽装をちゃんとしていないって事かしら。", "スクルド")
