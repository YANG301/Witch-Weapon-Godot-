# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("Ela ri, inclinando-se casualmente para mim, finalmente deixando a cabeça cair no meu ombro.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("... Obrigado, Ren.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Poderíamos fazer com que Aya examinasse você...\nEla é muito habilidosa, sabe? Ela definitivamente encontrará uma maneira", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya de repente coloca o dedo indicador esquerdo em meus lábios e balança a cabeça. Eu me acalmo em um instante, e ela se inclina novamente em meu ombro.")
	await novel_interface.show_text_only("Ficamos sentados lá juntos, apenas observando o que acontece lá embaixo. Os protestos deveriam ser barulhentos, mas não conseguimos ouvir nada onde estamos. É pacífico, reconfortante.")
	await novel_interface.show_text_only("Como devo descrever essa garota...")
	await novel_interface.show_text_only("Um pioneiro? Vanguarda? Aventureiro?")
	await novel_interface.show_text_only("Todos esses são termos que me ocorreram. Mas eles não parecem totalmente certos.")
	await novel_interface.show_text_only("Seja Sonya ou nossos ancestrais... eles devem ter sentido um medo intransponível quando deixaram seus lares familiares e se aventuraram no desconhecido.")
	await novel_interface.show_text_only("Eles devem ter ficado aterrorizados, mas também animados, ansiosos...")
	await novel_interface.show_text_only("Observando atentamente o entorno, escolhendo o melhor caminho, limpando os arbustos que atrapalhavam...")
	await novel_interface.show_text_only("Eles estavam definitivamente ocupados demais para pensar no significado que suas ações tiveram para a raça humana e para a história.")
	await novel_interface.show_text_only("Aquelas pessoas lá embaixo, posando e tirando selfies no meio da multidão – são elas que estão tentando desesperadamente provar sua própria importância, não são?")
	await novel_interface.show_text_only("Todos eles querem parecer diferentes. No entanto, sem perceber, todos eles se uniram para formar este enorme monstro...")
	await novel_interface.show_text_only("No caminho para cá, ouvimos um repórter entrevistando pela rádio os presentes no comício.")
	await novel_interface.show_text_only("O repórter escolheu vinte e três pedestres aleatórios. De todos eles, apenas um conseguiu apontar a localização estimada de Masada Ford no mapa mundial.")
	await novel_interface.show_text_only("Metade deles nem sabia exatamente contra o que estavam protestando.")
	await novel_interface.show_text_only("... Então o significado da existência deles é realmente tão importante?")
	await novel_interface.show_text_only("Sou puxado de volta à realidade pela vibração do meu telefone. Ao atendê-lo, coloco o telefone em transmissão para que Sonya possa ouvir também.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ooh, vocês dois... estão se comportando mal, hein?", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Sim?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O que vocês estão fazendo na Primeira Avenida?\nE tão alto? Você está observando as pessoas ou algo assim?", "Ai")
	await novel_interface.show_text_only("Aya parece surpreendentemente preocupada. É quando noto um drone pairando diagonalmente, de frente para nós.")
	await novel_interface.show_dialog("Não sei para onde Mariru foi. De qualquer forma, estou aqui para contar os resultados que obtivemos após analisar a bateria que Beatrice nos enviou...", "Ai")
	await novel_interface.show_dialog("Vou direto ao ponto.", "Ai")
	await novel_interface.show_dialog("Está confirmado que a bateria tem algo a ver com a Substância H. E foi criada por um fabricante militar de Masada Ford.", "Ai")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Então... uma arma de Substância H?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quando aquele líquido brilhante e pegajoso foi fabricado, a Substância H estava definitivamente envolvida. Ainda não podemos ter certeza dos ingredientes.", "Ai")
	await novel_interface.show_dialog("Basicamente, podemos ver isso como uma espécie de célula de combustível. O líquido selado na caixa da bateria é consumido à medida que a bateria libera energia.", "Ai")
	await novel_interface.show_dialog("Por alguma razão – talvez para cumprir o prazo de envio ou algo assim – eles reformaram o produto sem nem mesmo extrair o número de série de fábrica da MMI.", "Ai")
	await novel_interface.show_dialog("Até o regulador de tensão fica preso do lado de fora, na caixa da bateria.", "Ai")
	await novel_interface.show_text_only("Aya parece confusa.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Caixa de bateria...? Regulador de tensão?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, você não sabe como é, certo? Deixe-me descrevê-lo...", "Ai")
	await novel_interface.show_dialog("Um cilindro de metal com quase sete centímetros de altura. Totalmente coberto com uma camada isolante, exceto nos eletrodos de cada lado. É como uma bateria AA, mas maior.", "Ai")
	await novel_interface.show_dialog("Na sua lateral está uma placa estruturada mecanicamente. Empurre-o para abri-lo e você verá dois contatos de metal.", "Ai")
	await novel_interface.show_dialog("Se aplicarmos tensão extremamente baixa nos contatos, podemos controlar o nível de eletricidade liberada.", "Ai")
	await novel_interface.show_dialog("Na parte externa da caixa da bateria, há um regulador de quarenta microvolts. Está na posição perfeita para segurar a placa e restringir a tensão aplicada aos contatos.", "Ai")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("Por que parece uma bateria alimentada por bateria...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É usado como fonte de energia reserva para uma lanterna de energia luminosa ou algo assim?")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("É porque essas baterias não foram projetadas para serem baterias...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya parece sombria.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("É como... a segurança mecânica das armas... e um dispositivo de ignição.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tento calcular a energia contida nessa bateria.", "Ai")
	await novel_interface.show_dialog("De acordo com o que a companhia elétrica nos disse, uma bateria como esta pode manter um dispositivo de microvigilância de 6W funcionando por cerca de vinte dias.", "Ai")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("Não parece grande coisa...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Como você calcula a potência? Aprendemos isso na aula? Esqueci...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya suspira diante da minha desesperança quando se trata de física.")
	await novel_interface.show_dialog("Uma bateria de 2,88 KW pode manter seu celular funcionando por meio ano.", "Ai")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Uau! Tanto tempo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Atualmente, estou acostumado a usar o Elluka para carregar meu telefone e console de jogos. Annie me repreende muito por isso.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Espere... o que acontece se não houver regulador de tensão?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Foi por isso que liguei para você, na verdade.", "Ai")
	await novel_interface.show_dialog("Descobri que na faixa de entrada de 1 a 500 microvolts, a potência gerada pela bateria aumenta junto com a entrada. Mas quando ultrapassa 500, nada acontece. Nenhuma saída.", "Ai")
	await novel_interface.show_dialog("Então aumentei a tensão para 32 V e, de repente, uma luz branca ofuscante saiu da bateria...", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("De acordo com o que nossa câmera de alta velocidade capturou, o líquido da bateria foi consumido em menos de um milissegundo.", "Ai")
	await novel_interface.show_dialog("A explosão de poder quase incinerou o teto da sala de isolamento. Há marcas de queimaduras cruzando toda a parede e o chão.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("O quê?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente me lembro que, quando Igor nos atacou no Sky Hotel, um de seus lacaios usou uma arma elétrica...")
	await novel_interface.show_text_only("Depois de uma explosão de luz poderosa, havia marcas de queimaduras se espalhando por toda a sala também.")
	await novel_interface.show_dialog("Ainda assim, a arma que atingiu Annie naquela época não parecia ser tão poderosa. E foi programado para atingir apenas uma pessoa, caso contrário todos na sala estariam mortos.", "Ai")
	await novel_interface.show_dialog("E 32V é na verdade a tensão mínima de excitação para ignitores de pulso eletrônicos usados pelo exército de defesa nacional de Masada Ford.", "Ai")
	await novel_interface.show_text_only("Aya faz uma pausa.")
	await novel_interface.show_dialog("A energia gerada por uma bateria de 2,88KW é igual à de 5,5 libras de TNT...", "Ai")
	await novel_interface.show_dialog("Embora as baterias não possam gerar ondas de choque tão destrutivas quanto o TNT, ainda podem ser fatais para todos os seres vivos em um raio de 10 metros.", "Ai")
	await novel_interface.show_dialog("E neste momento, temos uma dessas coisas em cada poste da Zona Desmilitarizada Acordada...", "Ai")
	await novel_interface.show_text_only("Eu suspiro, olhando para as hordas gigantescas lá embaixo.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Droga... Igor... como ele pôde...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("Espere!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya interrompe.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Se for assim, certamente Masada Ford não gostaria que essas baterias explodissem, certo?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Isso é verdade.", "Ai")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("As baterias foram fabricadas às pressas, os números de série ainda estão visíveis. E um simples regulador de tensão foi adicionado como uma espécie de solução rápida...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Parece que eles estavam desesperados para atender ao grande número de pedidos feitos pelo Congresso Unido.", "Ai")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Se as baterias explodirem, as autoridades poderão saber quem as fabricou a partir dos números de série. Isso seria uma atitude estúpida da parte de Masada.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Além disso, este é um projeto de renovação da cidade em grande escala. Inúmeras pessoas estariam envolvidas na logística, implementação e manutenção. Seria impossível manter um segredo tão mortal em segredo.", "Ai")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Isso é verdade...", "Lian")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("O que é realmente suspeito são os pacientes mencionados por Beatrice.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mariru já havia alertado o centro de controle de doenças para publicar um alerta de contaminação classe quatro. Atualmente, todos os vinte casos estão reunidos na Zona Desmilitarizada Convencionada.", "Ai")
	await novel_interface.show_dialog("No entanto, estas baterias não têm qualquer efeito no estado mental das pessoas. E os resultados da detecção de memes mostram que eles também não contêm fontes de infecção do tipo meme...", "Ai")
	await novel_interface.show_text_only("Olho para baixo, sem palavras. Tantas perguntas, mas nenhuma resposta.")
	await novel_interface.show_text_only("Eu olho para a multidão lá embaixo. Há um poste de luz a cada 12 metros...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Espere. O que Sonya e eu achamos estranho quando estávamos lá?")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("Que as “fronteiras” das multidões em manifestação são demasiado definidas...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hum?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O que você quer dizer...?", "Ai")
	await novel_interface.show_text_only("Talvez a resposta tenha estado bem diante de nós o tempo todo. Simplesmente não vimos porque havia muitas distrações na rua...")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("Mariru não disse que TODOS os sistemas de iluminação e vigilância dos postes de luz da cidade foram substituídos pelo Congresso Unido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sim.", "Ai")
	await novel_interface.show_dialog("Nesse caso, por que as lâmpadas de rua vêm em duas cores?", "Lian")
	await novel_interface.show_text_only("Na Primeira Avenida, os postes de luz brilham em um amarelo quente, iluminando as fronteiras claras das multidões.")
	await novel_interface.show_text_only("Enquanto isso, nas vielas desertas, os postes de luz brilham em branco.")
	await novel_interface.show_text_only("Do outro lado do receptor vem o som de uma digitação furiosa.")
	await novel_interface.show_dialog("Acabei de verificar. As novas lâmpadas que eles adicionaram deveriam ser lâmpadas LED sustentáveis ​​com temperatura de cor de 4.500K, para que parecessem brancas. Não tenho certeza do que há com os amarelos...", "Ai")
	await novel_interface.show_text_only("Sonya e eu trocamos olhares, na tentativa de relembrar todas as luzes que vimos nas últimas horas.")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("A filmagem da linha de defesa em frente ao Congresso Unido que acabamos de ver era amarelada. A área provavelmente está iluminada por um grande número de lâmpadas amarelas.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Os postes de luz da Electronics Street também eram do tipo amarelo, eu acho...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("A rua estava caótica, cheia de letreiros de néon deslumbrantes e outdoors iluminados. Ninguém notaria as lâmpadas amarelas.")
	await novel_interface.show_dialog("A atmosfera na Electronics Street estava realmente um pouco estranha hoje... todos pareciam anormalmente animados.", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Por outro lado, as ruas com iluminação branca pareciam quase desertas.", "Lian")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("A rua em frente à delegacia de onde escapamos...", "Soya")
	await novel_interface.show_dialog("Também...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("Aquela estrada tranquila perto do Newell Central Park...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Poderia ser...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Aquela luz dourada...", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("Hum?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por trás da porta...", "Soya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("Foi...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya não se preocupa em terminar a frase. Ela agarra minha mão e corre em direção ao elevador.")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
