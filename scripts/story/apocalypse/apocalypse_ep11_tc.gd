# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("這群笨蛋，基本上都是男人啊──", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("貝阿特麗切微笑著舉起右手，露出那個灰綠色金屬質地、微微泛出淡藍色光暈的手環。")
	await novel_interface.show_text_only("那是愛衣製作的道具，是用屏蔽迷因異質物影響的特殊合金做成的，能夠壓制「詛咒」。")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("等等，妳是想……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("我記得莉琉說過，那個「詛咒」會讓所有看到她的男性陷入瘋狂的迷戀。")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("準確地說，是看到她的臉──", "莉琉")
	await novel_interface.show_dialog("愛衣在一系列試驗後發現，直視貝阿特麗切的臉會使男性大腦的梭狀回和杏仁核區高度興奮。", "莉琉")
	await novel_interface.show_dialog("但僅限於距離80公尺內的直視──照片、錄影或鏡面反射都不會產生效果。", "莉琉")
	await novel_interface.show_dialog("這種興奮持續一段時間後，會使觀察者的大腦產生不可逆的變化，並改變整個人的行為模式。", "莉琉")
	await novel_interface.show_dialog("從迫切想要佔有她，轉為求之不得的焦慮、狂躁、仇恨……甚至會產生自殘、縱火和暴力傾向。", "莉琉")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("還真是戀愛的現實寫照啊──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉無奈地嘆了口氣。")
	await novel_interface.show_text_only("我本來想問愛衣是如何完成這種可怕的試驗，但思考了一下覺得還是不知道比較好……")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("（還好我不是她的白老鼠～欸？）", "小憐")
	await novel_interface.show_dialog("……", "小憐")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("等等！妳昨天命令我穿著「那種衣服」單獨幫貝阿特麗切做歷史介紹。", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("該不會也是……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("妳現在才反應過來？！", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("果然！")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("嘖……那貝阿特麗切昨天戴的手環是假的，這件事妳也不知道吧？", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉帶著失望眼神看著滿臉震驚的我。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("指定那身衣服，是為了避免妳的主觀感受影響實驗，所以用「羞恥感」來混淆「愛慕感」。", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("而且……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她突然雙手捏住我的肩膀，臉上露出微妙的笑容。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("讓妳穿兔女郎裝果然很有意思～～", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("啊啊啊啊啊啊啊啊啊──！！！\n不要再提了啊啊啊啊啊啊啊啊！！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那地獄般的一個多小時，我穿著兔女郎裝在密閉的空間裡和貝阿特麗切面對面。")
	await novel_interface.show_text_only("滿臉通紅的我緊張到話都說不清楚，連走路都有點不穩……")
	await novel_interface.show_text_only("貝阿特麗切也全程強忍著笑意安慰我……")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("愛衣說，當時妳大腦的3D掃描就像煙火表演一樣，要不是後來腦壓過高，她才不想喊卡呢。", "莉琉")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("不過，能夠確定的是，雖然妳的大腦會像男性一樣對貝阿特麗切表現出興奮，卻不會留下任何創傷。", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("換成其他人的話，最短四十秒，最長八分鐘，就會留下永久的烙印。", "莉琉")
	await novel_interface.show_dialog("是不是很安心啊？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("安心個屁啊──！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("最近希望徹底刪除的回憶有點太多了。")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
