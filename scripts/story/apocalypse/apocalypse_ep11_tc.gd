	await novel_interface.show_dialog("等一下我說「開始」之後，妳們有30秒的時間。", "貝阿特麗切")
	await novel_interface.show_dialog("救出伊露卡後，我們到附近的新井中心公園會合，那一帶沒有示威的人群。", "貝阿特麗切")
	await novel_interface.show_dialog("──聽清楚了嗎？", "貝阿特麗切")
	await novel_interface.show_text_only("我點了點頭，盡量不去想像臉上軟軟的觸感。")
	await novel_interface.show_dialog("我、我也要──", "索婭")
	await novel_interface.show_text_only("「咯」！")
	await novel_interface.show_text_only("金屬卡扣碰撞聲，手環被解開了。")
