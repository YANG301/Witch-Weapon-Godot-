	await novel_interface.show_text_only("莉琉摸了摸斯庫爾德的頭。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("妳每天在御櫻川的初中部上課不會無聊嗎？", "莉琉")
