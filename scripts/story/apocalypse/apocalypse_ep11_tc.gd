	await novel_interface.show_dialog("妳和小憐的氣息都像嬰兒一樣純淨！", "索婭")
	await novel_interface.show_dialog("……簡直，太有趣了！！", "索婭")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("索婭的聲音異常興奮，拚命搖著我的後背。")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("唔唔哇嗚咿呃！！\n（要無法呼吸了！！）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("呵呵，這個身體確實比印象中還要輕盈呢──\n多虧了這個小可愛～", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("巨乳大姐姐將懷中的小憐抱得更緊了。")
	await novel_interface.show_text_only("小憐似乎很激動，雙手拚命在空中比劃。")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("……妳究竟是誰？", "索婭")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("啊，一直忘了自我介紹呢～\n我叫貝阿特麗切·波爾蒂納。", "貝阿特麗切")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("90分鐘前。")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("協議非武裝區內，新豐洲鷺華園酒店。")
	await novel_interface.show_text_only("頂樓宴會廳──聽鸝堂門外。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("居然在99樓蓋了個露天庭院……是不是華雲宮的人都喜歡這麼浮誇？", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉看著庭院上方大廈的玻璃屋頂，不屑地笑了笑。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("可能高度越高看起來就越尊貴吧……而且99這個數字聽起來比較吉利？", "斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髮少女困惑地搔了搔頭。")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("妳到底是怎麼鎖定這場拍賣會的？", "斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉目光轉向了宴會廳門口的噴墨廣告。")
	await novel_interface.show_text_only("大標題是「致元博物館秋季拍賣會」。\n下面一行小字寫著：藝術與金融交匯新模式")
	await novel_interface.show_text_only("藍底白字的設計非常礙眼，讓人很難相信這是藝術品拍賣會。")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("太難看了吧？怎麼看都很像詐騙……", "斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉笑著點了點頭。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("但這場拍賣會的五百個席位全坐滿了，63件拍賣品也已經賣出了60件，沒有一件流標。", "莉琉")
