# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("Y mientras el resplandor arde más rojizo sobre la ola,\nEso espera el equipo ascendente, que Phaëton\nMal sabía guiar, y en cada parte la luz")
	await novel_interface.show_text_only("Desvanecimientos disminuidos, más intensos en el medio;\nAsí quemó la pacífica oriflama y aflojó\nPor todas partes la llama viva decaía.")
	await novel_interface.show_text_only("Y en medio de eso agitaban sus pendones deportivos\nMiles de Ángeles; en resplandor cada uno")
	await novel_interface.show_text_only("Adorno distintivo y pintoresco...")
	await novel_interface.show_text_only("—Canto XXXI, Paradiso, La Divina Comedia")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru se pone de pie, jugando con la foto en sus manos, mientras observa atentamente al hombre de cabello gris frente a ella.")
	await novel_interface.show_text_only("No se puede encontrar mucha información sobre este hombre. Nadie sabe siquiera si Lumbert es su verdadero nombre, y mucho menos cuál es su apellido.")
	await novel_interface.show_text_only("Pero sigue siendo un hecho que fue nombrado caballero con este nombre debido a su \"destacada contribución a la paz mundial\".")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko ya confirmó que es seguro negociar con él).", "Marirú")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("La mayoría de la gente cree que la razón por la que el Congreso Unido tiene el mayor poder sobre nuestro planeta es que es donde se congregan los líderes nacionales de todo el mundo.", "Marirú")
	await novel_interface.show_dialog("Es cierto que este tipo de organización existió en la historia alguna vez. Pero la estructura era endeble y los miembros nunca podían dejar de discutir. El presidente actuó más bien como un mendigo pacificador.", "Marirú")
	await novel_interface.show_dialog("Pero el Congreso Unido que tenemos ahora no es así en absoluto. Mucho más influyente. Y mucho más rico.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru vuelve a guardar la foto en el bolsillo, con el rostro impasible.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Del interés nace la confianza. De la confianza nace el poder. Y el poder, a través de la disposición y distribución de los recursos, genera aún más interés...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert levanta una ceja.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Ése es el modelo básico de sociedad de Walker.", "Lumbert")
	await novel_interface.show_dialog("Los políticos son elegidos por los grupos de interés como agentes que cuentan con la confianza del público.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Si estos agentes no pueden mantener o crear intereses mayores, sus poderes serán arrebatados y alguien más ocupará su lugar.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eso es cierto en la macrohistoria, pero el público nunca ha sido razonable. Como dijo una vez Le Bon...", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Las masas nunca han tenido sed de la verdad. Quien pueda proporcionarles ilusiones es fácilmente su amo; Quien intenta destruir sus ilusiones es siempre su víctima.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert murmura, terminando la cita por ella. Mariru sonríe y asiente.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hay demasiadas formas de saltarse la parte de interés y ganarse directamente la confianza del público.", "Marirú")
	await novel_interface.show_dialog("Los líderes de este tipo no temen hacer grandes sacrificios siempre que al final tengan éxito.", "Marirú")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Sin embargo, después de la Guerra de los Siete Años, quienes mantienen seguras las vidas de las masas y las naciones en funcionamiento comienzan a repensar toda la situación.", "Marirú")
	await novel_interface.show_dialog("Y así formaron el Congreso Unido. Una organización que colabora y negocia directamente con grupos de interés.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Entonces, en realidad es al revés. El Congreso Unido no es poderoso porque esté formado por líderes nacionales. De hecho, la verdad es que sólo aquellos en el Congreso están calificados para convertirse en líderes nacionales.", "Marirú")
	await novel_interface.show_dialog("Esta organización dio su primer paso hace tres años...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hace una pausa. Lumbert la mira fijamente y contiene la respiración.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hace tres años, el Congreso Unido y la iglesia trabajaron juntos para probar un tipo de Sustancia H clase EX en América del Sur. Presionaron a los señores de la guerra de la mafia para que trabajaran con ellos.", "Marirú")
	await novel_interface.show_dialog("Sin embargo, el experimento se les fue de las manos. Murieron más de cuarenta y seis mil lugareños.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Sobornaron a todos los que sabían la verdad para que se callaran y calificaron todo el asunto como la Masacre del Río Churún, culpando a Carlos Branco, el único señor de la guerra que se negó a cooperar.", "Marirú")
	await novel_interface.show_dialog("La noticia del incidente se volvió viral. A los medios les encantó. El público la odió y mostró su disgusto y odio por la guerra a gran escala.", "Marirú")
	await novel_interface.show_dialog("Y el Congreso Unido llegó a ser ampliamente apreciado como la organización que trabajó en una operación militar conjunta para matar a Branco. Nadie se molestó siquiera en cuestionar si la existencia de esta organización era legal en primer lugar.", "Marirú")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("¿Pero no es demasiado antinatural? Miles de cuerpos, dispuestos en una formación similar a una matriz, con la iglesia como centro...", "Marirú")
	await novel_interface.show_dialog("Creo que el Congreso disparó allí un arma de Sustancia H, capaz de perturbar las ondas de radio en un radio de dos millas, para ocultar la verdad.", "Marirú")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("También se produjo una anomalía similar en el campo de batalla de Asia occidental. Por eso las imágenes capturadas por los satélites de allí estaban todas distorsionadas; después de todo, la luz también era un tipo de onda.", "Marirú")
	await novel_interface.show_dialog("Por eso las perturbaciones de las ondas de radio en la zona persistieron durante semanas incluso después de que se cerrara “la puerta”.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pone mucho énfasis en las palabras \"la puerta\". Lumbert cierra los ojos, resignado.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru estudia la foto que tiene en la mano.")
	await novel_interface.show_dialog("Limpiar todos esos cuerpos requirió muchos trabajadores. Debe haber sido difícil asegurarse de que ninguno de ellos filtrara nada.", "Marirú")
	await novel_interface.show_dialog("Apuesto a que nunca esperaste que alguien tomara esta foto de la escena con una vieja cámara mecánica y un rollo de película podrida.", "Marirú")
	await novel_interface.show_dialog("El fondo de la imagen estaba borroso. Eso se debió a las propiedades de distorsión de la luz del arma de Sustancia H que usó su gente.", "Marirú")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Interesante. ¿Pero por qué estás tan convencido de que estuve involucrado?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un mes antes del incidente, usted fue nombrado Secretario General de la Organización del Tratado para la Prohibición de Experimentos con Armas Sustancia H.", "Marirú")
	await novel_interface.show_dialog("A primera vista, el propósito de esta organización es prohibir los experimentos con armas de Sustancia H. Es un establecimiento poderoso con muchos recursos disponibles y excelentes capacidades de recopilación de información.", "Marirú")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Es imposible que no estés enterado de un incidente de esta escala. La razón por la que decidiste no hablar fue que, de hecho, fuiste tú quien planeó todo.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert no intenta protestar y Mariru toma su silencio como una señal de que es seguro seguir adelante.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Al final, la iglesia envió a algunos de los suyos para recuperar la Sustancia H que causaba todos los problemas. Posteriormente recibieron una cantidad anormal de fondos y privilegios del Consejo Unido.", "Marirú")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("La Sustancia H en cuestión es una puerta negra entreabierta. Detrás hay una luz dorada cegadora.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("¡Suficiente! ¡Lo entiendo!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert interrumpe, levantando ambos brazos en un acto de rendición.")
	await novel_interface.show_text_only("Se tira del cuello del traje y se aclara la garganta.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("De hecho, la misión de nuestra organización es garantizar que el público no tenga fácil acceso a las armas de Sustancia H, y mucho menos utilizarlas en experimentos.", "Lumbert")
	await novel_interface.show_dialog("La sustancia H es demasiado peligrosa. Si no se tiene cuidado, podría destruir nuestra civilización. Pero ese experimento que realizamos... era inevitable. Alguien tenía que hacerlo, bien podríamos ser nosotros.", "Lumbert")
	await novel_interface.show_dialog("Alguien... algo... estaba llamando a la puerta desde dentro. Cada vez con mayor urgencia. No teníamos elección...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("¿Llaman...?", "Marirú")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Llamando a la puerta del cielo, sí.", "Lumbert")
	await novel_interface.show_dialog("El cielo existe en todas las religiones y sistemas mitológicos, en diferentes formas. Las definiciones pueden diferir en cada sistema de creencias, pero quizás todas nacieron de la misma fuente.", "Lumbert")
	await novel_interface.show_dialog("En los registros históricos dicen que, justo antes de que se abra la puerta, se llamará tres veces consecutivas.", "Lumbert")
	await novel_interface.show_dialog("Golpes profundos y resonantes. Como si llamara al alma del oyente...", "Lumbert")
	await novel_interface.show_dialog("Después de que se escuchen los golpes por primera vez, habrá silencio durante una semana y los golpes comenzarán de nuevo. Los intervalos entre los golpes se van haciendo cada vez más cortos...", "Lumbert")
	await novel_interface.show_dialog("Cuando no pasen más de noventa segundos entre cada serie de golpes, sabremos que la puerta del cielo está lista para abrirse.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Puedes definir el \"ser\" detrás de la puerta como quieras, pero el hecho es que tiene poderes que pueden provocar un desastre apocalíptico.", "Lumbert")
	await novel_interface.show_dialog("Una inundación masiva, por ejemplo, eh...", "Marirú")
	await novel_interface.show_dialog("Según los manuscritos de la iglesia, la única manera de mantener la puerta cerrada es reunir a unas diez mil personas en el campo, rodeando la puerta...", "Lumbert")
	await novel_interface.show_dialog("Una especie de sacrificio, ¿eh?", "Marirú")
	await novel_interface.show_text_only("Lumbert ignora el comentario de Mariru y continúa.")
	await novel_interface.show_dialog("Este tipo de cosas sucedía cada pocos cientos de años. Siempre, los cadáveres terminaban dispuestos en una disposición radial, con la puerta como punto central.", "Lumbert")
	await novel_interface.show_dialog("Este tipo de ritual normalmente se llevaba a cabo en secreto. Sin embargo, como siempre pasaban cientos de años entre un ritual y el siguiente, ciertas personas de ciertas épocas los usaban para su propio beneficio...", "Lumbert")
	await novel_interface.show_dialog("Por ejemplo, la masacre del día de San Bartolomé en París, 1572.", "Lumbert")
	await novel_interface.show_dialog("La noche anterior al día de San Bartolomé de ese año se produjo una horrible masacre religiosa, la peor en siglos, con más de setenta mil muertes.", "Lumbert")
	await novel_interface.show_dialog("París, eh...", "Marirú")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Espera, ¿un conjunto radial con una puerta como punto central?", "Marirú")
	await novel_interface.show_text_only("Mariru inmediatamente recuerda la forma en que están dispuestas las carreteras en la ciudad del romance.")
	await novel_interface.show_dialog("Irónico, ¿no?...", "Lumbert")
	await novel_interface.show_text_only("Lumbert se ríe sin humor.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aún así, no se puede tocar una puerta a menos que tenga una forma concreta. ¿Por qué no lo destruyes o lo arrojas a algún lugar del espacio exterior?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("La puerta del cielo no es más que un concepto. Al principio, la puerta nunca aparecía dos veces en el mismo lugar.", "Lumbert")
	await novel_interface.show_dialog("Apareció en lugares donde se suponía que ni siquiera debía haber una puerta. Por ejemplo, en la superficie de las antiguas murallas de las ciudades.", "Lumbert")
	await novel_interface.show_dialog("Siempre traían consigo desastres, pero también eran una especie de reliquias divinas, prueba de que existía una existencia más allá de nuestra comprensión.", "Lumbert")
	await novel_interface.show_dialog("Las facciones religiosas en la historia nunca habían dejado de luchar por este concepto, queriendo reclamarlo como propio.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("¿Cómo se reivindica un concepto exactamente?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Los registros históricos nos dicen que Santa Sofía había sido la \"propietaria\" oficial de la puerta del cielo durante un período de tiempo más largo.", "Lumbert")
	await novel_interface.show_dialog("Luego, en el siglo XV, el escultor Lorenzo Ghiberti de Florencia reclamó la propiedad del concepto a través de una obra de arte en la que trabajó toda su vida.", "Lumbert")
	await novel_interface.show_dialog("Dicha obra de arte, una vez finalizada en 1452, se utilizó como entrada principal de la Catedral de Florencia. El mundo estuvo de acuerdo en que a partir de entonces será conocida como la puerta del cielo.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ya veo.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El método más antiguo que utilizaban los humanos para reclamar la propiedad de un concepto era demostrar su propio valor mediante la creación de obras de arte majestuosas y extravagantes.")
	await novel_interface.show_text_only("Pirámides, templos, palacios, coronas, tronos...")
	await novel_interface.show_text_only("Todas las formas de demostrar que el creador es el verdadero y digno propietario de un concepto.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Espera... ¿no fue Constantinopole, donde se encuentra Santa Sofía, invadida y ocupada un año después de que se completara la obra de arte de Ghiberti? ¿Fue porque...?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert niega con la cabeza.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("No lo sabemos. No se pudo encontrar evidencia directa en ese período.", "Lumbert")
	await novel_interface.show_dialog("De lo que sí podemos estar seguros es de que la obra de Ghiberti fue destruida en la Guerra de los Siete Años.", "Lumbert")
	await novel_interface.show_dialog("Por lo tanto, para determinar cuándo aparecerá la próxima \"puerta\" y garantizar que esté en un área lo suficientemente remota como para causar un daño mínimo la próxima vez que se abra...", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Tuvimos que trabajar con la iglesia para crear una especie de copia.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Pero algo salió mal en el experimento. No pudimos cerrar las puertas como deberíamos. Por eso la iglesia tuvo que llegar tan lejos...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esto lo explica todo. Para Mariru, es como si finalmente reuniera las piezas y viera el rompecabezas completo tal como es.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Entonces... encubriste todo después con una mentira ingeniosa, la ayuda de los medios y el chivo expiatorio perfecto...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se ríe sombríamente de las palabras de Mariru.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Gracias por el cumplido, supongo.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("No. No es un cumplido. Si algún día la humanidad no tendrá más remedio que enfrentarse a un poder de una escala tan abrumadora...", "Marirú")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Consideraría estúpido intentar encubrir todo con una mentira, difundir la ignorancia disfrazada de esperanza.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("¿Pero no lo ves? Los humanos somos así de débiles. Preferimos renunciar a nuestra seguridad por una sensación de seguridad.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sonríe y alza la voz.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Por eso la \"ética\" es valiosa en cierto modo.", "Marirú")
	await novel_interface.show_dialog("Ocultar la verdad de ese experimento es parte de tu trabajo. Y la verdad ahora está en mis manos...", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Tienes razón. Entonces, nombra tus términos.", "Lumbert")
	await novel_interface.show_dialog("Pero recuerde que yo no soy más que un representante y no tengo influencia sobre las decisiones del Congreso Unido. Ni siquiera sé quién toma las decisiones.", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("No te preocupes, no nombraré nada que esté más allá de tu poder.", "Marirú")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Mi condición es: el sucesor de Scheinermann, Primer Ministro de la Tercera Ciudad Academia, no puede ser alguien del ejército.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert parece desconcertado por la petición.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Superficialmente, al menos financieramente, mientras el Congreso Unido autorice a Masada a vender armas, nunca tendrán que preocuparse de que sus fabricantes de armas quiebren.", "Marirú")
	await novel_interface.show_dialog("Sin embargo, la política no se trata solo de dinero. La gente también desea el poder...", "Marirú")
	await novel_interface.show_dialog("Una vez que el público comience a cansarse de las guerras inútiles, ya no habrá una base firme sobre la cual construir un ejército a gran escala.", "Marirú")
	await novel_interface.show_dialog("¿No te has dado cuenta de que, recientemente, cada vez más canales de medios de Masada han comenzado a referirse a su propia capital como \"Ciudad Academia\" en lugar de Masada Ford?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert no responde.")
	await novel_interface.show_text_only("De repente, el ascensor negro del lado izquierdo suena. Una mujer con gafas emerge de sus puertas, con un pequeño maletín en la mano.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("¿Akiko?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Conociste a ese viejo jabalí por la tarde sin avisarme. Te dejaré libre esta vez.", "Akiko")
	await novel_interface.show_dialog("¿Pero no deberías al menos haberme dicho que ibas a conocer a Mariru? ¡Especialmente porque fui yo quien los presentó!", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se gira para darle a Mariru una mirada de incredulidad y Mariru se encoge de hombros.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ella hizo muchas preguntas. Tenía que decírselo.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Uf...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Viejo zorro.", "Akiko")
	await novel_interface.hide_character()
