# apocalypse_ep14.gd - 天启篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第14话剧本
	apocalypse_ep14_script()

func play_script():
	pass

# 天启篇第14话 - 正式剧本
func apocalypse_ep14_script():
	# 开场设置
	novel_interface.show_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Я наблюдаю, как машина, везущая Эллуку обратно в штаб-квартиру СИД, укатывается и исчезает в конце дороги. Мой мозг до сих пор заполнен образами парня без сознания и всей этой крови...")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Джон должен быть в порядке, верно?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня отвечает, глядя на окровавленный осколок стекла в своей руке:")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Он задел некоторые мышцы, но не задел ни одной крупной артерии. С ним все будет в порядке, если его вовремя вылечат.", "Соя")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("И все же это безумие, как он шел более двадцати минут с такой раной. Любой нормальный человек, наверное, уже потерял бы сознание.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("...Может быть, у него есть CIPA или что-то в этом роде?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это расстройство, которое я видел по телевизору. У многих персонажей он есть в аниме и драмах.")
	await novel_interface.show_text_only("Они не чувствуют боли, поэтому даже аппендицит может их убить — они могут даже не заметить, что что-то не так, пока у них в желудке не появится дыра или что-то в этом роде.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Хотя в этом случае у него, вероятно, все еще должны быть тактильные чувства.", "Соя")
	await novel_interface.show_dialog("Он должен был хотя бы почувствовать это пятно запекшейся крови на своих штанах. Но он, кажется, вообще ничего не заметил. Он действительно...", "Соя")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("Потрясающе!", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Что?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Нам нужно сходить проведать его в больнице. Посмотрите, какие стимулы вызовут у него реакцию.", "Соя")
	await novel_interface.show_dialog("Или, может быть, он был слишком сосредоточен на Рене, чтобы заметить боль?", "Соя")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("В этом случае нам также придется использовать Рена как часть эксперимента. Надо одолжить ее у той самки гориллы...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пока Соня болтает, моя грудь непонятно где вибрирует.")
	await novel_interface.show_dialog("Кого ты назвал самкой гориллы, а?", "Мариру")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("М-Мариру?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня в ужасе трясет волосами, но Мариру нигде не видит. Есть только я, одна рука на моей жужжащей груди.")
	await novel_interface.show_dialog("Уже скучаешь по мне, Рен?", "Мариру")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Ты не можешь просто позвонить мне на мой телефон?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","laugh",0.25)
	await novel_interface.show_dialog("Ого...", "Соя")
	await novel_interface.show_text_only("Наконец обнаружив источник голоса, Соня подпрыгивает ко мне, ее глаза сияют от любопытства.")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она подпрыгивает к моей груди, как золотистый ретривер с виляющим хвостом…")
	await novel_interface.show_text_only("Из ее лодыжки внезапно появляется яркая дуга. Соня падает на землю.")
	await novel_interface.show_text_only("Ее правую руку и ногу дважды свело спазмом, и ей удается подняться, полупарализованная.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("(Похоже, теперь она быстрее восстанавливается после ударов током...?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("С глазами, полными слез, девушка садится, потирая ноющую левую руку, и поднимает голову к небу в молчаливой жалобе.")
	novel_interface.show_character("soya_uniform","cry")
	await novel_interface.show_dialog("Боже, ты даже можешь управлять этой штукой дистанционно?", "Соя")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/UAV.png")
	await novel_interface.show_text_only("Я следую за взглядом Сони и замечаю крошечную красную точку, парящую в воздухе.")
	await novel_interface.show_dialog("Дрон?", "Лиан")
	await novel_interface.show_dialog("Разве дроны не запрещены в этой зоне?", "Лиан")
	await novel_interface.show_text_only("Запреты, конечно, никогда не мешали СИД, но разве Мариру не говорила пару дней назад, что нам нужно проявить осторожность во время Международного форума мира?")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Ну, я думаю, нападения на полицейских, взлом тюрем и начало беспорядков тоже не считаются проявлением осторожности...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Сегодня ситуация особенная. На Первой авеню уже собралось более пятидесяти тысяч человек, марширующих неизвестно за что.", "Мариру")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Так много?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("В семи районах уже произошли беспорядки. В штабе силовиков сейчас бардак.", "Мариру")
	await novel_interface.show_dialog("Я сказал их командиру, что если они не справятся с этими беспорядками должным образом, Новая Опулентия может оказаться в беде...", "Мариру")
	await novel_interface.show_dialog("И я как бы немного оказывал на него давление, воспитывая его семью. Бедняга согласился сразу позволить СИДу обходить определенные ограничения.", "Мариру")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("(«Какое-то» давление?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("В этом году они действительно приложили все усилия для Форума. Даже переоборудовали все уличные фонари в Согласованной демилитаризованной зоне на новые модели.", "Мариру")
	await novel_interface.show_dialog("Каждый уличный фонарь теперь служит камерой наблюдения. Также установлены соответствующие сети и устройства.", "Мариру")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Это не очень умный план. Наверняка есть места, где нет уличных фонарей. Зачем еще вам пришлось бы использовать дроны, верно?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— насмешливо говорит Соня, но Мариру просто мычит в знак согласия.")
	await novel_interface.show_dialog("Да, совсем не умный план. Стоит дорого, а результата не дает. Кроме того, существует и огромный политический фактор риска...", "Мариру")
	await novel_interface.show_dialog("Если средства массовой информации узнают о том, что повсюду установлены камеры наблюдения, они обязательно вспомнят классические романы-антиутопии. Джордж Оруэлл и все такое. Объединенный Конгресс окажется под огнем.", "Мариру")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("В любом случае, я узнал то, что мне нужно было знать.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Теперь подтверждено, что все, что мне нужно сделать, — это оказать на определенных людей небольшое давление, чтобы убедить даже самые влиятельные организации мира принять откровенно глупые решения.", "Мариру")
	await novel_interface.show_dialog("Теперь все, что нам нужно знать, это на кого нацелиться...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру просматривает тысячи профилей, которые только что были импортированы в ее портативное устройство. Профили, которые содержат личные данные, банковские счета, сумму средств и другие соответствующие данные.")
	await novel_interface.show_dialog("Что ты имеешь в виду...?", "Лиан")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Например, Сенат — это организация, которая обладает наибольшей властью над Федерацией Новой Опулентии. В таком случае мне хотелось бы знать, какой именно властью обладает Сенат. Все ли должны выполнять их приказы?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вы этого не делаете, например...", "Лиан")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Короче говоря, каждая нация состоит из многоуровневой системы власти. На власть, которой обладают различные организации, влияет множество факторов: экономика, армия, история, культура, религия и многое другое.", "Мариру")
	await novel_interface.show_dialog("Что касается лидера нации, то он всего лишь представитель, выбранный для поддержания баланса в сложной борьбе за власть между различными фракциями.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("С самого начала истории, независимо от того, в какой политической системе – демократической, диктатурной, республиканской, академической – никогда не было настоящего «Короля», который решает все.", "Мариру")
	await novel_interface.show_dialog("Все, что там было, это кто-то, кому приходится преодолевать бесчисленные конфликтные ситуации, делать невозможный выбор за всех и брать на себя вину за все, в чем нет его вины.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру делает паузу, глядя на группу членов спасательной команды, которые эвакуируют массы людей в защитных костюмах.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Тот единственный человек, на котором лежит вся эта ответственность... они могут выглядеть сильными, но на самом деле на их телах больше шрамов, чем они могут сосчитать.", "Мариру")
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("…", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня молчит, прижав руку к груди, а я смотрю в замешательстве.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Я не уверен, что понимаю...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("В любом случае, ты не предназначен для этого, идиот.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня заставляет себя успокоить дыхание и наконец спрашивает серьезным тоном:")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Я вижу, что вы здесь, чтобы торговаться, но последняя часть головоломки, самая важная, все еще отсутствует. Итак, вы готовы дать мне что-нибудь в обмен на мою информацию, да?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ага.", "Мариру")
	await novel_interface.show_text_only("Мариру легко отвечает.")
	await novel_interface.show_dialog("Насколько я знаю, Рыцари Правосудия — это «монахи в черных одеждах, владеющие Печатью Истины». Менее двадцати счастливчиков удостоились такой чести за последние пятьсот лет.", "Мариру")
	await novel_interface.show_dialog("В истории было бесчисленное множество талантливых монахов в черных одеждах.", "Мариру")
	await novel_interface.show_dialog("Но даже они не получили Печати Истины, символа высшей неприкосновенности в Царстве Божием. Только те, кого церковь считает внесшими важный вклад в развитие мира, имеют такую ​​привилегию.", "Мариру")
	await novel_interface.show_dialog("Вы получили свое два года назад. Его вручил вам покойный Папа, Его Святейшество Каллист IV.", "Мариру")
	await novel_interface.show_dialog("Тебе тогда не могло быть больше двенадцати лет, не так ли?", "Мариру")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Хм, ты действительно много знаешь.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ну, я сразу перейду к делу.", "Мариру")
	await novel_interface.show_dialog("Что именно вы делали три года назад во время миссии по «очистке» Гайанского щита?", "Мариру")
	await novel_interface.show_text_only("Соня молчит несколько секунд, прежде чем снова поднять голову.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Я знаю, чего ты от меня хочешь, но у меня есть условия.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Конечно, я весь в ушах.", "Мариру")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("Во-первых, немедленно деактивируйте этот браслет!", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Я не могу.", "Мариру")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Что?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Для деактивации требуется специальное оборудование штаба ГИБДД. Я не могу сделать это удаленно. Прямо сейчас все, что мы можем сделать, это установить максимальное расстояние между вами и Реном, около 650 футов.", "Мариру")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("... Ладно, по крайней мере, это лучше, чем тридцать футов.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Желтый индикатор на браслете Сони мигнет несколько раз.")
	await novel_interface.show_dialog("Дело сделано.", "Мариру")
	await novel_interface.show_text_only("Устремив на меня взгляд, Соня начинает осторожно пятиться назад, останавливаясь каждые несколько шагов и наконец вздыхая с облегчением, когда становится очевидно, что нас разделяет более 650 футов.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Ну, во-вторых, я хочу знать, что происходит между Беатрис и Реном. И я хочу, чтобы Рен сказала мне своими словами.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру некоторое время молча обдумывает это.")
	await novel_interface.show_dialog("... Хорошо. Но ты должен пообещать, что никому больше не расскажешь.", "Мариру")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Ч-что? Действительно ли можно сказать ей об этом?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Беатрис умерла где-то в тринадцатом веке. По словам Аи, нынешнее тело Беатрис было создано только в тот самый момент, когда я ее вызвал.")#换行问题
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Значит, я «создал» такое удивительное тело? Это сюрреалистично...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Однако этот факт имеет гриф «совершенно секретно». Даже Сенат не может знать.")
	await novel_interface.show_text_only("В настоящее время правду знают только восемь человек во всем мире: я, Энни, сама Беатрис, Рафилия, доктор Деккерс, Мариру, Айя и Генриетта.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(Информация, которую Мариру хочет получить от Сони, должна быть безумно важной...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Обещаю никому не рассказывать.", "Соя")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Но не забывайте: если Рен лжет, я сразу это пойму!", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Ладно, ладно!\nПерестаньте это втирать...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я продолжаю рассказывать о своем опыте в отеле Sky Hotel, где я вызвал Беатрис, используя изумрудное ожерелье Рафилии.")
	await novel_interface.show_text_only("С разрешения Мариру я рассказываю ей часть о том, как Беатрис победила Игоря, а также о ее «проклятии».")
	await novel_interface.show_text_only("Соня слушает, ее глаза блестят, как у ребенка, читающего сказку на ночь, время от времени вмешавшись взволнованными вздохами.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Значит, изумруд на ожерелье, принадлежавшем семье Рафилии… много веков назад он был вставлен в меч Беатрис?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
