# apocalypse_ep05.gd - 天启篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第05话剧本
	apocalypse_ep05_script()

func play_script():
	pass

# 天启篇第05话 - 正式剧本
func apocalypse_ep05_script():
	# scene1 - 盲点序章
	novel_interface.show_background("res://assets/images/bg/Soya/Blindspot.png")
	await novel_interface.show_text_only("Un punto ciego es el lugar donde las arterias, venas y nervios se entrecruzan en la retina. No hay células sensibles a la luz en esta sección y, por lo tanto, los estímulos visuales no pueden activarla.")
	await novel_interface.show_text_only("Sin embargo, no podemos saber dónde está el punto ciego cuando miramos algo, porque el cerebro automáticamente completa lo que falta.")
	await novel_interface.show_text_only("Así es como funciona nuestro cerebro. Hace todo lo posible para que cada situación parezca razonable.")
	await novel_interface.show_text_only("Por lo tanto, mucha gente cree que lo que les parece natural debe ser indiscutiblemente correcto.")
	await novel_interface.show_text_only("¿Pero lo es realmente?")
	await novel_interface.show_text_only("En la historia hubo una persona que no se dio cuenta de que era ciega hasta los siete años.")
	await novel_interface.show_text_only("Los nacidos sin oído pensarían que el mundo está en silencio si nadie les dijera lo contrario.")
	await novel_interface.show_text_only("Si una ocurrencia anormal de alguna manera se ha convertido en la predeterminada, la aceptaremos tal como está.")
	await novel_interface.show_text_only("Y nunca aprenderemos la verdad hasta que un día nos veamos obligados a enfrentar las contradicciones que tenemos ante nuestros ojos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("En ese caso... es posible que haya un defecto innato con el que todos los humanos nacen. Pero como es lo predeterminado para todos, nadie lo cuestiona...")
	novel_interface.show_background("res://assets/images/bg/Soya/Doomsday1.png")
	await novel_interface.show_text_only("Hasta que un día...")
	await novel_interface.show_text_only("Se ven obligados a afrontar las contradicciones que tienen delante de sus ojos...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	
	# scene2 - 美术馆继续
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Todavía estoy tratando de aceptar la noticia que sacudió al mundo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Es muy serio, por supuesto, simplemente no sé qué pensar...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incluso si Nueva Opulentia sobrevive a la primera ronda de ataques nucleares, la gente todavía tendría que lidiar con la contaminación nuclear, los problemas ambientales y el hambre. Todo fatal.")
	await novel_interface.show_text_only("\"Un apocalipsis de clase XK no deja supervivientes\".")
	await novel_interface.show_text_only("Esta es una cita que se escucha frecuentemente en las noticias estos días. También fue la base sobre la cual el Congreso Unido pudo poner fin a la guerra y mantener la paz.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Un sistema de contraataque nuclear indiscriminado no es nada nuevo. Alguien ya diseñó algo así durante la Guerra Fría.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Vaya, ¿hace tanto tiempo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Lo que pasa es que la gente rara vez lo menciona.", "Rafael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿Sabes por qué?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ni siquiera intento responder, sé que no tengo remedio en historia. Así que simplemente me siento ahí y sonrío cortésmente mientras Raphilia me mira.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("La razón fue que los altos mandos de todos los países tenían este acuerdo silencioso: no sería bueno anunciar públicamente la existencia de este tipo de cosas.", "Rafael")
	await novel_interface.show_dialog("Este siempre ha sido un tema tabú, no importa en países con una censura estricta o en aquellos que apuestan por la libertad de prensa.", "Rafael")
	await novel_interface.hide_character()
	
	# 背景切换
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Cuando se estableció por primera vez el Congreso Unido y terminó la guerra, el público pensó que era por “el futuro de la humanidad y la civilización”.")
	await novel_interface.show_text_only("En cuanto a la Sustancia H clase XK, nadie habla nunca de ella, a pesar de que fue lo que realmente puso fin a la guerra.")
	await novel_interface.show_text_only("Para inspirar confianza en el público en general, el Consejo lanzó un proyecto llamado “Nueva Puerta Giratoria” en la transmisión del fin de la guerra.")
	await novel_interface.show_text_only("Un proyecto en el que los seis países miembros habían acordado por unanimidad nombrar a sus capitales “Ciudades Academia”.")
	
	novel_interface.change_background("res://assets/images/bg/Soya/Guidepost.png")
	await novel_interface.show_text_only("El movimiento afectó a muchas cosas. Se reformaron los gobiernos, se emitieron nuevas monedas y nuevas deudas nacionales, se cambiaron los nombres de los aeropuertos y los monumentos y hubo que reemplazar las señales de tráfico en gran escala.")
	await novel_interface.show_text_only("Técnicamente, fue sólo un simple cambio de nombres. Pero el sistema crediticio de cada uno de estos países se recuperó milagrosamente de la guerra en un par de meses.")
	await novel_interface.show_text_only("Incluso las empresas que cotizan en bolsa comenzaron a solicitar cambios de nombre; siempre que el nombre de la empresa tuviera algo que ver con “Ciudad Academia”, las acciones se dispararían.")
	novel_interface.change_background("res://assets/images/bg/Soya/galleries.png")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Porque el término “Ciudad Academia” significaba un futuro brillante y feliz.", "Rafael")
	await novel_interface.show_dialog("Y todos los seres humanos necesitan algo en lo que puedan confiar, algo que represente sus esperanzas y sueños.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Es como los chicos y sus... “varitas”, ¿verdad?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mmmm?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia levanta una mano, luciendo muy lista para despedazar a Sonya.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("De hecho, este anuncio público debe haber estado planeándose durante bastante tiempo.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por lo general, algo como esto simplemente se anunciaría en una reunión cerrada entre altos mandos.")
	await novel_interface.show_text_only("Las naciones más pequeñas no participantes e incluso los terroristas podrían obtener información como esta de todos modos.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Y ahora mismo, todos los funcionarios de los seis países con poder suficiente para prohibir a los medios difundir la noticia están celebrando una reunión a puerta cerrada.", "Rafael")
	await novel_interface.show_dialog("Los canales de medios de todo el mundo, naturalmente, querrían aprovechar esta impactante noticia tanto como sea posible para conseguir la mayor cantidad de seguidores y tráfico.", "Rafael")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Estarán sembrando el pánico y el caos por todo el mundo, desenfrenados...", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia mira a la multitud afuera, con el ceño fruncido.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("¿Este lugar suele estar tan lleno de gente?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Esta es una calle muy orientada a un determinado grupo de clientes y no tiene nada que ver con la política, pero es cierto que está más concurrida de lo normal.")
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Bueno, no creo que haya nada de qué preocuparse.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mira por la pared de cristal del vestíbulo del segundo piso donde nos encontramos actualmente y confirma.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Las auras de estas personas se ven bien. No tienen colores enojados. Algunos huelen a humo y a ansiedad, pero eso puede deberse fácilmente a que están rodeados de demasiada gente.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Eso es lo que significa la “sinestesia” en tu perfil?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Supongo que sí.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Pues entonces cuéntanos: ¿cómo son nuestras auras?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia se acerca, curiosa.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Hm... Eres un poco contradictorio.", "Soya")
	await novel_interface.show_dialog("Hueles como un camino rural después de la lluvia y te sientes... cálido. Incluso cuando tienes emociones negativas, la lluvia las elimina todas al instante.", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","perspire1",0.25)
	await novel_interface.show_dialog("(... ¿Entonces es por eso que Sonya no pudo esquivar cuando Raphilia la golpeó? ¿Porque ya no olió su furia?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya ladea la cabeza, pareciendo confundida.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Por lo general, las personas que huelen así son amables y tranquilizadoras, pero tú eres violento, irritable y...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si yo fuera el que tuviera sinestesia, apuesto a que vería llamas furiosas sobre la cabeza de Raphilia en este mismo momento.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Uh, quiero decir, los olores no mienten, así que debes ser dulce, indulgente, amable, benévolo y no violento, ¿verdad?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya rápidamente intenta enmendarse y cambia de tema.")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Ejem, de todos modos, Ren... ¡tiene el color más puro que he visto en mi vida!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("¿Respirar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¿Ah?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia levanta una ceja y la curiosidad la lleva a dejar su enojo a un lado.")#文字错误
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Por ejemplo, cuando estábamos comiendo parfaits en la tienda de postres, con cada bocado que ella tomaba, podía escucharla gritar \"¡Eeeee! ¡Qué rico!\". desde lo más profundo de su corazón.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Ah, ¿en serio?\n(¡Eso es tan vergonzoso!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("No da el siguiente bocado hasta que termina de chillar. Es realmente interesante de ver.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ja, un idiota de hecho.", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("En cuanto a Elluka, es como un hámster. Ella simplemente come y come.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("¡Ejeje!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka se ríe, como si Sonya la estuviera elogiando.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Cuando Ren ve a una linda chica en la calle, ella comienza a brillar de rosa. Hace todo lo posible por no mirar fijamente, pero sus ojos siempre la traicionan...", "Soya")
	await novel_interface.show_dialog("A veces finge mirar a lo lejos detrás de la chica y luego gira la cabeza en otra dirección con la esperanza de parecer menos asquerosa.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Lo sabía, ella es material totalmente acosadora.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia me lanza una mirada furiosa.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Ay, vamos...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pensé que estaba haciendo un buen trabajo ocultando mi mirada... ¿tenía que observarme con tanto cuidado?")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Cuando Ren ve ropa bonita, su aura luce dos colores diferentes y contrastantes. Sin embargo, normalmente gana el lado rosado.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("¿Ah?", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia me echa un vistazo y su mirada finalmente se posa en mis piernas.")
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("(¡Soy inocente! ¡Realmente no sé nada!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Por cierto, si baja el tono de su aura como si quisiera simplemente desaparecer, significa que necesita ajustarse el tirante del sujetador o las medias de red.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","hungry")
	await novel_interface.show_dialog("¡Ah, buena observación!", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("¡Así es!", "Rafael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka y Sonya parecen estar pasando el mejor momento de sus vidas, lo que hace que Sonya esté aún más feliz de contarles más.")#文字错误
	await novel_interface.show_text_only("Esto es todo. No puedo quedarme aquí y escuchar esta calumnia...")
	await novel_interface.show_text_only("Contengo la respiración, retrocedo.")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ah, claro, cuando Ren quiere ir al baño, ella—", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que Sonya pueda terminar la frase, la luz indicadora de su tobillera empieza a parpadear.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("¿Eh?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se oye un clic y luego un elegante arco azul claro pasa velozmente por la ventana del vestíbulo de la galería de arte.")
	await novel_interface.show_text_only("La chica de cabello plateado cae al suelo, una ráfaga de humo blanco sale de su cuerpo.")
	await novel_interface.show_text_only("Elluka se arrodilla a su lado y toca su forma inmóvil, con cara inocente. Raphilia debería poder darse cuenta inmediatamente de que Elluka no lo hizo.")
	await novel_interface.show_text_only("Cuando la chica rubia finalmente recuerda que existo, ya he llegado a las escaleras.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(¡Lo siento, esta es la única forma en que puedo hacerla callar!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡Bam!")
	await novel_interface.show_text_only("En mi prisa por escapar, choco directamente contra alguien.")
	await novel_interface.show_text_only("En lugar de ser derribado, ese “alguien” me ayuda suavemente a levantarme, soportando mi peso con sus... activos.")
	novel_interface.show_character("ren_fishnet","timid")
	await novel_interface.show_dialog("(Son... ¡tan elásticos!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Cuidado, pequeño.", "Mujer de pelo negro")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La dama de cabello negro me hace una mueca y luego bosteza.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Uh, lo siento...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella sostiene una katana japonesa con una empuñadura intrincada y una hoja de diseño artístico.")#文字错误
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Eres Ren, ¿no?", "Mujer de pelo negro")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("¡Qué carita tan adorable!", "Mujer de pelo negro")
	await novel_interface.hide_character()

	print("=== 天启篇第05话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
