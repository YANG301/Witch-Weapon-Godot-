# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Nos enseñan todo tipo de virtudes para vivir.")
	await novel_interface.show_text_only("Estoy seguro de que la mayoría de nosotros hemos leído esa historia sobre Marie Curie y su extraordinaria capacidad de concentración.")
	await novel_interface.show_text_only("Ella estaba estudiando y a su hermana y a sus compañeros se les ocurrió una broma. Apilaron varias sillas detrás de ella. Si se movía, toda la pila se derrumbaría.")
	await novel_interface.show_text_only("Pero la pila permaneció en su lugar incluso hasta que Marie Curie terminó de leer el libro completo.")
	await novel_interface.show_text_only("Su gran enfoque fue lo que le permitió convertirse en la primera científica en recibir dos veces el Premio Nobel.")
	await novel_interface.show_text_only("Pero quizás se te haya ocurrido esta pregunta:")
	await novel_interface.show_text_only("“¿Todos sienten lo mismo respecto al mismo tema? ¿Desde que nacieron?”")
	await novel_interface.show_text_only("Algunas personas nacen con la capacidad de absorber conocimientos sin parar y apenas necesitan dormir.")
	await novel_interface.show_text_only("Pueden memorizar mucha información y permanecer concentrados durante mucho tiempo.")
	await novel_interface.show_text_only("Es fácil para ellos. Pero para muchos otros, es casi imposible.")
	await novel_interface.show_text_only("Quizás, para Marie Curie, leer libros de física sea más fácil que leer manga.")
	await novel_interface.show_text_only("Entonces, luchar por las mismas “virtudes”, para la mayoría de las personas, es como luchar contra los rasgos genéticos con los que nacieron.")
	await novel_interface.show_text_only("¿Quizás no hayas considerado esta pregunta antes?")
	await novel_interface.show_text_only("Pero ahora lo has hecho. La semilla ha sido plantada en tu cabeza.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Entonces...")
	await novel_interface.show_text_only("La próxima vez que te hagas esta pregunta, ¿la voz de quién la hará?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Haga clic.")
	await novel_interface.show_text_only("El sonido de un arma de fuego al cargarse.")
	await novel_interface.show_text_only("Después de la secuencia de apertura de NTBC News, llega la voz familiar de la locutora.")
	await novel_interface.show_dialog("\"El cuarto Foro Internacional Anual de Paz se llevará a cabo en la Zona Desmilitarizada Acordada en Nueva Opulentia dentro de tres días\".", "Noticias")
	await novel_interface.show_dialog("“Como ciudad neutral con el sistema de investigación científica más grande, Nueva Opulentia dará la bienvenida a invitados de las otras cinco Ciudades Academia esta semana”.", "Noticias")
	await novel_interface.show_dialog("\"El Foro de Paz de este año se centrará en el desarrollo de la Sustancia H como recurso energético, el Proyecto de Reconstrucción y otras cuestiones importantes\".", "Noticias")
	await novel_interface.show_dialog("\"El presidente de Masada Ford ha declarado en un reciente discurso informal que la ciudad pronto publicará un nuevo conjunto de planes militares para restablecer el orden en Oriente Medio\".", "Noticias")
	await novel_interface.show_dialog("\"El representante del Departamento de Noticias de Salmonton se ha negado a comentar sobre este tema\".", "Noticias")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("En el antiguo almacén cuelga una lámpara de techo tenuemente iluminada que emite pequeños chisporroteos de electricidad.")
	await novel_interface.show_text_only("A un lado, un hombre de cabello plateado está sentado bajo la dura luz blanca.")
	await novel_interface.show_text_only("Está atado a una silla resistente cuyas patas han sido soldadas al suelo.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("El hombre todavía se está adaptando a la luminosidad que lo rodea, ya que le acaban de quitar el saco que llevaba encima de la cabeza. Los ásperos cables de refuerzo del barco rozan su costoso traje personalizado, dejando extremos ásperos y deshilachados.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al notar el sonido de un arma de fuego al ser amartillada, lentamente levanta la cabeza.")
	await novel_interface.show_text_only("Justo delante de él hay una cámara montada. Y junto a él, un secuestrador con una máscara negra lo apunta con una pistola.")
	await novel_interface.show_text_only("El hombre intenta desesperadamente mirar a su alrededor. Ve a un guardia en el otro extremo del almacén, sosteniendo un rifle de asalto.")
	await novel_interface.show_text_only("Por el pañuelo negro que cubre sus rostros y los trajes de camuflaje, es bastante obvio de dónde son estos tipos.")
	await novel_interface.show_text_only("El hombre de cabello plateado se retuerce lo mejor que puede. En la periferia de su visión, ve una bandera negra...")
	await novel_interface.show_text_only("En la cámara de vídeo que tiene delante hay un teléfono móvil que reproduce las noticias al máximo volumen.")
	await novel_interface.show_dialog("\"Sir Lumbert, secretario ejecutivo de la Organización del Tratado para la Prohibición de Experimentos con Armas Sustancia H, celebró hoy una conferencia de prensa\".", "Noticias")
	await novel_interface.show_dialog("\"La organización desempeña un papel importante para evitar que la Sustancia H se utilice como arma. Se estableció sobre la base del Tratado Universal de Prohibición de Experimentos con Armas de Sustancia H\".", "Noticias")
	await novel_interface.show_dialog("\"Sir Lumbert afirma que la organización ha establecido actualmente un gran número de estaciones de seguimiento en todo el mundo para supervisar todos los experimentos con la sustancia H\".", "Noticias")
	await novel_interface.show_dialog("\"Lumbert cree que la cooperación militar entre Ciudades Academia debería convertirse en una parte normalizada de sus relaciones diplomáticas\".", "Noticias")
	await novel_interface.show_dialog("\"Afirma apoyar el desarrollo y la experimentación de Masada Ford con su sistema de respuesta pasiva. Explica que una cantidad razonable de intimidación es la verdadera base para mantener la paz\".", "Noticias")
	await novel_interface.show_dialog("\"También pide públicamente la oportunidad de tener una conversación con la Dra. Mariru Von Braun de la Academia de Ciencias New Opulentia...\"", "Noticias")
	await novel_interface.show_text_only("Al escuchar esto, el hombre atado a la silla sonríe levemente.")
	await novel_interface.show_text_only("Su impecable cabello plateado está peinado hacia atrás. Ojos cerúleos miran con indiferencia algunas fotografías clavadas en la pared.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("En una foto descolorida, algunos trabajadores con trajes protectores se enfrentan a montones de cadáveres.")
	await novel_interface.show_text_only("A juzgar por la baja resolución de las fotografías, debieron haber sido tomadas con una cámara SLR y película antigua.")
	await novel_interface.show_text_only("Recuerda claramente que, en ese momento, habían utilizado fuertes ondas de interferencia electromagnética en un radio de varios kilómetros para evitar que otros filmaran el área.")
	await novel_interface.show_text_only("Según la fecha en la parte inferior izquierda, la foto fue tomada hace tres años a orillas del río Churún, en el Escudo Guyanés...")
	novel_interface.change_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("¡Haz clic!")
	await novel_interface.show_text_only("El hombre de negro cierra de golpe el teléfono y, de la nada, le da una patada en el estómago al hombre de cabello plateado.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("¡Uf! *tosiendo*", "Hombre de traje")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No soporto lo falso que parece en la televisión, ¿eh, señor?", "Secuestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("¿Falso?\nYo era... sincero.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El hombre de negro se acerca a Lumbert, lo agarra del cabello y tira de su cabeza hacia atrás, obligándolo a mirar directamente a la única fuente de luz en la habitación.")
	await novel_interface.show_text_only("Luego saca una guadaña y apunta al ojo de Lumbert.")
	await novel_interface.show_dialog("Bueno, me pregunto cuánto vale tu cara.", "Secuestrador")
	await novel_interface.show_text_only("Con la luz brillando directamente en los ojos del hombre, sus pupilas cerúleas se diluyen rápidamente.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Entonces, ¿qué dices? Nombra tu precio.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert echa un vistazo furtivo a la hoja de acero de Damasco que apunta a su globo ocular.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Te colaste en Nueva Opulentia, te apoderaste de mi agenda completa y acabaste con todos mis guardaespaldas en dos minutos...", "Lumbert")
	await novel_interface.show_dialog("E incluso logré obtener esas fotos...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("De ninguna manera hiciste todo eso solo para filmar un video de mi decapitación. Debes tener algún otro motivo.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El lúcido razonamiento de Lumbert toma por sorpresa al hombre de negro.")
	await novel_interface.show_text_only("Libera a Lumbert de su estrangulamiento y le golpea la cara con una hoja de papel.")
	await novel_interface.show_dialog("Bueno, entonces pongámonos manos a la obra. Te daré sesenta segundos para responderme. ¿Acuerdo o no trato?", "Secuestrador")
	await novel_interface.show_text_only("El papel se desliza sobre los pantalones de Lumbert. Mira hacia abajo: en él están impresos doce cuentas en moneda cifrada y los precios reales.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Mmm. Tienes cierto grado de autocontrol. Es bueno verlo.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert mira por la ventana. El día parece estar amaneciendo.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("(Después de tenerme como rehén durante doce horas, comenzaron una negociación con un objetivo claro en mente.)")
	await novel_interface.show_text_only("(Sólo los secuestradores experimentados hacen eso. Deben estar bien entrenados...)")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert mira de reojo las cifras que figuran en la hoja de papel.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Si tengo en cuenta el tipo de cambio, parece que estas cifras están de acuerdo con la fianza para la lista de terroristas que el Consejo Unido ha publicado recientemente...", "Lumbert")
	await novel_interface.show_dialog("No eres de la Resistencia, ¿eh?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La repentina pregunta de Lumbert toma al secuestrador con la guardia baja.")
	await novel_interface.show_dialog("¿Eh?", "Secuestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Los aplaudo por su esfuerzo de actuar como terroristas, pero apuesto a que Menorah los envía desde Masada Ford.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Cállate!", "Secuestrador")
	await novel_interface.show_text_only("El hombre de negro marcha rápidamente hacia Lumbert, dispuesto a noquearlo.")
	await novel_interface.show_text_only("Y éste de repente levanta la voz y grita en hebreo:")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("(hebreo) ¡Bomba! ¡Bajar!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El guardia en el otro extremo del almacén instintivamente levanta los brazos para cubrirse la cabeza y, tras darse cuenta de que es una trampa, agarra su arma y apunta a Lumbert.")
	await novel_interface.show_text_only("El hombre de negro ciertamente no esperaba esto. Pero es obvio que su tapadera queda descubierta por las acciones reflexivas de su camarada.")
	await novel_interface.show_text_only("Lumbert sonríe burlonamente.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Entonces, ¿es este el guión que estás siguiendo? He sido secuestrado por terroristas de la Resistencia, que afirman estar en posesión de pruebas de que el Congreso Unido realizó experimentos ilegales con la Sustancia H...", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert vuelve a mirar las fotos de la pared.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Actualmente soy la única persona que ha mostrado públicamente su apoyo a Masada Ford por construir sistemas automáticos de contraataque con fines de intimidación. Es razonable que la Resistencia me secuestre.", "Lumbert")
	await novel_interface.show_dialog("Soy una figura bastante conocida, así que esto saldrá en todas las noticias. Más comenzarán a ver a la Resistencia como terroristas locos.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Y también puedes usar esas fotos para obligar al Congreso Unido a desembolsar dinero en forma de moneda cifrada... matando tres pájaros de un tiro.", "Lumbert")
	await novel_interface.show_dialog("La transacción de moneda cifrada es totalmente visible en el canal público. Una vez que paguen, será como si hubieran admitido públicamente que han realizado experimentos ilegales con la sustancia H antes.", "Lumbert")
	await novel_interface.show_dialog("En el futuro, Masada Ford podrá usar esto para amenazar a las otras Ciudades Academia y apoyar su sistema de respuesta pasiva. Nadie se atreverá a rechazar ninguna de sus solicitudes.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Su análisis es 100% exacto. El hombre de negro se queda paralizado por el shock, sin saber qué hacer.")
	await novel_interface.show_text_only("A pesar de estar contenido, Lumbert ahora tiene la ventaja.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Elegiste utilizar imágenes de noticias editadas para no tener que hablar mucho y no notar tu acento.", "Lumbert")
	await novel_interface.show_dialog("Pero la marca de la cámara... la bandera negra detrás de mí... esa guadaña de Damasco... eso es excesivo, ¿no crees?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert hace una pausa y le sonríe al nervioso hombre de negro.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Por lo que puedo decir, ustedes debieron ser ex-reclutas que trabajaron bajo Menorah antes de que los echaran.", "Lumbert")
	await novel_interface.show_dialog("Escuché que incluso aquellos que no pasaron sus pruebas aún pueden trabajar como una especie de mercenarios especiales, siempre y cuando pasen la “revisión de ideología”.", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Así que a los minions desechables como tú se les asigna la tarea de llevar a cabo operaciones políticamente controvertidas como ésta. De esa manera, si mueres, no les afectará de todos modos.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Secuestrador")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Probablemente tengas órdenes estrictas de no hacerme daño. Después de todo, soy el único partidario de Masada Ford en este momento.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Pero bueno, tengo una buena oportunidad para ti y tu amigo...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Por lo que sé sobre la composición estándar del escuadrón de combate de Menorah, tú y ese guardia de allí no sois los únicos en el equipo.", "Lumbert")
	await novel_interface.show_dialog("Fuera de este almacén, debería haber un miembro técnico de combate, un apoyo de potencia de fuego pesada y un francotirador. ¿Estoy en lo cierto?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert le pregunta al hombre de negro, cada palabra claramente enunciada, con ojos agudos y astutos.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Comparte lo que sabes conmigo y aceptaré fingir que no sospecho nada y seguir jugando siguiendo este guión que tienes.", "Lumbert")
	await novel_interface.show_dialog("Si no lo haces, fracasarás en esta misión. ¿Y quién sabe cómo lo castigarán las personas de su organización si eso sucede?", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Eh, está bien! Nosotros... ¡trabajaremos contigo!", "Secuestrador")
	await novel_interface.show_text_only("El hombre de negro toma la decisión de inmediato. Se da vuelta, buscando una llave para liberar a Lumbert.")
	await novel_interface.show_text_only("De repente, de la nada, se oye el sonido de algo cortando el aire...")
	await novel_interface.show_text_only("El hombre de negro se queda inmóvil, como petrificado.")
	novel_interface.show_character("lambert","surprise")
	await novel_interface.show_dialog("¿Qué...?", "Lumbert")
	await novel_interface.hide_character()
	
	# scene3
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Antes de que Lumbert pueda terminar su pregunta, todas las luces del almacén se apagan.")
	await novel_interface.show_text_only("Desde afuera llegan varios golpes fuertes.")
	await novel_interface.show_text_only("¡Auge!\n¡Chocar!")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse2.png")
	await novel_interface.show_text_only("Una poderosa ráfaga de aire hace volar todas las ventanas del antiguo almacén. Múltiples focos cegadores invaden el espacio al mismo tiempo.")
	await novel_interface.show_dialog("¡Que nadie se mueva!", "Soldado de la Oficina de Defensa")
	await novel_interface.show_text_only("Bajo el cielo de primera hora de la mañana, una docena de policías especiales del Metropolitan MD llegan. Derriban a los guardias afuera del almacén en segundos y corren hacia Lumbert.")
	await novel_interface.show_text_only("El fuerte ruido de la hélice del helicóptero bloquea todos los demás sonidos.")
	await novel_interface.show_text_only("El equipo de rescate ayuda a Lumbert a ponerse de pie, mientras sacude con calma sus doloridos brazos y piernas.")
	await novel_interface.show_text_only("Un miembro del equipo toma una fotografía de lo que solía ser el hombre de negro. Su cuerpo ha sido cortado limpiamente en dos desde la cintura. Con un golpe sordo, la mitad superior se desliza hasta el suelo.")
	await novel_interface.show_text_only("Mientras que la mitad inferior, sus dos piernas, todavía están allí.")
	await novel_interface.show_text_only("Los miembros del equipo de rescate que los rodean miran confundidos este extraño cadáver.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Entonces no fueron ellos quienes lo mataron. Por lo tanto, debe ser...", "Lumbert")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("—¡Espera, las fotos!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert se vuelve hacia la pared, previamente cubierta por fotografías. Todas las fotos han desaparecido.")
	await novel_interface.show_text_only("En un rincón oscuro, un punto ciego libre de las cámaras de vigilancia, un largo mechón de cabello negro y ensangrentado desaparece silenciosamente en la noche...")
	
	print("=== 天启篇第01话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
