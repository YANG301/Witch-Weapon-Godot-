# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice levanta uma perna, o pé no corrimão, e grita no microfone.")
	await novel_interface.show_text_only("O aparelho de som, no volume máximo, leva sua voz até o final da Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Vocês são um lixo, todos vocês!", "Beatriz")
	await novel_interface.show_dialog("Vá para o inferno, pervertidos!", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("O quê?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Uh...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ela só está... dizendo isso para chamar a atenção, certo? Ela não quis dizer isso, certo?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("E atraiu a atenção que ela fez. Todos os olhos estão voltados para ela agora.")
	await novel_interface.show_text_only("No momento em que veem o rosto de Beatrice, os pedestres não conseguem mais desviar o olhar. Eles ficam parados, boquiabertos, impressionados com os saltos altos vermelhos brilhantes e a sombra atraente sob a minissaia.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Lixo, todos vocês! Insetos imundos! Você adoraria que eu pisoteasse vocês até a morte, não é?", "Beatriz")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Você não tem vergonha?", "Beatriz")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Talvez ela realmente esteja falando sério...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A maioria das pessoas na rua está olhando agora. Até os mascotes que dançavam nos tetos dos outros caminhões param de se apresentar para assistir ao espetáculo.")
	await novel_interface.show_text_only("Sonya e eu aproveitamos a oportunidade para subir a escada na lateral da caminhonete de Elluka.")
	await novel_interface.show_text_only("A garota está sentada em seu trono, dando tapinhas de satisfação na barriga protuberante. Dezenas de pratos vazios estão na mesa de oferendas à sua frente.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Ela... comeu tudo isso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Examino a área, calculando a melhor maneira de tirar esse glutão gordinho de toda essa bagunça, mas Elluka simplesmente se joga em cima de mim.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Senhorita Ren!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Coloco um dedo nos lábios, gesticulando para ela mantê-lo abaixado...")
	await novel_interface.show_text_only("No entanto, ela já saltou no ar, mirando direto no meu rosto...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Ah, certo. A primeira vez que vi Elluka, ela estava lutando contra bruxas no ar, não estava?")
	await novel_interface.show_text_only("Lembro-me de Aya me contando que essa menina, com cerca de onze ou doze anos de idade, a julgar pela idade de seus ossos, havia passado por dezenas de operações e tinha inúmeras peças mecânicas instaladas em seu corpo.")
	await novel_interface.show_text_only("Sua memória foi apagada muitas vezes – ela nem se lembra de quando seu olho esquerdo foi substituído por uma prótese ocular eletrônica de nível militar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Com todas aquelas peças mecânicas dentro dela, mesmo sendo capaz de flutuar aproveitando o campo eletromagnético, seu peso real é na verdade o dobro do meu...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Baque!")
	await novel_interface.show_text_only("Elluka pousa em cima de mim, as coxas apertando minhas costelas, a barriga macia cobrindo meu rosto. Suas mãos gordinhas agarram minha nuca.")
	await novel_interface.show_text_only("Juro que pude ouvir minha coluna quebrando com a pressão.")
	await novel_interface.show_text_only("Ela envolve todo o corpo em volta do meu peito, da minha cabeça, esfregando o rosto no meu cabelo como um gato muito entusiasmado.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Senhorita Ren é minha favorita! *oi*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pelo seu rosto vermelho alegre e pela voz arrastada, alguém poderia pensar que ela está bêbada.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Eu ouvi um estalo alto... eram seus ossos?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fico rígido, congelado no local. Parece que meu pescoço vai quebrar ao meio se eu mover um pouquinho.")
	await novel_interface.show_text_only("A comoção parece ter atraído a atenção das mulheres próximas. Alguns até apontam para nós, perguntando “o que é isso?”")
	await novel_interface.show_text_only("Pareço um monstro cabeçudo usando meias arrastão agora. Não admira que estejam confusos.")
	await novel_interface.show_text_only("Percebendo nossa situação, Beatrice levanta a voz, como se quisesse nos dar mais tempo para evacuar.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Todos vocês pertencem ao ferro-velho! Nem um grama de decência em suas cabeças! Larvas! Arrepios! Suínos!", "Beatriz")
	await novel_interface.show_dialog("Todos vocês—", "Beatriz")
	await novel_interface.show_dialog("Morra!", "Beatriz")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os dois oradores cantam em coro com eletricidade efervescente enquanto o discurso apaixonado de Beatrice atinge o seu clímax.")
	await novel_interface.show_text_only("E finalmente explodem, ao lado das lâmpadas dos outdoors iluminados próximos.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("A rua inteira cai em um silêncio assustador.")
	await novel_interface.show_text_only("A multidão ainda está olhando, em estado de choque, para a senhora ruiva, parada em toda a sua glória no topo do caminhão.")
	await novel_interface.show_text_only("Sonya aproveita a breve distração para arrancar Elluka de cima de mim e depois a empurra de costas.")
	await novel_interface.show_text_only("A menina mais nova, que se grudava em mim como se fosse um chiclete, adormece num instante.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Uau... não esperava que o pirralho pesasse tanto...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suspiro, finalmente conseguindo recuperar o fôlego, massageando minha cintura enquanto examino a cena. Ainda está irritantemente silencioso.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Esses caras estão petrificados ou algo assim?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas momentos depois, aplausos começaram a se espalhar pela multidão. Aplausos altos e maravilhosos.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Ahhhh! Ela é maravilhosa! Você é maravilhoso!", "Transeunte A")
	await novel_interface.show_dialog("Pise em mim, minha rainha!", "Transeunte B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("O quê?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ondas e mais ondas de aplausos extáticos explodem por toda a rua.")
	await novel_interface.show_text_only("As multidões estão se revoltando de pura excitação.")
	await novel_interface.show_text_only("Dos caminhões blindados pretos do outro lado da rua, vários soldados carregando armas automáticas descem, observando confusos o repentino alvoroço.")
	await novel_interface.show_text_only("Gesticulo na direção deles, tentando alertar Beatrice, e é aí que acidentalmente avisto seu rosto...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Ah, querido—", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Ela é... tão linda!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma corrente quente e formigante que parece muito com desejo se espalha pelo meu corpo instantaneamente.")
	await novel_interface.show_text_only("Minhas bochechas queimam, minhas pernas cedem...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Eu quero ela...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("...Ren?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As multidões estão fora de controle. Eles atacam o caminhão de Beatrice como um só, cantando em voz alta enquanto avançam, a tal ponto que o frágil veículo está prestes a tombar.")
	await novel_interface.show_text_only("Alguns caras tentam escalar o caminhão pela lateral, mas Beatrice simplesmente pisa em suas mãos e os chuta para baixo.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Sim! Mais! Pise em mim também! Por favor, minha rainha!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sorri e balança a cabeça ao ver a expressão de pura idiotice em meu rosto, depois coloca a pulseira de volta.")
	await novel_interface.show_text_only("Então ela tira uma cápsula prateada do tamanho de um polegar de seus seios e a joga na multidão selvagem sob seus pés...")
	await novel_interface.show_text_only("Numa nuvem de fumaça branca, a bela Beatrice desaparece sem deixar rastros.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Ainda não consigo esquecer seu rosto deslumbrante, até que Sonya puxa meu braço.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Saia dessa! Os soldados estão chegando! Além disso...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("À medida que a fumaça se dissipa, a multidão começa a murmurar confusa, percebendo que o objeto em foco não está mais ali.")
	await novel_interface.show_text_only("Sonya e eu mal conseguimos nos afastar da multidão antes que o fã-clube de Elluka perceba que seu ídolo se foi.")
	await novel_interface.show_dialog("Onde está Lady Elluka?", "Guarda Real A")
	await novel_interface.show_dialog("Ali! Aquele de meia arrastão levou Nossa Senhora Elluka!", "Guarda Real B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Meias arrastão? Lady Elluka?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Seqüestrador! Chame a polícia!", "Guarda Real C")
	await novel_interface.show_dialog("Depois deles!", "Guarda Real A")
	await novel_interface.show_text_only("Um grupo de homens furiosos vem direto até nós, seguido por alguns policiais de segurança.")
	await novel_interface.show_text_only("Qual é, que tipo de sequestrador usa meias arrastão?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Corra!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas é difícil para nós afastar a multidão, especialmente porque Sonya está carregando a rechonchuda Elluka, e minha cintura ainda lateja de dor.")
	await novel_interface.show_text_only("O que é pior, há alguns policiais patrulhando à frente...")
	await novel_interface.show_text_only("Não podemos lutar. Não podemos correr. É impossível.")
	await novel_interface.show_text_only("De repente, atrás de nós, vem o som de vidro quebrando.")
	await novel_interface.show_text_only("Um cara loiro com um blusão preto derrubou um outdoor iluminado à moda antiga na rua.")
	await novel_interface.show_text_only("Os cacos das lâmpadas do outdoor cobrem o chão. Os pedestres, tentando ao máximo evitá-los, desaceleram efetivamente o fã-clube de Elluka.")
	await novel_interface.show_text_only("O loiro sorri para Sonya e para mim, com um rosto inocente e doce.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Há um atalho à frente. Venha comigo?", "Menino com óculos")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya e eu trocamos olhares. Por que isso parece algum tipo de cenário de filme?")
	await novel_interface.show_text_only("O jovem de óculos, cabelos loiros fofos, camisa xadrez e olhos azuis, parece um tanto tímido.")
	await novel_interface.show_text_only("Ele parece quase envergonhado pela nossa falta de reação e se apressa em explicar:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Eu... eu trabalho meio período em uma loja por aqui... acabei de sair do trabalho...", "Menino com óculos")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ele olha para minhas pernas, engole em seco e se vira.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Uau, essa não é realmente uma boa maneira de olhar furtivamente para as garotas...)\n(É muito óbvio...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Você... parecia que estava sendo perseguido por alguns bandidos, então pensei...", "Menino com óculos")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os ombros de Sonya caem quando ela baixa a guarda brevemente.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("A julgar pela sua aura, ele não quer nos machucar.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Na verdade, considerando todas as coisas, NÓS somos os vilões aqui...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Mostre o caminho!", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
