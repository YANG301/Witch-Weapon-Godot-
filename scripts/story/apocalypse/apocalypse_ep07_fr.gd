	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Tu veux dire... Theresa fait aussi partie de ces personnes ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Une de ces personnes ?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je garde les yeux rivés sur le visage de Sonya pendant que j’essaie de trouver les mots justes.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Comme les filles qui ont reçu les « informations » de la magie, mais qui sont toujours saines d’esprit.", "Lian")
	await novel_interface.show_dialog("Certaines d’entre elles sont incapables de supporter le fardeau de la connaissance et perdent la raison, devenant ainsi le genre de sorcières que l’on veut tuer.", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Il y a une différence entre les deux.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya garde les yeux rivés sur les miens pendant qu'elle parle :")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Alors, ceux qui perdent la raison... peuvent-ils s'en remettre ?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Théoriquement non. C'est du moins ce qu'Aya a dit...", "Lian")
	await novel_interface.hide_character()
	
