	await novel_interface.show_dialog("(Oh, ça vient de cette émission !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne peux m’empêcher d’être un peu excité.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hum ?", "Raphaël")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Euh, rien, rien...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je cache rapidement mon enthousiasme. Je suis plutôt un pro dans ce domaine maintenant.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Je dois y aller. Vous feriez mieux de partir aussi.", "Raphaël")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("On dirait que quelque chose de fou va se produire ce soir.", "Raphaël")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia me met dans la main une gemme verte de la taille d’une bille.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Henriette a fait ça. Cela pourrait s'avérer utile si quelqu'un était blessé.", "Raphaël")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia évite résolument mon regard, l’air très gênée.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Oh... Henriette, hein...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela fait un moment que je n’ai pas entendu parler de cet alchimiste qui insistait pour m’appeler « Maître ».")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Je me demande ce qu'elle penserait si elle savait que maintenant c'est moi qui dois appeler les autres Maître en tenue de servante...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Quoi qu'il en soit, faites attention.", "Raphaël")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avant même que je puisse répondre, Raphilia disparaît avec Theresa et son entourage.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Je les regarde disparaître dans la foule d’Electronics Street.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hm, elle serre toujours dans ses bras ce livre avec lequel elle vient de me frapper à la tête...", "Soya")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pas étonnant qu’elle soit si pressée de partir !")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Hé, et si nous regardions également cet événement avant de rentrer...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J’adorerais aussi avoir mon propre petit drapeau jaune. Mais avant que je puisse finir ma phrase, Sonya me plaque contre un mur.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Ça vous plaisait, hein ? Tu penses que me choquer avec le bracelet de cheville est totalement amusant, hein ?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Ah non...\nS-désolé !", "Lian")
	# removed legacy empty placeholder comment
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me rends compte que j'ai peut-être baissé ma garde trop tôt.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Je me pose la question depuis cet après-midi...", "Soya")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("Thérèse, Raphilia et Elluka...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(Ils trois ? Qu’ont-ils en commun ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Leurs auras sentent la sorcière, mais ont des couleurs semblables à celles des humains.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Ce n’est pas ce à quoi je m’attendais.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya passe durement son index et son majeur sur mon cœur. Ses yeux sont d’acier, froids et déterminés. Une chose est claire :")
