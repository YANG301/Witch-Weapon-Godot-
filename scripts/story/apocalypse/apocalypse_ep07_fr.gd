	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Sonya me libère lentement de son emprise, soulagée, après avoir entendu ma réponse.")
	await novel_interface.show_dialog("... Est-ce vrai ?", "Soya")
	await novel_interface.show_text_only("Sa voix est petite, tremblante.")
	await novel_interface.show_dialog("Tu sais quoi...? Quand Theresa vous a guidé pour « tirer une flèche invisible » avec votre bras…", "Soya")
	await novel_interface.show_dialog("Je pensais que tu me tuerais, c'est sûr...", "Soya")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lorsqu'elle a touché votre corps et que vous avez commencé à vous \"charger\", j'ai pu sentir vos auras augmenter en puissance, au moins dix... non, des centaines de fois l'originale.", "Soya")
	await novel_interface.show_dialog("N’importe qui aurait été dévoré par un tel pouvoir.", "Soya")
	await novel_interface.show_dialog("Mais j’ai regardé cette aura cramoisie, si puissante qu’elle pénétrait tout le bâtiment, me traverser. Et pourtant, je n’ai pas été blessé du tout…", "Soya")
