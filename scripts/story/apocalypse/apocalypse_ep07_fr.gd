	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Harima Tech a fini de scanner nos spécimens de sorcières. Ils ont trouvé quelque chose d'intéressant...", "Aï")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Des spécimens ? Vous voulez dire ceux que les militaires ont capturés dans les collines du nord « pour un prix énorme » ?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Heureusement que je ne m'occupe que des anomalies sous couverture Aegis...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Eh bien, faire des liens pour les maintenir en place a pris du temps...\nQuoi qu’il en soit, je ne vais pas vous ennuyer avec les détails. Je vais passer directement aux résultats que nous avons trouvés.", "Aï")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Premièrement, le corps d’une sorcière est contrôlé par le cerveau. Cependant, elle ne prend pas en compte ses propres limites physiques.", "Aï")
