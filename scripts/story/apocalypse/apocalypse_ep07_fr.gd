	await novel_interface.show_dialog("Les participants à l’événement recevront gratuitement des produits dérivés de certains anime.", "Entourage")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("C-est-ce que ça pourrait être...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je remarque que beaucoup de piétons brandissent un petit drapeau jaune sur lequel est écrit « Accès restreint ». C’est un objet souvent vu dans l’un des animes les plus populaires de nos jours.")
