	await novel_interface.show_dialog("Mais pas assez capable pour se faufiler dans la suite, tirer sur la cible et faire passer cela pour un suicide.", "Thérèse")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Ou peut-être était-il victime de chantage ?", "Raphaël")
	await novel_interface.show_dialog("Ou peut-être était-il simplement une pièce d’échec dont les gens là-haut n’avaient plus besoin…", "Raphaël")
