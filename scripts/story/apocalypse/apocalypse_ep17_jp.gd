# apocalypse_ep17.gd - 天启篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第17话剧本
	apocalypse_ep17_script()

func play_script():
	pass

# 天启篇第17话 - 正式剧本
func apocalypse_ep17_script():
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("ソヤは笑ってツッコミを入れると、\n身体をゆっくり傾けて、頭を俺の肩に乗せた。")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("……ありがとう、レンさん。", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("帰ったら愛衣に検査してもらおう……\nあいつはすごいから、きっと何か方法が──", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは急に左手の人差し指を俺の唇に当てた。\n\n俺がその先を言うのをやめると、\n再び頭を肩に乗せる。")
	await novel_interface.show_text_only("地上の輝かしい景色を俺達は静かに眺めている。\n\n賑やかな光景なはずなのに、なぜか異様な静寂を\n感じた。")
	await novel_interface.show_text_only("彼女をどう形容するべきなのか……")
	await novel_interface.show_text_only("先駆者？ 開拓者？ 冒険家？")
	await novel_interface.show_text_only("色々な単語が俺の脳内によぎったが、\n口にしようとすると何かが違う気がする──")
	await novel_interface.show_text_only("ソヤも人類の祖先も、馴染みの土地を離れて\n未開の地へと足を踏み入れた時、\nきっと巨大な恐怖に直面したはずだ。")
	await novel_interface.show_text_only("死ぬほど怖いはずなのに期待と興奮を感じて……")
	await novel_interface.show_text_only("周囲の環境を観察しながら、慎重に道を選び\n切り開いていく……")
	await novel_interface.show_text_only("その時になったら「人間」とか「歴史」への\n意義なんて、どうでも良くなるだろう。")
	await novel_interface.show_text_only("色んなポーズの自撮りをしている人間が\nデモ隊の中に混ざっているのは、\nひょっとして自分の存在意義を懸命に\n証明しようとしているのではないだろうか？")
	await novel_interface.show_text_only("全員自分が特別だとアピールする果てに、\n自然とあの巨大な蠢きが生まれたのだろうか？")
	await novel_interface.show_text_only("ここに来る時、車の中に流れているラジオで\nジャーナリストがデモに参加している人々に\nインタビューをしていた事を思い出す。")
	await novel_interface.show_text_only("インタビューされていた23人の中で、\nマサダブルクの正確な場所を、\n世界地図上で指差せたのは1人だけだった。")
	await novel_interface.show_text_only("半分以上の人間は、自分達が参加しているデモが\n一体何なのかすら分かっていない。")
	await novel_interface.show_text_only("「意義」って本当に重要なのだろうか……？")
	await novel_interface.show_text_only("……そんな事を考える最中、携帯の着信バイブが\n俺の思考を現実へと引き戻した。\nソヤにまた奪われそうになったので、\n自らスピーカー音声に切り替える。")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("もしもし、マリルか？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("本当に、2人は大人しくないわね～～", "アイ")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("愛衣！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("それで、外に出るなって言われてるはずなのに\nなんで君達は中央通りに行っちゃってるのよ！？\nしかもそんな高いところにまで登っちゃって……\n人の海でも観察しているのかい？", "アイ")
	await novel_interface.show_text_only("愛衣の言い方は珍しく心配そうだった。\nドローンの1台が不気味に俺達を見つめている。")
	await novel_interface.show_dialog("マリルがどこへ行ったかは分からないわ。\n\n私はベアトリーチェが送ってきた例の電池の\n分析結果を教えようと思ってね……", "アイ")
	await novel_interface.show_dialog("とにかく要点を話すわね。", "アイ")
	await novel_interface.show_dialog("あの電池は異質物と確実に関係がある。\nそしてマサダブルクの軍需企業が製造した物よ。", "アイ")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("やっぱり……異質物武器なのか！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("少なくとも、あのドロドロした光る液体の\n製造過程に異質物が関わっているはずよ。\n今はまだ成分を解析できていないけどね。", "アイ")
	await novel_interface.show_dialog("基本的に燃料電池の一種と思って大丈夫。\n\n封入された液体が放電に伴って消費される\nって仕組みね。", "アイ")
	await novel_interface.show_dialog("でも何故かMMIの出荷番号すら消さずに\n塗装をそのままにしていたわ。\n急いで出荷しようとしたのかしら……", "アイ")
	await novel_interface.show_dialog("電圧リミッターは電池ボックスに外付けされて\nいるけど……", "アイ")
	await novel_interface.show_text_only("愛衣の言い方は少し困惑を帯びている。")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("電池ボックス……電圧リミッター……？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ああ、君達は実物を見た事がないんだっけ。", "アイ")
	await novel_interface.show_dialog("高さは7.2センチの金属製円柱。\n\n\n両端の正負極以外、全体が絶縁塗装に覆われ、\nまるで単三電池を巨大化したかのようね──", "アイ")
	await novel_interface.show_dialog("電池の側面には機械構造のバッフル板があって、\n下にずらすと2つの金属ターミナルがある。", "アイ")
	await novel_interface.show_dialog("ターミナルに低い電圧を与えるだけで、電池の\n正負極の放電強度をコントロールできるわ。", "アイ")
	await novel_interface.show_dialog("外付けの電池ボックスに40マイクロボルトの\n電圧リミッターが付属されていて、\nこれを使ってバッフル板をずらすとターミナルの\n入力電圧をコントロールできる構造なわけさ。", "アイ")
	novel_interface.show_character("ren_fishnet","speechless")
	await novel_interface.show_dialog("なんだか電池で駆動している電池みたいに\n聞こえるけど……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソーラーパネルに懐中電灯の光を当てるみたいな\n原理と同じ感じがする。")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("それは元々、電池として作られたわけでは\nないからでしょうね。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤが真剣な表情になる。")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("まるで……武器の安全装置と点火装置ですわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("電池のパワーを測定したけど──", "アイ")
	await novel_interface.show_dialog("確かに電力会社の説明通りだったわ。\n\nこれなら消費電力が6ワットの超小型監視装置を\n1つの電池で20日間作動できるはずよ。", "アイ")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("なんか……大した事じゃなさそう？", "レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（電力って確か何かと何かを掛け算して……）\n\n（……どうやって計算するんだっけ？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は救いのない俺の物理計算に関する知識に\n呆れを見せる。")
	await novel_interface.show_dialog("──2.88キロワット時！！\n\nレンちゃんの携帯に使う電池の半年分だよ……", "アイ")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("そんなにすごいのか！！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("最近すぐ電池が無くなるから、イルカを使って\n携帯とゲーム機の充電をしていると、\nアニーに良く小言を言われる。")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("少しお待ちを……もし電圧リミッターを外したら\nどうなりますの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("それを言おうと思って電話したのよ……", "アイ")
	await novel_interface.show_dialog("入力が1～500マイクロボルトの範囲内なら\n出力も正比例して増加するんだけど、\n500マイクロボルトを超えた途端、\n出力しなくなる事に気付いたの。", "アイ")
	await novel_interface.show_dialog("そして32ボルトまで上げ続けたら急に\n電池が白光を始めて……", "アイ")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("────ッ！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("高速カメラの映像で確認したけど、電池内の\n液体は1ミリ秒未満で瞬時に使い果たされたわ。", "アイ")
	await novel_interface.show_dialog("激しい放電は隔離室の天井を焦がして、\n壁と床は樹状の焼け跡だらけよ。", "アイ")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("なんだって……！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("以前にスカイホテルでヤコブに襲われた時、\n彼の手下が使っていた放電する武器……")
	await novel_interface.show_text_only("眩しく光った後、部屋中に樹状のような\n焼け跡を残していた。")
	await novel_interface.show_dialog("前回アニーが受けた電撃はこれより比較的\n弱かったわ。\nそれに指向性装置もあったはず。\n\nでなければ部屋にいた全員に電撃が拡散される\n結果になったと思うから。", "アイ")
	await novel_interface.show_dialog("あと32ボルトって数字はマサダブルク国防軍の\n電磁パルス点火式武器の電圧最小値。\nあの規格と共通しているわね。", "アイ")
	await novel_interface.show_text_only("愛衣は少し間をおいて話す。")
	await novel_interface.show_dialog("2.88キロワット/時のパワーを一気に\n放出した場合、\n2.5キログラムのTNT爆薬の威力に\n相当するわ……", "アイ")
	await novel_interface.show_dialog("電池は爆薬みたいに強力な破壊力を持つ衝撃波を\n出すことはできないけど、\n半径10メートル以内の人に致命的なダメージを\n与える事は簡単ね。", "アイ")
	await novel_interface.show_dialog("現在、協定非武装地域の街灯に全てに、\nそんな物騒なものが装着されているわけよ……", "アイ")
	await novel_interface.show_text_only("俺は下の群衆を眺めて、思わず息を飲んだ。")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("クソッ！ ヤコブの奴め……！！", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","speechless",0.25)
	await novel_interface.show_dialog("お待ちくださいまし。", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは急に俺達の話に割り込んだ。")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("先ほどの愛衣さんの説明からしますと、\n最も電池が爆発して欲しくないのは……\nむしろマサダブルクではありませんこと？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("その通りだね。", "アイ")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("慌てて出荷番号も消さずに塗装してから、\n現有の武器ストックを転用、\n緊急用の電圧リミッターを取り付けた……", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("連合議会から急に来た大量注文への\n緊急対策っぽいよね？", "アイ")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("万が一爆発すれば、全ての電池にマサダの\n出荷番号が書いてありますし……\nそれってあまりにも愚かじゃありませんの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("こういう大規模な市政改造工事になると、物流、\n設置、整備に従事する人数は計り知れないから\nそもそも情報を漏らさないようにするなんて\n不可能に近いしね。", "アイ")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("そう言われば、そうだよな？", "レン")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("それに一番おかしい事と言ったら、\nベアトリーチェが報告したあの数人の症例だ。", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("マリルが疾病管理センターに4級の感染警告を\n発表させたみたい。\n今のところ全市で20人前後にも及ぶ患者は、\n全員が協定非武装地域内で発見されたわ。", "アイ")
	await novel_interface.show_dialog("でも、この電池は精神に影響する効果なんて\nひとつもないと断言できる。\nミーム検査の色相も全て異状なしだったし……", "アイ")
	await novel_interface.show_text_only("──俺達は黙り込んでしまう。\n\nいくら考えを巡らせても正解には届かず、\n結局は振り出しだ。")
	await novel_interface.show_text_only("俺はぼんやりと景色を見下ろした。\n\n街灯は10メートルぐらいの幅で均等に建ち、\nその下には大勢の人間が集まっている……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("そういえば下にいた時、ソヤと話していて\nなんか引っかかったような？")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("……デモ隊の……境目……？\n\n……もしかして？", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("……どうしましたの？", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……どういう事？", "アイ")
	await novel_interface.show_text_only("もしかしたら、そもそも答えは最初から\n俺達の目の前にあったのかもしれない。\nでも街には邪魔な要素が多すぎたから、\n俺達はずっと気付かなかった。")
	novel_interface.show_character("ren_fishnet","normal1")
	await novel_interface.show_dialog("連合議会が協定非武装地域内の照明と\n監視システムの改修まで行っていたって……\n……確かマリルが言ってたよね？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("その通りだけど。", "アイ")
	await novel_interface.show_dialog("──じゃあ、なんで明らかに2種類の色の街灯が\nあるんだ？", "レン")
	await novel_interface.show_text_only("暖かな黄色の光を放つ街灯が、デモに集まる\n群衆の境界線をはっきりと描いている。")
	await novel_interface.show_text_only("その隣の閑散とした分かれ道の街灯は白色だ。")
	await novel_interface.show_text_only("電話の向こうから慌ただしくキーボードを\n打つ音がした。")
	await novel_interface.show_dialog("調べたところ、今回全面的に交換したのは\n色温度4500ケルビンの長持ちするLED。\n白めの自然光のはずよ。", "アイ")
	await novel_interface.show_text_only("俺とソヤは目を見合わせて、今夜の出来事を\n思い出そうとする。")
	novel_interface.change_background("res://assets/images/bg/Soya/Cordon.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("──監視映像を見ていた時。\n\n連合議会ビル前の警戒線は、大面積を覆う\n黄色い光源があった。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("電気街の街灯も、暖かな黄色だった気が\nしますわ……", "ソヤ")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("騒ぎが起きた電気街は、カラフルなネオン看板や\n広告灯に囲まれていた。\n黄色の街灯は、その景色に自然と溶け込む事が\nできるだろう。")
	await novel_interface.show_dialog("確かに今日の電気街の雰囲気は興奮し過ぎてて、\n異常だった気がする……", "レン")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("逆に白い街灯の場所には誰もいなかった。", "レン")
	novel_interface.show_background("res://assets/images/bg/Soya/Police_Station.png")
	await novel_interface.show_dialog("わたくし達が脱出した警察署の外にあった街灯も\n白でしたわ！", "ソヤ")
	await novel_interface.show_dialog("それと……", "レン")
	novel_interface.change_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	await novel_interface.show_text_only("新井センターパークの外にあった、\nあの寂しい路地も──")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("まさか……", "ソヤ")
	novel_interface.show_background("res://assets/images/bg/Soya/First_Avenue.png")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("扉の奥にある……", "ソヤ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","upset",0.25)
	await novel_interface.show_dialog("……何？", "レン")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あの眩しい金色の光……", "ソヤ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"solemn")
	await novel_interface.show_dialog("まさか──", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ソヤは少しの躊躇いもなく俺の手を引っ張り、\nエレベーターに向かって走り出す──")
	print("=== 天启篇第17话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
