# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("We emerge from the building to find our ride parked at the entrance. The tubby driver hands us two micro bone conduction earpieces.")
	await novel_interface.show_dialog("The boss told me to give those to you.", "Driver")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("The b-boss?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya and I put on the earpieces and hear Aya speaking on the other end.")
	await novel_interface.show_dialog("It’s too noisy in the crowds. You might have trouble hearing me if we talk on the phone.", "Ai")
	await novel_interface.show_dialog("I just checked. Out of the entire Agreed Demilitarized Zone, only the seven areas where the riots happened have yellow street lamps.", "Ai")
	await novel_interface.show_dialog("Those are all busy areas with a lot of billboards and other light sources, so even those checking aerial footage wouldn’t notice the difference.", "Ai")
	await novel_interface.show_dialog("We’ve sent our retrieval team, but I guess I can’t convince you to stay back. Just keep Ren safe.", "Ai")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Stay back? Huh? Stay back from what?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simply nods at the drone that’s been trailing us, and drags me into the crowd.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("We arrive under a yellow street lamp that luckily isn’t surrounded by too many people. The lamp pole goes up for almost twenty-five feet.")
	await novel_interface.show_text_only("Back in the training courses in SID, I was a total failure at climbing drills.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Got an F for all of them.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I usually had to tackle the pole in a flying leap in order to gain some height—but I end up sliding down anyway.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hehe...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya yanks out a sagging metal box from her purse. It's surprisingly big, with sides the size of your average note paper, and around three inches in thickness.")
	await novel_interface.show_text_only("A shiny silver line runs across the box's surface, marking a rotatable component. And on the side is a pink metallic stripe.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Guess what I've got here!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya exclaims proudly, holding up the box for me to see.")
	await novel_interface.show_text_only("Hmm. Judging from the size, the craftsmanship, the large fan-like rotatable component, and that sparkly metallic stripe—")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Uh, some kind of unnecessarily huge graphics card?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simply pulls the catch on the handle, and the pink-striped side of the box opens up like an accordion.")
	await novel_interface.show_text_only("And from the inside, a series of black mechanical components come popping out, along with a long “board”. Put them all together and it extends for almost forty inches.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("What the heck?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("It's a weapon exclusive to Judgment Knights. Powered by Substance H!", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("The Penitentiary made it for me according to my wishes.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya twists the handle and a row of gleaming saw teeth appears alongside the edge of the long board.")
	await novel_interface.show_text_only("The row of teeth reaches on all the way to the arc at the end of the board, and finally all the way back into the box.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("A chainsaw?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Something like that. It's not powered by electricity, though. It's my favorite weapon!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya grins and turns the \"chainsaw\" on. The teeth begin rotating at astounding speed, but it's surprisingly silent.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("Are you gonna—", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Without hesitation, Sonya begins slicing through the metal light pole. Sparks fly everywhere, and the silver pole screeches in protest.")#多字问题
	await novel_interface.show_text_only("The noise attracts a whole audience. A few middle-aged men, despite not having the least idea what's going on, begin to hoot and cheer.")
	await novel_interface.show_text_only("Very soon, two blasts are heard from inside the pole, and Sonya calmly retrieves her chainsaw.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She looks up at the street lamp, which is no longer shining. The column, around eight inches in diameter, is almost sliced through.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Timber!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("That's more like it!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya smirks, giving the pole a whack towards the opposite direction of the crowds.")
	await novel_interface.show_text_only("And the pole finally gives way, toppling over with a deafening shriek.")
	await novel_interface.show_text_only("Boom! The lamp post slams into the ground, cracking the tar surfacing and sending rubble flying.")
	await novel_interface.show_text_only("The surrounding crowds remain dumbfounded for a few seconds, then wild applause breaks out.")
	await novel_interface.show_dialog("To freedom!\nTo peace!", "Crowd")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("What does this have to do with freedom and pace?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We sprint over to what was once the top of the street lamp. Sonya swiftly cuts off the part with the light, while the drone tailing us lands beside the spectacle.")
	await novel_interface.show_dialog("I can't see much from here. Get rid of the lampshade and hold the light bulb closer to the drone. I want to see the LED model.", "Ai")
	await novel_interface.show_text_only("To avoid the excited crowds, I pick up the light bulb and dash off in the direction of our SUV.")#换行问题
	await novel_interface.show_text_only("As soon as we arrive, Sonya dissects the whole thing according to Aya's instructions. We find a micro-camera, batteries, the filament and the electric ballast.")
	await novel_interface.show_dialog("The serial numbers of these components and the LED all seem fine and above-board.", "Ai")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Hey...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hold up the lampshade against the light source from somewhere outside the vehicle.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("If the lampshade is yellow, there's no way the lamp would produce white light, right?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The yellow texture covering the lampshade seems intricate, with detailed embossment. Must have taken a lot of work.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Maybe there's a message hidden on this lampshade? I can't tell, though...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya, too, holds up the lampshade against the light outside, and shakes her head in defeat.")
	await novel_interface.show_dialog("There's a 3D scanning device on the van. Put the lampshade inside and send the results to me.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Wow, we've got something like that on the car?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Of course! All SID vehicles come with a full set of automated weap—", "Ai")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("Watch out!", "Soya")
	await novel_interface.hide_character()
	
	# Scene 4 - 被攻击场景
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Zing!")
	novel_interface.show_background("res://assets/images/bg/Soya/Beingshot.png")
	await novel_interface.show_text_only("A sudden, blinding blast of white light shoots out from the corner and rams straight into my chest.")
	await novel_interface.show_text_only("For a second, all I can hear is the sharp screech of electricity. Has my heart stopped beating? Feels like it has.")
	await novel_interface.show_text_only("Someone catches me as I fall backward—probably the driver. With Sonya's help, he drags me to the other side behind the van.")
	await novel_interface.show_text_only("Seven buff man in black special combat suits rush upon us with submachine guns...")
	await novel_interface.show_text_only("Everything around me seems to be shrouded in a haze, as if someone's slapped on a gruesome filter. But my brain remains alert, almost extraordinarily so. It's like I can see what's going on in slow motion.")
	await novel_interface.show_text_only("There's Sonya and Aya, screaming my name. But I can't hear them clearly. It's like there were a wall between us...")
	await novel_interface.show_text_only("The driver nimbly pulls out a shotgun from the trunk, loads it with one hand, and begins firing at our attackers, using the bulletproof car door as a cover.")
	await novel_interface.show_text_only("So this chubby dude is actually real badass, huh...")
	await novel_interface.show_text_only("Too bad they have an advantage in numbers and are well-trained. They've got excellent weapons, and it's obvious from the way they're attacking that they aren't planning to let us get away alive. Not even Sonya, a little girl...")
	await novel_interface.show_text_only("The last thing I remember before my consciousness fades away is Sonya squeezing my hand once, then raising her chainsaw—")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("What follows is a series of terrified, animalistic screams of dying men.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# Scene 5 - 瑟蕾莎场景
	novel_interface.change_background("res://assets/images/bg/Soya/Backstreet.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("<Around a thousand feet away from First Avenue>")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Tsk...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa deftly cuts out a black piece of fabric from the outfit of a dead soldier on the ground, while also lazily speaking into her headset.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Are these guys really just a backup team?\nThey sure spent a lot on their equipment.", "Theresa")
	await novel_interface.show_dialog("Huh? Leave them alive?", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("... Oops!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa smacks herself on the head.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("I forgot I was supposed to leave them alive...", "Theresa")
	await novel_interface.show_dialog("Come on, it's not my fault! Their brains all exploded all of a sudden. I got caught off guard so I slayed them all.", "Theresa")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("Besides, even if I bring them back alive, it's not like we can find out anything interesting from these dudes, right?", "Theresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Burn all fingerprints... dynamite implants in teeth... as soon as they're on the verge of death, the mechanism triggers and the whole face is blasted...", "Theresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("... Yeah! See? Not my fault!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya complains to whoever it is on the other end of the conversation.")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("I was totally gonna leave those guys alive! I just kinda hit them with my blade... I wanted to give them a chance to appreciate my cool moves—", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("And then they just exploded!", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She sighs, cleaning her blade with the fabric she cut off, then tosses the dirty rag on the face of the corpse—if it can even be called a face anymore.")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Bunch of losers.", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa puts her gleaming katana back into its sheath.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Two emergency units appeared out of nowhere from an alley. No license plate. There were more than a dozen of them, so I couldn't take them all at once...", "Theresa")
	await novel_interface.show_dialog("But the three of them managed to escape just fine from those attackers, huh? That driver must be skilled.", "Theresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Wait, what?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa presses the headset closer to her ear, as if that would change what she had heard.")
	novel_interface.show_character("cereza","uneasy")
	await novel_interface.show_dialog("The attackers... all annihilated?", "Theresa")
	await novel_interface.show_dialog("And their blood splattered so high it reached the fifth floor of a nearby office building?", "Theresa")#多符号
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Was it...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa pauses, waiting for confirmation from the other side.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Ah, right, I knew it was her doing! When I met her today, I felt it too.", "Theresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("Hahahaha...", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa yawns, sleepily.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("You gotta stop waking me so early all the time. I just wanna go back to my bed.", "Theresa")
	await novel_interface.show_dialog("Anyway, you've got all the information you want, right?", "Theresa")
	await novel_interface.hide_character()
	
	# Scene 6 - 莉琉与伦伯特对话
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("From the other side comes a confident female voice.")
	await novel_interface.show_dialog("Yeah, I’ve got all I need to win in this negotiation.", "Female Voice")
	novel_interface.show_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Sonya's anklet is bugged. I heard everything she told Ren. And that, plus what you've found...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru glances at the faded photo in her hand, as she paces around the closed basement.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Well done, Theresa.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Or should I say... Machida Rinko?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa just laughs wryly and hangs up.")
	await novel_interface.show_text_only("Seconds later, one of the two sets of black elevator doors leading to the basement opens. A man in an impeccable suit comes striding out.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("What an impressive design...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Two elevators, located on different streets, in two buildings back to back. Yet they lead to the same hidden basement.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Hey, Sir Lumbert.\nSee, both of our identities are... sensitive, so we have to meet in secret.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Didn't you say two days ago on TV that you wanted to have a public conversation with me?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Guess there's no need for that anymore.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert motions at the faded photo in Mariru's hand.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Now, tell me. How much do you know?", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 7 - 小怜醒来
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("I can't tell how much time have passed as I slowly regain feeling in my limbs. I hear the rumbling of a vehicle... am I on a car?")
	await novel_interface.show_text_only("There's a hand gently stroking my forehead. Feels like home.")
	await novel_interface.show_dialog("Ren...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/Wakingup.png")
	await novel_interface.show_text_only("I force my eyes open, though everything is still blurry.")
	await novel_interface.show_dialog("Ren—", "Soya")
	await novel_interface.show_dialog("You're awake?", "Soya")
	await novel_interface.show_text_only("Sonya sounds agitated. Are those tears I see in her eyes?")
	await novel_interface.show_dialog("What happened...?", "Lian")
	await novel_interface.show_dialog("Urgh...", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("I feel something hard in my mouth. Something that's not supposed to be there. I spit it out reflexively.")
	novel_interface.show_background("res://assets/images/bg/Soya/Backseat.png")
	await novel_interface.show_text_only("I rub my eyes and find myself on the back seat of our SUV. What was it that I just spat out? I look down at my hand.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("What’s…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It's a transparent gem, the size of a marble. Looks just like the one Raphilia had handed me, though the color has faded.")
	await novel_interface.show_dialog("Wow! Up already?", "Driver")
	await novel_interface.show_dialog("Stay put, don't move! We really thought we lost you back there. No idea how we were gonna tell the boss.", "Driver")
	await novel_interface.show_dialog("And don't worry, we'll reach the hospital soon.", "Driver")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Hospital?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I try my best to recall what exactly happened. We were attacked, weren't we? And then—")
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("Are you okay? Does it hurt anywhere?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya asks, grabbing my hand tight. She sounds uncharacteristically concerned.")
	await novel_interface.show_text_only("She snaps her fingers by my ears to make sure I can still hear, then tells me to focus on her finger, which then draws a circle, to check the function of my eyes.")
	await novel_interface.show_text_only("I pat myself down and decide that it actually doesn't hurt much anywhere.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Was I... struck by a bolt of lightening?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ugh, it was an electrical weapon. That was lucky. I was so worried.", "Ai")
	await novel_interface.show_text_only("I hear Aya exhale from inside the earpiece.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Lucky?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Oh, you don't know?", "Ai")
	await novel_interface.show_dialog("The whole outfit you're wearing today... the dress, the stockings and shoes... they're made with composite materials with conductive carbon fiber.", "Ai")
	await novel_interface.show_dialog("It was to prevent you from being accidentally shocked by that anklet—", "Ai")
	await novel_interface.show_text_only("Wait, so these fishnet stockings that keep falling down are actually really valuable?")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Couldn't they have designed it to look less embarrassing?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("When you got hit by that arc, your outfit formed a Faraday cage by itself and conducted most of the power away from you.", "Ai")
	await novel_interface.show_dialog("Still, that weapon was pretty powerful and the outfit wasn't able to absorb it all. That's why you got knocked out anyway.", "Ai")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("So that's how Raphilia's gem is supposed be used... luckily I didn't force you to swallow it.", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("W-wait, what did you do to me when I was unconscious?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I don't have the least idea what a Faraday cage is, but... thank you, Faraday, my bro!")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Who were those guys anyway?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I glance at the rear window and notice blood splattered all over it.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("What the heck is going on?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Awkward silence. Then the driver finally speaks up.")
	await novel_interface.show_dialog("You're okay, that's what matters.", "Driver")
	await novel_interface.show_dialog("Ah, right. Aren't the results of the scan out already?", "Driver")
	await novel_interface.show_dialog("I already sent them to Ren's phone. More analysis is required, though.", "Ai")
	novel_interface.change_background("res://assets/images/bg/Soya/Ripple.png")
	await novel_interface.show_text_only("I immediately unlock my phone to see a bizarre image...")
	await novel_interface.show_dialog("What’s…", "Lian")
	await novel_interface.show_text_only("In a three-dimensional space, countless tiny cubes are woven together in twisted forms. They seem to carry a huge amount of information...")
	await novel_interface.show_text_only("Sonya leans over to see too.")
