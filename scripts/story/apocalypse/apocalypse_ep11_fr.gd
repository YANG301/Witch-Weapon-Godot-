# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Non, ces idiots, ce sont tous des hommes !", "Béatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sur le bras droit de Béatrice se trouve un bracelet en métal vert mousse, brillant doucement dans une teinte bleu clair.")
	await novel_interface.show_text_only("Une invention d'Aya. Fabriqué en alliage spécial qui bloque les effets de la substance mème H. Peut être utilisé pour supprimer les effets de la « malédiction » de Béatrice.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Attends, qu'est-ce que tu comptes faire...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Je me souviens que Mariru m'avait parlé de la « malédiction » il y a quelques semaines. Tout homme qui voit Béatrice tombera immédiatement éperdument amoureux d’elle.")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("Pour être exact, c’est son visage qui déclenche l’effet.", "Mariru")
	await novel_interface.show_dialog("Grâce à une série de tests menés par Aya, ils ont découvert que regarder directement le visage de Béatrice stimule fortement le gyrus fusiforme et l’amygdale du cerveau masculin.", "Mariru")
	await novel_interface.show_dialog("Cependant, ce n’est efficace que si la cible la regarde directement dans un rayon de 260 pieds. Les photos, vidéos ou reflets n’ont pas un tel effet.", "Mariru")
	await novel_interface.show_dialog("Après que cette stimulation soit active pendant un certain temps, le cerveau de la personne affectée subira des changements irréversibles. Cela changera fondamentalement leur façon d’agir.", "Mariru")
	await novel_interface.show_dialog("Ils veulent désespérément s'approprier Béatrice. Mais comme ils ne le peuvent pas, ils deviennent anxieux, irritables et pleins de ressentiment. Cela peut même conduire à l’automutilation, à un incendie criminel ou à des tendances violentes.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Comme c'est triste, hein ? Un amour non partagé...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pousse un soupir.")
	await novel_interface.show_text_only("J'ouvre la bouche pour demander comment exactement Aya a mené cette horrible expérience, mais je la referme. C'est mieux si je reste ignorant.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Heureusement, je n'étais pas l'un de ses sujets de test...)", "Lian")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Attendez ! Quand tu m'as fait expliquer des trucs à Béatrice seule dans « cette tenue » hier...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Était-ce aussi une expérience d’Aya ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Vous ne vous en êtes rendu compte que maintenant ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors c'était le cas ?")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hmm, alors vous n'avez probablement pas encore réalisé que le bracelet que Béatrice portait hier était faux, hein ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("» plaisante Mariru, l'air légèrement déçue par mon manque de capacités d'observation.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("La raison pour laquelle je t'ai fait porter cette tenue était pour empêcher tes pensées subjectives de gâcher nos résultats de tests. La « gêne » que vous ressentiez annulerait effectivement vos « désirs ».", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Et…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle tend la main et pose ses deux mains sur mes épaules. Sur son visage se trouve un subtil sourire narquois.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Tu étais plutôt belle dans une tenue de lapin playboy !", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aaaaaaaaaa !\nNe pouvons-nous pas arrêter d’en parler ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai passé cette heure infernale en tenue de lapin playboy, seule avec Béatrice, dans une pièce fermée.")
	await novel_interface.show_text_only("J'étais tellement nerveux que je pouvais à peine prononcer une phrase entière. Je ne pouvais même pas marcher correctement.")
	await novel_interface.show_text_only("Et Béatrice a passé l’heure à me réconforter, même si elle était sur le point d’éclater de rire, j’en suis sûr.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aya a dit que les images scannées en 3D de votre cerveau étaient alors comme un feu d'artifice. Elle a vraiment apprécié ça, elle l’aurait laissé durer beaucoup plus longtemps si votre pression cérébrale n’avait pas été un peu élevée.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quoi qu’il en soit, nous savons maintenant que, même si votre cerveau réagit à la malédiction de Béatrice comme celui de n’importe quel homme normal, aucun traumatisme ne sera laissé pour compte.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("D’un autre côté, d’autres hommes souffriront de lésions cérébrales permanentes après avoir regardé le visage de Béatrice pendant un certain temps. La période varie de quarante secondes à huit minutes.", "Mariru")
	await novel_interface.show_dialog("Donc tu es en sécurité. N'êtes-vous pas soulagé ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Je ne suis certainement pas soulagé !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ah, c'est un autre de mes souvenirs que j'aimerais pouvoir effacer.")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Alors... si elle enlève son bracelet ici...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Béatrice me sourit gentiment, puis me serre dans ses bras.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Tout devient sombre devant moi alors que mon visage est écrasé contre sa poitrine.")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.show_dialog("Je dirai « allez-y ». Après cela, vous disposez de trente secondes.", "Béatrice")
	await novel_interface.show_dialog("Attrapez Elluka, et nous nous séparerons et nous retrouverons à Newell Central Park. Là, il y a moins de manifestants.", "Béatrice")
	await novel_interface.show_dialog("Compris ?", "Béatrice")
	await novel_interface.show_text_only("J'acquiesce, faisant de mon mieux pour ne pas penser à la douceur de ma poitrine sur mon visage.")
	await novel_interface.show_dialog("Hé, je veux aussi un tour !", "Soya")
	await novel_interface.show_text_only("\"Cliquez\"")
	await novel_interface.show_text_only("Le fermoir du bracelet s'ouvre. La malédiction est désormais en vigueur.")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("Aux yeux de Sonya, Electronics Street est désormais un monde rose.")
	await novel_interface.show_text_only("Le même genre de rose qu’elle avait vu envelopper certains livres au contenu explicite lorsqu’ils faisaient leurs courses à la librairie cet après-midi.")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Toi aussi tu es une sorcière ?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ah. Vous pouvez le dire ?", "Béatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("Mais tu n'es pas comme Elluka ou Raphilia...", "Soya")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("Comme Ren, vous avez une aura aussi pure que celle d’un bébé !", "Soya")
	await novel_interface.show_dialog("... C'est fascinant !", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("S'exclame Sonya en secouant mes épaules avec enthousiasme.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Wahhhhh !\n(Arrêtez ça ! Je ne peux pas respirer !)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Vous semblez peser moins que dans mes souvenirs.\nN'es-tu pas mignonne ?", "Béatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La dame aux gros seins serre Ren encore plus fort.")
	await novel_interface.show_text_only("Pendant ce temps, Ren se débat désespérément, essayant d'échapper à son étreinte suffocante.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("... Bref, qui es-tu ?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Oups, j'ai oublié de me présenter.\nJe m'appelle Béatrice Portinari.", "Béatrice")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<il y a 90 minutes>")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Zone démilitarisée agréée, nouvel hôtel Opulentia Stork Garden>")
	await novel_interface.show_text_only("<À l’extérieur de Birdsong Hall, la salle de banquet au dernier étage>")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Whoa, ils ont un jardin ici au 99ème étage. Les gens de Hovering Palace apprécient-ils tout le temps un luxe comme celui-ci ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru examine les toits de verre, avec un sourire narquois sans enthousiasme.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Peut-être que plus le jardin est haut, plus il semble luxueux ? Ou peut-être que 99 est le numéro porte-bonheur du propriétaire ?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille blonde se gratte la tête, confuse.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Comment avez-vous décidé que cette vente aux enchères était ce que nous recherchions de toute façon ?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru fixe son regard sur le panneau d'affichage peint à la bombe à l'entrée de la salle de banquet.")
	await novel_interface.show_text_only("Sur celui-ci figure le titre « Johnson’s Museum Autumn Auction »,\nsuivi du sous-titre : où l'art rencontre la finance.")
	await novel_interface.show_text_only("Le texte blanc semble particulièrement choquant sur le fond bleu. Rien d'artistique là-dedans.")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("Est-ce vraiment une vente aux enchères d’œuvres d’art ? Cela ne me semble pas très esthétique.", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hoche la tête et sourit.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Mais les cinq cents sièges sont pourvus. Sur les soixante-trois pièces, soixante ont déjà été vendues.", "Mariru")
	await novel_interface.show_dialog("Au total, 1,5 milliard ont été réalisés.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("C'est autant ? Cette vente aux enchères doit donc être énorme.\nMais je n'en ai rien entendu...", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Les comptes cryptés électroniquement que vous nous avez signalés contiennent des fonds valant des milliards.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("C’est beaucoup, mais juste assez pour construire deux gratte-ciel de ce type.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Pour utiliser cette somme d’argent afin d’avoir un impact sur les milliers de milliards de fonds de reconstruction que possède le Congrès américain, il ne devrait y avoir qu’un seul moyen…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Corruption ? C’est pourquoi ils ont choisi la monnaie cryptée ?", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Les comptes peuvent être cryptés, mais toutes les transactions effectuées peuvent être vues par tous les utilisateurs du réseau. Et une transaction de cette taille : il est impossible que les gens ne la remarquent pas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("C'est pourquoi ils ont besoin d'une raison réalisable pour la transaction...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld penche la tête sur le côté, réfléchissant. Puis elle s'exclame :")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Oh, c'est pour ça qu'ils organisent une vente aux enchères !", "Skuld")
	await novel_interface.show_dialog("Les antiquités sans prix fixe sont une bonne excuse pour des transactions d'une valeur importante. Des objets comme de la porcelaine, du jade, des tableaux anciens... personne ne sourcillerait s'il voyait quelqu'un offrir des millions pour les acquérir.", "Skuld")
	await novel_interface.show_dialog("Et la transaction se déroule également sur le territoire international. Il est impossible pour les services fiscaux de différents pays de collecter des impôts.", "Skuld")
	await novel_interface.show_dialog("Tout ce dont ils ont besoin, c'est de contacter les deux parties et de vendre quelques cochonneries sous le nom d'un musée privé.", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Mais ils ne peuvent pas laisser entrer de vrais connaisseurs d’art, car ils seront en mesure de savoir d’un seul coup d’œil ce qui se passe.", "Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("C’est pour cela que toutes les places sont occupées !\nIls ont rempli les sièges avec leurs propres gens !", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru tapote la tête de Skuld avec approbation.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Très intelligent. Vous vous ennuyez probablement beaucoup à l’école, n’est-ce pas ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Qu'en pensez-vous ?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sourit à Mariru, l'air fier.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Alors, laissez-moi vous dire autre chose.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Les « fonds de reconstruction d’après-guerre » sont essentiellement des prêts accordés par le Congrès uni. Les gouvernements qui ont emprunté auprès d’eux doivent rembourser l’argent, sous peine de faire face à la colère des six grandes nations.", "Mariru")
	await novel_interface.show_dialog("Mais historiquement, aucun pays n’a jamais été en mesure de rembourser un prêt de cette ampleur dans les délais. C’est là qu’intervient la marge de négociation.", "Mariru")
	await novel_interface.show_dialog("Le Comité est extrêmement riche. Tout ce qu’ils veulent, c’est probablement le secteur le plus lucratif, par exemple les infrastructures de base comme l’électricité et les communications.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ils peuvent simplement faire une proposition aux chefs de gouvernement qui ont emprunté de l’argent : ils n’auront pas besoin de rembourser le montant emprunté tant qu’ils donneront en permanence au Comité 30 % des parts de leur réseau de télécommunications.", "Mariru")
	await novel_interface.show_dialog("Les gouvernements, incapables de rembourser les prêts, acceptent généralement. Certains dirigeants nationaux peuvent même demander activement des rabais en privé.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Alors, comment le Comité parvient-il à contrôler les « secteurs » qu’il souhaite ?", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Ils doivent convaincre le Congrès américain de laisser les sociétés multinationales détenir des fonds et disposer d’un certain degré d’autonomie…", "Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("C’est beaucoup demander. Seront-ils vraiment d’accord ?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Au lieu de répondre, Mariru pose simplement une autre question.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Cet art peint à la bombe ressemble à un enfant de maternelle. Qu'est-ce que ça vous dit ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Celui qui l’a fait n’a pas fait assez d’efforts pour cacher le fait que tout cela était faux.", "Skuld")
	await novel_interface.hide_character()
	
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Mais beaucoup d’argent est en jeu. Ils ont dû louer le dernier étage de l'hôtel et embaucher des centaines de personnes. Ils ont déjà dépensé beaucoup d’argent, alors pourquoi n’ont-ils pas dépensé beaucoup d’argent également pour les graphismes ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Eh bien…", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld fait la moue, déconcerté par toutes les nouvelles informations.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Eh bien, c’est parce que ce n’est pas nouveau pour eux. C’est déjà arrivé d’innombrables fois. Ici comme ailleurs.", "Mariru")
	await novel_interface.show_dialog("Personne ne les a jamais soupçonnés ni dénoncés. Ils ne prennent donc plus la peine de le cacher.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("La corruption est un art en soi, en particulier ce type de corruption sournoise. Ils doivent collecter une immense quantité d’informations et s’assurer que toutes les personnes impliquées sont satisfaites à tous les niveaux.", "Mariru")
	await novel_interface.show_dialog("De nombreuses enquêtes doivent être menées. D’innombrables personnes participent à l’opération. Les échanges d’avantages, comme celui que nous observons aujourd’hui, se sont produits à de nombreuses reprises.", "Mariru")
	await novel_interface.show_dialog("Ils devront négocier avec beaucoup de gens. Fonctionnaires, chaînes médiatiques, alliances de travailleurs, organisations non gouvernementales, même ceux qui occupent des positions élevées dans le crime organisé.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("C’est ainsi qu’ils influencent les décisions clés prises par le Congrès uni.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hoche la tête en direction de la porte fermée de la salle de banquet.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("C’est ce qui vaut le plus dans cette vente aux enchères.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld baisse la tête et soupire.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("C'est nul... c'est tellement malhonnête...", "Skuld")
	novel_interface.change_expression("talk")
	await novel_interface.show_dialog("Attends, c’était ce que tu prévoyais depuis le début ?", "Skuld")
	await novel_interface.show_dialog("Vous ne vouliez pas arrêter ces cerveaux qui manipulent le projet de reconstruction...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, la porte de la salle des banquets s'ouvre par un petit craquement. Fabella leur tend la main et leur fait signe OK.")
	await novel_interface.show_text_only("C’est le signal que tous les articles ont été vendus et que la transaction entre les comptes électroniquement cryptés est sur le point d’avoir lieu.")
	await novel_interface.show_text_only("Mariru prend son talkie-walkie.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Équipe de récupération, bloquez toutes les entrées du 99ème étage, y compris la cage d'ascenseur. Alertez l'hôtel qu'une forte dose de substances polluantes radioactives a été détectée au 98ème étage.", "Mariru")
	await novel_interface.show_dialog("Coupez tous les signaux réseau et moyens de communication dans le bâtiment. Une fois que je dis allez-y, imposez le silence radio.", "Mariru")
	novel_interface.change_expression("angry")
