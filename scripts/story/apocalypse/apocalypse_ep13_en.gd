	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I gulp, realizing that I’m a girl now and shouldn’t have apologized. The blond guy look up in confusion, while Sonya simply smirks knowingly.")#文字错误
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Oh?", "Soya")
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Dang, did I give my identity away?)", "Lian")
	novel_interface.show_character("soya_uniform", "relieve")
	await novel_interface.show_dialog("Ah, whatever, I can carry her. I’m strong.", "Soya")
	await novel_interface.show_dialog("I’m not useless like a certain someone...\nWho fell head over heels for a pretty lady... even got a nosebleed...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Oops, she totally saw my embarrassing episode!")
	await novel_interface.show_text_only("And... nosebleed? I got a nosebleed?")
	
	# 贝阿特丽切出现
	novel_interface.show_character("beatrice_regular", "smile1")
	await novel_interface.show_dialog("Fell head over heels, huh?", "Female Voice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice pipes up, emerging from the shadows behind us.")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("You made it here pretty quickly.", "Beatrice")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("When did you arrive?", "Lian")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Hey, you’re a bit too good at concealing your aura...", "Soya")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("I’m used to that sort of thing.\nGotta hide myself well if I don’t want men to see me, right?", "Beatrice")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Shh, stay down.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice suddenly pulls us into the shadows. Seconds later, an armored truck speeds by, flying right past us.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Lots of military vehicles pass by the area. Let’s go somewhere else.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# 进入公园主干道
	novel_interface.show_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("We arrive on the main pedestrian path in Newell Central Park. Sonya gently lowers the slumbering Elluka onto a bench.")
	await novel_interface.show_text_only("While we don’t see anyone nearby, we can hear kids and dogs playing in a distance. It makes me feel much safer.")
	await novel_interface.show_text_only("Beatrice studies the kind boy who led us away from the fiasco.")
	novel_interface.show_character("beatrice_regular", "normal")
	await novel_interface.show_dialog("Who’s this?", "Beatrice")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Oh, sorry, forgot to introduce myself...", "Boy with Glasses")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond youth seems (understandably) nervous in front of Beatrice, like he doesn’t know where to direct his gaze.")
	await novel_interface.show_text_only("At her face? At the impressive breasts underneath? Eventually, he has to turn away and just choose to not look at all.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Bro, I totally get how it feels!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I just didn’t realize turning away would make it even more obvious that I’m interested...")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Guess I need to be more careful in the future...)", "Lian")
	novel_interface.show_character("john", "worry")
	await novel_interface.show_dialog("I’m John. I work part-time in a shop on Electronics Street.", "Boy with Glasses")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("John? What a nondescript name.", "Soya")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Yeah, it’s... quite common...", "John")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("John pushes up his glasses awkwardly.")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("S-sorry... I saw you yelling at people on top of your truck... I thought it was so cool, so I...", "John")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("You what?", "Beatrice")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Filmed you...", "John")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("You totally want to watch it on repeat at home, eh?", "Soya")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(I understand how you’re feeling, buddy, but you can’t just own up to doing stuff like that!)", "Lian")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("I... I accidentally filmed the truck nearby too. That was why I saw you guys... so when I noticed people chasing after you, I had to man up and help...", "John")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("John sneaks a glance at me, face beet red, voice decreasing in volume.")
	novel_interface.show_character("ren_fishnet", "speechless")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I remember back when I still played those MMOs. I chose to play a female character just for the heck of it. A guy in my guild ended up confessing his feelings to me, stammering all the way.")
	await novel_interface.show_text_only("Dude, gamers who play female characters are not necessarily girls!")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Poor dude... he must have been devastated...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice moves to John’s side and says gently:")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Of course. You’re a gentleman. A gentleman always mans up when he sees pretty girls in trouble, right?", "Beatrice")
	novel_interface.show_character("john", "perspire")
	await novel_interface.show_dialog("I’m... I’m so sorry... I’ll delete the video! And I’ll pay the store for the smashed billboard too...", "John")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("John keeps bowing as he apologizes. Definitely born and bred in New Opulentia. People here have no backbone.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("Very polite, isn’t he?", "Soya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet", "stare", 0.25)
	await novel_interface.show_dialog("If only you were more like him...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Still, it’s hard to imagine that this timid boy is the same as the one who resolutely smashed an illuminated billboard to ward off Elluka’s fanclub.")
	await novel_interface.show_text_only("The ground, covered with glass shards. The short-circuited wires, fizzling with electricity. Left quite an impression on me.")
	novel_interface.show_character("ren_fishnet", "bored")
	await novel_interface.show_dialog("(He probably didn’t realize how big a commotion he’d cause, eh?)", "Lian")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("It’s all right.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice pats the young man on his shoulder.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("I’ve been bottling those feelings inside for years. It felt really good to finally scream it all out for the first time!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("So it was her first time? She’s a natural!")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("I should do this more often in the future!", "Beatrice")
	novel_interface.show_character("ren_fishnet", "sprite")
	await novel_interface.show_dialog("(That’ll just cause more riots!)", "Lian")
	novel_interface.show_character("beatrice_regular", "smile3")
	await novel_interface.show_dialog("Oh, right...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice moves to my side, wrapping an arm around my waist.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("You were walking a bit weird. You hurt your waist?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She presses her fingers on my skin, only lightly, but the pain brings tears into my eyes.")
	await novel_interface.show_text_only("I instinctively try to shift away, but falls into Beatrice’s lap instead. The lady pats my head fondly.")
	novel_interface.show_character("beatrice_regular", "sad")
	await novel_interface.show_dialog("You might have twisted something. Gotta fix it before it gets worse.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She looks down at her hands.")
	novel_interface.show_character("beatrice_regular", "sad")
	await novel_interface.show_dialog("Hmm, no bleeding.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("The headquarters are a bit far. Should I bring you to a nearby hospital?", "Beatrice")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("I’m kinda on the run though... the hospital might contact the security soldiers...", "Lian")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("If it’s just a sprain, Mother Elgana might be able to help.", "Soya")
	novel_interface.show_character("beatrice_regular", "normal")
	await novel_interface.show_dialog("Elgana?", "Beatrice")
	novel_interface.show_character("john", "worry")
	await novel_interface.show_dialog("On the run...? Mother?", "John")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("John listens on, expression confounded.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("I knew her back from when I was in the Abbey. She got appointed to a newly-built church in New Opulentia only last week. It’s pretty close.", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("She used to prescribe medicine for the CDF and the Penitentiary. Her drugs are much more effective against muscle and tendon injuries than the ones you get in the hospital.", "Soya")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("So she’s a really skilled doctor? Let’s go, then!", "John")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice glances meaningfully at John, who seems even more worried than I am.")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("I... I mean...\nI’ll come with you...", "John")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Someone seems to care about you an awful lot, bunny...", "Beatrice")
	novel_interface.show_character("ren_fishnet", "awkward")
	await novel_interface.show_dialog("Aaaahh! Leave the bunny outfit out of this!", "Lian")
	novel_interface.show_character("soya_uniform", "laugh")
	await novel_interface.show_dialog("What bunny outfit?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya leans in, looking annoyingly eager.")
	novel_interface.show_character("ren_fishnet", "shy_left")
	await novel_interface.show_dialog("Nothing! Nothing whatsoever!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice clears her throat and summarizes her decision, face serious.")
	novel_interface.show_character("beatrice_regular", "smile2")
	await novel_interface.show_dialog("Let’s head to the church, then. I’ll send a car over too. If Mother Elgana can’t fix your waist, we’ll bring you back to the headquarters.", "Beatrice")
	novel_interface.show_character("ren_fishnet", "normal1")
	await novel_interface.show_dialog("Sounds good.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She then dials a number.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Hey, laundromat, right?\nI need transportation...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("After Beatrice has everything set up, Sonya picks Elluka up onto her back once more.")
	await novel_interface.show_text_only("The church she mentioned is indeed quite close, only a ten-minute walk from the park.")
	
	# 到达教堂
	novel_interface.show_background("res://assets/images/bg/Soya/Church_N.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_fishnet", "happy")
	await novel_interface.show_dialog("Wow, it’s enormous!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The church is a brown-colored stone building, its outer walls covered by a massive religious mural.")
	await novel_interface.show_text_only("In the center of the plaza sits a small fountain. Traces of waterproof strips can still be found on the marble. The construction must have finished not long ago.")
	await novel_interface.show_text_only("The cross on the roof extends upward into the dark night sky. The impressive gate seems especially glorious under the lighting.")
	novel_interface.show_character("beatrice_regular", "normal")
	await novel_interface.show_dialog("…", "Beatrice")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("The gate is shining... is it made of gold?", "Lian")
	novel_interface.show_character("soya_uniform", "smile")
