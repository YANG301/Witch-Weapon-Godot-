# apocalypse_ep13.gd - 天启篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第13话剧本
	apocalypse_ep13_script()

func play_script():
	pass

# 天启篇第13话 - 正式剧本
func apocalypse_ep13_script():
	# 开场序章 - 关于疼痛的感受
	novel_interface.show_background("res://assets/images/bg/Soya/Hypnosis2.png")
	await novel_interface.show_text_only("Perhaps you’ve heard stories like this before...")
	await novel_interface.show_text_only("A soldier only notices that he’s already seriously injured, entrails all over the ground, after the battle is over. Before that, he didn’t feel a thing.")
	await novel_interface.show_text_only("A hiker only feels pain in his fingers after he looks down and realizes they’re frozen. Before that, he didn’t feel a thing.")
	await novel_interface.show_text_only("Some hypnotism experts can even temporarily “shut down” their target’s ability to sense pain.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Because pain, after all, is subjective.")
	# 场景转移到小巷
	novel_interface.show_background("res://assets/images/bg/Soya/Dark_alley.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("The bespectacled guy is, true to his word, quite familiar with the area.")
	await novel_interface.show_text_only("He leads us into a restaurant concealed in an alley, greets the shopkeeper, and brings us through the kitchen to the back door.")
	await novel_interface.show_text_only("We then wind through a few more dark, narrow alleys, finally managing to shake off the persistent fanclub members.")
	await novel_interface.show_text_only("The alleys are lined by shabby walls, with air-conditioner fans mounted on them. Alongside the path are garbage cans and vending machines that look like they haven’t seen any action in a while.")
	await novel_interface.show_text_only("I didn’t know there was a whole maze of decrepit alleys behind the bright Electronics Street.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Minutes later, we pass through a barb wire fence to arrive on a main road.")
	
	# 到达新井中心公园外
	novel_interface.show_background("res://assets/images/bg/Soya/Night_Park_Out.png")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("That’s where you’re headed, right? Newell Central Park?", "Boy with Glasses")
	novel_interface.show_character("ren_fishnet", "happy")
	await novel_interface.show_dialog("Wow, we’re here already?\nI thought it’d take longer judging from the stupid map on my phone...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look around. The gigantic dome-shaped gate across the street, decorated with colorful lights, is indeed the east gate to Newell Central Park.")
	await novel_interface.show_text_only("The street, devoid of residences and shops, is quiet and a bit desolate. Our footsteps are audible as we head down the street.")
	await novel_interface.show_text_only("In the air is the fizzling electricity from the street lamps, and for some reason a faint coppery smell of blood.")
	novel_interface.show_character("ren_fishnet", "gratified")
	await novel_interface.show_dialog("Hurry, Beatrice is probably waiting!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya, who’s carrying a sleeping Elluka, starts complaining.")
	novel_interface.show_character("soya_uniform", "cry")
	await novel_interface.show_dialog("This kid weighs a ton!", "Soya")
	await novel_interface.show_dialog("Shouldn’t a real gentleman have offered his help already?", "Soya")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("S-sorry...", "Lian")
