# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("那片平和的金紅色光芒，\n位於中央，燦爛輝煌，")
	await novel_interface.show_text_only("而四面八方的光焰則一概減弱光亮。")
	await novel_interface.show_text_only("我看見正是在那中央，\n有一千多位歡樂喜慶的天使在展翅飛翔，")
	await novel_interface.show_text_only("它們各有各的技藝和亮光……")
	await novel_interface.show_text_only("──《神曲》天堂篇-XXXI")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("莉琉用手指玩弄著那張照片，同時仔細觀察著面前的這位頭髮花白的男人。")
	await novel_interface.show_text_only("關於他的情報十分有限，就連倫伯特（Lambot）這個沒有姓氏的名字是不是真名也沒人知道。")
	await novel_interface.show_text_only("但他因對「和平事業的傑出貢獻」而以這個名字獲得勛章，卻是不爭的事實。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("（既然有秋子的確認，應該是個可以談判的對象。）", "莉琉")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("絕大多數的人認為，所謂聯合議會，是因為各國元首齊聚在此，所以才成為世界的權力中樞。", "莉琉")
	await novel_interface.show_dialog("歷史上確實有過那種機構，只不過組織鬆散而且各成員國之間爭吵不休，主席反而成了和事佬兼要飯的。", "莉琉")
	await novel_interface.show_dialog("然而，聯合議會的預算規模和影響力與之前那些機構完全不可同日而語。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉收起照片，嚴肅地說道。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("利益產生信任，信任產生權力，而權力透過對資源的協調與分配，又能產生更大的利益──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特的眉頭上揚。")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("這是沃克爾的基礎社會模型。", "倫伯特")
	await novel_interface.show_dialog("由利益團體選出政治人物，成為承載民眾信任的代理人。", "倫伯特")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("一旦代理人無法維持和製造更大的利益，就會被剝奪權力並由他人替換。", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("雖然從宏觀的歷史角度上看確實如此，但民眾從來都不是理性的，正如勒朋所說──", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("群體追求和相信的從來不是什麼真相和理性，而是盲從、殘忍、偏執和狂熱，只知道簡單極端的感情。", "倫伯特")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特自言自語地接話，莉琉微笑著點了點頭。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("有太多手段可以繞過利益這個環節，直接取得民眾信任。", "莉琉")
	await novel_interface.show_dialog("這種領袖也從不害怕以巨大的犧牲為代價，成就自己的豐功偉業──", "莉琉")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("但在七年戰爭後，那些真正維持著人們生活和國家運轉的人開始反思。", "莉琉")
	await novel_interface.show_dialog("最終由那些人成立了「聯合議會」這種與「利益相關方」直接進行協作與博弈的組織。", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("所以真相是：能進入聯合議會的人，才有資格成為國家元首。", "莉琉")
	await novel_interface.show_dialog("而這個組織的第一次行動，是在三年前──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉停頓了片刻，倫伯特盯著她，屏住了呼吸。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("三年前，聯合議會和教廷在南美祕密測試EX級異質物。受到強力施壓的當地軍閥也只能乖乖配合。", "莉琉")
	await novel_interface.show_dialog("不過試驗卻失控了，還造成了4.6萬人死亡。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("那次事件後來被包裝成「丘倫河大屠殺」，並嫁禍給當時唯一沒有配合你們的軍閥──卡洛斯·布蘭科。", "莉琉")
	await novel_interface.show_dialog("這個慘案受到世界各大媒體關注和不斷報導，民眾的厭戰情緒就在那次事件中一口氣爆發。", "莉琉")
	await novel_interface.show_dialog("以聯合軍事行動處決那個軍閥，也成為了聯合議會合法性的重要基礎之一。", "莉琉")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("但是在試驗現場，那數萬具屍體以教堂為中心呈放射狀的排列，實在太不自然了……", "莉琉")
	await novel_interface.show_dialog("我猜，為了掩飾真相，你們在那裡投放了能干擾半徑三公里內所有電磁波的異質物武器。", "莉琉")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("類似的異常狀況曾在西亞戰場上出現過，因為光也是一種電磁波，導致連衛星都無法拍出正常畫面。", "莉琉")
	await novel_interface.show_dialog("這就是為什麼那扇門被關閉後，整個區域的電磁干擾卻依然持續了幾週。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉故意強調了「那扇門」三個字的語氣，聽到這裡，倫伯特默默閉上了眼睛。")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("莉琉端詳著手中的照片。")
	await novel_interface.show_dialog("清理那麼多屍體需要大量的工作人員，很難完全控管。", "莉琉")
	await novel_interface.show_dialog("我猜，你萬萬也想不到，現場有人用傳統相機和已經發霉的底片拍下了這張照片。", "莉琉")
	await novel_interface.show_dialog("而照片中異常模糊的遠景，就是異質物武器扭曲光線的效果造成的。", "莉琉")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("妳又知道我有參與其中了？", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("一個月前，你被任命為聯合議會「禁止異質物武器試驗條約組織」的執行祕書長。", "莉琉")
	await novel_interface.show_dialog("這個組織表面上禁止任何人進行異質物武器試驗，因此擁有非常可觀的資源和情報能力。", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("你不可能對這種規模的事件毫不知情，之所以選擇沉默，是因為那次試驗就是由你主導的──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特並沒有表示反駁，莉琉乘勝追擊。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("最後由教廷出面回收那個異質物，他們事後也因此得到了聯合議會超乎尋常的資助和授權。", "莉琉")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("那個異質物，是一扇半開的漆黑大門，門後面閃爍著刺眼的金色光芒──", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("夠了！不用說了。", "倫伯特")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特打斷莉琉，舉起雙手表示認輸。")
	await novel_interface.show_text_only("他用手整理了西裝領口，稍稍調整了一下嗓音。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("我們的工作，的確是為了確保沒有人可以隨意進行異質物武器試驗。", "倫伯特")
	await novel_interface.show_dialog("因為異質物太過危險，一個不小心就會導致文明毀滅，但是那次試驗非進行不可。", "倫伯特")
	await novel_interface.show_dialog("那扇門背後傳來的敲門聲一次比一次急促，而門早晚都會被打開──", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("……敲門聲？", "莉琉")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("「天堂之門」……", "倫伯特")
	await novel_interface.show_dialog("每個宗教和神話體系都有自己定義的天堂，或許那些定義都系出同源。", "倫伯特")
	await novel_interface.show_dialog("根據歷史記載，在那扇門被打開之前，門後會傳來「咚咚咚──」連續三下的敲門聲。", "倫伯特")
	await novel_interface.show_dialog("據說那聲音低沉深邃，像是敲進了聽見的人的靈魂……", "倫伯特")
	await novel_interface.show_dialog("敲門聲開始出現時，最初是隔一週會再出現，接著間隔時間會越來越短。", "倫伯特")
	await novel_interface.show_dialog("間隔時間不到90秒時，門就隨時可能被打開──", "倫伯特")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("隨便妳怎麼定義門後的存在，但它擁有能造成世界末日級災難的能力，這一點是無庸置疑的。", "倫伯特")
	await novel_interface.show_dialog("比如超大型洪水嗎？", "莉琉")
	await novel_interface.show_dialog("在教廷的文獻中，唯一能壓制「門」的辦法，就是要在以門為中心的小範圍內聚集數萬人……", "倫伯特")
	await novel_interface.show_dialog("像獻祭那樣？", "莉琉")
	await novel_interface.show_text_only("倫伯特並沒有直接承認這種說法，接著說。")
	await novel_interface.show_dialog("這種事每幾百年就會發生一次，每次的死者都會以門為中心呈放射狀排列。", "倫伯特")
	await novel_interface.show_dialog("這種儀式大多是祕密進行，但因為間隔時間太久，偶爾還是會被特定時代的人利用──", "倫伯特")
	await novel_interface.show_dialog("比如1572年，發生在巴黎的聖巴多羅買大屠殺。", "倫伯特")
	await novel_interface.show_dialog("聖巴多羅買紀念日前一夜，發生了被稱為「數世紀以來最可怕的宗教屠殺」，死亡人數多達7萬。", "倫伯特")
	await novel_interface.show_dialog("巴黎……", "莉琉")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("以門為中心呈放射狀排列！？", "莉琉")
	await novel_interface.show_text_only("莉琉忽然想到那座城市最有名的觀光景點。")
	await novel_interface.show_dialog("應該算是歷史開的一個玩笑吧～", "倫伯特")
	await novel_interface.show_text_only("倫伯特聲音中帶著一絲戲謔。")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("既然是可以被敲響的門，就應該是有形的物質，為什麼不直接毀了它或用火箭送出太陽系呢？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("「天堂之門」只是一個概念，一開始每次出現的位置都不一樣。", "倫伯特")
	await novel_interface.show_dialog("就算在沒有門的地方，那扇門甚至能直接出現在古城牆的牆面上。", "倫伯特")
	await novel_interface.show_dialog("雖然會帶來災厄，但也是最能顯現神蹟的聖物。", "倫伯特")
	await novel_interface.show_dialog("歷史上各個宗教勢力對這個概念歸屬權的爭奪從沒停過……", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("概念要怎麼爭奪？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("歷史記載中，聖索菲亞大教堂擁有天堂之門最長的歸屬權。", "倫伯特")
	await novel_interface.show_dialog("15世紀佛羅倫斯的雕塑家吉貝爾蒂，用畢生精力創作的作品將那個「概念」搶了過來。", "倫伯特")
	await novel_interface.show_dialog("1452年，那件作品成了佛羅倫斯聖若翰洗者洗禮堂的大門，也就是後人眼中的天堂之門。", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("原來是這樣──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("人類爭奪某個概念最古老的辦法，就是用最奢華宏偉的作品自我證明。")
	await novel_interface.show_text_only("無論金字塔、神廟、宮殿、皇冠或是王座。")
	await novel_interface.show_text_only("為的都是證明自己的正統，證明自己是最被認可的存在。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("等一下，那作品完成的第二年，聖索菲亞大教堂所在的君士坦丁堡就被攻占了，難道是因為……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特搖了搖頭。")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("那段歷史是一團謎，並沒有直接的證據。", "倫伯特")
	await novel_interface.show_dialog("然而確定的是，吉貝爾蒂的作品在七年戰爭中被毀了……", "倫伯特")
	await novel_interface.show_dialog("想要準確控制那扇門出現的位置，並確保它下次是在可控制區域內打開的話──", "倫伯特")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("就只能聯合教廷製造一個複製品。", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("但是試驗出了差錯，不知為何門並沒有順利關閉，所以教廷才會如此不惜代價……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉終於將零散的線索完整地拼湊起來，每一方的行為都有了合理的理由。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("那之後一系列的情報釋出和媒體報導都是大師級的操作，選擇的替死鬼也堪稱完美……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("聽到莉琉的自言自語，倫伯特無奈地笑了笑。")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("我該說妳過獎了嗎？", "倫伯特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("不，如果有一天人類不得不面對那種強大力量的話──", "莉琉")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("懷抱著道德底線自欺欺人，用無知來安慰自己是最愚蠢的。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("但人類就是這麼脆弱的生物，寧可為了安全感而放棄安全。", "倫伯特")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉的嘴角挑起，提高了聲調。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("所以說，「道德」終究是有價值的。", "莉琉")
	await novel_interface.show_dialog("掩蓋試驗的真相也是你分內的工作，但現在真相在我手裡──", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("確實如此，妳有什麼條件，說出來看看吧。", "倫伯特")
	await novel_interface.show_dialog("雖然我不過是個代理人，連那一系列決定是聯合議會的哪位做出的都不知道。", "倫伯特")
	await novel_interface.hide_character()
	
	# Scene 4 - 交易谈判
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("放心，我開的條件不會超出你的能力範圍。", "莉琉")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("我的條件是，第三學園都市，施恩內曼總理的繼任者，不能是軍方的人。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倫伯特顯然對這個要求感到意外。")
