# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("ベアトリーチェはマイクを持ち、片方の足で\nサイドレールを踏む。")
	await novel_interface.show_text_only("彼女の解き放った怒声に近い言葉が、\nオーディオを通して電気街全体を貫く。")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("さあ、愛しきクズども────", "ベアトリーチェ")
	await novel_interface.show_dialog("──正真正銘の変態達よ、覚悟なさいッ！！！！", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("はっ？", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("おやまぁ……？", "ソヤ")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（ちゅ、注意を引くために言ってるんだよな？）", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ベアトリーチェの爆弾発言が狙い通り、\n人々の目線を惹き付けた。")
	await novel_interface.show_text_only("パレードカーの下で口をあんぐり開けながら\nベアトリーチェを見る男達。\n赤いハイヒールの靴底、揺れるスカートの影……\n何か妄想している男達を彼女は見下した──")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("あんた達はいつもそう！！\n\n可愛い子を見ていたと思ったらすぅ～～ぐ\nこっちを向きやがって！！貞操概念はないの！？\n\n多情で、移り気で、飽き性で、すぐ嫁だの\n何だの言いやがって──", "ベアトリーチェ")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("──そんな気持ちで殺された身にも\nなりなさいよッ！！！ \n中途半端で恥ずかしくないのッ！？！？", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("（な、なんか積年の恨みを爆発させているだけ\n　のように聞こえるんだけど……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("大勢が彼女に注意を奪われ、他のパレードカーで\nパフォーマンスをしていたマスコット達すら、\n完全に動きを止めた。")
	await novel_interface.show_text_only("隙を見て俺とソヤは中に入り込む。\n\nパレードカーに備え付けてある階段を登って、\nイルカの近くまで辿り着いた。")
	await novel_interface.show_text_only("一番上の神輿に座っているイルカは、\n満足げにポッコリお腹を撫でていた。\n目の前には空き皿がズラリと並んでいる。")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("あれ全部……イルカが食べたのか！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は周囲を見渡しながら、あの食いしん坊を\nどうやってバレずに連れ戻そうか考える。\nしかし、イルカが何やら不穏な動きを……")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("レンお姉ちゃ～～んっ！！", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こっちに気付いたみたいだ。\n\n俺は顔を向け「シーッ！」とジェスチャーを\nしようとする──")
	await novel_interface.show_text_only("だが、彼女はすでに高く飛び上がっており──\n\n手足を広げて空から俺の顔に向かって\n落ちてくる……")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("そうだった。初めてイルカに出会った時、\nドールと空中で戦っていたっけ。")
	await novel_interface.show_text_only("愛衣が彼女の身体を検査した結果、骨年齢は\n11歳から12歳くらい。\n大幅な機械改造を受けている事が判明した。")
	await novel_interface.show_text_only("また何回も記憶を削除されており、いつ左目が\n軍用電子義眼に変えられたのかも覚えていない。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("最後に――\n\n彼女は電磁場を利用して宙に浮かぶ事ができるが\n実際の体重は俺の2倍もあり……")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("バキッーーボキボキッーーーー")
	await novel_interface.show_text_only("イルカが空中から落ちてくる。\n\n両足で俺の腰を挟み、膨らんだお腹を俺の顔に\nくっ付けて、両手で俺の首を強く抱きしめた。")
	await novel_interface.show_text_only("瞬時に俺の頸椎、腰椎と肩部に巨大な圧力が\n襲いかかる。")
	await novel_interface.show_text_only("彼女は全身で俺の胸と頭を包みこんで、\n嬉しそうに頭の上で頬ずりをしている。")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("えへへ、レンお姉ちゃん大好きぃ～～\n──けっぷ。", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("真っ赤な顔のイルカは、声をこもらせて話す。\nまるで酔っぱらっているみたいだ。")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("あなたの骨から……変な音が鳴りましたわよ？", "ソヤ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("…………………………", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……硬直して動けない俺。\n\n今は絶妙なバランスを保っているが、不用意に\n動くとダメージを受けた骨が逝くと思う。")
	await novel_interface.show_text_only("一連の出来事は何人かの注意を引いてしまった\nようで──\n俺達の方に向けて「何だあれ？」って\n声が聞こえた。")
	await novel_interface.show_text_only("網タイツを穿いた巨大な青い頭の怪物がいたら、\nそりゃ「何だあれ？」だろう。")
	await novel_interface.show_text_only("状況に気付いたベアトリーチェが声のトーンを\n上げてくれる。\n俺達の撤退時間を稼ぐ最後のひと押しだ。")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("思慮深いフリして、私利私欲ばかりッ！\n汚い妄想だらけッ！\nゴミッ！ クズッ！ 豚ッ！ 変態ッ！！！", "ベアトリーチェ")
	await novel_interface.show_dialog("そんなあんた達は全員────", "ベアトリーチェ")
	await novel_interface.show_dialog("──地獄に落ちなさいッッ！！！！", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("渾身の罵倒が最高潮に達すると、\n2台の大出力スピーカーも耐え切れなくなり、\n甲高いノイズを発生させた。")
	await novel_interface.show_text_only("遂にはスピーカー正面のネオン看板のライトが\n「パンっ！ パンっ！」と音を立てて破裂する。")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("電気街全体が不気味な静寂に包まれた──")
	await novel_interface.show_text_only("パレードカーの上で勇ましい姿を見せる\n赤髪の女王様に、人々は唖然としている。")
	await novel_interface.show_text_only("ソヤは餅のようにへばり付く俺の顔から\nイルカを引っ剥がして、自分の背中に背負った。")
	await novel_interface.show_text_only("イルカの方はすでに、ぐっすりと眠っている。")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("このガキ……こんなに重いとは……ッ！", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ようやく解放された俺は、ダメージを受けた腰を\n揉みながら再度周囲を見渡した。\n沈黙が支配している空気が一面に広がって、\n物凄く不安に駆られる。")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("まさかこいつら罵倒されて、カッとなってる\nとかじゃ……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しばらくすると、荒波のような声の渦が遠方から\n押し寄せてきた──")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("ああぁぁぁ素晴らしいいぃぃぃぃッッッ！！！！", "通行人A")
	await novel_interface.show_dialog("どうか俺をもっと罵ってくださいいぃぃぃッ！！", "通行人B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("はっ？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("電気街全体で声の誘爆が次々と発生する。")
	await novel_interface.show_text_only("群衆のボルテージは一気に最高潮に達した。")
	await novel_interface.show_text_only("小銃を持った兵士が黒い装甲車から降りてくると\n変に沸き立つ群衆に困惑した表情を見せる。")
	await novel_interface.show_text_only("俺はベアトリーチェに注意を促そうと\n兵士の方角を指差した。\nその時、ダメと言われたのにうっかり彼女の顔を\n見てしまう……")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("やばッ──", "レン")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("………………き、きれいだ！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女の顔を見た途端、急に下腹部から暖かい物が\n全身に伝わっていくのを感じた。")
	await novel_interface.show_text_only("頬が熱くなって、足に力が入らない……")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("（俺も……）", "レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("……レンさん？", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("歓声がリズムを刻み始めると人々のテンションは\nますますヒートアップ。\nベアトリーチェが乗るパレードカーも押されて\nグラグラと揺れるぐらいだ。")
	await novel_interface.show_text_only("何人かが側面から車の屋根に登ろうとするが、\n彼女に次々と顔を蹴られ、落とされている。")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("（俺も踏まれたいよおおぉぉぉ～～ッッ！！！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目がハートになってしまった俺。\n\nそんな姿を彼女が見ると、微笑みながら頭を\n横に振ってブレスレットを装着し直した。")
	await novel_interface.show_text_only("胸元から親指サイズの銀色のカプセルを取り出し\n自分の足元に向かって叩き付ける──")
	await novel_interface.show_text_only("そして白い発煙と共に、ベアトリーチェの姿は\n霧のように消えた。")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("まだピンク色の感覚に溺れている俺……\n\n……ソヤが腕を掴んで引っ張ってくれた。")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("何をポケーっとしておりますのッ！\n軍隊が来ますわよッ！\nそれに……！", "ソヤ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("煙が消えた後、リズムに乗っていた歓声が徐々に\n崩れていき、人々の意識が元に戻っていく。")
	await novel_interface.show_text_only("意識を取り戻した親衛隊の1人が、拝んでいた\n『萌神様』の消失に気付いた。")
	await novel_interface.show_dialog("なッ！！！　イルカ様は！？！？", "親衛隊A")
	await novel_interface.show_dialog("あっちだッ！！！ \nあの網タイツがイルカ様を誘拐しやがった！！！", "親衛隊B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("（網タイツ…？　…イルカ……様？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("アイツ誘拐犯じゃね！？\n早く警察呼ぼうぜ！！", "親衛隊C")
	await novel_interface.show_dialog("追うぞ――――――ッッッ！！！！！", "親衛隊A")
	await novel_interface.show_text_only("はっぴを着た大群の男達が謎の正義感を携え、\n俺達に襲いかかってくる。\nその後ろには数名の保安警察も付いてきている。")
	await novel_interface.show_text_only("網タイツを穿いた誘拐犯なんているかよ！！")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("早く逃げなきゃっ！！", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しかしソヤはイルカを背負っているし、俺も腰を\n負傷中だから奴らを振り切れそうにない。")
	await novel_interface.show_text_only("さらには前方、\nどうやら警官達が待ち構えているようだ……")
	await novel_interface.show_text_only("殴り合いもできないし、逃げようにも走れない。\nまさに絶体絶命――\nガッシャァーーーーンッ！！")
	await novel_interface.show_text_only("突然、俺達の後ろからガラスが派手に\n割れる音がした。")
	await novel_interface.show_text_only("黒いコートを着た男性が、道端の古い電飾看板を\n倒したのだ。")
	await novel_interface.show_text_only("看板に付いていた丸い電球が地面によって\n砕かれると、\nそれを避けた通行人が後ろの親衛隊の視界を\nさえぎった。")
	await novel_interface.show_text_only("その男性は俺とソヤの方を向くと、人畜無害な\n笑顔を見せる。")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("この先に小道があります。案内しましょうか？", "眼鏡の男子")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺とソヤは互いに顔を見合わせた。\n\n……これって映画の真似か何か？")
	await novel_interface.show_text_only("メガネを掛けていて、チェック柄のシャツを\n着ている男。\n紺碧の目からは少し内気な感じが伺える。")
	await novel_interface.show_text_only("俺達がしばらく返事しないのを見て、\n彼は少し恥ずかしそうに説明した。")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("ぼ、僕は近くの店でアルバイトをしていて、\nちょうど終わったところで……", "眼鏡の男子")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼は視線を俺の足へと泳がせたが、すぐに頭を\n横に向ける。")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("（そうか……その方法で女の子を盗み見るのは\n　やっぱダメなんだな……）\n（明らかにバレバレじゃないか……）", "レン")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("君達が……悪い人に追われていた様子を\n見てたので……", "眼鏡の男子")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ソヤは少しほっとして、警戒心を解く。")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("まあ……彼の気配からは悪意を感じませんわ。", "ソヤ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("色んな意味で、悪いのは俺達の方なんだけどな。")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("早く案内してくださいまし～～♪", "ソヤ")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
