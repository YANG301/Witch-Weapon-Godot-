# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice lifts one leg, foot on the railing, and yells into her microphone.")
	await novel_interface.show_text_only("The stereo, turned up to full volume, carries her voice to the very end of Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("You’re garbage, all of you!", "Beatrice")
	await novel_interface.show_dialog("Go to hell, perverts!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("What?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Uh...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(She’s just... saying that to attract attention, right? She doesn’t mean it, right?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("And attract attention she did. All eyes are on her now.")
	await novel_interface.show_text_only("The second they see Beatrice’s face, the pedestrians can no longer look away. They stand, mouths hanging open, awed by her shiny red high heels and the enticing shadow under her miniskirt.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Garbage, all of you! Filthy bugs! You’d love me to stomp y’all to death, wouldn’t you?", "Beatrice")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Aren’t you ashamed?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Maybe she actually does mean it...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Most of the people on the street are staring now. Even the mascots who had been dancing on the roofs of other trucks pause in their performances to watch the spectacle.")
	await novel_interface.show_text_only("Sonya and I take the opportunity to scale the ladder on the side of Elluka’s truck.")
	await novel_interface.show_text_only("The girl is sitting on her throne, patting her bulging belly in satisfaction. Dozens of empty plates lie on the offering table in front of her.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("She... ate all this?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I survey the area, calculating the best way to carry this chubby little glutton out of this whole mess, but Elluka simply throws herself onto me.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Miss Ren!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hold a finger to my lips, motioning at her to keep it down—")
	await novel_interface.show_text_only("Yet she’s already leapt into the air, aiming straight for my face...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Oh, right. The first time I saw Elluka, she was fighting witches in the air, wasn’t she?")
	await novel_interface.show_text_only("I remember Aya telling me that this girl, around eleven to twelve years old judging from the age of her bones, had undergone dozens of operations and had countless mechanical parts installed in her body.")
	await novel_interface.show_text_only("Her memory’s been wiped too many times—she doesn’t even remember when her own left eye had been replaced by a military-grade electronic prosthetic eye.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("With all those mechanical parts inside her, even though she’s capable of floating by taking advantage of the electromagnetic field, her actual weight is in fact twice that of mine...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Thump!")
	await novel_interface.show_text_only("Elluka lands on me, thighs squeezing my ribs, soft belly covering my face. Her chubby hands clutch at the back of my neck.")
	await novel_interface.show_text_only("I swear I could hear my spine breaking from the pressure.")
	await novel_interface.show_text_only("She wraps her whole body around my chest, my head, nuzzling her cheek on my hair like a very enthusiastic cat.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Miss Ren is my favorite! *hic*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("From her gleeful red face and the slur in her voice, one would have thought she’s drunk.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("I heard this loud crack... was that your bones?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stand stiff, frozen in spot. Feels like my neck will snap in half if I move even the tiniest bit.")
	await novel_interface.show_text_only("The commotion seems to have attracted the attention of the females nearby. Some are even pointing at us, asking “what’s that?”")
	await novel_interface.show_text_only("I look like a big-headed monster in fishnet stockings right now. No wonder they’re confused.")
	await novel_interface.show_text_only("Noticing our predicament, Beatrice raises her voice, as if to buy us some more time to evacuate.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("You all belong in the junkyard! Not an ounce of decency in your heads! Maggots! Creeps! Swine!", "Beatrice")
	await novel_interface.show_dialog("All of you—", "Beatrice")
	await novel_interface.show_dialog("Die!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The two speakers chorus with fizzling electricity as Beatrice’s passionate speech reaches its climax.")
	await novel_interface.show_text_only("And finally they explode, alongside the light bulbs on the nearby illuminated billboards.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("The whole street falls into an eerie silence.")
	await novel_interface.show_text_only("The crowds are still staring, shell-shocked, at the red-haired lady, standing in all her glory on top of the truck.")
	await novel_interface.show_text_only("Sonya uses the brief distraction to yank Elluka off me, then shoves her onto her own back.")
	await novel_interface.show_text_only("The younger girl, who had plastered herself over me like a piece of gum, falls asleep in an instant.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Whew... didn’t expect the brat to weigh this much...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I sigh, finally managing to catch my breath, massaging my waist as I survey the scene. It’s still unnervingly silent.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Are these guys petrified or something?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But moments later, cheers begin rippling through the crowd. Loud, wondrous cheers.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Aahhh! She’s wonderful! You’re wonderful!", "Passerby A")
	await novel_interface.show_dialog("Step on me, my queen!", "Passerby B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Waves and waves of ecstatic cheers explode all over the street.")
	await novel_interface.show_text_only("The crowds are rioting out of sheer excitement.")
	await novel_interface.show_text_only("From the black armored trucks across the street, several soldiers carrying automatic weapons hop down, surveying the sudden uproar in confusion.")
	await novel_interface.show_text_only("I gesture in their direction, trying to alert Beatrice, and that’s when I accidentally catch sight of her face...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Oh dear—", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("She’s... so beautiful!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A warm tingling current that feels very much like desire spreads through my body instantly.")
	await novel_interface.show_text_only("My cheeks burn, my legs give out...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(I want her...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("... Ren?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The crowds are going out of control. They surge upon Beatrice’s truck as one, chanting loudly as they go, to the point that the flimsy vehicle is on the verge of toppling over.")
	await novel_interface.show_text_only("Some guys attempt to scale the truck from the side, but Beatrice simply stomps on their grabby hands and kicks them back down.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Yes! More! Stomp on me too! Please, my queen!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice smiles and shakes her head at the look of sheer idiocy on my face, then clasps her bracelet back on.")
	await novel_interface.show_text_only("Then she pulls out a silver capsule the size of a thumb from her breasts and tosses it at the wilding crowds under her feet—")
	await novel_interface.show_text_only("In a cloud of white smoke, the beautiful Beatrice disappears without a trace.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("I still can’t forget her stunning face, however—until Sonya tugs at my arm.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Snap out of it! The soldiers are coming! Besides...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As the smoke dissipates, the crowd begins murmuring in confusion, realizing that their object of focus is no longer there.")
	await novel_interface.show_text_only("Sonya and I barely manage a few steps away from the crowds before Elluka’s fanclub notices that their very own idol is gone.")
	await novel_interface.show_dialog("Where’s Lady Elluka?", "Royal Guard A")
	await novel_interface.show_dialog("Over there! That one in fishnet stockings took our Lady Elluka!", "Royal Guard B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Fishnet stockings? Lady Elluka?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Kidnapper! Call the police!", "Royal Guard C")
	await novel_interface.show_dialog("After them!", "Royal Guard A")
	await novel_interface.show_text_only("A group of raging men make a beeline for us, followed by a few security police.")
	await novel_interface.show_text_only("Come on, what kind of kidnapper wears fishnet stockings?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Run!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But it’s hard for us to shake the crowd off, especially since Sonya is carrying the plump Elluka, and my waist is still throbbing in pain.")
	await novel_interface.show_text_only("What’s worse, there are some cops patrolling up ahead...")
	await novel_interface.show_text_only("We can’t fight. We can’t run. It’s hopeless.")
	await novel_interface.show_text_only("Suddenly, from behind us, comes the sound of shattering glass.")
	await novel_interface.show_text_only("A blond guy in a black windbreaker has knocked over an old-school illuminated billboard by the street.")
	await novel_interface.show_text_only("The shards of the billboard light bulbs cover the ground. The pedestrians, trying their best to avoid them, effectively slow down Elluka’s fanclub.")
	await novel_interface.show_text_only("The blond guy smiles at Sonya and me, face innocent and sweet.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("There’s a shortcut up ahead. Come with me?", "Boy with Glasses")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya and I exchange glances. Why does this sound like some kind of scenario from a movie?")
	await novel_interface.show_text_only("The bespectacled young man, with fluffy blond hair, a plaid shirt and azure eyes, seems rather shy.")
	await novel_interface.show_text_only("He looks almost embarrassed by our lack of reaction and hastens to explain:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("I... I work part-time in a store around here... I just got off work...", "Boy with Glasses")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("He glances at my legs, gulps, and turns away.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Wow, this is indeed not a good way to sneak glances at girls...)\n(It’s way too obvious...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("You... you looked like you were being chased by some baddies, so I thought...", "Boy with Glasses")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya’s shoulder’s sag as she lets her guard down briefly.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("Judging from his aura, he doesn’t want to hurt us.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Actually, all things considered, WE’RE the baddies here...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Lead the way!", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
