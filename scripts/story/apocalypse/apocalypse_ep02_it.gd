# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Il filmato della missione di salvataggio degli ostaggi è ovunque nei notiziari del venerdì mattina.")
	await novel_interface.show_text_only("Poiché il SID ha chiuso tutte le vie di fuga nell'area coperta dall'Aegis, i rapitori non hanno avuto altra scelta che tenere temporaneamente il loro ostaggio in un magazzino abbandonato.")
	await novel_interface.show_text_only("Sono stati arrestati quattro terroristi, sospettati di aver rapito un alto esponente del Consiglio Unito. Una conclusione soddisfacente per questo incidente.")
	await novel_interface.show_dialog("Omicidi e rapimenti in pieno giorno in un territorio internazionale: è come se chiedessero la guerra a tutti i paesi membri del Congresso Unito!", "Lumbert")
	await novel_interface.show_dialog("Questo incidente è la prova di come il terrorismo sia ovunque intorno a noi. Anche le recenti attività di Spacetime Flux potrebbero avere qualcosa a che fare con i terroristi.", "Lumbert")
	await novel_interface.show_dialog("Come sopravvissuto alla guerra, credo fermamente che l’intimidazione sia un mezzo importante per garantire la sicurezza e la pace.", "Lumbert")
	await novel_interface.show_text_only("Mi faccio beffe mentre salto l'intervista, che ovviamente è una stronzata scritta a tavolino, mentre sgranocchio l'ottantesima patatina in un'ora.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Questo tizio... sarebbe quasi morto? (Munch munch)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Sì. Non l'hanno salvato solo poche ore fa? E sta già tenendo un discorso. Hmm. Sospettoso...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Tuttavia, la parte con gli elicotteri e la squadra di soccorso è stata piuttosto tosta. Quasi come un film.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mmm, che bello!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka annuisce, con espressione solenne.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Si tratta principalmente di un editing eccellente e di un'ottima musica di sottofondo. A chi non piacciono gli effetti cinematografici, giusto?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A causa dell'importante evento che si tiene in città, la scuola inizia piuttosto tardi in questi giorni, verso le dieci e mezza. Inoltre finiamo le lezioni molto prima.")
	await novel_interface.show_text_only("Annie, Elluka e io siamo tutti rannicchiati insieme sul divano come piccoli criceti, condividendo le patatine (più come se Annie me le avesse rubate).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("L’intelligence del SID non è stata la ragione principale per cui il salvataggio ha avuto tanto successo?\nLa notizia non ci ha nemmeno dato credito...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Dopotutto, le agenzie di intelligence hanno bisogno dell’anonimato per sopravvivere. Devo volare sotto il radar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Signorina Ren...\nVoglia di cioccolato...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La piccola testa di Elluka spunta all'improvviso tra me e Annie.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Pocky al cioccolato?\nIl minimarket al piano di sotto sembra essere esaurito. Abbiamo comprato tutto.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Te ne prenderò un altro la prossima volta che andremo al supermercato.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Ma... lo voglio... adesso...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka mette il broncio, scuotendo la scatola vuota davanti alla mia faccia, il labbro inferiore tremante.")
	await novel_interface.show_text_only("Ma fa troppo caldo per uscire adesso. Tutto quello che voglio è restare in casa, godermi l'aria condizionata ed essere una patata.")
	await novel_interface.show_text_only("Mariru è stata impegnata in questi giorni. Dopotutto, nella zona demilitarizzata concordata sono arrivate tantissime personalità importanti per partecipare al quarto Forum internazionale di pace.")
	await novel_interface.show_text_only("La portata del Forum quest'anno è davvero impressionante. Le cinque Città Accademia oltre a New Opulentia hanno inviato centinaia di rappresentanti ciascuna.")
	await novel_interface.show_text_only("Per giunta, una conferenza di leader governativi di alto livello. Naturalmente, ha causato molti problemi nella vita quotidiana delle persone.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Molte aree della città sono ora zone temporaneamente vietate alle biciclette. Davvero scomodo per noi quando ordiniamo la consegna.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie si lamenta mentre scorre il telefono, sdraiata disordinatamente sul divano.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Va bene, va bene, vado a prendervi degli snack.\nAnnie, hai bisogno che porti qualcosa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Eheh...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahahah…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I due elencano prontamente dozzine di articoli, con un'aria totalmente compiaciuta come loro.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Perché fa così caldo?", "Lian")
	await novel_interface.show_dialog("mi sto sciogliendo...", "Lian")
	await novel_interface.show_text_only("È ancora presto, il supermercato ha appena aperto, ma fuori fa già caldo.")
	await novel_interface.show_text_only("Cammino arrancando, trascinando un enorme sacco di cibo spazzatura. Sembra che ci sia molto personale di sicurezza in giro per le strade in questi giorni.")
	await novel_interface.show_text_only("Sono state istituite molte zone soggette a restrizioni di trasporto. I cittadini devono portare sempre con sé la carta d'identità.")
	await novel_interface.show_text_only("Le auto della polizia e gli assistenti di sicurezza si trovano in ogni stazione dei trasporti pubblici.")
	await novel_interface.show_text_only("Il trasporto è per lo più limitato nella zona demilitarizzata concordata. Nuovissimi dispositivi di sorveglianza sono stati montati su tutti i lampioni della via principale.")
	await novel_interface.show_text_only("Ho sentito che, poiché la città non ha abbastanza soldati di sicurezza, il Congresso Unito deve assumere tutti i mercenari che Ritnalap ha da offrire.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Tuttavia, immagino sia comprensibile essere vigili...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Abbasso lo sguardo dall'incrocio sopraelevato e vedo passare un gruppo di manifestanti. Un cameraman di qualche canale di notizie li segue, filmando il corteo.")
	await novel_interface.show_text_only("Non è passato molto tempo dalla fine della guerra. Naturalmente, tutti i tipi di organizzazioni, gruppi e canali mediatici sarebbero entusiasti di trovare un pubblico a New Opulentia durante un evento così importante.")
	await novel_interface.show_text_only("Tutte le organizzazioni hanno obiettivi diversi: conflitti regionali, questioni razziali, problemi dei rifugiati, oppressione religiosa, problemi economici... di qualsiasi cosa, c'è un'organizzazione che urla al riguardo.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Ci sono anche gruppi missionari qui che cercano nuovi seguaci. Non avrebbero potuto scegliere un periodo meno caotico per farlo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Secondo quanto mi ha detto Mariru, anche gli ultimi tre Fori internazionali di pace non sono andati molto bene.")
	await novel_interface.show_text_only("Il precedente si sarebbe dovuto tenere a Masada Ford, ma hanno dovuto trasferirsi a Salmonton a causa dei frequenti attacchi terroristici alla frontiera.")
	await novel_interface.show_text_only("Poi il Dr. Deckers ha annunciato dal nulla al Forum dello scorso anno che Salmonton avrebbe aperto le sue porte a tutti i rifugiati. Ciò ha portato a molte urla e rivolte, ovviamente.")
	await novel_interface.show_text_only("In seguito Raphilia aveva fatto un commento politicamente scorretto, motivo per cui la sua famiglia aveva finito per mandarla a New Opulentia.")
	await novel_interface.show_text_only("Per quanto riguarda l'anno prima... i terroristi hanno bombardato un intero isolato a Newmoridas. Hanno persino inviato elicotteri militari.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Dev'essere stato orribile...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Due giorni fa, Skuld è stato invitato a un evento di beneficenza nell'area dell'ambasciata e ha fatto una generosa donazione ai bambini che muoiono di fame in Sud America.")
	await novel_interface.show_text_only("Per coincidenza, un'organizzazione vegana europea stava protestando contro la macellazione di animali fuori dalla sede.")
	await novel_interface.show_text_only("Alcuni di loro si spogliarono e si sdraiarono a terra, simulando pezzi di bistecca.")
	await novel_interface.show_text_only("Abbiamo visto una cameriera versare una pentola di salsa violacea, completa di tentacoli di calamaro, su una \"bistecca\" dalla diretta televisiva.")
	await novel_interface.show_text_only("La sfortunata “bistecca” si allontanò a quattro zampe, stridendo a pieni polmoni.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("E oggi, il sito ufficiale dell’organizzazione ha pubblicato una dichiarazione in cui afferma che i suoi membri sono stati gravemente traumatizzati.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ahahah...\n(Spero che Fabella si renda conto di quanto sia terribile la sua cucina adesso!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, il mio telefono vibra nella borsa.\nMariru ha inviato un messaggio.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Uhm. Fai rapporto al quartier generale oggi, eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Dieci ore fa>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, sala di controllo SID>")
	await novel_interface.show_text_only("Una donna dai capelli rossi in tenuta militare sta in piedi con le braccia incrociate sul petto, fissando la dozzina di parentesi rosse che si muovono rapidamente sullo schermo in bianco e nero.")
	await novel_interface.show_text_only("Una finestra di chat appare improvvisamente dalla parte inferiore dello schermo.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Capo, secondo i nostri dati, l'ostaggio Sir Lumbert si trova ancora da qualche parte sotto l'egida.", "Agente SID")
	await novel_interface.show_dialog("La nostra analisi del percorso di sorveglianza ci dice che il rapitore si trova molto probabilmente in una di queste tre aree. Un magazzino abbandonato nella Bay Area ha mostrato un'attività anomala di consumo di elettricità...", "Agente SID")
	await novel_interface.show_dialog("Dovremmo informare l'Ufficio della Difesa?", "Agente SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Non ancora. Circonda la zona e aspetta i miei ordini.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Roger quello.", "Agente SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chiudendo la finestra, Mariru passa al canale della chat militare.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("La zona montuosa è più avanti. Mantieni l'elicottero ad un'altitudine di sicurezza, non lasciare che ci notino.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Capito. Abbiamo immagini chiare dal satellite termosensibile.", "Soldato A")
	await novel_interface.show_dialog("Si muovono così velocemente... sono davvero umani?", "Soldato A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Tecnicamente... una volta erano umani. Semplicemente non più.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Sono stati evacuati tutti nella direzione in cui si stanno dirigendo? Se si verifica qualcosa di anomalo:", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I nostri cannoni e le armi di distruzione regionale sono pronti.", "Soldato B")
	await novel_interface.show_text_only("Mariru annuisce. Non vuole far trapelare troppo ai militari.")
	await novel_interface.show_text_only("Inoltre, ha avuto un brutto presentimento a riguardo fin dall'inizio della missione di tracciamento...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Di solito ci occupiamo di quelle “streghe” che appaiono fuori dal centro di New Opulentia annientandole con la forza con le armi da fuoco pesanti che i militari hanno piazzato in anticipo nell’area.)", "Mariru")
	await novel_interface.show_dialog("(Secondo le esperienze passate, queste cose di solito attaccano casualmente gli esseri viventi o le strutture vicine dopo che i loro bozzoli delle streghe sono scomparsi.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Ma nelle ultime due settimane sembra che abbiano mostrato una sorta di schema identico...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aspetta... c'è qualcuno più avanti!", "Soldato A")
	await novel_interface.show_dialog("Portare anche una motosega. Forse un taglialegna?", "Soldato B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiota, quale taglialegna lavora alle undici di sera?\nQuali sono i risultati del test sui meme?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verde. È umano!", "Soldato A")
	await novel_interface.show_dialog("E... anche una ragazza umana?", "Soldato B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru ingrandisce immediatamente il filmato catturato.")
	await novel_interface.show_text_only("Sullo schermo della termoimmagine c’è una bambina che indossa una bandana e trasporta una motosega grande quasi quanto lei.")
	await novel_interface.show_text_only("E sta salutando quelle streghe che corrono velocemente.")
	await novel_interface.show_text_only("Le streghe principali, allertate dal suono della motosega, cambiano rotta e guidano il branco nella sua direzione.")
	await novel_interface.show_text_only("Una colonia di streghe di queste dimensioni di solito può essere sconfitta solo da una squadra di armati pesantemente ed esperti con mitragliatrici. La ragazza non ha alcuna possibilità.")
	await novel_interface.show_text_only("Ma prima che Mariru possa avvisare la squadra di pulizia di raccogliere il cadavere della ragazza in seguito, la ragazza si gira semplicemente verso le streghe, raggiante, con la motosega in mano.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Adatta il suo ritmo e la sua postura mentre innumerevoli streghe le sfrecciano accanto, schivando abilmente i loro attacchi e allo stesso tempo facendo a pezzi le streghe in arrivo.")
	await novel_interface.show_text_only("Le streghe, come la carne fresca infilata in un trituratore pesante, finiscono in minuscoli pezzetti di carne.")
	await novel_interface.show_text_only("La ragazza si muove e attacca agevolmente, utilizzando le leggi dell'inerzia e della forza centrifuga a suo vantaggio. Non sembra essere straordinariamente forte: ha solo la fisica dalla sua parte.")
	await novel_interface.show_text_only("Probabilmente aveva fatto qualche calcolo in anticipo e, in base alle caratteristiche dei bersagli e alla propria forza, aveva scelto la motosega come arma più efficace.")
	await novel_interface.show_text_only("Nel giro di trenta secondi, quelle decine di streghe, che il SID e i militari stavano braccando da quattro giorni, ormai non sono altro che carne triturata.")
	await novel_interface.show_dialog("C-cosa facciamo adesso?", "Soldato A")
	await novel_interface.show_text_only("Mariru sospira.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Cavolo...", "Mariru")
	await novel_interface.show_dialog("Riflettori accesi. Missile Hellfire pronto...", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Prova a parlarle con un altoparlante. Dille che è circondata. Se osa muoversi, fatela a pezzi insieme a questa montagna.", "Mariru")
	await novel_interface.show_dialog("Riportatela viva!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<Qualche ora dopo, sala interrogatori del SID>")
	await novel_interface.show_text_only("Accanto allo specchio unidirezionale, Mariru sfoglia il file del bersaglio sul suo dispositivo portatile.")
	await novel_interface.show_text_only("Nome: Sonya Angeles")
	await novel_interface.show_text_only("Età: 14...?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organizzazione...", "Mariru")
	await novel_interface.show_dialog("Distretto speciale della chiesa di Salmonton, CDF.", "Mariru")
	await novel_interface.show_dialog("Quello era un tribunale religioso, giusto?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru tocca un pulsante e il vetro diventa trasparente. Una ragazza, vestita con abiti da suora, la incontra dall'altra parte con occhi silenziosi e docili.")
	await novel_interface.show_text_only("Il suo corpicino è nascosto sotto il pesante abito di velluto nero, tenuto insieme da una spilla rosso scuro.")
	await novel_interface.show_text_only("Invece del cappello da suora, ha un paio di orecchie da gatto in testa. Sembra che le stia bene.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Capelli argentati lunghi e lucenti, occhi azzurri. Avrebbe dovuto essere carino, ma quel sorriso stranamente freddo e disinvolto sul suo viso era tagliente, agghiacciante.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sfoglia i relativi rapporti e nota la riga in caratteri rossi in basso—")
	await novel_interface.show_text_only("Questa persona è protetta dalle condizioni speciali dell'Accordo di Salmonton e non può essere trattenuta da alcuna organizzazione appartenente a un paese membro del Congresso Unito per più di dodici ore.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Ehi. L'ordine di indagine che l'esercito di New Opulentia ha contro di te è già annullato.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("Ah? Bene.\nEro così spaventato!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Dovrebbero essere loro ad avere paura. Quel soldato che ti ha appena portato qui ha fatto domanda per un'operazione di rimozione della memoria di livello C...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza dai capelli d'argento, con le mani incatenate, si lecca le labbra, sorridendo per l'eccitazione.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Eh, puzzavano così tanto, sai? Ma non li ho nemmeno feriti.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Comunque, mi interrogherai? Almeno hai un profumo davvero buono!", "Soya")# 换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza studia Mariru con molto interesse.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ah? Sonya, giusto?", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Interrogare le persone è la mia... “competenza”.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche Mariru inizia a sembrare eccitata.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ma ancora, prima...", "Mariru")
