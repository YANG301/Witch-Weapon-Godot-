	await novel_interface.show_dialog("Était-ce...", "Thérèse")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa fait une pause, attendant la confirmation de l'autre côté.")
	novel_interface.show_character("cereza","normal")
