	await novel_interface.show_dialog("Les numéros de série de ces composants et de la LED semblent tous corrects et honnêtes.", "Aï")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Hé...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je place l'abat-jour contre la source de lumière provenant de quelque part à l'extérieur du véhicule.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Si l’abat-jour est jaune, la lampe ne produira jamais de lumière blanche, n’est-ce pas ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La texture jaune recouvrant l'abat-jour semble complexe, avec un gaufrage détaillé. Cela a dû demander beaucoup de travail.")
