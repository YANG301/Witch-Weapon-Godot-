	await novel_interface.show_dialog("Peut-être y a-t-il un message caché sur cet abat-jour ? Mais je ne peux pas le dire...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya, elle aussi, tient l'abat-jour face à la lumière extérieure et secoue la tête en signe de défaite.")
