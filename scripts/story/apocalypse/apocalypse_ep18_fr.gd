	await novel_interface.show_dialog("Tsk...", "Thérèse")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa découpe habilement un morceau de tissu noir dans la tenue d'un soldat mort au sol, tout en parlant paresseusement dans son casque.")
