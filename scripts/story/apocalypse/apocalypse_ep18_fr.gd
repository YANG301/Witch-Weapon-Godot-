	await novel_interface.show_dialog("En plus, même si je les ramène vivants, ce n'est pas comme si nous pouvions découvrir quelque chose d'intéressant auprès de ces mecs, non ?", "Thérèse")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Brûlez toutes les empreintes digitales... implantez de la dynamite dans les dents... dès qu'ils sont sur le point de mourir, le mécanisme se déclenche et tout le visage est détruit...", "Thérèse")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("... Ouais ! Voir? Ce n'est pas ma faute !", "Thérèse")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya se plaint à la personne à l'autre bout de la conversation.")
