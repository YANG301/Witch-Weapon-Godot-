# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Nous sortons du bâtiment pour trouver notre manège garé à l'entrée. Le gros conducteur nous tend deux oreillettes à micro conduction osseuse.")
	await novel_interface.show_dialog("Le patron m'a dit de vous les donner.", "Chauffeur")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Le b-boss ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya et moi avons mis les écouteurs et entendons Aya parler à l'autre bout du fil.")
	await novel_interface.show_dialog("C'est trop bruyant dans la foule. Vous pourriez avoir du mal à m'entendre si nous parlons au téléphone.", "Aï")
	await novel_interface.show_dialog("Je viens de vérifier. Sur l’ensemble de la zone démilitarisée agréée, seules les sept zones où les émeutes ont eu lieu sont dotées de lampadaires jaunes.", "Aï")
	await novel_interface.show_dialog("Ce sont toutes des zones très fréquentées avec de nombreux panneaux d’affichage et autres sources de lumière, de sorte que même ceux qui vérifient les images aériennes ne remarqueront pas la différence.", "Aï")
	await novel_interface.show_dialog("Nous avons envoyé notre équipe de récupération, mais je suppose que je ne peux pas vous convaincre de rester en retrait. Gardez simplement Ren en sécurité.", "Aï")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Rester en retrait ? Hein? Rester en retrait de quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya se contente de hocher la tête en direction du drone qui nous suit et m'entraîne dans la foule.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("Nous arrivons sous un réverbère jaune qui heureusement n’est pas entouré de trop de monde. Le mât de la lampe s'élève sur près de vingt-cinq pieds.")
	await novel_interface.show_text_only("Lors des stages au SID, j'ai été un échec total aux exercices d'escalade.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(J'ai un F pour chacun d'eux.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je devais généralement m'attaquer au poteau en un saut volant pour gagner de la hauteur, mais je finis quand même par glisser vers le bas.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Héhé...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sort de son sac à main une boîte en métal affaissée. Il est étonnamment grand, avec des côtés de la taille de votre papier à notes moyen et environ trois pouces d'épaisseur.")
	await novel_interface.show_text_only("Une ligne argentée brillante traverse la surface de la boîte, marquant un composant rotatif. Et sur le côté se trouve une bande métallique rose.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Devinez ce que j'ai ici !", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("S'exclame fièrement Sonya en me montrant la boîte.")
	await novel_interface.show_text_only("Hum. À en juger par la taille, le savoir-faire, le grand composant rotatif en forme d'éventail et cette bande métallique scintillante...")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Euh, une sorte de carte graphique inutilement énorme ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tire simplement sur le loquet de la poignée et le côté rayé rose de la boîte s'ouvre comme un accordéon.")
	await novel_interface.show_text_only("Et de l’intérieur, une série de composants mécaniques noirs ressortent, ainsi qu’une longue « planche ». Mettez-les tous ensemble et il s’étend sur près de quarante pouces.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Qu'est-ce que c'est ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("C'est une arme exclusive aux Judgment Knights. Propulsé par Substance H !", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Le pénitencier me l'a fait selon mes souhaits.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tourne la poignée et une rangée de dents de scie brillantes apparaît le long du bord de la longue planche.")
	await novel_interface.show_text_only("La rangée de dents s'étend jusqu'à l'arc à l'extrémité de la planche, et enfin jusqu'à la boîte.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Une tronçonneuse ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Quelque chose comme ça. Il n’est cependant pas alimenté à l’électricité. C'est mon arme préférée !", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya sourit et allume la « tronçonneuse ». Les dents commencent à tourner à une vitesse étonnante, mais elles sont étonnamment silencieuses.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("Est-ce que tu vas...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sans hésitation, Sonya commence à trancher le poteau lumineux en métal. Des étincelles volent partout et le mât d'argent hurle en signe de protestation.")#多字问题
	await novel_interface.show_text_only("Le bruit attire tout un public. Quelques hommes d'âge moyen, même s'ils n'ont pas la moindre idée de ce qui se passe, commencent à hué et à applaudir.")
	await novel_interface.show_text_only("Très vite, deux détonations se font entendre à l'intérieur du poteau, et Sonya récupère calmement sa tronçonneuse.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle lève les yeux vers le réverbère qui ne brille plus. La colonne, d’environ huit pouces de diamètre, est presque tranchée.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Du bois !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("C'est plutôt ça !", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sourit, donnant un coup au poteau dans la direction opposée à la foule.")
	await novel_interface.show_text_only("Et le poteau finit par céder, basculant dans un cri assourdissant.")
	await novel_interface.show_text_only("Boum ! Le lampadaire s'écrase dans le sol, fissurant la surface goudronnée et faisant voler les décombres.")
	await novel_interface.show_text_only("La foule environnante reste médusée pendant quelques secondes, puis de violents applaudissements éclatent.")
	await novel_interface.show_dialog("À la liberté !\nÀ la paix !", "Foule")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("Qu’est-ce que cela a à voir avec la liberté et le rythme ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nous sprintons vers ce qui était autrefois le sommet du réverbère. Sonya coupe rapidement la partie avec la lumière, tandis que le drone qui nous suit atterrit à côté du spectacle.")
	await novel_interface.show_dialog("Je ne vois pas grand chose d'ici. Débarrassez-vous de l’abat-jour et rapprochez l’ampoule du drone. Je veux voir le modèle LED.", "Aï")
	await novel_interface.show_text_only("Pour éviter la foule excitée, je récupère l’ampoule et me précipite en direction de notre SUV.")#换行问题
