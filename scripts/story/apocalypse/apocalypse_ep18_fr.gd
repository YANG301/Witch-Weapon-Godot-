	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("... Oups !", "Thérèse")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa se frappe la tête.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("J'avais oublié que je devais les laisser en vie...", "Thérèse")
