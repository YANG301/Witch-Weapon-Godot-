# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

