# apocalypse_ep18.gd - 天启篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第18话剧本
	apocalypse_ep18_script()

func play_script():
	pass

# 天启篇第18话 - 正式剧本
func apocalypse_ep18_script():
	# Scene 1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Saímos do prédio e encontramos nosso carro estacionado na entrada. O motorista atarracado nos entrega dois fones de ouvido de microcondução óssea.")
	await novel_interface.show_dialog("O chefe me disse para dar isso a você.", "Motorista")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("O b-chefe?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya e eu colocamos os fones de ouvido e ouvimos Aya falando do outro lado da linha.")
	await novel_interface.show_dialog("É muito barulhento no meio da multidão. Você pode ter problemas para me ouvir se falarmos ao telefone.", "Ai")
	await novel_interface.show_dialog("Acabei de verificar. De toda a Zona Desmilitarizada Acordada, apenas as sete áreas onde ocorreram os motins têm postes de iluminação amarelos.", "Ai")
	await novel_interface.show_dialog("Todas essas são áreas movimentadas com muitos outdoors e outras fontes de luz, então mesmo aqueles que verificam as imagens aéreas não notariam a diferença.", "Ai")
	await novel_interface.show_dialog("Enviamos nossa equipe de resgate, mas acho que não consigo convencê-lo a ficar para trás. Apenas mantenha Ren seguro.", "Ai")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Ficar para trás? Huh? Ficar longe de quê?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simplesmente acena para o drone que está nos seguindo e me arrasta para a multidão.")
	
	# Scene 2 - 切换场景
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Soya/Parade.png")
	await novel_interface.show_text_only("Chegamos sob um poste de luz amarelo que felizmente não está rodeado de muita gente. O poste da lâmpada sobe quase sete metros.")
	await novel_interface.show_text_only("De volta aos cursos de treinamento do SID, eu era um fracasso total nos exercícios de escalada.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Recebi um F para todos eles.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Geralmente eu tinha que agarrar o mastro em um salto voador para ganhar alguma altura – mas acabo escorregando de qualquer maneira.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hehe...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya tira uma caixa de metal da bolsa. É surpreendentemente grande, com lados do tamanho de um papel comum e cerca de sete centímetros de espessura.")
	await novel_interface.show_text_only("Uma linha prateada brilhante atravessa a superfície da caixa, marcando um componente giratório. E na lateral há uma faixa metálica rosa.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Adivinha o que tenho aqui!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya exclama com orgulho, erguendo a caixa para eu ver.")
	await novel_interface.show_text_only("Hum. A julgar pelo tamanho, o acabamento, o grande componente giratório em forma de leque e aquela faixa metálica brilhante—")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Uh, algum tipo de placa gráfica desnecessariamente grande?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya simplesmente puxa a trava da alça e o lado listrado rosa da caixa se abre como um acordeão.")
	await novel_interface.show_text_only("E do interior sai uma série de componentes mecânicos pretos, junto com uma longa “prancha”. Junte todos eles e ele se estende por quase quarenta centímetros.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Que diabos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("É uma arma exclusiva dos Cavaleiros do Julgamento. Alimentado pela Substância H!", "Soya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("A Penitenciária fez isso para mim de acordo com a minha vontade.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya gira a alça e uma fileira de dentes de serra brilhantes aparece ao longo da borda da prancha longa.")
	await novel_interface.show_text_only("A fileira de dentes atinge todo o arco no final da placa e, finalmente, volta para dentro da caixa.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Uma motosserra?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	await novel_interface.show_dialog("Algo assim. Porém, não é alimentado por eletricidade. É minha arma favorita!", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sonya sorri e liga a \"motosserra\". Os dentes começam a girar a uma velocidade surpreendente, mas de forma surpreendentemente silenciosa.")
	
	novel_interface.show_character("ren_fishnet","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("soya_uniform","normal",0.25)
	novel_interface.character_2nd_dark()
	
	await novel_interface.show_dialog("Você vai-", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sem hesitar, Sonya começa a cortar o poste de metal. Faíscas voam por toda parte e o mastro prateado grita em protesto.")#多字问题
	await novel_interface.show_text_only("O barulho atrai todo um público. Alguns homens de meia idade, apesar de não terem a menor ideia do que está acontecendo, começam a vaiar e aplaudir.")
	await novel_interface.show_text_only("Muito em breve, duas explosões são ouvidas de dentro do poste, e Sonya calmamente recupera sua motosserra.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela olha para o poste de luz, que não brilha mais. A coluna, com cerca de 20 centímetros de diâmetro, está quase cortada.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("T...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Madeira!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("É mais assim!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya sorri, dando uma pancada no poste na direção oposta da multidão.")
	await novel_interface.show_text_only("E o poste finalmente cede, tombando com um grito ensurdecedor.")
	await novel_interface.show_text_only("Bum! O poste bate no chão, quebrando a superfície de alcatrão e espalhando escombros pelos ares.")
	await novel_interface.show_text_only("A multidão ao redor permanece estupefata por alguns segundos, depois irrompem aplausos violentos.")
	await novel_interface.show_dialog("Para a liberdade!\nPara a paz!", "Multidão")
	novel_interface.show_character("ren_fishnet","sob")
	await novel_interface.show_dialog("O que isso tem a ver com liberdade e ritmo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Corremos até o que antes era o topo do poste de luz. Sonya rapidamente corta a parte com a luz, enquanto o drone que nos segue pousa ao lado do espetáculo.")
	await novel_interface.show_dialog("Não consigo ver muita coisa daqui. Livre-se do abajur e segure a lâmpada mais perto do drone. Quero ver o modelo LED.", "Ai")
	await novel_interface.show_text_only("Para evitar a multidão animada, pego a lâmpada e saio correndo na direção do nosso SUV.")#换行问题
	await novel_interface.show_text_only("Assim que chegamos, Sonya disseca tudo de acordo com as instruções de Aya. Encontramos uma microcâmera, baterias, o filamento e o reator elétrico.")
	await novel_interface.show_dialog("Os números de série desses componentes e do LED parecem bons e honestos.", "Ai")
	novel_interface.show_character("ren_fishnet","worry")
	await novel_interface.show_dialog("Ei...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu seguro o abajur contra a fonte de luz de algum lugar fora do veículo.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Se o abajur for amarelo, não tem como a lâmpada produzir luz branca, certo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A textura amarela que cobre o abajur parece complexa, com relevo detalhado. Deve ter dado muito trabalho.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("Talvez haja uma mensagem escondida neste abajur? Eu não posso dizer, no entanto...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya também segura o abajur contra a luz externa e balança a cabeça, derrotada.")
	await novel_interface.show_dialog("Há um dispositivo de digitalização 3D na van. Coloque o abajur dentro e me mande o resultado.", "Ai")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Uau, temos algo assim no carro?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Claro! Todos os veículos SID vêm com um conjunto completo de armas automatizadas—", "Ai")
	novel_interface.show_character("soya_uniform","yell")
	await novel_interface.show_dialog("Cuidado!", "Soya")
	await novel_interface.hide_character()
	
	# Scene 4 - 被攻击场景
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Zing!")
	novel_interface.show_background("res://assets/images/bg/Soya/Beingshot.png")
	await novel_interface.show_text_only("Uma explosão repentina e ofuscante de luz branca sai do canto e atinge direto meu peito.")
	await novel_interface.show_text_only("Por um segundo, tudo que consigo ouvir é o barulho agudo da eletricidade. Meu coração parou de bater? Parece que sim.")
	await novel_interface.show_text_only("Alguém me segura quando caio para trás — provavelmente o motorista. Com a ajuda de Sonya, ele me arrasta para o outro lado, atrás da van.")
	await novel_interface.show_text_only("Sete homens musculosos em trajes de combate especiais pretos avançam sobre nós com metralhadoras...")
	await novel_interface.show_text_only("Tudo ao meu redor parece estar envolto em uma névoa, como se alguém tivesse colocado um filtro horrível. Mas meu cérebro permanece alerta, quase extraordinariamente. É como se eu pudesse ver o que está acontecendo em câmera lenta.")
	await novel_interface.show_text_only("Lá estão Sonya e Aya, gritando meu nome. Mas não consigo ouvi-los claramente. É como se houvesse um muro entre nós...")
	await novel_interface.show_text_only("O motorista puxa agilmente uma espingarda do porta-malas, carrega-a com uma das mãos e começa a atirar contra nossos agressores, usando a porta à prova de balas do carro como cobertura.")
	await novel_interface.show_text_only("Então esse cara gordinho é realmente durão, hein...")
	await novel_interface.show_text_only("Pena que eles têm vantagem numérica e são bem treinados. Eles têm armas excelentes e é óbvio, pela maneira como estão atacando, que não planejam nos deixar escapar com vida. Nem mesmo Sonya, uma garotinha...")
	await novel_interface.show_text_only("A última coisa que me lembro antes de minha consciência desaparecer é de Sonya apertando minha mão uma vez e depois levantando sua motosserra...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O que se segue é uma série de gritos animalescos e aterrorizados de homens moribundos.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# Scene 5 - 瑟蕾莎场景
	novel_interface.change_background("res://assets/images/bg/Soya/Backstreet.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("<Cerca de mil metros de distância da Primeira Avenida>")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Tsc...", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa habilmente corta um pedaço de tecido preto da roupa de um soldado morto no chão, enquanto fala preguiçosamente em seu fone de ouvido.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Esses caras são realmente apenas uma equipe reserva?\nEles com certeza gastaram muito em seus equipamentos.", "Teresa")
	await novel_interface.show_dialog("Hein? Deixá-los vivos?", "Teresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("... Ops!", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa dá um tapa na cabeça.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Esqueci que deveria deixá-los vivos...", "Teresa")
	await novel_interface.show_dialog("Vamos, não é minha culpa! Seus cérebros explodiram de repente. Fui pego de surpresa e matei todos eles.", "Teresa")
	novel_interface.change_expression("boring")
	await novel_interface.show_dialog("Além disso, mesmo que eu os traga de volta vivos, não podemos descobrir nada de interessante com esses caras, certo?", "Teresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Queime todas as impressões digitais... implantes de dinamite nos dentes... assim que eles estão à beira da morte, o mecanismo é acionado e todo o rosto é destruído...", "Teresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("... Sim! Ver? Não é minha culpa!", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya reclama com quem está do outro lado da conversa.")
	novel_interface.show_character("cereza","speek")
	await novel_interface.show_dialog("Eu ia deixar esses caras vivos! Eu meio que acertei eles com minha lâmina... Eu queria dar a eles uma chance de apreciar meus movimentos legais—", "Teresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("E então eles simplesmente explodiram!", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela suspira, limpando a lâmina com o tecido que cortou, depois joga o pano sujo no rosto do cadáver – se é que ainda pode ser chamado de rosto.")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Bando de perdedores.", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa coloca sua katana brilhante de volta na bainha.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Duas unidades de emergência apareceram do nada em um beco. Sem matrícula. Eram mais de uma dúzia deles, então não pude pegar todos de uma vez...", "Teresa")
	await novel_interface.show_dialog("Mas os três conseguiram escapar muito bem desses agressores, hein? Esse motorista deve ser habilidoso.", "Teresa")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Espere, o que?", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa pressiona o fone de ouvido mais perto do ouvido, como se isso pudesse mudar o que ela tinha ouvido.")
	novel_interface.show_character("cereza","uneasy")
	await novel_interface.show_dialog("Os atacantes... todos aniquilados?", "Teresa")
	await novel_interface.show_dialog("E o sangue deles respingou tão alto que atingiu o quinto andar de um prédio comercial próximo?", "Teresa")#多符号
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Foi...", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa faz uma pausa, aguardando a confirmação do outro lado.")
	novel_interface.show_character("cereza","normal")
	await novel_interface.show_dialog("Ah, certo, eu sabia que era culpa dela! Quando a conheci hoje, também senti isso.", "Teresa")
	novel_interface.change_expression("blink")
	await novel_interface.show_dialog("Hahahaha...", "Teresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa boceja, sonolenta.")
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Você tem que parar de me acordar tão cedo o tempo todo. Eu só quero voltar para minha cama.", "Teresa")
	await novel_interface.show_dialog("De qualquer forma, você tem todas as informações que deseja, certo?", "Teresa")
	await novel_interface.hide_character()
	
	# Scene 6 - 莉琉与伦伯特对话
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Do outro lado vem uma voz feminina confiante.")
	await novel_interface.show_dialog("Sim, tenho tudo que preciso para vencer nesta negociação.", "Voz Feminina")
	novel_interface.show_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("A tornozeleira de Sonya está grampeada. Eu ouvi tudo o que ela disse a Ren. E isso, mais o que você encontrou...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru olha para a foto desbotada em sua mão enquanto caminha pelo porão fechado.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Muito bem, Thereza.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ou devo dizer... Machida Rinko?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa apenas ri ironicamente e desliga.")
	await novel_interface.show_text_only("Segundos depois, um dos dois conjuntos de portas pretas do elevador que levam ao porão se abre. Um homem com um terno impecável sai andando.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Que design impressionante...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Dois elevadores, localizados em ruas diferentes, em dois edifícios costas com costas. No entanto, eles levam ao mesmo porão escondido.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Olá, senhor Lumbert.\nVeja, nossas identidades são... sensíveis, então temos que nos encontrar em segredo.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Você não disse há dois dias na TV que queria ter uma conversa pública comigo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Acho que não há mais necessidade disso.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert aponta para a foto desbotada na mão de Mariru.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Agora, diga-me. Quanto você sabe?", "Lumbert")
	await novel_interface.hide_character()
	
	# Scene 7 - 小怜醒来
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Não sei dizer quanto tempo se passou enquanto lentamente recupero a sensação em meus membros. Ouço o barulho de um veículo... estou em um carro?")
	await novel_interface.show_text_only("Há uma mão acariciando suavemente minha testa. Me sinto em casa.")
	await novel_interface.show_dialog("Ren...", "Soya")
	novel_interface.show_background("res://assets/images/bg/Soya/Wakingup.png")
	await novel_interface.show_text_only("Forço meus olhos a abrirem, embora tudo ainda esteja embaçado.")
	await novel_interface.show_dialog("Ren—", "Soya")
	await novel_interface.show_dialog("Você está acordado?", "Soya")
	await novel_interface.show_text_only("Sonya parece agitada. São lágrimas que vejo nos olhos dela?")
	await novel_interface.show_dialog("O que aconteceu...?", "Lian")
	await novel_interface.show_dialog("Urgh...", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Sinto algo duro na minha boca. Algo que não deveria estar lá. Eu cuspi reflexivamente.")
	novel_interface.show_background("res://assets/images/bg/Soya/Backseat.png")
	await novel_interface.show_text_only("Esfrego os olhos e me vejo no banco de trás do nosso SUV. O que foi que eu acabei de cuspir? Olho para minha mão.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("O que é…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É uma gema transparente, do tamanho de uma bola de gude. Parece exatamente com aquele que Raphilia me entregou, embora a cor tenha desbotado.")
	await novel_interface.show_dialog("Uau! Já acordou?", "Motorista")
	await novel_interface.show_dialog("Fique parado, não se mova! Nós realmente pensamos que tínhamos perdido você lá atrás. Não faço ideia de como íamos contar ao chefe.", "Motorista")
	await novel_interface.show_dialog("E não se preocupe, chegaremos ao hospital em breve.", "Motorista")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Hospitalar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu tento o meu melhor para lembrar o que exatamente aconteceu. Fomos atacados, não fomos? E então—")
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("Você está bem? Dói em algum lugar?", "Soya")
