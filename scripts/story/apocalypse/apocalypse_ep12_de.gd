# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
func apocalypse_ep12_script():
	# scene1 - 开场黑屏到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice hebt ein Bein, stellt den Fuß auf das Geländer und schreit in ihr Mikrofon.")
	await novel_interface.show_text_only("Die auf volle Lautstärke aufgedrehte Stereoanlage trägt ihre Stimme bis zum Ende der Electronics Street.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Ihr seid alle Müll!", "Beatrice")
	await novel_interface.show_dialog("Fahr zur Hölle, Perverse!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("Was?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "jest", 0.25)
	await novel_interface.show_dialog("Äh...", "Soya")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Sie sagt das doch nur, um Aufmerksamkeit zu erregen, oder? Sie meint es doch nicht so, oder?)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Und sie erregte Aufmerksamkeit. Alle Augen sind jetzt auf sie gerichtet.")
	await novel_interface.show_text_only("Als sie Beatrices Gesicht sehen, können die Passanten den Blick nicht mehr abwenden. Sie stehen mit offenem Mund da und sind beeindruckt von ihren glänzend roten High Heels und dem verlockenden Schatten unter ihrem Minirock.")
	novel_interface.show_character("beatrice_regular", "bored")
	await novel_interface.show_dialog("Müll, ihr alle! Dreckige Käfer! Du würdest es lieben, wenn ich euch alle zu Tode stampfe, nicht wahr?", "Beatrice")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Schämst du dich nicht?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "panic")
	await novel_interface.show_dialog("(Vielleicht meint sie es tatsächlich so ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die meisten Leute auf der Straße starren jetzt. Sogar die Maskottchen, die auf den Dächern anderer Lastwagen getanzt hatten, machten bei ihren Auftritten eine Pause, um sich das Spektakel anzusehen.")
	await novel_interface.show_text_only("Sonya und ich nutzen die Gelegenheit, um die Leiter an der Seite von Ellukas Truck zu erklimmen.")
	await novel_interface.show_text_only("Das Mädchen sitzt auf ihrem Thron und streichelt zufrieden ihren prallen Bauch. Auf dem Opfertisch vor ihr liegen Dutzende leerer Teller.")
	novel_interface.show_character("ren_fishnet", "upset")
	await novel_interface.show_dialog("Sie... hat das alles gegessen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich überprüfe die Gegend und überlege, wie ich diesen pummeligen kleinen Vielfraß am besten aus diesem Schlamassel herausholen kann, aber Elluka wirft sich einfach auf mich.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Fräulein Ren!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich halte einen Finger an meine Lippen und bedeutet ihr, ihn gedrückt zu halten …")
	await novel_interface.show_text_only("Doch sie ist bereits in die Luft gesprungen und zielt direkt auf mein Gesicht ...")

	# scene2 - 回忆场景
	novel_interface.change_background("res://assets/images/bg/Soya/Recall.png")
	await novel_interface.show_text_only("Oh, richtig. Als ich Elluka zum ersten Mal sah, kämpfte sie gegen Hexen in der Luft, nicht wahr?")
	await novel_interface.show_text_only("Ich erinnere mich, dass Aya mir erzählte, dass dieses Mädchen, dem Alter ihrer Knochen nach zu urteilen, etwa elf bis zwölf Jahre alt war, Dutzende Operationen durchlaufen hatte und unzählige mechanische Teile in ihren Körper eingebaut worden waren.")
	await novel_interface.show_text_only("Ihr Gedächtnis wurde zu oft gelöscht – sie kann sich nicht einmal daran erinnern, wann ihr eigenes linkes Auge durch eine elektronische Augenprothese in Militärqualität ersetzt wurde.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mit all diesen mechanischen Teilen in ihrem Inneren ist ihr tatsächliches Gewicht, obwohl sie in der Lage ist, unter Ausnutzung des elektromagnetischen Feldes zu schweben, tatsächlich doppelt so hoch wie meines ...")
	# scene3 - 回到秋叶原
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Puh!")
	await novel_interface.show_text_only("Elluka landet auf mir, die Schenkel drücken auf meine Rippen, der weiche Bauch bedeckt mein Gesicht. Ihre pummeligen Hände umklammern meinen Nacken.")
	await novel_interface.show_text_only("Ich schwöre, ich konnte hören, wie mein Rückgrat vor dem Druck brach.")
	await novel_interface.show_text_only("Sie schlingt ihren ganzen Körper um meine Brust, meinen Kopf und schmiegt ihre Wange an mein Haar wie eine sehr begeisterte Katze.")
	novel_interface.show_character("iluka_uniform", "smile")
	await novel_interface.show_dialog("Miss Ren ist mein Favorit! *hick*", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aufgrund ihres fröhlichen roten Gesichts und der undeutlichen Stimme hätte man denken können, sie sei betrunken.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Ich hörte dieses laute Knacken... waren das deine Knochen?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet", "wail")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich stehe steif und wie erstarrt da. Es fühlt sich an, als würde mein Hals in der Mitte brechen, wenn ich mich auch nur das kleinste bisschen bewege.")
	await novel_interface.show_text_only("Der Tumult scheint die Aufmerksamkeit der Weibchen in der Nähe erregt zu haben. Manche zeigen sogar auf uns und fragen: „Was ist das?“")
	await novel_interface.show_text_only("Ich sehe im Moment wie ein großköpfiges Monster in Netzstrümpfen aus. Kein Wunder, dass sie verwirrt sind.")
	await novel_interface.show_text_only("Als Beatrice unsere missliche Lage bemerkt, erhebt sie ihre Stimme, als wolle sie uns etwas mehr Zeit für die Evakuierung verschaffen.")
	novel_interface.show_character("beatrice_regular", "angry")
	await novel_interface.show_dialog("Ihr gehört alle auf den Schrottplatz! Kein Fünkchen Anstand in euren Köpfen! Maden! Gruselig! Schwein!", "Beatrice")
	await novel_interface.show_dialog("Ihr alle –", "Beatrice")
	await novel_interface.show_dialog("Stirb!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die beiden Sprecher singen mit sprühender Elektrizität, während Beatrices leidenschaftliche Rede ihren Höhepunkt erreicht.")
	await novel_interface.show_text_only("Und schließlich explodieren sie, zusammen mit den Glühbirnen auf den nahegelegenen beleuchteten Werbetafeln.")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Die ganze Straße verfällt in eine unheimliche Stille.")
	await novel_interface.show_text_only("Die Menge starrt immer noch geschockt auf die rothaarige Dame, die in all ihrer Pracht auf dem Dach des Lastwagens steht.")
	await novel_interface.show_text_only("Sonya nutzt die kurze Ablenkung, um Elluka von mir zu reißen und sie dann auf ihren Rücken zu stoßen.")
	await novel_interface.show_text_only("Das jüngere Mädchen, das sich wie ein Kaugummi auf mich geklebt hatte, schläft sofort ein.")
	novel_interface.show_character("soya_uniform", "afraid")
	await novel_interface.show_dialog("Puh... ich hätte nicht erwartet, dass die Göre so viel wiegt...", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich seufze, komme endlich wieder zu Atem und massiere meine Taille, während ich die Szene betrachte. Es ist immer noch beunruhigend still.")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Sind diese Kerle versteinert oder so?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Doch Augenblicke später beginnt Jubelrufe durch die Menge zu schallen. Lauter, wundersamer Jubel.")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_dialog("Aahhh! Sie ist wunderbar! Du bist wunderbar!", "Passant A")
	await novel_interface.show_dialog("Tritt auf mich, meine Königin!", "Passant B")
	novel_interface.show_character("ren_fishnet", "stare")
	await novel_interface.show_dialog("Was?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Überall auf der Straße explodieren Wellen ekstatischer Jubelrufe.")
	await novel_interface.show_text_only("Die Menge randaliert vor purer Aufregung.")
	await novel_interface.show_text_only("Von den schwarzen gepanzerten Lastwagen auf der anderen Straßenseite hüpfen mehrere Soldaten mit automatischen Waffen herunter und beobachten verwirrt den plötzlichen Aufruhr.")
	await novel_interface.show_text_only("Ich geste in ihre Richtung und versuche, Beatrice zu alarmieren, und da erblicke ich zufällig ihr Gesicht ...")

	# scene4 - 被美色迷惑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	novel_interface.show_character("ren_fishnet", "timid")
	await novel_interface.show_dialog("Oh mein Gott –", "Lian")
	novel_interface.change_expression("heart")
	await novel_interface.show_dialog("Sie ist... so schön!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein warmer, prickelnder Strom, der sich fast wie Verlangen anfühlt, breitet sich augenblicklich durch meinen Körper aus.")
	await novel_interface.show_text_only("Meine Wangen brennen, meine Beine geben nach...")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Ich will sie...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "speechless", 0.25)
	await novel_interface.show_dialog("... Ren?", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Die Massen geraten außer Kontrolle. Gemeinsam stürmen sie auf Beatrices Truck zu und singen dabei so laut, dass das schwache Fahrzeug kurz vor dem Umkippen steht.")
	await novel_interface.show_text_only("Einige Jungs versuchen, von der Seite auf den Truck zu klettern, aber Beatrice tritt einfach auf ihre Greifhände und tritt sie zurück nach unten.")
	novel_interface.show_character("ren_fishnet", "heart")
	await novel_interface.show_dialog("(Ja! Mehr! Tritt auch auf mir herum! Bitte, meine Königin!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice lächelt und schüttelt den Kopf, als sie den Ausdruck purer Idiotie auf meinem Gesicht sieht, dann legt sie ihr Armband wieder um.")
	await novel_interface.show_text_only("Dann holt sie eine daumengroße Silberkapsel aus ihrer Brust und wirft sie in die wilden Menschenmengen unter ihren Füßen –")
	await novel_interface.show_text_only("In einer Wolke aus weißem Rauch verschwindet die schöne Beatrice spurlos.")
	# scene5 - 逃跑
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN.png")
	await novel_interface.show_text_only("Ich kann ihr atemberaubendes Gesicht jedoch immer noch nicht vergessen – bis Sonya an meinem Arm zieht.")
	novel_interface.show_character("ren_fishnet","heart")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("soya_uniform", "yell", 0.25)
	await novel_interface.show_dialog("Schluss damit! Die Soldaten kommen! Außerdem...", "Soya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als sich der Rauch auflöst, beginnt die Menge verwirrt zu murmeln und erkennt, dass ihr Fokusobjekt nicht mehr da ist.")
	await novel_interface.show_text_only("Sonya und ich schaffen es kaum, ein paar Schritte von der Menge wegzukommen, als Ellukas Fanclub bemerkt, dass ihr ganz persönliches Idol verschwunden ist.")
	await novel_interface.show_dialog("Wo ist Lady Elluka?", "Königliche Garde A")
	await novel_interface.show_dialog("Da drüben! Der in den Netzstrümpfen hat unsere Lady Elluka mitgenommen!", "Königliche Garde B")
	novel_interface.show_character("ren_fishnet", "wry_smile")
	await novel_interface.show_dialog("(Netzstrümpfe? Lady Elluka?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Entführer! Rufen Sie die Polizei!", "Königliche Garde C")
	await novel_interface.show_dialog("Nach ihnen!", "Königliche Garde A")
	await novel_interface.show_text_only("Eine Gruppe wütender Männer stürmt auf uns zu, gefolgt von ein paar Sicherheitspolizisten.")
	await novel_interface.show_text_only("Komm schon, was für ein Entführer trägt Netzstrümpfe?")
	novel_interface.show_character("ren_fishnet", "perspire1")
	await novel_interface.show_dialog("Lauf!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber es fällt uns schwer, die Menge abzuschütteln, vor allem, weil Sonya die dicke Elluka trägt und meine Taille immer noch vor Schmerzen pocht.")
	await novel_interface.show_text_only("Was noch schlimmer ist: Vor Ihnen patrouillieren einige Polizisten ...")
	await novel_interface.show_text_only("Wir können nicht kämpfen. Wir können nicht weglaufen. Es ist aussichtslos.")
	await novel_interface.show_text_only("Plötzlich ertönt hinter uns das Geräusch splitternden Glases.")
	await novel_interface.show_text_only("Ein blonder Mann in einer schwarzen Windjacke hat eine altmodische Leuchtreklame an der Straße umgeworfen.")
	await novel_interface.show_text_only("Die Scherben der Plakatglühbirnen bedecken den Boden. Die Fußgänger, die ihr Bestes geben, ihnen auszuweichen, bremsen Ellukas Fanclub effektiv aus.")
	await novel_interface.show_text_only("Der Blonde lächelt Sonya und mich an, sein Gesicht ist unschuldig und süß.")
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Davor gibt es eine Abkürzung. Komm mit mir?", "Junge mit Brille")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya und ich tauschen Blicke aus. Warum klingt das wie ein Szenario aus einem Film?")
	await novel_interface.show_text_only("Der bebrillte junge Mann mit den flauschigen blonden Haaren, dem karierten Hemd und den azurblauen Augen wirkt eher schüchtern.")
	await novel_interface.show_text_only("Er wirkt fast verlegen über unsere mangelnde Reaktion und beeilt sich zu erklären:")
	novel_interface.show_character("john", "shy")
	await novel_interface.show_dialog("Ich ... ich arbeite Teilzeit in einem Geschäft hier in der Nähe ... ich bin gerade von der Arbeit gekommen ...", "Junge mit Brille")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Er wirft einen Blick auf meine Beine, schluckt und wendet sich ab.")
	novel_interface.show_character("ren_fishnet", "uneasy")
	await novel_interface.show_dialog("(Wow, das ist in der Tat keine gute Möglichkeit, einen Blick auf Mädchen zu werfen ...)\n(Es ist viel zu offensichtlich...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("john", "smile")
	await novel_interface.show_dialog("Du... du sahst aus, als würdest du von ein paar Bösewichten gejagt, also dachte ich...", "Junge mit Brille")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonyas Schulter lässt nach, als sie kurz ihre Deckung nachlässt.")
	novel_interface.show_character("soya_uniform", "smile")
	await novel_interface.show_dialog("Seiner Aura nach zu urteilen, will er uns nicht verletzen.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alles in allem sind WIR hier die Bösewichte ...")
	novel_interface.show_character("soya_uniform", "jest")
	await novel_interface.show_dialog("Gehen Sie voran!", "Soya")
	await novel_interface.hide_character()
	
	print("=== 天启篇第12话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
