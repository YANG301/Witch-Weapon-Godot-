	await novel_interface.show_text_only("Deve essersi fatto male quando ha rovesciato il cartellone pubblicitario. Avrebbe dovuto provare un dolore tremendo, dover camminare con una ferita del genere...")
	await novel_interface.show_text_only("Ma in realtà non sembrava averlo sentito affatto.")

	print("=== 天启篇第13话结束 ===")
	
