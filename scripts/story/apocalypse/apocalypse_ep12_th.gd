# apocalypse_ep12.gd - 天启篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第12话剧本
	apocalypse_ep12_script()

func play_script():
	pass

# 天启篇第12话 - 正式剧本
