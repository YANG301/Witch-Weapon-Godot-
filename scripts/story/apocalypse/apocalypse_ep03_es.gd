# apocalypse_ep03.gd - 天启篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第03话剧本
	apocalypse_ep03_script()

func play_script():
	pass

