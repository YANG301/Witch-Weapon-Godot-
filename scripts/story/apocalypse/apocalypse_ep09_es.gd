	await novel_interface.show_text_only("Sonya me lleva al otro lado de la calle. Me vuelvo para vislumbrar la comisaría, oculta detrás de la cegadora luz blanca de la farola, con las sirenas a todo volumen.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Probablemente se habrán dado cuenta de que hemos escapado...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estamos en territorio internacional y no soy inmune a leyes como las de Sonya. Si los soldados de seguridad me encuentran...")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("(Agresión a agentes de policía, fuga de cárcel, destrucción de bienes públicos...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No importa cómo lo vea, terminaré tras las rejas, vestido con batas de prisión a rayas y revolcándome en la autocompasión...")
	await novel_interface.show_dialog("Oye tú, ¿qué haces ahí?", "Guardia de seguridad")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un policía que patrulla se me acerca. Sólo entonces me doy cuenta de que la desalmada Sonya ha desaparecido entre las sombras.")
	await novel_interface.show_text_only("La policía de seguridad me echa un vistazo con los ojos entrecerrados.")
	await novel_interface.show_dialog("Se están volviendo más jóvenes, eh...\n¡Muéstrame tu identificación!", "Guardia de seguridad")
	novel_interface.show_character("ren_fishnet","awkward")
	await novel_interface.show_dialog("(Debe pensar que soy uno de esos—)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dudo, esperando que Sonya aparezca y lo derribe por mí...")
	await novel_interface.show_text_only("Pero ella no parece interesada en ayudar.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Eh...\nEn realidad...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todo lo que puedo hacer es abofetear mi cara más linda, con los dedos agarrando el dobladillo de mi falda, el miedo y la angustia evidentes en mi voz temblorosa.")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Yo… estoy aquí de compras con mis compañeros… pero me perdí…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Empiezo a fingir sollozar, tratando de parecer lo más inofensivo posible.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Si... si no llego a casa pronto... Mami se preocupará...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Aun así, si regreso sin Elluka, ¡Mariru definitivamente me matará!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El policía ciertamente no esperaba esto. Él mira fijamente, con la mandíbula apretada, y traga.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("(¿Qué diablos estoy haciendo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, el policía de seguridad da un salto hacia adelante, como si le hubieran picado algo en la espalda. Se desploma, revelando a Sonya parada orgullosa detrás de él.")
	await novel_interface.show_text_only("Ella recupera su botón-aguja de su espalda e imita mi voz:")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Si... si no llego a casa pronto... Mami se preocupará...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("¿Por qué no ayudaste antes? ¡Caray!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("¿Y a cuántos policías hemos paralizado hoy? Si nos atrapan...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Si nos atrapan, puedes decir simplemente que te secuestré y te obligué a hacer esto. No pueden hacerme nada de todos modos.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dice Sonya, volviendo a colocar fácilmente el botón en su capa.")
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("¿Qué hay en la aguja?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("Bueno... es extracto de toxina de pez globo. Paraliza los músculos, pero no afecta el corazón ni el sistema de aspiración.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya explica, pareciendo bastante orgullosa.")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("Mientras duren los efectos, el objetivo envenenado no puede moverse ni hablar, pero aún puede pensar y sentir todo lo que está sucediendo.", "Soya")
	novel_interface.change_expression("relieve")
	await novel_interface.show_dialog("¡Un momento perfecto para hacer lo que quieras con ellos!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Por qué se ve tan emocionada?")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("¿No debería Mariru haber confiscado un objeto tan peligroso?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Tch, ella envió a alguien aún más peligroso para cuidarme, ¿no?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Oh... Elluka...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se hace tarde. No puedo evitar preocuparme al saber que la pequeña Elluka deambula sola por las calles.")
	novel_interface.show_character("soya_uniform","normal")
	await novel_interface.show_dialog("¿Deberíamos comprobar Electronics Street? Parece que hay una conmoción allí.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya fija su mirada en la calle iluminada con luces de neón a lo lejos, donde las auras de la multitud reunida parecen brillar con un color anormal.")
	await novel_interface.hide_background()
	novel_interface.change_music("")
	await novel_interface.show_text_only("<Mientras tanto, dentro de la Zona Desmilitarizada Acordada>")
	await novel_interface.show_text_only("<Hotel del cielo>")
	
