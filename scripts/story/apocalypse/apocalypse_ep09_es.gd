	await novel_interface.show_dialog("Después de todo—", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Nosotros somos los que inventamos las elecciones.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert levanta su vaso hacia Miller y bebe su bebida de un trago.")

	print("=== 天启篇第09话结束 ===")
	
