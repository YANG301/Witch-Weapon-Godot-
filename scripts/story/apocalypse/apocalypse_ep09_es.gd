	novel_interface.show_background("res://assets/images/bg/SkyHotel/Soya_Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("Un anciano con túnica blanca de sacerdote llega al salón. Les dice a sus dos jóvenes asistentes que esperen en la entrada.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Debes estar cansado de viajar desde Chennai. Permítame felicitarlo por su ascenso, Arzobispo Miller de la Iglesia Anglicana del Sur de la India.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Ah, Lumberto. Estoy seguro de que ya sabes todo lo que pasó hoy...", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El arzobispo con sobrepeso suspira mientras se sienta en una silla.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Ya expresé mi apoyo a la Tercera Ciudad Academia hace algún tiempo—", "Lumbert")
	novel_interface.change_expression("usually")
	await novel_interface.show_dialog("Pero ciertamente no esperaba que hicieran un anuncio sobre el sistema de respuesta pasiva en este momento. Y el orador se suicidó inmediatamente después...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("¿Quizás “ciertas personas” quieren que la noticia salga durante la reunión a puerta cerrada?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Todavía no podemos estar seguros de si hay alguien detrás de todo esto, pero hasta donde yo sé, no es idea del Primer Ministro Scheinermann.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Incluso si ignoramos el desafortunado momento del anuncio, el hecho de que este sistema haya sido construido ya significa muchas cosas. Estoy seguro de que lo entiendes, ¿eh?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Eso es lo que me trajo a verte hoy.", "Lumbert")
	novel_interface.change_expression("usually")
	await novel_interface.show_dialog("Ellos voluntariamente renunciaron al acceso a la Sustancia H de grado militar y en su lugar la aplicaron a un sistema de respuesta pasiva sobre el cual el propio país no tiene control...", "Lumbert")
	await novel_interface.show_dialog("Eso, junto con la situación financiera actual de Masada Ford, nos dice...", "Lumbert")
	novel_interface.change_expression("sedation")
	await novel_interface.show_dialog("Este país realmente debe haberse cansado de la guerra.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("En primer lugar, es culpa suya que la Resistencia existiera.", "Miller")#文字错误
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El arzobispo Miller sacude la cabeza con un bufido.")
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Aun así, si el Primer Ministro Scheinermann ordena el desarme, la gama sobre la que Masada Ford tiene control disminuirá de tamaño. En ese caso, probablemente ya no tendrán poder sobre la península del Sinaí.", "Lumbert")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Eso no es ideal, ¿verdad?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("¿Quieres decir... que perderán el Canal de Suez?", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
	await novel_interface.show_dialog("Estoy seguro de que ni el Dr. Deckers ni Su Santidad estarían dispuestos a ceder el Canal a otra persona.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert sonríe y se recuesta en la silla.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Espero encontrar un método de transporte que siga siendo seguro y confiable, de modo que Masada Ford tenga suficientes recursos y poder para mantener la paz en Asia occidental.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El arzobispo Miller asiente en silencio.")
	novel_interface.show_character("lambert","serious")
	await novel_interface.show_dialog("Con el acuerdo internacional actual, África y América del Sur son los únicos lugares donde Masada Ford puede exportar sus “soluciones de defensa nacional”.", "Lumbert")
	await novel_interface.show_dialog("Mientras tanto, a las naciones miembros del Congreso Unido y sus áreas subordinadas no se les permite comprarles. La falta de ingresos dificulta mantener en funcionamiento el ejército de defensa de Masada Ford.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Pero si el cabeza de mula Scheinermann realmente decide el desarme...", "Miller")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Él ya es viejo", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert interrumpe.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Pero su hijo y sus sobrinos todavía ocupan puestos en el ejército de defensa.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert hace una pausa deliberadamente y Miller rompe el silencio después de pensar un poco.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Scheinermann ya ha prometido nuevas elecciones tras su dimisión. Estoy seguro de que lo sabes.", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert levanta su copa y contempla las sombras de bambú que se balancean en la pared del salón. En realidad, aquí no hay bambúes; es simplemente un efecto creado por las luces.")
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("No se puede mantener el poder sin ganarse la confianza del público. Y para ganarse su confianza, primero tendrás que ganarte su corazón.", "Lumbert")
