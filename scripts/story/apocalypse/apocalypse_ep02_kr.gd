# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

