# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Las imágenes de la misión de rescate de rehenes aparecen en todas las noticias del viernes por la mañana.")
	await novel_interface.show_text_only("Como el SID cerró todas las rutas de escape en la zona cubierta por el Aegis, los secuestradores no tuvieron más remedio que mantener temporalmente a sus rehenes en un almacén abandonado.")
	await novel_interface.show_text_only("Han sido detenidos cuatro terroristas, sospechosos de secuestrar a un alto mando del Consejo Unido. Un final satisfactorio para este incidente.")
	await novel_interface.show_dialog("Asesinato y secuestro a plena luz del día en un territorio internacional: ¡es como si estuvieran pidiendo la guerra con todas las naciones miembros del Congreso Unido!", "Lumbert")
	await novel_interface.show_dialog("Este incidente es evidencia de cómo el terrorismo está a nuestro alrededor. Las recientes actividades de Spacetime Flux también pueden tener algo que ver con los terroristas.", "Lumbert")
	await novel_interface.show_dialog("Como superviviente de la guerra, creo firmemente que la intimidación es un medio importante para garantizar la seguridad y la paz.", "Lumbert")
	await novel_interface.show_text_only("Me burlo mientras me salto la entrevista, que obviamente es una tontería escrita, mientras mastico la octogésima papa frita en una hora.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Este tipo… ¿casi muere? (mastica mastica)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Sí. ¿No lo rescataron hace apenas unas horas? Y ya está dando un discurso. Mmm. Sospechoso...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Aún así, esa parte con los helicópteros y el equipo de rescate fue bastante ruda. Casi como una película.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mmm, ¡qué genial!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka asiente con rostro solemne.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Es principalmente una edición excelente y una música de fondo excelente. ¿A quién no le gustan los efectos cinematográficos, verdad?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Debido al importante evento que se celebra en la ciudad, las clases empiezan bastante tarde estos días, alrededor de las diez y media. Además salimos de clases mucho antes.")
	await novel_interface.show_text_only("Annie, Elluka y yo estamos acurrucadas juntas en el sofá como pequeños hámsteres, compartiendo patatas fritas (más bien como si Annie me las hubiera robado).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("¿No fue la información de inteligencia del SID la razón principal por la que el rescate fue tan exitoso?\nLa noticia ni siquiera nos dio crédito...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Después de todo, las agencias de inteligencia necesitan el anonimato para sobrevivir. Tengo que pasar desapercibido.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Señorita Ren...\nQuieres chocolate...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La pequeña cabeza de Elluka asoma de repente entre Annie y yo.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¿Pocky de chocolate?\nLa tienda de abajo parece haberse agotado. Lo compramos todo.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Te traeré más la próxima vez que vayamos al supermercado.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Pero... lo quiero... ahora...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka hace pucheros, sacude la caja vacía frente a mi cara y su labio inferior tiembla.")
	await novel_interface.show_text_only("Pero ahora hace demasiado calor para salir. Lo único que quiero es quedarme en casa, disfrutar del aire acondicionado y ser una patata.")
	await novel_interface.show_text_only("Mariru ha estado ocupada estos días. Después de todo, toneladas de figuras importantes han llegado a la Zona Desmilitarizada Acordada para asistir al Cuarto Foro Internacional de Paz.")
	await novel_interface.show_text_only("La escala del Foro de este año es realmente impresionante. Las cinco Ciudades Academia además de Nueva Opulentia han enviado cientos de representantes.")
	await novel_interface.show_text_only("Para empezar, una conferencia de líderes gubernamentales de alto nivel. Naturalmente, ha causado muchos problemas en la vida cotidiana de la gente.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Muchas zonas de la ciudad son ahora zonas temporales libres de bicicletas. Realmente un inconveniente para nosotros a la hora de realizar el pedido de entrega.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie se queja mientras navega por su teléfono, tumbada desordenadamente en el sofá.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Bien, bien, iré a buscarles algunos bocadillos.\nAnnie, ¿necesitas que traiga algo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Jeje...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Los dos rápidamente enumeran docenas de artículos, pareciendo totalmente engreídos.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("¿Por qué hace tanto calor?", "Lian")
	await novel_interface.show_dialog("me estoy derritiendo...", "Lian")
	await novel_interface.show_text_only("Todavía es temprano, el supermercado acaba de abrir, pero afuera ya hace un calor sofocante.")
	await novel_interface.show_text_only("Camino con dificultad, cargando una enorme bolsa de comida chatarra. Parece que estos días hay mucho personal de seguridad dando vueltas en las calles.")
	await novel_interface.show_text_only("Se han establecido muchas zonas de restricción de transporte. Los ciudadanos deben portar su documento de identidad en todo momento.")
	await novel_interface.show_text_only("En todas las estaciones de transporte público se pueden encontrar coches de policía y asistentes de seguridad.")
	await novel_interface.show_text_only("El transporte está mayormente restringido en la Zona Desmilitarizada Acordada. Se han instalado nuevos dispositivos de vigilancia en todas las farolas de la vía principal.")
	await novel_interface.show_text_only("Escuché que, dado que la ciudad no tiene suficientes soldados de seguridad, el Congreso Unido tiene que contratar a todos los mercenarios que Ritnalap tiene para ofrecer.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Aun así, supongo que es comprensible estar alerta...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro hacia abajo desde el cruce elevado y veo pasar a un grupo de manifestantes. Un camarógrafo de algún canal de noticias los sigue, filmando la procesión.")
	await novel_interface.show_text_only("No ha pasado mucho tiempo desde que terminó la guerra. Naturalmente, todo tipo de organizaciones, grupos y canales de medios estarían entusiasmados de encontrar una audiencia en New Opulentia durante un evento tan importante.")
	await novel_interface.show_text_only("Todas las organizaciones tienen objetivos diferentes: conflictos regionales, cuestiones raciales, problemas de refugiados, opresión religiosa, problemas económicos... lo que sea, hay una organización que está gritando al respecto.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Incluso hay grupos misioneros aquí que buscan nuevos seguidores. ¿No podrían haber elegido un período menos caótico para hacerlo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Según me dijo Mariru, los últimos tres Foros Internacionales de Paz tampoco transcurrieron sin problemas.")
	await novel_interface.show_text_only("El anterior se iba a celebrar en Masada Ford, pero tuvieron que trasladarse a Salmonton debido a los frecuentes ataques terroristas en las fronteras.")
	await novel_interface.show_text_only("Luego, el Dr. Deckers anunció de la nada en el Foro del año pasado que Salmonton ahora abriría sus puertas a todos los refugiados. Eso provocó muchos gritos y disturbios, por supuesto.")
	await novel_interface.show_text_only("Raphilia había hecho un comentario políticamente incorrecto después, razón por la cual su familia terminó enviándola a Nueva Opulentia.")
	await novel_interface.show_text_only("En cuanto al año anterior... los terroristas bombardearon una manzana entera en Newmoridas. Incluso enviaron helicópteros militares.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Eso debe haber sido horrible...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Hace dos días, Skuld fue invitado a un evento benéfico en el área de la embajada e hizo una generosa donación para los niños hambrientos en América del Sur.")
	await novel_interface.show_text_only("Casualmente, una organización vegana de Europa estaba protestando por la matanza de animales fuera del lugar.")
	await novel_interface.show_text_only("Algunos de ellos se desnudaron y quedaron tendidos en el suelo, simulando trozos de carne.")
	await novel_interface.show_text_only("Vimos a una criada verter una olla de salsa violácea, completa con tentáculos de calamar, sobre un “filete” de la cobertura en vivo por televisión.")
	await novel_interface.show_text_only("El desafortunado “filete” se alejó a cuatro patas, chirriando a todo pulmón.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("Y hoy, el sitio web oficial de la organización publicó un comunicado afirmando que sus miembros han quedado gravemente traumatizados.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Jajaja...\n(¡Espero que Fabella se dé cuenta de lo terrible que es su cocina ahora!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, mi teléfono vibra en mi bolso.\nMariru ha enviado un mensaje.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Mmm. Preséntate hoy en el cuartel general, ¿eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Hace diez horas>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, sala de control SID>")
	await novel_interface.show_text_only("Una mujer pelirroja vestida de militar está de pie con los brazos cruzados sobre el pecho, mirando fijamente la docena de corchetes rojos que se mueven rápidamente en la pantalla en blanco y negro.")
	await novel_interface.show_text_only("De repente aparece una ventana de chat en la parte inferior de la pantalla.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Jefe, según nuestros registros, el rehén Sir Lumbert todavía se encuentra en algún lugar cubierto por la Égida.", "Agente SID")
	await novel_interface.show_dialog("Nuestro análisis de seguimiento de vigilancia nos dice que lo más probable es que el secuestrador se encuentre en una de estas tres áreas. Un almacén abandonado en el Área de la Bahía ha estado mostrando una actividad anormal de consumo de electricidad...", "Agente SID")
	await novel_interface.show_dialog("¿Deberíamos informar a la Oficina de Defensa?", "Agente SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Todavía no. Rodea el área y espera mis órdenes.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Entendido eso.", "Agente SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al cerrar la ventana, Mariru cambia al canal de chat militar.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("La zona montañosa está más adelante. Mantén el helicóptero a una altitud segura, que no nos noten.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lo tengo. Tenemos imágenes claras del satélite sensor de calor.", "Soldado A")
	await novel_interface.show_dialog("Se están moviendo tan rápido... ¿son realmente humanos?", "Soldado A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Técnicamente… alguna vez fueron humanos. Simplemente ya no.", "Marirú")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("¿Han sido evacuados todos los que se encuentran en la dirección en la que se dirigen? Si ocurre algo anormal—", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nuestros cañones y armas de destrucción regional están listos.", "Soldado B")
	await novel_interface.show_text_only("Mariru asiente. No quiere filtrar demasiado a los militares.")
	await novel_interface.show_text_only("Además, ha tenido un mal presentimiento sobre esto desde el comienzo de esta misión de rastreo...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Por lo general, nos ocupamos de esas “brujas” que aparecen en las afueras del centro de Nueva Opulentia aniquilándolas por la fuerza con las armas de fuego pesadas que los militares han colocado en el área de antemano).", "Marirú")
	await novel_interface.show_dialog("(Según experiencias pasadas, esas cosas generalmente atacan aleatoriamente a seres vivos o instalaciones cercanas después de que sus capullos de bruja desaparecen).", "Marirú")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Pero durante las últimas dos semanas, parecen estar mostrando una especie de patrón idéntico...)", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Espera... ¡hay alguien más adelante!", "Soldado A")
	await novel_interface.show_dialog("Llevando también una motosierra. ¿Quizás un leñador?", "Soldado B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiota, ¿qué leñador trabaja a las once?\n¿Cuáles son los resultados de la prueba de memes?", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Verde. ¡Es humano!", "Soldado A")
	await novel_interface.show_dialog("Y... ¿una chica humana también?", "Soldado B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru inmediatamente hace zoom en las imágenes capturadas.")
	await novel_interface.show_text_only("En la pantalla termográfica, hay una niña con un pañuelo y una motosierra casi tan grande como ella.")
	await novel_interface.show_text_only("Y ella está saludando a esas brujas veloces y gallardas.")
	await novel_interface.show_text_only("Las brujas líderes, alertadas por el sonido de la motosierra, cambian de rumbo y conducen la manada en su dirección.")
	await novel_interface.show_text_only("Una colonia de brujas de este tamaño normalmente sólo puede ser derrotada por un escuadrón de portadores de ametralladoras experimentados y fuertemente armados. La chica no tiene ninguna posibilidad.")
	await novel_interface.show_text_only("Pero antes de que Mariru pueda alertar al equipo de limpieza para que recojan el cadáver de la niña más tarde, la niña simplemente se gira hacia las brujas, sonriendo, con una motosierra en la mano.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ella ajusta su ritmo y postura mientras innumerables brujas pasan a toda velocidad, esquivando sus ataques hábilmente y al mismo tiempo separando a las brujas entrantes.")
	await novel_interface.show_text_only("Las brujas, como carne fresca metida en una trituradora de alta resistencia, terminan como pequeños trozos de carne.")
	await novel_interface.show_text_only("La niña se mueve y ataca suavemente, utilizando las leyes de la inercia y la fuerza centrífuga a su favor. No parece ser extraordinariamente fuerte, sólo tiene la física de su lado.")
	await novel_interface.show_text_only("Probablemente había hecho algunos cálculos de antemano y seleccionado la motosierra como el arma más efectiva según las características de los objetivos y su propia fuerza.")
	await novel_interface.show_text_only("En treinta segundos, esas decenas de brujas, a las que el SID y los militares llevaban cuatro días siguiendo la pista, ya no son más que carne desmenuzada.")
	await novel_interface.show_dialog("¿Q-qué hacemos ahora?", "Soldado A")
	await novel_interface.show_text_only("Mariru suspira.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Maldita sea...", "Marirú")
	await novel_interface.show_dialog("Focos encendidos. Misil Hellfire listo—", "Marirú")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Intenta hablar con ella por un altavoz. Dile que está rodeada. Si se atreve a moverse, hazla pedazos junto con esta montaña.", "Marirú")
	await novel_interface.show_dialog("¡Tráela de vuelta con vida!", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<Unas horas más tarde, sala de interrogatorios del SID>")
	await novel_interface.show_text_only("Junto al espejo unidireccional, Mariru hojea el archivo del objetivo en su dispositivo portátil.")
	await novel_interface.show_text_only("Nombre: Sonya Ángeles")
	await novel_interface.show_text_only("Edad: 14...?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organización...", "Marirú")
	await novel_interface.show_dialog("Distrito Especial de la Iglesia Salmonton, CDF.", "Marirú")
	await novel_interface.show_dialog("Solía ser un tribunal religioso, ¿verdad?", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru toca un botón y el cristal se aclara. Una chica vestida de monja la recibe con ojos silenciosos y dóciles al otro lado.")
	await novel_interface.show_text_only("Su pequeño cuerpo está oculto bajo su pesado vestido de terciopelo negro, sujeto con un broche rojo oscuro.")
	await novel_interface.show_text_only("En lugar de un sombrero de monja, tiene un par de orejas de gato en la cabeza. Parece que le sienta bien.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Cabello plateado largo y liso, ojos azules. Debería haber sido lindo, pero esa sonrisa inquietantemente fría e indiferente en su rostro: aguda, escalofriante.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hojea los informes relacionados y nota la fila de letras rojas en la parte inferior.")
	await novel_interface.show_text_only("Esta persona está protegida bajo las condiciones especiales del Acuerdo de Salmonton y no puede ser retenida por ninguna organización perteneciente a una nación miembro del Congreso Unido durante más de doce horas.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Oye. La orden de investigación que los militares de Nueva Opulentia tienen contra usted ya está cancelada.", "Marirú")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("¿Ah? Bien.\n¡Estaba tan asustado!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Ellos deberían ser los que tengan miedo. Ese soldado que acaba de traerte incluso solicitó una operación de eliminación de memoria de grado C...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica de cabello plateado, con las manos encadenadas, se lame los labios y sonríe de emoción.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Eh, apestaban muchísimo, ¿sabes? Pero ni siquiera les hice daño.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("De todos modos, ¿vas a interrogarme? ¡Al menos hueles muy bien!", "Soya")# 换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña estudia a Mariru con mucho interés.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("¿Ah? Sonia, ¿verdad?", "Marirú")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Interrogar a la gente es mi... “experiencia”.", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru también comienza a verse emocionada.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Pero aún así, antes de eso...", "Marirú")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica ladea la cabeza y observa a Mariru sacar su identificación de una bolsa con inocente curiosidad.")
	await novel_interface.show_text_only("La tarjeta está enmarcada en un patrón elegante de estilo retro, completamente diferente al de las tarjetas de identificación de Ciudad Academia. La tarjeta en sí es negra y tiene tallados símbolos dorados que representan el tribunal religioso.")
