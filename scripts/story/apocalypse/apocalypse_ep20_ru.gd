# apocalypse_ep20.gd - 天启篇第20话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第20话剧本
	apocalypse_ep20_script()

func play_script():
	pass

# 天启篇第20话 - 正式剧本
func apocalypse_ep20_script():
	# 开场宇宙哲学思考
	novel_interface.show_background("res://assets/images/bg/Soya/Universe.png")
	await novel_interface.show_text_only("Раньше меня привлекали эпически звучащие, весьма творческие теории.")
	await novel_interface.show_text_only("На самом деле люди — это мозги, плавающие в резервуаре для культивирования. Мы не что иное, как простые симуляции. Вся планета создана как детский эксперимент. Подобные теории.")
	await novel_interface.show_text_only("Я был зависим от этих идей. Опьяненный. От них у меня мурашки по коже.")
	await novel_interface.show_text_only("Пока однажды я не начал задаваться вопросом...")
	await novel_interface.show_text_only("Этот резервуар для выращивания, тот программист, создавший симуляцию, тот ребенок, который проводил эксперимент... в каком мире ОНИ живут?")
	await novel_interface.show_text_only("Разве мы все не заперты в одной и той же вселенной, и у нас нет возможности выбраться?")
	await novel_interface.show_text_only("Как в песне из «Отеля Калифорния»: вы можете выехать в любой момент, когда захотите, но никогда не сможете уйти.")
	await novel_interface.show_text_only("Когда боги смотрят в звездное небо, разве они не испытывают того же любопытства, трепета и страха, что и мы?")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Рен!")
	
	# 小怜醒来
	novel_interface.show_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("—!", "Лиан")
	await novel_interface.show_text_only("Открываю глаза на какой-то сильный, резкий запах и оказываюсь на мягком матрасе.")
	await novel_interface.show_text_only("Ая стоит рядом со мной, нюхая соль в руке, а Мариру маячит в изножье кровати и снимает меня на телефон.")
	await novel_interface.show_dialog("А?", "Лиан")
	await novel_interface.show_text_only("Я быстро вытираю слюни и сопли с лица, с ужасом замечая большое мокрое пятно на подушке.")
	await novel_interface.show_text_only("Ощущение, будто я долго спал. И приснился очень грустный сон...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Ты выглядишь очаровательно, когда спишь!", "Ай")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру улыбается, убирает телефон и подходит ближе, кладя руку мне на лоб.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Сегодня суббота. Вы отсутствовали более десяти часов.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Так долго? Подожди, где мы?", "Лиан")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("О нет, Соня!", "Лиан")
	await novel_interface.hide_character()
	
	# 回忆爆炸
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N2.png")
	await novel_interface.show_text_only("Вот тогда все это возвращается ко мне. Светящийся огненный шар, который когда-то был военным вертолетом. Спускаясь по спирали к земле, исчезая за величественным силуэтом церкви.")
	await novel_interface.show_text_only("Я помню, как стоял как вкопанный, глаза были прикованы к огню и густому дыму. Я бы закричала, но у меня было такое чувство, словно что-то застряло у меня в горле.")
	await novel_interface.show_text_only("А через несколько секунд раздался еще один, еще более громкий хлопок..")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Вы были нокаутированы ударом взрыва.", "Ай")
	novel_interface.show_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Топливный бак вертолета взорвался высоковольтной электрической дугой. Эльгана и пятеро солдат внутри сгорели дотла.", "Ай")
	await novel_interface.show_dialog("Дубликат Небесной Двери теперь представляет собой не более чем груду пепла. А как только его разрушили, абажуры на улицах потеряли свою эффективность.", "Ай")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая имеет наглость показаться разочарованным.")
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("А Соня? С ней все в порядке?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Все присутствовавшие агенты видели, как она вошла в вертолет. И никто не заметил, как она оставила его во время крушения...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мое сердце замирает.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Но есть хорошие новости. Среди обломков ее трупа не нашли. Она должна была держать батарею, когда произошел взрыв, но они вообще не смогли обнаружить никаких ее биологических останков.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Э?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Солдаты, разбиравшие обломки, были не из СИД, но их информация должна быть достоверной.", "Мариру")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ведь мы им угрожали драгоценной маленькой дочкой командира силовика...", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру сияет от гордости.")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(Было ли это необходимо?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Кроме того, наши браслеты очень прочные и усилены веществом H. Они должны остаться неповрежденными даже при взрыве такого размера. Но сигнал с Сониного браслета пропал...", "Ай")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая делает паузу и смотрит на Мариру.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Это было как в тот раз, когда Рен исчез из Ковчега...", "Ай")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не могу не напрячься, как только она упоминает это место.")
	await novel_interface.show_text_only("Раньше Ковчег представлял собой сложную подземную канализационную систему, масштабно построенную еще до войны. Мариру переоборудовала его в подземную лабораторию на средства Сената.")
	await novel_interface.show_text_only("Там я вызвал Генриетту Кунрат, алхимика, родом из шестнадцатого века.")
	novel_interface.change_background("res://assets/images/bg/Baizhu/CauseAndEffect.png")
	await novel_interface.show_text_only("И тут мы вдвоем попали в Разлом Соответствий — мистическое пространство, где понятия времени и ориентации больше не применяются.")
	await novel_interface.show_text_only("Когда нам наконец удалось выйти из космоса, мы оказались в Антарктиде.")
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Пусть планы Сони пошли не совсем так, как она хотела, возможно, у нее еще есть шанс...", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Шанс...? Значит, она все еще может быть жива?\nМогу ли я чем-нибудь помочь?", "Лиан")
	await novel_interface.show_dialog("И... ее планы? Что ты имеешь в виду?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру вздыхает, нежно покачивая головой в ответ на мои быстрые вопросы.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("О, так ты не знал?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Не знал что?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Те браслеты, которые вы носили... они были созданы специально для условно-досрочно освобожденных заключенных. Чтобы убедиться, что они не смогут сбежать.", "Мариру")
	await novel_interface.show_dialog("Естественно, они все прослушиваются. Я слышал все, что говорила Соня.", "Мариру")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Соня это определенно знала.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я киваю, все еще в замешательстве.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Помните, что произошло вчера?", "Мариру")
	await novel_interface.show_dialog("Когда вы втроем вместе ходили по магазинам, Соня очень внимательно наблюдала за вами и Эллукой.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Верно. Она даже рассказала Рафилии о своих открытиях, когда мы были в художественной галерее...)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Когда Рен видит на улице симпатичную девушку, она начинает светиться розовым. Она изо всех сил старается не пялиться, но глазные яблоки всегда ее выдают...", "Соя")
	await novel_interface.show_dialog("Иногда она делает вид, что смотрит вдаль за спиной девушки, а затем поворачивает голову в другую сторону в надежде, что она не будет выглядеть гадкой.", "Соя")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("А после того, как вы покинули картинную галерею, она навязалась вам, требуя узнать больше о ведьмах и гримуарах.", "Мариру")
	await novel_interface.show_dialog("Именно тогда она рассказала, как церковь обращается с фрагментами гримуара, оставленными ведьмами.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Гримуар? Это что-то вроде книги?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Глаза Сони расширяются, как будто она вдруг что-то поняла.")
	novel_interface.show_character("soya_uniform","trance")
	await novel_interface.show_dialog("Я помню, как иногда видел бумажки, летающие вокруг, когда имел дело с ведьмами...", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня вспоминает.")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Но монахини в аббатстве всегда говорили, что они могут заразить людей, и сотрудники тюрьмы собирали их всех и сжигали в кучу во время уборки места происшествия.", "Соя")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Тюрьма...?\n(Слышал ли я этот термин раньше?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("А потом вы, ребята, встретились с Беатрис на улице Электроники. Соня заметила, что и от тебя, и от Беатрис пахло «чистотой»…", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая вдруг вмешивается:")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Я тоже это заметил! Содержание радионуклидов в телах Рена и Беатрис даже ниже того, которое новорожденный должен был унаследовать от матери.", "Ай")
	novel_interface.change_2nd_expression("dizzy")
	await novel_interface.show_dialog("Означает ли это, что подобные научные вещи действительно могут обнаружить люди с синестезией?\nОго, я бы с удовольствием провел эксперимент...", "Ай")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Во всяком случае, Соня рассказала все вышеперечисленное, зная, что я услышу. Поэтому, когда она рассказала о своих условиях перед входом в церковь, я уже мог догадаться, что она, должно быть, планировала. И я просто следовал плану...", "Мариру")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру гладит меня по голове, а я продолжаю смотреть, как всегда смущенный.")
	novel_interface.show_character("liliu_research","happy")
