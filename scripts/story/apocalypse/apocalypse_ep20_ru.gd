	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Church_N_Door.png")
	novel_interface.show_character("el","normal")
	await novel_interface.show_dialog("Соня, это ты открыла секретный ящик, запечатанный в тюрьме?", "Эльгана")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","worry")
	await novel_interface.show_dialog("…", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("el","normal")
	await novel_interface.show_dialog("Ты всегда был любопытным, да...", "Эльгана")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Lounge.png")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Спутник зафиксировал внезапный поток пространства-времени в Мемориальной церкви Новой Опулентии в течение тех пяти секунд, когда Соня открывала коробку.", "Ай")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Она заставила кокон ведьмы испариться в одно мгновение... весьма талантливо!", "Ай")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("И после этого, когда Беатрис позвонила вам по телефону, Соня задала ей несколько вопросов, чтобы подтвердить свою личность.", "Мариру")
