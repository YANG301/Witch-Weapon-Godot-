# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Les images de la mission de sauvetage des otages sont omniprésentes dans les journaux télévisés du vendredi matin.")
	await novel_interface.show_text_only("Le SID ayant fermé toutes les voies de fuite dans la zone couverte par l'Aegis, les ravisseurs n'ont eu d'autre choix que de garder temporairement leur otage dans un entrepôt abandonné.")
	await novel_interface.show_text_only("Quatre terroristes, soupçonnés d'avoir enlevé un haut responsable du Conseil unifié, ont été arrêtés. Une fin satisfaisante à cet incident.")
	await novel_interface.show_dialog("Meurtres et enlèvements en plein jour sur un territoire international : c’est comme s’ils demandaient la guerre à tous les pays membres du Congrès uni !", "Lumbert")
	await novel_interface.show_dialog("Cet incident montre à quel point le terrorisme est omniprésent autour de nous. Les récentes activités de Spacetime Flux pourraient également avoir quelque chose à voir avec les terroristes.", "Lumbert")
	await novel_interface.show_dialog("En tant que survivant de la guerre, je crois fermement que l'intimidation est un moyen important d'assurer la sécurité et la paix.", "Lumbert")
	await novel_interface.show_text_only("Je me moque en sautant l'interview, qui est évidemment une connerie scénarisée, pendant que je grignote la quatre-vingtième chips en une heure.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Ce gars... est-ce qu'il est sur le point de mourir ? (Munch, munch)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ouais. Ne l'ont-ils pas sauvé il y a quelques heures à peine ? Et il prononce déjà un discours. Hmm. Suspect...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Pourtant, cette partie avec les hélicoptères et l’équipe de secours était plutôt dure à cuire. Presque comme un film.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Mm, c'est trop cool !", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka hoche la tête, le visage solennel.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("C’est surtout un excellent montage et une excellente musique de fond. Qui n’aime pas les effets cinématographiques, n’est-ce pas ?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En raison de l'événement important qui se déroule dans la ville, l'école commence assez tard ces jours-ci, vers dix heures trente. Nous quittons également les cours beaucoup plus tôt.")
	await novel_interface.show_text_only("Annie, Elluka et moi sommes tous recroquevillés sur le canapé comme des petits hamsters, partageant des chips (plutôt comme si Annie me les avait volés).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Les renseignements du SID ne sont-ils pas la principale raison du succès du sauvetage ?\nLes nouvelles ne nous ont même pas crédités...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Après tout, les agences de renseignement ont besoin de l’anonymat pour survivre. Je dois voler sous le radar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Mademoiselle Ren...\nTu veux du chocolat...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La petite tête d’Elluka surgit soudain entre Annie et moi.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Des Pocky au chocolat ?\nLe dépanneur en bas semble être épuisé. Nous avons tout acheté.", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Je t'en apporterai un peu plus la prochaine fois que nous irons au supermarché.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Mais... je le veux... maintenant...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka fait la moue, secouant la boîte vide devant mon visage, la lèvre inférieure tremblante.")
	await novel_interface.show_text_only("Mais il fait trop chaud pour sortir maintenant. Tout ce que je veux, c'est rester à l'intérieur, profiter de la climatisation et être une pomme de terre.")
	await novel_interface.show_text_only("Mariru a été occupée ces jours-ci. Après tout, des tonnes de personnalités importantes sont arrivées dans la zone démilitarisée agréée pour assister au quatrième Forum international de la paix.")
	await novel_interface.show_text_only("L'ampleur du Forum cette année est vraiment impressionnante. Les cinq villes académiques, outre New Opulentia, ont chacune envoyé des centaines de représentants.")
	await novel_interface.show_text_only("Une conférence de dirigeants gouvernementaux de haut niveau pour démarrer. Naturellement, cela a causé de nombreux problèmes dans la vie quotidienne des gens.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("De nombreux quartiers de la ville sont désormais des zones temporaires sans vélo. Vraiment gênant pour nous lors de la commande de livraison.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie se plaint alors qu'elle fait défiler son téléphone, affalée sur le canapé en désordre.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Très bien, je vais vous chercher des collations.\nAnnie, tu veux que j'apporte quelque chose ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Héhé...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Mwahaha…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tous deux énumèrent rapidement des dizaines d'articles, l'air totalement suffisants.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Pourquoi fait-il si chaud ?", "Lian")
	await novel_interface.show_dialog("Je fond...", "Lian")
	await novel_interface.show_text_only("Il est encore tôt, le supermarché vient d’ouvrir, mais il fait déjà une chaleur étouffante dehors.")
	await novel_interface.show_text_only("J’avance péniblement, trimballant un énorme sac de malbouffe. Il semble y avoir beaucoup d’agents de sécurité qui circulent dans les rues ces jours-ci.")
	await novel_interface.show_text_only("De nombreuses zones de restriction de transport ont été établies. Les citoyens doivent toujours avoir sur eux une carte d'identité.")
	await novel_interface.show_text_only("Des voitures de police et des agents de sécurité se trouvent à chaque station de transports publics.")
	await novel_interface.show_text_only("Les transports sont principalement restreints dans la zone démilitarisée agréée. De tout nouveaux dispositifs de surveillance ont été installés sur tous les lampadaires de l'artère principale.")
	await novel_interface.show_text_only("J’ai entendu dire que, comme la ville ne dispose pas de suffisamment de soldats de sécurité, le Congrès uni doit embaucher tous les mercenaires que Ritnalap a à offrir.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Pourtant, je suppose qu'il est compréhensible d'être vigilant...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je regarde depuis le carrefour surélevé pour voir un groupe de manifestants passer. Un caméraman d'une chaîne d'information les suit et filme le cortège.")
	await novel_interface.show_text_only("Il n’y a pas longtemps que la guerre est terminée. Naturellement, toutes sortes d’organisations, de groupes et de médias seraient ravis de trouver un public à New Opulentia lors d’un événement aussi important.")
	await novel_interface.show_text_only("Les organisations ont toutes des objectifs différents : conflits régionaux, problèmes raciaux, problèmes de réfugiés, oppression religieuse, problèmes économiques... vous l'appelez, il y a une organisation qui le crie.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Il existe même des groupes missionnaires ici à la recherche de nouveaux adeptes. N’auraient-ils pas pu choisir une période moins chaotique pour faire cela ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("D’après ce que Mariru m’a dit, les trois derniers Forums internationaux de paix ne se sont pas non plus déroulés sans heurts.")
	await novel_interface.show_text_only("Le précédent devait avoir lieu à Masada Ford, mais ils ont dû déménager à Salmonton en raison des fréquentes attaques terroristes aux frontières.")
	await novel_interface.show_text_only("Puis, de nulle part, lors du Forum de l’année dernière, le Dr Deckers a annoncé que Salmonton ouvrirait désormais ses portes à tous les réfugiés. Bien entendu, cela a provoqué de nombreux cris et émeutes.")
	await novel_interface.show_text_only("Raphilia avait ensuite fait un commentaire politiquement incorrect, c'est pourquoi sa famille a fini par l'envoyer à New Opulentia.")
	await novel_interface.show_text_only("Quant à l'année d'avant... les terroristes ont bombardé tout un quartier de Newmoridas. Même envoyé des hélicoptères militaires.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Cela a dû être horrible...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Il y a deux jours, Skuld a été invité à un événement caritatif dans le quartier de l'ambassade et a fait un généreux don aux enfants affamés d'Amérique du Sud.")
	await novel_interface.show_text_only("Par coïncidence, une organisation végétalienne européenne protestait contre l’abattage d’animaux à l’extérieur du lieu.")
	await novel_interface.show_text_only("Certains d'entre eux se sont déshabillés et gisaient sur le sol, simulant des morceaux de steak.")
	await novel_interface.show_text_only("Nous avons vu une femme de ménage verser un pot de sauce violacée, complétée par des tentacules de calamar, sur un « steak » de la couverture en direct à la télévision.")
	await novel_interface.show_text_only("Le malheureux « steak » s’est mis à quatre pattes en hurlant à pleins poumons.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("Et aujourd’hui, le site officiel de l’organisation a publié une déclaration affirmant que ses membres avaient été lourdement traumatisés.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Hahaha...\n(J'espère que Fabella réalise à quel point sa cuisine est terrible maintenant !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, mon téléphone vibre dans mon sac.\nMariru a envoyé un message.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Hum. Présentez-vous au quartier général aujourd'hui, hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Il y a dix heures>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23h15, salle de contrôle SID>")
	await novel_interface.show_text_only("Une femme rousse en tenue militaire se tient debout, les bras croisés sur la poitrine, regardant fixement la douzaine de supports rouges qui se déplacent rapidement sur l'écran noir et blanc.")
	await novel_interface.show_text_only("Une fenêtre de discussion apparaît soudainement dans la partie inférieure de l'écran.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Patron, selon nos archives, l'otage Sir Lumbert se trouve toujours quelque part couvert par l'Aegis.", "Agent SID")
	await novel_interface.show_dialog("Notre analyse de surveillance nous indique que le ravisseur se trouve très probablement dans l'une de ces trois zones. Un entrepôt abandonné dans la Bay Area affiche une activité anormale de consommation d'électricité...", "Agent SID")
	await novel_interface.show_dialog("Devons-nous informer le Bureau de la Défense ?", "Agent SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Pas encore. Encerclez la zone et attendez mes ordres.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Roger ça.", "Agent SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En fermant la fenêtre, Mariru passe au canal de discussion militaire.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("La zone montagneuse est devant nous. Gardez l'hélicoptère à une altitude sûre, ne les laissez pas nous remarquer.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Je l'ai compris. Nous avons des images claires du satellite de détection de chaleur.", "Soldat A")
	await novel_interface.show_dialog("Ils se déplacent si vite... est-ce vraiment des humains ?", "Soldat A")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Techniquement… ils étaient autrefois des humains. Mais plus maintenant.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Est-ce que tout le monde dans la direction dans laquelle ils se dirigent a été évacué ? Si quelque chose d'anormal se produit...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nos canons et armes de destruction régionale sont prêts.", "Soldat B")
	await novel_interface.show_text_only("Mariru hoche la tête. Elle ne veut pas trop en dire aux militaires.")
	await novel_interface.show_text_only("D’ailleurs, elle a un mauvais pressentiment depuis le début de cette mission de traque…")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Nous traitons généralement ces « sorcières » qui apparaissent à l’extérieur du centre-ville de New Opulentia en les annihilant de force avec les armes à feu lourdes que les militaires ont placées à l’avance dans la zone.)", "Mariru")
	await novel_interface.show_dialog("(D'après des expériences passées, ces choses attaquent généralement au hasard les êtres vivants ou les installations à proximité après la disparition de leurs cocons de sorcière.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Mais depuis deux semaines, ils semblent afficher une sorte de schéma identique...)", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Attends... il y a quelqu'un devant !", "Soldat A")
	await novel_interface.show_dialog("Porter une tronçonneuse aussi. Peut-être un bûcheron ?", "Soldat B")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Idiot, quel bûcheron travaille à onze heures ?\nQuels sont les résultats du test mème ?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vert. C'est humain !", "Soldat A")
	await novel_interface.show_dialog("Et... une fille humaine aussi ?", "Soldat B")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Mariru zoome immédiatement sur les images capturées.")
	await novel_interface.show_text_only("Sur l’écran thermique, on voit une petite fille portant un bandana et une tronçonneuse presque aussi grosse qu’elle.")
	await novel_interface.show_text_only("Et elle fait signe à ces sorcières qui se précipitent rapidement.")
	await novel_interface.show_text_only("Les principales sorcières, alertées par le bruit de la tronçonneuse vrombissante, changent de cap et conduisent la meute dans sa direction.")
	await novel_interface.show_text_only("Une colonie de sorcières de cette taille ne peut généralement être détruite que par une escouade de porteurs de mitrailleuses lourdement blindés et expérimentés. La fille n’a aucune chance.")
	await novel_interface.show_text_only("Mais avant même que Mariru puisse alerter l'équipe de nettoyage pour qu'elle récupère le cadavre de la jeune fille plus tard, la jeune fille se tourne simplement vers les sorcières, rayonnante, tronçonneuse à la main.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Elle ajuste son rythme et sa posture alors que d'innombrables sorcières passent, esquivant habilement leurs attaques tout en séparant les sorcières entrantes.")
	await novel_interface.show_text_only("Les sorcières, comme de la viande fraîche fourrée dans un broyeur robuste, finissent sous forme de minuscules morceaux de chair.")
	await novel_interface.show_text_only("La jeune fille se déplace et attaque en douceur, utilisant les lois de l'inertie et de la force centrifuge à son avantage. Elle ne semble pas être extraordinairement forte, elle a juste la physique de son côté.")
	await novel_interface.show_text_only("Elle avait probablement fait quelques calculs au préalable et sélectionné la tronçonneuse comme arme la plus efficace en fonction des caractéristiques des cibles et de sa propre force.")
	await novel_interface.show_text_only("En trente secondes, ces dizaines de sorcières, que le SID et les militaires traquaient depuis quatre jours, ne sont plus que de la viande déchiquetée.")
	await novel_interface.show_dialog("Qu'est-ce qu'on fait maintenant ?", "Soldat A")
	await novel_interface.show_text_only("Mariru pousse un soupir.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Merde...", "Mariru")
	await novel_interface.show_dialog("Pleins feux sur. Missile Hellfire prêt—", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Essayez de lui parler avec un haut-parleur. Dites-lui qu'elle est encerclée. Si elle ose bouger, faites-la exploser avec cette montagne.", "Mariru")
	await novel_interface.show_dialog("Ramenez-la vivante !", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene4 - SID审讯室
	novel_interface.show_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("<Quelques heures plus tard, salle d'interrogatoire du SID>")
	await novel_interface.show_text_only("À côté du miroir sans tain, Mariru feuillette le dossier de la cible sur son appareil portable.")
	await novel_interface.show_text_only("Nom : Sonya Angeles")
	await novel_interface.show_text_only("Âge : 14 ans... ?")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Organisation...", "Mariru")
	await novel_interface.show_dialog("District spécial de l'église de Salmonton, CDF.", "Mariru")
	await novel_interface.show_dialog("C'était autrefois un palais de justice religieux, n'est-ce pas ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","smile")
	await novel_interface.show_text_only("Mariru appuie sur un bouton et le verre devient clair. Une jeune fille, vêtue d'un costume de nonne, la rencontre avec des yeux silencieux et dociles de l'autre côté.")
	await novel_interface.show_text_only("Son petit corps est dissimulé sous sa lourde robe en velours noir, maintenue par une broche rouge foncé.")
	await novel_interface.show_text_only("Au lieu d’un chapeau de nonne, elle a une paire d’oreilles de chat sur la tête. Ça a l'air de lui aller bien.")
	novel_interface.change_expression("jest")
	await novel_interface.show_text_only("Cheveux argentés longs et élégants, yeux azur. Cela aurait dû être mignon, mais ce sourire étrangement froid et nonchalant sur son visage était aigu et glaçant.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru parcourt les rapports associés et note la ligne de caractères rouges en bas—")
	await novel_interface.show_text_only("Cette personne est protégée selon les conditions particulières de l'Accord de Salmonton et ne peut être détenue par aucune organisation appartenant à un pays membre du Congrès uni pendant plus de douze heures.")
	novel_interface.show_character("liliu_uniform1","speak")
	await novel_interface.show_dialog("Hé. L'ordre d'enquête que l'armée de Nouvelle Opulentia a lancé contre vous a déjà été annulé.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_nun","normal")
	await novel_interface.show_dialog("Ah ? Bien.\nJ'avais tellement peur !", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Ce sont eux qui devraient avoir peur. Le soldat qui vient de vous amener a même demandé une opération de suppression de mémoire de niveau C...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille aux cheveux argentés, les mains enchaînées, se lèche les lèvres en souriant d'excitation.")
	novel_interface.show_character("soya_nun","relieve")
	await novel_interface.show_dialog("Eh, ils puaient tellement, tu sais ? Mais je ne leur ai même pas fait de mal.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Quoi qu'il en soit, tu vas m'interroger ? Au moins tu sens vraiment bon !", "Soya")# 换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille étudie Mariru avec beaucoup d'intérêt.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ah ? Sonya, n'est-ce pas ?", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Interroger les gens est mon... « expertise ».", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru commence aussi à avoir l'air excitée.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Mais quand même, avant ça...", "Mariru")
