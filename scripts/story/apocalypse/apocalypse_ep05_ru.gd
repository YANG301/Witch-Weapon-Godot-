# apocalypse_ep05.gd - 天启篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第05话剧本
	apocalypse_ep05_script()

func play_script():
	pass

# 天启篇第05话 - 正式剧本
func apocalypse_ep05_script():
	# scene1 - 盲点序章
	novel_interface.show_background("res://assets/images/bg/Soya/Blindspot.png")
	await novel_interface.show_text_only("Слепое пятно — это место, где на сетчатке пересекаются артерии, вены и нервы. В этом отделе нет светочувствительных клеток, поэтому зрительная стимуляция не может его вызвать.")
	await novel_interface.show_text_only("Однако мы не можем сказать, где находится слепое пятно, когда смотрим на что-то, потому что мозг автоматически заполняет то, чего не хватает.")
	await novel_interface.show_text_only("Так работает наш мозг. Он делает все возможное, чтобы каждая ситуация казалась разумной.")
	await novel_interface.show_text_only("Поэтому многие люди считают, что то, что кажется им естественным, должно быть бесспорно правильным.")
	await novel_interface.show_text_only("Но так ли это на самом деле?")
	await novel_interface.show_text_only("В истории был человек, который не осознавал, что был слеп, пока ему не исполнилось семь лет.")
	await novel_interface.show_text_only("Те, кто родился без слуха, подумали бы, что мир молчит, если бы им никто не сказал обратного.")
	await novel_interface.show_text_only("Если аномальное событие каким-то образом стало событием по умолчанию, мы примем его как есть.")
	await novel_interface.show_text_only("И мы никогда не узнаем правду, пока однажды нам не придется столкнуться с противоречиями, стоящими перед нашими глазами.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("В таком случае... возможно, у всех людей есть врожденный недостаток. Но поскольку это значение по умолчанию для всех, никто никогда не подвергает его сомнению...")
	novel_interface.show_background("res://assets/images/bg/Soya/Doomsday1.png")
	await novel_interface.show_text_only("Пока однажды...")
	await novel_interface.show_text_only("Им приходится сталкиваться с противоречиями прямо у них на глазах...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	
	# scene2 - 美术馆继续
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Я все еще пытаюсь смириться с новостью, которая потрясла мир.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(Это действительно серьезно, конечно, я просто не знаю, что и думать...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Даже если Новая Опулентия переживет первый раунд ядерных атак, людям все равно придется иметь дело с ядерным загрязнением, экологическими проблемами и голодом. Все фатально.")
	await novel_interface.show_text_only("«Апокалипсис класса XK не оставляет выживших».")
	await novel_interface.show_text_only("Эту цитату в наши дни часто можно услышать в новостях. Это также стало основой, благодаря которой Объединенный Конгресс смог положить конец войне и сохранить мир.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Система неизбирательного ядерного контратаки на самом деле не является чем-то новым. Кто-то уже разработал нечто подобное во время холодной войны.", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Ого, так давно?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Просто люди редко об этом упоминают.", "Рафаэль")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Знаешь почему?", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я даже не пытаюсь ответить, знаю, что я безнадежен в истории. Поэтому я просто сижу и вежливо улыбаюсь, пока Рафилия пристально смотрит на меня.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Причина заключалась в том, что высокопоставленные лица во всех странах заключили молчаливое соглашение: публично заявлять о существовании подобных вещей не следует.", "Рафаэль")
	await novel_interface.show_dialog("Эта тема всегда была табу, как в странах со строгой цензурой, так и в странах, где важна свобода прессы.", "Рафаэль")
	await novel_interface.hide_character()
	
	# 背景切换
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Когда Объединенный Конгресс был впервые создан и закончилась война, общественность думала, что это было ради «будущего человечества и цивилизации».")
	await novel_interface.show_text_only("Что касается Вещества H класса XK — о нем никто никогда не говорит, хотя именно оно фактически положило конец войне.")
	await novel_interface.show_text_only("Чтобы вызвать доверие у широкой общественности, Совет запустил проект под названием «Новая вращающаяся дверь» в передаче, посвящённой концу войны.")
	await novel_interface.show_text_only("Проект, в рамках которого шесть стран-членов единогласно согласились назвать свои столицы «Академическими городами».")
	
	novel_interface.change_background("res://assets/images/bg/Soya/Guidepost.png")
	await novel_interface.show_text_only("Это движение повлияло на многое. Были реформированы правительства, выпущена новая валюта и новые государственные долги, переименованы аэропорты и достопримечательности, а дорожные знаки пришлось заменить в широком масштабе.")
	await novel_interface.show_text_only("Технически это была простая смена названия. Но кредитная система в каждой из этих стран чудесным образом оправилась от войны всего за пару месяцев.")
	await novel_interface.show_text_only("Даже листинговые компании начали подавать заявки на изменение названия — пока название компании имело какое-то отношение к «Академгороду», акции резко взлетели вверх.")
	novel_interface.change_background("res://assets/images/bg/Soya/galleries.png")
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Потому что термин «Академгород» означал светлое, счастливое будущее…", "Рафаэль")
	await novel_interface.show_dialog("И всем людям нужно что-то, чему они могли бы доверять, что-то, что олицетворяло бы их надежды и мечты.", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Это как парни и их... «палочки», да?", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Хм?", "Эллука")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("…", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия поднимает руку, готовая разорвать Соню на куски.")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Действительно, это публичное заявление, должно быть, планировалось уже довольно давно.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Обычно о чем-то подобном просто объявляли на закрытом совещании высокопоставленных лиц.")
	await novel_interface.show_text_only("Небольшие страны, не являющиеся участниками, и даже террористы в любом случае смогут получить подобную информацию.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("И прямо сейчас все чиновники шести стран, обладающие достаточной властью, чтобы запретить СМИ распространять эту новость, проводят закрытое заседание.", "Рафаэль")
	await novel_interface.show_dialog("Медийные каналы по всему миру, естественно, захотят как можно больше выжать из этой шокирующей новости, чтобы получить как можно больше подписчиков и трафика.", "Рафаэль")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Они будут безудержно сеять панику и хаос по всему миру...", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия смотрит на толпу снаружи, нахмурив брови.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Здесь... обычно здесь так многолюдно?", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Эта улица в значительной степени ориентирована на определенную нишевую группу покупателей и не имеет никакого отношения к политике, но это правда, что здесь действительно более многолюдно, чем обычно.")
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Ну, думаю, беспокоиться не о чем.", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня выглядывает из стеклянной стены вестибюля второго этажа, где мы сейчас находимся, и подтверждает.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Ауры этих людей выглядят красиво. Они не в гневных цветах. Некоторые действительно пахнут дымом и тревогой, но это легко может быть потому, что их окружает слишком много людей.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Так вот что означает «синестезия» в вашем профиле?", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Думаю да.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ну, тогда расскажите нам: каковы наши ауры?", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия наклоняется ближе, с любопытством.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Хм... Какой-то ты противоречивый человек.", "Соя")
	await novel_interface.show_dialog("От тебя пахнет проселочной дорогой после дождя, и ты чувствуешь... тепло. Даже когда у вас негативные эмоции, дождь моментально их смывает.", "Соя")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_fishnet","perspire1",0.25)
	await novel_interface.show_dialog("(...Так вот почему Соня не смогла увернуться, когда ее ударила Рафилия? Потому что она уже не чуяла своей ярости?)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Соня склоняет голову набок и выглядит растерянной.")
	novel_interface.show_character("soya_uniform","speechless")
	await novel_interface.show_dialog("Обычно люди, которые так пахнут, нежны и успокаивают, но ты жесток и раздражителен и…", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Если бы у меня была синестезия, держу пари, что в этот самый момент я бы увидел бушующее пламя над головой Рафилии.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("Я имею в виду, запахи не лгут, поэтому ты должен быть милым, всепрощающим, добрым, доброжелательным и ненасильственным, верно?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Соня быстро пытается исправиться и меняет тему.")
	novel_interface.show_character("soya_uniform","relieve")
	await novel_interface.show_dialog("Кхм, в любом случае, Рен... у нее самый чистый цвет, который я когда-либо видел!", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Дышать?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("О?", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия поднимает бровь, любопытство побуждает ее отложить гнев.")#文字错误
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Например, когда мы ели парфе в кондитерской, с каждым кусочком, который она откусывала, я слышал ее визг: «Иииии! Вкуснятина!» из глубины ее сердца.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("Оу, правда?\n(Это так неловко!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Она не откусит следующего кусочка, пока не перестанет визжать. Это действительно интересно смотреть.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Ха, идиот действительно.", "Рафаэль")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Что касается Эллуки, то она как хомяк. Она просто ест и ест.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Эхехе!", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эллука хихикает, как будто Соня ее хвалит.")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Когда Рен видит на улице симпатичную девушку, она начинает светиться розовым. Она изо всех сил старается не пялиться, но глазные яблоки всегда ее выдают...", "Соя")
	await novel_interface.show_dialog("Иногда она делает вид, что смотрит вдаль за спиной девушки, а затем поворачивает голову в другую сторону в надежде, что она не будет выглядеть гадкой.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Я знал это, она полностью сталкерский материал.", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия бросает на меня взгляд.")
	novel_interface.show_character("ren_fishnet","shy_left")
	await novel_interface.show_dialog("Ой, давай...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я думал, что хорошо скрываю свой взгляд... неужели ей нужно было так внимательно за мной наблюдать?")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Когда Рен видит красивую одежду, ее аура окрашивается в два разных, конфликтующих цвета. Однако обычно розовая сторона побеждает.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("О?", "Рафаэль")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рафилия окидывает меня взглядом, и ее взгляд в конце концов останавливается на моих ногах.")
	novel_interface.show_character("ren_fishnet","shy_right")
	await novel_interface.show_dialog("(Я невиновен! Я действительно ничего не знаю!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Кстати, если она приглушает свою ауру, как будто хочет просто исчезнуть, значит, ей нужно поправить бретельку бюстгальтера или чулки в сеточку.", "Соя")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","hungry")
	await novel_interface.show_dialog("Ах, хорошее наблюдение!", "Эллука")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Это верно!", "Рафаэль")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эллука и Соня, кажется, отлично проводят время, и Соня становится еще счастливее, рассказывая им больше.")#文字错误
	await novel_interface.show_text_only("Вот и все. Я не могу здесь оставаться и слушать эту клевету...")
	await novel_interface.show_text_only("Я задерживаю дыхание, отступаю назад…")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("Ах да, когда Рен хочет в туалет, она…", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем Соня успевает закончить предложение, индикатор на ее браслете начинает мигать.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("А?", "Соя")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Раздается щелчок, а затем мимо окна вестибюля художественной галереи мелькает изящная голубая дуга.")
	await novel_interface.show_text_only("Седовласая девушка падает на землю, от ее тела поднимается клубок белого дыма.")
	await novel_interface.show_text_only("Эллука становится на колени рядом с ней и тычет пальцем в ее неподвижное тело с невинным лицом. Рафилия должна сразу понять, что Эллука этого не делала.")
	await novel_interface.show_text_only("Когда блондинка наконец вспомнила, что я существую, я уже добрался до лестницы.")
	novel_interface.show_character("ren_fishnet","uneasy")
	await novel_interface.show_dialog("(Извините, это единственный способ заставить ее замолчать!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Бам!")
	await novel_interface.show_text_only("Пытаясь уйти, я врезаюсь прямо в кого-то.")
	await novel_interface.show_text_only("Вместо того, чтобы меня опрокинули, эта «кто-то» мягко помогает мне подняться, поддерживая мой вес своими… активами.")
	novel_interface.show_character("ren_fishnet","timid")
	await novel_interface.show_dialog("(Они... такие пружинистые!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.show_character("cereza","wordless")
	await novel_interface.show_dialog("Смотри, малышка.", "Черноволосая женщина")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Женщина с волосами цвета воронова крыла ругается на меня, а затем зевает.")
	novel_interface.show_character("ren_fishnet","shy")
