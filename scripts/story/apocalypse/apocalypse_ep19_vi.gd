# apocalypse_ep19.gd - 天启篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第19话剧本
	apocalypse_ep19_script()

func play_script():
	pass

# 天启篇第19话 - 正式剧本
func apocalypse_ep19_script():
	# Scene 1 - 神曲开场
	novel_interface.show_background("res://assets/images/bg/Soya/DivinaCommedia.png")
	await novel_interface.show_text_only("Và khi ánh sáng rực rỡ nhất trên làn sóng,\nĐiều đó chờ đợi đội đi lên, Phaëton\nTôi biết cách hướng dẫn, và trên mỗi phần ánh sáng")
	await novel_interface.show_text_only("Giảm dần, mãnh liệt nhất ở giữa;\nVì vậy hãy đốt cháy oriflame yên bình và thư giãn\nỞ mọi phía, ngọn lửa sống đang tàn lụi.")
	await novel_interface.show_text_only("Và giữa lúc đó những đồng xu thể thao của họ vẫy tay\nHàng ngàn thiên thần; trong sự rực rỡ mỗi")
	await novel_interface.show_text_only("Cách trang trí độc đáo và lạ mắt...")
	await novel_interface.show_text_only("—Canto XXXI, Paradiso, Thần khúc")
	
	# Scene 2 - 地下密室对话
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Mariru đứng, nghịch bức ảnh trên tay, đồng thời quan sát sâu sắc người đàn ông tóc hoa râm trước mặt.")
	await novel_interface.show_text_only("Không có nhiều thông tin được tìm thấy liên quan đến người đàn ông này. Thậm chí không ai biết Lumbert có phải là tên thật của anh ta hay không chứ đừng nói đến họ của anh ta là gì.")
	await novel_interface.show_text_only("Nhưng sự thật vẫn là anh ấy được phong tước hiệp sĩ dưới cái tên này do “đóng góp xuất sắc cho hòa bình thế giới”.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("(Akiko đã xác nhận rằng việc thương lượng với anh ấy là an toàn.)", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Hầu hết mọi người tin rằng lý do khiến Quốc hội Thống nhất nắm giữ quyền lực lớn nhất trên hành tinh của chúng ta là vì đó là nơi tập trung các nhà lãnh đạo quốc gia trên khắp thế giới.", "Mariru")
	await novel_interface.show_dialog("Đúng là loại tổ chức này đã tồn tại trong lịch sử từ xa xưa. Nhưng cơ cấu này rất mỏng manh và các thành viên không bao giờ có thể ngừng tranh cãi. Ông chủ tịch hành động giống một kẻ hòa giải-chém-ăn xin hơn.", "Mariru")
	await novel_interface.show_dialog("Nhưng Quốc hội Thống nhất mà chúng ta có bây giờ không hề như vậy chút nào. Có ảnh hưởng hơn nhiều. Và giàu có hơn nhiều.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru cất bức ảnh lại vào túi, vẻ mặt thản nhiên.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Từ sự quan tâm, niềm tin được sinh ra. Từ niềm tin, sức mạnh được sinh ra. Và quyền lực, thông qua việc sắp xếp và phân phối các nguồn lực, thậm chí còn tạo ra nhiều lợi ích hơn nữa...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert nhướn mày.")
	novel_interface.show_character("lambert","sedation")
	await novel_interface.show_dialog("Đó là mô hình xã hội cơ bản của Walker.", "Lumbert")
	await novel_interface.show_dialog("Các chính trị gia được các nhóm lợi ích lựa chọn là người đại diện được công chúng tin tưởng.", "Lumbert")
	novel_interface.change_expression("relax")
	await novel_interface.show_dialog("Nếu những người đại diện này không thể duy trì hoặc tạo ra những lợi ích lớn hơn, quyền lực của họ sẽ bị tước đoạt và người khác sẽ thay thế họ.", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Điều đó đúng trong lịch sử vĩ mô, nhưng công chúng chưa bao giờ hợp lý. Như Lê Bon đã từng nói...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","smile")
	await novel_interface.show_dialog("Quần chúng chưa bao giờ khao khát sự thật. Bất cứ ai có thể cung cấp cho họ ảo tưởng đều dễ dàng là chủ nhân của họ; bất cứ ai cố gắng phá hủy ảo tưởng của họ luôn là nạn nhân của họ.", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert thì thầm, hoàn thành câu trích dẫn cho cô ấy. Mariru mỉm cười và gật đầu.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Có quá nhiều cách để bỏ qua phần lãi suất và trực tiếp lấy được lòng tin của công chúng.", "Mariru")
	await novel_interface.show_dialog("Những nhà lãnh đạo kiểu này không ngại hy sinh lớn lao miễn là cuối cùng họ thành công.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tuy nhiên, sau Chiến tranh Bảy năm, những người thực sự đảm bảo an toàn cho cuộc sống của người dân và sự điều hành của các quốc gia bắt đầu suy nghĩ lại về toàn bộ tình hình.", "Mariru")
	await novel_interface.show_dialog("Và do đó họ đã thành lập Quốc hội Thống nhất. Một tổ chức hợp tác và thương lượng trực tiếp với các nhóm lợi ích.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Vì vậy, nó thực sự là cách khác. Quốc hội Thống nhất không có quyền lực vì nó bao gồm các nhà lãnh đạo quốc gia. Trên thực tế, sự thật là chỉ những người trong Quốc hội mới đủ tư cách trở thành lãnh đạo quốc gia.", "Mariru")
	await novel_interface.show_dialog("Tổ chức này đã có động thái đầu tiên cách đây ba năm...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dừng lại. Lumbert nhìn cô chằm chằm, nín thở.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ba năm trước, Quốc hội Hoa Kỳ và nhà thờ đã hợp tác cùng nhau để thử nghiệm một loại Chất H loại EX ở Nam Mỹ. Họ gây áp lực buộc các trùm mafia ở đó phải hợp tác với họ.", "Mariru")
	await novel_interface.show_dialog("Tuy nhiên, thí nghiệm đã vượt quá tầm kiểm soát. Hơn 46.000 người dân địa phương đã chết.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Bernadotte.png")
	await novel_interface.show_dialog("Họ hối lộ tất cả những người biết sự thật để bịt miệng họ, và gọi toàn bộ sự việc là Vụ thảm sát sông Churun, đổ lỗi cho Carlos Branco, lãnh chúa duy nhất từ ​​chối hợp tác.", "Mariru")
	await novel_interface.show_dialog("Tin tức về vụ việc đã lan truyền. Các phương tiện truyền thông yêu thích nó. Công chúng ghét nó, đồng thời thể hiện sự ghê tởm và căm ghét chiến tranh trên diện rộng.", "Mariru")
	await novel_interface.show_dialog("Và Quốc hội Thống nhất được nhiều người đánh giá cao khi là tổ chức thực hiện chiến dịch quân sự chung nhằm tiêu diệt Branco. Thậm chí không ai bận tâm đặt câu hỏi liệu sự tồn tại của tổ chức này có hợp pháp ngay từ đầu hay không.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Nhưng chẳng phải nó quá mất tự nhiên sao? Hàng nghìn thi thể, xếp thành hình mảng, lấy nhà thờ làm trung tâm...", "Mariru")
	await novel_interface.show_dialog("Tôi tin rằng Quốc hội đã bắn vũ khí Chất H ở đó, loại vũ khí có khả năng làm gián đoạn sóng vô tuyến trong bán kính hai dặm, nhằm che giấu sự thật.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Điều bất thường tương tự cũng xảy ra trên chiến trường Tây Á. Đó là lý do tại sao những hình ảnh được chụp bởi các vệ tinh ở đó đều bị biến dạng—dù sao thì ánh sáng cũng là một loại sóng.", "Mariru")
	await novel_interface.show_dialog("Đó là lý do tại sao tình trạng gián đoạn sóng vô tuyến trong khu vực vẫn tồn tại trong nhiều tuần ngay cả sau khi “cánh cổng” đã đóng lại.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nhấn mạnh vào từ “cánh cổng”. Lumbert nhắm mắt cam chịu.")
	novel_interface.change_background("res://assets/images/bg/Soya/Churun.png")
	await novel_interface.show_text_only("Mariru nghiên cứu bức ảnh trên tay mình.")
	await novel_interface.show_dialog("Việc dọn dẹp tất cả những thi thể đó cần rất nhiều công nhân. Chắc hẳn rất khó để đảm bảo rằng không ai trong số họ tiết lộ bất cứ điều gì.", "Mariru")
	await novel_interface.show_dialog("Tôi cá là bạn không bao giờ mong đợi ai đó chụp được bức ảnh hiện trường này bằng một chiếc máy ảnh cơ cũ và một cuộn phim mục nát.", "Mariru")
	await novel_interface.show_dialog("Nền của bức ảnh bị mờ. Đó là do đặc tính bóp méo ánh sáng của vũ khí Chất H mà người của bạn sử dụng.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.show_character("lambert","usually")
	await novel_interface.show_dialog("Thú vị. Nhưng tại sao bạn lại tin chắc rằng tôi có liên quan?", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Một tháng trước khi vụ việc xảy ra, ông được bổ nhiệm làm Tổng thư ký của Tổ chức Hiệp ước cấm thử nghiệm vũ khí chất H.", "Mariru")
	await novel_interface.show_dialog("Bề ngoài, mục đích của tổ chức này là cấm các thí nghiệm vũ khí Chất H. Đó là một cơ sở hùng mạnh với nhiều nguồn lực sẵn có và khả năng thu thập thông tin tuyệt vời.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Bạn không thể không biết về một sự cố ở quy mô này. Sở dĩ bạn chọn không lên tiếng là vì thực chất bạn là người đã lên kế hoạch cho tất cả.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert không cố gắng phản kháng, và Mariru coi sự im lặng của anh ta như một dấu hiệu cho thấy đã an toàn để tiếp tục.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Cuối cùng, nhà thờ đã cử một số người của họ đi thu hồi Chất H, gây ra mọi rắc rối. Sau đó, họ đã nhận được một số tiền và đặc quyền bất thường từ Hội đồng Liên hợp quốc.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Chất H được đề cập là một cánh cửa đen mở một nửa. Đằng sau nó là ánh sáng vàng chói mắt—", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Đủ rồi! Tôi hiểu rồi!", "Lumbert")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lumbert ngắt lời, giơ cả hai tay ra hiệu đầu hàng.")
	await novel_interface.show_text_only("Anh kéo cổ áo vest và hắng giọng.")
	novel_interface.show_character("lambert","frown")
	await novel_interface.show_dialog("Thật vậy, sứ mệnh của tổ chức chúng tôi là đảm bảo rằng công chúng không dễ dàng tiếp cận với vũ khí Chất H chứ đừng nói đến việc sử dụng chúng trong các thí nghiệm.", "Lumbert")
	await novel_interface.show_dialog("Chất H quá nguy hiểm. Nếu không cẩn thận, nó có thể phá hủy nền văn minh của chúng ta. Nhưng thí nghiệm mà chúng tôi tiến hành... đó là điều không thể tránh khỏi. Ai đó phải làm điều đó, có thể là chúng ta.", "Lumbert")
	await novel_interface.show_dialog("Ai đó... thứ gì đó... đang gõ cửa từ bên trong. Càng ngày càng khẩn trương. Chúng tôi không có sự lựa chọn...", "Lumbert")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Gõ cửa...?", "Mariru")
	await novel_interface.hide_character()
	
	# Scene 3 - 天堂之门
	novel_interface.change_background("res://assets/images/bg/Soya/BlackGate.png")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Gõ cửa thiên đường, vâng.", "Lumbert")
	await novel_interface.show_dialog("Thiên đường tồn tại trong mọi tôn giáo và hệ thống thần thoại, dưới nhiều hình thức khác nhau. Các định nghĩa có thể khác nhau ở mỗi hệ thống tín ngưỡng, nhưng có lẽ chúng đều được sinh ra từ cùng một nguồn.", "Lumbert")
	await novel_interface.show_dialog("Sử sách ghi lại rằng, ngay trước khi mở cửa, người ta sẽ gõ cửa ba lần liên tiếp.", "Lumbert")
	await novel_interface.show_dialog("Những tiếng gõ sâu và vang vọng. Như gõ cửa tâm hồn người nghe...", "Lumbert")
	await novel_interface.show_dialog("Sau khi nghe thấy tiếng gõ đầu tiên, sẽ có sự im lặng trong một tuần và tiếng gõ lại bắt đầu. Khoảng thời gian giữa những lần gõ cửa dần dần ngắn lại...", "Lumbert")
	await novel_interface.show_dialog("Khi không quá chín mươi giây giữa mỗi lần gõ, chúng ta sẽ biết rằng cửa thiên đàng đã sẵn sàng mở.", "Lumbert")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Bạn có thể định nghĩa “sinh vật” đằng sau cánh cửa theo cách bạn muốn, nhưng thực tế là nó nắm giữ những sức mạnh có thể gây ra thảm họa cấp độ tận thế.", "Lumbert")
	await novel_interface.show_dialog("Ví dụ như một trận lũ lụt lớn, hử...", "Mariru")
	await novel_interface.show_dialog("Theo bản thảo của nhà thờ, cách duy nhất để giữ cửa đóng lại là tập hợp khoảng mười nghìn người trong phạm vi, vây quanh cửa...", "Lumbert")
	await novel_interface.show_dialog("Một kiểu hy sinh nhỉ?", "Mariru")
	await novel_interface.show_text_only("Lumbert phớt lờ nhận xét của Mariru và tiếp tục.")
	await novel_interface.show_dialog("Chuyện như vậy xảy ra vài trăm năm một lần. Luôn luôn, các xác chết được sắp xếp thành một mảng xuyên tâm, với cánh cửa là điểm trung tâm.", "Lumbert")
	await novel_interface.show_dialog("Loại nghi lễ này thường được thực hiện trong bí mật. Tuy nhiên, vì luôn có hàng trăm năm giữa nghi lễ này và nghi lễ tiếp theo, một số người ở những thời đại nhất định sẽ sử dụng chúng để làm lợi cho riêng họ...", "Lumbert")
	await novel_interface.show_dialog("Ví dụ, vụ thảm sát Ngày Thánh Bartholomew ở Paris năm 1572.", "Lumbert")
	await novel_interface.show_dialog("Đêm trước Ngày Thánh Bartholomew năm đó, đã xảy ra một vụ thảm sát tôn giáo khủng khiếp, tồi tệ nhất trong nhiều thế kỷ, với hơn 70.000 người chết.", "Lumbert")
	await novel_interface.show_dialog("Paris, hả...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Soya/Paris.png")
	await novel_interface.show_dialog("Đợi đã, một mảng xuyên tâm với một cánh cửa là điểm trung tâm?", "Mariru")
	await novel_interface.show_text_only("Mariru ngay lập tức nhớ đến cách bố trí các con đường ở thành phố lãng mạn.")
	await novel_interface.show_dialog("Thật mỉa mai phải không...", "Lumbert")
	await novel_interface.show_text_only("Lumbert cười một cách thiếu hài hước.")
	novel_interface.change_background("res://assets/images/bg/Soya/Underground_Hall.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Tuy nhiên, không thể gõ cửa trừ khi nó có hình dạng cụ thể. Tại sao bạn không phá hủy nó hoặc vứt nó đi đâu đó ngoài không gian?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("lambert","relax")
