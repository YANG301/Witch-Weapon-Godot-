# apocalypse_ep11.gd - 天启篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第11话剧本
	apocalypse_ep11_script()

func play_script():
	pass

# 天启篇第11话 - 正式剧本
func apocalypse_ep11_script():
	# scene1 - 开始
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("No. These idiots—they’re all men!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On Beatrice’s right arm is a bracelet—made of mossy green metal, gleaming softly in a light blue hue.")
	await novel_interface.show_text_only("An invention of Aya's. Made of special alloy that blocks the effects of meme Substance H. Can be used to suppress the effects of Beatrice’s ”curse”.")
	novel_interface.show_character("ren_fishnet","perspire1")
	await novel_interface.show_dialog("Wait, what are you planning to—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("I remember Mariru telling me a couple weeks ago about the “curse”. Any male who sees Beatrice will immediately fall head over heels in love with her.")
	# scene2 - 回忆莉琉的解释
	novel_interface.show_background("res://assets/images/bg/Soya/FusiformGyrus.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_dialog("To be exact, it’s her face that triggers the effect.", "Mariru")
	await novel_interface.show_dialog("Through a series of tests conducted by Aya, they’ve discovered that looking directly at Beatrice’s face highly stimulates the fusiform gyrus and amygdala in the male brain.", "Mariru")
	await novel_interface.show_dialog("However, it’s only effective if the target is directly looking at her in a 260-feet radius. Photos, videos or reflections do not have such an effect.", "Mariru")
	await novel_interface.show_dialog("After this stimulation is in effect for a period of time, the affected person’s brain will undergo irreversible changes. This will fundamentally change the way they act.", "Mariru")
	await novel_interface.show_dialog("They become desperate to make Beatrice theirs. But, as they can’t, they become anxious, irritable, resentful. This may even lead to self-harm, arson or violent tendencies.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("How sad, eh? Unrequited love...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru heaves a sigh.")
	await novel_interface.show_text_only("I open my mouth to ask how exactly Aya conducted that horrible experiment, but close it again. It’s better if I remain ignorant.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Luckily I wasn’t one of her test subjects...)", "Lian")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Wait! When you made me explain stuff to Beatrice alone in “that outfit” yesterday...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Was that an experiment of Aya’s too?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("You only realized now?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("So it was?")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Hmm, then you probably haven’t realized that the bracelet Beatrice wore yesterday was fake yet, eh?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru quips, looking slightly disappointed at my lack of observation skills.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("The reason I made you wear that outfit was to keep your subjective thoughts from messing up our test results. The “embarrassment” you were feeling would effectively cancel out your “desires”.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("And…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She reaches out, places both hands on my shoulders. On her face is a subtle smirk.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... You looked pretty good in a playboy bunny outfit!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aaaaaaaaaa!\nCan’t we just stop bringing that up?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I spent that one hellish hour in a playboy bunny outfit, alone with Beatrice, in an enclosed room.")
	await novel_interface.show_text_only("I was so nervous I could barely get out a whole sentence. I couldn’t even walk properly.")
	await novel_interface.show_text_only("And Beatrice spent the hour comforting me, even though she was on the verge of bursting in to giggles, I’m sure.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aya said the 3D scan images of your brain then was like a fireworks show. She really enjoyed it, would have let it go on for much longer if your brain pressure hadn’t been a bit high.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Anyway, now we know that, though your brain reacts to Beatrice’s curse just like any normal male’s, no trauma will be left behind.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("On the other hand, other men will suffer from permanent brain damage after a period of looking at Beatrice’s face. The period ranges from forty seconds to eight minutes.", "Mariru")
	await novel_interface.show_dialog("So you’re safe. Aren’t you relieved?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("I’m certainly not relieved!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Ah, that’s another one of my memories I wish I could just erase.")
	
	# scene3 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("(So... if she takes off her bracelet here...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice smiles sweetly at me, then pulls me into a hug.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Everything goes dark in front of me as my face is smushed into her chest.")
	await novel_interface.show_dialog("Huh?", "Lian")
	await novel_interface.show_dialog("I’ll say “go”. After that, you have thirty seconds.", "Beatrice")
	await novel_interface.show_dialog("Grab Elluka, and we’ll split up and meet up in Newell Central Park. Fewer protesters there.", "Beatrice")
	await novel_interface.show_dialog("Got it?", "Beatrice")
	await novel_interface.show_text_only("I nod, trying my best not to think about the soft chest in my face.")
	await novel_interface.show_dialog("Hey, I want a turn too!", "Soya")
	await novel_interface.show_text_only("“Click”")
	await novel_interface.show_text_only("The clasp of the bracelet falls open. The curse is now in effect.")
	# scene4 - 索娅的视角
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraNN1.png")
	await novel_interface.show_text_only("In the eyes of Sonya, Electronics Street is now a world of pink.")
	await novel_interface.show_text_only("The same kind of pink she saw shrouding certain books with explicit content back when they were shopping in the bookstore this afternoon.")
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("You’re a witch too?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Ah. You can tell?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","shy")
	await novel_interface.show_dialog("But you’re not like Elluka or Raphilia...", "Soya")
	novel_interface.change_expression("laugh")
	await novel_interface.show_dialog("You, like Ren, have an aura as pure as a baby’s!", "Soya")
	await novel_interface.show_dialog("... This is fascinating!", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya exclaims, shaking my shoulders in excitement.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("Wahhhhh!\n(Stop it! Can’t breathe!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile2")
	await novel_interface.show_dialog("Your seem to weigh less than I remembered.\nAren’t you a cutie?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The busty lady holds Ren even tighter.")
	await novel_interface.show_text_only("Meanwhile, Ren is flailing desperately, trying to escape her suffocating embrace.")
	novel_interface.show_character("soya_uniform","afraid")
	await novel_interface.show_dialog("... Anyway, who are you?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Oops, forgot to introduce myself.\nI’m Beatrice Portinari.", "Beatrice")
	await novel_interface.hide_character()
	
	# scene5 - 90分钟前的场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<90 minutes ago>")
	novel_interface.change_background("res://assets/images/bg/Soya/Club.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Agreed Demilitarized Zone, New Opulentia Stork Garden Hotel>")
	await novel_interface.show_text_only("<Outside Birdsong Hall, the banquet hall on the top floor>")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Whoa, they’ve got a garden up here on the 99th floor. Do people in Hovering Palace enjoy luxuries like this all the time?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru surveys the glass rooftops, smirking half-heartedly.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Maybe the higher the garden is, the more luxurious it seems? Or maybe 99 is the owner’s lucky number?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl scratches her head, confused.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("How did you decide that this auction is what we’re looking for anyway?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru trains her gaze on the spray-painted billboard at the entrance of the banquet hall.")
	await novel_interface.show_text_only("On it is the heading “Johnson’s Museum Autumn Auction”,\nfollowed by the subtitle: where art meets finance.")
	await novel_interface.show_text_only("The white text seems especially jarring over the blue background. Nothing artistic about it.")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("Is this really an auction for artworks? Doesn’t seem very aesthetically pleasing to me.", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nods and grins.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("But all five hundred seats are filled. Out of the sixty-three items, sixty have already been sold.", "Mariru")
	await novel_interface.show_dialog("A total of 1.5 billion has been made.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("That much? This auction must be huge, then.\nBut I haven’t heard a thing about it...", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("The electronically encrypted accounts you tipped us on... they contain funds worth billions.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("That’s a lot, but only enough to build two skyscrapers of this type.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("To use this amount of money to create an impact on the trillions of rebuilding funds the United Congress owns, there should be only one way...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Bribery? That’s why they chose encrypted currency?", "Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("The accounts may be encrypted, but any transactions made can be seen by everyone in the network. And a transaction this size—no way people won’t notice it.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("That’s why they need a feasible reason for the transaction...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld tilts her head to one side, thinking. Then she exclaims:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Oh, that’s why they’re holding an auction!", "Skuld")
	await novel_interface.show_dialog("Antiques without a set price are a good excuse for transactions worth a large amount. Stuff like china, jade, old paintings... no one would bat an eye if they saw someone bidding millions for them.", "Skuld")
	await novel_interface.show_dialog("And the transaction is held on international territory too. Makes it impossible for the tax departments from different nations to collect tax.", "Skuld")
	await novel_interface.show_dialog("All they need is to contact both sides of the trade and sell off some junk under the name of some privately-owned museum.", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("But they can’t let real art connoisseurs into the venue, because they’ll be able to tell something’s up at a glance.", "Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("So that’s why all seats are filled!\nThey’ve filled the seats with their own people!", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pats Skuld’s head approvingly.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Very clever. You probably get bored at school a lot, huh?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("What do you think?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld beams up at Mariru, looking proud.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Let me tell you something else, then.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("The “post-war rebuilding funds” are basically loans provided by the United Congress. The governments that borrowed from them must pay the money back, or face the wrath from the six major nations.", "Mariru")
	await novel_interface.show_dialog("But historically, no nation was ever able to repay a loan this size within the deadline. That’s where scope for negotiation comes in.", "Mariru")
	await novel_interface.show_dialog("The Committee is filthy rich. All they want for themselves is probably the most lucrative sector, for example basic infrastructures like power and communications.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("They can simply make a proposal to the heads of the governments that borrowed money: that they won’t need to pay the borrowed amount back as long as they permanently give the Committee 30% of the shares of their telecommunications network.", "Mariru")
	await novel_interface.show_dialog("The governments, unable to pay back the loans, will usually agree. Some of the nation leaders may even actively request rebates in private.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("So how does the Committee gain control over the “sectors” they want?", "Skuld")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("They have to convince the United Congress to let multinational corporations own funds and have a certain degree of autonomy...", "Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("That’s a lot to ask for. Will they really agree?", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Instead of answering, Mariru simply asks another question.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("This spray-painted art looks like a kindergartener did it. What does that tell you?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("That whoever did it wasn’t trying hard enough to conceal the fact that it’s all fake.", "Skuld")
	await novel_interface.hide_character()
	
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("A lot of money is involved, though. They had to rent the top floor of the hotel and hire hundreds of people. They already spent so much—so why didn’t they spend a lot on the graphics too?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Well…", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld pouts, stumped by all the new information.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Well, it’s because this isn’t new to them. It’s happened countless times already. Both here and somewhere else.", "Mariru")
	await novel_interface.show_dialog("No one‘s ever suspected or called them out. So they no longer bother to conceal it.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Bribery is an art in itself, especially this underhanded type of bribery. They need to collect an immense amount of information and make sure everyone involved is satisfied at every level.", "Mariru")
	await novel_interface.show_dialog("Heaps of investigations have to be done. Countless people become part of the operation. Exchanges of benefits, like this one we see today, have happened numerous times.", "Mariru")
	await novel_interface.show_dialog("They’ll have to negotiate with heaps of people. Officials, media channels, worker alliances, non-governmental organizations, even those in a high position in organized crime.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("That’s how they influence key decisions made by the United Congress.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nods at the closed door of the banquet hall.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("That’s what’s actually worth the most in this auction.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld hangs her head and sighs.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("This sucks... it feels so dishonest...", "Skuld")
	novel_interface.change_expression("talk")
	await novel_interface.show_dialog("Wait, was that what you’ve been planning since the beginning?", "Skuld")
	await novel_interface.show_dialog("You didn’t want to arrest those masterminds manipulating the rebuild project...", "Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, the door to the banquet hall opens by a small crack. Fabella holds out a hand, giving them an OK sign.")
	await novel_interface.show_text_only("It’s the signal that all items have been sold and the transaction between the electronically encrypted accounts is about to happen.")
	await novel_interface.show_text_only("Mariru picks up her walkie-talkie.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Retrieval team, block all entrances to the 99th floor, including the elevator shaft. Alert the hotel that a large dose of radioactive pollution substances have been detected on the 98th floor.", "Mariru")
	await novel_interface.show_dialog("Cut all network signals and means of communication in the building. Once I say go, impose radio silence.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Go!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	
	# scene6 - 回到现场
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Brooklyn.mp3")
	await novel_interface.show_text_only("Beatrice finally lets me breathe. She prods me to turn around so that my back is facing her, and whispers into my ear.")
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Wait until I say “go”. And don’t peek!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She then shoves me towards the direction of the truck which Elluka is on. I try my best to force my way through the crowds, with Sonya following from behind.")
	await novel_interface.show_text_only("Meanwhile, Beatrice calmly stalks off towards another truck nearby, pushing men out of the way like a high and mighty queen.")
	await novel_interface.show_text_only("Whoever turns around to scream at her loses their senses immediately when they see her face.")
	await novel_interface.show_text_only("Beatrice nimbly climbs up onto an unoccupied truck, where two workers are performing a sound check on the roof.")
	await novel_interface.show_text_only("She grabs a mike and watches until Sonya and I manage to squeeze as closely to Elluka’s truck as possible, then motions at the workers to turn her mike to max volume.")
	novel_interface.show_character("beatrice_regular","smile1")
	await novel_interface.show_dialog("Go!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hearing her orders, I nod at Sonya.")#换行问题
	novel_interface.show_character("ren_fishnet","solemn")
	await novel_interface.show_dialog("Go!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With the speaker on max volume, whatever Beatrice says next will reach the ears of every single person on Electronics Street for sure.")
	await novel_interface.show_text_only("Standing proud on the roof of the truck, she takes a deep breath and screams into her microphone, letting her voice carry.")
	novel_interface.show_character("beatrice_regular","angry")
	await novel_interface.show_dialog("You’re garbage, all of you!", "Beatrice")
	await novel_interface.show_dialog("Go to hell, perverts!", "Beatrice")
	await novel_interface.hide_character()
	
	print("=== 天启篇第11话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
