# apocalypse_ep13.gd - 天启篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第13话剧本
	apocalypse_ep13_script()

func play_script():
	pass

# 天启篇第13话 - 正式剧本
func apocalypse_ep13_script():
