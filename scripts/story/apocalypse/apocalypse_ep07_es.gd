# apocalypse_ep07.gd - 天启篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第07话剧本
	apocalypse_ep07_script()

func play_script():
	pass

# 天启篇第07话 - 正式剧本
func apocalypse_ep07_script():
	# scene1 - 继续美术馆对话
	novel_interface.show_background("res://assets/images/bg/Soya/Galleries.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Se suicidó el portavoz de Masada Ford? ¡Pero eso es imposible!", "Rafael")
	await novel_interface.show_dialog("Se veía tan engreído en la conferencia de prensa... en lugar de comerse una bala, es mucho más probable celebrar con champán. ¿No podría haberle disparado alguien más?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("cereza","blink")
	await novel_interface.show_dialog("Bueno, el equipo de servicios especiales de Menorah parece un grupo capaz...", "Theresa")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Pero no lo suficientemente capaz como para colarse en la suite, dispararle al objetivo y hacer que parezca un suicidio.", "Theresa")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("¿O tal vez lo estaban chantajeando?", "Rafael")
	await novel_interface.show_dialog("O, tal vez, era simplemente una pieza de ajedrez que la gente de allá arriba ya no necesitaba...", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("cereza","smile")
	await novel_interface.show_dialog("Está bien, está bien, dejemos las conjeturas para más tarde. Ven ahora.", "Theresa")
	await novel_interface.show_dialog("La Primera Avenida, donde está la sede del Congreso Unido, ya está inundada de manifestantes. La situación pronto estará fuera de control.", "Theresa")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Además, ¿no se lo prometiste ya a tu abuelo?", "Theresa")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Theresa le da una palmada en la espalda a Raphilia y le susurra algo al oído.")
	novel_interface.show_character("ren_fishnet","normal2")
	await novel_interface.show_dialog("(Teresa no parece europea...)\n(¿Y ella lleva una katana en un distrito comercial, así como así? Es casi como si estuviera haciendo alarde de ella...)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Es cierto que las armas de este tipo no están prohibidas en esta área…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Después de terminar su pequeña sesión de susurros, Raphilia asiente con la cabeza hacia Theresa y les hace un gesto a todos para que bajen juntas las escaleras.")
	
	# scene2 - 夜晚电器街
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Salimos de la galería de arte y llegamos a las calles.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("El sol apenas se ha puesto. Las farolas ya están encendidas e iluminan la bulliciosa Electronics Street con su cálido resplandor amarillo.")#不确定
	novel_interface.show_character("iluka_uniform","speechless")
	await novel_interface.show_dialog("Vaya...", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Esa es mucha gente...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("¿Está sucediendo algún tipo de evento por aquí?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Acabo de comprobarlo en línea. Parece que muchas tiendas tuvieron que cerrar temporalmente durante la reciente restricción de tráfico...", "séquito")
	await novel_interface.show_dialog("Pero la restricción se levantó ayer por la noche y el gran evento de reapertura previsto para el próximo lunes también se trasladó a hoy.", "séquito")
	await novel_interface.show_dialog("Los participantes del evento recibirán productos limitados y gratuitos de algunos animes.", "séquito")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","stare")
	await novel_interface.show_dialog("P-podría ser...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noto que muchos peatones sostienen una pequeña bandera amarilla que dice \"Acceso restringido\". Es un elemento que se ve a menudo en uno de los animes más populares de estos días.")
	await novel_interface.show_text_only("Ese anime consistía en niñas adorables con uniformes de jardín de infantes, trabajando duro con banderitas en sus manos. Muchos espectadores se habían enamorado de su pura ternura, incluyéndome a mí.")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("(¡Oh, es de ese programa!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No puedo evitar emocionarme un poco.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Mmmm?", "Rafael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Eh, nada, nada...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Oculto rápidamente mi emoción. Ahora soy prácticamente un profesional en eso.")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Me tengo que ir. Será mejor que ustedes también se vayan.", "Rafael")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Parece que algo loco va a pasar esta noche.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia mete una gema verde del tamaño de una canica en mi mano.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Henriette hizo esto. Podría resultar útil si alguien resulta herido.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphilia evita resueltamente mis ojos, pareciendo súper avergonzada.")
	novel_interface.show_character("ren_fishnet","gratified")
	await novel_interface.show_dialog("Oh... Henriette, eh...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ha pasado un tiempo desde la última vez que oí hablar de ese alquimista que insistía en llamarme \"Maestro\".")
	novel_interface.show_character("ren_fishnet","shy")
	await novel_interface.show_dialog("(Me pregunto qué pensaría si supiera que ahora soy yo quien tiene que llamar Maestro a los demás con un traje de sirvienta...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("De todos modos, cuídate.", "Rafael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pueda responder, Raphilia desaparece junto con Theresa y su séquito.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Los veo desaparecer entre la multitud de Electronics Street.")
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.show_character("soya_uniform","jest")
	await novel_interface.show_dialog("Hm, ella todavía está abrazada a ese libro con el que acaba de golpearme en la cabeza...", "Soya")#换行问题
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡No es de extrañar que tenga tanta prisa por irse!")
	novel_interface.show_character("ren_fishnet","smile")
	await novel_interface.show_dialog("Oye, ¿qué pasa si también revisamos ese evento antes de regresar?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A mí también me encantaría tener mi propia banderita amarilla. Pero antes de que pueda terminar la frase, Sonya me arroja contra una pared.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Lo estabas disfrutando, ¿eh? Crees que sorprenderme con la tobillera es totalmente divertido, ¿eh?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("Ah, no...\n¡Lo siento!", "Lian")
	# removed legacy empty placeholder comment
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy cuenta de que es posible que haya bajado la guardia demasiado pronto.")
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Me lo pregunto desde esta tarde...", "Soya")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("Teresa, Raphilia y Elluka...", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("(¿Los tres? ¿Qué tienen en común?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","smile")
	await novel_interface.show_dialog("Sus auras huelen a bruja, pero tienen colores parecidos a los de los humanos.", "Soya")
	novel_interface.change_expression("jest")
	await novel_interface.show_dialog("Eso no es lo que esperaba.", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mete el corazón con los dedos índice y medio con fuerza. Sus ojos son acerados, fríos y decididos. Una cosa está clara:")
	await novel_interface.show_text_only("Si miento, muero.")
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("¿Quieres decir... Theresa también es una de esas personas?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("¿Una de esas personas?", "Soya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mantengo mis ojos en el rostro de Sonya mientras intento encontrar las palabras correctas.")
	novel_interface.show_character("ren_fishnet","wry_smile")
	await novel_interface.show_dialog("Como chicas que recibieron la “información” de la magia, pero aún están cuerdas.", "Lian")
	await novel_interface.show_dialog("Algunas de ellas son incapaces de soportar la carga del conocimiento y pierden la cordura, convirtiéndose así en el tipo de brujas que quieres matar.", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Hay una diferencia entre los dos.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sonya mantiene sus ojos fijos en los míos mientras habla:")
	novel_interface.show_character("soya_uniform","wordless")
	await novel_interface.show_dialog("Entonces, aquellos que pierden la cordura… ¿podrán recuperarse?", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","upset")
	await novel_interface.show_dialog("Teóricamente no. Al menos eso es lo que dijo Aya...", "Lian")
	await novel_interface.hide_character()
	
	# scene3 - 回忆场景
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("<Hace unas semanas>")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Harima Tech terminó de escanear nuestros especímenes de brujas. Han encontrado algo interesante...", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("¿Ejemplos? ¿Se refiere a aquellos que los militares capturaron en las colinas del norte “por un precio enorme”?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Afortunadamente sólo estoy a cargo de las anomalías bajo la cobertura de Aegis...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Bueno, hacer ataduras para mantenerlos en su lugar tomó algo de tiempo...\nDe todos modos, no los aburriré con los detalles. Iré directamente a los resultados que encontramos.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Primero, el cuerpo de una bruja está controlado por el cerebro. Sin embargo, no tiene en cuenta sus propios límites físicos.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Hypnosis.png")
	await novel_interface.show_dialog("Por lo general, un humano establecería una especie de límite subconsciente en su propio cuerpo con fines de autoprotección. Este límite se puede cancelar temporalmente mediante hipnotismo y métodos similares.", "Ai")
	await novel_interface.show_dialog("Por ejemplo, una persona hipnotizada puede permanecer inmóvil como una tabla rígida con sólo la cabeza y los pies sostenidos por un estante, mientras que no hay nada que los sostenga en el medio.", "Ai")
	await novel_interface.show_dialog("Y ni siquiera se inmutarán cuando se les coloque más de veinte libras de peso sobre el estómago. Un ser humano plenamente consciente no sería capaz de hacer eso.", "Ai")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("El cerebro de una bruja trata el cuerpo como un consumible. Es por eso que pueden moverse en ráfagas anormalmente poderosas, pero esto, por supuesto, puede dañar sus cuerpos.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("(Por eso es que pueden torcer sus articulaciones de maneras espeluznantes, eh...)", "Lian")#换行问题
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("En segundo lugar, el cerebro de una bruja sigue recibiendo información de una fuente desconocida, incluso en un entorno bloqueado por ondas electromagnéticas. La velocidad a la que reciben la información sigue aumentando cada segundo.", "Ai")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Es como si fueran un disco duro, en el que se introducen datos y luego se eliminan una y otra vez. En teoría, el ancho de banda máximo está determinado por la velocidad a la que se ingresa y luego se elimina la información de sus células cerebrales.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Pero esto supone una carga enorme para las células, que como resultado mueren. Las células restantes tendrán que soportar una carga aún mayor, por lo que morirán aún más rápido.", "Ai")
	await novel_interface.show_dialog("Lo que queda de su conciencia simplemente se disiparía como una gota en el océano.", "Ai")#换行问题
	await novel_interface.show_dialog("Considerándolo todo, las brujas tienen límites; después de todo, el cuerpo humano solo puede soportar hasta cierto punto. Sus poderes mágicos están restringidos por su cuerpo físico y su cerebro.", "Ai")
	await novel_interface.show_dialog("Podemos decir que el cuerpo y el cerebro de una bruja son simplemente baterías que deben agotarse.", "Ai")
	await novel_interface.show_dialog("Y el límite de rendimiento de estas baterías está determinado por el nivel más alto de descarga que pueden soportar mientras están en estado de cortocircuito.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sé que Aya había leído los perfiles completos de esas \"brujas\", cuando todavía estaban vivas. Ella también debe haber intentado varias formas de devolverles la conciencia.")
	await novel_interface.show_text_only("Los describió como si fueran objetos sin personalidad, pero probablemente fue su manera de decirme que está bien darlo todo cuando lucho contra ellos y que no necesito sentirme culpable por ello.")
	await novel_interface.show_text_only("La razón humana es como una presa: por muy resistente que parezca, en el momento en que se rompe, sólo puede haber un resultado.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Y el trabajo de Sonya es minimizar el daño en el momento en que se rompa la presa.")
	await novel_interface.show_text_only("No debe haber sido fácil para ella.")
	
	# scene4 - 回到现在
	novel_interface.show_background("res://assets/images/bg/Soya/AkihabaraN.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Sonya me libera lentamente de su agarre, aliviada, después de escuchar mi respuesta.")
	await novel_interface.show_dialog("... ¿Es así?", "Soya")
	await novel_interface.show_text_only("Su voz es pequeña, temblorosa.")
	await novel_interface.show_dialog("¿Sabes qué...? Cuando Teresa te guió para “disparar una flecha invisible” con tu brazo...", "Soya")
	await novel_interface.show_dialog("Pensé que me matarías con seguridad...", "Soya")
	novel_interface.show_character("ren_fishnet","panic")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cuando ella tocó tu cuerpo y comenzaste a “cargarte”, pude sentir que las auras de ambos aumentaban en poder, al menos diez… no, cientos de veces el original.", "Soya")
	await novel_interface.show_dialog("Cualquiera habría sido devorado por un poder como ese.", "Soya")
	await novel_interface.show_dialog("Pero vi esa aura carmesí, tan poderosa que penetró todo el edificio, dispararme a través de mí. Y aun así, no me lastimé en absoluto...", "Soya")
	await novel_interface.show_text_only("Cuando Sonya levanta la cabeza para mirarme, veo que está sonrojada.")
	novel_interface.show_character("soya_uniform","laugh")
	await novel_interface.show_dialog("—¡Nunca en mi vida había visto algo tan hermoso como esa aura!", "Soya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_fishnet","wail")
	await novel_interface.show_dialog("(... ¿Qué tipo de reacción es esa?)", "Lian")
	await novel_interface.hide_character()

	print("=== 天启篇第07话结束 ===")
	
	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
