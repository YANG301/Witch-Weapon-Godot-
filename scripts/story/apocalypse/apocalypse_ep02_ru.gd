# apocalypse_ep02.gd - 天启篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第02话剧本
	apocalypse_ep02_script()

func play_script():
	pass

# 天启篇第02话 - 正式剧本
func apocalypse_ep02_script():
	# scene1 - 客厅早晨
	novel_interface.show_background("res://assets/images/bg/APT/livingRoom_daytime.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Кадры операции по спасению заложников можно увидеть во всех пятничных утренних новостях.")
	await novel_interface.show_text_only("Поскольку СИД перекрыло все пути отхода в зоне действия «Иджис», у похитителей не было другого выбора, кроме как временно держать заложника на заброшенном складе.")
	await novel_interface.show_text_only("Четыре террориста, подозреваемые в похищении одного из руководителей Объединенного совета, были арестованы. Удовлетворительное завершение этого инцидента.")
	await novel_interface.show_dialog("Убийства и похищения людей средь бела дня на международной территории – как будто они требуют войны со всеми странами-членами Объединенного Конгресса!", "Ламберт")
	await novel_interface.show_dialog("Этот инцидент является свидетельством того, что терроризм окружает нас повсюду. Недавние действия «Потока пространства-времени» также могут иметь какое-то отношение к террористам.", "Ламберт")
	await novel_interface.show_dialog("Как человек, переживший войну, я твердо верю, что запугивание является важным средством обеспечения безопасности и мира.", "Ламберт")
	await novel_interface.show_text_only("Я усмехаюсь, пропуская интервью, которое, очевидно, является чушью по сценарию, и в то же время жую восьмидесятую картошку чипсов за час.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Этот парень... он чуть не умер? (Мунк-мунк)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Да. Разве они не спасли его всего несколько часов назад? И он уже произносит речь. Хм. Подозрительно...", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Тем не менее, эта часть с вертолетами и спасательной командой была довольно крутой. Почти как в кино.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","smile")
	await novel_interface.show_dialog("Мм, так круто!", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эллука кивает с торжественным лицом.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("По большей части это просто отличный монтаж и отличная фоновая музыка. Кому не нравятся кинематографические эффекты, верно?", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Из-за важного события, которое проходит в городе, занятия в школе в эти дни начинаются довольно поздно, около десяти тридцати. Мы также заканчиваем занятия намного раньше.")
	await novel_interface.show_text_only("Энни, Эллука и я свернулись клубочком на диване, как маленькие хомяки, и делимся фишками (скорее, Энни украла их у меня).")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Разве разведданные SID не были главной причиной успеха спасения?\nВ новостях нас даже не отметили...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("В конце концов, спецслужбам нужна анонимность, чтобы выжить. Приходится летать под радаром.", "Энни")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","panic")
	await novel_interface.show_dialog("Мисс Рен...\nХочется шоколада...", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Маленькая головка Эллуки внезапно высовывается между мной и Энни.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Шоколадный Поки?\nМагазин внизу, похоже, закончился. Мы купили все это.", "Лиан")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Я принесу тебе еще немного, когда мы в следующий раз пойдем в супермаркет.", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_uniform","sleepy")
	await novel_interface.show_dialog("Но... я хочу этого... сейчас...", "Эллука")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эллука надувает губы, тряся пустой коробкой перед моим лицом, нижняя губа дрожит.")
	await novel_interface.show_text_only("Но сейчас слишком жарко, чтобы выходить на улицу. Все, чего я хочу, — это оставаться дома, наслаждаться кондиционером и быть картошкой.")
	await novel_interface.show_text_only("Мариру была занята в эти дни. В конце концов, в Согласованную демилитаризованную зону прибыло множество важных фигур, чтобы принять участие в четвертом Международном форуме мира.")
	await novel_interface.show_text_only("Масштаб Форума в этом году поистине впечатляет. Каждый из пяти Академгородов, помимо Новой Опулентии, прислал по сотне представителей.")
	await novel_interface.show_text_only("Вдобавок конференция лидеров правительства на высшем уровне. Естественно, это вызвало множество проблем в повседневной жизни людей.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Многие районы города теперь являются временными зонами, свободными от велосипедистов. Действительно неудобно для нас при заказе доставки.", "Энни")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— жалуется Энни, прокручивая страницы на телефоне, беспорядочно растянувшись на диване.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ладно, ладно, я пойду принесу вам, ребята, чего-нибудь перекусить.\nЭнни, тебе нужно, чтобы я что-нибудь принес?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Хе-хе...", "Энни")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_uniform","smile",0.25)
	await novel_interface.show_dialog("Мвахаха…", "Эллука")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Они вдвоем быстро перечисляют десятки предметов, выглядя при этом совершенно самодовольными.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	
	# scene2 - 扶梯上
	novel_interface.show_background("res://assets/images/bg/Soya/Escalator.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_dialog("Почему так жарко?", "Лиан")
	await novel_interface.show_dialog("я таю...", "Лиан")
	await novel_interface.show_text_only("Еще рано, супермаркет только открылся, но на улице уже душно.")
	await novel_interface.show_text_only("Я бреду вперед, таща за собой огромный мешок с фаст-фудом. Кажется, в эти дни на улицах слоняется много сотрудников службы безопасности.")
	await novel_interface.show_text_only("Установлено множество зон ограничения транспорта. Граждане должны всегда иметь при себе удостоверения личности.")
	await novel_interface.show_text_only("Полицейские машины и помощники службы безопасности можно встретить на каждой остановке общественного транспорта.")
	await novel_interface.show_text_only("Транспортировка в основном ограничена в Согласованной демилитаризованной зоне. На всех фонарях главной улицы установлены новейшие устройства наблюдения.")
	await novel_interface.show_text_only("Я слышал, что, поскольку в городе не хватает солдат службы безопасности, Объединенному Конгрессу приходится нанимать всех наемников, которых может предложить Ритналап.")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("(Тем не менее, я думаю, что бдительность понятна...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю вниз с эстакады и вижу группу проходящих мимо участников марша. За ними следует оператор какого-то новостного канала, снимающий шествие.")
	await novel_interface.show_text_only("Прошло не так много времени, как закончилась война. Естественно, всевозможные организации, группы и каналы СМИ были бы рады найти аудиторию в Новой Опулентии во время такого важного события.")
	await novel_interface.show_text_only("У всех организаций разные цели — региональные конфликты, расовые проблемы, проблемы беженцев, религиозное притеснение, экономические проблемы… что угодно, есть организация, которая кричит об этом.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Здесь даже есть миссионерские группы, ищущие новых последователей. Неужели они не могли выбрать для этого какой-нибудь менее хаотичный период?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("По словам Мариру, последние три Международных форума мира тоже прошли не очень гладко.")
	await novel_interface.show_text_only("Предыдущий должен был пройти в Масада Форд, но им пришлось переехать в Салмонтон из-за частых терактов на границах.")
	await novel_interface.show_text_only("Затем на прошлогоднем Форуме доктор Декерс неожиданно объявил, что Салмонтон теперь откроет свои двери для всех беженцев. Это, конечно, привело к многочисленным крикам и беспорядкам.")
	await novel_interface.show_text_only("После этого Рафилия сделала политически некорректный комментарий, из-за чего ее семья в конечном итоге отправила ее в Новую Опулентию.")
	await novel_interface.show_text_only("А годом ранее... террористы разбомбили целый квартал в Ньюморидасе. Даже отправили военные вертолеты.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Это, наверное, было ужасно...", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/protest.png")
	await novel_interface.show_text_only("Два дня назад Скулда пригласили на благотворительное мероприятие в районе посольства, и он сделал щедрое пожертвование голодающим детям в Южной Америке.")
	await novel_interface.show_text_only("По совпадению, веганская организация из Европы протестовала против убийства животных за пределами места проведения мероприятия.")
	await novel_interface.show_text_only("Некоторые из них раздевались и лежали на земле, имитируя куски стейка.")
	await novel_interface.show_text_only("Мы наблюдали, как горничная налила горшок пурпурного соуса с щупальцами кальмара на «стейк» из прямой трансляции по телевизору.")
	await novel_interface.show_text_only("Несчастный «стейк» пополз на четвереньках, визжа во всю глотку.")
	novel_interface.change_background("res://assets/images/bg/Soya/Escalator.png")
	await novel_interface.show_text_only("А сегодня на официальном сайте организации появилось заявление, в котором утверждается, что ее члены получили тяжелые травмы.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ха-ха-ха...\n(Надеюсь, Фабелла понимает, насколько ужасно она сейчас готовит!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно у меня в сумке завибрировал телефон.\nМариру отправила сообщение.")
	novel_interface.show_character("ren_uniform","bored")
	await novel_interface.show_dialog("Хм. Доложите сегодня в штабе, да?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("<Десять часов назад>")
	
	# scene3 - SID指挥室
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("<23:15, диспетчерская СИД>")
	await novel_interface.show_text_only("Рыжеволосая женщина в военной форме стоит, скрестив руки на груди, и пристально смотрит на дюжину красных скобок, быстро движущихся по черно-белому экрану.")
	await novel_interface.show_text_only("В нижней части экрана внезапно появляется окно чата.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Босс, согласно нашим данным, заложник сэр Ламберт все еще находится где-то под прикрытием \"Иджиса\".", "Агент SID")
	await novel_interface.show_dialog("Анализ результатов наблюдения показывает, что похититель, скорее всего, находится в одном из этих трех мест. На заброшенном складе в районе залива наблюдается аномальное потребление электроэнергии...", "Агент SID")
	await novel_interface.show_dialog("Должны ли мы сообщить в Бюро обороны?", "Агент SID")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Пока нет. Окружите территорию и ждите моих приказов.", "Мариру")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Роджер, это.", "Агент SID")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Закрыв окно, Мариру переключается на военный чат.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Впереди гористая местность. Держите вертолёт на безопасной высоте, чтобы нас не заметили.", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Понял. У нас есть четкие изображения со спутника, чувствительного к теплу.", "Солдат А")
	await novel_interface.show_dialog("Они движутся так быстро... это действительно люди?", "Солдат А")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Технически... когда-то они были людьми. Просто больше нет.", "Мариру")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Все ли в том направлении, куда они направляются, эвакуированы? Если произойдет что-то ненормальное…", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Наши пушки и средства регионального уничтожения готовы.", "Солдат Б")
	await novel_interface.show_text_only("Мариру кивает. Она не хочет слишком много сливать военным.")
	await novel_interface.show_text_only("Кроме того, у нее было плохое предчувствие по этому поводу с самого начала миссии по слежению...")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("(Обычно мы имеем дело с теми «ведьмами», которые появляются за пределами центра Новой Опулентии, насильственно уничтожая их с помощью тяжелого огнестрельного оружия, которое военные заранее установили в этом районе.)", "Мариру")
	await novel_interface.show_dialog("(Согласно прошлому опыту, эти существа обычно случайным образом нападают на близлежащие живые существа или объекты после того, как их ведьмины коконы исчезают.)", "Мариру")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Но в течение последних двух недель они, кажется, демонстрируют идентичную картину...)", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Подождите... впереди кто-то есть!", "Солдат А")
	await novel_interface.show_dialog("Еще с собой бензопилу. Может, лесоруб?", "Солдат Б")
	novel_interface.show_character("liliu_uniform1","angry")
	await novel_interface.show_dialog("Идиот, какой лесоруб работает в одиннадцать вечера?\nКаковы результаты мем-теста?", "Мариру")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Зеленый. Это человечно!", "Солдат А")
	await novel_interface.show_dialog("И... человеческая девушка тоже?", "Солдат Б")
	novel_interface.change_background("res://assets/images/bg/Soya/thermal_Imaging.png")
	await novel_interface.show_text_only("Мариру немедленно увеличивает отснятый материал.")
	await novel_interface.show_text_only("На тепловизионном экране изображена маленькая девочка в бандане и с бензопилой, почти такой же большой, как она сама.")
	await novel_interface.show_text_only("И она машет этим стремительным лихим ведьмам.")
	await novel_interface.show_text_only("Ведущие ведьмы, предупрежденные звуком жужжащей бензопилы, меняют направление и ведут стаю в ее направлении.")
	await novel_interface.show_text_only("Колонию ведьм такого размера обычно может уничтожить только отряд тяжелобронированных и опытных пулеметчиков. У девушки нет шансов.")
	await novel_interface.show_text_only("Но прежде чем Мариру успевает предупредить команду по уборке, чтобы она позже забрала труп девушки, девушка просто поворачивается лицом к ведьмам, сияя, с бензопилой в руке.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Она меняет темп и позу, когда мимо проносятся бесчисленные ведьмы, умело уклоняясь от их атак и одновременно разрезая приближающихся ведьм на части.")
	await novel_interface.show_text_only("Ведьмы, словно свежее мясо, помещенное в мощный измельчитель, в конечном итоге превращаются в крошечные кусочки плоти.")
	await novel_interface.show_text_only("Девушка плавно движется и атакует, используя в своих целях законы инерции и центробежной силы. Она не кажется необычайно сильной — просто физика на ее стороне.")
	await novel_interface.show_text_only("Вероятно, она заранее провела некоторый расчет и выбрала бензопилу как наиболее эффективное оружие согласно характеристикам целей и собственной силе.")
	await novel_interface.show_text_only("В течение тридцати секунд те десятки ведьм, которых Служба безопасности и военные выслеживали в течение четырех дней, теперь превратились в не что иное, как измельченное мясо.")
	await novel_interface.show_dialog("Ч-что нам теперь делать?", "Солдат А")
	await novel_interface.show_text_only("Мариру вздыхает.")
