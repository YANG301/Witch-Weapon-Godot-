# apocalypse_ep01.gd - 天启篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放天启篇第01话剧本
	apocalypse_ep01_script()

func play_script():
	pass

# 天启篇第01话 - 正式剧本
func apocalypse_ep01_script():
	# scene1
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie.png")
	await novel_interface.show_text_only("Нас учат всевозможным добродетелям, согласно которым нужно жить.")
	await novel_interface.show_text_only("Я уверен, что большинство из нас читали историю о Марии Кюри и ее необыкновенных способностях к концентрации.")
	await novel_interface.show_text_only("Она училась, и ее сестра и одноклассники придумали розыгрыш. Позади нее поставили несколько стульев. Если бы она пошевелилась, вся стопка рухнула бы.")
	await novel_interface.show_text_only("Но стопка оставалась на месте даже до тех пор, пока Мария Кюри не прочитала всю книгу.")
	await novel_interface.show_text_only("Ее большое внимание позволило ей стать первым ученым, дважды получившим Нобелевскую премию.")
	await novel_interface.show_text_only("Но у вас мог возникнуть такой вопрос:")
	await novel_interface.show_text_only("\"Все ли чувствуют одинаково в отношении одного и того же предмета? С тех пор, как они родились?\"")
	await novel_interface.show_text_only("Некоторые люди рождаются со способностью безостановочно поглощать знания, и им почти не нужно спать.")
	await novel_interface.show_text_only("Они могут запоминать много информации и сохранять концентрацию в течение длительного времени.")
	await novel_interface.show_text_only("Для них это легко. Но для многих других это практически невозможно.")
	await novel_interface.show_text_only("Возможно, Марии Кюри читать книги по физике легче, чем читать мангу.")
	await novel_interface.show_text_only("Итак, стремление к одним и тем же «добродетелям» для большинства людей похоже на борьбу с генетическими особенностями, с которыми они родились.")
	await novel_interface.show_text_only("Возможно, вы раньше не задумывались над этим вопросом?")
	await novel_interface.show_text_only("Но теперь у вас есть. Семя было посажено в вашей голове.")
	novel_interface.change_background("res://assets/images/bg/Soya/Marie_Curie2.png")
	await novel_interface.show_text_only("Итак...")
	await novel_interface.show_text_only("В следующий раз, когда вы зададите себе этот вопрос, чей голос будет его задавать?")
	
	# scene2
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Нажмите.")
	await novel_interface.show_text_only("Звук заряжаемого огнестрельного оружия.")
	await novel_interface.show_text_only("После вступительной части новостей NTBC News звучит знакомый голос диктора-женщины.")
	await novel_interface.show_dialog("«Через три дня в согласованной демилитаризованной зоне в Новой Опулентии пройдет четвертый ежегодный Международный форум мира».", "Новости")
	await novel_interface.show_dialog("«Как нейтральный город с крупнейшей системой научных исследований, Новая Опулентия на этой неделе будет принимать гостей из других пяти Академгородов».", "Новости")
	await novel_interface.show_dialog("«Форум мира в этом году будет посвящен развитию вещества H как энергетического ресурса, проекту восстановления и другим важным вопросам».", "Новости")
	await novel_interface.show_dialog("«Спикер Масады Форд в недавней неформальной речи заявил, что город вскоре опубликует совершенно новый набор военных планов, чтобы восстановить порядок на Ближнем Востоке».", "Новости")
	await novel_interface.show_dialog("«Представитель отдела новостей Салмонтона отказался комментировать эту тему».", "Новости")
	novel_interface.show_background("res://assets/images/bg/Soya/Abduction_warehouse.png")
	await novel_interface.show_text_only("На старом складе висит тускло освещенная потолочная лампа, издающая тихие шипящие звуки электричества.")
	await novel_interface.show_text_only("Сбоку под резким белым светом сидит седовласый мужчина.")
	await novel_interface.show_text_only("Он привязан к прочному стулу, ножки которого приварены к земле.")
	await novel_interface.show_character("lambert","frown")
	await novel_interface.show_text_only("Мужчина все еще приспосабливается к окружающему его свету, поскольку мешок с его головы только что сдернули. Грубая корабельная арматура трётся о его дорогой сшитый на заказ костюм, оставляя грубые, потертые концы.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заметив звук взведения огнестрельного оружия, он медленно поднимает голову.")
	await novel_interface.show_text_only("Прямо перед ним установлена камера. А рядом стоит похититель в черной маске, указывая на него пистолетом.")
	await novel_interface.show_text_only("Мужчина отчаянно пытается осмотреться. Он замечает охранника в дальнем конце склада с автоматом в руках.")
	await novel_interface.show_text_only("По черной бандане, закрывающей лица, и камуфляжной одежде совершенно очевидно, откуда эти парни.")
	await novel_interface.show_text_only("Среброволосый мужчина изворачивается изо всех сил. На периферии своего поля зрения он видит черный флаг...")
	await novel_interface.show_text_only("На видеокамере перед ним установлен сотовый телефон, транслирующий новости на максимальной громкости.")
	await novel_interface.show_dialog("«Сэр Ламберт, исполнительный секретарь Организации Договора о запрещении экспериментов с оружием с веществом H, провел сегодня пресс-конференцию».", "Новости")
	await novel_interface.show_dialog("«Организация играет важную роль в предотвращении использования вещества H в качестве оружия. Она создана на основе Универсального договора о запрещении экспериментов с оружием с веществом H».", "Новости")
	await novel_interface.show_dialog("«Сэр Ламберт заявляет, что в настоящее время организация создала большое количество станций мониторинга по всему миру для наблюдения за всеми экспериментами с веществом H».", "Новости")
	await novel_interface.show_dialog("«Ламберт считает, что военное сотрудничество между Академгородами должно стать нормализованной частью их дипломатических отношений».", "Новости")
	await novel_interface.show_dialog("\"Он утверждает, что поддерживает разработку и экспериментирование Масады Форд с их системой пассивного ответного удара. Он объясняет, что разумное количество запугивания является истинной основой поддержания мира\".", "Новости")
	await novel_interface.show_dialog("«Он также публично просит о возможности поговорить с доктором Мариру фон Браун из Академии наук Новой Опулентии…»", "Новости")
