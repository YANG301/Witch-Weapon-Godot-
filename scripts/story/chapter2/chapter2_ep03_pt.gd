# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("“Escoltados” pelos agentes, Annie e eu entramos em um sedã preto.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("O habitáculo é sufocante.")
	await novel_interface.show_text_only("Envolvo meus braços em volta dos joelhos, perplexa.")
	await novel_interface.show_text_only("Annie se apoia em mim suavemente, o que me faz sentir um pouco relaxado.")
	await novel_interface.show_dialog("Então... o que é SID? \\nVocê fica nervoso toda vez que ouve isso.", "Annie")
	await novel_interface.show_dialog("Você é do espaço sideral? \\nSID é o departamento de inteligência sob o Senado.", GameConfig.player_name)
	await novel_interface.show_dialog("Alguns dizem que SID desempenha um papel mais importante do que o sistema de defesa Aegis para manter New Opulentia neutro.", GameConfig.player_name)
	await novel_interface.show_dialog("Mas existem mais lendas urbanas sobre pessoas levadas por SID e nunca mais voltam... É simplesmente horrível.", GameConfig.player_name)
	await novel_interface.show_dialog("Ok... Mas então, o que é a Cidade Acadêmica?", "Annie")
	await novel_interface.show_dialog("(Espere... Essa garota não tem nenhum bom senso?)", GameConfig.player_name)
	await novel_interface.show_text_only("Annie vê meu olhar surpreso... e ela apenas me dá um sorriso relaxado.")
	await novel_interface.show_dialog("Apenas relaxe, não teremos problemas!", "Annie")
	await novel_interface.show_dialog("Porque... você é especial.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("É estranho que as divagações de Annie de alguma forma tenham acalmado minha mente agitada.")
	await novel_interface.show_text_only("Não parece tão horrível ser levado embora por SID...")
	await novel_interface.show_text_only("(Não. Não. É horrível!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("Chegamos à movimentada área comercial da cidade e entramos em uma garagem comum no subsolo, onde pegamos um elevador para carros.")
	await novel_interface.show_text_only("Após o agente reportar, o elevador começa a se mover.")
	await novel_interface.show_text_only("Posso sentir o quão rápido o elevador está se movendo. Ele desce por longos trechos várias vezes e até muda de lado de vez em quando.")
	await novel_interface.show_dialog("(É difícil imaginar tal labirinto subterrâneo sob a área de negócios...)", GameConfig.player_name)
	await novel_interface.show_text_only("Rumores sobre a sede do SID abundam. Alguns dizem que está localizado nos subúrbios ao sul de New Opulentia, e toda a estrutura é revestida com camuflagem óptica.")
	await novel_interface.show_text_only("É claro que, para um prédio que não existe oficialmente no sistema, a mídia poderia inventar qualquer coisa, desde que atraia cliques.")
	await novel_interface.show_text_only("E onde estou entrando é exatamente na área central deste departamento “inexistente”.")
	await novel_interface.show_dialog("(Só espero não me tornar “inexistente” aqui...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Descemos do carro em frente a um corredor revestido de placas de metal. Dá uma sensação de tecnologia e abstinência.")
	await novel_interface.show_text_only("A porta do elevador fecha automaticamente assim que saímos. Ouvimo-lo sair enquanto continuamos pelo corredor escuro. O ar fica pesado e sombrio.")
	await novel_interface.show_text_only("Meu coração também está afundando...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("Seguimos direto pelo corredor e chegamos a uma sala iluminada, mas fechada.")
	await novel_interface.show_text_only("Parece uma espécie de sala de interrogatório, mas não há mesas nem cadeiras. Uma parede é um enorme painel de vidro.")
	await novel_interface.show_text_only("Antes que eu possa me virar para verificar aquela parede—")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Uau—!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Alguém coloca os braços em volta da minha cintura com força.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Ai… Dói!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando estou prestes a perder o equilíbrio, sinto minha cabeça cair em algo familiar, macio, mas firme.")
	await novel_interface.show_dialog("Bem... A julgar pela sua força central, o material de espionagem não é para você.", "Voz Feminina")
	await novel_interface.show_dialog("Achei que tínhamos alguns erros de varredura corporal, então queria confirmar pessoalmente.", "Voz Feminina")
	await novel_interface.show_dialog("Mas é bom.", "Voz Feminina")
	await novel_interface.show_text_only("A voz feminina atrás de mim parece familiar.")
	await novel_interface.show_text_only("Ela afrouxa os braços. Com um medo persistente, eu me viro. \\nA mulher na minha frente—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(Huh?! Isso é enorme!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Sra.... Sra.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Você a conhece?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ah? Tão rápido para revelar que você pode identificar agentes de outra agência de inteligência. \\nParece que você nunca planejou esconder quem você é...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(Puxa! Eu sou bobo…)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("É difícil de acreditar, mas essa mulher uniformizada na minha frente é a mulher que conheci no meu sonho.")
	await novel_interface.show_text_only("A figura esbelta... o cabelo ruivo... o olhar sádico...")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Você deve responder minhas perguntas honestamente agora.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Não dê desculpas nem faça truques.", "Mariru")
	await novel_interface.show_dialog("O interrogatório é uma das minhas especialidades. \\nEu não vou pegar leve com essa sua carinha fofa~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("Aquela atitude autoritária e provocadora e aqueles olhos confiantes com um toque de zombaria...")
	await novel_interface.show_text_only("Qual é o nome completo dela mesmo? \\nCerto, é...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Exatamente. Eu sou o chefe de SID. Meu nome é Mariru Von Braun.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("É ela!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Espere... o chefe de SID? \\nEla não era a cientista-chefe?!")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("Mas olhando de perto suas roupas e marcas nos ombros, ela provavelmente é uma chefão...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Suas meias e saltos altos são os mesmos de ontem.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ei, garota, o que você está olhando, hein?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Ah! Sim... certo! \\nDesculpe, senhora!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você tem coragem de deixar sua mente vagar agora.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ouvi dizer que você contou muitas histórias horríveis sobre SID para esse rabo duplo azul.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru gira o chicote nas mãos. Fico nervoso e engulo em seco.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Adivinhe... \\nQuantos deles são verdadeiros?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Uh! Eu sinto muito!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("B… cauda dupla azul…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Agora que você conhece o medo, vamos começar com sua identidade.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru abre seu terminal portátil e uma projeção aparece imediatamente na parede da sala de interrogatório.")
	await novel_interface.show_text_only("Ele mostra fotos minhas tiradas de diferentes ângulos por câmeras de vigilância, e o resultado da análise facial diz:")
	await novel_interface.show_text_only("[Nenhuma correspondência encontrada]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nenhum registro de chegada... Aegis não consegue identificar.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se não fosse o seu fraco condicionamento físico, você seria imediatamente tratado como um espião ou intruso terrorista.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("Sinto-me um pouco envergonhado e esfrego minha barriga inconscientemente.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", esta senhora parece ainda mais assustadora do que os inimigos que encontramos anteriormente...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Sim… e ela não terá nenhum problema em ver através das minhas mentiras...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(Vou confessar! Nossa! Tanto faz!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", por onde devo começar...?", GameConfig.player_name)
	await novel_interface.show_dialog("É um pouco complicado, para ser honesto. Estou muito confuso também.", GameConfig.player_name)
	await novel_interface.show_dialog("Você provavelmente não vai acreditar no que eu digo...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Pare de divagar. Eu julgarei isso por mim mesmo!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("… Bem… eu tive esse sonho.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("No sonho, fui ao Centro de Pesquisa assistir a uma palestra para meu relatório de ensino ao ar livre… E cheguei um pouco antes do horário de fechamento.", GameConfig.player_name)
	await novel_interface.show_dialog("Eu conheci você lá. E você disse que foi capturado...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Aparentemente, Mariru considera isso uma piada ou algo assim.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Quer dizer, você me conheceu em um sonho?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim, foi você. \\nE você me arrastou para um canto...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ah, certo... você era um cientista de classe SS reconhecido pelo Senado... \\nDr. Mariru Von Braun, certo?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Sou eu.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Mas esta informação não é secreta – qualquer pessoa familiarizada com New Opulentia sabe disso.", "Mariru")
	await novel_interface.show_dialog("... Esqueça. \\nEntão o que aconteceu a seguir?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você derrubou um dos intrusos e pegou uma pistola. Você me pediu para ficar parado e esperar pelo resgate e foi até o local do sequestro.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Local de sequestro? \\nOnde exatamente?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você disse que era a Sala de Conferências.", GameConfig.player_name)
	await novel_interface.show_dialog("Você estava prestes a dar uma palestra lá. Você foi o palestrante.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Palestra… Palestrante.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(Ela está falando sobre a palestra pública sobre Ross Goblet organizada por Wolfgang?)", "Mariru")
	await novel_interface.show_dialog("(Mas deveria ter sido cancelado. Como ela poderia saber disso?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum... Sra.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sim… nada. Prossiga.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E alguns homens armados mascarados apareceram. Desci correndo e me escondi na sombra de uma lousa...", GameConfig.player_name)
	await novel_interface.show_dialog("Desculpe, mas não me lembro do que aconteceu lá…", GameConfig.player_name)
	await novel_interface.show_dialog("De alguma forma, desmaiei e quando acordei, vi…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("O que você viu?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Vi fumaça e chamas por toda parte.", GameConfig.player_name)
	await novel_interface.show_dialog("O Centro de Pesquisa e os edifícios circundantes estavam todos em ruínas...", GameConfig.player_name)
	await novel_interface.show_dialog("Havia um cheiro pungente por toda parte.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Tinha um sabor fortemente salino e amargo...", GameConfig.player_name)
	await novel_interface.show_dialog("Todas as pessoas se transformaram em figuras de pedra.", GameConfig.player_name)
	await novel_interface.show_dialog("Não, não exatamente pedra – era sal.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("E eu vi algo brilhando no ar.", GameConfig.player_name)
	await novel_interface.show_dialog("Foi como o inferno. \\nMas de alguma forma posso sentir uma espécie de tranquilidade peculiar.", GameConfig.player_name)
	await novel_interface.show_dialog("Algo está me respondendo...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("E então minha memória ficou vaga... Pode haver um raio de luz—", GameConfig.player_name)
	await novel_interface.show_dialog("E… isso é praticamente o fim do sonho.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Quando acordei, me encontrei na cama do meu quarto e já era de manhã.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Foi... apenas um sonho...?", "Mariru")
	await novel_interface.show_dialog("Sua memória olfativa era tão vívida como se você realmente estivesse lá…", "Mariru")
	await novel_interface.show_dialog("(Se aquele cheiro pungente fosse enxofre...) \\n(Seria exatamente como Sodoma e Gomorra foram destruídas em Gênesis.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
