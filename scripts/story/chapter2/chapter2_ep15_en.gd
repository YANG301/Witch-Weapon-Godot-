# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Sigh... This skirt is still way too short...\nIt feels all chilly underneath...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Too many unbelievable things have happened these past few days.\nMy brain can barely keep up anymore...", "Lian")
	await novel_interface.show_dialog("The dream about the city being destroyed, waking up one morning to find I'd turned into a girl, and getting attacked by some completely inexplicable enemy...", "Lian")
	await novel_interface.show_dialog("None of it feels real at all.\nAnd on top of that...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, come in.", "Homeroom Teacher")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ah, y-yes!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-Nice to meet you for the first time!\nHello, everyone, my name is Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("I'm very happy to become classmates with all of you, so please take care of me from now on...\n...", "Lian")
	await novel_interface.show_dialog("(...Even though I'm becoming your classmate in the form of a girl high schooler whether I like it or not...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Please just spare me...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Alright then, Lian, take the empty seat in the back row.", "Homeroom Teacher")
	await novel_interface.show_dialog("(...A transfer student at this point in the term? That's unusual.)", "Classmate A")
	await novel_interface.show_dialog("(...She keeps staring at the floor. I bet she's really quiet, huh?)", "Classmate B")
	await novel_interface.show_dialog("(...But she's really cute... Is that hair color dyed?)", "Classmate A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Everyone's looking at me...\nUgh... the road ahead is going to be rough...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Phew, class is finally over... School life never used to be this exhausting.\nA high-achievement school really is different after all...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Crap... I need to use the bathroom...)", "Lian")
	await novel_interface.show_dialog("(N-No way, I absolutely cannot go into the girls' restroom at school...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ugh, what am I supposed to do...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("What's wrong~ Why are you sighing so much?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Huh? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("So? Are you settling into the new school alright? There are lots of very cute girls here~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh... let's not talk about that right now.\nDid your basic knowledge training finish already?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Hehe, I came over as soon as I passed the evaluation! If I left you here all alone, who knows what might happen to you.", "Annie")
	await novel_interface.show_dialog("Luckily I wasn't gone for very long, and New Opulentia is an immigrant city now, so I probably won't have too hard a time adapting.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Miss Mariru also asked me to take care of you~\nShe specifically arranged for us to be in the same class.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("I'm a grown ma—\nAnyway, I don't need anyone taking care of me~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Hehe, besides, I feel a lot more at ease when I'm by your side too...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("I heard that you volunteered to join SID together with me.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie looked grateful. I was momentarily at a loss for words, and I had no idea whether I'd actually be able to pass the tests smoothly...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh, right—the school nurse asked me to pass along a message. She wants you to go see her for a physical exam.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("A-A physical exam!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("We're transfer students, so the school has to give us separate checkups~\nOr are you upset you missed doing it together with the whole class...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Of course not!!\nI get it, but before that...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Rest... room...)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("I can't hear you... Say it louder~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Um, could you take me to the restroom...?", "Lian")
	await novel_interface.show_dialog("If I go in alone... I'd feel way too guilty. I don't dare go in by myself...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nAnd after you said you didn't need anyone taking care of you~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Alright already... hurry up...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...About the physical exam...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...The fact that I used to be a boy won't get exposed, right?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(What do they even check during a physical exam again?)", "Lian")
	await novel_interface.show_dialog("(And wait... do I have to take my clothes off?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Good thing I didn't get lazy and actually put on my underwear today...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(The infirmary... is it here?)", "Lian")
	await novel_interface.show_dialog("Excuse me, I'm the transfer student here for the physical exam...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Perfect timing. I've been waiting for you.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("A-A-A-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, no, why are you the one doing the exam?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Huh???\nAi, s-stop, stop that——!!", "Lian")
	await novel_interface.show_dialog("Wait... What's that weird flailing instrument you're holding??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Waaahhhh——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ugh... why is this happening...", "Lian")
	await novel_interface.show_dialog("They could've skipped all this stuff and that stuff, couldn't they...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("You're exaggerating way too much.\nIt's just a routine examination, routine~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... Vision in both eyes is 2.0. That's absolutely perfect.\nHas that changed from your old data?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh? My left eye used to be 1.0, and my right was 0.7.\nThe doctor even told me to sit farther away when I played games...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("How fascinating... Your body looks like it was reconstructed from the ground up, right down to your bones.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("And yet the neural topology of your brain simultaneously exhibits traits of both sexes, which is why your memories and thought patterns were preserved... is that it?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai sounded almost excited enough to tremble.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("If that's the case... then in theory, you should also be aware that you're becoming more sensitive to other people's emotions.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-No way...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Absolutely not! I'm one hundred percent male!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Anyway, from a medical standpoint, you're one hundred percent female without question.\nYour health is perfectly fine, except for one thing...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Except for what?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In a little while, you'll experience a bout of abdominal pain. Other than that, there are no problems at all~\nIt should be coming soon, so make sure you're prepared.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Stomach pain...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... Whaaat——???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Ai, you!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("I felt so wronged and powerless that I was on the verge of tears...\nUgh, I'm supposed to be a man—don't cry!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, this really is perfect... It's rare to see someone your age with not a single scar anywhere on their body.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("That doesn't make me happy at all!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Um—can I go back now...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai took off her white lab coat, put on an expression that said \"now I'm getting serious,\" and pulled two outfits out of the wardrobe...")
	await novel_interface.show_dialog("What are you talking about?\nThe fun part is only just beginning...", "Ai")
	await novel_interface.show_dialog("Mariru already approved it, so I get to have Lian try on all sorts of different clothes...", "Ai")
	await novel_interface.show_dialog("E-Eh—?", "Lian")
	await novel_interface.show_dialog("And then... hehehehe, I'm also going to study every single one of Lian's data points.", "Ai")
	await novel_interface.show_dialog("Yaaahhhhhhhhhhhh~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
