# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Wait, where are the paper you just collected?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ugh… The paper. I meant to tell you about that.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I hand over the pages I found on the battlefield to Annie. Elluka bites her tongue.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("The Wardenclyffe Manuscript… Marvelous! I can't believe you have found these!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("They fell off from those guys earlier. It just doesn't feel right… Annie, can you read them out?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um… The lines are blurred, but I can feel the magic flowing through them.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("The Grimoire… Grimoire Fragments, more precisely.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimoire… Is it something about the witches?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Actually, it's a book of witchcraft. The first script of this kind I've ever seen is a pamphlet coming out of nowhere.", "Annie")
	await novel_interface.show_dialog("If I remember correctly, the pamphlet is titled Mystical Trajectory. It just appeared out of thin air in my locker.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("At first, I thought it was the coach who gave it to me. The witchcraft inside was super weird, like teaching you how to change trajectories.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("But later, I found that the coach knew nothing about it. I thought it was a sort of superstition, so I never used it.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Not until…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It seems that Annie is done with recalling the past. She lowers her head and reads those scripts carefully.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("I remember Mariru said that Witches are humans who receive certain Substance H properties as a result of information contamination.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Contamination… for sure. I’d say it's very much to the point. Some \"information\" can hardly be erased once you get your hands on it.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Like those earworms and autotune remixes? I've tried a million times to get rid of them but always failed. Sometimes I just can't help humming the tunes when absent-minded…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ha. Well said, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Maybe these paper caused the Spacetime Flux? \\nBut… how is that even possible?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("It’s very likely. Such information can cost you a lot of energy, which is too much even for me.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("That's why we need certain \"Items\" to release the witchcraft, so that they can bear the cost for us.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie points at her baseball bat. Maybe that's why some weapons consume magic power…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("If an information overload happens, people may lose their sanity and go completely crazy…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Crazy… witches… \\nNeed… to be destroyed.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("So, witches… are the unfortunate ones, right? \\nAnnie, you know a lot.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Nah… \\nI'm just making assumptions based on my own experiences.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manuscript…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka seems lost in thought, her face brightens up with a look of eagerness.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Huh? What? You want to see them, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yes.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka looks at me longingly, like a small pet begging, her eyes brimming with tears.")
	await novel_interface.show_text_only("I can't turn her down, but these scripts are too dangerous…")
	await novel_interface.show_text_only("While I was hesitating, the thumps of a landing transport aircraft draw close.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Someone is coming!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID officer? Great, we found a… \\nWhat?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Surprisingly, the person walking out of the aircraft is not an SID agent.")
	await novel_interface.show_text_only("The man in glasses looks at Elluka tenderly, but she shivers with fear.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, you've kept me waiting for too long.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Administrator… I'm sorry.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Have you got the manuscript? \\nYou can’t handle them by yourself—I told you so. Bring them to me, now.", "Administrator")
	await novel_interface.show_dialog("Only useless trash would fail me on such a minor task, right?", "Administrator")
	await novel_interface.show_dialog("Clean up this mess, and then come with me to Oligar. There's another job waiting for you.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Whoa, whoa, whoa, watch your language! Can't you see that she is injured?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("She is just a little girl, not some tool you own!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The stranger doesn't seem to have noticed me until now. He scans me with a strange smile, like a predator inspecting his prey.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, take her with us.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Huh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Over my dead body. No one can take Lian as long as I’m here.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Take her…?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Yes, that's an order.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Order…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka stares at me, quite blankly. She seems to be in an inner struggle, but disobeying the Administrator is not an option.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Task: take Lian away. \\nTarget locked…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
