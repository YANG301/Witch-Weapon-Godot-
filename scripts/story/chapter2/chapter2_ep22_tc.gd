# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("對了，剛才妳收起來的那幾張紙在哪？", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("啊……我正想跟妳說呢。", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("我拿出剛才戰鬥後撿到的手稿遞給安妮，伊露卡在旁邊似乎欲言又止。")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Wardenclyffe\nManuscript……好厲害啊！你居然能找到這個！", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("這是之前那這群傢伙們身上掉下來的東西。 總覺得哪裡怪怪的……安妮可以讀出來？", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯——雖然很模糊，但確實能從它上面感受到魔力的流動。", "安妮")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("這應該就是「魔導書」……不，是魔導書的殘頁。", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("魔導書……是跟魔女有關的？", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("是記錄魔法資訊的文章，我第一次接觸這種東西的時候，是不知道哪裡冒出來的一本小冊子。", "安妮")
	await novel_interface.show_dialog("名字好像叫做《神秘彈道學》，就那麼憑空出現在我的置物櫃裡。", "安妮")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("一開始我還以為是教練發的，上面教的東西也很奇怪，比如改變彈道的魔法之類的。", "安妮")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("後來發現教練並不知道這本書，而且我覺得這只是迷信之類的，也從沒有使用過。", "安妮")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("直到……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮似乎不想再回憶了，低頭看著那幾張手稿。")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("我記得莉琉說過，「魔女」是吸收了某種資訊，而獲得了一些類似「異質物」特性的人類。", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("感染嘛……倒是很貼切的形容，雖說是“資訊”…\n…但有些“資訊”一旦沾染就永遠也忘不掉了。", "安妮")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("像是那種洗腦的廣告歌和鬼畜影片嗎？ 想忘也忘不掉，還會在放空時情不自禁地想起～", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("哈哈，小憐的形容很貼切呢。", "安妮")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("會不會是這幾頁紙，引起了時空波動？\n不過……真的就憑這幾張紙嗎？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("很有可能，這種資訊對人的精神損耗很大，就算我都能明顯的感覺到那種巨大的負擔。", "安妮")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("所以才要藉助某種「物品」釋放魔法，讓它們代替自己承受這種代價。", "安妮")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("安妮指了指自己的球棒，這種會消耗魔力的武器就是這麼產生的吧……")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("如果吸收了過量且難以負荷的資訊，甚至有可能會喪失心智變得瘋狂……", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("瘋狂，女巫……\\n需要，消滅。", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("女巫……就是那種不幸的人吧？ \\n安妮懂得真多呢。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("哎？ 也沒有啦……\\n我也只是根據自己的經驗做推斷而已。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("手稿……", "伊露卡")
	novel_interface.character_dark()
	await novel_interface.show_text_only("伊露卡露出若有所思又帶著嚮往的表情。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("嗯？ 怎麼啦，伊露卡？ ～也想看嗎？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯。", "伊露卡")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("伊露卡睜大了眼睛，像小動物一樣用水汪汪乞憐的眼神看著我。")
	await novel_interface.show_text_only("完全無法拒絕，但這麼危險的東西……")
	await novel_interface.show_text_only("我正在猶豫時，附近忽然傳來了運輸機降落的聲音。")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("有人來了！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("是SID的探員嗎？ 太好了，我們發現了一名……\\n咦？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("出乎我的意料，從運輸機上下來的，並不是SID的探員。")
	await novel_interface.show_text_only("戴著眼鏡的男人面目慈祥地看著伊露卡，但伊露卡卻露出了恐懼的神色。")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("伊露卡，這次動作很慢呢。", "管理員")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("管理員……對不起。", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("手稿拿到了嗎？ \\n跟妳說過不能自己消化吧，快點拿過來。", "管理員")
	await novel_interface.show_dialog("如果這點小事都辦不好，會變成那些沒用的東西哦。", "管理員")
	await novel_interface.show_dialog("這裡清理完畢後，馬上跟我去奧莉加執行下一個任務。", "管理員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("你那是什麼語氣！ 沒看到她受傷了嗎？", "小憐")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("她只是個小姑娘，不是你的工具！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("陌生的男人這時才注意到站在一旁的我，他笑咪咪的打量著我，就像注視著某種獵物。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("伊露卡，把這個人也帶走。", "管理員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("哎？ ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("我可不允許你做這種事，只要有我在，誰都別想帶走小憐！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("帶走……？", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("對，這是命令。", "管理員")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("命令……", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡一臉茫然地望著我，她似乎很痛苦的在抗拒著什麼。 但終究無法反抗管理員的指令。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("任務：帶走小憐。 \\n目標鎖定——", "伊露卡")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
