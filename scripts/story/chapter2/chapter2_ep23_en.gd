# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka assaults Annie and me with lightning magic. Not wanting to hurt her, all we can do is desperately defend ourselves.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("If this keeps up, all of us are going to get hurt...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hah… Ahh… \\nElluka, stop! Calm down!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Target locked. Continuing attack—", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A blazing strike cut through the air, followed by a blare. \\nI open my eyes, only to find myself unhurt.")
	await novel_interface.show_text_only("Behind the Administrator, the main rotor of the aircraft slowly topples over, \\nthen falls down like a broken twig.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Administrator")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ahem... everybody freeze——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("Mariru's voice rings out from a loudspeaker in the distance.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Miss Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Three helicopters appear overhead, and their blinding searchlights wash the ground in white as if it were broad daylight.")
	await novel_interface.show_text_only("Mariru is seated in the middle helicopter, shouting through a loudspeaker. The enormous gun mounted in front of her is still smoking.")
	await novel_interface.show_dialog("Ai's little toy really packs a punch. It actually took out the rotor shaft in a single shot.", "Mariru")
	await novel_interface.show_text_only("Mariru sounds a little too excited, like she'd love to fire another round... Hey, that thing already counts as a cannon, doesn't it?!")
	await novel_interface.show_text_only("The crashed transport's cockpit opens from within, and two pilots come tumbling out in a panic, scrambling for their lives.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hah… Haha…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A helicopter lands in the open lot outside the substation. Escorted by a crowd of heavily armed soldiers, Mariru strides toward us in high spirits.")
	await novel_interface.show_text_only("Having seen Mariru's face clearly, the Administrator spat ferociously on the ground.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph. Another SID lapdog.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("This isn't an SID operation. I'm here as an advisor to New Opulentia's Metropolitan Defense Bureau, carrying out a riot-suppression security mission.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Only then do I realize the people who got off the helicopters aren't SID agents at all. Every one of them is wearing an armband marked \"MD\".")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Isn't that right... Captain Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("That's right. The Metropolitan Defense Bureau suspects a terrorist attack against New Opulentia is underway here.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("I hereby order you and your men to cease hostilities immediately and come back with us for questioning.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("That wrestler-looking musclehead over there... I swear I've seen him before... Is he one of Mariru's acquaintances?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Those two cute girls are your subordinates? A department with no age limit sounds pretty nice...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... this little one...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hey, are you sure you want to do this?", "Administrator")
	await novel_interface.show_dialog("This is a demilitarized zone under the Agreement. Neither of your organizations has the authority to operate here.", "Administrator")
	await novel_interface.show_dialog("And there's no way you could have secured permission from the United Congress this quickly!", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Those multinational bureaucracies move at a snail's pace.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... sorry to disappoint you, but I'll be taking my people and leaving now.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ I'm not done talking yet... Johnson Heavy Industries, on the other hand, works a lot faster.", "Mariru")
	await novel_interface.show_dialog("After all, their eldest son is still studying in New Opulentia~ Right now, they're the ones asking me for favors...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("What?!", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Right now, three percent of this substation's load has already been fed into New Opulentia's city grid—", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("According to the Salmonton Agreement, any attack against the power grid of New Opulentia is deemed a first-class terrorist act.", "Mariru")
	await novel_interface.show_dialog("For incidents like this, the Metropolitan Defense Bureau holds the highest operational authority recognized by the United Congress.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("After all, our Aegis host… \\nCan't work without power.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("How could you possibly run Aegis off the city grid?! Cut the tricks!", "Administrator")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Enough talk. Take them away!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Wait! Masada Fort and New Opulentia signed a diplomatic-immunity agreement long ago, didn't they?", "Administrator")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The Administrator pulls out his identification from his coat pocket and smugly flashes it at Mariru and Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("I am Jacob Schmidt, military attaché of the Third Academy City, Masada Fort, to the United Congress.", "Administrator")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If you arrest me here, I assume it will cause some rather unnecessary diplomatic trouble, won't it?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("… \\nVery well. You’ve got one minute to get out of my sight.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("But, it seems that your vehicle has got some glitches… \\nSo, you may have to walk yourself home.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("What?! That's not fair!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Rules are rules. Hot-blooded impulse won't solve anything.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("But…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, we're leaving.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Wait, your identity has been verified, which is fine. But this little girl… I don't think she takes up any post in your Ministry of Foreign Affairs.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...You!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("I'm sorry, but she is a prime suspect in today's terrorist attack.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("If you try to take her by force, all I can do is regretfully inform your embassy that you were shot dead in a terrorist attack.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru pulls out a pistol and holds it against Jacob's head.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... She's nothing but a tool.\\nIf you want her that badly, then keep her!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Power level, critical… \\nHah… Activity terminated…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, who had been forcing herself to keep going this whole time, suddenly collapses to the ground like a machine that has lost power.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. In that state, she's probably useless anyway. Take care of the worthless scrap yourselves!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob pulls up his collar and quickens his pace, not casting even a single glance back. Soon, he disappears in the darkness.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, wake up! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, help her please!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("She still shows up on the life detector. She's probably just exhausted.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("And you—someone who still needs protecting himself—are out here shouting about saving other people?", "Mariru")
	await novel_interface.show_dialog("...You're turning more and more into a hot-blooded idiot.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Let's go home.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("That girl is our enemy, isn't she?", "Nantetsu")
	await novel_interface.show_dialog("Doesn't the Senate require all first-class terrorists to be detained immediately and then...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Have every helicopter keep its anti-scan modules running continuously. I'll have SID's four UAVs escort us in automatic counterattack mode.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("My people—I'll escort them personally. Anyone with a death wish is welcome to try me!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha… That's the Mariru I know.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru has the medical team treat our wounds, then takes Annie, Elluka, and me aboard the helicopter.")
	await novel_interface.show_text_only("Annie is so tired. She leans on my shoulder and soon falls asleep.")
	await novel_interface.show_text_only("Elluka is asleep too, sprawled across my lap with a bit of drool at the corner of her mouth. There's nothing left of that icy look she had just minutes ago.")
	await novel_interface.show_text_only("She's just an ordinary little girl after all... and for some reason, that fills me with relief.")
	await novel_interface.show_text_only("It'll be okay. Everything will work out, just like that song says—\\nEverything's gonna be OK.")
	await novel_interface.show_text_only("Even though peace now holds between the six Academy Cities, vast regions beyond their control are still ravaged by war.")
	await novel_interface.show_text_only("I wonder how many children like Elluka are still being used as weapons or tools...")
	await novel_interface.show_text_only("Mariru was right. I'm an idiot who always bites off more than I can chew.")
	await novel_interface.show_text_only("But I've hardly ever met anyone willing to drop all their guard and fall asleep peacefully beside me. Now there are two.")
	await novel_interface.show_text_only("… I like being an idiot.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
