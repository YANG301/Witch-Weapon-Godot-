# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Suspiro... Essa saia ainda é muito curta...\nParece todo frio por baixo...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Muitas coisas inacreditáveis aconteceram nos últimos dias.\nMeu cérebro mal consegue acompanhar...", "Lian")
	await novel_interface.show_dialog("O sonho da cidade sendo destruída, acordando uma manhã e descobrindo que havia me transformado em uma garota e sendo atacada por algum inimigo completamente inexplicável...", "Lian")
	await novel_interface.show_dialog("Nada disso parece real.\nE ainda por cima...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, entre.", "Professor de sala de aula")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ah, sim!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-Prazer em conhecê-los pela primeira vez!\nOlá a todos, meu nome é Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Estou muito feliz por ser colega de classe de todos vocês, então, por favor, cuidem de mim de agora em diante...\n...", "Lian")
	await novel_interface.show_dialog("(...Mesmo que eu esteja me tornando sua colega de classe na forma de uma estudante do ensino médio, goste ou não...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Por favor, me poupe...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tudo bem então, Lian, ocupe o lugar vazio na última fila.", "Professor de sala de aula")
	await novel_interface.show_dialog("(...Um aluno transferido neste momento do semestre? Isso é incomum.)", "Colega de classe A")
	await novel_interface.show_dialog("(...Ela fica olhando para o chão. Aposto que ela está bem quieta, né?)", "Colega de classe B")
	await novel_interface.show_dialog("(...Mas ela é muito fofa... Essa cor de cabelo é tingida?)", "Colega de classe A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Todo mundo está olhando para mim...\nUgh... o caminho a seguir vai ser difícil...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ufa, a aula finalmente acabou... A vida escolar nunca foi tão cansativa.\nUma escola de alto desempenho é realmente diferente, afinal...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Merda... preciso usar o banheiro...)", "Lian")
	await novel_interface.show_dialog("(N-De jeito nenhum, eu absolutamente não posso ir ao banheiro feminino da escola...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ugh, o que devo fazer...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("O que há de errado ~ Por que você está suspirando tanto?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hein? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Então? Você está se adaptando bem à nova escola? Tem muitas garotas muito fofas aqui~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh... não vamos falar sobre isso agora.\nSeu treinamento de conhecimentos básicos já terminou?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Hehe, vim assim que passei na avaliação! Se eu te deixasse aqui sozinho, quem sabe o que poderia acontecer com você.", "Annie")
	await novel_interface.show_dialog("Felizmente não estive fora por muito tempo e New Opulentia é uma cidade de imigrantes agora, então provavelmente não terei muita dificuldade em me adaptar.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("A senhorita Mariru também me pediu para cuidar de você ~\nEla providenciou especificamente para que ficássemos na mesma classe.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Sou uma mãe adulta—\nDe qualquer forma, não preciso de ninguém cuidando de mim~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Hehe, além disso, me sinto muito mais à vontade quando estou ao seu lado também...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Ouvi dizer que você se ofereceu para se juntar ao SID junto comigo.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie parecia grato. Fiquei momentaneamente sem palavras e não tinha ideia se conseguiria passar nos testes sem problemas...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, certo, a enfermeira da escola me pediu para passar uma mensagem. Ela quer que você vá vê-la para um exame físico.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("A-Um exame físico!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Somos alunos transferidos, então a escola tem que nos fazer exames separados ~\nOu você está chateado por não ter feito isso junto com toda a turma...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Claro que não!!\nEntendi, mas antes disso...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Quarto de descanso......)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Não consigo ouvir você... Diga mais alto~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Hum, você poderia me levar ao banheiro...?", "Lian")
	await novel_interface.show_dialog("Se eu for sozinho... me sentiria muito culpado. Não me atrevo a entrar sozinho...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nE depois que você disse que não precisava de ninguém cuidando de você~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Tudo bem... se apresse...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...Sobre o exame físico...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...O fato de eu ser menino não vai ser exposto, né?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(O que eles verificam durante um exame físico novamente?)", "Lian")
	await novel_interface.show_dialog("(E espere... eu tenho que tirar a roupa?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ainda bem que não fiquei com preguiça e coloquei minha calcinha hoje...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(A enfermaria... fica aqui?)", "Lian")
	await novel_interface.show_dialog("Com licença, sou o aluno transferido aqui para o exame físico...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Momento perfeito. Eu estive esperando por você.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("AAA-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, não, por que é você quem está fazendo o exame?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Hein???\nAi, e-pare, pare com isso——!!", "Lian")
	await novel_interface.show_dialog("Espere... O que é esse instrumento estranho que você está segurando??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Uauahhhh——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ugh... por que isso está acontecendo...", "Lian")
	await novel_interface.show_dialog("Eles poderiam ter pulado todas essas e outras coisas, não poderiam...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Você está exagerando demais.\nÉ só um exame de rotina, rotina~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... A visão em ambos os olhos é 2,0. Isso é absolutamente perfeito.\nIsso mudou em relação aos seus dados antigos?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein? Meu olho esquerdo tinha 1,0 e meu direito 0,7.\nO médico até me disse para sentar mais longe quando jogasse...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Que fascinante... Seu corpo parece ter sido reconstruído do zero, até os ossos.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("E ainda assim a topologia neural do seu cérebro exibe simultaneamente características de ambos os sexos, e é por isso que suas memórias e padrões de pensamento foram preservados... é isso?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai parecia quase animado o suficiente para tremer.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Se for esse o caso... então, em teoria, você também deve estar ciente de que está se tornando mais sensível às emoções das outras pessoas.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-De jeito nenhum...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Absolutamente não! Sou cem por cento homem!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("De qualquer forma, do ponto de vista médico, você é cem por cento mulher, sem dúvida.\nSua saúde está perfeitamente bem, exceto por uma coisa...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Exceto o quê?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Em pouco tempo, você sentirá uma crise de dor abdominal. Fora isso, não há nenhum problema ~\nDeve chegar em breve, então certifique-se de estar preparado.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Dor de estômago...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... O que——???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Ai, você!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Eu me senti tão injustiçado e impotente que estava à beira das lágrimas...\nUgh, eu deveria ser um homem - não chore!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, isso é realmente perfeito... É raro ver alguém da sua idade sem uma única cicatriz em qualquer parte do corpo.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("Isso não me deixa nada feliz!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Hum, posso voltar agora...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai tirou o jaleco branco, fez uma expressão que dizia \"agora estou falando sério\" e tirou duas roupas do guarda-roupa...")
	await novel_interface.show_dialog("Do que você está falando?\nA parte divertida está apenas começando...", "Ai")
	await novel_interface.show_dialog("Mariru já aprovou, então posso Lian experimentar todos os tipos de roupas diferentes...", "Ai")
	await novel_interface.show_dialog("E-Eh—?", "Lian")
	await novel_interface.show_dialog("E então... hehehehe, também vou estudar cada um dos pontos de dados de Lian.", "Ai")
	await novel_interface.show_dialog("Yaaahhhhhhhhhhhhh~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
