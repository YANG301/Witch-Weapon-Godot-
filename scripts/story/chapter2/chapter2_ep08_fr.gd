# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie est déjà installé dans la pièce voisine. Il y a certaines choses que je dois te dire seule.", "Mariru")
	await novel_interface.show_dialog("Je viens de recevoir une confirmation.", "Mariru")
	await novel_interface.show_dialog("Depuis ce matin, des anomalies spatio-temporelles à grande échelle sont apparues dans plusieurs grandes villes...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Les régions touchées que nous connaissons jusqu'à présent incluent Hovering Palace, Newmoridas, Masada Fort, Salmonton, New Opulentia et les îles Lebona.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Alors cela ne signifie-t-il pas...\nles six villes académiques... ?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("C'est vrai. Le monde entier regarde cela désormais, et l’ampleur de l’impact a largement dépassé les attentes.", "Mariru")
	await novel_interface.show_dialog("Je pense... il peut y avoir une possibilité...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Tout ce que vous avez décrit dans votre rêve : les terroristes attaquant le centre de recherche, la ville réduite en ruines...", "Mariru")
	await novel_interface.show_dialog("...tout cela s'est peut-être réellement produit.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("H-Comment est-ce possible ?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Je n'ai pas de preuve concluante, mais une distorsion dimensionnelle massive s'est peut-être déjà produite ce matin.", "Mariru")
	await novel_interface.show_dialog("Le satellite True Sight de SID a également détecté une explosion de bruit anormalement violente.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Peut-être que cela facilitera la compréhension : New Opulentia a en réalité été détruit une fois, mais une sorte de force a inversé cette réalité...", "Mariru")
	await novel_interface.show_dialog("Et cette force semble également être liée aux changements dans votre corps, ainsi qu'aux attaques de ces étranges ennemis.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Bien sûr, ce n'est encore que mon hypothèse.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Cette idée... n'est-elle pas un peu trop audacieuse... ?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("En raison des événements d'aujourd'hui, les cinq autres villes universitaires font toutes pression sur les Sénat pour qu'elles autorisent l'entrée pour enquête.", "Mariru")
	await novel_interface.show_dialog("Et si votre lien avec cet incident est révélé, être emmené par un institut de recherche sera le moindre de vos problèmes...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Les agents de toutes les agences de renseignement vous marqueraient comme une cible clé.", "Mariru")
	await novel_interface.show_dialog("Sans même compter ceux qui étaient déjà infiltrés, plus d'une centaine d'agents de renseignement de divers pays sont entrés aujourd'hui New Opulentia sous de fausses identités seulement.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Vous savez tout cela avec tant de détails ?\nPourquoi ne les arrêtez-vous pas ?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmph. Mieux vaut garder la situation sous contrôle dans l’obscurité plutôt que de les forcer à changer de visage et à disparaître de leur vue.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", il faut comprendre ceci : tant que tu as encore un corps de fille, tu ne pourras jamais retourner à ton ancienne vie.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Pourtant, le fait que nous, à SID, vous ayons trouvé en premier est peut-être un coup de chance.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Devenir une fille du jour au lendemain...\nComment suis-je censé expliquer cela à mes camarades de classe et à mes amis... ?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... tu ne t'inquiètes pas pour tes parents ?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ma mère est décédée quand j'étais petit.\nMon père... a déjà disparu depuis de nombreuses années...", GameConfig.player_name)
	await novel_interface.show_dialog("J'ai vécu dans un internat jusqu'à l'âge de douze ans.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Donc, le programme de garde d'enfants des gorilles d'après-guerre a vraiment aidé certains enfants après tout.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, vous avez eu votre part de difficultés.\nPourtant, vous n'avez pas à vous soucier de la question de la transition d'identité.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Transition d'identité... ?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un sourire plutôt inquiétant apparaît sur le visage de Mariru...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
