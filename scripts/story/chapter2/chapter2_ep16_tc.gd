# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("愛衣正捧著報告書核對螢幕上跳動的資料，房間內不時傳出她竊笑的聲音。")
	await novel_interface.show_text_only("莉琉從愛衣身後抽走了檔案，打量著上面的內容。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("體檢的結果如何？把你高興成這樣。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("啊——真是太美妙了！ ！", "愛衣")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("身體是女生，靈魂卻是男生……『播磨腦研』的傢伙要是知道了，拼命也會提交實驗申請把她搶走吧", "愛衣")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("所以才得嚴格保密，明白嗎。 \\n話說，妳找到什麼線索了？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("她們端粒檢測的年齡確實都是15歲，但安妮軟組織中銫-137的含量只有現代人平均值的四分之一。", "愛衣")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("虧妳能想到這種方法……\\n所以她最多隻經歷了一半的「七年戰爭」？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("除非戰爭後幾年她一直待在密封艙裡。", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我知道了。 \\n另一個呢？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("至於小憐……她肌肉組織裡檢測出的含量不到均值的兩百分之一，比新生兒從母繼承的還要低。", "愛衣")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……所以，是新生成的身體嗎？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("這才是最有趣的地方——她的體內有包括天花在內的很多已經滅絕的病毒抗體。", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("——？！", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("放心～脊髓沒有病毒殘留。", "愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("我粗略地檢查了一下，小憐的免疫系統演化應該只在近幾百年內，而沒有中世紀以前的病毒抗體。", "愛衣")
	await novel_interface.show_dialog("不過我想申請用她的白血球，培養008、217和742號病毒試試……", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……我派妳去做校醫，可不是為了滿足妳這種奇怪的嗜好。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("好啦好啦，我明白～\\n妳要我好好地觀察她們對吧？", "愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("她們和「洛斯金盃」的消失可能有關聯……\\n我懷疑她們還是沒透露某些細節。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("關起來審問一下不就好了嘛。", "愛衣")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("需要幫忙嗎？ 今天體檢用的裝置稍微改造一下，就是很好的審問道具哦～", "愛衣")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("愛衣露出過度興奮的神色，莉琉馬上捲起報告，敲了她一下。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("妳做好監視就行，有任何情況就馬上向我回報。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（那傢伙已經注意到了，恐怕SID內部早就……）", "莉琉")
	await novel_interface.show_dialog("（放在學校裡的話，至少可以降低好奇心，）\\n（還能順便牽制一下她的小動作……）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("不用你說，小憐的身體變化，我會全~部記錄下來的！", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("……妳也稍微收斂一點。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("嘿嘿嘿，放心吧。 \\n畢竟一下子搾乾淨就不好玩了嘛。", "愛衣")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
