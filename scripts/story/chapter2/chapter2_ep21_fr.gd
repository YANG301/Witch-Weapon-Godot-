# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Nous avons éliminé le boss après un combat acharné, et les autres ennemis ont disparu dans un nuage de brume rouge.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Whoa... \\nAttendez, qu'est-ce que c'est ?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Quelques pages jaunies tombent devant moi. Sur les pages se trouvent un mélange de textes et de motifs, à peine lisibles.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Quoi ? \\nOh... J'ai le vertige...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me frotte les yeux et essaie de relire les mots. La seule chose dont je suis sûr, c’est qu’ils sont rédigés en anglais.")
	await novel_interface.show_text_only("Même si certaines lettres sont lisibles,")
	await novel_interface.show_text_only("Tout ce que je peux ressentir, c'est un chaos complet chaque fois que j'essaie de les assembler.")
	await novel_interface.show_text_only("Cela ressemble à un trouble de la lecture. Je n’arrive même pas à identifier le mot le plus simple.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Rangez-les pour l'instant. Nous avons une vie à sauver.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("C'est vrai. J'ai compris!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Au moment où je les ai rangés, je crois avoir vu un talisman clignotant sur le papier, mais il a disparu très rapidement.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("C'est...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Hein ?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Est-ce mon illusion ? \\n(Je ressens un frémissement indescriptible. Qu'est-ce que c'est...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Le léger picotement sur mon bras me rappelle que ce n'est pas une illusion.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Hé, ça va ?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je regarde la fille blessée. Elle a toujours l'air froide. \\nJe ne suis ni heureux ni reconnaissant de ce que Annie et moi avons fait pour elle.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À en juger par son apparence et sa tenue, ce n'est pas qu'une fille d'à côté...")
	await novel_interface.show_text_only("Le cache-œil est assez bizarre. Mais regardez ses mains sous la robe… Elles sont enveloppées dans une armure mécanique.")
	await novel_interface.show_text_only("Elle a une grave blessure au ventre.... Même un adulte s'effondrera.")
	await novel_interface.show_text_only("Mais elle est restée assise là, si silencieusement, sans un mot.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Hé, quel est ton nom ? \\nQue fais-tu ici ?", "Lian")
	await novel_interface.show_dialog("Connaissez-vous ces gars-là ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Très bien... c'est peut-être trop de questions pour elle...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La petite fille se lève brusquement, toujours en sang. En fait, elle est plus grande que je ne le pensais…")
	await novel_interface.show_text_only("Oh mon dieu ! \\nSon corps... flotte au-dessus du sol ?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nMission : Éliminer, sorcières.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille répond aux questions d'une manière très étrange.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... C'est son nom ? \\nElle parle sur un ton très étrange.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Cible, identifiant... \\nHumain. Femelle. Montant...", "Elluka")
	await novel_interface.show_dialog("Un.", "Elluka")
	await novel_interface.show_dialog("... \\nRé-identification, activé.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(« Une » femme ?) \\n(Est-ce qu'elle m'a identifié comme un homme tout à l'heure ?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Ouais, c'est vrai ! Je suis un garçon !", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sorcière, montant, un. \\nMode Défense, activé.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Bahahaha... \nEnfin ! Dernièrement, j’ai le sentiment qu’un étranger va découvrir ma véritable identité.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Euh... pourquoi ses mains brillent-elles, de plus en plus brillantes ? \\nWhoa... Attendez, attendez une minute !")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Aaaah ! \\nAïe ! Aie! Aie!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("Pourquoi tu t'en prends à moi ?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("C'était proche. Grâce à ma réponse rapide, cet éclair n’a touché que légèrement mon bras et a laissé une brûlure blanchâtre au sol.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Faibles compétences de combat. Évasion rapide. \\n... Aucune menace.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eh bien... il semblerait que je viens d'être identifié comme un poulet…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Pourquoi m'as-tu attaqué seul ? \\nJe vous ai aidé.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Pas de poids pour une sorcière.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est honnête !", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Petit Elluka, regarde, nous avons été si gentils. \\nNous ne sommes donc certainement pas de mauvaises personnes.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Chuchotement) Annie, ce n’est pas du tout convaincant. Et on dirait que nous sommes des ravisseurs.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Eh bien…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... Alors, Elluka, êtes-vous aussi une sorcière ?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie m'ignore et demande directement à Elluka.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("Hé, attends ! Peut-être que Elluka ne sait même pas ce qu'est une sorcière.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Bourreau.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Bourreau... Eh bien... Pourquoi les enfants d'aujourd'hui aiment-ils autant les surnoms aussi stupides ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Merde, je viens de dire ça à voix haute...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un autre éclair frappe et je l’esquive à nouveau juste à temps.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hé, gamin ! \\nPouvons-nous juste parler ?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ici... chocolat. Arrête d'être en colère, d'accord ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je sors une barre de chocolat de ma poche, la brise en deux et la partage avec Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Ouf... Heureusement que j'ai du chocolat avec moi. \\nAprès tout, aucun enfant ne déteste le chocolat.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Miam...miam... \\nVous voyez, je l'ai mangé.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Du chocolat ?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ce n'est pas dangereux... \\nC'est une collation qui fait du bonheur !", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(chuchotant) Lian, celui qui offre à manger aux petites filles ressemble peut-être davantage à un kidnappeur.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Et tu te comportes comme une fille maintenant, en emportant des chocolats avec toi. Bien joué!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka hésite un instant avant d'ouvrir l'emballage et d'en mettre lentement un morceau dans sa bouche.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nBizarre, saveur...", "Elluka")
	await novel_interface.show_dialog("Amer.", "Elluka")
	await novel_interface.show_dialog("Doux...", "Elluka")
	await novel_interface.show_dialog("Elluka, ne déteste pas ça.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Haha, tu aimes ça ?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ooh... elle a l'air si mignonne... !")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Mwahaha...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Oups ! Lian a l'air si dangereux.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Expression faciale, identification... Hentai.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hentai... ?! \\nTu veux dire, moi ?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Mais Elluka, ne déteste pas ça.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha... alors ça va.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("Vous avez l'air heureux d'être étiqueté comme Hentai. \\nTu es vraiment bizarre...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Non, je ne le suis pas. Pourriez-vous arrêter de me mal interpréter ?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Ah ! \\nJ'ai un autre morceau. Vous pouvez l'avoir.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Ici !", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pêche partout, sort un récipient transparent de la taille d'une pile AA et me le donne. Il contient un fluide vert, épais et fluorescent.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Est-ce du fluide électrique... ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Échange, nourriture.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est ce que tu appelles de la nourriture ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka hoche sérieusement la tête.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Quand j'ai faim, l'administrateur me donne à manger. \\nPour reconstituer, de l'énergie.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("L'administrateur, votre tuteur ?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Puisque vous pouvez manger du chocolat, votre corps devrait fonctionner comme un enfant normal, n’est-ce pas ?", "Lian")
	await novel_interface.show_dialog("Vous n'êtes pas un appareil électroménager...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Nul doute que cette fille peut ressentir l’existence d’inscriptions magiques.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais la façon dont elle est propulsée… est très spéciale.", "Annie")
	await novel_interface.show_dialog("Elle est... une bourreau ?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
