# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Me miro en el espejo en la esquina del pasillo. \\nMis pestañas llenas de lágrimas se mueven hacia arriba y hacia abajo mientras respiro.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("De hecho… ¿soy una niña ahora?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Allá abajo... Se ha ido...)", "Lian")
	await novel_interface.show_dialog("(En este caso...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(¿Cómo... cómo haría para orinar...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Pescando alrededor...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¿Qué estás haciendo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡¡Waaaa!!", "Lian")
	await novel_interface.show_dialog("No es... Uhm... \\n¡¡Lo siento!! No era mi intención...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Jaja. ¿Perdón por qué? \\n¿Por tocarte?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(¿Qué... qué puedo hacer?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Mmm...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("¿Cómo hacen las chicas... cómo hacen…?", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué? ¿Qué quieres de mí? Por favor sea específico.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("¿Cómo usan el baño?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Eh?!", "Mariru")
	await novel_interface.show_dialog("Jajaja…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(¡Por fin lo digo en voz alta! No vuelvas a burlarte de mí...)", "Lian")
	await novel_interface.show_dialog("(Pero parece que no puedo aguantar más...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Oye… ¡no te rías de mí!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Simplemente siéntate y haz el trabajo. Así de simple.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("El baño de niñas está al final del pasillo. ¡Mover!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pfff. Dudó por un momento... \\nY finalmente entró corriendo llorando.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("¡Qué... lindo!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (descarga de agua)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ahh. Finalmente relájate.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Espera... Cómo...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("¿Cómo me lo quito?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("¿Listo? ¿Cómo te sientes al respecto?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("¡¡Es un asunto privado!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Con razón escuché que el baño de niñas a menudo se queda sin papel higiénico...)", "Lian")
	await novel_interface.show_dialog("Waaaah... \\nQué vergonzoso...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¡¡Maldita sea!! \\n¡Debo volver a mi antiguo yo! ¡No puedo esperar!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
