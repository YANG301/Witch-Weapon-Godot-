# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("De acordo com as estatísticas de treinamento, a aptidão física de Lian não é diferente da média das adolescentes.", "Ai")
	await novel_interface.show_dialog("Exceto pela coordenação olho-mão. Pode ter algo a ver com os troféus de platina em suas contas de jogo…", "Ai")
	await novel_interface.show_dialog("Annie tem melhor desempenho quando treina sozinho. Quase tão boa quanto atletas profissionais da sua idade.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Mas o que detectei na segunda vez que desapareceram numa área de fluxo é totalmente diferente.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hein? Alguma coisa interessante?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("As pessoas podem não ser capazes de sentir isso, mas…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("A Sonda Boltzmann no drone de rastreamento disparou algumas vezes. Já estava quebrado quando resgatado.", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Impossível. Se a sonda estivesse funcionando bem… então aqueles na área de fluxo… \\nEu diria que quase toda a área teria sido vaporizada.", "Mariru")
	await novel_interface.show_dialog("Eu diria que quase toda a área teria sido vaporizada.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("E você estava louco para anexar um dispositivo tão caro ao drone?", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru enrola o documento e bate na cabeça de Ai\\nAi solta um gemido rápido.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Bem… não estou falando de energia térmica. Aumentos abruptos da entropia da informação também podem levar aos mesmos resultados.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("As duas meninas fizeram com que esse evento extremamente improvável acontecesse com 100% de certeza.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Annie é uma bruxa, mas então Lian… Ela é um contêiner criado por Substance H?", "Mariru")
	await novel_interface.show_dialog("É como se Lian tivesse habilitado as bruxas e seu poder mágico…", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ou, como uma bateria supercarregada colocada em um vibrador…", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Um baque vem da Sala de Comando. Um caroço aparece na cabeça de Ai.")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Sinto muito pelos contribuintes. Imagine quanto dinheiro de impostos é desperdiçado com esquisitos como você.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("A ciência tem tudo a ver com curiosidade e luxúria insaciáveis, não é?", "Ai")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("… Você realmente não tem vergonha de dizer isso.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Mencionei as metas de pesquisa bizarras que você definiu para meu SRD?", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("E seu rosto me diz que você está planejando algo sexy. \\nDiga-me, o que está em sua mente?", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ai notou um sorriso no rosto de Mariru antes de desaparecer.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Como já estão treinados há algum tempo, é hora de ver o que aprenderam.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Substance H, o Ross Goblet, Bruxas, Fluxo de Espaço-Tempo… Todos conectados com Lian…)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Sem ela, Annie não conseguiria passar por uma área de fluxo.) \\n(Então, durante os sete anos em que Annie desapareceu…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Você parece estar… planejando colocar os dois adolescentes inocentes em perigo?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Do que não se pode falar, deve-se calar.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Humph. Ludwig Wittgenstein. Eu gosto mais de outra citação dele.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Não é como as coisas são no mundo que é místico…", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Mas isso existe.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Certamente permanecerei fiel aos meus princípios.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Não há dúvida sobre isso.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Annie e de repente recebo um pedido de Mariru. Devemos retornar ao nosso apartamento imediatamente e ficar de plantão.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Uma missão urgente?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Eu, uh... \\n(Olhando fixamente—)", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("Mãe… Mariru?", "Lian")
	await novel_interface.show_dialog("(Acho que vejo um lampejo de hesitação nos olhos de Mariru…)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Então, o tempo voa quando não nos encontramos? \\nVocê está crescendo rapidamente—", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim… Embora ainda haja coisas com as quais não estou acostumada.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sério? Por exemplo?", "Mariru")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Como a aparência do Traje de Batalha… \\nQue humilhação!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Obviamente é muito legal!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("A parte de cima não cabe mais? \\nDeseja uma nova medição?", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não, isso não!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("Mariru entra em contato comigo. Percebo sua intenção e rapidamente me esquivo dela.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Uh—Não, não! \\nCabe perfeitamente!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Ah.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("(Do que você está sentindo pena!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Eep! Lian ainda está em desenvolvimento…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie parece invejoso e triste.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Annie—! \\nComo você pode ser como ela...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Espero poder crescer como você! \\n—Infelizmente, meu tempo está parado.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O tempo dela está parado… Será porque ela é uma bruxa?")
	await novel_interface.show_text_only("Annie tenta parecer otimista, mas não consegue esconder a tristeza em seus olhos. O ar de repente fica pesado")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("… Annie", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Então, deixe-me senti-los—\\nAha!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie inesperadamente me abraça pelas costas.")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Ei—!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("… Você cresceu, garota.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru vira a cabeça, enxugando as lágrimas secretamente.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Você! Que bobagem!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Ahem – de volta aos negócios! \\nTenho uma missão urgente para você agora.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Você já ouviu falar da Subestação Johnson?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("A enorme subestação na costa leste?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("(É uma área co-administrada pelas seis Cidades Acadêmicas dentro do campo de proteção de Aegis. As negociações de paz do pós-guerra foram realizadas lá.)")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Exatamente. Acabamos de receber alarmes de uma dúzia de estações retransmissoras mostrando fortes ondas que ocorreram no Nordeste.", "Mariru")
	await novel_interface.show_dialog("E nosso satélite detectou um Fluxo Espaço-Tempo na Subestação.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Fluxo de espaço-tempo? Poderia ser…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Se os dados estiverem corretos, a situação seria a mesma que você passou antes.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Você ainda não está qualificado como agente de campo…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Mas a Subestação está dentro da “Zona Desmilitarizada Acordada”, o que significa que SID não tem autoridade para conduzir operações lá, mesmo estando em New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Pode ser visto como um compromisso menor para a “paz mundial”.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Então, preciso que você vá em frente para explorar a Subestação. SID equipes ficarão de prontidão no perímetro.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Conseguirei a aprovação do Congresso Unido o mais rápido possível.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("Você quer dizer que vamos invadir a jurisdição da Academy City Alliance? \\nEstá tudo bem?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh! Parece que alguém prefere ver um blecaute na área da embaixada do que pegar um atalho.", "Mariru")
	await novel_interface.show_dialog("Se surgirem problemas, aqueles idiotas que se odeiam podem simplesmente entrar em conflito. \\nSe a situação se deteriorar para uma guerra…", "Mariru")
	await novel_interface.show_dialog("Se a situação se deteriorar para uma guerra…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Tudo bem, tudo bem. O que quer que você diga…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E vocês são apenas adolescentes. Mesmo se você for pego por soldados de segurança, você pode escapar bancando o fofo.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Sim, quando os porcos voam!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De qualquer forma, isso é uma ordem. \\nO helicóptero está esperando no telhado. Prepare-se e pronto!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"sprite")
	await novel_interface.show_dialog("Que ditador…", "Lian")

	print("=== 第二章第19话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
