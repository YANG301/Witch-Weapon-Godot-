# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Đợi đã, tờ giấy bạn vừa thu thập ở đâu?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ờ… Tờ giấy. Tôi muốn nói với bạn về điều đó.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tôi giao những trang tôi tìm thấy trên chiến trường cho Annie. Elluka cắn lưỡi.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Bản thảo Wardenclyffe… Tuyệt vời! Tôi không thể tin rằng bạn đã tìm thấy những thứ này!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Họ đã rơi khỏi những kẻ đó trước đó. Chỉ là cảm thấy không ổn thôi… Annie, bạn có thể đọc chúng ra không?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ừm… Những đường nét mờ đi, nhưng tôi có thể cảm nhận được phép thuật đang chảy qua chúng.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Chính xác hơn là những mảnh Grimoire… Những mảnh Grimoire.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimoire… Có phải chuyện gì đó liên quan đến phù thủy không?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Thực ra đó là một cuốn sách về phép thuật. Kịch bản đầu tiên thuộc loại này mà tôi từng thấy là một cuốn sách nhỏ không biết từ đâu xuất hiện.", "Annie")
	await novel_interface.show_dialog("Nếu tôi nhớ không lầm thì cuốn sách nhỏ đó có tựa đề Quỹ đạo huyền bí. Nó chợt xuất hiện trong tủ đựng đồ của tôi.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Lúc đầu tôi nghĩ là huấn luyện viên đã đưa nó cho tôi. Phép thuật phù thủy bên trong cực kỳ kỳ lạ, giống như dạy bạn cách thay đổi quỹ đạo.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Nhưng sau đó tôi phát hiện ra rằng huấn luyện viên không hề biết gì về việc đó. Tôi nghĩ đó là một dạng mê tín nên chưa bao giờ sử dụng.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Không cho đến khi…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Có vẻ như Annie đã xong việc nhớ lại quá khứ. Cô cúi đầu đọc kỹ những dòng chữ đó.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Tôi nhớ Mariru đã nói rằng Phù thủy là con người nhận được một số thuộc tính Substance H do bị ô nhiễm thông tin.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Ô nhiễm… chắc chắn rồi. Tôi muốn nói rằng nó rất quan trọng. Một số \"thông tin\" khó có thể bị xóa một khi bạn đã chạm tay vào nó.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bạn có thích những bản remix sâu tai và autotune đó không? Tôi đã cố gắng hàng triệu lần để loại bỏ chúng nhưng luôn thất bại. Đôi khi tôi không thể không ngân nga những giai điệu khi lơ đãng…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hà. Nói hay lắm, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Có lẽ những tờ giấy này đã gây ra Dòng thời gian? \\nNhưng… làm sao điều đó có thể xảy ra được?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Rất có thể. Những thông tin như vậy có thể khiến bạn tốn rất nhiều năng lượng, thậm chí là quá nhiều đối với tôi.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Đó là lý do tại sao chúng ta cần một số \"Vật phẩm\" nhất định để giải phóng phép thuật phù thủy, để chúng có thể gánh chịu chi phí cho chúng ta.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie chỉ vào cây gậy bóng chày của cô ấy. Có lẽ đó là lý do tại sao một số vũ khí lại tiêu tốn sức mạnh ma thuật…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Nếu tình trạng quá tải thông tin xảy ra, mọi người có thể mất đi sự tỉnh táo và phát điên hoàn toàn…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Điên… phù thủy… \\nCần… bị tiêu diệt.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Vậy phù thủy… là những kẻ bất hạnh phải không? \\nAnnie, bạn biết nhiều đấy.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Không… \\nTôi chỉ đưa ra giả định dựa trên kinh nghiệm của bản thân.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bản thảo…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka có vẻ đang chìm đắm trong suy nghĩ, khuôn mặt cô bừng sáng với vẻ háo hức.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hả? Cái gì? Bạn muốn xem chúng không, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vâng.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka nhìn tôi đầy khao khát, giống như một con thú cưng nhỏ đang cầu xin, đôi mắt đẫm lệ.")
	await novel_interface.show_text_only("Tôi không thể từ chối cô ấy, nhưng những kịch bản này quá nguy hiểm…")
	await novel_interface.show_text_only("Trong khi tôi đang do dự, tiếng đập của một chiếc máy bay vận tải đang hạ cánh đến gần.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Có người đang đến!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID sĩ quan? Tuyệt vời, chúng tôi đã tìm thấy một… \\nCái gì?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Điều đáng ngạc nhiên là người bước ra khỏi máy bay không phải là đặc vụ SID.")
	await novel_interface.show_text_only("Người đàn ông đeo kính nhìn Elluka dịu dàng, nhưng cô ấy rùng mình vì sợ hãi.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, bạn đã để tôi chờ đợi quá lâu.", "Quản trị viên")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Quản trị viên... tôi xin lỗi.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Bạn đã có bản thảo chưa? \\nBạn không thể tự mình xử lý chúng—tôi đã nói với bạn rồi. Mang chúng đến cho tôi ngay bây giờ.", "Quản trị viên")
	await novel_interface.show_dialog("Chỉ có thứ rác rưởi vô dụng mới làm tôi thất bại trong một nhiệm vụ nhỏ nhặt như vậy, phải không?", "Quản trị viên")
	await novel_interface.show_dialog("Hãy dọn dẹp mớ hỗn độn này rồi cùng tôi tới Oligar. Có một công việc khác đang chờ bạn.", "Quản trị viên")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Whoa, whoa, whoa, coi chừng ngôn ngữ của bạn! Cậu không thấy cô ấy đang bị thương sao?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Cô ấy chỉ là một cô bé, không phải một công cụ nào đó mà bạn sở hữu!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người lạ dường như không hề chú ý đến tôi cho đến bây giờ. Anh ta nhìn tôi với một nụ cười kỳ lạ, giống như kẻ săn mồi đang kiểm tra con mồi.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, hãy đưa cô ấy đi cùng chúng tôi.", "Quản trị viên")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hả?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Trên xác chết của tôi. Không ai có thể lấy Lian chừng nào tôi còn ở đây.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Đưa cô ấy đi…?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Vâng, đó là mệnh lệnh.", "Quản trị viên")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Đặt hàng…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka nhìn tôi chằm chằm, khá ngơ ngác. Cô ấy dường như đang đấu tranh nội tâm, nhưng không vâng lời Quản trị viên không phải là một lựa chọn.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Nhiệm vụ: mang Lian đi. \\nMục tiêu đã bị khóa…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
