# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Desde esta manhã, detectamos repentinamente vários alertas de flutuação de fase do espaço-tempo em New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("É como se algo acordasse durante a noite...", "Mariru")
	await novel_interface.show_dialog("Satélites de vigilância mostram que você desapareceu no ar dentro da zona de anomalia e reapareceu do outro lado pouco depois – com outra pessoa ao seu lado.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru volta seu olhar para Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("E exatamente onde vocês dois apareceram, essa flutuação desapareceu por conta própria.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("A zona de anomalia? Você quer dizer o Centro de Pesquisa?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exatamente.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Poderia ter sido algum tipo de mau funcionamento do equipamento...? Eu estava na estrada principal o tempo todo.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("A expressão de Mariru fica séria.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você acha que qualquer pessoa pode entrar e sair de uma zona de flutuação de fase do espaço-tempo?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Essa coisa de flutuação... é realmente tão perigosa?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você realmente não sabe de nada, não é?...", "Mariru")
	await novel_interface.show_dialog("A fase do espaço-tempo é a base da lei física – como o sistema de coordenadas do universo. Não importa como as partículas se movam, os próprios eixos devem permanecer estáveis.", "Mariru")
	await novel_interface.show_dialog("Se esses eixos começarem a tremer, mesmo que por uma margem mínima, a ordem das partículas dentro desse espaço será devastada.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se apenas 5% das partículas de um edifício fossem deslocadas aleatoriamente em um micrômetro, a estrutura do material seria totalmente destruída e tudo entraria em colapso instantaneamente.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("E ainda assim você está perfeitamente bem, e os edifícios naquela área não apresentam nenhum dano estrutural.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(E de acordo com nossa pesquisa sobre Toques Divinos, um humano carregando “FANTASMA” não deveria nem mesmo ser capaz de entrar em um espaço como esse.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Em outras palavras, você basicamente entrou no olho de um furacão de categoria 12 que poderia destruir tudo, saiu ileso e de alguma forma acalmou a tempestade.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Então essas anomalias foram causadas pelas coisas que me atacaram?\nEles pareciam ter perdido a cabeça...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pare aí mesmo! Estou prestes a informar o Senado—", "Mariru")
	await novel_interface.show_dialog("Um desses lunáticos gosta de fazer análises de detecção de mentiras ao vivo no feed da conferência, então quanto menos eu souber agora, melhor.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Essa é... uma maneira muito distinta de descrever os senadores...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E uma garota também deveria saber quando pode mentir~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Eu não sou uma garota!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("De qualquer forma, tudo bem, não direi nada...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nos últimos anos, houve apenas quatro casos registrados desse tipo de flutuação do espaço-tempo em todo o mundo.\nA maioria deles estava ligada a falhas de contenção envolvendo Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Quando um Toque Divino desconhecido é ativado repentinamente, as consequências podem ser catastróficas.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...As pessoas vão se machucar?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Na pior das hipóteses, só o número de mortos atingiu dezenas de milhares.", "Mariru")
	await novel_interface.show_dialog("Mas as principais cidades acadêmicas sempre tiveram um acordo tácito para relatar esses incidentes como \"acidentes comuns\"...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Vazamentos de gás, acidentes de avião, ataques terroristas, esse tipo de coisa...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Então desta vez...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Desta vez é diferente. Nunca vimos surtos contínuos nesta escala antes...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Já está além do nível mais alto dos nossos cenários de propaganda. Quando chegar a hora, não conseguiremos nem inventar uma mentira para isso.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Isso pode ser por minha causa?\nSe houver algo que eu possa fazer para ajudar...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não pense demais. Suas mudanças físicas podem muito bem estar relacionadas, mas você sozinho não poderia ter causado uma perturbação tão grande.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Se você quiser procurar pistas, pode dar uma olhada na cena com meu pessoal.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Se essa possibilidade for real, então agora ela é a única resposta que temos...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Mas você não deve se esforçar de forma alguma e não deve contar a ninguém sobre você. Entendido?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Não contar a ninguém... então isso significa...\nEu tenho que fingir que sempre fui uma garota?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você já sabe disso, não é...?\nNew Opulentia sempre governou sob a doutrina da ciência acima de tudo.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Se você tornar sua experiência pública, você será classificado como um “cobaia experimental” e levado para uma instituição de pesquisa.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Então você provavelmente teria toda uma linhagem de homens de meia-idade que juraram suas vidas à ciência esperando para estudar seu corpo...", "Mariru")
	await novel_interface.show_dialog("Afinal, não é todo dia que eles conseguem uma garota tão fofa—", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...O-ok, entendi!!", GameConfig.player_name)
	await novel_interface.show_dialog("Eu... Eu absolutamente não direi nada imprudente!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
