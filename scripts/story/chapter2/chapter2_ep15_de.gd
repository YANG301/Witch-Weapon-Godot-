# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Seufz... Dieser Rock ist immer noch viel zu kurz...\nEs fühlt sich ganz kühl darunter an...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Zu viele unglaubliche Dinge sind in den letzten Tagen passiert.\nMein Gehirn kann kaum noch mithalten...", "Lian")
	await novel_interface.show_dialog("Der Traum, dass die Stadt zerstört wird, ich eines Morgens aufwache und feststelle, dass ich mich in ein Mädchen verwandelt habe, und dass ich von einem völlig unerklärlichen Feind angegriffen werde...", "Lian")
	await novel_interface.show_dialog("Nichts davon fühlt sich überhaupt real an.\nUnd obendrein...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, komm rein.", "Klassenlehrer")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ah, j-ja!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-Schön, Sie zum ersten Mal zu treffen!\nHallo zusammen, mein Name ist Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Ich freue mich sehr, mit Ihnen allen Klassenkameraden zu werden, also kümmern Sie sich bitte von nun an um mich...\n...", "Lian")
	await novel_interface.show_dialog("(...Auch wenn ich deine Klassenkameradin in Form einer Highschool-Schülerin werde, ob es mir gefällt oder nicht...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Bitte verschone mich einfach...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Also gut, Lian, nehmen Sie den freien Platz in der hinteren Reihe ein.", "Klassenlehrer")
	await novel_interface.show_dialog("(...Ein Transferstudent zu diesem Zeitpunkt im Semester? Das ist ungewöhnlich.)", "Klassenkamerad A")
	await novel_interface.show_dialog("(...Sie starrt ständig auf den Boden. Ich wette, sie ist wirklich ruhig, oder?)", "Klassenkamerad B")
	await novel_interface.show_dialog("(...Aber sie ist wirklich süß... Ist diese Haarfarbe gefärbt?)", "Klassenkamerad A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Alle schauen mich an...\nUgh... Der Weg vor uns wird hart sein...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Puh, der Unterricht ist endlich vorbei.... Der Schulalltag war noch nie so anstrengend.\nEine Schule mit guten Leistungen ist schließlich wirklich anders....", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Mist... Ich muss auf die Toilette...)", "Lian")
	await novel_interface.show_dialog("(N-Auf keinen Fall, ich kann auf keinen Fall in die Mädchentoilette der Schule gehen...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ugh, was soll ich tun...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Was ist los? Warum seufzst du so sehr?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hä? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Also? Geht es dir gut, dich in der neuen Schule einzuleben? Es gibt hier viele sehr süße Mädchen~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh...Lass uns jetzt nicht darüber reden.\nHaben Sie Ihr Grundwissenstraining schon abgeschlossen?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Hehe, ich bin sofort vorbeigekommen, nachdem ich die Bewertung bestanden hatte! Wenn ich dich hier allein lasse, wer weiß, was mit dir passieren könnte.", "Annie")
	await novel_interface.show_dialog("Zum Glück war ich nicht lange weg und New Opulentia ist jetzt eine Einwanderungsstadt, sodass es mir wahrscheinlich nicht allzu schwer fallen wird, mich anzupassen.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Fräulein Mariru hat mich auch gebeten, auf Sie aufzupassen~\nSie hat ausdrücklich dafür gesorgt, dass wir in derselben Klasse sind.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Ich bin eine erwachsene Mutter—\nJedenfalls brauche ich niemanden, der sich um mich kümmert~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Hehe, außerdem fühle ich mich viel wohler, wenn ich auch an deiner Seite bin...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Ich habe gehört, dass Sie sich freiwillig bereit erklärt haben, gemeinsam mit mir bei SID mitzumachen.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie sah dankbar aus. Mir fehlten kurz die Worte und ich hatte keine Ahnung, ob ich die Prüfungen tatsächlich reibungslos bestehen würde...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh, richtig – die Schulkrankenschwester hat mich gebeten, eine Nachricht zu übermitteln. Sie möchte, dass Sie zu einer körperlichen Untersuchung zu ihr kommen.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("A-A körperliche Untersuchung!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wir sind Transferschüler, daher muss die Schule uns getrennte Untersuchungen durchführen lassen~\nOder sind Sie verärgert, dass Sie es verpasst haben, es gemeinsam mit der ganzen Klasse zu machen...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Natürlich nicht!!\nIch verstehe, aber vorher...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Ruheraum... Raum...)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Ich kann dich nicht hören... Sag es lauter~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Ähm, könntest du mich zur Toilette bringen...?", "Lian")
	await novel_interface.show_dialog("Wenn ich alleine hineingehe..., würde ich mich viel zu schuldig fühlen. Ich traue mich nicht, alleine hineinzugehen...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nUnd nachdem du gesagt hast, dass du niemanden brauchst, der sich um dich kümmert~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Alles klar... Beeil dich...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...Über die körperliche Untersuchung...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...Die Tatsache, dass ich ein Junge war, wird doch nicht ans Licht kommen, oder?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Was überprüfen sie überhaupt noch einmal bei einer körperlichen Untersuchung?)", "Lian")
	await novel_interface.show_dialog("(Und warte... Muss ich mich ausziehen?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Gut, dass ich nicht faul geworden bin und heute tatsächlich meine Unterwäsche angezogen habe...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(Die Krankenstation... ist es hier?)", "Lian")
	await novel_interface.show_dialog("Entschuldigung, ich bin der Transferstudent hier für die körperliche Untersuchung...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Perfektes Timing. Ich habe auf dich gewartet.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("A-A-A-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, nein, warum machst du die Prüfung?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Huh???\nAi, s-stopp, hör auf damit——!!", "Lian")
	await novel_interface.show_dialog("Warte... Was ist das für ein seltsames, schlagendes Instrument, das du da in der Hand hältst??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Waaahhhh——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ugh... Warum passiert das?...", "Lian")
	await novel_interface.show_dialog("Sie hätten all dieses und jenes Zeug weglassen können, nicht wahr...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Du übertreibst viel zu sehr.\nEs ist nur eine Routineuntersuchung, Routine~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... Die Sehkraft auf beiden Augen beträgt 2,0. Das ist absolut perfekt.\nHat sich das gegenüber Ihren alten Daten geändert?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä? Mein linkes Auge hatte früher einen Wert von 1,0 und mein rechter einen Wert von 0,7.\nDer Arzt sagte mir sogar, ich solle weiter weg sitzen, wenn ich Spiele spielte...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Wie faszinierend... Ihr Körper sieht aus, als wäre er von Grund auf neu aufgebaut worden, bis hin zu den Knochen.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Und doch weist die neuronale Topologie Ihres Gehirns gleichzeitig Merkmale beider Geschlechter auf, weshalb Ihre Erinnerungen und Gedankenmuster erhalten blieben... Ist es das?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai klang fast aufgeregt genug, um zu zittern.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Wenn das der Fall ist... dann sollten Sie sich theoretisch auch darüber im Klaren sein, dass Sie sensibler für die Emotionen anderer Menschen werden.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-Auf keinen Fall...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Absolut nicht! Ich bin hundertprozentig männlich!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Wie auch immer, aus medizinischer Sicht bist du ohne Frage hundertprozentig weiblich.\nDeine Gesundheit ist vollkommen in Ordnung, bis auf eine Sache...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Außer was?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nach kurzer Zeit werden Sie einen Anfall von Bauchschmerzen verspüren. Ansonsten gibt es überhaupt keine Probleme~\nEs sollte bald verfügbar sein, also stellen Sie sicher, dass Sie vorbereitet sind.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Magenschmerzen...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... Waaat——???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Ai, du!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ich fühlte mich so ungerecht behandelt und machtlos, dass ich den Tränen nahe war...\nUgh, ich sollte ein Mann sein – weine nicht!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, das ist wirklich perfekt... Es kommt selten vor, dass man jemanden in deinem Alter sieht, der nirgendwo am Körper eine einzige Narbe hat.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("Das macht mich überhaupt nicht glücklich!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ähm – kann ich jetzt zurückgehen...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai zog ihren weißen Laborkittel aus, setzte einen Gesichtsausdruck auf, der sagte: „Jetzt werde ich ernst“ und holte zwei Outfits aus dem Kleiderschrank...")
	await novel_interface.show_dialog("Wovon redest du?\nDer lustige Teil fängt gerade erst an...", "Ai")
	await novel_interface.show_dialog("Mariru hat es bereits genehmigt, also darf ich Lian alle möglichen Kleidungsstücke anprobieren...", "Ai")
	await novel_interface.show_dialog("E-Äh-?", "Lian")
	await novel_interface.show_dialog("Und dann... hehehehe, ich werde auch jeden einzelnen von Lians Datenpunkten studieren.", "Ai")
	await novel_interface.show_dialog("Jaaahhhhhhhhhhhh~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
