# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Secondo le statistiche sull'allenamento, la forma fisica di Lian non è diversa da quella della media delle adolescenti.", "Ai")
	await novel_interface.show_dialog("Fatta eccezione per la coordinazione occhio-mano. Potrebbe avere qualcosa a che fare con i trofei di platino nei suoi account di gioco...", "Ai")
	await novel_interface.show_dialog("Annie ottiene risultati migliori quando si allena da solo. Quasi quanto gli atleti professionisti della sua età.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Ma quello che ho notato la seconda volta che sono scomparsi in un'area di flusso è totalmente diverso.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Eh? Qualcosa di interessante?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Le persone potrebbero non essere in grado di sentirlo, ma...", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("La sonda Boltzmann sul drone di localizzazione è uscita dalle classifiche un paio di volte. Era già rotto quando è stato recuperato.", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Impossibile. Se la sonda funzionasse bene... allora quelli nell'area del flusso... \\nDirei che quasi tutta l'area sarebbe stata vaporizzata.", "Mariru")
	await novel_interface.show_dialog("Direi che quasi tutta l'area sarebbe stata vaporizzata.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Ed eri fuori di testa ad attaccare un dispositivo così costoso al drone?", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru arrotola il documento e bussa alla testa di Ai\\nAi emette un breve gemito.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Beh... non sto parlando di energia termica. Anche improvvisi aumenti dell’entropia dell’informazione possono portare agli stessi risultati.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Le due ragazze hanno fatto sì che questo evento estremamente improbabile accadesse con certezza al 100%.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Annie è una strega, ma allora Lian… È un contenitore creato da Substance H?", "Mariru")
	await novel_interface.show_dialog("È come se Lian avesse abilitato le streghe e il loro potere magico...", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oppure, come una batteria sovralimentata inserita in un vibratore...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Un tonfo proviene dalla Sala Comando. Sulla testa di Ai appare un nodulo.")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Mi dispiace tanto per i contribuenti. Immagina quanti soldi delle tasse vengono sprecati per gente strana come te.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("La scienza è tutta una questione di curiosità e lussuria insaziabili, non è vero?", "Ai")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("… Non hai davvero vergogna a dirlo.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ho menzionato i bizzarri obiettivi di ricerca che hai fissato per il mio SRD?", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("E la tua faccia mi dice che stai progettando qualcosa di astuto. \\nDimmi, cosa hai in mente?", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ai notò un sorriso sul volto di Mariru prima che svanisse.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Dato che sono stati addestrati per un po', è tempo di vedere cosa hanno imparato.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Substance H, i Ross Goblet, Streghe, Flusso Spaziotemporale... Tutti collegati a Lian...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Senza di lei, Annie non potrebbe attraversare un'area di flusso.) \\n(Quindi, durante i sette anni in cui Annie scomparve...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Sembra che tu stia... progettando di mettere in pericolo i due adolescenti innocenti?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Di ciò di cui non si può parlare, bisogna tacere.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Humph. Ludwig Wittgenstein. Mi piace di più un'altra sua citazione.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Non è il modo in cui stanno le cose nel mondo ad essere mistico...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ma che esiste.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sicuramente rimarrò fedele ai miei principi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Nessun dubbio su questo.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Io e Annie riceviamo improvvisamente un ordine da Mariru. Dobbiamo tornare immediatamente al nostro appartamento e restare di guardia.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Una missione urgente?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Io uh... \\n(Fissando—)", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("Ma... Mariru?", "Lian")
	await novel_interface.show_dialog("(Credo di vedere un lampo di esitazione negli occhi di Mariru...)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Quindi il tempo vola quando non ci incontriamo? \\nStai crescendo velocemente—", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì... anche se ci sono ancora cose a cui non sono abituato.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Davvero? Per esempio?", "Mariru")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Come l'aspetto della Battle Suit... \\nChe umiliazione!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("È ovviamente molto bello!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("La parte superiore non va più bene? \\nVuoi una nuova misurazione?", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, non quello!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("Mariru mi contatta. Mi rendo conto delle sue intenzioni e la schivo rapidamente.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Uh... No, no! \\nSi adatta perfettamente!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Aww.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("(Per cosa provi pietà!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Ehi! Lian è ancora in fase di sviluppo...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sembra invidioso e triste.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Annie—! \\nCome potresti essere come lei...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Spero di poter crescere come te! \\n—Purtroppo il mio tempo è fermo.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il suo tempo è fermo... È perché è una strega?")
	await novel_interface.show_text_only("Annie cerca di sembrare ottimista, ma non riesce a nascondere il dolore nei suoi occhi. L'aria diventa improvvisamente pesante")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("… Annie", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Quindi, fammeli sentire...\\nAha!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie inaspettatamente mi abbraccia da dietro.")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Ehi...!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("… Sei cresciuta, ragazza.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru volta la testa dall'altra parte, asciugandosi di nascosto le lacrime.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Tu! Che sciocchezza!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Ehm, torniamo al lavoro! \\nHo una missione urgente per te in questo momento.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Hai sentito parlare della sottostazione Johnson?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La gigantesca sottostazione sulla costa orientale?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("(È un'area co-amministrata dalle sei Città Accademia all'interno del campo protettivo di Aegis. Qui si sono svolti i colloqui di pace del dopoguerra.)")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Esattamente. Abbiamo appena ricevuto allarmi da una dozzina di stazioni di ritrasmissione che mostrano forti ondate avvenute nel nord-est.", "Mariru")
	await novel_interface.show_dialog("E il nostro satellite ha rilevato un flusso spaziotemporale nella sottostazione.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Flusso spaziotemporale? Potrebbe essere...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Se i dati sono corretti, la situazione sarebbe la stessa di quelle che hai vissuto in precedenza.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Non sei ancora qualificato come agente sul campo…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ma la sottostazione si trova all'interno della \"Zona demilitarizzata concordata\", il che significa che SID non ha l'autorità per condurre operazioni lì anche se si trova in New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Può essere visto come un piccolo compromesso per la “pace nel mondo”.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Quindi ho bisogno che tu vada avanti per esplorare la sottostazione. Le squadre SID rimarranno sul perimetro.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Otterrò l'approvazione del Congresso Unito al più presto.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("Vuoi dire che sconfinaremo nella giurisdizione dell'Alleanza della Città Accademia? \\nVa davvero bene?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-eh! Sembra che qualcuno preferisca vedere un blackout nell'area dell'ambasciata piuttosto che prendere una scorciatoia.", "Mariru")
	await novel_interface.show_dialog("Se arrivano i guai, quegli idioti che si odiano a vicenda potrebbero semplicemente scontrarsi. \\nSe la situazione degenera in una guerra...", "Mariru")
	await novel_interface.show_dialog("Se la situazione degenera in una guerra...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Va bene, va bene. Qualunque cosa tu dica...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E voi siete solo adolescenti. Anche se vieni catturato dai soldati della sicurezza, potresti farla franca facendo il carino.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Sì, quando i maiali volano!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Comunque questo è un ordine. \\nL'elicottero sta aspettando sul tetto. Preparati e vai!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"sprite")
	await novel_interface.show_dialog("Che dittatore...", "Lian")

	print("=== 第二章第19话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
