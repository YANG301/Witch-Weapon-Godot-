# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie has already been settled in the next room. There are some things I need to tell you alone.", "Mariru")
	await novel_interface.show_dialog("I just received confirmation.", "Mariru")
	await novel_interface.show_dialog("Since this morning, large-scale spacetime anomalies have appeared in multiple major cities...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("The affected regions we know of so far include Hovering Palace, Newmoridas, Masada Fort, Salmonton, New Opulentia, and the Lebona Islands.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Then doesn't that mean...\nall six Academy Cities...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("That's right. The whole world is watching this now, and the scale of the impact has far exceeded expectations.", "Mariru")
	await novel_interface.show_dialog("I think... there may be one possibility...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Everything you described experiencing in your dream—the terrorists attacking the research center, the city reduced to ruins...", "Mariru")
	await novel_interface.show_dialog("...all of that may have really happened.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("H-How is that possible?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("I don't have conclusive proof, but a massive dimensional distortion may already have occurred this morning.", "Mariru")
	await novel_interface.show_dialog("SID's True Sight satellite also detected an abnormally violent burst of noise.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Maybe this will make it easier to understand: New Opulentia really was destroyed once, but some kind of force reversed that reality...", "Mariru")
	await novel_interface.show_dialog("And that force also seems to be connected to the changes in your body, as well as the attacks by those strange enemies.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Of course, that's still only my hypothesis.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("That idea... isn't it a little too bold...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Because of today's events, the other five Academy Cities are all pressuring the Senate to allow entry for investigation.", "Mariru")
	await novel_interface.show_dialog("And if your connection to this incident is exposed, being taken away by a research institution will be the least of your problems...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Agents from every intelligence organization would mark you as a key target.", "Mariru")
	await novel_interface.show_dialog("Not even counting the ones already undercover, over a hundred intelligence operatives from various countries entered New Opulentia today under false identities alone.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("You know all that in such detail?\nWhy don't you stop them?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmph. Better to keep the situation under control in the dark than force them to change faces and disappear from sight.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", you need to understand this: as long as you still have a girl's body, you can never return to your old life.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Still, the fact that we at SID found you first may be one stroke of luck.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Becoming a girl overnight...\nHow am I even supposed to explain that to my classmates and friends...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... aren't you worried about your parents?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("My mother died when I was little.\nMy father... has already been missing for many years...", GameConfig.player_name)
	await novel_interface.show_dialog("I lived in boarding school until I was twelve.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...So the gorilla's postwar childcare program really did help some kids after all.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, you've had your share of hardship.\nStill, you don't need to worry about the identity transition issue.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Identity... transition?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("A rather ominous smile appears on Mariru's face...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
