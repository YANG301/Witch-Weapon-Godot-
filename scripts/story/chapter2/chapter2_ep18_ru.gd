# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Жаркий летний полдень. Я кладу стопку бумаг рядом с круглым столом во дворе и опускаюсь в кресло в тени под деревьями.")
	await novel_interface.show_text_only("Некоторое время назад я видел, как эта симпатичная девушка боролась со своей стопкой книг. Я не стал долго думать и подал ей руку.")
	await novel_interface.show_text_only("Потом она просто поспешила уйти, хотя и к счастью. Именно тогда я понял, что я идиот.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Уф... Дай мне передохнуть здесь... Здесь так жарко.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Увы, в детстве для меня это было пустяком.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("А потом предстоит SID тренировка... Боже, можно мне где-нибудь спрятаться?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, следите за своими манерами... \\nЭто школа.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Привет, Annie! \\nЧто случилось?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Слушай... Я знаю, здесь жарко. \\nНо... действительно ли необходимо задирать рубашку, чтобы вытереть пот?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Я имею в виду... Остерегайтесь неисправности гардероба...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Черт!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Эта Lian девушка такая грубая...", "Студент А")
	await novel_interface.show_dialog("Да, на днях я видел, как она раздвинула ноги в юбке.", "Студент Б")
	await novel_interface.show_dialog("Правда? Фу…", "Студент А")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(Мне вообще не следовало носить юбки, ясно?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эй…")
	await novel_interface.show_text_only("Какой нежный голос.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Если не возражаете, используйте мой носовой платок.", "Элегантная девушка")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Передо мной красивая и элегантная девушка. \\nУ нее длинные шелковистые фиолетовые волосы и сиреневые глаза.")
	await novel_interface.show_text_only("Она протягивает мне носовой платок с изысканным и свежим ароматом.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Э?! \\nСпасибо… Спасибо.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Вы же переводные студенты первого курса, верно? \\nМеня зовут Nix Строцци. Я твой старший.", "Nix")
	await novel_interface.show_dialog("Я видел, как ты потел, и у меня с собой оказался носовой платок, так что... \\nНадеюсь, я не перебиваю.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix вежливо кивает мне, но я схожу с ума. Я встаю и довольно глупо отдаю честь.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Нет... совсем нет! \\nЭто отличная помощь!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Она кажется очень дружелюбной.) \\n(Она иностранка? Посмотрите на эти длинные ресницы...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на нежное лицо Nix и мое сердце колотится.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("С удовольствием. \\nИтак... тебя зовут...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Я Lian. Она Annie. \\nМы недавно переехали сюда.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix кажется растерянным и смотрит на Annie, хотя и ненадолго.")
	await novel_interface.show_text_only("Затем она дружелюбно улыбается Annie . Интересно, была ли это сейчас всего лишь моей иллюзией?")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Рад встретиться с вами сегодня.", "Nix")
	await novel_interface.show_dialog("Но мне нужно идти сейчас. Дайте мне знать, если я могу чем-то помочь.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Спасибо, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie колеблется, но не отвечает.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эта девушка, Nix... она выглядит намного класснее любой из этих девчонок с серебряной ложкой.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, с тобой все в порядке? \\nВы молчали.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Она сказала, что она Строцци?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Угу, ты ее знаешь?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie берет меня за руку и невинно улыбается.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Нет. \\nМы здесь новенькие. Откуда я мог ее знать?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Да, ты прав.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
