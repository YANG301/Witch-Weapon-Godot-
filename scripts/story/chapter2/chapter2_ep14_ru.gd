# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Но я хочу снова превратиться в мальчика...\nЧто мне делать...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Ну... почему бы просто не остаться такой девушкой?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что—??\nНет! Абсолютно нет!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Как вы сказали, возможно, судьба этого города была испорчена разрушением, и из-за этого вернулись десятки миллионов жизней...", "Mariru")
	await novel_interface.show_dialog("Чудо такого масштаба обязательно имеет какую-то цену, вы не думаете?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("А что, если эта цена... заключалась в том, что ты просто закончил вот так?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Как такое могло быть...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("А еще...\nТебе уже пятнадцать, да?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Девушка твоего возраста\n должна носить хотя бы бюстгальтер..., верно?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("А?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Знаешь, ты все еще растешь. С этого момента они могут продолжать расти....", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Чтоааа?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если вы его не наденете, это вызовет проблемы.\nНапример, когда вы бежите...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Т-ты имеешь в виду бюстгальтер...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Точно. Я думаю, тебе бы подошёл милый девичий стиль, не так ли?\nУ тебя такое милое лицо~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Абсолютно нет!!\nЯ-я мальчик!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("И, кстати, то, как ты сейчас сидишь...\nЭто на удивление смело с твоей стороны~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Я-я-я-я...\nЯ иду в ванную!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("О боже!\nЭтого парня действительно слишком легко дразнить~", "Mariru")
	await novel_interface.show_dialog("Похоже, теперь мне не придется скучать~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Я посмотрел на себя в зеркало. Вспоминая тот разговор, я медленно сполз по стене и присел там.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Я до сих пор просто не могу в это поверить...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Что-то в этом роде... Я категорически не хочу это носить!!", "Lian")
	await novel_interface.show_dialog("Как мужчина...\nТакое ощущение, что что-то важное ускользает от меня все дальше и дальше!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("А если бы кто-то увидел меня в месте, где продают подобные вещи...\nНет-нет! Абсолютно нет!", "Lian")
	await novel_interface.show_dialog("(Если бы я действительно сделал это...)\n(Тогда я действительно был бы... извращенцем!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Я не хочу быть извращенцем!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("О? Ты все еще сидишь здесь на корточках и плачешь?\nЯ уже подобрал размер по твоему бюсту.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("А?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Я оставил их в твоей комнате. Считайте их подарком от меня~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, спасибо!\nВместо этого я просто воспользуюсь бинтами!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Этот ребенок... ты невиновен или просто извращенец?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Хотя использование лейкопластырей может быть... еще более интересным.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Или вам нравится этот небольшой приступ боли, когда вы их срываете?", "Mariru")
	await novel_interface.show_dialog("Очень плохо. Все, что у нас есть, это бинты в виде спрея~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Ты делаешь это нарочно, не так ли!!\nУх... черт возьми!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Тц, хорошо, я надену это~!\nЕсли я настоящий мужчина, то чего тут смущаться!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Хм? Подождите?\nЭто... действительно сложно...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Мм-хм.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*клик*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Вот, я закрепил это для тебя~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nЧ-как ты сюда попал?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Я просто любезно помог тебе~\nКстати, ты можешь самостоятельно справиться с носками униформы?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А?! Это же просто носки, что тут сложного!\nЯ сделаю это сам!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("А юбка?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("С юбкой я тоже справлюсь... Я надену ее на себя...\nMariru, уйди уже!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Ух ты~ Значит, ты действительно знаешь, как надеть юбку. Это впечатляет.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Юбку не нужно тянуться за спину, чтобы что-нибудь застегнуть, так что в этом сложного?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Пфф, тогда ладно~\nЯ вернусь через некоторое время и посмотрю, как ты выглядишь, когда оденешься.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Черт побери, ... Mariru серьезно меня недооценивает!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Некоторое время спустя...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! Я одет!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Вы уверены?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Чего тут сомневаться! Я отлично его надел, не так ли?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Итак,... где именно у тебя молния?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Впереди! Облегчает посещение туалета!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Мм... а чем именно ты сейчас ходишь в туалет?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Э-э...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Э-это не имеет ни к чему никакого отношения! В любом случае...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Пфф... Молния идет сбоку.\nИди посмотри в зеркало~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("Сторона, затем сторона...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Почему девчачью одежду так трудно надеть!!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
