# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie ได้รับการตัดสินในห้องถัดไปแล้ว มีบางอย่างที่ฉันต้องบอกคุณคนเดียว", "Mariru")
	await novel_interface.show_dialog("ฉันเพิ่งได้รับการยืนยัน", "Mariru")
	await novel_interface.show_dialog("ตั้งแต่เช้านี้ ความผิดปกติของกาลอวกาศขนาดใหญ่ได้ปรากฏขึ้นในเมืองใหญ่หลายแห่ง...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("ภูมิภาคที่ได้รับผลกระทบที่เราทราบจนถึงตอนนี้ ได้แก่ พระราชวังโฮเวอร์ริ่ง นิวโมริดาส ป้อมมาซาดา แซลมอนตัน New Opulentia และหมู่เกาะเลโบนา", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("นั่นไม่ได้หมายความว่า...\nทั้งหกเมืองของ Academy...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("ถูกต้องแล้ว ขณะนี้ทั้งโลกกำลังจับตาดูสิ่งนี้ และขนาดของผลกระทบนั้นเกินความคาดหมายมาก", "Mariru")
	await novel_interface.show_dialog("ฉันคิดว่า... อาจมีความเป็นไปได้อย่างหนึ่ง...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("ทุกสิ่งที่คุณบรรยายถึงประสบการณ์ในความฝัน ผู้ก่อการร้ายโจมตีศูนย์วิจัย เมืองก็พังทลายลง...", "Mariru")
	await novel_interface.show_dialog("...ทั้งหมดนั้นอาจจะเกิดขึ้นจริงๆ", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("มะ-เป็นไปได้ยังไงเนี่ย!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("ฉันไม่มีข้อพิสูจน์ที่แน่ชัด แต่การบิดเบือนมิติครั้งใหญ่อาจเกิดขึ้นแล้วเมื่อเช้านี้", "Mariru")
	await novel_interface.show_dialog("ดาวเทียม ทรูไซต์ ของ SID ยังตรวจพบเสียงรบกวนที่มีความรุนแรงผิดปกติอีกด้วย", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("บางทีนี่อาจจะทำให้เข้าใจได้ง่ายขึ้น: New Opulentia ถูกทำลายไปแล้วครั้งหนึ่งจริงๆ แต่พลังบางอย่างกลับทำให้ความเป็นจริงนั้นกลับคืนมา...", "Mariru")
	await novel_interface.show_dialog("และพลังนั้นดูเหมือนว่าจะเชื่อมโยงกับการเปลี่ยนแปลงในร่างกายของคุณ เช่นเดียวกับการโจมตีของศัตรูแปลก ๆ เหล่านั้น", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("แน่นอนว่านั่นยังเป็นเพียงสมมติฐานของฉันเท่านั้น", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("ความคิดนั้น... มันไม่หนาเกินไปสักหน่อย... เหรอ?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("เนื่องจากเหตุการณ์ในวันนี้ เมือง Academy อีกห้าแห่งจึงกดดันให้ วุฒิสภา อนุญาตให้เข้าไปสอบสวนได้", "Mariru")
	await novel_interface.show_dialog("และหากความเกี่ยวข้องของคุณกับเหตุการณ์นี้ถูกเปิดเผย การถูกสถาบันวิจัยพรากไปจะเป็นปัญหาของคุณน้อยที่สุด...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("เจ้าหน้าที่จากทุกองค์กรข่าวกรองจะทำเครื่องหมายคุณว่าเป็นเป้าหมายหลัก", "Mariru")
	await novel_interface.show_dialog("ไม่นับแม้แต่คนที่ปกปิดอยู่แล้ว หน่วยข่าวกรองกว่าร้อยรายจากประเทศต่างๆ เข้ามา New Opulentia ในวันนี้ด้วยการระบุตัวตนอันเป็นเท็จเพียงอย่างเดียว", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("คุณรู้ทุกอย่างในรายละเอียดขนาดนั้น\nทำไมคุณไม่หยุดพวกเขาล่ะ?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ฮึ่ม ดีกว่าที่จะควบคุมสถานการณ์ในความมืด ดีกว่าบังคับพวกเขาให้เปลี่ยนหน้าแล้วหายไปจากสายตา", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+"คุณต้องเข้าใจสิ่งนี้: ตราบใดที่คุณยังมีร่างกายของผู้หญิงอยู่คุณจะไม่มีวันกลับไปสู่ชีวิตเก่าได้", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("อย่างไรก็ตาม การที่เรา SID พบคุณก่อนอาจเป็นโชคดีอย่างหนึ่ง", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("กลายเป็นเด็กผู้หญิงในชั่วข้ามคืน...\nฉันจะอธิบายเรื่องนี้ให้เพื่อนร่วมชั้นและเพื่อน ๆ ของฉันฟังได้อย่างไร...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("อืม... คุณไม่กังวลเกี่ยวกับพ่อแม่ของคุณเหรอ?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("แม่ของฉันเสียชีวิตตั้งแต่ฉันยังเด็ก\nพ่อของฉัน... หายไปหลายปีแล้ว...", GameConfig.player_name)
	await novel_interface.show_dialog("ฉันอาศัยอยู่ในโรงเรียนประจำจนกระทั่งฉันอายุสิบสอง", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...โครงการดูแลเด็กหลังสงครามของกอริลลาช่วยเด็กบางคนได้จริงๆ)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("อืม คุณได้รับส่วนแบ่งของความยากลำบาก\nถึงกระนั้น คุณไม่จำเป็นต้องกังวลเกี่ยวกับปัญหาการเปลี่ยนข้อมูลประจำตัว", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("การเปลี่ยนแปลงตัวตน...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("รอยยิ้มที่ค่อนข้างเป็นลางไม่ดีปรากฏบนใบหน้าของ Mariru...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
