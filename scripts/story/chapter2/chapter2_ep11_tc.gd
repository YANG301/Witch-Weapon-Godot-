# chapter2_ep11.gd - 第二章第11話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("喲~這不是小憐嘛，剛剛成為名正言順的美少女有什麼感想嗎？", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("……請不要再拿我開玩笑啦！", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯哼~對了，剛才看到你在假期結束後準備去另一所公立學校上高中？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("是的，新學校離我住的地方比較近，還有就是……學分要求也沒那麼嚴……", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("出於安全考慮，我會給你安排一個新的住所。\n至於學校嘛……", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（看來要去拜託那個老傢伙了）", "莉琉")
	await novel_interface.show_dialog("（想想就覺得麻煩……還好資訊已經被修正的非常完美了……）", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("御櫻川女子中學，這所學校有最高的安保等級，而且離SID總部也不遠。", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉邊說邊向上指了指。")
	await novel_interface.show_text_only("御櫻川，在地下總部上方的繁華商區，據說是一座學費貴得嚇死人的高階學校。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("那、那不是大小姐高校嗎！傳說中“聖潔的百合與燦爛的櫻花盛開的天國”……", "小憐")
	await novel_interface.show_text_only("這是某個經常宕機的破論壇外野，為諷刺御櫻川高昂學費撰寫的廣告語。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("你說什麼？", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒沒沒沒！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("不過你這個蠢樣，搞不好會成為學姐學妹們的……", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉輕輕一笑，並沒有說出下文。")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("會成為什麼啊！？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("現在可不是好奇心發作的時間。\n總之明天，你就去乖乖報到。", "莉琉")
	await novel_interface.show_dialog("那裡可沒公立學校那麼散漫。", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("就不能讓我悠閒一點嗎_(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("……啊對了，安妮怎麼辦？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("那丫頭啊，可是很有趣的身世呢。", "莉琉")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("她……怎麼了？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("系統中關於安妮·巴斯的記錄，只能追溯到七年以前，也就是她15歲的時候。", "莉琉")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("七年前是……她已經22歲了？！\n明明看起來跟我差不多大啊。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("是的，她現在的骨齡測定依然是15歲。", "莉琉")
	await novel_interface.show_dialog("但是這期間她究竟去了哪，為什麼突然出現，目前為止沒有人弄得清楚，包括她自己。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……無論如何，我認為安妮不會是壞人。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("這倒可以放心。\n畢竟就連SID裡，還有她曾經的粉絲呢。", "莉琉")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("呃？！安妮是什麼偶像嗎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("……應該屬於“多年前的明星”這類範疇吧。", "莉琉")
	await novel_interface.show_dialog("不過比起她以前的身份，我更中意現在她的特別之處。", "莉琉")
	await novel_interface.show_dialog("本來『魔女』的資料就少到讓人頭疼……真是意外的收穫。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("魔女……那又是什麼？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("嗯……簡單說，可以認為是因為感染了某種資訊，而獲得了一些類似『異質物』特性的人類。", "莉琉")
	await novel_interface.show_dialog("就像人們對目前的科學無法解釋的『異質物』的奇異特性稱呼為『神蹟』。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("在普通人看來，如果有人可以表達這種特性，簡直可以稱為『魔法』吧。", "莉琉")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("魔法……應該只是我們還不理解的科學吧……", "小憐")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("你想這樣理解也沒問題。", "莉琉")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("本來歷史上有很多關於『魔女』的記載，但一直被當做迷信和傳說。", "莉琉")
	await novel_interface.show_dialog("歷史上歐洲人曾在三百多年的時間裡，以『魔女』的名義處決了近十萬名女性。", "莉琉")
	await novel_interface.show_dialog("『魔女狩獵』運動，歷史課上有學……", "小憐")
	await novel_interface.show_dialog("雖然當時我只是當做無聊的考點，但仔細想來，的確是一場規模龐大到不正常的浩劫……", "莉琉")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("『異質物』被發現以來，各國都在重新審視那些傳說的真實性。", "莉琉")
	await novel_interface.show_dialog("最近有傳言說某些組織重新制造了魔女，並用於特務活動。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("不過好在安妮能爽快的答應加入。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("加入什麼？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("成為SID探員。", "莉琉")
	await novel_interface.show_dialog("從明天起，她就要開始替我辦事了。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("那怎麼行！SID探員的工作想想就知道太危險了！", "小憐")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("而且她和我一樣才15歲，不能做什麼探員吧……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哼哼，我們目前最小的探員只有13歲。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("13歲？！非法的吧！！\n那一定是非法的吧！！？", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("以後有機會見到她你就不會這麼想了。\n那孩子可遠比你這個笨蛋要聰明得多。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("……哼", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("作為新豐洲市民，我當然知道現在各個學園都市雖然表面上停火，但都在暗中較量。")
	await novel_interface.show_text_only("而且埃癸斯的護盾對生化武器和滲透式的恐怖襲擊是無效的。")
	await novel_interface.show_text_only("為了維護這座城市，可以想象莉琉與SID在暗中經歷了多少殊死的激烈戰鬥。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("哦對了，安妮表面的身份，是和你一起入學的轉學生。", "莉琉")
	await novel_interface.show_dialog("我給你們安排在同一個套間，制服和其他日常物\n品，一小時內都會送達。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("不要討價還價。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("我明白……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我當然明白，這樣沒有什麼不好。\n不，是比以前的生活會舒適太多了。")
	await novel_interface.show_text_only("只要讓SID解決一切問題就好。\n只要繼續渾渾噩噩地在貴族學校混學分就好。")
	await novel_interface.show_text_only("然後只要試著習慣這個新身體就好……嗎？")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("……不。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("嗯？", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("就算什麼也不明白，可我不想讓安妮一個人面對這種危險。")
	await novel_interface.show_text_only("在相遇的那一刻，出現在我面前的安妮。\n雖然看似鎮定，卻透露出一絲惶恐。")
	await novel_interface.show_text_only("她其實……也很害怕吧？")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("……莉琉姐，如果你不反對我這麼稱呼你…\n我也想幫忙！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("哈啊？！", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……我想…既然我有能力穿越那個颶風，應該也能在SID幫上點其他什麼忙！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("那不是颶風，是時空相位波動……", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("總之，我不能讓安妮獨自面對危險。", "小憐")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("說不定，還能有機會找到變回男孩子的辦法……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…但是以你的體質，應該連SID的清潔人員都打不過。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("額……\n（你請了怎樣的清潔工啊！掃地僧嗎？！）", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……這樣吧，讓你嘗試一下SID的學員訓練，以後就算遇到什麼危險，好歹能提升存活率。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("身份的話，就作為四級探員（候選）吧。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("好的！我會努力的！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（也好，看看能從這小傢伙身上獲取什麼資料。）", "莉琉")

	print("=== 第二章第11話結束 ===")

	# 呼叫劇情結束函式
	await novel_interface.end_story_episode(0.5)
