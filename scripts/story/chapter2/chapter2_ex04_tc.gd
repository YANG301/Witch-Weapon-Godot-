# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("獲得莉琉的許可後，我和安妮決定帶伊露卡上街逛逛。")
	await novel_interface.show_text_only("伊露卡站在我的身後，謹慎地觀察著周圍。")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("伊露卡，要吃巧克力嗎？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("伊露卡，巧克力，喜歡。", "伊露卡")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("來，這塊給妳。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡接過巧克力，小心翼翼地撕開包裝，輕輕地咬了一口。")
	await novel_interface.show_text_only("嗯啊～～不管看過多少次，都覺得真是超可愛的！")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("某人臉上又出現了糟糕的中年大叔才會有的表情哦！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("哎？ ！糟糕的……中年大叔？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("變態——", "伊露卡")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不要一起攻擊我啊！ 真是的！", "小憐")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("伊露卡，再這樣的話就不給你吃巧克力了哦~", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("嗚……", "伊露卡")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("糟糕，這種要哭要哭的表情也好可愛啊～～")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("嘿嘿嘿，騙妳的啦。 \\n喏，再給妳一塊。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("……妳究竟藏了多少巧克力啊？ ！\\n攝入過量的糖分會變胖哦！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("有什麼關係，只是幾塊巧克力而已。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮用異樣的眼神緊緊地盯著我，讓我感到了一股無形的壓力。")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("怎、怎麼了？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("我偷看過小憐最近的體檢報告，\\n除了體重不斷增加以外，身高完全沒變。", "安妮")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("為什麼妳要去看那種東西啊！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("嘿嘿嘿，當然是為了更瞭解妳呀。", "安妮")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("就像我現在就已經知道，妳的身高和我一樣，只有161公分呢！", "安妮")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這很值得驕傲嗎！ ！", "小憐")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("現在是161沒錯，但我還是個男生的時候，身高可有165呢！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("哎？ 明明是男生，卻只比現在高那麼一點？ 哈哈～", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("中、中計了……\\n不該把這個數字說出來的。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("從剛才起就一直默默地吃著巧克力的伊露卡，聽到這段對話後，忽然疑惑地抬起了頭。")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("小憐姐姐？", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("嗯？ 怎麼啦？", "小憐")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("小憐……哥哥？", "伊露卡")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("……", "小憐")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("姐姐？ 哥哥？ \\n資料混亂，無法判定。", "伊露卡")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("伊露卡！ 快點把剛才的對話忘掉！", "小憐")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("重新掃描，目標，人類女性……\\n姐姐？ 哥哥？", "伊露卡")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("啊啊啊快停下來啊！", "小憐")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
