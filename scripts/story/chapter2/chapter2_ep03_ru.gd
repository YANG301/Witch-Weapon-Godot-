# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("В сопровождении агентов мы с Annie прыгнули в черный как смоль седан.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("Пассажирский салон задыхается.")
	await novel_interface.show_text_only("Я в недоумении обхватываю колени руками.")
	await novel_interface.show_text_only("Annie мягко опирается на меня, что заставляет меня чувствовать себя несколько расслабленным.")
	await novel_interface.show_dialog("Итак... что такое SID? \\nВы нервничаете каждый раз, когда слышите это.", "Annie")
	await novel_interface.show_dialog("Вы из космоса? \\nSID — это разведывательный отдел в составе Сенат.", GameConfig.player_name)
	await novel_interface.show_dialog("Некоторые говорят, что SID играет более важную роль, чем Aegis в поддержании нейтралитета New Opulentia.", GameConfig.player_name)
	await novel_interface.show_dialog("Но есть еще городские легенды о людях, которых забрал SID и которые никогда не вернулись... Это просто ужасно.", GameConfig.player_name)
	await novel_interface.show_dialog("Хорошо... Но что такое Академгород?", "Annie")
	await novel_interface.show_dialog("(Подождите... Неужели у этой девушки вообще нет здравого смысла? )", GameConfig.player_name)
	await novel_interface.show_text_only("Annie видит мой удивленный взгляд... и просто расслабленно улыбается мне.")
	await novel_interface.show_dialog("Расслабься, у нас не будет никаких проблем!", "Annie")
	await novel_interface.show_dialog("Потому что... ты особенный.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("Странно, что бессвязная речь Annie каким-то образом успокоила мой взволнованный разум.")
	await novel_interface.show_text_only("Кажется, не так уж и ужасно быть забранным SID...")
	await novel_interface.show_text_only("(Нет. Нет. Это ужасно!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("Мы прибываем в оживленный деловой район города и заезжаем в обычный подвальный гараж, где поднимаемся на автомобильный лифт.")
	await novel_interface.show_text_only("После доклада агента лифт начинает двигаться.")
	await novel_interface.show_text_only("Я чувствую, как быстро движется лифт. Он несколько раз снижается на длинные отрезки времени и даже время от времени смещается в сторону.")
	await novel_interface.show_dialog("(Трудно представить себе такой подземный лабиринт под деловой зоной...)", GameConfig.player_name)
	await novel_interface.show_text_only("Слухов о штаб-квартире SID ходит много. Некоторые говорят, что он расположен на южном пригороде New Opulentia, и вся конструкция покрыта оптическим камуфляжем.")
	await novel_interface.show_text_only("Конечно, о здании, которого официально не существует в системе, СМИ могут придумать что угодно, лишь бы оно привлекало клики.")
	await novel_interface.show_text_only("И то, куда я вступаю, — это как раз основная область этого «несуществующего» отдела.")
	await novel_interface.show_dialog("(Я просто надеюсь, что меня здесь не сделают «несуществующим»...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Мы выходим из машины перед коридором, обставленным металлическими пластинами. Это дает ощущение технологии и воздержания.")
	await novel_interface.show_text_only("Дверь лифта автоматически закрывается сразу после того, как мы выходим. Мы слышим, как он уходит, пока продолжаем идти по темному коридору. Воздух становится спертым и унылым.")
	await novel_interface.show_text_only("У меня тоже сердце замирает...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("Мы идем прямо по коридору и попадаем в светлую, но закрытую комнату.")
	await novel_interface.show_text_only("Это похоже на комнату для допросов, но здесь нет ни столов, ни стульев. Одна стена представляет собой огромное стекло.")
	await novel_interface.show_text_only("Прежде чем я смогу повернуться и проверить эту стену…")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Уууу!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Кто-то с силой обнимает меня за талию.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Ой… Больно!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Собираясь потерять равновесие, я чувствую, как моя голова падает на что-то знакомое, мягкое, но твердое.")
	await novel_interface.show_dialog("Ну... Судя по твоей основной силе, шпионские штучки не для тебя.", "Женский голос")
	await novel_interface.show_dialog("Я думал, что у нас есть какие-то ошибки при сканировании тела, поэтому хотел убедиться лично.", "Женский голос")
	await novel_interface.show_dialog("Хотя чувствует себя хорошо.", "Женский голос")
	await novel_interface.show_text_only("Женский голос позади меня звучит знакомо.")
	await novel_interface.show_text_only("Она отпускает руки. С затяжным страхом я оборачиваюсь. \\nЖенщина передо мной—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(А?! Э-это огромно!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Мисс... Мисс Mariru!?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Ты знаешь ее?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("О? Так быстро выяснилось, что вы можете идентифицировать агентов другой разведывательной службы. \\nПохоже, вы никогда не планировали скрывать, кто вы...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(Боже! Глупый я…)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("В это трудно поверить, но эта женщина в военной форме передо мной — та самая женщина, которую я встретил во сне.")
	await novel_interface.show_text_only("Стройная фигура… рыжие волосы… садистский взгляд…")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Теперь вы должны честно ответить на мои вопросы.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Не оправдывайтесь и не хитрите.", "Mariru")
	await novel_interface.show_dialog("Допросы - одна из моих специальностей. \\nЯ не буду снисходителен к твоему милому личику~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("Это властное, дразнящее отношение и эти уверенные глаза с оттенком насмешки...")
	await novel_interface.show_text_only("Как ее полное имя еще раз? \\nВерно, это...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Точно. Я руководитель SID. Меня зовут Mariru Фон Браун.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("Это она!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Подождите, ... глава SID? \\nРазве она не была главным учёным?!")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("Но если внимательно взглянуть на ее одежду и следы на плечах, то она, вероятно, большой начальник...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Однако ее чулки и высокие каблуки такие же, как и вчера.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эй, девочка, на что ты смотришь, а?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("О! Да... верно! \\nИзвините, мэм!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("У тебя есть наглость, и ты позволяешь своим мыслям блуждать прямо сейчас.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Я слышал, что ты рассказал много ужасных историй о SID этому синему двухвосту.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru вертит в руках кнут. Я нервничаю и тяжело сглатываю.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Угадайте... \\nСколько из них правда?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Ух! Мне очень жаль!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Б… синий двуххвостый…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Теперь, когда вы знаете, что такое страх, давайте начнем с вашей личности.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru открывает свой портативный терминал, и на стене комнаты для допросов тут же появляется проекция.")
	await novel_interface.show_text_only("Там показаны мои фотографии, сделанные с разных ракурсов камерами наблюдения, и результат анализа лица гласит:")
	await novel_interface.show_text_only("[Совпадений не найдено]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ни одну запись о прибытии... Aegis не удалось идентифицировать.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Если бы дело не в вашей плохой физической подготовке, вас сразу же сочли бы шпионом или террористом-злоумышленником.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("Я чувствую себя немного неловко и бессознательно потираю живот.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", эта дама кажется даже более страшной, чем враги, с которыми мы столкнулись ранее...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Да… и ей не составит труда разглядеть мою ложь...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(Признаюсь! Боже! Что угодно!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", с чего мне вообще начать...?", GameConfig.player_name)
	await novel_interface.show_dialog("Честно говоря, это немного сложно. Я тоже очень смущен.", GameConfig.player_name)
	await novel_interface.show_dialog("Вы, наверное, не поверите тому, что я говорю...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Перестаньте болтать. Я буду судить об этом сама!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("…Ну… Мне приснился этот сон.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Во сне я пошел в Исследовательский центр, чтобы посетить лекцию для моего отчета об обучении на открытом воздухе… И я прибыл прямо перед закрытием.", GameConfig.player_name)
	await novel_interface.show_dialog("Я встретил тебя там. И вы сказали, что его поймали…", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Судя по всему, Mariru воспринимает это как шутку или что-то в этом роде.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Ты имеешь в виду, ты встретил меня во сне?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да, это был ты. \\nИ ты затащил меня в угол...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ах да,... вы были ученым класса СС, признанным Сенат... \\nДоктором. Mariru Фон Браун, верно?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Это я.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Но эта информация не является секретной — ее знает любой, кто знаком с New Opulentia.", "Mariru")
	await novel_interface.show_dialog("... Забудь об этом. \\nИ что произошло дальше?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы сбили одного из злоумышленников и получили пистолет. Ты попросил меня остаться на месте и дождаться помощи, а сам отправился к месту угона.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Место угона? \\nГде именно?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы сказали, что это конференц-зал.", GameConfig.player_name)
	await novel_interface.show_dialog("Вы собирались прочитать там лекцию. Вы были лектором.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Лекция… Лектор.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(Она говорит об публичной лекции о Ross Goblet, организованной Вольфгангом?)", "Mariru")
	await novel_interface.show_dialog("(Но его следовало отменить. Откуда она могла об этом знать?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эм... Мисс Mariru?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Да… ничего. Продолжать.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("И мимо прошли какие-то вооруженные люди в масках. Я сбежал вниз и спрятался в тени сланца...", GameConfig.player_name)
	await novel_interface.show_dialog("Извините, но я не помню, что там произошло…", GameConfig.player_name)
	await novel_interface.show_dialog("Я как-то потерял сознание, а когда очнулся, увидел…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Что ты видел?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Я видел дым и пламя вокруг.", GameConfig.player_name)
	await novel_interface.show_dialog("Исследовательский центр и окружающие его здания лежали в руинах...", GameConfig.player_name)
	await novel_interface.show_dialog("Вокруг стоял резкий запах.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("У него был сильно соленый и горький вкус...", GameConfig.player_name)
	await novel_interface.show_dialog("Все люди превратились в каменные фигуры.", GameConfig.player_name)
	await novel_interface.show_dialog("Нет, не совсем камень — это была соль.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("И я увидел что-то светящееся в воздухе.", GameConfig.player_name)
	await novel_interface.show_dialog("Это было похоже на ад. \\nНо почему-то я чувствую какое-то особенное спокойствие.", GameConfig.player_name)
	await novel_interface.show_dialog("Что-то мне отвечает...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("А потом моя память стала смутной... Возможно, была полоса света…", GameConfig.player_name)
	await novel_interface.show_dialog("И… это, по сути, конец сна.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Проснувшись, я обнаружил себя на кровати в своей комнате, и было уже утро.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Было ли это... всего лишь сном...?", "Mariru")
	await novel_interface.show_dialog("Твоя обонятельная память была настолько яркой, как будто ты действительно был там…", "Mariru")
	await novel_interface.show_dialog("(Если бы этот резкий запах был серой...) \\n(Это было бы точно так же, как были уничтожены Содом и Гоморра в книге Бытия.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
