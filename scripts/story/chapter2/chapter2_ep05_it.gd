# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Da stamattina, abbiamo improvvisamente rilevato diversi avvisi di fluttuazione della fase spaziotemporale in New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("È come se qualcosa si fosse svegliato durante la notte...", "Mariru")
	await novel_interface.show_dialog("I satelliti di sorveglianza mostrano che sei scomparso nel nulla all'interno della zona anomala, per poi riapparire dall'altra parte non molto tempo dopo, con qualcun altro accanto a te.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru volge lo sguardo verso Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("E proprio dove siete apparsi voi due, quella fluttuazione è scomparsa da sola.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("La zona anomala? Intendi il Centro Ricerche?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esattamente.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Potrebbe essere stato qualche tipo di malfunzionamento dell'apparecchiatura...? Sono stato tutto il tempo sulla strada principale.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("L'espressione di Mariru diventa seria.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pensi che chiunque possa entrare e uscire da una zona di fluttuazione della fase spaziotemporale?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Quella cosa della fluttuazione... è davvero così pericolosa?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Davvero non sai niente, vero...", "Mariru")
	await novel_interface.show_dialog("La fase spaziotemporale è il fondamento della legge fisica, come il sistema di coordinate dell'universo. Non importa come si muovono le particelle, gli assi stessi devono rimanere stabili.", "Mariru")
	await novel_interface.show_dialog("Se questi assi iniziano a tremare, anche del più piccolo margine, l’ordine delle particelle all’interno di quello spazio viene devastato.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se solo il 5% delle particelle di un edificio venissero spostate casualmente di un micrometro, la struttura materiale verrebbe completamente distrutta e l’intera struttura collasserebbe all’istante.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Eppure stai ancora perfettamente bene e gli edifici in quella zona non mostrano alcun danno strutturale.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(E secondo la nostra ricerca sui Tocchi Divini, un essere umano che trasporta \"FANTASMA\" non dovrebbe nemmeno essere in grado di entrare in uno spazio del genere.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In altre parole, sei praticamente finito nell’occhio di un uragano di categoria 12 che potrebbe distruggere tutto, ne sei uscito illeso e in qualche modo ha calmato la tempesta.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Allora quelle anomalie erano causate dalle cose che mi hanno attaccato?\nSembravano come se avessero perso la testa...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Fermati proprio lì! Sto per informare il Senato—", "Mariru")
	await novel_interface.show_dialog("A uno di quei pazzi piace eseguire analisi in tempo reale per rilevare la menzogna sul feed della conferenza, quindi meno ne so in questo momento, meglio è.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Questo è... un modo molto particolare per descrivere i Senatori...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E anche una ragazza dovrebbe sapere quando va bene mentire~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Non sono una ragazza!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Comunque va bene, non dico niente...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Negli ultimi anni, sono stati registrati solo quattro casi di questo tipo di fluttuazione dello spaziotempo in tutto il mondo.\nLa maggior parte di essi erano legati a fallimenti di contenimento che coinvolgevano Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Quando un Tocco Divino sconosciuto viene attivato improvvisamente, le conseguenze possono essere catastrofiche.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Le persone si faranno male?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nel peggiore dei casi, il bilancio delle vittime da solo ha raggiunto le decine di migliaia.", "Mariru")
	await novel_interface.show_dialog("Ma le principali Città Accademia hanno sempre avuto un tacito accordo per denunciare quegli incidenti come “incidenti ordinari”...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Fughe di gas, incidenti aerei, attacchi terroristici, cose del genere...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Allora questa volta...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questa volta è diverso. Non abbiamo mai visto epidemie continue su questa scala prima...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("È già oltre il livello più alto dei nostri scenari di propaganda. Quando arriverà il momento, non saremo nemmeno in grado di inventare una bugia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Potrebbe essere colpa mia?\nSe c'è qualcosa che posso fare per aiutare...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non pensarci troppo. I tuoi cambiamenti fisici potrebbero anche essere collegati, ma tu da solo non avresti potuto causare un disturbo così enorme.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Se vuoi cercare degli indizi, puoi andare a dare un'occhiata alla scena con la mia gente.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Se questa possibilità è reale, allora lei è l'unica risposta che abbiamo...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ma non devi assolutamente spingerti oltre e non devi parlare di te a nessuno. Inteso?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Non dirlo a nessuno... quindi significa...\nDevo fingere di essere sempre stata una ragazza?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo sai già, vero...?\nNew Opulentia ha sempre governato soprattutto secondo la dottrina della scienza.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Se rendi pubblica la tua esperienza, verrai classificato come \"soggetto sperimentale\" e portato in un istituto di ricerca~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Allora probabilmente avresti un'intera fila di uomini di mezza età che hanno giurato la loro vita alla scienza in attesa di studiare il tuo corpo...", "Mariru")
	await novel_interface.show_dialog("Dopotutto, non capita tutti i giorni di trovare una ragazza così carina...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...Okay, ho capito!!", GameConfig.player_name)
	await novel_interface.show_dialog("Io... non dirò assolutamente nulla di avventato!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
