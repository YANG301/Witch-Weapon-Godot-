# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Tôi nhìn mình trong tấm gương ở góc hành lang. \\nLông mi đầy nước mắt của tôi di chuyển lên xuống khi tôi thở.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Quả thực… bây giờ tôi là con gái?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Dưới đó... Nó biến mất rồi...)", "Lian")
	await novel_interface.show_dialog("(Trong trường hợp này...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Làm thế nào... tôi sẽ bị rò rỉ như thế nào...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Câu cá khắp nơi...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Bạn đang làm gì vậy?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ôi!!", "Lian")
	await novel_interface.show_dialog("Không phải vậy... Uhm... \\nXin lỗi!! Tôi không cố ý...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Haha. Xin lỗi vì điều gì? \\nĐể chạm vào chính mình?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(... tôi có thể làm gì?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Ừm...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Làm thế nào mà các cô gái... làm thế nào để họ…", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cái gì? Bạn muốn gì ở tôi? Hãy nói cụ thể.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Họ sử dụng phòng tắm như thế nào?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hả?!", "Mariru")
	await novel_interface.show_dialog("Hahaha…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Cuối cùng tôi nói to lên! Đừng trêu tôi nữa...)", "Lian")
	await novel_interface.show_dialog("(Nhưng có vẻ như tôi không thể chịu đựng được nữa...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Này… đừng cười tôi!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chỉ cần ngồi xuống và làm công việc. Đơn giản như vậy.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Phòng tắm nữ ở ngay cuối hành lang. Di chuyển!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pfff. Anh do dự một lúc... \\nRồi cuối cùng anh lao vào trong nước mắt.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Thật dễ thương...!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (xả nước)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("À. Cuối cùng hãy thư giãn.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Đợi đã... Thế nào...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Làm thế nào để tôi rũ bỏ nó?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Xong chưa? Bạn cảm thấy thế nào về nó?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("Đó là chuyện riêng tư!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Không trách nghe nói phòng tắm nữ thường xuyên hết giấy vệ sinh...)", "Lian")
	await novel_interface.show_dialog("Waaah... \\nXấu hổ quá...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Chết tiệt!! \\nTôi phải quay lại với tôi ngày xưa! Không thể chờ đợi được!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
