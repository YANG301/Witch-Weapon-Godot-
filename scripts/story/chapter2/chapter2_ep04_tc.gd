# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("嗯……但一切都真實得不像夢，所以我也有點搞不清楚。", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("我搜尋了好久，但完全查不到火災或建築損毀的新聞，\\n城市也和平時沒什麼不同。", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("只是……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("嗯？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("只是……？", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("一覺醒來……", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("我的身體，變成女生了……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("……", "安妮")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("嗯……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("哦？ 妳是說……變性？", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……別看我現在這樣……", GameConfig.player_name)
	await novel_interface.show_dialog("我！ 我本來是男生啊！ ！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("哦哦哦？ 男生？", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("啊……哈哈哈哈哈！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("所以妳現在是男扮女裝囉？ （靠近）", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("不、不是那個意思！ \\n喂！ 不要離我這麼近啦！", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("咦……不過某種意義來說……\\n似乎也算是……", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("啊！ 真是討厭！", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("嗯……這胸部做得真不錯。 （摸）", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("這種彈性……到底用什麼樣的技術才能有這麼自然的手感……（捏）", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("咦？ 這方面的話，安妮也想知道～！ ！", "安妮")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("呀！ 啊……不是，那個……\\n妳們不要隨便摸我啊！ ！！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("我看看……肩膀很纖細，腰身到骨盆的曲線也很優美。", "莉琉")
	await novel_interface.show_dialog("究竟是用了什麼材料啊，真好奇，尤其是……", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("呀啊啊啊！ 很癢呀……！", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("莉琉小姐！ 那裡！ 不行啊！", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("不行，不可以啊啊啊～！ ！！ ！！", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("嗚嗚嗚嗚………", GameConfig.player_name)
	await novel_interface.show_dialog("總、總而言之！ 到昨天為止我都是男生！", GameConfig.player_name)
	await novel_interface.show_dialog("也沒有做過任何手術之類的……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("我相信妳說的。", "莉琉")
	await novel_interface.show_dialog("以現在的技術，無論如何也不可能做到如此徹底的改變性別……", "莉琉")
	await novel_interface.show_dialog("如果不把骨骼全部換掉，是無法做到這種程度的。 \\n所以，妳本來就是個女生。", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("所以！ 我說我之前是男生啊！ ！\\n我是一覺醒來才變成這樣的！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("那妳有什麼實際的證據嗎？ \\n證明妳曾經身為男性的證據？", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯……證據……\\n啊，學生證！", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("我們進來時的隨身物品都被沒收了，包括我出門時穿的男裝和裡面的ID卡。")
	await novel_interface.show_text_only("莉琉在手持平板上點了兩下，調出了我的學生證。")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("有了！ 哼，就是這個！ \\n妳們看！ 我是男的吧？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("雖然五官確實有一點像男生，但只憑這種東西……", "莉琉")
	await novel_interface.show_dialog("對了，調出城市監控系統最近1個月拍到"+GameConfig.player_name+"的所有影像……", "莉琉")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("莉琉熟練地在平板上點按了起來，臉上露出了一絲興奮的表情。")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("看到那些廢墟時，我還以為自己在做夢，以為醒了就好了……", GameConfig.player_name)
	await novel_interface.show_dialog("結果醒來卻發現自己變成了女孩子……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("加入骨骼變化的修正，和剛才在走廊掃描到妳的步態比對……", "莉琉")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("莉琉並未理會我的自言自語，繼續興致勃勃地操作著手上的裝置。")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("難道那不是夢？ 可是現在一切都好好的，完全不像發生過那種事情……", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("啊……好混亂啊……！", GameConfig.player_name)
	await novel_interface.show_dialog("到底我的記憶裡哪些是真的、哪些是夢啊……！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("……步態識別模式吻合。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這是什麼意思？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("步態模式是大腦在行走時對身體每一塊肌肉的控制習慣，就算是最優秀的特務也無法偽裝。", "莉琉")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("雖然現有的科學理論無法解釋……\n但妳確實是"+GameConfig.player_name+"。", "莉琉")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("真，真的嗎？ ？", "安妮")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("我還以為，到這裡就能理出點頭緒……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("妳知道關於「洛斯金盃」的事嗎？", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("洛斯金盃？ 妳指的是新聞說在監控下突然消失的異質物……我沒親眼見過。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("嗯，假設妳說的全是真話……", "莉琉")
	await novel_interface.show_dialog("我會答應去做那種無聊又沒錢拿的講座，唯一的原因只有它了。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("那是在洛斯群島上找到的「異質物」，杯子外面鑲著四塊純度超乎想像的寶石。", "莉琉")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("對了，後來我爬出廢墟，看到飄在空中發光的物體輪廓，確實有點像杯子……", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("就那麼浮在半空，還泛著淡淡的紅色光……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("淡紅色？ ？", "莉琉")
	await novel_interface.show_dialog("（杯子裡的淡紅色液體一直是不解之謎……）", "莉琉")
	await novel_interface.show_dialog("（但這份情報被列為機密，即使前不久被評定為「Safe」，也從未對外公開過）", "莉琉")
	await novel_interface.show_dialog("（沒親眼見到的人不可能說出這種細節……）", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("看來，無論妳說的是不是夢境，都有必要再向妳深入瞭解。", "莉琉")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
