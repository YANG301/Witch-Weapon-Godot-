# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai kiểm tra báo cáo dựa trên dữ liệu nhấp nháy trên màn hình, thỉnh thoảng nhếch mép cười.")
	await novel_interface.show_text_only("Mariru chộp lấy bản báo cáo từ phía sau Ai và nghiên cứu nó.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Vậy bài kiểm tra thể chất diễn ra như thế nào? Bạn trông quá hài lòng với chính mình.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… Điều đó thật tuyệt vời!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Linh hồn của một chàng trai bị mắc kẹt trong cơ thể của một cô gái… Nếu những người ở Viện Nghiên cứu Não Harima nghe về Lian, họ sẽ giết người để gửi yêu cầu thí nghiệm và cướp cô ấy đi.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chúng ta phải giữ điều này cho riêng mình, hiểu không?\\nCó phát hiện gì mới không?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Cả telomere của chúng đều chỉ ra độ tuổi mười lăm, nhưng lượng Caesium-137 trong mô mềm của Annie chỉ bằng một phần tư mức trung bình ngày nay.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Thông minh… \\nVậy cùng lắm cô ấy chỉ sống qua được một nửa Cuộc chiến Bảy năm?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Trừ khi cô ấy bị giữ trong một chiếc hộp kín suốt nhiều năm sau chiến tranh.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi hiểu. \\nCòn Lian thì sao?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Về phần Lian… mức độ phát hiện được trong mô cơ của cô ấy thấp hơn 1/200 mức trung bình—thậm chí còn thấp hơn mức mà trẻ sơ sinh thừa hưởng từ mẹ của chúng.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vậy đó là một cơ thể mới được tổng hợp?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Bây giờ mới là phần thực sự thú vị – cơ thể cô ấy mang kháng thể chống lại nhiều loại virus đã tuyệt chủng từ lâu, bao gồm cả bệnh đậu mùa.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("-?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Bình tĩnh nào. Không còn virus sót lại trong tủy sống của cô ấy.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Tôi đã kiểm tra sơ bộ—lịch sử hệ thống miễn dịch của Lian dường như chỉ bao gồm vài thế kỷ gần đây. Không có kháng thể chống lại bất kỳ loại virus thời tiền trung cổ nào.", "Ai")
	await novel_interface.show_dialog("Tuy nhiên, tôi vẫn muốn yêu cầu một mẫu tế bào bạch cầu của cô ấy và thử nuôi cấy virus số 008, 217 và 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Đây không phải là công việc của bạn với tư cách là một bác sĩ trường học.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Vâng, đúng vậy. Tôi hiểu. \\nBạn muốn tôi để mắt đến họ phải không?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Họ có thể có liên kết đến Ross Goblet… \\nTôi nghi ngờ họ đã không kể toàn bộ câu chuyện.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Tại sao không nhốt họ lại và thẩm vấn họ?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Bạn có cần giúp một tay không? Hãy nhìn xem, với một chút sửa đổi, những công cụ tôi sử dụng để kiểm tra hôm nay sẽ hoàn hảo cho công việc…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai Đôi mắt ánh lên sự phấn khích. Mariru cuộn bản báo cáo lại và đánh cô ấy bằng nó.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Chỉ cần giữ cho đôi mắt và đôi tai của bạn mở. Báo cáo cho tôi nếu có chuyện gì xảy ra.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Bây giờ cô ấy đã nhận ra rồi, tôi e rằng ai đó trong SID có thể đã…)", "Mariru")
	await novel_interface.show_dialog("(Ít nhất cô ấy sẽ vẫn bị kiểm soát trong trường) \\n(Và trong lúc đó tôi có thể theo dõi cô ấy...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Bạn không cần phải nói với tôi hai lần. Tôi sẽ ghi lại mọi ~ thay đổi trong cơ thể của Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Tốt hơn hết bạn nên giữ kín danh tính và đi đúng hướng.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("He he, thư giãn đi. \\nSẽ chẳng có gì thú vị nếu tôi làm cạn khô cô ấy cùng một lúc.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
