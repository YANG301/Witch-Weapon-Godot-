# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie đã được giải quyết ở phòng bên cạnh. Có vài điều tôi cần nói riêng với bạn.", "Mariru")
	await novel_interface.show_dialog("Tôi vừa nhận được xác nhận.", "Mariru")
	await novel_interface.show_dialog("Kể từ sáng nay, các dị thường không thời gian quy mô lớn đã xuất hiện ở nhiều thành phố lớn...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Các khu vực bị ảnh hưởng mà chúng tôi biết cho đến nay bao gồm Cung điện Hovering, Newmoridas, Pháo đài Masada, Salmonton, New Opulentia và Quần đảo Lebona.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Vậy chẳng phải điều đó có nghĩa là...\ntất cả sáu Thành phố Học viện...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Đúng vậy. Cả thế giới hiện đang theo dõi điều này và quy mô của tác động đã vượt xa sự mong đợi.", "Mariru")
	await novel_interface.show_dialog("Tôi nghĩ... có thể có một khả năng...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Mọi thứ bạn mô tả đã trải qua trong giấc mơ—những kẻ khủng bố tấn công trung tâm nghiên cứu, thành phố biến thành đống đổ nát...", "Mariru")
	await novel_interface.show_dialog("...tất cả những điều đó có thể đã thực sự xảy ra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("H-Sao có thể thế được?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Tôi không có bằng chứng thuyết phục, nhưng một sự biến dạng không gian lớn có thể đã xảy ra sáng nay.", "Mariru")
	await novel_interface.show_dialog("Vệ tinh True Sight của SID cũng phát hiện ra một vụ nổ tiếng ồn dữ dội bất thường.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Có lẽ điều này sẽ dễ hiểu hơn: New Opulentia thực sự đã bị phá hủy một lần, nhưng một loại thế lực nào đó đã đảo ngược thực tế đó...", "Mariru")
	await novel_interface.show_dialog("Và sức mạnh đó dường như cũng có liên quan đến những thay đổi trong cơ thể bạn, cũng như những cuộc tấn công của những kẻ thù xa lạ đó.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tất nhiên đó vẫn chỉ là giả thuyết của tôi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ý tưởng đó... có phải hơi táo bạo quá không...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Vì những sự kiện ngày hôm nay, năm Thành phố Học viện còn lại đều đang gây áp lực lên Thượng viện để cho phép vào để điều tra.", "Mariru")
	await novel_interface.show_dialog("Và nếu mối liên hệ của bạn với vụ việc này bị bại lộ, việc bị tổ chức nghiên cứu bắt đi sẽ là vấn đề nhỏ nhất của bạn...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Đặc vụ từ mọi tổ chức tình báo sẽ đánh dấu bạn là mục tiêu chính.", "Mariru")
	await novel_interface.show_dialog("Thậm chí không tính những người đã hoạt động bí mật, ngày nay hơn một trăm đặc vụ tình báo từ nhiều quốc gia khác nhau đã vào New Opulentia chỉ bằng danh tính giả.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Bạn biết tất cả những điều đó một cách chi tiết như vậy?\nTại sao bạn không ngăn họ lại?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hừm. Thà giữ tình hình trong tầm kiểm soát trong bóng tối còn hơn buộc họ phải thay đổi khuôn mặt và biến mất khỏi tầm mắt.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", bạn cần hiểu điều này: chừng nào bạn còn mang cơ thể con gái thì bạn không bao giờ có thể quay lại cuộc sống cũ.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Tuy nhiên, việc chúng tôi tại SID tìm thấy bạn đầu tiên có thể là một điều may mắn.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Trở thành con gái chỉ sau một đêm...\nLàm sao tôi có thể giải thích điều đó với bạn cùng lớp và bạn bè của mình...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... bạn không lo lắng cho bố mẹ mình sao?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mẹ tôi mất khi tôi còn nhỏ.\nCha tôi... đã mất tích nhiều năm...", GameConfig.player_name)
	await novel_interface.show_dialog("Tôi sống ở trường nội trú cho đến khi tôi mười hai tuổi.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Vậy là chương trình chăm sóc trẻ em thời hậu chiến của khỉ đột thực sự đã giúp được một số trẻ em.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, bạn đã chia sẻ khó khăn rồi.\nTuy nhiên, bạn không cần phải lo lắng về vấn đề chuyển đổi danh tính.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chuyển đổi danh tính...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Một nụ cười khá đáng ngại xuất hiện trên khuôn mặt của Mariru...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
