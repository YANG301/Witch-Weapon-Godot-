# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("È un torrido pomeriggio estivo. Metto una pila di carte accanto al tavolo rotondo nel cortile e mi sprofondo su una sedia all'ombra sotto gli alberi.")
	await novel_interface.show_text_only("Qualche tempo fa ho visto questa bella ragazza alle prese con la sua pila di libri. Non ci ho pensato due volte e le ho dato una mano.")
	await novel_interface.show_text_only("Poi se ne andò di corsa, anche se per fortuna. È stato allora che ho capito che sono un idiota.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uff... Lasciami fare una pausa qui... Fa così caldo.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ahimè, per me era un gioco da ragazzi quando ero ragazzo.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("E poi c'è questo SID corso di formazione in arrivo... Cavolo, posso nascondermi da qualche parte?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, fai attenzione ai tuoi modi... \\nQuesta è una scuola.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Ehi, Annie! \\nChe succede?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ascolta... So che fa caldo. \\nMa... è proprio necessario alzare la maglietta per asciugarsi il sudore?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Voglio dire... fai attenzione a un malfunzionamento del guardaroba...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Accidenti!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Quella Lian ragazza è così scortese...", "Studente A")
	await novel_interface.show_dialog("Sì, l'ho vista allargare le gambe l'altro giorno, indossando una gonna.", "Studente B")
	await novel_interface.show_dialog("Davvero? Che schifo...", "Studente A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(Non avrei dovuto indossare le gonne fin dall'inizio, ok?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ehi…")
	await novel_interface.show_text_only("Che voce gentile.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Usa il mio fazzoletto se non ti dispiace.", "Ragazza elegante")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Davanti a me c'è una ragazza bella ed elegante. \\nHa capelli lunghi, setosi, viola e occhi lilla.")
	await novel_interface.show_text_only("Mi porge un fazzoletto dal profumo squisito e fresco.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Eh?! \\nGrazie... Grazie.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Siete gli studenti trasferiti del primo anno, giusto? \\nMi chiamo Nix Strozzi. Sono il tuo senior.", "Nix")
	await novel_interface.show_dialog("Ti ho visto sudare e ho con me il mio fazzoletto, quindi... \\nSpero di non interromperti.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix mi fa un cenno educatamente, ma io vado fuori di testa. Mi alzo e saluto in modo piuttosto stupido.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("No... affatto! \\nÈ di grande aiuto!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Sembra molto amabile.) \\n(È straniera? Guarda quelle lunghe ciglia...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Guardo il viso delicato di Nix, con il cuore che batte forte.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Piacere mio. \\nQuindi... il tuo nome è...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Sono Lian. Lei è Annie. \\nCi siamo appena trasferiti qui ultimamente.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix sembra confuso e fissa Annie, anche se brevemente.")
	await novel_interface.show_text_only("Poi sorride a Annie in modo amichevole. Mi chiedo se fosse solo una mia illusione proprio adesso.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sono felice di incontrarti oggi.", "Nix")
	await novel_interface.show_dialog("Ma devo andare adesso. Fammi sapere se c'è qualcosa che posso fare per aiutarti.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Grazie, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie esita senza alcuna risposta.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questa ragazza, Nix... sembra molto più elegante di tutte queste ragazze dal cucchiaio d'argento.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, stai bene? \\nSei stato silenzioso.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Ha detto che è una Strozzi?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh, la conosci?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie mi prende il braccio e mi fa un sorriso innocente.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("No. \\nSiamo nuovi qui. Come potrei conoscerla?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Sì, hai ragione.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
