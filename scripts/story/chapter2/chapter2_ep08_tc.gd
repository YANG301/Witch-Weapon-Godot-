# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("安妮已經安置到隔壁房間了，有些事情我必須單獨告訴妳。", "莉琉")
	await novel_interface.show_dialog("我剛剛得到確認的訊息。", "莉琉")
	await novel_interface.show_dialog("從今天早上開始，多個主要城市都出現了大規模的時空異變……", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("已知受影響的地區包括：華雲宮城、紐摩利達斯、馬薩達堡、薩蒙頓、新豐洲和萊博娜群島。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("欸？ 那不就是……\\n六大學園都市全都……？ ！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("就是醬，現在全世界都盯著這件事，影響幅度超乎預期。", "莉琉")
	await novel_interface.show_dialog("我覺得，或許有一種可能……", "莉琉")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("你說你在夢中經歷過的一切：襲擊研究中心的恐怖分子、化為廢墟的城市……", "莉琉")
	await novel_interface.show_dialog("……這些可能都確實發生過。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("真假！ 這…這…怎麼可能？ ！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("雖然沒有確切的證據，不過今早，很可能已經發生了一場超大規模的次元扭曲。", "莉琉")
	await novel_interface.show_dialog("SID「真實視域」衛星同時也偵測到了超乎尋常的雜訊爆發。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("換個比較容易懂的說法好了：新豐洲市確實曾經一度毀滅，但某種力量扭轉了這個現實……", "莉琉")
	await novel_interface.show_dialog("而且，這種力量似乎與妳身體的變化，以及遭遇怪異敵人的襲擊有關。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("當然啦，目前這只是我的假設。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("這想法……會不會太大膽了些……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("因為今天的事件，現在其他五個學園都市都拼命給元老院施加壓力，希望能入境進行調查。", "莉琉")
	await novel_interface.show_dialog("而妳與這次事件的關聯一旦曝光，恐怕就不只被研究機構帶走那麼簡單了……", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("所有情報組織的特務都會把妳視為關鍵目標。", "莉琉")
	await novel_interface.show_dialog("先不算原本就潛伏在此的特務，光今天用假身分進入新豐洲的各國情報員就超過一百人。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("妳既然這麼瞭解，\\n為什麼不阻止他們？", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("哼，與其逼他們換批新人，現在他們在明，我在暗，這樣更容易掌握局面。", "莉琉")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+"，有一點妳必須清楚：只要妳還是女孩的身體，就不可能回到原來的生活。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("不過最早發現妳的是我們SID，也算是件好事吧。", "莉琉")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("啊啊～一夜之間變成女孩子這種事……\\n我該怎麼對同學和朋友說才好……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("嗯？ 妳不擔心妳的父母嗎？", "莉琉")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我媽媽在我小時候就去世了，\\n爸爸……也已經失蹤好多年……", GameConfig.player_name)
	await novel_interface.show_dialog("我在12歲之前一直住在寄宿學校。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("（……大猩猩主持的戰後保育計劃，還是幫到了一些小朋友啊。 ）", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("嗯，妳也算吃過些苦了。 \\n至於性別、不對，是身分轉換的問題，妳倒是免煩惱。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("身分……轉換？", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉臉上露出了可疑的笑容……")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
