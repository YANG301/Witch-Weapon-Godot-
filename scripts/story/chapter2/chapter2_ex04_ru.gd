# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("С разрешения Mariru мы с Annie решаем пойти за покупками с Elluka.")
	await novel_interface.show_text_only("Elluka стоит позади меня, осторожно осматривая все.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, хочешь шоколада?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, шоколад, типа.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Вот и вы.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka берет плитку шоколада, осторожно разворачивает ее и откусывает небольшой кусочек.")
	await novel_interface.show_text_only("Просто не могу нарадоваться ей. Как мило!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Эй, ты выглядишь как извращенец средних лет.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Что?! Я всего лишь подросток.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Извращенец.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Почему вы оба сделали это со мной?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, я не дам тебе шоколада, если ты продолжишь так себя вести.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Фууу…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Стреляйте. Она выглядит мило, даже когда лежит.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Хаха. Я просто шучу. \\nВот и ты.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Сколько у тебя шоколада? \\nВы наберете вес, если будете переедать.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("В чем дело? У меня всего несколько кварталов.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie смотрит на меня странным взглядом, от чего мне становится не по себе.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Что?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Я украдкой просмотрел отчет о вашем недавнем медосмотре. \\nВы набираете вес, но не стали выше.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Почему ты это сделал?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Очевидно, чтобы узнать тебя получше.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Теперь я знаю, что твой рост всего пять футов три дюйма. То же, что и я.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Черт возьми. Это не повод для гордости.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Но мой рост был пять футов четыре дюйма, когда я был мальчиком!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Это не такая уж большая разница, не так ли?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Ты меня обманул... \\nЯ не должен был тебе этого говорить.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пока Elluka наслаждается шоколадом, разговор привлекает ее внимание. Она вдруг смотрит вверх в замешательстве.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Сестра Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Да?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Брат... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Сестра? Брат? \\nДанные повреждены. Неопознаваемый.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Забудьте то, что мы только что сказали!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Повторное сканирование цели. Идентифицирована женщина... \\nСестра? Брат?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Аааа! Останавливаться!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
