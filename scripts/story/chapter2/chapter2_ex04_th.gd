# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("เมื่อได้รับอนุญาตจาก Mariru Annie และฉันจึงตัดสินใจไปช็อปปิ้งกับ Elluka")
	await novel_interface.show_text_only("Elluka ยืนอยู่ข้างหลังฉัน มองทุกอย่างอย่างระมัดระวัง")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka เอาช็อคโกแลตมั้ย?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka ช็อคโกแลต อย่างเช่น", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("นี่คุณ.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka หยิบช็อกโกแลตแท่ง แกะออกอย่างระมัดระวัง และกัดเข้าไปเล็กน้อย")
	await novel_interface.show_text_only("แค่ไม่สามารถรับเธอได้เพียงพอ น่ารัก!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("เฮ้ คุณดูเหมือนคนนิสัยไม่ดีวัยกลางคนเลย", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("อะไรนะ! ฉันเป็นแค่วัยรุ่น", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("นิสัยเสีย.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ทำไมคุณสองคนถึงทำอย่างนี้กับฉัน?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka ฉันจะไม่ให้ช็อกโกแลตแก่คุณถ้าคุณยังทำตัวแบบนั้น", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("บู้…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ยิง เธอดูน่ารักแม้ตอนที่เธอล้มลง")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("ฮ่าๆ ฉันแค่ล้อเล่น \\nอยู่นี่แล้ว", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("คุณมีช็อคโกแลตมากแค่ไหน? \\nน้ำหนักจะขึ้นถ้าคุณกินมากเกินไป", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("เรื่องใหญ่อะไร. ฉันมีแค่ไม่กี่บล็อก", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie มองมาที่ฉันด้วยสายตาแปลกๆ ทำให้ฉันรู้สึกไม่สบายใจ")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("อะไรนะ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("ฉันแอบดูรายงานการตรวจร่างกายล่าสุดของคุณ \\nคุณกำลังเพิ่มน้ำหนัก แต่ไม่ได้สูงขึ้นเลย", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ทำไมคุณถึงทำเช่นนี้?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("เพื่อที่จะรู้จักคุณดีขึ้นอย่างเห็นได้ชัด", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("ตอนนี้ฉันรู้ว่าคุณสูงแค่ห้าฟุตสามเท่านั้น เช่นเดียวกับฉัน", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ประณามมัน มันไม่มีอะไรน่าภาคภูมิใจเลย", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("แต่ฉันสูงห้าฟุตสี่เมื่อตอนที่ฉันยังเป็นเด็ก!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("นั่นก็ไม่ได้แตกต่างกันมากนักใช่ไหม?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("คุณหลอกฉัน... \\nฉันไม่ควรบอกเรื่องนี้กับคุณเลย", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ขณะที่ Elluka เพลิดเพลินกับช็อกโกแลต บทสนทนาก็ดึงดูดความสนใจของเธอ จู่ๆ เธอก็เงยหน้าขึ้นมองด้วยความสับสน")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("น้อง Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("ใช่ไหม?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("พี่ชาย... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("น้องสาว? พี่ชาย? \\nข้อมูลเสียหาย ไม่สามารถระบุตัวตนได้", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! ลืมสิ่งที่เราเพิ่งพูด!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("การสแกนเป้าหมายอีกครั้ง ระบุเพศหญิง... \\nน้องสาว? พี่ชาย?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("อ๊าาา! หยุด!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
