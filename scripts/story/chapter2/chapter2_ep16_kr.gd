# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("아이가 보고서와 스크린 속 데이터를 비교하고 있다. 이따금 키득거리는 그녀의 웃음소리가 들린다.")
	await novel_interface.show_text_only("마리루가 아이의 뒤에서 문서를 뺏어가 내용을 살펴본다.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("건강검진 결과가 어때, 뭘 그렇게 신난 거야.", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("아——정말 신비로워! !", "아이")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("몸은 여자고 영혼은 남자라니…… 『하리마 뇌연구소』 놈들이 알면 무슨 수를 써서라도 실험 신청을 내고 데려가려 들겠네.", "아이")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그러니까 기밀이야. 알겠어,\\n단서는 찾았어?", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("텔로미어 연령은 모두 15살이야. 하지만 앤의 연조직 속 세슘-137 함량이 평균치의 4분의 1밖에 되지 않아.", "아이")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그러니까 『7년 전쟁』을 최대 절반 밖에 겪지 않았단 말이지, ", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("전쟁 후 몇 년간 밀폐 캡슐에 갇혀 있지 않는 이상은.", "아이")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("알았어. \\n렌은?", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("렌은…… 근육 조직에서 검출된 수치가 평균의 200분의 1도 안 돼. 신생아가 어머니에게서 물려받는 양보다도 더 낮아.", "아이")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……그러니까,새로 생성된 몸이라는 거야?", "마리루")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("더 흥미로운 건 이거야—— 몸 안에 천연두를 비롯해 이미 멸종한 바이러스들에 대한 항체가 잔뜩 있다는 거지.", "아이")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("——?!", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("걱정 마~척수에는 바이러스가 남아있지 않으니까.", "아이")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("대강 추려 보니 샤오롄의 면역 시스템 흔적은 최근 몇백 년 사이의 것뿐이야. 중세 이전 바이러스의 항체는 없어.", "아이")
	await novel_interface.show_dialog("그래도 샤오롄의 백혈구로 008, 217, 742호 바이러스를 배양해 보고 싶다니까~", "아이")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……널 학교로 보낸 건 너의 그 이상한 취향을 만족시키기 위해서가 아니야.", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("알았어,알았어~\\n두 사람을 잘 지켜보란 말이지?", "아이")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("두 사람은 『로스 금잔』의 실종과 관련이 있을지도 몰라… \\n그들이 뭔가 얘기하지 않은 게 있을 거야.", "마리루")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("가둬 놓고 취조하면 되잖아.", "아이")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("내가 도와줄까, 신체검사용 장치를 조금만 개조하면 좋은 심문 도구가 될 텐데~", "아이")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("아이가 흥분한 눈빛을 하자,마리루가 보고서를 말아 그녀를 때린다.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("잘 관찰하기나 해. 무슨 일이 있으면 즉시 보고하고. ", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(그 녀석들이 이미 알고 있어. 설마 SID 내부에…)", "마리루")
	await novel_interface.show_dialog("(학교에 놔두면 호기심을 낮출 수 있겠지.)\\n(그의 행동을 견제할 수도 있어…)", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("말 안 해도 알아. 렌의 신체 변화는 내가 전~부 기록해 둘 테니까!", "아이")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("……신중히 행동해.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("헤헤헤,걱정 마. \\n한 번에 다 짜버리면 재미가 없으니까.", "아이")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
