# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Antes de ir para sua nova escola, sua primeira tarefa é o treinamento de conhecimentos básicos.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Conhecimento básico?\nNão é como se eu estivesse Annie e tivesse perdido tudo o que aconteceu nesses últimos anos...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ei. Você perdeu mais de uma década de conhecimento sobre ser uma garota, não foi?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Eu não preciso desse tipo de conhecimento!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ignorou completamente meu protesto e caminhou em direção à mesa animado. Só então percebi que ela já havia preparado todo o tampo da mesa com todo tipo de ferramenta imaginável.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Primeiro, você precisa ser capaz de distinguir doze tons de batom padrão e memorizar as vinte principais marcas.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Tantos...?\nAs cores não são basicamente todas iguais?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Muito ingênuo! Isso não é nem um décimo do total.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("E aqui preparei um conjunto completo de ferramentas de maquiagem para você: base, sombra, brilho labial, iluminador, contorno...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hein? Eu tenho que colocar tanta coisa na minha cara?!\nNão é como se eu estivesse pintando... Quão complicado é ser uma garota, exatamente...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Não se preocupe. A partir de hoje, alguém vai te ensinar maquiagem corretamente.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mas os alunos do ensino médio não podem nem usar maquiagem...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Você realmente não entende o mundo das garotas do ensino médio...\nSe você continuar agindo de forma tão descuidada, as pessoas vão suspeitar em pouco tempo.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("E além da escola, como agente SID você precisará realizar todo tipo de missão. A maquiagem é uma das habilidades essenciais para uma agente feminina.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Especialmente com um rostinho fofo como o seu—", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru estendeu um dedo e inclinou meu queixo para cima.")
	await novel_interface.show_text_only("Dei um passo para trás para evitar a mão dela. De alguma forma, meu orgulho masculino simplesmente não conseguia aceitar isso.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Já fui voluntário antes, claro...\nMas nunca imaginei que teria que aprender coisas assim...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("As avaliações dos cadetes de SID são extremamente rigorosas. Cada rodada elimina um grande grupo de pessoas.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Já que você falou sobre um jogo tão importante, por que não provar seu valor?", "Mariru")
	await novel_interface.show_dialog("E se você passar na avaliação final, você será oficialmente incluído na lista – com um salário muito decente também~", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hein? Eu também posso ser pago?!\n(Th-Então meu carrinho de compras Gfat...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Tudo bem, o orgulho masculino pode ficar de lado por enquanto.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Hehehe... que pirralho simples.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Mas, em troca, é melhor você entender isso: como seu comandante, minhas ordens são absolutas e você as obedecerá incondicionalmente!", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("No que estou me metendo...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Primeiro, deixe-me apresentar alguém a você – o professor que se ofereceu para lhe ensinar maquiagem.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Embora suas responsabilidades habituais sejam drogas experimentais e desenvolvimento de equipamentos especiais...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Ah... você deve ser Lian, certo?\nHehe~ Esse perfil é realmente interessante~", "Menina com óculos")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Olá ~ Sou o diretor do Departamento de Pesquisa de Combate de SID. Como nossos arquivos foram alterados, você pode me ligar Ai.", "Menina com óculos")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Olá...\n(O arquivo dela... também foi alterado?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian é um excelente material de pesquisa...\nVocê não pode me emprestar ela por um tempinho~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Material de pesquisa...? Me emprestar...?)", "Lian")
	await novel_interface.show_dialog("(P-Por que minhas costas de repente ficam meio frias...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Eu sou o guardião dela, pelo menos no papel, então você não tem permissão para fazer nada contra ela ~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Hmph, tudo bem...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("Também não costumo usar maquiagem, mas essas coisas são simples. Eu memorizei tudo depois de olhar para ele por dez minutos.", "Ai")
	await novel_interface.show_dialog("Você também deve ser capaz de aprender rapidamente.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Tão rápido?\nPareceu um processo muito complicado para mim...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai lembra de tudo rapidamente. Você deveria aprender mais com ela no futuro ~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Certo...\n(Como exatamente devo aprender algo como memória?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aghh~~\nMinha cabeça está prestes a explodir depois de passar o dia todo com Ai memorizando marcas e cores de maquiagem.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! Por que você está aqui?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("O quê? Para começar, este apartamento é uma das minhas residências em New Opulentia.\nMais do que isso, todo este edifício é propriedade de SID~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não admira que este lugar seja tão escandaloso!\nEspere, não me diga que você vai morar aqui com Annie e eu...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Eu só passo por aqui ocasionalmente, então não vou ficar aqui com frequência ~\nEmbora a geladeira já esteja sem cerveja. Da próxima vez, lembre-se de me comprar duas caixas.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Mas hoje estou aqui especificamente no meu papel de seu guardião... hee-hee~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E-eu tenho um pressentimento terrível sobre isso!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Venha experimentar isso. Este é o seu uniforme escolar, Lian, e este é um vestido ~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por que... essa saia é tão curta...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Uma saia realmente fica melhor nesse comprimento.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Com certeza você alterou o comprimento dessa saia, não foi?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Não se preocupe com os pequenos detalhes ~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("E aqui temos meias até o tornozelo, meias carecas, cano alto, meia-calça...\nAh, e essa cinta-liga também!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Como existem tantos tipos de meias também...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Também tem diferentes tipos de listras, patchwork, estampas, bolinhas...\nAh, certo, quer experimentar meia arrastão?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Absolutamente não!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Não, espere! Esse não é o ponto!\nEu não quero usar coisas assim de jeito nenhum!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Se uma missão exigir isso, você não terá escolha de qualquer maneira, então é melhor se acostumar com isso cedo...\nQuer que eu ajude você?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("V-Você... você...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
