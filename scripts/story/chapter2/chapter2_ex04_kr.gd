# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("마리루의 허락을 받고 나와 앤이 이루카를 데리고 밖에 나왔다.")
	await novel_interface.show_text_only("이루카가 내 뒤에 서서 열심히 주위를 관찰한다. ")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("이루카,초콜릿 먹을래?", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("이루카,초콜릿,좋아.", "이루카")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("자,이거 너에게 줄게.", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("이루카가 초콜릿을 받아들고는 조심스럽게 포장을 뜯어 한 입 깨물어 먹는다. ")
	await novel_interface.show_text_only("이루카는 몇 번을 봐도 항상 귀여워!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("어떤 사람의 얼굴에 또 중년 아저씨의 표정이 나타났대요!", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("엣?!사춘기 남자에서 중년 아저씨로 진화한 거야, ", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("변태——", "이루카")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("어째서 두사람 다 한꺼번에 공격하는 거야!정말!", "샤오롄")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("이루카, 자꾸 이러면 초콜릿 안 줄 거야~", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("흑……", "이루카")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("이런,슬퍼하는 표정도 너무 귀엽잖아! ")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("헤헤헤,거짓말이야. \\n자,하나 더 줄게. ", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("……도대체 초콜릿이 몇 개나 있는 거야?!\\n당분을 과도하게 섭취하면 뚱뚱해진다구!", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("그게 무슨 상관이야. 겨우 초콜릿 몇 조각일 뿐인데. ", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("앤이 이상한 눈빛으로 날 뚫어져라 쳐다보자 무언의 압박이 느껴진다.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("왜,왜 그래?", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("렌의 최근 신체검사표를 몰래 봤어!\\n체중은 늘었지만 키는 전혀 변화가 없어. ", "앤")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("왜 그런 걸 보고 그래!", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("헤헤헤,당연히 렌을 더 많이 알아가기 위해서지. ", "앤")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("네 키는 지금 나랑 똑같은 161센티미터야! ", "앤")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("쳇,그게 그렇게나 뿌듯해 할 일이냐!", "샤오롄")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("그리고,남자였을 땐 165였어! ", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("엣, 남자인데도 지금보다 조금밖에 크지 않아, ", "앤")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("당했다……\\n너한테 얘기하는 게 아니였는데.", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("아까부터 묵묵히 초콜릿을 먹고 있떤 이루카가 우리의 대화를 들은 후 갑자기 고개를 든다.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("렌 언니?", "이루카")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("왜?", "샤오롄")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("렌…오빠?", "이루카")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("……", "샤오롄")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("언니, 오빠,\\n데이터 혼란,판정 불가. ", "이루카")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("이루카! 방금 들은 대화는 모두 잊어버려!", "샤오롄")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("다시 스캔,목표,인간 여성……\\n언니?오빠?", "이루카")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("아아아아 그만해!", "샤오롄")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
