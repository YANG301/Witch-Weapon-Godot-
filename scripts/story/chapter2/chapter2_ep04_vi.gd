# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ừ… tôi cũng thấy bối rối vì nó có cảm giác rất thật—không giống bất kỳ giấc mơ nào.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Tôi đã tìm kiếm tin tức về hỏa hoạn hoặc thiệt hại của tòa nhà nhưng không có gì cả. \\nThành phố trông vẫn yên bình như xưa.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ngoại trừ một điều…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ừm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Ngoại trừ cái gì?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Khi tôi thức dậy…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Tôi phát hiện cơ thể mình đã biến thành cơ thể một cô gái…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Ờ…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Hả? Bạn đã nói... nó đã thay đổi?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi không… trước đây tôi không hề trông như thế này…", GameConfig.player_name)
	await novel_interface.show_dialog("Tôi… tôi thực sự là một cậu bé!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwwww… một cậu bé?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Được rồi… chờ đã, cái gì cơ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ý bạn là bạn là một cậu bé mặc đồ khác giới? (nghiêng gần)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Không, không… Ý tôi không phải vậy. \\nĐừng đến gần thế này!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Nhưng… theo một nghĩa nào đó... \\nCó lẽ bạn đúng…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Ôi chúa ơi… làm sao tôi có thể giải thích điều này!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Dù sao đi nữa… bạn đã có một bộ ngực tuyệt vời. (Chạm)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Thật bồng bềnh… Bạn đã hoàn thành nó ở đâu? Thật là một cảm giác tự nhiên… (Véo)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo… Tôi cũng muốn tìm hiểu!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ôi! Không… không phải… chờ đã… \\nDừng lại đi!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Để tôi kiểm tra xem… cánh tay thon thả, vòng eo cong, hoàn hảo.", "Mariru")
	await novel_interface.show_dialog("Bạn đã sử dụng vật liệu gì? Đặc biệt là ở đây…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhh! Thật là ngứa…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Cô Mariru! Đừng chạm vào nó ở đây!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Không…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo…", GameConfig.player_name)
	await novel_interface.show_dialog("Tin hay không thì tùy! Tôi vẫn là một cậu bé cho đến ngày hôm qua!", GameConfig.player_name)
	await novel_interface.show_dialog("Không có phẫu thuật…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Vâng, không còn nghi ngờ gì nữa về điều này.", "Mariru")
	await novel_interface.show_dialog("Việc thay đổi giới tính hoàn toàn như vậy là không thể với công nghệ hiện tại.", "Mariru")
	await novel_interface.show_dialog("Bạn không thể làm được điều này trừ khi bạn thay thế mọi xương trong cơ thể. \\nĐiều đó có nghĩa là bạn đã và đang là một cô gái.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cái gì! Tôi đã nói với bạn rồi! \\nTôi thức dậy là một cô gái.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Bạn có bằng chứng gì không? \\nCó gì chứng minh bạn từng là con trai?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chà… bằng chứng… \\nỪ đúng rồi! Thẻ sinh viên của tôi!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Chúng tôi đã nộp lại toàn bộ đồ đạc của mình khi vào đây bao gồm cả quần áo và CMND.")
	await novel_interface.show_text_only("Mariru chạm vào thiết bị cầm tay của cô ấy, thẻ sinh viên của tôi hiện ra.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Vâng! Thế thôi! \\nNhìn này! Đó là bằng chứng.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Các đặc điểm trên khuôn mặt trông hơi giống bạn, nhưng điều này hầu như không có bằng chứng nào…", "Mariru")
	await novel_interface.show_dialog("Đúng rồi, kéo lên tất cả các cảnh quay của"+GameConfig.player_name+"đã bị hệ thống giám sát của thành phố ghi lại trong tháng qua…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru khéo léo gõ nhẹ vào máy tính bảng của mình, trông có vẻ hơi phấn khích.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Tôi đã nghĩ đó chỉ là một giấc mơ khi nhìn thấy đống đổ nát đó và tôi nghĩ mọi thứ sẽ trở lại bình thường sau khi thức dậy.", GameConfig.player_name)
	await novel_interface.show_dialog("Nhưng bây giờ, tôi đã trở thành một cô gái…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Áp dụng chỉnh sửa thay đổi xương. Kích hoạt phân tích dáng đi trên cảnh quay của bạn ở hành lang vừa rồi…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru phớt lờ lời thì thầm của tôi và tập trung vào máy tính bảng của cô ấy.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Có lẽ đó không phải là một giấc mơ. Nhưng bây giờ, mọi thứ có vẻ ổn. Không có lửa, không có sự hủy diệt.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh… Tôi hoàn toàn bối rối…!", GameConfig.player_name)
	await novel_interface.show_dialog("Phần nào trong ký ức của tôi là thật, phần nào chỉ là mơ…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Kiểu dáng dáng đi phù hợp.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Điều đó có nghĩa là gì?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Kiểu dáng đi là kiểu dáng kiểm soát đặc trưng của cơ bắp của một người khi đi bộ. Ngay cả những đặc vụ giỏi nhất cũng không thể che giấu được điều đó.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Mặc dù khoa học hiện tại không thể giải thích được…\nBạn thực sự là như vậy"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A… bạn có chắc không…?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Cuối cùng… tôi tưởng các bạn biết điều gì đó về chuyện này…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Vậy, bạn đã nghe nói về Ross Goblet chưa?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Một Substance H đột nhiên biến mất dưới sự giám sát của video, theo tin tức sáng nay… Nhưng tôi vẫn chưa tận mắt nhìn thấy nó.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Được rồi, nếu cậu nói sự thật…", "Mariru")
	await novel_interface.show_dialog("Có lẽ đó là lý do duy nhất khiến tôi đồng ý giảng miễn phí bài giảng nhàm chán này.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Nó là một Substance H được tìm thấy trên Quần đảo Ross. Bốn viên đá quý có độ tinh khiết vượt trội được gắn ở bên ngoài.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi đã nhìn thấy thứ gì đó trông giống như một chiếc cốc sáng chói đang bay trên bầu trời sau khi tôi trèo ra khỏi đống đổ nát.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Nó bay lơ lửng trên bầu trời, phát ra ánh sáng đỏ nhạt…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Màu đỏ nhạt?", "Mariru")
	await novel_interface.show_dialog("(Chất lỏng màu đỏ nhạt trong chiếc cốc vẫn còn là một bí ẩn…)", "Mariru")
	await novel_interface.show_dialog("(Nhưng thông tin đó được phân loại. Nó chưa bao giờ được công khai, ngay cả sau khi nó được xếp hạng 'An toàn' cách đây không lâu.)", "Mariru")
	await novel_interface.show_dialog("(Không ai có thể đưa ra những chi tiết như vậy nếu chưa từng nhìn thấy nó trước đây…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Bất kể đó có phải là một giấc mơ hay không, tôi e rằng chúng tôi cần phải xác nhận thêm thông tin với bạn.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
