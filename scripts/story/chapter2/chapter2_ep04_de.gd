# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ja ... ich bin auch verwirrt, weil es sich so real anfühlte – anders als jeder Traum.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ich habe nach Nachrichten über Feuer oder Gebäudeschäden gesucht, aber es gibt nichts. \\nDie Stadt sieht genauso friedlich aus wie früher.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Bis auf eine Sache …", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Außer was?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Als ich aufwachte ...", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Ich stellte fest, dass sich mein Körper in den Körper eines Mädchens verwandelt hatte …", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Naja...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Hä? Sagten Sie, es hat sich geändert?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich bin nicht... ich sah vorher nicht so aus...", GameConfig.player_name)
	await novel_interface.show_dialog("Ich... ich bin eigentlich ein Junge!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwwwww... ein Junge?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Okay... warte, was?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Du meinst, du bist ein Cross-Dressing-Junge? (beugt sich näher)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Nein, nein... Das meine ich nicht. \\nKomm nicht so nahe!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Aber… in gewisser Weise... \\nVielleicht hast du recht…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh Gott... wie kann ich das erklären!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Wie dem auch sei... du hast eine tolle Brustkorrektur. (Berührungen)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("So federnd ... Wo hast du es machen lassen? Was für eine natürliche Note… (Zwickt)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo... das will ich auch herausfinden!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Autsch! Nein... es ist nicht... warte... \\nHör auf damit!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Lassen Sie mich nachsehen … schlanke Arme, kurvige Taille, perfekt.", "Mariru")
	await novel_interface.show_dialog("Welche Materialien haben Sie verwendet? Besonders hier…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhhh! Das juckt...!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Frau Mariru! Fassen Sie es hier nicht an!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Nein...!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo…", GameConfig.player_name)
	await novel_interface.show_dialog("Ob Sie es glauben oder nicht! Ich war bis gestern ein Junge!", GameConfig.player_name)
	await novel_interface.show_dialog("Es gab keine Operation...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Ja, daran besteht kein Zweifel.", "Mariru")
	await novel_interface.show_dialog("Eine solch vollständige Geschlechtsumwandlung ist mit den aktuellen Technologien unmöglich.", "Mariru")
	await novel_interface.show_dialog("Sie können dies nicht tun, es sei denn, Sie ersetzen jeden Knochen in Ihrem Körper. \\nDas heißt, du bist und warst ein Mädchen.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was! Ich habe es dir gesagt! \\nIch bin als Mädchen aufgewacht.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Haben Sie Beweise? \\nIrgendwelche Beweise dafür, dass du ein Junge warst?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Na ja... Beweis... \\nJa, richtig! Mein Studierendenausweis!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Als wir hier eintraten, gaben wir alle meine Sachen ab, einschließlich meiner Kleidung und meines Personalausweises.")
	await novel_interface.show_text_only("Mariru tippt auf ihr Handheld-Gerät, woraufhin mein Studentenausweis angezeigt wird.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Ja! Das ist es! \\nSchau! Das ist der Beweis.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Die Gesichtszüge sehen ein bisschen wie Sie aus, aber das ist kaum ein Beweis ...", "Mariru")
	await novel_interface.show_dialog("Richtig, rufen Sie alle Aufnahmen von auf"+GameConfig.player_name+"im letzten Monat vom Überwachungssystem der Stadt erfasst…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru tippt geschickt auf ihr Tablet und sieht ein wenig aufgeregt aus.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Ich dachte, es wäre nur ein Traum, als ich diese Ruinen sah, und ich dachte, nach dem Aufwachen würde alles wieder normal werden.", GameConfig.player_name)
	await novel_interface.show_dialog("Aber jetzt werde ich ein Mädchen ...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Nehmen Sie Knochenveränderungskorrekturen vor. Aktivieren Sie gerade Ganganalysen für Ihre Aufnahmen im Flur …", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignoriert mein Murmeln und konzentriert sich auf ihr Tablet.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Vielleicht ist es kein Traum. Aber jetzt sieht alles gut aus. Kein Feuer, keine Zerstörung.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh... ich bin total verwirrt...!", GameConfig.player_name)
	await novel_interface.show_dialog("Welche Teile meiner Erinnerungen waren real und welche nur Träume ...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Gangmusterübereinstimmungen.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was bedeutet das?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Das Gangmuster ist das charakteristische Kontrollmuster der Muskeln einer Person beim Gehen. Selbst die besten Agenten können es nicht verbergen.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Obwohl die aktuelle Wissenschaft es nicht erklären kann …\nDas sind Sie wirklich"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A... bist du sicher...?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Endlich... ich dachte, ihr wüsstet etwas darüber...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Haben Sie schon von Ross Goblet gehört?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Ein Substance H, das laut den Nachrichten von heute Morgen plötzlich unter Videoüberwachung verschwand … Aber ich habe es noch nicht persönlich gesehen.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Nun, wenn Sie die Wahrheit sagen ...", "Mariru")
	await novel_interface.show_dialog("Es wird wahrscheinlich der einzige Grund sein, warum ich zustimmen würde, diesen langweiligen Vortrag kostenlos zu halten.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Es handelt sich um einen Substance H, der auf den Ross-Inseln gefunden wurde. An der Außenseite sind vier Edelsteine ​​von bemerkenswerter Reinheit angebracht.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nachdem ich aus den Ruinen geklettert bin, habe ich etwas gesehen, das wie ein leuchtender Kelch aussieht, der am Himmel fliegt.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Es schwebte am Himmel und strahlte ein schwaches rotes Licht aus ...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Schwaches Rot?", "Mariru")
	await novel_interface.show_dialog("(Die schwache rote Flüssigkeit im Kelch war ein Rätsel …)", "Mariru")
	await novel_interface.show_dialog("(Aber diese Informationen sind vertraulich. Sie wurden nie veröffentlicht, selbst nachdem sie vor nicht allzu langer Zeit als „sicher“ eingestuft wurden.)", "Mariru")
	await novel_interface.show_dialog("(Niemand könnte solche Details nennen, ohne es vorher gesehen zu haben …)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Unabhängig davon, ob es ein Traum war, befürchte ich, dass wir weitere Informationen mit Ihnen bestätigen müssen.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
