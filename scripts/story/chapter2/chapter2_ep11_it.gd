# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Guarda chi c'è! Come ci si sente a diventare ufficialmente una ragazza, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... Per favore, smettila di prendermi in giro!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Va bene, va bene. A proposito, ho sentito che hai intenzione di trasferirti in un'altra scuola superiore pubblica dopo la pausa?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Sì. La nuova scuola è più vicina a dove vivo e... i requisiti di credito non sono così rigidi...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Per ragioni di sicurezza, ti organizzerò una nuova sistemazione.\nPer quanto riguarda la scuola...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Sembra che dovrò chiedere un favore a quel vecchio vecchio.)", "Mariru")
	await novel_interface.show_dialog("(Il solo pensiero è fastidioso... meno male che i record sono già stati corretti perfettamente...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Scuola superiore femminile di Gosakuragawa. Ha il livello di sicurezza più alto e non è nemmeno lontano dal quartier generale di SID.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mentre parlava, Mariru indicò verso l'alto.")
	await novel_interface.show_text_only("Si dice che Gosakuragawa, il vivace quartiere commerciale sopra la sede della metropolitana, ospiti una scuola prestigiosa con tasse spaventosamente alte.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("W-Aspetta, quella non è la scuola delle ragazze ricche?! Quello che chiamano \"un paradiso dove fioriscono gigli puri e splendidi fiori di ciliegio\"...", "Lian")
	await novel_interface.show_text_only("Si trattava di un testo pubblicitario scritto da gente fuori tema su un certo forum spazzatura perennemente in crash per deridere l'oltraggiosa retta di Gosakuragawa.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Cos'era quello?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N-No, niente di niente!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Considerando quanto sei sciocco, potresti finire per diventare una vera e propria... cosa per tutti quegli uomini delle classi superiori e inferiori.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru fece una leggera risata e non finì la frase.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Diventare cosa esattamente?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Adesso non è il momento di dare libero sfogo alla tua curiosità.\nComunque domani andrai a fare rapporto come si deve.", "Mariru")
	await novel_interface.show_dialog("Lì non sarà così rilassato come in una scuola pubblica.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Non puoi lasciarmi rilassare un po'... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Oh, giusto. Che ne dici di Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Il background di quella ragazza è piuttosto interessante.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lei... cosa c'è che non va in lei?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("I registri di Annie Bass nell'impianto risalgono solo a sette anni fa, quando lei aveva quindici anni.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sette anni fa significa che... ha già ventidue anni?!\nDimostra più o meno la mia stessa età!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Esatto. Anche adesso, la sua età ossea misura ancora quindici anni.", "Mariru")
	await novel_interface.show_dialog("Ma dove sia andata in quel periodo e perché sia ricomparsa all'improvviso, nessuno lo ha ancora capito, nemmeno lei stessa.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Non importa cosa, non penso che Annie sia una persona cattiva.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Su questo puoi stare tranquillo.\nDopo tutto, ci sono anche persone in SID che erano suoi fan.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?! Annie era una specie di idolo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Probabilmente rientra nella categoria \"una stella di anni fa\".", "Mariru")
	await novel_interface.show_dialog("Ma rispetto a chi era prima, sono più interessato a cosa c'è di speciale in lei adesso.", "Mariru")
	await novel_interface.show_dialog("Tanto per cominciare ci sono così poche informazioni sulle streghe... che è stata una manna inaspettata.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Streghe... che cos'è?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Mm... in poche parole, puoi pensarli come esseri umani che sono stati infettati da un certo tipo di informazioni e hanno acquisito alcuni tratti simili a \"Substance H.\"", "Mariru")
	await novel_interface.show_dialog("Proprio come le persone chiamano le strane caratteristiche di \"Substance H\"—cose che la scienza attuale non può spiegare—\"miracoli\".", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Per la gente comune, se qualcuno potesse manifestare questo tipo di caratteristica, sembrerebbe praticamente \"magia\".", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("La magia... dovrebbe essere solo una scienza che ancora non comprendiamo...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Questo è un modo perfettamente valido di pensarci.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("Esistono molti documenti storici sulle \"streghe\", ma sono sempre state trattate come superstizione e leggenda.", "Mariru")
	await novel_interface.show_dialog("Nell'arco di più di trecento anni, gli europei giustiziarono quasi centomila donne in nome delle \"streghe\".", "Mariru")
	await novel_interface.show_dialog("La \"caccia alle streghe\"... l'abbiamo imparata durante il corso di storia...", "Lian")
	await novel_interface.show_dialog("Allora lo consideravo solo un noioso materiale d'esame, ma più ci penso, più mi sembra davvero una catastrofe su scala innaturalmente massiccia...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Da quando è stato scoperto \"Substance H\", ogni paese ha iniziato a riesaminare se quelle leggende fossero vere.", "Mariru")
	await novel_interface.show_dialog("Ultimamente circolano voci secondo cui alcune organizzazioni hanno ricreato le streghe e le usano per lo spionaggio.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Tuttavia, fortunatamente per noi, Annie ha accettato di aderire senza esitazione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Unirsi a cosa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Per diventare un agente SID.", "Mariru")
	await novel_interface.show_dialog("Da domani lavorerà per me.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Non puoi farlo! Gli agenti SID ovviamente svolgono un lavoro estremamente pericoloso!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("E ha solo quindici anni, proprio come me. Non può essere una specie di agente...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh. Il nostro agente più giovane in questo momento ha solo tredici anni.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Tredici?! È illegale!!\nDev'essere illegale, vero?!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se mai avrai la possibilità di incontrarla, non lo dirai più.\nQuel ragazzo è molto più intelligente di uno stupido come te.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Mmph.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Come cittadino di New Opulentia, ovviamente so che, sebbene le varie città accademiche sembrino sottoposte a un cessate il fuoco, sono ancora segretamente in competizione tra loro.")
	await novel_interface.show_text_only("E lo scudo di Aegis è inutile contro le armi biochimiche e gli attacchi terroristici di tipo infiltrazione.")
	await novel_interface.show_text_only("Per proteggere questa città, Mariru e SID devono aver combattuto innumerevoli battaglie disperate nell'ombra.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oh, giusto. L'identità di copertura di Annie sarà uno studente trasferito che si iscriverà con te.", "Mariru")
	await novel_interface.show_dialog("Ho fatto in modo che voi due alloggiate nella stessa suite. Le uniformi e gli altri beni di prima necessità\nsaranno consegnati entro un'ora.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Nessuna contrattazione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Capisco...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Naturalmente capisco. Non c'è niente di male in questo.\nNo, è molto più confortevole della vita che avevo prima.")
	await novel_interface.show_text_only("Finché SID si prende cura di tutto.\nFinché continuo a vagabondare nella vita in una scuola per ragazze nobili, semplicemente tirando avanti con i crediti.")
	await novel_interface.show_text_only("E finché cerco di abituarmi a questo nuovo corpo... basterebbe?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... No.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ehm?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche se non capisco ancora niente, non voglio che Annie affronti questo tipo di pericolo da sola.")
	await novel_interface.show_text_only("La Annie che mi è apparsa nel momento in cui ci siamo incontrati...\nSembrava calma, ma c'era ancora una traccia di paura in lei.")
	await novel_interface.show_text_only("Anche lei era... spaventata, vero?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Signorina Mariru—se non ti dispiace se ti chiamo così...\nAnch'io voglio aiutarti!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Eh?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Voglio dire... visto che sono riuscito a superare quell'uragano, forse posso aiutare SID anche con qualcos'altro!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Non è stato un uragano. Era una fluttuazione di fase spaziotemporale...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("In ogni caso, non posso lasciare che Annie affronti il pericolo da solo.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("E forse... forse avrò anche la possibilità di trovare un modo per tornare ad essere un ragazzo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... Ma con la tua abilità fisica, probabilmente non potresti nemmeno battere uno dei bidelli di SID.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Uh...\n(Che tipo di addetti alle pulizie assumete?! Monaci Shaolin?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Bene. Ti farò provare l'addestramento per cadetti SID. Almeno, se ti imbatti in un pericolo in futuro, il tuo tasso di sopravvivenza potrebbe aumentare leggermente.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Per quanto riguarda il tuo status, inizierai come candidato agente di livello 4.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Ok! Farò del mio meglio!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Bene. Vediamo che tipo di dati posso ottenere da questo piccolo.)", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
