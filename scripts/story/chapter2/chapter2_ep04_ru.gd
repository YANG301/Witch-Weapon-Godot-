# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Да… Я тоже в замешательстве, потому что это казалось таким реальным – в отличие от любого сна.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Я искал новости о пожаре или повреждениях зданий, но ничего не нашел. \\nГород выглядит таким же мирным, как и раньше.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Кроме одного…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Хм?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Кроме чего?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Когда я проснулся…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Я обнаружил, что мое тело изменилось на тело девушки…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Ну…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("А? Ты сказал... оно изменилось?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я не… Раньше я так не выглядел…", GameConfig.player_name)
	await novel_interface.show_dialog("Я… я вообще-то мальчик!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Фууууу... мальчик?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Хорошо… подожди, что?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ты имеешь в виду, что ты мальчик, переодевающийся? (наклоняется близко)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Нет, нет… Я не это имею в виду. \\nНе подходи так близко!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Но… в некотором смысле... \\nМожет быть, ты и прав…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("О боже… как я могу это объяснить!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("В любом случае... у тебя отличная грудь. (Прикасается)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Такой прыгучий... Где ты это сделал? Такое естественное прикосновение… (Щипки)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Ух... Я тоже хочу это узнать!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ой! Нет… это не… подожди… \\nПрекрати!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Позвольте мне проверить… стройные руки, пышная талия, идеально.", "Mariru")
	await novel_interface.show_dialog("Какие материалы вы использовали? Особенно здесь…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Аааа! Это зуд...!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Мисс Mariru! Не трогай это здесь!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Нет…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Фууу…", GameConfig.player_name)
	await novel_interface.show_dialog("Хотите верьте, хотите нет! Я был мальчиком до вчерашнего дня!", GameConfig.player_name)
	await novel_interface.show_dialog("Операции не было…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Да, в этом нет никаких сомнений.", "Mariru")
	await novel_interface.show_dialog("Столь полная смена пола невозможна при нынешних технологиях.", "Mariru")
	await novel_interface.show_dialog("Вы не сможете этого сделать, если не замените каждую кость в своем теле. \\nЭто значит, что ты есть и была девушкой.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что! Я же тебе говорил! \\nЯ проснулась девочкой.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("У вас есть доказательства? \\nЕсть ли доказательства того, что ты был мальчиком?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ну... доказательство... \\nДа, верно! Мой студенческий билет!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("При входе сюда мы сдали все мои вещи, включая одежду и удостоверение личности.")
	await novel_interface.show_text_only("Mariru постучала по своему портативному устройству, и на экране появился мой студенческий билет.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Да! Вот и все! \\nСмотри! Это доказательство.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Черты лица действительно немного похожи на вас, но это вряд ли является доказательством…", "Mariru")
	await novel_interface.show_dialog("Хорошо, поднимите все кадры"+GameConfig.player_name+"захвачено городской системой наблюдения за последний месяц…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ловко стучит по планшету и выглядит немного взволнованной.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Когда я увидел эти руины, я подумал, что это был всего лишь сон, и думал, что после пробуждения все вернется на круги своя.", GameConfig.player_name)
	await novel_interface.show_dialog("Но теперь я стала девочкой…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Примените коррекцию изменений костей. Включите анализ походки на видеозаписи в коридоре прямо сейчас…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru игнорирует мой бормотание и сосредотачивается на своем планшете.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Возможно, это не сон. Но теперь все выглядит просто прекрасно. Ни пожара, ни разрушений.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ухх... Я в полном замешательстве...!", GameConfig.player_name)
	await novel_interface.show_dialog("Какие части моих воспоминаний были реальными, а какие — всего лишь сном…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Характер походки совпадает.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что это значит?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Паттерн походки — это характерный шаблон управления мышцами человека при ходьбе. Даже лучшие агенты не смогут это скрыть.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Хотя современная наука не может этого объяснить…\nВы действительно"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("А... ты уверен...?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Наконец… я думал, вы, ребята, что-то об этом знаете…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Итак, вы слышали о Ross Goblet?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Substance H внезапно исчез под видеонаблюдением, согласно новостям этим утром… Но я еще не видел его лично.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Ну, если ты говоришь правду…", "Mariru")
	await novel_interface.show_dialog("Наверное, это будет единственная причина, по которой я согласлюсь прочитать эту скучную лекцию бесплатно.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Это Substance H найденный на островах Росса. Снаружи установлены четыре драгоценных камня удивительной чистоты.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("После того, как я выбрался из руин, я увидел что-то похожее на сияющий кубок, летящий в небе.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Он плыл по небу, излучая слабый красный свет…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Слабый красный?", "Mariru")
	await novel_interface.show_dialog("(Слабая красная жидкость в кубке была загадкой…)", "Mariru")
	await novel_interface.show_dialog("(Но эта информация засекречена. Она никогда не была обнародована, даже после того, как не так давно ей был присвоен рейтинг «безопасно».)", "Mariru")
	await novel_interface.show_dialog("(Никто не мог бы сообщить такие подробности, не видя этого раньше…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Независимо от того, был ли это сон, боюсь, нам нужно подтвердить с вами дополнительную информацию.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
