# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai confronta il rapporto con i dati che lampeggiano sul monitor, sorridendo di tanto in tanto.")
	await novel_interface.show_text_only("Mariru afferra il rapporto da dietro Ai e lo studia.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Allora, come è andato l'esame fisico? Sembri fin troppo soddisfatto di te stesso.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awww… È semplicemente favoloso!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("L'anima di un ragazzo intrappolata nel corpo di una ragazza... Se le persone dell'Harima Brain Research Institute vengono a sapere di Lian, uccideranno per presentare una richiesta di esperimento e rapirla.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dobbiamo tenerlo per noi, capito?\\nQualche nuova scoperta?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Entrambi i loro telomeri indicano un'età di quindici anni, ma la quantità di cesio-137 nei tessuti molli di Annie è solo un quarto della media odierna.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intelligente... \\nQuindi al massimo ha vissuto solo metà della Guerra dei Sette Anni?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("A meno che non sia stata tenuta in una capsula sigillata per anni dopo la guerra.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Capisco. \\nChe ne dici di Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Per quanto riguarda Lian... il livello rilevato nel suo tessuto muscolare è inferiore a un duecentesimo della media, inferiore persino a quello che i neonati ereditano dalle loro madri.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quindi è un corpo appena sintetizzato?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Ora ecco la parte davvero interessante: il suo corpo trasporta anticorpi contro molti virus estinti da tempo, compreso il vaiolo.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vacci piano. Non c'è nessun virus residuo nel suo midollo spinale.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ho fatto un controllo approssimativo: la storia del sistema immunitario di Lian sembra coprire solo gli ultimi secoli. Non ci sono anticorpi contro alcun virus pre-medievale.", "Ai")
	await novel_interface.show_dialog("Tuttavia, mi piacerebbe richiedere un campione dei suoi globuli bianchi e provare a coltivare i virus n. 008, 217 e 742...", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Questo non è il tuo lavoro come medico scolastico.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Sì, giusto. Capisco. \\nVuoi che li tenga d'occhio, vero?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Potrebbero avere un collegamento con il Ross Goblet scomparso… \\nSospetto che non abbiano raccontato tutta la storia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Perché non semplicemente rinchiuderli e interrogarli?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Hai bisogno di una mano? Guarda, con qualche modifica, gli strumenti che ho usato per il controllo oggi sarebbero perfetti per il lavoro...", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Gli occhi di Ai brillano di eccitazione. Mariru arrotola il rapporto e la schiaffeggia.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Tieni gli occhi e le orecchie aperti. Avvisami se succede qualcosa.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Ora che l'ha già notato, temo che qualcuno all'interno di SID potrebbe averlo...)", "Mariru")
	await novel_interface.show_dialog("(Almeno resterà controllata a scuola) \\n(E nel frattempo potrei tenerla d'occhio...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Non devi dirmelo due volte. Registrerò ogni~ singolo cambiamento nel corpo di Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Faresti meglio a mantenere un profilo basso e rimanere in pista.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Eh eh, rilassati. \\nNon sarebbe divertente se la prosciugassi tutta in una volta.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
