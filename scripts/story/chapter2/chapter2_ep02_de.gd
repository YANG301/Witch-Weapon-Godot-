# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("Achtung, alle Squads, die Phasenschwankungen lassen nach!", "Agent A")
	await novel_interface.show_dialog("Der Feind kann jeden Moment auftauchen!\nHalten Sie Ihre Positionen und bereiten Sie sich auf den Angriff vor!!", "Agent A")
	await novel_interface.show_dialog("... R-Bericht!", "Agent B")
	await novel_interface.show_dialog("Zwei humanoide Einheiten sind in Sichtweite aufgetaucht, direkt in der Kernzone der Anomalie...", "Agent B")
	await novel_interface.show_dialog("Menschen...?\nWie ist das möglich?! Was hat der memetische Scan ergeben?", "Agent A")
	await novel_interface.show_dialog("Der Farbton ist...\nGrün!!", "Agent B")
	await novel_interface.show_dialog("Es scheinen zwei junge Mädchen zu sein...\nHalten Sie die Flamme! Halten Sie Ihr Feuer!", "Agent B")
	await novel_interface.show_dialog("...", "Agent A")
	await novel_interface.show_dialog("Wir haben gerade Befehle erhalten: Priorität eins ist, sie zu sichern und zum Hauptquartier zurückzubringen.\nSchicken Sie einen leitenden Agenten zur Verhandlung –", "Agent A")
	await novel_interface.show_dialog("Alle anderen bleiben wachsam. Wenn die Ziele während der Verhandlungen verdächtige Bewegungen machen, eliminieren Sie sie sofort!!", "Agent A")
	await novel_interface.show_dialog("Verstanden!", "Agent B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Vorsichtig machten wir uns auf den Weg zum Ausgang des Forschungszentrums.")
	await novel_interface.show_text_only("Was uns dort neben der vertrauten Straße erwartete, war eine Reihe von Absperrbändern und eine Reihe bewaffneter Menschen, die dahinter standen und auf uns warteten.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Warum sind plötzlich so viele Leute aufgetaucht?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah-Annie!\nBeeil dich und zieh mich wieder um!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Diese Klamotten sind viel zu peinlich...\nIch möchte wirklich nicht, dass mich jemand so sieht...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Ist das wirklich das, worüber Sie sich im Moment Sorgen machen?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Deine Kleidung ist bei mir gut aufgehoben, also mach dir keine Sorgen...", "Annie")
	await novel_interface.show_dialog("Wenn du dich wirklich umziehen willst, zieh einfach das „Kampfoutfit“, das du gerade trägst, aus und zieh deine übliche weite Kleidung wieder an~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Aber da vorne sind viele Männer...\nWillst du dich wirklich direkt vor ihnen verändern?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh...\nAber ich bin ein Kerl...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Wenn ich darüber nachdenke... Du hast früher Männerkleidung getragen!\nKönnte es sein-", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä? Du warst auch schon einmal in einer solchen Situation??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Das macht Sinn... Annie ist wahrscheinlich auch kein gewöhnlicher Mensch, oder?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Wenn es Annie ist, kann sie vielleicht verstehen, was ich durchmache...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm, ich verstehe...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Du bist der Typ, der sich heimlich die Kleidung eines Jungen ausleiht, den er mag, und sie selbst trägt, oder?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist überhaupt nicht „verstanden“!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm~ Also eigentlich,"+GameConfig.player_name+"Ist das die Art von Person, die sich vom Duft des anderen Geschlechts fesseln lässt, nicht wahr? Kein Grund, sich zu schämen...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mach dieses Gesicht nicht so, als würdest du sagen: „Du bist vielleicht ein Perverser, aber ich akzeptiere dich trotzdem“!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Seufz... Ich habe immer noch absolut keine Ahnung, warum ich so geworden bin...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Halten Sie genau dort an!\nLegen Sie Ihre Hände dorthin, wo ich sie sehen kann!", "SID Agent")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Eine Person in einem schwarzen Anzug trat vor und schrie uns an.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Huh...?\nDenken sie, dass wir die Bösen sind?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Moment, dieses Abzeichen auf der Brust des Anführers...)\n(Ein perfekt runder, ringförmiger Schild – sagen Sie mir nicht, dass das...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Sie beide, ich bin ein SID Agent.\nBehalten Sie zu Ihrer eigenen Sicherheit diese Pose bei und bewegen Sie sich nicht.", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("Genau wie ich dachte, sie sind bei SID!\nWir sind jetzt am Arsch!!!")
	await novel_interface.show_text_only("In einem Augenblick füllten sich meine Gedanken mit Nachrichten über SID, die Schwärme von Agenten entsandten, um Spione zu fangen.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Und dann gab es urbane Legenden über „geheime Gefängnisse“, „Mordaktionen“ und dergleichen...")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Bericht aus der Kernquarantänezone: Die beiden Ziele haben keine feindselige Absicht gezeigt.\nBedrohungsstufe vorläufig auf D+ eingestellt.", "SID Agent")
	await novel_interface.show_dialog("Beginnen wir mit ein paar einfachen Fragen...\nWer bist du und was schleichst du hier herum?", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ich bin ein Student aus dieser Stadt...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wir sind gerade auf einer Exkursion hierher gekommen, um das Forschungsinstitut zu besichtigen...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Agent in Schwarz warf uns einen verächtlichen Blick zu.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Ist das so – eine Tour? Vom Institut?", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("Oh nein...\nPlötzlich fiel mir ein –")
	await novel_interface.show_text_only("Wegen des Verschwindens des „Roskin Cups“ war das Institut seit gestern Abend unter Notstandssperre.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("In einer Zeit wie dieser dreist daraus hervorzugehen und zu behaupten, wir wären nur zu Besuch..., das war im Grunde ein Geständnis.")
	await novel_interface.show_text_only("Wie erwartet schien sie über ihren Ohrhörer eine Art Anweisung zu erhalten und starrte mich mit einem strengen Blick an.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("Ich habe Befehle von meinem Vorgesetzten erhalten. Ihr beide werdet mitkommen.", "SID Agent")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Innerhalb weniger Sekunden waren wir beide vollständig umzingelt.")
	await novel_interface.show_text_only("Wohin ich auch blickte, eine Wand aus Gewehrläufen war direkt auf uns gerichtet.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", diese Leute sehen wirklich schlecht aus....\nWarum warten wir nicht auf eine Chance und rennen danach?", "Annie")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("Bitte seien Sie versichert, wir werden Ihnen keinen Schaden zufügen.\nSolange Sie bei den Ermittlungen kooperieren, kann dies alles friedlich gelöst werden.", "SID Agent")
	await novel_interface.show_dialog("Sie sollten verstehen, dass das Verschwinden eines „anomalen Objekts“ keine triviale Angelegenheit ist. Es könnte Ereignisse auslösen, die weit über den gesunden Menschenverstand hinausgehen, also kooperieren Sie bitte.", "SID Agent")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(Ereignisse jenseits des gesunden Menschenverstandes...?)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Okay, ich verstehe. Ich werde mit dir gehen.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Hä?? Warum gehst du einfach mit?!\nHey!"+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-hör auf zu ziehen! Mein blöder Rock wird sich lösen!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Du bist der Idiot! Warum solltest du mit Leuten umgehen, die so misstrauisch sind? Was, wenn sie dich unter Drogen setzen und irgendwo verkaufen?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was würde sich irgendjemand von einem erwachsenen Kerl wie mir wünschen?...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Warten Sie, nein – wer würde eine Menschenhandelsoperation inszenieren, wenn so viele Leute eine solche Szene machen?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+", Sie haben die Banden auf den Lebona-Inseln offensichtlich noch nie gesehen...", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wie dem auch sei... Vielleicht lernen wir endlich etwas.\nLass uns erst einmal mit ihr gehen...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Gut. Wohin du auch gehst, ich werde auch gehen...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Könnte ich, wenn möglich, zuerst einen Mantel besorgen?", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Dieses Outfit ist wirklich ein bisschen...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Als ich wie ein Mädchen gekleidet von allen beobachtet wurde, fühlte ich mich am ganzen Körper unwohl.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Okay, ich werde eine Anfrage stellen.", "SID Agent")
	await novel_interface.show_dialog("...", "SID Agent")
	await novel_interface.show_dialog("...Entschuldigung, mein Vorgesetzter sagte: „Das Outfit ist sehr süß“ und lehnte die Anfrage rundweg ab.", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Was für ein Vorgesetzter sagt so etwas überhaupt?!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
