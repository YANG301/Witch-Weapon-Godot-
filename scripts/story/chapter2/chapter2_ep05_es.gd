# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Desde esta mañana, hemos detectado repentinamente múltiples alertas de fluctuación de fase del espacio-tiempo en New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Es como si algo despertara de la noche a la mañana...", "Mariru")
	await novel_interface.show_dialog("Los satélites de vigilancia muestran que usted desapareció en el aire dentro de la zona de anomalía y luego reapareció en el otro lado poco después, con alguien más a su lado.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru vuelve su mirada hacia Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Y justo donde aparecieron ustedes dos, esa fluctuación desapareció por sí sola.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("¿La zona de anomalía? ¿Te refieres al Centro de Investigación?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exacto.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("¿Podría haber sido algún tipo de mal funcionamiento del equipo...? Estuve en la carretera principal todo el tiempo.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("La expresión de Mariru se vuelve seria.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Crees que cualquiera puede entrar y salir de una zona de fluctuación de fase del espacio-tiempo?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Esa cosa de fluctuación... ¿es realmente tan peligrosa?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Realmente no sabes nada, ¿verdad...", "Mariru")
	await novel_interface.show_dialog("La fase del espacio-tiempo es la base de la ley física, como el sistema de coordenadas del universo. No importa cómo se muevan las partículas, los propios ejes deben permanecer estables.", "Mariru")
	await novel_interface.show_dialog("Si esos ejes empiezan a temblar, aunque sea por el más mínimo margen, el orden de las partículas dentro de ese espacio queda devastado.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Si tan solo el 5% de las partículas de un edificio se desplazaran aleatoriamente un micrómetro, la estructura del material quedaría completamente destruida y todo se derrumbaría instantáneamente.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Y aún así estás perfectamente bien y los edificios en esa área no muestran ningún daño estructural.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Y según nuestra investigación sobre Toques Divinos, un humano que lleve \"FANTASMA\" ni siquiera debería poder entrar en un espacio como ese).", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("En otras palabras, básicamente entraste en el ojo de un huracán de categoría 12 que podría destrozarlo todo, saliste ileso y de alguna manera calmó la tormenta.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Entonces, ¿esas anomalías fueron causadas por las cosas que me atacaron? \n Parecían haber perdido la cabeza ...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Detente ahí mismo! Estoy a punto de informarle al Senado—", "Mariru")
	await novel_interface.show_dialog("A uno de esos lunáticos le gusta realizar análisis de detección de mentiras en vivo en la transmisión de la conferencia, así que cuanto menos sepa ahora, mejor.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Esa es... una forma muy distintiva de describir a los senadores...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y una chica también debería saber cuándo está bien mentir~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("¡¡No soy una niña!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("De todos modos, está bien, no diré nada...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("En los últimos años, solo se han registrado cuatro casos de este tipo de fluctuación espacio-temporal en todo el mundo.\nLa mayoría de ellos estaban relacionados con fallas de contención que involucraban Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Cuando un Toque Divino desconocido se activa repentinamente, las consecuencias pueden ser catastróficas.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...¿La gente saldrá lastimada?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("En el peor de los casos, sólo el número de muertos alcanzó las decenas de miles.", "Mariru")
	await novel_interface.show_dialog("Pero las principales Ciudades Academia siempre han tenido un acuerdo tácito de reportar esos incidentes como \"accidentes comunes\"...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Fugas de gas, accidentes aéreos, ataques terroristas, ese tipo de cosas...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Entonces esta vez...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esta vez es diferente. Nunca antes habíamos visto brotes continuos a esta escala...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ya está más allá del nivel más alto de nuestros escenarios propagandísticos. Cuando llegue el momento, ni siquiera podremos inventar una mentira.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("¿Podría ser por mi culpa?\nSi hay algo que pueda hacer para ayudar...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No lo pienses demasiado. Es posible que sus cambios físicos estén relacionados, pero usted solo no podría haber causado una perturbación tan grande.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Si quieres buscar pistas, puedes ir a echar un vistazo a la escena con mi gente.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Si esa posibilidad es real, entonces ahora mismo ella es la única respuesta que tenemos...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Pero no debes esforzarte en absoluto y no debes contarle a nadie sobre ti. ¿Comprendido?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("No decírselo a nadie... entonces, ¿eso significa que...\ntengo que fingir que siempre fui una niña?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esto ya lo sabes, ¿no?...?\nNew Opulentia siempre ha regido bajo la doctrina de la ciencia por encima de todo.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Si haces pública tu experiencia, serás clasificado como \"sujeto experimental\" y trasladado a una institución de investigación~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Entonces probablemente tendrías toda una fila de hombres de mediana edad que han jurado sus vidas a la ciencia esperando para estudiar tu cuerpo...", "Mariru")
	await novel_interface.show_dialog("Después de todo, no todos los días tienen una chica tan linda...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("... ¡¡O-está bien, lo entiendo!!", GameConfig.player_name)
	await novel_interface.show_dialog("Yo... ¡¡Absolutamente no diré nada imprudente!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
