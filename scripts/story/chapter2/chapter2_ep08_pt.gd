# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie já foi acomodado na próxima sala. Há algumas coisas que preciso contar a você sozinho.", "Mariru")
	await novel_interface.show_dialog("Acabei de receber a confirmação.", "Mariru")
	await novel_interface.show_dialog("Desde esta manhã, anomalias de espaço-tempo em grande escala apareceram em várias grandes cidades...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("As regiões afetadas que conhecemos até agora incluem o Palácio Hovering, Newmoridas, Forte Masada, Salmonton, New Opulentia e as Ilhas Lebona.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Então isso não significa...\ntodas as seis cidades acadêmicas...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Isso mesmo. O mundo inteiro está a observar isto agora, e a escala do impacto excedeu em muito as expectativas.", "Mariru")
	await novel_interface.show_dialog("Eu acho que... pode haver uma possibilidade...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Tudo o que você descreveu em seu sonho – os terroristas atacando o centro de pesquisa, a cidade reduzida a ruínas...", "Mariru")
	await novel_interface.show_dialog("...tudo isso pode ter realmente acontecido.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("C-Como isso é possível?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Não tenho provas conclusivas, mas uma enorme distorção dimensional pode já ter ocorrido esta manhã.", "Mariru")
	await novel_interface.show_dialog("O satélite True Sight de SID também detectou uma explosão de ruído anormalmente violenta.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Talvez isso facilite o entendimento: New Opulentia realmente foi destruído uma vez, mas algum tipo de força reverteu essa realidade...", "Mariru")
	await novel_interface.show_dialog("E essa força também parece estar ligada às mudanças em seu corpo, bem como aos ataques daqueles estranhos inimigos.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Claro, essa ainda é apenas minha hipótese.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Essa ideia... não é um pouco ousada demais...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Por causa dos acontecimentos de hoje, as outras cinco Cidades Acadêmicas estão pressionando o Senado para permitir a entrada para investigação.", "Mariru")
	await novel_interface.show_dialog("E se sua conexão com este incidente for exposta, ser levado por uma instituição de pesquisa será o menor dos seus problemas...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Agentes de todas as organizações de inteligência marcariam você como um alvo principal.", "Mariru")
	await novel_interface.show_dialog("Sem contar os que já estavam disfarçados, mais de uma centena de agentes de inteligência de vários países entraram hoje New Opulentia apenas sob identidades falsas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Você sabe tudo isso com tantos detalhes?\nPor que você não os impede?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmph. Melhor manter a situação sob controle no escuro do que forçá-los a mudar de rosto e desaparecer de vista.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", você precisa entender isso: enquanto você ainda tiver o corpo de uma menina, você nunca poderá voltar à sua antiga vida.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Ainda assim, o fato de nós da SID termos encontrado você primeiro pode ser um golpe de sorte.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tornar-me uma garota da noite para o dia...\nComo vou explicar isso para meus colegas e amigos...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... você não está preocupado com seus pais?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Minha mãe morreu quando eu era pequena.\nMeu pai... já está desaparecido há muitos anos...", GameConfig.player_name)
	await novel_interface.show_dialog("Morei em um internato até os doze anos.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Então, o programa de cuidados infantis do gorila no pós-guerra realmente ajudou algumas crianças, afinal.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, você já passou por muitas dificuldades.\nAinda assim, você não precisa se preocupar com a questão da transição de identidade.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Transição de identidade...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Um sorriso bastante ameaçador aparece no rosto de Mariru...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
