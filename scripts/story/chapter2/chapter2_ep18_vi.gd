# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Đó là một buổi chiều hè oi bức. Tôi ném một chồng giấy tờ cạnh chiếc bàn tròn trong sân rồi ngồi xuống chiếc ghế dưới bóng cây.")
	await novel_interface.show_text_only("Cách đây không lâu, tôi thấy một cô gái xinh đẹp đang vật lộn với đống sách của mình. Tôi không hề suy nghĩ mà giúp cô ấy một tay.")
	await novel_interface.show_text_only("Sau đó cô ấy chỉ vội vã rời đi, mặc dù rất may. Đó là lúc tôi nhận ra mình là một thằng ngốc.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Phù... Để tôi nghỉ ở đây... Nóng quá.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Than ôi, đó chỉ là một miếng bánh đối với tôi khi tôi còn là một cậu bé.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Và sau đó sắp có khóa đào tạo SID này... Chúa ơi, tôi có thể trốn ở đâu đó được không?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, hãy cẩn thận với cách cư xử của bạn... \\nĐây là một trường học.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Này, Annie! \\nCó chuyện gì thế?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Nghe này... Tôi biết trời nóng lắm. \\nNhưng... có nhất thiết phải vén áo lên lau mồ hôi không?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ý tôi là… Hãy cẩn thận với sự cố tủ quần áo…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Chết tiệt!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Cô gái Lian đó thật thô lỗ...", "Sinh viên A")
	await novel_interface.show_dialog("Ừ, hôm nọ tôi thấy cô ấy dang rộng chân, mặc váy.", "Sinh viên B")
	await novel_interface.show_dialog("Thật sao? Ối…", "Sinh viên A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(Lẽ ra ngay từ đầu tôi đã không nên mặc váy, được chứ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Này…")
	await novel_interface.show_text_only("Thật là một giọng nói dịu dàng.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Hãy dùng khăn tay của tôi nếu bạn không phiền.", "Cô gái thanh lịch")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trước mặt tôi là một cô gái xinh đẹp và thanh lịch. \\nCô ấy có mái tóc dài màu tím và đôi mắt màu hoa cà.")
	await novel_interface.show_text_only("Cô ấy đưa cho tôi một chiếc khăn tay có mùi thơm tinh tế và tươi mát.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ơ?! \\nCảm ơn… Cảm ơn bạn.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Các bạn là học sinh chuyển trường năm nhất phải không? \\nTên tôi là Nix Strozzi. Tôi là cấp trên của bạn.", "Nix")
	await novel_interface.show_dialog("Tôi thấy bạn đổ mồ hôi và tình cờ tôi có mang theo chiếc khăn tay nên... \\nTôi hy vọng tôi không làm phiền.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix gật đầu với tôi một cách lịch sự, nhưng tôi lại bối rối. Tôi đứng dậy chào một cách khá ngớ ngẩn.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Không... hoàn toàn không! \\nThật là một sự trợ giúp tuyệt vời!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Cô ấy có vẻ rất đáng yêu.) \\n(Cô ấy là người nước ngoài à? Hãy nhìn đôi lông mi dài đó...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn khuôn mặt thanh tú của Nix, tim tôi đập thình thịch.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Niềm vui của tôi. \\nVậy... tên bạn là...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Tôi là Lian. Cô ấy là Annie. \\nGần đây chúng tôi mới chuyển đến đây.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix có vẻ bối rối và nhìn chằm chằm vào Annie, mặc dù chỉ trong chốc lát.")
	await novel_interface.show_text_only("Sau đó cô ấy mỉm cười với Annie một cách thân thiện. Tôi tự hỏi liệu vừa rồi đó có phải chỉ là ảo giác của tôi không.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Rất vui được gặp bạn hôm nay.", "Nix")
	await novel_interface.show_dialog("Nhưng tôi cần phải đi bây giờ. Hãy cho tôi biết nếu tôi có thể làm gì để giúp đỡ.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Cảm ơn, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie do dự mà không có phản hồi.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cô gái này, Nix... cô ấy trông sang trọng hơn bất kỳ cô gái thìa bạc nào trong số này.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, bạn ổn chứ? \\nBạn đã im lặng.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Cô ấy có nói cô ấy là Strozzi không?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh, bạn biết cô ấy à?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie nắm lấy tay tôi và nở một nụ cười hồn nhiên.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Không. \\nChúng tôi mới ở đây. Làm sao tôi có thể biết cô ấy?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Vâng, bạn nói đúng.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
