# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Eliminamos o chefe após uma batalha feroz, e os outros inimigos desapareceram em uma nuvem de névoa vermelha.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Uau... \\nEspere, o que é isso?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Algumas páginas amareladas caem na minha frente. Nas páginas há uma mistura de texto e padrões, pouco legíveis.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("C... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("O quê? \\nOh... Estou tonto...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esfrego os olhos e tento ler as palavras novamente. A única coisa que tenho certeza é que estão escritos em inglês.")
	await novel_interface.show_text_only("Embora algumas letras sejam legíveis,")
	await novel_interface.show_text_only("Tudo o que posso sentir é um caos completo sempre que tento juntá-los.")
	await novel_interface.show_text_only("Parece um distúrbio de leitura. Não consigo identificar nem a palavra mais fácil sobre isso.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Guarde-os por enquanto. Temos uma vida para salvar.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Certo. Entendi!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("No momento em que os guardei, acho que vi um talismã piscando no papel, mas ele desapareceu muito rapidamente.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Isso é...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Eh?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Essa é minha ilusão? \\n(Sinto um tremor indescritível. O que é isso...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("O leve formigamento no meu braço me lembra que isso não é uma ilusão.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ei, você está bem?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eu olho para a garota ferida. Ela ainda parece fria. \\nNão estou feliz ou grato pelo que Annie e eu fizemos por ela.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A julgar pela sua aparência e roupa, ela não é apenas uma garota da casa ao lado...")
	await novel_interface.show_text_only("O tapa-olho é bastante estranho. Mas olhe para as mãos dela sob o vestido… Elas estão envoltas em uma armadura mecânica.")
	await novel_interface.show_text_only("Ela tem um ferimento grave na barriga... Até um adulto vai desmaiar.")
	await novel_interface.show_text_only("Mas ela está sentada lá tão quieta, sem dizer uma palavra.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ei, qual é o seu nome? \\nO que você está fazendo por aqui?", "Lian")
	await novel_interface.show_dialog("Você conhece esses caras?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Tudo bem... talvez sejam muitas perguntas para ela...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A menina se levanta de repente, ainda sangrando. Ela é realmente mais alta do que eu pensava...")
	await novel_interface.show_text_only("Oh meu Deus! \\nO corpo dela... está flutuando acima do chão?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nMissão: Eliminar, bruxas.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A menina responde às perguntas de uma forma muito estranha.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... Esse é o nome dela? \\nEla fala em um tom muito estranho.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Alvo, identificando... \\nHumano. Fêmea. Quantidade...", "Elluka")
	await novel_interface.show_dialog("Um.", "Elluka")
	await novel_interface.show_dialog("... \\nReidentificando, ativado.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(“Uma” mulher?) \\n(Ela me identificou como homem agora há pouco?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Sim, está certo! Eu sou um menino!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bruxa, quantidade, um. \\nModo de defesa ativado.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Bahahaha... \nFinalmente! Ultimamente tenho tido a sensação de que algum estranho descobrirá minha verdadeira identidade.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Uh... por que as mãos dela estão brilhando, cada vez mais brilhantes? \\nUau... Espere aí, espere um minuto!")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Aaah! \\nAi! Ai! Ai!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("Por que você está mexendo comigo?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Isso foi perto. Graças à minha resposta rápida, aquele raio tocou levemente meu braço e deixou uma queimadura esbranquiçada no chão.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Baixas habilidades de combate. Fuga rápida. \\n... Nenhuma ameaça.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bem... parece que acabei de ser identificado como uma galinha…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Por que você me atacou sozinho? \\nEu ajudei você.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Não é páreo para uma bruxa.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso é honesto!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Pequeno Elluka, olha, temos sido tão legais. \\nEntão definitivamente não somos pessoas más.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Sussurro) Annie, isso não é nada convincente. E parece que somos sequestradores.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bem…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... Então, Elluka, você também é uma bruxa?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie me ignora e pergunta diretamente a Elluka.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("Ei, espere! Talvez Elluka nem saiba o que é uma Bruxa.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Carrasco.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Carrasco... Bem... Por que as crianças de hoje em dia amam tanto apelidos tão estúpidos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Droga, acabei de dizer isso em voz alta...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Outro relâmpago atinge e eu me esquivo bem a tempo novamente.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ei, garoto! \\nPodemos apenas conversar?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aqui... chocolate. Pare de ficar bravo, ok?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Pego uma barra de chocolate do bolso, quebro ao meio e divido com Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Ufa... Sorte que tenho chocolate comigo. \\nAfinal, nenhuma criança odeia chocolate.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yum...yum... \\nVeja, eu comi tudo.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Chocolate?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não é perigoso... \\nÉ um lanche que traz felicidade!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(Sussurrando) Lian, quem oferece comida para menininhas pode parecer mais um sequestrador.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("E você está agindo como uma menina agora, levando chocolates junto. Bom trabalho!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka hesita por um momento antes de abrir a embalagem e lentamente colocar um pedaço na boca.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nEstranho, sabor...", "Elluka")
	await novel_interface.show_dialog("Amargo.", "Elluka")
	await novel_interface.show_dialog("Doce...", "Elluka")
	await novel_interface.show_dialog("Elluka, não odeia.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Haha, você gostou?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ooh... ela parece tão fofa...!")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Mwahaha...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ops! Lian parece tão perigoso.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Expressão facial, identificando... Hentai.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hentai...?! \\nVocê quer dizer eu?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Mas, Elluka, não odeia.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha... então tudo bem.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("Você parece feliz por ser rotulado como Hentai. \\nVocê é muito estranho...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Não, não estou. Você poderia parar de me interpretar mal?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Ah! \\nTenho outra peça. Você pode ficar com isso.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Aqui!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pesca, tira um recipiente transparente do tamanho de uma bateria AA e me dá. Nele há um fluido verde, espesso e fluorescente.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Isso é ... fluido elétrico?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Troca, comida.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("É isso que você chama de comida?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka acena com a cabeça seriamente.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Quando estou com fome, o administrador me dá comida. \\nPara reabastecer, energia.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O administrador, seu guardião?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Já que você pode comer chocolate, seu corpo deve funcionar como uma criança normal, certo?", "Lian")
	await novel_interface.show_dialog("Você não é um eletrodoméstico...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sem dúvida, esta garota pode sentir a existência de inscrições mágicas.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mas como ela é alimentada… é muito especial.", "Annie")
	await novel_interface.show_dialog("Ela é... uma Carrasca?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
