# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Después de terminar toda una serie de procedimientos de registro para la formación de cadetes SID, me entregaron una gran pila de \"libros de texto\".")
	await novel_interface.show_text_only("Luego, bajo la guía de un miembro del personal, tomé un pequeño y discreto ascensor desde la SID sede.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("El ascensor subió lo suficientemente rápido como para que pudiera sentir claramente la presión aumentando en mis oídos.\nCuando llegué a la superficie, me di cuenta de que ya era de noche...")
	await novel_interface.show_text_only("El ascensor daba al vestíbulo de un pequeño edificio de oficinas y, justo afuera, se encontraba el concurrido distrito comercial.")
	await novel_interface.show_text_only("Escuché que el ascensor solo puede descender a niveles más profundos cuando reconoce que cada pasajero es personal autorizado. De lo contrario, sólo viaja entre el primer y tercer piso del edificio de oficinas.") #换行问题
	await novel_interface.show_text_only("En el segundo piso del edificio había una cafetería abierta las 24 horas con gente yendo y viniendo todo el día, perfecta para esconderse a plena vista.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Suspiro...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Pensé que el entrenamiento de agentes involucraría cosas como combate cuerpo a cuerpo y disparos, pero esto se siente más como si me hubiera inscrito en un paquete completo de escuela intensiva...", "Lian")
	await novel_interface.show_dialog("¡Estos libros pesan mucho!\nMenos mal que el lugar Mariru arreglado para mí no está lejos de aquí.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Academy District East Road No. 6... Ella dijo que era muy discreto—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("—¡¿Cómo es esto tan discreto?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estaba parado dentro de una residencia de lujo en el último piso de un rascacielos. La lujosa sala de estar conectada a una terraza gigante con vista a la vista nocturna del distrito comercial.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("¿Esas llamas a lo largo de la pared son una chimenea real?\nEsto es demasiado exagerado...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Justo cuando miraba cautelosamente a mi alrededor y me preguntaba si había entrado en la habitación equivocada, recibí un mensaje de Mariru.")
	await novel_interface.show_text_only("Mariru: Elige el dormitorio que quieras.\nNo hay necesidad de ser educado con el presupuesto del Senado~") #原文有个♥
	await novel_interface.show_text_only("Esa mujer... ¡¡Discúlpate con los contribuyentes de New Opulentia ahora mismo!!")
	await novel_interface.show_dialog("Lian, ¡has vuelto!", "Annie")
	await novel_interface.show_text_only("Annie salió del baño, recogiéndose el cabello con una mano mientras caminaba.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! ¿Tú también estás aquí?\nMariru dijiste que acababas de ir a recibir un entrenamiento especial...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Terminé el entrenamiento antes de lo previsto. Me acabo de duchar y me probé el uniforme escolar.\nParece que vamos a ser compañeros de cuarto~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Derecha...\n(Parece que Mariru mencionó eso...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(¿Es esto algún tipo de prueba del cielo?)\n(Viviendo bajo el mismo techo que una niña y todo...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("¿Ese es el uniforme de esta escuela? Es muy lindo ~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Mm-hm~ La ropa que te prepararon está en esa caja de allí. ¡Tú también deberías probártelos!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("¿T-yo también tengo que usar uno...?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jeje, Lian, ¿todavía no te acostumbras a ser niña?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tan pronto como mencionó eso, no pude evitar rascarme la cabeza y desplomarme en el sofá.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("¿Cómo podría alguien acostumbrarse a algo como esto...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Nadie podría entender cómo se siente esto.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Lo entiendo.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie de repente se sentó a mi lado y acarició ligeramente mi mejilla con la punta de su dedo, como para consolarme.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Porque somos iguales.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Había una leve amargura en su sonrisa.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¡¿Q-Qué—?!\n¡¿Tú también eras un niño?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("¡Jajajajaja! Lian, ¿eres idiota?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Siempre he sido una niña ~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agh...\n(¡¡Eso es mortificante!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Justo cuando mi vergüenza estaba a punto de alcanzar su punto máximo, Annie dejó de reír y me miró suavemente.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("Pero el pánico en tu corazón en este momento... Realmente lo entiendo completamente.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("Yo también estuve atrapado en otro espacio-tiempo antes...\nEse sentimiento probablemente era un poco parecido a lo que estás pasando ahora.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Otro... espacio-tiempo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie hizo una pausa, como si estuviera pensando cuidadosamente en cómo expresarlo.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("¿No te lo dijo la señorita Mariru?\nPasé mucho tiempo a la deriva en otro espacio-tiempo sin entender realmente nada...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("El tiempo parecía vago allí. No me pareció mucho tiempo, pero cuando regresé me di cuenta de que ya habían pasado siete años.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mm, escuché un poquito sobre eso...", "Lian")
	await novel_interface.show_dialog("(Aunque eso fue solo por unas pocas pistas dispersas Mariru caídas...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Qué le pasó exactamente?\n¿Debería preguntarle directamente?")
	await novel_interface.show_text_only("Annie no continuó. Ella simplemente bajó la cabeza y jugó distraídamente con los dedos.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... ¿Alguna vez tú también te sientes así?", "Annie")
	await novel_interface.show_dialog("Como si todo esto pudiera ser sólo un sueño, y la próxima vez que abras los ojos, finalmente despertarás.", "Annie")
	await novel_interface.show_dialog("No es así como se suponía que debían ser las cosas. Se supone que no deberías estar aquí...\nPero no importa lo que hagas, no podrás volver a la normalidad.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(¿Entonces Annie llegó hasta aquí cargando sentimientos como ese ella sola...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me acerqué un poco más a Annie y le di una suave palmadita en el hombro.\nUh, consolar a una chica como esta... debería estar bien, ¿verdad?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("No tengas miedo. Has vuelto ahora, ¿no?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Mm...\nPero todo todavía me resulta tan desconocido...", "Annie")
	await novel_interface.show_dialog("Ni siquiera tengo la más mínima idea de lo que todos ustedes quieren decir con \"ciudad academia\".", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... Correcto. La guerra ni siquiera había terminado cuando Annie desapareció.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Entonces eso significa que todavía no sabes lo que pasó en estos últimos años, ¿verdad?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Solo busqué cosas de forma aproximada... Han pasado tantas cosas a lo largo de los años que ya ni siquiera entiendo lo que se supone que significan muchas de las palabras en las noticias.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hace siete años...\nEso fue justo en medio de la guerra que sumió al mundo entero en el caos.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("¿Eh? ¿La guerra?\n¿Te refieres a la campaña militar que el Fuerte Masada lanzó contra Europa?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie se esforzó por recordar.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, ese no. Poco después, casi todos los países se vieron arrastrados a ello.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("En aquel entonces yo estaba en la escuela primaria en un internado. Todos los días las noticias estaban llenas de informes de guerra y recuentos de víctimas. Fue una época bastante horrible...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, ¿tú también viviste la guerra?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No exactamente. Gracias a la protección de Aegis, New Opulentia estaba centrando todos sus esfuerzos en la reconstrucción junto a las ruinas en aquel entonces.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Miré el próspero paisaje nocturno de la ciudad más allá de la ventana... Cuando era pequeño, la ciudad estaba llena de grúas gigantes y maquinaria de construcción ocupada por todas partes.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Entonces, la mayor parte de lo que sé proviene de los libros de texto.", "Lian")
	await novel_interface.show_dialog("Debido a la guerra, la tecnología milagrosa avanzó rápidamente...\nY por \"milagro\" me refiero a fenómenos causados por Substance H.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Después de la guerra, los seis países que habían dominado las tecnologías clave establecieron cada uno una de las seis ciudades academia del mundo.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Se siente como si de repente hubiera despertado un talento oculto por ser profesor de historia...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Así que realmente sucedieron muchas cosas... Ni siquiera puedo imaginarlo.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bueno, cuando Annie se fue—uh, desapareció—el mundo todavía era comparativamente pacífico, ¿verdad...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Así es. ¡En aquel entonces todavía podía competir en juegos internacionales de béisbol!", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("En el momento en que Annie mencionó el béisbol, sus ojos comenzaron a brillar.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ya sabes, Lian, cada vez que era mi turno al bate, ¡todos los ojos de los espectadores se centraban solo en mí!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¡Esa mezcla de tensión y tener que darlo todo haría que me hirviera la sangre en todo el cuerpo!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando surgió el tema del béisbol, de repente pensé en el monumento de piedra negra afuera del Estadio de Béisbol de Lebona, con los nombres de decenas de miles de muertos grabados.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("En realidad...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("¿Mmm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Quizás, después de todo, perderte los peores años de la guerra fue algo bueno para ti.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Cuando lo pienso de esa manera, ¿tal vez convertirme en una chica y conocerte\ntampoco fue algo del todo malo... en cierto sentido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie se congeló. Por un momento, casi pareció avergonzada...\n¿O me lo estaba imaginando?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... De hecho, he querido agradecerte todo este tiempo.\nPorque... fuiste tú quien me salvó de vagar por ese mundo.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("¿Eh? Pero no hice nada...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es exactamente por eso que debes ser especial~", "Annie")
	await novel_interface.show_dialog("Todavía no sé cómo lo hiciste, pero en ese momento pude sentir tu cálida mano tirando de mí.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie tomó suavemente mi mano y se hundió en sus recuerdos.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si no hubiera sido por ti, no sé cuánto tiempo más me habría quedado atrapada allí, ni en qué me habría convertido al final...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("¿Convertirse en ... qué?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jajaja~ No es nada. Todo eso ya es cosa del pasado.\nDe repente siento un poco de sueño~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie parecía querer evadir el tema.\nSe estiró perezosamente, todavía con una sonrisa.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("¿Cuánto tiempo planean ustedes dos continuar con esta charla nocturna de chicas?", "Mariru")
	await novel_interface.show_text_only("La voz de Mariru de repente salió del altavoz en la esquina de la habitación.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("M-Mariru?!\n¿Estabas escuchando hace un momento?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("¿Qué? ¿Hay algo de malo en que un tutor vigile el horario de un par de niños?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Realmente tienes el descaro de decir eso...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("¿También responderte?\nParece que mañana tendré que entrenarte más duro...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("¡Lo siento! ¡¡Me daré un baño y me iré directamente a la cama!\n¡¡Buenas noches!!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
