# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Abbiamo eliminato il boss dopo una feroce battaglia e gli altri nemici sono svaniti in uno sbuffo di nebbia rossa.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Whoa... \\nAspetta, cos'è questo?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mi cadono davanti un paio di pagine ingiallite. Sulle pagine c'è un mix di testo e motivi, appena illeggibili.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Cosa? \\nOh... Ho le vertigini...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi stropiccio gli occhi e provo a leggere di nuovo le parole. L’unica cosa di cui sono sicuro è che sono scritti in inglese.")
	await novel_interface.show_text_only("Sebbene alcune lettere siano leggibili,")
	await novel_interface.show_text_only("Tutto quello che riesco a sentire è il caos completo ogni volta che provo a metterli insieme.")
	await novel_interface.show_text_only("Sembra un disturbo della lettura. Non riesco a identificare nemmeno la parola più semplice al riguardo.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Mettili via per ora. Abbiamo una vita da salvare.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Giusto. Fatto!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nel momento in cui li ho messi via, credo di aver visto un talismano lampeggiare sulla carta, ma è scomparso molto rapidamente.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Questo è...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Eh?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("È questa la mia illusione? \\n(Sento un fremito indescrivibile. Cos'è...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Il leggero formicolio sul braccio mi ricorda che non è un'illusione.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ehi, stai bene?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Guardo la ragazza ferita. Sembra ancora fredda. \\nNon felice o grato per quello che io e Annie abbiamo fatto per lei.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A giudicare dal suo aspetto e dal suo abbigliamento, non è solo una ragazza della porta accanto...")
	await novel_interface.show_text_only("La benda sull'occhio è già abbastanza strana. Ma guarda le sue mani sotto l'abito... Sono avvolte in un'armatura meccanica.")
	await novel_interface.show_text_only("Ha una grave ferita sulla pancia... Anche un adulto crollerà.")
	await novel_interface.show_text_only("Ma lei è rimasta seduta lì in silenzio, senza una parola.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Ehi, come ti chiami? \\nCosa fai da queste parti?", "Lian")
	await novel_interface.show_dialog("Conosci quei ragazzi?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Va bene... forse sono troppe domande per lei...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La bambina si alza improvvisamente, ancora sanguinante. In realtà è più alta di quanto pensassi...")
	await novel_interface.show_text_only("Oh mio Dio! \\nIl suo corpo... fluttua sopra il terreno?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nMissione: eliminare le streghe.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza risponde alle domande in un modo molto strano.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... È questo il suo nome? \\nParla con un tono molto strano.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bersaglio, identificazione... \\nUmano. Femmina. Importo...", "Elluka")
	await novel_interface.show_dialog("Uno.", "Elluka")
	await novel_interface.show_dialog("... \\nRe-identificazione, attivato.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(\"Una\" femmina?) \\n(Mi ha identificato come maschio proprio ora?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Sì, è vero! Sono un ragazzo!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Strega, importo, uno. \\nModalità difesa, attivata.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Bahahaha... \nFinalmente! Ultimamente ho la sensazione che qualche estraneo scoprirà la mia vera identità.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Uh... perché le sue mani brillano, sono sempre più luminose? \\nWhoa... Aspetta, aspetta un attimo!")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Aaaah! \\nAhi! Ahi! Ahi!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("Perché ce l'hai con me?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Era vicino. Grazie alla mia pronta risposta, quel fulmine mi ha sfiorato solo leggermente il braccio e ha lasciato una bruciatura biancastra a terra.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Abilità di combattimento basse. Fuga veloce. \\n... Nessuna minaccia.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ebbene... sembra che mi abbiano appena identificato come un pollo...")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Perché mi hai attaccato da solo? \\nTi ho aiutato.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Nessuna corrispondenza per una strega.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo è onesto!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Piccolo Elluka, guarda, siamo stati così gentili. \\nQuindi sicuramente non siamo cattive persone.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Whisper) Annie, questo non è affatto convincente. E sembra che siamo rapitori.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bene…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... Allora, Elluka, anche tu sei una strega?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie mi ignora e chiede direttamente a Elluka.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("Ehi, aspetta! Forse Elluka non sa nemmeno cosa sia una strega.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Boia.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Boia... Beh... Perché i ragazzi di oggi amano così tanto soprannomi così stupidi?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Dannazione, l'ho appena detto ad alta voce...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un altro fulmine colpisce e lo schivo appena in tempo.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ehi, ragazzo! \\nPossiamo parlare?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ecco... cioccolato. Smettila di arrabbiarti, va bene?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Prendo dalla tasca una tavoletta di cioccolato, la spezzo a metà e la condivido con Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Uff... Fortuna che ho della cioccolata con me. \\nDopotutto nessun bambino odia il cioccolato.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yum...yum... \\nVedi, l'ho mangiato.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Cioccolato?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non è pericoloso... \\nÈ uno spuntino che ti mette allegria!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(Sussurrando) Lian, colui che offre cibo alle bambine potrebbe sembrare più un rapitore.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("E adesso ti comporti come una ragazzina, porti con te i cioccolatini. Ben fatto!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka esita un attimo prima di aprire la confezione e mettersi lentamente un pezzo in bocca.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nStrano, sapore...", "Elluka")
	await novel_interface.show_dialog("Amaro.", "Elluka")
	await novel_interface.show_dialog("Dolce...", "Elluka")
	await novel_interface.show_dialog("Elluka, non lo odia.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ahah, ti piace?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ooh... è così carina...!")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Mwahaha...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ops! Lian sembra così pericoloso.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Espressione facciale, identificazione... Hentai.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hentai...?! \\nVuoi dire io?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Ma, Elluka, non lo odia.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahah... allora va bene.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("Sembri felice di essere etichettato come Hentai. \\nSei davvero strano...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("No, non lo sono. Potresti smetterla di fraintendermi?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Oh! \\nHo un altro pezzo. Puoi averlo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Ecco!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pesca in giro, tira fuori un contenitore trasparente delle dimensioni di una batteria AA e me lo dà. Al suo interno c'è un fluido verde, denso e fluorescente.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Questo è... fluido elettrico?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Scambio, cibo.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("È questo quello che chiami cibo?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka annuisce serio.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Quando ho fame, l'amministratore mi dà da mangiare. \\nPer ricostituire energia.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("L'amministratore, il tuo tutore?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Dato che puoi mangiare cioccolato, il tuo corpo dovrebbe funzionare proprio come fa un bambino normale, giusto?", "Lian")
	await novel_interface.show_dialog("Non sei un elettrodomestico...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Senza dubbio, questa ragazza può sentire l'esistenza di iscrizioni magiche.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ma il modo in cui è alimentata... è davvero speciale.", "Annie")
	await novel_interface.show_dialog("Lei è... un boia?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
