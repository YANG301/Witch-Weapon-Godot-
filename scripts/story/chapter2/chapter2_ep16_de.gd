# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai vergleicht den Bericht mit den blinkenden Daten auf dem Monitor und grinst von Zeit zu Zeit.")
	await novel_interface.show_text_only("Mariru schnappt sich den Bericht hinter Ai und studiert ihn.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Wie verlief die körperliche Untersuchung? Du siehst viel zu zufrieden mit dir aus.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… Das ist einfach fabelhaft!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Die Seele eines Jungen, gefangen im Körper eines Mädchens ... Wenn die Leute am Harima Brain Research Institute von Lian erfahren, werden sie töten, um einen Versuchsantrag einzureichen und sie zu entführen.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wir müssen das für uns behalten, verstanden?\\nIrgendwelche neuen Erkenntnisse?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Ihre Telomere weisen beide auf ein Alter von fünfzehn Jahren hin, aber die Menge an Cäsium-137 im Weichgewebe von Annie beträgt nur ein Viertel des heutigen Durchschnitts.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Clever ... \\nSie hat also höchstens die Hälfte des Siebenjährigen Krieges miterlebt?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Es sei denn, sie wurde nach dem Krieg jahrelang in einer versiegelten Kapsel festgehalten.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich verstehe. \\nWas ist mit Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Was Lian betrifft, beträgt der in ihrem Muskelgewebe festgestellte Wert weniger als ein Zweihundertstel des Durchschnitts – sogar niedriger als der Wert, den Neugeborene von ihren Müttern erben.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es handelt sich also um einen neu synthetisierten Körper?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Hier kommt nun der wirklich interessante Teil: Ihr Körper trägt Antikörper gegen viele längst ausgestorbene Viren, darunter auch Pocken.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Lass es ruhig angehen. In ihrem Rückenmark befindet sich kein Restvirus.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ich habe eine grobe Überprüfung durchgeführt – die Geschichte des Immunsystems von Lian scheint nur die letzten paar Jahrhunderte abzudecken. Es gibt keine Antikörper gegen vormittelalterliche Viren.", "Ai")
	await novel_interface.show_dialog("Dennoch würde ich gerne eine Probe ihrer weißen Blutkörperchen anfordern und versuchen, die Viren Nr. 008, 217 und 742 zu kultivieren …", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Das ist nicht Ihre Aufgabe als Schularzt.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Ja, richtig. Ich verstehe. \\nDu willst, dass ich sie im Auge behalte, oder?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie könnten einen Link zu den vermissten Ross Goblet haben… \\nIch vermute, dass sie nicht die ganze Geschichte erzählt haben.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Warum sperrt man sie nicht einfach ein und verhört sie?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Brauchen Sie Hilfe? Schauen Sie, mit ein wenig Modifikation wären die Werkzeuge, die ich heute für die Untersuchung verwendet habe, perfekt für den Job …", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ais Augen strahlen vor Aufregung. Mariru rollt den Bericht zusammen und schlägt sie damit.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Halten Sie einfach Ihre Augen und Ohren offen. Melden Sie sich bei mir, wenn etwas passiert.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Jetzt, wo sie es bereits bemerkt hat, fürchte ich, dass jemand in SID es vielleicht getan hat ...)", "Mariru")
	await novel_interface.show_dialog("(Zumindest wird sie in der Schule die Kontrolle behalten) \\n(Und in der Zwischenzeit könnte ich auf sie aufpassen...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Du musst es mir nicht zweimal sagen. Ich werde jede einzelne Veränderung in Lians Körper aufzeichnen!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Bleiben Sie lieber unauffällig und bleiben Sie auf dem Laufenden.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Hehe, entspann dich. \\nEs würde keinen Spaß machen, wenn ich sie auf einmal ausleeren würde.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
