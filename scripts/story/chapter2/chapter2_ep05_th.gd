# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ตั้งแต่เช้านี้ เราได้ตรวจพบการแจ้งเตือน ความผันผวนของเฟสมิติเวลา หลายรายการใน New Opulentia", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("เหมือนมีอะไรตื่นขึ้นมาข้ามคืน...", "Mariru")
	await novel_interface.show_dialog("ดาวเทียมเฝ้าระวังแสดงให้เห็นว่าคุณหายตัวไปในอากาศเบาบางภายในโซนความผิดปกติ จากนั้นปรากฏขึ้นอีกครั้งในอีกฟากหนึ่งหลังจากนั้นไม่นาน โดยมีคนอื่นอยู่ข้างๆ คุณ", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru หันสายตาไปทาง Annie")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("และทันทีที่คุณสองคนปรากฏตัวขึ้น ความผันผวนนั้นก็หายไปเอง", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("โซนความผิดปกติ? คุณหมายถึงศูนย์วิจัยเหรอ?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เผงเลย", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("เป็นไปได้ไหมว่าอุปกรณ์บางอย่างทำงานผิดปกติ...? ฉันออกไปบนถนนสายหลักตลอดเวลา", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru สีหน้าจริงจัง")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คุณคิดว่าใครๆ ก็สามารถเข้าและออกจากโซน ความผันผวนของเฟสมิติเวลา ได้ เพราะเหตุใด", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("สิ่งที่ผันผวน... มันอันตรายขนาดนั้นเลยเหรอ?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คุณไม่รู้อะไรเลยจริงๆ ใช่ไหม...", "Mariru")
	await novel_interface.show_dialog("ระยะกาลอวกาศเป็นรากฐานของกฎฟิสิกส์ เช่นเดียวกับระบบพิกัดของจักรวาล ไม่ว่าอนุภาคจะเคลื่อนที่อย่างไร แกนเองก็จะต้องคงที่", "Mariru")
	await novel_interface.show_dialog("หากแกนเหล่านั้นเริ่มสั่น แม้แต่ระยะขอบที่เล็กที่สุด ลำดับของอนุภาคภายในพื้นที่นั้นจะเสียหาย", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ถ้าเพียง 5% ของอนุภาคในอาคารถูกสุ่มเคลื่อนไปหนึ่งไมโครเมตร โครงสร้างวัสดุจะถูกทำลายอย่างสิ้นเชิง และสิ่งทั้งหมดก็จะพังทลายลงทันที", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("แต่คุณยังสบายดี และอาคารต่างๆ ในบริเวณนั้นก็ไม่แสดงความเสียหายทางโครงสร้างเลย", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(และจากการวิจัยของเราเกี่ยวกับ Divine Touches มนุษย์ที่มี \"GHOST\" ไม่ควรเข้าไปในพื้นที่แบบนั้นด้วยซ้ำ)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("กล่าวอีกนัยหนึ่ง โดยพื้นฐานแล้ว คุณเดินเข้าไปในดวงตาของพายุเฮอริเคนระดับ 12 ที่สามารถฉีกทุกสิ่งทุกอย่างออกจากกัน กลับออกมาโดยไม่ได้รับอันตราย และทำให้พายุสงบลงได้", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("ถ้าอย่างนั้นความผิดปกติเหล่านั้นก็เกิดจากสิ่งที่โจมตีฉันเหรอ?\nดูเหมือนว่าพวกเขาจะเสียสติไปแล้ว...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("หยุดตรงนั้น! ฉันกำลังจะบรรยายสรุปเกี่ยวกับ วุฒิสภา—", "Mariru")
	await novel_interface.show_dialog("หนึ่งในคนวิกลจริตชอบทำการวิเคราะห์การตรวจจับโกหกแบบสดบนฟีดการประชุม ดังนั้นยิ่งฉันรู้น้อยเท่าไหร่ก็ยิ่งดีเท่านั้น", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("นั่นเป็น... วิธีที่โดดเด่นมากในการอธิบายวุฒิสมาชิก...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("และผู้หญิงก็ควรจะรู้ว่าเมื่อไรที่จะโกหกได้เช่นกัน~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("ฉันไม่ใช่ผู้หญิง!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("ยังไงซะ ก็ได้ ฉันจะไม่พูดอะไรทั้งนั้น...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ในช่วงไม่กี่ปีที่ผ่านมา มีการบันทึกกรณีความผันผวนของกาลอวกาศประเภทนี้เพียงสี่กรณีทั่วโลก\nส่วนใหญ่เกี่ยวข้องกับความล้มเหลวในการกักกันที่เกี่ยวข้องกับ Substance H", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("เมื่อสัมผัสศักดิ์สิทธิ์ที่ไม่รู้จักถูกเปิดใช้งานอย่างกะทันหัน ผลที่ตามมาอาจเป็นหายนะได้", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...คนจะได้รับบาดเจ็บมั้ย?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ในกรณีที่เลวร้ายที่สุด ยอดผู้เสียชีวิตเพียงอย่างเดียวก็สูงถึงหลายหมื่นคน", "Mariru")
	await novel_interface.show_dialog("แต่เมืองหลักๆ ของ Academy มักมีข้อตกลงที่ไม่ได้พูดเสมอที่จะรายงานเหตุการณ์เหล่านั้นว่าเป็น \"อุบัติเหตุธรรมดา\"...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("แก๊สรั่ว เครื่องบินตก การโจมตีของผู้ก่อการร้าย อะไรทำนองนั้น...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("แล้วคราวนี้...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ครั้งนี้แตกต่างออกไป เราไม่เคยเห็นการระบาดต่อเนื่องขนาดนี้มาก่อน...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("มันอยู่นอกเหนือระดับสูงสุดของสถานการณ์การโฆษณาชวนเชื่อของเราแล้ว เมื่อถึงเวลา เราจะไม่สามารถสร้างเรื่องโกหกให้กับมันได้", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("อาจเป็นเพราะฉันหรือเปล่า\nมีอะไรที่ฉันสามารถช่วยได้...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อย่าคิดมาก การเปลี่ยนแปลงทางกายภาพของคุณอาจจะเชื่อมโยงกัน แต่คุณคนเดียวไม่สามารถก่อให้เกิดความวุ่นวายครั้งใหญ่นี้ได้", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("ถ้าต้องการหาเบาะแสก็เข้าไปดูที่เกิดเหตุกับคนของข้าได้", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(หากความเป็นไปได้นั้นเป็นจริง ตอนนี้เธอคือคำตอบเดียวที่เรามี...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("แต่คุณจะต้องไม่กดดันตัวเองเด็ดขาด และอย่าบอกใครเกี่ยวกับตัวเองด้วย เข้าใจไหม?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("อย่าบอกใครเลย... นั่นหมายความว่า...\nฉันต้องแกล้งทำเป็นว่าฉันยังเป็นผู้หญิงมาตลอดเหรอ?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คุณรู้เรื่องนี้แล้วใช่ไหม...?\nNew Opulentia ปกครองภายใต้หลักคำสอนของวิทยาศาสตร์เหนือสิ่งอื่นใดมาโดยตลอด", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("หากคุณเปิดเผยประสบการณ์ของคุณต่อสาธารณะ คุณจะถูกจัดว่าเป็น \"วิชาทดลอง\" และถูกส่งตัวไปสถาบันวิจัย~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ถ้าอย่างนั้นคุณคงมีชายวัยกลางคนจำนวนมากที่สาบานตนเป็นวิทยาศาสตร์เพื่อรอที่จะศึกษาร่างกายของคุณ...", "Mariru")
	await novel_interface.show_dialog("ท้ายที่สุดแล้ว ไม่ใช่ทุกวันที่พวกเขาจะมีผู้หญิงที่น่ารักขนาดนี้—", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...โอเค เข้าใจแล้ว!!", GameConfig.player_name)
	await novel_interface.show_dialog("ฉัน... ฉันจะไม่พูดอะไรบ้าๆบอๆอย่างแน่นอน!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
