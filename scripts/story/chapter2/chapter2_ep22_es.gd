# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Espera, ¿dónde está el papel que acabas de recoger?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Uf… El periódico. Quería contarte sobre eso.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le entrego las páginas que encontré en el campo de batalla a Annie. Elluka se muerde la lengua.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("El manuscrito de Wardenclyffe… ¡Maravilloso! ¡No puedo creer que hayas encontrado esto!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Se cayeron de esos tipos antes. Simplemente no se siente bien... Annie, ¿puedes leerlos en voz alta?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um… Las líneas están borrosas, pero puedo sentir la magia fluyendo a través de ellas.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("El Grimorio... Fragmentos de Grimorio, más precisamente.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimorio… ¿Es algo sobre las brujas?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("En realidad, es un libro de brujería. El primer guión de este tipo que he visto es un panfleto que surge de la nada.", "Annie")
	await novel_interface.show_dialog("Si no recuerdo mal, el folleto se titula Trayectoria mística. Apareció de la nada en mi casillero.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Al principio pensé que era el entrenador quien me lo regalaba. La brujería interna era súper extraña, como enseñarte cómo cambiar de trayectoria.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Pero luego descubrí que el entrenador no sabía nada al respecto. Pensé que era una especie de superstición, así que nunca lo usé.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("No hasta…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parece que Annie ha terminado de recordar el pasado. Ella baja la cabeza y lee esos guiones con atención.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Recuerdo que Mariru dijo que las brujas son humanos que reciben ciertas Substance H propiedades como resultado de la contaminación de la información.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Contaminación… seguro. Yo diría que va muy al grano. Parte de la \"información\" difícilmente se puede borrar una vez que la tienes en tus manos.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Te gustan esos gusanos y remezclas de autoajuste? Intenté un millón de veces deshacerme de ellos pero siempre fracasé. A veces simplemente no puedo evitar tararear las melodías cuando estoy distraído...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ja. Bien dicho, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Quizás estos artículos causaron el flujo del espacio-tiempo? \\nPero... ¿cómo es eso posible?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Es muy probable. Esta información puede costarle mucha energía, lo cual es demasiado incluso para mí.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Es por eso que necesitamos ciertos \"Objetos\" para liberar la brujería, para que ellos puedan cubrir el costo por nosotros.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie señala su bate de béisbol. Quizás es por eso que algunas armas consumen poder mágico…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Si ocurre una sobrecarga de información, las personas pueden perder la cordura y volverse completamente locas…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Brujas... locas... \\nNecesitan... ser destruidas.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Entonces, las brujas… son las desafortunadas, ¿verdad? \\nAnnie, sabes mucho.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("No... \\nSolo estoy haciendo suposiciones basadas en mis propias experiencias.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manuscrito…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka parece perdida en sus pensamientos, su rostro se ilumina con una mirada de entusiasmo.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("¿Eh? ¿Qué? ¿Quieres verlos, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka me mira con nostalgia, como una pequeña mascota suplicando, con los ojos llenos de lágrimas.")
	await novel_interface.show_text_only("No puedo rechazarla, pero estos guiones son demasiado peligrosos...")
	await novel_interface.show_text_only("Mientras dudaba, se acercaron los golpes de un avión de transporte que aterrizaba.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("¡Alguien viene!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID ¿oficial? Genial, encontramos un... \\n¿Qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sorprendentemente, la persona que sale del avión no es un agente SID.")
	await novel_interface.show_text_only("El hombre de gafas mira a Elluka con ternura, pero ella tiembla de miedo.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, me has hecho esperar demasiado.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Administrador… lo siento.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("¿Tienes el manuscrito? \\nNo puedes manejarlos tú solo, te lo dije. Tráemelos ahora.", "Administrador")
	await novel_interface.show_dialog("Sólo la basura inútil me fallaría en una tarea tan pequeña, ¿verdad?", "Administrador")
	await novel_interface.show_dialog("Limpia este desastre y luego ven conmigo a Oligar. Hay otro trabajo esperándote.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¡Vaya, espera, espera, cuida tu lenguaje! ¿No ves que está herida?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("¡Ella es solo una niña pequeña, no una herramienta tuya!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El extraño no parece haberme notado hasta ahora. Me examina con una extraña sonrisa, como un depredador inspeccionando a su presa.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, llévala con nosotros.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("¡¿Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sobre mi cadáver. Nadie puede soportar Lian mientras yo esté aquí.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("¿Llevarla…?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sí, eso es una orden.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Orden…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka me mira fijamente, sin comprender. Parece estar en una lucha interior, pero desobedecer al Administrador no es una opción.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Tarea: llevarse Lian. \\nObjetivo bloqueado…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
