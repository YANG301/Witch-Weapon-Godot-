# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Ich betrachte mich im Spiegel an der Ecke des Flurs. \\nMeine tränenreiche Wimper bewegt sich beim Atmen auf und ab.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Tatsächlich... bin ich jetzt ein Mädchen?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Da unten... Es ist weg...)", "Lian")
	await novel_interface.show_dialog("(In diesem Fall...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Wie... wie würde ich ein Leck nehmen...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Angeln in der Umgebung...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Was machst du?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Waaaah!!", "Lian")
	await novel_interface.show_dialog("Es ist nicht... Ähm... \\nTut mir leid!! Ich wollte nicht...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Haha. Entschuldigung für was? \\nDafür, dass du dich selbst berührt hast?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(Was... was kann ich tun?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Ähm...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Wie geht es Mädchen?... Wie geht es ihnen?", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was? Was willst du von mir? Bitte seien Sie konkret.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Wie nutzen sie die Toilette?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä?!", "Mariru")
	await novel_interface.show_dialog("Hahaha…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Endlich sage ich es laut! Mach dich nicht noch einmal über mich lustig...)", "Lian")
	await novel_interface.show_dialog("(Aber es scheint, ich kann es nicht mehr halten...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Hey... lache mich nicht aus!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Setzen Sie sich einfach hin und erledigen Sie die Arbeit. So einfach ist das.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Die Mädchentoilette befindet sich gleich am Ende des Flurs. Bewegen!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pfff. Er zögerte einen Moment... \\nUnd schließlich stürzte er unter Tränen herein.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("So... süß!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (Wasserspülung)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ahh. Endlich entspannen.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Warten... Wie...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Wie kann ich es abschütteln?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Fertig? Wie denkst du darüber?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("Es ist eine Privatsache!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Kein Wunder, dass ich gehört habe, dass Mädchentoiletten oft kein Toilettenpapier mehr haben...)", "Lian")
	await novel_interface.show_dialog("Waaaah... \\nSo peinlich...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Verdammt!! \\nIch muss zu meinem alten Ich zurückkehren! Ich kann es kaum erwarten!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
