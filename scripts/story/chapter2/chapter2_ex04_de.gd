# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Mit der Erlaubnis von Mariru beschließen Annie und ich, mit Elluka einkaufen zu gehen.")
	await novel_interface.show_text_only("Elluka steht hinter mir und betrachtet alles aufmerksam.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, willst du Schokolade?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, Schokolade, so.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Hier sind Sie.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka nimmt die Tafel Schokolade, wickelt sie vorsichtig aus und beißt hinein.")
	await novel_interface.show_text_only("Ich kann einfach nicht genug von ihr bekommen. So süß!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hey, du siehst aus wie ein Perverser mittleren Alters.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Was?! Ich bin nur ein Teenager.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervers.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Warum habt ihr beide mir das angetan?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, ich gebe dir keine Schokolade, wenn du dich weiterhin so benimmst.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Schießen. Sie sieht süß aus, auch wenn sie deprimiert ist.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Haha. Ich mache nur Spaß. \\nHier bist du.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Wie viel Schokolade hast du? \\nDu wirst an Gewicht zunehmen, wenn du zu viel isst.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Was ist die große Sache? Ich habe nur ein paar Blöcke.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie starrt mich mit einem seltsamen Blick an, wodurch ich mich unwohl fühle.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Was?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Ich habe einen kurzen Blick auf Ihren aktuellen Untersuchungsbericht geworfen. \\nDu nimmst zu, bist aber nicht größer geworden.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Warum hast du das getan?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Natürlich, um dich besser kennenzulernen.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Jetzt weiß ich, dass du nur 1,70 m groß bist. Genauso wie ich.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Verdammt. Darauf kann man nicht stolz sein.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Aber als Junge war ich 1,70 Meter groß!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Das ist doch kein großer Unterschied, oder?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Du hast mich ausgetrickst... \\nIch hätte dir das nicht sagen sollen.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während Elluka ihre Schokolade genießt, erregt das Gespräch ihre Aufmerksamkeit. Plötzlich blickt sie verwirrt auf.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Schwester Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Ja?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bruder... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Schwester? Bruder? \\nDaten beschädigt. Nicht identifizierbar.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Vergessen Sie, was wir gerade gesagt haben!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ziel erneut scannen. Frau identifiziert... \\nSchwester? Bruder?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaaahh! Stoppen!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
