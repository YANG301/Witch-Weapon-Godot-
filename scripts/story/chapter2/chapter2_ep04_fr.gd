# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Ouais… Je suis aussi confus parce que cela semblait si réel, contrairement à n'importe quel rêve.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("J'ai cherché des nouvelles d'incendie ou de dégâts aux bâtiments, mais il n'y a rien. \\nLa ville semble aussi paisible qu'avant.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Sauf pour une chose…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hum ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sauf pour quoi ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Quand je me suis réveillé…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("J'ai découvert que mon corps était devenu celui d'une fille…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Eh bien…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Hein ? Vous avez dit… ça a changé ?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je ne suis pas… je ne ressemblais pas à ça avant…", GameConfig.player_name)
	await novel_interface.show_dialog("Je… je suis en fait un garçon !", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwwww… un garçon ?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ok… attends, quoi ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Tu veux dire que tu es un garçon qui se travestit ? (se penche)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Non, non… Ce n'est pas ce que je veux dire. \\nNe vous approchez pas si près !", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Mais… dans un certain sens... \\nPeut-être avez-vous raison…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh mon Dieu… comment puis-je expliquer cela !", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Quoi qu'il en soit… tu as un superbe travail de seins. (Touche)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Tellement rebondissant… Où l'avez-vous fait ? Une touche si naturelle… (Pincées)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo… je veux le savoir aussi !", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Aïe ! Non… ce n'est pas… attendez… \\nArrêtez ça !", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Laissez-moi vérifier… bras fins, taille courbée, parfait.", "Mariru")
	await novel_interface.show_dialog("Quels matériaux avez-vous utilisé ? Surtout ici…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhhh ! Ça démange…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Mme Mariru ! N'y touchez pas ici !", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Non…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Bouh…", GameConfig.player_name)
	await novel_interface.show_dialog("Croyez-le ou non ! J'étais un garçon jusqu'à hier !", GameConfig.player_name)
	await novel_interface.show_dialog("Il n’y a pas eu d’opération…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Oui, cela ne fait aucun doute.", "Mariru")
	await novel_interface.show_dialog("Un changement de genre aussi complet est impossible avec les technologies actuelles.", "Mariru")
	await novel_interface.show_dialog("Vous ne pouvez pas le faire à moins de remplacer tous les os de votre corps. \\nCe qui signifie que vous êtes et avez été une fille.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ! Je te l'ai dit ! \\nJe me suis réveillée en fille.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Avez-vous une preuve ? \\nY a-t-il quelque chose qui prouve que tu étais un garçon ?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh bien… la preuve… \\nOuais, c'est vrai ! Ma carte d'étudiant !", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Nous avons remis toutes mes affaires en entrant ici, y compris mes vêtements et ma carte d'identité.")
	await novel_interface.show_text_only("Mariru appuie sur son appareil portatif, ce qui fait apparaître ma carte d'étudiant.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Ouais ! C'est ça! \\nRegardez ! C'est la preuve.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Les traits du visage vous ressemblent un peu, mais ce n’est guère une preuve…", "Mariru")
	await novel_interface.show_dialog("Bien, affichez toutes les images de"+GameConfig.player_name+"capturé par le système de surveillance de la ville au cours du mois dernier…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru tapote adroitement sur sa tablette, l'air un peu excitée.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Je pensais que ce n'était qu'un rêve quand j'ai vu ces ruines, et je pensais que tout redeviendrait normal après mon réveil.", GameConfig.player_name)
	await novel_interface.show_dialog("Mais maintenant, je deviens une fille…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Appliquez des corrections de changement osseux. Activez tout à l’heure les analyses de démarche sur vos images dans le couloir…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignore mon murmure et se concentre sur sa tablette.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Ce n'est peut-être pas un rêve. Mais maintenant, tout semble aller pour le mieux. Pas d'incendie, pas de destruction.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh… je suis totalement confus…!", GameConfig.player_name)
	await novel_interface.show_dialog("Quelles parties de mes souvenirs étaient réelles et lesquelles n'étaient que des rêves… ?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Le modèle de démarche correspond.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Qu'est-ce que ça veut dire ?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Le modèle de démarche est le modèle de contrôle caractéristique des muscles d’une personne lors de la marche. Même les meilleurs agents ne peuvent le dissimuler.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Bien que la science actuelle ne puisse pas l'expliquer…\nVous l'êtes vraiment"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A… tu es sûr… ?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Enfin… je pensais que vous saviez quelque chose à ce sujet…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Alors, avez-vous entendu parler du Ross Goblet ?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet ? Un Substance H qui a soudainement disparu sous vidéosurveillance, selon les informations de ce matin… Mais je ne l'ai pas encore vu en personne.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Eh bien, si vous dites la vérité…", "Mariru")
	await novel_interface.show_dialog("Ce sera probablement la seule raison pour laquelle j’accepterais de donner gratuitement cette conférence ennuyeuse.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("C'est un Substance H trouvé sur les îles de Ross. Quatre pierres précieuses d'une pureté remarquable sont montées à l'extérieur.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("J'ai vu quelque chose qui ressemble à un gobelet brillant voler dans le ciel après être sorti des ruines.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Il flottait dans le ciel, émettant une faible lumière rouge…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Rouge pâle ?", "Mariru")
	await novel_interface.show_dialog("(Le liquide rouge pâle dans le gobelet est un mystère…)", "Mariru")
	await novel_interface.show_dialog("(Mais cette information est classifiée. Elle n’a jamais été rendue publique, même après avoir été classée « sûre » il n’y a pas si longtemps.)", "Mariru")
	await novel_interface.show_dialog("(Personne ne pourrait donner de tels détails sans l’avoir vu auparavant…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Qu’il s’agisse ou non d’un rêve, je crains que nous devions confirmer plus d’informations avec vous.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
