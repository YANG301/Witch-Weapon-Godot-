# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("俺とアニーはSIDのエージェント達に\\n「エスコート」され、黒い車に乗った。")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("閉鎖的な車内は、息が詰まりそうだ。")
	await novel_interface.show_text_only("内心不安な俺は、何をすれば良いのか分からず、ただ両ひざを抱えて座っていた。")
	await novel_interface.show_text_only("だけど、狼狽えてはいない。\\n傍にアニーが寄り添ってくれているおかげだ。")
	await novel_interface.show_dialog("SID……『秘密情報局』って何なの？\\n\\nその名前を聞いてからずっと顔を曇らせている\\nみたいだけど。", "アニー")
	await novel_interface.show_dialog("知らないのか？\\nSIDは元老院直属の情報機関だよ。", GameConfig.player_name)
	await novel_interface.show_dialog("第五学園都市が中立でいられるのは『イージス』の防衛システムよりも、\\nSIDの貢献が大きいってみんなに言われてるんだ", GameConfig.player_name)
	await novel_interface.show_dialog("「SIDに連れ去れた人間は二度と姿を見せる事はない」という都市伝説もできるぐらい。\\nとにかく恐ろしいスパイ機関だよ……", GameConfig.player_name)
	await novel_interface.show_dialog("へぇ～～……で、その学園都市って何？", "アニー")
	await novel_interface.show_dialog("（おいおい……それは流石に常識だろ？）", GameConfig.player_name)
	await novel_interface.show_text_only("不思議そうな顔で俺が見つめるのに対し、\\nアニーは気楽な笑みを浮かべるだけだった。")
	await novel_interface.show_dialog("とにかく、ノープロブレムっ！\\n何があっても私達は大丈夫！", "アニー")
	await novel_interface.show_dialog("だって、あなたは特別だもん。", "アニー")
	await novel_interface.show_dialog("……", GameConfig.player_name)
	await novel_interface.show_text_only("アニーが気軽に口にした言葉を聞くと、\\n不思議と焦りを覚えていた気持ちが落ち着いた。")
	await novel_interface.show_text_only("もうSIDに連れ去られている事も、\\n怖いと思わなくなった…………")
	await novel_interface.show_text_only("（いやいやいやいや、やっぱり怖いって！）")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("俺達を乗せた車が都市部の商業区にたどり着く。\\nそして目立たない地下駐車場の──\\n自動車用エレベーターに入った。")
	await novel_interface.show_text_only("エージェントの人が何かを話すと、\\nエレベーターが音を立てて動き始めた。")
	await novel_interface.show_text_only("自動車用エレベーターは数回長距離を降下したと思ったら、横の移動も何回か挟み──\\nそんな動作を複数回繰り返した。")
	await novel_interface.show_dialog("（商業区の地下に、こんな巨大迷路のような空間　があったのか……）", GameConfig.player_name)
	await novel_interface.show_text_only("SIDの本部には様々な伝説がある。\\n\\n例えば新豊洲の東南郊外に、建物全体が光学カモフラージュされて存在している。とか。")
	await novel_interface.show_text_only("システム上「存在しない」建物なので、いつも\\nマスメディアに仰々しく言われたい放題だ。")
	await novel_interface.show_text_only("そして俺がいる場所こそが、\\nまさしくその「存在しない」機関の中枢……")
	await novel_interface.show_dialog("（俺もここで「存在しない」人間にならなければ　いいけど……）", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("車から降りると、厳粛な雰囲気の廊下に\\nたどり着いた。\\n金属プレートに包まれていて、超科学技術が\\n満載っぽい。")
	await novel_interface.show_text_only("数歩進むと、エレベーターは自動的に閉まり、　素早く遠ざかる音が聞こえた。\\n厳粛な雰囲気はさらに重くなり、抑圧感が漂う。")
	await novel_interface.show_text_only("俺の心もまた沈み始めてきた……")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("廊下を真っ直ぐ進むと、明るいが閉鎖的な部屋に到着した。")
	await novel_interface.show_text_only("尋問室みたいだけど、机や椅子はない。\\n一面の壁が巨大なガラス張りになっている。")
	await novel_interface.show_text_only("しきりに見回しながら室内を観察していると──")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("うわっ――！！", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("突然背後から腰周りを掴まれ、引き寄せられる。")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("あっ、あとっ、ととととああっ――！", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("身体のバランスが崩れると……既視感。\\n\\n後頭部に柔らかくしっかりしたモノを感じた。")
	await novel_interface.show_dialog("ふん……このレベルの身体能力では、\\n諜報任務はできんな…", "女性の声")
	await novel_interface.show_dialog("先ほどのスキャン結果に誤りがあると思って、\\n直接確認しに来たのだが。", "女性の声")
	await novel_interface.show_dialog("……手触りだけはいいな。", "女性の声")
	await novel_interface.show_text_only("聞き覚えのある女性の声が、背後から聞こえて\\nきた。")
	await novel_interface.show_text_only("相手が手を放したので、驚くままに振り返った。\\n目に映ったのは──")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("（こっ、この、お、大きいのは！！？？）", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("ま、マリルさん！？", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("ん？　……お知り合い？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ほう？　私を知っているという情報をあっさり\\n漏らすとは…\\nどうやら自分の正体を隠す気はないようだな……", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("（あっ！　しまった、つい叫んじゃった……）", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("信じられないけど、目の前の軍服姿の女性は、\\n夢の中、研究センターで会ったお姉さんだった。")
	await novel_interface.show_text_only("背が高く、髪色は火のように赤く……\\nそして何よりもこのドＳな雰囲気……")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("それじゃあ、大人しく質問に答えてもらおう。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("事故とか偶然を言い訳にして誤魔化すなよ？", "マリル")
	await novel_interface.show_dialog("一応、私は『尋問』が得意スキルなんでね。\\n\\nあどけない顔でこっちを見ても、\\n手加減はしないぞ～～？", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("この威厳あれど悪戯っぽい態度、そして\\n自信満々でちょっと見下してるまなざし……")
	await novel_interface.show_text_only("彼女のフルネームは？\\nそうだ、彼女の名前は──")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("お前が知るように、私はSIDの主任である\\nマリル・フォン・ブラウンだ。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("この人だッ！！")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("ちょっと待って、SIDの主任？\\n首席科学者じゃないのか！？")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("だけど、服装とか肩章とか見ると、\\n確かに偉い軍人っぽいし……")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("ストッキングとハイヒールは昨日と同じだけど。")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ん？　小娘、どこを見てるんだ？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("わぁっ！　なんでもないですっ！\\n申し訳ありませんっ！　マリル様っ！", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("この状況でボンヤリを決め込むなんて、\\n良～い度胸だな～～", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("話によれば、この青ツインテにSIDの怖い怖～い噂話を流しまくっていたって？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("楽しそうに手元の教鞭を弄ぶマリルを目の前に、俺は緊張から唾を飲む。")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("さて……その噂話……\\n自分でどこまで本当か試してみるか？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("ひぃぃぃっ！　ご、ごめんなさいぃぃっ！", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("あ、青ツインテ……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("怖いと分かっているなら、\\nお前の身元をまずはハッキリさせろ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが携帯端末を操作すると、尋問室の壁面にすぐさま投影が映し出された。")
	await novel_interface.show_text_only("映像は監視カメラによって様々な角度から\\n撮られた俺の写真。\\nそして顔認証システムの分析結果は──")
	await novel_interface.show_text_only("「特徴照合該当なし。識別不能」")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("入国記録がないと、『イージス』システムは認識できない。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("新豊洲に潜入した工作員やテロリストとして、\\n普通なら直ぐに処分しているところだが……\\nお前は、あまりにも身体能力が低いからな……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("……ちょっと恥ずかしくなり、俺は無意識で\\n以前より柔らくなったお腹を触った。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+"、このお姉さん、\\nさっき会った敵より怖いみたい……", "アニー")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（そうだね、嘘ついてもすぐにバレる予感……）", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("（やっぱ正直に喋ろうっ！　あああっ！\\n　もう構うもんかっ！）", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("俺は"+GameConfig.player_name+"、どこから話せばいいかな……", GameConfig.player_name)
	await novel_interface.show_dialog("事情が複雑過ぎて、俺自身も混乱してるんだ。", GameConfig.player_name)
	await novel_interface.show_dialog("聞いても信じてもらえないと思うけど……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("御託はいい。さっさと話せ。", "マリル")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("……俺は……夢を見たんだ。", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("単位のために、研究センターの講義を\\n聴きに行く事にしたんだ……\\nそれで昨日は閉館直前に間に合ったんだ。", GameConfig.player_name)
	await novel_interface.show_dialog("そこでマリルさんと出会って、\\n「研究センターが占領された」って\\nマリルさんから聞いて……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは冗談でも聞いたような表情をする。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("──夢の中で私に会ったと？", "マリル")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そう、間違いなくあなただった。\\nあなたは強引に俺を引っ張り込んだ……", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("あっ、そうだ。あなたは元老院に認定された\\nSS級科学者……\\nマリル・フォン・ブラウン博士だよね？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("……確かにそうだ。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("しかし、その情報は元々公開されている。\\n\\n新豊洲科学院をある程度知ってる人間なら、\\n誰でも分かっているはずだ。", "マリル")
	await novel_interface.show_dialog("……まぁいい。\\nそれで？", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("マリルさんは覆面のテロリストを1人倒して、\\n拳銃を奪い取った。\\nそして大人しく救援を待っていてくれと俺に\\n指示した後、占領された現場に向かった……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("占領された現場？\\nどこのことだ？", "マリル")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("確か『講義室』って言ってた。", GameConfig.player_name)
	await novel_interface.show_dialog("元々そこでは講義が開催される予定で、\\nマリルさんが講師だったはず。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("………講義…………講師。", "マリル")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("（……ヴォルフガングのジジイが手配した\\n　『ロス・ゴールド』に関する講義の事か？）", "マリル")
	await novel_interface.show_dialog("（しかしあれは公表される前にキャンセルされた　はず。なぜこの子が知っている？）", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あの……マリルさん？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("気にするな。続けろ。", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("しばらくして、銃を持ったテロリストが数人\\nやってきた。俺は逃げようと頑張ったけど……\\n下の階に落とされてしまって。そこから石板の\\n影に必死に身を隠したんだ……", GameConfig.player_name)
	await novel_interface.show_dialog("ごめんなさい。その辺りから、記憶が曖昧で……", GameConfig.player_name)
	await novel_interface.show_dialog("どうやら気絶していて、気が付いた時には……\\nもうすでに、景色が……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("景色が……？", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("周囲一面の煙と火の海だったんだ。", GameConfig.player_name)
	await novel_interface.show_dialog("研究センターの建物も、廃墟と化していた……", GameConfig.player_name)
	await novel_interface.show_dialog("空気中の粘り付くような臭いが、鼻を突いて……", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("舌根が渋くなるほどの鈍重な塩辛さ……", GameConfig.player_name)
	await novel_interface.show_dialog("そして全員が石像になっていたんだ……", GameConfig.player_name)
	await novel_interface.show_dialog("いや、石じゃない………あれは……塩だ。", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("あとは光っているモノが宙に浮いているのを……見た。", GameConfig.player_name)
	await novel_interface.show_dialog("地獄のような光景なのに……\\nなぜか異様な静穏を感じて……", GameConfig.player_name)
	await novel_interface.show_dialog("何かが呼び掛けてるような……", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("そこからまた記憶があやふやになって、\\n一筋の光が──────", GameConfig.player_name)
	await novel_interface.show_dialog("うん……夢はそこで終わった。", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("気が付いたら、家のベッドで寝てて…\\nもう朝を迎えていたんだ。", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("ただの……夢……か？", "マリル")
	await novel_interface.show_dialog("そこまではっきりした嗅覚の記憶。\\nまるでお前は実体験でもしたかのような……", "マリル")
	await novel_interface.show_dialog("（その「鼻を突いた臭い」が硫黄であれば……）\\n\\n（『創世記』の中でソドムとゴモラが滅びる様式　と似ている）", "マリル")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
