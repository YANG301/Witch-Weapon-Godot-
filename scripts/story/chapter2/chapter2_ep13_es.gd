# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Antes de ir a su nueva escuela, su primera tarea es la formación de conocimientos básicos.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("¿Conocimientos básicos?\nNo es que me haya Annie y me haya perdido todo lo que pasó estos últimos años...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je. Te perdiste más de una década de conocimiento sobre ser una niña, ¿no?~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("¡No necesito ese tipo de conocimiento!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ignoró por completo mi protesta y caminó hacia la mesa de muy buen humor. Sólo entonces me di cuenta de que ya había preparado toda la mesa con todo tipo de herramientas imaginables.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Primero, debes poder distinguir doce tonos de lápiz labial estándar y memorizar las veinte marcas principales.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("¿Tantos...?\n¿No son básicamente todos los colores iguales?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("¡Demasiado ingenuo! Eso no es ni una décima parte del total.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Y aquí he preparado un conjunto completo de herramientas de maquillaje para ti: base, sombra de ojos, brillo de labios, iluminador, contorno...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("¿Eh? ¡¿Tengo que ponerme tantas cosas en la cara?!\nNo es como si estuviera pintando... ¿Qué tan complicado es ser una niña, exactamente...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("No te preocupes. A partir de hoy alguien te enseñará a maquillarte correctamente.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pero a los estudiantes de secundaria ni siquiera se les permite usar maquillaje...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Realmente no entiendes el mundo de las chicas de secundaria....\nSi sigues actuando así de descuidado, la gente sospechará en poco tiempo.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Y además de la escuela, como agente SID necesitarás realizar todo tipo de misiones. El maquillaje es una de las habilidades esenciales para una mujer operativa.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Especialmente con una carita linda como la tuya.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru extendió un dedo e inclinó mi barbilla hacia arriba.")
	await novel_interface.show_text_only("Di un paso atrás para evitar su mano. De alguna manera mi orgullo masculino simplemente no podía aceptarlo.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ya fui voluntario antes, claro...\nPero nunca esperé tener que aprender cosas como estas...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Las evaluaciones de cadetes de SID son extremadamente estrictas. Cada ronda elimina a un gran grupo de personas.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ya que hablaste de un juego tan importante, ¿por qué no demostrar tu valía?", "Mariru")
	await novel_interface.show_dialog("Y si pasas la evaluación final, serás incorporado oficialmente a la lista, con un salario muy decente también~", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("¿Eh? ¡¿A mí también me pueden pagar?!\n(E-Entonces mi carrito de compras Gfat...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Muy bien, el orgullo masculino puede quedarse en un rincón por ahora.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Jejeje... qué mocoso más simple.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Pero a cambio, será mejor que comprendas esto: como tu oficial al mando, mis órdenes son absolutas y las obedecerás incondicionalmente.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("¿En qué me estoy metiendo...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Primero, déjame presentarte a alguien: el profesor que se ofreció como voluntario para enseñarte maquillaje.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Aunque sus responsabilidades habituales son fármacos experimentales y desarrollo de equipos especiales...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Oh... debes ser Lian, ¿verdad?\nJeje~ Este perfil es realmente interesante~", "chica con gafas")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Hola ~ Soy el director del Departamento de Investigación de Combate de SID. Dado que nuestros archivos han sido modificados, puedes llamarme Ai.", "chica con gafas")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Hola...\n(¿Su archivo... también fue modificado?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian es un material de investigación excelente. ...\n¿¡No puedes prestármela por un rato~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Material de investigación...? ¿Prestarme...?)", "Lian")
	await novel_interface.show_dialog("(P-¿Por qué de repente siento un poco de frío en la espalda...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Soy su tutor, al menos en el papel, así que no tienes permitido hacer ningún movimiento con ella~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Hmph, bien...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("Normalmente tampoco uso maquillaje, pero eso es simple. Lo tenía todo memorizado después de mirarlo durante diez minutos.", "Ai")
	await novel_interface.show_dialog("También deberías poder aprenderlo rápidamente.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Tan rápido?\nMe pareció un proceso realmente complicado...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai recuerda todo rápidamente. Deberías aprender más de ella en el futuro~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Correcto...\n(¡¿Cómo exactamente se supone que debo aprender algo como la memoria?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aghh~~\nMi cabeza está a punto de explotar después de pasar todo el día con Ai memorizando marcas y colores de maquillaje.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! ¡¿Por qué estás aquí?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("¿Qué? Para empezar, este apartamento es una de mis residencias en New Opulentia.\nMás que eso, todo este edificio es SID propiedad~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Con razón este lugar es tan escandaloso!\nEspera, no me digas que vas a vivir aquí con Annie y conmigo...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Solo paso por aquí de vez en cuando, así que no me quedaré aquí a menudo~\nAunque el refrigerador ya no tiene cerveza. La próxima vez recuerda comprarme dos estuches.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Pero hoy estoy aquí específicamente en mi papel de tu guardián... ji-ji~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¡Tengo un presentimiento terrible sobre esto!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Ven a probártelos. Este es tu uniforme escolar, Lian, y este es un vestido~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Por qué... esta falda es tan corta...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Una falda realmente luce mejor con este largo.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Definitivamente alteraste el largo de esta falda, ¿no?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("No te preocupes por los pequeños detalles~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Y aquí tenemos calcetines tobilleros, calcetines altos, medias hasta el muslo, pantimedias...\n¡Oh, y este liguero también!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Cómo es posible que existan tantos tipos de calcetines...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("También hay diferentes tipos de rayas, patchwork, estampados, lunares...\nAh, claro, ¿quieres probar las medias de red?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¡¡Absolutamente no!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¡No, espera! ¡¡Ese no es el punto!\n¡¡No quiero usar cosas como estas en absoluto!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Si una misión lo requiere, no tendrás otra opción de todos modos, así que es mejor que te acostumbres temprano...\n¿Quieres que te ayude?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("¡¡T-Tú... tú...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
