# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Согласно статистике тренировок, физическая подготовка Lian ничем не отличается от среднестатистических девочек-подростков.", "Ai")
	await novel_interface.show_dialog("За исключением зрительно-моторной координации. Возможно, это как-то связано с платиновыми трофеями на ее игровых аккаунтах…", "Ai")
	await novel_interface.show_dialog("Annie работает лучше, тренируясь в одиночку. Почти так же хороша, как профессиональные спортсмены ее возраста.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Но то, что я обнаружил, когда они во второй раз исчезли в зоне потока, совершенно иное.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("А? Что-нибудь интересное?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Возможно, люди этого не чувствуют, но…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Зонд Больцмана на дроне слежения пару раз зашкаливал. Когда его спасли, он уже был сломан.", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Невозможно. Если бы зонд работал хорошо… то те, кто находился в зоне потока… \\nЯ бы сказал, что почти вся область испарилась бы.", "Mariru")
	await novel_interface.show_dialog("Я бы сказал, что почти вся территория испарилась бы.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("А вы с ума сошли, чтобы прикрепить на дрон такое дорогое устройство?", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru сворачивает документ и стучит Ai по голове.\\nAi издает быстрый стон.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Ну... я не говорю о тепловой энергии. Резкое увеличение информационной энтропии также может привести к тем же результатам.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Две девушки сделали это крайне маловероятное событие возможным со 100% уверенностью.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Annie ведьма, но тогда Lian… Она контейнер, созданный Substance H?", "Mariru")
	await novel_interface.show_dialog("Как будто Lian активировал ведьм и их магическую силу…", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Или как аккумулятор с наддувом, вставленный в вибратор…", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Из командной комнаты доносится стук. На голове Ai появляется шишка.")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Мне очень жаль налогоплательщиков. Представьте, сколько налогов тратится на таких чудаков, как вы.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Наука – это ненасытное любопытство и похоть, не так ли?", "Ai")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("… Вам действительно не стыдно это говорить.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Я уже упоминал о странных исследовательских целях, которые вы поставили перед моим SRD?", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("И твое лицо говорит мне, что ты задумал что-то фальшивое. \\nСкажи мне, что у тебя на уме?", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ai заметил улыбку на лице Mariru прежде, чем она исчезла.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Поскольку они какое-то время обучались, пришло время посмотреть, чему они научились.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Substance H, Ross Goblet, Ведьмы, Пространственно-временной поток… Все связано с Lian…)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Без нее Annie не смог бы пройти через область потока.) \\n(Итак, в течение семи лет, когда Annie исчез…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Кажется, вы... планируете подвергнуть опасности двух невинных подростков?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("О чем нельзя говорить, о том следует молчать.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Хм. Людвиг Витгенштейн. Мне больше нравится другая его цитата.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Мистическим является не то, как обстоят дела в мире…", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Но что оно существует.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Я обязательно останусь верен своим принципам.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("В этом нет никаких сомнений.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Annie и я внезапно получил заказ от Mariru. Мы должны немедленно вернуться в нашу квартиру и оставаться на дежурстве.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Срочная миссия?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Я, э... \\n(Смотрю—)", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("Ма… Mariru?", "Lian")
	await novel_interface.show_dialog("(Мне кажется, я вижу вспышку колебания в глазах Mariru…)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Значит, время летит, когда мы не встречаемся? \\nТы быстро растешь—", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да… Хотя есть еще вещи, к которым я не привык.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Правда? Например?", "Mariru")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Как внешний вид боевого костюма… \\nКакое унижение!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Это, конечно, очень круто!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Топ больше не подходит? \\nХотите новое измерение?", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, не это!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("Mariru обращается ко мне. Я понимаю ее намерение и быстро уклоняюсь от нее.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Э-нет, нет! \\nОн идеально подходит!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Оуу.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("(Чего ты жалеешь!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Ип! Lian все еще развивается…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie выглядит завистливым и грустным.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Annie—! \\nКак ты мог быть таким, как она…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Надеюсь, я смогу вырасти, как ты! \\n—К сожалению, мое время остановилось.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ее время остановилось… Потому что она ведьма?")
	await novel_interface.show_text_only("Annie пытается выглядеть оптимистично, но не может скрыть печаль в глазах. Воздух внезапно становится тяжелым")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("… Annie", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Итак, дайте мне их почувствовать—\\nАга!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie неожиданно обнимает меня со спины.")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Эй!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("… Ты выросла, девочка.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru отворачивается, тайком вытирая слезы.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Ты! Какая ерунда!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Кхм, вернемся к делу! \\nУ меня сейчас для тебя срочное задание.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Вы слышали о подстанции Джонсон?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Супер-огромная подстанция на восточном побережье?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("(Это территория, совместно управляемая шестью Академгородами, находящаяся в защитном поле Aegis. Там проводились послевоенные мирные переговоры.)")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Точно. Мы только что получили сигналы тревоги с дюжины ретрансляционных станций, свидетельствующие о сильных скачках напряжения, произошедших на северо-востоке.", "Mariru")
	await novel_interface.show_dialog("И наш спутник обнаружил Пространственно-временной поток на Подстанции.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Пространственно-временной поток? Может ли это быть…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Если данные верны, ситуация будет такой же, как и та, с которой вы сталкивались раньше.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Вы еще не имеете квалификации полевого агента…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Но подстанция находится в «Согласованной демилитаризованной зоне», а это означает, что SID не имеет полномочий проводить там операции, даже если она находится в New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Это можно рассматривать как незначительный компромисс ради «мира во всем мире».", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Итак, мне нужно, чтобы вы разведали подстанцию. SID команды будут стоять по периметру.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Я получу одобрение Объединенного Конгресса как можно скорее.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("Вы имеете в виду, что мы нарушим юрисдикцию Альянса Академгорода? \\nЭто действительно нормально?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Угу! Похоже, кто-то предпочел бы увидеть затемнение в районе посольства, чем срезать путь.", "Mariru")
	await novel_interface.show_dialog("Если придет беда, те идиоты, которые ненавидят друг друга, могут просто столкнуться. \\nЕсли ситуация перерастет в войну…", "Mariru")
	await novel_interface.show_dialog("Если ситуация перерастет в войну…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Хорошо, хорошо. Что бы вы ни говорили…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А вы всего лишь подростки. Даже если вас поймают солдаты службы безопасности, вы можете уйти, если будете вести себя мило.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Да, когда свиньи летают!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("В любом случае, это приказ. \\nВертолет ждет на крыше. Готовьтесь и вперед!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"sprite")
	await novel_interface.show_dialog("Какой диктатор…", "Lian")

	print("=== 第二章第19话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
