# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("ฉันมองตัวเองในกระจกตรงมุมห้องโถง \\nขนตาที่มีน้ำตาของฉันขยับขึ้นและลงขณะที่ฉันหายใจ")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("จริงสิ… ตอนนี้ฉันเป็นผู้หญิงแล้วเหรอ?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(ข้างล่างนั่น... หมดแล้ว...)", "Lian")
	await novel_interface.show_dialog("(ในกรณีนี้...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(ยังไง... จะรั่วได้อย่างไร...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(ตกปลารอบๆ...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("คุณกำลังทำอะไรอยู่?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("ว้าว!!", "Lian")
	await novel_interface.show_dialog("ไม่ใช่... อืม... \\nขออภัย!! ฉันไม่ได้ตั้งใจ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("ฮ่าๆ ขอโทษเรื่องอะไร? \\nเพื่อสัมผัสตัวเองเหรอ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(อะไร... ฉันจะทำอย่างไร?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... อืม...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("สาวๆ... เป็นยังไงบ้าง...", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อะไรนะ? คุณต้องการอะไรจากฉัน? โปรดระบุให้เฉพาะเจาะจง", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("พวกเขาใช้ห้องน้ำอย่างไร?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ห๊ะ?!", "Mariru")
	await novel_interface.show_dialog("ฮ่าๆๆ…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(สุดท้ายฉันก็พูดออกมาดังๆ! อย่าล้อฉันอีกนะ...)", "Lian")
	await novel_interface.show_dialog("(แต่ดูเหมือนทนไม่ไหวแล้ว...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("เฮ้… อย่าหัวเราะเยาะฉันนะ!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("แค่นั่งลงและทำงาน ง่ายๆแบบนั้น", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("ห้องน้ำหญิงอยู่ทางด้านล่างของห้องโถง เคลื่อนไหว!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("ฟฟฟ. เขาลังเลอยู่ครู่หนึ่ง... \\nและในที่สุดก็รีบเข้ามาทั้งน้ำตา", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("... น่ารักจังเลย!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nสลูช (การล้างน้ำ)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("อ่า.. ในที่สุดก็ผ่อนคลาย", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("รอสักครู่... อย่างไร...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("ฉันจะสลัดมันออกได้อย่างไร?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("เสร็จแล้วเหรอ? คุณรู้สึกอย่างไรเกี่ยวกับเรื่องนี้?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("มันเป็นเรื่องส่วนตัว!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(ไม่น่าแปลกใจที่ฉันได้ยินมาว่าห้องน้ำหญิงมักจะหมดกระดาษชำระ...)", "Lian")
	await novel_interface.show_dialog("ว้าว... \\nน่าอายจังเลย...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("ให้ตายเถอะ!! \\nฉันต้องกลับไปหาฉันคนเดิม! รอไม่ไหวแล้ว!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
