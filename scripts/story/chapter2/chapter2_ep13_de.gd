# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bevor Sie an Ihre neue Schule gehen, besteht Ihre erste Aufgabe darin, Grundkenntnisse zu vermitteln.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Grundkenntnisse?\nEs ist nicht so, dass ich Annie alles verpasst hätte, was in den letzten Jahren passiert ist...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh. Du hast über ein Jahrzehnt an Wissen über das Mädchensein vermisst, nicht wahr?~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("So ein Wissen brauche ich nicht!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ignorierte meinen Protest völlig und schritt gut gelaunt auf den Tisch zu. Erst dann fiel mir auf, dass sie bereits die gesamte Tischplatte mit allen erdenklichen Werkzeugen vorbereitet hatte.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Zunächst müssen Sie in der Lage sein, zwölf Standard-Lippenstifttöne zu unterscheiden und sich die zwanzig besten Marken zu merken.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("So viele...?\nSind die Farben nicht grundsätzlich alle gleich?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Zu naiv! Das ist nicht einmal ein Zehntel der Gesamtzahl.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Und hier habe ich ein komplettes Set an Make-up-Tools für Sie vorbereitet – Grundierung, Lidschatten, Lipgloss, Highlighter, Konturierung...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Hä? Ich muss so viel Zeug auf mein Gesicht auftragen?!\nEs ist nicht so, als würde ich malen... Wie kompliziert ist es eigentlich, ein Mädchen zu sein...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Mach dir keine Sorgen. Ab heute bringt dir jemand das richtige Schminken bei.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aber Oberstufenschülern ist es nicht einmal erlaubt, Make-up zu tragen...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Du verstehst die Welt der Highschool-Mädchen wirklich nicht....\nWenn du weiterhin so nachlässig verhältst, werden die Leute im Handumdrehen misstrauisch.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Und neben der Schule müssen Sie als SID-Agent alle möglichen Missionen ausführen. Make-up ist eine der wesentlichen Fähigkeiten einer weiblichen Mitarbeiterin.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Besonders mit einem süßen kleinen Gesicht wie deinem …", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru streckte einen Finger aus und neigte mein Kinn nach oben.")
	await novel_interface.show_text_only("Ich trat einen Schritt zurück, um ihrer Hand auszuweichen. Irgendwie konnte mein männlicher Stolz es einfach nicht akzeptieren.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sicherlich habe ich schon früher ehrenamtlich gearbeitet...\nAber ich hätte nie gedacht, dass ich so etwas lernen müsste...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("SIDs Kadettenbewertungen sind äußerst streng. Jede Runde eliminiert eine große Menge Leute.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Warum beweisen Sie sich nicht, da Sie ein so großes Spiel vorgetragen haben?", "Mariru")
	await novel_interface.show_dialog("Und wenn Sie die Abschlussprüfung bestehen, werden Sie offiziell in den Kader aufgenommen – und das mit einem sehr anständigen Gehalt", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hä? Ich kann auch bezahlt werden?!\n(Th-Then mein Gfat-Warenkorb...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Okay, der männliche Stolz kann vorerst in der Ecke bleiben.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Hehehe... was für ein einfacher kleiner Bengel.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Aber im Gegenzug sollten Sie Folgendes besser verstehen: Als Ihr kommandierender Offizier sind meine Befehle absolut und Sie werden ihnen bedingungslos gehorchen!", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Worauf lasse ich mich bloß ein...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Zunächst möchte ich Ihnen jemanden vorstellen – den Lehrer, der sich freiwillig bereit erklärt hat, Ihnen Make-up beizubringen.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Obwohl ihr üblicher Aufgabenbereich experimentelle Medikamente und die Entwicklung spezieller Geräte sind...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Oh... du musst doch Lian sein, oder?\nHehe~ Dieses Profil ist wirklich interessant~", "Mädchen mit Brille")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Hallo ~ ich bin der Direktor der Kampfforschungsabteilung von SID. Da unsere beiden Dateien geändert wurden, können Sie mich einfach Ai nennen.", "Mädchen mit Brille")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Hallo...\n(Ihre Datei... wurde auch geändert?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian ist so hervorragendes Forschungsmaterial...\nKannst du sie mir nicht für eine Weile leihen~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Forschungsmaterial...? Mich ausleihen...?)", "Lian")
	await novel_interface.show_dialog("(W-Warum fühlt sich mein Rücken plötzlich irgendwie kalt an...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ich bin ihr Vormund, zumindest auf dem Papier, also darfst du sie nicht angreifen~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Hmpf, gut...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("Normalerweise trage ich auch kein Make-up, aber das ist einfach. Nachdem ich es zehn Minuten lang angeschaut hatte, hatte ich alles auswendig gelernt.", "Ai")
	await novel_interface.show_dialog("Sie sollten es auch schnell lernen können.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("So schnell?\nEs schien mir ein wirklich komplizierter Prozess zu sein...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai merkt sich schnell alles. Du solltest in Zukunft mehr von ihr lernen~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Richtig...\n(Wie genau soll ich so etwas wie Gedächtnis lernen?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aghh~~\nMein Kopf explodiert gleich, nachdem ich den ganzen Tag damit verbracht habe, Make-up-Marken und -Farben auswendig zu lernen.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! Warum bist du hier?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Was? Diese Wohnung ist zunächst einmal eine meiner Wohnungen in New Opulentia.\nDarüber hinaus ist dieses ganze Gebäude SID Eigentum~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Kein Wunder, dass dieser Ort so ungeheuerlich ist!\nWarte, erzähl mir nicht, dass du hier mit Annie und mir leben wirst...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ich komme nur gelegentlich vorbei, daher werde ich nicht oft hier bleiben~\nObwohl der Kühlschrank bereits kein Bier mehr hat. Denken Sie beim nächsten Mal daran, mir zwei Koffer zu kaufen.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Aber heute bin ich speziell in meiner Rolle als Ihr Vormund hier... hee-hee~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich-ich habe ein schreckliches Gefühl dabei!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Kommen Sie und probieren Sie diese an. Das ist deine Schuluniform, Lian, und dieses hier ist ein Kleid~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Warum ist... dieser Rock so kurz...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("In dieser Länge sieht ein Rock wirklich am besten aus.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du hast definitiv die Länge dieses Rocks verändert, oder?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Machen Sie sich keine Gedanken über die kleinen Details~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Und hier haben wir Söckchen, Crew-Socken, Overknee-Strümpfe, Strumpfhosen...\nOho, und diesen Strapsgürtel auch!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wie gibt es denn auch so viele Arten von Socken...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Es gibt auch verschiedene Arten von Streifen, Patchwork, Mustern und Punkten....\nAch ja, willst du Netzstrümpfe ausprobieren?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Absolut nicht!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Nein, warte! Darum geht es nicht!\nSolche Sachen möchte ich überhaupt nicht tragen!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Wenn eine Mission es erfordert, hast du sowieso keine Wahl, also solltest du dich lieber gleich daran gewöhnen....\nMöchtest du, dass ich dir helfe?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Y-Du... du...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
