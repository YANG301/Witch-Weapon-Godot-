# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie уже заселен в соседней комнате. Есть кое-что, что мне нужно сказать тебе наедине.", "Mariru")
	await novel_interface.show_dialog("Я только что получил подтверждение.", "Mariru")
	await novel_interface.show_dialog("С сегодняшнего утра во многих крупных городах появились крупномасштабные пространственно-временные аномалии...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Насколько нам известно, затронутые регионы включают Парящий дворец, Ньюморидас, Форт Масада, Салмонтон, New Opulentia и острова Лебона.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Тогда разве это не означает...\nвсе шесть Академгородов...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Это верно. Сейчас за этим наблюдает весь мир, и масштабы воздействия намного превзошли ожидания.", "Mariru")
	await novel_interface.show_dialog("Я думаю,... может быть одна возможность...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Все, что вы описали, пережило во сне — террористы атакуют исследовательский центр, город превратился в руины...", "Mariru")
	await novel_interface.show_dialog("...все это могло произойти на самом деле.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Х-как это возможно?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("У меня нет убедительных доказательств, но сегодня утром, возможно, уже произошло огромное пространственное искажение.", "Mariru")
	await novel_interface.show_dialog("Спутник «Истинное зрение» SID также зафиксировал аномально сильный всплеск шума.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Возможно, это облегчит понимание: New Opulentia действительно когда-то было уничтожено, но какая-то сила перевернула эту реальность...", "Mariru")
	await novel_interface.show_dialog("И эта сила, похоже, также связана с изменениями в вашем теле, а также с атаками этих странных врагов.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Конечно, это пока только моя гипотеза.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Эта идея... не слишком ли смелая...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Из-за сегодняшних событий остальные пять Академгородов оказывают давление на Сенат с целью разрешить вход для расследования.", "Mariru")
	await novel_interface.show_dialog("И если ваша причастность к этому инциденту будет раскрыта, то быть захваченным исследовательским учреждением будет наименьшей из ваших проблем...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Агенты каждой разведывательной организации отметили бы вас как ключевую цель.", "Mariru")
	await novel_interface.show_dialog("Не считая уже работающих под прикрытием, сегодня только под вымышленными именами в New Opulentia вошли более сотни сотрудников разведки из разных стран.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Ты все это так подробно знаешь?\nПочему бы тебе их не остановить?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Хм. Лучше держать ситуацию под контролем в темноте, чем заставлять их менять лица и исчезать из поля зрения.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", тебе нужно понять следующее: пока у тебя есть девичье тело, ты никогда не сможешь вернуться к своей прежней жизни.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Тем не менее, тот факт, что мы в SID нашли вас первыми, может быть удачей.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Стать девушкой в одночасье...\nКак мне вообще объяснить это своим одноклассникам и друзьям...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Мм... ты не беспокоишься о своих родителях?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Моя мать умерла, когда я был маленьким.\nМой отец... уже много лет пропал без вести...", GameConfig.player_name)
	await novel_interface.show_dialog("Я жил в школе-интернате до двенадцати лет.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Таким образом, послевоенная программа ухода за детьми горилл действительно помогла некоторым детям.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Мм, у тебя была своя доля трудностей.\nТем не менее, тебе не нужно беспокоиться о проблеме смены личности.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Переход идентичности...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("На лице Mariru появляется довольно зловещая улыбка...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
