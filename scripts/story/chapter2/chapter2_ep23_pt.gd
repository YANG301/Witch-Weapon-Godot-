# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka ataca Annie e a mim com magia relâmpago. Não querendo machucá-la, tudo o que podemos fazer é nos defender desesperadamente.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Se isso continuar, todos nós vamos nos machucar...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hah… Ahh… \\nElluka, pare! Acalmar!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Alvo bloqueado. Ataque contínuo—", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um ataque ardente cortou o ar, seguido por um estrondo. \\nAbro os olhos, apenas para me encontrar ileso.")
	await novel_interface.show_text_only("Atrás do Administrador, o rotor principal da aeronave tomba lentamente e depois cai como um galho quebrado.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Administrador")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aham... todo mundo congela——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("A voz de Mariru soa em um alto-falante à distância.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Senhorita Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Três helicópteros aparecem no alto, e seus holofotes ofuscantes iluminam o chão de branco, como se fosse plena luz do dia.")
	await novel_interface.show_text_only("Mariru está sentado no helicóptero do meio, gritando pelo alto-falante. A enorme arma montada à sua frente ainda está fumegando.")
	await novel_interface.show_dialog("O brinquedinho de Ai realmente é incrível. Na verdade, ele destruiu o eixo do rotor com um único tiro.", "Mariru")
	await novel_interface.show_text_only("Mariru parece um pouco animada demais, como se ela adorasse disparar outra bala... Ei, essa coisa já conta como um canhão, não é?!")
	await novel_interface.show_text_only("A cabine do transporte acidentado se abre por dentro e dois pilotos saem em pânico, lutando por suas vidas.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hah… Haha…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um helicóptero pousa no terreno aberto fora da subestação. Escoltado por uma multidão de soldados fortemente armados, Mariru caminha em nossa direção animado.")
	await novel_interface.show_text_only("Tendo visto o rosto de Mariru claramente, o Administrador cuspiu ferozmente no chão.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph. Outro SID cachorrinho.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Esta não é uma operação SID. Estou aqui como conselheiro do New Opulentia Metropolitan Defense Bureau, realizando uma missão de segurança para supressão de distúrbios.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Só então percebo que as pessoas que desceram dos helicópteros não são SID agentes. Cada um deles usa uma braçadeira marcada \"MD\".")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Não é mesmo... Capitão Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Isso mesmo. O Metropolitan Defense Bureau suspeita que um ataque terrorista contra New Opulentia está em andamento aqui.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Por este meio ordeno que você e seus homens cessem imediatamente as hostilidades e voltem conosco para interrogatório.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Aquele musculoso com cara de lutador ali... Juro que já o vi antes... Ele é um dos conhecidos de Mariru?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Essas duas lindas garotas são suas subordinadas? Um departamento sem limite de idade parece muito bom...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... esse pequenino...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ei, você tem certeza que quer fazer isso?", "Administrador")
	await novel_interface.show_dialog("Esta é uma zona desmilitarizada ao abrigo do Acordo. Nenhuma de suas organizações tem autoridade para operar aqui.", "Administrador")
	await novel_interface.show_dialog("E não havia como você ter conseguido a permissão do Congresso Unido tão rapidamente!", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Essas burocracias multinacionais movem-se a passo de caracol.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... desculpe desapontar você, mas vou pegar meu pessoal e partir agora.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ Ainda não terminei de falar... A Johnson Heavy Industries, por outro lado, trabalha muito mais rápido.", "Mariru")
	await novel_interface.show_dialog("Afinal, o filho mais velho deles ainda está estudando em New Opulentia~ No momento, são eles que me pedem favores...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("O que?!", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Neste momento, três por cento da carga desta subestação já foi alimentada na rede da cidade de New Opulentia—", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("De acordo com o Acordo de Salmonton, qualquer ataque contra a rede elétrica de New Opulentia é considerado um ato terrorista de primeira classe.", "Mariru")
	await novel_interface.show_dialog("Para incidentes como este, o Metropolitan Defense Bureau detém a mais alta autoridade operacional reconhecida pelo Congresso Unido.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Afinal, nosso Aegis host… \\nNão consegue trabalhar sem energia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Como você poderia tirar Aegis da rede da cidade?! Corte os truques!", "Administrador")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Chega de conversa. Leve-os embora!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Espere! O Forte Masada e New Opulentia assinaram um acordo de imunidade diplomática há muito tempo, não foi?", "Administrador")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("O Administrador tira sua identificação do bolso do casaco e mostra-a presunçosamente para Mariru e Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Eu sou Jacob Schmidt, adido militar da Terceira Cidade Acadêmica, Forte de Masada, no Congresso Unido.", "Administrador")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se você me prender aqui, presumo que isso causará problemas diplomáticos desnecessários, não é?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("…\\nMuito bem. Você tem um minuto para sair da minha vista.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Mas parece que seu veículo tem alguns problemas... \\nEntão, talvez você precise caminhar até casa.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("O que?! Isso não é justo!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Regras são regras. Impulso de sangue quente não resolverá nada.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Mas…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, estamos indo embora.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Espere, sua identidade foi verificada, tudo bem. Mas esta menina... não creio que ocupe nenhum cargo no seu Ministério das Relações Exteriores.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Você!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Lamento, mas ela é a principal suspeita do ataque terrorista de hoje.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Se tentar capturá-la à força, tudo o que posso fazer é informar, com pesar, à sua embaixada que foi morto a tiro num ataque terrorista.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru saca uma pistola e a segura contra a cabeça de Jacob.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... Ela não passa de uma ferramenta.\\nSe você a quer tanto, então fique com ela!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Nível de potência, crítico… \\nHah… Atividade encerrada…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, que estava se forçando a continuar esse tempo todo, de repente cai no chão como uma máquina que perdeu energia.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. Nesse estado, ela provavelmente é inútil de qualquer maneira. Cuide você mesmo da sucata inútil!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob levanta o colarinho e acelera o passo, sem lançar um único olhar para trás. Logo, ele desaparece na escuridão.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, acorde! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, ajude-a por favor!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ela ainda aparece no detector de vida. Ela provavelmente está apenas exausta.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("E você – alguém que ainda precisa se proteger – está aqui gritando sobre salvar outras pessoas?", "Mariru")
	await novel_interface.show_dialog("...Você está se tornando cada vez mais um idiota de sangue quente.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Vamos para casa.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Aquela garota é nossa inimiga, não é?", "Nantetsu")
	await novel_interface.show_dialog("O Senado não exige que todos os terroristas de primeira classe sejam detidos imediatamente e então...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Faça com que cada helicóptero mantenha seus módulos anti-varredura funcionando continuamente. Farei com que os quatro UAVs de SID nos escoltem em modo de contra-ataque automático.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Meu povo, eu os acompanharei pessoalmente. Qualquer pessoa com desejo de morte pode me experimentar!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha… Esse é o Mariru que eu conheço.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru faz com que a equipe médica trate nossos ferimentos e então leva Annie, Elluka e eu a bordo do helicóptero.")
	await novel_interface.show_text_only("Annie está tão cansado. Ela se apoia em meu ombro e logo adormece.")
	await novel_interface.show_text_only("Elluka também está dormindo, esparramada no meu colo com um pouco de baba no canto da boca. Não sobrou nada daquele olhar gelado que ela tinha há poucos minutos.")
	await novel_interface.show_text_only("Afinal, ela é apenas uma garotinha comum... e por alguma razão, isso me enche de alívio.")
	await novel_interface.show_text_only("Tudo ficará bem. Tudo vai dar certo, como diz aquela música:\\nTudo vai ficar bem.")
	await novel_interface.show_text_only("Embora a paz seja agora mantida entre as seis Cidades Acadêmicas, vastas regiões fora do seu controle ainda são devastadas pela guerra.")
	await novel_interface.show_text_only("Eu me pergunto quantas crianças como Elluka ainda estão sendo usadas como armas ou ferramentas...")
	await novel_interface.show_text_only("Mariru estava certo. Sou um idiota que sempre morde mais do que consigo mastigar.")
	await novel_interface.show_text_only("Mas dificilmente conheci alguém disposto a baixar toda a guarda e adormecer pacificamente ao meu lado. Agora são dois.")
	await novel_interface.show_text_only("… Eu gosto de ser um idiota.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
