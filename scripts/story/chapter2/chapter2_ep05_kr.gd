# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("오늘 아침부터 신토요스 시내 여러 곳에서 갑작스럽게 『시공 위상 파동』 경보가 감지됐어.", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("하룻밤 사이에 뭔가가 깨어난 것처럼……", "마리루")
	await novel_interface.show_dialog("감시 위성 기록으로는, 넌 이변 구역 안에서 흔적도 없이 사라졌다가 얼마 후 반대편에 갑자기 나타났어. 게다가 옆에는 한 명이 더 있었지.", "마리루")
	novel_interface.character_dark()
	await novel_interface.show_text_only("마리루의 시선이 앤에게 향한다.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("그리고 너희 둘이 나타난 자리에서는 그런 파동이 저절로 사라졌어.", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("이변 구역, 연구 센터 말이야?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("맞아.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("그냥 기계 고장 같은 거 아닐까…… 나는 계속 큰길에 있었는걸.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("마리루의 표정이 진지해진다.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("『시공 위상 파동』 구역을 아무나 드나들 수 있다고 생각해?", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("그 파동이라는 게…… 그렇게 심각한 거야?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("정말 아무것도 모르는구나……", "마리루")
	await novel_interface.show_dialog("시공 위상은 물리 법칙의 기초야. 우주의 좌표계 같은 거지. 입자가 어떻게 운동하든 좌표축은 안정적으로 유지돼야 해.", "마리루")
	await novel_interface.show_dialog("좌표축에 흔들림이 생기면, 그 폭이 아무리 작아도 공간 안 입자의 질서엔 치명적이야.", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("만약 빌딩을 이루는 입자의 5%가 무작위로 1마이크론씩 어긋나면, 재료 구조가 완전히 파괴돼서 순식간에 붕괴하지.", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("하지만 넌 지금도 멀쩡히 뛰어다니고 있고, 그 구역의 건물들에도 구조적 파괴는 없었어.", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(게다가 기적 연구 결과에 따르면 『GHOST』를 지닌 인간은 그런 공간에 들어갈 수 없어)", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("어쨌든 넌 모든 걸 찢어발길 12급 허리케인의 눈 속으로 걸어 들어갔다가 멀쩡히 나왔고, 거기에 폭풍까지 잠재운 셈이야.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("……", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("그 이변은 나를 습격한 것들 때문에 생긴 거야,\n마치 이성을 잃은 것 같았는데……", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그만! 나는 지금 당장 원로원 브리핑에 들어가야 해——", "마리루")
	await novel_interface.show_dialog("그놈들 중엔 회의 중에 영상으로 실시간 거짓말 탐지나 돌리는 미친 인간도 있거든. 그러니 지금은 내가 아는 게 적을수록 좋아.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("원로원 설명이 참 별나네……", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("여자애는 언제 거짓말해야 하는지도 알아야 한다고~", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("난 여자애가 아니거든!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("아무튼 말 안 하면 되는 거지……", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("근래 들어 전 세계에서 이런 시공 파동이 기록된 건 4번뿐이야.\n대부분 『이물질』 수용 실패와 관련돼 있었지.", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("정체를 알 수 없는 『기적』이 갑자기 활성화되면 재앙적인 결과를 부를 가능성이 커.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("……다치는 사람이 생기겠지?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("가장 심각했던 경우엔 사망자만 수만 명이었어.", "마리루")
	await novel_interface.show_dialog("하지만 몇몇 학원도시는 이런 사건을 아주 능숙하게 『통상 사고』로 위장해 보도했지……", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("가스 누출이나 항공 사고, 테러 같은 걸로……", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("그럼 이번에는……", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("이번은 예전과 달라. 이렇게 대규모로 연속 폭발한 적은 한 번도 없었어……", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("홍보 시나리오의 최고 대응 등급마저 넘어섰으니, 이젠 거짓말로도 둘러댈 수 없을 거야.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("이번 일도 나 때문일까,\n내가 뭔가 도울 수 있다면……", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("쓸데없는 생각은 마. 네 몸의 변화가 이번 일과 관련됐을 가능성은 높지만, 너 혼자서 이런 대형 사건을 일으킬 순 없어.", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("단서를 찾고 싶다면 내 사람과 함께 현장을 둘러봐.", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(그럴 가능성이 있다면, 지금 그녀가 유일한 대응책이야……)", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("하지만 절대 무리하면 안 돼. 그리고 누구에게도 네 일을 말하지 마. 알겠어?", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("다른 사람한테 말하지 말라는 건……\n내가 원래부터 여자였던 척하라는 거야?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("너도 알잖아……\n신토요스는 줄곧 과학 지상주의를 통치 이념으로 내세워 왔어.", "마리루")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("네 경험을 공개하면 『실험 대상』으로 분류돼서 연구 기관으로 끌려가겠지~", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("그때쯤이면 평생 과학에 몸 바치겠다고 맹세한 아저씨들이 줄 서서 네 몸을 연구하려 들걸……", "마리루")
	await novel_interface.show_dialog("이렇게 귀여운 여자애를 좀처럼 만나기 힘드니까——", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("……아, 알았어!!", GameConfig.player_name)
	await novel_interface.show_dialog("나…… 절대 함부로 말 안 할게!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
