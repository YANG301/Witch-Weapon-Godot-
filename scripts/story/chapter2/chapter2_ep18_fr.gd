# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("C'est un après-midi d'été torride. Je dépose une pile de papiers à côté de la table ronde dans la cour et m'affale sur une chaise à l'ombre sous les arbres.")
	await novel_interface.show_text_only("Il y a quelque temps, j'ai vu cette jolie fille aux prises avec sa pile de livres. Je n’y ai pas réfléchi à deux fois et je lui ai donné un coup de main.")
	await novel_interface.show_text_only("Puis elle s'est dépêchée, bien que heureusement. C'est à ce moment-là que j'ai réalisé que j'étais un idiot.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ouf... Laisse-moi faire une pause ici... Il fait tellement chaud.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hélas, c'était du gâteau pour moi quand j'étais petit.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Et puis il y a cette SID formation à venir... Mon Dieu, je peux me cacher quelque part ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, faites attention à vos manières.... \\nC'est une école.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Hé, Annie ! \\nQuoi de neuf ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Écoute... Je sais qu'il fait chaud. \\nBut... is it really necessary to lift up your shirt to wipe sweat off?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Je veux dire… Attention à un dysfonctionnement de garde-robe…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Merde !", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Cette fille Lian est tellement impolie...", "Étudiant A")
	await novel_interface.show_dialog("Ouais, je l'ai vue écarter les jambes l'autre jour, portant une jupe.", "Étudiant B")
	await novel_interface.show_dialog("Vraiment ? Beurk…", "Étudiant A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(Je n'aurais pas dû porter de jupes en premier lieu, d'accord ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hé…")
	await novel_interface.show_text_only("Quelle voix douce.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Utilisez mon mouchoir si cela ne vous dérange pas.", "Fille élégante")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Devant moi se trouve une fille belle et élégante. \\nElle a de longs cheveux violets soyeux et des yeux lilas.")
	await novel_interface.show_text_only("Elle me tend un mouchoir au parfum exquis et frais.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Hein ?! \\nMerci… Merci.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Vous êtes les étudiants transférés de première année, n'est-ce pas ? \\nJe m'appelle Nix Strozzi. Je suis ton aîné.", "Nix")
	await novel_interface.show_dialog("Je t'ai vu transpirer, et il se trouve que j'ai mon mouchoir avec moi, alors... \\nJ'espère ne pas vous interrompre.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix me fait un signe de tête poliment, mais je panique. Je me lève et salue d'une manière assez bête.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Non... pas du tout ! \\nC'est d'une grande aide !", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Elle semble très aimable.) \\n(Est-elle une étrangère ? Regardez ces longs cils...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je regarde le visage délicat de Nix, mon cœur battant la chamade.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Mon plaisir. \\nDonc... votre nom est...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Je suis Lian. Elle est Annie. \\nNous venons d'être transférés ici récemment.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie ?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix semble confus et regarde Annie, quoique brièvement.")
	await novel_interface.show_text_only("Puis elle sourit amicalement à Annie. Je me demande si ce n'était que mon illusion à l'instant.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heureux de vous rencontrer aujourd'hui.", "Nix")
	await novel_interface.show_dialog("Mais je dois y aller maintenant. Faites-moi savoir si je peux faire quelque chose pour vous aider.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Merci, Nix !", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie hésite sans aucune réponse.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cette fille, Nix..., elle a l'air beaucoup plus classe que n'importe laquelle de ces filles à la cuillère d'argent.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, ça va ? \\nVous êtes resté silencieux.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("A-t-elle dit qu'elle était une Strozzi ?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh, tu la connais ?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie me prend le bras et me fait un sourire innocent.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Non. \\nNous sommes nouveaux ici. Comment pourrais-je la connaître ?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ouais, tu as raison.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
