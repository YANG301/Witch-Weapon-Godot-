# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie ya se ha instalado en la habitación de al lado. Hay algunas cosas que necesito decirte a solas.", "Mariru")
	await novel_interface.show_dialog("Acabo de recibir confirmación.", "Mariru")
	await novel_interface.show_dialog("Desde esta mañana, han aparecido anomalías espacio-temporales a gran escala en varias ciudades importantes...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Las regiones afectadas que conocemos hasta ahora incluyen Hovering Palace, Newmoridas, Masada Fort, Salmonton, New Opulentia y las islas Lebona.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Entonces, ¿eso no significa...\nlas seis Ciudades Academia...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Así es. El mundo entero está observando esto ahora y la escala del impacto ha superado con creces las expectativas.", "Mariru")
	await novel_interface.show_dialog("Creo que... puede haber una posibilidad...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Todo lo que describiste experimentando en tu sueño: los terroristas atacando el centro de investigación, la ciudad reducida a ruinas...", "Mariru")
	await novel_interface.show_dialog("...todo eso puede haber sucedido realmente.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¡¿Cómo es eso posible?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("No tengo pruebas concluyentes, pero es posible que esta mañana ya haya ocurrido una distorsión dimensional masiva.", "Mariru")
	await novel_interface.show_dialog("El satélite True Sight de SID también detectó una explosión de ruido anormalmente violenta.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Quizás esto haga que sea más fácil de entender: New Opulentia realmente fue destruido una vez, pero algún tipo de fuerza revirtió esa realidad...", "Mariru")
	await novel_interface.show_dialog("Y esa fuerza también parece estar conectada con los cambios en tu cuerpo, así como con los ataques de esos extraños enemigos.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Por supuesto, esto sigue siendo sólo mi hipótesis.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Esa idea... ¿no es demasiado atrevida...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Debido a los eventos de hoy, las otras cinco Ciudades Academia están presionando al Senado para permitir la entrada para la investigación.", "Mariru")
	await novel_interface.show_dialog("Y si su conexión con este incidente queda expuesta, que una institución de investigación se lo lleve será el menor de sus problemas...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Los agentes de todas las organizaciones de inteligencia lo marcarían como un objetivo clave.", "Mariru")
	await novel_interface.show_dialog("Sin contar a los que ya están encubiertos, más de cien agentes de inteligencia de varios países ingresaron hoy a New Opulentia solo con identidades falsas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Sabes todo eso con tanto detalle?\n¿Por qué no los detienes?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmph. Es mejor mantener la situación bajo control en la oscuridad que obligarlos a cambiar de cara y desaparecer de la vista.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", debes entender esto: mientras tengas el cuerpo de una niña, nunca podrás volver a tu antigua vida.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Aún así, el hecho de que nosotros en SID te encontráramos primero puede ser un golpe de suerte.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Convertirme en niña de la noche a la mañana...\n¿Cómo se supone que voy a explicarles eso a mis compañeros de clase y amigos...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... ¿no estás preocupado por tus padres?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mi madre murió cuando yo era pequeña.\nMi padre... ya lleva muchos años desaparecido...", GameConfig.player_name)
	await novel_interface.show_dialog("Viví en un internado hasta los doce años.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Entonces, después de todo, el programa de cuidado infantil del gorila de posguerra realmente ayudó a algunos niños).", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, ya has tenido tu parte de dificultades.\nAún así, no necesitas preocuparte por el problema de la transición de identidad.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Transición de identidad...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Una sonrisa bastante siniestra aparece en el rostro de Mariru...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
