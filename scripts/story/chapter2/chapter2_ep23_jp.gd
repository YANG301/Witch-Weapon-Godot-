# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("イルカは電撃の魔法を使って、\n俺とアニーに襲いかかってきた。\n彼女を傷付けたくない俺達は、否応なく防御に\n徹するしかない。")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("このままじゃ共倒れになるだけよ……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("はぁ……はぁ……\\nイルカ、落ち着くんだ！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("目標捕捉、攻撃続行――うッ！？", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然のまぶしい光が空を劈き、巨大な音が\\n辺りを包む。\\n目を開けると、自分達が怪我をしてない事に\\n気が付いた。")
	await novel_interface.show_text_only("管理人の後ろに鎮座していた輸送機の主回転翼が\\n片方向に向かって傾く。\\nそしてゆっくりと、枝が折れるかのように\\n地面へと落ちた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ッ！？", "管理人")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("コホン……\\n\\n全員戦闘を停止せよ――ッ！", "マリル")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("遠くから、拡声器を通したマリルの声が\\n聞こえてくる。")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("マリルさんっ！！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("上空には3機ものヘリが飛翔していた。\\n彼らの地上を照らすサーチライトの光は、\\nまるで周りが昼にでもなったかのように明るい。")
	await novel_interface.show_text_only("拡声器を持つマリルが真ん中のヘリに\\n乗っているのをうかがえる。\\n彼女の目の前にある巨大な銃器からは、\\n煙が出ていた。")
	await novel_interface.show_dialog("愛衣の製作したコイツも役に立つじゃないか。\\nまさかプロペラの主軸を一撃でぶっ壊せるとは。", "マリル")
	await novel_interface.show_text_only("マリルは興奮気味に、もう1発撃ちたそうに\\nしているが……\\nおいおい、あれはもはや大砲だろ……！！")
	await novel_interface.show_text_only("墜落した輸送機のコクピットが開く。\\n\\n辛うじて生きていた2人のパイロットは、\\n一目散に逃げ去った。")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("はっ……はは……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ヘリが変電所の外の空き地に着陸した後、\\nマリルは威風堂々と俺達の方に向かってくる。\\n背後には完全武装の兵士達が何人も続いていた。")
	await novel_interface.show_text_only("ようやくマリルの顔を確認できると、\\n管理人と呼ばれた男は不機嫌な声で呟いた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ふんっ。　SIDの犬め。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("今回はSIDとは関係ないぞ。\\n\\n私は単に新豊洲都市防衛庁の顧問として、防犯と\\n安全保障に関する任務を遂行しているだけだ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("よく見ると、ヘリから降りて来た部隊は\\nSIDの捜査員ではなく、\\n全員が「MD」の臂章を付けていた。")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("そうだろう、南哲隊長？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("全くもってその通りだ。\\n\\n現在、都市防衛庁はこの場所で、新豊洲に対する\\nテロ活動があったと疑っている。", "南哲")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("あんたとあんたの部下は直ちに攻撃を停止し、\\nご同行を願おう。調査にご協力を。", "南哲")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("あのレスラーみたいな筋肉男、\\nどっかで見た覚えが……\\nマリルの知り合いか？", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そこの可愛らしい女の子2人が君の部下かい？\\n年齢制限がない部門はいいなぁ……\\nうん？　このお嬢ちゃん……", "南哲")
	await novel_interface.show_dialog("うん？　このお嬢ちゃん……", "南哲")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("おやおや、このような無茶な真似をしても\\nよろしいのですかな？", "管理人")
	await novel_interface.show_dialog("ここは『協定非武装地域』です。\\n\\n君達の所属する組織が、この場所の行動権限を\\n持ち合わせているなら、話は別ですが。", "管理人")
	await novel_interface.show_dialog("この短時間で、連合議会の許可を得る事などは\\n不可能でしょう。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("確かに、多国籍で共同統治している官僚機構の\\n業務速度はカタツムリに等しい。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ふん…がっかりさせた所で申し訳ありませんが、\\n既に用事は済みました。\\n私どもは、これにて立ち去らせて頂こうかと\\n思います。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("お～っと話を最後まで聞け…あのカタツムリの\n許可がなくとも、江森重工は対応が迅速でな。", "マリル")
	await novel_interface.show_dialog("お～っと話を最後まで聞け…あのカタツムリの\\n許可がなくとも、江森重工は対応が迅速でな。\\n変電所の持ち主からの直々の頼みとあらば、\\n私達も動かざるを得ない……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("な、なんだとっ！？", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("現在、この変電所からの約3％の電力が、\\n新豊洲都市の送電網に組み込まれている──", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("《サモントン協定》によると、\\n第五学園都市送電網への攻撃は──\\n……全て第一級テロ活動と見なされる。", "マリル")
	await novel_interface.show_dialog("都市防衛庁はこうした活動に対して、\\n連合議会が認める最高行動権を所持する事となる\\n……というわけだ。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("だってうちの『イージス』のメインサーバーは\\n電力で動いてるからな～～", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ふざけるなッ！ 都市送電網ぐらいでイージスを\\n動かせる訳がないだろうが！\\n詭弁を垂れるなッ！！", "管理人")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("無駄話はそこまでだ！　連れて行け！！", "南哲")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…………待ちなさい\\n\\nマサダブルクと新豊洲は、外交特権協議を\\n結んでいますよね？", "管理人")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("「管理人」はコートの内ポケットから証明書を\\n取り出し、得意げにマリルと南哲に見せつけた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("私は第三学園都市マサダブルクから派遣された\\n駐連合議会武官ヤコブ・シュミットです。", "管理人")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("……", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そう…もしも……もしもの事ですが、\\n皆様がここで私を逮捕したとなると──\\n──不必要な『外交摩擦』が発生してしまう\\nかもしれませんね……？", "ヤコブ")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("…………チッ\\nなら1分以内に、私の視界から消え失せろ。", "マリル")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("ただ……お前の乗り物はちょっとした故障を\\nしているようだ。\\nこいつは自力で歩いて帰ってもらうしかないな。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("なんで！？　どうして見逃すんだ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("『ルール』はルールだ。\\n熱血だけでは問題を解決できない。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("でっ、でも……っ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("イルカ、来なさい。", "ヤコブ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("で、ルールに則りお伝えするが……\\n私はお前の証明書しか見てないぞ？\\nまさかお前達の外交部は子供に職務を与えている\\nとでも言うのか？", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("──貴様……ッ！", "ヤコブ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("すまないなぁ、そいつはテロの重要な容疑者だ。", "マリル")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("強引に連れて行くというなら、お前達の大使には\\n大変残念なお知らせをしなくてはならない。\\n不幸にも駐連合議会武官ヤコブ・シュミットは、\\nテロリストに襲撃され頭を撃ち抜かれました　と", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは拳銃を取り出し、ヤコブと自称してる男の頭に突き付けた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ふんっ……こいつは所詮、ただの道具だ。\\n貴様らが欲しければくれてやる！", "ヤコブ")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("エナジー、低下……\\nはぁ……はぁ……活動、停止……", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("先ほどから辛うじて持ち堪えていたイルカが、\\n突如電源が切れたかのように地面に倒れた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ちっ、それだけダメージを受けた破損品なんぞ\\nどうせもう使えないだろう。\\n役立たずのゴミ処理は貴様らにお任せする。", "ヤコブ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ヤコブは足早にコートの襟を直し、\\n振り返りもせず、夜の帳の中に姿を消した。")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("イルカ、起きてッ！　起きてッ！", "小憐")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("マリル、お願いだ。\\nイルカを助けてくれ……！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("安心しろ。ライフセンサーはまだ反応している。\\nただの疲労で倒れただけだろう。", "マリル")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("と言うかお前こそ早急に手当てが必要な状態\\nだというのに…\\n自分よりも誰かを助けてと叫ぶなんてな。", "マリル")
	await novel_interface.show_dialog("──ますますの熱血バカか、お前は。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("とりあえず、家に帰るぞ。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("おいおい、その娘は敵の戦闘員なんだよな？", "南哲")
	await novel_interface.show_dialog("元老院は第一級テロリストに対して、\\n即座に監禁するようにと……", "南哲")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("全てのヘリにアンチスキャンモジュールを\\n絶え間なく作動させるように伝えろ。\\nSIDのUAVを4機自動反撃モードへ移行。\\n護衛を務めさせる。", "マリル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("『全員』私の連れだ\\n──私が直に護送する。\\n死にたいヤツはかかってこいッ！", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("ハッハッハッ……君らしいな。", "南哲")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("マリルは医療班に俺達の傷の応急処置を頼んだ。\\nそれから俺達はマリルに付いて行き、\\nヘリコプターへと乗り込んだ。")
	await novel_interface.show_text_only("アニーも疲れていたのか俺の肩に寄りかかり、\\n直ぐに夢の中へと入っていった。")
	await novel_interface.show_text_only("イルカも俺の膝の上で寝そべり、\\n口元からヨダレを垂らして寝ている。\\n先ほどまでの氷のような表情は、\\nもう見当たらない。")
	await novel_interface.show_text_only("ただの普通の女の子じゃないか……\\nなんだか急に安心できた……")
	await novel_interface.show_text_only("大丈夫だよ、全て上手く行くさ。\\nあの歌のように──\\n──Everything is gonna be OK。")
	await novel_interface.show_text_only("六大学園都市の間では平和を成し遂げているが、\\n\\n勢力圏以外の地区では、未だ戦争の火の手が\\n上がり続けている。")
	await novel_interface.show_text_only("イルカのような子供が……\\n\\nどれだけの子供が武器や道具として、\\n扱われているのか……")
	await novel_interface.show_text_only("マリルの言いたい事は分かる。\\n俺が身の程知らずのバカだって言いたいのを。")
	await novel_interface.show_text_only("だけど幼い頃からの記憶を振り返っても、\\nこんなにも近くで警戒心を解いて、\\n眠ってくれる人なんて、出会った事はなかった。")
	await novel_interface.show_text_only("うん……俺は……\\nバカでもいいや。")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
