# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("回到公寓之後，一直處於睡夢中的伊露卡抓著我的衣服，說什麼也不肯放手。")
	await novel_interface.show_text_only("安妮和莉琉叫我轉身不許偷看並組成人牆，把伊露卡的金屬手甲和破損的外套脫下換成了普通的衣服") #换行问题
	await novel_interface.show_text_only("然後她們叫我以生命擔保不會做什麼奇怪的事情之後，才允許我把伊露卡抱回自己的房間。")
	await novel_interface.show_text_only("……現在伊露卡躺在我的床上，抓著我的衣服繼續呼呼大睡，我只得陪坐在床邊。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("小孩子這麼黏人嘛……\\n好累啊～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("經過一晚的行動，我也四肢痠軟，無力地癱倒在一旁，無意中碰到了放在口袋裡的那疊紙。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("這是安妮所說的……「魔導書殘頁」？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("剛才伊露卡好像也很想要呢，還用小動物似的眼神看著我……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我躺在床上仔細看了看，腦袋還是一片混沌，根本無法識別上面的內容。")
	await novel_interface.show_text_only("在我想翻看其他頁的時候，幾張紙從手中滑落到伊露卡身上。")
	await novel_interface.show_text_only("接觸到伊露卡的紙張突然發出藍色的光芒。")
	await novel_interface.show_text_only("大量記載著某種資訊的符文湧出的同時，甚至連屋內的空氣也震動起來。")
	await novel_interface.show_text_only("隨後我手上的書頁也好像被某種力量拉扯著，全都飛到了伊露卡身上。")
	await novel_interface.show_text_only("在一陣炫目的強光之後，所有書頁都消失不見了。")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("這、這是——！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("探索開始，發現目標——\\n巧克力……姐姐！", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("伊露卡？ ！妳醒了？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡一把抱住我，與此同時大門在我的身後被用力地端開。")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("喂，剛才的震動是怎麼回事？\n……哇啦！你終於對伊露卡下手了嗎？", "安妮")
	novel_interface.character_dark()
	await novel_interface.show_text_only("安妮用一種古怪的眼神看著我。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("不是妳想的那樣啊，請聽我解釋！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("能量，充滿。 \\n搜尋……未找到。", "伊露卡")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("怎麼了，妳要找誰嗎？", "小憐")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("……裁判所，管理員。", "伊露卡")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("裁判所……是什麼啊？ \\n總之，我們先找莉琉來想想對策吧。", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("裁判所……妳可真會給我找麻煩，居然把「教團」的人帶回來了。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("哎？ ！那是什麼？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("為了調查魔女的記錄，我在文獻中查到了一些奇怪的地下組織，最古老的就屬「教團」了。", "莉琉")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("但教團似乎分裂成好幾個派系，「裁判所」就是其中的一支。", "莉琉")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("那個派系是幾百年前分裂出來的，成天叫囂著要消滅一切魔女，是當年「魔女狩獵」活動的主力。", "莉琉")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("我最討厭這種不科學的團體扯上關係了。", "莉琉")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("之前只是想給伊露卡安排到新豐洲的保育學校……\\n不過既然如此，看來是不能輕易放她離開了～", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("莉琉其實是另有目的吧，不要私下做什麼研究試驗啊……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("在妳心中，我就那麼壞嗎？", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉彈了一下我的腦袋。 \\n伊露卡鼓著嘴，有些不高興地盯著莉琉。")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("目標判定，危險指數，極高。", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("……這小鬼。", "莉琉")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("對了，伊露卡，那個叫雅各的男人，究竟要讓妳執行什麼任務？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡皺著眉頭，慢慢地回憶起來——")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("一，清理女巫，完成\\n二，獲取手稿，失敗。", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("手稿？ 不是在小憐那裡嗎？", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("搜尋……狀態異常。 \\n手稿……已消化。", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("消化是指……那些書頁已經和妳合為一體了？ \\n還是說那些本來就是伊露卡魔導書的一部分？", "小憐")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("管理員不許妳消化……\\n是害怕妳能力變強後就無法控制吧？", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("居然能把伊露卡的話翻譯成這麼詳細的內容，小憐妳果然超厲害的！", "安妮")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("等等，伊露卡的魔導書？ \\n也就是說……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("這小丫頭也是「魔女」嗎？", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉立刻上前嘗試捏伊露卡的臉，但被伊露卡小心地躲開。")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("早聽說有組織試圖製造並控制魔女，真是什麼年代都有野心家想擁有超級士兵啊。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("為什麼妳們好像都對魔女很熟悉……就我一個還搞不清楚，究竟怎麼樣才會變成魔女啊？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("嗯，一開始我也不太清楚呢。 只記得那時候，糊裡糊塗地看了那本書。", "安妮")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("看的時候感覺大腦發麻，越往後越難懂，之後就能感覺到身體被某種力量浸染了。", "安妮")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("後來有一天，我默唸了其中的一句咒語，接著就被捲入那個異次元空間……", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("說到空間……其實妳們倆到達變電所的時候，衛星就偵測到那裡的時空相位波動已經消失了。", "莉琉")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我就說沒有之前在異變區域的那種感覺呢！", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("妳所說的異變區域，古代記載魔女的文獻上稱為「魔女之繭」。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("是人類轉變為魔女時形成、外人無法打破也不可能進入的結界，與異質物造成的空間性質很像吧？", "莉琉")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("而在變電所的波動消失的幾乎同時，衛星偵測到到了光學訊號——", "莉琉")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("就是與妳們開戰的傢伙，出現了。", "莉琉")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("仔細想想，「魔女之繭」這個名字……那些傢伙在繭消失的同時出現，就好像被孵化出來的一樣。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("女巫，消滅！", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("所以女巫果然是指無法承載魔導書上的資訊，因而喪失心智的人吧！ ？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("她們應該只是普通的少女，因為無法承載手稿上的魔法，在閱讀過程中遭到了反噬。", "安妮")
	await novel_interface.show_dialog("引起空間巨變同時，連自己也變成了……\\n被稱為「女巫」的怪物。", "安妮")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("很多古書上也有類似的記載，知道越多關於魔法的資訊，越會讓人陷入無法回復的瘋狂狀態。", "莉琉")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("掌握魔法又失去心智的女巫會造成巨大的破壞，如果真的是這樣的話……", "莉琉")
	await novel_interface.show_dialog("這或許就是歐洲的「魔女狩獵」運動持續了那麼久的原因之一。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("什麼啊，這根本就像病毒感染一樣啊。", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("從目前的資訊推斷，伊露卡的管理員把殲滅女巫作為第一目標，進而想要回收魔導書的殘頁。", "莉琉")
	await novel_interface.show_dialog("但並不允許伊露卡使用魔導書……或許是想以此製造更多的魔女。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("可是我也看了伊露卡的魔導書，卻連一個單字都念不出來。 這和我本來是男生有關嗎？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("……男生？", "伊露卡")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("伊露卡有些緊張，向後退了兩步，露出疑惑的表情。")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("呃，伊露卡，這件事情先放到一邊，\\n不要在意……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("我就可以讀呀，小憐不會是笨蛋吧？", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("比起這個，我更想知道妳到底用了什麼辦法，能輕易進入「魔女之繭」。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("我也不想啊！ 每次進去都有人想打我……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("——這種行為已經跨越了多層維度，目前無法從科學的角度解釋清楚。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("如果能解釋的話，那我首先想知道的，是為什麼我會變成女生啊！")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("嘿嘿，不要煩惱啦，現在搞不明白的事，總有一天會知道原因的嘛！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("妳還真是樂觀啊……", "小憐")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
