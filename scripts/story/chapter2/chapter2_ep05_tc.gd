# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("從今天早上開始，我們突然偵測到新豐洲市內多處發生了「時空相位波動」的警報。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("就好像在一夜之間，有什麼東西覺醒了一樣……", "莉琉")
	await novel_interface.show_dialog("監控衛星顯示，妳曾經憑空消失在異變區域內，不久後卻突然出現在另一邊，身邊還多了個人。", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉眼神看向安妮。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("然後，在妳們兩個出現的地方，這種波動就消失了。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("異變區域？ 是研究中心嗎？", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒錯。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("會不會是機器故障什麼的……我可是一直都走在大馬路上啊。", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("莉琉的表情變嚴肅了。")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳以為，隨便什麼人都能出入「時空相位波動」的區域嗎？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("那個什麼波動……很嚴重嗎？", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("唉，妳還真是什麼都不懂……", "莉琉")
	await novel_interface.show_dialog("時空相位是物理法則的基礎，就像宇宙的座標系。 無論粒子如何運動，座標軸都必須保持穩定。", "莉琉")
	await novel_interface.show_dialog("如果座標軸出現波動，即使幅度再小，對空間內粒子的秩序也會具有毀滅性。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("如果一棟大樓有5%的粒子隨機偏移1微米，就會徹底破壞建材結構，導致建築瞬間坍塌。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("但妳現在還活蹦亂跳，那片區域的建築物也沒出現結構性的破壞。", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（重點是，根據神蹟研究的結果，擁有「GHOST」的人類是不可能進入那種空間的。 ）", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("總之，妳相當於走進了一個可以撕裂一切的十二級暴風中心，結果不但完好無缺地走出來，還平息了風暴。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("……", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("所以，異變是那些襲擊我的東西造成的嗎？ \\n好像是失去理智的……", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("打住！我馬上要去給元老院做簡報——", "莉琉")
	await novel_interface.show_dialog("他們當中有個神經病喜歡在會議過程中對影片作即時分析與測謊，所以現在我知道的越少越好。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("妳對元老們的描述真是特別……", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("女孩子要懂得什麼時候才可以說謊哦～", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("我說了我才不是什麼女孩子！ ！", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("唉，總之我什麼都不說就是了……", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("近幾年來，全世界只有4次這樣時空波動的記錄，\\n大多都與「異質物」的收容失效有關。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("特性不明的「神蹟」突然激發，很可能會導致災難性的後果。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("……會有人受傷嗎？", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("當然，最嚴重的一次光罹難者就有幾萬人。", "莉琉")
	await novel_interface.show_dialog("不過幾大學園都市都很有默契地將這些事件偽裝成「一般事故」加以報導……", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("像是瓦斯外洩、飛機失事、恐怖攻擊之類的……", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("那這次……", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這次與以往不同，從沒遇過這麼大規模的連續爆發……", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("超出了宣傳方式的最高預設等級，恐怕是什麼謊話都編不出來了。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("這次會不會是因為我？ \\n如果我能幫上什麼忙的話……", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("別想太多，雖然妳身體的變化很可能與此有關，但光憑妳還鬧不出這麼大的動靜。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("不過如果妳想尋找線索，倒是可以跟我的人去現場看看。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（如果有像她說的那種可能，那她現在的確是唯一的對策……）", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("但是，絕不可以勉強自己，也不要跟任何人說自己的事，明白了嗎？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("不能跟別人說……也就是說……\\n我要假裝自己本來就是女生嗎？", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳也知道吧……\\n新豐洲市一直都奉行科學至上的理念。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("如果妳公開自己的經歷，就會被定義為「實驗物件」，然後被帶去研究機構喲~", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("到時鐵定會有一群發誓終身獻給科學的大叔排隊等著研究妳的身體唷……", "莉琉")
	await novel_interface.show_dialog("畢竟難得遇到這麼可愛的女孩子嘛——", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("……這太恐怖了！ 我明白了！ ！", GameConfig.player_name)
	await novel_interface.show_dialog("我……我絕對不會亂說！", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
