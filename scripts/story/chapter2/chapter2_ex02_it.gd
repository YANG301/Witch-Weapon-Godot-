# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Mi guardo allo specchio all'angolo del corridoio. \\nLe mie ciglia piene di lacrime si muovono su e giù mentre respiro.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Infatti... sono una ragazza adesso?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Laggiù... Non c'è più...)", "Lian")
	await novel_interface.show_dialog("(In questo caso...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Come... come farei a fare una pisciatina...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Pesca intorno a...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Cosa stai facendo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Waaaah!!", "Lian")
	await novel_interface.show_dialog("Non è... Uhm... \\nScusa!! Non volevo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Ahah. Scusa per cosa? \\nPer toccarti?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(Cosa... cosa posso fare?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Ehm...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Come fanno le ragazze... come fanno...", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa? Cosa vuole da me? Per favore sii specifico.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Come usano il bagno?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?!", "Mariru")
	await novel_interface.show_dialog("Ahahah…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Finalmente lo dico ad alta voce! Non prendermi più in giro...)", "Lian")
	await novel_interface.show_dialog("(Ma sembra che non ce la faccio più...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Ehi... non ridere di me!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Siediti e fai il lavoro. Semplice proprio così.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Il bagno delle ragazze è in fondo al corridoio. Mossa!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pffff. Esitò per un momento... \\nE alla fine si precipitò dentro piangendo.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Così... carino!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (lavaggio con acqua)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ahh. Finalmente rilassati.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Aspetta... Come...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Come posso scrollarlo di dosso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Fatto? Come ti senti a riguardo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("È una questione privata!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Non c'è da stupirsi se ho sentito che nel bagno delle ragazze spesso finisce la carta igienica...)", "Lian")
	await novel_interface.show_dialog("Waaaah... \\nCosì imbarazzante...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Dannazione!! \\nDevo tornare alla vecchia me! Non vedo l'ora!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
