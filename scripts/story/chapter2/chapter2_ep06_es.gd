# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Murmurando) Ese pequeño mocoso era mucho más interesante...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un mensaje de conexión de llamada de voz parpadea en la pantalla en diagonal frente a Mariru. La voz electrónica deliberadamente distorsionada enmascara el género original del hablante.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(He hecho esta sesión informativa muchas veces, pero este formato de interferencia cifrada unilateral todavía es exasperante).", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Entonces, respecto a la desaparición del Ross Goblet, ¿cómo avanza la investigación ahora?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("A las 00:15 de esta mañana el sistema de seguridad confirmó que el Ross Goblet había desaparecido.", "Mariru")
	await novel_interface.show_dialog("A las 06:40, el sistema de monitoreo satelital True Sight emitió una advertencia luego de detectar una severa distorsión dimensional.", "Mariru")
	await novel_interface.show_dialog("Luego, desde las 07:00 de esta mañana hasta ahora, el sistema Aegis ha detectado seis alertas de fluctuación de fase del espacio-tiempo dentro de New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Y si tomamos como centro el instituto de investigación, treinta y dos alertas similares aparecieron simultáneamente en un radio de mil quinientos kilómetros...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Todo eso ya está en el documento. Dame la conclusión.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mira por encima de su hombro derecho y sonríe.")
	await novel_interface.show_text_only("Sólo por el tono, puede decir que es el severo y serio director ejecutivo de Senado.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—Esto no fue un robo. Fue el despertar de un Substance H, junto con la reacción en cadena que desencadenó.", "Mariru")
	await novel_interface.show_dialog("Y a juzgar por la frecuencia y escala actuales, todavía no podemos determinar si es de tipo memético Substance H.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el instante en que Mariru termina de hablar, murmullos de sorpresa y discusiones en voz baja se propagan a través de las pantallas oscuras que la rodean.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("¡¿Qué?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una voz profunda y firme proviene de la izquierda de Mariru.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("¿Te refieres a un brote exponencial de un \"Toque Divino\" enajenador?\nEso sí que es interesante...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Por el momento, parece más probable que se produzcan varios incidentes al mismo tiempo.\n\"Divine Touch\"... No me gusta especialmente la terminología imprecisa.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Aunque él es la autoridad en Substance H... enajenantes)", "Mariru")
	await novel_interface.show_dialog("(Aún no puedo evitar la sensación de que este gorila le frió el cerebro con demasiada radiación).", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Entonces según tu criterio...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("No hay manera de que pueda enviar un informe de conclusión todavía. Simplemente no tenemos suficiente información procesable.", "Mariru")
	await novel_interface.show_dialog("Dada la situación actual, solicito una orden de investigación Clase S sin restricciones. Espero que todos puedan entender.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ignorando los susurros a su alrededor, Mariru vuelve su atención a la terminal portátil.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Esa niña fue a otra zona de anomalía...)", "Mariru")
	await novel_interface.show_dialog("(Como era de esperar, ella desapareció, reapareció un rato después y luego la fluctuación de fase cercana se detuvo nuevamente).", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Las imágenes de la escena ... ¿tiene sangre?)", "Mariru")
	await novel_interface.show_dialog("(¡¡Ese idiota... no me digas que ella en realidad—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Pareces un poco distraído.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué?... Para nada.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Lo que sea que estés mirando, ¿contiene información más importante que este informe?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...No, es solo un video de un gatito. ¿Quieres verlo?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Un agudo chirrido eléctrico y un zumbido surgen desde la izquierda de Mariru.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("No te enojes tanto. Un poco de diversión mejora la eficiencia del trabajo.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru recorre con la mirada la habitación. Parece que nadie se dio cuenta del desliz momentáneo de hace un momento.")
	novel_interface.character_light()
	await novel_interface.show_dialog("En cualquier caso, la inteligencia básica que hemos obtenido hasta ahora es exactamente como se indica en el informe.\nEl incidente aún está bajo investigación.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Si no hay preguntas, me dirijo a la escena.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Antes de que Mariru pueda irse, una voz un tanto frívola proviene de su izquierda.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...Escuché que tus subordinados trajeron a dos estudiantes de secundaria a SID para interrogarlos.", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Ese desagradable bastardo otra vez.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("¿Había algo especial en ellos, señora Mariru... no, doctora?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Nada en absoluto. Ya lo hemos confirmado: eran sólo dos gatitos demasiado curiosos que se colaron en una zona restringida.", "Mariru")
	await novel_interface.show_dialog("Me encargaré de que los envíen a casa después.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ya veo. Entonces está bien.", "#C")
	await novel_interface.show_dialog("En un momento delicado como este, sería problemático si otros países comenzaran a tratarlos como una especie de existencia extraña...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Ese comentario provoca un alboroto entre los demás.")
	await novel_interface.show_text_only("...¿Qué se supone que significa eso?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Estoy seguro de que un comentario descuidado puede incomodar a algunas personas.\nMis disculpas, finge que nunca lo escuchaste.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Qué hombre tan detestable.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Bueno, entonces, de todos modos, este incidente ya ha llamado la atención de las otras Ciudades Academia.", "Bright")
	await novel_interface.show_dialog("Confiaremos en usted para la investigación clasificada y el manejo de la información pública de ahora en adelante.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Naturalmente.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
