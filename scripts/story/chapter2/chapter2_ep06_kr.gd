	await novel_interface.show_dialog("지금 자네가 보고 있던 것, 그 보고 내용보다 더 중요한 정보라도 있나?", "자일즈")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……뭐, 새끼고양이 영상일 뿐인데요. 보시겠어요?", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "자일즈")
