	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(그가 정신 영향류 『이물질』의 권위자이긴 하지만……)", "마리루")
	await novel_interface.show_dialog("(하지만 이 고릴라는 방사능을 너무 많이 쐬어서 뇌가 맛이 간 것 같아)", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("그렇다면 자네 판단은?", "브렛")
