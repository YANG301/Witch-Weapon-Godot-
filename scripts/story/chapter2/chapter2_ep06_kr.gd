	await novel_interface.show_dialog("……\n(정말 재수 없는 자식이네.)", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("좋아, 어찌 됐든 이번 사건은 다른 학원도시들의 주목을 끌어 버렸네.", "브렛")
	await novel_interface.show_dialog("이후의 기밀 조사와 대외 정보 유도 역시 자네에게 맡기겠네.", "브렛")
