	await novel_interface.show_dialog("뭐 특별한 점이라도 있었나, 마리루 각하…… 아니, 박사.", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……아니요. 방금 확인을 끝냈는데, 그저 호기심이 지나쳐 봉쇄 구역으로 기어들어온 새끼고양이 두 마리일 뿐입니다.", "마리루")
	await novel_interface.show_dialog("이후엔 사람을 붙여 집까지 돌려보낼 겁니다.", "마리루")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("그렇다면 다행이군.", "#C")
	await novel_interface.show_dialog("이런 민감한 시기에 다른 나라가 우리를 뭔가 수상한 존재로 보게 되면 곤란하니까……", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("그 말에 참석자들이 술렁이기 시작했다.")
