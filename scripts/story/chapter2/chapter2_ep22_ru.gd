# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Подожди, а где бумага, которую ты только что собрал?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ух… Бумага. Я хотел сказать тебе об этом.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я передаю страницы, найденные на поле боя, Annie. Elluka прикусывает язык.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Рукопись Уорденклифа… Великолепно! Я не могу поверить, что ты нашел это!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Они оторвались от тех парней раньше. Это просто неправильно… Annie, ты можешь их прочитать?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм… Линии размыты, но я чувствую, как сквозь них течет волшебство.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Гримуар… Точнее, фрагменты гримуара.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Гримуар... Это что-то про ведьм?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("На самом деле это книга о колдовстве. Первый сценарий такого рода, который я когда-либо видел, — это брошюра, возникшая из ниоткуда.", "Annie")
	await novel_interface.show_dialog("Если я правильно помню, брошюра называется «Мистическая траектория». Он просто появился из воздуха в моем шкафчике.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Сначала я подумал, что это мне тренер дал. Колдовство внутри было очень странным, вроде обучения изменению траектории.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Но позже я обнаружил, что тренер ничего об этом не знал. Я подумал, что это своего рода суеверие, поэтому никогда им не пользовался.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Не раньше, чем…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, Annie покончили с воспоминаниями о прошлом. Она опускает голову и внимательно читает эти сценарии.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Помню, Mariru говорил, что Ведьмы — это люди, получившие определённые Substance H свойства в результате информационного заражения.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Загрязнение… точно. Я бы сказал, что это очень актуально. Некоторую «информацию» вряд ли удастся стереть, как только вы ее получите.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нравятся эти ушные черви и ремиксы с автонастройкой? Я пытался избавиться от них миллион раз, но всегда безуспешно. Иногда я просто не могу не напевать мелодии, когда рассеян…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ха. Хорошо сказано, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Может быть, эта бумага вызвала Поток пространства-времени? \\nНо… как это вообще возможно?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Это очень вероятно. Такая информация может стоить вам много сил, что даже для меня слишком много.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Вот почему нам нужны определенные «Предметы», чтобы высвободить колдовство, чтобы они могли понести за нас цену.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie указывает на свою бейсбольную биту. Может быть, поэтому некоторое оружие потребляет магическую силу…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Если произойдет информационная перегрузка, люди могут потерять рассудок и совсем сойти с ума…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Сумасшедшие… ведьмы… \\nНужно… быть уничтоженными.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Итак, ведьмы... несчастные, да? \\nAnnie, ты много знаешь.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Нет… \\nЯ просто делаю предположения, основанные на собственном опыте.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Рукопись…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka кажется погруженной в свои мысли, ее лицо озаряется рвением.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("А? Что? Ты хочешь их увидеть, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka смотрит на меня с тоской, как маленький питомец, просящий милостыню, ее глаза полны слез.")
	await novel_interface.show_text_only("Я не могу ей отказать, но эти сценарии слишком опасны…")
	await novel_interface.show_text_only("Пока я колебался, приближаются удары приземляющегося транспортного самолета.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Кто-то идет!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID офицер? Отлично, мы нашли… \\nЧто?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Удивительно, но человек, выходящий из самолета, не является агентом SID.")
	await novel_interface.show_text_only("Мужчина в очках смотрит на Elluka нежно, но она дрожит от страха.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, вы заставили меня ждать слишком долго.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Администратор… Извините.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("У вас есть рукопись? \\nТы не сможешь справиться с ними самостоятельно — я тебе говорил. Принеси их мне, сейчас же.", "Администратор")
	await novel_interface.show_dialog("Только бесполезный хлам подведет меня в таком незначительном деле, верно?", "Администратор")
	await novel_interface.show_dialog("Разберись с этим бардаком, а потом пойдём со мной к Олигару. Тебя ждет еще одна работа.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Эй, эй, эй, следи за своим языком! Разве вы не видите, что она ранена?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Она всего лишь маленькая девочка, а не какой-то инструмент, которым вы владеете!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Незнакомец, похоже, до сих пор меня не заметил. Он смотрит на меня со странной улыбкой, как хищник, осматривающий свою жертву.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, возьмите ее с собой.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("А?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Над моим трупом. Никто не сможет выдержать Lian, пока я здесь.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Взять ее…?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Да, это приказ.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Заказать…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka смотрит на меня совершенно безучастно. Похоже, она находится во внутренней борьбе, но неподчинение Администратору — не вариант.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Задача: забрать Lian. \\nЦель заблокирована…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
