# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Schauen Sie, wer hier ist! Wie fühlt es sich an, offiziell ein Mädchen zu werden, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... Bitte hör auf, dich über mich lustig zu machen!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Okay, okay. Ich habe übrigens gehört, dass Sie planen, nach der Pause an eine andere öffentliche Highschool zu wechseln?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ja. Die neue Schule liegt näher an meinem Wohnort und... die Kreditanforderungen sind nicht so streng...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aus Sicherheitsgründen werde ich eine neue Unterkunft für Sie organisieren.\nWas die Schule betrifft...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Sieht so aus, als müsste ich diesen alten Kerl um einen Gefallen bitten.)", "Mariru")
	await novel_interface.show_dialog("(Allein der Gedanke daran ist ärgerlich... Gut, dass die Datensätze bereits perfekt korrigiert wurden...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Gosakuragawa-Mädchenoberschule. Es verfügt über die höchste Sicherheitsbewertung und ist auch nicht weit vom Hauptquartier von SID entfernt.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Während sie sprach, zeigte Mariru nach oben.")
	await novel_interface.show_text_only("In Gosakuragawa, dem geschäftigen Geschäftsviertel oberhalb des unterirdischen Hauptquartiers, soll sich eine angesehene Schule mit erschreckend hohen Studiengebühren befinden.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("W-Warte, ist das nicht die Schule für reiche Mädchen?! Das, was sie „ein Paradies, in dem reine Lilien und prächtige Kirschblüten blühen“ nennen...", "Lian")
	await novel_interface.show_text_only("Dabei handelte es sich um einen Werbetext, der von Leuten, die nicht zum Thema gehörten, in einem bestimmten, ständig abstürzenden Junk-Forum geschrieben wurde, um sich über Gosakuragawas unverschämte Studiengebühren lustig zu machen.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Was war das?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N-Nein, überhaupt nichts!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Wenn du so albern bist, könntest du am Ende für all diese Ober- und Unterschichtmänner ein echter Hingucker werden.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru lachte leicht und beendete den Satz nicht.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Was genau werden?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Jetzt ist nicht die Zeit, Ihrer Neugier freien Lauf zu lassen.\nWie auch immer, morgen werden Sie sich ordnungsgemäß melden.", "Mariru")
	await novel_interface.show_dialog("Dort wird es nicht so locker sein wie an einer öffentlichen Schule.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Kannst du mich nicht einfach ein wenig entspannen lassen?... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Oh, richtig. Was ist mit Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Der Hintergrund dieses Mädchens ist ziemlich interessant.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie... Was ist los mit ihr?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Die Aufzeichnungen über Annie Bass im System reichen nur sieben Jahre zurück, als sie fünfzehn war.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vor sieben Jahren heißt das, dass... sie schon zweiundzwanzig ist?!\nSie sieht ungefähr im gleichen Alter aus wie ich!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Das ist richtig. Selbst jetzt beträgt ihr Knochenalter immer noch fünfzehn.", "Mariru")
	await novel_interface.show_dialog("Aber wohin sie in dieser Zeit ging und warum sie plötzlich wieder auftauchte, hat bisher niemand herausgefunden, auch nicht sie selbst.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Egal was passiert, ich glaube nicht, dass Annie ein schlechter Mensch ist.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Da können Sie beruhigt sein.\nSchließlich gibt es in SID sogar Leute, die früher ihre Fans waren.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä?! War Annie eine Art Idol?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Sie fällt wahrscheinlich in die Kategorie „ein Star von vor Jahren“.", "Mariru")
	await novel_interface.show_dialog("Aber im Vergleich zu früher interessiert mich heute mehr das Besondere an ihr.", "Mariru")
	await novel_interface.show_dialog("Es gibt zunächst so wenig Informationen über Hexen... Das war ein unerwarteter Glücksfall.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hexen... was ist das?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Mm... Einfach ausgedrückt kann man sie sich als Menschen vorstellen, die durch eine bestimmte Art von Informationen infiziert wurden und einige Eigenschaften erworben haben, die denen von „Substance H ähneln.“", "Mariru")
	await novel_interface.show_dialog("Genauso wie die Leute die seltsamen Eigenschaften von „Substance H“ – Dinge, die die aktuelle Wissenschaft nicht erklären kann – „Wunder“ nennen.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Für gewöhnliche Menschen würde es praktisch wie „Magie“ aussehen, wenn jemand diese Art von Eigenschaft zeigen könnte.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("Magie... sollte nur eine Wissenschaft sein, die wir noch nicht verstehen...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Das ist eine völlig berechtigte Denkweise.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("Es gibt viele historische Aufzeichnungen über „Hexen“, aber sie wurden immer als Aberglaube und Legende behandelt.", "Mariru")
	await novel_interface.show_dialog("Über einen Zeitraum von mehr als dreihundert Jahren haben die Europäer fast hunderttausend Frauen im Namen von „Hexen“ hingerichtet.", "Mariru")
	await novel_interface.show_dialog("Die „Hexenjagden“... davon haben wir im Geschichtsunterricht erfahren...", "Lian")
	await novel_interface.show_dialog("Damals betrachtete ich es nur als langweiligen Prüfungsstoff, aber je mehr ich darüber nachdenke, desto mehr kommt es mir wirklich wie eine Katastrophe unnatürlich großen Ausmaßes vor...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Seit „Substance H“ entdeckt wurde, hat jedes Land damit begonnen, erneut zu prüfen, ob diese Legenden wahr sind.", "Mariru")
	await novel_interface.show_dialog("In letzter Zeit gibt es Gerüchte, dass bestimmte Organisationen Hexen nachgebildet haben und sie für Spionagezwecke einsetzen.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Dennoch stimmte Annie zu unserem Glück ohne zu zögern zu, beizutreten.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Beitreten, was?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Um ein SID Agent zu werden.", "Mariru")
	await novel_interface.show_dialog("Ab morgen wird sie für mich arbeiten.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Das kannst du nicht machen! SID Agenten leisten offensichtlich äußerst gefährliche Arbeit!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Und sie ist erst fünfzehn, genau wie ich. Sie kann keine Agentin sein...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh. Unser jüngster Agent ist derzeit erst dreizehn.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Dreizehn?! Das ist illegal!!\nDas muss illegal sein, oder?!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn du jemals die Gelegenheit bekommst, sie zu treffen, wirst du das nicht mehr sagen.\nDieses Kind ist viel schlauer als ein Idiot wie du.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Hmpf.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als Bürger von New Opulentia weiß ich natürlich, dass die verschiedenen Akademiestädte zwar scheinbar unter einem Waffenstillstand stehen, aber insgeheim immer noch miteinander konkurrieren.")
	await novel_interface.show_text_only("Und der Schutzschild von Aegis ist gegen biochemische Waffen und Terroranschläge im Infiltrationsstil nutzlos.")
	await novel_interface.show_text_only("Um diese Stadt zu schützen, müssen Mariru und SID unzählige verzweifelte Schlachten im Schatten geführt haben.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oh, richtig. Die Deckidentität von Annie ist ein Transferstudent, der sich bei Ihnen einschreibt.", "Mariru")
	await novel_interface.show_dialog("Ich habe dafür gesorgt, dass Sie beide in derselben Suite übernachten. Uniformen und andere Dinge des täglichen Bedarfs\nwerden alle innerhalb einer Stunde geliefert.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Keine Verhandlungen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Ich verstehe...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Natürlich verstehe ich. Daran ist nichts Schlimmes.\nNein – es ist viel bequemer als das Leben, das ich vorher hatte.")
	await novel_interface.show_text_only("Solange SID sich um alles kümmert.\nSolange ich auf der Schule einiger adliger Mädchen durchs Leben treibe und nur mit Credits über die Runden komme.")
	await novel_interface.show_text_only("Und solange ich versuche, mich an diesen neuen Körper zu gewöhnen... würde das ausreichen?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Nein.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hm?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auch wenn ich noch nichts verstehe, möchte ich nicht, dass Annie sich dieser Art von Gefahr allein stellt.")
	await novel_interface.show_text_only("Die Annie, die vor mir erschien, als wir uns trafen...\nSie sah ruhig aus, aber in ihr war immer noch eine Spur von Angst.")
	await novel_interface.show_text_only("Sie hatte... auch Angst, nicht wahr?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Fräulein Mariru – wenn es Ihnen nichts ausmacht, wenn ich Sie so nenne...\nIch möchte auch helfen!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Hä?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Ich meine... Da ich diesen Hurrikan überstehen konnte, kann ich vielleicht SID auch bei etwas anderem helfen!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Das war kein Hurrikan. Es handelte sich um eine raumzeitliche Phasenschwankung...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("Wie dem auch sei, ich kann Annie der Gefahr nicht allein aussetzen.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Und vielleicht... vielleicht bekomme ich sogar die Chance, einen Weg zu finden, mich wieder in einen Jungen zu verwandeln...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... Aber mit Ihren körperlichen Fähigkeiten könnten Sie wahrscheinlich nicht einmal einen von SIDs Hausmeistern schlagen.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Äh...\n(Was für Reinigungskräfte stellt ihr Leute ein?! Shaolin-Mönche?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Gut. Ich lasse Sie das SID Kadettentraining ausprobieren. Zumindest wenn Sie in Zukunft in Gefahr geraten, könnte dies Ihre Überlebensrate ein wenig erhöhen.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Was Ihren Status betrifft, beginnen Sie als Agentenkandidat der Stufe 4.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Okay! Ich werde mein Bestes geben!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Gut. Mal sehen, welche Daten ich aus diesem Kleinen herausholen kann.)", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
