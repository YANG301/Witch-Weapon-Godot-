# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("Atenção todos os elencos, as oscilações de fase estão diminuindo!", "Agente A")
	await novel_interface.show_dialog("O inimigo pode surgir a qualquer momento!\nMantenha suas posições e prepare-se para atacar!!", "Agente A")
	await novel_interface.show_dialog("... Relatório R!", "Agente B")
	await novel_interface.show_dialog("Duas unidades humanóides apareceram dentro do alcance visual, bem na zona central da anomalia...", "Agente B")
	await novel_interface.show_dialog("Humanos...?\nComo isso é possível?! O que a varredura memética mostrou?", "Agente A")
	await novel_interface.show_dialog("A tonalidade é...\nVerde!!", "Agente B")
	await novel_interface.show_dialog("Elas parecem ser duas meninas...\nSegurem fogo! Segure seu fogo!", "Agente B")
	await novel_interface.show_dialog("...", "Agente A")
	await novel_interface.show_dialog("Acabamos de receber ordens: a prioridade é protegê-las e trazê-las de volta à sede.\nEnvie um agente sênior para negociar—", "Agente A")
	await novel_interface.show_dialog("Todos os outros, fiquem alertas. Se os alvos fizerem algum movimento suspeito durante as negociações, elimine-os imediatamente!!", "Agente A")
	await novel_interface.show_dialog("Entendido!", "Agente B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Caminhamos cuidadosamente em direção à saída do centro de pesquisa.")
	await novel_interface.show_text_only("O que nos esperava ali, além da rua familiar, era uma fileira de fitas de barricada e uma fileira de pessoas armadas atrás dela, prontas para nos receber.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Por que tantas pessoas apareceram de repente?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah—Annie!\nApresse-se e troque de roupa!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Essas roupas são muito embaraçosas...\nEu realmente não quero que ninguém me veja assim...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("É com isso que você está realmente preocupado agora?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Suas roupas estão todas guardadas em segurança comigo, então não se preocupe...", "Annie")
	await novel_interface.show_dialog("Se você realmente quer se trocar, apenas tire aquela ‘roupa de batalha’ que você está usando agora e coloque suas roupas largas de sempre de volta~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Mas tem muitos homens à frente...\nVocê realmente quer mudar bem na frente deles?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh...\nMas eu sou um cara...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Pensando bem... você estava usando roupas masculinas mais cedo!\nSerá que—", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein? Você também já esteve em uma situação assim antes??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Isso faz sentido... Annie provavelmente também não é uma pessoa comum, não é?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Se for Annie, talvez ela consiga entender o que estou passando...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hum, entendi...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Você é do tipo que secretamente pega emprestadas as roupas de um garoto que você gosta e as veste você mesmo, certo?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso não é 'entender' de jeito nenhum!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm ~ Então, na verdade,"+GameConfig.player_name+"é o tipo de pessoa que se deixa cativar pelo cheiro do sexo oposto, né? Não precisa ficar envergonhado...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não faça aquela cara de: ‘Você pode ser um pervertido, mas eu aceito você mesmo assim’!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Suspiro... Ainda não tenho a menor ideia de por que fiquei assim...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Pare aí!\nColoque suas mãos onde eu possa vê-las!", "SID Agente")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Uma pessoa de terno preto se adiantou e gritou para nós.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Hein...?\nEles acham que somos os bandidos?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Espere, aquela insígnia no peito do líder...)\n(Um escudo perfeitamente redondo em forma de anel - não me diga que é...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Vocês dois, sou um agente SID.\nPara sua própria segurança, mantenham essa pose e não se movam.", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("Assim como pensei, eles estão com SID!\nEstamos ferrados agora!!!")
	await novel_interface.show_text_only("Em um instante, minha mente se encheu de notícias sobre SID despachando enxames de agentes para capturar espiões.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("E havia lendas urbanas sobre 'prisões secretas', 'operações de assassinato' e coisas do gênero...")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Relatório da zona de quarentena central: os dois alvos não demonstraram intenção hostil.\nNível de ameaça definido provisoriamente como D+.", "SID Agente")
	await novel_interface.show_dialog("Vamos começar com algumas perguntas simples...\nQuem é você e o que está fazendo escondido por aqui?", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sou estudante desta cidade...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Acabamos de vir aqui em uma viagem de campo para visitar o instituto de pesquisa...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O agente de preto nos lançou um olhar de desdém.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("É isso mesmo... um passeio? Do instituto?", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("Ah, não...\nDe repente me lembrei—")
	await novel_interface.show_text_only("Por causa do desaparecimento da 'Taça Roskin', o instituto foi colocado sob bloqueio de emergência desde a noite passada.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Sair descaradamente em um momento como este e alegar que estávamos apenas visitando ... isso era basicamente uma confissão.")
	await novel_interface.show_text_only("Como esperado, ela pareceu receber algum tipo de instrução através do fone de ouvido e me encarou com um olhar severo.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("Recebi ordens do meu superior. Vocês dois virão conosco.", "SID Agente")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("No espaço de apenas alguns segundos, nós dois estávamos completamente cercados.")
	await novel_interface.show_text_only("Para onde quer que eu olhasse, havia uma parede de canos de armas apontados diretamente para nós.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", essas pessoas parecem uma notícia muito ruim...\nPor que não esperamos por uma chance e corremos para ela?", "Annie")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("Fique tranquilo, não iremos prejudicá-lo.\nContanto que você coopere com a investigação, tudo isso poderá ser resolvido pacificamente.", "SID Agente")
	await novel_interface.show_dialog("Você deve compreender que o desaparecimento de um “objeto anômalo” não é uma questão trivial. Isso poderia desencadear eventos muito além do bom senso, então, por favor, coopere.", "SID Agente")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(Eventos além do bom senso...?)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ok, eu entendo. Eu irei com você.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Hein?? Por que você está indo com eles?!\nEi!"+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-pare de puxar! Minha saia estúpida vai cair!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Você é o idiota! Por que você iria com pessoas tão suspeitas? E se eles te drogarem e te venderem em algum lugar?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O que alguém iria querer com um cara adulto como eu...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Espere, não – quem organizaria uma operação de tráfico humano com tantas pessoas fazendo tal cena?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+", você obviamente nunca viu as gangues nas Ilhas Lebona...", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De qualquer forma... talvez possamos finalmente aprender alguma coisa.\nVamos apenas ir com ela por enquanto...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Tudo bem. Onde você for, eu irei também...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum, se possível, eu poderia comprar um casaco primeiro?", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Essa roupa é realmente um pouco...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ser observada por todos vestida como uma garota fez todo o meu corpo se sentir desconfortável.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Tudo bem, vou fazer um pedido.", "SID Agente")
	await novel_interface.show_dialog("...", "SID Agente")
	await novel_interface.show_dialog("...Desculpe, meu superior disse: 'Essa roupa é muito fofa' e rejeitou categoricamente o pedido.", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Que tipo de superior diz algo assim?!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
