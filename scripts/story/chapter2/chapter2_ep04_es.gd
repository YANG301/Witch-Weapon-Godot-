# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sí... También estoy confundida porque se sintió muy real, diferente a cualquier sueño.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("He buscado noticias sobre incendios o daños en edificios, pero no hay nada. \\nLa ciudad parece tan tranquila como solía ser.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Excepto por una cosa...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Mmmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("¿Excepto por qué?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Cuando desperté…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Encontré mi cuerpo cambiado al cuerpo de una niña...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Bueno…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("¿Eh? ¿Dijiste… que cambió?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No... no me veía así antes...", GameConfig.player_name)
	await novel_interface.show_dialog("Yo… ¡en realidad soy un niño!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwwwww... ¿un niño?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Está bien… espera, ¿qué?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("¿Quieres decir que eres un chico travestido? (se acerca)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("No, no… Eso no es lo que quiero decir. \\n¡No te acerques tanto!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Pero... en cierto sentido... \\nQuizás tengas razón...", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh Dios… ¡cómo puedo explicar esto!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("De todos modos… tienes una gran operación de senos. (Toca)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Tan hinchable... ¿Dónde lo hiciste? Qué toque tan natural… (Pellizca)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo… ¡yo también quiero saberlo!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Ay! No... no lo es... espera... \\n¡Basta con eso!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Déjame comprobar... brazos delgados, cintura con curvas, perfecto.", "Mariru")
	await novel_interface.show_dialog("¿Qué materiales usaste? Especialmente aquí…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhh! ¡Eso pica…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("¡Sra. Mariru! ¡No lo toques aquí!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¡No…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo...", GameConfig.player_name)
	await novel_interface.show_dialog("¡Lo creas o no! ¡Yo era un niño hasta ayer!", GameConfig.player_name)
	await novel_interface.show_dialog("No hubo cirugía...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sí, no hay duda sobre esto.", "Mariru")
	await novel_interface.show_dialog("Un cambio de género tan completo es imposible con las tecnologías actuales.", "Mariru")
	await novel_interface.show_dialog("No puedes hacer esto a menos que reemplaces todos los huesos de tu cuerpo. \\nLo que significa que eres y has sido una niña.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Qué! ¡Ya te lo dije! \\nMe desperté como una niña.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("¿Tiene alguna prueba? \\n¿Algo que pruebe que solías ser un niño?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bueno... prueba... \\n¡Sí, claro! ¡Mi tarjeta de estudiante!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Entregamos todas mis pertenencias al entrar aquí, incluida mi ropa y mi documento de identidad.")
	await novel_interface.show_text_only("Mariru toca su dispositivo portátil, lo que muestra mi tarjeta de estudiante.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("¡Sí! ¡Eso es todo! \\n¡Mira! Esa es la prueba.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Los rasgos faciales se parecen un poco a ti, pero esto no es una prueba...", "Mariru")
	await novel_interface.show_dialog("Bien, abre todas las imágenes de"+GameConfig.player_name+"capturado por el sistema de vigilancia de la ciudad durante el último mes...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru golpea hábilmente su tableta, luciendo un poco emocionada.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Pensé que era sólo un sueño cuando vi esas ruinas, y pensé que todo volvería a la normalidad después de despertar.", GameConfig.player_name)
	await novel_interface.show_dialog("Pero ahora me convierto en una niña...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Aplicar correcciones de cambio óseo. Active el análisis de la marcha en sus imágenes en el pasillo hace un momento...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignora mi murmullo y se concentra en su tableta.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Quizás no sea un sueño. Pero ahora todo parece estar bien. Sin fuego, sin destrucción.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh… ¡Estoy totalmente confundida…!", GameConfig.player_name)
	await novel_interface.show_dialog("¿Qué partes de mis recuerdos eran reales y cuáles eran solo sueños…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… El patrón de marcha coincide.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué significa eso?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("El patrón de marcha es el patrón de control característico de los músculos de una persona al caminar. Ni siquiera los mejores agentes pueden ocultarlo.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Aunque la ciencia actual no puede explicarlo…\nRealmente lo eres"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("¿A… estás seguro…?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Finalmente… pensé que ustedes sabían algo sobre esto…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Entonces, ¿has oído hablar del Ross Goblet?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Un Substance H que desapareció repentinamente bajo videovigilancia, según las noticias de esta mañana… Pero aún no lo he visto en persona.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Bueno, si estás diciendo la verdad...", "Mariru")
	await novel_interface.show_dialog("Probablemente será la única razón por la que aceptaría dar esta aburrida conferencia de forma gratuita.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Es un Substance H que se encuentra en las Islas Ross. En el exterior se encuentran montadas cuatro gemas de notable pureza.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vi algo que parece una copa brillante volando en el cielo después de que salí de las ruinas.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Flotó en el cielo, emitiendo una tenue luz roja...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("¿Rojo tenue?", "Mariru")
	await novel_interface.show_dialog("(El tenue líquido rojo en la copa ha sido un misterio…)", "Mariru")
	await novel_interface.show_dialog("(Pero esa información es clasificada. Nunca se hizo pública, incluso después de que no hace mucho fue calificada como \"segura\").", "Mariru")
	await novel_interface.show_dialog("(Nadie podría dar tales detalles sin haberlo visto antes…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Independientemente de si fue un sueño, me temo que necesitamos confirmar más información con usted.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
