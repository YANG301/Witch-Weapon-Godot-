# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Прежде чем вы пойдете в новую школу, вашим первым заданием будет обучение базовым знаниям.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Базовые знания?\nНе то чтобы я Annie пропустил все, что произошло за последние несколько лет...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хех. Вы упустили десятилетний багаж знаний о том, как быть девушкой, не так ли?~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Мне не нужны такие знания!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru полностью проигнорировал мой протест и в приподнятом настроении направился к столу. Только тогда я заметил, что она уже подготовила всю столешницу всеми возможными инструментами.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Во-первых, нужно уметь различать двенадцать стандартных оттенков помады и запоминать двадцатку лучших брендов.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Так много...?\nРазве цвета не одинаковы?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Слишком наивно! Это даже не десятая часть от общего количества.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("А здесь я подготовила для вас полный набор инструментов для макияжа — тональный крем, тени для век, блеск для губ, хайлайтер, контуринг...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("А? Мне приходится столько всего наносить на лицо?!\nЭто не то, что я рисую... Насколько сложно быть девушкой, именно...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Не волнуйтесь. С сегодняшнего дня кто-то будет учить тебя правильному макияжу.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Но старшеклассникам не разрешается даже краситься...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Вы действительно не понимаете мир старшеклассниц....\nЕсли вы продолжите вести себя так небрежно, люди сразу же заподозрят подозрения.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("А помимо школы, как агенту SID вам придется выполнять всевозможные миссии. Макияж – один из важнейших навыков для женщины-оперативника.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Особенно с таким милым личиком, как твое…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru протянул палец и поднял подбородок вверх.")
	await novel_interface.show_text_only("Я сделал шаг назад, чтобы избежать ее руки. Почему-то моя мужская гордость просто не могла этого принять.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Конечно, я и раньше работал волонтером...\nНо я никогда не ожидал, что мне придется изучать такие вещи...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Оценки кадетов SID чрезвычайно строги. Каждый раунд отсеивает огромную группу людей.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Раз уж вы заговорили о такой большой игре, почему бы не проявить себя?", "Mariru")
	await novel_interface.show_dialog("И если вы пройдете окончательную оценку, вас официально включат в состав, причем с очень приличной зарплатой~", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("А? Мне тоже могут заплатить?!\n(Т-тогда моя корзина для покупок в Gfat...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ладно, мужская гордость может пока посидеть в углу.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Хе-хе-хе... какой простой маленький отродий.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Но со своей стороны, тебе лучше понять: как твой командир, мои приказы абсолютны, и ты будешь подчиняться им безоговорочно!", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Во что я ввязываюсь...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Во-первых, позвольте мне представить вам кое-кого — преподавателя, который вызвался научить вас макияжу.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Хотя ее обычные обязанности — разработка экспериментальных лекарств и специального оборудования...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("О,... ты, должно быть, Lian, верно?\nХе-хе~ Этот профиль действительно интересный~", "Девушка в очках")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Привет~ Я директор отдела боевых исследований SID. Поскольку оба наших файла были изменены, вы можете просто позвонить мне Ai.", "Девушка в очках")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Привет...\n(Ее файл... тоже был изменен?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian — такой отличный исследовательский материал....\nНе могли бы вы одолжить ее мне на некоторое время~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Материал для исследований...? Одолжить меня...?)", "Lian")
	await novel_interface.show_dialog("(Ч-почему у меня вдруг похолодело в спине...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Я ее опекун, по крайней мере на бумаге, так что вам не разрешено трогать ее~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Хм, хорошо...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("Обычно я тоже не пользуюсь косметикой, но тут все просто. Я все это запомнил после десятиминутного просмотра.", "Ai")
	await novel_interface.show_dialog("Вы тоже сможете научиться этому быстро.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Так быстро?\nМне это показалось очень сложным процессом...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai быстро все запоминает. Тебе стоит поучиться у нее большему в будущем~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Верно...\n(Как именно я должен научиться чему-то вроде памяти?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Ага~~\nМоя голова вот-вот взорвется после того, как я провела весь день с Ai заучиванием марок и цветов косметики.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! Почему ты здесь?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Что? Начнем с того, что эта квартира является одной из моих резиденций в New Opulentia.\nБолее того, все это здание является SID собственностью~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Неудивительно, что это место такое возмутительное!\nПодожди, не говори мне, что ты собираешься жить здесь с Annie и мной...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Я захожу сюда лишь изредка, так что оставаться здесь буду нечасто~\nХотя в холодильнике уже закончилось пиво. В следующий раз не забудь купить мне два ящика.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Но сегодня я здесь именно в роли твоего опекуна... хи-хи~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("У меня ужасное предчувствие по этому поводу!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Приходите примерить это. Это твоя школьная форма, Lian, а это платье~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Почему... эта юбка такая короткая...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Юбка действительно выглядит лучше всего именно такой длины.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ты точно изменила длину этой юбки, не так ли?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Не обращайте внимания на мелкие детали~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("А здесь у нас есть носки до щиколотки, носки-лодочки, гольфы, колготки...\nОго, и еще этот пояс для подвязок!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Откуда столько видов носков...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Также есть разные виды полосок, лоскутного шитья, узоров, горошка....\nДа, хотите попробовать чулки в сеточку?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Категорически нет!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Нет, подожди! Дело не в этом!\nЯ вообще не хочу носить такие вещи!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Если миссия требует этого, у вас все равно не будет выбора, так что вам стоит привыкнуть к этому пораньше....\nХотите, я вам помогу?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Д-Ты... ты...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
