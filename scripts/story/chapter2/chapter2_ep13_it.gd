# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Prima di andare nella nuova scuola, il tuo primo compito è la formazione sulle conoscenze di base.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Conoscenze di base?\nNon è che io sia Annie e mi sia perso tutto quello che è successo negli ultimi anni...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh. Ti sei perso più di un decennio di conoscenze sull'essere una ragazza, vero?~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Non ho bisogno di quel tipo di conoscenza!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ignorò completamente la mia protesta e si avvicinò al tavolo di buon umore. Solo allora ho notato che aveva già preparato l'intero piano del tavolo con ogni tipo di strumento immaginabile.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Innanzitutto, devi essere in grado di distinguere dodici tonalità di rossetto standard e memorizzare le venti marche principali.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Così tanti...?\nI colori non sono praticamente tutti uguali?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Troppo ingenuo! Non è nemmeno un decimo del totale.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("E qui ho preparato per te un set completo di strumenti per il trucco: fondotinta, ombretto, lucidalabbra, evidenziatore, contouring...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Eh? Devo mettermi tutta quella roba in faccia?!\nNon è come se stessi dipingendo... Quanto è complicato essere una ragazza, esattamente...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Non preoccuparti. Da oggi qualcuno ti insegnerà a truccarti come si deve.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ma agli studenti delle scuole superiori non è nemmeno permesso truccarsi...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Davvero non capisci il mondo delle ragazze delle scuole superiori...\nSe continui a comportarti in modo così sconsiderato, le persone si insospettiranno in pochissimo tempo.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("E oltre alla scuola, come agente SID dovrai svolgere tutti i tipi di missioni. Il trucco è una delle abilità essenziali per un'operatrice.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Soprattutto con un visino carino come il tuo...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru allungò un dito e inclinò il mento verso l'alto.")
	await novel_interface.show_text_only("Feci un passo indietro per evitare la sua mano. In qualche modo il mio orgoglio maschile semplicemente non riusciva ad accettarlo.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ho già fatto volontariato in passato, certo...\nMa non mi sarei mai aspettato di dover imparare cose del genere...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Le valutazioni dei cadetti di SID sono estremamente rigide. Ogni round elimina un enorme gruppo di persone.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Visto che hai parlato di una partita così importante, perché non metterti alla prova?", "Mariru")
	await novel_interface.show_dialog("E se superi la valutazione finale, verrai ufficialmente inserito nel roster, con uno stipendio molto dignitoso~", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Eh? Posso essere pagato anch'io?!\n(G-Allora il mio carrello Gfat...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Va bene, per ora l'orgoglio maschile può sedersi in un angolo.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Hehehe... che semplice moccioso.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Ma in cambio, faresti meglio a capirlo: come tuo ufficiale in comando, i miei ordini sono assoluti e tu li obbedirai incondizionatamente!", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("In cosa mi sto cacciando...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Per prima cosa, lascia che ti presenti qualcuno: l'insegnante che si è offerta volontaria per insegnarti il trucco.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Sebbene le sue responsabilità abituali siano farmaci sperimentali e sviluppo di attrezzature speciali...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Oh... devi essere Lian, giusto?\nHehe~ Questo profilo è davvero interessante~", "Ragazza con gli occhiali")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ciao~ Sono il direttore del dipartimento di ricerca sul combattimento di SID. Dato che entrambi i nostri file sono stati alterati, puoi semplicemente chiamarmi Ai.", "Ragazza con gli occhiali")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Ciao...\n(Anche il suo file... è stato modificato?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian è un materiale di ricerca davvero eccellente...\nNon puoi prestarmela per un po'~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Materiale di ricerca...? Prestarmi...?)", "Lian")
	await novel_interface.show_dialog("(W-Perché all'improvviso mi sento un po' fredda la schiena...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Sono il suo tutore, almeno sulla carta, quindi non ti è permesso fare alcuna mossa con lei~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Umph, bene...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("Di solito non mi trucco neanche io, ma è una cosa semplice. Avevo memorizzato tutto dopo averlo guardato per dieci minuti.", "Ai")
	await novel_interface.show_dialog("Dovresti essere in grado di impararlo anche velocemente.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Così veloce?\nMi è sembrato un processo davvero complicato...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai ricorda tutto velocemente. Dovresti imparare di più da lei in futuro~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Giusto...\n(Come dovrei imparare esattamente qualcosa come la memoria?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aghh~~\nLa mia testa sta per esplodere dopo aver passato tutto il giorno con Ai a memorizzare marche e colori di trucco.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! Perché sei qui?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Cosa? Questo appartamento è una delle mie residenze a New Opulentia per cominciare.\nInoltre, l'intero edificio è di proprietà SID~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non c'è da stupirsi che questo posto sia così scandaloso!\nAspetta, non dirmi che vivrai qui con Annie e me...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Vengo solo di tanto in tanto, quindi non resterò qui spesso~\nAnche se il frigorifero è già senza birra. La prossima volta ricordati di comprarmene due custodie.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ma oggi sono qui specificatamente nel mio ruolo di tuo guardiano... ih-ih~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ho una sensazione terribile a riguardo!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Vieni a provarli. Questa è la tua uniforme scolastica, Lian, e questo è un vestito~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Perché... questa gonna è così corta...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Una gonna sta davvero meglio con questa lunghezza.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hai decisamente modificato la lunghezza di questa gonna, vero?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Non preoccuparti dei piccoli dettagli~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("E qui abbiamo calzini alla caviglia, calzettoni, calze autoreggenti, collant...\nOho, e anche questo reggicalze!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Come mai ci sono così tanti tipi di calzini...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ci sono anche diversi tipi di righe, patchwork, fantasie, pois...\nOh giusto, vuoi provare le calze a rete?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Assolutamente no!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("No, aspetta! Non è questo il punto!\nNon voglio assolutamente indossare cose del genere!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Se una missione lo richiede, non avrai comunque scelta, quindi potresti anche abituarti presto...\nVuoi che ti aiuti?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("T-tu... tu...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
