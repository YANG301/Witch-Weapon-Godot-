# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("Attenzione a tutte le squadre, le fluttuazioni di fase si stanno attenuando!", "Agente A")
	await novel_interface.show_dialog("Il nemico potrebbe emergere da un momento all'altro!\nMantieni la posizione e preparati a ingaggiare!!", "Agente A")
	await novel_interface.show_dialog("... Rapporto R!", "Agente B")
	await novel_interface.show_dialog("Due unità umanoidi sono apparse nel raggio visivo, proprio nella zona centrale dell'anomalia...", "Agente B")
	await novel_interface.show_dialog("Umani...?\nCome è possibile?! Cosa ha mostrato la scansione memetica??", "Agente A")
	await novel_interface.show_dialog("La tonalità è...\nVerde!!", "Agente B")
	await novel_interface.show_dialog("Sembrano due ragazzine...\nTrattenete il fuoco! Tieni il fuoco!", "Agente B")
	await novel_interface.show_dialog("...", "Agente A")
	await novel_interface.show_dialog("Abbiamo appena ricevuto degli ordini: la priorità è metterli al sicuro e riportarli al quartier generale.\nInvia un agente senior a negoziare—", "Agente A")
	await novel_interface.show_dialog("Tutti gli altri, state attenti. Se gli obiettivi fanno qualche mossa sospetta durante i negoziati, eliminateli immediatamente!!", "Agente A")
	await novel_interface.show_dialog("Capito!", "Agente B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Ci siamo diretti con cautela verso l'uscita del centro di ricerca.")
	await novel_interface.show_text_only("Ciò che ci aspettava lì, oltre alla strada familiare, era una linea di nastro di barricata e una fila di persone armate in piedi dietro di essa, pronte per noi.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Perché così tante persone si sono presentate all'improvviso?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah—Annie!\nSbrigati e cambiami i vestiti!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Questi vestiti sono troppo imbarazzanti...\nNon voglio davvero che nessuno mi veda così...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("È davvero questo ciò che ti preoccupa in questo momento?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("I tuoi vestiti sono tutti al sicuro con me, quindi non preoccuparti...", "Annie")
	await novel_interface.show_dialog("Se vuoi davvero cambiare, togliti quel 'vestito da battaglia' che indossi adesso e indossa di nuovo i tuoi soliti vestiti larghi~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ma ci sono tanti uomini più avanti...\nVuoi davvero cambiare proprio davanti a loro?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uffa...\nMa io sono un ragazzo...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Ora che ci penso... prima indossavi abiti da uomo!\nPotrebbe essere—", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh? Anche tu hai già vissuto una situazione del genere??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Ha senso che anche ... Annie probabilmente non sia una persona normale, vero?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Se è Annie, forse può capire cosa sto passando...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm, ho capito...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Sei il tipo che prende in prestito di nascosto i vestiti di un ragazzo che ti piace e li indossa tu stesso, giusto?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo non è affatto \"capirlo\"!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm~ Quindi, in realtà,"+GameConfig.player_name+"è il tipo di persona che si lascia affascinare dall'odore del sesso opposto, eh? Non c'è bisogno di essere imbarazzato...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non fare quella faccia del tipo: 'Potresti anche essere un pervertito, ma ti accetterò comunque'!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Sigh... Non ho ancora assolutamente idea del perché sono diventato così...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Fermati lì!\nMetti le mani dove posso vederle!", "SID Agente")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Una persona vestita di nero si fece avanti e ci urlò.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Eh...?\nPensano che noi siamo i cattivi?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Aspetta, quell'insegna sul petto del leader...)\n(Uno scudo perfettamente rotondo, a forma di anello, non dirmi che è...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Voi due, io sono un SID agente.\nPer la tua sicurezza, mantieni quella posa e non muoverti.", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("Proprio come pensavo, sono con SID!\nSiamo fregati adesso!!!")
	await novel_interface.show_text_only("In un istante, la mia mente si riempì di notizie sull'invio di SID sciami di agenti per catturare spie.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("E poi c'erano leggende metropolitane su \"prigioni segrete\", \"operazioni di assassinio\" e simili...")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Rapporto dalla zona centrale di quarantena: i due obiettivi non hanno mostrato intenti ostili.\nLivello di minaccia provvisoriamente impostato su D+.", "SID Agente")
	await novel_interface.show_dialog("Cominciamo con alcune semplici domande...\nChi sei e cosa fai furtivamente da queste parti?", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sono uno studente di questa città...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Siamo appena venuti qui in gita per visitare l'istituto di ricerca...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'agente in nero ci guardò con disprezzo.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("È così... una gita? Dell'istituto?", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("Oh no...\nAll'improvviso mi sono ricordato—")
	await novel_interface.show_text_only("A causa della scomparsa della \"Roskin Cup\", l'istituto era stato messo sotto blocco d'emergenza da ieri sera.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Uscirne sfacciatamente in un momento come questo e affermare che eravamo solo in visita... era fondamentalmente una confessione.")
	await novel_interface.show_text_only("Come previsto, sembrò ricevere qualche tipo di istruzione attraverso l'auricolare e mi fissò con uno sguardo severo.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("Ho ricevuto ordini dal mio superiore. Voi due verrete con noi.", "SID Agente")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Nel giro di pochi secondi eravamo completamente circondati.")
	await novel_interface.show_text_only("Ovunque guardassi, c'era un muro di canne di pistola puntate proprio verso di noi.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", queste persone sembrano davvero brutte notizie...\nPerché non aspettiamo un'occasione e scappiamo?", "Annie")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("Ti assicuriamo che non ti faremo del male.\nFinché collaborerai con le indagini, tutto questo potrà essere risolto pacificamente.", "SID Agente")
	await novel_interface.show_dialog("Dovresti capire che la scomparsa di un \"oggetto anomalo\" non è una cosa da poco. Potrebbe innescare eventi ben oltre il buon senso, quindi per favore collabora.", "SID Agente")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(Eventi oltre il buon senso...?)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ok, capisco. Verrò con te.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Eh?? Perché vai con loro?!\nEhi!"+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-smettila di tirare! La mia stupida gonna si staccherà!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Sei tu l'idiota! Perché dovresti andare con persone così sospettose? E se ti drogassero e ti vendessero da qualche parte?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa si vorrebbe da un ragazzo adulto come me...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Aspetta, no, chi organizzerebbe un'operazione di tratta di esseri umani con così tante persone che fanno una scena del genere?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+", ovviamente non hai mai visto le bande delle Isole Lebona...", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ad ogni modo... forse potremmo finalmente imparare qualcosa.\nPer ora andiamo con lei...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Bene. Ovunque tu vada, andrò anch'io...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehm, se possibile, potrei procurarmi prima un cappotto?", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Questo outfit è davvero un po'...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Essere guardato da tutti mentre ero vestito da ragazza metteva a disagio tutto il mio corpo.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Va bene, inserisco una richiesta.", "SID Agente")
	await novel_interface.show_dialog("...", "SID Agente")
	await novel_interface.show_dialog("...Scusa, il mio superiore ha detto: \"Quel vestito è molto carino\" e ha respinto categoricamente la richiesta.", "SID Agente")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Che razza di superiore dice una cosa del genere?!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
