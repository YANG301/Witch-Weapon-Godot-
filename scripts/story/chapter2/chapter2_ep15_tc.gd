# chapter2_ep15.gd - 第二章第15話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("唉……裙子還是太短了啊……\n下面涼颼颼的……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("這幾天發生了太多難以置信的事情\n腦子都不夠使了……", "小憐")
	await novel_interface.show_dialog("無論是城市毀滅的夢，還是清早起來就發現自己變成了女生，還是遭到莫名其妙的敵人襲擊……", "小憐")
	await novel_interface.show_dialog("都那麼的沒有實感\n而且……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("小憐同學，進來吧。", "班主任")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("啊，是！", "小憐")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("初、初初、初次見面！\n大家好，我叫憐……", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("很高興和大家成為同學，今後就請大家多多指教了\n……", "小憐")
	await novel_interface.show_dialog("（然而是以不得不當女高中生的方式成為同學\n……）", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("（……饒了我吧……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("那麼，憐同學就坐後排的空位子吧。", "班主任")
	await novel_interface.show_dialog("（……這個時期轉學，真稀奇呢。）", "同學A")
	await novel_interface.show_dialog("（看她一直盯著地上，應該很文靜吧？）", "同學B")
	await novel_interface.show_dialog("（不過很可愛啊……頭髮的顏色是染過的嗎？）", "同學A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("大家都在看我……\n嗚嗚……前途多難啊……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("呼，下課了……學校生活以前可沒這麼累人啊。\n果然高偏差值的學校就是不一樣……", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("（糟糕……想上廁所……）", "小憐")
	await novel_interface.show_dialog("（不…不行，絕對不能進學校的女洗手間…！）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("唉，該怎麼辦啊……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("怎麼啦~唉聲嘆氣的。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("欸？安妮！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("怎麼樣？新的學校還適應嗎？這裡都是些很可愛的女孩子呢~", "安妮")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗚……先不管那些啦。\n你的基礎知識訓練結束了嗎！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("哼哼，我一透過考核就趕過來啦！讓小憐一個人在這裡說不定出什麼事呀。", "安妮")
	await novel_interface.show_dialog("好在離開的時間不是很久，現在的新豐洲又是移民城市，我應該不難適應的。", "安妮")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("莉琉小姐還委託我要照顧小憐呢~\n特意把我們安排在一個班。", "安妮")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("我一個大男……\n總之照顧什麼的，不用的啦~~", "小憐")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("嘿嘿，而且呆在你身邊，我也比較安心……", "安妮")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("我聽說你自告奮勇要和我一起加入SID的事了。", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("安妮露出感謝的神情，我一時語塞，也不知道自己能不能順利透過測試……")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("對了，剛才保健室的老師託我轉告，要你去找她做一下體檢。", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("體、體檢！？", "小憐")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我們是轉學生所以學校要單獨體檢啦~\n還是說，你是在懊惱錯過了全班一起的……", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("哪有！！\n我明白啦，可在此之前……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯？", "安妮")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("（……廁……所……）", "小憐")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("聽不見啦……說大聲點~", "安妮")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("……那個，可不可以帶我去上廁所……", "小憐")
	await novel_interface.show_dialog("我一個人會……很有罪惡感，不敢進去……", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("噗……\n還說不用人照顧~", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("好啦……快……", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("（額……體檢的話……）", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("（以前是男孩子的事，應該不會露餡吧！）", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("（體檢都要檢查什麼來著？）", "小憐")
	await novel_interface.show_dialog("（話說……是要脫衣服的吧？）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（幸好沒有嫌麻煩，把內衣穿來了……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("（保健室……是這裡嗎？）", "小憐")
	await novel_interface.show_dialog("打擾了，我是來體檢的轉學生……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("來得好，正等你呢。", "愛衣")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("愛、愛愛愛、愛衣？", "小憐")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("嗚哇，別，為什麼是你來做檢查嘛！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("欸？？？\n愛衣，住、住手啊———！！", "小憐")
	await novel_interface.show_dialog("等等……你手上拿的，那個奇怪的張牙舞爪的器械是什麼？？", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("嗚啊啊啊啊———！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("嗚嗚嗚，怎麼這樣……", "小憐")
	await novel_interface.show_dialog("這種事情那種事情的，明明可以不用做的吧……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("你太誇張啦。\n不過是常規的檢查，常規哦~", "愛衣")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("……雙眼視力2.0，非常完美呀。\n和你以前的資料有變化嗎？", "愛衣")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("誒？我原來是左眼1.0，右眼0.7\n醫生還讓我玩遊戲的時候離遠點……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("太有趣了……你的身體就像被重新構造了一遍，整個骨骼都發生了變化。", "愛衣")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("但大腦的神經拓撲結構卻同時展現了兩種性別的特質，所以記憶和思維習慣得以保留嗎……", "愛衣")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("愛衣的情緒似乎很激動，聲音都有點發抖。")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("這樣的話……理論上你應該能意識到，自己更容易感知別人的情緒了。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("沒、沒有吧……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("絕對沒有！我是100%的男生！", "小憐")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("總之，從醫學角度看來，你100%是女性無疑。\n健康狀態完全沒有問題，只不過……", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("只不過？", "小憐")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("過段時間會經歷一次腹痛，除此以外都沒問題~\n應該快了，記得做好準備啦。", "愛衣")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("肚子痛嗎……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("……欸——？？？", "小憐")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("嗚嗚……愛衣，你！！", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("感覺委屈又無力，快要哭出來了……\n嗚嗚嗚，男子漢，不許哭！！")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("嗯嗯，真的是完美啊……很少有人長這麼大身上一點疤痕都沒有哦。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("聽著一點都不會開心啊！！", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("那個——我可以回去了嗎……？", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("愛衣脫掉了白大褂，一幅準備“這次要認真了哦”的表情，從衣櫃裡拿出兩件衣服……")
	await novel_interface.show_dialog("說什麼呢？\n好戲才剛開始呢……", "愛衣")
	await novel_interface.show_dialog("莉琉批准了，可以把各種各樣的衣服都給小憐試穿一下呢……", "愛衣")
	await novel_interface.show_dialog("噫、噫——？", "小憐")
	await novel_interface.show_dialog("然後……呵呵呵呵，我還要研究一下小憐的每一項資料的啊。", "愛衣")
	await novel_interface.show_dialog("呀啊啊啊啊啊啊啊啊啊啊~~~！", "小憐")

	print("=== 第二章第15話結束 ===")

	# 呼叫劇情結束函式
	await novel_interface.end_story_episode(0.5)
