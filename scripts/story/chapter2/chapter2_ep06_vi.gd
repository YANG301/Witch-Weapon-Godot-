# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Lẩm bẩm) Con nhóc đó thú vị hơn nhiều...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lời nhắc kết nối cuộc gọi thoại nhấp nháy trên màn hình theo đường chéo phía trước Mariru. Giọng nói điện tử bị bóp méo có chủ ý che giấu giới tính ban đầu của người nói.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Tôi đã thực hiện bản tóm tắt này nhiều lần, nhưng định dạng can thiệp được mã hóa một chiều này vẫn khiến tôi khó chịu.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Vậy, liên quan đến sự biến mất của Ross Goblet, cuộc điều tra hiện đang tiến hành như thế nào?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Lúc 00:15 sáng nay, hệ thống an ninh xác nhận Ross Goblet đã biến mất.", "Mariru")
	await novel_interface.show_dialog("Lúc 06:40, hệ thống giám sát vệ tinh True Sight đã đưa ra cảnh báo sau khi phát hiện hiện tượng biến dạng chiều nghiêm trọng.", "Mariru")
	await novel_interface.show_dialog("Sau đó, từ 07:00 sáng nay đến nay, hệ thống Aegis đã phát hiện sáu cảnh báo Biến động pha không thời gian trong New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Và nếu chúng ta lấy viện nghiên cứu làm trung tâm, ba mươi hai cảnh báo tương tự sẽ xuất hiện đồng thời trong bán kính mười lăm trăm km...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Tất cả điều đó đã có trong tài liệu. Hãy cho tôi kết luận.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru liếc qua vai phải của cô ấy và mỉm cười.")
	await novel_interface.show_text_only("Chỉ từ giọng điệu thôi, cô ấy có thể biết đó là Giám đốc điều hành nghiêm khắc, không cười của Thượng viện.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—Đây không phải là một vụ trộm. Đó là sự thức tỉnh của một Substance H, cùng với phản ứng dây chuyền mà nó gây ra.", "Mariru")
	await novel_interface.show_dialog("Và xét theo tần suất và quy mô hiện tại, chúng tôi vẫn không thể xác định liệu đó có phải là loại lan truyền thông tin Substance H hay không.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ngay khi [[1007]]] nói xong, những tiếng thì thầm giật mình và cuộc thảo luận im lặng lan truyền qua màn hình tối xung quanh cô.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Cái gì?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một giọng nói trầm và đều đều phát ra từ bên trái của Mariru.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ý bạn là sự bùng phát theo cấp số nhân của \"Cảm ứng thần thánh\" ảnh hưởng đến tâm trí?\nGiờ điều đó thật thú vị...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Hiện tại, có vẻ như có nhiều sự cố xảy ra cùng lúc.\n\"Divine Touch\"... Tôi đặc biệt không thích những thuật ngữ không chính xác.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Mặc dù ông ấy là người có thẩm quyền về ảnh hưởng đến tâm trí Substance H...)", "Mariru")
	await novel_interface.show_dialog("(Tôi vẫn không thể quên được cảm giác rằng con khỉ đột này đã đốt cháy não mình bằng quá nhiều bức xạ.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Vậy theo phán đoán của bạn...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Tôi chưa thể gửi báo cáo kết luận được. Đơn giản là chúng tôi không có đủ thông tin hữu ích.", "Mariru")
	await novel_interface.show_dialog("Với tình hình hiện tại, tôi đang yêu cầu lệnh điều tra Cấp S không hạn chế. Tôi hy vọng tất cả các bạn có thể hiểu được.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Lờ đi những lời thì thầm xung quanh, Mariru hướng sự chú ý của cô trở lại thiết bị đầu cuối cầm tay.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Cô bé đó đã đi đến một khu vực dị thường khác...)", "Mariru")
	await novel_interface.show_dialog("(Đúng như dự đoán—cô ấy biến mất, một lúc sau xuất hiện trở lại, và rồi biến động pha gần đó lại dừng lại.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Cảnh quay hiện trường... có phải vết máu trên người cô ấy không?)", "Mariru")
	await novel_interface.show_dialog("(Con ngốc đó... đừng nói với tôi là cô ấy thực sự—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Bạn có vẻ hơi mất tập trung.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cái gì?... Không hề.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Dù bạn đang nhìn vào thứ gì—nó có chứa thông tin quan trọng hơn cuộc họp này không?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Không, đây chỉ là video về một chú mèo con. Bạn muốn xem nó?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Một tiếng rên rỉ điện sắc bén và âm thanh vo ve phát ra từ bên trái của Mariru.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Đừng giận dữ thế. Một chút chuyển hướng sẽ cải thiện hiệu quả công việc.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru quét ánh mắt của cô ấy quanh phòng. Có vẻ như không ai để ý đến sự trượt dốc nhất thời vừa rồi.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Trong mọi trường hợp, thông tin tình báo cơ bản mà chúng tôi thu được cho đến nay chính xác như đã nêu trong cuộc họp.\nVụ việc vẫn đang được điều tra thêm.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Nếu không có câu hỏi nào, tôi sẽ tới hiện trường.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Trước khi Mariru kịp rời đi, một giọng nói có phần khiếm nhã vang lên từ bên trái cô ấy.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...Tôi nghe nói cấp dưới của anh đã đưa hai học sinh trung học về SID để thẩm vấn?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Lại là tên khốn đáng ghét đó.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("Có điều gì đặc biệt ở họ không, thưa bà Mariru... không, thưa bác sĩ?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Không có gì cả. Chúng tôi đã xác nhận điều đó - chúng chỉ là hai chú mèo con quá tò mò đã lẻn vào khu vực cấm.", "Mariru")
	await novel_interface.show_dialog("Tôi sẽ sắp xếp để đưa họ về nhà sau đó.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tôi hiểu. Vậy thì tốt.", "#C")
	await novel_interface.show_dialog("Vào thời điểm nhạy cảm như thế này, sẽ thật rắc rối nếu các quốc gia khác bắt đầu coi họ như một loại tồn tại kỳ lạ...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nhận xét đó gây ra một sự náo động giữa những người khác.")
	await novel_interface.show_text_only("...Điều đó có nghĩa là gì?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tôi chắc chắn rằng một nhận xét bất cẩn có thể khiến một số người khó chịu.\nTôi xin lỗi—hãy coi như bạn chưa từng nghe thấy điều đó.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Thật là một người đàn ông đáng ghét.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Vậy thì, dù sao đi nữa, sự việc này đã thu hút sự chú ý của các Thành phố Học viện khác.", "Bright")
	await novel_interface.show_dialog("Chúng tôi sẽ trông cậy vào bạn trong cuộc điều tra mật và quản lý thông tin công khai kể từ đây trở đi.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Đương nhiên.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
