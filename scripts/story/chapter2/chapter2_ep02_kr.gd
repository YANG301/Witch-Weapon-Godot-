# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("각 조 주의, 위상 변동이 약해지고 있다!", "요원A")
	await novel_interface.show_dialog("적이 언제 나타날지 모른다!\n각 위치에서 공격에 대비하라!", "요원A")
	await novel_interface.show_dialog("…보, 보고!", "요원B")
	await novel_interface.show_dialog("시야 범위 내에서 인간형 개체 두 명을 발견했습니다. 변이 핵심 구역에 갑자기 출현했습니다……", "요원B")
	await novel_interface.show_dialog("인간이라고……,\n그럴 리가! 밈 검출 결과는??", "요원A")
	await novel_interface.show_dialog("색상은……\n녹색입니다!!", "요원B")
	await novel_interface.show_dialog("두 소녀로 보입니다……\n사격 중지! 사격 중지!", "요원B")
	await novel_interface.show_dialog("……", "요원A")
	await novel_interface.show_dialog("방금 명령을 받았다. 우선 저 둘을 제압해 본부로 데려간다.\n상급 요원 한 명이 가서 교섭해라——", "요원A")
	await novel_interface.show_dialog("다른 인원은 경계를 유지해라. 교섭 중 목표가 수상한 움직임을 보이면 즉시 사살한다!!", "요원A")
	await novel_interface.show_dialog("알겠습니다!", "요원B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("우리는 조심스럽게 연구센터 출구 쪽으로 나아갔다.")
	await novel_interface.show_text_only("우리를 맞이한 건 익숙한 거리뿐만이 아니었다. 한 줄로 쳐진 통제선과, 그 뒤에서 무기를 든 채 대기 중인 사람들이 서 있었다.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("어, 어디서 이렇게 많은 사람이 튀어나온 거야?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("아, 앤!\n빨리 내 옷 원래대로 돌려줘!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("이렇게 창피한 옷차림은……\n정말 남들한테 보이고 싶지 않단 말이야……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("이런 상황에서 그게 그렇게 신경 쓰여?", "앤")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("네 옷은 내가 잘 보관하고 있으니까 걱정하지 마……", "앤")
	await novel_interface.show_dialog("정 바꾸고 싶으면 지금 입은 『전투복』을 벗고, 원래 입던 그 헐렁한 옷으로 다시 갈아입으면 되잖아~", "앤")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("그래도 앞에 남자들이 엄청 많은데……\n정말 그 사람들 앞에서 갈아입을 거야?", "앤")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("우우우~~\n나도 엄연히 남……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("그러고 보니…… 방금 네가 입고 있던 건 전부 남자 옷이었잖아!\n설마——", "앤")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("엥, 너도 예전에 이런 일을 겪은 적 있어??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(그러고 보니…… 앤은 평범한 사람이 아닌 것 같지,)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(앤이라면…… 어쩌면 내 처지를 이해해 줄지도 몰라……)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("응응, 이해해……", "앤")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("좋아하는 남자애 옷을 몰래 가져다가 혼자 입어 본 거지?", "앤")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("이해하긴 개뿔이!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("응응~ 사실 "+GameConfig.player_name+"도 이성의 체취에 끌리는 타입인 거지, 부끄러워할 필요 없어……", "앤") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("\"넌 변태지만 난 널 이해해\" 같은 표정 짓지 말라고!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("하아…… 내가 왜 이렇게 된 건지 아직도 전혀 감이 안 와……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("……")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("거기 서!\n손 들어!", "SID요원")
	novel_interface.character_dark()
	await novel_interface.show_text_only("검은 정장을 입은 사람이 앞으로 나와 우리에게 소리쳤다")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("에……,\n우릴 나쁜 사람으로 보는 건가?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(잠깐, 저 선두에 선 사람 가슴팍의 표식은)\n(둥근 원형에 고리가 겹쳐진 방패——설마……)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("두 분, 저는 SID 요원입니다.\n다치지 않게 하려는 거니, 자세를 유지한 채 움직이지 마세요.", "SID요원")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("역시 SID 놈들이잖아!\n이제 큰일 났다!!!")
	await novel_interface.show_text_only("내 머릿속에는 SID가 대규모 요원을 동원해 스파이를 체포하던 뉴스 장면이 순식간에 스쳐 지나갔다.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("거기에 \"비밀 감옥\"이라느니, \"암살 작전\"이라느니 하는 도시전설까지……")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("핵심 봉쇄 구역 보고. 목표 두 명에게서 공격 의도는 확인되지 않았다.\n위협 등급은 일단 D+로 판정.", "SID요원")
	await novel_interface.show_dialog("우선 간단히 몇 가지만 묻겠습니다……\n——당신들, 정체가 뭐죠, 여기서 수상하게 뭘 하고 있었습니까?", "SID요원")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("저는 이 도시 학생인데요……", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("우린 그, 그냥 현장학습으로 연구소를 잠깐 견학하러 왔을 뿐이에요……", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("검은 정장을 입은 요원의 얼굴에 노골적인 경멸이 스쳤다.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("그래요——견학, 연구소를?", "SID요원")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("큰일이다……\n문득 떠올랐다——")
	await novel_interface.show_text_only("『로스 금배』가 사라진 일 때문에 연구소는 어젯밤부터 긴급 계엄 상태였다.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("이런 때에 우리가 태연하게 안에서 걸어 나와서 그냥 견학만 했다고 떠드는 건…… 거의 스스로 자백하는 거나 다름없었다.")
	await novel_interface.show_text_only("역시나, 그녀는 이어폰 너머로 뭔가 지시를 받은 듯 굳은 표정으로 나를 바라봤다.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("상부의 명령을 받았습니다. 두 분, 저희와 함께 가 주시죠.", "SID요원")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("불과 몇 초 만에 우리 둘은 완전히 포위당했다.")
	await novel_interface.show_text_only("시야에 들어오는 건 우리를 겨누고 있는 새까만 총구뿐이었다.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", 이 녀석들 아무래도 심상치 않은데…\n틈을 봐서 도망치는 게 낫지 않을까.", "앤")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("안심하세요. 저희는 두 분을 해치지 않습니다.\n조사에 협조해 주시면 일은 평화롭게 해결될 겁니다.", "SID요원")
	await novel_interface.show_dialog("두 분도 아시겠지만, 『이물질』 실종 건은 결코 가볍지 않습니다. 상식을 벗어나는 각종 사태로 이어질 수 있으니 꼭 이해해 주십시오.", "SID요원")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(상식을 벗어나는 일……인가,)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("좋아, 알겠어요. 당신들을 따라갈게요.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("뭐?? 왜 따라가겠다는 거야!\n야! "+GameConfig.player_name+"!", "앤")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("자, 잡아당기지 마! 바보 같은 치마가 벗겨지잖아!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("바보는 너거든! 왜 이렇게 수상한 녀석들을 따라가려는 건데, 약이라도 먹여서 팔아넘기면 어떡하려고?!", "앤")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("나 같은 남자애가 팔려가기는 무슨……", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("아니, 누가 이렇게 대대적으로 인신매매를 하냐!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+"은 레보나 군도의 깡패들을 본 적이 없는 모양이네……", "앤")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("어쨌든…… 뭔가 알아낼 수 있을지도 몰라\n우선 얌전히 따라가 보자……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("알겠어, 네가 가는 데라면 나도 따라갈게……", "앤")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("저기, 괜찮으시다면 겉옷 한 벌만 주실 수 있을까요.", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("이 옷은 아무래도 좀……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("여자 옷을 입은 채 사람들 시선을 한몸에 받고 있으려니, 온몸이 영 불편했다.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("좋습니다, 한번 신청해 보겠습니다.", "SID요원")
	await novel_interface.show_dialog("……", "SID요원")
	await novel_interface.show_dialog("……죄송합니다. 상관께서 \"그 차림이 아주 귀엽다\"고 하시면서\n단칼에 기각하셨습니다.", "SID요원")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("대체 어떤 상관인 거야!!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
