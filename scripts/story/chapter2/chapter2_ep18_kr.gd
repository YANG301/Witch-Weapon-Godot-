# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("숨이 막힐 듯한 한여름 오후, 나는 서류 한 묶음을 중정의 원탁 옆에 내려놓고 그늘 아래 의자에 털썩 주저앉았다.")
	await novel_interface.show_text_only("예쁜 선배가 힘겹게 물건을 들고 가는 걸 본 나는 참지 못하고 달려갔으나……")
	await novel_interface.show_text_only("고마워하는 선배가 시야에서 사라지자마자 자신이 바보 같다는 걸 느꼈다.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("후,드디어 쉴 수 있겠어. 더워죽겠네.", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("하아…… 원래 몸이었다면 이 정도는 아무것도 아니었는데.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("아직 SID 훈련도 남아있어……숨어버리고 싶다.", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("렌,저기……\\n여긴 학교잖아?", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("앤이구나~\\n왜 그래?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("네가 많이 더운 건 알겠는데\\n옷을 들어서 땀을 닦으면…좋지 않을 것 같아.", "앤")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("속살이 보이잖아..", "앤")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("이런!", "샤오롄")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("저 렌이라는 전학생 너무 거칠지 않아,……", "동급생A")
	await novel_interface.show_dialog("그러게,치마를 입고 다리를 벌리고 앉는 걸 봤다니까! ", "동급생B")
	await novel_interface.show_dialog("정말?그러면 안 되는데……", "동급생A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…\\n(그거야 원래 난 치마를 입으면 안 되는 사람이니까!)", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("저기……")
	await novel_interface.show_text_only("다정한 목소리가 들린다.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("안녕,괜찮다면 이 손수건을 써. ", "우아하며 품위있는 소녀")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("눈 앞에 나타난 사람은 예쁘고 우아한 여학생이다. \\n\\n찰랑이는 보라색 머리카락,라일락처럼 다정한 눈동자를 가졌다.")
	await novel_interface.show_text_only("그녀가 내게 손수건을 건네준다. 손수건에서 우아하고 상쾌한 향기가 난다.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("앗?!\\n고,고마워요.", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("1학년 전학생들이지?\\n난 닉스 스트로치,너희들 선배야.", "닉스")
	await novel_interface.show_dialog("너무 더워 보이길래… 마침 손수건도 가지고 있고. 내가 방해한 건 아닌지 모르겠어.", "닉스")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("닉스가 예의있게 고개를 끄덕이자 나도 모르게 일어나 바보처럼 인사했다. ")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("아,아니에요!\\n그럴 리가요! 정말 고맙습니다!", "샤오롄")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(다정한 선배다.)\\n(외국인이겠지, 속눈썹이 정말 길어…)", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("닉스의 섬세한 얼굴을 보고 있자니 심장이 조금 빨리 뛰는 것 같았다.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("그렇게까지 격식 차리지 않아도 돼.\n그보다…… 이름이 뭐지?", "닉스")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("저는 렌,이 친구는 앤이에요.\\n최근에 전학왔어요. ", "샤오롄")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……앤?", "닉스")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("닉스가 표정을 찌푸리며 앤의 얼굴을 응시한다.")
	await novel_interface.show_text_only("하지만,마치 착각이였던 것처럼 그녀가 재빨리 앤을 향해 미소를 짓는다.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("만나서 반가웠어.", "닉스")
	await novel_interface.show_dialog("난 먼저 가볼게.\\n내 도움이 필요하면 언제든지 찾아와. ", "닉스")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("고맙습니다,선배!", "샤오롄")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("……", "앤")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("앤이 대답하지 않고 머뭇거린다.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("저 선배……다른 선배들보다 훨씬 우아해.", "샤오롄")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("앤,왜 그래?\\n아까부터 아무 말도 하지 않고.", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("방금 그 선배,스트로치라고 했지?", "앤")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("응. 아는 사람이야?", "샤오롄")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("앤이 내게 팔짱을 끼고 밝게 웃는다.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("응?아니야~\\n방금 전학 왔는데,어떻게 알겠어.", "앤")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("그건 그렇지.", "샤오롄")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
