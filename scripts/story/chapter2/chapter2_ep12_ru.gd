# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("После прохождения целого ряда регистрационных процедур на SID кадетскую подготовку мне вручили толстую стопку «учебников».")
	await novel_interface.show_text_only("Затем под руководством сотрудника я поднялся на небольшом неприметном лифте из штаб-квартиры SID .")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Лифт поднимался достаточно быстро, чтобы я отчетливо чувствовал нарастающее давление в ушах.\nКогда я достиг поверхности, я понял, что уже вечер...")
	await novel_interface.show_text_only("Лифт вывел в вестибюль небольшого офисного здания, а сразу за ним оказался многолюдный торговый район.")
	await novel_interface.show_text_only("Я слышал, что лифт может спуститься на более глубокие уровни только в том случае, если он признает, что каждый пассажир является уполномоченным персоналом. В противном случае он просто путешествует между первым и третьим этажами офисного здания.") #换行问题
	await novel_interface.show_text_only("На втором этаже здания находилось круглосуточное кафе, куда целый день приходили и уходили люди — идеальное место, чтобы спрятаться на виду.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Вздох...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Я думал, что обучение агентов будет включать в себя такие вещи, как рукопашный бой и стрельба, но это больше похоже на то, будто я подписался на полный пакет неполной школы...", "Lian")
	await novel_interface.show_dialog("Эти книги очень тяжелые!\nХорошо, что место, устроенное для меня Mariru недалеко отсюда.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Восточная дорога Академического округа № 6... Она сказала, что это очень скромно…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("— Как это вообще скромно?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я стоял внутри роскошной резиденции на верхнем этаже высотного здания. Роскошная гостиная соединена с огромной террасой с видом на ночной коммерческий район.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Это пламя вдоль стены — настоящий камин?\nЭто слишком перебор...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пока я осторожно оглядывался по сторонам и задавался вопросом, не зашёл ли я не в ту комнату, я получил сообщение от Mariru.")
	await novel_interface.show_text_only("Mariru: Выберите любую спальню, которая вам нравится.\nНе нужно быть вежливым с бюджетом Сенат~") #原文有个♥
	await novel_interface.show_text_only("Эта женщина... Немедленно извинись перед налогоплательщиками New Opulentia!!")
	await novel_interface.show_dialog("Lian, ты вернулся!", "Annie")
	await novel_interface.show_text_only("Annie вышла из ванной, одной рукой собирая волосы на ходу.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! Ты тоже здесь?\nMariru сказал, что ты только что ушел на специальную тренировку...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Я закончил обучение досрочно. Я только что принял душ и примерил школьную форму.\nПохоже, мы будем соседями по комнате~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Вправо...\n(Похоже, Mariru упоминал об этом...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(Это какое-то испытание с небес?)\n(Жить под одной крышей с девушкой и все такое...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Это школьная форма? Это действительно мило~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Мм-хм~ Одежда, которую они приготовили для тебя, находится вон в той коробке. Вам тоже стоит примерить их!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Мне-мне тоже придется его надеть...?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хе-хе, Lian, ты еще не привыкла быть девушкой?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Как только она заговорила об этом, я не мог не почесать голову и рухнуть на диван.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Как можно было к такому привыкнуть...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ух... Никто не мог понять, на что это похоже.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Я понимаю.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie внезапно села рядом со мной и слегка провела кончиком пальца по моей щеке, как бы утешая меня.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Потому что мы одинаковы.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В ее улыбке была легкая горечь.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ч-Что—?!\nТы тоже был мальчиком?!\nТы тоже был мальчиком?!\nТы тоже был мальчиком?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ахахахахаха! Lian, ты идиот?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Я всегда была девочкой~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ага...\n(Это унизительно!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Когда мое смущение достигло своего апогея, Annie перестал смеяться и нежно посмотрел на меня.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("Но паника в твоем сердце прямо сейчас... Я действительно полностью это понимаю.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("Раньше я тоже был в ловушке в другом пространстве-времени...\nЭто чувство, вероятно, немного походило на то, через что вы проходите сейчас.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Еще одно... пространство-время?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie сделала паузу, как будто тщательно обдумывая, как это сформулировать.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Разве Мисс Mariru не говорила вам?\nЯ очень долго дрейфовал в другом пространстве-времени, ничего толком не понимая...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Время там казалось смутным. Казалось, это не так уж и долго, но когда я вернулся, я понял, что прошло уже семь лет.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Мм, я немного слышал об этом...", "Lian")
	await novel_interface.show_dialog("(Хотя это было лишь из-за нескольких разрозненных намеков, Mariru упало...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что именно с ней случилось?\nСтоит ли мне спросить ее напрямую?")
	await novel_interface.show_text_only("Annie не продолжилось. Она лишь опустила голову и рассеянно играла пальцами.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... ты тоже когда-нибудь чувствовал себя так—", "Annie")
	await novel_interface.show_dialog("Как будто все это может быть всего лишь сном, и в следующий раз, когда ты откроешь глаза, ты наконец проснешься.", "Annie")
	await novel_interface.show_dialog("Все должно было быть не так. Тебя здесь быть не должно...\nНо что бы ты ни делал, ты не сможешь вернуться на нормальный путь.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Значит, Annie зашла так далеко, неся подобные чувства в одиночку...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я подошел немного ближе к Annie и нежно похлопал ее по плечу.\nЭ, утешать такую девушку... должно быть нормально, верно?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Не бойтесь. Ты вернулся, не так ли~", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Мм...\nНо все по-прежнему кажется мне таким незнакомым...", "Annie")
	await novel_interface.show_dialog("Я даже не имею ни малейшего представления, что вы все подразумеваете под «академгородом».", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... Верно. Война еще даже не закончилась, когда Annie исчез.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Значит, вы до сих пор не знаете, что произошло за последние несколько лет, верно?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Я лишь примерно посмотрел на ситуацию... За эти годы произошло столько всего, что я даже не понимаю, что означают многие слова в новостях.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Семь лет назад...\nЭто было как раз в разгар войны, повергшей весь мир в хаос.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("А? Война?\nВы имеете в виду военную кампанию, которую форт Масада начал против Европы?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie очень старался вспомнить.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, не тот. Вскоре после этого в это были втянуты почти все страны.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Я тогда учился в начальной школе в интернате. Каждый день новости были полны военных сообщений и подсчетов потерь. Это было ужасное время...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, ты тоже пережил войну?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Не совсем. Благодаря защите Aegis New Opulentia тогда сосредоточил все свои усилия на реконструкции рядом с руинами.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я смотрел на процветающий ночной пейзаж города за окном... Когда я был маленьким, город был полон гигантских кранов и повсюду занятой строительной техники.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Так что большая часть того, что я знаю, взята из учебников.", "Lian")
	await novel_interface.show_dialog("Благодаря войне чудо-технологии быстро развивались...\nИ под «чудом» я подразумеваю явления, вызванные Substance H.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("После войны каждая из шести стран, освоивших ключевые технологии, основала по одному из шести мировых городов-академий.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Ощущение, будто во мне внезапно пробудился какой-то скрытый талант учителя истории...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Так что действительно многое произошло... Я даже представить себе не могу.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что ж, когда Annie ушел — ну, исчез — мир все еще был сравнительно мирным, верно...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Это верно. Тогда я еще мог участвовать в международных бейсбольных матчах!", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("В тот момент, когда Annie заговорила о бейсболе, ее глаза засияли.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Знаешь, Lian, когда бы ни наступала моя очередь бить битой, взгляды всех зрителей были сосредоточены только на мне одном!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("От этой смеси напряжения и необходимости отдать все, что у тебя есть, кровь закипит во всем моем теле!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда речь зашла о бейсболе, я внезапно подумал о памятнике из черного камня возле бейсбольного стадиона Лебона, на котором выгравированы имена десятков тысяч погибших.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("На самом деле...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Хм?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Возможно, пропустить худшие годы войны было для тебя в конце концов к лучшему.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Когда я думаю об этом таким образом, может быть, превратиться в девушку и встретиться с тобой\n тоже не так уж и плохо... в каком-то смысле?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie замер. На мгновение она выглядела почти смущенной...\nИли мне это показалось?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... Вообще-то я всё это время хотел поблагодарить тебя.\nПотому что... именно ты спас меня от скитаний по тому миру.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("А? Но я ничего не сделал...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Именно поэтому ты должен быть особенным~", "Annie")
	await novel_interface.show_dialog("Я до сих пор не знаю, как ты это сделал, но в тот момент я почувствовал, как твоя теплая рука тянет меня за собой.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie нежно взяла меня за руку и погрузилась в воспоминания.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если бы не ты, я не знаю, как долго я бы оставался там в ловушке и кем бы я мог стать в конце концов...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Стать... кем?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ахаха~ Это ничего. Теперь все это в прошлом.\nМне вдруг захотелось спать~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie казалось, хотела уйти от темы.\nОна лениво потянулась, все еще улыбаясь.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Как долго вы двое планируете продолжать ночной разговор этих девушек?", "Mariru")
	await novel_interface.show_text_only("Голос Mariru внезапно раздался из динамика в углу комнаты.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("М-Mariru?!\nТы только что подслушивал?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Что? Что-то не так, когда опекун следит за расписанием пары детей?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("У тебя действительно хватает наглости сказать это...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Ты тоже отвечаешь?\nПохоже, завтра мне придётся тренировать тебя очень усердно...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("Мне очень жаль! Я приму ванну и сразу же пойду спать!\nСпокойной ночи!!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
