# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("Attention, all squads, the phase fluctuations are subsiding!", "Agent A")
	await novel_interface.show_dialog("The enemy may emerge at any minute!\nHold your positions and prepare to engage!!", "Agent A")
	await novel_interface.show_dialog("... R-report!", "Agent B")
	await novel_interface.show_dialog("Two humanoid units have appeared within visual range, right in the anomaly core zone...", "Agent B")
	await novel_interface.show_dialog("Humans...?\nHow is that possible?! What did the memetic scan show??", "Agent A")
	await novel_interface.show_dialog("The hue is...\nGreen!!", "Agent B")
	await novel_interface.show_dialog("They seem to be two young girls...\nHold your fire! Hold your fire!", "Agent B")
	await novel_interface.show_dialog("...", "Agent A")
	await novel_interface.show_dialog("We just received orders: priority one is to secure them and bring them back to headquarters.\nSend a senior agent to negotiate—", "Agent A")
	await novel_interface.show_dialog("Everyone else, stay alert. If the targets make any suspicious move during negotiations, eliminate them immediately!!", "Agent A")
	await novel_interface.show_dialog("Understood!", "Agent B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("We carefully made our way toward the exit of the research center.")
	await novel_interface.show_text_only("What awaited us there, besides the familiar street, was a line of barricade tape and a row of armed people standing behind it, ready for us.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wh-why did so many people suddenly show up?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah—Annie!\nHurry up and change my clothes back!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("These clothes are way too embarrassing...\nI really don't want anyone seeing me like this...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Is that really what you're worried about right now?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Your clothes are all being kept safe with me, so don't worry...", "Annie")
	await novel_interface.show_dialog("If you really want to change, just take off that 'battle outfit' you're wearing now and put your usual baggy clothes back on~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("But there are a lot of men up ahead...\nDo you really want to change right in front of them?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh...\nBut I'm a gu...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Come to think of it... you were wearing men's clothes earlier!\nCould it be—", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh? You've been in a situation like this before too??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(That makes sense... Annie probably isn't an ordinary person either, is she?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(If it's Annie, maybe she can understand what I'm going through...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm, I get it...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("You're the type who secretly borrows the clothes of a boy you like and wears them yourself, right?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's not 'getting it' at all!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm~ So actually, "+GameConfig.player_name+" is the kind of person who gets captivated by the scent of the opposite sex, huh? No need to be embarrassed...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Don't make that face like, 'You may be a pervert, but I'll accept you anyway'!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Sigh... I still have absolutely no idea why I've turned out like this...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Stop right there!\nPut your hands where I can see them!", "SID Agent")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A person in a black suit stepped forward and shouted at us.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Huh...?\nDo they think we're the bad guys?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Wait, that insignia on the leader's chest...)\n(A perfectly round, ring-shaped shield—don't tell me that's...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("The two of you, I'm an SID agent.\nFor your own safety, keep that pose and don't move.", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("Just as I thought, they're with SID!\nWe're screwed now!!!")
	await novel_interface.show_text_only("In an instant, my mind filled with news stories about SID dispatching swarms of agents to capture spies.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("And then there were urban legends about 'secret prisons,' 'assassination operations,' and the like...")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Report from the core quarantine zone: the two targets have shown no hostile intent.\nThreat level provisionally set to D+.", "SID Agent")
	await novel_interface.show_dialog("Let's start with a few simple questions...\nWho are you, and what are you doing sneaking around here?", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("I'm a student from this city...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("We j-just came here on a field trip to tour the research institute...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The agent in black gave us a look of disdain.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Is that so— a tour? Of the institute?", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("Oh no...\nI suddenly remembered—")
	await novel_interface.show_text_only("Because of the disappearance of the 'Roskin Cup,' the institute had been placed under emergency lockdown since last night.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Walking out of it brazenly at a time like this and claiming we were just visiting... that was basically a confession.")
	await novel_interface.show_text_only("As expected, she seemed to receive some kind of instruction through her earpiece and fixed me with a stern look.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("I've received orders from my superior. The two of you will come with us.", "SID Agent")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("In the span of just a few seconds, the two of us were completely surrounded.")
	await novel_interface.show_text_only("Everywhere I looked, there was a wall of gun barrels pointed right at us.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", these people look really bad news...\nWhy don't we wait for a chance and run for it?", "Annie")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("Please rest assured, we won't harm you.\nAs long as you cooperate with the investigation, this can all be resolved peacefully.", "SID Agent")
	await novel_interface.show_dialog("You should understand that the disappearance of an 'anomalous object' is no trivial matter. It could trigger events far beyond common sense, so please cooperate.", "SID Agent")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(Events beyond common sense...?)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Okay, I understand. I'll go with you.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Huh?? Why are you just going with them?!\nHey! "+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-quit pulling! My stupid skirt is going to come off!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("You're the idiot! Why would you go with people this suspicious? What if they drug you and sell you off somewhere?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What would anyone even want with a grown guy like me...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Wait, no—who would stage a human trafficking operation with this many people making such a scene?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+", you've obviously never seen the gangs on the Lebona Islands...", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anyway... maybe we might finally learn something.\nLet's just go with her for now...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Fine. Wherever you go, I'll go too...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um, if possible, could I get a coat first?", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("This outfit is really a bit...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Being watched by everyone while dressed like a girl made my whole body feel uncomfortable.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Alright, I'll put in a request.", "SID Agent")
	await novel_interface.show_dialog("...", "SID Agent")
	await novel_interface.show_dialog("...Sorry, my superior said, 'That outfit is very cute,' and flatly rejected the request.", "SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("What kind of superior even says something like that?!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
