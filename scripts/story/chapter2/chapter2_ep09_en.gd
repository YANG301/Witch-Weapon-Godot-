# chapter2_ep09.gd - 第二章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep09_script()

func play_script():
	pass

func chapter2_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("So... to keep you safe, I'm going to erase every trace and record of your former life and rewrite your identity file.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("You can really do something like that?\nSo SID really is as legendary as they say...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Of course. Besides, every citizen record in New Opulentia is already part of Substance H.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Huh? You've got to be kidding me...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Didn't they teach you this in school? New Opulentia's entire civic administration system is built on top of Aegis.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Right... the Aegis system is a memetic-type Substance H...", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Because it's woven so deeply into everyday life, everyone has long since grown used to this existence that surpasses human understanding.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aegis is a software system. Once activated, it can deploy a defensive field with a radius of thirty-five kilometers.", "Mariru")
	await novel_interface.show_dialog("The shell of that field can automatically identify and block attacks of any kind. It can even suppress the effects of many Divine Touch weapons.", "Mariru")
	await novel_interface.show_dialog("No one knows the principle behind its threat recognition, but it's highly intelligent—it won't block the flow of any non-hostile matter or information.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("It is absolutely the foundation that allowed New Opulentia to recover quickly from the war and preserve its neutrality.", "Mariru")
	await novel_interface.show_dialog("And Aegis's mainframe can identify and repel cyberattacks as well.", "Mariru")
	await novel_interface.show_dialog("Because its security is practically flawless, the Senate decided to migrate the entire city administration system onto the Aegis mainframe.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As long as an ID card is linked to a phone, Aegis can correlate a person's identity, household registry, and account records—even CAPH credits can be checked.") #鎹㈣闂important
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("We really did learn all that in school...\nI just forgot most of it right after the exam.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("But what I'm going to tell you next—is classified.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru stares at me gravely, as if she has made up her mind.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("The Aegis system has one more ability that has never been made public.", "Mariru")
	await novel_interface.show_dialog("The moment anyone enters the range of its defensive field, the system identifies them immediately.", "Mariru")
	await novel_interface.show_dialog("You could say that identification is based on the soul.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Based on the... soul?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis assigns an electronic code to every person within its range. After that, no matter how that person disguises themselves, alters their face, loses their memory, or gets brainwashed...", "Mariru")
	await novel_interface.show_dialog("...they will still be identified as that original code.", "Mariru")
	await novel_interface.show_dialog("Each code has only two possible states: inside the defensive range, or outside it.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("If a code is no longer within the range, then either that person has left the city, or they've died.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A chill runs across my scalp as I listen.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Everyone... is just a code?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("That's right. Nothing else is attached to it—no name, no photo, no location data.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Creating a file for each code, matching it to the real person, updating the information, and tracking key targets—that's SID's job.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("It's a security system that every other Academy City envies.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("It... watches every person it protects, every code, every second of every day...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A complicated expression flashes across Mariru's face. It lasts only an instant, but I see it clearly.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("No wonder you know exactly when intelligence agents from other countries slip into New Opulentia.", GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Wait! Then my...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("I had my people screen every new code that appeared today--", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("I've never encountered a case like this before either... but as far as Aegis is concerned, you still register as male.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emotion surges through me so hard that my eyes almost well up.\nFinally... finally, I can prove I'm a boy!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("So you can't go on being a boy anymore.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Huh?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Now that you've learned all this classified information...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru suddenly steps closer. I instinctively back away, only to realize my body is already pressed against the wall.")
	await novel_interface.show_text_only("But she doesn't stop. She plants one arm against the wall and corners me completely.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("S-So what does that mean...?", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her face is way too close!\nMy heart is pounding so hard it feels like it's going to explode!")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("So from now on, you're mine~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Huh--??", GameConfig.player_name)
	await novel_interface.show_dialog("W-What do you mean, \"belong to you\"?!", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog(""+GameConfig.player_name+", ID 2519G1911, age 15.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru finally lets me go, then skillfully pulls out a handheld device and starts flicking and tapping away.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("So you went back to an ordinary public school in middle school...\nSo before that, you were a lonely adolescent boy living on your own~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Height 165... no, 161 now. And you've lost quite a bit of weight too, so I'd better update that.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As Mariru works, the handheld device gives off a crisp confirmation beep.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Huh? I got shorter?", GameConfig.player_name)
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(That makes sense... none of my old clothes fit anymore...)", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("You're even a member of Akira Takasaki's fan club?\nTsk tsk, how innocent...", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Your online shopping history is pretty entertaining too~ My Little Sister Could Never Be an Idol, Magic Love H...", "Mariru")
	await novel_interface.show_dialog("And you even bought a body pillow... the special edition?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Aaaaaaaaaaaaaaaaaaah!!!\nDon't look! Don't look at that!!!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("(This is public execution, isn't it?!\nN-No, having her see this is even worse than that!!)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Well... I suppose I've teased you enough~", "Mariru")
	await novel_interface.show_dialog("I've had Level-5 clearance for ages, but this is the first time I've ever gotten to do something this fun.", "Mariru")
	await novel_interface.show_dialog("Let's see... beginning profile revision...\nChange sex to \"Female\"!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A crisp confirmation tone rings out.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Tsk tsk, will that leave a timestamp?\nThat won't do if those people notice it...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Then... classify the edit history as \"Confidential\".\nThere, that should do it.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Having all household and administrative records fully digitized really is convenient.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("J-Just... that easily??", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mm-hmm~ I just altered your file in every administrative system record.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("You're now legally a girl, you know.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("You can even walk straight into the women-only train car now without any trouble~♥", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Unbelievable! It changed that easily...!!", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("My heart sinks. I can't accept it...")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Besides, your old name is tied far too closely to your male identity...", "Mariru")
	await novel_interface.show_dialog("What sort of new name would be cute enough for you, I wonder...?\nLet me think...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/girlchar_battleWearingCry.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_text_only("It suddenly hits me just how much power Mariru actually has.")
	await novel_interface.show_text_only("She can change someone's entire life with a few flicks of her fingers...")
	await novel_interface.show_text_only("I know she's doing it to protect me, but... it still feels so unfair!!")
	await novel_interface.show_text_only("I'm a boy!! I still...")
	await novel_interface.show_text_only("Just thinking that makes the tears spill out before I can stop them...\nSob, sob...")
	await novel_interface.show_text_only("Damn it, is this because my body turned into a girl?\nWhy am I crying this easily...?")
	await novel_interface.show_text_only("I'd already promised myself I wouldn't cry again...\nBut the tears just won't stop...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Oh? You're actually crying?\nIs it because your sex got changed for good~?", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Hahaha, all right, all right...\nHonestly, the way you cry like this really does make people want to cherish you~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Want to cherish you... cherish...\nLian...", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Hm... \"Lian\" actually sounds pretty good~\nIt suits the way you look now, too.", "Mariru")
	await novel_interface.show_dialog("It's decided!\nFrom today on, your name is \"Lian\"!", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Set data synchronization authority to... Level 5.\nThat should even change the nameplates in your game records, right?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Lian...\nWha--??? What!??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(You're kidding me, right?! You have to be kidding me!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("All done! From now on, every identification system will recognize you by that name... Little Lian~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Can you really just change something like a name this casually?\nUgh...", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("There, there, stop sniffling already~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Guardian... hmm, I'll just set that to me.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I-I don't want that!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh? Thinking of resisting--", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Did my tone just now sound so gentle that you got the mistaken impression I'm easy to reason with?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru's voice suddenly turns stern.\nAn overwhelming pressure crashes down on me...")
	novel_interface.show_character("liliu_uniform2","serious")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("I'm sorry, Guardian!!\nI was wrong!!", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Given your current situation, I really ought to lock you up~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Please don't smile while saying something that dangerous!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("All I changed just now was your basic information. The linked historical records still need a lot of cosmetic work.", "Mariru")
	await novel_interface.show_dialog("If your identity is exposed before that's finished, you'll be in danger at any moment. I'll lock your file for now--", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The handheld device emits another crisp confirmation tone.")
	novel_interface.show_character("liliu_uniform2","serious")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Hm?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("It's a classified transmission. I need to deal with it.\nGo wait for me in the lobby first.", "Mariru")

	print("=== 绗簩绔犵9璇濈粨鏉?===")

	# 璋冪敤鍓ф儏缁撴潫鍑芥暟
	await novel_interface.end_story_episode(0.5)

