# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("Внимание всем отрядам, фазовые колебания затихают!", "Агент А")
	await novel_interface.show_dialog("Враг может появиться в любую минуту!\nУдерживайте свои позиции и приготовьтесь к бою!!", "Агент А")
	await novel_interface.show_dialog("... R-отчет!", "Агент Б")
	await novel_interface.show_dialog("Два гуманоидных отряда появились в пределах видимости, прямо в зоне ядра аномалии...", "Агент Б")
	await novel_interface.show_dialog("Люди...?\nКак это возможно?! Что показало меметическое сканирование??", "Агент А")
	await novel_interface.show_dialog("Оттенок ...\nЗеленый!!", "Агент Б")
	await novel_interface.show_dialog("Кажется, это две молодые девушки....\nПридержи огонь! Держи огонь!", "Агент Б")
	await novel_interface.show_dialog("...", "Агент А")
	await novel_interface.show_dialog("Мы только что получили приказ: первый приоритет — обезопасить их и вернуть в штаб.\nОтправьте старшего агента на переговоры—", "Агент А")
	await novel_interface.show_dialog("Все остальные, будьте начеку. Если цели сделают какой-либо подозрительный шаг во время переговоров, немедленно устраните их!!", "Агент А")
	await novel_interface.show_dialog("Понятно!", "Агент Б")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Мы осторожно пробирались к выходу из исследовательского центра.")
	await novel_interface.show_text_only("Там, кроме знакомой улицы, нас ждала линия баррикадной ленты и стоящая за ней шеренга вооруженных людей, готовых нас встретить.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ч-почему вдруг появилось так много людей?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ах—Annie!\nПоторопитесь и переоденьте меня обратно!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Эта одежда слишком смущает...\nЯ правда не хочу, чтобы кто-нибудь видел меня в таком виде...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Это действительно то, что тебя сейчас беспокоит?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Вся ваша одежда хранится у меня, так что не волнуйтесь...", "Annie")
	await novel_interface.show_dialog("Если ты действительно хочешь переодеться, просто сними тот «боевой наряд», который ты сейчас носишь, и снова надень свою обычную мешковатую одежду~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Но впереди много мужчин...\nТы действительно хочешь измениться прямо на их глазах?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ух...\nНо я гу...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Если подумать,... раньше ты носил мужскую одежду!\nМогло ли это быть—", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А? Вы уже были в такой ситуации??", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Это имеет смысл.... Annie она, наверное, тоже не обычный человек, не так ли?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Если это Annie, возможно, она сможет понять, через что я прохожу...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ммм, я понял...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Вы из тех, кто тайно берет одежду у парня, который вам нравится, и носит ее сам, верно?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это вообще не \"понимаю\"!!!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ммм~ Так на самом деле,"+GameConfig.player_name+"это тот тип людей, которых пленяет запах противоположного пола, да? Не надо смущаться...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Не делай такое выражение лица: «Может быть, ты и извращенец, но я все равно тебя приму»!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Эх... Я до сих пор совершенно не понимаю, почему я оказался таким...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Остановитесь!\nПоложите руки так, чтобы я мог их видеть!", "SID Агент")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Человек в черном костюме вышел вперед и крикнул на нас.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("А...?\nОни думают, что мы плохие парни?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Подождите, этот знак отличия на груди лидера...)\n(Идеально круглый щит в форме кольца — не говорите мне, что это...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Вы двое, я агент SID.\nДля вашей же безопасности сохраняйте эту позу и не двигайтесь.", "SID Агент")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("Как я и думал, они с SID!\nТеперь мы облажались!!!")
	await novel_interface.show_text_only("В одно мгновение мой разум наполнился новостями о том, как SID отправляют рой агентов для поимки шпионов.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("А еще ходили городские легенды о «тайных тюрьмах», «покушениях» и тому подобном...")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Отчет из основной карантинной зоны: две цели не проявили враждебных намерений.\nУровень угрозы предварительно установлен на D+.", "SID Агент")
	await novel_interface.show_dialog("Давайте начнем с нескольких простых вопросов...\nКто вы и что вы здесь делаете?", "SID Агент")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Я студент из этого города...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Мы т-только что приехали сюда на экскурсию по научно-исследовательскому институту...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Агент в черном посмотрел на нас с презрением.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Это так — экскурсия? Из института?", "SID Агент")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("О нет...\nЯ вдруг вспомнил—")
	await novel_interface.show_text_only("Из-за исчезновения «Кубка Роскина» со вчерашнего вечера в институте была введена чрезвычайная блокировка.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Нагло уйти из этого в такое время и заявить, что мы просто были в гостях у ... — это было по сути признанием.")
	await novel_interface.show_text_only("Как и ожидалось, она, похоже, получила какие-то инструкции через наушник и пристально посмотрела на меня.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("Я получил приказ от своего начальника. Вы двое пойдете с нами.", "SID Агент")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Всего за несколько секунд мы оба были полностью окружены.")
	await novel_interface.show_text_only("Куда бы я ни посмотрел, повсюду была стена стволов, направленных прямо на нас.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", эти люди выглядят очень плохими новостями...\nПочему бы нам не дождаться шанса и не воспользоваться им?", "Annie")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("Будьте уверены, мы не причиним вам вреда.\nПока вы будете сотрудничать со следствием, все можно решить мирным путем.", "SID Агент")
	await novel_interface.show_dialog("Вы должны понимать, что исчезновение «аномального объекта» — дело нетривиальное. Это может спровоцировать события, выходящие за рамки здравого смысла, поэтому, пожалуйста, сотрудничайте.", "SID Агент")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("(События, выходящие за рамки здравого смысла...?)", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Хорошо, я понимаю. Я пойду с тобой.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("А?? Почему ты просто идешь с ними?!\nЭй!"+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("К-перестань тянуть! Моя дурацкая юбка сейчас слетит!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Ты идиот! Зачем тебе идти с такими подозрительными людьми? А что, если тебя накачают и продадут куда-нибудь?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Чего вообще можно хотеть от такого взрослого парня, как я...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Подождите, нет, кто станет организовывать операцию по торговле людьми, когда такое количество людей устраивает такую сцену?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+", вы явно никогда не видели банды на островах Лебона...", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("В любом случае... возможно, мы наконец-то узнаем что-нибудь.\nДавайте пока просто пойдём с ней...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Хорошо. Куда бы ты ни пошел, я тоже пойду...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эм, если возможно, могу ли я сначала надеть пальто?", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Этот наряд действительно немного ...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Когда все смотрели, когда я был одет как девушка, все мое тело чувствовало дискомфорт.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Хорошо, я оставлю заявку.", "SID Агент")
	await novel_interface.show_dialog("...", "SID Агент")
	await novel_interface.show_dialog("...Извините, мой начальник сказал: «Этот наряд очень милый» и категорически отклонил эту просьбу.", "SID Агент")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Какой начальник вообще такое говорит?!", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
