	await novel_interface.show_dialog("정말……너무 귀여워!!", "마리루")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("……\\n촤아——(물 내리는 소리)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("아——이제 살 것 같다~~", "샤오롄")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("잠깐…어째……", "샤오롄")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("흔… 흔들어 몇 번…?", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("………………")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("왔네?느낌이 어땠어?", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("그런 걸 묻지 말란 말이야!!!", "샤오롄")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(어쩐지 여자 화장실에 휴지가 잘 떨어진다고 그러더니……)", "샤오롄")
	await novel_interface.show_dialog("흑흑흑……\\n너무 어색해……", "샤오롄")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("비참해 비참해 분해!!\n난 꼭! 꼭 빨리 원래대로 돌아갈 거야!!", "샤오롄")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
