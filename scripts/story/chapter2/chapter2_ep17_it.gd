# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("Ecco come dovrebbe essere una scuola ricca! \\nGuarda che cibo appetitoso nella mensa.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Ciao! Vorrei un piatto di riso al curry e tre ali di pollo fritte.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Le torte di gamberi sembrano buone. Ne prendo due, per favore.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sei sicuro di poter finire tutto questo?", "Personale della mensa")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Certo, un gioco da ragazzi!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ehi, guarda! Quella ragazza mangia come un cavallo.", "Studente 1")
	await novel_interface.show_dialog("Incredibile… Mangia sempre così tanto?", "Studente 2")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(... Sono un ragazzo, ok? Questo è normale.)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Sai, la gente ti invidia. \\nMangi molto senza ingrassare...", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Niente di speciale. \\nHmmmm! Le torte di gamberi sono così deliziose!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ebbene, Lian...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa? (Munches) \\nIl riso al curry è davvero buono! (Sorso)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Adoro questa scuola! (granite)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Mangi davvero come un cavallo, vero?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("È lei la nuova studentessa trasferita?", "Studente 1")
	await novel_interface.show_dialog("Non sembra affatto una ragazza... \\nEww, allarga le gambe quando è seduta. È disgustoso!", "Studente 2")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… Questo fa davvero schifo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Boohoo…", "Lian")
	await novel_interface.show_dialog("Bene... ho finito di mangiare...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Questo è quanto mangerebbe una ragazza.", "Annie")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ero un grande mangiatore! \\nPotrei mangiare più che posso e prendermi il tempo per digerire...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ahahah…! Sei davvero un cavallo? Perché dovresti farlo?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Probabilmente perché... soffrivo la fame troppo spesso quando ero bambino.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis può solo identificare e proteggere i proiettili. Ciò significa che i soldati armati possono facilmente penetrare nel suo campo di forza.")
	await novel_interface.show_text_only("Il campo di forza ha un raggio di 20 miglia, all'epoca di fatto l'ultima fossa per milioni di sopravvissuti.")
	await novel_interface.show_text_only("La guerra ha lasciato tanti orfani. L'organizzazione della difesa ha appesantito il Senato. Pertanto, le forniture a ciascuna scuola materna furono pesantemente razionate.")
	await novel_interface.show_text_only("Molti bambini morivano di fame e dovevano cercare cibo nella zona di guerra vicino al confine. Ero uno di loro...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Capisco i tuoi sentimenti. Solo... non mangiare troppo adesso.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche Annie potrebbe aver vissuto quei giorni...")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ehi, prendiamo qualche dolce dopo la scuola!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("…Va bene!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Raramente abbiamo tempo libero per uscire in questo modo, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("In realtà è la prima volta che vengo in questo tipo di ristorante... \\n(Mi sento un po' a disagio con le ragazze ovunque...)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Va bene, vediamo... beh, prendo questo! \\nParfait di gelato al mirtillo Super soda Bevanda speciale DX!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Il nome sembra davvero fantastico!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Sei davvero un bambino, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Prenderò solo un caffè...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, sei una ragazza adesso. \\nNon vuoi provare qualche dessert? Sono davvero deliziosi!", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Ok... fammi controllare. \\nEmm… Muffin al formaggio Matcha Napoleon… (Non male.)", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Torta reale con crema all'arancia candita… (sembra buonissima…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Sundae con frutta ghiacciata, festa tropicale... \\n(Gulps)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Scusate... avete deciso?", "Cameriere")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Beh... Uhm\\nforse... solo caffè... grazie...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bene.", "Cameriere")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Bene…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Uh, aspetta! Ho cambiato idea... \\nUn semifreddo con gelato alla fragola e mousse ai mirtilli, per favore...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Voglio solo assaggiarlo! \\nPrima ho visto solo ragazze mangiarli...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ahah, non c'è bisogno di spiegare.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mi dispiace farti aspettare. Ecco il tuo ordine.", "Cameriere")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Grazie!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Divertitevi!", "Cameriere")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Ok, pronto a partire!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Uhm... buonissimo..!!", "Lian")
	await novel_interface.show_dialog("La fragola ha un profumo così fresco. La crema è davvero dolce. E la mousse ai mirtilli, un po’ acidula ma davvero gustosa…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sento un po' in imbarazzo quando scopro che Annie mi fissa.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Le ragazze adorano questi dessert. Ho sempre desiderato sapere\\nche sapore hanno.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, sei così...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Ehm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Così adorabile!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cos... di cosa stai parlando...!", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
