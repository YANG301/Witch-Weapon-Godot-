# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Es ist ein glühend heißer Sommernachmittag. Ich lege einen Stapel Papiere neben den runden Tisch im Hof ​​und lasse mich auf einem Stuhl im Schatten unter den Bäumen nieder.")
	await novel_interface.show_text_only("Vor einiger Zeit sah ich dieses hübsche Mädchen, wie es mit seinem Stapel Bücher kämpfte. Ich überlegte nicht lange und reichte ihr die Hand.")
	await novel_interface.show_text_only("Dann eilte sie einfach weg, wenn auch zum Glück. Da wurde mir klar, dass ich ein Idiot bin.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Puh... Lass mich hier eine Pause machen... Es ist so heiß.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Leider war es für mich als Junge ein Kinderspiel.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Und dann steht da noch dieses SID Training an... Meine Güte, kann ich mich irgendwo verstecken?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, achten Sie auf Ihr Benehmen... \\nDas ist eine Schule.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Hey, Annie! \\nWas ist los?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hör zu... Ich weiß, es ist heiß. \\nAber... ist es wirklich notwendig, das Hemd hochzuheben, um den Schweiß abzuwischen?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ich meine ... Seien Sie vorsichtig bei einer Garderobenstörung ...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Verdammt!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Dieses Lian Mädchen ist so unhöflich...", "Schüler A")
	await novel_interface.show_dialog("Ja, ich habe sie neulich gesehen, wie sie ihre Beine spreizte und einen Rock trug.", "Student B")
	await novel_interface.show_dialog("Wirklich? Igitt…", "Schüler A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(Ich hätte überhaupt keine Röcke tragen sollen, okay?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hey…")
	await novel_interface.show_text_only("Was für eine sanfte Stimme.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Benutzen Sie mein Taschentuch, wenn es Ihnen nichts ausmacht.", "Elegantes Mädchen")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vor mir steht ein schönes und elegantes Mädchen. \\nSie hat langes, seidiges, lila Haar und lila Augen.")
	await novel_interface.show_text_only("Sie reicht mir ein Taschentuch mit einem exquisiten und frischen Duft.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Äh?! \\nDanke... Danke.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Sie sind die Transferstudenten im ersten Jahr, oder? \\nMein Name ist Nix Strozzi. Ich bin dein Ältester.", "Nix")
	await novel_interface.show_dialog("Ich habe dich schwitzen sehen und habe zufällig mein Taschentuch dabei, also... \\nIch hoffe, ich störe nicht.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix nickt mir höflich zu, aber ich flippe aus. Ich stehe auf und salutiere ziemlich dumm.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Nein... Überhaupt nicht! \\nEs ist eine große Hilfe!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Sie wirkt sehr liebenswürdig.) \\n(Ist sie eine Ausländerin? Schauen Sie sich diese langen Wimpern an...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue in das zarte Gesicht von Nix, mein Herz rast.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Es ist mir ein Vergnügen. \\nAlso... Ihr Name ist...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Ich bin Lian. Sie ist Annie. \\nWir sind erst kürzlich hierher gewechselt.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix wirkt verwirrt und starrt Annie an, wenn auch nur kurz.")
	await novel_interface.show_text_only("Dann lächelt sie Annie freundlich an. Ich frage mich, ob es gerade nur meine Illusion war.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich freue mich, Sie heute kennenzulernen.", "Nix")
	await novel_interface.show_dialog("Aber ich muss jetzt gehen. Lassen Sie mich wissen, ob ich Ihnen helfen kann.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Danke, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie zögert ohne Antwort.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dieses Mädchen, Nix..., sie sieht viel edler aus als jedes dieser Silberlöffel-Mädchen.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, geht es dir gut? \\nDu warst still.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Hat sie gesagt, dass sie eine Strozzi ist?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh, kennst du sie?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie nimmt meinen Arm und lächelt mich unschuldig an.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Nein. \\nWir sind neu hier. Wie konnte ich sie kennen?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ja, du hast recht.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
