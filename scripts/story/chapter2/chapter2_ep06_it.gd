# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Brombando) Quel moccioso era molto più interessante...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una richiesta di connessione per una chiamata vocale lampeggia diagonalmente sullo schermo davanti a Mariru. La voce elettronica deliberatamente distorta maschera il genere originale di chi parla.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Ho fatto questo briefing molte volte, ma questo formato di interferenza crittografata unilaterale è ancora esasperante.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Allora, per quanto riguarda la scomparsa del Ross Goblet, come stanno procedendo le indagini adesso?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Alle 00:15 di questa mattina, il sistema di sicurezza ha confermato che il Ross Goblet era scomparso.", "Mariru")
	await novel_interface.show_dialog("Alle 06:40, il sistema di monitoraggio satellitare True Sight ha emesso un avviso dopo aver rilevato una grave distorsione dimensionale.", "Mariru")
	await novel_interface.show_dialog("Quindi, dalle 07:00 di questa mattina fino ad ora, il sistema Aegis ha rilevato sei avvisi di fluttuazione della fase spaziotemporale all'interno di New Opulentia.", "Mariru")
	await novel_interface.show_dialog("E se prendiamo come centro l'istituto di ricerca, trentadue allarmi simili sono comparsi contemporaneamente in un raggio di millecinquecento chilometri...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Tutto questo è già nel documento. Dammi la conclusione.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru guarda oltre la sua spalla destra e sorride.")
	await novel_interface.show_text_only("Solo dal tono, può dire che si tratta dell'amministratore delegato severo e senza sorrisi di Senato.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—Non è stato un furto. Fu il risveglio di un Substance H, insieme alla reazione a catena che scatenò.", "Mariru")
	await novel_interface.show_dialog("E a giudicare dalla frequenza e dalla scala attuali, non siamo ancora in grado di determinare se sia di tipo memetico Substance H.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nell'istante in cui Mariru finisce di parlare, mormorii sorpresi e discussioni sommesse si propagano attraverso gli schermi oscurati intorno a lei.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Cosa?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una voce profonda e ferma proviene dalla sinistra di Mariru.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Intendi un'esplosione esponenziale di un \"Tocco Divino\" che influenza la mente?\nQuesto è interessante...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Al momento, sembra più probabile che si tratti di più incidenti contemporaneamente.\n\"Divine Touch\"... Non amo particolarmente la terminologia imprecisa.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Sebbene sia l'autorità in materia di influenza mentale Substance H...)", "Mariru")
	await novel_interface.show_dialog("(Non riesco ancora a scacciare la sensazione che questo gorilla si sia fritto il cervello a causa delle troppe radiazioni.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Quindi secondo il tuo giudizio...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Non posso ancora inviare un rapporto conclusivo. Semplicemente non abbiamo abbastanza informazioni utilizzabili.", "Mariru")
	await novel_interface.show_dialog("Considerata la situazione attuale, richiedo un ordine di indagine di Classe S senza restrizioni. Spero che possiate capire tutti.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ignorando i sussurri intorno a lei, Mariru riporta la sua attenzione al terminale portatile.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Quella ragazzina è andata in un'altra zona anomala...)", "Mariru")
	await novel_interface.show_dialog("(Come previsto, è scomparsa, è riapparsa poco dopo, e poi la fluttuazione di fase nelle vicinanze si è fermata di nuovo.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Nel filmato della scena... c'è sangue su di lei?)", "Mariru")
	await novel_interface.show_dialog("(Quell'idiota... non dirmi che in realtà—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Sembri un po' distratto.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa?... Niente affatto.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Qualunque cosa tu stia fissando, contiene informazioni più importanti di questo briefing?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...No, è solo il video di un gattino. Vuoi vederlo?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Un forte lamento elettrico e un ronzio esplodono dalla sinistra di Mariru.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Non essere così arrabbiato. Una piccola deviazione migliora l’efficienza del lavoro.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru spazia lo sguardo per la stanza. Sembra che nessuno si sia accorto del momentaneo errore proprio ora.")
	novel_interface.character_light()
	await novel_interface.show_dialog("In ogni caso, le informazioni di base che abbiamo ottenuto finora sono esattamente quelle dichiarate nel briefing.\nL'incidente è ancora oggetto di ulteriori indagini.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se non ci sono domande, mi dirigo sulla scena.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Prima che Mariru possa andarsene, una voce un po' impertinente arriva dalla sua sinistra.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...Ho sentito che i tuoi subordinati hanno riportato due studenti delle scuole superiori a SID per interrogarli?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Ancora quell'odioso bastardo.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("C'era qualcosa di speciale in loro, Signora Mariru... no, Dottore?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Niente di niente. Lo abbiamo già confermato: erano solo due gattini troppo curiosi che si sono intrufolati in una zona riservata.", "Mariru")
	await novel_interface.show_dialog("Farò in modo che li mandino a casa dopo.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Capisco. Va bene, allora.", "#C")
	await novel_interface.show_dialog("In un momento delicato come questo, sarebbe problematico se altri paesi iniziassero a trattarli come una sorta di strana esistenza...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Questa osservazione suscita scalpore tra gli altri.")
	await novel_interface.show_text_only("...Cosa dovrebbe significare?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Un'osservazione imprudente può mettere a disagio alcune persone, ne sono sicuro.\nMi scuso, fai finta di non averlo mai sentito.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Che uomo assolutamente detestabile.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Ebbene, comunque questo incidente ha già attirato l'attenzione delle altre Città Accademia.", "Bright")
	await novel_interface.show_dialog("D'ora in poi faremo affidamento su di te per le indagini riservate e la gestione delle informazioni pubbliche.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Naturalmente.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
