# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Me olho no espelho no canto do corredor. \\nMeu cílio choroso sobe e desce enquanto respiro.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Na verdade… sou uma menina agora?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Lá embaixo... Se foi...)", "Lian")
	await novel_interface.show_dialog("(Neste caso...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Como... como eu faria um vazamento...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Pescando por aí...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("O que você está fazendo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Uau!!", "Lian")
	await novel_interface.show_dialog("Não é... Uhm... \\nDesculpe!! Eu não queria...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Haha. Desculpe pelo quê? \\nPor se tocar?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(O que... o que posso fazer?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Hum...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Como as meninas... como elas…", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê? O que você quer de mim? Por favor, seja específico.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Como eles usam o banheiro?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein?!", "Mariru")
	await novel_interface.show_dialog("Hahaha…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Finalmente, digo isso em voz alta! Não zombe de mim de novo...)", "Lian")
	await novel_interface.show_dialog("(Mas parece que não aguento mais...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Ei… não ria de mim!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Apenas sente-se e faça o trabalho. Simples assim.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("O banheiro feminino fica no fim do corredor. Mover!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Aff. Ele hesitou por um momento... \\nE finalmente entrou correndo em lágrimas.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Tão... fofo!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (descarga de água)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ah. Finalmente relaxe.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Espere... Como...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Como faço para me livrar disso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Feito? Como você se sente sobre isso?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("É um assunto privado!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Não é à toa que ouvi dizer que o banheiro das meninas muitas vezes fica sem papel higiênico...)", "Lian")
	await novel_interface.show_dialog("Uaaaah... \\nTão embaraçoso...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Droga!! \\nPreciso voltar ao antigo eu! Mal posso esperar!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
