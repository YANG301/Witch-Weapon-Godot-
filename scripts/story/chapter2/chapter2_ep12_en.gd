# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("After finishing a whole series of registration procedures for SID cadet training, I was handed a thick stack of \"textbooks.\"")
	await novel_interface.show_text_only("Then, under the guidance of a staff member, I took a small, inconspicuous elevator up from SID Headquarters.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("The elevator rose fast enough that I could clearly feel the pressure building in my ears.\nBy the time I reached the surface, I realized it was already evening...")
	await novel_interface.show_text_only("The elevator opened into the lobby of a small office building, and just outside was the crowded commercial district.")
	await novel_interface.show_text_only("I heard the elevator can only descend to the deeper levels when it recognizes that every passenger is authorized personnel. Otherwise, it just travels between the first and third floors of the office building.") #换行问题
	await novel_interface.show_text_only("On the building's second floor there was a 24-hour café with people coming and going all day—perfect for hiding in plain sight.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Sigh...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("I thought agent training would involve things like hand-to-hand combat and shooting, but this feels more like I signed up for an entire cram school package...", "Lian")
	await novel_interface.show_dialog("These books are seriously heavy!\nGood thing the place Mariru arranged for me isn't far from here.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Academy District East Road No. 6... She said it was a very low-key—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("—How is this low-key at all?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I was standing inside a luxury residence on the top floor of a high-rise. The lavish living room connected to a giant terrace overlooking the commercial district's night view.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Are those flames along the wall an actual fireplace?\nThis is way too over the top...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Just as I was cautiously looking around and wondering whether I'd walked into the wrong room, I received a message from Mariru.")
	await novel_interface.show_text_only("Mariru: Pick any bedroom you like.\nNo need to be polite with the Senate's budget~") #原文有个♥
	await novel_interface.show_text_only("That woman... Apologize to New Opulentia's taxpayers right now!!")
	await novel_interface.show_dialog("Lian, you're back!", "Annie")
	await novel_interface.show_text_only("Annie came out of the bathroom, one hand gathering up her hair as she walked.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! You're here too?\nMariru said you'd gone off for some special training just now...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("I finished the training ahead of schedule. I just took a shower and tried on the school uniform.\nLooks like we're going to be roommates~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Right...\n(Seems like Mariru did mention that...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(Is this some kind of test from heaven?)\n(Living under the same roof as a girl and all...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Is that this school's uniform? It's really cute~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Mm-hm~ The clothes they prepared for you are in that box over there. You should try them on too!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("I-I have to wear one too...?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hehe, Lian, are you still not used to being a girl?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As soon as she brought that up, I couldn't help but scratch my head and collapse onto the sofa.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("How could anyone get used to something like this...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... No one could possibly understand what this feels like.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("I do understand.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie suddenly sat down beside me and lightly brushed my cheek with her fingertip, as if to comfort me.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Because we're the same.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("There was a faint bitterness in her smile.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("W-What—?!\nYou used to be a boy too?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ahahahahaha! Lian, are you an idiot?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("I've always been a girl~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agh...\n(That's mortifying!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Just when my embarrassment was about to hit its peak, Annie stopped laughing and looked at me gently.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("But the panic in your heart right now... I really do understand it completely.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("I was trapped in another spacetime before too...\nThat feeling was probably a little like what you're going through now.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Another... spacetime?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie paused, as if she were thinking carefully about how to phrase it.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Didn't Miss Mariru tell you?\nI spent a very long time drifting in another spacetime without really understanding anything...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Time felt vague there. It didn't seem all that long, but when I came back, I realized seven years had already passed.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mm, I heard a tiny bit about it...", "Lian")
	await novel_interface.show_dialog("(Though that was only from a few scattered hints Mariru dropped...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("What exactly happened to her?\nShould I ask her directly?")
	await novel_interface.show_text_only("Annie didn't continue. She just lowered her head and absently played with her fingers.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... do you ever feel this way too—", "Annie")
	await novel_interface.show_dialog("Like all of this might just be a dream, and the next time you open your eyes, you'll finally wake up.", "Annie")
	await novel_interface.show_dialog("This isn't how things were supposed to be. You're not supposed to be here...\nBut no matter what you do, you can't get back onto the normal track.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(So Annie made it this far carrying feelings like that all by herself...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I edged a little closer to Annie and gave her shoulder a gentle pat.\nUh, comforting a girl like this... should be okay, right?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Don't be scared. You're back now, aren't you~", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Mm...\nBut everything still feels so unfamiliar to me...", "Annie")
	await novel_interface.show_dialog("I don't even have the faintest idea what all of you mean by an \"academy city.\"", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... Right. The war hadn't even ended yet when Annie disappeared.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("So that means you still don't know what happened over these past few years, right?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("I only looked things up roughly... So much has happened over the years that I don't even understand what a lot of the words in the news are supposed to mean anymore.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Seven years ago...\nThat was right in the middle of the war that threw the whole world into chaos.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Huh? The war?\nDo you mean the military campaign Masada Fort launched against Europe?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie tried hard to remember.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, not that one. Not long after that, almost every country got dragged into it.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("I was in elementary school at a boarding school back then. Every day the news was full of war reports and casualty counts. It was a pretty awful time...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, did you live through the war too?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Not exactly. Thanks to Aegis's protection, New Opulentia was focusing all its efforts on reconstruction beside the ruins back then.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I looked out at the prosperous city nightscape beyond the window... When I was little, the city was full of giant cranes and busy construction machinery everywhere.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So most of what I know came from textbooks.", "Lian")
	await novel_interface.show_dialog("Because of the war, miracle technology advanced rapidly...\nAnd by \"miracle,\" I mean phenomena caused by Substance H.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("After the war, the six countries that had mastered the key technologies each established one of the world's six academy cities.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Feels like I suddenly awakened some hidden talent for being a history teacher...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("So that much really happened... I can't even imagine it.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Well, when Annie left—uh, disappeared—the world was still comparatively peaceful, right...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("That's right. Back then I could still compete in international baseball games!", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("The moment Annie brought up baseball, her eyes started to shine.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("You know, Lian, whenever it was my turn at bat, all the spectators' eyes would focus on me alone!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("That mixture of tension and having to give it everything you've got would make the blood in my whole body boil!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("When baseball came up, I suddenly thought of the black stone monument outside Lebona Baseball Stadium, engraved with the names of tens of thousands of the dead.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Actually...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Hm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Maybe missing the worst years of the war was a good thing for you after all.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("When I think about it that way, maybe turning into a girl and meeting you\nwasn't entirely a bad thing either... in a sense?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie froze. For a moment, she almost looked embarrassed...\nOr was I imagining it?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... I've actually been wanting to thank you this whole time.\nBecause... it was you who saved me from wandering in that world.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Huh? But I didn't do anything...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's exactly why you must be special~", "Annie")
	await novel_interface.show_dialog("I still don't know how you did it, but at that moment, I could feel your warm hand pulling me along.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie gently took my hand and sank into her memories.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If it hadn't been for you, I don't know how much longer I would have stayed trapped over there, or what I might have become in the end...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Become... what?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahaha~ It's nothing. That's all in the past now.\nI suddenly feel a little sleepy~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie seemed to want to dodge the subject.\nShe stretched lazily, still wearing a smile.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("How long are you two planning to keep this girls' night talk going?", "Mariru")
	await novel_interface.show_text_only("Mariru's voice suddenly came out of the speaker in the corner of the room.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("M-Mariru?!\nWere you listening in just now?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("What? Is there something wrong with a guardian keeping an eye on a couple of kids' schedule?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("You really have the nerve to say that...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Talking back too?\nLooks like I'll have to train you extra hard tomorrow...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("I'm sorry! I'll take a bath and go straight to bed right away!\nGood night!!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
