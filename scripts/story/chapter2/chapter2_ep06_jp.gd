# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("（独り言）やはり、あの小娘の方が面白いな……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルの斜め前にあるスクリーンに、音声回線接続の通知が一瞬だけ表示された。続いて、意図的に加工された電子音が流れ、話し手の性別を覆い隠した。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("（こういう報告は何度もやったが、一方的に暗号化ノイズを被せてくる形式は、本当に気分が悪い）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("では、『ロス・ゴールド』消失事件についてだが、現在の調査状況はどうなっている？", "キルス")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("本日午前零時十五分、保安システムが『ロス・ゴールド』の消失を確認しました。", "マリル")
	await novel_interface.show_dialog("午前六時四十分、『トゥルービジョン』衛星測監システムが警告を発し、強力な次元歪曲を検知しました。", "マリル")
	await novel_interface.show_dialog("その後、午前七時から現在まで——『イージス』システムは新豊洲市内で計六件の時空位相波動警報を検知しています。", "マリル")
	await novel_interface.show_dialog("さらに研究所を中心に、半径千五百キロ圏内で三十二件の類似警報が同時に発生しています……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("その程度は文書に目を通せば分かる。結論を言え。", "キルス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは右後方へ視線をやり、薄く笑った。")
	await novel_interface.show_text_only("声色だけで分かる。あれは、厳格で滅多に笑わない元老院首席執政だ。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("——これは単なる盗難事件ではありません。『異質物』の覚醒と、それに伴う連鎖反応です。", "マリル")
	await novel_interface.show_dialog("加えて、現在の頻度と規模から見ても、模因型異質物かどうかさえ断定できません。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが言い終えた瞬間、暗いスクリーンに囲まれた会場のあちこちから、驚きとざわめきが漏れた。")
	await novel_interface.show_text_only("！！！！！")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("何だと！？", "キルス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("低く落ち着いた嗓音が、マリルの左側から響く。")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("精神干渉型の『聖痕』が指数関数的に爆発したと？\nそれはまた実に興味深いな……", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("現状では、単純に複数の事件が同時発生している可能性の方が高い。\n『神跡』……私はあまり、そういう大雑把な言い方は好みません。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（とはいえ、あの男は精神干渉系『異質物』の権威だが……）", "マリル")
	await novel_interface.show_dialog("（だがあのゴリラ、放射線を浴びすぎて頭までやられたんじゃないかと時々思う）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("君の見立てでは、どう判断している？", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("現時点で結論めいた報告はできません。有効な情報が少なすぎます。", "マリル")
	await novel_interface.show_dialog("現在の事態を鑑み、私は無制限のS級調査令を申請します。皆様にはご理解を願いたい。", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは周囲の囁きを意に介さず、再び手元の端末へ意識を向けた。")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("（あの子が新しい異変区域へ行った……）", "マリル")
	await novel_interface.show_dialog("（やはり、一度消えた後しばらくして再出現し、その周囲の位相波動も止まっている）", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（現場から届いた映像……彼女の身体のそれは血痕か？）", "マリル")
	await novel_interface.show_dialog("（あの馬鹿……まさか！！）", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("心ここにあらず、といった様子だな。", "キルス")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("何のことです？……まったくそんなことは。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("さっきから見入っているそれに、報告内容より大事な情報でもあるのか？", "キルス")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……まあ、ただの子猫の動画ですよ。皆さんもご覧になりますか？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("！！！", "キルス")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("マリルの左側から、甲高い電子音とブザーが響いた。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("そう怒らないでください。適度な息抜きは、仕事の能率向上に役立ちます。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("……", "キルス")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("マリルは周囲を見回したが、先ほどの動揺に気づいた者はいないようだった。")
	novel_interface.character_light()
	await novel_interface.show_dialog("ともかく、現時点で得られている基礎情報は以上です。\n事件については引き続き調査を進めます。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ほかに質問がなければ、私はこのまま現場へ向かいます。", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルが席を立とうとしたその時、左手側からどこか軽薄な声が割って入った。")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("……聞いた話では、君の部下が高校生を二人、SIDへ連れて帰ったそうだね？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……\n（またこいつか）", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("何か特別な点でも？　マリル閣下……いや、博士。", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……何もありません。さっき確認しましたが、ただ好奇心のまま封鎖区画へ迷い込んだ二匹の子猫です。", "マリル")
	await novel_interface.show_dialog("後でこちらから家まで送らせます。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("そうですか、それなら結構。", "#C")
	await novel_interface.show_dialog("こういう微妙な時期ですからね。万が一、他国に何か奇妙な存在だと思われでもしたら困るでしょう……", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("その一言に、会場は一気にざわついた。")
	await novel_interface.show_text_only("……こいつ、何を言いたいんだ？")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("少々配慮を欠く発言でしたかな。もし気分を害したのなら失礼。どうか聞かなかったことにしてください。", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("……\n（本当に腹立たしい奴だ）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("いずれにせよ、今回の事件はすでに他の学園都市の注意を引いてしまった。", "ブライト")
	await novel_interface.show_dialog("以後の極秘調査と世論誘導も、引き続き君に任せたい。", "ブライト")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("承知しました。", "マリル")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
