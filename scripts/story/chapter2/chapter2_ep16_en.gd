# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai checks the report against the data blinking on the monitor, smirking from time to time.")
	await novel_interface.show_text_only("Mariru snatches the report from behind Ai and studies it.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("So, how did the physical exam go? You look far too pleased with yourself.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… That's just fabulous!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("A boy's soul trapped in a girl's body… If the people at the Harima Brain Research Institute hear about Lian, they'll kill to file an experiment request and snatch her away.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("We must keep this to ourselves, understand?\\nAny new findings?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Their telomeres both indicate an age of fifteen, but the amount of cesium-137 in Annie's soft tissue is only a quarter of the present-day average.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Clever… \\nSo at most, she only lived through half of the Seven Years War?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Unless she’s been kept in a sealed capsule for years after the war.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I see. \\nWhat about Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("As for Lian… the level detected in her muscle tissue is less than one two-hundredth of the average—lower even than what newborns inherit from their mothers.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So it’s a newly synthesized body?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Now here's the really interesting part—her body carries antibodies to many long-extinct viruses, including smallpox.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Take it easy. There’s no residual virus in her spinal cord.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("I did a rough check—Lian's immune-system history seems to cover only the last few centuries. There are no antibodies to any pre-medieval viruses.", "Ai")
	await novel_interface.show_dialog("Still, I'd love to request a sample of her white blood cells and try culturing viruses No. 008, 217, and 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("This is not your job as a school doctor.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Yeah, right. I understand. \\nYou want me to keep an eye on them, right?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("They might have a link to the missing Ross Goblet… \\nI suspect they didn't tell the whole story.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Why not just lock them up and interrogate them?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Do you need a hand? Look, with a bit of modification, the tools I used for the checkup today would be perfect for the job…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai's eyes gleam with excitement. Mariru rolls up the report and smacks her with it.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Just keep your eyes and ears open. Report to me if anything happens.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Now that she's already noticed it, I'm afraid someone within SID might have…)", "Mariru")
	await novel_interface.show_dialog("(At least she'll stay controlled in the school) \\n(And in the meantime I could watch her...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("You don't have to tell me twice. I'll record every~ single change in Lian's body!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("You’d better keep a low profile and stay on track.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Heh heh, relax. \\nIt wouldn't be any fun if I drained her dry all at once.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
