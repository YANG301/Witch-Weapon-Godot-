# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai ตรวจสอบรายงานโดยเทียบกับข้อมูลที่กะพริบบนหน้าจอ และยิ้มเป็นครั้งคราว")
	await novel_interface.show_text_only("Mariru คว้ารายงานจากด้านหลัง Ai และศึกษามัน")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("แล้วการตรวจร่างกายเป็นยังไงบ้าง? คุณดูพอใจกับตัวเองมากเกินไป", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("อร๊าย… มันเยี่ยมมาก!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("วิญญาณของเด็กผู้ชายที่ติดอยู่ในร่างของเด็กผู้หญิง… หากคนที่สถาบันวิจัยสมอง Harima ได้ยินเกี่ยวกับ Lian พวกเขาจะฆ่าเพื่อยื่นคำขอทดลองและคว้าตัวเธอไป", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เราต้องเก็บเรื่องนี้ไว้กับตัวเอง เข้าใจไหม?\\nมีอะไรค้นพบใหม่บ้างไหม?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("เทโลเมียร์ของทั้งคู่บ่งบอกถึงอายุ 15 ปี แต่ปริมาณซีเซียม-137 ในเนื้อเยื่ออ่อนของ Annie นั้นเป็นเพียงหนึ่งในสี่ของค่าเฉลี่ยในปัจจุบัน", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉลาด… \\nอย่างมากที่สุด เธอมีชีวิตอยู่เพียงครึ่งเดียวของสงครามเจ็ดปีเหรอ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("เว้นแต่ว่าเธอจะถูกเก็บไว้ในแคปซูลที่ปิดสนิทเป็นเวลาหลายปีหลังสงคราม", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันเห็น. \\nแล้ว Lian ล่ะ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("สำหรับ Lian… ระดับที่ตรวจพบในเนื้อเยื่อกล้ามเนื้อของเธอนั้นน้อยกว่าหนึ่งในสองในร้อยของค่าเฉลี่ย ซึ่งต่ำกว่าระดับที่ทารกแรกเกิดได้รับมรดกจากแม่ของพวกเขา", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มันเป็นร่างกายสังเคราะห์ใหม่เหรอ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("นี่เป็นส่วนที่น่าสนใจมาก ร่างกายของเธอมีแอนติบอดีต่อไวรัสที่สูญพันธุ์ไปแล้วหลายชนิด รวมถึงไข้ทรพิษ", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("ใจเย็นๆ นะ ไม่มีไวรัสตกค้างอยู่ในไขสันหลังของเธอ", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("ฉันได้ตรวจสอบคร่าวๆ แล้ว—Lian ประวัติระบบภูมิคุ้มกันของดูเหมือนว่าจะครอบคลุมเพียงสองสามศตวรรษที่ผ่านมาเท่านั้น ไม่มีแอนติบอดีต่อไวรัสก่อนยุคกลาง", "Ai")
	await novel_interface.show_dialog("แต่ฉันก็อยากจะขอตัวอย่างเซลล์เม็ดเลือดขาวของเธอและลองเพาะไวรัสหมายเลข 008, 217 และ 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("นี่ไม่ใช่งานของคุณในฐานะแพทย์ในโรงเรียน", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("ใช่แล้ว ฉันเข้าใจ. \\nคุณต้องการให้ฉันจับตาดูพวกเขาใช่ไหม?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("พวกเขาอาจมีลิงก์ไปยัง Ross Goblet ที่หายไป… \\nฉันสงสัยว่าพวกเขาไม่ได้บอกเล่าเรื่องราวทั้งหมด", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("ทำไมไม่ขังพวกเขาไว้และสอบปากคำพวกเขาล่ะ?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("คุณต้องการมือไหม? ฟังนะ แก้ไขนิดหน่อย เครื่องมือที่ผมใช้ตรวจสุขภาพวันนี้จะสมบูรณ์แบบสำหรับงาน...", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai ดวงตาของ Ai เปล่งประกายด้วยความตื่นเต้น Mariru หยิบรายงานขึ้นมาและตบเธอด้วย")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("เพียงแค่เปิดตาและหูของคุณ รายงานให้ฉันทราบหากเกิดอะไรขึ้น", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(ตอนนี้เธอสังเกตเห็นแล้ว ฉันกลัวว่าคนใน SID อาจจะ...)", "Mariru")
	await novel_interface.show_dialog("(อย่างน้อยเธอก็จะถูกควบคุมอยู่ในโรงเรียน) \\n(และระหว่างนี้ฉันก็สามารถเฝ้าดูเธอได้...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("คุณไม่จำเป็นต้องบอกฉันสองครั้ง ฉันจะบันทึกทุกการเปลี่ยนแปลงในร่างกายของ Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("คุณควรรักษาโปรไฟล์ให้ต่ำและติดตามต่อไป", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("เฮ่ เฮ่ สบายใจ.. \\nมันคงไม่สนุกเลยถ้าฉันทำให้เธอแห้งทั้งหมดในคราวเดียว", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
