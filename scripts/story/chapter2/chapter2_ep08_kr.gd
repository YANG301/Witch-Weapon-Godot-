# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("앤은 옆방에 재워 뒀어. 너와 단둘이 얘기해야 할 게 있어.", "마리루")
	await novel_interface.show_dialog("방금 막 확실한 정보를 확인했어.", "마리루")
	await novel_interface.show_dialog("오늘 아침부터 여러 주요 도시에서 대규모 시공 이변이 발생했어……", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("영향을 받은 지역은 현재까지 화운궁성, 뉴모리다스, 마사다 성채, 살몬톤, 신토요스, 그리고 레보나 군도야.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("그럼 설마……\n6대 학원도시가 전부……?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("맞아. 지금은 전 세계가 이 일을 주시하고 있어. 영향 규모는 예상보다 훨씬 커.", "마리루")
	await novel_interface.show_dialog("내 생각엔, 한 가지 가능성이 있어……", "마리루")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("네가 꿈속에서 겪었다고 말한 모든 일 말이야. 연구 센터를 습격한 테러리스트, 폐허가 된 도시……", "마리루")
	await novel_interface.show_dialog("……그 모든 게 실제로 일어났을지도 몰라.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("뭐…… 뭐라고?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("확실한 증거는 없지만, 오늘 아침 이미 초대형 차원 왜곡이 발생했을 가능성이 높아.", "마리루")
	await novel_interface.show_dialog("SID 『진실의 시야』 위성도 동시에 전례 없는 규모의 노이즈 폭발을 감지했어.", "마리루")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("쉽게 말하면 이거야. 신토요스는 분명 한 번 멸망했지만, 어떤 힘이 그 현실을 비틀어 되돌려 놓았다는 거지……", "마리루")
	await novel_interface.show_dialog("그리고 그 힘은 네 몸의 변화와, 네가 맞닥뜨린 기묘한 적들의 습격과도 관련이 있는 것 같아.", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("물론 아직은 어디까지나 내 가설일 뿐이야.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("그 생각은…… 너무 대담한 거 아냐……?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("오늘 사건 때문에 다른 다섯 학원도시가 원로원에 압력을 넣고 있어. 직접 들어와 조사하겠다는 거지.", "마리루")
	await novel_interface.show_dialog("네가 이번 일과 관련 있다는 사실이 드러나는 순간, 연구 기관에 끌려가는 정도로는 끝나지 않을 거야……", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("모든 정보 조직의 요원들이 널 핵심 표적으로 찍겠지.", "마리루")
	await novel_interface.show_dialog("잠복 요원은 빼고도, 오늘 하루에만 위장 신분으로 신토요스에 들어온 각국 정보 인원이 백 명을 넘었어.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("그걸 그렇게 자세히 알고 있어,\n왜 막지 않는 거야?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("흥, 그들을 억지로 새 얼굴로 갈아치우게 만드는 것보다 지금처럼 내가 뒤에서 판을 읽는 편이 더 나아.", "마리루")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+",이건 분명히 알아둬. 네가 아직 여자 몸인 이상 예전 생활로 돌아가는 건 불가능해.", "마리루")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("그래도 제일 먼저 널 발견한 게 우리 SID였다는 건, 어쩌면 행운일지도 몰라.", "마리루")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("하룻밤 사이에 여자애가 돼 버렸다고……\n친구들이나 반 친구들한테 대체 뭐라고 말해야 하지……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("음…… 부모님 걱정은 안 돼?", "마리루")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("엄마는 내가 어릴 때 돌아가셨어.\n아빠는…… 실종된 지 벌써 여러 해가 됐고……", GameConfig.player_name)
	await novel_interface.show_dialog("나는 열두 살 전까진 줄곧 기숙학교에서 지냈어.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(……고릴라가 주도한 전후 보육 계획이 애들한텐 꽤 도움이 되긴 했군)", "마리루")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("그래, 고생 좀 했겠네.\n하지만 신분 전환 문제라면 걱정할 필요 없어.", "마리루")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("신분…… 전환?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("마리루의 얼굴에 불길한 미소가 떠올랐다……")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
