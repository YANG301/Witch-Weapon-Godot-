# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("With Mariru's permission, Annie and I decide to go shopping with Elluka.")
	await novel_interface.show_text_only("Elluka stands behind me, looking at everything cautiously.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, do you want chocolate?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, chocolate, like.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Here you are.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka takes the chocolate bar, unwraps it carefully, and takes a small bite.")
	await novel_interface.show_text_only("Just can't get enough of her. So cute!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hey, you are looking like a middle-age pervert.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("What?! I'm just a teenager.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervert.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Why did you both do this to me?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, I won't give you chocolate if you keep acting like that.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Shoot. She looks cute even when she is down.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Haha. I'm just kidding. \\nHere you are.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("How much chocolate do you have? \\nYou'll gain weight if you overeat.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("What's the big deal. I just have a few blocks.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie stares at me with a strange look, making me feel uncomfortable.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("What?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("I sneaked a look at your recent physical checkup report. \\nYou're putting on weight, but didn't grow any taller.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Why did you do this?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("To know you better, obviously.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Now I know you're only five foot three. Same as me.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Damn it. It's nothing to be proud of.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("But I was five foot four when I was a boy!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("That's not much of a difference, isn’t it?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("You tricked me... \\nI shouldn't have told you this.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("While Elluka enjoys her chocolate, the conversation catches her attention. She suddenly looks up in confusion.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Sister Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Yes?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Brother... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sister? Brother? \\nData corrupted. Unidentifiable.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Forget what we just said!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Re-scanning target. Female identified... \\nSister? Brother?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaaahh! Stop!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
