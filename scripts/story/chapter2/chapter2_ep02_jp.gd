# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("各班、注意！　位相変動が減衰している！", "捜査員A")
	await novel_interface.show_dialog("敵がいつ現れても、おかしくない状況だ！\n各位ポジションを守れ　迎撃準備をっ！！", "捜査員A")
	await novel_interface.show_dialog("……報っ、報告です！", "捜査員B")
	await novel_interface.show_dialog("目視範囲内に人型ユニットを二体確認、異変コア区域に突如出現しました……", "捜査員B")
	await novel_interface.show_dialog("人間……？\nあり得ない！　ミーム検知の結果は！？", "捜査員A")
	await novel_interface.show_dialog("色別反応は……グリーンですッ！！", "捜査員B")
	await novel_interface.show_dialog("どうやら2人の少女のようです……\nオイっ！　撃つなっ！　撃つなっ！", "捜査員B")
	await novel_interface.show_dialog("……", "捜査員A")
	await novel_interface.show_dialog("たった今命令が入った。最優先であの二人を確保し、本部へ連行する。\n上級捜査員を一人、交渉に向かわせろ――", "捜査員A")
	await novel_interface.show_dialog("他の者は警戒を続けろ。交渉中でも対象に異変があれば即座に処分しろ！！", "捜査員A")
	await novel_interface.show_dialog("了解です！", "捜査員B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("俺たちは慎重に研究センターの出口へ向かった。")
	await novel_interface.show_text_only("そこで俺たちを待っていたのは、見慣れた街並みと、その手前に張られた封鎖線――そしてその向こうで武器を構える大勢の連中だった。")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("な、なんで、こんな大勢の人がっ！？", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("あ――アニー！\n早く俺の服を元に戻してくれ！！", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("こ…こんな恥ずかしい格好……\nこれ以上見られたくない……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("こんな時でも、気にするのはそこなんだ？", "アニー")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("あなたの服なら、ちゃんと私が預かってるから心配いらないよ……", "アニー")
	await novel_interface.show_dialog("どうしても着替えたいなら、今の『戦闘服』を脱いで、元のぶかぶかの服を着ればいいだけだよ～", "アニー")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("でも～、目の前には男の人とか～が大勢いるね～\n本当に彼らの目の前で着替えちゃうのかな～？", "アニー")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ううう～～\n俺だって男なのに……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("そういえば……さっき着てたのって全部男物だったよね！\nもしかして――", "アニー")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("えっ？　前にもこんなことがあったのか？？", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("（そうだよな……アニーって、やっぱり普通の人じゃないんだろうな？）", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("（アニーなら、もしかしたら俺の身に何が起きてるのか分かるかも……）", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("うんうん、分かるよ……", "アニー")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("好きな男の子の服をこっそり持ち出して、自分で着ちゃったんでしょ？", "アニー")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ダメだ、分かってねえッ！！！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("うんうん～、実は"+GameConfig.player_name+"って異性の匂いに惹かれちゃうタイプなんでしょ？\n恥ずかしがらなくていいんだよ……", "アニー") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そういう『変態だけど受け入れてあげるわ』って顔するのやめろッ！！！", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("はぁ……どうしてこんなことになったのか、まだ全然分からない……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("……")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("止まれ！\n手を上げろ！", "SID捜査員")
	novel_interface.character_dark()
	await novel_interface.show_text_only("黒いスーツ姿の人物が一歩前に出て、俺たちに向かって叫んだ。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("えっ……？\n俺たち、悪者扱いされてるのか？", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("（待てよ、先頭のあいつの胸についてるあのマーク……）\n（真円の、輪が重なった盾――まさか……）", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("お二人とも、私はSIDの捜査員です。\n怪我を避けるため、そのまま動かないでください。", "SID捜査員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("やっぱりSIDの連中だ！\nこれはマズい！！！")
	await novel_interface.show_text_only("頭の中に、SIDが大勢のエージェントを引き連れてスパイを逮捕するニュース映像が一瞬でよぎった。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("それに『秘密監獄』だの『暗殺任務』だの、ろくでもない都市伝説まで……")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("コア封鎖区域より報告。対象二名に攻撃意思なし。\n暫定脅威レベルはD+。", "SID捜査員")
	await novel_interface.show_dialog("まずは簡単に聞かせてもらおう……\n――君たちは何者だ？　ここで何をしていた？", "SID捜査員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("俺はこの街の学生です……", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("お、俺たちは校外学習で研究所を見学しに来ただけで……", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("黒いスーツの捜査員は、あからさまに鼻で笑った。")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("そうか——見学？研究所？", "SID捜査員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("しまった……\nそうだ、思い出した――")
	await novel_interface.show_text_only("『ロス金杯』が消えたせいで、研究所は昨夜から緊急戒厳中だったんだ。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("そんな時に俺たちが中からのこのこ出てきて、『ちょっと見学してました』なんて言ったら……どう見ても自分から白状してるようなものだ。")
	await novel_interface.show_text_only("案の定、あの捜査員はイヤホン越しに何か指示を受けたらしく、険しい目で俺を見つめてきた。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("上からの命令だ。二人とも、こちらへ同行してもらう。", "SID捜査員")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ほんの数秒で、俺たちは完全に包囲されてしまった。")
	await novel_interface.show_text_only("視界に入るのは、こちらへ向けられた黒々とした銃口ばかりだ。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+"、こいつらかなりヤバそうだよ……\n隙を見て逃げちゃおう？", "アニー")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("安心してください。\nあなた達の身の安全は保障いたします。\nご協力さえして頂けるならば、穏便な解決へと\n最善を尽くします。", "SID捜査員")
	await novel_interface.show_dialog("『異質物』の失踪は重大事です。常識を逸した事態を招く恐れもあります。\nどうか理解してください。", "SID捜査員")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("（常識外の事件……か…）", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("分かりました、ついて行きます。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("えっ？？　なんでついて行くの！？\nちょっと！"+GameConfig.player_name+"！", "アニー")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ひ、引っ張るなっ！　バカっ！\nスカートが脱げるだろっ！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("あんたのほうがバカだよ！　なんでこんな怪しい連中について行くの？\n薬を盛られて売り飛ばされたらどうするの！？", "アニー")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("俺みたいな男にそんな事……", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("そもそも人を攫って売るために、\n誰がこんな大人数を用意するんだよ！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+"はきっとリバーナ諸島のマフィアを\n見たことないんだね……", "アニー")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("とにかく……\n何かが分かるかもしれないじゃないか！\n大人しくついていこう……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("分かった。あなたが行くなら、私もついて行くよ……", "アニー")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あの～、できればコートを1枚もらえませんか？", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("この服はさすがにちょっと……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("女性用の服を着ている姿を見られ続けるなんて、身体中がむず痒くて仕方がない。")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("……分かった。申請してみる。", "SID捜査員")
	await novel_interface.show_dialog("……", "SID捜査員")
	await novel_interface.show_dialog("……すまない。上の人が『その服、可愛いな』って言って、\nきっぱり却下された。", "SID捜査員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("どんな上司なんだよ、それ！！", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
