# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("Back at the apartment, Elluka is still clinging to my clothes even in her sleep.")
	await novel_interface.show_text_only("Annie and Mariru order me to turn around and not peek, then form a human wall while they remove Elluka's metal gauntlets and torn coat and change her into ordinary clothes.")
	await novel_interface.show_text_only("Then they make me swear on my life that I won't do any harm to Elluka, before allowing me to take her to my room.")
	await novel_interface.show_text_only("...Now Elluka is asleep on my bed, still clutching my clothes, so all I can do is sit beside her.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Why are you so clingy, kiddo? \\nGod, I'm so tired…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("After a whole night’s operation, I'm completely worn out. As I fall back onto the bed, I feel the paper in my pocket.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Annie said these are… the Grimoire Fragments?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Elluka appeared to want these, and looked at me like a cute pet…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lying on the bed, I examine the pages once again. But the content is just as incomprehensible as what it appeared earlier.")
	await novel_interface.show_text_only("As I turn the pages, a couple of pages slip out of my hand and fall on Elluka's body.")
	await novel_interface.show_text_only("The moment the pages touch her body, a blueish glow suddenly appears.")
	await novel_interface.show_text_only("A wave of symbols and words burst out of the pages, and even the air in my room starts trembling.")
	await novel_interface.show_text_only("All of a sudden, the remaining pages seem dragged by some invisible force towards Elluka's body.")
	await novel_interface.show_text_only("There is a blast of dazzling light, then everything disappears.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Wh-What is this—?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Search initiated. Target identified—\\nChocolate... big sis!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Elluka?! You're awake!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka suddenly throws her arms around me. At the same time, the door behind me is slammed open.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Hey, what was that shaking?\\n...Wait, did you finally make a move on Elluka?!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie looks at me as if I'm a pervert.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("It's not what you think. Let me explain!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Energy, full.\\nSearching... target not found.", "Elluka")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Why, who are you looking for?", "Lian")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("… Administrator, of the Courthouse.", "Elluka")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("The Courthouse...? What's that?\\nAnyway, let's get Mariru and figure out what to do.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Courthouse… You guys are getting me in big trouble. Your friend is a member of the Congregation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Huh? What's that?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("While researching on witches, I got to know about these strange underground organizations, including the Congregation, the oldest of the kind.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("The Congregation later split into different factions, and the Courthouse is one of them.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Since it split off hundreds of years ago, the Courthouse has been threatening to wipe out all witches, and had orchestrated the infamous Witch's Hunt.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("I hate to deal with such superstitious groups.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("I was originally planning to place Elluka in a childcare school in New Opulentia...\\nBut under the circumstances, I can't just let her go.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("You must have other plans. You’d better not conduct any strange research on her…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Am I that bad in your eyes?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru knocks my head. \\nElluka pouts and stares at Mariru angrily.")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Target identified. Threat rating, extremely high.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("… Little brat.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, Elluka, what task did Jacob give you?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka frowns and slowly recalls her task—")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("First, terminate the witches. Completed. \\nSecond, obtain the manuscript. Failed.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("The manuscript? Isn't Lian the one who has it?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Searching… Status exception. \\nManuscript… consumed.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Consumed? You mean the pages are inside you now?\\nOr were they part of Elluka's grimoire all along?", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Your Administrator wouldn't let you absorb them...\\nWas he afraid you'd become too powerful for him to control?", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("That’s a full story from just a couple of her words, Lian. Well done!", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Wait, Elluka's Grimoire. \\nWhich means…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("This little kid is also a witch?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru tries to pinch her cheek, but Elluka nimbly dodges it.")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("I've long heard that some groups attempt to create and control witches. There’s no lack of careerists dying to have super soldiers!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("How do you two know so much about witches...? I'm the only one in the dark here. Tell me—how does a girl become a witch?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Uh, at first, I wasn't sure either. I remember reading that book without knowing what it was.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("I started feeling dizzy as the content became increasingly difficult. Then at one point, I felt like an unknown force just went into my body.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("One day, I uttered a spell from the book, and was dragged into another Spacetime…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Spacetime… According to satellite data, the Spacetime Flux had already stopped when you arrived at the substation.", "Mariru")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No wonder I didn't have the same feeling as I had in other Flux Areas!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("What you call a Flux Area is referred to in ancient witch literature as a \"Witch's Cocoon.\"", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("It forms when a human transforms into a witch. Outsiders can neither break it nor enter it. It's very similar in nature to a space generated by Substance H, wouldn't you say?", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("And almost at the moment the flux disappeared, our satellite detected optical signals—", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("I mean, the guys you fought against appeared.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Think about it — “Witch’s Cocoon”… The moment the cocoon disappeared, these guys came out. It's like they hatched from the cocoon.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Witch, terminate!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("So witches have indeed lost their minds as they can't bear the information on the Grimoire!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("They were just normal girls. They couldn’t stand the magic power coming from the scripts and were hurt.", "Annie")
	await novel_interface.show_dialog("The moment they triggered a violent spatial distortion, they became...\\nThe monstrous beings people call \"Witches.\"", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("It's said in many ancient books that the more information on magical power one knows, the more easily they suffer from irreversible madness.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("If their sanity is lost, the witches may cause great disasters. If this is true…", "Mariru")
	await novel_interface.show_dialog("Then this might be a reason why the Witch's Hunt lasted so long in Europe.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Crap. Sounds like a pandemic.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("According to what we know, Elluka's Administrator prioritized witch hunting as a way to recover the Grimoire Fragments.", "Mariru")
	await novel_interface.show_dialog("But he didn't allow Elluka to use the Grimoire… Maybe he wants to create more witches with it.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("But I read Elluka's Grimoire, and didn't recognize a single word. Does it have anything to do with me being a boy?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("… Boy?", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka looks nervous and steps back, her face puzzled.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Uh, Elluka, I'll explain this later. \\nDon't worry…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("But I could read it. So maybe Lian really is just an idiot after all?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("I'm more curious about how you could easily enter the Witch's Cocoon.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("I didn't ask for it! Every time I enter the area, there's always someone wanting to kill me…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—What you did involves crossing multiple dimensions. Science can't explain this as of now.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("If science can explain anything here, the first thing I want to know is why I turned into a girl!")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Hee-hee, just put it aside. Any question will be solved sooner or later!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("That’s positive thinking…", "Lian")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
