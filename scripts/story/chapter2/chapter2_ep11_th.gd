	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... ก็ได้ ฉันจะให้คุณลองฝึกนักเรียนนายร้อย SID อย่างน้อยที่สุดหากคุณประสบอันตรายในอนาคต มันอาจเพิ่มอัตราการรอดชีวิตของคุณเล็กน้อย", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("สำหรับสถานะของคุณ คุณจะเริ่มต้นในฐานะผู้สมัครตัวแทนระดับ 4", "Mariru")
	novel_interface.character_dark()
