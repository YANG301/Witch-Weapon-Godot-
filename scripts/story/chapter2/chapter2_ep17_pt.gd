# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("É assim que uma escola rica deveria ser! \\nVeja essas comidas deliciosas na cantina.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Olá! Quero um conjunto de arroz com curry e três asas de frango frito.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Os bolinhos de camarão parecem bons. Quero dois, por favor.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tem certeza de que pode terminar tudo isso?", "Pessoal da cantina")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Claro, moleza!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ei, olhe! Aquela garota está comendo como um cavalo.", "Aluno 1")
	await novel_interface.show_dialog("Inacreditável… Ela sempre come tanto assim?", "Aluno 2")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(... eu sou um menino, ok? Isso é normal.)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Você sabe, as pessoas invejam você. \\nVocê come muito sem ganhar peso…", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nada de especial. \\nHmmmm! Os bolinhos de camarão são tão deliciosos!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Bem, Lian…", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê? (Munches) \\nO arroz com curry tem um gosto muuuito bom! (Goles)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Eu amo essa escola! (Lamas)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Você realmente come como um cavalo, não é?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ela é a nova estudante transferida?", "Aluno 1")
	await novel_interface.show_dialog("Não parece nem um pouco uma garota... \\nEca, abrindo as pernas quando está sentada. Isso é nojento!", "Aluno 2")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… Isso é realmente uma merda.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Boohoo…", "Lian")
	await novel_interface.show_dialog("Bem… acabei de comer…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Isso é o quanto uma garota comeria.", "Annie")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu costumava ser um grande comedor! \\nEu poderia comer o máximo que puder e demorar para digerir...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha…! Você é realmente um cavalo? Por que você faria isso?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Provavelmente porque... eu passava fome com muita frequência quando era criança.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis só pode identificar e proteger balas. Isto significa que os soldados armados podem facilmente penetrar no seu campo de força.")
	await novel_interface.show_text_only("O campo de força tem um raio de 32 quilômetros, efetivamente a última vala para milhões de sobreviventes naquela época.")
	await novel_interface.show_text_only("A guerra deixou muitos órfãos. Organizar a defesa pesou sobre o Senado. Assim, os suprimentos para cada creche foram fortemente racionados.")
	await novel_interface.show_text_only("Muitas crianças estavam morrendo de fome e tiveram que procurar comida na zona de guerra perto da fronteira. Eu fui um deles…")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Eu entendo seus sentimentos. Apenas… não coma demais agora.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie também pode ter vivido aqueles dias…")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ei, vamos pegar algumas sobremesas depois da escola!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("… Ok!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Raramente temos tempo livre para sair assim, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Na verdade, é a primeira vez que estou neste tipo de restaurante... \\n(Me sinto um pouco desconfortável com as garotas ao redor...)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tudo bem, vamos ver... bem, vou querer esse! \\nSorvete de Mirtilo Parfait Super Refrigerante Bebida Especial DX!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("O nome parece muito legal!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Você é realmente uma criança, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Só vou tomar um café...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, você é uma menina agora. \\nVocê não quer experimentar algumas sobremesas? Eles são muito deliciosos!", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Ok… deixe-me verificar. \\nEmm… Muffin de Queijo Matcha Napoleão… (Nada mal.)", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Bolo Real de Creme de Laranja Cristalizada… (Parece gostoso também…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Sundae de frutas geladas para festa tropical… \\n(Goles)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Com licença… Você já se decidiu?", "Garçom")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Bem… Hummm \\ntalvez… só café… obrigado…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tudo bem.", "Garçom")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Bem…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Uh, espere! Mudei de ideia… \\nUm Parfait de Sorvete de Morango com Mousse de Mirtilo, por favor…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Eu só quero provar isso! \\nEu só vi garotas comê-los antes...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ah, não há necessidade de explicar.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Desculpe por mantê-lo esperando. Aqui está o seu pedido.", "Garçom")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Obrigado!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aproveite!", "Garçom")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Ok, pronto para ir!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Delícia… que delícia..!!", "Lian")
	await novel_interface.show_dialog("O morango tem um cheiro tão fresco. O creme é muito doce. E a mousse de mirtilo, um pouco azeda mas muito saborosa…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fico um pouco envergonhado quando encontro Annie olhando para mim.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("As meninas adoram essas sobremesas. Sempre quis saber \\nqual o sabor deles.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, você é tão...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Hum?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Tão adorável!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Do que… do que você está falando…!", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
