# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("アニーはもう隣の部屋に休ませてある。お前には、二人きりで話しておきたいことがある。", "マリル")
	await novel_interface.show_dialog("さっき確認の取れた情報だ。", "マリル")
	await novel_interface.show_dialog("今朝から、複数の主要都市で大規模な時空異変が起きている……", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("影響を受けている地域は、華雲宮城、ニューモリダス、マサダブルク、サモントン、新豊洲、それにレボナ諸島だ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("それって……\n六大学園都市が全部……！？", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("そうだ。今やこの件は全世界が注視している。被害の広がりは、予想をはるかに超えている。", "マリル")
	await novel_interface.show_dialog("私は……ある可能性を考えている。", "マリル")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("お前が夢の中で経験したと言っていたこと——研究センターを襲ったテロリスト、廃墟になった都市……", "マリル")
	await novel_interface.show_dialog("……あれは、全部本当に起きたことだったのかもしれない。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("そ……そんなこと、あり得るのか！？", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("決定的な証拠はまだない。だが今朝、超大規模な次元歪曲が発生していた可能性は高い。", "マリル")
	await novel_interface.show_dialog("SIDの『トゥルービジョン』衛星も、同時に異常なノイズの爆発を検知している。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("言い換えれば——新豊洲市は一度本当に滅びた。だが、何らかの力がその現実を書き換えたんだ。", "マリル")
	await novel_interface.show_dialog("しかも、その力はお前の身体の変化や、あの怪異に襲われた件とも関係しているように思える。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("もちろん、今のところは私の仮説に過ぎない。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("その考え……少し大胆すぎないか……？", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("今日の件で、他の五つの学園都市は元老院に圧力をかけている。新豊洲への立ち入り調査を求めているんだ。", "マリル")
	await novel_interface.show_dialog("そして今回の事件とお前の関係が一度でも露見すれば、研究機関に連れて行かれる程度じゃ済まない……", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("あらゆる情報機関の工作員が、お前を重要目標としてマークするだろう。", "マリル")
	await novel_interface.show_dialog("潜伏中の連中を除いても、今日だけで偽造身分を使って新豊洲に入った各国の諜報員は百人を超えている。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("そこまで分かってるのか？\nどうして止めないんだ？", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ふん。奴らに別の顔を用意させるくらいなら、泳がせておいた方がこちらはずっと動きを掴みやすい。", "マリル")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+"、これだけは理解しておけ。お前がまだ女の身体である限り、元の生活には戻れない。", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("だが、最初にお前を見つけたのが私たちSIDだったのは、不幸中の幸いと言えるかもしれない。", "マリル")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("一晩で女の子になったなんて……\nクラスメイトや友達に、何て説明すればいいんだ……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ふむ……お前は両親のことは気にならないのか？", "マリル")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("母さんは、私が小さい頃に亡くなった\n父さんも……もう何年も行方が分からない……", GameConfig.player_name)
	await novel_interface.show_dialog("私は十二歳になるまで、ずっと寄宿学校で暮らしてたんだ。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("（……ゴリラが進めていた戦後保育計画も、少しは子供たちの役に立っていたのか）", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("ふむ、少しは苦労してきたようだな。\nだが、身分変更の件はお前が心配する必要はない。", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("身分……変更？", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルの顔に、不穏な笑みが浮かんだ……")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
