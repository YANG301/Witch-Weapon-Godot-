# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Посмотрите, кто здесь! Каково это официально стать девушкой, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... Пожалуйста, прекратите надо мной издеваться!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хорошо, хорошо. Кстати, я слышал, ты планируешь перевестись в другую государственную среднюю школу после каникул?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Да. Новая школа ближе к тому месту, где я живу, и... требования к зачетам не такие строгие...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Из соображений безопасности я собираюсь найти для вас новое место.\nЧто касается школы...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Похоже, мне придется попросить этого старикашку об одолжении.)", "Mariru")
	await novel_interface.show_dialog("(Просто думать об этом раздражает... хорошо, что записи уже прекрасно исправлены...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Средняя школа для девочек Госакурагава. У него самый высокий рейтинг безопасности, и он находится недалеко от штаб-квартиры SID .", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Пока она говорила, Mariru указал вверх.")
	await novel_interface.show_text_only("Госакурагава, шумный коммерческий район над подземной штаб-квартирой, как говорят, является домом для престижной школы с ужасающе высокой платой за обучение.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("П-подожди, разве это не школа для богатых девочек?! Тот, который они называют «раем, где цветут чистые лилии и великолепные цветы вишни»...", "Lian")
	await novel_interface.show_text_only("Это была рекламная копия, написанная людьми, не имеющими отношения к теме, на каком-то постоянно ломающемся мусорном форуме, чтобы высмеять возмутительную плату за обучение Госакурагавы.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Что это было?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Н-нет, вообще ничего!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Учитывая то, насколько ты глуп, ты можешь в конечном итоге стать настоящей ... штукой для всех этих старшеклассников и младших школьников.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru легко рассмеялся и не закончил предложение.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Стать кем именно?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Сейчас не время давать волю своему любопытству.\nВ любом случае, завтра ты пойдешь и отчитаешься должным образом.", "Mariru")
	await novel_interface.show_dialog("Там не будет так свободно, как в государственной школе.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Не могли бы вы дать мне немного расслабиться... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Ах да. А как насчет Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Происхождение этой девушки довольно интересное.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Она... что с ней не так?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Записи о Annie Басс в системе появились всего семь лет назад, когда ей было пятнадцать.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Семь лет назад значит... ей уже двадцать два?!\nОна выглядит примерно того же возраста, что и я!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Это верно. Даже сейчас ее костный возраст все еще составляет пятнадцать.", "Mariru")
	await novel_interface.show_dialog("Но куда она пропала за это время и почему вдруг появилась вновь, до сих пор никто не разобрался, в том числе и сама Annie.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Несмотря ни на что, я не думаю, что Annie плохой человек.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("В этом отношении можете быть спокойны.\nВ конце концов, в SID есть даже люди, которые когда-то были ее поклонниками.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А?! Был ли Annie каким-то идолом?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Вероятно, она попадает в категорию «звезда многолетней давности».", "Mariru")
	await novel_interface.show_dialog("Но по сравнению с тем, кем она была раньше, меня больше интересует, что в ней особенного сейчас.", "Mariru")
	await novel_interface.show_dialog("Начнем с того, что информации о ведьмах так мало.... это была неожиданная удача.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ведьмы... что это?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Мм... проще говоря, вы можете думать о них как о людях, которые были заражены определенной информацией и приобрели некоторые черты, похожие на \"Substance H..\"", "Mariru")
	await novel_interface.show_dialog("Точно так же, как люди называют странные характеристики «Substance H» — вещей, которые современная наука не может объяснить — «чудесами».", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Для обычных людей, если кто-то сможет проявить такую черту, это будет выглядеть практически как «магия».", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("Магия... должна быть просто наукой, которую мы пока не понимаем...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Это совершенно правильный способ думать об этом.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("Существует множество исторических записей о «ведьмах», но к ним всегда относились как к суевериям и легендам.", "Mariru")
	await novel_interface.show_dialog("За более чем триста лет европейцы казнили около ста тысяч женщин от имени «ведьм».", "Mariru")
	await novel_interface.show_dialog("«Охота на ведьм»... о которой мы узнали на уроке истории...", "Lian")
	await novel_interface.show_dialog("Тогда я воспринимал это всего лишь как скучный экзаменационный материал, но чем больше я об этом думаю, тем больше это кажется катастрофой неестественно масштабного масштаба...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("С тех пор, как была обнаружена «Substance H», каждая страна начала перепроверять правдивость этих легенд.", "Mariru")
	await novel_interface.show_dialog("В последнее время ходят слухи, что некоторые организации воссоздали ведьм и используют их в шпионаже.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Тем не менее, к счастью для нас, Annie без колебаний согласился присоединиться.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Присоединиться к чему?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Стать агентом SID.", "Mariru")
	await novel_interface.show_dialog("С завтрашнего дня она будет работать на меня.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Вы не можете этого сделать! SID агенты явно выполняют крайне опасную работу!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("А ей всего пятнадцать, как и мне. Она не может быть каким-то агентом...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хех. Нашему самому молодому агенту сейчас всего тринадцать.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Тринадцать?! Это незаконно!!\nЭто должно быть незаконно, верно?!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если у тебя когда-нибудь появится возможность встретиться с ней, ты больше так не скажешь.\nЭтот ребенок намного умнее такого дурака, как ты.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Хмф.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Как гражданин New Opulentia, конечно, я знаю, что, хотя в различных академических городах, похоже, действует прекращение огня, они все еще тайно конкурируют друг с другом.")
	await novel_interface.show_text_only("А щит Aegis бесполезен против биохимического оружия и террористических атак в стиле проникновения.")
	await novel_interface.show_text_only("Чтобы защитить этот город, Mariru и SID должны были вести бесчисленные отчаянные битвы в тени.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("О, верно. Под прикрытием Annie будет переведенный студент, зачисленный вместе с вами.", "Mariru")
	await novel_interface.show_dialog("Я устроил так, чтобы вы двое остановились в одном номере. Униформа и другие предметы первой необходимости\nбудут доставлены в течение часа.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Никакого торга.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Я понимаю...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Конечно, я понимаю. В этом нет ничего плохого.\nНет, это гораздо комфортнее той жизни, которая у меня была раньше.")
	await novel_interface.show_text_only("Пока SID обо всем позаботится.\nПока я продолжаю дрейфовать по жизни в какой-нибудь благородной женской школе, просто зарабатывая кредиты.")
	await novel_interface.show_text_only("И пока я пытаюсь привыкнуть к этому новому телу... будет ли этого достаточно?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Нет.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Хм?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Даже если я еще ничего не понимаю, я не хочу, чтобы Annie столкнулась с такой опасностью одна.")
	await novel_interface.show_text_only("Annie которая появилась передо мной в тот момент, когда мы встретились...\nОна выглядела спокойной, но в ней все еще был след страха.")
	await novel_interface.show_text_only("Она тоже была... напугана, не так ли?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Мисс Mariru — если вы не возражаете, я вас так называю...\nЯ тоже хочу помочь!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("А?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Я имею в виду... поскольку я смог пройти через этот ураган, возможно, я смогу помочь SID и с чем-то еще!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Это был не ураган. Это было пространственно-временное фазовое колебание...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("В любом случае, я не могу позволить Annie столкнуться с опасностью в одиночку.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("И, возможно,... возможно, у меня даже появится шанс найти способ снова превратиться в мальчика...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... Но с твоими физическими способностями ты, вероятно, не смог бы победить даже одного из дворников SID.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Э-э...\n(Каких уборщиков вы нанимаете?! Шаолиньские монахи?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Хорошо. Я позволю тебе попробовать SID курсантскую подготовку. По крайней мере, если вы столкнетесь с опасностью в будущем, это может немного повысить вашу выживаемость.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Что касается вашего статуса, вы начнете как кандидат в агенты 4-го уровня.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Хорошо! Я сделаю все возможное!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Хорошо. Посмотрим, какие данные я смогу получить от этого малыша.)", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
