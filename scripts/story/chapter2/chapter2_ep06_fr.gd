# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Marmonne) Ce petit morveux était bien plus intéressant...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une invite de connexion d'appel vocal clignote sur l'écran en diagonale devant Mariru. La voix électronique délibérément déformée masque le sexe d'origine de l'orateur.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(J'ai fait ce briefing à de nombreuses reprises, mais ce format d'interférence crypté unilatéral est toujours exaspérant.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Alors, concernant la disparition du Ross Goblet, comment se déroule l'enquête actuellement ?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("A 00h15 ce matin, le système de sécurité a confirmé que le Ross Goblet avait disparu.", "Mariru")
	await novel_interface.show_dialog("À 06h40, le système de surveillance par satellite True Sight a émis un avertissement après avoir détecté une grave distorsion dimensionnelle.", "Mariru")
	await novel_interface.show_dialog("Puis, depuis 7h00 ce matin jusqu'à maintenant, le système Aegis a détecté six alertes de fluctuation de phase spatio-temporelle au sein de New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Et si l'on prend l'institut de recherche comme centre, trente-deux alertes similaires sont apparues simultanément dans un rayon de mille cinq cents kilomètres...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Tout cela est déjà dans le document. Donnez-moi la conclusion.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru regarde par-dessus son épaule droite et sourit.")
	await novel_interface.show_text_only("Rien qu'au ton, elle peut dire qu'il s'agit du directeur général sévère et sans sourire de Sénat.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("— Ce n'était pas un vol. C'était le réveil d'un Substance H, avec la réaction en chaîne qu'il déclenchait.", "Mariru")
	await novel_interface.show_dialog("Et à en juger par la fréquence et l'échelle actuelles, nous ne pouvons toujours pas déterminer s'il s'agit d'un Substance H de type mémétique.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À l'instant où Mariru finit de parler, des murmures surpris et des discussions feutrées se répercutent à travers les écrans sombres autour d'elle.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Quoi ?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une voix grave et ferme s'élève à la gauche de Mariru.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Vous voulez dire une explosion exponentielle d'un \"Toucher Divin\" affectant l'esprit ?\nC'est intéressant...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Pour le moment, il semble plus probable que plusieurs incidents éclatent en même temps.\n\"Toucher Divin\"... Je n'aime pas particulièrement la terminologie imprécise.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Bien qu'il soit l'autorité en matière de Substance H...)", "Mariru")
	await novel_interface.show_dialog("(Je n'arrive toujours pas à me débarrasser du sentiment que ce gorille a grillé son cerveau avec trop de radiations.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Alors selon votre jugement... ?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Je ne peux pas encore soumettre un rapport de conclusion. Nous n’avons tout simplement pas suffisamment d’informations exploitables.", "Mariru")
	await novel_interface.show_dialog("Compte tenu de la situation actuelle, je demande une ordonnance d'enquête de classe S sans restriction. J'espère que vous pouvez tous comprendre.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ignorant les chuchotements autour d'elle, Mariru reporte son attention sur le terminal portable.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Cette petite fille est allée dans une autre zone d'anomalie...)", "Mariru")
	await novel_interface.show_dialog("(Comme prévu : elle a disparu, est réapparue un peu plus tard, puis la fluctuation de phase à proximité s'est à nouveau arrêtée.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Les images de la scène ..., est-ce que du sang est sur elle ?)", "Mariru")
	await novel_interface.show_dialog("(Cet idiot... ne me dis pas qu'en fait—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Vous semblez un peu distrait.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ?... Pas du tout.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Quoi que vous regardiez, contient-il des informations plus importantes que ce briefing ?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Non, c'est juste une vidéo d'un chaton. Vous voulez le voir ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Un gémissement électrique aigu et un bourdonnement éclatent à la gauche de Mariru.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Ne sois pas si en colère. Un peu de diversion améliore l’efficacité du travail.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru parcourt la pièce du regard. Il semble que personne n’ait remarqué le dérapage momentané pour l’instant.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Quoi qu'il en soit, les renseignements de base que nous avons obtenus jusqu'à présent sont exactement ceux indiqués dans le briefing.\nL'incident fait toujours l'objet d'une enquête plus approfondie.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("S'il n'y a pas de questions, je me rends sur place.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Avant que Mariru puisse partir, une voix quelque peu désinvolte s'élève à sa gauche.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...J'ai entendu dire que vos subordonnés avaient ramené deux lycéens à SID pour les interroger ?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Encore ce salaud odieux.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("Y avait-il quelque chose de spécial chez eux, Madame Mariru... non, Docteur ?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Rien du tout. Nous l'avons déjà confirmé : il s'agissait simplement de deux petits chatons trop curieux qui se sont faufilés dans une zone réglementée.", "Mariru")
	await novel_interface.show_dialog("Je ferai en sorte qu'ils soient renvoyés chez eux par la suite.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Je vois. C'est bien, alors.", "#C")
	await novel_interface.show_dialog("À un moment sensible comme celui-ci, il serait gênant si d'autres pays commençaient à les traiter comme une sorte d'existence étrange....", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Cette remarque déclenche un tollé parmi les autres.")
	await novel_interface.show_text_only("...Qu'est-ce que ça veut dire ?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Une remarque imprudente peut mettre certaines personnes mal à l'aise, j'en suis sûr.\nMes excuses, faites comme si vous ne l'aviez jamais entendu.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Quel homme tout à fait détestable.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Quoi qu’il en soit, cet incident a déjà attiré l’attention des autres Cités Académies.", "Bright")
	await novel_interface.show_dialog("Nous compterons désormais sur vous pour l'enquête classifiée et la gestion de l'information publique.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Naturellement.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
