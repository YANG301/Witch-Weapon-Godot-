# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("아참,네가 방금 주운 종이들은 어디 있어?", "앤")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("아… 마침 그 얘길 하려던 참이었어.", "샤오롄")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("방금 전투 뒤에 주운 원고를 앤에게 건넸다. 옆에 있던 이루카는 뭔가 말하고 싶은 듯 머뭇거린다.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Wardenclyffe\nManuscript…… 대단해! 이걸 찾아내다니!", "앤")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("그 녀석들이 떨어트린 물건이야. 그런데 조금 이상해…앤은 읽을 수 있겠어?", "샤오롄")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("응——흐릿하긴 하지만 마력의 움직임이 느껴져. ", "앤")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("이건 분명 『마도서』……아니,마도서의 페이지야. ", "앤")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("마도서……마녀와 관련 있는 거야?", "샤오롄")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("마법 정보를 기록한 문서야. 나도 처음 만졌을 때 갑자기 책이 나타났어.", "앤")
	await novel_interface.show_dialog("이름은 《신비한 탄도학》이였던 것 같아. 터무니없이 내 캐비닛에 나타났지.", "앤")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("처음엔 교관님이 보낸 줄 알았어. 하지만 내용이 이상했지. 탄도를 바꾸는 마법 같은 것.", "앤")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("후에 교관님도 그 책을 모른다는 걸 알았고,난 미신 같은 건가 하고 사용하지 않았어. ", "앤")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("그 날이 오기까지……", "앤")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("앤이 회상하고 싶지 않았는지 고개를 숙이고 종이들을 바라본다. ")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("『마녀』는 어떤 정보를 감염시켜서 『이물질』과 비슷한 특성을 가진 인간을 만든다고 들었어.", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("감염이라…… 꽤 정확한 표현이네. \"정보\"라고는 해도\n일단 한 번 스며들면 영영 잊을 수 없는 \"정보\"도 있으니까.", "앤")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("중독성 강한 광고 음악이나 야한 영상처럼, \\n잊고 싶어도 잊혀지지 않고,\\n딴 생각하다 자기도 모르게 흥얼흥얼~", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("하하. 렌의 비유가 딱인 걸?", "앤")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("혹시 이 종이 몇 장 때문에 시공 파동이 생긴 걸까,\n하지만…… 정말 고작 이 몇 장 때문에?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("가능성 있어. 이런 정보는 정신을 많이 소모시켜. 나도 막대한 부담이 선명하게 느껴지는 걸. ", "앤")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("그러니까 어떤 “물체”에 의지해 마법을 시전해서 대신 대가를 치르게 하는 거야.", "앤")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("앤은 자기 배트를 가리켰다. 이런 식으로 마력을 소모하는 무기가 생겨나는 거겠지……")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("정보 과부하가 일어나면 이성을 상실해서 미쳐버릴 수 있어……", "앤")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("미친,무녀……\\n소멸,필요.", "이루카")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("무녀……그 불행한 사람들,\\n앤은 많은 걸 알고 있구나.", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("아, 아니야……\\n나도 내 경험으로 추측한 것뿐이야.", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("종이……", "이루카")
	novel_interface.character_dark()
	await novel_interface.show_text_only("이루카가 생각에 잠겨 그리움이 담긴 표정을 한다.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("응, 왜 그래,이루카, 너도 보고 싶어?", "샤오롄")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("응.", "이루카")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("이루카의 눈이 커진다. 마치 작은 동물처럼 촉촉하고 애원하는 눈빛으로 날 쳐다본다. ")
	await novel_interface.show_text_only("거절할 수 없지만,이렇게 위험한 물건을……")
	await novel_interface.show_text_only("내가 망설이고 있을 때,갑자기 수송기가 내려오는 소리가 들린다. ")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("누군가 왔어!", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID 요원인가, 잘 됐다. 우리가 발견……\\n에?", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("나의 예상과는 달리 수송기에서 내려온 것은 SID 요원이 아니였다.")
	await novel_interface.show_text_only("안경을 쓴 남자가 자상한 표정으로 이루카를 쳐다봤지만,이루카는 공포에 질린 얼굴을 하고 있다.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("이루카,이번엔 좀 느렸어.", "관리자")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("관리자님…죄송합니다.", "이루카")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("종이는 손에 넣었나?\\n혼자 소화하지 말랬지. 어서 가져와.", "관리자")
	await novel_interface.show_dialog("이렇게 간단한 일도 해내지 못한다면,쓸모 없는 물건이 될 거야.", "관리자")
	await novel_interface.show_dialog("여기 정리가 끝나는 대로, 곧바로 나와 함께 오르가로 가서 다음 임무를 수행한다.", "관리자")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("무슨 말이 그래!애가 다친 거 안 보여, ", "샤오롄")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("어린 아이일 뿐이라고. 네 물건 따위가 아니야!", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("낯선 남자는 그제야 옆에 서 있던 나를 알아차렸다. 그는 무언가 사냥감이라도 보듯 싱글싱글 웃으며 나를 훑어보았다.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("이루카. 이 사람도 데려간다.", "관리자")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("엣?!", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("그렇게 둘 수는 없어! 내가 있는 한 누구도 렌을 데려가지 못해!", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("데려가…?", "이루카")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("맞아. 명령이다.", "관리자")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("명령…", "이루카")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("이루카가 당황하며 날 바라본다. 고통스럽게 저항해 보지만,결국 관리자의 명령을 거부하지 못한다.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("임무：렌을 데려간다. \\n타겟 고정——", "이루카")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
