	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("……", "앤")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("응…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("응?바뀌었다고……?", "마리루")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……이건 내 진짜 모습이 아니야……", GameConfig.player_name)
	await novel_interface.show_dialog("나! 사실,원래 남자였어!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("흐응, 남자?", "마리루")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("아……하?", "앤")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("그러니까,지금은 여장 남자란 말이야,(다가선다)", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("그,그런 뜻이 아니라! \\n이봐! 너무 가까이 붙지 말라고! ", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("으…어떤 의미에선……\\n그렇다고 볼 수 있지?", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("아아,답답해!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("음……이 가슴 꽤 훌륭한데, (더듬)", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("이 탄성……도대체 어떤 기술로 이렇게 자연스러운 촉감을 만든 거지……(꼬집)", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("앗?그런 거라면 앤도 알고 싶어~~!!", "앤")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("아!아……아니,그건……\\n멋대로 날 만지지 마! ! !", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("어깨도 얇고 허리부터 골반까지 곡선도 아름다워. ", "마리루")
	await novel_interface.show_dialog("도대체 어떤 재료를 썼길래…특히……", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("아하하하하!간지러워……!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("마리루!거긴 안 돼!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("안돼애애애애~~~!!!!!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("흑흑흑흑…", GameConfig.player_name)
	await novel_interface.show_dialog("어,어쨌든! 어제까지 난 남자였어!", GameConfig.player_name)
	await novel_interface.show_dialog("수술 같은 건 하지 않았어…!", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("아니,나도 그건 의심하지 않아.", "마리루")
	await novel_interface.show_dialog("현재 기술로는 어떻게 해도 이렇게 철저히 성별을 바꿀 순 없어……", "마리루")
	await novel_interface.show_dialog("골격을 전부 바꾼다고 해도 이렇게까진 할 수 없지.\\n그러니까 넌 원래 여자가 맞아.", "마리루")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그러니까! 다 얘기했잖아!!\\n눈 떠보니 이렇게 변해있었다니까!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("증거 있어,\\n네가 원래 남자였다는 증거 말이야.", "마리루")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("음……증거……\\n아,학생증!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("여기 들어올 때 휴대품을 모두 압수당했다. 집을 나설 때 입고 있던 남자옷이랑 신분증까지!")
	await novel_interface.show_text_only("마리루가 단말기 버튼을 몇 번 두드리자 내 학생증이 보인다.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("있다! 이거야!\\n이것 봐! 난 남자 맞지?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("이목구비가 확실히 닮긴 하지만 이걸로는…", "마리루")
	await novel_interface.show_dialog("그래, 도시 감시 시스템에서 최근 한 달간 "+GameConfig.player_name+"의 모습이 찍힌 영상을 전부 불러와 봐……", "마리루")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("마리루가 익숙한 듯 태블릿의 버튼을 누르며 잔뜩 들뜬 표정을 한다.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("그 폐허를 봤을 때 꿈을 꾸고 있는 줄 알았어. 꿈에서 깨어나기만 하면 된다고…", GameConfig.player_name)
	await novel_interface.show_dialog("하지만 깨어났을 때 이미 여자로 변해있었어……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("골격 변화와 방금 복도에서 스캔한 걸음걸이를 비교하면……", "마리루")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("마리루가 내 혼잣말을 무시한 채 계속해서 손에 든 물건을 조작한다.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("설마 그게 꿈이 아니란 말야, 하지만 지금 아무 일도 없었다는 듯이 평화로운데…", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("아……정말,전혀 감을 못 잡겠어……!", GameConfig.player_name)
	await novel_interface.show_dialog("도대체 내 기억 속에서 뭐가 진짜고 뭐가 꿈인 거야……!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("……걸음걸이 식별 모드 부합.", "마리루")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("무슨 뜻이야?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("걸음걸이는 대뇌가 사람의 근육을 제어하는 거라 우수한 특공대원이라도 위장할 수 없어.", "마리루")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("현대 과학 이론으로는 설명할 수 없지만……\n네가 "+GameConfig.player_name+"인 건 분명해.", "마리루")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("저,정말?", "앤")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("이곳에 오면 뭔가 알 수 있을 거라고 생각했는데……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("『로스 금잔』에 대해 아는 게 있어?", "마리루")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("로스 금잔, 아침에 이물질이 갑자기 사라졌다는 뉴스를 보긴 했지만 실제로 본 적은 없어.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("네 말이 사실이라면……", "마리루")
	await novel_interface.show_dialog("내가 그런 시시한 강의에 가겠다고 한 이유는 그것 때문일 거야. ", "마리루")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("그건 로우스 섬에서 찾은 『이물질』이야. 잔 표면에 4개의 불가사의한 보석이 박혀 있어.", "마리루")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("맞아,폐허를 기어나와서 본 하늘에 빛을 뿜는 물체가 잔을 닮은 것 같기도 해……", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("공중에 떠서 옅은 붉은색 빛을 내고 있었어…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("옅은 붉은색?", "마리루")
	await novel_interface.show_dialog("(컵 안의 담홍색 액체는 줄곧 풀리지 않는 수수께끼인데……)", "마리루")
	await novel_interface.show_dialog("(하지만 이 정보는 기밀로 분류되어 있어. 얼마 전에 『Safe』 판정을 받았어도 외부에는 공개된 적이 없어……)", "마리루")
	await novel_interface.show_dialog("(직접 보지 않고서야 이렇게 세밀하게 알 수 없는데……)", "마리루")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("네가 말한 게 진짜든 꿈이든,네 상황을 좀 더 알아봐야겠어. ", "마리루")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
