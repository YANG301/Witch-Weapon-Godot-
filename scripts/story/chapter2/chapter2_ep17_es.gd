# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("¡Así debería ser una escuela rica! \\nMira esta deliciosa comida en la cantina.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("¡Hola! Me gustaría un juego de arroz al curry y tres alitas de pollo fritas.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Las tortitas de gambas tienen buena pinta. Tomaré dos por favor.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Estás seguro de que puedes terminar todo esto?", "Personal de cantina")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("¡Claro, pan comido!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Oye, mira! Esa chica come como un caballo.", "Estudiante 1")
	await novel_interface.show_dialog("Increíble… ¿Siempre come tanto?", "Estudiante 2")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(... Soy un niño, ¿vale? Esto es normal.)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Ya sabes, la gente te envidia. \\nComes mucho sin engordar...", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nada especial. \\n¡Hmmmmm! ¡Las tartas de gambas están riquísimas!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Bueno, Lian…", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué? (Mastica) \\n¡El arroz al curry sabe muy bien! (traga saliva)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¡Me encanta esta escuela! (Granizados)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Realmente comes como un caballo, ¿verdad?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Es ella la nueva estudiante transferida?", "Estudiante 1")
	await novel_interface.show_dialog("No parece una niña en absoluto... \\nEww, abre las piernas cuando está sentada. ¡Eso es asqueroso!", "Estudiante 2")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… Esto realmente apesta.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Boohoo...", "Lian")
	await novel_interface.show_dialog("Bueno... ya terminé de comer...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Eso es lo que comería una niña.", "Annie")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Yo solía comer mucho! \\nPodría comer todo lo que pueda y tomarme mi tiempo para digerir...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("¡Jajaja…! ¿Eres realmente un caballo? ¿Por qué harías eso?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Probablemente porque... Pasaba hambre con demasiada frecuencia cuando era niño.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis solo puede identificar y proteger balas. Esto significa que los soldados armados pueden penetrar fácilmente su campo de fuerza.")
	await novel_interface.show_text_only("El campo de fuerza tiene un radio de 20 millas, siendo efectivamente el último recurso para millones de supervivientes en aquel entonces.")
	await novel_interface.show_text_only("La guerra dejó muchos huérfanos. La organización de la defensa agobiaba al Senado. Por lo tanto, los suministros para cada guardería estaban fuertemente racionados.")
	await novel_interface.show_text_only("Muchos niños morían de hambre y tenían que buscar comida en la zona de guerra cerca de la frontera. Yo era uno de ellos...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Entiendo tus sentimientos. Simplemente... no comas en exceso ahora.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie también pudo haber vivido esos días…")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Oye, ¡comamos algunos postres después de la escuela!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("… ¡Está bien!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Pocas veces tenemos tiempo libre para salir así, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("De hecho, es la primera vez que estoy en este tipo de restaurante... \\n(Me siento un poco incómodo con las chicas alrededor...)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Muy bien, veamos… bueno, ¡me quedo con este! \\n¡Bebida especial DX con parfait de helado de arándanos y súper refresco!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¡El nombre suena realmente genial!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Realmente eres un niño, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Sólo tomaré un café...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, ahora eres una niña. \\n¿No quieres probar algunos postres? ¡Están muy deliciosos!", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Está bien... déjame comprobarlo. \\nEmm... Muffin de queso Matcha Napoleón... (Nada mal).", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Pastel de crema de naranja confitada real… (También se ve delicioso…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Sundae de frutas heladas de fiesta tropical... \\n(tragos)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Disculpe… ¿Ha tomado una decisión?", "camarero")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Bueno... Ummm \\ntal vez... sólo café... gracias...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Muy bien.", "camarero")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Bueno…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("¡Eh, espera! Cambié de opinión... \\nUn parfait de helado de fresa y mousse de arándanos, por favor...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("¡Solo quiero probarlo! \\nSolo vi a chicas comérselo antes...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ajá, no hace falta dar explicaciones.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lamento hacerte esperar. Aquí está tu pedido.", "camarero")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("¡Gracias!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Disfruta!", "camarero")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("¡Bien, listo para comenzar!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("¡¡Mmm… delicioso..!!", "Lian")
	await novel_interface.show_dialog("La fresa huele tan fresca. La crema es realmente dulce. Y la mousse de arándanos, un poco ácida pero muy rica…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me siento un poco avergonzado cuando encuentro a Annie mirándome.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("A las chicas les encantan estos postres. Siempre quise saber \\ncómo saben.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, eres tan...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Mmmm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("¡Qué lindo!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¡Qu… de qué estás hablando…!", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
