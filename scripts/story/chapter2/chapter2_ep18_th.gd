# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("มันเป็นช่วงบ่ายฤดูร้อนที่แผดเผา ฉันทิ้งกองกระดาษไว้ข้างโต๊ะกลมในลานบ้าน แล้วทรุดตัวลงบนเก้าอี้ใต้ร่มไม้")
	await novel_interface.show_text_only("เมื่อไม่นานมานี้ฉันเห็นสาวสวยคนนี้กำลังต่อสู้กับกองหนังสือของเธอ ฉันไม่ได้คิดสองครั้งและยื่นมือให้เธอ")
	await novel_interface.show_text_only("จากนั้นเธอก็รีบออกไปแม้ว่าจะโชคดีก็ตาม นั่นคือตอนที่ฉันรู้ว่าฉันเป็นคนงี่เง่า")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ว้าววว... ขอพักตรงนี้ก่อนนะคะ... ร้อนจังเลย", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("อนิจจา มันเป็นเค้กชิ้นหนึ่งสำหรับฉันเมื่อฉันยังเป็นเด็ก")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("และแล้วก็ถึง SID การฝึกที่กำลังจะมาถึง... ให้ตายเถอะ ฉันจะไปซ่อนที่ไหนสักแห่งได้ไหม?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian ดูท่าทางของคุณให้ดี... \\nนี่คือโรงเรียน", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("เฮ้ Annie! \\nเป็นไงบ้าง?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("ฟังนะ... ฉันรู้ว่ามันร้อน \\nแต่... จำเป็นจริงๆ เหรอที่ต้องยกเสื้อขึ้นเพื่อเช็ดเหงื่อ?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("ฉันหมายถึง… ระวังตู้เสื้อผ้าทำงานผิดปกติ…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("ประณาม!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Lian ผู้หญิงคนนั้นหยาบคายมาก...", "นักศึกษา ก")
	await novel_interface.show_dialog("ใช่ ฉันเห็นเธอกางขาใส่กระโปรงเมื่อวันก่อน", "นักเรียนบี")
	await novel_interface.show_dialog("จริงเหรอ? ยัก…", "นักศึกษา ก")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(ฉันไม่น่าใส่กระโปรงตั้งแต่แรกเลย โอเค้?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เฮ้…")
	await novel_interface.show_text_only("ช่างเป็นเสียงที่อ่อนโยน")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("ใช้ผ้าเช็ดหน้าของฉันถ้าคุณไม่รังเกียจ", "สาวสง่างาม")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ข้างหน้าฉันเป็นสาวสวยและสง่างาม \\nเธอมีผมสีม่วงยาวสลวยและดวงตาสีม่วงม่วง")
	await novel_interface.show_text_only("เธอยื่นผ้าเช็ดหน้าซึ่งมีกลิ่นหอมสดชื่นให้ฉัน")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("เอ๊ะ! \\nขอบคุณ... ขอบคุณ", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("คุณเป็นนักเรียนโอนย้ายชั้นปีที่ 1 ใช่ไหม? \\nฉันชื่อ Nix สโตรซซี่ ฉันเป็นรุ่นพี่ของคุณ", "Nix")
	await novel_interface.show_dialog("ฉันเห็นคุณเหงื่อออก และบังเอิญมีผ้าเช็ดหน้าติดตัวไปด้วย ดังนั้น... \\nฉันหวังว่าฉันจะไม่รบกวน", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix พยักหน้าให้ฉันอย่างสุภาพ แต่ฉันก็ตกใจมาก ฉันยืนขึ้นและทักทายอย่างโง่เขลา")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("ไม่... ไม่เลย! \\nเป็นความช่วยเหลือที่ยอดเยี่ยม!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(เธอดูเป็นกันเองมาก) \\n(เธอเป็นชาวต่างชาติเหรอ? ดูขนตายาวๆ พวกนั้นสิ...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันมองดูใบหน้าอันละเอียดอ่อนของ Nix หัวใจของฉันเต้นรัว")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("ความสุขของฉัน \\n... คุณชื่อ...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("ฉันชื่อ Lian เธอคือ Annie \\nเราเพิ่งย้ายมาที่นี่เมื่อเร็วๆ นี้", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix ดูสับสนและจ้องมองไปที่ Annie แม้ว่าจะเป็นช่วงสั้นๆ")
	await novel_interface.show_text_only("จากนั้นเธอก็ยิ้มให้ Annie อย่างเป็นมิตร ฉันสงสัยว่ามันเป็นเพียงภาพลวงตาของฉันตอนนี้หรือไม่")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ดีใจที่ได้พบคุณวันนี้", "Nix")
	await novel_interface.show_dialog("แต่ฉันต้องไปตอนนี้ โปรดแจ้งให้เราทราบหากมีสิ่งใดที่ฉันสามารถช่วยได้", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("ขอบคุณ Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie ลังเลโดยไม่มีการตอบสนองใดๆ")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ผู้หญิงคนนี้ Nix... เธอดูมีคลาสกว่าสาวๆ ช้อนเงินคนอื่นๆ มาก", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie คุณสบายดีไหม? \\nคุณเงียบไปแล้ว", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("เธอบอกว่าเธอเป็น Strozzi หรือไม่?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เอ่อ คุณรู้จักเธอเหรอ?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie คว้าแขนของฉันแล้วยิ้มอย่างไร้เดียงสา")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("นะ \\nเราเพิ่งมาใหม่ ฉันจะรู้จักเธอได้อย่างไร?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("ใช่คุณพูดถูก", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
