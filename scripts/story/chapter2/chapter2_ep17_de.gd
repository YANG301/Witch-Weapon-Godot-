	await novel_interface.show_text_only("Es ist mir ein wenig peinlich, wenn ich sehe, dass Annie mich anstarrt.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Mädchen lieben diese Desserts. Ich wollte schon immer wissen, wie sie schmecken.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, du bist so...", "Annie")
