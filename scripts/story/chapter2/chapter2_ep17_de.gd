	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ich will einfach nur einen Vorgeschmack darauf haben! \\nIch habe bisher nur gesehen, wie Mädchen sie gegessen haben ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Aha, das muss man nicht erklären.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tut mir leid, Sie warten zu lassen. Hier ist Ihre Bestellung.", "Kellner")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Danke!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Viel Spaß!", "Kellner")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Okay, fertig!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Lecker...lecker...!!", "Lian")
	await novel_interface.show_dialog("Die Erdbeere riecht so frisch. Die Creme ist wirklich süß. Und das Blaubeermousse, etwas sauer, aber wirklich lecker…", "Lian")
