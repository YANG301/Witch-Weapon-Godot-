# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("С сегодняшнего утра мы неожиданно обнаружили несколько предупреждений о флуктуациях фазы пространства-времени в New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Как будто ночью что-то проснулось...", "Mariru")
	await novel_interface.show_dialog("Спутники наблюдения показывают, что вы растворились в воздухе внутри аномальной зоны, а затем вскоре снова появились на другой стороне — с кем-то еще рядом с вами.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru переводит взгляд на Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("И как раз там, где вы двое появились, это колебание исчезло само по себе.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Аномальная зона? Вы имеете в виду Исследовательский центр?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Точно.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Могла ли это быть какая-то неисправность оборудования...? Я все время находился на главной дороге.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Выражение лица Mariru становится серьезным.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы думаете, что каждый может войти в зону флуктуации фазы пространства-времени и покинуть ее?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Эта штука с колебаниями... неужели она настолько опасна?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ты действительно ничего не знаешь, не так ли...", "Mariru")
	await novel_interface.show_dialog("Фаза пространства-времени — это основа физического закона, подобно системе координат Вселенной. Независимо от того, как движутся частицы, сами оси должны оставаться стабильными.", "Mariru")
	await novel_interface.show_dialog("Если эти оси начнут дрожать, пусть даже незначительно, порядок частиц в этом пространстве будет разрушен.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Если бы всего 5% частиц в здании случайно сместились на один микрометр, структура материала была бы полностью разрушена, и все здание мгновенно рухнуло бы.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("И все же с вами все в порядке, а здания в этом районе вообще не имеют структурных повреждений.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(И согласно нашему исследованию «Божественных прикосновений», человек, несущий «ПРИЗРАК», не должен даже иметь возможность войти в такое пространство.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Другими словами, вы, по сути, попали в эпицентр урагана 12-й категории, который мог разорвать все на части, вернулись целыми и невредимыми и каким-то образом успокоили ураган.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Тогда были ли эти аномалии вызваны напавшими на меня тварями?\nОни, казалось, сошли с ума...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Остановитесь здесь! Я собираюсь проинформировать Сенат—", "Mariru")
	await novel_interface.show_dialog("Один из этих сумасшедших любит проводить анализ обнаружения лжи в прямом эфире в ленте конференции, так что чем меньше я сейчас знаю, тем лучше.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Это... очень характерный способ описания сенаторов...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("И девушка тоже должна знать, когда можно врать~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Я не девочка!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Ладно, ничего не скажу...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("За последние годы во всем мире было зарегистрировано всего четыре случая такого рода пространственно-временных флуктуаций.\nБольшинство из них были связаны с нарушениями условий содержания, связанными с Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Когда внезапно активируется неизвестное Божественное прикосновение, последствия могут быть катастрофическими.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Пострадают ли люди?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("В худшем случае только число погибших достигало десятков тысяч.", "Mariru")
	await novel_interface.show_dialog("Но крупные Академгорода всегда имели негласное соглашение сообщать об этих инцидентах как о «обычных несчастных случаях»...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Утечки газа, авиакатастрофы, теракты и тому подобное...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Тогда на этот раз...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("На этот раз все по-другому. Мы никогда раньше не видели непрерывных вспышек такого масштаба...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Это уже выходит за рамки наших пропагандистских сценариев. Когда придет время, мы даже не сможем придумать для этого ложь.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Может ли это быть из-за меня?\nЕсли я могу чем-то помочь...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Не задумывайтесь об этом. Ваши физические изменения вполне могут быть связаны между собой, но вы сами по себе не могли бы вызвать такое огромное беспокойство.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Если хочешь найти улики, можешь пойти и осмотреть место происшествия вместе с моими людьми.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Если такая возможность реальна, то сейчас она — единственный ответ, который у нас есть...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Но ни в коем случае нельзя себя заставлять и никому о себе не рассказывать. Понял?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Никому не говорить... значит ли это, что...\nмне придется притворяться, что я всегда была девочкой?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы уже знаете это, не так ли?...?\nNew Opulentia всегда правил в соответствии с доктриной науки превыше всего.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Если вы обнародуете свой опыт, вас классифицируют как «подопытного» и отправляют в исследовательское учреждение~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Тогда у вас, вероятно, будет целая очередь мужчин среднего возраста, посвятивших свою жизнь науке и ожидающих изучения вашего тела...", "Mariru")
	await novel_interface.show_dialog("В конце концов, не каждый день им попадается такая милая девушка…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...О-окей, я понял!!", GameConfig.player_name)
	await novel_interface.show_dialog("Я... Я абсолютно не скажу ничего опрометчивого!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
