# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Dopo aver completato tutta una serie di procedure di registrazione per l'addestramento dei cadetti SID, mi è stata consegnata una grossa pila di \"libri di testo\".")
	await novel_interface.show_text_only("Poi, sotto la guida di un membro dello staff, ho preso un piccolo ascensore poco appariscente dal SID quartier generale.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("L'ascensore salì abbastanza velocemente che potevo sentire chiaramente la pressione che aumentava nelle mie orecchie.\nQuando raggiunsi la superficie, mi resi conto che era già sera...")
	await novel_interface.show_text_only("L'ascensore si apriva nell'atrio di un piccolo edificio di uffici e appena fuori c'era l'affollato quartiere commerciale.")
	await novel_interface.show_text_only("Ho sentito che l'ascensore può scendere ai livelli più profondi solo quando riconosce che ogni passeggero è personale autorizzato. Altrimenti viaggia solo tra il primo e il terzo piano dell'edificio adibito a uffici.") #换行问题
	await novel_interface.show_text_only("Al secondo piano dell'edificio c'era un bar aperto 24 ore su 24 con gente che andava e veniva tutto il giorno, perfetto per nascondersi in bella vista.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Sospiro...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Pensavo che l'addestramento degli agenti avrebbe comportato cose come il combattimento corpo a corpo e le sparatorie, ma con questo mi sento più come se mi fossi iscritto a un intero pacchetto scolastico...", "Lian")
	await novel_interface.show_dialog("Questi libri sono davvero pesanti!\nMeno male che il posto che Mariru ha predisposto per me non è lontano da qui.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Academy District East Road No. 6... Ha detto che era un posto molto tranquillo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("—Come mai tutto questo è di basso profilo?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi trovavo all'interno di una residenza di lusso all'ultimo piano di un grattacielo. Il lussuoso soggiorno collegato ad una gigantesca terrazza che si affaccia sulla vista notturna del quartiere commerciale.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Quelle fiamme lungo il muro sono un vero caminetto?\nAnche questo è esagerato...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Proprio mentre mi guardavo attorno con cautela e mi chiedevo se non fossi entrato nella stanza sbagliata, ho ricevuto un messaggio da Mariru.")
	await novel_interface.show_text_only("Mariru: Scegli la camera da letto che preferisci.\nNon c'è bisogno di essere educati con il budget di Senato~") #原文有个♥
	await novel_interface.show_text_only("Quella donna... Chiedi scusa ai contribuenti di New Opulentia adesso!!")
	await novel_interface.show_dialog("Lian, sei tornato!", "Annie")
	await novel_interface.show_text_only("Annie uscì dal bagno, raccogliendosi i capelli con una mano mentre camminava.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! Ci sei anche tu?\nMariru ha detto che sei andato per un allenamento speciale proprio adesso...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Ho terminato la formazione prima del previsto. Ho appena fatto una doccia e ho provato l'uniforme scolastica.\nSembra che diventeremo compagni di stanza~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Destra...\n(Sembra che Mariru l'abbia menzionato...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(È una specie di prova dal cielo?)\n(Vivere sotto lo stesso tetto di una ragazza e tutto il resto...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Quella è l'uniforme di questa scuola? È davvero carino~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Mm-hm~ I vestiti che hanno preparato per te sono in quella scatola laggiù. Dovresti provarli anche tu!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("I-devo indossarne uno anch'io...?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eheh, Lian, non sei ancora abituata a essere una ragazza?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Non appena ha tirato fuori l'argomento, non ho potuto fare a meno di grattarmi la testa e crollare sul divano.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Come è possibile che qualcuno si abitui a una cosa del genere...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Nessuno potrebbe capire cosa si prova.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Capisco.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie all'improvviso si sedette accanto a me e mi sfiorò leggermente la guancia con la punta del dito, come per consolarmi.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Perché siamo uguali.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'era una leggera amarezza nel suo sorriso.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("C-Cosa—?!\nAnche tu eri un ragazzo?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ahahahahahah! Lian, sei un idiota?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Sono sempre stata una ragazza~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agh...\n(È mortificante!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Proprio quando il mio imbarazzo stava per raggiungere l'apice, Annie smise di ridere e mi guardò dolcemente.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("Ma il panico nel tuo cuore in questo momento... Lo capisco davvero perfettamente.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("Anch'io prima ero intrappolato in un altro spaziotempo...\nQuella sensazione era probabilmente un po' simile a quella che stai attraversando adesso.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Un altro... spaziotempo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie fece una pausa, come se stesse pensando attentamente a come esprimerlo.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Non te l'ha detto la signorina Mariru?\nHo trascorso molto tempo alla deriva in un altro spaziotempo senza capire veramente nulla...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Lì il tempo sembrava vago. Non mi è sembrato così lungo, ma quando sono tornato mi sono reso conto che erano già passati sette anni.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mm, ne ho sentito parlare...", "Lian")
	await novel_interface.show_dialog("(Anche se questo era solo da alcuni suggerimenti sparsi Mariru lasciati...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cosa le è successo esattamente?\nDevo chiederglielo direttamente?")
	await novel_interface.show_text_only("Annie non ha continuato. Abbassò semplicemente la testa e giocò distrattamente con le dita.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... anche tu ti senti mai così—", "Annie")
	await novel_interface.show_dialog("Come se tutto questo potesse essere solo un sogno, e la prossima volta che aprirai gli occhi, finalmente ti sveglierai.", "Annie")
	await novel_interface.show_dialog("Non è così che dovevano andare le cose. Non dovresti essere qui...\nMa qualunque cosa tu faccia, non puoi tornare sulla strada normale.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Quindi Annie è arrivata fin qui portando sentimenti del genere da sola...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sono avvicinato un po' di più a Annie e le ho dato una pacca gentile sulla spalla.\nUh, confortare una ragazza come questa... dovrebbe andare bene, giusto?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Non aver paura. Sei tornato adesso, non è vero?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Mm...\nMa tutto mi sembra ancora così sconosciuto...", "Annie")
	await novel_interface.show_dialog("Non ho nemmeno la più pallida idea di cosa intendiate tutti con \"città accademica\".", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... Giusto. La guerra non era ancora finita quando Annie scomparve.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Ciò significa che ancora non sai cosa è successo in questi ultimi anni, giusto?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Ho solo guardato le cose in modo approssimativo... Sono successe così tante cose nel corso degli anni che non capisco nemmeno più cosa dovrebbero significare molte delle parole nelle notizie.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sette anni fa...\nEra proprio nel bel mezzo della guerra che gettò il mondo intero nel caos.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Eh? La guerra?\nIntendi la campagna militare lanciata dal Forte Masada contro l'Europa?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie si è sforzato di ricordare.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, non quello. Non molto tempo dopo, quasi tutti i paesi vi furono coinvolti.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Allora frequentavo le elementari in un collegio. Ogni giorno i notiziari erano pieni di resoconti di guerra e di conteggi delle vittime. È stato un periodo davvero terribile...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, anche tu hai vissuto la guerra?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non esattamente. Grazie alla protezione di Aegis, allora New Opulentia concentrava tutti i suoi sforzi sulla ricostruzione accanto alle rovine.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Guardavo il prospero paesaggio notturno della città oltre la finestra... Quando ero piccolo, la città era piena di gru giganti e macchinari edili indaffarati ovunque.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quindi la maggior parte di quello che so proviene dai libri di testo.", "Lian")
	await novel_interface.show_dialog("A causa della guerra, la tecnologia miracolosa avanzò rapidamente...\nE per \"miracolo\" intendo fenomeni causati da Substance H.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Dopo la guerra, i sei paesi che padroneggiavano le tecnologie chiave fondarono ciascuno una delle sei città accademiche del mondo.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Mi sento come se all'improvviso avessi risvegliato un talento nascosto per essere un insegnante di storia...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Quindi è successo davvero così tanto... Non riesco nemmeno a immaginarlo.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bene, quando Annie se ne andò—ehm, scomparve—il mondo era ancora relativamente pacifico, giusto...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Esatto. Allora potevo ancora competere nelle partite internazionali di baseball!", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Nel momento in cui Annie ha parlato di baseball, i suoi occhi hanno iniziato a brillare.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Sai, Lian, ogni volta che toccava il mio turno alla battuta, tutti gli occhi degli spettatori si concentravano solo su di me!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quel miscuglio di tensione e di dover dare tutto quello che hai mi farebbe ribollire il sangue in tutto il corpo!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando si parlò di baseball, improvvisamente pensai al monumento di pietra nera fuori dallo stadio di baseball di Lebona, su cui erano incisi i nomi di decine di migliaia di morti.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("In realtà...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Ehm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Forse, dopotutto, perderti gli anni peggiori della guerra è stata una buona cosa per te.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Quando ci penso in questo modo, forse trasformarsi in una ragazza e incontrarti\nnon è stata del tutto una cosa negativa... in un certo senso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie si bloccò. Per un momento sembrò quasi imbarazzata...\nO me lo stavo immaginando?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... In realtà volevo ringraziarti per tutto questo tempo.\nPerché... sei stato tu a salvarmi dal vagare in quel mondo.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Eh? Ma non ho fatto nulla...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo è esattamente il motivo per cui devi essere speciale~", "Annie")
	await novel_interface.show_dialog("Ancora non so come hai fatto, ma in quel momento ho potuto sentire la tua mano calda che mi trascinava con sé.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie mi prese dolcemente la mano e sprofondò nei suoi ricordi.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se non fosse stato per te, non so per quanto tempo sarei rimasto intrappolato laggiù, né cosa sarei diventato alla fine...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Diventare... cosa?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahaha~ Non è niente. Ormai è tutto passato.\nAll'improvviso mi sento un po' assonnato~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie sembrava voler schivare l'argomento.\nSi stiracchiò pigramente, ancora sorridente.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Per quanto tempo avete intenzione di portare avanti questa chiacchierata notturna tra ragazze?", "Mariru")
	await novel_interface.show_text_only("La voce di Mariru uscì all'improvviso dall'altoparlante nell'angolo della stanza.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("M-Mariru?!\nStavi ascoltando proprio adesso?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Cosa? C'è qualcosa di sbagliato nel fatto che un tutore tenga d'occhio il programma di un paio di bambini?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Hai davvero il coraggio di dirlo...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Anche tu rispondi?\nSembra che dovrò allenarti molto duramente domani...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("Mi dispiace! Mi faccio un bagno e vado subito a letto!\nBuona notte!!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
