# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Depuis ce matin, nous avons soudainement détecté plusieurs alertes de fluctuation de phase spatio-temporelle sur New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("C'est comme si quelque chose s'était réveillé du jour au lendemain...", "Mariru")
	await novel_interface.show_dialog("Les satellites de surveillance montrent que vous avez disparu dans les airs à l’intérieur de la zone d’anomalie, puis que vous êtes réapparu de l’autre côté peu de temps après, avec quelqu’un d’autre à vos côtés.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru tourne son regard vers Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Et là où vous êtes apparus tous les deux, cette fluctuation a disparu d’elle-même.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("La zone d'anomalie ? Vous voulez dire le Centre de Recherche ?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactement.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Serait-ce dû à une sorte de dysfonctionnement de l'équipement... ? J'étais tout le temps sur la route principale.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("L'expression de Mariru devient sérieuse.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pensez-vous que n’importe qui peut entrer et sortir d’une zone de fluctuation de phase spatio-temporelle ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Cette chose de fluctuation... est-elle vraiment si dangereuse ?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu ne sais vraiment rien, n'est-ce pas...", "Mariru")
	await novel_interface.show_dialog("La phase espace-temps est le fondement de la loi physique, comme le système de coordonnées de l'univers. Quelle que soit la façon dont les particules se déplacent, les axes eux-mêmes doivent rester stables.", "Mariru")
	await novel_interface.show_dialog("Si ces axes commencent à trembler, même de la plus petite marge, l’ordre des particules dans cet espace est dévasté.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Si seulement 5 % des particules d’un bâtiment étaient déplacées de manière aléatoire d’un micromètre, la structure matérielle serait complètement détruite et l’ensemble s’effondrerait instantanément.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Et pourtant, vous allez toujours parfaitement bien, et les bâtiments dans cette zone ne présentent aucun dommage structurel.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Et selon nos recherches sur Divine Touches, un humain portant « GHOST » ne devrait même pas pouvoir entrer dans un espace comme celui-là.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("En d’autres termes, vous êtes entré dans l’œil d’un ouragan de catégorie 12 qui pourrait tout détruire, vous en êtes ressorti indemne et avez d’une manière ou d’une autre calmé la tempête.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Alors ces anomalies étaient-elles causées par les choses qui m'ont attaqué ?\nIls avaient l'air d'avoir perdu la tête...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Arrêtez-vous là ! Je suis sur le point de briefer les Sénat—", "Mariru")
	await novel_interface.show_dialog("L’un de ces fous aime lancer une analyse de détection de mensonges en direct sur le fil de la conférence, donc moins j’en sais pour le moment, mieux c’est.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("C'est... une façon très particulière de décrire les sénateurs...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Et une fille devrait aussi savoir quand il est acceptable de mentir~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("je ne suis pas une fille !!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Bref, très bien, je ne dirai rien...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ces dernières années, il n'y a eu que quatre cas enregistrés de ce type de fluctuation spatio-temporelle dans le monde entier.\nLa plupart d'entre eux étaient liés à des défaillances de confinement impliquant Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Lorsqu’un Toucher Divin inconnu est soudainement activé, les conséquences peuvent être catastrophiques.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Les gens seront-ils blessés ?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dans le pire des cas, le nombre de morts à lui seul a atteint des dizaines de milliers.", "Mariru")
	await novel_interface.show_dialog("Mais les grandes villes universitaires ont toujours eu un accord tacite pour signaler ces incidents comme des « accidents ordinaires »...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Fuites de gaz, crashs d'avions, attentats terroristes, ce genre de choses...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Alors cette fois...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cette fois, c'est différent. Nous n'avons jamais vu d'épidémies continues de cette ampleur auparavant...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Cela dépasse déjà le plus haut niveau de nos scénarios de propagande. Le moment venu, nous ne pourrons même pas inventer un mensonge.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Serait-ce à cause de moi ?\nSi je peux faire quelque chose pour aider...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N'y pensez pas trop. Vos changements physiques sont peut-être liés, mais vous seul ne pouviez pas causer une perturbation aussi énorme.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Si vous voulez chercher des indices, vous pouvez aller voir la scène avec mes hommes.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Si cette possibilité est réelle, alors pour le moment, elle est la seule réponse que nous ayons...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Mais vous ne devez absolument pas vous forcer et vous ne devez parler de vous à personne. Compris?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Ne le dire à personne..., alors ça veut dire...\nJe dois faire comme si j'avais toujours été une fille ?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous le savez déjà, n'est-ce pas ?... ?\nNew Opulentia a toujours gouverné selon la doctrine de la science avant tout.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Si vous rendez votre expérience publique, vous serez classé comme « sujet expérimental » et emmené dans un institut de recherche ~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Vous auriez alors probablement toute une lignée d'hommes d'âge moyen qui ont juré leur vie à la science et qui attendent d'étudier votre corps...", "Mariru")
	await novel_interface.show_dialog("Après tout, ce n'est pas tous les jours qu'ils ont une fille aussi mignonne...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...O-d'accord, je comprends !!", GameConfig.player_name)
	await novel_interface.show_dialog("Je... Je ne dirai absolument rien d'imprudent !!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
