# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("But I want to turn back into a boy...\nWhat am I supposed to do...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Well... why not just stay a girl like this?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wha—??\nNo! Absolutely not!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Like you said, maybe this city's fate was twisted away from destruction, and tens of millions of lives came back because of it...", "Mariru")
	await novel_interface.show_dialog("A miracle on that scale is bound to come with some kind of price, don't you think?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("And what if that price... was simply you ending up like this?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("How could that be...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Also...\nYou're already fifteen, right?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("A girl your age\nshould at least be wearing a bra... right?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("Huh?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You're still growing, you know. They might keep getting bigger from here on out...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Whaaaat?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If you don't wear one, it'll cause problems.\nFor example, when you're running...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Y-You don't mean a bra...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactly. I think a cute, girly style would suit you well, don't you?\nYou've got the kind of face that looks adorable~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Absolutely not!!\nI-I'm a boy!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And by the way, the way you're sitting right now...\nThat's surprisingly bold of you~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("I-I-I-I...\nI'm going to the bathroom!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh dear—\nThat kid really is far too easy to tease~", "Mariru")
	await novel_interface.show_dialog("Looks like I won't be bored from now on~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("I stared at myself in the mirror. Thinking back on that conversation, I slowly slid down the wall and crouched there.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("I still just can't believe it...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Something like that... I absolutely do not want to wear it!!", "Lian")
	await novel_interface.show_dialog("As a man...\nIt feels like something important is slipping farther and farther away from me!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("And if someone saw me in a place where they sell that kind of thing...\nNo, no! Absolutely not!", "Lian")
	await novel_interface.show_dialog("(If I actually did that...)\n(Then I'd really be... a pervert!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("I don't want to be a pervert!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Oh? You're still squatting here crying?\nI've already picked out the right size based on your bust.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Huh?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("I left them in your room. Think of them as a gift from me~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No thanks!\nI'll just use bandages instead!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("This child... are you innocent or just perverted?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Though using adhesive bandages might be... even more interesting.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Or do you happen to enjoy that little jolt of pain when you rip them off?", "Mariru")
	await novel_interface.show_dialog("Too bad. All we have here are spray-on bandages~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("You're doing this on purpose, aren't you!!\nUgh... damn it!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Tch, fine, I'll wear it~!\nIf I'm a real man, what's there to be embarrassed about!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Hm? Wait?\nThis... is really hard...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Mm-hm.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*click*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("There, I fastened it for you~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nH-How did you get in here?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("I was just kindly helping you out~\nBy the way, can you handle the uniform's knee-high socks on your own?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh?! They're just socks, what's so hard about that!\nI'll do it myself!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("And the skirt?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I can handle the skirt too... I'll put it on myself...\nMariru, get out already!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Wow~ So you actually know how to put on a skirt. That's impressive.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("A skirt doesn't require reaching behind your back to fasten anything, so what's hard about it?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, alright then~\nI'll come back in a bit and see what you look like once you're dressed.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Damn it... Mariru is seriously underestimating me!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Some time later...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! I'm dressed!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Are you sure?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What's there to be unsure about! I put it on just fine, didn't I?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("So then... where exactly is your zipper?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In the front! Makes it easier when you need to use the toilet!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... and what exactly do you use to go to the toilet now?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Th-That has nothing to do with anything! Anyway...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft... The zipper goes on the side.\nGo take a look in the mirror~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("The side, then the side...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Why are girls' clothes so hard to put on!!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
