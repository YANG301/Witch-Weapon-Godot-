# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Con il permesso di Mariru, io e Annie decidiamo di andare a fare shopping con Elluka.")
	await novel_interface.show_text_only("Elluka sta dietro di me e osserva tutto con cautela.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, vuoi del cioccolato?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, cioccolato, tipo.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Eccoti qui.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka prende la tavoletta di cioccolato, la scarta con attenzione e la addenta.")
	await novel_interface.show_text_only("Non ne ho mai abbastanza di lei. Così carino!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ehi, sembri un pervertito di mezza età.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cosa?! Sono solo un adolescente.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervertito.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Perché mi avete fatto questo?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, non ti darò la cioccolata se continui a comportarti così.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Spara. Sembra carina anche quando è giù.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Ahah. Sto scherzando. \\nEccoti qui.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Quanto cioccolato hai? \\nSe mangi troppo aumenterai di peso.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Qual è il problema? Ho solo pochi isolati.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie mi fissa con uno sguardo strano, facendomi sentire a disagio.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Cosa?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Ho dato un'occhiata al tuo recente rapporto di controllo fisico. \\nStai ingrassando, ma non sei diventato più alto.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Perché hai fatto questo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Per conoscerti meglio, ovviamente.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ora so che sei alto solo un metro e settanta. Come me.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dannazione. Non c'è niente di cui essere orgogliosi.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Ma da ragazzo ero alto un metro e settanta!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Non c'è molta differenza, vero?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Mi hai ingannato... \\nNon avrei dovuto dirtelo.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre Elluka si gode la cioccolata, la conversazione attira la sua attenzione. All'improvviso alza lo sguardo confusa.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Sorella Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Sì?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Fratello... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sorella? Fratello? \\nDati danneggiati. Non identificabile.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Dimentica quello che abbiamo appena detto!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Obiettivo di nuova scansione. Femmina identificata... \\nSorella? Fratello?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaaahh! Fermare!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
