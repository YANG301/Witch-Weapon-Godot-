# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie wurde bereits im Nebenraum untergebracht. Es gibt einige Dinge, die ich dir alleine sagen muss.", "Mariru")
	await novel_interface.show_dialog("Ich habe gerade eine Bestätigung erhalten.", "Mariru")
	await novel_interface.show_dialog("Seit heute Morgen sind in mehreren Großstädten großräumige Raumzeitanomalien aufgetreten...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Zu den betroffenen Regionen, die uns bisher bekannt sind, gehören Hovering Palace, Newmoridas, Masada Fort, Salmonton, New Opulentia und die Lebona-Inseln.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Bedeutet das dann nicht...\nalle sechs Akademiestädte...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Das ist richtig. Die ganze Welt beobachtet dies jetzt, und das Ausmaß der Auswirkungen hat die Erwartungen weit übertroffen.", "Mariru")
	await novel_interface.show_dialog("Ich denke... es könnte eine Möglichkeit geben...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Alles, was Sie in Ihrem Traum erlebt haben – die Terroristen, die das Forschungszentrum angreifen, die in Schutt und Asche gelegte Stadt...", "Mariru")
	await novel_interface.show_dialog("...All das könnte wirklich passiert sein.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("H-Wie ist das möglich?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ich habe keinen schlüssigen Beweis, aber es könnte bereits heute Morgen zu einer massiven Dimensionsverzerrung gekommen sein.", "Mariru")
	await novel_interface.show_dialog("Der True Sight-Satellit von SID entdeckte außerdem einen ungewöhnlich heftigen Lärmausbruch.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Vielleicht wird es dadurch einfacher zu verstehen: New Opulentia wurde tatsächlich einmal zerstört, aber irgendeine Macht hat diese Realität umgekehrt...", "Mariru")
	await novel_interface.show_dialog("Und diese Kraft scheint auch mit den Veränderungen in Ihrem Körper sowie den Angriffen dieser seltsamen Feinde zusammenzuhängen.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Natürlich ist das immer noch nur meine Hypothese.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Ist diese Idee... nicht etwas zu gewagt...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aufgrund der heutigen Ereignisse üben alle anderen fünf Akademiestädte Druck auf die Senat aus, die Einreise für Ermittlungen zu gestatten.", "Mariru")
	await novel_interface.show_dialog("Und wenn Ihre Verbindung zu diesem Vorfall aufgedeckt wird, wird die Abführung durch eine Forschungseinrichtung das geringste Ihrer Probleme sein...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Agenten aller Geheimdienstorganisationen würden Sie als Hauptziel markieren.", "Mariru")
	await novel_interface.show_dialog("Ohne die bereits Verdeckten einzurechnen, reisten heute allein unter falschen Identitäten über hundert Geheimdienstmitarbeiter aus verschiedenen Ländern in New Opulentia ein.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Du weißt das alles so genau?\nWarum hältst du sie nicht auf?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmpf. Es ist besser, die Situation im Dunkeln unter Kontrolle zu halten, als sie zu zwingen, ihr Gesicht zu wechseln und aus dem Blickfeld zu verschwinden.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", müssen Sie Folgendes verstehen: Solange Sie noch den Körper eines Mädchens haben, können Sie niemals in Ihr altes Leben zurückkehren.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Dennoch könnte die Tatsache, dass wir bei SID Sie zuerst gefunden haben, ein Glücksfall sein.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Über Nacht ein Mädchen werden...\nWie soll ich das meinen Klassenkameraden und Freunden überhaupt erklären...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... Machst du dir keine Sorgen um deine Eltern?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Meine Mutter starb, als ich klein war.\nMein Vater... wird bereits seit vielen Jahren vermisst...", GameConfig.player_name)
	await novel_interface.show_dialog("Ich lebte bis zu meinem zwölften Lebensjahr im Internat.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Das Nachkriegs-Kinderbetreuungsprogramm des Gorillas hat also doch einigen Kindern wirklich geholfen.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Hmm, du hattest einiges an Schwierigkeiten.\nDennoch brauchst du dir über das Problem des Identitätsübergangs keine Sorgen zu machen.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Identitätsübergang...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ein ziemlich bedrohliches Lächeln erscheint auf Marirus Gesicht...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
