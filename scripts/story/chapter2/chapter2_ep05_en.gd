# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Since this morning, we've suddenly detected multiple Spacetime Phase Fluctuation alerts across New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("It's as if something woke up overnight...", "Mariru")
	await novel_interface.show_dialog("Surveillance satellites show that you vanished into thin air inside the anomaly zone, then reappeared on the other side not long after—with someone else beside you.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru turns her gaze toward Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("And right where the two of you appeared, that fluctuation disappeared on its own.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("The anomaly zone? You mean the Research Center?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactly.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Could it have been some kind of equipment malfunction...? I was out on the main road the whole time.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru's expression turns serious.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Do you think just anyone can enter and leave a Spacetime Phase Fluctuation zone?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("That fluctuation thing... is it really that dangerous?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You really don't know anything, do you...", "Mariru")
	await novel_interface.show_dialog("Spacetime phase is the foundation of physical law—like the coordinate system of the universe. No matter how particles move, the axes themselves must remain stable.", "Mariru")
	await novel_interface.show_dialog("If those axes start to tremble, even by the tiniest margin, the order of the particles within that space is devastated.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("If just 5% of the particles in a building were randomly shifted by one micrometer, the material structure would be utterly destroyed and the whole thing would collapse instantly.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("And yet you're still perfectly fine, and the buildings in that area show no structural damage at all.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(And according to our research on Divine Touches, a human carrying \"GHOST\" shouldn't even be able to enter a space like that.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In other words, you basically walked into the eye of a Category 12 hurricane that could tear everything apart, came back out unharmed, and somehow calmed the storm.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Then were those anomalies caused by the things that attacked me?\nThey seemed like they'd lost their minds...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Stop right there! I'm about to brief the Senate—", "Mariru")
	await novel_interface.show_dialog("One of those lunatics likes to run live lie-detection analysis on the conference feed, so the less I know right now, the better.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("That's... a very distinctive way to describe the Senators...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And a girl ought to know when it's okay to lie, too~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("I'm not a girl!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Anyway, fine, I won't say anything...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In recent years, there have only been four recorded cases of this kind of spacetime fluctuation in the entire world.\nMost of them were tied to containment failures involving Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("When an unknown Divine Touch is suddenly activated, the consequences can be catastrophic.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Will people get hurt?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In the worst case, the death toll alone reached the tens of thousands.", "Mariru")
	await novel_interface.show_dialog("But the major Academy Cities have always had an unspoken agreement to report those incidents as \"ordinary accidents\"...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Gas leaks, plane crashes, terrorist attacks, that sort of thing...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Then this time...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("This time is different. We've never seen continuous outbreaks on this scale before...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("It's already beyond the highest level of our propaganda scenarios. When the time comes, we won't even be able to invent a lie for it.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Could this be because of me?\nIf there's anything I can do to help...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Don't overthink it. Your physical changes may well be connected, but you alone couldn't possibly have caused a disturbance this huge.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("If you want to look for clues, you can go take a look at the scene with my people.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(If that possibility is real, then right now she's the only response we have...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("But you are absolutely not to push yourself, and you are not to tell anyone about yourself. Understood?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Not tell anyone... so does that mean...\nI have to pretend I was always a girl?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You know this already, don't you...?\nNew Opulentia has always governed under the doctrine of science above all else.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("If you make your experience public, you'll be classified as an \"experimental subject\" and carted off to a research institution~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Then you'd probably have a whole line of middle-aged men who've sworn their lives to science waiting to study your body...", "Mariru")
	await novel_interface.show_dialog("After all, it's not every day they get a girl this cute—", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...O-okay, I get it!!", GameConfig.player_name)
	await novel_interface.show_dialog("I... I absolutely won't say anything reckless!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
