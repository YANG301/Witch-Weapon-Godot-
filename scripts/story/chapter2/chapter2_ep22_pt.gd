# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Espere, onde estão os papéis que você acabou de coletar?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ugh… O papel. Eu queria te contar sobre isso.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Entrego as páginas que encontrei no campo de batalha para Annie. Elluka morde a língua.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("O Manuscrito Wardenclyffe… Maravilhoso! Não acredito que você encontrou isso!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Eles caíram daqueles caras mais cedo. Simplesmente não parece certo… Annie, você pode lê-los?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum… As linhas estão borradas, mas posso sentir a magia fluindo através delas.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("O Grimório… Fragmentos de Grimório, mais precisamente.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimório… É algo sobre as bruxas?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Na verdade, é um livro de bruxaria. O primeiro roteiro desse tipo que vi é um panfleto que surge do nada.", "Annie")
	await novel_interface.show_dialog("Se bem me lembro, o panfleto é intitulado Trajetória Mística. Simplesmente apareceu do nada no meu armário.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("No começo pensei que fosse o treinador quem me deu. A bruxaria lá dentro era super estranha, como ensinar como mudar de trajetória.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mais tarde, porém, descobri que o treinador não sabia nada sobre isso. Achei que era uma espécie de superstição, então nunca usei.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Não até…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parece que Annie acabou com a lembrança do passado. Ela abaixa a cabeça e lê os roteiros com atenção.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Lembro que Mariru disse que Bruxas são humanos que recebem certas Substance H propriedades como resultado da contaminação de informações.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Contaminação… com certeza. Eu diria que é muito direto ao ponto. Algumas “informações” dificilmente podem ser apagadas quando você coloca as mãos nelas.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Como aqueles earworms e remixes de autotune? Já tentei um milhão de vezes me livrar deles, mas sempre falhei. Às vezes eu simplesmente não consigo evitar cantarolar as músicas quando estou distraído...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ah. Bem dito, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Talvez esses papéis tenham causado o Fluxo do Espaço-Tempo? \\nMas… como isso é possível?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("É muito provável. Essas informações podem custar muita energia, o que é demais até para mim.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("É por isso que precisamos de certos “Itens” para liberar a bruxaria, para que eles possam arcar com o custo para nós.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie aponta para seu taco de beisebol. Talvez seja por isso que algumas armas consomem poder mágico…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Se acontecer uma sobrecarga de informações, as pessoas podem perder a sanidade e enlouquecer completamente…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Loucas… bruxas… \\nPrecisam… ser destruídas.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Então, bruxas… são as infelizes, certo? \\nAnnie, você sabe muito.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Não… \\nEstou apenas fazendo suposições com base em minhas próprias experiências.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manuscrito…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka parece perdida em pensamentos, seu rosto se ilumina com uma expressão de ansiedade.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hein? O que? Você quer vê-los, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka olha para mim com saudade, como um pequeno animal de estimação implorando, com os olhos cheios de lágrimas.")
	await novel_interface.show_text_only("Não posso recusar, mas esses roteiros são muito perigosos…")
	await novel_interface.show_text_only("Enquanto eu hesitava, as batidas de um avião de transporte pousando se aproximaram.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Alguém está vindo!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID oficial? Ótimo, encontramos um… \\nO quê?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Surpreendentemente, a pessoa que sai da aeronave não é um agente SID.")
	await novel_interface.show_text_only("O homem de óculos olha para Elluka com ternura, mas ela estremece de medo.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, você me deixou esperando por muito tempo.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Administrador… sinto muito.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Você tem o manuscrito? \\nVocê não pode lidar com eles sozinho - eu avisei. Traga-os para mim agora.", "Administrador")
	await novel_interface.show_dialog("Somente lixo inútil me falharia em uma tarefa tão pequena, certo?", "Administrador")
	await novel_interface.show_dialog("Limpe essa bagunça e depois venha comigo para Oligar. Há outro trabalho esperando por você.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ei, ei, ei, cuidado com a língua! Você não vê que ela está ferida?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ela é apenas uma garotinha, não uma ferramenta que você possui!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O estranho parece não ter me notado até agora. Ele me examina com um sorriso estranho, como um predador inspecionando sua presa.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, leve-a conosco.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hein?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sobre meu cadáver. Ninguém aguenta Lian enquanto eu estiver aqui.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Leve ela...?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sim, isso é uma ordem.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Encomende…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka me encara, bastante inexpressivo. Ela parece estar numa luta interior, mas desobedecer ao Administrador não é uma opção.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Tarefa: leve Lian embora. \\nAlvo bloqueado…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
