# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Muttering) That little brat was a lot more interesting...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voice-call connection prompt flickers across the screen diagonally in front of Mariru. The deliberately distorted electronic voice masks the speaker's original gender.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(I've done this briefing plenty of times, but this one-sided encrypted interference format is still infuriating.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("So, regarding the disappearance of the Ross Goblet, how is the investigation proceeding now?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("At 00:15 this morning, the security system confirmed that the Ross Goblet had disappeared.", "Mariru")
	await novel_interface.show_dialog("At 06:40, the True Sight satellite monitoring system issued a warning after detecting severe dimensional distortion.", "Mariru")
	await novel_interface.show_dialog("Then, from 07:00 this morning until now, the Aegis system has detected six Spacetime Phase Fluctuation alerts within New Opulentia.", "Mariru")
	await novel_interface.show_dialog("And if we take the research institute as the center, thirty-two similar alerts appeared simultaneously within a radius of fifteen hundred kilometers...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("All of that is already in the document. Give me the conclusion.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru glances over her right shoulder and smiles.")
	await novel_interface.show_text_only("Just from the tone alone, she can tell it's the Senate's stern, unsmiling Chief Executive.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—This was not a theft. It was the awakening of a Substance H, along with the chain reaction it triggered.", "Mariru")
	await novel_interface.show_dialog("And judging by the current frequency and scale, we still can't determine whether it's a memetic-type Substance H.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The instant Mariru finishes speaking, startled murmurs and hushed discussion ripple through the darkened screens around her.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("What?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A deep, steady voice comes from Mariru's left.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("You mean an exponential outbreak of a mind-affecting \"Divine Touch\"?\nNow that's interesting...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("At the moment, it looks more likely to be multiple incidents erupting at the same time.\n\"Divine Touch\"... I'm not particularly fond of imprecise terminology.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Though he is the authority on mind-affecting Substance H...)", "Mariru")
	await novel_interface.show_dialog("(I still can't shake the feeling that this gorilla fried his brain on too much radiation.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Then according to your judgment...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("There's no way I can submit a conclusion report yet. We simply don't have enough actionable information.", "Mariru")
	await novel_interface.show_dialog("Given the current situation, I'm requesting an unrestricted Class-S investigation order. I hope you can all understand.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ignoring the whispers around her, Mariru turns her attention back to the handheld terminal.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(That little girl went to another anomaly zone...)", "Mariru")
	await novel_interface.show_dialog("(As expected—she disappeared, reappeared a while later, and then the nearby phase fluctuation stopped again.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(The footage from the scene... is that blood on her?)", "Mariru")
	await novel_interface.show_dialog("(That idiot... don't tell me she actually—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("You seem a little distracted.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What?... Not at all.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Whatever you're staring at—does it contain information more important than this briefing?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Nah, it's just a video of a kitten. Want to see it?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("A sharp electrical whine and buzzing sound erupts from Mariru's left.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Don't be so angry. A little diversion improves work efficiency.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru sweeps her gaze around the room. It seems no one noticed the momentary slip just now.")
	novel_interface.character_light()
	await novel_interface.show_dialog("In any case, the basic intelligence we've obtained so far is exactly as stated in the briefing.\nThe incident is still under further investigation.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("If there are no questions, I'm heading to the scene.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Before Mariru can leave, a somewhat flippant voice comes from her left.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...I heard your subordinates brought two high school students back to SID for questioning?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(That obnoxious bastard again.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("Was there something special about them, Lady Mariru... no, Doctor?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Nothing at all. We've already confirmed it—they were just two overly curious little kittens who sneaked into a restricted zone.", "Mariru")
	await novel_interface.show_dialog("I'll arrange to have them sent home afterward.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I see. That's good, then.", "#C")
	await novel_interface.show_dialog("At a sensitive time like this, it would be troublesome if other countries started treating them as some kind of strange existence...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("That remark sets off an uproar among the others.")
	await novel_interface.show_text_only("...What's that supposed to mean?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("A careless remark can make some people uncomfortable, I'm sure.\nMy apologies—just pretend you never heard it.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(What an utterly detestable man.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Well then, regardless, this incident has already drawn the attention of the other Academy Cities.", "Bright")
	await novel_interface.show_dialog("We'll be relying on you for the classified investigation and the management of public information from here on out.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Naturally.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
