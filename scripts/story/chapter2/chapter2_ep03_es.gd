# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("“Escoltado” por los agentes, Annie y me subí a un sedán negro azabache.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("El habitáculo es asfixiante.")
	await novel_interface.show_text_only("Envuelvo mis brazos alrededor de mis rodillas, desconcertada.")
	await novel_interface.show_text_only("Annie se apoya suavemente en mí, lo que me hace sentir algo relajado.")
	await novel_interface.show_dialog("Entonces... ¿qué es SID? \\nTe pones nervioso cada vez que lo escuchas.", "Annie")
	await novel_interface.show_dialog("¿Eres del espacio exterior? \\nSID es el departamento de inteligencia bajo el Senado.", GameConfig.player_name)
	await novel_interface.show_dialog("Algunos dicen que SID juega un papel más importante que el Aegis sistema de defensa para mantener New Opulentia neutral.", GameConfig.player_name)
	await novel_interface.show_dialog("Pero hay más leyendas urbanas sobre personas tomadas por SID y nunca regresan... Es simplemente horrible.", GameConfig.player_name)
	await novel_interface.show_dialog("Vale... Pero entonces, ¿qué es Ciudad Academia?", "Annie")
	await novel_interface.show_dialog("(Espera... ¿Esta chica no tiene ningún sentido común?)", GameConfig.player_name)
	await novel_interface.show_text_only("Annie ve mi mirada de sorpresa... y solo me da una sonrisa relajada.")
	await novel_interface.show_dialog("¡Relájate, no tendremos ningún problema!", "Annie")
	await novel_interface.show_dialog("Porque... eres especial.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("Es extraño que las divagaciones de Annie de alguna manera hayan calmado mi mente agitada.")
	await novel_interface.show_text_only("No parece tan horrible que se lo lleve SID...")
	await novel_interface.show_text_only("(No. No. ¡Es horrible!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("Llegamos a la bulliciosa zona comercial de la ciudad y entramos en un garaje común y corriente en el sótano, donde subimos a un ascensor para coches.")
	await novel_interface.show_text_only("Después de que el agente informa, el ascensor comienza a moverse.")
	await novel_interface.show_text_only("Puedo sentir lo rápido que se mueve el ascensor. Desciende varias veces durante largos tramos e incluso se desplaza de vez en cuando hacia los lados.")
	await novel_interface.show_dialog("(Es difícil imaginar un laberinto subterráneo así debajo de la zona comercial...)", GameConfig.player_name)
	await novel_interface.show_text_only("Abundan los rumores sobre la sede SID. Algunos dicen que está ubicado en los suburbios del sur de New Opulentia, y que toda la estructura está recubierta con camuflaje óptico.")
	await novel_interface.show_text_only("Por supuesto, para un edificio que no existe oficialmente en el sistema, los medios podrían inventar cualquier cosa siempre que atraiga clics.")
	await novel_interface.show_text_only("Y donde estoy entrando es exactamente en el área central de este departamento “inexistente”.")
	await novel_interface.show_dialog("(Sólo espero que no me hagan “inexistente” aquí...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Bajamos del coche frente a un pasillo forrado con placas de metal. Da una sensación de tecnología y abstinencia.")
	await novel_interface.show_text_only("La puerta del ascensor se cierra automáticamente justo después de que bajamos. Escuchamos que se va mientras continuamos por el pasillo oscuro. El aire se vuelve rígido y lúgubre.")
	await novel_interface.show_text_only("Mi corazón también se está hundiendo...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("Caminamos recto por el pasillo y llegamos a una habitación luminosa pero cerrada.")
	await novel_interface.show_text_only("Parece una especie de sala de interrogatorios, pero no hay mesas ni sillas. Una pared es un enorme panel de vidrio.")
	await novel_interface.show_text_only("Antes de que pueda girarme para mirar esa pared...")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Vaya!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Alguien rodea con fuerza sus brazos alrededor de mi cintura.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Ay… ¡Duele!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando estoy a punto de perder el equilibrio, siento que mi cabeza cae sobre algo familiar, suave pero firme.")
	await novel_interface.show_dialog("Bueno... A juzgar por tu fuerza central, el tema del espionaje no es para ti.", "Voz femenina")
	await novel_interface.show_dialog("Pensé que teníamos algunos errores en el escaneo corporal, así que quería confirmarlo personalmente.", "Voz femenina")
	await novel_interface.show_dialog("Aunque se siente bien.", "Voz femenina")
	await novel_interface.show_text_only("La Voz femenina detrás de mí me suena familiar.")
	await novel_interface.show_text_only("Ella suelta los brazos. Con miedo persistente, me doy la vuelta. \\nLa mujer frente a mí—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(¡¿Eh?! ¡¡¡E-eso es enorme!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¿¡Sra.... Sra. Mariru!?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("¿La conoces?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¿Ah? Tan rápido de revelar que puedes identificar a agentes de otra agencia de inteligencia. \\nParece que nunca planeaste ocultar quién eres...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(¡Dios! Qué tonto soy…)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Es difícil de creer, pero esta mujer uniformada frente a mí es la mujer que conocí en mi sueño.")
	await novel_interface.show_text_only("La figura esbelta... el pelo rojo... la mirada sádica...")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Debes responder mis preguntas honestamente ahora.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("No pongas excusas ni hagas trucos.", "Mariru")
	await novel_interface.show_dialog("El interrogatorio resulta ser una de mis especialidades. \\nNo seré fácil con esa linda carita tuya~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("Esa actitud autoritaria y burlona, y esos ojos confiados con un toque de burla...")
	await novel_interface.show_text_only("¿Cuál es su nombre completo? \\nCorrecto, es...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Exacto. Soy el jefe de SID. Mi nombre es Mariru Von Braun.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("¡¡¡Es ella!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Espera... ¿el jefe de SID? \\n¿No era ella la científica jefe?")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("Pero si miras de cerca su ropa y sus marcas en los hombros, probablemente sea una gran jefa...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Sin embargo, sus medias y tacones altos son los mismos que ayer.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oye niña, ¿qué estás mirando, eh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("¡Ah! Sí... ¡claro! \\n¡Lo siento, señora!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tienes algo de valor para dejar que tu mente divague ahora mismo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("He oído que le contaste muchas historias horribles sobre SID a este gemelo azul.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru hace girar su látigo en sus manos. Me pongo nervioso y trago fuerte.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Adivina... \\n¿Cuántas de ellas son ciertas?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("¡Eh! ¡Lo siento mucho!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("B… azul de doble cola…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ahora que conoces el miedo, comencemos con tu identidad.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru abre su terminal portátil e inmediatamente aparece una proyección en la pared de la sala de interrogatorios.")
	await novel_interface.show_text_only("Muestra fotografías mías tomadas desde diferentes ángulos por cámaras de vigilancia y el resultado del análisis facial dice:")
	await novel_interface.show_text_only("[No se encontraron coincidencias]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("No hay registro de llegada... Aegis no logra identificar.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Si no fuera por su mala condición física, inmediatamente lo tratarían como un espía o un intruso terrorista.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("Me siento un poco avergonzado y me froto la barriga inconscientemente.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", esta dama parece incluso más aterradora que los enemigos con los que nos topamos antes...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Sí… y ella no tendrá ningún problema para ver a través de mis mentiras...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(¡Lo confesaré! ¡Dios! ¡Lo que sea!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", ¿por dónde debería empezar...?", GameConfig.player_name)
	await novel_interface.show_dialog("Es un poco complicado, para ser honesto. Yo también estoy muy confundido.", GameConfig.player_name)
	await novel_interface.show_dialog("Probablemente no creas lo que digo...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Deja de divagar. ¡Lo juzgaré por mí mismo!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("… Bueno… tuve este sueño.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("En el sueño, iba al Centro de Investigación para asistir a una conferencia para mi informe de enseñanza al aire libre... Y llegué justo antes de la hora de cierre.", GameConfig.player_name)
	await novel_interface.show_dialog("Te conocí allí. Y dijiste que ha sido capturado...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Aparentemente, Mariru toma esto como una broma o algo así.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("¿Quieres decir que me conociste en un sueño?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí, fuiste tú. \\nY me arrastraste a un rincón...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Oh, right... you were an SS-class scientist recognized by the Senado... \\nDr. Mariru Von Braun, ¿verdad?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Ese soy yo.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Pero esta información no es secreta; cualquiera que esté familiarizado con New Opulentia lo sabe.", "Mariru")
	await novel_interface.show_dialog("... Olvídalo. \\nEntonces, ¿qué pasó después?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Derribaste a uno de los intrusos y conseguiste una pistola. Me pediste que me quedara quieto esperando el rescate y fuiste al lugar del secuestro.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Punto de secuestro? \\n¿Dónde exactamente?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dijiste que era la sala de conferencias.", GameConfig.player_name)
	await novel_interface.show_dialog("Estabas a punto de dar una conferencia allí. Tú eras el conferenciante.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Conferencia… Profesor.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(¿Se refiere a la conferencia pública sobre Ross Goblet organizada por Wolfgang?)", "Mariru")
	await novel_interface.show_dialog("(Pero debería haber sido cancelado. ¿Cómo pudo saber ella sobre esto?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um... ¿Sra. Mariru?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sí… nada. Seguir.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y pasaron unos pistoleros enmascarados. Corrí escaleras abajo y me escondí a la sombra de una pizarra...", GameConfig.player_name)
	await novel_interface.show_dialog("Lo siento pero no recuerdo lo que pasó allí...", GameConfig.player_name)
	await novel_interface.show_dialog("De alguna manera me desmayé y cuando desperté, vi…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("¿Qué viste?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Vi humo y llamas por todas partes.", GameConfig.player_name)
	await novel_interface.show_dialog("El Centro de Investigación y los edificios circundantes estaban todos en ruinas...", GameConfig.player_name)
	await novel_interface.show_dialog("Había un olor acre por todas partes.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Tenía un fuerte sabor salino y amargo...", GameConfig.player_name)
	await novel_interface.show_dialog("Todas las personas se convirtieron en figuras de piedra.", GameConfig.player_name)
	await novel_interface.show_dialog("No, no exactamente piedra: era sal.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Y vi algo brillando en el aire.", GameConfig.player_name)
	await novel_interface.show_dialog("Fue como el infierno. \\nPero de alguna manera puedo sentir una especie de tranquilidad peculiar.", GameConfig.player_name)
	await novel_interface.show_dialog("Algo me está respondiendo...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Y entonces mi memoria se volvió vaga... Podría haber un rayo de luz—", GameConfig.player_name)
	await novel_interface.show_dialog("Y... ese es prácticamente el final del sueño.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Cuando desperté, me encontré en la cama de mi habitación y ya era de mañana.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("¿Fue... solo un sueño...?", "Mariru")
	await novel_interface.show_dialog("Tu memoria olfativa era tan vívida como si realmente estuvieras allí…", "Mariru")
	await novel_interface.show_dialog("(Si ese olor acre fuera azufre...) \\n(Sería como la forma en que Sodoma y Gomorra fueron destruidas en Génesis.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
