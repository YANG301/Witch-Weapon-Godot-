# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("We eliminated the boss after a fierce battle, and the other enemies vanished in a puff of red mist.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Whoa... \\nWait, what’s this?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A couple of yellowing pages fall in front of me. On the pages are a mix of text and patterns, barely readable.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("What? \\nOh... I feel dizzy...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I rub my eyes and try to read the words again. The one thing I’m sure about is that they’re written in English.")
	await novel_interface.show_text_only("Although some letters are legible, ")
	await novel_interface.show_text_only("All I can feel is complete chaos whenever I try to put them together.")
	await novel_interface.show_text_only("It feels like a reading disorder. I cannot identify even the easiest word on it.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Put them away for now. We have a life to save.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Right. Got it!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The moment I put them away, I think I saw a flashing talisman on the paper, but it disappeared very quickly.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("That’s...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Eh?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Is that my illusion? \\n(I feel an indescribable quiver. What’s that...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The slight tingling on my arm reminds me this is not an illusion.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Hey, are you okay?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I look at the injured girl. She still looks cold. \\nNot happy or grateful for what Annie and I have done for her.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Judging from her appearance and outfit, she's not just a girl next door…")
	await novel_interface.show_text_only("The eye patch is weird enough. But look at her hands under the frock… They are wrapped in mechanical armor.")
	await novel_interface.show_text_only("She has a serious wound on the belly... Even an adult will break down. ")
	await novel_interface.show_text_only("But she’s been sitting there so quietly, without a word.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Hey, what’s your name? \\nWhat are you doing around here?", "Lian")
	await novel_interface.show_dialog("Do you know those guys?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Alright... maybe that’s too many questions for her...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The little girl suddenly stands up, still bleeding. She’s actually taller than I thought…")
	await novel_interface.show_text_only("Oh my god! \\nHer body... is floating above the ground?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nMission: Eliminate, witches.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl answers the questions in a very strange way.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... Is that her name? \\nShe speaks in a very odd tone.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Target, identifying... \\nHuman. Female. Amount...", "Elluka")
	await novel_interface.show_dialog("One.", "Elluka")
	await novel_interface.show_dialog("... \\nRe-identifying, activated.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(“One” female?) \\n(Did she identify me as a male just now?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Yeah, that’s right! I am a boy!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Witch, amount, one. \\nDefense mode, activated.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Bahahaha... \nFinally! Lately I’ve been having this feeling that some stranger will find out my true identity.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Uh... why are her hands shining, brighter and brighter? \\nWhoa... Hold on, wait a minute!")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Aaaah! \\nOuch! Ouch! Ouch!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("Why are you picking on me?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("That was close. Thanks to my quick response, that lightning strike only touched my arm slightly and left a whitish burn on the ground.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Low combat skills. Fast escape. \\n... No threat.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Well... it seems that I have just been identified as a chicken…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Why did you attack me alone? \\nI helped you.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("No match for a witch.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's honest!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Little Elluka, look, we’ve been so nice. \\nSo we are definitely not bad people.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Whisper) Annie, this isn’t persuasive at all. And it sounds like we’re kidnappers.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Well…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... So, Elluka, are you also a witch?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie ignores me and asks Elluka directly.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("Hey, wait! Maybe Elluka doesn’t even know what a Witch is.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Executioner.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Executioner... Well... Why do kids these days love such stupid nicknames so much?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Damn, I just said that out loud...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Another lightning strike hits, and I dodge it just in time again.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hey, kid! \\nCan we just talk?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Here... chocolate. Stop being mad, alright?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I take a bar of chocolate from my pocket, break it in half, and share it with Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Phew... Lucky that I have chocolate with me. \\nNo kid hates chocolate after all.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yum...yum... \\nSee, I’ve eaten it up.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Chocolate?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("It’s not dangerous... \\nIt’s a snack that brings you happiness!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(Whispering) Lian, the one who offers food to little girls may look more like a kidnapper.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("And you are acting like a girl now, taking chocolates along. Well done!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka hesitates for a moment before she opens the packing and slowly puts a piece into her mouth.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nWeird, flavor...", "Elluka")
	await novel_interface.show_dialog("Bitter.", "Elluka")
	await novel_interface.show_dialog("Sweet...", "Elluka")
	await novel_interface.show_dialog("Elluka, doesn’t hate it.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Haha, you like it?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ooh... she looks so cute...!")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Mwahaha...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Oops! Lian looks so dangerous.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Facial expression, identifying... Hentai.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hentai...?! \\nYou mean, me?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("But, Elluka, doesn’t hate it.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha... then that’s fine.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("You look happy to be labeled as a Hentai. \\nYou’re really weird...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("No, I'm not. Could you stop misinterpreting me?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Oh! \\nI have another piece. You can have it.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Here!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka fishes around, pulls out a transparent container the size of an AA battery, and gave it to me. In it is a green, thick, fluorescent fluid.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Is this... electric fluid?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Exchange, food.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Is this what you call food?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka nods seriously.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("When I am hungry, the administrator, gives me food. \\nTo replenish, energy.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The administrator, your guardian?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Since you can eat chocolate, your body should function just as a normal kid does, right?", "Lian")
	await novel_interface.show_dialog("You’re not a home appliance...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("No doubt, this girl can feel the existence of magic inscriptions.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("But how she’s powered… is very special.", "Annie")
	await novel_interface.show_dialog("She’s... an Executioner?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
