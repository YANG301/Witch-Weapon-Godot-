# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("アパートに戻った後でも、イルカは俺の服を\\n掴んだまま寝ている。\\n何をやっても手を離してくれなかった。")
	await novel_interface.show_text_only("アニーとマリルは俺に見せないよう人垣を組み、\nイルカの金属手甲と破れたコートを脱がして、\nやっとのことで普通の服に着替えさせた。") #换行问题
	await novel_interface.show_text_only("命に誓って変な事は絶対にしないと約束した後、\\n俺の部屋にイルカを運ぶ事を、\\n彼女達はようやく許可してくれた。")
	await novel_interface.show_text_only("……イルカは今、俺のベッドに横たわり、\n相変わらず俺の服を掴みながら熟睡している。\nそのため、俺もベッドの傍から離れられない。")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("子供はこんなくっつきたがるもんなんだな……\\n疲れたぁ～～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("波乱の一晩がやっと終わり、\\n俺も疲れていないわけが無く、横になった。\\nふとポケットに入っていた紙の束に触れてみる。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("これがアニーが言ってた……\\n『魔導書の破れたページ』", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("イルカも欲しがっていたよな。\\n小動物のような目で俺を見て……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は横たわったままで、紙の束をじっくりと\\n見てみるが、やはりただのカオスだ。\\n内容の認識が一切できない。")
	await novel_interface.show_text_only("紙束の前後を入れ替えてみる。\\n\\n誤って数枚の紙切れをイルカの方へと\\n滑り落としてしまった。")
	await novel_interface.show_text_only("紙がイルカに接触して──\\n\\nすると突然、青色の光が放たれた。")
	await novel_interface.show_text_only("大量の情報を記載した図形が湧き出すと同時に、\\n部屋内の空気が振動する。")
	await novel_interface.show_text_only("そして俺の手にある紙も全て、何らかの力により\\n引っ張られるかの如く、\\nイルカの身体に吸い込まれていった。")
	await novel_interface.show_text_only("目を開けられないほどの光が消失した後、\\n何事もなかったかのように辺りを静寂が包む……")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("い、いまのは……！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("探索開始、目標発見──\\nチョコレートの……お姉ちゃん！", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("イルカっ！？　起きたのか？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカが俺に抱き付いた。それと同時に、\n俺の後ろのドアが力強く蹴り開かれた。")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("ねぇ、今の振動は何！？\\n……ってワオッ！？\\n結～～局イルカに手を出したのね！？", "アニー")
	novel_interface.character_dark()
	await novel_interface.show_text_only("アニーが変な目で俺を見る。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("誤解だって！　俺の話を聞いてくれッ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("エナジー、満タン。\\n捜索……未発見。", "イルカ")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("どうしたんだ？　何かを探してるのか？", "小憐")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("……裁判所、管理人。", "イルカ")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("裁判所……って？\\nとりあえずマリルと相談しよう。", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("裁判所か……\\nお前の元には本当に面倒が寄り付いてくるなぁ。\\nよりにもよって『教団』の者を連れ帰ったとは。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("えっ！？　なんだそれ？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("魔女の記録を調査するにあたり、文献から\\n怪しい地下組織の存在をいくつか発見した。\\nその中で1番古いものが『教団』", "マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("しかし、現在の『教団』はいくつかの派閥に\\n分裂している。\\n『裁判所』は分裂した内の1つだ。", "マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("その派閥は数百年前から存在していたらしい。\\n全ての魔女の根絶を主張し、\\n遥か昔は『魔女狩り』活動の主力だったそうな。", "マリル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("私はそういう、非科学的な団体と関わるのは\\n大嫌いだ。", "マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("イルカには新豊洲の保育学校を手配する\\n予定だったが……\\nこうなってしまった以上、容易く手放すのも\\nダメになったな～～", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("何か企んでるなマリル。\\n勝手に実験したりするなよ……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("お前の中で、私はそんなに悪者か？", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルが俺の頭を小突いた。\\n\\nイルカは頬を膨らませ、不機嫌そうにマリルを\\n見つめている。")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("目標判定、危険度、極高。", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("……このガキめ。", "マリル")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("そうだ！　イルカ、あのヤコブって言う男に、\\nどんな任務を与えられていたんだ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは眉をひそめ、少しずつ思い出していく…")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("1、ドールの始末、完了。\\n2、手稿の確保、失敗しました。", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("手稿？\\nレンちゃんが持ってるんじゃなかったっけ？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("検索……状態異常。\\n手稿……消化済み。", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("消化って……君と一体化したって事？\\n\\nそれとも、あの手稿は元々イルカの魔導書の\\n一部だった？", "小憐")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("管理人が消化を禁じたのは……\\n君の力が増す事によって、\\n制御できなくなるのを恐れていた？", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("イルカの言葉をここまで具体的に通訳するって、\\nレンちゃんはやっぱりスゴイ！", "アニー")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("って、イルカの魔導書って事は。\\nつまり……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("やはりこの小娘も『魔女』なのか？", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルはイルカの頬を摘まもうとしたが、\\n……イルカに警戒されて躱された。")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("魔女の製造と統率を試みている組織がいるとは\\n聞いていたが……\\nやはりどの時代でも、スーパーソルジャーを\\n欲しがる野心家はいるもんだ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("なんか魔女に詳しいよな、みんなは……\\n俺はまだ理解できてないんだけど、\\n一体どうやったら魔女になるんだ？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("私も最初は、よく分からなかったの。\\nあの時うっかり本を読んだのは覚えてるけど……", "アニー")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("読んでいると脳が痺れる感覚がしてきて、\\n段々と何も考えられなくなって……\\nその後は、身体が何かに汚染されて行くような…", "アニー")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("そしてある時、本の中にある呪文を暗唱したら、\\nあの異次元空間に巻き込まれたの……", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("空間か……\\n\\nお前達が変電所にたどり着いたと同時に、\\n衛星が時空位相波動の消失を感知した。", "マリル")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("以前の異変区域みたいな感じがしなかったのは、\\nそれが原因かも！", "アニー")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("その異変区域だが、魔女について記された古代の\\n文献の中では『魔女の繭』と呼ばれている。", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("人間が魔女へと変貌する際に形成される結界。\\n外からは破る事も進入する事も不可能だ。\\n性質は、異質物が生成した空間と似てるだろう？", "マリル")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("変電所の波動が消えたとほぼ同時に、\\n衛星が光学信号を検出し──", "マリル")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("お前らと戦った奴らが現れた。", "マリル")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("よくよく考えれば『魔女の繭』という名前……\\nあいつらは繭の消失と同時に現れる。\\n──まるで孵化したかのように。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("ドール、消滅！", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("やっぱりドールは……\\n魔導書の情報量に耐えられず、理性を失った人間\\nって事なんだよな。", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("そうね…彼女達も元は普通の少女だったはず……\\nだけど手稿に記載された魔法の継承に失敗して、\\n力の反発を受けてしまった。", "アニー")
	await novel_interface.show_dialog("空間に大きな変異を引き起こすと同時に、\\n自身も……『ドール』と呼ばれる化け物に。", "アニー")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("多くの古文書に類似的な記載がある。\\n魔法の情報を知れば知るほど手の施しようのない\\n狂気に陥る可能性が高くなると。", "マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("魔法を身に付けた挙句、理性を失ったドールは、\\n大きな破壊を招いてしまう。\\nもし本当にそうだったら……", "マリル")
	await novel_interface.show_dialog("それこそ、ヨーロッパの『魔女狩り』運動が、\\n長く続いた原因の1つ……なのかもな。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("なんか、まるでウイルス感染じゃないか。", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("現在の情報から推察すると、イルカの管理人は、\\nドールの殲滅を最優先事項に指定。\\nその次に魔導書の破れたページを回収しようと\\nしていた。", "マリル")
	await novel_interface.show_dialog("彼はイルカに魔導書の使用を禁じた……\\n\\nもしかしたら、もっと多くの魔女を作り出す\\n腹積もりかもしれない。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("でも俺はイルカの魔導書を見たけど、\\nこれっぽっちも読めなかったぞ。\\n俺が元々男って事と関係あるのかな？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("おとこ……？", "イルカ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("イルカは少し緊張したように後ずさる。\\nその表情には疑惑がうかがえる。")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("え～っと、イルカ、\\nこの件はとりあえず置いておこう。\\n気にしないで……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("私は読めたよ～。\\nレンちゃんは元々アンポンタンだし、\\n魔法とか関係なく普通に読めないんじゃないの？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("それよりも、お前はなぜ意図も容易く\\n「魔女の繭」に入る事ができるんだ？\\n方法を教えろ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("俺だってやりたくてやってるわけじゃないよ！！\\nあの中に入るたびに、皆で俺を殴ってくるし……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("お前のやってる行為は多層次元に跨っていて\\n現在の科学では説明が不可能だ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺自身で説明できるなら、まずなんで\\n俺が女の子になっちゃったのかを知りたいよ！")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("えっへへ～、悩んじゃダメだって！\\n\\n今は分からなくても、いつか原因がちゃ～んと\\n分かる時が来るって！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("楽観的だな…、アニー……", "小憐")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
