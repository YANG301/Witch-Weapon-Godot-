# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Aspetta, dove sono i documenti che hai appena raccolto?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Uffa... Il giornale. Volevo parlartene.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Consegno le pagine che ho trovato sul campo di battaglia a Annie. Elluka si morde la lingua.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Il manoscritto Wardenclyffe… Meraviglioso! Non posso credere che tu abbia trovato questi!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Sono caduti da quei ragazzi prima. Semplicemente non mi sembra giusto... Annie, puoi leggerli?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uhm... I confini sono sfumati, ma riesco a sentire la magia che scorre attraverso di essi.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Il Grimorio… Frammenti di Grimorio, più precisamente.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimorio… Ha a che fare con le streghe?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("In realtà è un libro di stregoneria. La prima sceneggiatura di questo tipo che abbia mai visto è un opuscolo uscito dal nulla.", "Annie")
	await novel_interface.show_dialog("Se ricordo bene, l'opuscolo si intitola Mystical Trajectory. È appena apparso dal nulla nel mio armadietto.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("All’inizio pensavo che me lo avesse dato l’allenatore. La stregoneria all'interno era davvero strana, come insegnarti come cambiare traiettoria.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ma più tardi ho scoperto che l'allenatore non ne sapeva nulla. Pensavo fosse una sorta di superstizione, quindi non l'ho mai usato.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Non finché…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembra che Annie abbia finito di ricordare il passato. Abbassa la testa e legge attentamente quelle scritte.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Ricordo che Mariru disse che le streghe sono umani che ricevono determinate Substance H proprietà come risultato della contaminazione delle informazioni.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Contaminazione… di sicuro. Direi che è molto pertinente. Alcune \"informazioni\" difficilmente possono essere cancellate una volta messe sopra le mani.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ti piacciono quegli auricolari e i remix di autotune? Ho provato un milione di volte a sbarazzarmene ma ho sempre fallito. A volte non riesco proprio a fare a meno di canticchiare la melodia quando sono distratto...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ah. Ben detto, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Forse questi documenti hanno causato il flusso spaziotemporale? \\nMa... com'è possibile?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("È molto probabile. Tali informazioni possono costarti molta energia, il che è troppo anche per me.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ecco perché abbiamo bisogno di determinati \"oggetti\" per liberare la stregoneria, in modo che possano sostenerne il costo per noi.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie indica la sua mazza da baseball. Forse è per questo che alcune armi consumano potere magico...")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Se si verifica un sovraccarico di informazioni, le persone potrebbero perdere la sanità mentale e impazzire completamente...", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Pazze... streghe... \\nHanno bisogno... di essere distrutte.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Quindi, le streghe... sono quelle sfortunate, giusto? \\nAnnie, sai molto.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("No... \\nSto solo facendo delle supposizioni basate sulla mia esperienza.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manoscritto…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka sembra persa nei suoi pensieri, il suo viso si illumina con un'espressione di entusiasmo.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Eh? Che cosa? Vuoi vederli, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka mi guarda con desiderio, come un piccolo animale domestico che implora, con gli occhi pieni di lacrime.")
	await novel_interface.show_text_only("Non posso rifiutarla, ma questi copioni sono troppo pericolosi...")
	await novel_interface.show_text_only("Mentre esitavo, si avvicinano i colpi di un aereo da trasporto in atterraggio.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Qualcuno sta arrivando!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID ufficiale? Ottimo, abbiamo trovato un... \\nCosa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sorprendentemente, la persona che scende dall'aereo non è un agente SID.")
	await novel_interface.show_text_only("L'uomo con gli occhiali guarda Elluka con tenerezza, ma lei trema di paura.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, mi hai fatto aspettare troppo a lungo.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Amministratore... mi dispiace.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hai il manoscritto? \\nNon puoi gestirli da solo, te l'avevo detto. Portameli, adesso.", "Amministratore")
	await novel_interface.show_dialog("Solo la spazzatura inutile mi deluderebbe in un compito così insignificante, giusto?", "Amministratore")
	await novel_interface.show_dialog("Pulisci questo pasticcio e poi vieni con me da Oligar. C'è un altro lavoro che ti aspetta.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Whoa, whoa, whoa, attento a come parli! Non vedi che è ferita?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("È solo una ragazzina, non uno strumento che possiedi!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lo sconosciuto non sembra essersi accorto di me fino ad ora. Mi scruta con uno strano sorriso, come un predatore che esamina la sua preda.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, portala con noi.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Eh?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sul mio cadavere. Nessuno può sopportare Lian finché sono qui.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Prendila...?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sì, è un ordine.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Ordina…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka mi fissa con sguardo assente. Sembra che stia attraversando una lotta interiore, ma disobbedire all'Amministratore non è un'opzione.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Compito: portare via Lian. \\nObiettivo bloccato...", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
