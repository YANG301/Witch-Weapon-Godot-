# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("Zurück in der Wohnung klammert sich Elluka auch im Schlaf immer noch an meine Kleidung.")
	await novel_interface.show_text_only("Annie und Mariru befehlen mir, mich umzudrehen und keinen Blick darauf zu werfen, und bilden dann eine menschliche Mauer, während sie Ellukas Metallstulpen und den zerrissenen Mantel ausziehen und ihr normale Kleidung anziehen.")
	await novel_interface.show_text_only("Dann lassen sie mich bei meinem Leben schwören, dass ich Elluka keinen Schaden zufügen werde, bevor sie mir erlauben, sie in mein Zimmer zu bringen.")
	await novel_interface.show_text_only("...Jetzt schläft Elluka auf meinem Bett und umklammert immer noch meine Kleidung, sodass ich nur noch neben ihr sitzen kann.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Warum bist du so anhänglich, Kleiner? \\nGott, ich bin so müde…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nach einer ganzen Nacht Operation bin ich völlig erschöpft. Als ich zurück auf das Bett falle, spüre ich das Papier in meiner Tasche.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Annie sagte, das seien... die Grimoire-Fragmente?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Elluka schien das zu wollen und sah mich an wie ein süßes Haustier ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich liege auf dem Bett und untersuche die Seiten noch einmal. Doch der Inhalt ist genauso unverständlich wie zuvor.")
	await novel_interface.show_text_only("Während ich die Seiten umblättere, rutschen mir ein paar Seiten aus der Hand und fallen auf Ellukas Körper.")
	await novel_interface.show_text_only("In dem Moment, in dem die Seiten ihren Körper berühren, erscheint plötzlich ein bläuliches Leuchten.")
	await novel_interface.show_text_only("Eine Welle von Symbolen und Wörtern bricht aus den Seiten hervor und sogar die Luft in meinem Zimmer beginnt zu beben.")
	await novel_interface.show_text_only("Plötzlich scheinen die verbleibenden Seiten von einer unsichtbaren Kraft zu Ellukas Körper gezogen zu werden.")
	await novel_interface.show_text_only("Es gibt einen grellen Lichtstrahl, dann verschwindet alles.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("W-Was ist das?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Suche eingeleitet. Ziel identifiziert – \\nSchokolade... große Schwester!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Elluka?! Du bist wach!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka wirft plötzlich ihre Arme um mich. Gleichzeitig wird die Tür hinter mir aufgerissen.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Hey, was war das für ein Zittern?\\n...Warte, hast du endlich einen Schritt unternommen, Elluka?!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie sieht mich an, als wäre ich ein Perverser.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Es ist nicht das, was du denkst. Lass es mich erklären!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Energie, voll.\\nSuchendes... Ziel wurde nicht gefunden.", "Elluka")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Warum, wen suchen Sie?", "Lian")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("… Administrator des Gerichtsgebäudes.", "Elluka")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Das Gerichtsgebäude...? Was ist das?\\nWie auch immer, lass uns Mariru holen und herausfinden, was zu tun ist.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Gerichtsgebäude ... Ihr bringt mich in große Schwierigkeiten. Ihr Freund ist Mitglied der Kongregation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hä? Was ist das?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Während ich über Hexen recherchierte, lernte ich diese seltsamen Untergrundorganisationen kennen, darunter auch die Congregation, die älteste ihrer Art.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Die Kongregation spaltete sich später in verschiedene Fraktionen auf, und das Gerichtsgebäude ist eine davon.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Seit seiner Abspaltung vor Hunderten von Jahren drohte das Gerichtsgebäude mit der Auslöschung aller Hexen und organisierte die berüchtigte Hexenjagd.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Ich hasse es, mit solch abergläubischen Gruppen zu tun zu haben.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ich hatte ursprünglich vor, Elluka in einer Kindertagesstätte in New Opulentia... unterzubringen.\\nAber unter den gegebenen Umständen kann ich sie nicht einfach gehen lassen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Sie müssen andere Pläne haben. Du solltest besser keine seltsamen Nachforschungen über sie anstellen ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Bin ich in deinen Augen so schlecht?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru haut mir um den Kopf. \\nElluka schmollt und starrt Mariru wütend an.")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Ziel identifiziert. Bedrohungseinstufung, extrem hoch.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("… Kleine Göre.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, Elluka, welche Aufgabe hat dir Jacob gegeben?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka runzelt die Stirn und erinnert sich langsam an ihre Aufgabe –")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Töte zuerst die Hexen. Vollendet. \\nZweitens besorgen Sie sich das Manuskript. Fehlgeschlagen.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Das Manuskript? Ist Lian nicht derjenige, der es hat?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Suche... Statusausnahme. \\nManuskript… verbraucht.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Verbraucht? Du meinst, die Seiten sind jetzt in dir?\\nOder waren sie die ganze Zeit Teil von Ellukas Zauberbuch?", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Ihr Administrator ließ nicht zu, dass Sie sie absorbieren...\\nHatte er Angst, Sie würden zu mächtig werden, als dass er sie kontrollieren könnte?", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Das ist eine ganze Geschichte aus nur ein paar ihrer Worte, Lian. Gut gemacht!", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Warte, Ellukas Grimoire. \\nDas bedeutet…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Dieses kleine Kind ist auch eine Hexe?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru versucht ihr in die Wange zu kneifen, aber Elluka weicht ihm geschickt aus.")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("Ich habe schon lange gehört, dass einige Gruppen versuchen, Hexen zu erschaffen und zu kontrollieren. Es gibt keinen Mangel an Karrieristen, die sich unbedingt Supersoldaten wünschen!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Woher weißt ihr zwei so viel über Hexen...? Ich bin hier der Einzige, der im Dunkeln tappt. Sag mir – wie wird ein Mädchen zur Hexe?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Äh, zuerst war ich mir auch nicht sicher. Ich erinnere mich, dass ich dieses Buch gelesen habe, ohne zu wissen, was es war.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mir wurde schwindelig, je schwieriger der Inhalt wurde. Dann hatte ich irgendwann das Gefühl, als ob eine unbekannte Kraft einfach in meinen Körper eindrang.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Eines Tages sprach ich einen Zauberspruch aus dem Buch aus und wurde in eine andere Raumzeit gezogen ...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Raumzeit… Laut Satellitendaten hatte der Raumzeitfluss bereits aufgehört, als Sie am Umspannwerk ankamen.", "Mariru")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Kein Wunder, dass ich nicht das gleiche Gefühl hatte wie in anderen Flux Areas!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Was Sie als Flux Area bezeichnen, wird in der alten Hexenliteratur als „Hexenkokon“ bezeichnet.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("Es entsteht, wenn sich ein Mensch in eine Hexe verwandelt. Außenstehende können es weder durchbrechen noch betreten. Es ist von Natur aus einem von Substance H erzeugten Raum sehr ähnlich, würden Sie nicht sagen?", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Und fast in dem Moment, als der Fluss verschwand, entdeckte unser Satellit optische Signale –", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Ich meine, die Jungs, gegen die du gekämpft hast, sind aufgetaucht.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Denken Sie darüber nach – „Witch’s Cocoon“ … In dem Moment, als der Kokon verschwand, kamen diese Jungs heraus. Es ist, als wären sie aus dem Kokon geschlüpft.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Hexe, beende!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Hexen haben also tatsächlich den Verstand verloren, weil sie die Informationen im Zauberbuch nicht ertragen können!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Es waren ganz normale Mädchen. Sie konnten die magische Kraft, die von den Drehbüchern ausging, nicht ertragen und waren verletzt.", "Annie")
	await novel_interface.show_dialog("In dem Moment, in dem sie eine heftige räumliche Verzerrung auslösten, wurden sie zu...\\nDie monströsen Wesen, die die Leute „Hexen“ nennen.", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("In vielen alten Büchern heißt es, je mehr Informationen man über magische Kräfte weiß, desto leichter erleidet man irreversiblen Wahnsinn.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Wenn ihr Verstand verloren geht, können die Hexen große Katastrophen anrichten. Wenn das wahr ist ...", "Mariru")
	await novel_interface.show_dialog("Dann könnte dies ein Grund dafür sein, dass die Hexenjagd in Europa so lange andauerte.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Mist. Klingt nach einer Pandemie.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("Soweit wir wissen, hat der Administrator von Elluka der Hexenjagd Priorität eingeräumt, um die Grimoire-Fragmente zu bergen.", "Mariru")
	await novel_interface.show_dialog("Aber er hat Elluka nicht erlaubt, das Zauberbuch zu benutzen ... Vielleicht möchte er damit noch mehr Hexen erschaffen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Aber ich habe das Grimoire von Elluka gelesen und kein einziges Wort erkannt. Hat das etwas damit zu tun, dass ich ein Junge bin?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("… Junge?", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka sieht nervös aus und tritt mit verwirrtem Gesicht zurück.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Äh, Elluka, das erkläre ich später. \\nKeine Sorge ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("Aber ich konnte es lesen. Vielleicht ist Lian also doch wirklich nur ein Idiot?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ich bin eher neugierig, wie man den Kokon der Hexe leicht betreten kann.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Ich habe nicht danach gefragt! Jedes Mal, wenn ich das Gebiet betrete, ist da immer jemand, der mich töten will ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—Was Sie getan haben, bestand darin, mehrere Dimensionen zu durchqueren. Die Wissenschaft kann dies derzeit nicht erklären.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wenn die Wissenschaft hier irgendetwas erklären kann, möchte ich als Erstes wissen, warum ich mich in ein Mädchen verwandelt habe!")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Hihi, legen Sie es einfach beiseite. Jede Frage wird früher oder später gelöst!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Das ist positives Denken ...", "Lian")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
