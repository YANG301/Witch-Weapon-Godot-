# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Suspiro... Esta falda todavía es demasiado corta...\nSe siente fría debajo...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Han sucedido demasiadas cosas increíbles estos últimos días.\nMi cerebro apenas puede seguir el ritmo...", "Lian")
	await novel_interface.show_dialog("El sueño de la ciudad destruida, despertarme una mañana y descubrir que me había convertido en una niña y ser atacada por un enemigo completamente inexplicable...", "Lian")
	await novel_interface.show_dialog("Nada de esto parece real en absoluto.\nY además de eso...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, pasa.", "Profesor titular")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("¡Ah, sí!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-¡Encantado de conocerte por primera vez!\nHola a todos, mi nombre es Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Estoy muy feliz de ser compañeros de clase con todos ustedes, así que cuídenme de ahora en adelante...\n...", "Lian")
	await novel_interface.show_dialog("(...Aunque me estoy convirtiendo en tu compañera de clase en la forma de una estudiante de secundaria, me guste o no...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Por favor, perdóname...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Muy bien, entonces, Lian, toma el asiento vacío en la última fila.", "Profesor titular")
	await novel_interface.show_dialog("(...¿Un estudiante transferido a estas alturas del semestre? Eso es inusual.)", "compañero de clase a")
	await novel_interface.show_dialog("(...Ella sigue mirando al suelo. Apuesto a que está muy callada, ¿eh?)", "Compañero B")
	await novel_interface.show_dialog("(...Pero ella es muy linda... ¿Ese color de cabello está teñido?)", "compañero de clase a")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Todos me miran...\nUf... el camino por delante va a ser difícil...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uf, las clases finalmente terminaron... La vida escolar nunca solía ser tan agotadora.\nUna escuela de alto rendimiento realmente es diferente después de todo...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Mierda... Necesito usar el baño...)", "Lian")
	await novel_interface.show_dialog("(¡N-De ninguna manera, no puedo ir al baño de niñas en la escuela...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Uf, ¿qué se supone que debo hacer...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("¿Qué pasa? ¿Por qué suspiras tanto?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("¿Eh? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Entonces? ¿Te estás adaptando bien a la nueva escuela? Hay muchas chicas muy lindas aquí~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uf... no hablemos de eso ahora.\n¡¿Ya terminó tu formación de conocimientos básicos?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Jeje, ¡vine tan pronto como pasé la evaluación! Si te dejara aquí sola, quién sabe qué podría pasarte.", "Annie")
	await novel_interface.show_dialog("Afortunadamente, no estuve fuera por mucho tiempo y New Opulentia ahora es una ciudad de inmigrantes, por lo que probablemente no me resultará muy difícil adaptarme.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("La señorita Mariru también me pidió que cuidara de ti~\nElla específicamente hizo arreglos para que estuviéramos en la misma clase.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Soy una madre adulta—\nDe todos modos, no necesito que nadie me cuide~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Jeje, además me siento mucho más a gusto cuando estoy a tu lado también...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Escuché que te ofreciste como voluntario para unirte a SID junto conmigo.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie parecía agradecido. Por un momento me quedé sin palabras y no tenía idea de si realmente podría pasar las pruebas sin problemas...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, claro, la enfermera de la escuela me pidió que le pasara un mensaje. Quiere que vayas a verla para un examen físico.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("¿¡Un examen físico!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Somos estudiantes transferidos, por lo que la escuela tiene que hacernos chequeos por separado~\n¿O estás molesto por no haberlo hecho junto con toda la clase...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("¡¡Por supuesto que no!!\nLo entiendo, pero antes de eso...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Mmm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Sala de descanso......)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("No puedo oírte... Dilo más fuerte~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Um, ¿podrías llevarme al baño...?", "Lian")
	await novel_interface.show_dialog("Si entro solo... Me sentiría demasiado culpable. No me atrevo a entrar solo...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nY después de que dijiste que no necesitabas que nadie te cuidara~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Muy bien ya... date prisa...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...Sobre el examen físico...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...El hecho de que solía ser un niño no quedará expuesto, ¿verdad?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(¿Qué revisan nuevamente durante un examen físico?)", "Lian")
	await novel_interface.show_dialog("(Y espera... ¿tengo que quitarme la ropa?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Menos mal que no me dio pereza y hoy me puse la ropa interior...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(La enfermería... ¿está aquí?)", "Lian")
	await novel_interface.show_dialog("Disculpe, soy el estudiante transferido aquí para el examen físico...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Momento perfecto. Te he estado esperando.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("¿A-A-A-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, no, ¿por qué eres tú el que hace el examen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("¿Eh???\nAi, ¡¡detente, detén eso——!!", "Lian")
	await novel_interface.show_dialog("Espera... ¿Qué es ese extraño instrumento que estás sosteniendo?", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¡¡¡Waahhhh——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uf... ¿por qué está pasando esto?...", "Lian")
	await novel_interface.show_dialog("Podrían haberse saltado todas estas cosas y aquellas, ¿no?...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Estás exagerando demasiado.\nEs sólo un examen de rutina, rutina~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... La visión en ambos ojos es 2.0. Eso es absolutamente perfecto.\n¿Ha cambiado eso con respecto a tus datos anteriores?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh? Mi ojo izquierdo solía ser 1.0 y el derecho 0.7.\nEl médico incluso me dijo que me sentara más lejos cuando jugaba...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Qué fascinante... Tu cuerpo parece haber sido reconstruido desde cero, hasta los huesos.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Y, sin embargo, la topología neuronal de su cerebro exhibe simultáneamente rasgos de ambos sexos, razón por la cual sus recuerdos y patrones de pensamiento se conservaron... ¿es así?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai sonaba casi lo suficientemente emocionado como para temblar.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Si ese es el caso... entonces, en teoría, también deberías ser consciente de que te estás volviendo más sensible a las emociones de otras personas.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-De ninguna manera...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Absolutamente no! ¡Soy cien por ciento hombre!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("De todos modos, desde un punto de vista médico, eres cien por ciento mujer sin lugar a dudas.\nTu salud está perfectamente bien, excepto por una cosa...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("¿Excepto por qué?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Al poco tiempo, experimentará un ataque de dolor abdominal. Aparte de eso, no hay ningún problema ~\nDebería llegar pronto, así que asegúrate de estar preparado.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Dolor de estómago...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... ¿Quéeee——???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Uf... Ai, ¡¡tú!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Me sentí tan agraviado e impotente que estuve al borde de las lágrimas...\nUf, se supone que debo ser un hombre, ¡¡no llores!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, esto realmente es perfecto... Es raro ver a alguien de tu edad sin una sola cicatriz en alguna parte de su cuerpo.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("¡¡Eso no me hace nada feliz!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Um... ¿puedo volver ahora...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai se quitó la bata blanca de laboratorio, puso una expresión que decía \"ahora me estoy poniendo serio\" y sacó dos conjuntos del armario...")
	await novel_interface.show_dialog("¿De qué estás hablando?\nLa parte divertida apenas comienza...", "Ai")
	await novel_interface.show_dialog("Mariru ya lo aprobó, así que puedo tener Lian probarme todo tipo de ropa diferente...", "Ai")
	await novel_interface.show_dialog("¿E-Eh—?", "Lian")
	await novel_interface.show_dialog("Y luego... jejejeje, también voy a estudiar cada uno de los puntos de datos de Lian.", "Ai")
	await novel_interface.show_dialog("¡Aaaahhhhhhhhhhhh~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
