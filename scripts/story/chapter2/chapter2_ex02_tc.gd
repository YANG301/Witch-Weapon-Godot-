# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("在大廳角落的鏡子前面，看著鏡中的自己，\\n稍微被淚水浸濕的長睫毛隨著呼吸起伏……")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("已經完全……是女孩子的樣子了嗎？", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("（下面……空蕩蕩的，什麼都沒有了……）", "小憐")
	await novel_interface.show_dialog("（這樣的話……）", "小憐")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("（我，要怎麼……上廁所啊……）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（摸……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("妳在做什麼？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("哇———哇———！！！", "小憐")
	await novel_interface.show_dialog("沒有啦……我，欸，這個！ ！\\n對不起！ ！我並不是在做奇怪的事情……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("哈哈哈，為什麼要向我道歉呢？ \\n難不成……啊！ 剛剛妳正準備對自己的身體……", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("（怎、怎麼辦？ ？）", "小憐")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("不是啦！ 莉琉……那個……", "小憐")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("女、女孩子要……", "小憐")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("要什麼啊？ 拜託別人的時候要把事情說得清清楚楚才行！", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("……要怎麼上廁所啊！ ？", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哈——？！", "莉琉")
	await novel_interface.show_dialog("啊哈哈哈哈哈～～", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("（我居然真的問出來了！ ！又要被取笑了……）", "小憐")
	await novel_interface.show_dialog("（但我好像……快要忍不住了……）", "小憐")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("不、不要笑了啦！ ！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嘛……像平常那樣坐下去就好了。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("女廁就在走廊那邊，快去吧！ ！", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("噗，這小鬼居然在女廁前面糾結……\\n最後還是閃著淚花著跑進去了嘛～", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("真是……太可愛了啊啊啊啊啊！ ！", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("………\\n嘩——（沖水的聲音）")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("啊——總算～呼～", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("欸，等……怎麼……", "小憐")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("顛…顛幾下…？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("………………")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("回來了？ 感覺如何？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("這種事情就不要問我感想了，拜託！ ！！", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（怪不得之前經常聽說女廁很容易沒衛生紙……）", "小憐")
	await novel_interface.show_dialog("嗚嗚嗚……\\n真是太尷尬了……", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("可悲可悲可惡！！\n我一定！一定要儘快變回去！！", "小憐")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
