# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Я смотрю на себя в зеркало в углу зала. \\nМоя заплаканная ресница двигается вверх и вниз, пока я дышу.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Действительно... я теперь девочка?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Там внизу... Его больше нет...)", "Lian")
	await novel_interface.show_dialog("(В данном случае...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Как... как бы я отлил...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Рыбалка вокруг...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Что ты делаешь?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ваааа!!", "Lian")
	await novel_interface.show_dialog("Это не... Хм... \\nИзвините!! Я не хотел...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Хаха. Извините за что? \\nЗа то, что прикоснулся к себе?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(Что... что я могу сделать?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Хм...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Как девочки... как они…", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что? Чего ты хочешь от меня? Пожалуйста, будьте конкретны.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Как они пользуются ванной?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А?!", "Mariru")
	await novel_interface.show_dialog("Ха-ха-ха…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Наконец-то я говорю это вслух! Больше не смейтесь надо мной...)", "Lian")
	await novel_interface.show_dialog("(Но, кажется, я больше не могу сдерживаться...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Эй… не смейся надо мной!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Просто садись и делай работу. Вот так просто.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Туалет для девочек находится дальше по коридору. Двигаться!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Пффф. Он на мгновение заколебался... \\nИ в конце концов прибежал со слезами.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Так... мило!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (промывка водой)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ах. Наконец расслабьтесь.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Подождите... Как...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Как мне избавиться от этого?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Готово? Как вы к этому относитесь?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("Это личное дело!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Неудивительно, что я слышал, что в ванной для девочек часто заканчивается туалетная бумага...)", "Lian")
	await novel_interface.show_dialog("Ваааа... \\nКак неловко...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Черт возьми!! \\nЯ должен вернуться к прежнему себе! Не могу дождаться!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
