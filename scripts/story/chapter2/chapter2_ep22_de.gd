# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Moment, wo ist das Papier, das Sie gerade gesammelt haben?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Ugh... Die Zeitung. Ich wollte dir davon erzählen.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich übergebe die Seiten, die ich auf dem Schlachtfeld gefunden habe, an Annie. Elluka beißt sich auf die Zunge.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Das Wardenclyffe-Manuskript… Wunderbar! Ich kann nicht glauben, dass Sie diese gefunden haben!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Sie sind vorhin von diesen Jungs abgefallen. Es fühlt sich einfach nicht richtig an... Annie, kannst du sie vorlesen?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ähm ... Die Linien sind verschwommen, aber ich kann die Magie spüren, die durch sie fließt.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Das Grimoire … Grimoire-Fragmente, genauer gesagt.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimoire ... Hat es etwas mit den Hexen zu tun?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Eigentlich ist es ein Buch über Hexerei. Das erste Drehbuch dieser Art, das ich je gesehen habe, ist eine Broschüre, die aus dem Nichts kommt.", "Annie")
	await novel_interface.show_dialog("Wenn ich mich richtig erinnere, trägt die Broschüre den Titel Mystical Trajectory. Es ist einfach wie aus dem Nichts in meinem Spind aufgetaucht.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Zuerst dachte ich, es wäre der Trainer, der es mir gegeben hat. Die darin enthaltene Hexerei war super seltsam, als würde man einem beibringen, wie man Flugbahnen ändert.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Aber später stellte ich fest, dass der Trainer nichts davon wusste. Ich dachte, es wäre eine Art Aberglaube, also habe ich es nie benutzt.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Erst…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es scheint, dass Annie mit der Erinnerung an die Vergangenheit fertig ist. Sie senkt den Kopf und liest die Skripte sorgfältig durch.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Ich erinnere mich, dass Mariru gesagt hat, dass Hexen Menschen sind, die aufgrund der Informationskontamination bestimmte Substance H Eigenschaften erhalten.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Kontamination ... ganz sicher. Ich würde sagen, es ist sehr auf den Punkt gebracht. Manche „Informationen“ lassen sich kaum noch löschen, wenn man sie einmal in die Hände bekommt.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wie diese Ohrwürmer und Autotune-Remixe? Ich habe eine Million Mal versucht, sie loszuwerden, bin aber immer gescheitert. Manchmal kann ich einfach nicht anders, als die Melodien zu summen, wenn ich geistesabwesend bin ...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ha. Gut gesagt, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vielleicht haben diese Papiere den Raumzeitfluss verursacht? \\nAber… wie ist das überhaupt möglich?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Es ist sehr wahrscheinlich. Solche Informationen können viel Energie kosten, was selbst für mich zu viel ist.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Deshalb benötigen wir bestimmte „Gegenstände“, um die Hexerei zu befreien, damit sie die Kosten für uns tragen können.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie zeigt auf ihren Baseballschläger. Vielleicht verbrauchen manche Waffen deshalb magische Kraft ...")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Wenn es zu einer Informationsüberflutung kommt, können Menschen den Verstand verlieren und völlig verrückt werden …", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Verrückte... Hexen... \\nMüssen... vernichtet werden.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Hexen sind also die Unglücklichen, oder? \\nAnnie, du weißt eine Menge.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Nein ... \\nIch mache nur Annahmen, die auf meinen eigenen Erfahrungen basieren.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manuskript…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka scheint in Gedanken versunken zu sein, ihr Gesicht strahlt voller Vorfreude.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hä? Was? Du willst sie sehen, Elluka?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka schaut mich sehnsüchtig an, wie ein kleines bettelndes Haustier, ihre Augen sind voller Tränen.")
	await novel_interface.show_text_only("Ich kann sie nicht ablehnen, aber diese Drehbücher sind zu gefährlich ...")
	await novel_interface.show_text_only("Während ich noch zögerte, näherte sich das Poltern eines landenden Transportflugzeugs.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Es kommt jemand!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID Offizier? Großartig, wir haben ein... \\nWas?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Überraschenderweise ist die Person, die das Flugzeug verlässt, kein Agent.")
	await novel_interface.show_text_only("Der Mann mit der Brille schaut Elluka zärtlich an, aber sie zittert vor Angst.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, du hast mich zu lange warten lassen.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Administrator... Es tut mir leid.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hast du das Manuskript? \\nDu kannst sie nicht alleine bewältigen – das habe ich dir gesagt. Bring sie mir jetzt.", "Administrator")
	await novel_interface.show_dialog("Nur nutzloser Müll würde mich bei einer so kleinen Aufgabe im Stich lassen, oder?", "Administrator")
	await novel_interface.show_dialog("Räumen Sie dieses Chaos auf und kommen Sie dann mit mir nach Oligar. Es wartet noch ein weiterer Job auf Sie.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Whoa, whoa, whoa, pass auf deine Sprache auf! Kannst du nicht sehen, dass sie verletzt ist?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Sie ist nur ein kleines Mädchen, kein Werkzeug, das du besitzt!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Fremde scheint mich bisher nicht bemerkt zu haben. Er mustert mich mit einem seltsamen Lächeln, wie ein Raubtier, das seine Beute inspiziert.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, nimm sie mit.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hä?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Über meinem toten Körper. Niemand kann Lian ertragen, solange ich hier bin.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Nimm sie...?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ja, das ist ein Befehl.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bestellen…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka starrt mich ganz ausdruckslos an. Sie scheint sich in einem inneren Kampf zu befinden, doch Ungehorsam gegenüber dem Administrator ist keine Option.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Aufgabe: Lian wegnehmen. \\nZiel gesperrt…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
