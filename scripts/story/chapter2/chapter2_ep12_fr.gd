# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Après avoir terminé toute une série de procédures d'inscription à la formation des SID cadets, on m'a remis une épaisse pile de « manuels ».")
	await novel_interface.show_text_only("Puis, sous la direction d'un membre du personnel, j'ai pris un petit ascenseur discret pour monter depuis le quartier général de SID.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("L'ascenseur est monté assez vite pour que je puisse clairement sentir la pression monter dans mes oreilles.\nAu moment où j'ai atteint la surface, j'ai réalisé que c'était déjà le soir...")
	await novel_interface.show_text_only("L'ascenseur donnait sur le hall d'un petit immeuble de bureaux, et juste à l'extérieur se trouvait le quartier commercial bondé.")
	await novel_interface.show_text_only("J'ai entendu dire que l'ascenseur ne peut descendre vers les niveaux plus profonds que lorsqu'il reconnaît que chaque passager est un personnel autorisé. Sinon, il circule uniquement entre le premier et le troisième étage de l'immeuble de bureaux.") #换行问题
	await novel_interface.show_text_only("Au deuxième étage du bâtiment se trouvait un café ouvert 24h/24 avec des gens qui allaient et venaient toute la journée, parfait pour se cacher à la vue de tous.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Soupir...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Je pensais que la formation des agents impliquerait des choses comme le combat au corps à corps et le tir, mais cela donne plutôt l'impression que je me suis inscrit à un programme complet de cours de rattrapage...", "Lian")
	await novel_interface.show_dialog("Ces livres sont vraiment lourds !\nC'est une bonne chose que l'endroit que Mariru m'ait réservé ne soit pas loin d'ici.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Academy District East Road No. 6... Elle a dit que c'était un endroit très discret...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("— En quoi est-ce discret ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me trouvais dans une résidence de luxe au dernier étage d'un immeuble. Le somptueux salon relié à une terrasse géante donnant sur la vue nocturne du quartier commercial.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Ces flammes le long du mur sont-elles une véritable cheminée ?\nC'est beaucoup trop exagéré...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que je regardais prudemment autour de moi et me demandais si je m'étais trompé de pièce, j'ai reçu un message de Mariru.")
	await novel_interface.show_text_only("Mariru : Choisissez la chambre que vous aimez.\nPas besoin d'être poli avec le budget du Sénat~") #原文有个♥
	await novel_interface.show_text_only("Cette femme... Excusez-vous immédiatement auprès des contribuables de New Opulentia !!")
	await novel_interface.show_dialog("Lian, vous êtes de retour !", "Annie")
	await novel_interface.show_text_only("Annie sortit de la salle de bain, une main rassemblant ses cheveux tout en marchant.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! Vous êtes ici aussi ?\nMariru a dit que vous veniez de suivre un entraînement spécial à l'instant...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("J'ai terminé la formation plus tôt que prévu. Je viens de prendre une douche et j'ai essayé l'uniforme scolaire.\nOn dirait que nous allons être colocataires~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Right...\n(On dirait que Mariru a mentionné que...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(Est-ce une sorte de test venu du ciel ?)\n(Vivre sous le même toit qu'une fille et tout...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Est-ce que c'est l'uniforme de cette école ? C'est vraiment mignon~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Mm-hm~ Les vêtements qu'ils ont préparés pour toi sont dans cette boîte là-bas. Tu devrais les essayer aussi !", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Je-je dois en porter un aussi... ?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Héhé, Lian, tu n'es toujours pas habituée à être une fille ?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dès qu'elle en a parlé, je n'ai pas pu m'empêcher de me gratter la tête et de m'effondrer sur le canapé.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Comment quelqu'un pourrait-il s'habituer à quelque chose comme ça ?...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Personne ne pourrait comprendre à quoi cela ressemble.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Je comprends.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie s'est soudainement assise à côté de moi et m'a légèrement effleuré la joue du bout du doigt, comme pour me réconforter.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Parce que nous sommes pareils.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il y avait une légère amertume dans son sourire.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("W-Quoi—?!\nTu étais aussi un garçon avant ?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ahahahahaha ! Lian, es-tu un idiot ?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("J'ai toujours été une fille~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agh...\n(C'est mortifiant !!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Juste au moment où mon embarras était sur le point d'atteindre son paroxysme, Annie arrêta de rire et me regarda doucement.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("Mais la panique dans votre cœur en ce moment..., je la comprends vraiment parfaitement.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("Avant, j'étais aussi piégé dans un autre espace-temps....\nCe sentiment ressemblait probablement un peu à ce que vous vivez maintenant.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Un autre... espace-temps ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie fit une pause, comme si elle réfléchissait soigneusement à la façon de le formuler.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Miss Mariru ne vous l'a pas dit ?\nJ'ai passé très longtemps à dériver dans un autre espace-temps sans vraiment rien comprendre...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Le temps y semblait vague. Cela ne m'a pas semblé si long, mais à mon retour, j'ai réalisé que sept ans s'étaient déjà écoulés.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mm, j'en ai entendu parler un tout petit peu...", "Lian")
	await novel_interface.show_dialog("(Bien que ce ne soit que quelques indices épars que Mariru a laissé tomber...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Que lui est-il arrivé exactement ?\nDois-je lui demander directement ?")
	await novel_interface.show_text_only("Annie n'a pas continué. Elle baissa simplement la tête et joua distraitement avec ses doigts.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... avez-vous déjà ressenti cela aussi—", "Annie")
	await novel_interface.show_dialog("Comme si tout cela n'était peut-être qu'un rêve, et que la prochaine fois que vous ouvrirez les yeux, vous vous réveillerez enfin.", "Annie")
	await novel_interface.show_dialog("Ce n’est pas ainsi que les choses étaient censées se passer. Vous n'êtes pas censé être ici...\nMais quoi que vous fassiez, vous ne pouvez pas revenir sur la voie normale.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Alors Annie est arrivée jusqu'ici en portant des sentiments comme ça toute seule... ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me suis rapproché un peu de Annie et je lui ai doucement tapoté l'épaule.\nEuh, réconforter une fille comme celle-ci... devrait être bien, non ?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("N'ayez pas peur. Tu es de retour maintenant, n'est-ce pas~", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Mm...\nMais tout me semble encore si inconnu...", "Annie")
	await novel_interface.show_dialog("Je n’ai même pas la moindre idée de ce que vous entendez tous par « ville universitaire ».", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... C'est vrai. La guerre n'était même pas encore terminée lorsque Annie a disparu.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Cela signifie donc que vous ne savez toujours pas ce qui s’est passé ces dernières années, n’est-ce pas ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("J'ai seulement fait des recherches grossières.... Il s'est passé tellement de choses au fil des années que je ne comprends même plus ce que beaucoup de mots dans l'actualité sont censés signifier.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Il y a sept ans...\nC'était en plein milieu de la guerre qui a plongé le monde entier dans le chaos.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hein ? La guerre ?\nVoulez-vous parler de la campagne militaire que Masada Fort a lancée contre l'Europe ?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie s'est efforcé de se souvenir.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non, pas celui-là. Peu de temps après, presque tous les pays s’y sont retrouvés entraînés.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("À l’époque, j’étais à l’école primaire dans un internat. Chaque jour, les informations étaient remplies de rapports de guerre et de décomptes de victimes. C'était une période assez horrible...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, avez-vous aussi vécu la guerre ?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pas exactement. Grâce à la protection de Aegis, New Opulentia concentrait alors tous ses efforts sur la reconstruction à côté des ruines.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("J'ai regardé le paysage nocturne prospère de la ville au-delà de la fenêtre.... Quand j'étais petite, la ville était pleine de grues géantes et d'engins de construction occupés partout.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La plupart de ce que je sais vient donc des manuels.", "Lian")
	await novel_interface.show_dialog("Grâce à la guerre, la technologie miracle a progressé rapidement...\nEt par « miracle », j'entends les phénomènes provoqués par Substance H.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Après la guerre, les six pays qui maîtrisaient les technologies clés ont chacun créé l'une des six villes universitaires du monde.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(J'ai l'impression d'avoir soudainement éveillé un talent caché pour être professeur d'histoire...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Donc tout cela s'est réellement passé... Je ne peux même pas l'imaginer.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh bien, quand Annie est parti – euh, a disparu – le monde était encore relativement paisible, n'est-ce pas ... ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("C'est vrai. À l’époque, je pouvais encore participer à des matchs internationaux de baseball !", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Au moment où Annie a évoqué le baseball, ses yeux ont commencé à briller.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Vous savez, Lian, à chaque fois que c'était mon tour de jouer au bâton, tous les yeux des spectateurs se concentraient sur moi seul !", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Ce mélange de tension et de devoir tout donner ferait bouillir le sang dans tout mon corps !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lorsque le baseball a été évoqué, j'ai soudainement pensé au monument en pierre noire situé à l'extérieur du stade de baseball de Lebona, gravé des noms de dizaines de milliers de morts.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("En fait...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Hein ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Peut-être que rater les pires années de la guerre était une bonne chose pour vous après tout.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Quand j'y pense de cette façon, peut-être que devenir une fille et te rencontrer\nn'était pas entièrement une mauvaise chose non plus... dans un sens ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie se figea. Pendant un instant, elle eut presque l'air embarrassée....\nOu est-ce que je l'imaginais ?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... En fait, j'avais envie de te remercier tout ce temps.\nParce que... c'est toi qui m'as sauvé de l'errance dans ce monde.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Hein ? Mais je n'ai rien fait...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est exactement pourquoi tu dois être spécial ~", "Annie")
	await novel_interface.show_dialog("Je ne sais toujours pas comment tu as fait, mais à ce moment-là, j'ai senti ta main chaude me tirer.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie m'a doucement pris la main et s'est enfoncée dans ses souvenirs.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sans toi, je ne sais pas combien de temps je serais resté coincé là-bas, ni ce que je serais devenu à la fin...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Devenir... quoi ?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahaha~ Ce n'est rien. Tout cela appartient au passé maintenant.\nJe me sens soudain un peu somnolent~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie semblait vouloir esquiver le sujet.\nElle s'étira paresseusement, toujours souriante.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Combien de temps comptez-vous continuer cette soirée entre filles ?", "Mariru")
	await novel_interface.show_text_only("La voix de Mariru sortit soudainement du haut-parleur dans le coin de la pièce.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("M-Mariru?!\nVous écoutiez tout à l'heure ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Quoi ? Y a-t-il quelque chose de mal à ce qu'un tuteur surveille l'emploi du temps de quelques enfants ?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Tu as vraiment le culot de dire ça...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Tu réponds aussi ?\nOn dirait que je vais devoir t'entraîner encore plus dur demain...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("Je suis désolé ! Je vais prendre un bain et aller me coucher tout de suite !\nBonne nuit !!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
