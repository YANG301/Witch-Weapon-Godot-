# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("ใช่… ฉันก็สับสนเช่นกันเพราะมันให้ความรู้สึกเหมือนจริงมาก—ไม่เหมือนความฝันใดๆ", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("ฉันค้นหาข่าวไฟไหม้หรือความเสียหายของอาคารแล้ว แต่ไม่มีอะไรเลย \\nเมืองนี้ดูสงบสุขเหมือนเมื่อก่อน", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ยกเว้นสิ่งหนึ่ง…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("อืม?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("ยกเว้นอะไร?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("เมื่อฉันตื่น…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("ฉันพบว่าร่างกายของฉันเปลี่ยนเป็นร่างของผู้หญิง…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("ก็…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("ฮะ? คุณบอกว่า…มันเปลี่ยนไปเหรอ?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันไม่ใช่… ฉันไม่เคยเห็นแบบนี้มาก่อน…", GameConfig.player_name)
	await novel_interface.show_dialog("ฉัน… จริงๆ แล้วฉันเป็นเด็กผู้ชายนะ!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("เอ่อ...เด็กผู้ชายเหรอ?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("โอเค… เดี๋ยวก่อนอะไร?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("คุณหมายถึงคุณเป็นเด็กผู้ชายที่แต่งตัวข้ามเพศเหรอ? (โน้มตัวเข้ามาใกล้)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("ไม่ ไม่… นั่นไม่ใช่สิ่งที่ฉันหมายถึง \\nอย่าเข้ามาใกล้ขนาดนี้!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("แต่... ในแง่หนึ่ง... \\nบางทีคุณอาจพูดถูก...", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("โอ้พระเจ้า… ฉันจะอธิบายเรื่องนี้ได้อย่างไร!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("อย่างไรก็ตาม… คุณมีงานหน้าอกที่ยอดเยี่ยม (สัมผัส)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("เด้งมาก…ไปทำมาจากไหน? สัมผัสที่เป็นธรรมชาติ… (หยิก)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("วู… ฉันก็อยากรู้เหมือนกัน!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("อุ๊ย! ไม่… มันไม่ใช่… รอก่อน… \\nหยุดนั่นสิ!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ขอเช็คหน่อย… แขนเรียว รอบเอวโค้ง เป๊ะมาก", "Mariru")
	await novel_interface.show_dialog("คุณใช้วัสดุอะไร? โดยเฉพาะที่นี่…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("อ่า! คันเลย…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("คุณ Mariru! อย่าแตะต้องที่นี่!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("ไม่…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("บู้…", GameConfig.player_name)
	await novel_interface.show_dialog("เชื่อหรือไม่! ฉันเป็นเด็กจนกระทั่งเมื่อวาน!", GameConfig.player_name)
	await novel_interface.show_dialog("ไม่มีการผ่าตัด…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ใช่แล้ว ไม่ต้องสงสัยเรื่องนี้เลย", "Mariru")
	await novel_interface.show_dialog("การเปลี่ยนแปลงเพศโดยสิ้นเชิงเช่นนี้เป็นไปไม่ได้ด้วยเทคโนโลยีในปัจจุบัน", "Mariru")
	await novel_interface.show_dialog("คุณไม่สามารถทำเช่นนี้ได้เว้นแต่คุณจะเปลี่ยนกระดูกทุกส่วนในร่างกาย \\nซึ่งหมายความว่าคุณเป็นและเคยเป็นผู้หญิงมาก่อน", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อะไรนะ! ฉันบอกคุณแล้ว! \\nฉันตื่นขึ้นมาเป็นเด็กผู้หญิง", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("คุณมีหลักฐานบ้างไหม? \\nมีอะไรพิสูจน์ว่าคุณเคยเป็นเด็กผู้ชายหรือเปล่า?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อืม… พิสูจน์… \\nใช่แล้ว! บัตรประจำตัวนักเรียนของฉัน!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("เรามอบสิ่งของทั้งหมดของฉันเมื่อเข้ามาที่นี่ รวมถึงเสื้อผ้าและบัตรประจำตัวประชาชนด้วย")
	await novel_interface.show_text_only("Mariru แตะอุปกรณ์มือถือของเธอ ซึ่งจะแสดงบัตรนักเรียนของฉันขึ้นมา")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("ใช่แล้ว! แค่นั้นแหละ! \\nดูสิ! นั่นคือข้อพิสูจน์", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("รูปร่างหน้าตาก็ดูคล้ายกับคุณนิดหน่อย แต่นี่ก็แทบจะไม่สามารถพิสูจน์ได้เลย...", "Mariru")
	await novel_interface.show_dialog("เอาล่ะ ดึงภาพทั้งหมดของ"+GameConfig.player_name+"โดยระบบเฝ้าระวังของเมืองเมื่อเดือนที่ผ่านมา...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru แตะแท็บเล็ตของเธออย่างช่ำชอง ดูตื่นเต้นเล็กน้อย")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("ฉันคิดว่ามันเป็นเพียงความฝันเมื่อฉันเห็นซากปรักหักพังเหล่านั้น และฉันคิดว่าทุกอย่างจะกลับมาเป็นปกติหลังจากตื่นนอน", GameConfig.player_name)
	await novel_interface.show_dialog("แต่ตอนนี้ฉันกลายเป็นสาวแล้ว...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("ใช้การแก้ไขการเปลี่ยนแปลงกระดูก เปิดใช้งานการวิเคราะห์การเดินในวิดีโอของคุณที่ทางเดินตอนนี้...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ไม่สนใจเสียงพึมพำของฉันและมุ่งความสนใจไปที่แท็บเล็ตของเธอ")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("บางทีมันอาจจะไม่ใช่ความฝัน แต่ตอนนี้ทุกอย่างดูเรียบร้อยดี ไม่มีไฟไม่มีการทำลาย", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("เอ่อ… ฉันสับสนไปหมดแล้ว…!", GameConfig.player_name)
	await novel_interface.show_dialog("ส่วนไหนในความทรงจำของฉันที่เป็นเรื่องจริง และส่วนไหนเป็นเพียงความฝัน…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… รูปแบบการเดินตรงกัน", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("นั่นหมายความว่าอย่างไร?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("รูปแบบการเดินเป็นรูปแบบการควบคุมกล้ามเนื้อของบุคคลเมื่อเดิน แม้แต่ตัวแทนที่ดีที่สุดก็ไม่สามารถปกปิดมันได้", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("แม้ว่าวิทยาศาสตร์ในปัจจุบันจะอธิบายไม่ได้…\nคุณเป็นเช่นนั้นจริงๆ"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("ก…คุณแน่ใจเหรอ…?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("ในที่สุด… ฉันคิดว่าพวกคุณรู้อะไรบางอย่างเกี่ยวกับเรื่องนี้…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("คุณเคยได้ยินเกี่ยวกับ Ross Goblet บ้างไหม?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Substance H ที่จู่ๆ ก็หายไปภายใต้กล้องวงจรปิด ตามข่าวเมื่อเช้านี้... แต่ฉันยังไม่ได้เห็นมันด้วยตัวเองเลย", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("เอ่อ ถ้าจะพูดความจริงล่ะก็...", "Mariru")
	await novel_interface.show_dialog("อาจเป็นเหตุผลเดียวที่ฉันยอมบรรยายที่น่าเบื่อนี้ให้ฟังฟรีๆ", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("มันคือ Substance H ที่พบในหมู่เกาะรอสส์ อัญมณีสี่เม็ดที่มีความบริสุทธิ์โดดเด่นติดตั้งอยู่ด้านนอก", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันได้เห็นบางสิ่งบางอย่างที่ดูเหมือนแก้วที่ส่องแสงลอยอยู่บนท้องฟ้าหลังจากที่ฉันปีนออกมาจากซากปรักหักพัง", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("มันลอยอยู่บนท้องฟ้า เปล่งแสงสีแดงจางๆ…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("แดงจางๆ?", "Mariru")
	await novel_interface.show_dialog("(ของเหลวสีแดงจางๆ ในกุณโฑเป็นเรื่องลึกลับ…)", "Mariru")
	await novel_interface.show_dialog("(แต่ข้อมูลดังกล่าวถูกจัดประเภทไว้ ไม่เคยเปิดเผยต่อสาธารณะ แม้จะเพิ่งได้รับการจัดอันดับว่า 'ปลอดภัย' เมื่อไม่นานมานี้ก็ตาม)", "Mariru")
	await novel_interface.show_dialog("(ไม่มีใครสามารถให้รายละเอียดดังกล่าวได้โดยไม่ต้องเคยเห็นมาก่อน…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("ไม่ว่าจะเป็นความฝัน ฉันเกรงว่าเราต้องยืนยันข้อมูลเพิ่มเติมกับคุณ", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
