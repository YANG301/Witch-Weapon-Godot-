# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("This is what a rich school should be like! \\nLook at these mouthwatering food in the canteen.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Hi! I'd like a curry rice set and three fried chicken wings.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("The prawn cakes look good. I'll have two please.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Are you sure you can finish all these?", "Canteen Staff")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Sure, piece of cake!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hey, look! That girl is eating like a horse.", "Student 1")
	await novel_interface.show_dialog("Unbelievable… Does she always eat that much?", "Student 2")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(… I'm a boy, okay? This is normal.)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("You know, people envy you. \\nYou eat a lot without gaining weight…", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nothing special. \\nHmmmmm! The prawn cakes are so delicious!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Well, Lian…", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What? (Munches) \\nThe curry rice tastes soooo good! (Gulps)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("I love this school! (Slushes)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("You really eat like a horse, do you?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Is she the new transfer student?", "Student 1")
	await novel_interface.show_dialog("Doesn’t look like a girl at all… \\nEww, spreading her legs when sitting. That’s gross!", "Student 2")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… This really sucks.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Boohoo…", "Lian")
	await novel_interface.show_dialog("Well… I'm done eating…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("That’s how much a girl would eat.", "Annie")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I used to be a big eater! \\nI could eat as much as I can and take my time to digest…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha…! Are you really a horse? Why would you do that?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Probably because... I went hungry quite too often when I was a kid.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis can only identify and shield bullets. This means, armed soldiers can easily penetrate its force field.")
	await novel_interface.show_text_only("The force field has a radius of 20 miles, effectively the last ditch for millions of survivors back then.")
	await novel_interface.show_text_only("The war left behind so many orphans. Organizing the defense weighed the Senate down. So, supplies to each nursery school were heavily rationed.")
	await novel_interface.show_text_only("Many kids were starving and had to look for food in the war zone near the boundary. I was one of them…")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("I understand your feelings. Just… don't overeat now.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie may have also lived through those days…")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Hey, let's grab some desserts after school!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("… Okay!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("We rarely have free time to go out like this, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("It's actually my first time to be in this kind of restaurant… \\n(Feeling slightly uneasy with girls all around…)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alright, let’s see… well, I'll have this one! \\nBlueberry Ice Cream Parfait Super Soda Special Drink DX!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("The name sounds really cool!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("You're really a child, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("I'll just have coffee…", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, you're a girl now. \\nDon't you wanna try some desserts? They're very delicious!", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Okay… let me check. \\nEmm… Matcha Napoleon Cheese Muffin… (Not bad.)", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Royal Candied Orange Cream Cake… (Looks yummy too…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Tropical Feast Iced Fruits Sundae… \\n(Gulps)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Excuse me… Have you made up your mind?", "Waiter")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Well… Ummm \\nmaybe… just coffee… thanks…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Alright.", "Waiter")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Well…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Uhh, wait! I changed my mind… \\nA Blueberry Mousse Strawberry Ice Cream Parfait please…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("I just wanna have a taste of it! \\nI only saw girls eat them before…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Aha, no need to explain.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sorry to keep you waiting. Here’s your order.", "Waiter")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Thanks!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Enjoy!", "Waiter")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Okay, ready to go!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Yum… yummy..!!", "Lian")
	await novel_interface.show_dialog("The strawberry smells so fresh. The cream is really sweet. And the blueberry mousse, a bit sour but really tasty…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I feel a bit embarrassed when I find Annie staring at me.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Girls love these desserts. I've always wanted to know \\nhow they taste.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, you're so...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Hmm?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("So lovely!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Wh… what are you talking about…!", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
