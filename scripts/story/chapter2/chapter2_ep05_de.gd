# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Seit heute Morgen haben wir plötzlich mehrere Raumzeit-Phasenfluktuationswarnungen in New Opulentia entdeckt.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Es ist, als wäre über Nacht etwas aufgewacht...", "Mariru")
	await novel_interface.show_dialog("Überwachungssatelliten zeigen, dass Sie innerhalb der Anomaliezone in Luft aufgelöst sind und nicht lange danach auf der anderen Seite wieder aufgetaucht sind – mit jemand anderem an Ihrer Seite.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru richtet ihren Blick auf Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Und genau dort, wo Sie beide auftauchten, verschwand diese Schwankung von selbst.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Die Anomaliezone? Du meinst das Forschungszentrum?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genau.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Könnte es sich um eine Gerätestörung gehandelt haben...? Ich war die ganze Zeit auf der Hauptstraße unterwegs.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Marirus Gesichtsausdruck wird ernst.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Glauben Sie, dass einfach jeder eine Raumzeit-Phasenfluktuationszone betreten und verlassen kann?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Ist diese Schwankungssache... wirklich so gefährlich?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du weißt wirklich nichts, oder?...", "Mariru")
	await novel_interface.show_dialog("Die Raumzeitphase ist die Grundlage des physikalischen Gesetzes – wie das Koordinatensystem des Universums. Egal wie sich die Teilchen bewegen, die Achsen selbst müssen stabil bleiben.", "Mariru")
	await novel_interface.show_dialog("Wenn diese Achsen zu zittern beginnen, und sei es auch nur geringfügig, ist die Ordnung der Teilchen in diesem Raum zerstört.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wenn nur 5 % der Partikel in einem Gebäude zufällig um einen Mikrometer verschoben würden, würde die Materialstruktur völlig zerstört und das Ganze würde sofort zusammenbrechen.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Und dennoch geht es Ihnen vollkommen gut, und die Gebäude in dieser Gegend weisen überhaupt keine strukturellen Schäden auf.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Und laut unserer Forschung zu Divine Touches sollte ein Mensch, der „GHOST“ trägt, nicht einmal in der Lage sein, einen solchen Raum zu betreten.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Mit anderen Worten, Sie sind im Grunde einem Hurrikan der Kategorie 12 ins Auge geraten, der alles auseinanderreißen konnte, unversehrt wieder herausgekommen ist und den Sturm irgendwie beruhigt hat.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Wurden diese Anomalien dann durch die Dinge verursacht, die mich angegriffen haben?\nEs schien, als hätten sie den Verstand verloren...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hören Sie genau dort auf! Ich bin dabei, die Senat— zu informieren.", "Mariru")
	await novel_interface.show_dialog("Einer dieser Verrückten führt gerne eine Live-Lügenerkennungsanalyse im Konferenz-Feed durch, also je weniger ich jetzt weiß, desto besser.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Das ist... eine sehr charakteristische Art, die Senatoren zu beschreiben...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Und ein Mädchen sollte auch wissen, wann es in Ordnung ist zu lügen", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Ich bin kein Mädchen!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Wie auch immer, gut, ich werde nichts sagen...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("In den letzten Jahren wurden weltweit nur vier Fälle dieser Art von Raumzeitfluktuation registriert.\nDie meisten davon standen im Zusammenhang mit Eindämmungsfehlern im Zusammenhang mit Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wenn plötzlich eine unbekannte göttliche Berührung aktiviert wird, können die Folgen katastrophal sein.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Werden Menschen verletzt?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Im schlimmsten Fall erreichte allein die Zahl der Todesopfer Zehntausende.", "Mariru")
	await novel_interface.show_dialog("Aber die großen Akademiestädte hatten immer eine unausgesprochene Vereinbarung, diese Vorfälle als „normale Unfälle“ zu melden...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Gaslecks, Flugzeugabstürze, Terroranschläge und so etwas...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Dann dieses Mal...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Diesmal ist es anders. Wir haben noch nie zuvor kontinuierliche Ausbrüche in diesem Ausmaß gesehen...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Es geht bereits über die höchste Stufe unserer Propagandaszenarien hinaus. Wenn es soweit ist, werden wir nicht einmal in der Lage sein, eine Lüge dafür zu erfinden.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Könnte das an mir liegen?\nWenn ich irgendetwas tun kann, um zu helfen...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Denken Sie nicht zu viel darüber nach. Ihre körperlichen Veränderungen mögen durchaus damit zusammenhängen, aber Sie allein hätten unmöglich eine so große Störung verursachen können.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Wenn Sie nach Hinweisen suchen möchten, können Sie sich mit meinen Leuten den Tatort ansehen.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Wenn diese Möglichkeit real ist, dann ist sie im Moment die einzige Antwort, die wir haben...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Aber Sie dürfen sich auf keinen Fall überfordern und niemandem etwas über sich erzählen. Verstanden?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Erzähl es niemandem... Bedeutet das also, dass ich so tun muss, als wäre ich schon immer ein Mädchen gewesen?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das wissen Sie doch schon, nicht wahr...?\nNew Opulentia hat immer nach der Doktrin der Wissenschaft regiert, die über allem anderen steht.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Wenn Sie Ihre Erfahrung veröffentlichen, werden Sie als „experimentelles Subjekt“ eingestuft und an eine Forschungseinrichtung verschleppt", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Dann hätten Sie wahrscheinlich eine ganze Reihe von Männern mittleren Alters, die ihr Leben der Wissenschaft geschworen haben und darauf warten, Ihren Körper zu studieren...", "Mariru")
	await novel_interface.show_dialog("Schließlich kommt es nicht jeden Tag vor, dass man ein so süßes Mädchen bekommt –", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...O-okay, ich verstehe!!", GameConfig.player_name)
	await novel_interface.show_dialog("Ich... Ich werde auf keinen Fall etwas Leichtsinniges sagen!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
