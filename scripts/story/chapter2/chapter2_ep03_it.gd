# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("\"Scortati\" dagli agenti, io e Annie siamo saliti su una berlina nera come l'ebano.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("L'abitacolo è soffocante.")
	await novel_interface.show_text_only("Mi stringo le braccia attorno alle ginocchia, sconcertato.")
	await novel_interface.show_text_only("Annie si appoggia delicatamente a me, il che mi fa sentire un po' rilassato.")
	await novel_interface.show_dialog("Quindi... cos'è SID? \\nDiventi nervoso ogni volta che lo senti.", "Annie")
	await novel_interface.show_dialog("Vieni dallo spazio? \\nSID è il dipartimento di intelligence sotto il Senato.", GameConfig.player_name)
	await novel_interface.show_dialog("Alcuni dicono che SID svolge un ruolo più importante del sistema di difesa Aegis nel mantenere New Opulentia neutrale.", GameConfig.player_name)
	await novel_interface.show_dialog("Ma ci sono altre leggende metropolitane su persone prese da SID e non tornano mai più... È semplicemente orribile.", GameConfig.player_name)
	await novel_interface.show_dialog("Ok... Ma allora, cos'è la Città Accademia?", "Annie")
	await novel_interface.show_dialog("(Aspetta... Questa ragazza non ha alcun buon senso? )", GameConfig.player_name)
	await novel_interface.show_text_only("Annie vede il mio sguardo sorpreso... e mi fa un sorriso rilassato.")
	await novel_interface.show_dialog("Rilassati, non avremo problemi!", "Annie")
	await novel_interface.show_dialog("Perché... sei speciale.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("È strano che il divagare di Annie abbia in qualche modo calmato la mia mente agitata.")
	await novel_interface.show_text_only("Non sembra così orribile essere portati via da SID...")
	await novel_interface.show_text_only("(No. No. È orribile!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("Arriviamo nella vivace zona commerciale della città ed entriamo in un normale garage sotterraneo dove saliamo su un ascensore per auto.")
	await novel_interface.show_text_only("Dopo che l'agente ha riferito, l'ascensore inizia a muoversi.")
	await novel_interface.show_text_only("Posso sentire la velocità con cui si muove l'ascensore. Scende più volte per lunghi tratti e ogni tanto si sposta anche lateralmente.")
	await novel_interface.show_dialog("(È difficile immaginare un simile labirinto sotterraneo sotto l'area commerciale...)", GameConfig.player_name)
	await novel_interface.show_text_only("Le voci sul quartier generale del SID abbondano. Alcuni dicono che si trovi nella periferia sud di New Opulentia, e l'intera struttura è rivestita con un camuffamento ottico.")
	await novel_interface.show_text_only("Naturalmente, per un edificio che non esiste ufficialmente nel sistema, i media potrebbero inventare qualsiasi cosa purché attiri clic.")
	await novel_interface.show_text_only("E dove sto entrando è proprio l'area centrale di questo dipartimento “inesistente”.")
	await novel_interface.show_dialog("(Spero solo di non essere reso \"inesistente\" qui...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Scendiamo dall'auto davanti ad un corridoio avvolto da lastre di metallo. Dà un senso di tecnologia e astinenza.")
	await novel_interface.show_text_only("La porta dell'ascensore si chiude automaticamente subito dopo la nostra discesa. Lo sentiamo allontanarsi mentre proseguiamo lungo il corridoio buio. L'aria diventa rigida e triste.")
	await novel_interface.show_text_only("Anche il mio cuore sta sprofondando...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("Percorriamo il corridoio e arriviamo in una stanza luminosa ma chiusa.")
	await novel_interface.show_text_only("Sembra una specie di stanza per gli interrogatori, ma non ci sono tavoli né sedie. Una parete è un'enorme lastra di vetro.")
	await novel_interface.show_text_only("Prima che possa voltarmi per controllare quel muro...")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Whoooa—!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Qualcuno mi mette con forza le braccia intorno alla vita.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Ahi... Fa male!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre sto per perdere l'equilibrio, sento che la mia testa cade su qualcosa di familiare, morbido ma fermo.")
	await novel_interface.show_dialog("Beh... A giudicare dalla tua forza principale, la roba da spia non fa per te.", "Voce femminile")
	await novel_interface.show_dialog("Pensavo che ci fossero degli errori di scansione del corpo, quindi volevo confermarlo personalmente.", "Voce femminile")
	await novel_interface.show_dialog("Mi sento bene però.", "Voce femminile")
	await novel_interface.show_text_only("La voce femminile alle mie spalle mi suona familiare.")
	await novel_interface.show_text_only("Allenta le braccia. Con uno spavento persistente, mi giro. \\nLa donna di fronte a me—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(Eh?! Che-è enorme!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Signora... Signora Mariru!?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("La conosci?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ah? Così veloce da rivelare che puoi identificare agenti di un'altra agenzia di intelligence. \\nSembra che tu non abbia mai pensato di nascondere chi sei...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(Accidenti! Che stupido...)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("È difficile da credere, ma questa donna in uniforme davanti a me è la donna che ho incontrato nel mio sogno.")
	await novel_interface.show_text_only("La figura snella... i capelli rossi... lo sguardo sadico...")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Devi rispondere onestamente alle mie domande adesso.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Non cercare scuse e non fare scherzi.", "Mariru")
	await novel_interface.show_dialog("Sembra che gli interrogatori siano una delle mie specialità. \\nNon andrò piano con quel tuo faccino carino~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("Quell'atteggiamento prepotente e canzonatorio, e quegli occhi sicuri con una punta di scherno...")
	await novel_interface.show_text_only("Qual è il suo nome completo? \\nEsatto, è...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Esattamente. Sono il capo di SID. Il mio nome è Mariru Von Braun.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("E' lei!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Aspetta... il capo di SID? \\nNon era lei il capo scienziato?!")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("Ma guardando da vicino i suoi vestiti e i segni sulle spalle, probabilmente è un grande capo...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Però le sue calze e i tacchi alti sono gli stessi di ieri.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehi, ragazza, cosa stai guardando, eh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Oh! Sì... giusto! \\nMi dispiace, signora!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hai un po' di coraggio e lasci vagare la mente in questo momento.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ho sentito che hai raccontato molte storie orribili su SID a questo codino blu.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru rigira la frusta tra le mani. Mi innervosisco e deglutisco a fatica.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Indovina... \\nQuanti di loro sono veri?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Uh! Mi dispiace tanto!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("B... coda doppia blu...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Ora che conosci la paura, cominciamo con la tua identità.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru apre il suo terminale portatile e immediatamente appare una proiezione sulla parete della stanza degli interrogatori.")
	await novel_interface.show_text_only("Mostra le mie foto scattate da diverse angolazioni dalle telecamere di sorveglianza e il risultato dell'analisi facciale recita:")
	await novel_interface.show_text_only("[Nessuna corrispondenza trovata]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nessun record di arrivo... Aegis non riesce a identificare.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se non fosse per la tua scarsa forma fisica, verresti immediatamente trattato come una spia o un intruso terrorista.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("Mi sento un po' in imbarazzo e inconsciamente mi massaggio la pancia.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", questa signora sembra ancora più spaventosa dei nemici che abbiamo incontrato prima...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Sì... e non avrà problemi a capire le mie bugie...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(Lo confesserò! Accidenti! Qualunque cosa!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", da dove dovrei iniziare...?", GameConfig.player_name)
	await novel_interface.show_dialog("È un po' complicato, a dire il vero. Anch'io sono molto confuso.", GameConfig.player_name)
	await novel_interface.show_dialog("Probabilmente non crederai a quello che dico...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Smettila di divagare. Lo giudicherò da solo!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("… Beh… ho fatto questo sogno.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Nel sogno andavo al Centro Ricerche per assistere a una conferenza per la mia relazione sull'insegnamento all'aperto… E arrivavo poco prima dell'orario di chiusura.", GameConfig.player_name)
	await novel_interface.show_dialog("Ti ho incontrato lì. E hai detto che è stato catturato...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Apparentemente, Mariru lo prende come uno scherzo o qualcosa del genere.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Vuoi dire che mi hai incontrato in un sogno?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì, eri tu. \\nE mi hai trascinato in un angolo...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Oh, giusto... eri uno scienziato di classe SS riconosciuto dal Senato... \\nDr. Mariru Von Braun, giusto?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Sono io.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ma questa informazione non è segreta: chiunque abbia familiarità con New Opulentia lo sa.", "Mariru")
	await novel_interface.show_dialog("... Lascia perdere. \\nAllora cosa è successo dopo?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hai abbattuto uno degli intrusi e hai preso una pistola. Mi hai chiesto di restare e aspettare i soccorsi, e sei andato sul luogo del dirottamento.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Punto di dirottamento? \\nDove esattamente?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hai detto che era la sala conferenze.", GameConfig.player_name)
	await novel_interface.show_dialog("Stavi per tenere una conferenza lì. Tu eri il docente.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Conferenza… Docente.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(Si riferisce alla conferenza pubblica su Ross Goblet organizzata da Wolfgang?)", "Mariru")
	await novel_interface.show_dialog("(Ma avrebbe dovuto essere cancellato. Come poteva saperlo?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehm... Signora Mariru?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sì... niente. Vai avanti.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E sono passati alcuni uomini armati mascherati. Corsi di sotto e mi nascosi all'ombra di un'ardesia...", GameConfig.player_name)
	await novel_interface.show_dialog("Scusate ma non ricordo cosa sia successo lì...", GameConfig.player_name)
	await novel_interface.show_dialog("In qualche modo sono svenuto e quando mi sono svegliato, ho visto...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Cosa hai visto?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Ho visto fumo e fiamme tutt'intorno.", GameConfig.player_name)
	await novel_interface.show_dialog("Il Centro Ricerche e gli edifici circostanti erano tutti in rovina...", GameConfig.player_name)
	await novel_interface.show_dialog("C'era un odore pungente tutt'intorno.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Aveva un forte sapore salino e amaro...", GameConfig.player_name)
	await novel_interface.show_dialog("Tutte le persone si sono trasformate in figure di pietra.", GameConfig.player_name)
	await novel_interface.show_dialog("No, non esattamente pietra: era sale.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("E ho visto qualcosa che brillava nell'aria.", GameConfig.player_name)
	await novel_interface.show_dialog("Era un inferno. \\nMa in qualche modo riesco a sentire una sorta di particolare tranquillità.", GameConfig.player_name)
	await novel_interface.show_dialog("Qualcosa mi risponde...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("E poi la mia memoria è diventata confusa... Potrebbe esserci una striscia di luce—", GameConfig.player_name)
	await novel_interface.show_dialog("E... questa è praticamente la fine del sogno.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Quando mi sono svegliato, mi sono ritrovato sul letto nella mia stanza, ed era già mattina.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Era... solo un sogno...?", "Mariru")
	await novel_interface.show_dialog("La tua memoria olfattiva era così vivida come se fossi davvero lì…", "Mariru")
	await novel_interface.show_dialog("(Se quell'odore pungente fosse zolfo...) \\n(Sarebbe proprio come il modo in cui Sodoma e Gomorra furono distrutte nella Genesi.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
