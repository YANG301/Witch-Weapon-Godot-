# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Мы уничтожили босса после жестокой битвы, а остальные враги исчезли в клубах красного тумана.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Ого... \\nПодождите, что это?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Передо мной падает пара пожелтевших страниц. На страницах — смесь текста и узоров, едва читаемая.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Что? \\nО... У меня кружится голова...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я протираю глаза и пытаюсь прочитать слова еще раз. Единственное, в чем я уверен, это то, что они написаны на английском языке.")
	await novel_interface.show_text_only("Хотя некоторые буквы читабельны,")
	await novel_interface.show_text_only("Все, что я чувствую, это полный хаос всякий раз, когда я пытаюсь собрать их вместе.")
	await novel_interface.show_text_only("Это похоже на расстройство чтения. Я не могу подобрать даже самое простое слово.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Отложите их пока. Нам есть жизнь, которую нужно спасти.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Верно. Понятно!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("В тот момент, когда я убрал их, мне показалось, что я увидел на бумаге сверкающий талисман, но он очень быстро исчез.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Это...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Э?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это моя иллюзия? \\n(Я чувствую неописуемую дрожь. Что это...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Легкое покалывание в руке напоминает мне, что это не иллюзия.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Эй, ты в порядке?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я смотрю на раненую девушку. Она все еще выглядит холодной. \\nНе рада и не благодарна за то, что мы с Annie сделали для нее.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Судя по ее внешности и одежде, она не просто соседская девчонка…")
	await novel_interface.show_text_only("Повязка на глазу достаточно странная. Но посмотрите на ее руки под платьем… Они закутаны в механическую броню.")
	await novel_interface.show_text_only("У нее серьезная рана на животе... Даже взрослый человек сломается.")
	await novel_interface.show_text_only("Но она сидела так тихо, не говоря ни слова.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Эй, как тебя зовут? \\nЧто ты здесь делаешь?", "Lian")
	await novel_interface.show_dialog("Вы знаете этих ребят?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Ладно... возможно, для нее слишком много вопросов...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Маленькая девочка внезапно встает, все еще истекая кровью. На самом деле она выше, чем я думал…")
	await novel_interface.show_text_only("О боже мой! \\nЕе тело... парит над землей?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nМиссия: Уничтожить ведьм.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка отвечает на вопросы очень странно.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... Это ее имя? \\nОна говорит очень странным тоном.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Цель, идентифицирующая ... \\nЧеловек. Женский. Сумма...", "Elluka")
	await novel_interface.show_dialog("Один.", "Elluka")
	await novel_interface.show_dialog("... \\nПовторная идентификация, активирована.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(«Одна» женщина?) \\n(Она только что опознала во мне мужчину?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Да, это так! Я мальчик!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ведьма, сумма, одна. \\nРежим защиты активирован.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Баха-ха-ха... \nНаконец-то! В последнее время у меня возникло ощущение, что какой-то незнакомец узнает мою настоящую личность.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Э... почему ее руки светятся все ярче и ярче? \\nЭй... Подожди, подожди минутку!")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Аааа! \\nОй! Ой! Ой!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("Почему ты придираешься ко мне?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Это было близко. Благодаря моей быстрой реакции, удар молнии лишь слегка задел мою руку и оставил на земле белесый ожог.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Низкие боевые навыки. Быстрый побег. \\n... Никакой угрозы.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ну... кажется, меня только что опознали как курицу…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Почему ты напал на меня одного? \\nЯ помог тебе.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Не ровня ведьме.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это честно!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Маленький Elluka, смотри, мы были такими милыми. \\nТак что мы определенно неплохие люди.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Шепот) Annie, это совсем не убедительно. И похоже, что мы похитители.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Ну…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... Итак, Elluka, ты тоже ведьма?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie игнорирует меня и спрашивает напрямую Elluka.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("Эй, подожди! Возможно, Elluka даже не знает, что такое Ведьма.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Палач.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Палач... Ну... Почему современные дети так любят такие дурацкие прозвища?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Блин, я только что сказал это вслух...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ударяет еще один удар молнии, и я снова вовремя уклоняюсь от него.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Эй, малыш! \\nМожем просто поговорить?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Здесь... шоколад. Перестань злиться, ладно?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я достаю из кармана плитку шоколада, ломаю ее пополам и делюсь с Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Уф... Повезло, что у меня с собой шоколад. \\nВ конце концов, ни один ребенок не ненавидит шоколад.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ням...ням... \\nВидите, я это съел.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Шоколад?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это не опасно... \\nЭто закуска, которая приносит счастье!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(Шепотом) Lian, тот, кто предлагает еду маленьким девочкам, может больше походить на похитителя.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("А ты сейчас ведешь себя как девчонка и берешь с собой шоколадки. Отличная работа!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka мгновение колеблется, прежде чем открыть упаковку и медленно положить кусочек в рот.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nСтранно, аромат...", "Elluka")
	await novel_interface.show_dialog("Горький.", "Elluka")
	await novel_interface.show_dialog("Мило...", "Elluka")
	await novel_interface.show_dialog("Elluka, не ненавидит это.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Хаха, тебе это нравится?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ох... она выглядит так мило...!")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Мвахаха...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Упс! Lian выглядит очень опасно.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Выражение лица, идентифицирующее... Хентай.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Хентай...?! \\nТы имеешь в виду меня?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Но Elluka не ненавидит это.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хаха... тогда всё в порядке.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("Ты выглядишь счастливым, когда тебя называют хентаем. \\nТы действительно странный...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Нет, я не такой. Не могли бы вы перестать меня неправильно истолковывать?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("О! \\nУ меня есть еще один кусок. Вы можете получить это.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Здесь!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka порылся вокруг, вытащил прозрачный контейнер размером с батарейку АА и отдал мне. В нем находится зеленая густая флуоресцентная жидкость.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Это... электрическая жидкость?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Обмен, еда.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это то, что вы называете едой?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka серьезно кивает.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Когда я голоден, администратор кормит меня. \\nДля восполнения энергии.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Администратор, ваш опекун?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Поскольку вы можете есть шоколад, ваше тело должно функционировать так же, как у нормального ребенка, верно?", "Lian")
	await novel_interface.show_dialog("Вы не бытовая техника...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Без сомнения, эта девушка чувствует существование магических надписей.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Но ее сила… очень особенная.", "Annie")
	await novel_interface.show_dialog("Она... Палач?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
