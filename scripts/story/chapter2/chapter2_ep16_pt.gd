# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai compara o relatório com os dados piscando no monitor, sorrindo de vez em quando.")
	await novel_interface.show_text_only("Mariru pega o relatório por trás Ai e o estuda.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Então, como foi o exame físico? Você parece muito satisfeito consigo mesmo.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… Isso é simplesmente fabuloso!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("A alma de um menino presa no corpo de uma menina… Se as pessoas do Harima Brain Research Institute ouvirem sobre Lian, eles matarão para registrar um pedido de experimento e a levarão embora.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Devemos guardar isso para nós mesmos, entendeu?\\nAlguma nova descoberta?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Ambos os seus telômeros indicam uma idade de quinze anos, mas a quantidade de césio-137 nos tecidos moles de Annie é apenas um quarto da média atual.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Inteligente… \\nEntão, no máximo, ela viveu apenas metade da Guerra dos Sete Anos?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("A menos que ela tenha sido mantida numa cápsula selada durante anos após a guerra.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu vejo. \\nE Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Quanto a Lian… o nível detectado em seu tecido muscular é inferior a um duzentos por cento da média – ainda mais baixo do que o que os recém-nascidos herdam de suas mães.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Então é um corpo recém-sintetizado?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Agora, aqui está a parte realmente interessante: o corpo dela carrega anticorpos para muitos vírus extintos há muito tempo, incluindo a varíola.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vá com calma. Não há vírus residual na medula espinhal.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fiz uma verificação aproximada: a história do sistema imunológico de Lian parece cobrir apenas os últimos séculos. Não existem anticorpos contra nenhum vírus pré-medieval.", "Ai")
	await novel_interface.show_dialog("Mesmo assim, eu adoraria solicitar uma amostra de seus glóbulos brancos e tentar cultivar os vírus nº 008, 217 e 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Este não é o seu trabalho como médico escolar.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Sim, certo. Eu entendo. \\nVocê quer que eu fique de olho neles, certo?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eles podem ter uma ligação com o Ross Goblet… \\nSuspeito que eles não contaram a história toda.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Por que não trancá-los e interrogá-los?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Você precisa de uma mão? Olha, com algumas modificações, as ferramentas que usei para o check-up hoje seriam perfeitas para o trabalho…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Os olhos de Ai brilham de excitação. Mariru enrola o relatório e dá um tapa nela.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Apenas mantenha seus olhos e ouvidos abertos. Informe-me se algo acontecer.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Agora que ela já percebeu isso, temo que alguém dentro de SID possa ter…)", "Mariru")
	await novel_interface.show_dialog("(Pelo menos ela permanecerá controlada na escola) \\n(E enquanto isso eu poderia vigiá-la...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Você não precisa me dizer duas vezes. Vou registrar cada ~ mudança no corpo de Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("É melhor você manter a discrição e permanecer no caminho certo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ei, ei, relaxe. \\nNão seria nada divertido se eu a drenasse completamente de uma vez.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
