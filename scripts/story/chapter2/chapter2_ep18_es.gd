# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Es una tarde calurosa de verano. Dejo un montón de papeles junto a la mesa redonda del patio y me hundo en una silla a la sombra de los árboles.")
	await novel_interface.show_text_only("Hace un tiempo vi a esta linda chica luchando con su pila de libros. No lo pensé dos veces y le di una mano.")
	await novel_interface.show_text_only("Luego se apresuró a alejarse, aunque afortunadamente. Fue entonces cuando me di cuenta de que soy un idiota.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uf... Déjame tomar un descanso aquí... Hace mucho calor.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por desgracia, para mí era pan comido cuando era niño.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Y luego viene este SID entrenamiento... Dios, ¿puedo esconderme en algún lugar?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, cuida tus modales... \\nEsto es una escuela.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("¡Oye, Annie! \\n¿Qué pasa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Escucha... Sé que hace calor. \\nPero... ¿es realmente necesario levantarse la camisa para secarse el sudor?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Quiero decir... Ten cuidado con un mal funcionamiento del vestuario...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("¡Maldita sea!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("Esa chica Lian es muy grosera...", "Estudiante A")
	await novel_interface.show_dialog("Sí, la vi abierta de piernas el otro día, con falda.", "Estudiante B")
	await novel_interface.show_dialog("¿En serio? Qué asco…", "Estudiante A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(No debería haber usado faldas en primer lugar, ¿de acuerdo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Oye...")
	await novel_interface.show_text_only("Qué voz tan suave.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Usa mi pañuelo si no te importa.", "chica elegante")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Frente a mí hay una chica hermosa y elegante. \\nTiene cabello largo, sedoso, morado y ojos lilas.")
	await novel_interface.show_text_only("Me entrega un pañuelo con una fragancia exquisita y fresca.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("¡¿Eh?! \\nGracias... Gracias.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ustedes son los estudiantes transferidos de primer año, ¿verdad? \\nMi nombre es Nix Strozzi. Soy tu mayor.", "Nix")
	await novel_interface.show_dialog("Te vi sudando y resulta que tengo mi pañuelo conmigo, así que... \\nEspero no interrumpir.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix me hace un gesto cortés con la cabeza, pero me asusto. Me levanto y saludo de una manera bastante tonta.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("¡No... en absoluto! \\n¡Es de gran ayuda!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(Parece muy amable.) \\n(¿Es extranjera? Mira esas pestañas largas...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro el delicado rostro de Nix, mi corazón se acelera.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Es un placer. \\nEntonces... tu nombre es...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("Soy Lian. Ella es Annie. \\nNos acabamos de transferir aquí últimamente.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix parece confundido y mira fijamente a Annie, aunque brevemente.")
	await novel_interface.show_text_only("Luego le sonríe a Annie de manera amistosa. Me pregunto si fue solo mi ilusión de ahora.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Encantado de conocerte hoy.", "Nix")
	await novel_interface.show_dialog("Pero necesito irme ahora. Déjame saber si hay algo que pueda hacer para ayudar.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("¡Gracias, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie duda sin ninguna respuesta.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esta chica, Nix... luce mucho más elegante que cualquiera de estas chicas de cuchara de plata.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, ¿estás bien? \\nHas estado callado.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("¿Dijo que es una Strozzi?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ajá, ¿la conoces?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie me toma del brazo y me regala una sonrisa inocente.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("No. \\nSomos nuevos aquí. ¿Cómo podría conocerla?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Sí, tienes razón.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
