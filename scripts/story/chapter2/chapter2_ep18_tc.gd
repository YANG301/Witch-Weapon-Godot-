# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("被曬到喘不過氣的夏日午後，我把一大摞檔案擺到中庭的圓桌邊，自己也癱坐到樹蔭下的椅子上。")
	await novel_interface.show_text_only("看到一個漂亮的學姐很辛苦地抱著這疊東西，我就忍不住衝上去幫忙了……")
	await novel_interface.show_text_only("看著學姐一臉感激地消失在我的視野中，我才意識到自己是個笨蛋。")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("呼，總算可以休息了，熱死了。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("唉……原來的身體拿這些根本是小菜一碟啊")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("而且接下來還有SID的訓練……啊啊！ 好想找個地方躲起來。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("小憐，那個……\\n這裡可是學校哦。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("是安妮啊～\\n我知道這裡是學校啊，怎麼了？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("雖然我知道妳很熱，\\n但是直接撩起衣襬擦汗……好像不太好吧？", "安妮")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("就是……會走光啦。", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("糟糕！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("那個叫小憐的轉學生也太沒氣質了……", "同學A")
	await novel_interface.show_dialog("是呀，我那天還看到她穿著裙子張開腿坐呢！", "同學B")
	await novel_interface.show_dialog("真的嗎？ 這樣子不好吧……", "同學A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("……\\n（因為我本來就不應該穿裙子啊！ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那個……")
	await novel_interface.show_text_only("一個溫柔的聲音傳來。")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("妳好，不介意的話，請用這條手帕吧。", "氣質優雅的少女")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("出現在眼前的，是一名漂亮優雅的女生。 \\n柔順的紫色長髮，紫丁香一般溫柔的雙眸。")
	await novel_interface.show_text_only("她向我遞出了一條手帕，上面還帶著優雅清新的香味。")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("哎？ ！\\n謝、謝謝。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("妳們就是一年級的轉校生吧？ \\n我叫倪克斯·斯特羅齊，是妳們的學姐。", "倪克斯")
	await novel_interface.show_dialog("我剛剛看到妳好像很熱的樣子，剛好我隨身帶了手帕，\\n希望沒有打擾到妳們。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯禮貌地點了點頭，我不知所措地站起來，笨手笨腳地行了個禮。")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("不、不會的！ \\n完全沒有，謝謝妳，這條手帕真是幫了大忙啦！", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("（好溫柔的學姐啊。 ）\\n（她是外國人吧，睫毛好長……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("看著倪克斯精緻的面孔，感覺心跳有些力加快。")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("不用這麼客氣。\n那麼……請問你的名字是……", "倪克斯")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("我叫小憐，她是安妮。 \\n我們都是最近才轉學過來的。", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……安妮？", "倪克斯")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("倪克斯的表情變得有些古怪，還盯著安妮的臉看。")
	await novel_interface.show_text_only("但她很快朝安妮友好地微笑了一下，彷彿剛才只是我的錯覺。")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("很高興認識妳們。", "倪克斯")
	await novel_interface.show_dialog("我還有事得先走了，如果以後有什麼需要，妳們都可以來找我。", "倪克斯")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("謝謝學姐！", "小憐")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("……", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("安妮沒有回應，有些猶豫。")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這位學姐……比其他大小姐的氣質都還要優雅啊。", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("咦？ 安妮，妳怎麼了？ \\n從剛才起就一直不說話。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("剛才那個學姐說，她叫斯特羅齊？", "安妮")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("是啊，妳認識她嗎？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("安妮勾住我的胳膊，露出了率性的笑容。")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("怎麼可能認識！ \\n我跟妳都是剛轉學來的耶。", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("說得也是呢。", "小憐")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
