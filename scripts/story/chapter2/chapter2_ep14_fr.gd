# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mais je veux redevenir un garçon...\nQue suis-je censé faire... ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Eh bien... pourquoi ne pas rester une fille comme ça ?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi—??\nNon ! Absolument pas !", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Comme vous l'avez dit, peut-être que le destin de cette ville a été détourné de la destruction et que des dizaines de millions de vies sont revenues à cause de cela...", "Mariru")
	await novel_interface.show_dialog("Un miracle de cette ampleur a forcément un prix, vous ne pensez pas ?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Et si ce prix... était simplement que vous finissiez comme ça ?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Comment cela pourrait-il être...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Aussi...\nTu as déjà quinze ans, n'est-ce pas ?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Une fille de votre âge\ndevrait au moins porter un soutien-gorge..., n'est-ce pas ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu grandis encore, tu sais. Ils pourraient continuer à grossir à partir de maintenant...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Quoi ?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si vous n'en portez pas, cela posera des problèmes.\nPar exemple, lorsque vous courez...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("O-Tu ne veux pas dire un soutien-gorge... ?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactement. Je pense qu'un style mignon et girly vous irait bien, n'est-ce pas ?\nTu as le genre de visage qui a l'air adorable~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Absolument pas !!\nJe-je suis un garçon !!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Et au fait, la façon dont vous êtes assis en ce moment...\nC'est étonnamment audacieux de votre part~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("I-I-I-I...\nJe vais aux toilettes !!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh mon Dieu—\nCe gamin est vraiment beaucoup trop facile à taquiner~", "Mariru")
	await novel_interface.show_dialog("On dirait que je ne m'ennuierai plus à partir de maintenant ~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Je me suis regardé dans le miroir. En repensant à cette conversation, j'ai lentement glissé le long du mur et je m'y suis accroupi.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Je n'arrive toujours pas à y croire...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Un truc comme ça... Je ne veux absolument pas le porter !!", "Lian")
	await novel_interface.show_dialog("En tant qu'homme...\nJ'ai l'impression que quelque chose d'important m'échappe de plus en plus !", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Et si quelqu'un me voyait dans un endroit où l'on vend ce genre de choses...\nNon, non ! Absolument pas !", "Lian")
	await novel_interface.show_dialog("(Si je faisais vraiment ça...)\n(Alors je serais vraiment... un pervers !!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Je ne veux pas être un pervers !!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ah ? Tu es toujours accroupie ici en train de pleurer ?\nJ'ai déjà choisi la bonne taille en fonction de ta poitrine.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Je les ai laissés dans ta chambre. Considérez-les comme un cadeau de ma part~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non merci !\nJe vais juste utiliser des bandages à la place !!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Cet enfant... es-tu innocent ou juste pervers ?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Mais utiliser des pansements adhésifs pourrait être encore plus intéressant.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ou appréciez-vous ce petit sursaut de douleur lorsque vous les arnaquez ?", "Mariru")
	await novel_interface.show_dialog("Dommage. Tout ce que nous avons ici, ce sont des bandages pulvérisés~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Vous faites ça exprès, n'est-ce pas !!\nUgh... bon sang !!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Tch, très bien, je vais le porter ~!\nSi je suis un vrai homme, de quoi y a-t-il de quoi être gêné !!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Hum ? Attendez ?\nC'est... vraiment difficile...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Mm-hm.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*cliquez*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Voilà, je l'ai attaché pour toi~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nH-Comment es-tu entré ici ?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Je t'ai juste gentiment aidé~\nAu fait, peux-tu gérer toi-même les chaussettes hautes de l'uniforme ?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ?! Ce ne sont que des chaussettes, qu'est-ce qu'il y a de si dur là-dedans !\nJe le ferai moi-même !", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Et la jupe ?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Moi aussi je peux gérer la jupe... Je vais l'enfiler moi-même...\nMariru, sors déjà !!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Wow~ Alors tu sais vraiment comment mettre une jupe. C'est impressionnant.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Une jupe n'a pas besoin d'être tendue derrière le dos pour attacher quoi que ce soit, alors qu'est-ce qui est difficile ?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, ok alors~\nJe reviendrai un peu et je verrai à quoi tu ressembles une fois habillé.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Bon sang,... Mariru me sous-estime sérieusement !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Quelque temps plus tard...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru ! Je suis habillé !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Etes-vous sûr ?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("De quoi ne pas être sûr ! Je l'ai très bien mis, n'est-ce pas ?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Alors..., où est exactement ta fermeture éclair ?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Devant ! Cela facilite la tâche lorsque vous devez utiliser les toilettes !", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... et qu'est-ce que tu utilises exactement pour aller aux toilettes maintenant ?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ça n'a rien à voir avec quoi que ce soit ! Quoi qu'il en soit...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft... La fermeture éclair va sur le côté.\nVa jeter un oeil dans le miroir~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("Le côté, puis le côté...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Pourquoi les vêtements de filles sont si difficiles à enfiler !!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
