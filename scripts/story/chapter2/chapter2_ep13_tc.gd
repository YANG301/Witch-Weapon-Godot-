# chapter2_ep13.gd - 第二章第13話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("在進入新的學校之前，你的第一個任務就是進行基礎知識培訓。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("基礎知識？\n我又不像安妮錯過了這幾年的事……", "小憐")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哼哼，你可是錯過了整整十幾年做女生的知識啊~", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("那種知識才不需要啦！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉完全沒理會我的抗議，神采奕奕的走向桌邊。我才發現她早已經準備了滿滿一桌子的各式道具。")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("首先，你要能分辨口紅的12種典型色號，並記住前20名的品牌。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("這麼多種啊……\n顏色不是差不多嗎？", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("太天真了！這只是總量的不到十分之一。", "莉琉")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("然後這裡給你準備了全套的化妝道具——裡面有粉底、眼影、唇彩、高光、修容……", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("欸？要往臉上塗這麼多東西嗎？！\n又不是在畫畫……做女生到底有多複雜……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("不用擔心，從今天開始會有專人教你化妝。", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("高中生不是不允許化妝……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("你啊，太不瞭解女高中生的世界了……\n這種大大咧咧的樣子用不了兩天就會引起懷疑的。", "莉琉")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("而且除了上學，作為SID的探員還需要執行各種任務，化妝是女性特工的必備技能之一。", "莉琉")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("尤其是你這樣的小臉蛋——", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉伸出食指，挑起我的下巴。")
	await novel_interface.show_text_only("我後退一步躲開了她的手，總覺得自己的男性尊嚴無法接受。")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("雖然之前確實是自告奮勇\n但我可沒想到要學這些東西啊……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("SID的學員考核可是非常嚴格的，每次都會篩選掉一大批人。", "莉琉")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("你既然說了那樣的大話，就證明一下自己吧。", "莉琉")
	await novel_interface.show_dialog("而且如果透過最終考核就可以被納入正式編制，還會有不菲的薪水哦~", "莉琉")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("欸？還能有錢拿啊！？\n（那，那我的Gfat購物車……）", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("好，男性尊嚴先放到一邊。")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("（呵呵呵，真是單純的小鬼）", "莉琉")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("但是相應的，你也要明白——作為你的長官，我的命令是絕對的，必須無條件服從！", "莉琉")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("到底要怎樣……", "小憐")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("先給你介紹一個人——自告奮勇教你化妝的老師。", "莉琉")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("雖然平時負責的是試驗性藥品和特種裝備研發……", "莉琉")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("哦……小憐是吧？\n嘿嘿~這份檔案真是有趣~", "戴眼鏡的女生")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("你好~我是SID戰研部的主任，既然咱們的檔案都被修改過，你叫我愛衣就可以了。", "戴眼鏡的女生")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("你好……\n（她的檔案……也被修改過？）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("莉琉啊，小憐這麼好的研究素材，真的不能……\n借給我用用嗎~！？", "愛衣")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（？？？研究素材？用用……？）", "小憐")
	await novel_interface.show_dialog("（為、為什麼後背有點發涼……）", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("我怎麼也算監護人，你不可以對她出手哦~", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("哼，好吧……", "愛衣")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("雖然我也難得化妝，不過那些東西很簡單，我看了10分鐘就全記下來了。", "愛衣")
	await novel_interface.show_dialog("你應該也能很快學會的。", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("這麼快？\n好像程式很複雜來的……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("愛衣記什麼都很快，以後多跟她學學吧~", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("是……\n（記憶力這種東西要怎麼學嘛！）", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("啊嗚~~\n跟愛衣記了一天化妝品的牌子和顏色頭大死了。", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("……莉琉！你怎麼在這？！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("怎麼？這公寓本來就是我在新豐洲的住所之一。\n不僅如此，這整棟大樓都是SID的資產~", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我說怎麼這麼誇張！\n等等，難道你要跟我和安妮住在一起……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("只是偶爾回來，並不會經常住在這~\n這裡的冰箱都沒有啤酒了，下次記得幫我買兩箱。", "莉琉")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("不過今天是特意過來作為監護人……哼哼~", "莉琉") #♪少一個音樂符號
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不、不祥的感覺！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("來試試，這是小憐的校服、這是連衣裙~", "莉琉")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("為什麼……這個裙子這麼短……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("裙子的長度果然還是這樣好啊。", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這個裙子果然被改過長度了吧！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("不要在意那種細節~", "莉琉")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("這邊還有短筒襪、中筒襪、長筒襪、連褲襪……\n哦哦，還有這條吊帶襪！", "莉琉")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("襪子怎麼也有這麼多種類……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("還有不同型別的條紋、拼接、圖案、波點……\n對了，要不要試試網襪？", "莉琉")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("才不要呢！！！", "小憐")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("不對！重點是！\n這種東西我才不要穿啦！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("任務需要的時候也由不得你，不如趁早……\n要不要我來幫你？", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("你……你……！！", "小憐")

	print("=== 第二章第13話結束 ===")

	# 呼叫劇情結束函式
	await novel_interface.end_story_episode(0.5)
