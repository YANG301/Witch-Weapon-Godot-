# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Ma voglio tornare ragazzo...\nCosa dovrei fare...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Beh... perché non restare una ragazza così?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa-??\nNo! Assolutamente no!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Come hai detto tu, forse il destino di questa città è stato distorto dalla distruzione e decine di milioni di vite sono tornate in vita a causa di ciò...", "Mariru")
	await novel_interface.show_dialog("Un miracolo di quella portata avrà sicuramente un prezzo, non credi?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("E se quel prezzo... fosse semplicemente la tua fine?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Come potrebbe essere...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Inoltre...\nHai già quindici anni, vero?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Una ragazza della tua età\ndovrebbe almeno indossare un reggiseno... giusto?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Stai ancora crescendo, lo sai. Potrebbero continuare a diventare più grandi da qui in avanti...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Cosaaa?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se non lo indossi, causerà problemi.\nAd esempio, quando corri...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Y-Non intendi un reggiseno...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esattamente. Penso che uno stile carino e femminile ti starebbe bene, vero?\nHai quel tipo di viso che sembra adorabile~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Assolutamente no!!\nS-sono un maschio!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E comunque, il modo in cui sei seduto adesso...\nÈ sorprendentemente audace da parte tua~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("I-I-I-I...\nVado in bagno!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh cielo—\nQuel ragazzo è davvero troppo facile da prendere in giro~", "Mariru")
	await novel_interface.show_dialog("Sembra che non mi annoierò da adesso in poi~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Mi guardai allo specchio. Ripensando a quella conversazione, sono scivolato lentamente lungo il muro e mi sono accovacciato lì.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Ancora non riesco a crederci...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Qualcosa del genere... Non voglio assolutamente indossarlo!!", "Lian")
	await novel_interface.show_dialog("Come uomo...\nSembra che qualcosa di importante mi stia scivolando sempre più lontano!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("E se qualcuno mi vedesse in un posto dove vendono cose del genere...\nNo, no! Assolutamente no!", "Lian")
	await novel_interface.show_dialog("(Se lo facessi davvero...)\n(Allora sarei davvero... un pervertito!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Non voglio essere un pervertito!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ah? Sei ancora accovacciato qui a piangere?\nHo già scelto la taglia giusta in base al tuo seno.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Li ho lasciati nella tua stanza. Considerali come un mio regalo~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No grazie!\nUserò solo delle bende!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Questo bambino... sei innocente o semplicemente pervertito?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Anche se usare le bende adesive potrebbe essere... ancora più interessante.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("O ti capita di provare piacere in quella piccola scossa di dolore quando li strappi?", "Mariru")
	await novel_interface.show_dialog("Peccato. Qui abbiamo solo bende spray~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Lo stai facendo apposta, vero!!\nUgh... dannazione!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Tch, va bene, lo indosserò~!\nSe sono un vero uomo, cosa c'è di cui vergognarsi!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Ehm? Aspetta?\nQuesto... è davvero difficile...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Mm-hm.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*clicca*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Ecco, te l'ho allacciato~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nH-Come sei arrivato qui?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ti stavo solo aiutando, gentilmente~\nA proposito, puoi occuparti dei calzini alti fino al ginocchio dell'uniforme da solo?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?! Sono solo calzini, cosa c'è di così difficile!\nLo farò da solo!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("E la gonna?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Posso gestire anche la gonna... Me la metto da sola...\nMariru, esci già!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Wow~ Quindi sai davvero come indossare una gonna. È impressionante.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Una gonna non richiede di allungarsi dietro la schiena per allacciare qualcosa, quindi cosa c'è di difficile?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, va bene allora~\nTornerò tra un po' e vedrò come sarai una volta vestita.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Dannazione... Mariru mi sta seriamente sottovalutando!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Qualche tempo dopo...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! Sono vestito!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Sei sicuro?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa c'è di cui non essere sicuri! L'ho messo benissimo, vero?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Allora... dov'è esattamente la tua cerniera?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nella parte anteriore! Rende più facile quando hai bisogno di usare la toilette!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... e cosa usi esattamente per andare in bagno adesso?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehm...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Q-Questo non ha niente a che fare con niente! Comunque...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft... La cerniera va sul lato.\nVai a guardarti allo specchio~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("Il lato, poi il lato...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Perché i vestiti delle ragazze sono così difficili da indossare!!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
