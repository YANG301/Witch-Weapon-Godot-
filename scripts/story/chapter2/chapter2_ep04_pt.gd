# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sim... também estou confuso porque parecia tão real – diferente de qualquer sonho.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Procurei notícias de incêndios ou danos em edifícios, mas não encontrei nada. \\nA cidade parece tão pacífica quanto costumava ser.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Exceto por uma coisa…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hum?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Exceto o quê?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Quando acordei…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Eu descobri que meu corpo mudou para o corpo de uma garota...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Bem…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Hein? Você disse... mudou?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu não sou... eu não estava assim antes...", GameConfig.player_name)
	await novel_interface.show_dialog("Eu… na verdade sou um menino!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ecaaaaa… um menino?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ok... espere, o que?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Quer dizer que você é um garoto travestido? (inclina-se para perto)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Não, não… Não é isso que quero dizer. \\nNão chegue tão perto!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Mas… em certo sentido... \\nTalvez você esteja certo…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh Deus… como posso explicar isso!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("De qualquer forma... você tem uma ótima plástica nos seios. (Toca)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Tão animado… Onde você fez isso? Um toque tão natural... (Beliscões)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Uau… eu também quero descobrir!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ai! Não… não é… espere… \\nPare com isso!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Deixe-me verificar… braços finos, cintura curva, perfeito.", "Mariru")
	await novel_interface.show_dialog("Que materiais você usou? Especialmente aqui…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhhh! Isso dá coceira…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Sra. Não toque aqui!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Não…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo…", GameConfig.player_name)
	await novel_interface.show_dialog("Acredite ou não! Eu era um menino até ontem!", GameConfig.player_name)
	await novel_interface.show_dialog("Não houve cirurgia...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sim, não há dúvida sobre isso.", "Mariru")
	await novel_interface.show_dialog("Uma mudança tão completa de género é impossível com as tecnologias actuais.", "Mariru")
	await novel_interface.show_dialog("Você não pode fazer isso a menos que substitua todos os ossos do seu corpo. \\nO que significa que você é e sempre foi uma garota.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê! Eu já te contei! \\nAcordei como uma menina.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Você tem alguma prova? \\nAlguma coisa que prove que você era um menino?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bem… prova… \\nSim, certo! Minha carteira de estudante!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Entregamos todos os meus pertences ao entrar aqui, inclusive minhas roupas e carteira de identidade.")
	await novel_interface.show_text_only("Mariru toca em seu dispositivo portátil, o que abre meu cartão de estudante.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Sim! É isso! \\nOlha! Essa é a prova.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("As características faciais se parecem um pouco com você, mas isso dificilmente é uma prova…", "Mariru")
	await novel_interface.show_dialog("Certo, pegue todas as filmagens de"+GameConfig.player_name+"capturado pelo sistema de vigilância da cidade no último mês…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru bate habilmente em seu tablet, parecendo um pouco animado.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Achei que era só um sonho quando vi aquelas ruínas, e pensei que tudo voltaria ao normal depois de acordar.", GameConfig.player_name)
	await novel_interface.show_dialog("Mas agora, eu me tornei uma garota...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Aplique correções de alteração óssea. Ative análises de marcha em suas imagens no corredor agora há pouco…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignora meu murmúrio e se concentra em seu tablet.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Talvez não seja um sonho. Mas agora tudo parece bem. Sem fogo, sem destruição.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh… estou totalmente confuso…!", GameConfig.player_name)
	await novel_interface.show_dialog("Quais partes das minhas memórias eram reais e quais partes eram apenas sonhos…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… O padrão de marcha corresponde.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O que isso significa?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("O padrão de marcha é o padrão de controle característico dos músculos de uma pessoa ao caminhar. Mesmo os melhores agentes não conseguem disfarçar.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Embora a ciência atual não consiga explicar isso…\nVocê realmente é"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A... você tem certeza...?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Finalmente… pensei que vocês soubessem algo sobre isso…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Então, você já ouviu falar do Ross Goblet?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Um Substance H que desapareceu repentinamente sob vigilância por vídeo, segundo o noticiário desta manhã… Mas ainda não o vi pessoalmente.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Bem, se você está dizendo a verdade…", "Mariru")
	await novel_interface.show_dialog("Provavelmente será a única razão pela qual eu concordaria em dar esta palestra chata de graça.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("É um Substance H encontrado nas Ilhas Ross. Quatro gemas de notável pureza estão montadas no exterior.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu vi algo que parecia uma taça brilhante voando no céu depois que saí das ruínas.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ele flutuou no céu, emitindo uma leve luz vermelha…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Vermelho fraco?", "Mariru")
	await novel_interface.show_dialog("(O líquido vermelho fraco na taça tem sido um mistério…)", "Mariru")
	await novel_interface.show_dialog("(Mas essa informação é confidencial. Nunca foi tornada pública, mesmo depois de ter sido classificada como ‘Segura’ há pouco tempo.)", "Mariru")
	await novel_interface.show_dialog("(Ninguém poderia dar tais detalhes sem ter visto antes…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Independentemente de ter sido um sonho, infelizmente precisamos confirmar mais informações com você.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
