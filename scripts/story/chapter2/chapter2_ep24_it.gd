# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("Di ritorno all'appartamento, Elluka è ancora aggrappata ai miei vestiti anche nel sonno.")
	await novel_interface.show_text_only("Annie e Mariru mi ordinano di girarmi e di non sbirciare, quindi formano un muro umano mentre rimuovono i guanti di metallo e il cappotto strappato di Elluka e la trasformano in abiti normali.")
	await novel_interface.show_text_only("Poi mi fanno giurare sulla mia vita che non farò alcun male a Elluka, prima di permettermi di portarla nella mia stanza.")
	await novel_interface.show_text_only("...Ora Elluka sta dormendo sul mio letto, stringendo ancora i miei vestiti, quindi tutto quello che posso fare è sedermi accanto a lei.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Perché sei così appiccicoso, ragazzo? \\nDio, sono così stanco...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dopo un’intera notte di operazione, sono completamente esausto. Mentre ricado sul letto, sento il foglio in tasca.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Annie ha detto che questi sono... i Frammenti del Grimorio?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Elluka sembrava volerli e mi guardava come un simpatico animale domestico...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sdraiato sul letto, esamino ancora una volta le pagine. Ma il contenuto è altrettanto incomprensibile quanto appariva prima.")
	await novel_interface.show_text_only("Mentre giro le pagine, un paio di pagine mi scivolano dalle mani e cadono sul corpo di Elluka.")
	await novel_interface.show_text_only("Nel momento in cui le pagine toccano il suo corpo, appare all'improvviso un bagliore bluastro.")
	await novel_interface.show_text_only("Un'ondata di simboli e parole irrompe dalle pagine, e anche l'aria della mia stanza inizia a tremare.")
	await novel_interface.show_text_only("All'improvviso, le pagine rimanenti sembrano trascinate da una forza invisibile verso il corpo di Elluka.")
	await novel_interface.show_text_only("C'è un'esplosione di luce abbagliante, poi tutto scompare.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Co-cos'è questo...?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ricerca avviata. Obiettivo identificato: \\nCioccolata... sorella maggiore!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Elluka?! Sei sveglio!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka all'improvviso mi getta le braccia al collo. Allo stesso tempo, la porta dietro di me si spalanca.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ehi, cos'era quello tremore?\\n...Aspetta, finalmente ti sei mosso su Elluka?!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie mi guarda come se fossi un pervertito.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Non è quello che pensi. Lasciami spiegare!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Energia, piena.\\nRicerca target ... non trovato.", "Elluka")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Perché, chi stai cercando?", "Lian")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("…Amministratore, del Palazzo di Giustizia.", "Elluka")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Il Tribunale...? Che cos'è?\\nComunque, prendiamo Mariru e scopriamo cosa fare.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Tribunale... Ragazzi, mi state mettendo in grossi guai. Il tuo amico è membro della Congregazione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Eh? Che cos'è?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Facendo ricerche sulle streghe, sono venuto a conoscenza di queste strane organizzazioni clandestine, tra cui la Congregazione, la più antica del genere.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Successivamente la Congregazione si è divisa in diverse fazioni e il Tribunale è una di queste.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Da quando si è separato centinaia di anni fa, il Tribunale ha minacciato di spazzare via tutte le streghe e ha orchestrato la famigerata Caccia alle streghe.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Odio avere a che fare con gruppi così superstiziosi.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Inizialmente avevo intenzione di collocare Elluka in una scuola per bambini a New Opulentia...\\nMa date le circostanze, non posso lasciarla andare.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Devi avere altri piani. Faresti meglio a non condurre nessuna strana ricerca su di lei...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Sono così cattivo ai tuoi occhi?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru mi batte la testa. \\nElluka mette il broncio e fissa Mariru con rabbia.")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Obiettivo identificato. Grado di minaccia, estremamente alto.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("… Piccolo marmocchio.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, Elluka, quale compito ti ha dato Jacob?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka aggrotta la fronte e ricorda lentamente il suo compito:")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Per prima cosa, elimina le streghe. Completato. \\nSecondo, ottieni il manoscritto. Fallito.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Il manoscritto? Non è Lian colui che ce l'ha?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Ricerca in corso... Eccezione stato. \\nManoscritto... consumato.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Consumato? Vuoi dire che le pagine sono dentro di te adesso?\\nOppure facevano sempre parte del grimorio di Elluka?", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Il tuo amministratore non ti avrebbe permesso di assorbirli...\\nAveva paura che saresti diventato troppo potente per poter essere controllato?", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Questa è la storia completa solo da un paio delle sue parole, Lian. Ben fatto!", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aspetta, il Grimorio di Elluka. \\nIl che significa...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Anche questo ragazzino è una strega?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru cerca di pizzicarle la guancia, ma Elluka lo schiva agilmente.")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("Ho sentito dire da tempo che alcuni gruppi tentano di creare e controllare le streghe. Non mancano i carrieristi che muoiono dalla voglia di avere dei super soldati!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Come fate voi due a sapere così tanto sulle streghe...? Sono l'unico all'oscuro qui. Dimmi: come fa una ragazza a diventare una strega?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Uh, all'inizio non ne ero sicuro neanche io. Ricordo di aver letto quel libro senza sapere cosa fosse.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ho iniziato ad avere le vertigini man mano che il contenuto diventava sempre più difficile. Poi a un certo punto, mi sono sentito come se una forza sconosciuta fosse entrata nel mio corpo.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Un giorno, ho pronunciato un incantesimo tratto dal libro e sono stato trascinato in un altro Spaziotempo...", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Spaziotempo… Secondo i dati satellitari, il flusso spaziotemporale si era già interrotto quando sei arrivato alla sottostazione.", "Mariru")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non c'è da stupirsi che non abbia avuto la stessa sensazione che ho avuto in altre Flux Areas!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Ciò che chiami Area di Flusso viene chiamata nell'antica letteratura sulle streghe \"Bozzolo della Strega\".", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("Si forma quando un essere umano si trasforma in una strega. Gli estranei non possono né romperlo né entrarvi. È molto simile in natura ad uno spazio generato da Substance H, non trovi?", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("E quasi nel momento in cui il flusso è scomparso, il nostro satellite ha rilevato segnali ottici...", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Voglio dire, sono comparsi i ragazzi contro cui hai combattuto.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Pensaci: \"Witch's Cocoon\"... Nel momento in cui il bozzolo è scomparso, questi ragazzi sono usciti. È come se fossero nati dal bozzolo.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Strega, termina!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Quindi le streghe hanno davvero perso la testa perché non sopportano le informazioni sul Grimorio!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Erano semplicemente ragazze normali. Non potevano sopportare il potere magico proveniente dalle sceneggiature e sono rimasti feriti.", "Annie")
	await novel_interface.show_dialog("Nel momento in cui hanno innescato una violenta distorsione spaziale, sono diventate...\\nGli esseri mostruosi che la gente chiama \"Streghe\".", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("In molti libri antichi si dice che più informazioni si conoscono sui poteri magici, più facilmente si soffre di follia irreversibile.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Se perdono la sanità mentale, le streghe possono causare grandi disastri. Se questo è vero…", "Mariru")
	await novel_interface.show_dialog("Allora questo potrebbe essere il motivo per cui la caccia alle streghe è durata così a lungo in Europa.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Merda. Sembra una pandemia.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("Secondo ciò che sappiamo, l'amministratore di Elluka ha dato priorità alla caccia alle streghe come modo per recuperare i frammenti del grimorio.", "Mariru")
	await novel_interface.show_dialog("Ma non ha permesso a Elluka di usare il Grimorio... Forse vuole creare più streghe con esso.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ma ho letto il Grimorio di Elluka e non ho riconosciuto una sola parola. Ha qualcosa a che fare con il fatto che sono un ragazzo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("…ragazzo?", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka sembra nervosa e fa un passo indietro, con espressione perplessa.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Uh, Elluka, lo spiegherò più tardi. \\nNon preoccuparti...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("Ma potrei leggerlo. Quindi forse Lian è davvero solo un idiota, dopotutto?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Sono più curioso di sapere come potresti facilmente entrare nel bozzolo della strega.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Non l'ho chiesto io! Ogni volta che entro in zona c'è sempre qualcuno che vuole uccidermi...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—Quello che hai fatto prevede l'attraversamento di più dimensioni. La scienza non può spiegarlo al momento.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se la scienza può spiegare qualcosa, la prima cosa che voglio sapere è perché mi sono trasformata in una ragazza!")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Ih ih, mettilo da parte e basta. Qualsiasi domanda sarà risolta prima o poi!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Questo è il pensiero positivo...", "Lian")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
