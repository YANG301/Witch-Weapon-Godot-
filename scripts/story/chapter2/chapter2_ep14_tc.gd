# chapter2_ep14.gd - 第二章第14話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("但是我想變回男生啊……\n究竟怎麼做才行……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("嘛……索性就這麼當女孩子就好了啊~", "莉琉")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("誒——？？\n才！不！要！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("就像你說的，或許這座城市扭轉了毀滅的命運，上千萬的生命也因此復活……", "莉琉")
	await novel_interface.show_dialog("這種程度的奇蹟背後，總有某種代價吧？", "莉琉")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("如果代價……只是你變成這個樣子呢？", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("怎麼會……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("另外……\n你已經15歲了吧？", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("這個年紀的女孩子\n至少……也應該穿內衣吧？", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("哈？", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("你還在成長期，今後說不定越長越大……", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("欸——？？", "小憐")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不穿的話，會出問題喔。\n比如跑動的時候……", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("內、內衣該不會是……？！", "小憐")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("對啊，我覺得你應該適合那種可愛的少女風格吧？\n畢竟臉蛋是可愛型別的~", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("絕對不要！！\n我、我可是男生啊！！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("而且話說你的坐姿啊……\n真是意外的大膽呢~", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("我我我我……\n我要去衛生間了！！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("哎呀——\n那孩子……真是好捉弄呢~", "莉琉")
	await novel_interface.show_dialog("看來以後不會無聊了~", "莉琉")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("我看著鏡中的自己，回想著剛才的對話，身體靠牆緩緩的蹲了下去。")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("果然，難以相信啊……", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("那種東西……絕對不想穿啊！！", "小憐")
	await novel_interface.show_dialog("作為男人的我……\n感覺有某樣重要的東西……要離我遠去了！", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("而且，在買那種東西的地方被人看到的話……\n不行不行！絕對不可以！", "小憐")
	await novel_interface.show_dialog("（如果那樣做的話……）\n（那就真的是……變態了！！！）", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("我才不想做變態啊！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("哦？你還蹲在這哭啊\n已經按你的胸圍準備好了。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("誒？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("放在你的房間，就當送你的禮物了~", "莉琉")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不用！\n我用創可貼就好了！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("這孩子……到底是是純潔還是H啊~", "莉琉")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("雖然用膠布狀的創可貼可能……更加有趣。", "莉琉")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("難道你比較喜歡撕下來創可貼那一瞬的痛感嗎？", "莉琉")
	await novel_interface.show_dialog("可惜這裡只有噴霧型的創可貼哦~", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("你是故意的吧！！\n嗚……可惡！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("切，穿就穿~！\n堂堂男子漢有什麼可害羞的！！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("……嗯？咦？\n這個……好難啊……", "小憐")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("……嗯嗯", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("『啪嗒』")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("幫你扣好了~", "莉琉")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("莉琉？！\n你、你怎麼進來的？！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("好心幫幫你嘛~\n話說制服的長筒襪，你一個人能行嗎？", "莉琉")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("啊！？不就是幾雙襪子嗎，有什麼不行的！\n我還是自己來吧！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("那裙子呢？", "莉琉")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("裙子還是會的……我自己穿就好……\n莉琉你快出去！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("咦~你居然會穿裙子啊，還真了不起呢。", "莉琉")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("裙子又不用把手伸到後面扣扣子，有什麼難的！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("噗，好吧~\n一會我就來看看你穿成什麼樣子。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("可惡……太小看我了，莉琉那傢伙！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("一段時間後……")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("莉琉！我穿好了！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("你確定？", "莉琉")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("有什麼好確定的！這不好好的穿著呢麼！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("你的拉鍊……放在哪啊？", "莉琉")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("前面啊！方便上廁所嘛！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("嗯……你現在用什麼上廁所？", "莉琉")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("呃……", "小憐")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("這……這有什麼關係嘛！反正……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("噗……拉鍊是在旁邊的\n你去照照鏡子吧~", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("旁邊就旁邊……\n……", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("為什麼女生的衣服這麼難穿啊！！", "小憐")

	print("=== 第二章第14話結束 ===")

	# 呼叫劇情結束函式
	await novel_interface.end_story_episode(0.5)
