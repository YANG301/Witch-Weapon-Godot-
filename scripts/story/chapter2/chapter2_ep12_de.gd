# chapter2_ep12.gd - 第二章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep12_script()

func play_script():
	pass

func chapter2_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("Nachdem ich eine ganze Reihe von Registrierungsverfahren für die SID Kadettenausbildung abgeschlossen hatte, wurde mir ein dicker Stapel „Lehrbücher“ ausgehändigt.")
	await novel_interface.show_text_only("Dann fuhr ich unter Anleitung eines Mitarbeiters mit einem kleinen, unauffälligen Aufzug vom SID-Hauptquartier hinauf.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Der Aufzug stieg schnell genug an, dass ich deutlich spüren konnte, wie sich der Druck in meinen Ohren aufbaute.\nAls ich die Oberfläche erreichte, wurde mir klar, dass es bereits Abend war...")
	await novel_interface.show_text_only("Der Aufzug führte in die Lobby eines kleinen Bürogebäudes, und direkt davor befand sich das überfüllte Geschäftsviertel.")
	await novel_interface.show_text_only("Ich habe gehört, dass der Aufzug nur dann in die tieferen Etagen fahren kann, wenn er erkennt, dass es sich bei jedem Fahrgast um autorisiertes Personal handelt. Ansonsten fährt es nur zwischen dem ersten und dritten Stock des Bürogebäudes.") #换行问题
	await novel_interface.show_text_only("Im zweiten Stock des Gebäudes gab es ein 24-Stunden-Café, in dem den ganzen Tag über Leute kamen und gingen – perfekt, um sich vor aller Augen zu verstecken.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Seufz...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ich dachte, das Agententraining würde Dinge wie Nahkampf und Schießen beinhalten, aber das fühlt sich eher so an, als hätte ich mich für ein komplettes Nachhilfeschulpaket angemeldet...", "Lian")
	await novel_interface.show_dialog("Diese Bücher sind wirklich schwer!\nGut, dass der für mich arrangierte Ort Mariru nicht weit von hier entfernt ist.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Academy District East Road Nr. 6... Sie sagte, es sei ein sehr zurückhaltendes …", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","wail") 
	await novel_interface.show_dialog("—Wieso ist das überhaupt zurückhaltend?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich stand in einer Luxusresidenz im obersten Stockwerk eines Hochhauses. Das großzügige Wohnzimmer ist mit einer riesigen Terrasse mit Blick auf das nächtliche Geschäftsviertel verbunden.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Sind diese Flammen an der Wand ein echter Kamin?\nDas ist viel zu übertrieben...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gerade als ich mich vorsichtig umsah und mich fragte, ob ich den falschen Raum betreten hatte, erhielt ich eine Nachricht von Mariru.")
	await novel_interface.show_text_only("Mariru: Wählen Sie ein beliebiges Schlafzimmer aus, das Ihnen gefällt.\nSie müssen nicht höflich mit dem Budget des Senat umgehen~") #原文有个♥
	await novel_interface.show_text_only("Diese Frau... entschuldigt sich sofort bei den Steuerzahlern von New Opulentia!!")
	await novel_interface.show_dialog("Lian, du bist zurück!", "Annie")
	await novel_interface.show_text_only("Annie kam aus dem Badezimmer und fasste sich beim Gehen mit einer Hand die Haare.")
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Annie?! Bist du auch hier?\nMariru sagte, du wärst gerade zu einem Spezialtraining gefahren...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Ich habe die Schulung vorzeitig abgeschlossen. Ich habe gerade geduscht und die Schuluniform anprobiert.\nSieht so aus, als würden wir Mitbewohner sein~", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("R-Rechts...\n(Scheint, als hätte Mariru das erwähnt...)", "Lian")
	novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"shy_left")
	await novel_interface.show_dialog("(Ist das eine Art Prüfung vom Himmel?)\n(Unter einem Dach leben wie ein Mädchen und so...)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Ist das die Uniform dieser Schule? Es ist wirklich süß~", "Lian")
	novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Mm-hm~ Die Kleidung, die sie für dich vorbereitet haben, ist in der Kiste da drüben. Sie sollten sie auch anprobieren!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Ich-ich muss auch einen tragen...?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hehe, Lian, bist du es immer noch nicht gewohnt, ein Mädchen zu sein?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Als sie das ansprach, konnte ich nicht anders, als mich am Kopf zu kratzen und mich auf das Sofa fallen zu lassen.")
	novel_interface.show_character("anne_uniform","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Wie könnte sich jemand an so etwas gewöhnen...", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Niemand könnte verstehen, wie sich das anfühlt.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Ich verstehe.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie setzte sich plötzlich neben mich und strich leicht mit ihrer Fingerspitze über meine Wange, als wollte sie mich trösten.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("... Annie?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Weil wir gleich sind.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In ihrem Lächeln lag eine leichte Bitterkeit.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("W-Was-?!\nDu warst auch mal ein Junge?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ahahahahaha! Lian, bist du ein Idiot?", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ich war schon immer ein Mädchen~", "Annie")
	novel_interface.character_light(0.35,"shy_left")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agh...\n(Das ist beschämend!!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Gerade als meine Verlegenheit ihren Höhepunkt erreichen wollte, hörte Annie auf zu lachen und sah mich sanft an.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","normal2",0.25)
	await novel_interface.show_dialog("Aber die Panik in deinem Herzen im Moment... Ich verstehe sie wirklich vollkommen.", "Annie")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false)
	await novel_interface.show_dialog("Ich war auch schon einmal in einer anderen Raumzeit gefangen...\nDieses Gefühl war wahrscheinlich ein bisschen wie das, was du jetzt durchmachst.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Noch eine... Raumzeit?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie hielt inne, als würde sie sorgfältig darüber nachdenken, wie sie es formulieren sollte.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hat Miss Mariru es dir nicht gesagt?\nIch verbrachte eine sehr lange Zeit damit, in einer anderen Raumzeit zu treiben, ohne wirklich etwas zu verstehen...", "Annie")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Die Zeit fühlte sich dort vage an. Es kam mir nicht allzu lange vor, aber als ich zurückkam, wurde mir klar, dass bereits sieben Jahre vergangen waren.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mm, ich habe ein bisschen davon gehört...", "Lian")
	await novel_interface.show_dialog("(Obwohl das nur auf ein paar vereinzelte Hinweise zurückzuführen war, die Mariru fallen gelassen wurden...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Was genau ist mit ihr passiert?\nSoll ich sie direkt fragen?")
	await novel_interface.show_text_only("Annie wurde nicht fortgesetzt. Sie senkte einfach den Kopf und spielte geistesabwesend mit ihren Fingern.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Lian... Fühlst du dich auch jemals so?", "Annie")
	await novel_interface.show_dialog("Als ob das alles nur ein Traum wäre und wenn du das nächste Mal deine Augen öffnest, wirst du endlich aufwachen.", "Annie")
	await novel_interface.show_dialog("So sollten die Dinge nicht sein. Du solltest nicht hier sein...\nAber egal, was du tust, du kommst nicht zurück auf den normalen Weg.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("(Also Annie hat es mit solchen Gefühlen ganz alleine bis hierher geschafft...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich rückte etwas näher an Annie heran und klopfte ihr sanft auf die Schulter.\nÄh, ein Mädchen wie dieses zu trösten... sollte in Ordnung sein, oder?")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Hab keine Angst. Du bist jetzt zurück, nicht wahr?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Mm...\nAber für mich fühlt sich alles immer noch so ungewohnt an...", "Annie")
	await novel_interface.show_dialog("Ich habe nicht die geringste Ahnung, was Sie alle unter einer „Akademiestadt“ verstehen.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(... Richtig. Der Krieg war noch nicht einmal zu Ende, als Annie verschwand.)", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Das bedeutet also, dass Sie immer noch nicht wissen, was in den letzten Jahren passiert ist, oder?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Ich habe nur grob nachgeschaut... Im Laufe der Jahre ist so viel passiert, dass ich nicht einmal mehr verstehe, was viele der Wörter in den Nachrichten bedeuten sollen.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vor sieben Jahren...\nDas war mitten im Krieg, der die ganze Welt ins Chaos stürzte.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hä? Der Krieg?\nMeinen Sie die militärische Kampagne, die Masada Fort gegen Europa startete?", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie bemühte sich, sich zu erinnern.")
	novel_interface.show_character("ren_battle","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nein, das nicht. Nicht lange danach wurde fast jedes Land hineingezogen.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ich war damals in der Grundschule in einem Internat. Jeden Tag waren die Nachrichten voller Kriegsberichte und Opferzahlen. Es war eine ziemlich schreckliche Zeit...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Lian, hast du den Krieg auch miterlebt?", "Annie")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nicht ganz. Dank des Schutzes von Aegis konzentrierte New Opulentia damals alle seine Bemühungen auf den Wiederaufbau neben den Ruinen.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich blickte auf die wohlhabende Nachtlandschaft der Stadt hinter dem Fenster.... Als ich klein war, war die Stadt überall voller riesiger Kräne und geschäftiger Baumaschinen.")
	novel_interface.show_character("ren_battle","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das meiste, was ich weiß, stammt also aus Lehrbüchern.", "Lian")
	await novel_interface.show_dialog("Aufgrund des Krieges entwickelte sich die Wundertechnologie rasch weiter...\nUnd mit „Wunder“ meine ich Phänomene, die durch Substance H verursacht wurden.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Nach dem Krieg gründeten die sechs Länder, die die Schlüsseltechnologien beherrschten, jeweils eine der sechs Akademiestädte der Welt.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Es fühlt sich an, als hätte ich plötzlich ein verborgenes Talent für den Beruf eines Geschichtslehrers geweckt...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("So viel ist also wirklich passiert... Ich kann es mir gar nicht vorstellen.", "Annie")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nun, als Annie ging – äh, verschwand – war die Welt noch vergleichsweise friedlich, oder...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Das ist richtig. Damals konnte ich noch an internationalen Baseballspielen teilnehmen!", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("In dem Moment, als Annie Baseball erwähnte, begannen ihre Augen zu leuchten.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Weißt du, Lian, wann immer ich mit dem Schläger an der Reihe war, waren alle Augen der Zuschauer auf mich allein gerichtet!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Diese Mischung aus Anspannung und dem Zwang, alles geben zu müssen, würde mir das Blut im ganzen Körper zum Kochen bringen!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als es um Baseball ging, musste ich plötzlich an das schwarze Steinmonument vor dem Lebona-Baseballstadion denken, in das die Namen von Zehntausenden Toten eingraviert waren.")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Tatsächlich...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Hm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Vielleicht war es doch gut für Sie, die schlimmsten Kriegsjahre verpasst zu haben.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Wenn ich so darüber nachdenke, war es in gewisser Weise vielleicht auch nicht ganz schlecht, ein Mädchen zu werden und dich zu treffen\n...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie erstarrte. Für einen Moment sah sie fast verlegen aus...\nOder habe ich mir das nur eingebildet?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Lian... Eigentlich wollte ich dir die ganze Zeit danken.\nWeil... du es warst, der mich davor bewahrt hat, in dieser Welt umherzuirren.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Hä? Aber ich habe nichts getan...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genau deshalb musst du etwas Besonderes sein~", "Annie")
	await novel_interface.show_dialog("Ich weiß immer noch nicht, wie du das gemacht hast, aber in diesem Moment konnte ich spüren, wie deine warme Hand mich mitzog.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie nahm sanft meine Hand und versank in ihren Erinnerungen.")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn du nicht gewesen wärst, weiß ich nicht, wie lange ich dort noch gefangen geblieben wäre oder was am Ende aus mir geworden wäre...", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Werde... was?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahaha~ Es ist nichts. Das ist jetzt alles Vergangenheit.\nIch fühle mich plötzlich etwas schläfrig~", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie schien dem Thema ausweichen zu wollen.\nSie streckte sich träge und lächelte immer noch.")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Wie lange habt ihr beide vor, dieses Mädelsabendgespräch weiterzuführen?", "Mariru")
	await novel_interface.show_text_only("Marirus Stimme kam plötzlich aus dem Lautsprecher in der Ecke des Raumes.")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("M-Mariru?!\nHast du gerade zugehört?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Was? Stimmt etwas nicht, wenn ein Vormund den Zeitplan einiger Kinder im Auge behält?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Du hast wirklich den Mut, das zu sagen...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Sprichst du auch zurück?\nSieht so aus, als müsste ich dich morgen besonders hart trainieren...", "Mariru")
	novel_interface.character_light(0.35,"wail")
	await novel_interface.show_dialog("Es tut mir leid! Ich nehme ein Bad und gehe gleich ins Bett!\nGute Nacht!!", "Lian")

	print("=== 第二章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
