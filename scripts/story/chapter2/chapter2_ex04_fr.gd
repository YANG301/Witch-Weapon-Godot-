# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Avec la permission de Mariru, Annie et moi décidons d'aller faire du shopping avec Elluka.")
	await novel_interface.show_text_only("Elluka se tient derrière moi, regardant tout avec prudence.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, tu veux du chocolat ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, du chocolat, comme.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Vous y êtes.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka prend la barre de chocolat, la débballe soigneusement et prend une petite bouchée.")
	await novel_interface.show_text_only("Je ne peux pas en avoir assez d'elle. Si mignon!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hé, tu ressembles à un pervers d'âge moyen.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Quoi ?! Je ne suis qu'un adolescent.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervers.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pourquoi vous m'avez fait ça tous les deux ?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, je ne te donnerai pas de chocolat si tu continues à agir comme ça.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Bouh…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tirez. Elle a l'air mignonne même lorsqu'elle est déprimée.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Haha. C'est juste une plaisanterie. \\nVous y êtes.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Combien de chocolat as-tu ? \\nVous prendrez du poids si vous mangez trop.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Quel est le problème. J'ai juste quelques blocs.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me regarde avec un regard étrange, me mettant mal à l'aise.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("J'ai jeté un œil à votre récent rapport de contrôle physique. \\nVous avez pris du poids, mais vous n'avez pas grandi.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pourquoi as-tu fait ça ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Pour mieux vous connaître, évidemment.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Maintenant, je sais que tu ne mesures que cinq pieds trois. Pareil que moi.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bon sang. Il n'y a pas de quoi être fier.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Mais je mesurais 1,70 mètre quand j'étais petit !", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Cela ne fait pas beaucoup de différence, n'est-ce pas ?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Vous m'avez trompé... \\nJe n'aurais pas dû vous dire ça.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que Elluka apprécie son chocolat, la conversation attire son attention. Elle lève soudain les yeux, confuse.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Sœur Lian ?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Oui ?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Frère... Lian ?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sœur ? Frère? \\nDonnées corrompues. Inidentifiable.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka ! Oubliez ce que nous venons de dire !", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cible de nouvelle analyse. Femme identifiée... \\nSœur ? Frère?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaaahh ! Arrêt!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
