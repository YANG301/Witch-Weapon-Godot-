# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("ニュクス先輩が少し妙な表情で、\\nアニーを見つめている。")
	await novel_interface.show_text_only("綺麗な先輩が山のようなコレを大変そうに抱えていたので、思わず手伝いを申し出てしまった……")
	await novel_interface.show_text_only("感激しつつも俺の視界からすぐ消え去った先輩を見て、自分がバカだったという事に気付いた。")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ふー、やっと休める……暑い…死ぬ……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("はぁ……元の身体だったら、\\nこのくらいどうってことなかったのに……")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ここからまだSIDの訓練もあるなんて……\\nくそーどっかに隠れたい……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("レ、レンちゃん……あの……\\nここは……学校だよ？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("やあ、アニー。\\nどうしたの？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("暑いのはわかるけど。\\n服の裾をまくり上げて汗を拭くのは……\\n……あんまり良くないと思うの。", "アニー")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("その……丸見え。", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("やばい！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("あのレンっていう転校生……\\n粗野と言えば良いのでしょうか……", "生徒A")
	await novel_interface.show_dialog("そうよね～\\n前にも彼女が脚を開いて座っているのを見たわ。", "生徒B")
	await novel_interface.show_dialog("まあ本当に？　なんてはしたない……", "生徒A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…………………………………………\\n\\n（そもそも俺が、スカートを穿いてる事自体が\\n　間違いなんだから、仕方ないだろ！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("あの……")
	await novel_interface.show_text_only("物腰の柔らかい声が聞こえた。")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("ごきげんよう。\\nよろしければ、このハンカチをお使い下さい。", "エレガントな少女")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目の前に現れたのは、優雅な雰囲気を纏った\\n素敵な女性。\\nしなやかな紫色の長髪に、\\nライラックのような優しい瞳をしている。")
	await novel_interface.show_text_only("彼女が俺に差し出したハンカチ、\\nそれはすごくファビュラスな香りがした。")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("えっ？！\\nあ、ありがとうございますっ。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("あなた達は1年の新しい転校生ですよね？\\n私はニュクス・ストラッツィです。\\nあなた達の、先輩になるのかしら？", "ニュクス")
	await novel_interface.show_dialog("あなたが暑そうにしているのを見まして、\\n手元にハンカチがありましたから……\\nお邪魔でなければ、良いのですが。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ニュクスが礼儀正しく頷いた。俺も戸惑いながら\\n立ち上がった後、不器用に会釈を返した。")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("い、いいえっ！\\nとんでもない、助かりましたっ！", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("（優しい先輩だな…）\\n（外国の人かな、まつ毛が長い……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さっきの先輩、\\n名前がストラッツィって言ったよね？")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("そんなにかしこまらなくていいわ。\\nそれより……あなたのお名前は？", "ニュクス")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("俺はレン、彼女はアニーです。\\n俺達は最近ここに転校してきたばかりで……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……アニー？", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ニュクス先輩が少し妙な表情で、\\nアニーを見つめている。")
	await novel_interface.show_text_only("……と思ったけど、錯覚だったようだ。\\n\\n見変えれば彼女は、アニーへ友好的に\\n微笑んでいるだけだった。")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("お知り合いになれて嬉しいわ。", "ニュクス")
	await novel_interface.show_dialog("私はこれから少し用事がありまして、\\n本日はゆっくりとお話できませんが。\\nもし今後何かお困り事があれば、\\n私のところに是非、来て下さいね。", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("ありがとう先輩！", "小憐")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("……", "アニー")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("アニーは返事をせずに、何か少し躊躇っている。")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("今の先輩……この学校で出会ったお嬢様達の\\n中でも特別上品だったな。", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("アニーどうしたの？\\nさっきから黙っちゃって。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("さっきの先輩、\\n名前がストラッツィって言ったよね？", "アニー")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そう言ってたね。知り合い？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("アニーは俺の腕を引いて、真っ直ぐな笑顔を\\n浮かべた。")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("え？　全然そんな事はないよ～？\\n\\nあなたと一緒で転校してきたばっかりなのに、\\nどうやって知り合うのよ～～", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("それもそっか。", "小憐")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
