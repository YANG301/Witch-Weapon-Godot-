	await novel_interface.show_dialog("Et notre satellite a détecté un flux spatio-temporel dans la sous-station.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Flux spatio-temporel ? Serait-ce…", "Lian")
