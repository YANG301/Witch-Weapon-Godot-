# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Yeah… I'm also confused because it felt so real—unlike any dream.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("I've searched for news of fire or building damages, but there's nothing. \\nThe city looks just as peaceful as it used to be.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Except for one thing…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Except for what?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("When I woke up…", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("I found my body changed to a girl's body…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Well…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Huh? Did you say… it changed?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I'm not… I didn't look like this before…", GameConfig.player_name)
	await novel_interface.show_dialog("I… I am actually a boy!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwwww… a boy?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Okay… wait, what?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("You mean you're a boy cross-dressing? (leans close)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("No, no… That’s not what I mean. \\nDon't get this close!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("But… in some sense... \\nMaybe you're right…", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh god… how can I explain this!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Anyway… you've got a great boob job. (Touches)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("So bouncy… Where did you get it done? Such a natural touch…  (Pinches)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo… I want to find out too!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ouch! No… it's not… wait… \\nStop that!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Let me check… slender arms, curvy waistline, perfect.", "Mariru")
	await novel_interface.show_dialog("What materials did you use? Especially here…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhhh! That's itchy…!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Ms. Mariru! Don't touch it here!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("No…!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo…", GameConfig.player_name)
	await novel_interface.show_dialog("Believe it or not! I was a boy until yesterday!", GameConfig.player_name)
	await novel_interface.show_dialog("There was no surgery…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Yeah, no doubt about this.", "Mariru")
	await novel_interface.show_dialog("Such a complete gender change is impossible with current technologies.", "Mariru")
	await novel_interface.show_dialog("You cannot do this unless you replace every bone in your body. \\nWhich means, you are, and have been, a girl.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What! I've told you! \\nI woke up as a girl.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Do you have any proof? \\nAnything to prove that you used to be a boy?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Well… proof… \\nYeah right! My student ID card!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("We handed in all my belongings when entering here, including my clothes and ID card.")
	await novel_interface.show_text_only("Mariru taps on her hand-held device, which brings up my student card.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Yeah! That's it! \\nLook! That’s the proof.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("The facial features do look a bit like you, but this is hardly any proof…", "Mariru")
	await novel_interface.show_dialog("Right, pull up all footage of "+GameConfig.player_name+" captured by the city's surveillance system over the past month…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru deftly taps on her tablet, looking a bit excited.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("I thought it was only a dream when I saw those ruins, and I thought everything will go back to normal after waking up.", GameConfig.player_name)
	await novel_interface.show_dialog("But now, I become a girl…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Apply bone change corrections. Activate gait analyses on your footage at the corridor just now…", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignores my murmur and focuses on her tablet.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Maybe it's not a dream. But now, everything looks just fine. No fire, no destruction.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh… I'm totally confused…!", GameConfig.player_name)
	await novel_interface.show_dialog("Which parts of my memories were real, and which parts were just dreams…?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Gait pattern matches.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What does that mean?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Gait pattern is the signature control pattern of a person’s muscles when walking. Even the best agents can't disguise it.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Although current science can't explain it…\nYou really are "+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A… are you sure…?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Finally… I thought you guys knew something about this…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("So, have you heard of the Ross Goblet?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? A Substance H that suddenly disappeared under video surveillance, according to the news this morning… But I haven't seen it in person yet.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Well, if you're telling the truth…", "Mariru")
	await novel_interface.show_dialog("It will probably be the only reason that I would agree to give this boring lecture for free.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("It is a Substance H found on the Ross Islands. Four gems with remarkable purity are mounted on the exterior.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I did see something that looks like a shining goblet flying in the sky after I climbed out of the ruins.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("It floated in the sky, emitting a faint red light…", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Faint red?", "Mariru")
	await novel_interface.show_dialog("(The faint red liquid in the goblet has been a mystery…)", "Mariru")
	await novel_interface.show_dialog("(But that information is classified. It was never made public, even after it was rated 'Safe' not long ago.)", "Mariru")
	await novel_interface.show_dialog("(No one could give such details without having seen it before…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Regardless of whether it was a dream, I’m afraid we need to confirm more information with you.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
