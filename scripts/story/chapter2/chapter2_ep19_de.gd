	await novel_interface.show_text_only("Annie versucht optimistisch zu wirken, aber sie kann die Trauer in ihren Augen nicht verbergen. Die Luft wird plötzlich schwer")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("… Annie", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Also, lass mich sie spüren –\\nAha!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie umarmt mich unerwartet von hinten.")
