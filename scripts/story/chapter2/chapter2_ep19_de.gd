	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wie das Aussehen des Kampfanzugs ... \\nSo eine Demütigung!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Es ist offensichtlich sehr cool!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Das Oberteil passt nicht mehr? \\nMöchten Sie eine neue Messung?", "Mariru")
	novel_interface.character_light(0.35,"awkward")
