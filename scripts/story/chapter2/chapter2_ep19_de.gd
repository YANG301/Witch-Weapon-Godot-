	await novel_interface.show_dialog("Haben Sie schon von der Johnson Substation gehört?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das superriesige Umspannwerk an der Ostküste?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("(Es handelt sich um ein gemeinsam verwaltetes Gebiet der sechs Akademiestädte innerhalb des Schutzgebiets von Aegis. Dort fanden Nachkriegsfriedensgespräche statt.)")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Genau. Wir haben gerade Alarme von einem Dutzend Relaisstationen erhalten, die starke Überspannungen im Nordosten anzeigen.", "Mariru")
	await novel_interface.show_dialog("Und unser Satellit hat einen Raumzeitfluss in der Umspannstation entdeckt.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Raumzeitfluss? Könnte es sein ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Wenn die Daten korrekt sind, wäre die Situation dieselbe wie die, die Sie zuvor durchgemacht haben.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sie sind noch nicht als Außendienstmitarbeiter qualifiziert ...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Aber das Umspannwerk liegt innerhalb der „vereinbarten entmilitarisierten Zone“, was bedeutet, dass SID nicht befugt ist, dort Operationen durchzuführen, obwohl es sich in New Opulentia befindet.", "Mariru")
	await novel_interface.show_dialog("Es kann als kleiner Kompromiss für den „Weltfrieden“ angesehen werden.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Also, ich möchte, dass Ihr losgeht und das Umspannwerk auskundschaftt. SID-Teams stehen am Rand bereit.", "Mariru")
