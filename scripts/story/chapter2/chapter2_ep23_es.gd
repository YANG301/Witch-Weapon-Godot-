# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka nos ataca a Annie y a mí con magia de relámpago. Al no querer hacerle daño, lo único que podemos hacer es defendernos desesperadamente.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Si esto sigue así, todos saldremos heridos...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ja… Ahh… \\nElluka, ¡detente! ¡Cálmate!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Objetivo bloqueado. Ataque continuo", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un golpe ardiente atravesó el aire, seguido de un estruendo. \\nAbro los ojos y me encuentro ileso.")
	await novel_interface.show_text_only("Detrás del Administrador, el rotor principal del avión se vuelca lentamente y luego cae como una ramita rota.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Administrador")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ejem... ¡Todos se congelan——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("La voz de Mariru suena desde un altavoz en la distancia.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("¡Señorita Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tres helicópteros aparecen sobre nosotros y sus reflectores cegadores bañan el suelo de blanco como si fuera plena luz del día.")
	await novel_interface.show_text_only("Mariru está sentado en el helicóptero del medio, gritando a través de un altavoz. La enorme pistola montada frente a ella todavía humea.")
	await novel_interface.show_dialog("El pequeño juguete de Ai realmente tiene un gran impacto. De hecho, eliminó el eje del rotor de un solo disparo.", "Mariru")
	await novel_interface.show_text_only("Mariru suena demasiado emocionada, como si le encantara disparar otra ronda... Oye, esa cosa ya cuenta como un cañón, ¿no?")
	await novel_interface.show_text_only("La cabina del transporte accidentado se abre desde dentro y dos pilotos salen dando tumbos presas del pánico, luchando por sus vidas.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ja... jaja...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un helicóptero aterriza en el terreno abierto fuera de la subestación. Escoltado por una multitud de soldados fuertemente armados, Mariru avanza hacia nosotros muy animado.")
	await novel_interface.show_text_only("Habiendo visto claramente el rostro de Mariru, el Administrador escupió ferozmente en el suelo.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph. Otro SID perro faldero.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Esta no es una operación SID. Estoy aquí como asesor del Metropolitan Defense Bureau de New Opulentia, llevando a cabo una misión de seguridad para suprimir disturbios.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sólo entonces me doy cuenta de que las personas que bajaron de los helicópteros no son SID agentes en absoluto. Cada uno de ellos lleva un brazalete marcado \"MD\".")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("¿No es así... Capitán Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Así es. El Metropolitan Defense Bureau sospecha que aquí se está llevando a cabo un ataque terrorista contra New Opulentia.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Por la presente ordeno a usted y a sus hombres que cesen las hostilidades inmediatamente y regresen con nosotros para ser interrogados.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Ese musculoso con apariencia de luchador de ahí... Juro que lo he visto antes... ¿Es uno de los conocidos de Mariru?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Esas dos lindas chicas son tus subordinadas? Un departamento sin límite de edad suena bastante bien...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... este pequeño...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oye, ¿estás seguro de que quieres hacer esto?", "Administrador")
	await novel_interface.show_dialog("Esta es una zona desmilitarizada según el Acuerdo. Ninguna de sus organizaciones tiene la autoridad para operar aquí.", "Administrador")
	await novel_interface.show_dialog("¡Y no hay forma de que hubieras obtenido el permiso del Congreso Unido tan rápido!", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Esas burocracias multinacionales se mueven a paso de tortuga.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... Lamento decepcionarte, pero llevaré a mi gente y me iré ahora.", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ Aún no he terminado de hablar... Johnson Heavy Industries, por otro lado, trabaja mucho más rápido.", "Mariru")
	await novel_interface.show_dialog("Después de todo, su hijo mayor todavía está estudiando en New Opulentia~ Ahora mismo son ellos los que me piden favores...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("¡¿Qué?!", "Administrador")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("En este momento, el tres por ciento de la carga de esta subestación ya se ha inyectado a la red de la ciudad de New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Según el Acuerdo de Salmonton, cualquier ataque contra la red eléctrica de New Opulentia se considera un acto terrorista de primera clase.", "Mariru")
	await novel_interface.show_dialog("Para incidentes como este, el Metropolitan Defense Bureau tiene la máxima autoridad operativa reconocida por el Congreso Unido.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Después de todo, nuestro Aegis host… \\nNo puede funcionar sin energía.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("¿Cómo podrías ejecutar Aegis fuera de la red de la ciudad? ¡Corta los trucos!", "Administrador")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Basta de hablar. ¡Llévatelos!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...¡Espera! Masada Fort y New Opulentia firmaron un acuerdo de inmunidad diplomática hace mucho tiempo, ¿no?", "Administrador")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("El Administrador saca su identificación del bolsillo de su abrigo y se la muestra con aire de suficiencia a Mariru y Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Soy Jacob Schmidt, agregado militar de la Tercera Ciudad Academia, Fuerte Masada, ante el Congreso Unido.", "Administrador")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si me arrestan aquí, supongo que causarán problemas diplomáticos bastante innecesarios, ¿no es así?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("…\\nMuy bien. Tienes un minuto para perderte de vista.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Pero parece que tu vehículo tiene algunos fallos... \\nEntonces, es posible que tengas que caminar hasta casa.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("¡¿Qué?! ¡Eso no es justo!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Las reglas son reglas. Un impulso apasionado no solucionará nada.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Pero…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, nos vamos.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Espera, tu identidad ha sido verificada, lo cual está bien. Pero esta niña… no creo que ocupe ningún cargo en su Ministerio de Asuntos Exteriores.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...¡¡Tú!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Lo siento, pero ella es la principal sospechosa del ataque terrorista de hoy.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Si intenta tomarla por la fuerza, todo lo que puedo hacer es informar a su embajada con pesar que lo mataron a tiros en un ataque terrorista.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru saca una pistola y la apunta contra la cabeza de Jacob.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... Ella no es más que una herramienta.\\nSi tanto la quieres, ¡quédate con ella!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Nivel de potencia, crítico... \\nHah... Actividad terminada...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, que se había estado obligando a seguir adelante todo este tiempo, de repente colapsa en el suelo como una máquina que ha perdido potencia.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. En ese estado, probablemente sea inútil de todos modos. ¡Ocúpate tú mismo de la chatarra sin valor!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob se levanta el cuello y acelera el paso, sin mirar atrás. Pronto desaparece en la oscuridad.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, ¡despierta! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, ¡ayúdala por favor!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Ella todavía aparece en el detector de vida. Probablemente simplemente esté agotada.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("¿Y tú, alguien que todavía necesita protegerse, estás aquí gritando acerca de salvar a otras personas?", "Mariru")
	await novel_interface.show_dialog("...Te estás convirtiendo cada vez más en un idiota de sangre caliente.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Vámonos a casa.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Esa chica es nuestra enemiga, ¿no?", "Nantetsu")
	await novel_interface.show_dialog("¿No exige la Senado que todos los terroristas de primera clase sean detenidos inmediatamente y luego...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haga que cada helicóptero mantenga sus módulos anti-escaneo funcionando continuamente. Haré que los cuatro UAV de SID nos escolten en modo de contraataque automático.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Mi gente... los escoltaré personalmente. ¡Cualquiera que tenga deseos de morir puede probarme!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Jajaja… Ese es el Mariru que conozco.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru hace que el equipo médico trate nuestras heridas, luego nos lleva a Annie, a Elluka y a mí a bordo del helicóptero.")
	await novel_interface.show_text_only("Annie está muy cansado. Se apoya en mi hombro y pronto se queda dormida.")
	await novel_interface.show_text_only("Elluka también está dormida, tumbada en mi regazo con un poco de baba en la comisura de la boca. No queda nada de esa mirada gélida que tenía hace apenas unos minutos.")
	await novel_interface.show_text_only("Ella es solo una niña común y corriente después de todo... y por alguna razón, eso me llena de alivio.")
	await novel_interface.show_text_only("Todo estará bien. Todo saldrá bien, tal como dice esa canción:\\nTodo estará bien.")
	await novel_interface.show_text_only("Aunque ahora reina la paz entre las seis Ciudades Academia, vastas regiones fuera de su control todavía están asoladas por la guerra.")
	await novel_interface.show_text_only("Me pregunto cuántos niños como Elluka siguen siendo utilizados como armas o herramientas...")
	await novel_interface.show_text_only("Mariru tenía razón. Soy un idiota que siempre muerde más de lo que puedo masticar.")
	await novel_interface.show_text_only("Pero casi nunca he conocido a nadie dispuesto a bajar la guardia y quedarse dormido tranquilamente a mi lado. Ahora son dos.")
	await novel_interface.show_text_only("… Me gusta ser un idiota.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
