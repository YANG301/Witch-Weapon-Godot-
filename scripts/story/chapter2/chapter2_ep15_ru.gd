# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Эх... Эта юбка все еще слишком короткая...\nПод ней очень холодно...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Слишком много невероятных вещей произошло за последние несколько дней.\nМой мозг уже едва справляется...", "Lian")
	await novel_interface.show_dialog("Сон о разрушении города, проснувшись однажды утром и обнаружив, что я превратился в девушку, и на меня напал какой-то совершенно необъяснимый враг...", "Lian")
	await novel_interface.show_dialog("Ничто из этого не кажется реальным.\nИ вдобавок ко всему...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, заходите.", "Классный руководитель")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ах, д-да!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Н-Н-Н-Приятно познакомиться с вами впервые!\nПривет всем, меня зовут Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Я очень рад стать со всеми вами одноклассниками, поэтому, пожалуйста, позаботьтесь обо мне с этого момента...\n...", "Lian")
	await novel_interface.show_dialog("(...Хотя я становлюсь твоей одноклассницей в образе старшеклассницы, нравится мне это или нет...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Пожалуйста, пощадите меня...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Хорошо, тогда Lian, займи свободное место в заднем ряду.", "Классный руководитель")
	await novel_interface.show_dialog("(...Переведенный студент на данном этапе семестра? Это необычно.)", "Одноклассник А")
	await novel_interface.show_dialog("(...Она продолжает смотреть в пол. Могу поспорить, она очень тихая, да?)", "Одноклассник Б")
	await novel_interface.show_dialog("(...Но она очень милая... Это цвет волос, покрашенный?)", "Одноклассник А")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Все смотрят на меня...\nУх... дорога впереди будет трудной...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Уф, занятия наконец закончились... Школьная жизнь еще никогда не была такой утомительной.\nВ конце концов, школа с высокими достижениями действительно другая...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Чёрт... Мне нужно в туалет...)", "Lian")
	await novel_interface.show_dialog("(Н-Ни в коем случае, я категорически не могу зайти в туалет для девочек в школе...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ох, что мне делать...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Что случилось~ Почему ты так вздыхаешь?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("А? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Итак? Ты хорошо адаптируешься в новой школе? Здесь много очень милых девушек~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ух... давай не будем сейчас об этом.\nТвое базовое обучение уже закончилось?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Хе-хе, я пришел, как только прошел оценку! Если я оставлю тебя здесь одну, кто знает, что с тобой может случиться.", "Annie")
	await novel_interface.show_dialog("К счастью, меня не было надолго, а New Opulentia сейчас город иммигрантов, так что мне, вероятно, не составит труда адаптироваться.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Мисс Mariru также попросила меня позаботиться о вас~\nОна специально организовала, чтобы мы учились в одном классе.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Я взрослая мама—\nВ любом случае, мне не нужна забота обо мне~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Хе-хе, кроме того, я чувствую себя гораздо спокойнее, когда я рядом с тобой...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Я слышал, что вы вызвались присоединиться к SID вместе со мной.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie выглядел благодарным. На мгновение я потерял дар речи и понятия не имел, смогу ли я на самом деле пройти тесты гладко...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ах да, школьная медсестра попросила меня передать сообщение. Она хочет, чтобы вы пошли к ней на медицинский осмотр.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("А-медицинский осмотр!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Мы переведенные ученики, поэтому школе приходится проводить для нас отдельные осмотры~\nИли ты расстроен, что пропустил это вместе со всем классом...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Конечно нет!!\nЯ понимаю, но перед этим...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Комната отдыха......)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Я тебя не слышу... Скажи это громче~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Эм, не мог бы ты отвести меня в туалет...?", "Lian")
	await novel_interface.show_dialog("Если я пойду один... я буду чувствовать себя слишком виноватым. Я не смею войти один...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Пфф...\nИ после того, как ты сказал, что тебе не нужна чья-то забота~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Ладно уже... поторопитесь...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...О медицинском осмотре...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...Тот факт, что я был мальчиком, не будет раскрыт, верно?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Что они вообще проверяют во время медицинского осмотра?)", "Lian")
	await novel_interface.show_dialog("(И подождите... мне нужно раздеться?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Хорошо, что я не поленился и сегодня надел нижнее белье...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(Лазарет... здесь?)", "Lian")
	await novel_interface.show_dialog("Извините, я переведенный студент на медосмотр...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Идеальное время. Я ждал тебя.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("А-А-А-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Вау, нет, почему это ты сдаешь экзамен?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("А???\nAi, п-стоп, прекрати——!!", "Lian")
	await novel_interface.show_dialog("Подождите... Что это за странный инструмент, который ты держишь в руках??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Ваааааа--!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ух... почему это происходит...", "Lian")
	await novel_interface.show_dialog("Они могли бы пропустить все это и это, не так ли...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Вы слишком преувеличиваете.\nЭто обычный осмотр, рутина~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... Зрение обоих глаз 2,0. Это абсолютно идеально.\nИзменилось ли это по сравнению с вашими старыми данными?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А? Мой левый глаз раньше был 1,0, а правый — 0,7.\nДоктор даже сказал мне сидеть подальше, когда я играл в игры...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Как очаровательно... Ваше тело выглядит так, будто оно было реконструировано с нуля, вплоть до костей.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("И все же нейронная топология вашего мозга одновременно демонстрирует черты обоих полов, поэтому ваши воспоминания и образ мышления сохранились... так?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai звучал настолько взволнованно, что дрожал.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Если это так... то теоретически вам также следует осознавать, что вы становитесь более чувствительными к эмоциям других людей.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Н-Ни в коем случае...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Абсолютно нет! Я стопроцентный мужчина!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("В любом случае, с медицинской точки зрения, вы, без сомнения, стопроцентная женщина.\nСо здоровьем у вас всё в порядке, за исключением одного...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Кроме чего?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Через некоторое время вы почувствуете приступ боли в животе. В остальном проблем нет вообще~\nОно должно скоро появиться, так что будьте готовы.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Боль в животе...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... Что-—???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ух... Ai, ты!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Я чувствовал себя настолько обиженным и бессильным, что был на грани слез....\nУх, я должен быть мужчиной — не плачь!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Мм, мм, это действительно прекрасно... Редко можно увидеть кого-то твоего возраста, у которого на теле не будет ни единого шрама.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("Меня это совсем не радует!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Хм, могу я вернуться сейчас...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai сняла свой белый лабораторный халат, сделала вид, что «теперь я серьезно настроена», и вытащила из гардероба два наряда...")
	await novel_interface.show_dialog("О чём ты говоришь?\nСамое интересное только начинается...", "Ai")
	await novel_interface.show_dialog("Mariru уже одобрил это, так что я могу Lian примерить разную одежду...", "Ai")
	await novel_interface.show_dialog("Э-э-?", "Lian")
	await novel_interface.show_dialog("А потом... хе-хе-хе, я также собираюсь изучить каждую точку данных Lian.", "Ai")
	await novel_interface.show_dialog("Дааааааааааа~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
