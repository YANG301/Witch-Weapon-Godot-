# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Sigh... Questa gonna è ancora troppo corta...\nSembra tutto freddo sotto...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Sono successe troppe cose incredibili negli ultimi giorni.\nIl mio cervello riesce a malapena a tenere il passo...", "Lian")
	await novel_interface.show_dialog("Il sogno della città che veniva distrutta, svegliarmi una mattina per scoprire che mi ero trasformata in una ragazza e venire attaccata da un nemico del tutto inspiegabile...", "Lian")
	await novel_interface.show_dialog("Niente di tutto ciò sembra reale.\nE oltretutto...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, entra.", "Insegnante di casa")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ah, sì!", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-Piacere di conoscervi per la prima volta!\nCiao a tutti, mi chiamo Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Sono molto felice di diventare compagno di classe di tutti voi, quindi per favore prendetevi cura di me da ora in poi...\n...", "Lian")
	await novel_interface.show_dialog("(...Anche se sto diventando tua compagna di classe sotto forma di una liceale, che mi piaccia o no...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...Per favore, risparmiami...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Va bene allora, Lian, prendi il posto vuoto nell'ultima fila.", "Insegnante di casa")
	await novel_interface.show_dialog("(...Uno studente trasferito a questo punto del trimestre? È insolito.)", "Compagno di classe A")
	await novel_interface.show_dialog("(...Continua a fissare il pavimento. Scommetto che è davvero silenziosa, eh?)", "Compagno di classe B")
	await novel_interface.show_dialog("(...Ma è davvero carina... Quel colore di capelli è tinto?)", "Compagno di classe A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Tutti mi guardano...\nUgh... la strada da percorrere sarà dura...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uff, la lezione è finalmente finita... La vita scolastica non è mai stata così faticosa.\nDopo tutto, una scuola ad alto rendimento è davvero diversa...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Merda... Devo usare il bagno...)", "Lian")
	await novel_interface.show_dialog("(N-Assolutamente no, non posso assolutamente entrare nel bagno delle ragazze a scuola...!)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Uffa, cosa dovrei fare...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Cosa c'è che non va~ Perché sospiri così tanto?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Eh? Annie!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Allora? Ti stai ambientando bene nella nuova scuola? Ci sono un sacco di ragazze molto carine qui~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uffa... non parliamone adesso.\nIl tuo corso di formazione sulle conoscenze di base è già finito?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Hehe, sono venuto non appena ho superato la valutazione! Se ti lasciassi qui tutto solo, chissà cosa potrebbe succederti.", "Annie")
	await novel_interface.show_dialog("Fortunatamente non sono stato via per molto tempo, e New Opulentia è una città di immigrati adesso, quindi probabilmente non avrò troppe difficoltà ad adattarmi.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("La signorina Mariru mi ha anche chiesto di prendermi cura di te~\nHa specificamente organizzato che fossimo nella stessa classe.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Sono una mamma adulta—\nComunque, non ho bisogno che nessuno si prenda cura di me~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Eheh, poi mi sento molto più a mio agio anche quando sono al tuo fianco...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Ho sentito che ti sei offerto volontario per unirti a SID insieme a me.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie sembrava grato. Per un momento sono rimasto senza parole e non avevo idea se sarei stato effettivamente in grado di superare i test senza problemi...")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh, giusto, l'infermiera della scuola mi ha chiesto di passarle un messaggio. Vuole che tu vada a trovarla per un esame fisico.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("A-Un esame fisico!?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Siamo studenti trasferiti, quindi la scuola deve darci controlli separati~\nO sei arrabbiato per non averlo fatto insieme a tutta la classe...?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Certo che no!!\nHo capito, ma prima...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ehm?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Camera di riposo......)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Non riesco a sentirti... Dillo più forte~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Uhm, potresti portarmi in bagno...?", "Lian")
	await novel_interface.show_dialog("Se entrassi da solo... mi sentirei troppo in colpa. Non oso entrare da solo...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nE dopo che hai detto che non avevi bisogno che nessuno si prendesse cura di te~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Va già bene... sbrigati...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...Informazioni sull'esame fisico...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...Il fatto che ero un ragazzo non verrà scoperto, giusto?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Cosa controllano di nuovo durante un esame fisico?)", "Lian")
	await novel_interface.show_dialog("(E aspetta... devo togliermi i vestiti?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Meno male che oggi non sono diventato pigro e mi sono messo la biancheria intima...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(L'infermeria... è qui?)", "Lian")
	await novel_interface.show_dialog("Mi scusi, sono lo studente trasferito qui per l'esame fisico...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Tempismo perfetto. Ti stavo aspettando.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("A-A-A-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, no, perché sei tu a fare l'esame?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Eh???\nAi, s-basta, smettila——!!", "Lian")
	await novel_interface.show_dialog("Aspetta... Cos'è quello strano strumento agitato che hai in mano??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Waaahhhh——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Uffa... perché sta succedendo questo...", "Lian")
	await novel_interface.show_dialog("Avrebbero potuto saltare tutte queste cose e quelle cose, no...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Stai esagerando troppo.\nÈ solo un esame di routine, routine~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... La visione in entrambi gli occhi è 2,0. È assolutamente perfetto.\nÈ cambiato rispetto ai vecchi dati?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh? Il mio occhio sinistro era 1.0 e il mio destro era 0.7.\nIl dottore mi ha persino detto di sedermi più lontano quando giocavo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Che fascino... Il tuo corpo sembra ricostruito da zero, fino alle ossa.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Eppure la topologia neurale del tuo cervello mostra contemporaneamente tratti di entrambi i sessi, motivo per cui i tuoi ricordi e i tuoi schemi di pensiero sono stati preservati... è così?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai sembrava quasi eccitato al punto da tremare.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Se è così... allora, in teoria, dovresti anche essere consapevole che stai diventando più sensibile alle emozioni degli altri.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-Assolutamente no...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Assolutamente no! Sono maschio al cento per cento!", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Comunque, da un punto di vista medico, sei donna al cento per cento senza dubbio.\nLa tua salute va benissimo, tranne che per una cosa...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Tranne cosa?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tra poco avvertirai un attacco di dolore addominale. A parte questo, non ci sono problemi di sorta~\nDovrebbe arrivare presto, quindi assicurati di essere preparato.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mal di stomaco...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... Cos'è——???", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Uffa... Ai, tu!!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mi sono sentito così offeso e impotente che ero sull'orlo delle lacrime...\nUgh, dovrei essere un uomo, non piangere!!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, è davvero perfetto... È raro vedere qualcuno della tua età senza una sola cicatrice in qualsiasi parte del corpo.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("Ciò non mi rende affatto felice!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ehm... posso tornare indietro adesso...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai si è tolta il camice bianco, ha assunto un'espressione che diceva \"ora sto diventando serio\" e ha tirato fuori due abiti dall'armadio...")
	await novel_interface.show_dialog("Di cosa stai parlando?\nLa parte divertente è solo all'inizio...", "Ai")
	await novel_interface.show_dialog("Mariru l'ha già approvato, quindi posso farmi provare Lian tutti i tipi di vestiti diversi...", "Ai")
	await novel_interface.show_dialog("E-Eh—?", "Lian")
	await novel_interface.show_dialog("E poi... hehehehe, studierò anche ogni singolo punto dati di Lian.", "Ai")
	await novel_interface.show_dialog("Yaaahhhhhhhhhhh~~~!", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
