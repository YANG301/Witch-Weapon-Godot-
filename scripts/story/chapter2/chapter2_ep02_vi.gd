	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Được rồi, tôi hiểu. Tôi sẽ đi cùng bạn.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Hả?? Tại sao bạn lại đi với họ?!\nNày!"+GameConfig.player_name+"!", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-đừng kéo nữa! Chiếc váy ngu ngốc của tôi sắp tuột ra rồi!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Bạn là thằng ngốc! Tại sao bạn lại đi với những người đáng ngờ này? Điều gì sẽ xảy ra nếu họ đánh thuốc mê bạn và bán bạn đi đâu đó?!", "Annie")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mọi người sẽ muốn gì ở một người trưởng thành như tôi...", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Đợi đã, không—ai lại tổ chức một hoạt động buôn người với nhiều người như vậy và tạo ra cảnh tượng như vậy?!", GameConfig.player_name)
