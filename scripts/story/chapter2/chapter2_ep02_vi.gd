	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Báo cáo từ vùng cách ly cốt lõi: hai mục tiêu không có ý định thù địch.\nMức độ đe dọa tạm thời được đặt thành D+.", "SID Đại lý")
	await novel_interface.show_dialog("Hãy bắt đầu với một vài câu hỏi đơn giản...\nBạn là ai, và bạn đang làm gì mà lẻn vào đây?", "SID Đại lý")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Tôi là sinh viên đến từ thành phố này...", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Chúng tôi ch-chỉ đến đây trong một chuyến đi thực tế để tham quan viện nghiên cứu...", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người đặc vụ mặc đồ đen nhìn chúng tôi bằng ánh mắt khinh thường.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Có phải vậy không - một chuyến tham quan? Của viện?", "SID Đại lý")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("Ôi không...\nTôi chợt nhớ ra—")
	await novel_interface.show_text_only("Vì sự biến mất của 'Roskin Cup', viện đã bị phong tỏa khẩn cấp kể từ tối qua.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Bước ra khỏi đó một cách trắng trợn vào thời điểm như thế này và tuyên bố rằng chúng tôi chỉ đến thăm... về cơ bản đó là một lời tỏ tình.")
	await novel_interface.show_text_only("Đúng như dự đoán, cô ấy dường như nhận được chỉ dẫn nào đó qua tai nghe và nhìn tôi bằng ánh mắt nghiêm nghị.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("Tôi đã nhận được lệnh từ cấp trên. Hai bạn sẽ đi cùng chúng tôi.", "SID Đại lý")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Chỉ trong vài giây, cả hai chúng tôi đã bị bao vây hoàn toàn.")
	await novel_interface.show_text_only("Nhìn đâu tôi cũng thấy một bức tường nòng súng chĩa thẳng vào chúng tôi.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", những người này trông thực sự là tin xấu...\nTại sao chúng ta không chờ đợi cơ hội và chạy theo nó?", "Annie")
