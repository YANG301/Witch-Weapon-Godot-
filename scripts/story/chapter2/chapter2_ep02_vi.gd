	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Tại-tại sao nhiều người đột nhiên xuất hiện?!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah—Annie!\nMau thay quần áo lại cho tôi!!", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Bộ quần áo này xấu hổ quá...\nTôi thực sự không muốn ai nhìn thấy tôi như thế này...", GameConfig.player_name)
