	await novel_interface.show_dialog("Bạn nên hiểu rằng sự biến mất của một 'vật thể dị thường' không phải là chuyện nhỏ. Nó có thể gây ra những sự kiện vượt xa lẽ thường, vì vậy hãy hợp tác.", "SID Đại lý")
