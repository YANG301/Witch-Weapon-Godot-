	await novel_interface.show_dialog("Quần áo của bạn đều được tôi giữ an toàn nên đừng lo lắng...", "Annie")
	await novel_interface.show_dialog("Nếu bạn thực sự muốn thay đổi, chỉ cần cởi 'bộ trang phục chiến đấu' bạn đang mặc và mặc lại bộ quần áo rộng thùng thình thường ngày của bạn~", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Nhưng phía trước có rất nhiều người đàn ông...\nBạn có thực sự muốn thay đổi ngay trước mặt họ không?", "Annie")
	novel_interface.character_light(0.35,"shy_right")
