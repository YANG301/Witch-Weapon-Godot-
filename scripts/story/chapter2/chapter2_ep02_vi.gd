	await novel_interface.show_text_only("...")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Dừng lại ngay tại đó!\nĐặt tay bạn ở nơi tôi có thể nhìn thấy!", "SID Đại lý")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Một người mặc bộ đồ đen bước tới và hét vào mặt chúng tôi.")
