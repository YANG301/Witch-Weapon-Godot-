	await novel_interface.show_dialog("... Báo cáo R!", "Đặc vụ B")
	await novel_interface.show_dialog("Hai đơn vị hình người đã xuất hiện trong tầm nhìn, ngay trong vùng lõi dị thường...", "Đặc vụ B")
	await novel_interface.show_dialog("Con người...?\nLàm sao có thể?! Quá trình quét memetic cho thấy điều gì??", "Đặc vụ A")
	await novel_interface.show_dialog("Màu sắc là...\nXanh lục!!", "Đặc vụ B")
	await novel_interface.show_dialog("Họ có vẻ là hai cô gái trẻ...\nGiữ lửa! Hãy giữ lửa!", "Đặc vụ B")
	await novel_interface.show_dialog("...", "Đặc vụ A")
	await novel_interface.show_dialog("Chúng tôi vừa nhận được mệnh lệnh: ưu tiên hàng đầu là bảo vệ họ và đưa họ về trụ sở chính.\nGửi một đặc vụ cấp cao đến đàm phán—", "Đặc vụ A")
