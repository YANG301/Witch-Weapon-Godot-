	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mhm~ Thực ra thì,"+GameConfig.player_name+"là loại người bị mùi hương của người khác giới hớp hồn phải không? Không cần phải xấu hổ...", "Annie") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Đừng làm bộ mặt kiểu 'Bạn có thể là một kẻ hư hỏng, nhưng dù thế nào tôi cũng sẽ chấp nhận bạn'!!!", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Thở dài... Tôi vẫn hoàn toàn không hiểu tại sao mình lại trở nên như thế này...", GameConfig.player_name)
