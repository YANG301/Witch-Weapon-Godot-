	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Huh...?\nHọ có nghĩ chúng ta là kẻ xấu không?", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("(Đợi đã, phù hiệu trên ngực của thủ lĩnh...)\n(Một chiếc khiên hình tròn, hình chiếc nhẫn hoàn hảo—đừng bảo với tôi rằng đó là...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Hai người, tôi là đặc vụ SID.\nVì sự an toàn của chính các bạn, hãy giữ tư thế đó và đừng di chuyển.", "SID Đại lý")
