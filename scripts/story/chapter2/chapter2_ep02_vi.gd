	await novel_interface.show_dialog("Ugh...\nNhưng tôi là gu...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Nghĩ lại thì... ban nãy cậu đã mặc quần áo nam!\nCó lẽ nào—", "Annie")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hả? Bạn cũng từng rơi vào hoàn cảnh như thế này à???", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Điều đó có lý... Annie có lẽ cô ấy cũng không phải là một người bình thường phải không?)", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Nếu là Annie, có lẽ cô ấy có thể hiểu được những gì tôi đang trải qua...)", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ừm, tôi hiểu rồi...", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Bạn là kiểu người lén lút mượn quần áo của chàng trai bạn thích và tự mình mặc phải không?", "Annie")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Đó không phải là 'hiểu được' chút nào!!!", GameConfig.player_name)
