	await novel_interface.show_dialog("...Xin lỗi, cấp trên của tôi đã nói, 'Bộ trang phục đó rất dễ thương' và thẳng thừng từ chối yêu cầu.", "SID Đại lý")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Cấp trên nào lại nói những điều như vậy?!", GameConfig.player_name)

