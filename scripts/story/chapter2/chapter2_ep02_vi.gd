	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dù sao thì... có lẽ cuối cùng chúng ta cũng có thể học được điều gì đó.\nBây giờ chúng ta hãy đi với cô ấy thôi...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Được rồi. Anh đi đâu em cũng đi đó...", "Annie")
