	await novel_interface.show_dialog("Bộ trang phục này thực sự hơi...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Bị mọi người theo dõi trong khi ăn mặc như con gái khiến toàn thân tôi khó chịu.")
