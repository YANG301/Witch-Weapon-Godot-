# chapter2_ep18.gd - 第二章第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep18_script()

func play_script():
	pass

func chapter2_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("It is a scorching summer afternoon. I plunk a pile of papers next to the round table in the courtyard, and sink into a chair in the shade under the trees.")
	await novel_interface.show_text_only("A while ago, I saw this pretty girl grappling with her pile of books. I didn’t think twice and gave her a hand.")
	await novel_interface.show_text_only("Then she just hurried away, albeit thankfully. That’s when I realized I am an idiot.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Phew... Let me take a break here... It’s so hot.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alas, it was a piece of cake to me when I was a boy.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("And then there’s this SID training coming up... Gosh, can I hide somewhere?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Lian, watch your manner... \\nThis is a school.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Hey, Annie! \\nWhat’s up?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Listen... I know it’s hot. \\nBut... is it really necessary to lift up your shirt to wipe sweat off?", "Annie")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("I mean… Be careful of a wardrobe malfunction…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","wail",0.25)
	await novel_interface.show_dialog("Damn!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_dialog("That Lian girl is so rude...", "Student A")
	await novel_interface.show_dialog("Yeah, I saw her spreading her legs the other day, wearing a skirt.", "Student B")
	await novel_interface.show_dialog("Really? Yuck…", "Student A")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("... \\n(I shouldn't have worn skirts in the first place, okay?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hey…")
	await novel_interface.show_text_only("What a gentle voice.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Use my handkerchief if you don’t mind.", "Elegant Girl")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In front of me is a beautiful and elegant girl. \\nShe has long, silky, purple hair and lilac eyes.")
	await novel_interface.show_text_only("She hands me a handkerchief with an exquisite and fresh fragrance.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Eh?! \\nThank… Thank you.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("You are the first-year transfer students, right? \\nMy name is Nix Strozzi. I’m your senior.", "Nix")
	await novel_interface.show_dialog("I saw you sweating, and I happen to have my handkerchief with me, so... \\nI hope I’m not interrupting.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix nods to me politely, but I freak out. I stand up and salute in a pretty dumb way.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("No... not at all! \\nIt’s a great help!", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("(She seems very amiable.) \\n(Is she a foreigner? Look at those long eyelashes...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look at Nix’s delicate face, my heart racing.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("My pleasure. \\nSo... your name is...", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	await novel_interface.show_dialog("I’m Lian. She’s Annie. \\nWe just transferred here lately.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Annie?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix seems confused and stares at Annie, albeit briefly.")
	await novel_interface.show_text_only("Then she smiles at Annie in a friendly way. I wonder if it was only my illusion just now.")
	novel_interface.show_character("nyx_normal","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Glad to meet you today.", "Nix")
	await novel_interface.show_dialog("But I need to go now. Let me know if there’s anything I can do to help.", "Nix")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Thanks, Nix!", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","upset",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie hesitates without any response.")
	novel_interface.show_character("ren_uniform","gratified")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","upset",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("This girl, Nix... she looks much classier than any of these silver-spoon girls.", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Annie, are you okay? \\nYou have been quiet.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"unhappy")
	await novel_interface.show_dialog("Did she say she’s a Strozzi?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh, you know her?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie takes my arm and gives me an innocent smile.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Nah. \\nWe're new here. How could I know her?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Yeah, you're right.", "Lian")

	print("=== 第二章第18话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
