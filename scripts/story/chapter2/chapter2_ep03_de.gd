# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Von den Agenten „eskortiert“ sprangen Annie und ich in eine pechschwarze Limousine.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("Im Fahrgastraum ist es stickig.")
	await novel_interface.show_text_only("Ich schlinge verwirrt meine Arme um meine Knie.")
	await novel_interface.show_text_only("Annie lehnt sich sanft an mich, wodurch ich mich etwas entspannt fühle.")
	await novel_interface.show_dialog("Also... was ist SID? \\nMan wird jedes Mal nervös, wenn man es hört.", "Annie")
	await novel_interface.show_dialog("Kommst du aus dem Weltraum? \\nSID ist die Geheimdienstabteilung unter dem Senat.", GameConfig.player_name)
	await novel_interface.show_dialog("Einige sagen, dass SID eine wichtigere Rolle spielt als das Aegis Verteidigungssystem, um New Opulentia neutral zu halten.", GameConfig.player_name)
	await novel_interface.show_dialog("Aber es gibt noch mehr urbane Legenden über Menschen, die von SID entführt wurden und nie wieder zurückkamen.... Es ist einfach schrecklich.", GameConfig.player_name)
	await novel_interface.show_dialog("Okay... Aber was ist dann die Akademiestadt?", "Annie")
	await novel_interface.show_dialog("(Warte... Hat dieses Mädchen überhaupt keinen gesunden Menschenverstand?)", GameConfig.player_name)
	await novel_interface.show_text_only("Annie sieht meinen überraschten Blick... und sie lächelt mich einfach entspannt an.")
	await novel_interface.show_dialog("Entspannen Sie sich, wir werden keine Probleme haben!", "Annie")
	await novel_interface.show_dialog("Weil... du etwas Besonderes bist.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("Es ist seltsam, dass das Geschwafel von Annie meinen aufgeregten Geist irgendwie beruhigt hat.")
	await novel_interface.show_text_only("Es scheint nicht so schrecklich, von SID... mitgenommen zu werden.")
	await novel_interface.show_text_only("(Nein. Nein. Es ist schrecklich!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("Wir erreichen das geschäftige Geschäftsviertel der Stadt und fahren in eine gewöhnliche Tiefgarage, wo wir in einen Autoaufzug gelangen.")
	await novel_interface.show_text_only("Nachdem sich der Agent gemeldet hat, setzt sich der Aufzug in Bewegung.")
	await novel_interface.show_text_only("Ich kann spüren, wie schnell sich der Aufzug bewegt. Über weite Strecken geht es mehrmals bergab, ab und zu kommt es sogar zur Seite.")
	await novel_interface.show_dialog("(Ein solches unterirdisches Labyrinth unter dem Geschäftsviertel kann man sich kaum vorstellen...)", GameConfig.player_name)
	await novel_interface.show_text_only("Gerüchte über das SID-Hauptquartier gibt es zuhauf. Einige sagen, es liege am südlichen Vorort von New Opulentia und die gesamte Struktur sei mit optischer Tarnung überzogen.")
	await novel_interface.show_text_only("Natürlich könnten die Medien für ein Gebäude, das offiziell nicht im System existiert, alles erfinden, solange es Klicks anzieht.")
	await novel_interface.show_text_only("Und da greife ich genau in den Kernbereich dieser „nicht existierenden“ Abteilung ein.")
	await novel_interface.show_dialog("(Ich hoffe nur, dass ich hier nicht „nicht existent“ werde...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Wir steigen vor einem mit Metallplatten umwickelten Korridor aus dem Auto. Es vermittelt ein Gefühl von Technologie und Abstinenz.")
	await novel_interface.show_text_only("Gleich nachdem wir ausgestiegen sind, schließt sich die Aufzugstür automatisch. Wir hören, wie es geht, während wir den dunklen Korridor entlanggehen. Die Luft wird steif und trüb.")
	await novel_interface.show_text_only("Mein Herz sinkt auch...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("Wir gehen geradeaus den Korridor entlang und gelangen in einen hellen, aber geschlossenen Raum.")
	await novel_interface.show_text_only("Es sieht aus wie eine Art Verhörraum, aber es gibt weder Tische noch Stühle. Eine Wand ist eine riesige Glasscheibe.")
	await novel_interface.show_text_only("Bevor ich mich umdrehen kann, um nach der Wand zu sehen –")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Whoooa—!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Jemand legt gewaltsam seine Arme um meine Taille.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Autsch... Es tut weh!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich kurz davor bin, das Gleichgewicht zu verlieren, spüre ich, wie mein Kopf auf etwas Vertrautes, Weiches, aber Festes fällt.")
	await novel_interface.show_dialog("Nun... Von deiner Kernstärke her zu urteilen, ist das Spionagezeug nichts für dich.", "Weibliche Stimme")
	await novel_interface.show_dialog("Ich dachte, dass es sich um Körperscanfehler handelte, also wollte ich das persönlich bestätigen.", "Weibliche Stimme")
	await novel_interface.show_dialog("Fühlt sich aber gut an.", "Weibliche Stimme")
	await novel_interface.show_text_only("Die weibliche Stimme hinter mir kommt mir bekannt vor.")
	await novel_interface.show_text_only("Sie lockert ihre Arme. Mit anhaltender Angst drehe ich mich um. \\nDie Frau vor mir—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(Huh?! Th-das ist riesig!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Frau... Frau Mariru!?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Kennst du sie?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ach? So schnell ist zu erkennen, dass man Agenten eines anderen Geheimdienstes identifizieren kann. \\nSieht so aus, als hättest du nie vorgehabt, zu verbergen, wer du bist...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(Meine Güte! Dumm von mir…)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Es ist kaum zu glauben, aber diese Frau in Uniform vor mir ist die Frau, die ich in meinem Traum getroffen habe.")
	await novel_interface.show_text_only("Die schlanke Figur… die roten Haare… der sadistische Blick…")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Sie müssen meine Fragen jetzt ehrlich beantworten.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Machen Sie keine Ausreden und spielen Sie keine Streiche.", "Mariru")
	await novel_interface.show_dialog("Verhöre gehören zu meinen Spezialgebieten. \\nIch werde dein süßes kleines Gesicht nicht schonen~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("Diese überhebliche, neckende Haltung und diese selbstbewussten Augen mit einem Hauch von Spott...")
	await novel_interface.show_text_only("Wie ist nochmal ihr voller Name? \\nRichtig, es ist...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Genau. Ich bin der Leiter von SID. Mein Name ist Mariru Von Braun.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("Sie ist es!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Warte... der Kopf von SID? \\nWar sie nicht die Chefwissenschaftlerin?!")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("Aber wenn man sich ihre Kleidung und Schulterabdrücke genau anschaut, ist sie wahrscheinlich eine große Chefin...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Ihre Strümpfe und High Heels sind allerdings die gleichen wie gestern.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hey, Mädchen, was guckst du dir an?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Oh! Ja... Richtig! \\nEntschuldigung, Ma'am!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du hast Nerven und lässt jetzt einfach deine Gedanken schweifen.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ich habe gehört, dass du diesem blauen Zwillingsschwanz viele schreckliche Geschichten über SID erzählt hast.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru dreht ihre Peitsche in ihren Händen. Ich werde nervös und schlucke schwer.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ratet mal... \\nWie viele davon sind wahr?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Äh! Es tut mir so leid!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("B… blauer Doppelschwanz…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Nachdem Sie nun die Angst kennen, beginnen wir mit Ihrer Identität.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru öffnet ihr Handheld-Terminal und sofort erscheint eine Projektion an der Wand des Verhörraums.")
	await novel_interface.show_text_only("Es zeigt Fotos von mir, die von Überwachungskameras aus verschiedenen Blickwinkeln aufgenommen wurden, und das Ergebnis der Gesichtsanalyse lautet:")
	await novel_interface.show_text_only("[Keine Übereinstimmungen gefunden]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Kein Ankunftsdatensatz... Aegis konnte nicht identifiziert werden.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wäre es nicht Ihre schlechte körperliche Fitness, würden Sie sofort als Spion oder terroristischer Eindringling behandelt werden.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("Es ist mir etwas peinlich und ich reibe mir unbewusst den Bauch.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", diese Dame scheint noch gruseliger zu sein als die Feinde, denen wir zuvor begegnet sind...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ja... und sie wird keine Probleme haben, meine Lügen zu durchschauen...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(Ich werde gestehen! Meine Güte! Was auch immer!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", wo soll ich überhaupt anfangen...?", GameConfig.player_name)
	await novel_interface.show_dialog("Es ist ein bisschen kompliziert, um ehrlich zu sein. Ich bin auch sehr verwirrt.", GameConfig.player_name)
	await novel_interface.show_dialog("Sie werden wahrscheinlich nicht glauben, was ich sage...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Hör auf zu schwafeln. Das werde ich selbst beurteilen!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("… Nun ja … ich hatte diesen Traum.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Im Traum ging ich zum Forschungszentrum, um einer Vorlesung für meinen Outdoor-Lehrbericht beizuwohnen … Und ich kam kurz vor Schließung an.", GameConfig.player_name)
	await novel_interface.show_dialog("Ich habe dich dort getroffen. Und Sie sagten, es sei gefangen worden ...", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Anscheinend hält Mariru das für einen Witz oder so etwas.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Du meinst, du hast mich in einem Traum getroffen?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja, das warst du. \\nUnd du hast mich in eine Ecke gezerrt...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Oh, richtig... Sie waren ein SS-Wissenschaftler, der vom Senat... anerkannt wurde. \\nDr. Mariru Von Braun, richtig?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Das bin ich.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Aber diese Informationen sind nicht geheim – jeder, der mit New Opulentia vertraut ist, weiß es.", "Mariru")
	await novel_interface.show_dialog("... Vergiss es. \\nWas geschah als nächstes?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du hast einen der Eindringlinge niedergeschlagen und eine Pistole erbeutet. Du hast mich gebeten, dort zu bleiben und auf Rettung zu warten, und bist zum Ort der Entführung gegangen.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hijack-Spot? \\nWo genau?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie sagten, es sei der Konferenzsaal.", GameConfig.player_name)
	await novel_interface.show_dialog("Sie wollten dort gerade einen Vortrag halten. Du warst der Dozent.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Vorlesung… Dozent.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(Redet sie über den von Wolfgang arrangierten öffentlichen Vortrag über Ross Goblet?)", "Mariru")
	await novel_interface.show_dialog("(Aber es hätte abgesagt werden sollen. Woher konnte sie davon wissen?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ähm... Frau Mariru?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Ja... nichts. Mach weiter.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Und einige maskierte bewaffnete Männer kamen vorbei. Ich rannte nach unten und versteckte mich im Schatten einer Schiefertafel...", GameConfig.player_name)
	await novel_interface.show_dialog("Tut mir leid, aber ich kann mich nicht erinnern, was dort passiert ist ...", GameConfig.player_name)
	await novel_interface.show_dialog("Ich wurde irgendwie ohnmächtig und als ich aufwachte, sah ich ...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Was hast du gesehen?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Ich sah überall Rauch und Flammen.", GameConfig.player_name)
	await novel_interface.show_dialog("Das Forschungszentrum und die umliegenden Gebäude lagen alle in Trümmern...", GameConfig.player_name)
	await novel_interface.show_dialog("Überall herrschte ein stechender Geruch.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Es hatte einen stark salzigen und bitteren Geschmack...", GameConfig.player_name)
	await novel_interface.show_dialog("Alle Menschen verwandelten sich in Steinfiguren.", GameConfig.player_name)
	await novel_interface.show_dialog("Nein, nicht gerade Stein – es war Salz.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Und ich sah etwas in der Luft leuchten.", GameConfig.player_name)
	await novel_interface.show_dialog("Es war wie die Hölle. \\nAber irgendwie spüre ich eine Art eigenartige Ruhe.", GameConfig.player_name)
	await novel_interface.show_dialog("Etwas antwortet mir...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Und dann wurde meine Erinnerung vage... Es könnte ein Lichtstreifen sein –", GameConfig.player_name)
	await novel_interface.show_dialog("Und... das ist so ziemlich das Ende des Traums.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Als ich aufwachte, lag ich auf meinem Bett in meinem Zimmer und es war bereits Morgen.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("War es... nur ein Traum...?", "Mariru")
	await novel_interface.show_dialog("Ihre olfaktorische Erinnerung war so lebendig, als ob Sie tatsächlich dort wären ...", "Mariru")
	await novel_interface.show_dialog("(Wenn dieser stechende Geruch Schwefel wäre...) \\n(Es wäre genau so, wie Sodom und Gomorra in Genesis zerstört wurden.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
