# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai сверяет отчет с данными, мигающими на мониторе, время от времени ухмыляясь.")
	await novel_interface.show_text_only("Mariru выхватывает отчет сзади Ai и изучает его.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Итак, как прошел медицинский осмотр? Ты выглядишь слишком довольным собой.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Оууу… Это просто потрясающе!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Душа мальчика заперта в теле девочки... Если люди в Институте исследования мозга Харимы услышат о Lian, они убьют, чтобы подать запрос на эксперимент, и похитят ее.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Мы должны держать это при себе, понимаешь?\\nЕсть новые открытия?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Их теломеры указывают на пятнадцатилетний возраст, но количество цезия-137 в мягких тканях Annie составляет лишь четверть современного среднего показателя.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Умно... \\nЗначит, она пережила максимум половину Семилетней войны?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Если только ее не держали в запечатанной капсуле в течение многих лет после войны.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я вижу. \\nА как насчет Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Что касается Lian… уровень, обнаруженный в ее мышечной ткани, составляет менее одной двухсотой среднего — даже ниже, чем тот, который новорожденные наследуют от своих матерей.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Значит, это недавно синтезированное тело?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("А вот что самое интересное: в ее организме есть антитела ко многим давно вымершим вирусам, включая оспу.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Успокойся. В ее спинном мозге нет остаточного вируса.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Я провел приблизительную проверку: история иммунной системы Lian охватывает, похоже, лишь последние несколько столетий. Антитела ни к каким досредневековым вирусам не существует.", "Ai")
	await novel_interface.show_dialog("Тем не менее, мне бы очень хотелось запросить образец ее лейкоцитов и попробовать культивировать вирусы № 008, 217 и 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Это не твоя работа школьного врача.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Да, верно. Я понимаю. \\nВы хотите, чтобы я за ними присматривал, верно?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Возможно, у них есть ссылка на пропавшую Ross Goblet… \\nЯ подозреваю, что они не рассказали всю историю.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Почему бы просто не запереть их и не допросить?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Вам нужна рука? Послушайте, если немного модифицировать инструменты, которые я использовал сегодня для проверки, они идеально подойдут для этой работы…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Глаза Ai светятся от волнения. Mariru сворачивает отчет и шлепает ее им.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Просто держите глаза и уши открытыми. Сообщите мне, если что-нибудь произойдет.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Теперь, когда она это уже заметила, я боюсь, что кто-то из SID мог заметить…)", "Mariru")
	await novel_interface.show_dialog("(По крайней мере, она сохранит контроль в школе) \\n(А тем временем я мог бы наблюдать за ней...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Тебе не нужно говорить мне дважды. Я буду записывать каждое~ изменение в теле Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Вам лучше вести себя сдержанно и не сбиться с пути.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Хе-хе, расслабься. \\nБыло бы неинтересно, если бы я сразу осушал ее всю.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
