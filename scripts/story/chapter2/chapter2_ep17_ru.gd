# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("Вот какой должна быть богатая школа! \\nПосмотрите на эту аппетитную еду в столовой.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Привет! Я бы хотел рисовый сет с карри и три жареных куриных крылышка.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Торты с креветками выглядят хорошо. Мне два, пожалуйста.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ты уверен, что сможешь закончить все это?", "Персонал столовой")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Конечно, кусок пирога!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Эй, смотри! Эта девчонка ест как лошадь.", "Студент 1")
	await novel_interface.show_dialog("Невероятно… Она всегда так много ест?", "Студент 2")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(… Я мальчик, ясно? Это нормально.)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Знаешь, люди тебе завидуют. \\nВы едите много, но не набираете вес…", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ничего особенного. \\nХммммм! Торты с креветками очень вкусные!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ну, Lian…", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что? (Жует) \\nРис карри ооочень вкусный! (Сглатывает)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Я люблю эту школу! (Слякоть)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Ты действительно ешь как лошадь, да?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Э?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Она новая переводная студентка?", "Студент 1")
	await novel_interface.show_dialog("Совсем не похожа на девушку... \\nФу, раздвигает ноги, когда сидит. Это отвратительно!", "Студент 2")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… Это действительно отстой.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Фууу…", "Lian")
	await novel_interface.show_dialog("Ну... я закончил есть...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Именно столько съела бы девушка.", "Annie")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Раньше я был большим едоком! \\nЯ мог бы съесть столько, сколько смогу, и не торопиться, чтобы переварить…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ха-ха-ха…! Ты правда лошадь? Зачем вам это делать?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Наверное, потому, что... в детстве я слишком часто голодал.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis может только распознавать и защищать пули. Это означает, что вооруженные солдаты могут легко проникнуть в его силовое поле.")
	await novel_interface.show_text_only("Силовое поле имеет радиус 20 миль, что фактически было последней угрозой для миллионов выживших тогда.")
	await novel_interface.show_text_only("Война оставила после себя очень много сирот. Организация защиты отягощала Сенат . Таким образом, снабжение каждого детского сада было жестко нормировано.")
	await novel_interface.show_text_only("Многие дети голодали, и им приходилось искать еду в зоне боевых действий недалеко от границы. Я был одним из них…")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Я понимаю твои чувства. Просто… не переедайте сейчас.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie тоже, возможно, пережил те дни…")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Эй, давай возьмем десерты после школы!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("… Хорошо!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("У нас редко бывает свободное время, чтобы вот так погулять, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Вообще-то, я впервые в таком ресторане... \\n(Чувствую себя немного неловко среди девчонок вокруг...)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ладно, посмотрим… ну, я возьму вот этот! \\nЧерничное мороженое, парфе, супергазированный напиток, специальный напиток DX!", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Название звучит очень круто!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Ты правда ребенок, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Я просто выпью кофе…", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, ты теперь девочка. \\nНе хочешь попробовать десерты? Они очень вкусные!", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Хорошо… позвольте мне проверить. \\nЭмм… Сырный маффин «Наполеон» матча… (Неплохо.)", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Королевский торт с апельсиновыми цукатами и кремом… (тоже выглядит вкусно…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Тропический праздник, мороженое с фруктами и мороженым… \\n(Глотками)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Простите... Вы уже решили?", "Официант")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Ну… ммм\\nможет быть… просто кофе… спасибо…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Хорошо.", "Официант")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Ну…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Ух, подожди! Я передумал… \\nЧерничный мусс, клубничное мороженое, парфе, пожалуйста…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Я просто хочу попробовать это на вкус! \\nРаньше я видела, как их ели только девушки…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ага, не надо объяснять.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Извините, что заставил вас ждать. Вот ваш заказ.", "Официант")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Спасибо!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Наслаждайтесь!", "Официант")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Хорошо, готово!", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Ням... вкусно..!!", "Lian")
	await novel_interface.show_dialog("Клубника пахнет очень свежо. Крем действительно сладкий. И черничный мусс, немного кисловатый, но очень вкусный…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я чувствую себя немного неловко, когда замечаю, что Annie смотрит на меня.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Девочки обожают эти десерты. Мне всегда хотелось знать,\\nкаковы они на вкус.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Баха-ха… \\nLian, ты такой...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Хм?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Так мило!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Что… о чем ты говоришь…!", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
