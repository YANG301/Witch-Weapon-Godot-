# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka nous attaque Annie et moi avec la magie de la foudre. Ne voulant pas lui faire de mal, tout ce que nous pouvons faire est de nous défendre désespérément.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Si cela continue, nous allons tous être blessés...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hah… Ahh… \\nElluka, arrête ! Calme-toi!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Cible verrouillée. Attaque continue—", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une frappe fulgurante traversa l’air, suivie d’une explosion. \\nJ'ouvre les yeux et me retrouve indemne.")
	await novel_interface.show_text_only("Derrière l'Administrateur, le rotor principal de l'avion bascule lentement, puis retombe comme une brindille cassée.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Administrateur")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ahem... tout le monde se fige—— !", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("La voix de Mariru résonne depuis un haut-parleur au loin.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Mademoiselle Mariru !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trois hélicoptères surgissent au-dessus de nous et leurs projecteurs aveuglants éclairent le sol de blanc comme s'il faisait plein jour.")
	await novel_interface.show_text_only("Mariru est assis dans l'hélicoptère du milieu et crie à travers un haut-parleur. L’énorme pistolet monté devant elle fume encore.")
	await novel_interface.show_dialog("Le petit jouet de Ai a vraiment du punch. Il a en fait retiré l’arbre du rotor d’un seul coup.", "Mariru")
	await novel_interface.show_text_only("Mariru a l'air un peu trop excitée, comme si elle adorerait tirer un autre coup.... Hé, cette chose compte déjà comme un canon, n'est-ce pas ?!")
	await novel_interface.show_text_only("Le cockpit du transport écrasé s'ouvre de l'intérieur et deux pilotes en sortent paniqués, se précipitant pour sauver leur vie.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hah… Haha…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un hélicoptère atterrit sur un terrain découvert à l'extérieur de la sous-station. Escorté par une foule de soldats lourdement armés, Mariru se dirige vers nous de bonne humeur.")
	await novel_interface.show_text_only("Ayant clairement aperçu le visage de Mariru, l'Administrateur cracha férocement au sol.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph. Un autre SID chien de poche.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Il ne s'agit pas d'une opération SID. Je suis ici en tant que conseiller de New Opulentia Metropolitan Defense Bureau, menant une mission de sécurité anti-émeute.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ce n'est qu'à ce moment-là que je réalise que les gens qui sont descendus des hélicoptères ne sont pas du tout des SID agents. Chacun d'entre eux porte un brassard marqué \"MD\".")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("N'est-ce pas vrai... Capitaine Nantetsu ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("C'est vrai. Les Metropolitan Defense Bureau soupçonnent qu'une attaque terroriste contre New Opulentia est en cours ici.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("J'ordonne par la présente à vous et à vos hommes de cesser immédiatement les hostilités et de revenir avec nous pour un interrogatoire.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Ce musclé aux allures de lutteur là-bas... Je jure que je l'ai déjà vu... Est-il une connaissance de Mariru ?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ces deux jolies filles sont vos subordonnées ? Un département sans limite d'âge, ça a l'air plutôt sympa...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... ce petit...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hé, tu es sûr de vouloir faire ça ?", "Administrateur")
	await novel_interface.show_dialog("Il s'agit d'une zone démilitarisée au sens de l'Accord. Aucune de vos organisations n’a le pouvoir d’opérer ici.", "Administrateur")
	await novel_interface.show_dialog("Et vous n’auriez pas pu obtenir l’autorisation du Congrès uni aussi rapidement !", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Ces bureaucraties multinationales évoluent à la vitesse d’un escargot.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... désolé de vous décevoir, mais je vais emmener mon peuple et partir maintenant.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ Je n'ai pas encore fini de parler.... Johnson Heavy Industries, en revanche, travaille beaucoup plus vite.", "Mariru")
	await novel_interface.show_dialog("Après tout, leur fils aîné étudie toujours à New Opulentia~ En ce moment, ce sont eux qui me demandent des faveurs...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Quoi ?!", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("À l'heure actuelle, trois pour cent de la charge de cette sous-station a déjà été injectée dans le réseau urbain de New Opulentia—", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Selon l'Accord de Salmonton, toute attaque contre le réseau électrique de New Opulentia est considérée comme un acte terroriste de première classe.", "Mariru")
	await novel_interface.show_dialog("Pour des incidents comme celui-ci, le Metropolitan Defense Bureau détient la plus haute autorité opérationnelle reconnue par le Congrès uni.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Après tout, notre hôte Aegis… \\nNe peut pas fonctionner sans électricité.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Comment pourriez-vous faire fonctionner Aegis hors du réseau de la ville ?! Arrêtez les trucs!", "Administrateur")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Assez parlé. Emportez-les !", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Attendez ! Massada Fort et New Opulentia ont signé un accord d'immunité diplomatique il y a longtemps, n'est-ce pas ?", "Administrateur")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'Administrateur sort sa pièce d'identité de la poche de son manteau et la montre d'un air suffisant à Mariru et Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Je m'appelle Jacob Schmidt, attaché militaire de la Troisième Ville Académie, Massada Fort, auprès du Congrès Uni.", "Administrateur")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si vous m'arrêtez ici, je suppose que cela causera des problèmes diplomatiques plutôt inutiles, n'est-ce pas ?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("… \\nTrès bien. Vous avez une minute pour sortir de ma vue.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Mais il semble que votre véhicule présente des problèmes… \\nVous devrez donc peut-être rentrer chez vous à pied.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("Quoi ?! Ce n'est pas juste !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Les règles sont des règles. Une impulsion de sang chaud ne résoudra rien.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Mais…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, nous partons.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Attendez, votre identité a été vérifiée, ce qui est très bien. Mais cette petite fille… Je ne pense pas qu'elle occupe un poste dans votre ministère des Affaires étrangères.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Vous !!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Je suis désolé, mais elle est l'un des principaux suspects de l'attaque terroriste d'aujourd'hui.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Si vous essayez de l'emmener de force, tout ce que je peux faire, c'est informer avec regret votre ambassade que vous avez été abattu lors d'une attaque terroriste.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru sort un pistolet et le tient contre la tête de Jacob.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... Elle n'est qu'un outil.\\nSi vous la voulez à ce point, alors gardez-la !", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Niveau de puissance, critique… \\nHah… Activité terminée…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, qui s'était forcée à continuer tout ce temps, s'effondre soudain au sol comme une machine qui aurait perdu de la puissance.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. Dans cet état, elle est probablement inutile de toute façon. Prenez soin vous-mêmes des déchets sans valeur !", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob remonte son col et accélère le pas, sans même jeter un seul regard en arrière. Bientôt, il disparaît dans l'obscurité.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, réveillez-vous ! Elluka !", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, aidez-la s'il vous plaît !…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Elle apparaît toujours sur le détecteur de vie. Elle est probablement juste épuisée.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Et vous, quelqu'un qui a encore besoin de se protéger, êtes ici en train de crier qu'il faut sauver les autres ?", "Mariru")
	await novel_interface.show_dialog("...Tu deviens de plus en plus un idiot au sang chaud.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Rentrons à la maison.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Cette fille est notre ennemie, n'est-ce pas ?", "Nantetsu")
	await novel_interface.show_dialog("Le Sénat n'exige-t-il pas que tous les terroristes de première classe soient arrêtés immédiatement, puis...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Demandez à chaque hélicoptère de faire fonctionner ses modules anti-scan en permanence. Les quatre drones de SID nous escorteront en mode contre-attaque automatique.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Mon peuple, je les escorterai personnellement. Toute personne ayant un désir de mort est invitée à m'essayer !", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha… C'est le Mariru que je connais.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru demande à l'équipe médicale de soigner nos blessures, puis emmène Annie, Elluka et moi à bord de l'hélicoptère.")
	await novel_interface.show_text_only("Annie est tellement fatigué. Elle s'appuie sur mon épaule et s'endort bientôt.")
	await novel_interface.show_text_only("Elluka dort aussi, étalée sur mes genoux avec un peu de bave au coin de la bouche. Il ne reste plus rien de ce regard glacial qu'elle avait il y a quelques minutes à peine.")
	await novel_interface.show_text_only("Ce n'est qu'une petite fille ordinaire après tout... et pour une raison quelconque, cela me soulage.")
	await novel_interface.show_text_only("Tout ira bien. Tout ira bien, comme le dit cette chanson :\\nTout ira bien.")
	await novel_interface.show_text_only("Même si la paix règne désormais entre les six villes académiques, de vastes régions échappant à leur contrôle sont toujours ravagées par la guerre.")
	await novel_interface.show_text_only("Je me demande combien d'enfants comme Elluka sont encore utilisés comme armes ou outils...")
	await novel_interface.show_text_only("Mariru avait raison. Je suis un idiot qui mord toujours plus que ce que je peux mâcher.")
	await novel_interface.show_text_only("Mais je n'ai presque jamais rencontré quelqu'un prêt à baisser toute sa garde et à s'endormir paisiblement à côté de moi. Maintenant, il y en a deux.")
	await novel_interface.show_text_only("… J'aime être un idiot.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
