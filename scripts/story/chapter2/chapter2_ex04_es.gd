# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Con el permiso de Mariru, Annie y yo decidimos ir de compras con Elluka.")
	await novel_interface.show_text_only("Elluka está detrás de mí, mirando todo con cautela.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, ¿quieres chocolate?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, chocolate, como.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Aquí tienes.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka toma la barra de chocolate, la desenvuelve con cuidado y le da un pequeño mordisco.")
	await novel_interface.show_text_only("Simplemente no puedo tener suficiente de ella. ¡Tan lindo!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Oye, pareces un pervertido de mediana edad.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¡¿Qué?! Soy sólo un adolescente.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervertido.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Por qué ambos me hicieron esto?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, no te daré chocolate si sigues actuando así.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo...", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dispara. Se ve linda incluso cuando está deprimida.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Jaja. Estoy bromeando. \\nAquí tienes.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("¿Cuánto chocolate tienes? \\nEngordarás si comes en exceso.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("¿Cuál es el problema? Solo tengo unas pocas cuadras.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me mira fijamente con una mirada extraña, haciéndome sentir incómodo.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Eché un vistazo a tu reciente informe de chequeo físico. \\nEstás aumentando de peso, pero no has crecido más.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Por qué hiciste esto?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Para conocerte mejor, obviamente.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ahora sé que sólo mides cinco pies tres. Lo mismo que yo.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Maldita sea. No es nada de qué enorgullecerse.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("¡Pero yo medía cinco pies y cuatro cuando era niño!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Esa no es mucha diferencia, ¿no?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Me engañaste... \\nNo debería haberte dicho esto.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras Elluka disfruta de su chocolate, la conversación llama su atención. De repente ella mira confundida.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("¿Hermana Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("¿Sí?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Hermano... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Hermana? ¿Hermano? \\nDatos dañados. No identificable.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! ¡Olvídate de lo que acabamos de decir!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Volver a escanear el objetivo. Mujer identificada... \\n¿Hermana? ¿Hermano?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("¡Aaaahh! ¡Detener!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
