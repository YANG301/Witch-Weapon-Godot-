# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("¡Mira quién está aquí! ¿Cómo se siente convertirse oficialmente en una niña, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... ¡Por favor deja de burlarte de mí!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Está bien, está bien. Por cierto, escuché que planeas transferirte a otra escuela secundaria pública después de las vacaciones.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Sí. La nueva escuela está más cerca de donde vivo y... los requisitos de crédito no son tan estrictos...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por razones de seguridad, voy a conseguir un nuevo lugar para que te quedes.\nEn cuanto a la escuela...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Parece que tendré que pedirle un favor a ese viejo).", "Mariru")
	await novel_interface.show_dialog("(Solo pensarlo es molesto... menos mal que los registros ya fueron corregidos perfectamente...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Escuela secundaria de niñas Gosakuragawa. Tiene la calificación de seguridad más alta y tampoco está lejos de la SID sede.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mientras hablaba, Mariru señaló hacia arriba.")
	await novel_interface.show_text_only("Se dice que Gosakuragawa, el bullicioso distrito comercial situado encima de la sede subterránea, alberga una prestigiosa escuela con matrículas terriblemente altas.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡¿E-espera, no es esa la escuela de niñas ricas?! El que llaman \"un paraíso donde florecen lirios puros y espléndidas flores de cerezo\"...", "Lian")
	await novel_interface.show_text_only("Ese era un texto publicitario escrito por gente fuera de tema en cierto foro basura que constantemente colapsa para burlarse de la escandalosa matrícula de Gosakuragawa.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("¿Qué fue eso?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N-¡No, nada de nada!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Con lo tonto que eres, podrías terminar convirtiéndote en algo... para todos esos estudiantes de último y primer año.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru soltó una ligera carcajada y no terminó la frase.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Convertirse en qué exactamente?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Ahora no es el momento de dejar volar tu curiosidad.\nDe todos modos, mañana irás y te presentarás como es debido.", "Mariru")
	await novel_interface.show_dialog("Allí no será tan relajado como en una escuela pública.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("¿No puedes simplemente dejarme relajarme un poco?... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Ah, claro. ¿Qué pasa con Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Los antecedentes de esa chica son bastante interesantes.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ella... ¿Qué le pasa?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Los registros de Annie Bass en el sistema sólo se remontan a siete años atrás, cuando ella tenía quince años.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Hace siete años significa que...ya tiene veintidós?!\n¡Parece tener aproximadamente la misma edad que yo!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Así es. Incluso ahora, su edad ósea todavía ronda los quince años.", "Mariru")
	await novel_interface.show_dialog("Pero adónde fue durante ese tiempo y por qué reapareció repentinamente, nadie lo ha descubierto hasta ahora, incluida Annie.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Pase lo que pase, no creo que Annie sea una mala persona.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("En eso puedes estar tranquilo.\nDespués de todo, incluso hay personas en SID que solían ser sus fans.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Eh?! ¿Era Annie algún tipo de ídolo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Probablemente entra en la categoría de \"una estrella de hace años\".", "Mariru")
	await novel_interface.show_dialog("Pero en comparación con quién solía ser, ahora estoy más interesado en lo que tiene de especial.", "Mariru")
	await novel_interface.show_dialog("Para empezar, hay tan poca información sobre las brujas... que esto fue una ganancia inesperada.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Brujas... ¿qué es eso?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Mm... en pocas palabras, puedes pensar en ellos como humanos que fueron infectados por cierto tipo de información y adquirieron algunos rasgos similares a \"Substance H\".", "Mariru")
	await novel_interface.show_dialog("Al igual que la gente llama a las extrañas características de \"Substance H\" (cosas que la ciencia actual no puede explicar) \"milagros\".", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Para la gente común, si alguien pudiera manifestar ese tipo de rasgo, prácticamente parecería \"magia\".", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("La magia... debería ser simplemente una ciencia que aún no entendemos...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Ésa es una manera perfectamente válida de pensarlo.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("Hay muchos registros históricos sobre las \"brujas\", pero siempre fueron tratadas como superstición y leyenda.", "Mariru")
	await novel_interface.show_dialog("A lo largo de más de trescientos años, los europeos ejecutaron a casi cien mil mujeres en nombre de \"brujas\".", "Mariru")
	await novel_interface.show_dialog("La \"caza de brujas\"... eso lo aprendimos en la clase de historia...", "Lian")
	await novel_interface.show_dialog("En aquel entonces, solo lo traté como un material de examen aburrido, pero cuanto más lo pienso, más lo siento como una catástrofe a una escala anormalmente masiva...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Desde que se descubrió \"Substance H\", todos los países han comenzado a reexaminar si esas leyendas eran ciertas.", "Mariru")
	await novel_interface.show_dialog("Últimamente hay rumores de que ciertas organizaciones han recreado brujas y las están utilizando para espionaje.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Aún así, por suerte para nosotros, Annie aceptó unirse sin dudarlo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("¿Unirse a qué?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Convertirse en agente SID.", "Mariru")
	await novel_interface.show_dialog("A partir de mañana, ella estará trabajando para mí.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("¡No puedes hacer eso! SID ¡Los agentes obviamente hacen un trabajo extremadamente peligroso!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("Y ella sólo tiene quince años, igual que yo. Ella no puede ser una especie de agente...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je. Nuestro agente más joven ahora tiene sólo trece años.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("¡¿Trece?! ¡¡Eso es ilegal!!\nEso tiene que ser ilegal, ¿verdad?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si alguna vez tienes la oportunidad de conocerla, no volverás a decir eso.\nEse niño es mucho más inteligente que un tonto como tú.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Hmph.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como ciudadano de New Opulentia, por supuesto sé que aunque las distintas ciudades de la academia parecen estar bajo un alto el fuego, todavía están compitiendo secretamente entre sí.")
	await novel_interface.show_text_only("Y el escudo de Aegis es inútil contra armas bioquímicas y ataques terroristas de tipo infiltración.")
	await novel_interface.show_text_only("Para proteger esta ciudad, Mariru y SID debieron haber librado innumerables batallas desesperadas en las sombras.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ah, claro. La identidad encubierta de Annie será la de un estudiante transferido que se inscribe con usted.", "Mariru")
	await novel_interface.show_dialog("He arreglado que ustedes dos se queden en la misma suite. Los uniformes y otras necesidades diarias\nse entregarán en una hora.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sin negociación.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Entiendo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por supuesto que lo entiendo. No hay nada malo en esto.\nNo, es mucho más cómoda que la vida que tenía antes.")
	await novel_interface.show_text_only("Mientras SID se encargue de todo.\nMientras yo siga vagando por la vida en alguna escuela de niñas nobles, arreglándomelas con los créditos.")
	await novel_interface.show_text_only("Y mientras intente acostumbrarme a este nuevo cuerpo... ¿sería suficiente?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... No.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¿Mmm?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incluso si no entiendo nada todavía, no quiero que Annie enfrente ese tipo de peligro ella sola.")
	await novel_interface.show_text_only("La Annie que apareció ante mí en el momento en que nos conocimos...\nParecía tranquila, pero todavía había un rastro de miedo en ella.")
	await novel_interface.show_text_only("Ella también estaba... asustada, ¿no?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Señorita Mariru—si no le importa que la llame así...\n¡Yo también quiero ayudar!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("¡¿Eh?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Quiero decir, ... ya que pude pasar por ese huracán, ¡tal vez pueda ayudar a SID con algo más también!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Eso no fue un huracán. Fue una fluctuación de fase espaciotemporal...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("De todos modos, no puedo dejar que Annie enfrente el peligro solo.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Y tal vez... tal vez incluso tenga la oportunidad de encontrar una manera de volver a convertirme en un niño...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... Pero con tu habilidad física, probablemente ni siquiera podrías vencer a uno de los conserjes de SID.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Uh...\n(¡¿Qué tipo de limpiadores contratan ustedes?! ¿Monjes Shaolin?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Bien. Te dejaré probar el SID entrenamiento de cadetes. Al menos si corres peligro en el futuro, podría aumentar un poco tu tasa de supervivencia.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("En cuanto a su estado, comenzará como candidato a agente de nivel 4.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("¡Está bien! ¡Haré lo mejor que pueda!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Bien. Veamos qué tipo de datos puedo sacarle a este pequeño).", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
