# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("（自言自語）還是那個小傢伙比較有趣……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉斜前方的螢幕閃過一串語音連線提示，刻意偽裝的電子音掩蓋了說話人本身的性別。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("（雖然做過很多次簡報，但這種單方加密幹擾的形式，實在令人不爽。 ）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("有關「洛斯金盃」消失的事件，現在調查進度如何了？", "基爾斯")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("今天凌晨零時十五分，保全系統發現「洛斯金盃」消失。", "莉琉")
	await novel_interface.show_dialog("早上六時四十分，「真實視域」衛星監控系統發出警告，表示偵測到強烈次元扭曲。", "莉琉")
	await novel_interface.show_dialog("之後從今早七點到現在——『埃癸斯』系統在新豐洲範圍內共偵測到了六起時空相位波動警報。", "莉琉")
	await novel_interface.show_dialog("而如果以研究所為中心，半徑一千五百公里以內範圍內，同步出現了三十二起類似警報……", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("這些都在文件裡，說結論。", "基爾斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉朝著右後方看了一眼，笑了笑。")
	await novel_interface.show_text_only("僅憑語調就能判斷出，這是那位性格嚴謹、不苟言笑的元老院首席元老。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("——這不是失竊事件，而是『異質物』覺醒及其引發的連帶效應。", "莉琉")
	await novel_interface.show_dialog("而且以現在的頻率和規模看來，無法確定是不是模因類異質物。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉話音剛落，四周的黑暗熒幕中便傳來吃驚和小聲議論的聲音。")
	await novel_interface.show_text_only("！！！！！")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("什麼？ ！", "基爾斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一道沉穩低啞的嗓音從莉琉的左手邊傳來。")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("你是指精神影響型的『神蹟』指數級爆發？\n這還真是有意思……", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("目前看來更可能是單純的多起事件同時爆發而已。 \\n至於「神蹟」……我不太習慣用不嚴謹的詞彙。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("（雖然他是精神影響類「異質物」的權威……）", "莉琉")
	await novel_interface.show_dialog("（但總覺得這個大猩猩接觸太多輻射，所以腦子壞掉了。 ）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("那按照你的判斷……", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("現在可無法提出任何結論報告，有效資訊太少了。", "莉琉")
	await novel_interface.show_dialog("根據目前的事態，我申請無限制的S級調查令，希望諸位可以理解。", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉並不理會四周傳來的竊竊私語聲，把注意力放回了手持平板上。")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("（那個小朋友去了新的異變區域……）", "莉琉")
	await novel_interface.show_dialog("（果然，又是消失之後一段時間重新出現，接著附近的相位波動也停止了。 ）", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（咦？ 根據現場傳來的影像……她身上的是血跡嗎？ ）", "莉琉")
	await novel_interface.show_dialog("（這個笨蛋……該不會！ ！）", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("妳好像有點心不在焉啊。", "基爾斯")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("什麼？ 沒有這回事。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("你盯著看的東西，上面有什麼比彙報內容更重要的資訊嗎？", "基爾斯")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……嘛，只是小貓咪的影片而已，你們想看嗎？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("！ ！！", "基爾斯")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("莉琉的左側傳來了尖銳的電流聲和蜂鳴。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("別生氣嘛，適當的調劑有助於提高工作效率。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("……", "基爾斯")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("莉琉環視四周，似乎沒有人察覺到她剛才的動搖。")
	novel_interface.character_light()
	await novel_interface.show_dialog("總之，目前所有的基本情報就如同方才彙報。 \\n事件正在進一步調查中。", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("沒有問題的話，我要去現場了。", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("未等莉琉準備離開，左手邊就傳來一道略顯輕佻的聲音。")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("……聽說，妳的手下帶了兩名高中生回SID進行審查？", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……\\n（嘖，又是這個討厭的傢伙。 ）", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("她們有什麼特別之處嗎？ 莉琉閣下……不，莉琉博士。", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……沒什麼，剛才已經查清楚，她們只是兩隻好奇心太旺盛，翻進封鎖區的小貓咪。", "莉琉")
	await novel_interface.show_dialog("之後我就會安排人送她們回家。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("是嗎，那就好。", "#C")
	await novel_interface.show_dialog("在這種敏感時期，萬一被其他國家當做什麼奇怪的存在，那就不好了……", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("這句話引起了眾人喧嘩。")
	await novel_interface.show_text_only("……這傢伙什麼意思？")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("唉啊，說了不夠嚴謹的話，有人會覺得不習慣吧。 \\n真是抱歉了，大家就當作沒有聽到吧。", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("……\\n（真的是令人討厭的傢伙。 ）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("好了，無論如何這次事件已經引起了其他學園都市的注意。", "布萊特")
	await novel_interface.show_dialog("接下來的機密調查和公開資訊的引導，也要拜託妳了。", "布萊特")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("這是當然！", "莉琉")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
