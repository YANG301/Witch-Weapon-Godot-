	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ใช่", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka มองฉันด้วยความปรารถนาเหมือนสัตว์เลี้ยงตัวเล็กๆ ขอทาน ดวงตาของเธอเต็มไปด้วยน้ำตา")
	await novel_interface.show_text_only("ฉันไม่สามารถปฏิเสธเธอได้ แต่สคริปต์เหล่านี้อันตรายเกินไป...")
	await novel_interface.show_text_only("ในขณะที่ฉันกำลังลังเล เสียงเครื่องบินขนส่งลงจอดก็ดังเข้ามาใกล้")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("มีคนกำลังมา!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID เจ้าหน้าที่? เยี่ยมมาก เราพบ... \\nอะไรนะ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("น่าแปลกที่บุคคลที่เดินออกจากเครื่องบินไม่ใช่เจ้าหน้าที่ SID")
	await novel_interface.show_text_only("ชายใส่แว่นมอง Elluka อย่างอ่อนโยน แต่เธอก็ตัวสั่นด้วยความกลัว")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka คุณทำให้ฉันรอนานเกินไปแล้ว", "ผู้ดูแลระบบ")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("ผู้ดูแลระบบ… ฉันขอโทษ", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("คุณได้ต้นฉบับแล้วหรือยัง? \\nคุณไม่สามารถจัดการมันได้ด้วยตัวเอง—ฉันบอกคุณแล้ว พาพวกเขามาหาฉันเดี๋ยวนี้", "ผู้ดูแลระบบ")
	await novel_interface.show_dialog("มีเพียงขยะไร้ประโยชน์เท่านั้นที่จะล้มเหลวในงานเล็กๆ น้อยๆ เช่นนี้ใช่ไหม?", "ผู้ดูแลระบบ")
	await novel_interface.show_dialog("ทำความสะอาดระเบียบนี้ แล้วมากับฉันที่ Oligar มีงานอื่นรอคุณอยู่", "ผู้ดูแลระบบ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("ว้าว ว้าว ว้าว ดูภาษาของคุณสิ! ไม่เห็นเหรอว่าเธอได้รับบาดเจ็บ?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("เธอเป็นเพียงเด็กผู้หญิงตัวเล็ก ๆ ไม่ใช่เครื่องมือที่คุณเป็นเจ้าของ!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ดูเหมือนว่าคนแปลกหน้าจะไม่ได้สังเกตเห็นฉันจนกระทั่งบัดนี้ เขามองฉันด้วยรอยยิ้มแปลกๆ เหมือนกับนักล่าที่กำลังตรวจสอบเหยื่อของเขา")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka พาเธอไปด้วย", "ผู้ดูแลระบบ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("ห๊ะ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("เหนือศพของฉัน ไม่มีใครสามารถ Lian ตราบใดที่ฉันอยู่ที่นี่", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("พาเธอ…?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("ใช่ นั่นเป็นคำสั่ง", "ผู้ดูแลระบบ")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("สั่งซื้อ...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka จ้องมองมาที่ฉันอย่างว่างเปล่า ดูเหมือนเธอจะอยู่ในการต่อสู้ภายใน แต่การไม่เชื่อฟังผู้ดูแลระบบไม่ใช่ทางเลือก")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("ภารกิจ: นำ Lian ไป \\nล็อคเป้าหมาย...", "Elluka")

