	await novel_interface.show_text_only("ฉันมอบหน้าที่เจอในสนามรบให้กับ Annie Elluka กัดลิ้นของเธอ")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("ต้นฉบับ Wardenclyffe... มหัศจรรย์! ฉันไม่อยากจะเชื่อเลยว่าคุณจะพบสิ่งเหล่านี้!", "Annie")
