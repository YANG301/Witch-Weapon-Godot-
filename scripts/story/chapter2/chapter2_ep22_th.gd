	await novel_interface.show_dialog("ถ้าฉันจำไม่ผิด แผ่นพับนั้นมีชื่อว่า Mystical Trajectory มันโผล่ออกมาจากอากาศในล็อกเกอร์ของฉัน", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("ตอนแรกนึกว่าโค้ชเป็นคนให้ คาถาข้างในนั้นแปลกมาก เหมือนสอนวิธีเปลี่ยนวิถี", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("แต่ต่อมาผมพบว่าโค้ชไม่รู้เรื่องนี้เลย ฉันคิดว่ามันเป็นความเชื่อโชคลาง ดังนั้นฉันจึงไม่เคยใช้มันเลย", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("ไม่จนกว่า…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ดูเหมือนว่า Annie เสร็จสิ้นแล้วกับการนึกถึงอดีต เธอก้มศีรษะลงและอ่านสคริปต์เหล่านั้นอย่างระมัดระวัง")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("ฉันจำได้ว่า Mariru บอกว่าแม่มดเป็นมนุษย์ที่ได้รับคุณสมบัติบางอย่าง Substance H อันเป็นผลมาจากการปนเปื้อนของข้อมูล", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("การปนเปื้อน...อย่างแน่นอน บอกเลยว่าตรงประเด็นมาก \"ข้อมูล\" บางอย่างไม่สามารถลบออกได้เมื่อคุณได้สัมผัสมันแล้ว", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ชอบพวกขี้หูและรีมิกซ์ออโต้จูนเหรอ? ฉันพยายามล้านครั้งเพื่อกำจัดพวกมัน แต่ก็ล้มเหลวทุกครั้ง บางครั้งฉันก็อดฮัมเพลงไม่ได้เมื่อขาดสติ...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("ฮา. พูดได้ดี Lian", "Annie")
