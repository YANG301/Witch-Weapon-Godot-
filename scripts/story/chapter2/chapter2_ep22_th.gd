	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("บ้าไปแล้ว… แม่มด… \\nต้อง… ถูกทำลาย", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("แม่มด…คือผู้โชคร้ายใช่ไหม? \\nAnnie คุณรู้มาก", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("ไม่… \\nฉันแค่ตั้งสมมติฐานจากประสบการณ์ของตัวเอง", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("ต้นฉบับ…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka ดูเหมือนจมอยู่ในความคิด ใบหน้าของเธอสดใสขึ้นด้วยความกระตือรือร้น")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("ฮะ? อะไร คุณต้องการที่จะเห็นพวกเขา Elluka?", "Lian")
