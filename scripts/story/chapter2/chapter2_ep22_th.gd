	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("พวกเขาหลุดจากคนเหล่านั้นก่อนหน้านี้ มันรู้สึกไม่โอเคเลย… Annie คุณช่วยอ่านมันหน่อยได้ไหม?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อืม… เส้นนั้นเบลอ แต่ฉันสัมผัสได้ถึงเวทย์มนตร์ที่ไหลผ่านมัน", "Annie")
