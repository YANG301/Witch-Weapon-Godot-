	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("บางทีกระดาษเหล่านี้อาจก่อให้เกิด กระแสมิติเวลา? \\nแต่... มันเป็นไปได้ยังไงล่ะ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("เป็นไปได้มาก ข้อมูลดังกล่าวอาจทำให้คุณเสียพลังงานมาก ซึ่งมากเกินไปสำหรับฉันด้วยซ้ำ", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("นั่นเป็นสาเหตุที่เราต้องการ \"สิ่งของ\" บางอย่างเพื่อปลดปล่อยเวทมนตร์เพื่อที่พวกมันจะได้แบกรับค่าใช้จ่ายแทนเรา", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie ชี้ไปที่ไม้เบสบอลของเธอ บางทีนั่นอาจเป็นเหตุผลว่าทำไมอาวุธบางชนิดถึงใช้พลังเวทย์มนตร์...")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("หากมีข้อมูลมากเกินไป ผู้คนอาจสูญเสียสติและเป็นบ้าไปเลย...", "Annie")
