# chapter2_ep05.gd - 第二章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep05_script()

func play_script():
	pass

func chapter2_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Kể từ sáng nay, chúng tôi đột nhiên phát hiện nhiều cảnh báo Biến động Pha Không thời gian trên New Opulentia.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Như thể có thứ gì đó thức dậy qua đêm...", "Mariru")
	await novel_interface.show_dialog("Các vệ tinh giám sát cho thấy bạn đã biến mất trong không khí loãng bên trong vùng dị thường, sau đó không lâu sau đó xuất hiện trở lại ở phía bên kia—với một người khác bên cạnh bạn.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru hướng ánh mắt về phía Annie.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Và ngay tại nơi hai bạn xuất hiện, sự dao động đó đã tự biến mất.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Vùng dị thường? Ý bạn là Trung tâm Nghiên cứu?", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chính xác.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Có thể đó là một loại trục trặc thiết bị nào đó...? Tôi đã ở ngoài đường chính suốt thời gian đó.", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Biểu cảm của Mariru trở nên nghiêm túc.")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bạn có nghĩ rằng bất cứ ai cũng có thể vào và ra khỏi Vùng dao động pha không thời gian không?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Sự biến động đó... có thực sự nguy hiểm đến vậy không?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bạn thực sự không biết gì cả, phải không...", "Mariru")
	await novel_interface.show_dialog("Pha không thời gian là nền tảng của định luật vật lý—giống như hệ tọa độ của vũ trụ. Cho dù các hạt chuyển động như thế nào thì bản thân các trục vẫn phải ổn định.", "Mariru")
	await novel_interface.show_dialog("Nếu những trục đó bắt đầu rung chuyển, dù chỉ ở một biên độ nhỏ nhất, thì trật tự của các hạt trong không gian đó sẽ bị phá hủy.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Nếu chỉ 5% số hạt trong tòa nhà bị dịch chuyển ngẫu nhiên 1 micromet thì cấu trúc vật chất sẽ bị phá hủy hoàn toàn và toàn bộ tòa nhà sẽ sụp đổ ngay lập tức.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tuy nhiên, bạn vẫn hoàn toàn ổn, và các tòa nhà trong khu vực đó không có dấu hiệu hư hại về cấu trúc nào cả.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Và theo nghiên cứu của chúng tôi về Divine Touch, một người mang \"GHOST\" thậm chí không thể bước vào một không gian như thế.)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Nói cách khác, về cơ bản, bạn đã đi vào mắt một cơn bão cấp 12 có thể xé nát mọi thứ, quay trở lại mà không hề hấn gì và bằng cách nào đó đã làm dịu cơn bão.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("...", GameConfig.player_name)
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Vậy những điều bất thường đó có phải là do những thứ đã tấn công tôi gây ra không?\nHọ có vẻ như đã mất trí...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dừng lại ngay đó! Tôi sắp tóm tắt Thượng viện—", "Mariru")
	await novel_interface.show_dialog("Một trong những kẻ điên đó thích chạy phân tích phát hiện nói dối trực tiếp trên nguồn cấp dữ liệu hội nghị, vì vậy ngay lúc này tôi càng biết ít thì càng tốt.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Đó... một cách rất đặc biệt để mô tả các Thượng nghị sĩ...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Và con gái cũng phải biết khi nào thì nói dối là được~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Tôi không phải con gái!!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Dù sao thì được thôi, tôi sẽ không nói gì cả...", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Trong những năm gần đây, chỉ có bốn trường hợp được ghi nhận về loại biến động không thời gian này trên toàn thế giới.\nHầu hết trong số đó đều liên quan đến các thất bại ngăn chặn liên quan đến Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Khi một Divine Touch không xác định được kích hoạt đột ngột, hậu quả có thể rất thảm khốc.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("...Liệu mọi người có bị tổn thương không?", GameConfig.player_name)
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Trong trường hợp xấu nhất, riêng số người chết đã lên tới hàng chục nghìn người.", "Mariru")
	await novel_interface.show_dialog("Nhưng các Thành phố Học viện lớn luôn có thỏa thuận ngầm là báo cáo những sự cố đó là \"tai nạn thông thường\"...", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Rò rỉ khí gas, tai nạn máy bay, tấn công khủng bố, những thứ tương tự...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Vậy thì lần này...", GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lần này thì khác. Chúng tôi chưa bao giờ chứng kiến những đợt bùng phát liên tục ở quy mô này trước đây...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Nó đã vượt quá mức cao nhất trong các kịch bản tuyên truyền của chúng ta. Khi thời điểm đến, chúng ta thậm chí sẽ không thể bịa ra một lời nói dối nào cho nó.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Điều này có thể là do tôi không?\nNếu tôi có thể giúp gì được cho bạn...", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Đừng suy nghĩ quá nhiều về nó. Những thay đổi về thể chất của bạn có thể có liên quan đến nhau, nhưng một mình bạn không thể gây ra sự xáo trộn lớn như vậy.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Nếu muốn tìm kiếm manh mối, có thể cùng người của ta đi xem hiện trường.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Nếu khả năng đó là có thật thì hiện tại cô ấy là câu trả lời duy nhất mà chúng ta có...)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Nhưng bạn tuyệt đối không được thúc ép bản thân và không được nói cho ai biết về mình. Hiểu không?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Không nói cho ai biết... vậy có nghĩa là...\nTôi phải giả vờ mình luôn là con gái phải không?", GameConfig.player_name)
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bạn đã biết điều này rồi phải không...?\nNew Opulentia luôn cai trị theo học thuyết khoa học trên hết.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Nếu bạn công khai trải nghiệm của mình, bạn sẽ được phân loại là \"đối tượng thử nghiệm\" và được đưa đến một tổ chức nghiên cứu~", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Khi đó bạn có thể sẽ có cả một hàng đàn ông trung niên đã thề cả đời với khoa học đang chờ để nghiên cứu cơ thể bạn...", "Mariru")
	await novel_interface.show_dialog("Suy cho cùng, không phải ngày nào họ cũng có được một cô gái dễ thương thế này—", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("...Được rồi, tôi hiểu rồi!!", GameConfig.player_name)
	await novel_interface.show_dialog("Tôi... Tôi tuyệt đối sẽ không nói điều gì liều lĩnh!!", GameConfig.player_name)

	print("=== 第二章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
