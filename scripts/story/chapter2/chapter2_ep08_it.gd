# chapter2_ep08.gd - 第二章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep08_script()

func play_script():
	pass

func chapter2_ep08_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Annie è già stato sistemato nella stanza accanto. Ci sono alcune cose che devo dirti da solo.", "Mariru")
	await novel_interface.show_dialog("Ho appena ricevuto la conferma.", "Mariru")
	await novel_interface.show_dialog("Da questa mattina, anomalie spaziotemporali su larga scala sono apparse in diverse grandi città...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Le regioni colpite di cui siamo a conoscenza finora includono Hovering Palace, Newmoridas, Masada Fort, Salmonton, New Opulentia e le Isole Lebona.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Allora questo non significa...\ntutte e sei le Città Accademia...?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Esatto. Il mondo intero lo sta guardando adesso e la portata dell’impatto ha superato di gran lunga le aspettative.", "Mariru")
	await novel_interface.show_dialog("Penso che... potrebbe esserci una possibilità...", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	await novel_interface.show_dialog("Tutto quello che hai descritto hai vissuto nel tuo sogno: i terroristi che attaccano il centro di ricerca, la città ridotta in rovina...", "Mariru")
	await novel_interface.show_dialog("...tutto ciò potrebbe essere realmente accaduto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("H-Com'è possibile?!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Non ho prove conclusive, ma stamattina potrebbe già essersi verificata un'enorme distorsione dimensionale.", "Mariru")
	await novel_interface.show_dialog("Anche il satellite True Sight di SID ha rilevato un'esplosione di rumore anormalmente violenta.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Forse questo renderà più facile capire: New Opulentia è stato davvero distrutto una volta, ma una sorta di forza ha invertito quella realtà...", "Mariru")
	await novel_interface.show_dialog("E quella forza sembra essere collegata anche ai cambiamenti del tuo corpo, così come agli attacchi di quegli strani nemici.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Naturalmente questa è ancora solo la mia ipotesi.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Quest'idea... non è un po' troppo audace...?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("A causa degli eventi di oggi, le altre cinque Città Accademia stanno tutte facendo pressione sul Senato per consentire l'ingresso per le indagini.", "Mariru")
	await novel_interface.show_dialog("E se il tuo legame con questo incidente viene scoperto, essere portato via da un istituto di ricerca sarà l'ultimo dei tuoi problemi...", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Gli agenti di ogni organizzazione di intelligence ti segnalerebbero come un obiettivo chiave.", "Mariru")
	await novel_interface.show_dialog("Senza contare quelli già sotto copertura, oggi sono entrati New Opulentia oltre un centinaio di agenti dei servizi segreti provenienti da diversi paesi solo sotto false identità.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Sai tutto questo in modo così dettagliato?\nPerché non li fermi?", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Hmph. Meglio tenere la situazione sotto controllo al buio che costringerli a cambiare volto e sparire alla vista.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog(GameConfig.player_name+", devi capire questo: finché avrai ancora il corpo di una ragazza, non potrai mai tornare alla tua vecchia vita.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Tuttavia, il fatto che noi di SID ti abbia trovato per primo potrebbe essere un colpo di fortuna.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Diventare una ragazza da un giorno all'altro...\nCome dovrei spiegarlo ai miei compagni di classe e ai miei amici...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mm... non sei preoccupato per i tuoi genitori?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mia madre è morta quando ero piccola.\nMio padre... è già scomparso da molti anni...", GameConfig.player_name)
	await novel_interface.show_dialog("Ho vissuto in collegio fino all'età di dodici anni.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("(...Quindi il programma di assistenza all'infanzia del dopoguerra del gorilla ha davvero aiutato alcuni bambini, dopo tutto.)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mm, hai avuto la tua parte di difficoltà.\nTuttavia, non devi preoccuparti del problema della transizione dell'identità.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Transizione di identità...?", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sul volto di Mariru appare un sorriso piuttosto minaccioso...")

	print("=== 第二章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
