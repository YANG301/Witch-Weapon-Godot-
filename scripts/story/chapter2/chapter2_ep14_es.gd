# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Pero quiero volver a ser un niño...\n¿Qué se supone que debo hacer...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Bueno... ¿por qué no seguir siendo una chica así?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué—??\n¡No! ¡En absoluto!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Como dijiste, tal vez el destino de esta ciudad se desvió de la destrucción y decenas de millones de vidas regresaron gracias a ello...", "Mariru")
	await novel_interface.show_dialog("Un milagro de esa escala tendrá algún tipo de precio, ¿no crees?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("¿Y si ese precio... fuera simplemente que terminaras así?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Cómo podría ser eso?...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Además...\nYa tienes quince, ¿verdad?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Una chica de tu edad\nal menos debería usar sostén...¿verdad?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("¿Eh?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Todavía estás creciendo, ¿sabes? Es posible que sigan creciendo de ahora en adelante...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("¡¿Quéaaaa?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si no usas uno, causará problemas.\nPor ejemplo, cuando estás corriendo...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("¡¿No te refieres a un sujetador...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exacto. Creo que un estilo lindo y femenino te quedaría bien, ¿no?\nTienes el tipo de cara que se ve adorable~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("¡¡Por supuesto que no!!\n¡¡Soy un niño!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y por cierto, la forma en que estás sentado ahora mismo...\nEso es sorprendentemente atrevido de tu parte~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Yo-yo-yo-yo...\n¡¡Voy al baño!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Dios mío—\nEse niño realmente es demasiado fácil de burlar~", "Mariru")
	await novel_interface.show_dialog("Parece que no me aburriré de ahora en adelante~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Me miré en el espejo. Pensando en esa conversación, me deslicé lentamente por la pared y me agaché allí.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Todavía no puedo creerlo...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Algo así... ¡¡No quiero usarlo en absoluto!!", "Lian")
	await novel_interface.show_dialog("Como hombre...\n¡Siento como si algo importante se estuviera alejando cada vez más de mí!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Y si alguien me viera en un lugar donde venden ese tipo de cosas...\n¡No, no! ¡En absoluto!", "Lian")
	await novel_interface.show_dialog("(Si realmente hiciera eso...)\n(¡¡¡Entonces realmente sería... un pervertido!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¡¡No quiero ser un pervertido!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("¿Ah? ¿Sigues aquí en cuclillas llorando?\nYa he elegido la talla adecuada según tu busto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Los dejé en tu habitación. Piensa en ellos como un regalo de mi parte~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¡No, gracias!\n¡¡Usaré vendas en su lugar!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Este niño... ¿eres inocente o simplemente pervertido?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Aunque usar vendajes adhesivos podría ser... aún más interesante.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("¿O disfrutas esa pequeña punzada de dolor cuando te los arrancas?", "Mariru")
	await novel_interface.show_dialog("Qué lástima. Todo lo que tenemos aquí son vendajes en aerosol~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("¡¡Estás haciendo esto a propósito, verdad!!\nUgh... ¡¡Maldita sea!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("¡¡Tch, está bien, lo usaré~!\n¡¡Si soy un hombre de verdad, de qué hay que avergonzarse!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... ¿Mm? ¿Esperar?\nEsto... es realmente difícil...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Mm-hm.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*clic*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Ahí, te lo abroché~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\n¡¿C-Cómo llegaste aquí?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Solo estaba ayudándote amablemente~\nPor cierto, ¿puedes manejar los calcetines hasta la rodilla del uniforme tú solo?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Eh?! Son solo calcetines, ¿qué tiene eso de difícil?\n¡Lo haré yo mismo!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("¿Y la falda?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yo también puedo con la falda... Me la pondré yo misma...\nMariru, ¡¡lárgate ya!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Wow~ Así que realmente sabes cómo ponerte una falda. Eso es impresionante.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Una falda no requiere estirarse detrás de la espalda para abrocharse nada, entonces, ¿qué tiene de difícil?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, está bien entonces~\nVolveré en un momento y veré cómo te ves una vez que estés vestida.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("¡Maldita sea... Mariru me está subestimando seriamente!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Algún tiempo después...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! ¡Estoy vestido!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("¿Estás seguro?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡De qué hay que estar inseguro! Me lo puse muy bien, ¿no?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Entonces... ¿dónde está exactamente tu cremallera?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡En el frente! ¡Hace que sea más fácil cuando necesitas usar el baño!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... ¿y qué usas exactamente para ir al baño ahora?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¡E-Eso no tiene nada que ver con nada! De todos modos...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft... La cremallera va en el costado.\nVe a mirarte en el espejo~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("El lado, luego el lado...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¿Por qué es tan difícil ponerse la ropa de niña?", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
