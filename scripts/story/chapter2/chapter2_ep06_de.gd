# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(murmelt) Diese kleine Göre war viel interessanter...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Diagonal vor Mariru flimmert eine Aufforderung zur Sprachanrufverbindung über den Bildschirm. Die bewusst verzerrte elektronische Stimme verdeckt das ursprüngliche Geschlecht des Sprechers.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Ich habe dieses Briefing schon oft gemacht, aber dieses einseitig verschlüsselte Interferenzformat ist immer noch ärgerlich.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Was das Verschwinden des Ross Goblet betrifft, wie geht die Untersuchung nun voran?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Heute Morgen um 00:15 Uhr bestätigte das Sicherheitssystem, dass die Ross Goblet verschwunden war.", "Mariru")
	await novel_interface.show_dialog("Um 06:40 Uhr gab das Satellitenüberwachungssystem True Sight eine Warnung aus, nachdem es starke Dimensionsverzerrungen festgestellt hatte.", "Mariru")
	await novel_interface.show_dialog("Dann, von 07:00 Uhr heute Morgen bis jetzt, hat das Aegis-System innerhalb von New Opulentia sechs Raumzeit-Phasenfluktuationswarnungen erkannt.", "Mariru")
	await novel_interface.show_dialog("Und wenn wir das Forschungsinstitut als Zentrum nehmen, erschienen in einem Umkreis von fünfzehnhundert Kilometern gleichzeitig zweiunddreißig ähnliche Alarme...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("All das steht bereits im Dokument. Geben Sie mir die Schlussfolgerung.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru blickt über ihre rechte Schulter und lächelt.")
	await novel_interface.show_text_only("Allein am Tonfall kann sie erkennen, dass es sich um den strengen, ernsten Vorstandsvorsitzenden der Senat handelt.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—Das war kein Diebstahl. Es war das Erwachen eines Substance H, zusammen mit der Kettenreaktion, die es auslöste.", "Mariru")
	await novel_interface.show_dialog("Und gemessen an der aktuellen Häufigkeit und dem Ausmaß können wir immer noch nicht feststellen, ob es sich um einen memetischen Typ Substance H handelt.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Kaum ist Mariru mit dem Sprechen fertig, ertönt erschrockenes Gemurmel und eine gedämpfte Diskussion durch die abgedunkelten Bildschirme um sie herum.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Was?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Von Marirus Linken ertönt eine tiefe, gleichmäßige Stimme.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Du meinst einen exponentiellen Ausbruch einer geistesbeeinflussenden „Göttlichen Berührung“?\nNun, das ist interessant...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Im Moment sieht es eher danach aus, dass mehrere Vorfälle gleichzeitig ausbrechen.\n\"Divine Touch\"... Ich mag ungenaue Terminologie nicht besonders.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Obwohl er die Autorität für geistesbeeinflussende Substance H... ist)", "Mariru")
	await novel_interface.show_dialog("(Ich werde das Gefühl immer noch nicht los, dass dieser Gorilla sein Gehirn durch zu viel Strahlung verbrannt hat.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Dann nach Ihrem Urteil...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ich kann noch keinen Abschlussbericht einreichen. Wir haben einfach nicht genügend umsetzbare Informationen.", "Mariru")
	await novel_interface.show_dialog("Angesichts der aktuellen Situation beantrage ich eine uneingeschränkte Ermittlungsanordnung der Klasse S. Ich hoffe, Sie können es alle verstehen.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru ignoriert das Flüstern um sie herum und richtet ihre Aufmerksamkeit wieder auf das Handheld-Terminal.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Das kleine Mädchen ging in eine andere Anomaliezone...)", "Mariru")
	await novel_interface.show_dialog("(Wie erwartet – sie verschwand, tauchte eine Weile später wieder auf und dann hörte die Phasenfluktuation in der Nähe wieder auf.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Das Filmmaterial von der Szene... Ist das Blut an ihr?)", "Mariru")
	await novel_interface.show_dialog("(Dieser Idiot... sagt mir nicht, dass sie tatsächlich –!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Du scheinst etwas abgelenkt zu sein.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was?... Überhaupt nicht.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Was auch immer Sie gerade anstarren – enthält es Informationen, die wichtiger sind als dieses Briefing?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Nein, es ist nur ein Video von einem Kätzchen. Willst du es sehen?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Von Marirus Linken ertönt ein scharfes elektrisches Heulen und Summen.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Sei nicht so wütend. Ein wenig Abwechslung steigert die Arbeitseffizienz.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru lässt ihren Blick durch den Raum schweifen. Es scheint, dass niemand den vorübergehenden Ausrutscher bemerkt hat.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Auf jeden Fall entsprechen die grundlegenden Informationen, die wir bisher erhalten haben, genau den Angaben im Briefing.\nDer Vorfall wird noch weiter untersucht.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wenn es keine Fragen gibt, gehe ich zum Tatort.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Bevor Mariru gehen kann, ertönt von links eine etwas leichtfertige Stimme.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...Ich habe gehört, dass Ihre Untergebenen zwei Oberschüler zur Befragung nach SID zurückgebracht haben?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Schon wieder dieser widerliche Bastard.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("War da etwas Besonderes an ihnen, Lady Mariru... Nein, Doktor?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Überhaupt nichts. Wir haben es bereits bestätigt – es waren nur zwei übermäßig neugierige kleine Kätzchen, die sich in eine Sperrzone geschlichen haben.", "Mariru")
	await novel_interface.show_dialog("Ich werde dafür sorgen, dass sie später nach Hause geschickt werden.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ich verstehe. Das ist dann gut.", "#C")
	await novel_interface.show_dialog("In einer sensiblen Zeit wie dieser wäre es problematisch, wenn andere Länder anfangen würden, sie als eine Art seltsame Existenz zu behandeln...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Diese Bemerkung löste bei den anderen einen Aufruhr aus.")
	await novel_interface.show_text_only("...Was soll das heißen?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ich bin mir sicher, dass eine nachlässige Bemerkung manchen Menschen Unbehagen bereiten kann.\nEs tut mir leid – tun Sie einfach so, als hätten Sie sie nie gehört.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Was für ein absolut abscheulicher Mann.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Nun ja, dieser Vorfall hat jedenfalls bereits die Aufmerksamkeit der anderen Akademiestädte auf sich gezogen.", "Bright")
	await novel_interface.show_dialog("Von nun an verlassen wir uns bei der geheimen Untersuchung und der Verwaltung öffentlicher Informationen auf Sie.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Natürlich.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
