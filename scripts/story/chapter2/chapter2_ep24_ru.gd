# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("Вернувшись в квартиру, Elluka все еще цепляется за мою одежду даже во сне.")
	await novel_interface.show_text_only("Annie и Mariru приказывают мне повернуться и не подглядывать, затем образуют человеческую стену, пока они снимают с Elluka металлические рукавицы и порванное пальто и переодевают ее в обычную одежду.")
	await novel_interface.show_text_only("Затем они заставляют меня поклясться жизнью, что я не причиню никакого вреда Elluka, прежде чем позволить мне отвести ее в свою комнату.")
	await novel_interface.show_text_only("...Сейчас Elluka спит на моей кровати, все еще сжимая мою одежду, поэтому все, что я могу сделать, это сесть рядом с ней.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Почему ты такой навязчивый, малыш? \\nБоже, я так устал...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("После целой ночи операции я совершенно измотан. Падая обратно на кровать, я чувствую бумагу в кармане.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Annie сказал, что это... Фрагменты Гримуара?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Elluka захотел их и посмотрел на меня как на милого домашнего любимца…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Лежа на кровати, я еще раз просматриваю страницы. Но содержание так же непонятно, как и то, что появилось ранее.")
	await novel_interface.show_text_only("Когда я перелистываю страницы, пара страниц выскальзывает из моей руки и падает на тело Elluka.")
	await novel_interface.show_text_only("В тот момент, когда страницы касаются ее тела, внезапно появляется голубоватое свечение.")
	await novel_interface.show_text_only("Со страниц вырывается волна символов и слов, и даже воздух в моей комнате начинает дрожать.")
	await novel_interface.show_text_only("Внезапно оставшиеся страницы кажутся притянутыми какой-то невидимой силой к телу Elluka .")
	await novel_interface.show_text_only("Возникает вспышка ослепительного света, затем все исчезает.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ч-что это?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Поиск начат. Цель определена —\\nШоколадная... сестренка!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Elluka?! Ты проснулся!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka внезапно обнимает меня. В это же время дверь позади меня распахивается.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Эй, что это трясло?\\n...Подожди, ты наконец сделал шаг на Elluka?!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie смотрит на меня как на извращенца.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Это не то, что вы думаете. Позвольте мне объяснить!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Энергия полная.\\nПоиск... цели не найден.", "Elluka")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Почему, кого ты ищешь?", "Lian")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("… Администратор здания суда.", "Elluka")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Здание суда...? Что это?\\nВ любом случае, давайте возьмем Mariru и разберемся, что делать.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Здание суда... Ребята, из-за вас у меня большие неприятности. Ваш друг — член Конгрегации.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("А? Что это такое?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Исследуя ведьм, я узнал об этих странных подпольных организациях, в том числе о Конгрегации, старейшей в своем роде.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Позже Конгрегация распалась на разные фракции, и здание суда — одна из них.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("С тех пор, как оно отделилось сотни лет назад, Здание суда угрожало уничтожить всех ведьм и организовало печально известную охоту на ведьм.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Ненавижу иметь дело с такими суеверными группами.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Изначально я планировал поместить Elluka в детскую школу в New Opulentia...\\nНо в сложившихся обстоятельствах я не могу просто отпустить ее.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("У тебя, должно быть, другие планы. Вам лучше не проводить о ней никаких странных исследований...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Я настолько плох в твоих глазах?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ударяет меня по голове. \\nElluka надувает губы и сердито смотрит на Mariru.")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Цель определена. Рейтинг угрозы чрезвычайно высок.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("… Маленький мальчишка.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("О, Elluka, какое задание тебе дал Jacob?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka хмурится и медленно вспоминает свою задачу—")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Сначала уничтожьте ведьм. Завершенный. \\nВо-вторых, получите рукопись. Неуспешный.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Рукопись? Разве Lian не тот, у кого оно есть?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Поиск… Исключение статуса. \\nРукопись… уничтожена.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Поглощено? Ты имеешь в виду, что страницы теперь внутри тебя?\\nИли они все это время были частью гримуара Elluka?", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Ваш Администратор не позволил вам поглотить их...\\nБоялся ли он, что вы станете слишком могущественными, чтобы он мог их контролировать?", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Это целая история всего из пары ее слов, Lian. Отличная работа!", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Подожди, Гримуар Elluka. \\nЭто означает…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Этот маленький ребенок тоже ведьма?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru пытается ущипнуть ее за щеку, но Elluka ловко уворачивается.")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("Я давно слышал, что некоторые группы пытаются создавать ведьм и контролировать их. Нет недостатка в карьеристах, жаждущих иметь суперсолдат!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Откуда вы двое так много знаете о ведьмах...? Я здесь единственный, кто в темноте. Скажи мне, как девушка становится ведьмой?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Ох, поначалу я тоже не был уверен. Я помню, как читал эту книгу, не зная, что это такое.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("У меня начало кружиться голова, поскольку содержание становилось все труднее. Затем в какой-то момент я почувствовал, как неизвестная сила просто вошла в мое тело.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Однажды я произнес заклинание из книги, и меня затащило в другое Пространство-Время…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Пространство-время… По спутниковым данным, Поток Пространства-времени уже остановился, когда вы прибыли на подстанцию.", "Mariru")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Неудивительно, что у меня не было таких же ощущений, как в других областях потока!", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("То, что вы называете «Областью потока», в древней ведовской литературе упоминается как «Ведьмин кокон».", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("Он образуется, когда человек превращается в ведьму. Посторонние не могут ни сломать его, ни войти в него. По своей природе оно очень похоже на пространство, созданное Substance H, не так ли?", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("И почти в тот момент, когда поток исчез, наш спутник зафиксировал оптические сигналы…", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Я имею в виду, появились парни, против которых ты сражался.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Подумайте сами — «Кокон ведьмы»… В тот момент, когда кокон исчез, оттуда вышли эти ребята. Они как будто вылупились из кокона.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Ведьма, прекрати!", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Значит, ведьмы действительно сошли с ума, поскольку не могут переносить информацию из Гримуара!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Они были обычными девочками. Они не выдержали магической силы, исходящей от сценариев, и были ранены.", "Annie")
	await novel_interface.show_dialog("В тот момент, когда они вызвали сильное пространственное искажение, они стали...\\nЧудовищными существами, которых люди называют «Ведьмами».", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Во многих древних книгах сказано, что чем больше информации о магической силе человек знает, тем легче он страдает необратимым безумием.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Если они потеряют рассудок, ведьмы могут вызвать большие бедствия. Если это правда…", "Mariru")
	await novel_interface.show_dialog("Тогда это может быть причиной того, что охота на ведьм длилась так долго в Европе.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Дерьмо. Похоже на пандемию.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("Насколько нам известно, администратор Elluka отдал приоритет охоте на ведьм как способу восстановления фрагментов Гримуара.", "Mariru")
	await novel_interface.show_dialog("Но он не позволил Elluka использовать Гримуар… Возможно, он хочет создать с его помощью еще больше ведьм.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Но я прочитал Гримуар Elluka и не узнал ни одного слова. Это как-то связано с тем, что я мальчик?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("… Мальчик?", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka нервничает и отступает назад, ее лицо озадачено.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Э-э, Elluka, я объясню это позже. \\nНе волнуйтесь…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("Но я смог это прочитать. Так может быть Lian действительно просто идиот?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Меня больше интересует, как можно было легко войти в Кокон Ведьмы.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Я не просил об этом! Каждый раз, когда я вхожу в это место, всегда кто-то хочет меня убить…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("— То, что вы сделали, предполагает пересечение нескольких измерений. Наука пока не может объяснить это.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Если наука здесь может что-то объяснить, то первое, что я хочу знать, это почему я превратилась в девочку!")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Хи-хи, просто отложи это в сторону. Любой вопрос рано или поздно будет решен!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Это позитивное мышление…", "Lian")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
