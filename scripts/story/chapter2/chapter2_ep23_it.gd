# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka assalta me e Annie con la magia del fulmine. Non volendo farle del male, tutto ciò che possiamo fare è difenderci disperatamente.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Se continua così, ci faremo tutti del male...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ahh... Ahh... \\nElluka, fermati! Calmati!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Obiettivo bloccato. Attacco continuo—", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un colpo ardente squarciò l'aria, seguito da un fragore. \\nApro gli occhi, solo per ritrovarmi illeso.")
	await novel_interface.show_text_only("Dietro l'Amministratore, il rotore principale dell'aereo si ribalta lentamente,\\n poi cade come un ramoscello spezzato.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Amministratore")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ehm... tutti bloccati——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("La voce di Mariru risuona da un altoparlante lontano.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Signorina Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tre elicotteri compaiono in alto e i loro fari accecanti inondano il terreno di bianco come se fosse pieno giorno.")
	await novel_interface.show_text_only("Mariru è seduto nell'elicottero centrale e grida attraverso l'altoparlante. L'enorme pistola montata davanti a lei fuma ancora.")
	await novel_interface.show_dialog("Il giocattolino di Ai è davvero formidabile. In realtà ha eliminato l'albero del rotore in un solo colpo.", "Mariru")
	await novel_interface.show_text_only("Mariru sembra un po' troppo eccitata, come se le piacerebbe sparare un altro colpo... Ehi, quella cosa conta già come un cannone, non è vero?!")
	await novel_interface.show_text_only("La cabina di pilotaggio del mezzo di trasporto precipitato si apre dall'interno e due piloti escono precipitando fuori in preda al panico, lottando per la propria vita.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ahah... Ahah...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un elicottero atterra nello spazio aperto fuori dalla sottostazione. Scortato da una folla di soldati pesantemente armati, Mariru si avvicina a noi di buon umore.")
	await novel_interface.show_text_only("Avendo visto chiaramente il volto di Mariru, l'Amministratore sputò ferocemente per terra.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph. Un altro SID cagnolino.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Questa non è un'operazione SID. Sono qui come consigliere del Metropolitan Defense Bureau di New Opulentia, per svolgere una missione di sicurezza antisommossa.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Solo allora mi rendo conto che le persone scese dagli elicotteri non sono affatto SID agenti. Ognuno di loro indossa una fascia con la scritta \"MD\".")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Non è vero... Capitano Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Esatto. I Metropolitan Defense Bureau sospettano che qui sia in corso un attacco terroristico contro New Opulentia.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ordino a te e ai tuoi uomini di cessare immediatamente le ostilità e di tornare con noi per essere interrogati.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Quel muscoloso sembra un lottatore laggiù... Giuro di averlo già visto... È uno dei conoscenti di Mariru?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quelle due ragazze carine sono tue subordinate? Un dipartimento senza limiti di età sembra piuttosto carino...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... questo piccolino...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ehi, sei sicuro di volerlo fare?", "Amministratore")
	await novel_interface.show_dialog("Questa è una zona smilitarizzata ai sensi dell'accordo. Nessuna delle vostre organizzazioni ha l'autorità per operare qui.", "Amministratore")
	await novel_interface.show_dialog("E non avresti potuto ottenere il permesso del Congresso Unito così in fretta!", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Quelle burocrazie multinazionali si muovono a passo di lumaca.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... mi dispiace deluderti, ma prenderò la mia gente e me ne andrò adesso.", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ Non ho ancora finito di parlare... La Johnson Heavy Industries, d'altra parte, lavora molto più velocemente.", "Mariru")
	await novel_interface.show_dialog("Dopotutto, il loro figlio maggiore sta ancora studiando a New Opulentia~ In questo momento sono loro a chiedermi favori...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Cosa?!", "Amministratore")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("In questo momento, il 3% del carico di questa sottostazione è già stato immesso nella rete cittadina di New Opulentia—", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Secondo l'accordo di Salmonton ogni attacco contro la rete elettrica di New Opulentia è considerato un atto terroristico di prima classe.", "Mariru")
	await novel_interface.show_dialog("Per incidenti come questo, il Metropolitan Defense Bureau detiene la massima autorità operativa riconosciuta dal Congresso Unito.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Dopotutto, il nostro Aegis host... \\nNon può funzionare senza energia elettrica.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Come potresti far scappare Aegis fuori dalla rete cittadina?! Taglia i trucchi!", "Amministratore")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Basta parlare. Portateli via!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Aspetta! Il Forte di Masada e New Opulentia hanno firmato un accordo di immunità diplomatica molto tempo fa, vero?", "Amministratore")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'amministratore tira fuori il suo documento d'identità dalla tasca del cappotto e lo mostra compiaciuto a Mariru e Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sono Jacob Schmidt, addetto militare della Terza Città Accademia, Forte di Masada, al Congresso Unificato.", "Amministratore")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se mi arrestate qui, presumo che causerà qualche problema diplomatico piuttosto inutile, non è vero?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("…\\nMolto bene. Hai un minuto per sparire dalla mia vista.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Ma sembra che il tuo veicolo abbia dei problemi... \\nQuindi, potresti dover tornare a casa a piedi.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("Cosa?! Non è giusto!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Le regole sono regole. L'impulso a sangue caldo non risolverà nulla.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Ma…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, stiamo partendo.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Aspetta, la tua identità è stata verificata, il che va bene. Ma questa ragazzina... non credo che occuperà nessun incarico al vostro Ministero degli Affari Esteri.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Tu!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Mi dispiace, ma lei è la principale sospettata dell'attacco terroristico di oggi.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Se provi a prenderla con la forza, tutto ciò che posso fare è informare con rammarico la tua ambasciata che sei stato ucciso a colpi di arma da fuoco in un attacco terroristico.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru tira fuori una pistola e la punta contro la testa di Jacob.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmph... Non è altro che uno strumento.\\nSe la vuoi così tanto, allora tienitela!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Livello di potenza, critico... \\nHah... Attività terminata...", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, che si era sforzata di andare avanti per tutto questo tempo, crolla improvvisamente a terra come una macchina che ha perso potenza.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. In quello stato probabilmente è comunque inutile. Prendetevi cura voi stessi dei rottami senza valore!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob alza il bavero e accelera il passo, senza gettare nemmeno uno sguardo indietro. Presto scompare nell'oscurità.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, svegliati! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, aiutala, per favore!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Si presenta ancora sul rilevatore di vita. Probabilmente è solo esausta.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("E tu, qualcuno che ha ancora bisogno di proteggersi, sei qui fuori a gridare di salvare altre persone?", "Mariru")
	await novel_interface.show_dialog("...Stai diventando sempre più un idiota dal sangue caldo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Andiamo a casa.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Quella ragazza è nostra nemica, vero?", "Nantetsu")
	await novel_interface.show_dialog("Il Senato non richiede che tutti i terroristi di prima classe siano arrestati immediatamente e poi...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chiedi a ogni elicottero di mantenere i suoi moduli anti-scansione continuamente in funzione. I quattro UAV di SID ci scorteranno in modalità di contrattacco automatico.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("La mia gente... la scorterò personalmente. Chiunque abbia un desiderio di morte è il benvenuto a provarmi!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha… Questo è il Mariru che conosco.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru chiede all'équipe medica di curare le nostre ferite, poi porta Annie, Elluka e me a bordo dell'elicottero.")
	await novel_interface.show_text_only("Annie è così stanco. Si appoggia alla mia spalla e presto si addormenta.")
	await novel_interface.show_text_only("Anche Elluka dorme, sdraiata sulle mie ginocchia con un po' di bava all'angolo della bocca. Non è rimasto nulla dello sguardo gelido che aveva pochi minuti prima.")
	await novel_interface.show_text_only("Dopotutto è solo una ragazzina normale... e per qualche ragione, questo mi riempie di sollievo.")
	await novel_interface.show_text_only("Andrà tutto bene. Tutto funzionerà, proprio come dice quella canzone:\\nAndrà tutto bene.")
	await novel_interface.show_text_only("Anche se ora regna la pace tra le sei Città Accademia, vaste regioni fuori dal loro controllo sono ancora devastate dalla guerra.")
	await novel_interface.show_text_only("Mi chiedo quanti bambini come Elluka vengano ancora usati come armi o strumenti...")
	await novel_interface.show_text_only("Mariru aveva ragione. Sono un idiota che fa sempre il passo più lungo della gamba.")
	await novel_interface.show_text_only("Ma non ho quasi mai incontrato qualcuno disposto ad abbassare tutta la guardia e addormentarsi tranquillamente accanto a me. Ora ce ne sono due.")
	await novel_interface.show_text_only("… Mi piace essere un idiota.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
