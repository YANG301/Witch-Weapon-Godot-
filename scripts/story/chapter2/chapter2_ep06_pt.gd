# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Murmurando) Aquele pirralho era muito mais interessante...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um prompt de conexão de chamada de voz pisca na tela diagonalmente na frente de Mariru. A voz eletrônica deliberadamente distorcida mascara o gênero original do locutor.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(Já fiz esse briefing várias vezes, mas esse formato de interferência criptografada unilateral ainda é irritante.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Então, em relação ao desaparecimento do Ross Goblet, como anda a investigação agora?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Às 00h15 desta manhã, o sistema de segurança confirmou que o Ross Goblet havia desaparecido.", "Mariru")
	await novel_interface.show_dialog("Às 06h40, o sistema de monitoramento por satélite True Sight emitiu um alerta após detectar graves distorções dimensionais.", "Mariru")
	await novel_interface.show_dialog("Então, das 07:00 desta manhã até agora, o sistema Aegis detectou seis alertas de flutuação de fase do espaço-tempo dentro de New Opulentia.", "Mariru")
	await novel_interface.show_dialog("E se tomarmos o instituto de pesquisa como centro, trinta e dois alertas semelhantes apareceram simultaneamente num raio de mil e quinhentos quilômetros...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("Tudo isso já está no documento. Dê-me a conclusão.", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru olha por cima do ombro direito e sorri.")
	await novel_interface.show_text_only("Apenas pelo tom, ela pode dizer que é o severo e sério Chefe do Executivo do Senado.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—Isso não foi um roubo. Foi o despertar de um Substance H, junto com a reação em cadeia que ele desencadeou.", "Mariru")
	await novel_interface.show_dialog("E a julgar pela frequência e escala atuais, ainda não podemos determinar se é do tipo memético Substance H.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No instante em que Mariru termina de falar, murmúrios assustados e discussões abafadas ondulam pelas telas escuras ao seu redor.")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("O que?!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma voz profunda e firme vem da esquerda de Mariru.")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Você quer dizer um surto exponencial de um \"Toque Divino\" que afeta a mente?\nIsso é interessante...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("No momento, parece mais provável que ocorram vários incidentes ao mesmo tempo.\n\"Toque Divino\"... Não gosto particularmente de terminologia imprecisa.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(Embora ele seja a autoridade em afetar a mente Substance H...)", "Mariru")
	await novel_interface.show_dialog("(Ainda não consigo afastar a sensação de que esse gorila fritou o cérebro com muita radiação.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Então, de acordo com o seu julgamento...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ainda não tenho como apresentar um relatório de conclusão. Simplesmente não temos informações acionáveis ​​suficientes.", "Mariru")
	await novel_interface.show_dialog("Dada a situação atual, estou solicitando uma ordem de investigação irrestrita de Classe-S. Espero que todos vocês possam entender.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ignorando os sussurros ao seu redor, Mariru volta sua atenção para o terminal portátil.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(Aquela menina foi para outra zona de anomalia...)", "Mariru")
	await novel_interface.show_dialog("(Como esperado – ela desapareceu, reapareceu um pouco depois e então a flutuação da fase próxima parou novamente.)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(A filmagem da cena... tem sangue nela?)", "Mariru")
	await novel_interface.show_dialog("(Aquela idiota... não me diga que ela realmente—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("Você parece um pouco distraído.", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê?... De jeito nenhum.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Seja o que for que você esteja vendo, contém informações mais importantes do que este briefing?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Não, é só o vídeo de um gatinho. Quer ver?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Um gemido elétrico agudo e um zumbido irrompem à esquerda de Mariru.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Não fique tão bravo. Um pouco de diversão melhora a eficiência do trabalho.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru varre o olhar pela sala. Parece que ninguém percebeu o deslize momentâneo agora.")
	novel_interface.character_light()
	await novel_interface.show_dialog("De qualquer forma, a informação básica que obtivemos até agora é exatamente como declarada no briefing.\nO incidente ainda está sob investigação.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Se não houver perguntas, vou para o local.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Antes que Mariru possa sair, uma voz um tanto irreverente vem de sua esquerda.")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...Ouvi dizer que seus subordinados trouxeram dois estudantes do ensino médio de volta para SID para interrogatório?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(Aquele bastardo desagradável de novo.)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("Havia algo especial neles, Senhora Mariru... não, doutor?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Nada mesmo. Já confirmamos: eram apenas dois gatinhos muito curiosos que entraram furtivamente em uma zona restrita.", "Mariru")
	await novel_interface.show_dialog("Vou providenciar para que eles sejam mandados para casa depois.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Eu vejo. Isso é bom, então.", "#C")
	await novel_interface.show_dialog("Num momento delicado como este, seria problemático se outros países começassem a tratá-los como uma espécie de existência estranha...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Essa observação provoca alvoroço entre os outros.")
	await novel_interface.show_text_only("...O que isso quer dizer?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tenho certeza de que um comentário descuidado pode deixar algumas pessoas desconfortáveis.\nMinhas desculpas - apenas finja que nunca ouviu isso.", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(Que homem totalmente detestável.)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("Pois bem, independentemente disso, este incidente já chamou a atenção das outras Cidades Acadêmicas.", "Bright")
	await novel_interface.show_dialog("Contaremos com você para a investigação secreta e o gerenciamento de informações públicas de agora em diante.", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Naturalmente.", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
