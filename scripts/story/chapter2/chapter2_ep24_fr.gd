# chapter2_ep24.gd - 第二章第24话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep24_script()

func play_script():
	pass

func chapter2_ep24_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/bedRoom.png")
	await novel_interface.show_text_only("De retour à l'appartement, Elluka s'accroche toujours à mes vêtements même dans son sommeil.")
	await novel_interface.show_text_only("Annie et Mariru m'ordonnent de me retourner et de ne pas regarder, puis forment un mur humain pendant qu'ils enlèvent les gantelets métalliques et le manteau déchiré de Elluka et la changent en vêtements ordinaires.")
	await novel_interface.show_text_only("Puis ils me font jurer sur ma vie que je ne ferai aucun mal à Elluka, avant de me permettre de l'emmener dans ma chambre.")
	await novel_interface.show_text_only("...Maintenant, Elluka dort sur mon lit, tenant toujours mes vêtements, donc tout ce que je peux faire c'est m'asseoir à côté d'elle.")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Pourquoi es-tu si collant, gamin ? \\nMon Dieu, je suis tellement fatiguée…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Après une nuit entière d’opération, je suis complètement épuisé. En retombant sur le lit, je sens le papier dans ma poche.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Annie a dit que ce sont… les Fragments du Grimoire ?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Elluka semblait les vouloir et me regardait comme un adorable animal de compagnie…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Allongé sur le lit, j'examine à nouveau les pages. Mais le contenu est tout aussi incompréhensible que ce qu’il apparaissait auparavant.")
	await novel_interface.show_text_only("Alors que je tourne les pages, quelques pages glissent de ma main et tombent sur le corps de Elluka.")
	await novel_interface.show_text_only("Au moment où les pages touchent son corps, une lueur bleuâtre apparaît soudainement.")
	await novel_interface.show_text_only("Une vague de symboles et de mots jaillit des pages, et même l'air de ma chambre se met à trembler.")
	await novel_interface.show_text_only("Tout d'un coup, les pages restantes semblent entraînées par une force invisible vers le corps de Elluka.")
	await novel_interface.show_text_only("Il y a un éclat de lumière éblouissante, puis tout disparaît.")
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Qu-Qu'est-ce que c'est...?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Recherche lancée. Cible identifiée :\\nChocolat... grande sœur !", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Elluka?! Vous êtes réveillé !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka me prend soudain dans ses bras. Au même moment, la porte derrière moi s’ouvre claquée.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Hé, c'était quoi cette secousse ?\\n...Attendez, avez-vous finalement bougé sur Elluka ?!", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie me regarde comme si j'étais un pervers.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Ce n'est pas ce que tu penses. Laissez-moi vous expliquer !", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Énergie, pleine.\\nRecherche... cible introuvable.", "Elluka")
	novel_interface.character_2nd_light(0.35,"worry")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Pourquoi, qui cherches-tu ?", "Lian")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"sleepy")
	await novel_interface.show_dialog("… Administrateur, du Palais de Justice.", "Elluka")
	novel_interface.character_2nd_light(0.35,"perspire1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Le palais de justice... ? Qu'est-ce que c'est ?\\nQuoi qu'il en soit, allons chercher Mariru et voyons quoi faire.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Palais de justice… Vous me causez de gros ennuis. Votre ami est membre de la Congrégation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Hein ? Qu'est ce que c'est?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("En faisant des recherches sur les sorcières, j'ai fait la connaissance de ces étranges organisations clandestines, dont la Congrégation, la plus ancienne du genre.", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("La Congrégation s'est ensuite divisée en différentes factions, et le palais de justice en fait partie.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Depuis sa séparation il y a des centaines d'années, le palais de justice menace d'éliminer toutes les sorcières et a orchestré la tristement célèbre chasse aux sorcières.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Je déteste avoir affaire à des groupes aussi superstitieux.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Au départ, j'avais prévu de placer Elluka dans une garderie à New Opulentia...\\nMais dans ces circonstances, je ne peux pas la laisser partir.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Vous devez avoir d'autres projets. Tu ferais mieux de ne pas mener de recherches étranges sur elle…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Suis-je si mauvais à tes yeux ?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru me cogne la tête. \\nElluka fait la moue et regarde Mariru avec colère.")
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Cible identifiée. Indice de menace extrêmement élevé.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("… Petit morveux.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Oh, Elluka, quelle tâche Jacob vous a-t-il confié ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka fronce les sourcils et se souvient lentement de sa tâche—")
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Tout d’abord, éliminez les sorcières. Complété. \\nDeuxièmement, obtenez le manuscrit. Échoué.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Le manuscrit ? N'est-ce pas Lian celui qui l'a ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Recherche… Exception de statut. \\nManuscrit… consommé.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Consommé ? Vous voulez dire que les pages sont en vous maintenant ?\\nOu faisaient-elles partie du grimoire de Elluka depuis le début ?", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Votre Administrateur ne vous a pas laissé les absorber...\\nA-t-il peur que vous deveniez trop puissant pour qu'il puisse le contrôler ?", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("C'est une histoire complète à partir de quelques-uns de ses mots, Lian. Bien joué!", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Attendez, le Grimoire de Elluka. \\nCe qui signifie…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ce petit enfant est aussi une sorcière ?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru essaie de lui pincer la joue, mais Elluka l'esquive agilement.")
	novel_interface.character_light(0.35,"smile")
	await novel_interface.show_dialog("J'entends depuis longtemps que certains groupes tentent de créer et de contrôler des sorcières. Les carriéristes ne manquent pas d’envie d’avoir des super soldats !", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Comment en savez-vous autant sur les sorcières... ? Je suis le seul dans le noir ici. Dis-moi : comment une fille devient-elle une sorcière ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Euh, au début, je n'étais pas sûr non plus. Je me souviens avoir lu ce livre sans savoir de quoi il s'agissait.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("J'ai commencé à avoir le vertige à mesure que le contenu devenait de plus en plus difficile. Puis, à un moment donné, j’ai eu l’impression qu’une force inconnue venait d’entrer dans mon corps.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Un jour, j’ai prononcé un sort du livre et j’ai été entraîné dans un autre espace-temps…", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Espace-temps… Selon les données satellite, le flux espace-temps s'était déjà arrêté lorsque vous êtes arrivé à la sous-station.", "Mariru")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pas étonnant que je n'aie pas eu la même sensation que dans d'autres Zones Flux !", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Ce que vous appelez une zone de flux est désigné dans la littérature ancienne sur les sorcières sous le nom de « cocon de sorcière ».", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_dialog("Il se forme lorsqu'un humain se transforme en sorcière. Les étrangers ne peuvent ni le briser ni y pénétrer. Sa nature est très similaire à celle d'un espace généré par Substance H, n'est-ce pas ?", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Et presque au moment où le flux disparaissait, notre satellite a détecté des signaux optiques...", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Je veux dire, les gars contre qui tu t'es battu sont apparus.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Pensez-y : « Witch's Cocoon »… Au moment où le cocon a disparu, ces gars sont sortis. C'est comme s'ils sortaient du cocon.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Sorcière, termine !", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Donc les sorcières ont effectivement perdu la tête car elles ne supportent pas les informations du Grimoire !?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("C'étaient juste des filles normales. Ils ne pouvaient pas supporter le pouvoir magique provenant des scripts et ont été blessés.", "Annie")
	await novel_interface.show_dialog("Au moment où ils ont déclenché une violente distorsion spatiale, ils sont devenus des...\\nLes êtres monstrueux que les gens appellent les « sorcières ».", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Il est dit dans de nombreux livres anciens que plus on connaît d'informations sur le pouvoir magique, plus on souffre facilement d'une folie irréversible.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Si leur santé mentale est perdue, les sorcières peuvent provoquer de grands désastres. Si c'est vrai…", "Mariru")
	await novel_interface.show_dialog("C'est peut-être pour cela que la chasse aux sorcières a duré si longtemps en Europe.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","perspire1",0.25)
	await novel_interface.show_dialog("Merde. Cela ressemble à une pandémie.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("D'après ce que nous savons, l'Administrateur de Elluka a donné la priorité à la chasse aux sorcières comme moyen de récupérer les Fragments du Grimoire.", "Mariru")
	await novel_interface.show_dialog("Mais il n'a pas permis à Elluka d'utiliser le Grimoire… Peut-être qu'il veut créer plus de sorcières avec.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Mais j'ai lu le Grimoire de Elluka et je n'en ai pas reconnu un seul mot. Est-ce que cela a quelque chose à voir avec le fait que je sois un garçon ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","worry",0.25)
	await novel_interface.show_dialog("… Garçon ?", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka a l'air nerveuse et recule, le visage perplexe.")
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Euh, Elluka, j'expliquerai ça plus tard. \\nNe vous inquiétez pas…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","uneasy")
	await novel_interface.show_dialog("Mais je pourrais le lire. Alors peut-être que Lian n'est vraiment qu'un idiot après tout ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Je suis plus curieux de savoir comment vous pourriez facilement entrer dans le cocon de la sorcière.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Je ne l'ai pas demandé ! Chaque fois que j'entre dans la zone, il y a toujours quelqu'un qui veut me tuer...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("— Ce que vous avez fait implique de traverser plusieurs dimensions. La science ne peut pas expliquer cela pour l’instant.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si la science peut expliquer quelque chose ici, la première chose que je veux savoir, c’est pourquoi je suis devenue une fille !")
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Hé-hé, mets-le de côté. Toute question sera résolue tôt ou tard !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("C’est une pensée positive…", "Lian")

	print("=== 第二章第24话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
