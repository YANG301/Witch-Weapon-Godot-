# chapter2_ep13.gd - 第二章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep13_script()

func play_script():
	pass

func chapter2_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Before you go to your new school, your first assignment is basic knowledge training.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Basic knowledge?\nIt's not like I'm Annie and missed everything that happened these past few years...", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh. You missed over a decade's worth of knowledge about being a girl, didn't you?~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("I don't need that kind of knowledge!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru completely ignored my protest and strode toward the table in high spirits. Only then did I notice that she had already prepared the entire tabletop with every sort of tool imaginable.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("First, you need to be able to distinguish twelve standard lipstick shades and memorize the top twenty brands.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("That many...?\nAren't the colors basically all the same?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Too naive! That's not even a tenth of the total.", "Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("And here I've prepared a full set of makeup tools for you—foundation, eye shadow, lip gloss, highlighter, contouring...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Huh? I have to put that much stuff on my face?!\nIt's not like I'm painting... How complicated is being a girl, exactly...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("Don't worry. Starting today, someone will teach you makeup properly.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("But high school students aren't even allowed to wear makeup...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("You really don't understand the world of high school girls...\nIf you keep acting this careless, people will get suspicious in no time.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("And besides school, as a SID agent you'll need to carry out all kinds of missions. Makeup is one of the essential skills for a female operative.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Especially with a cute little face like yours—", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru reached out with one finger and tilted my chin upward.")
	await novel_interface.show_text_only("I took a step back to avoid her hand. Somehow my male pride simply couldn't accept it.")
	novel_interface.show_character("ren_battle","shy_left")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I did volunteer before, sure...\nBut I never expected I'd have to learn stuff like this...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("SID's cadet evaluations are extremely strict. Every round weeds out a huge batch of people.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Since you talked such a big game, why not prove yourself?", "Mariru")
	await novel_interface.show_dialog("And if you pass the final evaluation, you'll be officially brought onto the roster—with a very decent salary too~", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Huh? I can get paid too?!\n(Th-Then my Gfat shopping cart...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Alright, male pride can go sit in the corner for now.")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("(Hehehe... what a simple little brat.)", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("But in return, you'd better understand this—as your commanding officer, my orders are absolute, and you will obey them unconditionally!", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Just what am I getting myself into...?", "Lian")
	novel_interface.character_2nd_light(0.35,"speak")
	novel_interface.character_dark()
	await novel_interface.show_dialog("First, let me introduce someone to you—the teacher who volunteered to teach you makeup.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Though her usual responsibilities are experimental drugs and special equipment development...", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Oh... you must be Lian, right?\nHehe~ This profile is really interesting~", "Girl with Glasses")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Hi~ I'm the director of SID's Combat Research Department. Since both our files have been altered, you can just call me Ai.", "Girl with Glasses")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Hello...\n(Her file... was altered too?)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_wink",0.25)
	await novel_interface.show_dialog("Mariru, Lian is such excellent research material...\nCan't you lend her to me for a little while~!?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(??? Research material? Lend me...?)", "Lian")
	await novel_interface.show_dialog("(W-Why does my back suddenly feel kind of cold...)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("I'm her guardian, at least on paper, so you're not allowed to make a move on her~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Hmph, fine...", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_left(0,0.3,false,"normal")
	await novel_interface.show_dialog("I don't usually wear makeup either, but that stuff is simple. I had it all memorized after looking at it for ten minutes.", "Ai")
	await novel_interface.show_dialog("You should be able to learn it quickly too.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("That fast?\nIt seemed like a really complicated process to me...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ai remembers everything quickly. You should learn from her more in the future~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Right...\n(How exactly am I supposed to learn something like memory?!)", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aghh~~\nMy head is about to explode after spending all day with Ai memorizing makeup brands and colors.", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("... Mariru! Why are you here?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	await novel_interface.show_dialog("What? This apartment is one of my residences in New Opulentia to begin with.\nMore than that, this whole building is SID property~", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No wonder this place is so outrageous!\nWait, don't tell me you're going to live here with Annie and me...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("I only drop by occasionally, so I won't be staying here often~\nThough the refrigerator is already out of beer. Next time, remember to buy me two cases.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("But today I'm here specifically in my role as your guardian... hee-hee~♪", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I-I have a terrible feeling about this!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Come try these on. This is your school uniform, Lian, and this one is a dress~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Why is... this skirt so short...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("A skirt really does look best at this length.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You definitely altered the length of this skirt, didn't you?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Don't sweat the little details~", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("And over here we have ankle socks, crew socks, thigh-highs, pantyhose...\nOho, and this garter belt too!", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("How are there this many kinds of socks too...?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("There are also different kinds of stripes, patchwork, patterns, polka dots...\nOh right, want to try fishnet stockings?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Absolutely not!!!", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("No, wait! That's not the point!\nI don't want to wear stuff like this at all!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("If a mission calls for it, you won't get a choice anyway, so you might as well get used to it early...\nWant me to help you?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Y-You... you...!!", "Lian")

	print("=== 第二章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
