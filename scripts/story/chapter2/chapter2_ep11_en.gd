# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Look who's here! How does it feel to officially become a girl, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... Please stop making fun of me!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alright, alright. By the way, I heard you're planning to transfer to another public high school after the break?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Yeah. The new school is closer to where I live, and... the credit requirements aren't as strict...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("For safety reasons, I'm going to arrange a new place for you to stay.\nAs for school...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Looks like I'll have to ask that old geezer for a favor.)", "Mariru")
	await novel_interface.show_dialog("(Just thinking about it is annoying... good thing the records have already been corrected perfectly...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Gosakuragawa Girls' High School. It has the highest security rating, and it's not far from SID Headquarters either.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As she spoke, Mariru pointed upward.")
	await novel_interface.show_text_only("Gosakuragawa, the bustling commercial district above the underground headquarters, is said to be home to a prestigious school with terrifyingly high tuition.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("W-Wait, isn't that the rich girls' school?! The one they call \"a paradise where pure lilies and splendid cherry blossoms bloom\"...", "Lian")
	await novel_interface.show_text_only("That was an ad copy written by the off-topic crowd on a certain perpetually crashing junk forum to mock Gosakuragawa's outrageous tuition.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("What was that?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N-No, nothing at all!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("With how silly you are, you might just end up becoming quite the... thing for all those upperclassmen and underclassmen.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru gave a light laugh and didn't finish the sentence.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Become what exactly?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Now is not the time to let your curiosity run wild.\nAnyway, tomorrow you'll go and report in properly.", "Mariru")
	await novel_interface.show_dialog("It won't be as lax there as it is at a public school.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Can't you just let me relax a little... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Oh, right. What about Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("That girl's background is rather interesting.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("She... what's wrong with her?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("The records on Annie Bass in the system only go back seven years, when she was fifteen.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Seven years ago means... she's already twenty-two?!\nShe looks about the same age as me!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("That's right. Even now, her bone age still measures as fifteen.", "Mariru")
	await novel_interface.show_dialog("But where she went during that time, and why she suddenly reappeared, no one has figured out so far, including Annie herself.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... No matter what, I don't think Annie is a bad person.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("That much you can rest easy about.\nAfter all, there are even people in SID who used to be her fans.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh?! Was Annie some kind of idol?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... She probably falls into the category of \"a star from years ago.\"", "Mariru")
	await novel_interface.show_dialog("But compared with who she used to be, I'm more interested in what's special about her now.", "Mariru")
	await novel_interface.show_dialog("There's so little information on witches to begin with... this was an unexpected windfall.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Witches... what's that?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Mm... simply put, you can think of them as humans who were infected by a certain kind of information and acquired some traits similar to \"Substance H.\"", "Mariru")
	await novel_interface.show_dialog("Just like how people call the strange characteristics of \"Substance H\"—things current science can't explain—\"miracles.\"", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("To ordinary people, if someone can manifest that kind of trait, it would practically look like \"magic.\"", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("Magic... should just be science we don't understand yet...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("That's a perfectly valid way to think of it.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("There are many historical records about \"witches,\" but they were always treated as superstition and legend.", "Mariru")
	await novel_interface.show_dialog("Over a span of more than three hundred years, Europeans executed nearly one hundred thousand women in the name of \"witches.\"", "Mariru")
	await novel_interface.show_dialog("The \"witch hunts\"... we learned about that in history class...", "Lian")
	await novel_interface.show_dialog("Back then, I only treated it as some boring exam material, but the more I think about it, the more it really feels like a catastrophe on an unnaturally massive scale...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ever since \"Substance H\" was discovered, every country has started re-examining whether those legends were true.", "Mariru")
	await novel_interface.show_dialog("Lately, there are rumors that certain organizations have recreated witches and are using them for espionage.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Still, luckily for us, Annie agreed to join without hesitation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Join what?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("To become a SID agent.", "Mariru")
	await novel_interface.show_dialog("Starting tomorrow, she'll be working for me.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("You can't do that! SID agents obviously do extremely dangerous work!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("And she's only fifteen, just like me. She can't be some kind of agent...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh. Our youngest agent right now is only thirteen.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Thirteen?! That's illegal!!\nThat has to be illegal, right?!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If you ever get the chance to meet her, you won't say that anymore.\nThat kid is far smarter than a fool like you.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Hmph.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("As a citizen of New Opulentia, of course I know that although the various academy cities appear to be under a ceasefire, they're still secretly competing with one another.")
	await novel_interface.show_text_only("And Aegis's shield is useless against biochemical weapons and infiltration-style terrorist attacks.")
	await novel_interface.show_text_only("To protect this city, Mariru and SID must have fought countless desperate battles in the shadows.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Oh, right. Annie's cover identity will be a transfer student enrolling with you.", "Mariru")
	await novel_interface.show_dialog("I've arranged for the two of you to stay in the same suite. Uniforms and other daily necessities\nwill all be delivered within the hour.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("No bargaining.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("I understand...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Of course I understand. There's nothing bad about this.\nNo—it's far more comfortable than the life I had before.")
	await novel_interface.show_text_only("As long as SID takes care of everything.\nAs long as I keep drifting through life at some noble girls' school, just scraping by on credits.")
	await novel_interface.show_text_only("And as long as I try to get used to this new body... would that be enough?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... No.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hm?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Even if I don't understand anything yet, I don't want Annie facing that kind of danger all by herself.")
	await novel_interface.show_text_only("The Annie who appeared before me the moment we met...\nShe looked calm, but there was still a trace of fear in her.")
	await novel_interface.show_text_only("She was... scared too, wasn't she?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Miss Mariru—if you don't mind me calling you that...\nI want to help too!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Huh?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... I mean... since I was able to pass through that hurricane, maybe I can help SID with something else too!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("That wasn't a hurricane. It was a spatiotemporal phase fluctuation...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("Anyway, I can't let Annie face danger alone.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("And maybe... maybe I'll even get a chance to find a way to turn back into a boy...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... But with your physical ability, you probably couldn't even beat one of SID's janitors.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Uh...\n(What kind of cleaners do you people hire?! Shaolin monks?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Fine. I'll let you try the SID cadet training. At least if you run into danger in the future, it might raise your survival rate a little.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("As for your status, you'll start as a Level-4 Agent Candidate.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Okay! I'll do my best!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Good. Let's see what kind of data I can get out of this little one.)", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
