# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai compara el informe con los datos que parpadean en el monitor, sonriendo de vez en cuando.")
	await novel_interface.show_text_only("Mariru agarra el informe por detrás Ai y lo estudia.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Entonces, ¿cómo te fue en el examen físico? Pareces demasiado satisfecho contigo mismo.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… ¡Eso es simplemente fabuloso!", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("El alma de un niño atrapada en el cuerpo de una niña... Si la gente del Instituto de Investigación Cerebral Harima se entera de Lian, matarán para presentar una solicitud de experimento y arrebatársela.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Debemos guardarnos esto para nosotros, ¿entiendes?\\n¿Algún hallazgo nuevo?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Ambos telómeros indican una edad de quince años, pero la cantidad de cesio-137 en el tejido blando de Annie es sólo una cuarta parte del promedio actual.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Inteligente... \\nEntonces, como mucho, ¿solo vivió la mitad de la Guerra de los Siete Años?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("A menos que la hayan mantenido en una cápsula sellada durante años después de la guerra.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ya veo. \\n¿Qué pasa con Lian?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("En cuanto a Lian… el nivel detectado en su tejido muscular es menos de una dos centésima parte del promedio, incluso más bajo que lo que los recién nacidos heredan de sus madres.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Entonces es un cuerpo recién sintetizado?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Ahora viene la parte realmente interesante: su cuerpo porta anticuerpos contra muchos virus extintos hace mucho tiempo, incluida la viruela.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Tómatelo con calma. No hay virus residual en su médula espinal.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Hice una comprobación aproximada: la historia del sistema inmunológico de Lian parece abarcar sólo los últimos siglos. No existen anticuerpos contra ningún virus premedieval.", "Ai")
	await novel_interface.show_dialog("Aun así, me encantaría solicitar una muestra de sus glóbulos blancos e intentar cultivar los virus nº 008, 217 y 742...", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Este no es tu trabajo como médico escolar.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Sí, claro. Entiendo. \\nQuieres que los vigile, ¿verdad?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es posible que tengan un vínculo con el Ross Goblet desaparecido... \\nSospecho que no contaron toda la historia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("¿Por qué no simplemente encerrarlos e interrogarlos?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("¿Necesitas una mano? Mira, con un poco de modificación, las herramientas que usé para el chequeo de hoy serían perfectas para el trabajo…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Los ojos de Ai brillan de emoción. Mariru enrolla el informe y la golpea con él.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Sólo mantén los ojos y los oídos abiertos. Infórmame si pasa algo.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Ahora que ella ya lo ha notado, me temo que alguien dentro de SID podría haberlo hecho…)", "Mariru")
	await novel_interface.show_dialog("(Al menos ella permanecerá controlada en la escuela) \\n(Y mientras tanto podría vigilarla...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("No tienes que decírmelo dos veces. ¡Registraré cada~ cambio en el cuerpo de Lian!", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Será mejor que mantengas un perfil bajo y mantengas el rumbo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Je je, relájate. \\nNo sería divertido si la dejara seca de una vez.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
