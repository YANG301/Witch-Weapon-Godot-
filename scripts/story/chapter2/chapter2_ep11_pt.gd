# chapter2_ep11.gd - 第二章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep11_script()

func play_script():
	pass

func chapter2_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Olha quem está aqui! Qual é a sensação de se tornar oficialmente uma garota, Lian?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("... Por favor, pare de tirar sarro de mim!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tudo bem, tudo bem. A propósito, ouvi dizer que você está planejando se transferir para outra escola pública depois das férias.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Sim. A nova escola fica mais perto de onde moro e... os requisitos de crédito não são tão rígidos...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por motivos de segurança, vou providenciar um novo lugar para você ficar.\nQuanto à escola...", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Parece que terei que pedir um favor àquele velhote.)", "Mariru")
	await novel_interface.show_dialog("(Só de pensar nisso já é irritante... ainda bem que os registros já foram corrigidos perfeitamente...)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Escola secundária feminina de Gosakuragawa. Possui a classificação de segurança mais alta e também não fica longe da SID Sede.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Enquanto ela falava, Mariru apontou para cima.")
	await novel_interface.show_text_only("Diz-se que Gosakuragawa, o movimentado distrito comercial acima da sede subterrânea, abriga uma escola de prestígio com mensalidades terrivelmente altas.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("E-espera, essa não é a escola das meninas ricas?! Aquele que eles chamam de \"um paraíso onde florescem lírios puros e esplêndidas flores de cerejeira\"...", "Lian")
	await novel_interface.show_text_only("Essa foi uma cópia do anúncio escrita pela multidão fora do assunto em um certo fórum de lixo perpetuamente travado para zombar das mensalidades ultrajantes de Gosakuragawa.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("O que foi isso?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("N-Não, absolutamente nada!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Com o quão bobo você é, você pode acabar se tornando a coisa... para todos aqueles veteranos e calouros.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru deu uma leve risada e não terminou a frase.")
	novel_interface.show_character("ren_battle","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_dark()
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Torne-se o que exatamente?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Agora não é hora de deixar sua curiosidade correr solta.\nDe qualquer forma, amanhã você irá se reportar adequadamente.", "Mariru")
	await novel_interface.show_dialog("Não será tão relaxado lá como em uma escola pública.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Você não pode me deixar relaxar um pouco... _(:3」∠)_")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("... Ah, certo. E quanto a Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("O passado daquela garota é bastante interessante.", "Mariru")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ela... o que há de errado com ela?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Os registros de Annie Bass no sistema datam de apenas sete anos, quando ela tinha quinze anos.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sete anos atrás significa... ela já tem vinte e dois?!\nEla parece ter a mesma idade que eu!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Isso mesmo. Mesmo agora, sua idade óssea ainda é de quinze anos.", "Mariru")
	await novel_interface.show_dialog("Mas para onde ela foi durante esse tempo e por que reapareceu de repente, ninguém descobriu até agora, incluindo a própria Annie.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Não importa o que aconteça, não acho que Annie seja uma pessoa má.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Com isso você pode ficar tranquilo.\nAfinal, há até pessoas em SID que costumavam ser fãs dela.", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein?! Annie era algum tipo de ídolo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... Ela provavelmente se enquadra na categoria de \"uma estrela de anos atrás\".", "Mariru")
	await novel_interface.show_dialog("Mas comparada com quem ela costumava ser, estou mais interessado no que ela tem de especial agora.", "Mariru")
	await novel_interface.show_dialog("Para começar, há tão pouca informação sobre bruxas ... que foi uma sorte inesperada.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bruxas... o que é isso?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Mm... simplificando, você pode pensar neles como humanos que foram infectados por um certo tipo de informação e adquiriram algumas características semelhantes a \"Substance H.\"", "Mariru")
	await novel_interface.show_dialog("Assim como as pessoas chamam as estranhas características de \"Substance H\" - coisas que a ciência atual não consegue explicar - \"milagres\".", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Para as pessoas comuns, se alguém pudesse manifestar esse tipo de característica, isso praticamente pareceria “mágico”.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","normal1",0.25)
	await novel_interface.show_dialog("Magia... deveria ser apenas uma ciência que ainda não entendemos...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Essa é uma maneira perfeitamente válida de pensar nisso.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/burningPunish.png")
	await novel_interface.show_dialog("Existem muitos registros históricos sobre “bruxas”, mas elas sempre foram tratadas como superstição e lenda.", "Mariru")
	await novel_interface.show_dialog("Ao longo de mais de trezentos anos, os europeus executaram quase cem mil mulheres em nome de “bruxas”.", "Mariru")
	await novel_interface.show_dialog("A \"caça às bruxas\"... aprendemos sobre isso na aula de história...", "Lian")
	await novel_interface.show_dialog("Naquela época, eu apenas tratava isso como um material de exame chato, mas quanto mais penso sobre isso, mais parece uma catástrofe em uma escala anormalmente massiva...", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Desde que \"Substance H\" foi descoberto, todos os países começaram a reexaminar se essas lendas eram verdadeiras.", "Mariru")
	await novel_interface.show_dialog("Ultimamente, há rumores de que certas organizações recriaram bruxas e as estão usando para espionagem.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ainda assim, felizmente para nós, Annie concordou em aderir sem hesitação.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Junte-se ao quê?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Para se tornar um agente SID.", "Mariru")
	await novel_interface.show_dialog("A partir de amanhã, ela estará trabalhando para mim.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Você não pode fazer isso! Os agentes SID obviamente fazem um trabalho extremamente perigoso!", "Lian")
	novel_interface.change_2nd_expression("wry_smile")
	await novel_interface.show_dialog("E ela tem apenas quinze anos, assim como eu. Ela não pode ser algum tipo de agente...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ei. Nosso agente mais jovem agora tem apenas treze anos.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Treze?! Isso é ilegal!!\nIsso tem que ser ilegal, certo?!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se você tiver a chance de conhecê-la, não dirá mais isso.\nAquela criança é muito mais esperta do que um idiota como você.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sprite")
	await novel_interface.show_dialog("... Hmph.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como cidadão de New Opulentia, é claro que sei que, embora as várias cidades acadêmicas pareçam estar sob um cessar-fogo, elas ainda estão competindo secretamente entre si.")
	await novel_interface.show_text_only("E o escudo de Aegis é inútil contra armas bioquímicas e ataques terroristas de infiltração.")
	await novel_interface.show_text_only("Para proteger esta cidade, Mariru e SID devem ter travado inúmeras batalhas desesperadas nas sombras.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ah, certo. A identidade falsa de Annie será a de um estudante transferido matriculando-se com você.", "Mariru")
	await novel_interface.show_dialog("Combinei que vocês dois fiquem na mesma suíte. Uniformes e outras necessidades diárias\nserão entregues dentro de uma hora.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sem negociação.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Eu entendo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Claro que entendo. Não há nada de ruim nisso.\nNão, é muito mais confortável do que a vida que eu tinha antes.")
	await novel_interface.show_text_only("Contanto que SID cuide de tudo.\nContanto que eu continue vagando pela vida em alguma escola nobre para meninas, apenas sobrevivendo com créditos.")
	await novel_interface.show_text_only("E enquanto eu tentar me acostumar com esse novo corpo... isso seria suficiente?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Não.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hum?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mesmo que eu não entenda nada ainda, não quero que Annie enfrente esse tipo de perigo sozinha.")
	await novel_interface.show_text_only("A Annie que apareceu diante de mim no momento em que nos conhecemos...\nEla parecia calma, mas ainda havia um traço de medo nela.")
	await novel_interface.show_text_only("Ela estava... assustada também, não estava?")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("... Senhorita Mariru—se você não se importa que eu te chame assim...\nEu também quero ajudar!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","serious",0.25)
	await novel_interface.show_dialog("Hein?!", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Quer dizer,... já que consegui passar por aquele furacão, talvez eu possa ajudar SID com outra coisa também!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Isso não foi um furacão. Foi uma flutuação de fase espaço-temporal...", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shout")
	await novel_interface.show_dialog("De qualquer forma, não posso deixar Annie enfrentar o perigo sozinho.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("E talvez... talvez eu até tenha a chance de encontrar uma maneira de voltar a ser um menino...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("... Mas com sua habilidade física, você provavelmente não conseguiria nem vencer um dos zeladores de SID.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Uh...\n(Que tipo de faxineiros vocês contratam?! Monges Shaolin?!)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Tudo bem. Vou deixar você experimentar o treinamento de cadete SID. Pelo menos se você correr perigo no futuro, isso poderá aumentar um pouco sua taxa de sobrevivência.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Quanto ao seu status, você começará como Candidato a Agente de Nível 4.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Ok! Farei o meu melhor!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Bom. Vamos ver que tipo de dados posso extrair deste pequenino.)", "Mariru")

	print("=== 第二章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
