# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Com a permissão de Mariru, Annie e eu decidimos ir às compras com Elluka.")
	await novel_interface.show_text_only("Elluka está atrás de mim, olhando tudo com cautela.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, você quer chocolate?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, chocolate, tipo.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Aqui está você.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pega a barra de chocolate, desembrulha com cuidado e dá uma pequena mordida.")
	await novel_interface.show_text_only("Simplesmente não me canso dela. Tão fofo!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ei, você está parecendo um pervertido de meia-idade.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("O que?! Sou apenas um adolescente.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Pervertido.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por que vocês dois fizeram isso comigo?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, não vou te dar chocolate se você continuar agindo assim.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Atire. Ela parece fofa mesmo quando está deprimida.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Haha. Estou brincando. \\nAqui está.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Quanto chocolate você tem? \\nVocê ganhará peso se comer demais.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Qual é o problema. Só tenho alguns quarteirões.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me encara com um olhar estranho, me deixando desconfortável.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("O quê?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Dei uma olhada no seu recente relatório de exame físico. \\nVocê está ganhando peso, mas não cresceu mais.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por que você fez isso?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Para te conhecer melhor, obviamente.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Agora eu sei que você tem apenas um metro e setenta e cinco. O mesmo que eu.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Droga. Não há nada para se orgulhar.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Mas eu tinha um metro e setenta e quatro quando era menino!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Isso não faz muita diferença, não é?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Você me enganou... \\nEu não deveria ter te contado isso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Enquanto Elluka saboreia seu chocolate, a conversa chama sua atenção. De repente ela olha confusa.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Irmã Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Sim?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Irmão... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Irmã? Irmão? \\nDados corrompidos. Não identificável.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Esqueça o que acabamos de dizer!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nova varredura do alvo. Mulher identificada... \\nIrmã? Irmão?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaahh! Parar!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
