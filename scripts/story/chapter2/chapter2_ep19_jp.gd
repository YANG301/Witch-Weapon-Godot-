# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("訓練データの結果を見ていると、レンちゃんの\\n身体能力は一般の女子高生と変わらないね。", "愛衣")
	await novel_interface.show_dialog("唯一、特筆すべきは目と手のシンクロ率……\\n\\n彼女のゲームアカウントで獲得されている\\nプラチナトロフィー数との関連性が推測できる…", "愛衣")
	await novel_interface.show_dialog("アニーの単独訓練はレンちゃんより全然マシ。\\n同年齢の競技選手レベルに達しているわ。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("だけど前回、彼女達が再び異変区域に消えた\\n状態と、現在の観測結果は全く異なっている。", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ほお？　何か面白い発見でもしたか？", "マリル")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("普通の人間には感じられないかもしれないけど…", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("彼女達を追跡したドローンの『ボルツマン探針』\\nが、限界を超えた数値を何度も観測した挙句、\\n回収時にはオーバーフローが起きて、\\n壊れていたのよ。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("そんな結果があり得てたまるか。\\nもし探針での観測結果にミスがないのであれば、\\nその場にいた人間は……いや、恐らく街の大半が\\n高熱によって、気化しているだろう。", "マリル")
	await novel_interface.show_dialog("高熱によって、気化しているだろう。", "マリル")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("というか、あんな貴重品をドローンに装備させる\\nとか何を考えているっ。", "マリル")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("マリルが報告書を丸め、的確に愛衣の頭を叩く。\\n愛衣は短いうめき声をあげた。")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("まぁ……熱量以外に、情報エントロピーの\\n激増でも同じ効果を引き起こせるけどね。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("それにしたってこのエントロピーの莫大さ……\\n2人は確率が1兆分の1にも満たない事例を、\\n100％確定した形式で示したの。\\nこれはすごい事だよ。", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("アニーは魔女だ。レンは……\\n\\n『異質物』が創り出した器ってところか？", "マリル")
	await novel_interface.show_dialog("まるでレンが魔女と、\\n魔女達の魔法を動かしているかのようだ……", "マリル")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("まるでスーパー電池を、\\nバイブレーション・モーター付きのシリコン棒に\\n詰め込んだかのようだ……", "愛衣")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("指令室から大きな音がすると、愛衣の頭に\\n大きなタンコブができていた。")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("私ですら納税者を哀れに思う日が来るとは……\\n\\nあんなにも多額の税金を払ってまでして、\\n育てていたのがお前のような人間なんてな～～", "マリル")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("科学には、常に飢えた好奇心が必要だもの～～", "愛衣")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("……よく言えたもんだ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("あなただって、いつも私の戦術研究部に性根が\\nひん曲がったような変テコ研究開発目標を、\\n指定してくるじゃない……", "愛衣")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("それに、今も悪巧みをしているようね。\\n\\nさあさあ、何がしたいか教えてみなさいな？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣はマリルの口元の収まらない微笑みに、\\n気付いていた。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("訓練を受けさせてから、ほどよく時間も経った。\\nそろそろ、子供達の成果を見なくてはな。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（異質物、ロス・ゴールド、魔女、時空位相波動　全てが彼女達に直結する……）", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（アニーは彼女と行動を共にしている時にだけ、　異変区域に出入りできる）\\n（ではアニーが消えたこの七年間……）", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("その表情……\\nま～た無垢な少女を危険に晒すつもりね？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("現状では、まだ十分に情報を収集できていない。\\nだから、\\n『語り得ぬものについては、沈黙しなければ\\n ならない』だな。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("ふむむ～～\\n\\n私はウィトゲンシュタインのもう1つの\\n言葉の方が好きかな。", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("『神秘とは、世界がいかにあるかではなく……』", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("『世界があるというその事である』", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("私も当然、自分の原則に従って行うからな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("もちろん知っているわよ～～", "愛衣")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("俺とアニーは突然、マリルから\\n「今すぐにアパートに戻って待機しろ」\\nと命令を受けた。")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("緊急任務かな！？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("それは……\\n（じーー）", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("マ、マリル姉？", "小憐")
	await novel_interface.show_dialog("（なんか今日はマリルの目つきがおかしい……）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("一日千秋、と言うべきか？\\n随分と成長したな──", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そうかな……\\n生活上はまだ慣れないところがあるけど。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("ほお？　慣れない？", "マリル")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("例えば、戦闘服のデザインとか……\\n恥ずかし過ぎるんだよこれ！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("カッコいいのにッ！？", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("上着のサイズがもう合わなくなったのか？\\n是非とも、もう一度測り直す必要があるな。", "マリル")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そっ、そういう意味じゃないっ！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("マリルが俺へと両手を伸ばす。\\n\\n彼女の意図を察して、慌てて避けた。")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("い、いやいやいやーーっ！\\nサイズはピッタリですから──\\n本当にピッタリですーーとても──っ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("ちっ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("（何を残念がってるんだよ！）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("やっぱり、レンちゃんの身体は成長期なのね……", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーは落ち込みつつ羨ましそうな表情を\n浮かべた。")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("アニー！\\n君まで……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("私もレンちゃんと一緒に成長したいよ～～！\\n\\n──悲しいかな、私の時間は止まってるの。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("時間が止まっている……魔女と関係あるの？")
	await novel_interface.show_text_only("アニーの明るい表情には、隠し切れない悲しみが滲み出ており、空気が急に重くなった。")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("……アニー。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("だから……成長を感じさせて──！\\nてぇいっ！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーが背中から無警戒だった俺を抱きしめた。")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("わぁぁぁーーッ！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……娘がもう大人になって、\\n嫁に行ってしまうとはな…、ほろろ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが顔を横に向け、涙をぬぐっている。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("ああ、もうお前らっ！　一体なんなんだよ！！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("ごほん──そろそろ真面目に行こう。\\n先ほどお前達に遂行してもらわなければならない\\n緊急任務が発生した。", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("江森変電所を知っているか？", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("東の海辺にある超大型な変電所の事？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("（あそこは6つの学園都市が、イージスの範囲内\\n　に画定させた共同管理区域だ）\\n（戦後の講和もあそこで行われてたっけ）")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("そうだ、先ほど多数の中継所から警告があり、\\n北東地域では強烈なサージ電流が発生した。", "マリル")
	await novel_interface.show_dialog("そして、衛星が時空波動を検出。\\n\\nポインティングされた場所が江森変電所、\\nと言うわけだ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("時空波動！？　まさか……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("データに間違いがなければ、お前達2人が以前、\\n私の前に現れた状況と酷似している。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("本来であればお前達に、まだ出撃する資格はない", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("だが、あの場所は『協定非武装地域』であり、\\n新豊洲の管轄内ではあるが、\\nSIDに行動の自由は許されていない。", "マリル")
	await novel_interface.show_dialog("「世界平和」のための譲歩ってやつだ。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("というわけで、今回は特別な手段で\\n変電所の偵察を行う必要がある。\\nSIDの実働チームは周辺にて待機。", "マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("私は連合議会に行き、できるだけ早く\\n正式な許可を申請する。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("学園都市連盟の領地に勝手に侵入するって事？\\nそれってかなり不味いんじゃ……", "小憐")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ほお～？　どうやら大使館区域が大停電に陥る\\n可能性があると言うのに、\\n全く動きたくない奴がいるようだな。", "マリル")
	await novel_interface.show_dialog("もし何かあったら、互いに反目しあっている\\nおバカさん達がまた派手に喧嘩しちゃうかもな～\\nこの一件で戦争とかが始まっちゃうんだろうな～", "マリル")
	await novel_interface.show_dialog("この一件で戦争とかが始まっちゃうんだろうな～", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("はいはい…分かりましたよ……", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それにだ、女子高生2人ってことは。\\n\\n万が一保安軍に捕まっても、可愛い子ぶっとけば\\n誤魔化せるかもしれないだろう！", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("それで誤魔化せたら逆にすごいわ！！", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("とにかく、これは「私から」の命令な？\\n\\n屋上にヘリを用意した、準備が出来次第出発だ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"sprite")
	await novel_interface.show_dialog("なんて、独裁者だ……", "小憐")

	print("=== 第二章第19话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
