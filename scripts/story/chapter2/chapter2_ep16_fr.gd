# chapter2_ep16.gd - 第二章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep16_script()

func play_script():
	pass

func chapter2_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ai vérifie le rapport par rapport aux données clignotantes sur le moniteur, souriant de temps en temps.")
	await novel_interface.show_text_only("Mariru saisit le rapport par derrière Ai et l'étudie.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Alors, comment s’est passé l’examen physique ? Vous avez l'air bien trop content de vous.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Awwww… C'est tout simplement fabuleux !", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("L'âme d'un garçon piégée dans le corps d'une fille… Si les gens de l'Institut de recherche sur le cerveau Harima entendent parler de Lian, ils tueront pour déposer une demande d'expérience et l'enlèveront.", "Ai")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nous devons garder cela pour nous, compris ?\\nDe nouvelles découvertes ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Leurs télomères indiquent tous deux un âge de quinze ans, mais la quantité de césium 137 dans les tissus mous de Annie ne représente qu'un quart de la moyenne actuelle.", "Ai")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Intelligente... \\nDonc, tout au plus, elle n'a vécu que la moitié de la guerre de Sept Ans ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("À moins qu’elle ait été gardée dans une capsule scellée pendant des années après la guerre.", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je vois. \\nEt Lian ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Quant à Lian… le niveau détecté dans son tissu musculaire est inférieur à un deux centième de la moyenne, soit même inférieur à ce que les nouveau-nés héritent de leur mère.", "Ai")
	novel_interface.character_light(0.35,"serious")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C’est donc un corps nouvellement synthétisé ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Voici maintenant la partie vraiment intéressante : son corps porte des anticorps contre de nombreux virus disparus depuis longtemps, y compris la variole.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—?!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Allez-y doucement. Il n’y a aucun virus résiduel dans sa moelle épinière.", "Ai")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("J'ai fait une vérification approximative : l'histoire du système immunitaire de Lian semble ne couvrir que les derniers siècles. Il n’existe aucun anticorps contre les virus pré-médiévaux.", "Ai")
	await novel_interface.show_dialog("J’aimerais quand même lui demander un échantillon de ses globules blancs et essayer de cultiver les virus n°008, 217 et 742…", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ce n'est pas votre travail en tant que médecin scolaire.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Ouais, c'est vrai. Je comprends. \\nVous voulez que je les surveille, n'est-ce pas ?", "Ai")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ils pourraient avoir un lien avec les Ross Goblet… \\nJe soupçonne qu'ils n'ont pas raconté toute l'histoire.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Pourquoi ne pas simplement les enfermer et les interroger ?", "Ai")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Avez-vous besoin d'un coup de main ? Écoutez, avec quelques modifications, les outils que j'ai utilisés pour le contrôle d'aujourd'hui seraient parfaits pour le travail…", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Les yeux de Ai brillent d'excitation. Mariru roule le rapport et la frappe avec.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Gardez simplement les yeux et les oreilles ouverts. Signalez-moi si quelque chose arrive.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Maintenant qu'elle l'a déjà remarqué, j'ai peur que quelqu'un au sein de SID l'ait…)", "Mariru")
	await novel_interface.show_dialog("(Au moins, elle restera sous contrôle à l'école) \\n(Et en attendant je pourrais la surveiller...)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Tu n'es pas obligé de me le dire deux fois. J'enregistrerai chaque ~ changement dans le corps de Lian !", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Vous feriez mieux de faire profil bas et de rester sur la bonne voie.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Hé hé, détends-toi. \\nCe ne serait pas amusant si je la vidais d'un seul coup.", "Ai")

	print("=== 第二章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
