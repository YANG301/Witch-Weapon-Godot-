# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Attends, où est le papier que tu viens de récupérer ?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Pouah… Le journal. Je voulais vous en parler.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je remets les pages que j'ai trouvées sur le champ de bataille à Annie. Elluka se mord la langue.")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Le manuscrit de Wardenclyffe… Merveilleux ! Je ne peux pas croire que vous ayez trouvé ça !", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("Ils sont tombés de ces gars plus tôt. Cela ne semble tout simplement pas bien… Annie, pouvez-vous les lire à haute voix ?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh… Les lignes sont floues, mais je peux sentir la magie les traverser.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Le Grimoire… Fragments de Grimoire, plus précisément.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Grimoire… Est-ce que c'est quelque chose à propos des sorcières ?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("En fait, c'est un livre de sorcellerie. Le premier scénario de ce genre que j’ai jamais vu est un pamphlet sorti de nulle part.", "Annie")
	await novel_interface.show_dialog("Si je me souviens bien, la brochure s’intitule Trajectoire mystique. Il est apparu de nulle part dans mon casier.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Au début, je pensais que c'était le coach qui me l'avait donné. La sorcellerie à l’intérieur était super bizarre, comme si on t’apprenait à changer de trajectoire.", "Annie")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mais plus tard, j’ai découvert que le coach n’en savait rien. Je pensais que c'était une sorte de superstition, donc je ne l'ai jamais utilisé.", "Annie")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Pas avant…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il semble que Annie en ait fini avec le rappel du passé. Elle baisse la tête et lit attentivement ces scripts.")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("Je me souviens que Mariru a dit que les sorcières sont des humains qui reçoivent certaines propriétés de Substance H à la suite d'une contamination informationnelle.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("Contamination… bien sûr. Je dirais que c’est tout à fait pertinent. Certaines « informations » peuvent difficilement être effacées une fois que vous avez mis la main dessus.", "Annie")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous aimez ces vers d'oreille et ces remixes à réglage automatique ? J'ai essayé un million de fois de m'en débarrasser, mais j'ai toujours échoué. Parfois, je ne peux m'empêcher de fredonner les airs lorsque je suis distrait...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ha. Bien dit, Lian.", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Peut-être que ces papiers ont causé le flux spatio-temporel ? \\nMais… comment est-ce possible ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("C’est très probable. De telles informations peuvent vous coûter beaucoup d’énergie, ce qui est trop même pour moi.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("C'est pourquoi nous avons besoin de certains \"Objets\" pour libérer la sorcellerie, afin qu'ils puissent en supporter le prix à notre place.", "Annie")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Annie montre sa batte de baseball. C'est peut-être pour cela que certaines armes consomment du pouvoir magique…")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Si une surcharge d’informations se produit, les gens peuvent perdre la raison et devenir complètement fous…", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Des… sorcières folles… \\nIl faut… les détruire.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("Alors, les sorcières… ce sont les malheureuses, non ? \\nAnnie, vous en savez beaucoup.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Non… \\nJe fais juste des hypothèses basées sur mes propres expériences.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Manuscrit…", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka semble perdue dans ses pensées, son visage s'éclaire d'un air d'impatience.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("Hein ? Quoi? Vous voulez les voir, Elluka ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oui.", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elluka me regarde avec envie, comme un petit animal de compagnie qui mendie, les yeux remplis de larmes.")
	await novel_interface.show_text_only("Je ne peux pas la refuser, mais ces scripts sont trop dangereux…")
	await novel_interface.show_text_only("Pendant que j'hésitais, les bruits sourds d'un avion de transport à l'atterrissage se rapprochent.")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Quelqu'un arrive !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SID officier ? Super, nous avons trouvé un… \\nQuoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Étonnamment, la personne qui sort de l'avion n'est pas un agent.")
	await novel_interface.show_text_only("L'homme à lunettes regarde Elluka avec tendresse, mais elle frissonne de peur.")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, tu m'as fait attendre trop longtemps.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Administrateur… Je suis désolé.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Avez-vous le manuscrit ? \\nVous ne pouvez pas les gérer vous-même, je vous l'ai dit. Apportez-les-moi, maintenant.", "Administrateur")
	await novel_interface.show_dialog("Seules des ordures inutiles pourraient me faire échouer dans une tâche aussi mineure, n'est-ce pas ?", "Administrateur")
	await novel_interface.show_dialog("Nettoyez ce désordre, puis venez avec moi à Oligar. Il y a un autre travail qui t'attend.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Whoa, whoa, whoa, surveillez votre langage ! Ne vois-tu pas qu'elle est blessée ?", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ce n'est qu'une petite fille, pas un outil que vous possédez !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'étranger ne semble pas m'avoir remarqué jusqu'à présent. Il me scrute avec un étrange sourire, tel un prédateur inspectant sa proie.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, emmène-la avec nous.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hein ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sur mon cadavre. Personne ne peut supporter Lian tant que je suis là.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("L'emmener… ?", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oui, c'est un ordre.", "Administrateur")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Commande…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka me regarde d'un air vide. Elle semble être engagée dans une lutte intérieure, mais désobéir à l'Administrateur n'est pas une option.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Tâche : emporter Lian. \\nCible verrouillée…", "Elluka")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
