# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka нападает на Annie и меня магией молний. Не желая причинить ей вреда, все, что мы можем сделать, это отчаянно защищаться.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Если так будет продолжаться, пострадаем все мы...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Ха... ах... \\nElluka, стоп! Успокоиться!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Цель заблокирована. Продолжающаяся атака…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Воздух прорезал яркий удар, за которым последовал рев. \\nЯ открываю глаза и обнаруживаю, что я невредим.")
	await novel_interface.show_text_only("Позади Администратора несущий винт самолета медленно опрокидывается, а затем падает, как сломанная ветка.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Администратор")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Кхм... все замирают——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("Голос Mariru раздается из громкоговорителя на расстоянии.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Мисс Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Над головой появляются три вертолета, и их ослепительные прожекторы окрашивают землю в белый цвет, как будто это был средь бела дня.")
	await novel_interface.show_text_only("Mariru сидит в среднем вертолете и кричит в громкоговоритель. Огромная пушка, установленная перед ней, все еще дымится.")
	await novel_interface.show_dialog("Маленькая игрушка Ai действительно впечатляет. Фактически он выбил вал ротора одним выстрелом.", "Mariru")
	await novel_interface.show_text_only("Mariru звучит слишком взволнованно, как будто ей очень хотелось бы выстрелить еще раз.... Эй, эта штука уже считается пушкой, не так ли?!")
	await novel_interface.show_text_only("Кабина разбившегося транспорта открывается изнутри, и два пилота в панике вываливаются наружу, борясь за свою жизнь.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ха... Хаха...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вертолет приземляется на открытой площадке возле подстанции. Сопровождаемый толпой тяжеловооруженных солдат, Mariru в приподнятом настроении шагает к нам.")
	await novel_interface.show_text_only("Ясно увидев лицо Mariru Администратор яростно сплюнул на землю.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Хм. Еще одна SID болонка.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Это не операция SID. Я здесь как советник Столичного бюро обороны New Opulentia и выполняю задачу по обеспечению безопасности и подавлению беспорядков.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Только тогда я понимаю, что люди, вышедшие из вертолетов, вовсе не SID агенты. У каждого из них нарукавная повязка с надписью «MD».")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Не так ли... Капитан Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Это верно. Столичное бюро обороны подозревает, что здесь происходит террористическая атака против New Opulentia.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Настоящим я приказываю вам и вашим людям немедленно прекратить боевые действия и вернуться с нами для допроса.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Вон тот мускулистый, похожий на рестлера... Клянусь, я видел его раньше... Он один из знакомых Mariru?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Эти две милые девушки — твои подчиненные? Отделение без возрастных ограничений звучит довольно мило...", "Nantetsu")
	await novel_interface.show_dialog("Хм... этот малыш...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Эй, ты уверен, что хочешь это сделать?", "Администратор")
	await novel_interface.show_dialog("Это демилитаризованная зона согласно Соглашению. Ни одна из ваших организаций не имеет полномочий работать здесь.", "Администратор")
	await novel_interface.show_dialog("И невозможно так быстро получить разрешение Объединенного Конгресса!", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Эти многонациональные бюрократии движутся со скоростью улитки.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Хмф... извините, что разочаровал вас, но я сейчас заберу своих людей и уйду.", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Мм~ Я еще не закончил говорить... Johnson Heavy Industries, с другой стороны, работает намного быстрее.", "Mariru")
	await novel_interface.show_dialog("В конце концов, их старший сын все еще учится в New Opulentia~ Прямо сейчас они просят меня об одолжении...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Что?!", "Администратор")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Прямо сейчас три процента нагрузки этой подстанции уже поданы в городскую сеть New Opulentia —", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Согласно Салмонтонскому соглашению, любое нападение на энергосистему New Opulentia считается первоклассным террористическим актом.", "Mariru")
	await novel_interface.show_dialog("В случае подобных инцидентов Столичное бюро обороны обладает высшими оперативными полномочиями, признанными Объединённым Конгрессом.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("В конце концов, наш хост Aegis… \\nНе может работать без питания.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Как ты мог убрать Aegis за пределы городской сети?! Прекратите трюки!", "Администратор")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Хватит разговоров. Уберите их!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Подождите! Форт Масада и New Opulentia давно подписали соглашение о дипломатической неприкосновенности, не так ли?", "Администратор")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Администратор достает из кармана пальто свое удостоверение и самодовольно показывает его на Mariru и Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Я Jacob Шмидт, военный атташе Третьего Академгорода, форта Масада, в Объединенном Конгрессе.", "Администратор")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если вы арестуете меня здесь, я полагаю, это вызовет некоторые ненужные дипломатические проблемы, не так ли?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("… \\nОчень хорошо. У тебя есть одна минута, чтобы скрыться из моего поля зрения.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Но, похоже, у вашей машины какие-то неполадки... \\nИтак, возможно, вам придется идти домой пешком.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("Что?! Это не справедливо!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Правила есть правила. Горячий порыв ничего не решит.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Но…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, мы уходим.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Подождите, ваша личность подтверждена, и это нормально. Но эта маленькая девочка… Я не думаю, что она займет какой-либо пост в вашем Министерстве иностранных дел.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Ты!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Мне очень жаль, но она главная подозреваемая в сегодняшнем теракте.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Если вы попытаетесь захватить ее силой, все, что я смогу сделать, это с сожалением сообщить вашему посольству, что вы были застрелены в результате теракта.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru вытаскивает пистолет и прижимает его к голове Jacob.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Хмм... Она всего лишь инструмент.\\nЕсли ты так сильно хочешь ее, оставь ее себе!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Уровень мощности критический… \\nХа… Деятельность прекращена…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, которая все это время заставляла себя идти вперед, внезапно падает на землю, как машина, потерявшая мощность.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Тч. В таком состоянии она, вероятно, все равно бесполезна. Берегите бесполезный хлам сами!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob поднимает воротник и ускоряет шаг, не оглядываясь назад. Вскоре он исчезает во тьме.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, просыпайся! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, помогите ей, пожалуйста!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Она все еще появляется на детекторе жизни. Наверное, она просто устала.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("А ты — тот, кто все еще нуждается в защите — кричишь здесь о спасении других людей?", "Mariru")
	await novel_interface.show_dialog("...Ты все больше превращаешься в вспыльчивого идиота.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Пойдем домой.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Эта девушка — наш враг, не так ли?", "Nantetsu")
	await novel_interface.show_dialog("Разве Сенат не требует немедленного задержания всех первоклассных террористов, а затем...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Пусть на каждом вертолете постоянно работают модули защиты от сканирования. Я поручу четырем БПЛА SID сопровождать нас в режиме автоматической контратаки.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Мои люди — я буду сопровождать их лично. Любой, кто желает смерти, может попробовать меня!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ха-ха-ха… Это Mariru я знаю.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru поручает медицинской бригаде обработать наши раны, затем берет Annie, Elluka и меня на борт вертолета.")
	await novel_interface.show_text_only("Annie так устал. Она опирается на мое плечо и вскоре засыпает.")
	await novel_interface.show_text_only("Elluka тоже спит, растянувшись у меня на коленях, с каплей слюны в уголке рта. Ничего не осталось от того ледяного взгляда, который был у нее всего несколько минут назад.")
	await novel_interface.show_text_only("В конце концов, она всего лишь обычная маленькая девочка... и по какой-то причине это наполняет меня облегчением.")
	await novel_interface.show_text_only("Все будет в порядке. Все наладится, как поется в этой песне:\\nВсе будет хорошо.")
	await novel_interface.show_text_only("Несмотря на то, что сейчас между шестью Академгородами сохраняется мир, обширные регионы, находящиеся вне их контроля, все еще опустошены войной.")
	await novel_interface.show_text_only("Интересно, сколько таких детей, как Elluka до сих пор используют в качестве оружия или инструментов...")
	await novel_interface.show_text_only("Mariru был прав. Я идиот, который всегда откусывает больше, чем может прожевать.")
	await novel_interface.show_text_only("Но я почти никогда не встречал человека, готового отбросить всю свою бдительность и мирно заснуть рядом со мной. Теперь их двое.")
	await novel_interface.show_text_only("… Мне нравится быть идиотом.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
