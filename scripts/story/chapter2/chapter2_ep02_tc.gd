# chapter2_ep02.gd - 第二章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep02_script()

func play_script():
	pass

func chapter2_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spSoundChannel.png")
	await novel_interface.show_dialog("各小組注意，相位波動正在衰減！", "探員A")
	await novel_interface.show_dialog("敵人隨時可能出現！\n堅守位置準備迎擊！！", "探員A")
	await novel_interface.show_dialog("……報、報告！", "探員B")
	await novel_interface.show_dialog("目視區域內發現兩個人形單位，突然出現在異變核心區……", "探員B")
	await novel_interface.show_dialog("人類……？\n怎麼可能！模因檢測的結果是？？", "探員A")
	await novel_interface.show_dialog("色相是……\n綠色！！", "探員B")
	await novel_interface.show_dialog("似乎是兩個小姑娘……\n不要開火！不要開火！", "探員B")
	await novel_interface.show_dialog("……", "探員A")
	await novel_interface.show_dialog("剛剛接到命令，優先將她們控制並帶回總部。\n派一名高級探員去交涉——", "探員A")
	await novel_interface.show_dialog("其他人注意警戒，交涉期間目標如果有異動就立刻處決！！", "探員A")
	await novel_interface.show_dialog("明白！", "探員B")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("我們小心地朝研究中心出口前進。")
	await novel_interface.show_text_only("迎接我們的，除了熟悉的街道，還有一排封鎖線，以及後方手持武器嚴陣以待的人。")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("怎、怎麼突然冒出這麼多人？！", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("啊——安妮！\n快把我的衣服換回去！！", GameConfig.player_name)
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("這麼羞恥的衣服……\n實在不想被人看到啊……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("這種時候你還在意這個嗎？", "安妮")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("你的衣服都好好地保存在我這裡，不用擔心……", "安妮")
	await novel_interface.show_dialog("真要換的話，你把現在這套『戰服』脫掉，再穿回原本那些鬆鬆垮垮的衣服就好了～", "安妮")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("不過前面有好多男人耶……\n你真的要當著他們的面換衣服嗎？", "安妮")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗚嗚嗚～～\n明明我也是男……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("話說回來……你剛才穿的都是男裝啊！\n難道——", "安妮")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("欸？你以前也遇過這種狀況嗎？？", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("（也是呢……安妮應該不是一般人吧？）", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("（如果是安妮的話，或許能理解我的處境……）", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("嗯嗯，我理解的……", "安妮")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("你是偷拿了自己喜歡的男生的衣服來穿，對吧？", "安妮")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("理解個頭啊！！！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("嗯嗯～其實"+GameConfig.player_name+"是那種會對異性的味道特別著迷的體質吧？不用難為情啦……", "安妮") #文本变化important
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不要露出一副「雖然你是變態但我會包容你」的表情啊！！！", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("唉……我為什麼會變成這樣，還是完全沒有頭緒……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("……")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("站住！\n把手舉起來！", "SID探員")
	await novel_interface.character_dark()
	await novel_interface.show_text_only("一個穿著黑色西裝的人走上前來朝我們喊話。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("唉……？\n把我們當成壞人了嗎？", GameConfig.player_name)
	novel_interface.change_2nd_expression("panic")
	await novel_interface.show_dialog("（等等，那個領頭人胸口的標誌）\n（正圓形、環套式的盾牌——該不會是……）", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("兩位，我是SID的探員。\n為了避免你們受傷，請保持姿勢不要亂動。", "SID探員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_text_only("果然是SID的傢伙！\n這下慘了！！！")
	await novel_interface.show_text_only("我腦海中瞬間閃過那些SID出動大批特工抓捕間諜的新聞畫面。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("還有什麼「秘密監獄」啦、「暗殺行動」啦之類的都市傳說……")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("核心封鎖區報告，兩名目標未發現攻擊意圖。\n暫定威脅等級D+。", "SID探員")
	await novel_interface.show_dialog("先做個簡單的問話吧……\n——你們是什麼人？在這裡鬼鬼祟祟地做什麼？", "SID探員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("我是本市的學生……", GameConfig.player_name)
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("我們只、只是來做校外教學，順便參觀了一下研究所……", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那個穿黑色西裝的特工露出了不屑的表情。")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("是嗎——參觀？研究所？", "SID探員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_text_only("糟糕……\n我忽然想起來——")
	await novel_interface.show_text_only("因為『洛斯金盃』消失的事情，研究所昨晚就被緊急戒嚴了。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("這種時候我們大搖大擺地從裡面走出來，還聲稱自己只是參觀了一下……簡直就像在主動自白的熊吉。")
	await novel_interface.show_text_only("果然，她似乎從耳機裡接到了什麼指令，神情嚴肅地看著我。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("agent","",0.25)
	await novel_interface.show_dialog("我收到長官命令，請二位跟我們走一趟。", "SID探員")
	novel_interface.character_move_right(0,0.3,false)
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("短短幾秒之間，我們兩個就被徹底包圍住了。")
	await novel_interface.show_text_only("視線所及，對著我們的全是黑壓壓的槍口。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+"，這些傢伙看起來很不妙呢……\n不如我們看準時機逃掉吧。", "安妮")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("agent","",0.3)
	await novel_interface.show_dialog("請放心，我們不會傷害你們的。\n只要你們好好配合調查，事情就能和平解決。", "SID探員")
	await novel_interface.show_dialog("兩位應該知道，涉及『異質物』失蹤的事情非同小可，可能引發各種超乎常識的事件，請務必理解。", "SID探員")
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(-0.25,0.3,true,"worry")
	novel_interface.character_2nd_move_right(0.25,0.3,false)
	await novel_interface.show_dialog("（超乎常識的事件……嗎？）", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("好，明白了，我跟你們走。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("哎？？怎麼就跟著走了啊！\n喂！"+GameConfig.player_name+"！", "安妮")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("別、別扯了！笨蛋，裙子要被扯掉了！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("你才是笨蛋啊！為什麼要跟這麼可疑的傢伙走，要是被灌藥賣掉了怎麼辦？！", "安妮")
	novel_interface.character_light(0.35,"shy_right")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我一個大男人有什麼好……", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("不對，誰會找來這麼多人，大張旗鼓地拐賣人口啊！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"frustrate")
	await novel_interface.show_dialog(GameConfig.player_name+"一定沒見過萊博娜群島的黑幫吧……", "安妮")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("總之……說不定能搞清楚一些事呢\n還是乖乖跟她走吧……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("好吧，你去哪我都會跟著你啦……", "安妮")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("那個，方便的話能不能先給我一件外套。", GameConfig.player_name) 
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("這件衣服實在有點……", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("穿著女裝被眾人圍觀，實在是渾身不舒服。")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("好吧，我申請一下。", "SID探員")
	await novel_interface.show_dialog("……", "SID探員")
	await novel_interface.show_dialog("……抱歉，長官說「這身衣服很可愛」\n斷然否決了申請。", "SID探員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("到底是什麼樣的長官啊！！", GameConfig.player_name)

	print("=== 第二章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
