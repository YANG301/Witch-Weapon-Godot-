# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Với sự cho phép của Mariru, Annie và tôi quyết định đi mua sắm với Elluka.")
	await novel_interface.show_text_only("Elluka đứng đằng sau tôi, thận trọng quan sát mọi thứ.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Elluka, bạn có muốn sô cô la không?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("Elluka, sô cô la, giống như vậy.", "Elluka")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Bạn đây rồi.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka cầm lấy thanh sô cô la, cẩn thận mở gói và cắn một miếng nhỏ.")
	await novel_interface.show_text_only("Không thể có đủ của cô ấy. Rất dễ thương!")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Này, bạn trông giống như một kẻ biến thái ở tuổi trung niên.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cái gì?! Tôi chỉ là một thiếu niên.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("Biến thái.", "Elluka")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tại sao cả hai người lại làm điều này với tôi?", "Lian")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("Elluka, tôi sẽ không tặng sô cô la cho bạn nếu bạn cứ hành động như vậy.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Bắn. Cô ấy trông dễ thương ngay cả khi cô ấy xuống.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Haha. Tôi chỉ đùa thôi. \\nBạn đây rồi.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Bạn có bao nhiêu sô cô la? \\nBạn sẽ tăng cân nếu ăn quá nhiều.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Vấn đề lớn là gì? Tôi chỉ có một vài khối.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie nhìn tôi chằm chằm với ánh mắt kỳ lạ, khiến tôi cảm thấy khó chịu.")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("Cái gì?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Tôi đã lén xem báo cáo kiểm tra thể chất gần đây của bạn. \\nBạn đang tăng cân nhưng không cao thêm chút nào.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tại sao bạn làm điều này?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Rõ ràng là để hiểu bạn hơn.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Giờ tôi biết bạn chỉ cao có 5 foot 3. Giống như tôi.", "Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chết tiệt. Chẳng có gì đáng tự hào cả.", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Nhưng hồi nhỏ tôi cao 5 foot 4!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Điều đó không có nhiều khác biệt phải không?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Bạn đã lừa tôi... \\nLẽ ra tôi không nên nói với bạn điều này.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trong khi Elluka thưởng thức sô cô la của cô ấy, cuộc trò chuyện đã thu hút sự chú ý của cô ấy. Cô chợt nhìn lên với vẻ bối rối.")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("Chị Lian?", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Vâng?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anh trai... Lian?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chị ơi? Anh trai? \\nDữ liệu bị hỏng. Không thể xác định được.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Elluka! Hãy quên những gì chúng ta vừa nói đi!", "Lian")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quét lại mục tiêu. Nữ được xác định... \\nChị? Anh trai?", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Aaaahh! Dừng lại!", "Lian")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
