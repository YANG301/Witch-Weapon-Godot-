# chapter2_ex04.gd - 第二章番外04
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex04_script()

func play_script():
	pass

func chapter2_ex04_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("マリルの許可を得て、俺とアニーはイルカを\\n連れて街に出た。")
	await novel_interface.show_text_only("イルカは俺の後ろにくっ付いて、キョロキョロと\\n周囲の全てを観察している。")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("イルカ、チョコいる？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","normal",0.25)
	await novel_interface.show_dialog("イルカ、チョコ、好き。", "イルカ")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("はい、どうぞ。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカはチョコを受け取ると、慎重に包みを外し\\n軽く一口かじった。")
	await novel_interface.show_text_only("何～～度見ても、本当に可愛いな～！")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("誰かさんの顔が、中年のおっさん化してるよ！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("えっ！？遂に思春期男子から中年のおっさんに\\n進化してしまった！？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_normal","smile",0.25)
	await novel_interface.show_dialog("へんたい―――", "イルカ")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("なんで2人一緒に責めてくるんだよ！\\nもうっ！", "小憐")
	novel_interface.change_expression("sprite")
	await novel_interface.show_dialog("イルカにはもうチョコあげないからな～～", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("ぅう………", "イルカ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("やばい、この落ち込んでいる顔も超可愛いな！")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("へへ～ん、嘘だよ。\\nはいっ、もう1個どうぞ。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("……レンちゃん一体何個チョコ持ってるの！？\\n糖分の過剰摂取は絶対太るよっ！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("いいじゃないか、チョコぐらいで。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーに言い知れない目で見つめられ、\\n無言の圧力を感じた。")
	novel_interface.show_character("ren_uniform","uneasy")
	await novel_interface.show_dialog("どっ、どうしたの？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("レンちゃんの身体検査報告書を私見たよっ！\\n\\n体重がじわじわ増えてるのに、\\n身長はまったく伸びてない！", "アニー")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("なんでそんなものを見たの！？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("ふっふっふっ～、それはもちろんレンちゃん\\nの事をもっと詳しく知るためだよ！！", "アニー")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("そう！例えば私はこんな事も知っている……\\n\\nレンちゃんの身長は私と同じ161センチ！！", "アニー")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それは誇るポイントじゃないからな……", "小憐")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("それに俺が男だった時、165センチぐらいは\\nあったんだぞ！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("えっ…？　男の子だよね?\\n今より少しだけ背が高いぐらいだったの？", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("しまった……\\n（実数値まで言うべきじゃなかった……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さっきから黙々とチョコを食べていたイルカが、\\nこの会話にだけは反応して、\\n疑念を浮かべた表情で顔を上げた。")
	novel_interface.show_character("iluka_normal","gourmet")
	await novel_interface.show_dialog("レン…お姉ちゃん？", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("どうしたの？", "小憐")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("レン………お兄ちゃん？", "イルカ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("……", "小憐")
	novel_interface.character_light(0.35,"sleepy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("お姉ちゃん？　お兄ちゃん？\\nデータ混乱、判別不能。", "イルカ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("イルカ！　さっきの話は忘れよう！？", "小憐")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("再スキャン、目標、人類女性……\\nお姉？ちゃん？　お兄？ちゃん？", "イルカ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("うわあぁぁ――止まってくれえぇぇ――っ！", "小憐")

	print("=== 第二章番外04结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
