	await novel_interface.show_dialog("เนื่องจากคุณสามารถกินช็อกโกแลตได้ ร่างกายจึงควรทำงานเหมือนเด็กปกติใช่ไหม?", "Lian")
	await novel_interface.show_dialog("คุณไม่ใช่เครื่องใช้ไฟฟ้าภายในบ้าน...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("ไม่ต้องสงสัยเลยว่าหญิงสาวคนนี้สามารถสัมผัสได้ถึงการมีอยู่ของจารึกเวทมนตร์", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("แต่พลังของเธอ… เป็นสิ่งที่พิเศษมาก", "Annie")
	await novel_interface.show_dialog("เธอเป็น... เพชฌฆาตเหรอ?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
