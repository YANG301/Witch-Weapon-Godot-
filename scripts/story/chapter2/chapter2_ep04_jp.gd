# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("あまりにもリアル過ぎて、もしかしたら\\n夢じゃないかもしれない……\\n俺も未だに混乱してる……", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("でも、いくら検索しても、火災や建物が\\n破壊されたニュースなんてどこにもなくて……\\n街の光景もいつもと何も変わらないし……", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ただ……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……うん？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("ただ……？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("目覚めたら……", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("俺の身体が……女の子になってた……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("……", "アニー")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("はい…………", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("……は？　女の子になった……はぁ？", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("俺、今はこんな見た目だけど……", GameConfig.player_name)
	await novel_interface.show_dialog("俺ッ！！\\n俺は元々は男なんだよッ！！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("ほう？　ほうほう？\\n男だと？", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("ほ……え？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("つまりあれだ、あれだろ？\\n女装趣味と言う事か？（接近）", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("違うっ！　いや、そういう意味じゃなくて……！　\\nって、おいッ！グイグイ寄ってくるなッ！", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("あっ、でも……ある意味では……\\nそれで合っている……のか…？", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("あ、あああああ、もおおお！！", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("ふむ……この胸の部分、良くできている。\\n（ムニムニ）", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("そしてこの弾力……どんな技術を使えば、\\nこんな自然な感触を……（モムモム）", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("あ！　そっちの方面の話なら、\\nアニーも知りた～～いっ！！", "アニー")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("あっ！　ぁ、違う…やめろ…その……\\nお前ら気安く触るなッ！！！", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("どれどれ……\\n肩も繊細で、腰から骨盤までの曲線も美しい。", "マリル")
	await novel_interface.show_dialog("全身に使用した素材が何か知りたいな。\\n……ここなんて特に。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("やあああっ！　くすぐったいっ！", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("マリルさんっ！　そこっ！　ダメっ！", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("だめええぇぇぇぇ～～っ！！！！！", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("うっえうぅ……", GameConfig.player_name)
	await novel_interface.show_dialog("とにかくっ！　昨日まで俺は男だったの！", GameConfig.player_name)
	await novel_interface.show_dialog("手術も受けた事なんてないし……っ", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("まぁ、手術に関しては私も疑ってない。", "マリル")
	await novel_interface.show_dialog("現在の技術水準で、\\n徹底的に性別を変更するなどは不可能だ……", "マリル")
	await novel_interface.show_dialog("まず体中の骨を入れ替える前提がなければ、\\n成り立たない話。\\nゆえに、お前は最初から女性だ。", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("だっ！　かっ！　らっ！\\n女じゃないってッ！\\n目が覚めたらこうなってたって言ってんの！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("何か証拠を提示できないか？\\nかつて男であった事を証明できる物とか。", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("えーっと……証拠、証拠……\\nあっ！　学生証！", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("ここに入る時、所持物は全て没収された。\\n\\nただIDカードだけは俺が着ていた男の服に\\n入っているはず。")
	await novel_interface.show_text_only("マリルは手にあるタブレットで部下に指示を出し俺の学生証をこの場に持ってきてくれた。")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("あったっ！　これだよっ！\\nほら、男だろ？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("顔立ちは似てなくもないが、これだけではな……", "マリル")
	await novel_interface.show_dialog("そうだ、都市監視システムの直近1か月で撮影された\n"+GameConfig.player_name+"の映像をすべて呼び出してくれ……", "マリル")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("慣れた手付きでタブレットを操作するマリルの\\n表情には、やや興奮がうかがえる。")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("あの惨劇を見た時は夢かと思って、目を覚ませば\\nきっと全てが無かった事になってるって……", GameConfig.player_name)
	await novel_interface.show_dialog("だけどいざ目が覚めたら、\\n自分が女の子になってるなんて……", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("骨格変化の修正を加えて、先ほどお前が廊下で\\n歩いてた姿と比較すると……", "マリル")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("マリルは俺のつぶやきを無視して、\\n熱心にタブレットを操作し続けた。")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("あれは夢じゃなかった？でも今は普通だし、\\n惨劇が起きた様子も一切ないし……", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("あーーもうっ！　全然分からん！", GameConfig.player_name)
	await novel_interface.show_dialog("一体どこまでが本当で、どこまでが夢なんだよ……！", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("……分析完了\\n歩行パターンの一致を確認。", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("どういう意味？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("人の歩行パターンは、脳が筋肉をコントロール\\nする際の癖の塊みたいなものだ。\\nこの世で最も優秀と称される工作員であっても\\n完全にこれを偽装する事はできない。", "マリル")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("現在の科学理論では説明できないが……\nお前は間違いなく"+GameConfig.player_name+"だ。", "マリル")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("ほ、本当なの？？", "アニー")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("ここに来たら、何かが分かると思ったんだ……", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("おい、お前は『ロス・ゴールド』について\\n一体何を知ってる？", "マリル")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("『ロス・ゴールド』？\\n朝のニュースで、突然消えた異質物──\\nって見ただけで……実物は見た事がないけど。", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("ふむ、\\nもしお前の言っている事が真実と仮定すると……", "マリル")
	await novel_interface.show_dialog("私があの金にもならない、くっだらない講義に\\nわざわざ出向く理由は、\\n『ロス・ゴールド』ぐらいしかないだろう。", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("アレはロス諸島で発見された『異質物』で、\\n外周には奇跡的純度を誇る宝石が、\\n4つ装飾されている。", "マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そう言えば、廃墟から脱出した後に見た、\\n宙に浮かんで光る物体……\\n輪郭がグラスと似ていたような……", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("宙に浮かんでいた光は淡い紅色を帯びていて……", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("淡い紅色？？", "マリル")
	await novel_interface.show_dialog("（グラスの中に存在する紅色の液体、\\n　その謎はずっと解けなかった……）", "マリル")
	await novel_interface.show_dialog("（だがこの情報は機密扱いで、つい先日『Safe』と\n　判定された後も一度も外部には公開されていない……）", "マリル")
	await novel_interface.show_dialog("（自分の目で見た事のない人間が、\\n　ここまで詳しく知るはずがない……）", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("言っている事が真実か夢かはともかく、\\nお前からはもうちょっと話を聞く必要があるな。", "マリル")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
