# chapter2_ep15.gd - 第二章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep15_script()

func play_script():
	pass

func chapter2_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Soupir... Cette jupe est encore beaucoup trop courte...\nIl fait froid en dessous...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Trop de choses incroyables se sont produites ces derniers jours.\nMon cerveau arrive à peine à suivre...", "Lian")
	await novel_interface.show_dialog("Le rêve de la ville détruite, de me réveiller un matin pour découvrir que j'étais transformée en fille et que j'étais attaquée par un ennemi complètement inexplicable...", "Lian")
	await novel_interface.show_dialog("Rien de tout cela ne semble réel.\nEt en plus de ça...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, entrez.", "Professeur principal")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("Ah, oui-oui !", "Lian")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_classRoom.png")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("N-N-N-Ravi de vous rencontrer pour la première fois !\nBonjour à tous, je m'appelle Lian...", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Je suis très heureux de devenir camarade de classe avec vous tous, alors s'il vous plaît, prenez soin de moi à partir de maintenant...\n...", "Lian")
	await novel_interface.show_dialog("(...Même si je deviens ta camarade de classe sous la forme d'une lycéenne, que ça me plaise ou non...)", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(...S'il vous plaît, épargnez-moi...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Très bien, Lian, prenez le siège vide au dernier rang.", "Professeur principal")
	await novel_interface.show_dialog("(...Un étudiant transféré à ce stade du trimestre ? C'est inhabituel.)", "Camarade de classe A")
	await novel_interface.show_dialog("(...Elle continue de regarder le sol. Je parie qu'elle est vraiment silencieuse, hein ?)", "Camarade de classe B")
	await novel_interface.show_dialog("(...Mais elle est vraiment mignonne... Cette couleur de cheveux est-elle teinte ?)", "Camarade de classe A")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Tout le monde me regarde...\nUgh... la route à venir va être difficile...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ouf, les cours sont enfin terminés... La vie scolaire n'a jamais été aussi épuisante.\nUne école très performante est vraiment différente après tout...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Merde... Je dois aller aux toilettes...)", "Lian")
	await novel_interface.show_dialog("(N-Pas question, je ne peux absolument pas aller dans les toilettes des filles à l'école... !)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ugh, qu'est-ce que je suis censé faire... ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Qu'est-ce qui ne va pas~ Pourquoi soupires-tu autant ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hein ? Annie !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Et alors ? Est-ce que tu t'installes bien dans la nouvelle école ? Il y a beaucoup de filles très mignonnes ici~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh... ne parlons pas de ça maintenant.\nVotre formation aux connaissances de base est-elle déjà terminée ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Héhé, je suis venu dès que j'ai réussi l'évaluation ! Si je te laissais ici tout seul, qui sait ce qui pourrait t'arriver.", "Annie")
	await novel_interface.show_dialog("Heureusement, je ne suis pas parti très longtemps et New Opulentia est désormais une ville d'immigrants, donc je n'aurai probablement pas trop de mal à m'adapter.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Mademoiselle Mariru m'a également demandé de prendre soin de vous~\nElle s'est spécifiquement arrangée pour que nous soyons dans la même classe.", "Annie")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("Je suis une grande maman—\nDe toute façon, je n'ai besoin de personne pour prendre soin de moi~~", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Héhé, en plus, je me sens beaucoup plus à l'aise quand je suis à tes côtés aussi...", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("J'ai entendu dire que vous vous étiez porté volontaire pour rejoindre SID avec moi.", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Annie avait l'air reconnaissant. J'étais momentanément à court de mots et je ne savais pas si j'allais réellement réussir les tests sans problème....")
	novel_interface.show_character("anne_uniform","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh, c'est vrai, l'infirmière de l'école m'a demandé de lui transmettre un message. Elle veut que tu ailles la voir pour un examen physique.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("A-Un examen physique !?", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nous sommes des étudiants transférés, donc l'école doit nous faire passer des contrôles séparés~\nOu êtes-vous contrarié d'avoir manqué de le faire avec toute la classe... ?", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Bien sûr que non !!\nJe comprends, mais avant ça...", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("(...Salle de repos......)", "Lian")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("anne_uniform","worry",0.25)
	await novel_interface.show_dialog("Je ne t'entends pas... Dis-le plus fort~", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"shy_right")
	await novel_interface.show_dialog("... Euh, pourrais-tu m'emmener aux toilettes... ?", "Lian")
	await novel_interface.show_dialog("Si j'y vais seul..., je me sentirai bien trop coupable. Je n'ose pas y aller seul...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Pfft...\nEt après que tu aies dit que tu n'avais besoin de personne pour prendre soin de toi~", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Très bien déjà... dépêche-toi...", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_passage.png")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("(...À propos de l'examen physique...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("(...Le fait que j'étais un garçon ne sera pas révélé, n'est-ce pas ?!)", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Que vérifient-ils encore lors d’un examen physique ?)", "Lian")
	await novel_interface.show_dialog("(Et attendez... dois-je me déshabiller ?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(C'est une bonne chose que je n'ai pas été paresseux et que j'ai mis mes sous-vêtements aujourd'hui...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("(L'infirmerie... c'est ici ?)", "Lian")
	await novel_interface.show_dialog("Excusez-moi, je suis l'étudiant transféré ici pour l'examen physique...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Un timing parfait. Je t'attendais.", "Ai")
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("A-A-A-Ai?", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Wah, non, pourquoi c'est toi qui fais l'examen ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Hein... ?\nAi, a-arrête ça—— !!", "Lian")
	await novel_interface.show_dialog("Attendez... Quel est cet étrange instrument agité que vous tenez ??", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Aaaah——!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ugh... pourquoi cela se produit...", "Lian")
	await novel_interface.show_dialog("Ils auraient pu sauter tout ça et tout ça, n'est-ce pas... ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Vous exagérez beaucoup trop.\nC'est juste un examen de routine, de routine~", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("... La vision dans les deux yeux est de 2,0. C'est absolument parfait.\nCela a-t-il changé par rapport à vos anciennes données ?", "Ai")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ? Mon œil gauche était de 1,0 et mon œil droit de 0,7.\nLe médecin m'a même dit de m'asseoir plus loin lorsque je jouais à des jeux...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"blush_dizzy")
	await novel_interface.show_dialog("Comme c'est fascinant... Votre corps semble avoir été reconstruit de fond en comble, jusqu'aux os.", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Et pourtant, la topologie neuronale de votre cerveau présente simultanément des traits des deux sexes, c'est pourquoi vos souvenirs et vos schémas de pensée ont été préservés..., n'est-ce pas ?", "Ai")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ai semblait presque assez excité pour trembler.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Si tel est le cas, alors en théorie, vous devez également être conscient du fait que vous devenez plus sensible aux émotions des autres.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("N-Pas question...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Absolument pas ! Je suis un homme à cent pour cent !", "Lian")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Quoi qu'il en soit, d'un point de vue médical, vous êtes sans aucun doute une femme à cent pour cent.\nVotre santé est parfaitement bonne, à l'exception d'une chose...", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","worry",0.25)
	await novel_interface.show_dialog("Sauf pour quoi ?", "Lian")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dans peu de temps, vous ressentirez une douleur abdominale. A part ça, il n'y a aucun problème~\nCela devrait arriver bientôt, alors assurez-vous d'être prêt.", "Ai")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Des maux de ventre... ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false,"wail")
	await novel_interface.show_dialog("... Quoi——?!", "Lian")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("Ugh... Ai, toi !!", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Je me sentais tellement lésée et impuissante que j'étais au bord des larmes....\nUgh, je suis censé être un homme, ne pleure pas !!")
	novel_interface.show_character("ai","blush_think")
	await novel_interface.show_dialog("Mm, mm, c'est vraiment parfait.... C'est rare de voir quelqu'un de son âge sans aucune cicatrice sur son corps.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","shy_left")
	await novel_interface.show_dialog("Cela ne me fait pas plaisir du tout !!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Euh, puis-je y retourner maintenant... ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/aiyi_pickwearing.png")
	await novel_interface.show_text_only("Ai a enlevé sa blouse blanche, a affiché une expression qui disait \"maintenant, je deviens sérieux\" et a sorti deux tenues de la garde-robe...")
	await novel_interface.show_dialog("De quoi parlez-vous ?\nLa partie amusante ne fait que commencer...", "Ai")
	await novel_interface.show_dialog("Mariru l'a déjà approuvé, donc je peux Lian essayer toutes sortes de vêtements différents...", "Ai")
	await novel_interface.show_dialog("E-Eh—?", "Lian")
	await novel_interface.show_dialog("Et puis... hehehehe, je vais aussi étudier chacun des points de données de Lian.", "Ai")
	await novel_interface.show_dialog("Yaaahhhhhhhhhhhh~~~ !", "Lian")

	print("=== 第二章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
