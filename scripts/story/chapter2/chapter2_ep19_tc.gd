# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("從訓練的資料看，小憐的身體素質和普通的女高中生沒什麼差別。", "愛衣")
	await novel_interface.show_dialog("唯一亮眼的是眼手協調能力，我猜這跟她遊戲帳號上那串白金獎杯有關……", "愛衣")
	await novel_interface.show_dialog("安妮在單獨訓練的時候好一些，可以達到同年齡競技選手的水準。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("但上次觀測到她們倆再次一起消失在異變區域的時候就完全不同了。", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("哦？ 有什麼有趣的發現嗎？", "莉琉")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("雖然普通人不一定能感覺到……", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("但跟蹤她們的無人機上所裝的「玻爾茲曼探針」記錄多次爆表，回收時都已經壞掉了。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("不可能，如果探針無異常的話…那樣的話在場的人\n……", "莉琉")
	await novel_interface.show_dialog("不，恐怕大半條街道都會氣化了。", "莉琉")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("而且妳把那麼貴的玩意兒裝在無人機上到底想做什麼！", "莉琉")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("莉琉捲起報表，精準地敲到了愛衣的頭上，\\n愛衣發出一聲短促的呻吟。")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("嘛……就算不是熱量，資訊熵暴增也可以達到這種效果唷。", "愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("她們兩個人，居然將機率不到億萬分之一的事件，以100%確定發生的形式表達出來。", "愛衣")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("既然安妮是魔女，那小憐……算是「異質物」所造就的容器嗎？", "莉琉")
	await novel_interface.show_dialog("就像是小憐驅動了魔女和魔法一樣……", "莉琉")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("簡直就像是超級電池塞進了會震動的按摩棒一樣……", "愛衣")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("指揮室傳出一聲巨響，愛衣的頭上長出一個包。")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("我真為納稅人感到悲哀，他們繳那麼多稅金，怎麼會培養出妳這種人呢？", "莉琉")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("科學就是需要這種永遠飢渴難耐、無法滿足的好奇心嘛～", "愛衣")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("……虧妳好意思說出來。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("妳不也經常在我的戰研部指定些奇奇怪怪的研發目標嘛……", "愛衣")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("而且現在也一副在打主意的樣子呢。\n說吧說吧，你想幹什麼？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣發現了莉琉嘴角還沒來得及收斂的微笑。")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("既然已經接受一段時間的訓練，是該驗收小朋友們的訓練成果了。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("（異質物、洛斯金盃、魔女、時空相位波動，都被她串聯起來了……）", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（只有她在場的時候，安妮才能進出異變區域，）\\n（那安妮消失的這七年……）", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("這個表情……妳打算讓無知少女直接面對危險嗎？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("現階段還沒有收集到足夠的資訊，對於不可言喻的事只能保持沉默。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("哼~我還是比較喜歡維特根斯坦的另一句話。", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("真正神秘的，不是世界為何存在……", "莉琉")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("而是世界竟然存在。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("我會按照自己的原則做的。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("這點我當然知道～", "愛衣")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("我和安妮突然接到莉琉的命令，叫我們緊急返回公寓待命。")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("是緊急任務嗎？ ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("這個嘛……\\n（盯——）", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("莉、莉琉小姐？", "小憐")
	await novel_interface.show_dialog("（怎麼覺得今天莉琉的眼神有點奇怪……）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("該說是一日不見，如隔三秋嗎？ \\n唷，妳可是成長了不少啊——", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("是啊……雖然生活上還是有一些地方不太習慣。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("哦？ 不習慣？", "莉琉")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("比如說，戰服的設計……\\n那種裝扮也太令人害羞了吧？ ！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("明明很帥氣！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("是上衣的尺寸不合適了嗎？ \\n需要重新測量一下嗎？", "莉琉")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不！ 我才不是那個意思！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("莉琉向我伸出雙手，我識破她的意圖，連忙躲避。")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("呃——沒有沒有！ \\n很合適非常合適！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("嘖。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("（妳在可惜什麼啦！ ）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("果然，小憐的身體還在發育啊……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮露出羨慕又失落的表情。")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("安妮——！ \\n妳怎麼了……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("我也想和小伶一起長大啊~！\n——可惜，我的時間是靜止的。", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("時間是靜止的……和魔女有關嗎？")
	await novel_interface.show_text_only("安妮開朗的表情裡露出難以掩飾的哀傷，氣氛一下子沉重了。")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("……安妮。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("所以，快讓我感受一下——\n嘿咪！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮從背後一把抱住了沒有提防的我。")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("喂——！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("……女大不中留啊。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉把頭轉向一邊，偷偷擦拭眼淚。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("真是的，妳們！ 這是什麼跟什麼啦！ ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("咳咳——說正事！\n現在確實有個緊急任務要你們執行。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("妳們知道江森變電所嗎？", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("是東部海邊的那間超大型變電所？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("（那邊是六座學園都市在埃癸斯範圍內劃定出的共管區域，戰後和談就是在那裡進行的。 ）")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("沒錯，剛才接到了十幾個中繼點的警告，東北部地區出現了強烈的突波。", "莉琉")
	await novel_interface.show_dialog("衛星偵測到了時空波動狀況，鎖定位置就在江森變電所。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("時空波動？ ！難道……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("如果資料無誤，就很有可能和妳們兩個人之前的情況一樣。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("照理說，妳們還不符合出外勤的資格……", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("但那裡是「協議非武裝區」，即使是在新豐洲範圍內，SID也沒有行動許可權。", "莉琉")
	await novel_interface.show_dialog("算是為「世界和平」而做出的小小讓步吧。", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("所以，現在需要妳們先前往變電所偵查，SID的行動小組會在外圍待命。", "莉琉")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("我會去聯合議會，盡快申請到正式許可。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("呃，所以我們要擅闖學園都市聯盟的領地嗎？ \\n這樣會不會不太好啊。", "小憐")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哦？ 看來有人寧可讓使館區陷入全面停電的狀況，也不想走一次捷徑……", "莉琉")
	await novel_interface.show_dialog("要是出了什麼亂子，那群本來就互相看不順眼的笨蛋說不定又會打起來啦。", "莉琉")
	await novel_interface.show_dialog("要是因為這件事開戰的話……", "莉琉")
