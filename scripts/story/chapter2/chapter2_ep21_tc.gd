# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("一場激戰過後，終於消滅了帶頭的傢伙，其他人也隨之化作一團紅霧消散了。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("呼——\\n誒？！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("幾張發黃的手稿落在我面前，上面參雜著文字和圖案，展現出一幅讓人完全無法理解的狀態。")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W…A…D…", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("嗯？ ？\\n是我眼花了嗎……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我揉了揉眼睛又盯著那幾張紙看了一遍，唯一可以確定的是，它們是用英語寫的。")
	await novel_interface.show_text_only("雖然能辨認區域性的字母，可我一旦試圖將它們連成單詞和句子。")
	await novel_interface.show_text_only("就頓時覺得腦海中一片混亂在攪動，讓我無法識\n別。")
	await novel_interface.show_text_only("就像罹患了閱讀障礙，我連那上面最簡單的單字都認不出來了。")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("先別在那裡一直看啦，救人要緊～", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("哦～知、知道啦！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("在我將它們收起來的一瞬間，似乎看到紙張上閃過符咒圖樣的光芒，然後又快速消失。")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("那是——", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("什麼？", "安妮")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("難道，是我的錯覺？\n（那股難以言說的震顫，到底是……）", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("手臂上還殘留著痠麻的感覺，提醒著我，這一切並不是幻覺。")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("對了，妳沒事吧？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("我打量起受傷的小女孩，她的表情依舊十分冰冷。 \\n似乎並沒有因為受到我和安妮幫助而感到開心。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("仔細一看，她的外表和裝備，一定不是普通的小孩子……")
	await novel_interface.show_text_only("眼罩也就算了，罩袍之下，露出的是被機械鎧甲包裹的雙手。")
	await novel_interface.show_text_only("而且看她腹部的傷口……可能成年人都要哭喊喪失行動能力")
	await novel_interface.show_text_only("可她卻始終一言不發的靜靜蹲著。")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("小妹妹，你叫什麼名字？ \\n在這種地方做什麼？", "小憐")
	await novel_interface.show_dialog("剛才那群是什麼人，妳知道嗎？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("一口氣問這麼多，她回答不了吧……", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("突然間，小女孩不顧還在滲血的傷口便站了起來，個頭還挺高的嘛……")
	await novel_interface.show_text_only("等等等等！ ！\\n她的身體……飄在半空中？ ！")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……伊露卡。 \\n任務：消除，女巫。", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("小女孩用了一種奇怪的方式回答著問題。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("伊露卡……是她的名字嗎？ \\n好奇怪的語氣。")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("目標，判定——\\n人類、女性，數量……", "伊露卡")
	await novel_interface.show_dialog("一名。", "伊露卡")
	await novel_interface.show_dialog("……\\n再判定，啟動。", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("（『一名』女性？）\n（難道她能看出我的本質！！！）", "小憐")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("沒、沒錯！ 我可是男孩子啊！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("魔女，數量，一名。 \\n防禦模式，啟動。", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("啊哈哈哈——\n最近總是出現自己被陌生人認出是男生的幻覺……")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("小女孩手部的光怎麼越來越亮啊？ \\n嗯？ 喂、慢著！")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("啊啊啊啊啊——\n痛痛痛痛痛！", "小憐")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("喂，怎麼突然連我都劈啊？ ！", "小憐")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("還好我反應快，雷擊只是擦過手臂，然後在剛才站的地面上留下一個小白點。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("戰鬥能力低下，逃跑迅速。\n——無威脅。", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我，似乎被鑑定為弱雞了……")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("有必要連幫忙的人都攻擊嗎？ \\n而且為什麼針對我啊……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("魔女，打不過。", "伊露卡")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("太直白了！ ！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("小伊露卡，妳看我們這麼友善。 \\n絕對不會是壞人啦~~", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("（小聲）安妮，這種發言不僅沒有說服力，而且很像誘拐犯啊……", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("嗯……", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("——那麼，伊露卡也是魔女嗎？", "安妮")
	novel_interface.character_dark()
	await novel_interface.show_text_only("安妮沒有理我，而是直截了當地提問。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("喂喂，萬一伊露卡連「魔女」是什麼都不懂呢？")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("伊露卡，是，「行刑者」。", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("「行刑者」……現在的小孩子都喜歡這麼中二的稱號嗎？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("（糟糕，把心裡的吐槽說出來了……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("又一道落雷，還好及時躲開了。")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("哎，小朋友！ \\n有話好好說啊！", "小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("嗯……給妳一塊巧克力，別生氣了好不好？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("我將身上帶著的巧克力拿出來，分了一半遞給伊露卡。")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("呼，還好身上有帶巧克力。 \\n畢竟應該不會有小孩子討厭巧克力吧？")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("……", "伊露卡")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("啊——\\n妳看，我已經吃掉啦！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("巧克力？", "伊露卡")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不是什麼危險的東西啦……\\n是能夠為人來幸福感的零食哦！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("（小聲）隨便給陌生的小女孩投餵食物，小憐才更像誘拐犯吧！", "安妮")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("嗯……不過在隨身攜帶巧克力這點上來說，妳已經越來越像女孩子了呢！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡猶豫了一下，小心翼翼地開啟外包裝，慢慢地將巧克力含進嘴裡。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……\\n奇怪的，味道……", "伊露卡")
	await novel_interface.show_dialog("苦苦的。", "伊露卡")
	await novel_interface.show_dialog("甜甜的……", "伊露卡")
	await novel_interface.show_dialog("伊露卡，不討厭。", "伊露卡")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("嘿嘿，喜歡嗎？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("唉唷，她的表情，超可愛的……！")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("唉嘿嘿嘿……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("啊！ 小憐露出了很危險的表情。", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("表情，識別……變態。", "伊露卡")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("變變變態——？ ！\\n是說我嗎？ ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("但是，伊露卡，不討厭。", "伊露卡")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嘿嘿，不討厭就好～", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("被說成變態也這麼高興嗎？ \\n果然不能對妳掉以輕心啊……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("拜託妳別在旁邊加上奇怪的註解啦！", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("啊，對了！ \\n我這裡還剩下一塊巧克力，也給妳吧！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……給妳。", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡從身上摸出了一塊五號電池般的透明容器遞給我，裡面有發出綠色螢光的黏稠液體。")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("這是……電漿液吧？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("交換，食物。", "伊露卡")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這種東西能夠稱做食物嗎？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("伊露卡認真地點了點頭。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("餓的時候，管理員，給我食物。 \\n補充，能量。", "伊露卡")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("管理員，是妳的監護人嗎？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("如果能吃巧克力，應該是身體機能正常的小孩吧？", "小憐")
	await novel_interface.show_dialog("又不是家用電器……", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("果然這個小女孩，能感覺到魔法刻印的存在。", "安妮")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("但驅動的方式……很特別。", "安妮")
	await novel_interface.show_dialog("「行刑者」……嗎？", "安妮")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
