# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Eliminamos al jefe después de una feroz batalla y los otros enemigos desaparecieron en una nube de niebla roja.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Vaya... \\nEspera, ¿qué es esto?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un par de páginas amarillentas caen frente a mí. En las páginas hay una mezcla de texto y patrones, apenas legible.")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W... A... D...", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("¿Qué? \\nOh... Me siento mareado...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me froto los ojos e intento leer las palabras nuevamente. De lo único que estoy seguro es de que están escritos en inglés.")
	await novel_interface.show_text_only("Aunque algunas letras son legibles,")
	await novel_interface.show_text_only("Todo lo que puedo sentir es un caos total cada vez que intento juntarlos.")
	await novel_interface.show_text_only("Se siente como un trastorno de lectura. No puedo identificar ni siquiera la palabra más fácil.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Guárdalos por ahora. Tenemos una vida que salvar.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Correcto. ¡Entiendo!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("En el momento en que los guardé, creo que vi un talismán destellante en el papel, pero desapareció muy rápidamente.")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("Eso es...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("¿Eh?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Es esa mi ilusión? \\n(Siento un escalofrío indescriptible. ¿Qué es eso?...)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("El ligero cosquilleo en mi brazo me recuerda que esto no es una ilusión.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Oye, ¿estás bien?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Miro a la chica herida. Todavía parece fría. \\nNo estoy feliz ni agradecido por lo que Annie y yo hemos hecho por ella.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A juzgar por su apariencia y vestimenta, ella no es solo una chica de al lado...")
	await novel_interface.show_text_only("El parche en el ojo es bastante extraño. Pero mira sus manos debajo del vestido... Están envueltas en una armadura mecánica.")
	await novel_interface.show_text_only("Tiene una herida grave en el vientre... Incluso un adulto se derrumbará.")
	await novel_interface.show_text_only("Pero ella ha estado sentada allí en silencio, sin decir una palabra.")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Oye, ¿cómo te llamas? \\n¿Qué haces por aquí?", "Lian")
	await novel_interface.show_dialog("¿Conoces a esos tipos?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("Muy bien... tal vez sean demasiadas preguntas para ella...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La niña se levanta de repente, todavía sangrando. En realidad es más alta de lo que pensaba...")
	await novel_interface.show_text_only("¡Dios mío! \\n¿¡Su cuerpo... está flotando sobre el suelo?!")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... Elluka. \\nMisión: Eliminar, brujas.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña responde a las preguntas de una manera muy extraña.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("Elluka... ¿Ese es su nombre? \\nElla habla en un tono muy extraño.")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Objetivo, identificando... \\nHumano. Femenino. Importe...", "Elluka")
	await novel_interface.show_dialog("Uno.", "Elluka")
	await novel_interface.show_dialog("... \\nReidentificación, activado.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("(“¿Una” mujer?) \\n(¡¿Me identificó como hombre hace un momento?!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("¡Sí, es cierto! ¡Soy un chico!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bruja, cantidad, uno. \\nModo defensa, activado.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("Jajajaja... \n¡Por fin! Últimamente tengo la sensación de que algún extraño descubrirá mi verdadera identidad.")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("Uh... ¿por qué sus manos brillan, cada vez más y más? \\nVaya... ¡Espera, espera un minuto!")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("¡Aaaah! \\n¡Ay! ¡Ay! ¡Ay!", "Lian")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("¡¿Por qué te metes conmigo?!", "Lian")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Eso estuvo cerca. Gracias a mi rápida respuesta, ese rayo solo tocó levemente mi brazo y dejó una quemadura blanquecina en el suelo.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bajas habilidades de combate. Escape rápido. \\n... Ninguna amenaza.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bueno... parece que me acaban de identificar como una gallina…")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("¿Por qué me atacaste solo? \\nTe ayudé.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("No hay rival para una bruja.", "Elluka")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Eso es honesto!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("Pequeña Elluka, mira, hemos sido muy amables. \\nAsí que definitivamente no somos malas personas.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("(Susurro) Annie, esto no es nada persuasivo. Y parece que somos secuestradores.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Bueno…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("... Entonces, Elluka, ¿tú también eres una bruja?", "Annie")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Annie me ignora y pregunta a Elluka directamente.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("¡Oye, espera! Quizás Elluka ni siquiera sepa qué es una bruja.")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Elluka, Verdugo.", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Verdugo... Bueno... ¿Por qué a los niños de hoy en día les gustan tanto los apodos tan estúpidos?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("(Maldita sea, lo acabo de decir en voz alta...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cae otro rayo y lo esquivo justo a tiempo otra vez.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("¡Oye, chico! \\n¿Podemos simplemente hablar?", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aquí... chocolate. Deja de enojarte, ¿vale?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Saco una barra de chocolate de mi bolsillo, la rompo por la mitad y la comparto con Elluka.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("Uf... Qué suerte tener chocolate conmigo. \\nNingún niño odia el chocolate después de todo.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("…", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yum...yum... \\nMira, me lo he comido.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Chocolate?", "Elluka")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No es peligroso... \\n¡Es un bocadillo que te trae felicidad!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("(Susurrando) Lian, el que ofrece comida a las niñas puede parecer más un secuestrador.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Y ahora te comportas como una niña y llevas chocolates contigo. ¡Bien hecho!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka duda por un momento antes de abrir el paquete y lentamente llevarse un trozo a la boca.")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("... \\nExtraño, sabor...", "Elluka")
	await novel_interface.show_dialog("Amargo.", "Elluka")
	await novel_interface.show_dialog("Dulce...", "Elluka")
	await novel_interface.show_dialog("Elluka, no lo odia.", "Elluka")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("Jaja, ¿te gusta?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¡Ooh... se ve tan linda...!")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("Mwahaha...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("¡Ups! Lian parece muy peligroso.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Expresión facial, identificación... Hentai.", "Elluka")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hentai...?! \\n¿Quieres decir yo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Pero, Elluka, no lo odia.", "Elluka")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jaja... entonces está bien.", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("Pareces feliz de que te etiqueten como Hentai. \\nEres realmente raro...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("No, no lo soy. ¿Podrías dejar de malinterpretarme?", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("¡Ah! \\nTengo otra pieza. Puedes tenerlo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("¡Aquí!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka busca, saca un recipiente transparente del tamaño de una batería AA y me lo da. Contiene un líquido verde, espeso y fluorescente.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("¿Es este... fluido eléctrico?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("Intercambio, comida.", "Elluka")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Es esto lo que llamas comida?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Elluka asiente seriamente.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Cuando tengo hambre, el administrador me da comida. \\nPara reponer energía.", "Elluka")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿El administrador, tu tutor?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Como puedes comer chocolate, tu cuerpo debería funcionar como lo hace un niño normal, ¿verdad?", "Lian")
	await novel_interface.show_dialog("No eres un electrodoméstico...", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sin duda, esta chica puede sentir la existencia de inscripciones mágicas.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Pero su poder... es muy especial.", "Annie")
	await novel_interface.show_dialog("¿Ella es... una verdugo?", "Annie")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
