# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("不愧是超——有名（錢）的學校！ \\n餐廳裡的食物種類豐富到讓人想流淚。")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("您好！請給我一份咖哩飯套餐，三個炸雞翅。", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("蝦餅看起來也不錯呢，麻煩也給我兩塊。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("小妹妹，妳一個人吃得完嗎？", "食堂員工")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("沒問題的~", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("喂喂，妳們看那邊那個女生，居然能吃這麼多東西。", "同學甲")
	await novel_interface.show_dialog("看不出來啊，難道是大胃王嗎？", "同學乙")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（嗯？ 以男生的食量來說，這些不是正常的食量嗎？ ）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("嘿嘿，大家一定都很羨慕妳，\\n吃這麼多食物還長不胖～", "安妮")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這哪是什麼值得羨慕的事情。 \\n唔哇！ 蝦餅的味道……果然超棒啊！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("那個，小憐……", "安妮")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("腫麼啦？（嚼）\n這個咖哩飯也吼吼吃啊~（嚼）", "小憐")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("唔已經耐上這學校啦！ （嚼）", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("小憐吃東西的樣子，果然非常豪爽呢！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("哎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("那是新來的轉學生嗎？", "同學甲")
	await novel_interface.show_dialog("行為舉止完全不像女生欸……\\n哇，坐著時腿還張那麼開！", "同學乙")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("……可惡。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("嗚嗚嗚～", "小憐")
	await novel_interface.show_dialog("似乎……吃不下了……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("這才是女孩子正常的食量啦。", "安妮")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我以前可是一次能吃上兩天的份量，\\n然後再慢慢消化的……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("嗤……哈哈哈！ \\n妳是駱駝嗎？ 幹嘛這麼拼命吃啊。", "安妮")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("因為……小時候經常不知道下次有得吃是什麼時候。", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("埃癸斯只能識別和抵擋武器所射出的子彈，但手持武器計程車兵卻能輕易進入防護力場。")
	await novel_interface.show_text_only("所以半徑35公里的力場邊界，成為了當時幾百萬倖存者的最後防線。")
	await novel_interface.show_text_only("戰爭創造了太多孤兒，忙於組織防禦的元老院只能為每間保育學校分配有限的配額。")
	await novel_interface.show_text_only("我和很多小孩為了填飽肚子，經常要到邊界的戰區去尋找食物……")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("……小憐。", "安妮")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("這些我知道，但也不能撐壞自己啊。", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮應該也經歷過那段歷史吧……")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("……放學之後我帶妳去吃甜點吧！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("……嗯！", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("今天難得有空能和小憐逛街呢～", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("之前我都沒來過這種店……\\n（周圍都是女生啊，有點不自在……）", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我看一下選單……啊！我要這個！\\n藍莓冰沙超級碳酸特飲DX！！", "安妮")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("妳不覺得光名字就超帥氣嗎？", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("安妮還真是孩子氣呢～", "小憐")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("我要咖啡就好……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("小憐現在可是女孩子呢。\n那些甜食很美味的啦~不試試看嗎？", "安妮")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("嗯……我看看。 \\n抹茶拿破崙起士鬆餅……（好像還、還不錯嘛）", "小憐")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("皇家香橙蜜餞奶油蛋糕……\\n（這個看起來……也很美味啊）", "小憐")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("熱帶盛宴冰果聖代……\\n（吞口水）", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("這位客人，請問您決定好點什麼了嗎？", "服務員")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("啊，那個！ \\n我還是……要咖啡就好了。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("好的，請稍等。", "服務員")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("嗯……", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("請稍等！還、還是要一份……\n藍莓慕斯草莓冰激凌巴菲吧……", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("我，我只是試試而已喔！ \\n以前看過女同學吃過這種……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("嘿嘿～小憐不用跟我解釋啦～", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("久等了，這是您的甜點。", "服務員")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("這個……我可以吃了嗎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("請用。", "服務員")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("那我開動了！", "小憐")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("……", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("好、好美味……！！", "小憐")
	await novel_interface.show_dialog("新鮮草莓的香氣和甜甜的奶油，再加上微酸的藍莓慕斯……超好吃的～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我現在才發現安妮興致勃勃地看著我陶醉的表情，突然有點不好意思。")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("其實……這些女孩子常去吃的東西是什麼味道\n我一直都想知道呢。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("欸嘿嘿～～\\n小憐果然……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("嗯？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("很可愛呢～", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("妳……妳突然說這個幹嘛……！！", "小憐")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
