# chapter2_ep21.gd - 第二章第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep21_script()

func play_script():
	pass

func chapter2_ep21_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("激戦の末やっと敵のリーダーらしき奴を倒した。\\n他の連中も赤い霧と化して消えていく……")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("ふぅ──\\nんんっ？！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ふと、何枚かの黄ばんだ紙が俺の直ぐ側に、\\nヒラヒラと落ちてきた。\\n紙には謎の文字と図が記載されており、\\nそれが俺の目にちらりと映る。")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("W……A……D……", "小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("……うん？？\\n俺の目がおかしいのか……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目を擦って紙をじっくりと見るが……\\n英語が書かれている。　それだけは分かった。")
	await novel_interface.show_text_only("この文章……\n部分的にアルファベットを認識できるが、\n単語や文章に解釈しようとした途端、")
	await novel_interface.show_text_only("脳裏が混濁して解読が不可能となる。")
	await novel_interface.show_text_only("まるで失読症を罹ったかのように、その書面の\\n一番簡単な単語すら見分けがつかなくなる。")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("そこでじっと見ていないで、助けるほうが\\n先だよ～～っ！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("あっ、ああ、分かったっ！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("俺は謎の紙をとりあえずしまう。\\nするとなぜか呪文のような模様の光がほとばしり\\n……かと思ったらと一瞬で消えた。")
	novel_interface.show_character("ren_battle","solemn")
	await novel_interface.show_dialog("今のは──", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("どうしたの？", "アニー")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("気のせい、だよな？\\n（あの言葉にできない震えは……一体……）", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("腕には痺れたような感覚が残っている。\\n気のせいじゃ済まさないぞ　と、\\n俺に『警告』するかのように……")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("そうだ、君っ、大丈夫！？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("不可解な文章はさておいて、俺は怪我をしている\\n少女に駆け寄った。\\nだが、彼女の表情は依然冷たく、俺とアニーが\\n助けたからといっても、嬉しくはないようだ。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女の外見と装備を見る限り、\\nきっと普通の子供じゃない……")
	await novel_interface.show_text_only("眼帯はともかく、ローブの下には機械の装甲に\\n包まれた両手。")
	await novel_interface.show_text_only("腹部を見れば……\n大人でも泣き叫びそうな傷口の深さなのに、")
	await novel_interface.show_text_only("彼女は泣き言も言わず、\nただ黙ったまま静かにうずくまっている。")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("君、名前は？\\nこんな場所で何をしてたの？", "小憐")
	await novel_interface.show_dialog("さっきの奴らが何者か、知っていたりするかな？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","worry",0.25)
	await novel_interface.show_dialog("そうやって一度に質問しても、この子だって\\nこんな状態じゃ答えられないよ……", "アニー")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("まだ血が溢れ出ているにも関わらず、\\n突然、少女は立ち上がった。\\n意外と背が高いな……")
	await novel_interface.show_text_only("ってままま、待ってッ。待ってッ。\\n彼女の身体が………\\n宙に浮かんでませんかね、これっ？")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……イルカ。\\n任務：削除、ドール。", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("女の子は独特な言い回しで質問に答えた。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_text_only("イルカ……この子の名前か？\\nそれにしても独特な口調だ。")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("目標、補足──\\n人間、女性、数量……", "イルカ")
	await novel_interface.show_dialog("1名。", "イルカ")
	await novel_interface.show_dialog("…………\\n再測定、起動。", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("（女性が「1名」？）\\n（まさか俺の本質を見抜けるのかッ！！！）", "小憐")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("そ、そうだ！！　俺、男の子なんだよッ！！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("魔女、数量、1名。\\n防御モード、起動。", "イルカ")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"smile")
	await novel_interface.show_text_only("あ、あははは──\n女性と、魔女ね……最近、男と呼ばれてた頃が、\n幻想だったのじゃないかと疑い始めてるよ……")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_text_only("この子の手が徐々に明るく光っているような\\n幻覚も、見えるようになってきたし……？\\n──は？　おい、待ってッ！！")
	novel_interface.change_2nd_expression("sob")
	await novel_interface.show_dialog("あばばばばばーーー！\\nイタッ、イタタタタッ！！", "小憐")
	novel_interface.change_2nd_expression("wail")
	await novel_interface.show_dialog("おい！なんでいきなり俺を感電させようと\\nするんだよ！？", "小憐")
	novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("幸い俺の反応が速かったおかげか、\\n雷自体は腕を掠めただけで済んだ。\\n雷は先ほど俺が立っていた場所に直撃し、\\n白点を残す。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("戦闘能力の低下、逃げ足、速い。\\n脅威、無し。", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺、チキンって判定されたみたい……")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("助けた人にまで攻撃する必要あるのか？\\nしかも、なんで俺に対してだけ！？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("魔女、勝てない、無理。", "イルカ")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("正直な子だっ！！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("イルカちゃ～ん、私達こんなに仲良しなんだから\\n絶～対悪い人なんかじゃないよ～～", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","bored",0.25)
	await novel_interface.show_dialog("（小声）アニー、そのセリフは説得力がないし…\\n　　　　あと誘拐犯っぽいぞ…", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("はい…………", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("──それで、イルカちゃん、あなたも魔女なの？", "アニー")
	novel_interface.character_dark()
	await novel_interface.show_text_only("アニーは俺を無視して、単刀直入に聞き始めた。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","speechless",0.25)
	await novel_interface.show_text_only("おいおい、もしも彼女が『魔女』について\\n何も知らなかったら、\\nアニーの情報がばれちゃうじゃん。")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("イルカ、は、『執行人』。", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("『執行人』……中二病的な称号っぽいけど、\\n最近の子の流行りか？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("（しまった、心の声が思わず出てしまった……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("再び雷が落ちてきた。\\n\\n必死で避けた。")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("ちょ、ちょっと待って！！\\n言いたい事があるなら、口で言ってよ！", "小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("えっと……(ガサゴソ）\\n\\nチョコレートをあげるから、\\nそんなに怒らないで……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("俺はポケットにあったチョコレートを取り出し、半分をイルカに渡した。")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_text_only("ふ──、たまたまチョコを持ってて良かった。\\nチョコが嫌いな子供は流石にいないだろう。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("……", "イルカ")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("もぐ、もぐ──\\nほら、俺はもう食べた！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ちょこれーと？", "イルカ")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("危ない物とかじゃないからね……\\n\\nこれはみんなを幸せな気持ちにしてくれる\\n甘～い食べ物だよ！", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("（小声）見知らぬ幼女を餌付けするレンちゃんの　　　　セリフの方が、よっぽど誘拐犯みたい。", "アニー")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("うん……でもチョコを持ち歩いてる点では、\\nますます女の子っぽくなってきたね！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは少し躊躇うも、用心深く銀紙を外し、\\nゆっくりとチョコレートを口に含んだ。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("…………\\n変な、味……", "イルカ")
	await novel_interface.show_dialog("苦い。", "イルカ")
	await novel_interface.show_dialog("甘い……", "イルカ")
	await novel_interface.show_dialog("イルカ、嫌いじゃない。", "イルカ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("へっへ～～気に入った？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("やばい、この子の表情、超可愛いぞ……！")
	novel_interface.show_character("ren_battle","smile")
	await novel_interface.show_dialog("ふへへへ……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("ああっ！　レンちゃんが危ない顔してるっ！！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("表情、識別………変態。", "イルカ")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("へへへ、変態って――！？\\n俺の事かっ！？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("でも、イルカ、嫌いじゃない。", "イルカ")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あ、ええ、き、嫌いじゃなかったらいいや～～", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","frustrate")
	await novel_interface.show_dialog("変態呼ばわりされて嬉しいの？\\nやっぱりレンちゃんって油断ならないね……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("変な解釈をしないでっ！", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("あ、そうだ！ チョコレートがもう1枚\\n残っているから、こっちもあげるよ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("……これ…あげる。", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは身体のどこかから、単三電池みたいな\\n透明な容器を取り出し、俺にくれた。\\n中には緑の蛍光色を発するドロドロした液体が、\\n入っている。")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("これは……液中プラズマ？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("iluka_battle","",0.25)
	await novel_interface.show_dialog("交換です、食べ物。", "イルカ")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("これ、食べ物な感じなの？？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("イルカは真面目に頷いた。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("空腹時、管理人、食べ物をくれる。\\nエネルギー、補充。", "イルカ")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("『管理人』ってのが君の保護者？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("チョコが食べられるなら、\\n身体機能は普通の子供って事だよな？", "小憐")
	await novel_interface.show_dialog("家電製品じゃあるまいし……", "小憐")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("やっぱり……\\nこの女の子、魔法刻印の存在を感じる。", "アニー")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("でも動かす方法が……とても特別……", "アニー")
	await novel_interface.show_dialog("『執行人』……ね？", "アニー")

	print("=== 第二章第21话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
