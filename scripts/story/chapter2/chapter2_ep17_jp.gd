# chapter2_ep17.gd - 第二章第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep17_script()

func play_script():
	pass

func chapter2_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	await novel_interface.show_text_only("さすが超～～有名（で金持ち）の学校ッ！\\n食堂のメニューは涙が出るほど盛りだくさんだ！")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("すみません、カレーライスセットを一つと、手羽先の唐揚げを三つお願いします。", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("う～ん　エビ餅も美味しそう。\\n追加で2つエビ餅も！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("お、お嬢ちゃん。1人で全部食べきれるのかい？", "食堂スタッフ")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("もちろん、全然大丈夫ですよ～。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ねえねえ見てよ、あそこの女の子……\\n1人であんなに食べるって……", "クラスメイトA")
	await novel_interface.show_dialog("そんな風には全く見えないけど、\\nものすごい大食いなのかしら？", "クラスメイトB")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（………俺はいつもこれぐらい食べるけど、\\n　このぐらいって普通の範囲じゃないの？）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("あはは、みんなレンちゃんを羨ましがってるのよ\\nきっと。\\nそんなに食べても太らないのかな～～ってね。", "アニー")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そんなに羨ましがられる事か？\\nうわっ！　このエビ餅……やっぱ最高っ！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("あのね、レンちゃん………", "アニー")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("どうした？（もぐもぐ）\\nこのカレーもすごく美味しいよ～（もぐもぐ）", "小憐")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("うん、これなら、パクッ\\nこの学校に通うのも、ンク、ンク\\n……プハァッ、悪くないねっ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("レンちゃんの食べっぷりは、やっぱ豪快ね！", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("え？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("新しく入った転校生って……あの子？", "クラスメイトA")
	await novel_interface.show_dialog("何と言うか、\\n振る舞いが女の子っぽくないわね……\\nわわっ、脚を開いて座ってるわ！", "クラスメイトB")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("……くそぉ。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ううう～～", "小憐")
	await novel_interface.show_dialog("なぜかもう……食べられない……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("それでこそ、女の子の普通の範囲だよ。", "アニー")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("昔は1食で2日分の量を食べる事ができたのに。\\n\\nそれを2日かけてゆっくり消化したりして……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("あっははは！\\nレンちゃんラクダじゃないんだから！\\nなんでそんなに必死に食べてたの？", "アニー")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("だって……小さい頃にお腹一杯食べられるのは、今度、いつになるか……分からなかったから。", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("イージスは武器から射出された弾であれば\\n識別して遮蔽できるが、\\n武器を手に持っている兵士は、\\n簡単に防御フィールド内に入れてしまう。")
	await novel_interface.show_text_only("だから半径35㎞のフィールドの境界線は、当時\\n数百万いた生存者の最終防衛ラインだった。")
	await novel_interface.show_text_only("戦争はたくさんの孤児を作り出した。だけど\\n自衛の手配だけで手一杯だった元老院は、\\n保育学校の限られた配給を、\\nさらに制限してしまったんだ。")
	await novel_interface.show_text_only("俺を含めて、多くの子供達はお腹を満たすため、\\nいつも境界の戦闘地域にすら、\\n食べ物を探しに行かなければならなかった。")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("レンちゃん……", "アニー")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("分かったわ……\\nでも食べ過ぎて自分を壊すような事はしないでね", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("時間を飛び越えたとは言え、アニーもそんな\\n歴史を少なからず体験したのかもしれない……")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("ねぇ、放課後、スイーツでも食べにいかない？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("……うん！", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("せっかく今日は暇なんだし、レンちゃんと\\nぶらぶら歩くのもいいね～～", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("今までこんな店、来た事なかったけど………\\n（周りが全員女の子で、なんだか窮屈……）", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("メニューを見てみて……私はこれに決定！\\n\\nブルーベリーシャーベットスーパー炭酸\\n特製ドリンクDXッ！！", "アニー")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("名前がすでにカッコいいっ。", "アニー")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("アニーは本当、子供っぽいなぁ～～", "小憐")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("俺はコーヒーでいいよ……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("せっかく女の子になったんだし、スイーツも試してみたら？\\nすごく美味しいよ～", "アニー")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("え、あ、う……えっと\\n抹茶ナポレオンチーズワッフル……\\n（ま、まあまあ悪くないね）", "小憐")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("ロイヤルシロップ漬けオレンジクリームケーキ…\\n\\n（見た目は……美味しそうだけど）", "小憐")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("トロピカルゴージャスフルーツサンデー……\\n\\n（じゅるり）", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("お客様、ご注文はお決まりでしょうか？", "ウェイター")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("あ、あの！\\n……やっぱり俺はコーヒーでいいです。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("かしこまりました。少々お待ちください。", "ウェイター")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("はい…………", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("あっ、待って！　やっぱり一つ……\\nブルーベリームースいちごアイスパフェをお願いします……", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("お、俺はただ試してみるだけだからっ！　\\n\\n前にクラスメートの女の子が食べてるのを、\\n見た事があって……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("ふっふ～～説明しなくてもいいよっ。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("お待たせしました。\\nこちらがご注文の品でございます。", "ウェイター")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("あの……これ、もう食べてもいいですか？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("──？　どうぞ、お召し上がりください。", "ウェイター")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("じゃあ、いただきますっ！", "小憐")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("……", "小憐")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("お、おいしい……！！", "小憐")
	await novel_interface.show_dialog("新鮮な苺の香りと甘いクリーム、\\nちょっと酸っぱいブルーベリームースと……\\n本当、すごく、美味い……っ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("気付いたら、夢中になっている俺の表情を\\nアニーが興味津々と見ていた。\\n──ちょっと、恥ずかしい。")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("こういう女の子向けの甘いものが、どんな味なのか……\\nずっと気になってたんだ。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("あ、あああ……\\nレンちゃんってやっぱり……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("……うん？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("可愛いね～～", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("な、何を言うんだ、いきなり……っ！！", "小憐")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
