# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Aber ich möchte mich wieder in einen Jungen verwandeln...\nWas soll ich tun...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Nun... warum nicht einfach so ein Mädchen bleiben?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wha—??\nNo! Absolut nicht!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Wie Sie sagten, vielleicht wurde das Schicksal dieser Stadt durch die Zerstörung abgelenkt, und dadurch kamen zig Millionen Leben zurück...", "Mariru")
	await novel_interface.show_dialog("Ein Wunder dieser Größenordnung muss doch seinen Preis haben, finden Sie nicht auch?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Und was wäre, wenn dieser Preis... nur darauf zurückzuführen wäre, dass Sie so enden?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Wie konnte das sein...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Außerdem...\nDu bist schon fünfzehn, oder?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ein Mädchen in deinem Alter\nsollte zumindest einen BH tragen..., oder?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("Hä?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du bist immer noch am Wachsen, weißt du? Von hier an könnten sie immer größer werden...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Waaaat?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn du keins trägst, wird es Probleme geben.\nZum Beispiel, wenn du rennst...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Y-Du meinst nicht einen BH...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genau. Ich denke, ein süßer, mädchenhafter Stil würde dir gut stehen, nicht wahr?\nDu hast die Art von Gesicht, die bezaubernd aussieht~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Absolut nicht!!\nIch-ich bin ein Junge!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Und übrigens, die Art, wie du gerade sitzt...\nDas ist überraschend mutig von dir~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("I-I-I-I...\nIch gehe auf die Toilette!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh je—\nDieses Kind ist wirklich viel zu leicht zu necken~", "Mariru")
	await novel_interface.show_dialog("Sieht so aus, als würde mir von nun an keine Langeweile mehr aufkommen~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Ich starrte mich im Spiegel an. Als ich an dieses Gespräch zurückdachte, rutschte ich langsam die Wand hinunter und ging dort in die Hocke.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Ich kann es immer noch nicht glauben...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("So etwas in der Art... Ich möchte es auf keinen Fall tragen!!", "Lian")
	await novel_interface.show_dialog("Als Mann...\nEs fühlt sich an, als würde mir etwas Wichtiges immer weiter entgleiten!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Und wenn mich jemand an einem Ort sehen würde, an dem so etwas verkauft wird...\nNein, nein! Absolut nicht!", "Lian")
	await novel_interface.show_dialog("(Wenn ich das tatsächlich tun würde...)\n(Dann wäre ich wirklich... ein Perverser!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Ich möchte kein Perverser sein!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ach? Du hockst hier immer noch und weinst?\nIch habe anhand deiner Oberweite bereits die richtige Größe herausgesucht.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hä?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Ich habe sie in deinem Zimmer gelassen. Betrachten Sie sie als ein Geschenk von mir~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nein danke!\nIch verwende stattdessen einfach Bandagen!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Dieses Kind... bist du unschuldig oder nur pervers?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Allerdings könnte die Verwendung von Klebeverbänden... noch interessanter sein.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Oder genießen Sie zufällig den kleinen Schmerzstoß, wenn Sie sie abreißen?", "Mariru")
	await novel_interface.show_dialog("Schade. Alles, was wir hier haben, sind Sprühverbände", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Du machst das mit Absicht, nicht wahr!!\nUgh... Verdammt!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Tch, gut, ich werde es tragen~!\nWenn ich ein richtiger Mann bin, warum sollte ich mich dann schämen!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Hm? Warte?\nDas... ist wirklich schwer...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Mm-hm.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*klick*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Da habe ich es für dich befestigt~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nH-Wie bist du hier reingekommen?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ich habe dir nur freundlicherweise geholfen~\nKönnen Sie übrigens alleine mit den Kniestrümpfen der Uniform umgehen?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä?! Es sind nur Socken, was ist daran so schwer!\nIch mache es selbst!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Und der Rock?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mit dem Rock komme ich auch zurecht... Ich ziehe ihn mir selbst an...\nMariru, raus schon!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Wow~ Du weißt also tatsächlich, wie man einen Rock anzieht. Das ist beeindruckend.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bei einem Rock muss man nicht hinter den Rücken greifen, um etwas zu befestigen. Was ist also daran so schwer?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, dann alles klar~\nIch komme gleich noch einmal vorbei und schaue, wie du aussiehst, wenn du angezogen bist.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Verdammt,... Mariru unterschätzt mich ernsthaft!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Einige Zeit später...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! Ich bin angezogen!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Bist du sicher?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Worüber sollten Sie sich nicht im Klaren sein? Ich habe es ganz gut aufgetragen, nicht wahr?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Also... Wo genau ist dein Reißverschluss?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vorne! Erleichtert den Toilettengang!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... und womit gehst du jetzt genau auf die Toilette?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Äh...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Th-Das hat mit nichts zu tun! Wie auch immer...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft...Der Reißverschluss geht an der Seite.\nSchauen Sie sich mal im Spiegel an~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("Die Seite, dann die Seite...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Warum ist Mädchenkleidung so schwer anzuziehen!!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
