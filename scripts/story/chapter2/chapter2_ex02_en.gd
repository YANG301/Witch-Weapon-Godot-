# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("I look at myself in the mirror at the corner of the hall. \\nMy tearful eyelash moves up and down as I breathe.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Indeed… I'm a girl now?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Down there... It's gone...)", "Lian")
	await novel_interface.show_dialog("(In this case...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(How... how would I take a leak...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Fishing around...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("What are you doing?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Waaaah!!", "Lian")
	await novel_interface.show_dialog("It's not... Uhm... \\nSorry!! I didn't mean to...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Haha. Sorry for what? \\nFor touching yourself?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(What... what can I do?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Uhm...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("How do girls... how do they…", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What? What do you want from me? Please be specific.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("How do they use the bathroom?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh?!", "Mariru")
	await novel_interface.show_dialog("Hahaha…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Finally, I say it out loud! Don't make fun of me again...)", "Lian")
	await novel_interface.show_dialog("(But it seems I can't hold it any more...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Hey… don't laugh at me!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Just sit down and do the job. Simple as that.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("The girls' bathroom is just down the hall. Move!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pfff. He hesitated for a moment... \\nAnd eventually rushed in with tears.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("So... cute!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (water flushing)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ahh. Finally get relaxed.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Wait... How...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("How do I shake it off?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Done? How do you feel about it?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("It’s a private matter!!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(No wonder I heard that girls' bathroom often runs out of toilet paper...)", "Lian")
	await novel_interface.show_dialog("Waaaah... \\nSo embarrassing...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Damn it!! \\nI must go back to the old me! Can’t wait!", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
