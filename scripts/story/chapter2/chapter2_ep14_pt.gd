# chapter2_ep14.gd - 第二章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep14_script()

func play_script():
	pass

func chapter2_ep14_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mas eu quero voltar a ser um menino...\nO que devo fazer...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Bem... por que não continuar sendo uma garota assim?~", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O que—??\nNão! Absolutamente não!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Como você disse, talvez o destino desta cidade tenha sido distorcido pela destruição, e dezenas de milhões de vidas retornaram por causa disso...", "Mariru")
	await novel_interface.show_dialog("Um milagre nessa escala certamente terá algum preço, não acha?", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("E se esse preço... fosse simplesmente você acabando assim?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Como isso poderia ser...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Além disso...\nVocê já tem quinze anos, certo?", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Uma garota da sua idade\ndeveria pelo menos usar sutiã... certo?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy_left",0.25)
	await novel_interface.show_dialog("Hein?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você ainda está crescendo, você sabe. Eles podem continuar crescendo daqui em diante...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("O quê?!", "Lian")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se você não usar um, isso causará problemas.\nPor exemplo, quando você estiver correndo...", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("V-Você não quer dizer sutiã...?!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exatamente. Eu acho que um estilo fofo e feminino combinaria bem com você, não é?\nVocê tem o tipo de rosto que parece adorável~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Absolutamente não!!\nE-eu sou um menino!!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E a propósito, do jeito que você está sentado agora...\nIsso é surpreendentemente ousado da sua parte ~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"blush")
	await novel_interface.show_dialog("Eu-eu-eu-eu...\nVou ao banheiro!!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh querido—\nEsse garoto é realmente muito fácil de provocar~", "Mariru")
	await novel_interface.show_dialog("Parece que não vou ficar entediado de agora em diante~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	await novel_interface.show_text_only("Eu me olhei no espelho. Pensando naquela conversa, deslizei lentamente pela parede e me agachei ali.")
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Ainda não consigo acreditar...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Algo assim... Eu absolutamente não quero usar isso!!", "Lian")
	await novel_interface.show_dialog("Como homem...\nParece que algo importante está se afastando cada vez mais de mim!", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("E se alguém me visse em um lugar que vende esse tipo de coisa...\nNão, não! Absolutamente não!", "Lian")
	await novel_interface.show_dialog("(Se eu realmente fizesse isso...)\n(Então eu seria realmente... um pervertido!!!)", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Eu não quero ser um pervertido!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ah? Você ainda está agachado aqui chorando?\nJá escolhi o tamanho certo com base no seu busto.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hein?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("Deixei-os no seu quarto. Pense neles como um presente meu ~", "Mariru")
	novel_interface.character_light(0.35,"sob")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não, obrigado!\nVou usar apenas bandagens!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Essa criança... você é inocente ou apenas pervertido?~", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Embora usar bandagens adesivas possa ser... ainda mais interessante.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ou acontece que você gosta daquela pequena pontada de dor ao arrancá-los?", "Mariru")
	await novel_interface.show_dialog("Que pena. Tudo o que temos aqui são bandagens em spray ~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Você está fazendo isso de propósito, não é!!\nUgh... droga!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Chaostic Daily.mp3")
	novel_interface.show_character("ren_nude","indignation")
	await novel_interface.show_dialog("Tch, tudo bem, vou usá-lo~!\nSe eu sou um homem de verdade, o que há para ficar envergonhado!!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	novel_interface.character_light(0.35,"shock")
	await novel_interface.show_dialog("... Hum? Espere?\nIsso... é muito difícil...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("... Hum-hum.", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("*clique*")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Pronto, eu prendi para você ~", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mariru?!\nH-Como você entrou aqui?!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Eu estava gentilmente ajudando você ~\nA propósito, você consegue cuidar das meias até o joelho do uniforme sozinho?", "Mariru")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein?! São apenas meias, o que há de tão difícil nisso!\nEu mesmo faço isso!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("E a saia?", "Mariru")
	novel_interface.character_light(0.35,"shock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu aguento a saia também... Eu mesmo coloco ela...\nMariru, saia já!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Uau ~ Então você realmente sabe como colocar uma saia. Isso é impressionante.", "Mariru")
	novel_interface.character_light(0.35,"shame")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uma saia não exige que você alcance as costas para prender nada, então o que há de difícil nisso?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft, tudo bem então~\nVoltarei daqui a pouco e verei como você fica quando estiver vestido.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"indignation")
	await novel_interface.show_dialog("Droga,... Mariru está me subestimando seriamente!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Algum tempo depois...")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Mariru! Estou vestido!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","shock",0.25)
	await novel_interface.show_dialog("Você tem certeza?", "Mariru")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O que há para não ter certeza! Coloquei direitinho, não foi?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Então... onde exatamente está o seu zíper?", "Mariru")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Na frente! Facilita quando você precisa usar o banheiro!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Mm... e o que exatamente você usa para ir ao banheiro agora?", "Mariru")
	novel_interface.character_light(0.35,"wail")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh...", "Lian")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("I-Isso não tem nada a ver com nada! Enfim...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pfft... O zíper fica na lateral.\nVá dar uma olhada no espelho~", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_dialog("O lado, depois o lado...\n......", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Por que as roupas das meninas são tão difíceis de vestir!!", "Lian")

	print("=== 第二章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
