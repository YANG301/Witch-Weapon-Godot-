# chapter2_ep23.gd - 第二章第23话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep23_script()

func play_script():
	pass

func chapter2_ep23_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	await novel_interface.show_text_only("Elluka greift Annie und mich mit Blitzmagie an. Da wir sie nicht verletzen wollen, können wir uns nur verzweifelt verteidigen.")
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("Wenn das so weitergeht, werden wir alle Schaden erleiden...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Hah... Ahh... \\nElluka, hör auf! Beruhige dich!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Ziel erfasst. Fortsetzung des Angriffs –", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein flammender Schlag schnitt durch die Luft, gefolgt von einem lauten Grollen. \\nIch öffne meine Augen, nur um festzustellen, dass ich unverletzt bin.")
	await novel_interface.show_text_only("Hinter dem Administrator kippt der Hauptrotor des Flugzeugs langsam um und fällt dann wie ein abgebrochener Zweig herunter.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("!?", "Administrator")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ähem... alle erstarren——!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	await novel_interface.show_text_only("Marirus Stimme ertönt aus einem Lautsprecher in der Ferne.")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Fräulein Mariru!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Über ihnen tauchen drei Hubschrauber auf, und ihre blendenden Suchscheinwerfer tauchen den Boden in Weiß, als wäre es heller Tag.")
	await novel_interface.show_text_only("Mariru sitzt im mittleren Hubschrauber und ruft durch einen Lautsprecher. Die riesige Waffe, die vor ihr montiert ist, raucht immer noch.")
	await novel_interface.show_dialog("Das kleine Spielzeug von Ai hat es wirklich in sich. Tatsächlich wurde die Rotorwelle mit einem einzigen Schuss herausgerissen.", "Mariru")
	await novel_interface.show_text_only("Mariru klingt ein bisschen zu aufgeregt, als würde sie gerne noch eine Runde abfeuern... Hey, das Ding zählt schon als Kanone, nicht wahr?!")
	await novel_interface.show_text_only("Das Cockpit des abgestürzten Transporters öffnet sich von innen, und zwei Piloten stürzen in Panik heraus und kämpfen um ihr Leben.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hah... Haha...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein Hubschrauber landet auf dem freien Gelände vor dem Umspannwerk. Begleitet von einer Menge schwer bewaffneter Soldaten schreitet Mariru in bester Stimmung auf uns zu.")
	await novel_interface.show_text_only("Nachdem er Marirus Gesicht deutlich gesehen hatte, spuckte er wild auf den Boden.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmpf. Ein weiterer SID Schoßhündchen.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Dies ist kein SID-Vorgang. Ich bin hier als Berater von New Opulentias Metropolitan Defense Bureau und führe eine Sicherheitsmission zur Unterdrückung von Unruhen durch.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Erst dann wird mir klar, dass die Leute, die aus den Hubschraubern gestiegen sind, überhaupt keine Agenten sind. Jeder von ihnen trägt eine Armbinde mit der Aufschrift „MD“.")
	novel_interface.show_character("liliu_uniform1","jest")
	await novel_interface.show_dialog("Ist das nicht richtig?... Kapitän Nantetsu?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Das ist richtig. Die Metropolitan Defense Bureau vermutet, dass hier ein Terroranschlag gegen New Opulentia im Gange ist.", "Nantetsu")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Hiermit befehle ich Ihnen und Ihren Männern, die Feindseligkeiten sofort einzustellen und mit uns zum Verhör zurückzukehren.", "Nantetsu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Dieser wrestlerartige Muskelprotz da drüben... Ich schwöre, ich habe ihn schon einmal gesehen... Ist er einer von [[[1007]]s Bekannten?", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Diese beiden süßen Mädchen sind deine Untergebenen? Eine Abteilung ohne Altersbeschränkung klingt ganz nett...", "Nantetsu")
	await novel_interface.show_dialog("Hmm... dieser Kleine...", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hey, bist du sicher, dass du das machen willst?", "Administrator")
	await novel_interface.show_dialog("Dies ist eine entmilitarisierte Zone im Sinne des Abkommens. Keine Ihrer Organisationen hat die Befugnis, hier tätig zu werden.", "Administrator")
	await novel_interface.show_dialog("Und so schnell hätten Sie auf keinen Fall die Erlaubnis des Vereinigten Kongresses erhalten können!", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Diese multinationalen Bürokratien bewegen sich im Schneckentempo.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmpf... Tut mir leid, dich zu enttäuschen, aber ich werde meine Leute mitnehmen und jetzt gehen.", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Mm~ ich bin noch nicht fertig mit Reden... Johnson Heavy Industries hingegen arbeitet viel schneller.", "Mariru")
	await novel_interface.show_dialog("Schließlich studiert ihr ältester Sohn noch in New Opulentia~ Im Moment sind sie diejenigen, die mich um einen Gefallen bitten...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Was?!", "Administrator")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Derzeit sind bereits drei Prozent der Last dieses Umspannwerks in das Stadtnetz von New Opulentia eingespeist—", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Gemäß dem Salmonton-Abkommen gilt jeder Angriff auf das Stromnetz von New Opulentia als Terroranschlag erster Klasse.", "Mariru")
	await novel_interface.show_dialog("Für Vorfälle wie diesen verfügt die Metropolitan Defense Bureau über die höchste vom Vereinigten Kongress anerkannte operative Autorität.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Schließlich kann unser Aegis Gastgeber… \\nohne Strom nicht arbeiten.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Wie konntest du Aegis vom Stromnetz der Stadt abhängen?! Schluss mit den Tricks!", "Administrator")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","speak",0.25)
	await novel_interface.show_dialog("Genug geredet. Nimm sie weg!", "Nantetsu")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Warte! Masada Fort und New Opulentia haben vor langer Zeit ein Abkommen über diplomatische Immunität unterzeichnet, nicht wahr?", "Administrator")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Der Administrator holt seinen Ausweis aus der Manteltasche und zeigt ihn selbstgefällig auf Mariru und Nantetsu.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ich bin Jacob Schmidt, Militärattaché der Third Academy City, Masada Fort, beim Vereinigten Kongress.", "Administrator")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn Sie mich hier verhaften, wird das vermutlich ziemlich unnötigen diplomatischen Ärger verursachen, nicht wahr?", "Jacob")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"angry")
	await novel_interface.show_dialog("… \\nSehr gut. Du hast eine Minute Zeit, um mir aus den Augen zu verschwinden.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Aber es scheint, dass Ihr Fahrzeug ein paar Pannen hat ... \\nDaher müssen Sie möglicherweise selbst nach Hause gehen.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","shout")
	await novel_interface.show_dialog("Was?! Das ist nicht fair!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Regeln sind Regeln. Heißblütiger Impuls wird nichts lösen.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Aber…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Elluka, wir gehen.", "Jacob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","speak",0.25)
	await novel_interface.show_dialog("Warten Sie, Ihre Identität wurde überprüft, was in Ordnung ist. Aber dieses kleine Mädchen ... Ich glaube nicht, dass sie irgendeinen Posten in Ihrem Außenministerium antritt.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Du!!", "Jacob")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Es tut mir leid, aber sie ist eine Hauptverdächtige des heutigen Terroranschlags.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Wenn Sie versuchen, sie mit Gewalt zu entführen, kann ich Ihrer Botschaft nur mit Bedauern mitteilen, dass Sie bei einem Terroranschlag erschossen wurden.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru zieht eine Pistole heraus und hält sie an Jacobs Kopf.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Hmpf... Sie ist nichts weiter als ein Werkzeug.\\nWenn du sie so sehr willst, dann behalte sie!", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("Leistungsstufe, kritisch… \\nHah… Aktivität beendet…", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka, die sich die ganze Zeit gezwungen hatte, weiterzumachen, bricht plötzlich zu Boden wie eine Maschine, die ihre Kraft verloren hat.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Tch. In diesem Zustand ist sie wahrscheinlich sowieso nutzlos. Kümmern Sie sich selbst um den wertlosen Schrott!", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob zieht seinen Kragen hoch und beschleunigt seinen Schritt, ohne einen einzigen Blick zurück zu werfen. Bald verschwindet er in der Dunkelheit.")
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("Elluka, wach auf! Elluka!", "Lian")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Mariru, hilf ihr bitte!…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Sie taucht immer noch auf dem Lebensdetektor auf. Sie ist wahrscheinlich einfach nur erschöpft.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Und Sie – jemand, der sich immer noch schützen muss – schreien hier draußen nach der Rettung anderer Menschen?", "Mariru")
	await novel_interface.show_dialog("...Du entwickelst dich immer mehr zu einem heißblütigen Idioten.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Lass uns nach Hause gehen.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nantetsu","serious",0.25)
	await novel_interface.show_dialog("Dieses Mädchen ist unsere Feindin, nicht wahr?", "Nantetsu")
	await novel_interface.show_dialog("Verlangt das Senat nicht, dass alle erstklassigen Terroristen sofort festgenommen werden und dann...", "Nantetsu")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sorgen Sie dafür, dass die Anti-Scan-Module jedes Hubschraubers kontinuierlich laufen. Ich werde uns von den vier UAVs von SID im automatischen Gegenangriffsmodus eskortieren lassen.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Meine Leute – ich werde sie persönlich begleiten. Jeder, der einen Todeswunsch hat, ist herzlich willkommen, mich auszuprobieren!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Hahaha... Das ist das Mariru, das ich kenne.", "Nantetsu")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_helicopterBackto.png")
	await novel_interface.show_text_only("Mariru lässt das medizinische Team unsere Wunden behandeln und nimmt dann Annie, Elluka und mich an Bord des Hubschraubers.")
	await novel_interface.show_text_only("Annie ist so müde. Sie lehnt sich an meine Schulter und schläft bald ein.")
	await novel_interface.show_text_only("Elluka schläft auch, liegt ausgestreckt auf meinem Schoß und hat etwas Sabber im Mundwinkel. Von dem eisigen Blick, den sie noch vor wenigen Minuten hatte, ist nichts mehr übrig.")
	await novel_interface.show_text_only("Schließlich ist sie nur ein gewöhnliches kleines Mädchen... und aus irgendeinem Grund erfüllt mich das mit Erleichterung.")
	await novel_interface.show_text_only("Es wird alles gut. Alles wird gut werden, genau wie dieses Lied sagt:\\nAlles wird gut.")
	await novel_interface.show_text_only("Auch wenn zwischen den sechs Akademiestädten inzwischen Frieden herrscht, werden weite Gebiete, die außerhalb ihrer Kontrolle liegen, immer noch vom Krieg verwüstet.")
	await novel_interface.show_text_only("Ich frage mich, wie viele Kinder wie Elluka immer noch als Waffen oder Werkzeuge benutzt werden...")
	await novel_interface.show_text_only("Mariru hatte recht. Ich bin ein Idiot, der immer mehr abbeißt, als ich kauen kann.")
	await novel_interface.show_text_only("Aber ich habe kaum jemanden getroffen, der bereit war, seine Wachsamkeit aufzugeben und friedlich neben mir einzuschlafen. Jetzt sind es zwei.")
	await novel_interface.show_text_only("… Ich mag es, ein Idiot zu sein.")

	print("=== 第二章第23话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
