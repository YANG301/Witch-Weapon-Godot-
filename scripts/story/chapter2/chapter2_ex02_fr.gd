# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("Je me regarde dans le miroir au coin du couloir. \\nMes cils en larmes montent et descendent lorsque je respire.")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("En effet… je suis une fille maintenant ?", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("(Là-bas... C'est parti...)", "Lian")
	await novel_interface.show_dialog("(Dans ce cas...)", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Comment... comment pourrais-je fuir...)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Pêche autour de ...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Que fais-tu ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Waaaah !!", "Lian")
	await novel_interface.show_dialog("Ce n'est pas... Uhm... \\nDésolé !! Je ne voulais pas...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Haha. Désolé pour quoi ? \\nPour vous toucher ?", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("(Que... que puis-je faire ?)", "Lian")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("Mariru... Euh...", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Comment font les filles... comment font-elles…", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ? Que voulez-vous de moi? Veuillez être précis.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Comment utilisent-ils la salle de bain ?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ?!", "Mariru")
	await novel_interface.show_dialog("Hahaha…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Enfin, je le dis à voix haute ! Ne te moque plus de moi...)", "Lian")
	await novel_interface.show_dialog("(Mais il semble que je n'en puisse plus...)", "Lian")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("Hé… ne te moque pas de moi !", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Asseyez-vous et faites le travail. Aussi simple que ça.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Les toilettes des filles sont juste au bout du couloir. Se déplacer!", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("Pfff. Il hésita un instant... \\nEt finit par se précipiter en larmes.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Tellement... mignon !", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("... \\nSloosh (rinçage à l'eau)")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("Ahh. Détendez-vous enfin.", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Attendez... Comment...", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("Comment puis-je m'en débarrasser ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Terminé ? Qu’en pensez-vous ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("C'est une affaire privée !!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Pas étonnant que j'ai entendu dire que les toilettes des filles manquent souvent de papier toilette...)", "Lian")
	await novel_interface.show_dialog("Waaaah... \\nTellement embarrassant...", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Bon sang !! \\nJe dois retourner à mon ancien moi ! J'ai hâte !", "Lian")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
