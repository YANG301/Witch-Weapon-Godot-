# chapter2_ep22.gd - 第二章第22话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep22_script()

func play_script():
	pass

func chapter2_ep22_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_City_powerSubstation.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("そうだ！レンちゃんがさっき拾った紙はどこに？", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","gratified",0.25)
	await novel_interface.show_dialog("あっ……\\nちょうどこれの話をしようと思っていたんだ。", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("さっきの戦いで拾った紙をアニーに渡すと、\\n隣に居るイルカは何か言いたげにしている。")
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("Wardenclyffe Manuscript……すごいっ！\\nこんなモノが見つかるなんてっ！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","worry",0.25)
	await novel_interface.show_dialog("ヤツらが落としていったんだ。なんか変な感じの\\n文章なんだけど………アニーは読めるの？", "小憐")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うん──ぼんやりしているけど、\\n魔力の流れを確かに感じるわ。", "アニー")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("これは多分『魔導書』──\\n……いや、魔導書の破れたページね。", "アニー")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("魔導書……これって魔女と関係あるのか？", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("これは魔法の情報を記録した文書なの。\\n私が以前に出会った謎の小冊子も、\\nそのうちの1つだったのよ。", "アニー")
	await novel_interface.show_dialog("名前は確か…《神秘弾道学》\\n私のロッカーの中になぜか入っていて。", "アニー")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("最初はコーチが入れてくれた物だと思ったけど、\\n中身は不思議な事ばかり書いてあってね、\\n例えば、弾道を変える魔法とか。", "アニー")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("後になってコーチに尋ねたら、\\nそんな本など知らんって言うんだもん。\\nその時は不気味だったし、内容も世迷い事だらけ\\nだったから使おうとも思わなかったの。", "アニー")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("そう……\\n\\nあの時……まではね。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーはこれ以上思い出したくないようで、\\n俯いて手にあるページを見つめている。")
	novel_interface.show_character("ren_battle","normal2")
	await novel_interface.show_dialog("マリルが以前、言っていた話がある。\\n\\n『魔女』は何らかの情報に感染して、『異質物』\\nのような特性を手に入れた人間だって。", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("感染か……言い得て妙ね。\\nただ「情報」と言っても、この「情報」は\\n一度でも染まってしまったら、もう二度と\\n忘れられない。", "アニー")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("中毒性のあるCMソングやMADムービー\\nみたいな感じか？\\n忘れたくても忘れられないし、ふと気を抜けば\\n思わず口ずさんじゃっているような～？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("ははは～～レンちゃんのその例えも、\\nピッタリな表現で良い感じっ！", "アニー")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("けど、この数枚の紙切れが、時空波動を\\n引き起こした事になるのかな？\\nたかが紙切れ数枚で…そんな事が可能なの……？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("可能性はあると思うよ。こう言った「情報」は、\\n人の精神を大きく消耗するの。\\n私でさえ、その巨大な負担をはっきりと\\n感じるから。", "アニー")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("だから、何らかの「物」を通して魔法を開放し、\\n「物」に代償を引き受けてもらうの。", "アニー")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("アニーは自分のバットを指さした。\n\nこの魔力を消耗する兵器は、\nそんな風に生まれたのか……")
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("もしも自分の限界を超えて過度の情報を\\n受け取ってしまった場合、\\n理性が砕け散って発狂してしまう可能性も\\nあるの……", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("狂気、ドール……\\n消滅、必要。", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","gratified")
	await novel_interface.show_dialog("ドール……そういう不幸な人なのか？\\nアニーは色々な事を知ってるな。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("えっ？ そんな事は別に……\\n自分の経験をもとに推測しただけだし。", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("手稿……", "イルカ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("イルカは何か、この紙に考えがある様子で、\\n羨望のまなざしをこちらに向けている。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_battle","smile",0.25)
	await novel_interface.show_dialog("うん？　どうしたの？　イルカも見たいのか？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……うん。", "イルカ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("イルカの目は真ん丸。\\n喉の乾いた小動物が水をおねだりするかのような\\nそんなまなざしで俺を見つめてくる。")
	await novel_interface.show_text_only("このキュートなまなざしに抗うのは難しいが……\\nでも、こんな危険なモノ……")
	await novel_interface.show_text_only("俺が迷ってる最中、付近から輸送機の降下音が\\n聞こえてきた。")
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("誰か来た！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("SIDの捜査員か？\\nよかった、俺達は1人の女の子を……\\n…えっ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の予想に反し、輸送機から降りてきたのは\\nSIDの捜査員ではなかった。")
	await novel_interface.show_text_only("こちらに近寄ってきたメガネを掛けた男が、\\n慈しむような表情でイルカを見ている。\\nだがその表情に反し、イルカの顔は\\nあからさまな恐怖に染まっていた。")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("イルカ……今回は遅かったですね。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("管理人……ごめんなさい。", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("手稿はもう手に入れましたか？\\n自分で消化するのはダメと言ったでしょう？\\n早くコチラに渡しなさい。", "管理人")
	await novel_interface.show_dialog("このような事すらできないようでは、すぐに\\n『ゴミクズ』として取り扱われてしまいますよ？", "管理人")
	await novel_interface.show_dialog("ここの始末が済み次第、すぐにオリガへ向かって\\n新たな任務に就いてもらいます。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("なっ、なんだその言い方はッ！！\\nこの子の怪我が見えないのかッ！？", "小憐")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("この子はお前の道具なんかじゃないぞ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("男はイルカ以外を見向きもしていなかったが、\n俺の言葉を聞いた途端、\n獲物に狙いを定めるかのように俺を見つめ、\nこの場に似つかわしくない笑顔を浮かべた。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("──イルカ、\\nこいつも連れて行きなさい。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","serious")
	await novel_interface.show_dialog("えっ！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("そ、そんな事はさせないよ！レンちゃんを\\n連れ去るなんて、私がいる限り許さないッ！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("連れて……\\n行く……？", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("そうです……これも命令です。", "管理人")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("命令……", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカの動きには迷いがあった。\\n何かに抵抗して、苦しんでいる。\\nしかし最後には管理人の命令には逆らえない。")
	novel_interface.show_character("iluka_battle")
	await novel_interface.show_dialog("任務：目標……連れてく……\\n目標、捕捉──", "イルカ")

	print("=== 第二章第22话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
