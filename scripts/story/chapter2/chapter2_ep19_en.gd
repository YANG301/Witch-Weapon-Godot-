# chapter2_ep19.gd - 第二章第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep19_script()

func play_script():
	pass

func chapter2_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("According to the training statistics, Lian's physical fitness is no different from the average teenage girls.", "Ai")
	await novel_interface.show_dialog("Except for eye-hand coordination. It might have something to do with the platinum trophies in her game accounts…", "Ai")
	await novel_interface.show_dialog("Annie performs better when training alone. Almost as good as professional athletes of her age.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("But what I detected the second time they disappeared in a flux area is totally different.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Huh? Anything Interesting?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("People may not be able to feel it, but…", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("The Boltzmann Probe on the tracking drone spiked off the charts a couple of times. It was already broken when salvaged.", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Impossible. If the probe was working well… then those in the flux area… \\nI would say almost the whole area would have been vaporized.", "Mariru")
	await novel_interface.show_dialog("I would say almost the whole area would have been vaporized.", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("And were you out of your mind to attach such an expensive device on the drone?", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru rolls up the document, and knocks on Ai's head\\nAi lets out a quick groan.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Well… I'm not talking about thermal energy. Abrupt increases of information entropy can also lead to the same results.", "Ai")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("The two girls have made this extremely unlikely event to happen with 100% certainty.", "Ai")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Annie is a witch, but then Lian… Is she a container created by Substance H?", "Mariru")
	await novel_interface.show_dialog("It's like Lian has enabled the witches and their magic power…", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Or, like a supercharged battery put in a vibrator…", "Ai")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("A thud comes from the Command Room. A lump appears on Ai’s head.")
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("I feel so sorry for the taxpayers. Imagine how much tax money is wasted on weirdos like you.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Science is all about insatiable curiosity and lust, isn't it?", "Ai")
	novel_interface.character_2nd_light(0.35,"normal2")
	novel_interface.character_dark()
	await novel_interface.show_dialog("… You really have no shame to say that.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Did I mention the bizarre research targets you set for my SRD?", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("And your face tells me you're planning something foxy. \\nTell me, what's in your mind?", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ai noticed a smile on Mariru's face before it faded away.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Since they have been trained for a while, it's time to see what they've learnt.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("(Substance H, the Ross Goblet, Witches, Spacetime Flux… All connected with Lian…)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Without her, Annie couldn’t get through a flux area.) \\n(So, during the seven years when Annie disappeared…)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("You seem to be… planning to send the two innocent teenagers in danger?", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Whereof one cannot speak, thereof one must be silent.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Humph. Ludwig Wittgenstein. I like another quote of his better.", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("It is not how things are in the world that is mystical…", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("But that it exists.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("I surely will stay true to my principles.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("No doubt about that.", "Ai")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Annie and I suddenly receive an order from Mariru. We must return to our apartment immediately and stay on call.")
	novel_interface.show_character("ren_uniform","gratified")
	await novel_interface.show_dialog("An urgent mission?!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("I uh… \\n(Staring—)", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy_left")
	await novel_interface.show_dialog("Ma… Mariru?", "Lian")
	await novel_interface.show_dialog("(I think I see a flash of hesitation in Mariru's eyes…)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("So, time flies when we don't meet? \\nYou are growing fast—", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah… Though there are still things I'm not used to.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Really? For example?", "Mariru")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Like the look of the Battle Suit… \\nSuch a humiliation!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("It's obviously very cool!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("The top doesn't fit any more? \\nWould you like a new measurement?", "Mariru")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, not that!", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0,0.3,true)
	await novel_interface.show_text_only("Mariru reaches out to me. I realize her intent, and quickly dodge her.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Uh—No, no! \\nIt fits perfectly!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Aww.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("(What are you feeling pity for!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Eep! Lian is still developing…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie looks envious and sad.")
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Annie—! \\nHow could you be like her…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","smile")
	await novel_interface.show_dialog("I hope I could grow like you do! \\n—Unfortunately, my time is at a standstill.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her time is at a standstill… Is it because she is a witch?")
	await novel_interface.show_text_only("Annie tries to look upbeat, but she can't hide the sorrow in her eyes. The air suddenly becomes heavy")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("… Annie", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","happy")
	await novel_interface.show_dialog("So, let me feel them—\\nAha!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie unexpectedly hugs me from the back.")
	novel_interface.show_character("anne_battle","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("Hey—!", "Lian")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("… You’ve grown up, girl.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru turns her head away, wiping her tears secretly.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("You! What nonsense!!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Ahem—Back to business! \\nI do have an urgent mission for you right now.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Have you heard of the Johnson Substation?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The super huge substation on the East coast?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("(It's a co-administered area by the six Academy Cities within the protective field of Aegis. Post-war peace talks were held there.)")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Exactly. We've just got alarms from a dozen relay stations showing strong surges that occurred in the northeast.", "Mariru")
	await novel_interface.show_dialog("And our satellite has detected a Spacetime Flux in the Substation.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.character_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Spacetime Flux? Could it be…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("If the data is correct, the situation would be the same as those you went through before.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("You are not qualified as field agents yet…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("But the Substation is within the \"Agreed Demilitarized Zone”, which means, SID has no authority to conduct operations there even though it's in New Opulentia.", "Mariru")
	await novel_interface.show_dialog("It can be seen as a minor compromise for \"world peace.\"", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("So, I need you to go ahead to scout out the Substation. SID teams will stand by at the perimeter.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("I'll get the approval of the United Congress asap.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","wry_smile",0.25)
	await novel_interface.show_dialog("You mean, we'll trespass on the jurisdiction of the Academy City Alliance? \\nIs it really OK?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uh-huh! Looks like someone would rather see a blackout in the embassy area than take a shortcut.", "Mariru")
	await novel_interface.show_dialog("If trouble comes, those idiots who hate each other may just clash. \\nIf the situation deteriorates into a war…", "Mariru")
	await novel_interface.show_dialog("If the situation deteriorates into a war…", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("Alright, alright. Whatever you say…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And you are just teenagers. Even if you're caught by security soldiers, you may get away by playing cute.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Yeah, when pigs fly!", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anyway, this is an order. \\nThe helicopter is waiting on the roof. Get ready and off you go!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"sprite")
	await novel_interface.show_dialog("What a dictator…", "Lian")

	print("=== 第二章第19话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
