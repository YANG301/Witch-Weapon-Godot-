# chapter2_ep04.gd - 第二章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep04_script()

func play_script():
	pass

func chapter2_ep04_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("Sì... sono anche confuso perché sembrava così reale, diverso da qualsiasi sogno.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ho cercato notizie di incendi o danni edilizi, ma non c'è nulla. \\nLa città sembra tranquilla come un tempo.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Tranne una cosa...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ehm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Tranne cosa?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_left")
	await novel_interface.show_dialog("Quando mi sono svegliato...", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	await novel_interface.show_dialog("Ho scoperto che il mio corpo era cambiato in quello di una ragazza...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_dialog("Bene…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("Eh? Hai detto... che è cambiato?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Io non... non avevo questo aspetto prima...", GameConfig.player_name)
	await novel_interface.show_dialog("Io... in realtà sono un ragazzo!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true)
	await novel_interface.show_dialog("Ewwww… un maschio?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("Ok... aspetta, cosa?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Vuoi dire che sei un ragazzo che si traveste? (si avvicina)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_dialog("No, no... non è questo che intendo. \\nNon avvicinarti così tanto!", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Ma... in un certo senso... \\nForse hai ragione...", GameConfig.player_name)
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_dialog("Oh Dio... come posso spiegarlo!", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Comunque… hai un bel lavoro sulle tette. (Tocca)", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Così rimbalzante... Dove l'hai fatto? Un tocco così naturale… (pizzica)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","happy",0.25)
	await novel_interface.show_dialog("Woo... voglio scoprirlo anch'io!", "Annie")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahi! No... non è... aspetta... \\nSmettila!", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Fammi controllare... braccia sottili, vita sinuosa, perfetto.", "Mariru")
	await novel_interface.show_dialog("Che materiali hai utilizzato? Soprattutto qui…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ahhhhh! È prurito...!", GameConfig.player_name)
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Signora Mariru! Non toccarlo qui!", GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("No...!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Boohoo…", GameConfig.player_name)
	await novel_interface.show_dialog("Che tu ci creda o no! Ero un ragazzino fino a ieri!", GameConfig.player_name)
	await novel_interface.show_dialog("Non c’è stato nessun intervento chirurgico…", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sì, su questo non ci sono dubbi.", "Mariru")
	await novel_interface.show_dialog("Un cambiamento di genere così completo è impossibile con le tecnologie attuali.", "Mariru")
	await novel_interface.show_dialog("Non puoi farlo se non sostituisci ogni osso del tuo corpo. \\nIl che significa che sei, e sei stata, una ragazza.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa! Te l'ho detto! \\nMi sono svegliata come una ragazza.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Hai qualche prova? \\nNiente che provi che eri un ragazzo?", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Beh... prova... \\nSì, giusto! La mia carta d'identità studentesca!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Abbiamo consegnato tutte le mie cose quando sono entrato qui, compresi i miei vestiti e la carta d'identità.")
	await novel_interface.show_text_only("Mariru tocca il suo dispositivo portatile, che fa apparire la mia tessera studentesca.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Sì! Questo è tutto! \\nGuarda! Questa è la prova.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("I lineamenti del viso ti somigliano un po', ma questa non è certo una prova...", "Mariru")
	await novel_interface.show_dialog("Giusto, recupera tutte le riprese di"+GameConfig.player_name+"catturato dal sistema di sorveglianza della città nell'ultimo mese...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru tocca abilmente il suo tablet, sembrando un po' emozionata.")
	novel_interface.character_light(0.35,"worry")
	await novel_interface.show_dialog("Pensavo che fosse solo un sogno quando ho visto quelle rovine, e ho pensato che tutto sarebbe tornato alla normalità al risveglio.", GameConfig.player_name)
	await novel_interface.show_dialog("Ma ora sono diventata una ragazza...", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Applicare correzioni per il cambiamento osseo. Attiva subito l'analisi dell'andatura sulle tue riprese nel corridoio...", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ignora il mio mormorio e si concentra sul suo tablet.")
	novel_interface.character_light(0.35,"bored")
	await novel_interface.show_dialog("Forse non è un sogno. Ma ora sembra tutto a posto. Nessun fuoco, nessuna distruzione.", GameConfig.player_name)
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ughh... sono completamente confuso...!", GameConfig.player_name)
	await novel_interface.show_dialog("Quali parti dei miei ricordi erano reali e quali erano solo sogni...?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("… Lo schema dell’andatura corrisponde.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa significa?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Il modello dell’andatura è il modello di controllo caratteristico dei muscoli di una persona quando cammina. Anche i migliori agenti non riescono a nasconderlo.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("Anche se la scienza attuale non può spiegarlo...\nLo sei davvero"+GameConfig.player_name+".", "Mariru")
	novel_interface.character_move_left(-0.3,0.3,false)
	novel_interface.character_2nd_move_left(0)
	novel_interface.show_3rd_character("anne_battle","perspire",0.3)
	await novel_interface.show_dialog("A... sei sicuro...?", "Annie")
	await novel_interface.hide_2nd_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Alla fine... pensavo che voi ragazzi sapeste qualcosa al riguardo...", GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Allora, hai sentito parlare del Ross Goblet?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ross Goblet? Un Substance H scomparso all'improvviso sotto sorveglianza video, secondo le notizie di questa mattina... Ma non l'ho ancora visto di persona.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Beh, se dici la verità...", "Mariru")
	await novel_interface.show_dialog("Probabilmente sarà l’unico motivo per cui accetterei di tenere questa noiosa conferenza gratuitamente.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Si tratta di un Substance H trovato sulle Isole Ross. All'esterno sono montate quattro gemme di notevole purezza.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ho visto qualcosa che assomiglia ad un calice scintillante volare nel cielo dopo essere uscito dalle rovine.", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Fluttuava nel cielo, emettendo una debole luce rossa...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Rosso debole?", "Mariru")
	await novel_interface.show_dialog("(Il lieve liquido rosso nel calice è stato un mistero...)", "Mariru")
	await novel_interface.show_dialog("(Ma queste informazioni sono riservate. Non sono mai state rese pubbliche, anche dopo essere state classificate come \"sicure\" non molto tempo fa.)", "Mariru")
	await novel_interface.show_dialog("(Nessuno potrebbe fornire tali dettagli senza averlo visto prima…)", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Indipendentemente dal fatto che fosse un sogno, temo che dobbiamo confermare maggiori informazioni con te.", "Mariru")

	print("=== 第二章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
