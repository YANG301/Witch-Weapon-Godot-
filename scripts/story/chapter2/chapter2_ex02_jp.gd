# chapter2_ex02.gd - 第二章番外02
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ex02_script()

func play_script():
	pass

func chapter2_ex02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_text_only("大広間の鏡に、自分の今の姿が映っている。\\n涙に濡れたまつ毛が、呼吸に合わせて起伏する…")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("もう完全に……女の子みたいじゃないか……", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("（下も……スースーする……）", "小憐")
	await novel_interface.show_dialog("（……ん？　これって……）", "小憐")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("（トイレは……どうすれば……）", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（もぞもぞっ……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("何をしている？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("うわああぁぁーーっ！　ああぁぁぁーーっ！！！", "小憐")
	await novel_interface.show_dialog("違うんだ……っ！！\\nごめんなさいっ！！\\n 変な事とか考えていないから……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("ははは、お前は誰に謝っているんだ？\\nもしかして……自分の身体にか？", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("（ど、ど、ど、どうしよう……？）", "小憐")
	novel_interface.change_2nd_expression("blush")
	await novel_interface.show_dialog("マリル……あの……", "小憐")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("お、お、女の子って……", "小憐")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("なんだなんだ……人に物事を聞く時は、\\nはっきりと言え。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("……どうやってトイレを使えばいいの！？", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……は──！？", "マリル")
	await novel_interface.show_dialog("ぶぁっはっはははは～～～～ッッ！！", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("（こんな、こんな質問をしちゃうなんて……っ！　またからかわれる……）", "小憐")
	await novel_interface.show_dialog("（だけど我慢の……限界……）", "小憐")
	novel_interface.change_2nd_expression("timid")
	await novel_interface.show_dialog("わ、笑うなよッ！！", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("まあ……普段通り座ってやればいいさ。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("女子トイレは廊下の向こうだ、早く行け。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"normal1")
	await novel_interface.show_dialog("ぷっ！アイツ。\\n女子トイレの前でためらいつつも……\\n結局は涙目になりながら駆け込んで\\nいったではないか……", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("なんだ……あの可愛い生き物はッ！！", "マリル")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…………\\nピ──（水流し音）")
	novel_interface.show_character("ren_battle","uneasy")
	await novel_interface.show_dialog("はぁーー……スッキリした……", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("ちょっと待って……なんか……", "小憐")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("まだ……残ってる感が……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………………")
	await novel_interface.show_text_only("………………")
	novel_interface.change_background("res://assets/images/bg/SID/hall.png")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("おかえり、で、『どうだった？』", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy_right")
	await novel_interface.show_dialog("こういう事の感想を聞かないでッ！！！", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（女子トイレの紙が良く切れる原因はこれか…）", "小憐")
	await novel_interface.show_dialog("うううぅ……\\n恥ずかし過ぎる……", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("くそくそくそっ！！\\n必ず！　一刻も早く男に戻らないとっ！！", "小憐")

	print("=== 第二章番外02结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
