# chapter2_ep06.gd - 第二章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep06_script()

func play_script():
	pass

func chapter2_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/spConferenceRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(พึมพำ) เจ้าเด็กสารเลวนั่นน่าสนใจกว่ามาก...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ข้อความแจ้งการเชื่อมต่อการโทรด้วยเสียงจะกะพริบบนหน้าจอในแนวทแยงมุมด้านหน้า Mariru เสียงอิเล็กทรอนิกส์ที่จงใจบิดเบือนจะปิดบังเพศดั้งเดิมของผู้พูด")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("(ฉันได้บรรยายสรุปนี้มาหลายครั้งแล้ว แต่รูปแบบการรบกวนที่เข้ารหัสด้านเดียวนี้ยังคงสร้างความโมโหอยู่)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("แล้วเกี่ยวกับการหายตัวไปของ Ross Goblet ตอนนี้การสอบสวนเป็นอย่างไรบ้าง?", "Kirs")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("เมื่อเวลา 00:15 น. ของเช้านี้ ระบบรักษาความปลอดภัยยืนยันว่า Ross Goblet หายไปแล้ว", "Mariru")
	await novel_interface.show_dialog("เมื่อเวลา 06:40 น. ระบบติดตามด้วยดาวเทียม ทรูไซต์ ออกคำเตือนหลังจากตรวจพบการบิดเบือนมิติอย่างรุนแรง", "Mariru")
	await novel_interface.show_dialog("จากนั้น ตั้งแต่เวลา 07:00 น. ของเช้านี้จนถึงตอนนี้ ระบบ Aegis ได้ตรวจพบการแจ้งเตือน ความผันผวนของเฟสมิติเวลา หกรายการภายใน New Opulentia", "Mariru")
	await novel_interface.show_dialog("และถ้าเราเอาสถาบันวิจัยเป็นศูนย์กลาง ก็จะมีการแจ้งเตือนที่คล้ายกัน 32 รายการปรากฏขึ้นพร้อมๆ กันในรัศมี 1500 กิโลเมตร...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("ทั้งหมดนี้มีอยู่ในเอกสารแล้ว ให้ข้อสรุปแก่ฉัน", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru เหลือบมองไหล่ขวาแล้วยิ้ม")
	await novel_interface.show_text_only("ดูจากน้ำเสียงเพียงอย่างเดียว เธอบอกได้เลยว่าเป็นผู้บริหารระดับสูงที่เคร่งครัดและไม่ยิ้มแย้มของ วุฒิสภา")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("—นี่ไม่ใช่การขโมย มันเป็นการตื่นขึ้นของ Substance H พร้อมกับปฏิกิริยาลูกโซ่ที่มันกระตุ้น", "Mariru")
	await novel_interface.show_dialog("และเมื่อพิจารณาจากความถี่และขนาดในปัจจุบัน เรายังระบุไม่ได้ว่าเป็นประเภทมีม Substance H หรือไม่", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ทันทีที่ Mariru พูดจบ เสียงพึมพำที่น่าตกใจและการสนทนาเงียบ ๆ ก็กระเพื่อมผ่านหน้าจอที่มืดมิดรอบตัวเธอ")
	await novel_interface.show_text_only("!!!!!")
	novel_interface.show_character("senate_giles")
	await novel_interface.show_dialog("อะไรนะ!", "Kirs")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เสียงทุ้มและมั่นคงดังมาจากทางซ้ายของ Mariru")
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("คุณหมายถึงการระบาดแบบทวีคูณของ \"สัมผัสศักดิ์สิทธิ์\" ที่ส่งผลต่อจิตใจใช่ไหม\nน่าสนใจมาก...", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("ในขณะนี้ ดูเหมือนว่าจะมีเหตุการณ์หลายอย่างปะทุขึ้นในเวลาเดียวกัน\n\"Divine Touch\"... ฉันไม่ชอบคำศัพท์ที่ไม่ชัดเจนเป็นพิเศษ", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("(ถึงแม้พระองค์จะเป็นผู้มีอำนาจในการกระทบจิตใจ Substance H...)", "Mariru")
	await novel_interface.show_dialog("(ฉันยังไม่สามารถสั่นคลอนความรู้สึกที่กอริลลาตัวนี้ทอดสมองของเขาด้วยรังสีมากเกินไป)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("ถ้าอย่างนั้นตามวิจารณญาณของคุณ...?", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ฉันยังไม่มีวิธีส่งรายงานสรุปได้ เราไม่มีข้อมูลที่สามารถดำเนินการได้เพียงพอ", "Mariru")
	await novel_interface.show_dialog("ด้วยสถานการณ์ปัจจุบัน ฉันจึงขอคำสั่งสอบสวนคลาส S แบบไม่จำกัด ฉันหวังว่าคุณทุกคนจะเข้าใจ", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("โดยไม่สนใจเสียงกระซิบที่อยู่รอบตัวเธอ Mariru หันความสนใจของเธอกลับไปที่เครื่องอ่านบาร์โค้ดชนิดพกพา")
	novel_interface.character_light(0.35,"normal1")
	await novel_interface.show_dialog("(สาวน้อยคนนั้นไปโซนผิดปกติอีกแล้ว...)", "Mariru")
	await novel_interface.show_dialog("(ตามที่คาดไว้—เธอหายตัวไป และปรากฏตัวอีกครั้งในภายหลัง จากนั้นความผันผวนของระยะใกล้เคียงก็หยุดอีกครั้ง)", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(ภาพจากที่เกิดเหตุ... นั่นเลือดเธอหรือเปล่า?)", "Mariru")
	await novel_interface.show_dialog("(ไอ้โง่นั่น... อย่าบอกนะว่าเธอ—!!)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_giles","",0.25)
	await novel_interface.show_dialog("ดูเหมือนคุณจะฟุ้งซ่านเล็กน้อย", "Kirs")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อะไร?... ไม่เลย", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ไม่ว่าคุณกำลังดูอะไรอยู่ มันมีข้อมูลที่สำคัญกว่าการบรรยายสรุปนี้หรือไม่?", "Kirs")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...เปล่า มันเป็นแค่วิดีโอลูกแมวนะ ต้องการที่จะเห็นมัน?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("!!!", "Kirs")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("เสียงครวญครางทางไฟฟ้าที่คมชัดและเสียงหึ่งดังขึ้นจากด้านซ้ายของ Mariru")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("อย่าโกรธมากนะ การเบี่ยงเบนเล็กน้อยช่วยเพิ่มประสิทธิภาพในการทำงาน", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("...", "Kirs")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Mariru กวาดสายตาไปรอบๆ ห้อง ดูเหมือนว่าไม่มีใครสังเกตเห็นการลื่นไถลชั่วขณะในตอนนี้")
	novel_interface.character_light()
	await novel_interface.show_dialog("ไม่ว่าในกรณีใด ข้อมูลพื้นฐานที่เราได้รับมานั้นตรงตามที่ระบุไว้ในการบรรยายสรุปทุกประการ\nเหตุการณ์ดังกล่าวยังอยู่ในระหว่างการสอบสวนเพิ่มเติม", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("หากไม่มีคำถาม ฉันกำลังมุ่งหน้าไปที่เกิดเหตุ", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ก่อนที่ Mariru จะจากไป มีเสียงที่ค่อนข้างหยาบคายดังมาจากทางด้านซ้ายของเธอ")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_#C")
	await novel_interface.show_dialog("...ฉันได้ยินมาว่าลูกน้องของคุณพานักเรียนมัธยมปลายสองคนกลับมาที่ SID เพื่อซักถามเหรอ?", "#C")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("...\n(ไอ้สารเลวนั่นอีกแล้ว)", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("senate_#C","",0.25)
	await novel_interface.show_dialog("มีอะไรพิเศษเกี่ยวกับพวกเขาบ้างคะคุณผู้หญิง Mariru... ไม่นะคุณหมอ?", "#C")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...ไม่มีอะไรเลย เรายืนยันแล้ว พวกมันเป็นเพียงลูกแมวสองตัวที่ขี้สงสัยมากเกินไปที่แอบเข้าไปในเขตหวงห้าม", "Mariru")
	await novel_interface.show_dialog("ฉันจะจัดให้มีการส่งพวกเขากลับบ้านทีหลัง", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ฉันเห็น. นั่นเป็นสิ่งที่ดีแล้ว", "#C")
	await novel_interface.show_dialog("ในเวลาที่มีความอ่อนไหวเช่นนี้ คงลำบากหากประเทศอื่นเริ่มปฏิบัติต่อพวกเขาราวกับมีชีวิตที่แปลกประหลาด...", "#C")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("คำพูดนั้นทำให้เกิดความโกลาหลในหมู่คนอื่นๆ")
	await novel_interface.show_text_only("...หมายความว่าไง?")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ฉันแน่ใจว่าคำพูดที่ไม่ระมัดระวังอาจทำให้บางคนไม่สบายใจ\nขอโทษด้วย—แค่แสร้งทำเป็นว่าคุณไม่เคยได้ยินมาก่อน", "#C")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("...\n(ช่างเป็นบุรุษที่น่ารังเกียจอย่างยิ่ง)", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("senate_bright")
	await novel_interface.show_dialog("ถ้าอย่างนั้น ไม่ว่าเหตุการณ์นี้จะดึงดูดความสนใจของเมือง Academy อื่น ๆ ไปแล้ว", "Bright")
	await novel_interface.show_dialog("เราจะพึ่งพาคุณในการสืบสวนลับและการจัดการข้อมูลสาธารณะนับจากนี้เป็นต้นไป", "Bright")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ตามธรรมชาติ", "Mariru")

	print("=== 第二章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
