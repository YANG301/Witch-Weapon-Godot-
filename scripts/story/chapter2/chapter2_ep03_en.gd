# chapter2_ep03.gd - 第二章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter2_ep03_script()

func play_script():
	pass

func chapter2_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("“Escorted\" by the agents, Annie and I hopped into a jet-black sedan.")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView2.png")
	await novel_interface.show_text_only("The passenger compartment is suffocating.")
	await novel_interface.show_text_only("I wrap my arms around my knees, bewildered.")
	await novel_interface.show_text_only("Annie leans on me gently, which makes me feel somewhat relaxed.")
	await novel_interface.show_dialog("So... what is SID? \\nYou get edgy every time you hear it.", "Annie")
	await novel_interface.show_dialog("Are you from outer space? \\nSID is the intelligence department under the Senate.", GameConfig.player_name)
	await novel_interface.show_dialog("Some say SID plays a more important role than the Aegis defense system in keeping New Opulentia neutral.", GameConfig.player_name)
	await novel_interface.show_dialog("But there're more urban legends about people taken by SID and never come back... It's just horrible.", GameConfig.player_name)
	await novel_interface.show_dialog("Okay... But then, what's the Academy City?", "Annie")
	await novel_interface.show_dialog("(Wait... Does this girl have no common sense at all? )", GameConfig.player_name)
	await novel_interface.show_text_only("Annie sees my surprised look... and she just gives me a relaxed smile.")
	await novel_interface.show_dialog("Just relax, we won't have any problems!", "Annie")
	await novel_interface.show_dialog("Because... you're special.", "Annie")
	await novel_interface.show_dialog("…", GameConfig.player_name)
	await novel_interface.show_text_only("It's weird that Annie's rambling has somehow calmed my agitated mind.")
	await novel_interface.show_text_only("It seems not that horrible to be taken away by SID...")
	await novel_interface.show_text_only("(No. No. It is horrible!)")
	novel_interface.change_background("res://assets/images/bg/Shot/incarView1.png")
	await novel_interface.show_text_only("We arrive at the city's bustling business area and drive into an ordinary basement garage where we get onto a car elevator.")
	await novel_interface.show_text_only("After the agent reports, the elevator starts to move.")
	await novel_interface.show_text_only("I can feel how fast the elevator is moving. It descends for long stretches several times, and even shifts sideways now and then.")
	await novel_interface.show_dialog("(It's hard to imagine such an underground maze underneath the business area...)", GameConfig.player_name)
	await novel_interface.show_text_only("Rumors about the SID headquarters abound. Some say it's located at the south suburbs of New Opulentia, and the whole structure is coated with optical camouflage.")
	await novel_interface.show_text_only("Of course, for a building that doesn’t officially exist in the system, the media could make up anything as long as it attracts clicks.")
	await novel_interface.show_text_only("And where I'm stepping into is exactly the core area of this “non-existent” department.")
	await novel_interface.show_dialog("(I just hope that I won't be made “non-existent” here...)", GameConfig.player_name)
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("We step off the car in front of a corridor wrapped with metal plates. It gives a sense of technology and abstinence.")
	await novel_interface.show_text_only("The elevator door automatically shuts right after we get off. We hear it leaves as we continue along the dark corridor. The air gets stiff and dreary.")
	await novel_interface.show_text_only("My heart is also sinking...")
	novel_interface.change_background("res://assets/images/bg/SID/hearingRoom.png")
	await novel_interface.show_text_only("We walk straight down the corridor and arrive at a bright but enclosed room.")
	await novel_interface.show_text_only("It looks like some kind of interrogation room, but there are no tables or chairs. One wall is a huge pane of glass.")
	await novel_interface.show_text_only("Before I can turn to check on that wall—")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Whoooa—!", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Someone forcefully reaches their arms around my waist.")
	novel_interface.character_light(0.35,"sob")
	await novel_interface.show_dialog("Ouch… It hurts!", GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As I'm about to lose balance, I feel my head falls on something familiar, soft but firm.")
	await novel_interface.show_dialog("Well... Judging from your core strength, the spy stuff is not for you.", "Female Voice")
	await novel_interface.show_dialog("I thought we got some body scan errors, so I wanted to personally confirm.", "Female Voice")
	await novel_interface.show_dialog("Feels good though.", "Female Voice")
	await novel_interface.show_text_only("The female voice from behind me sounds familiar.")
	await novel_interface.show_text_only("She loosens her arms. With lingering fright, I turn around. \\nThe woman in front of me—")
	novel_interface.show_character("ren_battle","blush")
	await novel_interface.show_dialog("(Huh?! Th-that's huge!!!)", GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ms... Ms. Mariru!?", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("anne_battle","worry")
	await novel_interface.show_dialog("You know her?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Oh? So quick to reveal that you can identify agents from another intelligence agency. \\nLooks like you never planned to hide who you are...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("(Gosh! Silly me…)", GameConfig.player_name)
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("It’s hard to believe, but this woman in uniform in front of me is the woman I met in my dream.")
	await novel_interface.show_text_only("The slim figure… the red hair… the sadist look…")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("You must answer my questions honestly now.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Don't make any excuses or play any tricks.", "Mariru")
	await novel_interface.show_dialog("Interrogation happens to be one of my specialties. \\nI won't go easy on that cute little face of yours~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_text_only("That overbearing, teasing attitude, and those confident eyes with a hint of mockery...")
	await novel_interface.show_text_only("What's her full name again? \\nRight, it's...")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Exactly. I'm the head of SID. My name is Mariru Von Braun.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","awkward",0.25)
	await novel_interface.show_text_only("It's her!!!")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_text_only("Wait... the head of SID? \\nWasn't she the chief scientist?!")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_text_only("But having a close look at her clothes and shoulder marks, she's probably a big boss...")
	novel_interface.change_2nd_expression("shy")
	await novel_interface.show_text_only("Her stockings and high heels are the same as yesterday though.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hey, girl, what are you looking at, huh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("Oh! Yeah... right! \\nSorry, Ma’am!", GameConfig.player_name)
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You've got some nerve, letting your mind wander right now.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("I've heard that you told many horrible stories about SID to this blue twin-tail.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Mariru twiddles her whip in her hands. I get nervous and swallow hard.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Guess... \\nHow many of them are true?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Uh! I’m… so sorry!", GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_battle","perspire")
	await novel_interface.show_dialog("B… blue twin-tail…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Now that you know fear, let's start with your identity.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru opens her handheld terminal, and a projection immediately appears on the wall of the interrogation room.")
	await novel_interface.show_text_only("It shows photos of me taken from different angles by surveillance cameras, and the facial analysis result reads:")
	await novel_interface.show_text_only("[No matches found]")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("No arrival record... Aegis fails to identify.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("If it wasn't your poor physical fitness, you would be immediately dealt with as a spy or terrorist intruder.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","shy")
	await novel_interface.show_text_only("I feel a bit embarrassed and rub my belly unconsciously.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","frustrate",0.25)
	await novel_interface.show_dialog(GameConfig.player_name+", this lady seems even scarier than the enemies we ran into earlier...", "Annie")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Yeah… and she won't have any trouble seeing through my lies...)", GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false,"sob")
	await novel_interface.show_dialog("(I'll confess! Gosh! Whatever!)", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog(""+GameConfig.player_name+", where should I even begin...?", GameConfig.player_name)
	await novel_interface.show_dialog("It's a bit complicated, to be honest. I'm very confused too.", GameConfig.player_name)
	await novel_interface.show_dialog("You probably won’t believe what I say...", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Stop rambling. I'll judge that for myself!", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("… Well… I had this dream.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("In the dream, I went to the Research Center to attend a lecture for my outdoor teaching report… And I arrived right before the closing time.", GameConfig.player_name)
	await novel_interface.show_dialog("I met you there. And you said it has been captured…", GameConfig.player_name)
	novel_interface.character_dark()
	await novel_interface.show_text_only("Apparently, Mariru takes this as a joke or something.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","speak2",0.25)
	await novel_interface.show_dialog("You mean, you met me in a dream?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yes, it was you. \\nAnd you dragged me to a corner...", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Oh, right... you were an SS-class scientist recognized by the Senate... \\nDr. Mariru Von Braun, right?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("... That's me.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("But this information is not secret—anybody familiar with New Opulentia knows it.", "Mariru")
	await novel_interface.show_dialog("... Forget it. \\nSo what happened next?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You knocked down one of the intruders and got a pistol. You asked me to stay put and wait for rescue, and you went to the hijack spot.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hijack spot? \\nWhere exactly?", "Mariru")
	novel_interface.character_light(0.35,"gratified")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You said it was the Conference Hall.", GameConfig.player_name)
	await novel_interface.show_dialog("You were about to give a lecture there. You were the lecturer.", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("… Lecture… Lecturer.", "Mariru")
	novel_interface.change_2nd_expression("serious")
	await novel_interface.show_dialog("(Is she talking about the public lecture on Ross Goblet arranged by Wolfgang?)", "Mariru")
	await novel_interface.show_dialog("(But it should have been canceled. How could she know about this?)", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um... Ms. Mariru?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Yeah… nothing. Go on.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And some masked gunmen came by. I ran downstairs and hid in the shadow of a slate...", GameConfig.player_name)
	await novel_interface.show_dialog("Sorry but I can't remember what happened there…", GameConfig.player_name)
	await novel_interface.show_dialog("I somehow fainted and when I woke up, I saw…", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("What did you see?", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("I saw smoke and flames all around.", GameConfig.player_name)
	await novel_interface.show_dialog("The Research Center and the surrounding buildings were all in ruins...", GameConfig.player_name)
	await novel_interface.show_dialog("There was a pungent smell all around.", GameConfig.player_name)
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("It had a heavy saline and bitter taste...", GameConfig.player_name)
	await novel_interface.show_dialog("All people turned into stone figures.", GameConfig.player_name)
	await novel_interface.show_dialog("No, not exactly stone—it was salt.", GameConfig.player_name)
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("And I saw something shining in the air.", GameConfig.player_name)
	await novel_interface.show_dialog("It was like hell. \\nBut somehow I can feel a kind of peculiar tranquility.", GameConfig.player_name)
	await novel_interface.show_dialog("Something is responding to me...", GameConfig.player_name)
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("And then my memory became vague... There might be a streak of light—", GameConfig.player_name)
	await novel_interface.show_dialog("And… that's pretty much the end of the dream.", GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("When I woke up, I found myself on my bed in my room, and it was already morning.", GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Was it... only a dream...?", "Mariru")
	await novel_interface.show_dialog("Your olfactory memory was so vivid as if you were actually there…", "Mariru")
	await novel_interface.show_dialog("(If that pungent smell was sulfur...) \\n(It would be just like the way Sodom and Gomorrah were destroyed in Genesis.)", "Mariru")

	print("=== 第二章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
