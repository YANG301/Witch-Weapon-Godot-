	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("… C'est vraiment nul.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Bouh…", "Lian")
	await novel_interface.show_dialog("Eh bien… j'ai fini de manger…", "Lian")
