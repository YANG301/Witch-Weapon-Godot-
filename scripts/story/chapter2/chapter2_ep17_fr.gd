	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Est-elle la nouvelle étudiante transférée ?", "Étudiant 1")
