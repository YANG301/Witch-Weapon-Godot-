	await novel_interface.show_dialog("Le nom à l’air vraiment cool !", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"gratified")
	await novel_interface.show_dialog("Tu es vraiment un enfant, Annie.", "Lian")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Je vais juste prendre un café…", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lian, tu es une fille maintenant. \\nTu ne veux pas essayer des desserts ? Ils sont très délicieux !", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("D'accord… laisse-moi vérifier. \\nEmm… Muffin au fromage Matcha Napoléon… (Pas mal.)", "Lian")
	novel_interface.change_2nd_expression("shy_left")
	await novel_interface.show_dialog("Gâteau Royal à la Crème d'Orange Confite… (Il a l'air délicieux aussi…)", "Lian")
	novel_interface.change_2nd_expression("shy_right")
	await novel_interface.show_dialog("Coupe glacée aux fruits glacés du festin tropical… \\n(Gulps)", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_dialog("Excusez-moi… Avez-vous pris votre décision ?", "Serveur")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Eh bien… Ummm \\npeut-être… juste du café… merci…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Très bien.", "Serveur")
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Eh bien…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Euh, attends ! J'ai changé d'avis… \\nUn parfait à la crème glacée à la fraise et à la mousse de myrtille s'il vous plaît…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Je veux juste y goûter ! \\nJe n'ai vu que des filles en manger avant...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Aha, pas besoin d'expliquer.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Désolé de vous faire attendre. Voici votre commande.", "Serveur")
	novel_interface.show_character("ren_uniform","timid")
	await novel_interface.show_dialog("Merci!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Profitez-en !", "Serveur")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Bon, prêt à partir !", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("…", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Miam… miam..!!", "Lian")
	await novel_interface.show_dialog("La fraise sent si fraîche. La crème est vraiment sucrée. Et la mousse aux myrtilles, un peu acidulée mais vraiment savoureuse…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me sens un peu gêné quand je trouve Annie en train de me regarder.")
	novel_interface.show_character("ren_uniform","shy")
	await novel_interface.show_dialog("Les filles adorent ces desserts. J'ai toujours voulu savoir \\nquel est leur goût.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bahaha… \\nLian, tu es tellement...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Hum ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Tellement adorable !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Quoi… de quoi tu parles… !", "Lian")

	print("=== 第二章第17话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
