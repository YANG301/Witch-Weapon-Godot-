	await novel_interface.show_text_only("La guerre a laissé derrière elle de nombreux orphelins. L'organisation de la défense a alourdi les Sénat. Ainsi, les fournitures destinées à chaque école maternelle étaient fortement rationnées.")
	await novel_interface.show_text_only("De nombreux enfants mouraient de faim et devaient chercher de la nourriture dans la zone de guerre proche de la frontière. J'étais l'un d'entre eux…")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_diningRoom.png")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("… Lian.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Je comprends vos sentiments. Juste… ne mange pas trop maintenant.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie a peut-être aussi vécu cette époque…")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Hé, prenons quelques desserts après l'école !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("… D'accord !", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_coffeeShop.png")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Nous avons rarement du temps libre pour sortir ainsi, Lian.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	await novel_interface.show_dialog("C'est en fait la première fois que je vais dans ce genre de restaurant… \\n(Je me sens un peu mal à l'aise avec les filles autour…)", "Lian")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Très bien, voyons voir… eh bien, je vais prendre celui-là ! \\nParfait à la crème glacée aux bleuets Super Soda Special Drink DX !", "Annie")
