	novel_interface.character_move_right(0,0.3,true,"gratified")
	await novel_interface.show_dialog("Probablement parce que... j'avais trop souvent faim quand j'étais enfant.", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/cityCrash_ruin.png")
	await novel_interface.show_text_only("Aegis ne peut qu'identifier et protéger les balles. Cela signifie que les soldats armés peuvent facilement pénétrer son champ de force.")
