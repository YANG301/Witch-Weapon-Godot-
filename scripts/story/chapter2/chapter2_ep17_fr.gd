	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Eh bien, Lian…", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ? (Munches) \\nLe riz au curry est tellement bon ! (Gloires)", "Lian")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("J'adore cette école ! (Barbotines)", "Lian")
