# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("—O quê? O suspeito está morto?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nosso alvo havia reformado sua casa em uma fortaleza inteira. E ele disparou contra a equipe de resgate como um louco com armas pesadas no momento em que eles chegaram.","SID Agent")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("A equipe de resgate não deveria estar equipada apenas com armas não letais? Por que o alvo morreu?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("A equipe não feriu o alvo fatalmente.","SID Agent")
	await novel_interface.show_dialog("Em vez disso, o alvo parece ter morrido por overdose de neurofármacos ou perda de sangue.","SID Agent")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("... entendo. Você pode ir agora.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sim, chefe.","SID Agent")
	await novel_interface.show_text_only("Mariru está folheando os arquivos do suspeito, parecendo muito irritada, quando Aya entra na sala de controle.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ren está aqui agora?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sim. Tudo parece bastante estável.","Aya") #文字错误
	await novel_interface.show_dialog("Este é o... resultado da autópsia do suspeito?","Aya")
	await novel_interface.show_dialog("Antonio Jose Urquiza... um senhor da guerra da máfia que costumava ser bastante ativo na América do Sul durante a Guerra dos Sete Anos. No momento, ele não passa de um líder de gangue menor.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Pena que as drogas fritaram seu cérebro... ou poderíamos ter tentado interrogá-lo com aquele dispositivo.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya murmura enquanto folheia sua pilha de arquivos.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("América do Sul... então o alvo era mesmo a Fabella, né?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ainda não podemos ter certeza.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru balança a cabeça, com o rosto sombrio, enquanto estuda o perfil do alvo exibido na tela.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Um pequeno número de marcadores radioativos foi detectado no dispositivo de distribuição de produtos químicos que encontramos na igreja.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("E a partir disso, encontramos facilmente outro local com os mesmos marcadores radioativos... bem dentro de Nova Opulentia.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Ah? Então é quase como se o culpado nem se preocupasse em se esconder.","Aya")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("É por isso que acho isso tão suspeito...","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Antonio... esse cara tem motivo para machucar Fabella?","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim, e que motivo...","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("No segundo ano da guerra, a economia da América do Sul entrou em colapso. O que aconteceu a seguir foi que as gangues tomaram conta do cenário político com seus conflitos e brigas mesquinhas.","Mariru")
	await novel_interface.show_dialog("Fabella, que perdeu os pais na guerra, foi adotada por um coronel e cresceu em um ambiente militar rigoroso.","Mariru")
	await novel_interface.show_dialog("Ela logo exibiu instintos de combate animalescos e se tornou a mais jovem guarda nacional da história.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ouvi dizer que ela entrou sorrateiramente em território inimigo uma vez, sozinha, e assassinou silenciosamente o comandante - que por acaso era o filho mais velho de Antonio.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Esse é realmente algum motivo.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru invoca o retrato de um homem, vestido com traje militar, e gesticula para a tela.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esse foi o coronel que adotou Fabella: Carlos Branco.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Você quer dizer “Açougueiro do Rio Churun” Branco?","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("O Massacre do Rio Churun ​​aconteceu não muito depois que as seis Cidades Acadêmicas formaram o Congresso Unido.")
	await novel_interface.show_text_only("46 mil civis foram executados às margens do rio, e seu sangue tingiu de vermelho as Cataratas do Salto Ángel rio abaixo.")
	await novel_interface.show_text_only("Foi notícia em todas aquelas semanas. A opinião comum era que Carlos Branco, o mais poderoso senhor da guerra na altura, estava por detrás de tudo.")
	await novel_interface.show_text_only("As visões grotescas do incidente despertaram sentimentos anti-guerra generalizados no público em geral, e Branco foi desde então conhecido como o Açougueiro do Rio Churun.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Logo, o Congresso Unido tomou medidas militares contra Carlos Branco, condenando-o pelos seus crimes anti-humanitários e raciais.")
	await novel_interface.show_text_only("Finalmente, um Lancer Penetrator explodiu a caverna onde Branco estava escondido - e assim encerrando a era monopolizada por gangues na América do Sul.")
	await novel_interface.show_text_only("Isso colocou o Congresso Unido nos bons livros da maioria das pessoas. Eles eram vistos pelo público em geral como um símbolo de paz e justiça. Após o seu sucesso, as seis nações no Congresso foram renomeadas para Cidades Acadêmicas.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—Pelo menos essa é a versão oficial impressa nos livros de história.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorri e Aya acena com a cabeça em compreensão.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Depois disso, os seis senhores da guerra restantes na América do Sul simplesmente desapareceram de uma só vez, como se estivessem sob algum tipo de acordo. O Congresso Unido logo assumiu o controle de seu território.","Aya")
	await novel_interface.show_dialog("Você sabe o que realmente aconteceu, não é?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya pergunta, inclinando-se para perto de Mariru e cutucando sua cintura com o cotovelo, como um gatinho curioso.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Sim. O massacre realmente aconteceu – mas aqueles que morreram vieram dos territórios dos seis senhores da guerra.","Mariru")
	await novel_interface.show_dialog("Eles concordaram em enviar essas pessoas para o rio, e... você sabe o que aconteceu a seguir.","Mariru")
	await novel_interface.show_dialog("Alguém os subornou para fazer isso.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("O único que se recusou a aceitar a propina foi Carlos Branco.","Mariru")
	await novel_interface.show_dialog("Foi assim que ele recebeu o papel de “mal necessário” em nosso mundo atual.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Então, aqueles que subornaram os senhores da guerra...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya olha fixamente, com os olhos arregalados. A resposta é muito clara.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Esses senhores da guerra que desapareceram devem simplesmente ter se mudado para outro lugar, mudado de nome e aproveitado o resto de suas vidas gastando o dinheiro que receberam.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quanto à prova da culpa de Branco... deve ter sido forjada para os soldados de segurança pelo próprio Congresso Unido.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Se o Congresso Unido perceber que Antonio está de volta para se vingar, eles vão querer acabar com isso o mais rápido possível.","Aya")
	await novel_interface.show_dialog("Não admira que toda esta situação pareça tão estranha.","Aya")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah? Estranho como?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Os alucinógenos que encontramos no sangue do alvo são do mesmo tipo que encontramos em Fabella.","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu sabia disso.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("E encontramos um tipo de estimulante, do tipo que os senhores da guerra costumavam usar para manter seus soldados alertas. Esse foi realmente o verdadeiro motivo da morte de Antonio.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso também está no relatório.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("O estimulante torna hipersensível quem é injetado com ele. Eles ouvirão mais, sentirão mais.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Há tanto sangue em seu sangue que, se ele fosse atingido por uma bala de borracha, provavelmente doeria tanto quanto ser atingido por um canhão.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mas durante os cerca de vinte minutos em que os dois lados atiraram um contra o outro, o alvo foi atingido várias vezes...","Mariru")
	await novel_interface.show_dialog("O alvo está claramente visível desde o quinto minuto na filmagem da cena. E ele nunca injetou nada em si mesmo.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Eles também não encontraram nenhuma lesão em seu sistema nervoso durante a autópsia.","Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("D-isso significa que esse cara realmente gosta de dor? Uau, o masoquista definitivo...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru rapidamente enrola um papel e dá um tapa na cabeça de Aya, como se ela tivesse feito isso a vida toda.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ah... de qualquer maneira, eles já descobriram quem trouxe Skuld para o parque?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Quem quer que tenha sido, ficou longe de todas as câmeras de vigilância. Um exemplo clássico de um excelente sequestrador.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Alguém familiarizado com a localização das câmeras de vigilância... e que pudesse andar pela cidade com uma garota nas costas, sem ser visto como suspeito...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sim. Essas pistas são tudo que temos.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru coça o queixo, imersa em pensamentos.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se Antonio fosse realmente um bode expiatório, cuidadosamente escolhido para atuar como “culpado”...","Mariru")
	await novel_interface.show_dialog("Então quem está por trás de tudo isso provavelmente está atrás de Fabella - ou, mais especificamente, de seus poderes de bruxa.","Mariru")
	await novel_interface.show_dialog("Não acho que eles conseguiram o que queriam.","Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Mas ela é um espécime bastante valioso, então, em vez de matá-la naquele momento, eles decidiram deixá-la lá para o Congresso Unido capturá-la...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Então foi por isso que usaram um “bode expiatório” tão precioso?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bem, ela é uma bruxa possuída pela magia do fogo, então...\nHmm, espere, “informação com vontade”...","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Informação...?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os olhos chocados de Mariru encontram os de Aya. Eles chegaram à mesma conclusão.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se o que esses sequestradores queriam mesmo era roubar as informações de dentro da cabeça de Fabella...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Eles podem estar usando o mesmo tipo de equipamento que nós também. A Harima Tech projetou esses dispositivos para hackear o cérebro com base em alguns artigos publicados disponíveis ao público em geral.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Nesse caso, eles provavelmente se depararam com o mesmo problema que nós.","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("Os primeiros quatro agentes que tentaram invadir o cérebro de Fabella se depararam com a mesma parede sem fim.")
	await novel_interface.show_text_only("Como um firewall que mantém os intrusos afastados.")
	await novel_interface.show_dialog("Se for um tipo ofensivo de firewall—","Aya")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aya, prepare-se para acordar Ren assim que eu der as ordens.","Mariru")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
