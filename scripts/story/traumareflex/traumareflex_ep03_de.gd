# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Hey, hast du jemals so ein Gefühl?")
	await novel_interface.show_text_only("Sie erinnern sich an eine Szene... haben aber keine Ahnung, wann sie passiert ist.")
	await novel_interface.show_text_only("Ich meine nicht Déjà-vu. Jeder hat das irgendwann einmal.")
	await novel_interface.show_text_only("Ich meine, es gibt etwas, von dem Sie immer gewusst haben, dass es eines Tages passieren wird, und es passiert schließlich.")
	await novel_interface.show_text_only("Du hast immer gewusst, dass es passieren wird. Sie haben es sogar gesehen, in Form einer Rückblende. Man kann einfach nicht sicher sein, wann es passieren wird.")
	await novel_interface.show_text_only("Was wir Déjà-vu nennen, ist einfach eine Art Bestätigung, dass Ihre Vorahnungen wahr geworden sind.")
	await novel_interface.show_text_only("Du wusstest, dass es passieren würde. Du hast es immer gewusst.")
	await novel_interface.show_text_only("Nicht wahr?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Hm…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das blonde Mädchen öffnet benommen die Augen, reibt sich das Gesicht und findet sich auf einer Bank wieder.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabella... wo sind wir?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aber Fabella antwortet nicht. Seltsam. Das Dienstmädchen erschien normalerweise in der Sekunde, in der ihr Name aufgerufen wurde.")
	await novel_interface.show_text_only("Das Mädchen schaut sich um und sieht eine leere Straße, die auf beiden Seiten von ordentlichen Straßenlaternen gesäumt ist. Die Straße scheint ewig in unheimlicher Stille zu verharren, als wäre dies ein alternatives Universum.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Waren wir nicht in einer Kirche...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ahh... Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld steht auf und massiert mit einer Hand ihre schmerzende Schläfe.")
	await novel_interface.show_text_only("Sie erinnert sich an den Albtraum, den sie hatte. Erinnert sich an die verdrehten Bilder auf den Mosaikfenstern. Aber war es wirklich nur ein Albtraum?")
	await novel_interface.show_text_only("Sie erinnert sich an Fabella, wie er sie aus der Kirche warf und sie aus der Dunkelheit befreite, die sie sonst erfasst hätte ...")
	await novel_interface.show_text_only("Skuld überprüft ihre Sachen. Ihr Handy, ihr Portemonnaie, ihre Accessoires... alles da.")
	await novel_interface.show_text_only("Auf ihrem Telefon sind 32 verpasste Anrufe.")
	await novel_interface.show_text_only("Hätte Fabella nicht eine Anti-Tracking-Software auf dem Telefon installiert, hätte die Botschaft sie wahrscheinlich schon gefunden.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Zehn-achtzehn Uhr... ist es schon so spät?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie kneift die Augen zusammen und versucht ihr Bestes, ihre Atmung zu regulieren, um das Wirrwarr ihrer Erinnerungen zu ordnen.")
	await novel_interface.show_text_only("Sie muss ruhig bleiben – das hätten Vater und Fabella gewollt. Sie sagten ihr immer, je gefährlicher die Situation, desto mehr müsse sie einen klaren Kopf behalten.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Diese Kirche... und der Text von Pater Anton... müssen eine Falle sein.","Skuld")
	await novel_interface.show_dialog("Wer auch immer es war, es muss mich im Visier haben, Vater oder Fabella.","Skuld")
	await novel_interface.show_dialog("Ich kann Autos von den Straßen in der Nähe hören und sogar Straßenkünstler, die in einiger Entfernung ein Lied spielen ... und ich bin nicht gefesselt oder so.","Skuld")
	await novel_interface.show_dialog("Laut GPS meines Telefons befinde ich mich im Arai Central Park, nicht weit von der Kirche entfernt.","Skuld")
	await novel_interface.show_dialog("Wer auch immer mich hierher gebracht hat, hat es wahrscheinlich nicht böse gemeint.","Skuld")
	await novel_interface.show_dialog("Ich weiß nicht, ob derjenige, der die Falle gestellt hat und der mich hierher gebracht hat, derselben Fraktion angehört ... Ich kann nicht einfach so zurückgehen.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld wählt noch einmal Fabellas Nummer. Und wieder geht es zur Voicemail. Sie überprüft alle ihre Unterlagen und es scheint, dass Fabella sie auch überhaupt nicht kontaktiert hat.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabella...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Schließlich ruft sie ihren Vater an und hält ihr Telefon fest in ihrer kleinen Hand.")
	await novel_interface.show_text_only("Er nimmt den Anruf in der Sekunde entgegen, in der der Anruf eingeht.")
	await novel_interface.show_dialog("Skuld? Sind Sie das?","Vater")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Vater...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Wo zum Teufel bist du? Es ist schon nach zehn Uhr. wo du bist. Alle sterben vor Sorge!","Vater")
	await novel_interface.show_dialog("Und weder Sie noch Ihr Dienstmädchen haben den Hörer abgenommen! Was ist mit euch beiden? Botschafter Haggerty hat bereits ein Team losgeschickt, um nach Ihnen zu suchen!","Vater")
	await novel_interface.show_text_only("Ihr Vater klingt wütend – aber Skuld ist einfach erleichtert, seine Stimme zu hören.")
	await novel_interface.show_text_only("Zumindest hat niemand versucht, ihn zu irgendetwas zu drohen und sie als Geisel zu nehmen.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Ich bin jetzt in Sicherheit, mach dir keine Sorgen, aber hör zu –","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Mann beruhigt sich sofort, als er die Dringlichkeit im Tonfall seiner Tochter hört.")
	await novel_interface.show_dialog("... Bist du allein?","Vater")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Ja. Nur ich.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Warte einen Moment, ich rufe dich unter einer anderen Nummer zurück.","Vater")
	await novel_interface.show_text_only("Sie legt auf und erhält sofort einen Anruf von einer unbekannten Nummer.")
	await novel_interface.show_dialog("Okay, du kannst jetzt reden. Was ist passiert?","Vater")
	await novel_interface.show_text_only("Skuld holt tief Luft. Nach ihrem derzeitigen Kenntnisstand dürfte es zwei Möglichkeiten geben:")
	await novel_interface.show_text_only("Wenn diejenigen, die die Falle gestellt haben, und diejenigen, die sie hierher gebracht haben, aus derselben Gruppe stammen, dann muss ihr Ziel Fabella sein und nicht Skuld selbst.")
	await novel_interface.show_text_only("Wenn sie nicht derselben Gruppe angehören, könnte sie selbst das Ziel sein – wer auch immer sie wollte, hat versagt und hält derzeit Fabella und Pater Anton als Geiseln.")
	await novel_interface.show_text_only("Egal was es ist, ihr Lieblingsmensch auf der Welt ist in Gefahr.")
	await novel_interface.show_text_only("Wenn letzteres der Fall ist, kann sie jedoch nicht einfach selbst nach Fabella suchen. Es würde bedeuten, direkt in eine Falle zu tappen, und sie würde wahrscheinlich auch als Geisel enden, die die Entführer gegen Vater und das Komitee verwenden können.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Kannst du zuerst etwas für mich tun? Ich brauche jemanden, der nach Pater Anton von der Trinity Church schaut und mir sagt, ob er in Sicherheit ist.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Klar, ich schicke sofort jemanden.\nJetzt sag mir, was los ist.","Vater")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella und ich wurden vor nicht allzu langer Zeit in der Nähe der Botschaft überfallen. Sie haben wahrscheinlich eine Art Halluzinogen oder mit Substanz H hergestellte Drogen verwendet.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Was?","Vater")
	await novel_interface.show_text_only("Der Einsatz chemischer oder mit Substanz H hergestellter Waffen auf einem internationalen Territorium kommt in etwa einer Kriegserklärung gegen den Vereinigten Kongress gleich.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella riskierte ihr Leben, um mich zu retten. Ich weiß nicht, wo sie jetzt ist...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Diese Typen müssen mir eine SMS geschickt haben, in der sie sich als Pater Anton ausgeben, und mich dorthin gelockt haben.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… ich verstehe.","Vater")
	await novel_interface.show_dialog("Das Friedensforum findet nächsten Monat statt ... warum mussten Sie zu einem so sensiblen Zeitpunkt nach New Opulentia gehen ...?","Vater")
	await novel_interface.show_dialog("Wer dies wagen würde, würde auf jeden Fall sehr vorsichtig mit seiner Identität sein.","Vater")
	await novel_interface.show_dialog("Obwohl Fabellas Ex-Chef in Südamerika verstorben ist, hat er immer noch einige Feinde ...","Vater")
	await novel_interface.show_dialog("Wie auch immer, wo bist du jetzt?\nIch werde etwas mit ausländischen Verwandten vereinbaren und dich zurück nach Newmoridas bringen.","Vater")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Du musst es mir zuerst versprechen! Versprich mir, dass du Fabella rettest!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skulds Stimme zittert, seine Augen sind voller Tränen.")
	await novel_interface.show_dialog("…","Vater")
	await novel_interface.show_text_only("Am anderen Ende der Leitung herrscht Stille.")
	await novel_interface.show_text_only("Skuld weiß, dass ihr Vater äußerst kompetent und immer gut informiert ist. Er wäre in der Lage, die Situation leicht zu analysieren und die beste Vorgehensweise zu entscheiden.")
	await novel_interface.show_text_only("Ihr Vater ist Gründer eines Hedgefonds-Unternehmens, das während des Krieges aufgrund seiner hervorragenden Entscheidungskompetenz auf dem Finanzmarkt florierte. So sicherte er sich einen Platz im Komitee.")
	await novel_interface.show_text_only("Aber dadurch erlangte er auch unzählige Feinde. Der Rückgang von Aktien ist schließlich etwas ganz anderes als der Sturz eines Landes.")
	await novel_interface.show_text_only("Skuld wuchs in einer Umgebung voller Hass und Gefahr auf. Aber ihr Vater war seltsam hartnäckig und weigerte sich, sein Verhalten gegenüber seiner Tochter zu ändern.")
	await novel_interface.show_text_only("Es könnte etwas mit ihrer Mutter zu tun haben, die gestorben war, als sie noch sehr jung war.")
	await novel_interface.show_text_only("Plötzlich bemerkt Skuld einen kleinen roten Rahmen auf dem Display ihres Telefons.\nDies zeigt an, dass ihr Standort während des Anrufs verfolgt wird.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie legt sofort auf.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Sie haben jetzt meinen Standort! Ich muss hier raus...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld rennt in das Treppenhaus eines nahegelegenen Parkhauses.")
	await novel_interface.show_text_only("Sie ruft in ihren Kontakten die Nummer eines Waschsalons auf. Fabella hatte ihr diese Nummer als letzten Ausweg gegeben.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Ich schätze, ich habe jetzt keine Wahl!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Auf der Treppe kauernd wählt das Mädchen die Nummer.")
	await novel_interface.show_text_only("Nach dreimaligem Klingeln meldet sich eine nette Dame.")
	await novel_interface.show_text_only("Rexhill Waschsalon. Gerne bedienen wir Sie.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Ich bin Skuld Axelrod, internationale ID-Nr. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Verstanden. Bitte warten...")
	await novel_interface.show_text_only("Fräulein Axelrod, Ihre Wäsche ist fertig. Sollen wir es Ihnen schicken?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Sicher. Meine Freundin in der New Opulentia Memorial Church muss übrigens ihre Wäsche abholen.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Verstanden.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Ich bin bei –","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir wissen, wo Sie sind. Bitte haben Sie etwas Geduld.")
	await novel_interface.show_text_only("Die Dame legt auf.")
	await novel_interface.show_text_only("Zehn spannende Minuten später rollt ein schwarzer SUV auf den Parkplatz.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Guten Tag, Fräulein Axelrod.","SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Kommst du von... SID?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Ja. Wir haben Ihren Freund bereits zurückgeholt.","SID Agent")
	await novel_interface.show_dialog("Bitte steigen Sie ein.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
