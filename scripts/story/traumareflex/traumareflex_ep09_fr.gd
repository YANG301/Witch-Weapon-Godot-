# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("—Quoi ? Le suspect est mort ?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Notre cible avait transformé sa maison en une véritable forteresse. Et il a tiré sur l’équipe de récupération comme un fou avec des armes lourdes dès leur arrivée.","SID Agent")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("L’équipe de récupération ne devrait-elle pas être équipée uniquement d’armes non létales ? Pourquoi la cible est-elle morte ?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("L’équipe n’a pas blessé mortellement la cible.","SID Agent")
	await novel_interface.show_dialog("Au lieu de cela, la cible semble être décédée soit d'une surdose de produits neuropharmaceutiques, soit d'une perte de sang.","SID Agent")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("... Je vois. Vous pouvez y aller maintenant.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Oui, patron.","SID Agent")
	await novel_interface.show_text_only("Mariru feuillette les dossiers du suspect, l'air très ennuyée, quand Aya entre dans la salle de contrôle.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ren est-il là maintenant ?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Ouais. Tout semble assez stable.","Aya") #文字错误
	await novel_interface.show_dialog("S'agit-il des... résultats de l'autopsie du suspect ?","Aya")
	await novel_interface.show_dialog("Antonio Jose Urquiza... un chef de guerre mafieux qui était très actif en Amérique du Sud pendant la guerre de Sept Ans. Pour l’instant, il n’est qu’un petit chef de gang.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Dommage que les drogues lui aient à peu près grillé le cerveau... ou nous aurions pu essayer de l'interroger avec cet appareil.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya murmure en feuilletant sa pile de dossiers.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("L'Amérique du Sud... donc la cible était vraiment Fabella, hein ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Nous ne pouvons pas encore en être sûrs.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru secoue la tête, le visage sombre, alors qu'elle étudie le profil cible affiché à l'écran.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Un petit nombre de marqueurs radioactifs ont été détectés dans le dispositif de distribution de produits chimiques que nous avons trouvé dans l'église.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Et à partir de là, nous avons facilement trouvé un autre emplacement avec les mêmes marqueurs radioactifs... juste à l'intérieur de New Opulentia.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Ah ? C’est donc presque comme si le coupable ne prenait même pas la peine de se cacher.","Aya")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est pourquoi je trouve cela si suspect...","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Antonio... ce mec a-t-il une raison de blesser Fabella ?","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ouais, et quel motif...","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Au cours de la deuxième année de la guerre, l'économie de l'Amérique du Sud s'est effondrée. Ce qui s'est ensuite passé, c'est que les gangs ont envahi la scène politique avec leurs conflits et leurs petites bagarres.","Mariru")
	await novel_interface.show_dialog("Fabella, qui a perdu ses parents pendant la guerre, a été adoptée par un colonel et a grandi dans un environnement militaire strict.","Mariru")
	await novel_interface.show_dialog("Elle arbora bientôt des instincts de combat bestiaux et devint la plus jeune garde nationale de l'histoire.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("J’ai entendu dire qu’elle s’était infiltrée une fois, seule, en territoire ennemi et avait assassiné silencieusement le commandant – qui se trouvait être le fils aîné d’Antonio.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Voilà en effet un motif.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru évoque le portrait d'un homme, vêtu d'une tenue militaire, et fait des gestes vers l'écran.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'était le colonel qui a adopté Fabella : Carlos Branco.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Vous voulez dire « Boucher de la rivière Churun ​​» Branco ?","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le massacre de la rivière Churun ​​s'est produit peu de temps après que les six villes universitaires ont formé le Congrès uni.")
	await novel_interface.show_text_only("46 000 civils ont été exécutés par le fleuve, leur sang teintant en rouge les chutes Salto Ángel en aval.")
	await novel_interface.show_text_only("C'était partout dans l'actualité ces quelques semaines. L’opinion commune voulait que Carlos Branco, le chef de guerre le plus puissant de l’époque, soit derrière tout cela.")
	await novel_interface.show_text_only("Les images grotesques de l'incident ont suscité un sentiment anti-guerre généralisé dans le grand public, et Branco était depuis lors connu comme le boucher de la rivière Churun.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Bientôt, le Congrès uni a pris des mesures militaires contre Carlos Branco, le condamnant pour ses crimes anti-humanitaires et raciaux.")
	await novel_interface.show_text_only("Finalement, un Lancer Penetrator a fait exploser la grotte dans laquelle Branco se cachait, mettant ainsi fin à l'ère des gangs monopolisés en Amérique du Sud.")
	await novel_interface.show_text_only("Cela a mis le Congrès uni dans les bons livres de la plupart des gens. Ils étaient perçus par le grand public comme un symbole de paix et de justice. Suite à leur succès, les six nations participant au Congrès ont été renommées Villes Académies.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—C'est du moins la version officielle imprimée sur les livres d'histoire.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sourit et Aya hoche la tête avec compréhension.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Après cela, les six seigneurs de guerre restants en Amérique du Sud ont tout simplement disparu d'un seul coup, comme s'ils étaient sous une sorte d'accord. Le Congrès uni s'empara bientôt de leur territoire.","Aya")
	await novel_interface.show_dialog("Vous savez ce qui s’est réellement passé, n’est-ce pas ?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya demande, se penchant près de Mariru et lui poussant la taille avec un coude, comme un chat curieux.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ouais. Le massacre a réellement eu lieu, mais ceux qui sont morts venaient des territoires des six seigneurs de la guerre.","Mariru")
	await novel_interface.show_dialog("Ils ont accepté d'envoyer ces gens vers la rivière, et... vous savez ce qui s'est passé ensuite.","Mariru")
	await novel_interface.show_dialog("Quelqu'un les avait soudoyés pour qu'ils fassent cela.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Le seul qui a refusé d'accepter le pot-de-vin était Carlos Branco.","Mariru")
	await novel_interface.show_dialog("C'est ainsi qu'il a reçu le rôle du « mal nécessaire » dans notre monde actuel.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Alors ceux qui ont soudoyé les chefs de guerre...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya regarde fixement, les yeux écarquillés. La réponse n’est que trop claire.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Ces chefs de guerre qui ont disparu ont dû simplement déménager ailleurs, changer de nom et avoir passé le reste de leur vie à dépenser l'argent qu'ils recevaient.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quant à la preuve de la culpabilité de Branco... elle doit avoir été forgée pour les soldats de la sécurité par le Congrès uni lui-même.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Si le Congrès uni se rend compte qu’Antonio est de retour pour se venger, il voudrait en finir le plus vite possible.","Aya")
	await novel_interface.show_dialog("Pas étonnant que toute cette situation semble si gênante.","Aya")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah ? Gênant comment ?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Les hallucinogènes que nous avons trouvés dans le sang de la cible sont du même type que ceux que nous avons trouvés sur Fabella.","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je le savais.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Et nous avons trouvé un type de stimulant, celui que les chefs de guerre utilisaient souvent pour maintenir leurs soldats en alerte. C’était en fait la véritable raison de la mort d’Antonio.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C’est aussi dans le rapport.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Le stimulant rend hypersensible celui à qui on l'injecte. Ils entendront davantage, ressentiront davantage.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Il y en a tellement dans son sang que s’il était touché par une balle en caoutchouc, cela lui ferait probablement aussi mal que d’être touché par un coup de canon.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mais pendant la vingtaine de minutes où les deux camps se tiraient dessus, la cible a été touchée à plusieurs reprises...","Mariru")
	await novel_interface.show_dialog("La cible est bien visible depuis la cinquième minute dans les images de la scène. Et il ne s’est jamais rien injecté.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ils n’ont également trouvé aucune lésion dans son système nerveux lors de l’autopsie.","Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("D-est-ce que ça veut dire que ce type aime vraiment vraiment la douleur ? Wow, le masochiste ultime...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru enroule rapidement du papier et frappe Aya sur la tête, comme si elle avait fait ça toute sa vie.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Oh... de toute façon, ont-ils déjà découvert qui avait amené Skuld au parc ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Qui que ce soit, il est resté à l'écart de toutes les caméras de surveillance. Un exemple classique d’un excellent kidnappeur.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Quelqu'un qui connaît les emplacements des caméras de surveillance... et qui pourrait se promener en ville avec une fille sur le dos, sans être perçu comme suspect...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ouais. Ces indices sont tout ce que nous avons.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se gratte le menton, plongée dans ses pensées.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si Antonio était en réalité un bouc émissaire, soigneusement choisi pour agir comme le « coupable »...","Mariru")
	await novel_interface.show_dialog("Alors, celui qui est derrière tout cela s'en prend probablement à Fabella – ou, plus précisément, à ses pouvoirs de sorcière.","Mariru")
	await novel_interface.show_dialog("Je ne pense pas qu’ils aient obtenu ce qu’ils voulaient.","Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Mais c'est un spécimen assez précieux, alors au lieu de la tuer sur-le-champ, ils ont décidé de la laisser là-bas pour que le Congrès uni la capture...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("C’est donc pour cela qu’ils ont utilisé un « bouc émissaire » si précieux ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Eh bien, c'est une sorcière possédée par la magie du feu, alors...\nHmm, attendez, \"informations avec volonté\"...","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Des informations... ?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les yeux choqués de Mariru rencontrent ceux d'Aya. Ils sont arrivés à la même conclusion.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si ce que ces ravisseurs voulaient réellement, c'était voler les informations contenues dans la tête de Fabella...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Ils utilisent peut-être le même type d’équipement que nous utilisons également. Harima Tech avait conçu ces dispositifs de piratage cérébral sur la base de certains articles publiés accessibles au grand public.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Dans ce cas, ils ont probablement rencontré le même problème que nous.","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("Les quatre premiers agents qui ont tenté de pirater le cerveau de Fabella se sont heurtés au même mur sans fin.")
	await novel_interface.show_text_only("Comme un pare-feu qui empêche les intrus d'entrer.")
	await novel_interface.show_dialog("S'il s'agit d'un type de pare-feu offensant :","Aya")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aya, prépare-toi à réveiller Ren dès que je donne les ordres.","Mariru")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
