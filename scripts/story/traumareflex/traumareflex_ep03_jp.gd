# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("ねぇ……こんな経験した事はない？")
	await novel_interface.show_text_only("ある光景を急に思い出すんだけど、\nいつの記憶なのか思い出せない。")
	await novel_interface.show_text_only("それは多くの人が経験する「デジャブ」と\n呼ばれる体験とはちょっと違う。")
	await novel_interface.show_text_only("ずっと前から起きる事を知っていて、\n最終的には答えが証明されるような感じ。")
	await novel_interface.show_text_only("あなたはそれを予知していて、\nさらにフラッシュバックのような映像を見る。\nただ、その時には確認のしようがない。")
	await novel_interface.show_text_only("いわゆる「デジャブ」は、予測に対する\n単なる検証に過ぎないから。")
	await novel_interface.show_text_only("あなたは、こうなる事を知っていた──")
	await novel_interface.show_text_only("──そうでしょう？")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("う……ん……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髪の少女がぼんやりと意識を取り戻す。\n\n目を擦ってから、ようやく自分がベンチに\n横たわっている事に気付いた。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("ファビオラ……ここはどこなの？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("常に寄り添ってくれていたメイドが、\nいつものように自分の前に現れてくれない。")
	await novel_interface.show_text_only("誰もいない道の両側に、点々と並ぶ街灯の列が\n遠方へと伸びていく。\n少女は浮世離れした妙な静けさを感じ取る。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("あたしは……さっきまで教会に……","スクルド")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("ファ、ファビオラッ！！！？？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("強烈な頭痛を堪えながら、すぐにスクルドは\nベンチから立ち上がった。")
	await novel_interface.show_text_only("まるで悪夢を見ていたかのような時間だった。\n\nあのステンドグラスが歪んだ時の恐怖が、\n未だ深く脳裏へと刻み込まれている。")
	await novel_interface.show_text_only("最後、ファビオラが自分を暗闇から\n救い出してくれた……")
	await novel_interface.show_text_only("スクルドは所持品をチェックする……\n\n携帯電話、財布、アクセサリーも全て無事。")
	await novel_interface.show_text_only("携帯を取り出すと、32件の不在着信があった。")
	await novel_interface.show_text_only("ファビオラのアンチ追跡ソフトをインストール\nしていたから──\n大使館の人は探しに来られなかったのだろう……")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("22時18分……もうこんな時間？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女はベンチに座り、目を閉じて呼吸を整える。\n\n混乱していた記憶と情報を整理しようとする。")
	await novel_interface.show_text_only("以前、パパとファビオラから教わった──\n\n複雑で危険な状況に直面している時こそ、\n冷静さを保たなければならない。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("あの教会と……アントン神父からのメッセージは\nあたしに対する罠だった。","スクルド")
	await novel_interface.show_dialog("そう考えると「相手」の狙いは、\nあたし、パパ、あるいはファビオラの3つ。","スクルド")
	await novel_interface.show_dialog("近くの道路から車の声が微かに聞こえるし、\n遠くからもストリートバンドの演奏が聞こえる。\nどうやら監禁されているわけではないみたい。","スクルド")
	await novel_interface.show_dialog("携帯の位置情報によれば、\n今私がいるのは新井セントラルパーク。\nあの教会から2キロ圏内の場所……","スクルド")
	await novel_interface.show_dialog("──あたしをここに運んできた人に、\n敵意はないはずよ。","スクルド")
	await novel_interface.show_dialog("けど罠を仕掛けた人と、あたしを運んできた人が\n同じ勢力かどうかは分からない……\n……無闇に戻るわけにはいかないわ。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラの番号に電話をしてみるが\nやはり繋がらない。\n失神している間に彼女から連絡が有ったかもと、\n履歴を調べたが痕跡は何一つ存在しなかった。") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("ファビオラ……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は携帯を握りしめ、父親の番号を押す。")
	await novel_interface.show_text_only("電話は即座に繋がり、受話器の向こうから\n焦りと心配の交ざった声が聞こえてきた。")
	await novel_interface.show_dialog("もしもしっ？　スクルドかっ？","父親")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("パパ……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("どこへ行ってたんだッ！　連絡もせずに！\nそっちはもう夜の10時を過ぎているだろう！？","父親")
	await novel_interface.show_dialog("あのメイドも電話を取らずで、\nいなくなったと思ったらこんなに遅くまでッ！\nハグディー大使は今、お前の捜索命令を\n出しているのだぞ……ッ！","父親")
	await novel_interface.show_text_only("父親から頭ごなしに怒鳴りつけられたが、\nスクルドは少しだけほっとした──")
	await novel_interface.show_text_only("今の反応からすれば、ここ数時間以内で彼が\n誰かから脅迫をされていないという事だ。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("あたしは今のところ安全だわ。\nでも聞いて欲しいの──","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("娘の厳粛な口調を聞いて、電話の向こう側にいる\n父親はすぐに問題に気付く。")
	await novel_interface.show_dialog("……そこに誰かいるのか？","父親")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("いないわ、あたしだけよ。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("分かった。\n電話を変えてかけ直す。","父親")
	await novel_interface.show_text_only("電話を切るとすぐに「非通知番号」から\n着信がきた。")
	await novel_interface.show_dialog("よし。一体何があったんだ？","父親")
	await novel_interface.show_text_only("スクルドはもう一度深呼吸をする。\n\n今持っている情報から推察すると、\n2つの可能性が考えられる──")
	await novel_interface.show_text_only("罠を仕掛けた人間と、自分をここへ運んできた\n人間が同じ勢力の者だとすれば、\n彼らの目標は最初からファビオラだった。")
	await novel_interface.show_text_only("それぞれが別の勢力だとすれば、相手の目標は\nまだ達成されていないはず。\nファビオラとアントン神父を捕らえられたとして\nその目的は交渉用の人質だろうから。")
	await novel_interface.show_text_only("しかし、どちらにせよ今は自分にとって\n一番大事な人が危険にさらされている……")
	await novel_interface.show_text_only("だからと言って焦ってはいけない。後者の場合、\n自分ひとりでファビオラを捜索などすれば、\n自ら網にかかりに行くのと同義。相手に父親と\n理事会を脅迫するチャンスを与えてしまう。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("まず、最初にして欲しい事があるの。\n\nトリニティ大聖堂のアントン神父の安否を\n確認して。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("分かった、すぐに確認させる。\n今はどんな状況だ？","父親")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("さっきファビオラと大使館付近で待ち伏せに\nあったの。\n相手は幻覚作用のある薬剤か、異質物武器を\n使っていたと思う。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("なに――ッ！！？","父親")
	await novel_interface.show_text_only("国際領土で化学兵器または異質物兵器を使用し、\nさらに背後に支援者がいるともなれば、\n連合議会に宣戦布告したも同然だ。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("ファビオラは命がけであたしを助けてくれたの\nだけど、彼女自身が行方不明になっているわ……","スクルド")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("相手はアントン神父を装い……\nメッセージを送ってあたしを誘い出してきたの。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……事情は分かった。","父親")
	await novel_interface.show_dialog("来月には平和フォーラムが開かれる。\n\nだからあれほど言ったじゃないか……この危ない\n時期に新豊洲に行くのはよしなさいと……","父親")
	await novel_interface.show_dialog("こんな事をする連中だ、自分達の身元を隠すため\n細心の注意を払っているはず。","父親")
	await novel_interface.show_dialog("ファビオラが狙われたと言う可能性も\n考えられるな……\n彼女が南米で世話になっていた長官は、\n消えた現在になっても依然として敵が多い。","父親")
	await novel_interface.show_dialog("お前は今どこにいるんだ？\n\n後は私が何とかするから、外交ルートを通じて\nお前はニューモリダスに戻るんだ。","父親")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("その前にあたしと約束して、\n必ずファビオラを助けるって──","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドの声は震え、瞳の中は涙が揺らめく。")
	await novel_interface.show_dialog("…………","父親")
	await novel_interface.show_text_only("電話の向こうから、沈黙だけが返ってくる。")
	await novel_interface.show_text_only("彼女は自分の父親が優れている事は知っている。\n\nゆえに利害を分析し、計算上で最も優れた決断を\n下そうとしている事も分かっている。")
	await novel_interface.show_text_only("彼女の父親は、とあるヘッジファンド運用会社の\n創始者だ。\n戦争中に金融市場で思い切った決断を行い\n「理事会」への入会資格を獲得した。")
	await novel_interface.show_text_only("しかし平常時に株式を空売りするのと、\n戦時中に国を1つ空売りするのではわけが違う。\nそれが原因で彼は恨まれた。\n膨れ上がる敵の数が、何よりの証拠だ。")
	await novel_interface.show_text_only("憎悪と陰謀が渦巻く環境下で\nスクルドは育ってしまう。\nそれでも彼は家族のために行動やスタイルを\n変えたりはしない。\n父親は自分の意思を貫き続ける人間だった。")
	await novel_interface.show_text_only("過去に亡くした母親が原因で、その生き方に\n括っているのかもしれない……")
	await novel_interface.show_text_only("ふと携帯電話の画面上に、小さな赤い枠が\n点灯している事に気が付く。\nそれは通話中に位置が特定されているサイン──")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("────ッ！！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女はすぐさま電話を切った。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("位置が気付かれたの？\nすぐにここから離れないと……","スクルド")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("スクルドは近くにある駐車場の階段まで走る。")
	await novel_interface.show_text_only("この時、彼女の携帯電話に表示されていたのは\n電話帳にあるクリーニング屋の番号だった。\nファビオラが彼女に渡した『最後の保険』だ。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("……賭けるしかないっ！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は階段でしゃがみ込んで、電話をかける──")
	await novel_interface.show_text_only("ベルが3回鳴ると、優しい女の声が電話から\n聞こえてきた。")
	await novel_interface.show_text_only("お電話ありがとうございます。\nレイヒールクリーニングです。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("……あたしはスクルド・エクスロッド。\n外交識別コードはAX1832。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("はい。少々お待ちください……")
	await novel_interface.show_text_only("お待たせしました。\nお召し物のクリーニングは完了しております。\n直接の配送でよろしいでしょうか？")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("うん、新豊洲記念教会に友達もいるの。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("承知いたしました。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("あたしの位置は……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("場所は存じ上げております。\n少しの間ご辛抱ください。")
	await novel_interface.show_text_only("電話は切れた。")
	await novel_interface.show_text_only("──10分後。\n\n黒色のSUVが群を成して駐車場に入ってくる。")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("こんばんは、エクスロッドさん。","SID特工")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("あなた達は……SIDの人？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("ええ、あなたのご友人もすでにこちらで\n回収しました。","SID捜査員")
	await novel_interface.show_dialog("さぁ、どうぞお乗りください。","SID捜査員")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
