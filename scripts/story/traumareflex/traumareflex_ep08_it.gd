# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Questo mondo è crudele.")
	await novel_interface.show_text_only("La guerra di dieci anni fa ci ha lasciato poco con cui vivere.")
	await novel_interface.show_text_only("C'erano tantissimi ragazzi come me nell'orfanotrofio, ma pensavo comunque di essere il meno fortunato.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Forse sentivo che ciò che avevo perso era la cosa più importante. Ma forse il fatto di averli persi li ha resi ancora più importanti?")
	await novel_interface.show_text_only("Tuttavia per me, rifugiato protetto sotto l'egida, era difficile immaginare:")
	await novel_interface.show_text_only("Come sarebbe la vita, per coloro che dovessero continuare a sopravvivere sul campo di battaglia dopo aver perso i loro cari.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Uff... uff...")
	await novel_interface.show_text_only("Uff... uff...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Esco barcollando dal fumo pesante e mi accascio dietro un'auto sul ciglio della strada, respirando affannosamente nella maschera.")
	await novel_interface.show_text_only("Il terreno è ricoperto di macerie. Urla e rumori di esplosioni sembrano provenire da ogni direzione.")
	await novel_interface.show_text_only("Attraverso le fiamme e il fumo riesco ancora a distinguere la colorata pubblicità proiettata sullo schermo di un grattacielo lontano.")
	await novel_interface.show_text_only("Sembra tutto così... surreale.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Chissà quante esperienze di questo tipo esistono nei ricordi di Fabella...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La sua vita è così diversa dalla mia.")
	await novel_interface.show_text_only("Dopo essermi unito al SID ho seguito un po' di formazione, ma riguardava principalmente le tattiche e la manipolazione delle informazioni.")
	await novel_interface.show_text_only("Non sono mai stato in una vera esercitazione con pistole e proiettili veri. Anche quando facevamo pratica di tiro al bersaglio, gravitavo verso le poche armi più piccole con il rinculo più debole. Mariru e Annie ridevano sempre di me.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Se solo Annie fosse qui...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Uhm. Questa pistola che ho in mano... è una KRISS?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un fucile mitragliatore KRISS Vector, noto per il suo rinculo ridotto. I proiettili sono subsonici, di tipo silenzioso. Non c'è da stupirsi che Mariru la chiami una pistola ad acqua per idioti.")
	await novel_interface.show_text_only("... Ehi, non a tutti piace portare armi pesanti come a lei, sai?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Quest'arma... non è poi così male, forse riesco a farcela...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Guardo il caricatore esteso sul fondo e deglutisco.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Nah. Meglio tenere la sicurezza spenta per ora. Non voglio colpire un alleato.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sbircio fuori, cercando di osservare la situazione là fuori.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, va tutto bene laggiù?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("L'autista è morto! Aspetta... che diamine?\nOh mio Dio, amico, respira ancora!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Mettigli una maschera antigas sul viso e gettalo nel bagagliaio. Quindi prendi la tua attrezzatura e cerca riparo!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I membri della squadra non esitano. Fabella, con in mano una borsa nera, salta dall'altra parte dell'auto dietro la quale mi nascondo.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Wow, non posso credere ai miei occhi... si muove così velocemente!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel posiziona il ponte superiore che era volato via nell'esplosione accanto a una pila di pietre, creando una zona cieca che può usare come copertura, e si fa strada barcollando attraverso la strada.")
	await novel_interface.show_text_only("Pochi secondi dopo, un enorme zaino cade dal nulla dal fumo, poi Cassel passa oltre e scompare rapidamente nell'ombra all'angolo.")
	await novel_interface.show_text_only("Questa situazione è probabilmente un gioco da ragazzi per i membri delle squadre speciali come questi ragazzi. Dopotutto hanno tutti combattuto in prima linea.")
	await novel_interface.show_text_only("Ma questa volta, invece che in una zona di guerra, stanno combattendo nella Seconda Città Accademia.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Fai attenzione alle truppe meccaniche e invia un drone per esplorare l'ambiente.\nRussel, sei già entrato in contatto con il Team Alpha?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Nessuna risposta. Sono dall’altra parte dell’esplosione, insieme al nostro “bagaglio”.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguo lo sguardo di Russel. La strada più avanti è stata ridotta in mille pezzi ordinati, mentre noi siamo bloccati da qualche parte vicino al centro della strada.")
	await novel_interface.show_text_only("Il catrame sul terreno sta bruciando come nessun domani, rendendo difficile dire cosa sta succedendo più avanti.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Qualcuno ha seppellito qui le bombe prima?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Ehi! Principiante! Pensi davvero che sia sicuro nascondersi lì?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—Eh?\n(Sta parlando con me?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima ancora che io possa reagire, Fabella mi ha preso per il bavero della giacca e mi ha trascinato nell'ombra dietro il bancomat a lato della strada.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Andiamo, è troppo facile per il nemico portarti lì. E non sai da dove spareranno.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che io possa formulare una risposta, lei fa un gesto a Russel, che è dall'altra parte della strada, mentre Russel risponde con il pollice in su.")
	await novel_interface.show_text_only("Pochi secondi dopo, un oggetto volante grigio a forma di disco si alza da dietro l'auto dove è nascosto Russel.")
	await novel_interface.show_text_only("Fabella tira fuori dalla cintura un piccolo tablet e inizia a studiare la veduta a volo d'uccello della zona ripresa dal drone.")
	await novel_interface.show_text_only("I due SUV che guidano la truppa ormai non sono altro che fumanti palle di fuoco.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Quelle guardie di sicurezza... probabilmente tutte morte. Almeno il Team Alpha e il “bagaglio” erano dietro di noi...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso lo schermo del tablet svanisce in uno stato statico, seguito da un \"boom\" assordante.")
	await novel_interface.show_text_only("Con un debole suono sibilante, il ronzio grigio brucia nel cielo.")
	await novel_interface.show_text_only("I suoi piccoli componenti scendono a pioggia, sbattendo contro i tetti delle auto intorno a noi con clangori metallici.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Un cecchino?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Deve essere nell'edificio di fronte. Probabilmente utilizzando un dispositivo di accelerazione elettromagnetica antispionaggio a breve distanza. Guarda dove ti nascondi. Assicurati che l'ostacolo che scegli sia abbastanza spesso.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È un dispositivo che viene fornito con proiettili metallici accelerati costantemente dall'energia elettromagnetica. Estremamente potente, anche se il dispositivo è solitamente ingombrante e difficile da trasportare.")
	await novel_interface.show_text_only("Quei proiettili possono penetrare ostacoli molto spessi. Durante la guerra, un Primo Ministro fu ucciso da un uomo a più di 0,3 miglia di distanza, anche se si trovava dietro un muro di cemento spesso un metro. Fu così che questo tipo di dispositivo di cecchino completo ottenne la sua fama diffusa.")
	await novel_interface.show_text_only("Cose del genere in realtà non facevano parte della mia formazione, semplicemente le conosco perché, beh, sono in uno dei miei giochi preferiti. Viene fornito anche con una skin esclusiva, ad un prezzo esorbitante.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("L'occhio è abbassato! Ripeto, l'Occhio è abbassato!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Il cecchino dovrebbe trovarsi a circa mezzo miglio di distanza da noi. Abbiamo un altro drone con una superficie rifrangente e su cui è montato un occhio che tutto vede. Probabilmente non se ne accorgeranno se lo inviamo.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Aspetta, l'Occhio che tutto vede... il raggio della sua lente è di 15 mm, giusto?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiede Fabella, osservando con un riflettore l'edificio ben illuminato di fronte.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("L'obiettivo può ancora riflettere la luce, quindi. Anche quando è notte. Non possiamo coprirlo esattamente con una superficie che rifrange la luce.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Quindi possono ancora individuare il drone, eh... E non possiamo aprire il fuoco sull'edificio in quel modo. È un edificio residenziale comune e lì vivono persone innocenti.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Per un cecchino che lavora con un equipaggiamento ingombrante che richiede molto tempo per ricaricarsi, la priorità è non essere individuato dal nemico (noi).")
	await novel_interface.show_text_only("Ricordo di averlo imparato durante l'addestramento tattico.")
	await novel_interface.show_text_only("Però ricordo anche qualcos'altro dallo stesso libro di testo...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(La loro priorità è non farsi notare, è vero, ma anche... non dovrebbero anche cercare di non farci sapere della loro esistenza?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sparare al nostro drone, naturalmente, significa che sapremo della loro esistenza.")
	await novel_interface.show_text_only("Il che, ovviamente, li renderà un bersaglio. Chiunque sia deve essere un novellino che non sa cosa sta facendo...")
	await novel_interface.show_text_only("O qualcuno che è già sicuro di sapere dove girare la prossima volta e di poter evacuare immediatamente dopo aver finito il lavoro.")
	await novel_interface.show_text_only("Il mio cuore perde un battito.")
	await novel_interface.show_text_only("D'istinto mi alzo in piedi, costringendo Fabella a terra, lontano dal blocco dietro cui si nasconde.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Cosa stai facendo? Idiota—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il secondo successivo, il blocco su cui si era appoggiata esplode in pezzi.")
	await novel_interface.show_text_only("Dopo aver distrutto la copertura, il proiettile penetra nel muro dell'edificio, creando nel muro un rigonfiamento di nove piedi quadrati.")
	await novel_interface.show_text_only("I tabelloni accanto al bancomat vengono lanciati in aria. Innumerevoli banconote svolazzano nel cielo, per poi cadere a terra come fiocchi di neve, con i lampioni bianchi come sfondo.")
	await novel_interface.show_text_only("È come una scena uscita da un film noir.")
	await novel_interface.show_text_only("Guardo ipnotizzato, ma Fabella mi ha già stretto le gambe intorno alla vita, facendomi rotolare nell'ombra proiettata da una pila di mattoni di cemento.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Eh? Perché mi tiene fermo?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tutto bene, capo?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, sto bene.\nFortunatamente il nostro principiante è sveglio.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("risponde Fabella, dandomi una pacca sulle guance. Sarebbe sembrato un gesto dolce se non mi avesse cavalcato.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("E ho trovato un modo per evitare che l'obiettivo riflettesse la luce.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dice, allungandosi verso le mie cosce:")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
