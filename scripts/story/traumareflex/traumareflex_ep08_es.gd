# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Este mundo es cruel.")
	await novel_interface.show_text_only("La guerra de hace diez años nos dejó poco para vivir.")
	await novel_interface.show_text_only("Había toneladas de niños como yo en el orfanato, pero todavía pensaba que era el menos afortunado.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Quizás sentí que lo que perdí era lo más importante. Pero entonces, ¿tal vez el hecho de que los perdí los hizo aún más importantes?")
	await novel_interface.show_text_only("Aún así, era difícil para mí, un refugiado protegido bajo la Égida, imaginar—")
	await novel_interface.show_text_only("Cómo sería la vida, para aquellos que tuvieron que seguir sobreviviendo en el campo de batalla después de perder a sus seres queridos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Buf... buf...")
	await novel_interface.show_text_only("Buf... buf...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Salgo tambaleante del denso humo y me dejo caer detrás de un automóvil al costado de la carretera, respirando con dificultad a través de mi máscara.")
	await novel_interface.show_text_only("El suelo está cubierto de escombros. Gritos y sonidos de explosiones parecen venir de todas direcciones.")
	await novel_interface.show_text_only("A través de las llamas y el humo, todavía puedo distinguir el colorido comercial que se reproduce en la pantalla de un rascacielos lejano.")
	await novel_interface.show_text_only("Todo parece tan... surrealista.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Me pregunto cuántas experiencias de este tipo existen en los recuerdos de Fabella...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Su vida es muy diferente a la mía.")
	await novel_interface.show_text_only("Recibí algo de capacitación después de unirme a SID, pero está principalmente relacionada con tácticas y manipulación de información.")
	await novel_interface.show_text_only("Nunca he estado en un simulacro real con armas y balas reales. Incluso cuando teníamos prácticas de tiro, me inclinaba hacia las pocas armas más pequeñas con el retroceso más débil. Mariru y Annie siempre se reían de mí.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Si tan solo Annie estuviera aquí...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Mmmm. Esta pistola en mi mano... ¿es una KRISS?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una metralleta KRISS Vector, conocida por su retroceso reducido. Las balas son subsónicas, de las silenciosas. No es de extrañar que Mariru llame a esto una pistola de agua para cobardes.")
	await novel_interface.show_text_only("... Oye, no a todo el mundo le gusta llevar armas grandes como a ella, ¿sabes?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Esta arma... no está tan mal, tal vez pueda manejarla...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro el cargador extendido en la parte inferior y trago.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(No. Será mejor que mantengas el seguro quitado por ahora. No quiero golpear a un aliado).","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me asomo, tratando de observar la situación que hay ahí fuera.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, ¿todo bien por allá?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡El conductor está muerto! Espera... ¿qué diablos?\n¡Dios mío, el tipo todavía respira!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Ponle una máscara de gas en la cara y tíralo al maletero. ¡Entonces toma tu equipo y busca cobertura!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los miembros del escuadrón no dudan. Fabella, que lleva una bolsa negra, salta al otro lado del auto detrás del cual me escondo.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Wow, no puedo creer lo que veo... ¡se mueve tan rápido!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel coloca la cubierta superior que había volado en la explosión junto a una pila de piedras, creando una zona ciega que puede usar como cobertura, y se abre camino cruzando la calle.")
	await novel_interface.show_text_only("Segundos después, una enorme mochila aparece de la nada entre el humo, luego Cassel pasa rodando y desaparece rápidamente entre las sombras de la esquina.")
	await novel_interface.show_text_only("Esta situación probablemente sea pan comido para miembros del escuadrón de operaciones especiales como estos tipos. Después de todo, todos han luchado en el frente.")
	await novel_interface.show_text_only("Pero esta vez, en lugar de una zona de guerra, están peleando en la Segunda Ciudad Academia.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Ten cuidado con las tropas mecánicas y envía un dron para explorar el entorno.\nRussel, ¿ya te pusiste en contacto con el Equipo Alfa?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("No hay respuesta. Están al otro lado de la explosión, junto con nuestro “equipaje”.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sigo la mirada de Russel. La calle más adelante ha sido destrozada en ordenados pedazos, mientras que nosotros estamos atrapados en algún lugar cerca del medio de la carretera.")
	await novel_interface.show_text_only("El alquitrán en el suelo arde como si no hubiera mañana, lo que hace difícil saber qué está pasando más adelante.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(¿Alguien enterró aquí las bombas de antemano?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("¡Oye! ¡Novato! ¿De verdad crees que es seguro esconderse allí?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—¿Eh?\n(¿Me está hablando a mí?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pueda reaccionar, Fabella me tomó por el cuello de la chaqueta y me arrastró a las sombras detrás del cajero automático al costado de la calle.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Vamos, es demasiado fácil para el enemigo llevarte allí. Y no sabes desde dónde dispararán.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pueda formular una respuesta, ella le hace un gesto a Russel, que está al otro lado de la calle, mientras Russel responde con un pulgar hacia arriba.")
	await novel_interface.show_text_only("Segundos después, un objeto volador gris en forma de disco se eleva desde detrás del automóvil donde está escondido Russel.")
	await novel_interface.show_text_only("Fabella saca una pequeña tableta de su cinturón y comienza a estudiar la vista de pájaro de la zona capturada por el dron.")
	await novel_interface.show_text_only("Los dos SUV que lideran la tropa ahora no son más que bolas de fuego humeantes.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Esos guardias de seguridad... probablemente todos estén muertos. Al menos el Equipo Alfa y el “equipaje” estaban detrás de nosotros...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, la pantalla de la tableta se desvanece en estática, seguida de un “boom” ensordecedor.")
	await novel_interface.show_text_only("Con un sonido débil y chisporroteante, el dron gris arde en el cielo.")
	await novel_interface.show_text_only("Sus pequeños componentes caen como una lluvia, golpeando los techos de los autos que nos rodean con ruidos metálicos.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... ¿Un francotirador?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Debe estar en el edificio de enfrente. Probablemente utilizando un dispositivo de aceleración electromagnética antiespionaje de corta distancia. Mira dónde te escondes. Asegúrate de que el obstáculo que elijas sea lo suficientemente grueso.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es un dispositivo que viene con balas de metal aceleradas constantemente por energía electromagnética. Extremadamente potente, aunque el dispositivo suele ser engorroso y difícil de transportar.")
	await novel_interface.show_text_only("Esas balas pueden atravesar obstáculos realmente gruesos. Durante la guerra, un Primer Ministro fue asesinado por alguien desde más de 0,3 millas de distancia, a pesar de que estaba detrás de un muro de cemento de un metro de espesor. Así fue como este tipo de dispositivo de francotirador integral obtuvo su fama generalizada.")
	await novel_interface.show_text_only("Cosas como esta en realidad no eran parte de mi entrenamiento, simplemente lo sé porque, bueno, está en uno de mis juegos favoritos. También viene con una piel exclusiva, por un precio desorbitado.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡El Ojo está caído! Repito, ¡el Ojo está caído!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("El francotirador debería estar aproximadamente a media milla de nosotros. Tenemos otro dron con una superficie refractiva y tiene montado un Ojo que todo lo ve. Probablemente no se darán cuenta si enviamos ese.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Espera, el Ojo que Todo lo Ve... el radio de su lente es de 15mm, ¿verdad?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunta Fabella, mientras observa el edificio brillantemente iluminado al otro lado con un reflector.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Entonces, la lente aún puede reflejar la luz. Incluso cuando es de noche. No podemos cubrirlo exactamente con una superficie que refracte la luz.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Entonces todavía pueden detectar el dron, eh... Y no podemos abrir fuego contra el edificio así como así. Es un edificio de residentes comunes y allí vive gente inocente.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Para un francotirador que trabaja con un equipo engorroso que tarda mucho en recargarse, la prioridad es no ser detectado por el enemigo (nosotros).")
	await novel_interface.show_text_only("Recuerdo haber aprendido sobre eso en el entrenamiento táctico.")
	await novel_interface.show_text_only("Sin embargo, también recuerdo algo más del mismo libro de texto...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(Su prioridad es no ser descubiertos, eso es cierto, pero también… ¿no deberían también tratar de no dejarnos saber nada sobre su existencia?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Disparar con nuestro dron, naturalmente, significa que sabremos de su existencia.")
	await novel_interface.show_text_only("Lo que, por supuesto, los convertirá en un objetivo. Quienquiera que sea debe ser un novato que no sabe lo que está haciendo...")
	await novel_interface.show_text_only("O alguien que ya está seguro de saber dónde disparar a continuación y puede evacuar inmediatamente después de terminar el trabajo.")
	await novel_interface.show_text_only("Mi corazón da un vuelco.")
	await novel_interface.show_text_only("Salto instintivamente, obligando a Fabella a caer al suelo, lejos del bloqueo detrás del cual se esconde.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("¿Qué estás haciendo? Idiota—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al segundo siguiente, el bloqueo en el que se había estado apoyando explota en pedazos.")
	await novel_interface.show_text_only("Después de destruir la cubierta, la bala penetra la pared del edificio, creando un bulto de nueve pies cuadrados en la pared.")
	await novel_interface.show_text_only("Los tableros del cajero automático son lanzados al aire. Innumerables billetes revolotean en el cielo y eventualmente caen al suelo como copos de nieve, con las luces blancas de la calle como telón de fondo.")
	await novel_interface.show_text_only("Es como una escena sacada directamente de una película negra.")
	await novel_interface.show_text_only("Miro, hipnotizado, pero Fabella ya ha sujetado sus piernas sobre mi cintura, enviándome rodando hacia las sombras proyectadas por una pila de ladrillos de cemento.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(¿Eh? ¿Por qué me está reteniendo?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Se encuentra bien, jefe?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, estoy bien.\nAfortunadamente, nuestro novato tiene rápido ingenio.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella responde, acariciando mis mejillas. Habría parecido un gesto dulce si ella no hubiera estado cabalgando sobre mí.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("Y encontré una manera de evitar que la lente refleje la luz.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella dice, alcanzando mis muslos—")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
