# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("Il momento in cui finirà il mondo?","Ren")
	await novel_interface.show_dialog("(Aspetta, quel disastro ha colpito il mondo intero?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ma il giorno dopo non sembravano tutti bene?")
	await novel_interface.show_text_only("L'unica cosa che \"è finita\" è stata la mia...")
	await novel_interface.show_dialog("(Cosa ho fatto per meritarmi questo?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Ma in quel ricordo, sei un ragazzo.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("...Eh?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Allora, lei è un maschio, signorina Ren?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Uh... Uhm...\nUh, io...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Titoli di notizie come \"Travestimenti maschili per intrufolarsi nel reparto ospedaliero femminile\" mi attraversano la mente.")
	await novel_interface.show_text_only("Skuld si avvicina di qualche centimetro, con un'aria incredibilmente compiaciuta, come se mi avesse appena sorpreso a fare qualcosa di illegale.")
	await novel_interface.show_text_only("Mi sento messo alle strette, come un cervo alla luce dei fari.")
	await novel_interface.show_text_only("Inconsciamente mi copro il petto e mi muovo all'indietro, e poi cerco di tenere abbassata anche la gonna...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Uffa, questa gonna è davvero troppo corta! Non riesco a farla stare ferma!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Uh, aspetta, per cosa sono così nervoso?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, andiamo, sono una ragazza!\nHahaha...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non assomiglio per niente a un ragazzo in questo momento. In nessun modo Skuld avrebbe potuto collegare il mio io attuale con la mia identità originale.")
	await novel_interface.show_text_only("Inoltre, Mariru ha fatto molto per coprire le mie tracce. Nemmeno la migliore agenzia di intelligence sarebbe in grado di dire chi ero.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Ma quella sagoma tra le rovine di New Opulentia... è sicuramente un ragazzo nei miei ricordi.","Skuld")
	await novel_interface.show_text_only("Skuld si mette davanti a me, studiando il mio viso con molta perplessità.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("E dopo un lampo di luce bianca, ho visto il tuo volto.","Skuld")
	await novel_interface.show_dialog("È durato meno di un secondo, ma non ricordo mai male.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Sei la persona nei miei ricordi.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi siedo lì, con la schiena appoggiata al muro, terrorizzato dall'aura imponente di questa ragazzina.")
	await novel_interface.show_text_only("Non c'è da stupirsi che in quei classici romanzi fantasy, non importa quanto sia grande il mondo, non possono mai esserci più di due profeti. L’autore non saprà cosa farne.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Questo tipo di abilità... è come imbrogliare, non è vero?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Tuttavia era solo un frammento. E i ricordi non sono sempre affidabili.","Skuld")
	await novel_interface.show_dialog("Immagino di non poter essere sicuro nemmeno se tu sia un maschio o una femmina, solo da quello sguardo nei miei ricordi.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza bionda si arrende un po', lasciandomi un po' di respiro.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Tuttavia, sono riuscito a confermarlo quando mi hai abbracciato poco fa. Il tuo corpo, la tua struttura, i tuoi capelli...","Skuld")
	await novel_interface.show_dialog("Non sono sicuro del perché, ma la signorina Ren è sicuramente una ragazza, almeno in questo momento.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("E si sentono... carini...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sorride maliziosamente.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Loro?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ha affondato la faccia nel mio petto perché voleva confermare se \"loro\" erano reali?")
	await novel_interface.show_text_only("E mi ha anche controllato i capelli...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Scommetto che Mariru mi rimprovererà più tardi per aver abbassato la guardia così facilmente!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld alza la testa e si schiarisce la voce.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Comunque... ci siamo scambiati dei segreti, quindi... adesso siamo amici, giusto?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chiede, cautamente, in attesa.")
	await novel_interface.show_text_only("Il mio cuore batte forte. Il mio istinto mi dice che sotto tutto questo c'è il vero Skuld, non mascherato, vulnerabile.")
	await novel_interface.show_text_only("Deve essere cresciuta in un mondo senza fiducia. È ancora così giovane... non può avere più di tredici anni...")
	await novel_interface.show_text_only("Anche se le sue capacità profetiche non sono così potenti, probabilmente ci sono tantissime persone che vorrebbero usarla.")
	await novel_interface.show_text_only("Se il suo segreto venisse fuori, sarebbe rovinata.")
	await novel_interface.show_text_only("Eppure, ha rischiato tutto e me lo ha detto, anche se potevo benissimo essere monitorato e indossare uno degli insetti di Mariru...")
	await novel_interface.show_text_only("Forse tutto ciò che voleva era un amico, qualcuno con cui potesse essere onesta.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Sì. Il tuo segreto è al sicuro con me.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alzo il mignolo.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Perché io sono... \"speciale\" per te, giusto?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wow, è così scadente...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld lo fissa e poi scoppia a ridere.")
	await novel_interface.show_text_only("Lo promettiamo.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Quando Aya entra nel bar, vede immediatamente Mariru sul divano accanto alla finestra, che fa roteare delicatamente il bicchiere di vino nella sua mano.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Le “misure di sicurezza” per il prototipo sono state configurate in base alle vostre richieste.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Abbastanza veloce, vero?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Volevi che tenessi traccia delle stimolazioni del nervo vago di Ren e che la scollegassi immediatamente dal sistema se si verificava qualcosa di anomalo. Non è un po’ violento, però?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("È una specie di miccia di sicurezza. Dopotutto, non sappiamo ancora molto su come funzionano i ricordi, almeno a livello scientifico.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("E chissà se è proprio come dicono i film... “ti si frigge il cervello se si presentano ricordi contraddittori”.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sembra piuttosto entusiasta di vedere il cervello di qualcuno che viene fritto.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Se conduciamo un esperimento su alcune dozzine di persone a caso, lo sapremo, giusto?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru alza il bicchiere, studiando la forma dei cubetti di ghiaccio al suo interno sotto l'illuminazione.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("No...","Mariru")
	await novel_interface.show_dialog("Anche se una persona possiede due serie di ricordi completamente contraddittori, troverà comunque un modo per razionalizzarli.","Mariru")
	await novel_interface.show_dialog("Ad esempio, ricordi di una vita passata o di un universo parallelo. O forse una sorta di epifania divina.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Chissà, potrebbero anche fondare una setta con questo tipo di conoscenza.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vero, ma...","Aya")
	await novel_interface.show_dialog("Ma non hai chiesto a quelli dell'Harima Tech di non stimolare la sua corteccia prefrontale, per mantenere tagliata l'area della memoria nel suo cervello?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Vuoi che lei dimentichi la maggior parte delle informazioni che aveva una volta svegliata, come se fosse tutto un sogno... giusto?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru si gira a guardare fuori dalla finestra le luci virtuali della città.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella era una scout quando era ragazzina. È stata allevata da un signore della guerra in Sud America.","Mariru")
	await novel_interface.show_dialog("Lei sa troppo, più di quanto possa sopportare.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ah?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Giusto, non hai detto a Skuld di convincere Ren a intraprendere questa missione? Ha funzionato?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Naturalmente. Quell'idiota non sarà in grado di dire di no a una ragazza carina.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Così semplice, così ingenuo. La invidio un po'.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ma aspetta, in tal caso, perché hai—","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya si ferma a metà della frase, rendendosi conto di avere già la risposta alla sua stessa domanda.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vuoi stabilire una sorta di \"punto di ancoraggio della memoria\" per Ren, eh?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorride e sorseggia con grazia dal suo bicchiere.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Il modo semplice è sempre il migliore, eh?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Sicuramente la vizi, vero?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eh. È ora, andiamo.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
