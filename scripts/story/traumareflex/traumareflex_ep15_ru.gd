# traumareflex_ep15.gd - 创伤反射篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第15话剧本
	traumareflex_ep15_script()

func play_script():
	pass

# 创伤反射篇第15话 - 正式剧本
func traumareflex_ep15_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Слепота Антона.")
	await novel_interface.show_text_only("Заболевание, при котором пациент, хотя и слеп, упорно верит, что все еще может видеть.")
	await novel_interface.show_text_only("Несмотря на то, что у пациента могут быть небольшие синяки на конечностях от столкновения с предметами, он все равно будет придумывать разные причины, чтобы объяснить это.")
	await novel_interface.show_text_only("Так устроен мозг. Он создает новые воспоминания, чтобы дать объяснение вещам, которые он не может понять.")
	await novel_interface.show_text_only("Это своего рода инстинкт самосохранения, который возникает у нас, когда мы сталкиваемся с неизвестным.")
	await novel_interface.show_text_only("Возможно, это потому, что мы просто еще не готовы встретиться с тьмой за звездным небом?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	await novel_interface.show_text_only("Хм. Если бы эти пауки не были посланы людьми Рины...")
	await novel_interface.show_text_only("Тогда откуда они взялись? Механическое оружие такого большого размера появилось во Втором Академгороде просто так. Неслыханно.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Может быть, кто-то еще привнес в это воспоминание какие-то элементы? Не только я?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("А может, это не кто-то, а... нечто, обладающее своей волей.")
	await novel_interface.show_text_only("Я помню, до начала этой миссии...")
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Скульд рассказал нам, что Фабелла — огненная ведьма. Обладает магией огня.","Mariru")
