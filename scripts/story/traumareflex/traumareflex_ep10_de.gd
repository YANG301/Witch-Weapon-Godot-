# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella sitzt immer noch auf mir, im Schatten eines konkreten Gegenstands.")
	await novel_interface.show_dialog("Ich weiß, wie ich verhindern kann, dass die Linse Licht reflektiert.","Fabella")
	await novel_interface.show_text_only("Sagt sie, während sie mich mit einer Hand auf dem Boden festhält.")
	await novel_interface.show_dialog("Huh?\n(Warte, was wird sie tun?)","Ren")
	await novel_interface.show_text_only("Fabellas linke Hand liegt neben meinem Gesicht auf dem Boden und stützt ihr Gewicht. Ihr rechtes Knie steckt zwischen meinen Beinen. Dieses Grinsen auf ihrem Gesicht... bedrohlich.")
	await novel_interface.show_text_only("Dann greift sie mit ihrer rechten Hand nach unten und zieht sanft an meinen Seidenstrümpfen ...")
	await novel_interface.show_dialog("Shh.","Fabella")
	await novel_interface.show_text_only("Ich bin nicht in der Lage, ihre Handlungen aus meiner Sicht zu sehen, und kann mir nur vorstellen, was sie tut, basierend auf dem, was ich dort unten fühle.")
	await novel_interface.show_dialog("(Nein... bitte nein...)\n(Bitte, nicht da drüben...)","Ren")
	await novel_interface.show_text_only("Meine Wangen brennen, das Herz hämmert wie wild in meinem Brustkorb. In einer Art Reflex suchen meine Finger nach Halt am Boden.")
	await novel_interface.show_dialog("(Egal wie ich es betrachte, das... ist nicht ideal...)","Ren")
	await novel_interface.show_text_only("Fabella scheint mit meinem panischen, nervösen Gesichtsausdruck ziemlich zufrieden zu sein. Vielleicht wollte sie diesem Neuling schon seit einiger Zeit eine Lektion erteilen.")
	await novel_interface.show_text_only("Plötzlich wird ihr Griff fester und das nächste, was ich weiß, ist, dass ein Loch aus meinen Seidenstrümpfen gerissen wird.")
	await novel_interface.show_text_only("Ich kann nicht umhin zu schreien, sobald es passiert.")
	await novel_interface.show_dialog("Ahh!","Ren")
	await novel_interface.show_text_only("Ich höre in meinem Ohrhörer das Geräusch von heftigem Schlucken, gefolgt von Cassel, der wie verrückt hustet.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Fabella fährt mit der Öffnung fort und zieht den Stoff noch einmal ab, zieht dann meine Schuhe aus und zieht mir die restlichen Strümpfe von den Beinen.") #换行问题
	await novel_interface.show_text_only("Ich kann vor Verlegenheit kaum sprechen, als sie mir hilft, meine Schuhe wieder anzuziehen.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Ach, komm schon...)\n(Meine Beine sind jetzt ganz kalt...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, du hast weiche Beine.\nÜberhaupt keine Muskeln.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Haha, tut mir das wohl leid?")
	await novel_interface.show_text_only("Ich habe noch nicht einmal die Fassung wiedererlangt, aber Fabella verhält sich bereits wieder ganz professionell, wie die Kommandantin, die sie ist.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Reißt euch alle zusammen.","Fabella")
	await novel_interface.show_dialog("Wir brauchen einen Plan. Nachdem wir den Standort des Scharfschützen ermittelt haben, wie können wir ihn ausschalten?","Fabella") #换行问题
	await novel_interface.show_dialog("Ich glaube, ihre Aufgabe besteht einfach darin, uns vom tatsächlichen Schlachtfeld dort drüben abzulenken ...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella deutet auf den brennenden Straßenabschnitt hinter uns, wo man Geräusche schneller Schüsse hört.")
	await novel_interface.show_dialog("Hm... das elektromagnetische Kurzstrecken-Beschleunigungsgerät benötigt etwa 4,5 Sekunden zum Aufladen.","Russel")
	await novel_interface.show_dialog("Für die Kalibrierung des Geräts ist ein Zielfernrohr erforderlich. Selbst wenn der Scharfschütze eine dieser Waffen verwendet, die mehrere Schüsse gleichzeitig abfeuern, lässt die Ausrüstung dies nicht zu.","Russel")
	await novel_interface.show_dialog("Wir müssen ihren Standort finden, nachdem sie einmal geschossen haben, und sie ausschalten, bevor sie ein zweites Mal schießen können.","Russel")
	await novel_interface.show_dialog("Das Problem ist, dass unser Scharfschützengewehr immer noch im Kofferraum ist. Und wie bringen wir sie dazu, auf uns zu schießen, ohne uns selbst in Gefahr zu bringen?","Cassel")
	await novel_interface.show_text_only("Fabella untersucht mit einem Reflektor leise die Straße vor sich und bemerkt eine verirrte Autotür, die am Heck eines umgestürzten Panzerfahrzeugs hängt.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... Das muss bei der Explosion herausgefallen sein.","Fabella")
	await novel_interface.show_dialog("Könnt ihr mir ein paar Daten darüber besorgen, wie haltbar die Substanz-H-Panzerung unseres lächerlich teuren Lastwagens genau ist?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Du meinst... du willst es als Schutzschild benutzen...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Es wird wahrscheinlich einen guten Schild abgeben.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Oh?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("Im Internet ist ein Video eines Milliardärs zu sehen, der ein solches Fahrzeug bei einem Schießexperiment eingesetzt hat.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Selbst als er von einem Barretta M82A1 beschossen wurde, der mit einer elektromagnetischen Stabilisierungsbeschleunigungsvorrichtung ausgestattet war, wurde der LKW nicht im Geringsten beeinträchtigt.")
	await novel_interface.show_text_only("Dieser Milliardär gab nur mit seinen Geldbündeln und seinem russischen Akzent an. Aber es lässt sich nicht leugnen, dass das Video beliebt war.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Wenn Sie denken, dass es sicher ist, dann tun Sie es.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Hä?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella tastet auf meiner Kampfjacke herum, als suche sie nach der perfekten Stelle, dann rammt sie aus dem Nichts ihre Faust in mich hinein.")
	await novel_interface.show_text_only("Das war ein sehr beeindruckender Schlag. Als ich es nur ansah, war ich überzeugt, dass es mich auf der Stelle umbringen würde. Aber alles, was ich spürte, war ein leichtes Zittern in meinem Oberkörper.")
	await novel_interface.show_text_only("Die nicht-Newtonsche Flüssigkeit, die mein Hemd füllt, ist zwar normalerweise weich, verhärtet sich jedoch in der Sekunde, in der sie einer Kraft ausgesetzt wird.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Schöne Jacke. Wenn Sie später die Autotür hochhalten, denken Sie daran, sich hineinzulehnen und die Jacke den Stoß absorbieren zu lassen, anstatt Ihre Hände zu benutzen.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Ich –","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bevor ich protestieren kann, klemmt Fabella mir eine Maske über den Mund.")
	await novel_interface.show_text_only("Dann holt sie eine Spielzeugpistole aus ihrem Gürtel und zielt auf das Dach des gegenüberliegenden Gebäudes.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Sechs-Sekunden-Blitzbombe, fertig ...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Knall!")
	await novel_interface.show_text_only("Ein ultraheller Lichtfleck fliegt aus der Pistole, fegt am wunderschönen Nachthimmel vorbei, bevor er schließlich herunterkommt.")
	await novel_interface.show_text_only("Fabella wartet, bis der Fleck tief genug gesunken ist, bevor sie mich in einem wilden Sprint zum umgestürzten Transporter schleppt, hinter dem wir uns beide verstecken.")
	await novel_interface.show_text_only("Auch Cassel und Russel folgen uns zu einer nahegelegenen Blockade, wo sie uns sehen und mit uns kommunizieren können.")
	await novel_interface.show_text_only("Fabella gibt das Passwort in die Hintertür des Kofferraums ein und holt einen leichten Scout aus dem Waffenregal.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Dieser eignet sich besser zum schnellen Zielen.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, mach die Drohne bereit. Bewahren Sie es hinter der Ecke des Gebäudes auf, damit der Scharfschütze es nicht sehen kann. Lassen Sie es erst raus, wenn es hoch genug ist.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("befiehlt Fabella, während sie die Seidenstrümpfe, die sie mir von den Beinen gerissen hat, Cassel zuwirft, die um einen Stein gewickelt sind.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Frisch aus dem Ofen!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel blickt mich an, während er den Gegenstand fängt, und sieht leicht verlegen aus, und ich versuche mein Bestes, seinem Blick auszuweichen, mit rotem Gesicht.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, behalten Sie die übermittelten Bilder im Auge und melden Sie sich bei mir.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Verstehen Sie das.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella hebt dann die Autotür an, überprüft die reflektierende Substanz-H-Panzerung mit Bienenstockmuster darauf und schiebt sie mir in die Arme.")
	await novel_interface.show_text_only("Es ist leichter, als ich dachte. Ich konnte es sogar mit einer Hand hochheben.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Aber warum muss ich als Lockvogel fungieren?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Obwohl es nicht so ist, dass ich weiß, wie man etwas anderes macht ...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella zieht mich an sich und flüstert mir ins Ohr:")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Hören Sie genau zu. Sobald ich den Befehl erteile, gehst du auf der Seite mit dem dichten Rauch hinaus, die sich hinter dieser Tür verbirgt.","Fabella")
	await novel_interface.show_dialog("Der Scharfschütze sollte irgendwo zwischen 30 und 50 Stockwerken sein. Bleib in Deckung, lass sie deinen Hintern oder so etwas nicht sehen ...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Sonst hast du keinen Hintern mehr.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gleich nachdem sie zu Ende gesprochen hat, stößt sie mich in den Rauch und bedeutet mir, dort zu warten.")
	await novel_interface.show_text_only("Mittlerweile hat Cassel bereits die Kameralinse mit den Strümpfen abgedeckt und die Drohne in etwa zehn Stockwerke Höhe geschickt, verborgen im Schatten.")
	await novel_interface.show_text_only("Der lichtbrechende Mantel der Drohne ermöglicht es ihr, sich perfekt in ihre Umgebung einzufügen. Niemand könnte sagen, dass es da ist, wenn er nicht sehr, sehr genau hinschaut.")
	await novel_interface.show_text_only("Cassel und Russel geben beide das Okay, und Fabella lädt das Scharfschützengewehr in ihre Hände. Sie nickt mir zu –")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Ich muss es durchstehen...","Ren")
	await novel_interface.show_dialog("(Aya hat gesagt, dass es mir gut gehen wird, selbst wenn ich „sterbe“ ...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Moment, hat sie nicht gesagt, dass ich ein einfacher Beobachter bin und nicht mit der Umgebung interagieren kann?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In meinem Moment des Zögerns sticht mir etwas in den Hintern. Es ist Fabella mit ihrer Waffe. Sie sieht aus, als wäre sie bereit, mir den Kopf abzuschießen, wenn ich nicht bald anfange, mich zu bewegen.")
	await novel_interface.show_text_only("Ich seufze und bewege mich mürrisch aus dem Rauch, versteckt hinter der Autotür.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(Dieser Milliardär hätte besser keine falschen Requisiten verwendet, als er dieses Video drehte ...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich gehe weiter, bis ich fünf oder sechs Schritte vom dichten Rauch entfernt bin.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(...Niemand schießt auf mich?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Scharfschütze sollte mich leicht sehen können. Konnten sie erkennen, dass ich ein Lockvogel bin?")
	await novel_interface.show_text_only("Plötzlich ertönt von hinten das Geräusch klappernder Schritte. Aus dem Rand meines Sichtfelds schlüpft Fabella anmutig in mein Sichtfeld und landet in einer halb geduckten Position zu meinen Füßen.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—W-was?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Deck mich!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Etwas kracht mit einem lauten Knall gegen die Tür, die ich hochhalte. Die verheerende Kraft schleudert mich nach hinten und bringt mich aus dem Gleichgewicht.") #文字错误
	await novel_interface.show_text_only("Ich lande auf meinem Hintern, die Tür wird zur Seite geschleudert. Fabella und ich sind völlig offene, leichte Ziele.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh nein!)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Im zweiundvierzigsten Stock! Drittes Fenster von rechts! Sie haben die Laserführung an!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dann feuert unsere Drohne, versteckt im dunklen Nachthimmel, einen roten Laser auf das Fenster im gegenüberliegenden Gebäude.")
	await novel_interface.show_text_only("Knall!")
	await novel_interface.show_text_only("Knall! Knall!")
	await novel_interface.show_text_only("Fabella feuert dreimal hintereinander.")
	await novel_interface.show_text_only("Dann Stille – eine leblose, Verzweiflung hervorrufende Stille. Ich kann praktisch hören, wie mein Herz Blut in mein Gehirn pumpt.")
	await novel_interface.show_text_only("Eine Sekunde nach der anderen vergeht. Ich halte den Atem an und stelle mir vor, wie ich von einem Lichtstrahl in Stücke gerissen werde.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ziel eliminiert. Ich wiederhole: Ziel eliminiert!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("Ahaha!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Gut gemacht!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anstatt zu feiern, kniet Fabella weiterhin in derselben Position, die Waffe im Anschlag.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Psst, ruhig. Hört ihr –","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während ich meine Ohren anstrenge, bemerke ich, dass ich tatsächlich einen Hubschrauber hören kann, der sich nähert.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Was ist das... ein VTOL?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Verdammt! Es ist ein Zeisig!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Was? Ein Zeisig, hier? Innenstadt?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein Siskin ist eine Art unbemannter Militärhubschrauber, der während des Siebenjährigen Krieges in Masada Ford entwickelt wurde.")
	await novel_interface.show_text_only("Es ist dafür bekannt, zwölf Panzerabwehrraketen zu tragen, was es perfekt für Vernichtungskampagnen macht.")
	await novel_interface.show_text_only("Der gelb-schwarz gestreifte Schnitter kommt aus der Luft in Sicht und landet zwischen uns und dem gegenüberliegenden Gebäude.")
	await novel_interface.show_text_only("Da wird mir klar, dass wir erledigt sind.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
