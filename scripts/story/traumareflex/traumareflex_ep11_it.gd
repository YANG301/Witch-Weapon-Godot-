# traumareflex_ep11.gd - 创伤反射篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第11话剧本
	traumareflex_ep11_script()

func play_script():
	pass

# 创伤反射篇第11话 - 正式剧本
func traumareflex_ep11_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Lucherino. Un elicottero militare senza pilota.")
	await novel_interface.show_text_only("Un incubo per tutte le unità di terra, questo veicolo ad alta potenza di fuoco fu sviluppato da Masada Ford nella Terza Città Accademia durante la Guerra dei Sette Anni.")
	await novel_interface.show_text_only("È in grado di eseguire azioni di combattimento basate su un algoritmo automatizzato e può facilmente acclimatarsi agli ambienti militari con interruzioni delle onde radio.")
	await novel_interface.show_text_only("La sua tecnologia di riconoscimento AI tutt'altro che perfetta è il suo punto debole. È noto per i suoi frequenti fallimenti, che causano la morte o il ferimento di molti civili.")
	await novel_interface.show_text_only("Diversi paesi hanno firmato un accordo per vietare i dispositivi distruttivi azionati da macchine. Tuttavia, Masada Ford continua a rifiutarsi di entrare a far parte dell'accordo.")
	await novel_interface.show_text_only("E ora, questo incubo a strisce gialle e nere sta lentamente atterrando da sopra l'edificio verso di noi.")
	await novel_interface.show_text_only("I dodici missili a punta su entrambi i lati del veicolo possono facilmente ridurre in cenere l'intero blocco.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Shh, non muoverti.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella resta inginocchiata, con un ginocchio a terra. Appoggia lentamente il suo fucile da cecchino a terra e alza entrambe le braccia in un gesto di resa.")
	await novel_interface.show_text_only("Nel frattempo, sono ancora seduto lì, a malapena in grado di respirare per la forza schiacciante del proiettile del fucile di precisione che poco fa aveva fatto saltare via la mia copertura.")
	await novel_interface.show_text_only("Nell'ombra vedo una sagoma che si avvicina silenziosamente al Lucherino da sotto di esso.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Un aereo da ricognizione... non è uno di quelli che possono autodistruggersi?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il Lucherino, sospeso in aria, scruta l'ambiente circostante e all'improvviso lancia dozzine di missili di colore arancione.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("...!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh no!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I missili lasciano nell'aria diversi archi luminosi, si diffondono attorno al Lucherino ed esplodono tutti insieme.")
	await novel_interface.show_text_only("Diverse file di finestre di vetro vanno in frantumi nell'edificio dietro. Anche l'aereo da ricognizione è ridotto in schegge luccicanti nell'aria.")
	await novel_interface.show_text_only("La luce proveniente dal cartellone rosso e blu dietro l'intera scena la fa sembrare un glorioso spettacolo pirotecnico su larga scala.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("(Quindi spara razzi esca quando non è in grado di individuare la posizione esatta di una minaccia...)","Fabella")
	await novel_interface.show_dialog("(Che macchina da guerra davvero brillante. La sua programmazione basata sull'intelligenza artificiale è davvero straordinaria.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'elicottero poi gira lentamente, gira, finché non si trova direttamente di fronte a me e a Fabella.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	await novel_interface.show_text_only("La lente dell'occhio composto sotto il suo corpo punta il suo punto laser rosso mortale su noi due, seduti lì esposti proprio in mezzo alla strada.")
	await novel_interface.show_text_only("È come se il tempo si fosse fermato proprio lì.")
	await novel_interface.show_text_only("I pochi secondi che precedono la morte sono molto più terrificanti della morte stessa.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Solo... quanto tempo è passato?)","Ren")
	await novel_interface.show_dialog("(Se questo fa parte della memoria di Fabella, deve essere realmente accaduto.)","Ren")
	await novel_interface.show_text_only("Ma qualcosa non quadra...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.show_text_only("Dal nulla, il Lucherino trema violentemente, e poi—")
	await novel_interface.show_text_only("Dopo il crepitio statico e diversi clangori metallici, alcune parti dell'elicottero si staccano.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Qualcuno... ha sparato?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'elicottero corazzato si gira di lato e inizia a cadere, ma presto riesce a mantenere l'altitudine.")
	await novel_interface.show_text_only("Tenta di salire ancora una volta. Il sistema deve regolare la posizione del veicolo in base al danno subito.")
	await novel_interface.show_text_only("Un'improvvisa voce femminile esce dal mio auricolare, che era rimasto silenzioso per così tanto tempo che avevo dimenticato che esistesse.")
	await novel_interface.show_dialog("Scusate se vi ho fatto aspettare, piccoli miei!","Voce femminile")
	await novel_interface.show_dialog("Ma ricorda: l'acceleratore elettromagnetico mobile può essere utilizzato solo una volta. I proiettili normali non possono penetrarlo.","Voce femminile")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Rina! Come sta andando l'Alpha Team?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Preoccupati prima di te stesso. Devi ancora occuparti di quell'elicottero!","Voce maschile")
	await novel_interface.show_text_only("Una voce maschile profonda e rauca ci avverte.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Dov'è...\nFabella?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi accorgo che Fabella, la quale stava accovacciata al mio fianco, non c'è più. Sono rimasto solo io, seduto in mezzo alla strada come un idiota.")  #换行问题
	await novel_interface.show_text_only("Pochi secondi dopo, un'ombra scura con una coda arancione fiammeggiante irrompe da sotto il camion blindato rovesciato con un forte stridio.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Tutti a terra!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bum!")
	await novel_interface.show_text_only("Come se fosse stato fatto a pezzi dal forte urlo di Fabella, l'elicottero esplode su un lato in fiamme arancioni e gialle.")
	await novel_interface.show_text_only("Ben presto, l'elicottero viene inghiottito da un furioso incendio. Il Lucherino gira e rigira nei cieli, lasciando una scia di fumo scuro, e alla fine si schianta al suolo e incontra la sua morte.")
	await novel_interface.show_text_only("Un lembo dell'elica sfreccia fuori dal fumo pesante e atterra proprio tra le mie gambe, sporgendo dalla superficie asfaltata della strada.")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("?","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("…","Ren")
	await novel_interface.show_dialog("Aaaaaaaah!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi metto subito a carponi, con la sensazione che il cuore mi stia per uscire di bocca.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ahah, povera ragazza. Riesci ancora a stare in piedi?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella appare da dietro il camion blindato, gettando da parte una cartuccia di pungiglione vuota.")
	await novel_interface.show_text_only("Mi arrampico, cercando di domare la mia pettinatura disordinata.")
	await novel_interface.show_dialog("Ben fatto!","Voce maschile")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Pernardo? Come va laggiù?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non mi ringrazierai prima?","Voce femminile")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Bene. Grazie, oh grande Mirkin!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Amico. Perché sei rimasto zitto tutto questo tempo e ti ecciti solo quando vedi una ragazza?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Il “bagaglio” va bene. Abbiamo perso Schwartz. Azoulay è a terra.","Voce maschile")
	await novel_interface.show_text_only("Il maschio dalla voce rauca spiega la situazione con poche semplici parole. Così professionale, così privo di emozioni.")
	await novel_interface.show_dialog("La polizia e Ritnalap hanno inviato rinforzi, ma probabilmente sono rimasti bloccati fuori dalla zona. Probabilmente ci sarà un’altra ondata di attacchi.","Voce maschile")
	await novel_interface.show_dialog("Questa strada è barricata su entrambi i lati. Incontriamoci sulla strada sul lato est.","Voce maschile")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Roger, quello.","Fabella")
	await novel_interface.show_dialog("Prendi l'attrezzatura e preparati a partire!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Sì!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("E il tizio nel camion?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("Lasciamo qui l'idiota.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Sì!","Cassel")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Ci siamo avviati verso la strada vicina rompendo alcune finestre di un hotel lungo la strada e attraversandolo, trasportando il resto delle nostre munizioni e rifornimenti.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Qui le luci sono tutte accese. Non dovrebbe esserci qualcuno in giro?","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("Il Centro di controllo delle malattie ha emesso un avviso di perdita di rischio biologico di grado 3 qui novanta minuti fa. Adesso però è stato cancellato.","Russel")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Russel spiega, mentre scorre i messaggi sul suo tablet.")
	novel_interface.show_character("fabiola_battle","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("La guerra è finita solo l'anno scorso e i civili sono ancora paranoici. Chi vorrebbe essere colpito da una faccia piena di antrace, giusto?","Russel")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella chiede accigliandosi:")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Quel Lucherino... non è stato bandito sul mercato in tutto il mondo?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Naturalmente. Quei ragazzi sono orgogliosi del loro sistema di controllo AI top-secret. Sicuramente non lo venderanno a nessuno.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("E se recuperassimo l'unità di controllo dai rottami? In questo modo potremo studiarlo, rubare la tecnologia...","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Il chip si è autodistrutto nell'istante in cui l'elicottero si è schiantato, idiota.","Russel")
	await novel_interface.show_dialog("Ho sentito che i suoi moduli di attacco e difesa sono in realtà separati. Un paio di mesi fa, un ufficiale di Masada è fuggito dal suo paese con un campione di uno di quei moduli.","Russel")
	await novel_interface.show_dialog("Quando Menorah ne venne a conoscenza, inseguirono quel poveretto, riducendolo in mille pezzi insieme al suo mezzo di trasporto. Hanno anche raccolto le ceneri e le hanno rispedite al loro paese, per ogni evenienza.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Anche la loro agenzia di intelligence sembra piuttosto folle...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Sono qui!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguo il rumore dei passi e vedo diversi soldati che si avvicinano lentamente dal fondo della strada.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Ne hai quattro qui, eh... oh, e anche un principiante?","Pernard")
	await novel_interface.show_dialog("Mi serve una mappa della zona.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'alto e tarchiato Capitano del Team Alpha, con un occhio coperto da una benda, inizia immediatamente a studiare la mappa con Fabella.")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Che carino.\nSono Rina Mirkin. Piacere di conoscerti.","Rina")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	await novel_interface.show_dialog("Piacere di conoscerti. Chiamami Ren.","Ren")
	await novel_interface.show_dialog("(Non è stata lei a sparare il colpo che ci ha salvato il culo?)","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Rina sembra una hippie sofisticata, con la sua bandana colorata e il fucile da cecchino.")
	novel_interface.show_character("leena")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uhm. Il tuo vestito...","Rina")
	await novel_interface.show_dialog("È quello che i giovani chiamano girly punk?","Rina")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Ehm, no...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le mie calze di seta traforate sembrano... punk, però.")
	await novel_interface.show_text_only("Bene…")
	await novel_interface.show_text_only("All'improvviso, da dietro le spalle larghe del leader della Squadra Alpha, spunta fuori una figura familiare.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Ciao, signorina Ren.","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ci incontriamo di nuovo!","Skuld")

	print("=== 创伤反射篇第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
