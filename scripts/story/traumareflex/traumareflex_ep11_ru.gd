	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Рина! Как поживает команда Альфа?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("В первую очередь беспокойтесь о себе. Тебе еще придется разобраться с этим вертолетом!","Мужской голос")
