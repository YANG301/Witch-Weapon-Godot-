	await novel_interface.show_dialog("Полиция и Ритналап прислали поддержку, но они, вероятно, застряли за пределами этого района. Вероятно, будет еще одна волна атак.","Мужской голос")
	await novel_interface.show_dialog("Эта дорога забаррикадирована с обеих сторон. Давай встретимся на улице на восточной стороне.","Мужской голос")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Роджер, это.","Fabella")
	await novel_interface.show_dialog("Берите снаряжение и готовьтесь к работе!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Да!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("А как насчет парня в грузовике?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("Давайте оставим этого идиота здесь.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Да!","Cassel")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Мы направились к соседней улице, разбив несколько окон уличной гостиницы и пройдя через нее, неся с собой остатки боеприпасов и припасов.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Здесь горит свет. Разве рядом не должно быть никого?","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("Центр по контролю заболеваний выпустил здесь предупреждение об утечке биологической опасности 3-го класса девяносто минут назад. Однако сейчас его отменили.","Russel")
