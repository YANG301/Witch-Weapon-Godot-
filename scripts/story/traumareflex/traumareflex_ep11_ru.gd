	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Конечно. Эти ребята гордятся своей сверхсекретной системой управления искусственным интеллектом. Они его точно никому не продадут.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("А что если мы подберем блок управления из-под обломков? Таким образом, мы сможем изучить его, украсть технологию…","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Чип самоуничтожился в ту секунду, когда вертолет разбился, идиот.","Russel")
