# traumareflex_ep13.gd - 创伤反射篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第13话剧本
	traumareflex_ep13_script()

func play_script():
	pass

