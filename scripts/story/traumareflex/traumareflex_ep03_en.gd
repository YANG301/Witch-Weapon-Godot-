# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Hey, do you ever get that kind of feeling?")
	await novel_interface.show_text_only("You remember a scene... but have no idea when it happened.")
	await novel_interface.show_text_only("I don’t mean deja vu. Everyone has that some time or another.")
	await novel_interface.show_text_only("I mean, like, there’s something you’ve always known will happen someday, and it finally happens.")
	await novel_interface.show_text_only("You’ve always known it will happen. You’ve even seen it, in the form of a flashback. You just can’t be sure when it’s going to happen.")
	await novel_interface.show_text_only("What we call deja vu is simply a sort of confirmation that your premonitions have come true.")
	await novel_interface.show_text_only("You knew it will happen. You’ve always known.")
	await novel_interface.show_text_only("Haven’t you?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Hm…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl opens her eyes groggily, rubs her face and finds herself lying on a bench.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabella... where are we?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But Fabella does not reply. Strange. The maid would usually appear the second her name is called.")
	await novel_interface.show_text_only("The girl looks around to see an empty street, lined by orderly streetlamps on both sides. The street seems to go on forever in eerie silence, like this were some alternate universe.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Weren’t we in a church...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ahh... Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld gets to her feet, a hand massaging her aching temple.")
	await novel_interface.show_text_only("She remembers the nightmare she had. Remembers the twisted images on the mosaic windows. But was it really just a nightmare?")
	await novel_interface.show_text_only("She remembers Fabella, throwing her out of the church, releasing her from the darkness that would have otherwise claimed her...")
	await novel_interface.show_text_only("Skuld checks her belongings. Her cellphone, her wallet, her accessories... all there.")
	await novel_interface.show_text_only("There are thirty-two missed calls on her phone.")
	await novel_interface.show_text_only("If Fabella hadn’t installed an anti-tracking software on the phone, the Embassy would probably have found her already.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Ten-eighteen p.m... it’s that late already?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She squeezes her eyes shut, trying her best to regulate her breathing, to sort out the tangled mess that is her memories.")
	await novel_interface.show_text_only("She must remain calm—that’s what Father and Fabella would have wanted. They always told her the more dangerous the situation, the more she needs to keep a clear head.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("That church... and the text from Father Anton... must be a trap.","Skuld")
	await novel_interface.show_dialog("Whoever it was must be targeting me, Father or Fabella.","Skuld")
	await novel_interface.show_dialog("I can hear cars from the roads nearby and even street performers playing a song a distance away... and I’m not tied up or anything.","Skuld")
	await novel_interface.show_dialog("According to my phone GPS, I’m in Arai Central Park, not too far from the church.","Skuld")
	await novel_interface.show_dialog("Whoever brought me here probably didn’t mean any harm.","Skuld")
	await novel_interface.show_dialog("I don’t know if whoever set the trap and whoever brought me here belonged to the same faction... I can’t head back just like this.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld dials Fabella’s number once again. And once again, it goes to voicemail. She checks all her records and it doesn’t seem that Fabella had contacted her at all either.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabella...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Finally, she calls her father, gripping her phone tightly in her small hand.")
	await novel_interface.show_text_only("He picks up the second the call goes through.")
	await novel_interface.show_dialog("Skuld? Is that you?","Father")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Father...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Where the heck are you? It’s already past ten p.m. where you are. Everyone’s dying with worry!","Father")
	await novel_interface.show_dialog("And neither you nor your maid picked up the phone! What’s with you two? Ambassador Haggerty’s already sent a team out to look for you!","Father")
	await novel_interface.show_text_only("Her father sounds mad—but Skuld is simply relieved to hear his voice.")
	await novel_interface.show_text_only("At least no one tried to threaten him into anything, using her as hostage.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("I’m safe now, don’t worry, but listen—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The man quiets down immediately at the urgency in his daughter’s tone.")
	await novel_interface.show_dialog("... Are you alone?","Father")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Yeah. Just me.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Wait a sec, I’ll call you back with another number.","Father")
	await novel_interface.show_text_only("She hangs up and immediately receives a call from an unknown number.")
	await novel_interface.show_dialog("Okay, you can talk now. What happened?","Father")
	await novel_interface.show_text_only("Skuld takes a deep breath. According to what she currently knows, there should be two possibilities:")
	await novel_interface.show_text_only("If the ones who set the trap and the ones who brought her here were from the same group, then their target must be Fabella, not Skuld herself.")
	await novel_interface.show_text_only("If they’re not from the same group, then she herself could be the target—whoever wanted her failed and is currently holding Fabella and Father Anton hostage.")
	await novel_interface.show_text_only("No matter which it is, her favorite person in the world is in danger.")
	await novel_interface.show_text_only("Still, if it’s the latter, she can’t just go and look for Fabella herself. It would be walking straight into a trap, and she’ll probably end up a hostage too, which the kidnappers can use against Father and the Committee.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Can you do something for me first? I need someone to check on Father Anton from Trinity Church and tell me if he’s safe.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sure, I’ll send someone right away.\nNow, tell me what’s going on.","Father")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella and I were ambushed near the Embassy not long ago. They probably used some kind of hallucinogen or drugs made with Substance H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What?","Father")
	await novel_interface.show_text_only("Using chemical weapons or those made with Substance H in an international territory is pretty much equal to declaring war against the United Congress.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella risked her life to save me. I don’t know where she is now...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Those guys must have sent me a text pretending to be Father Anton and lured me there.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… I see.","Father")
	await novel_interface.show_dialog("The Forum of Peace is next month... why did you have to go to New Opulentia at such a sensitive timing...?","Father")
	await novel_interface.show_dialog("Whoever dared do this would definitely be very careful about their identity.","Father")
	await novel_interface.show_dialog("Though Fabella’s ex-boss in South America has passed away, he’s still got quite a few enemies...","Father")
	await novel_interface.show_dialog("Anyway, where are you now?\nI’ll arrange something with foreign relations and bring you back to Newmoridas.","Father")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("You have to promise me first! Promise me you’ll save Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld’s voice trembles, eyes brimming over with tears.")
	await novel_interface.show_dialog("…","Father")
	await novel_interface.show_text_only("On the other end of the line, silence.")
	await novel_interface.show_text_only("Skuld knows that her father is extremely skilled, always well-informed. He’d be able to analyze the situation easily and decide the best course of action.")
	await novel_interface.show_text_only("Her father is a founder of a hedge fund company, which flourished in the financial market during the war due to his excellent decision-making skills. That was how he earned a place for himself in the Committee.")
	await novel_interface.show_text_only("But that was also how he earned countless enemies. Bringing down stocks is, after all, very different from bringing down a country.")
	await novel_interface.show_text_only("Skuld grew up in an environment filled with hatred and danger. But her father was oddly persistent and refused to change his ways for his daughter.")
	await novel_interface.show_text_only("It might have something to do with her mother, who had died when she was very young.")
	await novel_interface.show_text_only("Suddenly, Skuld notices a small red frame on her phone screen.\nThis indicates that her location is being tracked during the call.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She immediately hangs up.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("They have my location now! Gotta get out of here...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld dashes into the stairwell of a nearby car park building.")
	await novel_interface.show_text_only("She calls up the number of a laundromat in her contacts. Fabella had given her this number as a last resort.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Guess I don’t have a choice now!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Crouched on the steps, the girl dials the number.")
	await novel_interface.show_text_only("After three rings, a nice lady speaks up.")
	await novel_interface.show_text_only("Rexhill Laundromat. Pleased to serve you.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... I’m Skuld Axelrod, international ID no. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Got it. Please wait...")
	await novel_interface.show_text_only("Miss Axelrod, your laundry is ready. Shall we send it to you?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Sure. My friend at New Opulentia Memorial Church needs her laundry picked up, by the way.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Got it.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("I’m at—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We know where you are. Please be patient.")
	await novel_interface.show_text_only("The lady hangs up.")
	await novel_interface.show_text_only("Ten nail-biting minutes later, a black SUV rolls into the car park.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Good day, Miss Axelrod.","SID特工")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Are you from... SID?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Yes. We’ve already retrieved your friend.","SID Agent")
	await novel_interface.show_dialog("Please get in.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
