# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Này, bạn có bao giờ có cảm giác đó không?")
	await novel_interface.show_text_only("Bạn nhớ một cảnh... nhưng không biết nó xảy ra khi nào.")
	await novel_interface.show_text_only("Ý tôi không phải là deja vu. Mọi người đều có điều đó vào lúc này hay lúc khác.")
	await novel_interface.show_text_only("Ý tôi là, có một điều gì đó mà bạn luôn biết sẽ xảy ra vào một ngày nào đó, và cuối cùng nó cũng xảy ra.")
	await novel_interface.show_text_only("Bạn luôn biết điều đó sẽ xảy ra. Bạn thậm chí đã nhìn thấy nó, dưới dạng hồi tưởng. Bạn không thể chắc chắn khi nào nó sẽ xảy ra.")
	await novel_interface.show_text_only("Cái mà chúng tôi gọi là deja vu chỉ đơn giản là một dạng xác nhận rằng linh cảm của bạn đã trở thành sự thật.")
	await novel_interface.show_text_only("Bạn biết điều đó sẽ xảy ra mà. Bạn đã luôn biết.")
	await novel_interface.show_text_only("Phải không bạn?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Ừm…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô gái tóc vàng lảo đảo mở mắt ra, xoa mặt và thấy mình đang nằm trên một chiếc ghế dài.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabella... chúng ta đang ở đâu?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhưng Fabella không trả lời. Lạ lùng. Người giúp việc thường xuất hiện ngay khi tên cô ấy được gọi.")
	await novel_interface.show_text_only("Cô gái nhìn quanh và thấy một con phố vắng, hai bên là những ngọn đèn đường trật tự. Con phố dường như kéo dài mãi trong sự im lặng kỳ quái, như thể đây là một vũ trụ song song nào đó.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Không phải chúng ta đang ở trong nhà thờ sao...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Àh... Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld đứng dậy, đưa tay xoa xoa thái dương đang đau nhức của cô.")
	await novel_interface.show_text_only("Cô nhớ lại cơn ác mộng mình gặp phải. Nhớ lại những hình ảnh méo mó trên những ô cửa sổ khảm. Nhưng liệu đó có thực sự chỉ là một cơn ác mộng?")
	await novel_interface.show_text_only("Cô nhớ đến Fabella, ném cô ra khỏi nhà thờ, giải thoát cô khỏi bóng tối mà lẽ ra sẽ cướp mất cô...")
	await novel_interface.show_text_only("Skuld kiểm tra đồ đạc của cô ấy. Điện thoại di động, ví, phụ kiện của cô ấy... tất cả đều ở đó.")
	await novel_interface.show_text_only("Có 32 cuộc gọi nhỡ trên điện thoại của cô ấy.")
	await novel_interface.show_text_only("Nếu Fabella không cài phần mềm chống theo dõi trên điện thoại thì có lẽ Đại sứ quán đã tìm ra cô ấy rồi.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Mười giờ mười tám giờ... đã muộn thế rồi à?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô nhắm mắt lại, cố gắng hết sức để điều hòa hơi thở, sắp xếp lại mớ hỗn độn vốn là ký ức của mình.")
	await novel_interface.show_text_only("Cô ấy phải giữ bình tĩnh—đó là điều mà Cha và Fabella mong muốn. Họ luôn nói với cô rằng tình thế càng nguy hiểm thì cô càng phải giữ cái đầu tỉnh táo.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Nhà thờ đó... và tin nhắn của Cha Anton... chắc chắn là một cái bẫy.","Skuld")
	await novel_interface.show_dialog("Dù đó là ai thì chắc chắn đang nhắm vào tôi, Cha hoặc Fabella.","Skuld")
	await novel_interface.show_dialog("Tôi có thể nghe thấy tiếng ô tô từ những con đường gần đó và thậm chí cả những người biểu diễn đường phố đang chơi một bài hát ở khoảng cách xa... và tôi không bị trói hay gì cả.","Skuld")
	await novel_interface.show_dialog("Theo GPS trên điện thoại của tôi, tôi đang ở Công viên Trung tâm Arai, cách nhà thờ không xa lắm.","Skuld")
	await novel_interface.show_dialog("Ai đưa tôi đến đây chắc không có ác ý gì đâu.","Skuld")
	await novel_interface.show_dialog("Không biết kẻ giăng bẫy và kẻ đưa tôi đến đây có phải cùng một phe hay không… Cứ thế này thì quay về không được.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld quay số của Fabella một lần nữa. Và một lần nữa, nó lại chuyển sang hộp thư thoại. Cô ấy kiểm tra tất cả hồ sơ của mình và có vẻ như Fabella cũng không liên lạc với cô ấy.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabella...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuối cùng, cô gọi cho bố mình, nắm chặt điện thoại trong bàn tay nhỏ nhắn.")
	await novel_interface.show_text_only("Anh ấy nhấc máy ngay khi cuộc gọi diễn ra.")
	await novel_interface.show_dialog("Skuld? Đó có phải là bạn không?","Bố")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Bố ơi...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bạn đang ở đâu vậy? Đã quá mười giờ tối rồi. bạn đang ở đâu Mọi người đều chết vì lo lắng!","Bố")
	await novel_interface.show_dialog("Và cả bạn và người giúp việc đều không nhấc máy! Hai người có chuyện gì vậy? Đại sứ Haggerty đã cử một đội đi tìm bạn!","Bố")
	await novel_interface.show_text_only("Cha cô ấy có vẻ tức giận—nhưng Skuld chỉ cảm thấy nhẹ nhõm khi nghe giọng nói của ông.")
	await novel_interface.show_text_only("Ít nhất thì không có ai cố gắng đe dọa anh ta bằng bất cứ điều gì, sử dụng cô ấy làm con tin.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Bây giờ tôi an toàn rồi, đừng lo lắng, nhưng hãy nghe này—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người đàn ông im lặng ngay lập tức trước sự khẩn cấp trong giọng điệu của con gái mình.")
	await novel_interface.show_dialog("... Bạn có một mình không?","Bố")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Vâng. Chỉ có tôi thôi.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Đợi chút, tôi sẽ gọi lại cho bạn bằng số khác.","Bố")
	await novel_interface.show_text_only("Cô cúp máy và ngay lập tức nhận được cuộc gọi từ số lạ.")
	await novel_interface.show_dialog("Được rồi, bây giờ bạn có thể nói chuyện. Chuyện gì đã xảy ra thế?","Bố")
	await novel_interface.show_text_only("Skuld hít một hơi thật sâu. Theo những gì cô ấy biết hiện tại, có hai khả năng:")
	await novel_interface.show_text_only("Nếu những người đặt bẫy và những người đưa cô đến đây là cùng một nhóm, thì mục tiêu của họ phải là Fabella chứ không phải Skuld.")
	await novel_interface.show_text_only("Nếu họ không thuộc cùng một nhóm, thì chính cô ấy có thể là mục tiêu—bất cứ ai muốn cô ấy đều thất bại và hiện đang giữ Fabella và Cha Anton làm con tin.")
	await novel_interface.show_text_only("Dù thế nào đi nữa, người cô yêu nhất trên đời cũng đang gặp nguy hiểm.")
	await novel_interface.show_text_only("Tuy nhiên, nếu là vế sau, cô ấy không thể tự mình đi tìm Fabella được. Đó sẽ là bước thẳng vào một cái bẫy, và có thể cuối cùng cô ấy cũng sẽ trở thành con tin, điều mà những kẻ bắt cóc có thể lợi dụng để chống lại Cha và Ủy ban.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Bạn có thể giúp tôi một việc trước được không? Tôi cần người kiểm tra Cha Anton từ Nhà thờ Trinity và cho tôi biết ông ấy có an toàn không.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Chắc chắn rồi, tôi sẽ cử người đến ngay.\nBây giờ, hãy cho tôi biết chuyện gì đang xảy ra.","Bố")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella và tôi bị phục kích gần Đại sứ quán cách đây không lâu. Có lẽ họ đã sử dụng một số loại thuốc gây ảo giác hoặc ma túy làm từ Chất H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cái gì?","Bố")
	await novel_interface.show_text_only("Sử dụng vũ khí hóa học hoặc những vũ khí được chế tạo bằng Chất H trên lãnh thổ quốc tế gần như tương đương với việc tuyên chiến chống lại Quốc hội Thống nhất.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella đã liều mạng để cứu tôi. Tôi không biết bây giờ cô ấy ở đâu...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Chắc mấy tên đó đã nhắn tin giả làm Cha Anton và dụ tôi đến đó.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… Tôi hiểu rồi.","Bố")
	await novel_interface.show_dialog("Diễn đàn Hòa bình diễn ra vào tháng sau... tại sao bạn lại phải đến New Opulentia vào thời điểm nhạy cảm như vậy...?","Bố")
	await novel_interface.show_dialog("Ai dám làm điều này chắc chắn sẽ rất cẩn thận về danh tính của mình.","Bố")
	await novel_interface.show_dialog("Dù ông chủ cũ của Fabella ở Nam Mỹ đã qua đời nhưng ông ấy vẫn còn khá nhiều kẻ thù...","Bố")
	await novel_interface.show_dialog("Dù sao thì bây giờ bạn đang ở đâu?\nTôi sẽ thu xếp vài việc liên quan đến quan hệ đối ngoại và đưa bạn trở lại Newmoridas.","Bố")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Anh phải hứa với em trước nhé! Hứa với tôi là bạn sẽ cứu Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giọng Skuld run run, mắt ngân ngấn nước.")
	await novel_interface.show_dialog("…","Bố")
	await novel_interface.show_text_only("Đầu dây bên kia im lặng.")
	await novel_interface.show_text_only("Skuld biết cha cô là người cực kỳ giỏi giang, luôn nắm rõ thông tin. Anh ta sẽ có thể phân tích tình hình một cách dễ dàng và quyết định cách hành động tốt nhất.")
	await novel_interface.show_text_only("Cha cô là người sáng lập một công ty quỹ phòng hộ, công ty này đã phát triển mạnh mẽ trên thị trường tài chính trong thời kỳ chiến tranh nhờ kỹ năng ra quyết định xuất sắc của ông. Đó là cách anh ấy giành được một vị trí trong Ủy ban.")
	await novel_interface.show_text_only("Nhưng đó cũng là cách anh kiếm được vô số kẻ thù. Suy cho cùng, việc hạ giá cổ phiếu rất khác với việc hạ bệ một quốc gia.")
	await novel_interface.show_text_only("Skuld lớn lên trong một môi trường đầy hận thù và nguy hiểm. Nhưng cha cô lại kiên trì một cách kỳ lạ và không chịu thay đổi cách sống của mình vì con gái mình.")
	await novel_interface.show_text_only("Có thể nó liên quan đến mẹ cô, người đã mất khi cô còn rất nhỏ.")
	await novel_interface.show_text_only("Đột nhiên, Skuld nhận thấy một khung nhỏ màu đỏ trên màn hình điện thoại của cô ấy.\nĐiều này cho biết vị trí của cô ấy đang được theo dõi trong suốt cuộc gọi.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy lập tức cúp máy.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Bây giờ họ đã có vị trí của tôi! Phải ra khỏi đây...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld lao vào cầu thang của tòa nhà bãi đậu xe gần đó.")
	await novel_interface.show_text_only("Cô ấy gọi đến số của tiệm giặt là trong danh bạ của mình. Fabella đã cho cô ấy con số này như một phương sách cuối cùng.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Có lẽ bây giờ tôi không còn lựa chọn nào khác!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cúi mình trên bậc thềm, cô gái bấm số.")
	await novel_interface.show_text_only("Sau ba hồi chuông, một quý cô tốt bụng lên tiếng.")
	await novel_interface.show_text_only("Tiệm giặt Rexhill. Rất hân hạnh được phục vụ bạn.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Tôi là Skuld Axelrod, số ID quốc tế. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hiểu rồi. Xin vui lòng chờ...")
	await novel_interface.show_text_only("Cô Axelrod, đồ giặt của cô đã sẵn sàng rồi. Chúng tôi sẽ gửi nó cho bạn nhé?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Chắc chắn rồi. Nhân tiện, bạn tôi ở Nhà thờ Tưởng niệm New Opulentia cần người mang đồ giặt đến cho cô ấy.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hiểu rồi.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Tôi đang ở—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chúng tôi biết bạn đang ở đâu. Xin hãy kiên nhẫn.")
	await novel_interface.show_text_only("Người phụ nữ cúp máy.")
	await novel_interface.show_text_only("Mười phút sau, một chiếc SUV màu đen lăn bánh vào bãi đậu xe.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Chúc một ngày tốt lành, cô Axelrod.","SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Bạn đến từ... SID?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Có. Chúng tôi đã tìm được bạn của bạn.","SID Agent")
	await novel_interface.show_dialog("Mời vào trong.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
