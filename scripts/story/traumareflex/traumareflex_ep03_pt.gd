# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Ei, você já teve esse tipo de sentimento?")
	await novel_interface.show_text_only("Você se lembra de uma cena... mas não tem ideia de quando aconteceu.")
	await novel_interface.show_text_only("Não quero dizer déjà vu. Todo mundo tem isso uma vez ou outra.")
	await novel_interface.show_text_only("Quer dizer, há algo que você sempre soube que aconteceria algum dia, e finalmente acontece.")
	await novel_interface.show_text_only("Você sempre soube que isso iria acontecer. Você até viu isso, na forma de um flashback. Você simplesmente não pode ter certeza de quando isso vai acontecer.")
	await novel_interface.show_text_only("O que chamamos de déjà vu é simplesmente uma espécie de confirmação de que suas premonições se tornaram realidade.")
	await novel_interface.show_text_only("Você sabia que isso iria acontecer. Você sempre soube.")
	await novel_interface.show_text_only("Não é?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Hum…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A loira abre os olhos meio grogue, esfrega o rosto e se vê deitada em um banco.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabela... onde estamos?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas Fabella não responde. Estranho. A empregada geralmente aparecia no segundo em que seu nome era chamado.")
	await novel_interface.show_text_only("A garota olha em volta e vê uma rua vazia, ladeada por postes de luz ordenados em ambos os lados. A rua parece durar para sempre em um silêncio assustador, como se fosse algum universo alternativo.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Não estávamos em uma igreja...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ahh... Fabela!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld se levanta, uma mão massageando sua têmpora dolorida.")
	await novel_interface.show_text_only("Ela se lembra do pesadelo que teve. Lembra as imagens distorcidas nas janelas de mosaico. Mas foi realmente apenas um pesadelo?")
	await novel_interface.show_text_only("Ela se lembra de Fabella, expulsando-a da igreja, libertando-a da escuridão que de outra forma a teria reivindicado...")
	await novel_interface.show_text_only("Skuld verifica seus pertences. Seu celular, sua carteira, seus acessórios... tudo ali.")
	await novel_interface.show_text_only("Há trinta e duas chamadas perdidas em seu telefone.")
	await novel_interface.show_text_only("Se Fabella não tivesse instalado um software anti-rastreamento no telefone, a Embaixada provavelmente já a teria encontrado.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Dez e dezoito da noite... já é tão tarde?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela fecha os olhos com força, tentando o seu melhor para regular sua respiração, para resolver a bagunça emaranhada que são suas memórias.")
	await novel_interface.show_text_only("Ela deve manter a calma - isso é o que papai e Fabella teriam desejado. Sempre lhe disseram que quanto mais perigosa a situação, mais ela precisa manter a cabeça limpa.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Aquela igreja... e o texto do Padre Anton... deve ser uma armadilha.","Skuld")
	await novel_interface.show_dialog("Quem quer que tenha sido deve estar me mirando, pai ou Fabella.","Skuld")
	await novel_interface.show_dialog("Posso ouvir carros nas estradas próximas e até artistas de rua tocando uma música ao longe... e não estou amarrado nem nada.","Skuld")
	await novel_interface.show_dialog("De acordo com o GPS do meu telefone, estou no Arai Central Park, não muito longe da igreja.","Skuld")
	await novel_interface.show_dialog("Quem me trouxe aqui provavelmente não quis fazer mal algum.","Skuld")
	await novel_interface.show_dialog("Não sei se quem armou a armadilha e quem me trouxe aqui pertencia à mesma facção... Não posso voltar assim.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld disca o número de Fabella mais uma vez. E mais uma vez, vai para o correio de voz. Ela verifica todos os seus registros e parece que Fabella também não a contatou.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabela...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Finalmente, ela liga para o pai, segurando o telefone com força em sua mão pequena.")
	await novel_interface.show_text_only("Ele atende no segundo em que a chamada é completada.")
	await novel_interface.show_dialog("Skuld? É você?","Pai")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Pai...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Onde diabos você está? Já passa das dez da noite. onde você está. Todo mundo está morrendo de preocupação!","Pai")
	await novel_interface.show_dialog("E nem você nem sua empregada atenderam o telefone! O que há com vocês dois? O Embaixador Haggerty já enviou uma equipe para procurar você!","Pai")
	await novel_interface.show_text_only("O pai dela parece louco - mas Skuld fica simplesmente aliviado ao ouvir sua voz.")
	await novel_interface.show_text_only("Pelo menos ninguém tentou ameaçá-lo com nada, usando-a como refém.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Estou seguro agora, não se preocupe, mas ouça—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O homem se acalma imediatamente com a urgência no tom de sua filha.")
	await novel_interface.show_dialog("... Você está sozinho?","Pai")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Sim. Apenas eu.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Espere um segundo, ligarei de volta para você com outro número.","Pai")
	await novel_interface.show_text_only("Ela desliga e imediatamente recebe uma ligação de um número desconhecido.")
	await novel_interface.show_dialog("Ok, você pode conversar agora. O que aconteceu?","Pai")
	await novel_interface.show_text_only("Skuld respira fundo. De acordo com o que ela sabe atualmente, deveria haver duas possibilidades:")
	await novel_interface.show_text_only("Se aqueles que armaram a armadilha e aqueles que a trouxeram aqui eram do mesmo grupo, então o alvo deles deve ser Fabella, não o próprio Skuld.")
	await novel_interface.show_text_only("Se eles não forem do mesmo grupo, então ela mesma poderia ser o alvo - quem a queria falhou e atualmente mantém Fabella e Padre Anton como reféns.")
	await novel_interface.show_text_only("Não importa qual seja, sua pessoa favorita no mundo está em perigo.")
	await novel_interface.show_text_only("Ainda assim, se for o último, ela não pode simplesmente ir procurar Fabella sozinha. Seria cair direto em uma armadilha, e ela provavelmente também acabaria como refém, o que os sequestradores poderão usar contra o pai e o Comitê.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Você pode fazer algo por mim primeiro? Preciso que alguém verifique o padre Anton, da Igreja da Trindade, e me diga se ele está seguro.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Claro, enviarei alguém imediatamente.\nAgora, me diga o que está acontecendo.","Pai")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella e eu fomos emboscados perto da Embaixada há pouco tempo. Provavelmente usaram algum tipo de alucinógeno ou drogas feitas com Substância H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("O quê?","Pai")
	await novel_interface.show_text_only("Usar armas químicas ou fabricadas com Substância H em um território internacional equivale praticamente a declarar guerra ao Congresso Unido.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella arriscou a vida para me salvar. não sei onde ela está agora...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Esses caras devem ter me enviado uma mensagem fingindo ser o padre Anton e me atraído até lá.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… entendo.","Pai")
	await novel_interface.show_dialog("O Fórum da Paz é no próximo mês... por que você teve que ir para Nova Opulência em um momento tão delicado...?","Pai")
	await novel_interface.show_dialog("Quem ousasse fazer isso definitivamente teria muito cuidado com sua identidade.","Pai")
	await novel_interface.show_dialog("Embora o ex-chefe de Fabella na América do Sul tenha falecido, ele ainda tem alguns inimigos...","Pai")
	await novel_interface.show_dialog("De qualquer forma, onde você está agora?\nVou combinar algo com as relações exteriores e trazê-lo de volta para Newmoridas.","Pai")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Você tem que me prometer primeiro! Prometa-me que você salvará Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz de Skuld treme, os olhos cheios de lágrimas.")
	await novel_interface.show_dialog("…","Pai")
	await novel_interface.show_text_only("Do outro lado da linha, silêncio.")
	await novel_interface.show_text_only("Skuld sabe que seu pai é extremamente habilidoso, sempre bem informado. Ele seria capaz de analisar a situação facilmente e decidir o melhor curso de ação.")
	await novel_interface.show_text_only("Seu pai é fundador de uma empresa de fundos de hedge, que floresceu no mercado financeiro durante a guerra devido às suas excelentes habilidades de tomada de decisão. Foi assim que ele conquistou um lugar no Comitê.")
	await novel_interface.show_text_only("Mas foi também assim que ele conquistou inúmeros inimigos. Afinal, derrubar as ações é muito diferente de derrubar um país.")
	await novel_interface.show_text_only("Skuld cresceu em um ambiente cheio de ódio e perigo. Mas seu pai foi estranhamente persistente e se recusou a mudar seus hábitos em relação à filha.")
	await novel_interface.show_text_only("Pode ter algo a ver com sua mãe, que morreu quando ela era muito jovem.")
	await novel_interface.show_text_only("De repente, Skuld percebe uma pequena moldura vermelha na tela do telefone.\nIsso indica que a localização dela está sendo rastreada durante a chamada.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela desliga imediatamente.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Eles têm minha localização agora! Tenho que sair daqui...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld corre para a escada de um estacionamento próximo.")
	await novel_interface.show_text_only("Ela liga para o número de uma lavanderia em seus contatos. Fabella lhe deu esse número como último recurso.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Acho que não tenho escolha agora!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Agachada nos degraus, a garota disca o número.")
	await novel_interface.show_text_only("Depois de três toques, uma senhora simpática fala.")
	await novel_interface.show_text_only("Lavanderia Rexhill. Prazer em atendê-lo.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Sou Skuld Axelrod, identificação internacional nº. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Entendi. Por favor, espere...")
	await novel_interface.show_text_only("Senhorita Axelrod, sua roupa está pronta. Vamos enviar para você?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Claro. A propósito, minha amiga da Igreja Memorial New Opulentia precisa que a roupa lavada seja recolhida.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Entendi.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Estou em—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sabemos onde você está. Por favor, seja paciente.")
	await novel_interface.show_text_only("A senhora desliga.")
	await novel_interface.show_text_only("Dez minutos depois, um SUV preto entra no estacionamento.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Bom dia, senhorita Axelrod.","SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Você é de... SID?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Sim. Já recuperamos seu amigo.","SID Agent")
	await novel_interface.show_dialog("Por favor, entre.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
