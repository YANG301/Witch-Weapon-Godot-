# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("──なに？　容疑者が死んだだと！？","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("元より相手は住宅を砦のように改造しており、\n確保には困難を極めると思われたのですが……\n回収チームが駆け付けた途端、気でも触れたか\nのように重火器で乱射を始めたため、\n仕方なく応戦したところ……","SID捜査員")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("……回収チームの装備は全て非致死性兵器の\nはずだが？","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("はい、目標人物に致命傷は見当たりません。","SID捜査員")
	await novel_interface.show_dialog("死因はおそらく神経系用薬の過剰摂取、\nあるいは出血多量と推測されます。","SID捜査員")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("……分かった、下がっていいぞ。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……了解しました。","SID捜査員")
	await novel_interface.show_text_only("マリルが少しイラつきながら容疑者の資料を\n見ていると、愛衣が指令室に入ってきた。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("レンは無事潜入できたか？","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("うん、もう安定しているはずだね。","愛衣") #文字错误
	await novel_interface.show_dialog("これは……容疑者の検死報告？","愛衣")
	await novel_interface.show_dialog("アントニオ・ホッセ・ウルキサ……\n七年戦争中に南米で活躍した軍閥の長。\n小勢のボスって感じかな？","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("脳全体が薬で焼けてしまっていたのは残念だね。\n\nそうじゃなければ、あの装置の「拷問」って\nやつをちょうど試せたのに。","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は手に持っている資料を、\nパラパラと見ながら惜しそうに言った。")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("南米……やはり狙いはファビオラ？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("まだ断定できんな。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルはスクリーン上に表示されている\n容疑者の資料を見つめ、\n厳しい表情のまま首を横に振った。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("教会で見つかった散布装置を調べた所、\n微量の標識化合物を検出した。","マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("検出結果から標識化合物を追ってみたが、\n新豊洲市内にて同様の反応を示す場所が、\n1か所だけ発見された…………いとも簡単にな。","マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("おや？　それじゃ自ら逮捕してくださいって\n言ってるようなもんじゃん？","愛衣")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("だから信用ならんのだ。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("アントニオね……\n彼がファビオラに手を出す動機はあるの？","愛衣")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ある。それも十二分にだ。","マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("あの戦争が2年目に突入し、南米の経済が\n全面的に崩壊した後、\n軍閥同士の争いが泥沼と化していった。","マリル")
	await novel_interface.show_dialog("そんな戦乱で両親を失ったファビオラは、\nとある大佐に拾われて軍隊の中で育てられた。","マリル")
	await novel_interface.show_dialog("結果、彼女は獣のごとき戦闘の才能を開花させ、\n最年少で親衛隊員へと所属する。","マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("活躍も目覚ましく、単独で敵陣に忍び込み\n相手の指揮官を暗殺した事もあるらしい……\nその暗殺した対象がアントニオの長男だった。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("それが動機だと言うのであれば、まあ筋が通って\nいるね……","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは軍服を着た男性の写真をスクリーンへ\n映し出し、愛衣へ見るようにジェスチャーした。")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ファビオラを引き取って育てた大佐──\n\nその大佐の名はカルロス・ブランコだ。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("あの『チュルン川の虐殺者』のブランコ！？","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("連合議会を結成して間もなくの頃、世界中を\n震撼させた「チュルン川大虐殺」が発生した。")
	await novel_interface.show_text_only("4.6万人の一般人がチュルン川の河畔で\n処刑され、\n当時の人達は下流に位置する世界最大級の滝、\nエンジェルフォールが血で赤く染まったと語る。")
	await novel_interface.show_text_only("この事件は世界中のマスコミが数週間に渡って\n報道し続けた。\n首謀者は当時、最大の軍閥の指導者である\n「カルロス・ブランコ」だと思われた。")
	await novel_interface.show_text_only("ショッキングな映像は民衆の反戦感情を\n一気に掻き立て、\n『チュルン川の虐殺者』の異名も急速に\n広まりを見せる。")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("連合議会はカルロス・ブランコに人道に対する罪\nおよび集団殺害罪を宣告。\n初めての連合軍事作戦を開始した。")
	await novel_interface.show_text_only("そして、Lancer地中貫通爆弾がブランコの\n隠れ家に撃ち込まれ──\n南米の群雄割拠の時代も終わりを告げた。")
	await novel_interface.show_text_only("連合議会はこれを契機に平和と正義のイメージを\n確立。\n6か国の首都を『学園都市』と改名する事を\n世界に向かって発表した。")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("──少なくとも、公式とされている歴史書の\nページ中ではそうだ。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが冷笑すると、愛衣も理解したかのように\n頷いた。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("あの後、不思議だったのは残った6つの軍閥が、\nまるで示し合わせたかのように姿を消した事。\n彼らが元々統治していた区域も、連合議会の\n傀儡たちに引き継がれた……","愛衣")
	await novel_interface.show_dialog("実は……裏事情を知っているんじゃないの？","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は好奇心旺盛な子猫のようにマリルに近付き\n彼女の腰を肘で突いた。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("虐殺は確かに発生したが、死者の全ては\nその6つの軍閥の統治下にあった者達だけだ。","マリル")
	await novel_interface.show_dialog("それぞれの軍閥は事前に打ち合わせをでも\nしたかのように統治下の人民を1ヶ所に集め、\nそして……","マリル")
	await novel_interface.show_dialog("……血に汚れるピエロを演じさせた。\n\n何者かが多額の金を交渉のテーブルに載せてな。","マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("その中で、唯一要求を飲まなかったのが\n話に挙がっていたカルロス・ブランコだ。","マリル")
	await novel_interface.show_dialog("結局、彼は時代の「必要悪」として仕立て\n上げられる事になってしまったが……","マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("その指示をしたのって、まさか──！？","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("愛衣はハッと悟った。")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("つまり姿を消した軍閥の人間達は、\n取引が終わり大金を手に入れ……\nそして、身分を変えて悠々自適に暮らしたと。","愛衣")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("この事件で見つかった様々な証拠は、初めから\n連合議会が保安軍のために用意したものだ。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("そんなアントニオが復讐のために姿を現したと\n連合議会が知れば──\n間違いなく存在を隠蔽しようと早期解決を\n図るだろうってことね……","愛衣")
	await novel_interface.show_dialog("だから違和感だらけなわけね……","愛衣")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ほぉ？　なんだ、話してみろ。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("アントニオの血液から検出された幻覚剤は、\nファビオラの体内で検出したものと同じよ。","愛衣")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それは知っている。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("さらに覚せい剤も検出されたわ。軍閥で兵士の\n神経を鋭敏に保つために使用していた薬物──\nこの薬物の過剰摂取が彼の死因だね。","愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それも検死報告に書いてあるな。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("この精神刺激薬の効果は神経感覚を研ぎ澄まし、\n通常時よりも聴覚や触覚が敏感になるわ。","愛衣")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…………","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("彼の血中に含まれていた濃度なら、\nたとえゴム弾に当たっただけでも、\n砲弾が直撃したような激痛を感じるはずよ。","愛衣")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そんな状態の人間が20分間にも及んで、攻撃に\nさらされてしまえば……\n非致死性兵器と言えども、ショック死は免れない\nだろうな。","マリル")
	await novel_interface.show_dialog("だが、現場の映像では何か薬物を注射したような\n動きはなかったぞ。","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("解剖しても、ドラッグの反応があるにも関わらず\n神経系の病変は無かったんだよね？\nでも脳は焼き切れてるし……","愛衣")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("いっそドMが極まって、気持ち良すぎて\n脳がイッちゃった説を私は押したい！","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルはこなれた感じに手近にあった紙を丸め、\n愛衣の頭を叩いた。")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("あぅ……\n\nそういえば、スクルドを公園に運んだ人物の\n正体は掴めた？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("調べてはみたが完璧に市街の監視カメラを\n回避している。\n仮に誘拐犯のために教科書を作るとしたら、\nその技術を載せたいレベルだな。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("付近の監視カメラの位置を熟知しながらも、\n少女を背負い市街地を2キロも歩いて、\n怪しまれない人か……","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("手がかりは以上だな。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは片手を顎に当てて思案する。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("もし、アントニオが意図的に用意された\n「犯人」なら……","マリル")
	await novel_interface.show_dialog("黒幕の狙いは、おそらくファビオラの『魔女』\nという身分だ。","マリル")
	await novel_interface.show_dialog("私は事件の黒幕が目的を達成できなかった\nのじゃないかと推測している。","マリル")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("だが、貴重なサンプルだ。\n\n死なせてしまうぐらいなら、連合議会に渡した\n方が良い……","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("だから、アントニオに罪を被せたの？\n色々と使える貴重な「スケープゴート」なのに。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("体内に炎の魔法を宿した魔女……\n『生きている情報』……","マリル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("情報……か。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは愛衣に目配せをすると、2人は同時に\n何かを悟った。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("もし、犯人の目的が『生きている情報』を\n奪う事であれば……","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("播磨脳研の設備に使われている技術は、\n公開済みの論文を基礎理論にしたものが大半よ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("ならば彼らも我々と同じ問題に直面した\nはずだ──","マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("無限に伸びる壁……\n\nファビオラの脳に潜入した4人の捜査員全員が\nそれを見た。")
	await novel_interface.show_text_only("まるで侵入者を拒むファイアウォールのように…")
	await novel_interface.show_dialog("もしも、それが攻撃性を持つファイアウォールで\nあるなら────","愛衣")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("愛衣。いつでもレンを起こせるようにするんだ。","マリル")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
