# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("お帰りなさい……ァッ！　間違ったっ！","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("お帰りなさいませぇ～～！\nご、ご、ご主人様ぁ……","レン")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("やっぱり変な感じ……","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("と言うか…………","レン")
	await novel_interface.show_dialog("なんで俺がメイドカフェでバイトしなきゃ\nいけないんだよっ！！","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こんなふざけた潜入任務、絶対にマリルが\n趣味で手配しただろ！！")
	await novel_interface.show_text_only("確かに大使館エリアにあるあのカフェは有名だし\n以前、ネットで紹介記事を読んだ事もある……")
	await novel_interface.show_text_only("優雅な雰囲気にクオリティの非常に高い食事、\n食器すらも洗練されていて……\n何よりもメイドのお姉さん達が全員超美人！！")
	await novel_interface.show_text_only("でも女性に「ご主人様」って呼ばれるのが\n恥ずかしくて実際に行った事は一度もなかった。")
	await novel_interface.show_text_only("あの時の自分よ……\nお前の考えは浅はかだったぞ……")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("本当に恥ずかしいのは\n「ご主人様」って呼ぶ側だからッ！！","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（しかもこのメイド服……）\n\n（芸が細かいと言うか……面倒くさい……）","レン")
	await novel_interface.show_dialog("（スカートは元々短く作ってあるし）\n\n（さらにパニエを着けて歩くのか……）","レン")
	await novel_interface.show_dialog("（しかしガーターベルトを着けるのって\n　初めてだな……）\n（これって腰に固定すればいいのか？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は頭を下に向け、\n装着している白レースのガーターベルトを見る。")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("（1人称視点からだと、こんな感じなのか……）\n\n（……案外可愛くないか？）","レン")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（こっそり写真を撮ってみたり……）\n\n（ぜ、絶対、誰にも見せないけどなっ！）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──パシャッ")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("コホン、さ、練習に戻ろうか……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("もし研修段階でクビにされたら、\n絶対マリルに踏み殺される。")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("おかえりなさいませぇ～！　ご主人様ぁ～～！","レン")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("ご主人様、\nオムライスに何を描きますかにゃぁ～～♡","レン")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("あああやっぱ死ぬぅッ！！\nこんなセリフ恥ずかし過ぎて死ぬぅッ！！","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("いや、こんなので負けちゃだめだ……\nもう一度……","レン")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…………")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("はぁ～～……もうこんな時間か。\n早く着替えて寝ようっ！","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("……そのメイド服はお前に似合うと思っていた。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("うんうん！思わず調教したくなるね！","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("洗面所から出ると、マリルと愛衣がソファーの\n上に座っている事に気が付いた。\nなにやら笑いを必死に堪えているようだ。")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("マリルッ！？　愛衣までッ！！？？","レン")
	await novel_interface.show_dialog("い、いつの間に入ってきてんだッ！！！","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("ついさっき♡","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("そ、そ、そそそそそれじゃ……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("全部・聞い・ちゃっ・たっ♡","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("聞くなああぁぁーーッ！！！\n\nい…いっそ殺してくれぇぇ……ッ！！！")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("うぅ……何しに来たんだよ突然……","レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("誰もいない時を見計らっているかと思えば、\n真夜中にメイド服を取り出して……\n練習だと理由を託けながら、\n鏡の前で嬉しそうに情事にふける……\nそんなヒメゴトをしている可愛いお前さんを\n見に来たわけだが？","マリル") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("変態度が増すような言い方を止めろっ！！\n\n（こんな練習してる姿…っ！）","レン")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("マリルが手配した任務のために、\n努力しているだけじゃないか……","レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ほう？メイドの仕事は、そんな上っ面なセリフを\n吐くだけの単純な仕事ではないんだぞ？","マリル")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("屋上でヘリが待機している、行くぞ。","マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("え？ こんな夜中に任務？\n待って、これ着替えさせて……","レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("いや不要だ。\n今回のターゲットはメイドなんでな。\nその衣装……ぷっ、とりあえず相応しいから\nそのままで行こう。","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("笑ったよねっ！？　今絶対笑ったよねっ！？")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("でも、この衣装ままって……","レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("大丈夫！\n前回彼女達にあった時も、その格好だったから！","愛衣")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("へっ？","レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("行けば分かるって。","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…………")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("3人でヘリコプターに乗り込み、大型医療機関に\n降り立った。\nこの時間じゃ医療スタッフの大半は、\n既に帰っているみたいだ。")
	await novel_interface.show_text_only("建物内部は設備の駆動音であるホワイトノイズを\n除くと、自分達の足音しか聞こえてこない。")
	await novel_interface.show_text_only("真夜中の人っ気のない病院の廊下……\n\n薄暗くはない分、真っ暗闇であるよりも\n不気味さを連想してしまう。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("ここって……病院だよな？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さっきの乗っていたヘリのパイロット2人は\n俺の良く知る捜査員だったので、\n今回も簡単には済まない状況となっているのが\n予想できた。")
	await novel_interface.show_text_only("マリルが任務に具体的な関与をする事は\nほとんどない。\nしかし、今回は情報を知りうる人間を\n最小限に抑えたいと考えているようだ。")
	await novel_interface.show_text_only("さらに歩いている最中、ここにある全ての\n監視カメラが壁に向けられている事に気付いた。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("ここは播磨脳科学総合研究センターの\n実験医療部門だよ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("今回のターゲットだが、色々な意味で\n非常にデリケートだ。\nだから本作戦は絶対機密として取り扱う。\n──元老院も含めてな。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("播磨脳研って……\n元老院側の研究機関じゃないの？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺のSID訓練カリキュラムに、できるだけ接触を\n避けるべき機関を暗記する項目があり、\nその中の1つに播磨脳研が存在していた。")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("ブライト博士が、昔ここの研究員だったって……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("あのゴリラは自身の縄張りを持っているから、\n今じゃ播磨脳研との関りも薄くなった。","マリル")
	await novel_interface.show_dialog("まあ、安心しろ。\nここは応用科学の研究部門に過ぎない。\nSIDも時々、この機関に発注をかけている。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("設備の購入額はかなりのものだったよ～～？\n\nこの実験医療部門のビルも、設備を整えるため\nだけに建てられたんだから。","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は指で「マネー」のサインを作る。")
	await novel_interface.show_text_only("アハハハ……安心と信頼の取引関係だな……")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("今回のターゲットの名前はファビオラだ。\n\n確か、お前とはスカイホテルの一件で\n面識があったはず。","マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("お前の要領が悪いところ見抜いて\n怒鳴り散らしていた、あの変なメイドだ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("思い出した！\n確か赤縁のメガネをかけていたような。\nそれと彼女の主人で、俺よりも全然\n賢そうだった感じの…名前はなんだったっけ。","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("スクルド・エクスロッド。\n第二学園都市の理事会メンバーの一人娘だ。","マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("4時間前、彼女が『クリーニング店』を通じて\n我々にメッセージを送ってきた。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("それって……亡命したいとか？","レン")
	await novel_interface.show_dialog("（イルカぐらいの年齢だったよな、あの子！）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("彼女の情報を基に我々は回収チームを派遣した。\n\nそして協定非武装地域にある教会にて、\n昏睡状態に陥ったファビオラの発見に至る。","マリル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("彼女の血中からはリゼルグ酸ジエチルアミド系の\n化合物が検出された。\nそして教会内部を調べたところ、\n軍事用の化学エアロゾル散布装置を発見。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("幻視させる化学兵器か……兵士同士で殺し合いが始まったりする、非常にユニークな作品だね。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("それって……テロ攻撃じゃないのか？","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("いや、どちらかというと捕獲を目的とした\n罠だろうな……","マリル")
	await novel_interface.show_dialog("スクルドの供述通りであれば、ファビオラは\n「魔女」であるとの事だ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("はぁ？？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こんな真夜中に俺が呼ばれた理由が分かった。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("ファビオラの体内の幻覚剤は中和したのだけど、\n依然として彼女は深い昏睡状態のままでね……","愛衣")
	await novel_interface.show_dialog("過剰量のレボドパを投薬しても、一向に目覚める\n気配がないのよ。","愛衣")
	await novel_interface.show_dialog("しかも、彼女の細胞の新陳代謝レベルが指数的に\n増えて暴走の傾向を示している。\n身体を氷水に浸けても、体温を制御できないわ。","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("すでに彼女の体温は\n内臓の大部分が壊死するレベルに達している。\n普通の人間なら、とっくにお陀仏のレベルよ。\n\nでも、どうやら彼女の身体は計り得ないぐらい\n高温に耐性を持っているみたいでねぇ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("スクルドによれば、ファビオラは体内に\n炎の魔法を宿した魔女だそうだ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("宿した……？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺はその奇妙な言葉が気になった。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("今まで集めたデータを分析すると、魔法は一種の\n情報操作の知識として解釈できる。","マリル")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("イルカのように電磁場を直接操作できるタイプと\n異なり、彼女の場合は寄生とでも呼ぶべきか……\n『ある種の膨大な情報』が自ら彼女を\n宿主として選択した。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("それじゃあ、まるで生き物じゃないか……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("まるでじゃない、生き物なんだよ。\n高密度な情報量と、十分に低いエントロピー値。\nこの2つの条件を満たしているのであれば、\n自己意識の誕生は有り得るのよね。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("ファビオラの理性が薄れていくのにつれ、\nその『生きている情報』は、\n彼女の身体をゆっくりと浸食し続けていく……","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("意識不明になった飼い主が自分の飼うペットに\n食い殺されてしまったニュースを思い出し、\n俺は思わずゾッとした。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("幸いにも、目覚めない原因は判明しているわ──\n\n彼女が起きないのは、元々「起きている」\nからに違いない。","愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("スキャンの結果、彼女の海馬体と前頭前皮質に\n活発な運動が見られるわ……\nまるで何かを思い出しているみたいに。","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("なのに脳幹の領域には有効な反射信号もなく、\nまるで何かによって閉じ込められている感じ。","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣はやや興奮して、説明が早口になる。")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("そこでボルツマン探測機を使って、スキャンして\nみたんだけど……\nなんと異変空間の特徴を示しちゃったのよッ！！","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("魔女の繭が……彼女の脳の中に？？","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("ビンゴ～～！","愛衣")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("そこで思い出したのよっ！\n\n尋問と訓練のためにSIDが播磨脳研に開発を\n依頼していた、脳への潜入装置がある事をね！！","愛衣")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("まだ制作中のプロトタイプだけど、\nアルファテストまでは済んでるわ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("それで、俺がモルモットに選ばれたわけか……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("お前は最終手段だ。","マリル")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("既に4人の捜査員がファビオラの脳内への潜入を\n試みたが、全員が何かによって阻害された。","マリル")
