# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Эй, у тебя когда-нибудь возникало такое чувство?")
	await novel_interface.show_text_only("Вы помните сцену... но понятия не имеете, когда она произошла.")
	await novel_interface.show_text_only("Я не имею в виду дежавю. У каждого это случается в то или иное время.")
	await novel_interface.show_text_only("Я имею в виду, что есть что-то, что вы всегда знали, что когда-нибудь произойдет, и это наконец происходит.")
	await novel_interface.show_text_only("Вы всегда знали, что это произойдет. Вы даже видели это в виде воспоминаний. Вы просто не можете быть уверены, когда это произойдет.")
	await novel_interface.show_text_only("То, что мы называем дежавю, — это просто своего рода подтверждение того, что ваши предчувствия сбылись.")
	await novel_interface.show_text_only("Вы знали, что это произойдет. Ты всегда знал.")
	await novel_interface.show_text_only("Не так ли?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Хм…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка сонно открывает глаза, трет лицо и обнаруживает, что лежит на скамейке.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Фабелла... где мы?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Но Фабелла не отвечает. Странный. Горничная обычно появлялась в тот момент, когда называли ее имя.")
	await novel_interface.show_text_only("Девушка оглядывается и видит пустую улицу, по обеим сторонам которой стоят стройные фонари. Улица, кажется, продолжается вечно в жуткой тишине, как будто это какая-то альтернативная вселенная.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Разве мы не были в церкви...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ааа... Фабелла!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд поднимается на ноги, массируя рукой ноющий висок.")
	await novel_interface.show_text_only("Она помнит кошмар, который ей приснился. Помнит перекрученные изображения на мозаичных окнах. Но был ли это действительно просто кошмар?")
	await novel_interface.show_text_only("Она помнит, как Фабелла выгнала ее из церкви, освободив от тьмы, которая в противном случае забрала бы ее...")
	await novel_interface.show_text_only("Скульд проверяет свои вещи. Ее мобильный телефон, кошелек, аксессуары... все здесь.")
	await novel_interface.show_text_only("На ее телефоне тридцать два пропущенных звонка.")
	await novel_interface.show_text_only("Если бы Фабелла не установила на телефон программу против слежения, посольство, вероятно, уже бы ее обнаружило.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Десять восемнадцать вечера... уже так поздно?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она зажмуривает глаза, изо всех сил стараясь регулировать дыхание, чтобы разобраться в запутанном беспорядке, составляющем ее воспоминания.")
	await novel_interface.show_text_only("Она должна сохранять спокойствие — этого хотели отец и Фабелла. Ей всегда говорили, что чем опаснее ситуация, тем больше ей нужно сохранять ясную голову.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Эта церковь... и сообщение отца Антона... должно быть, ловушка.","Skuld")
	await novel_interface.show_dialog("Кто бы это ни был, должно быть, он нацелен на меня, отец или Фабелла.","Skuld")
	await novel_interface.show_dialog("Я слышу машины на близлежащих дорогах и даже уличных артистов, играющих песню на расстоянии... и я не связан или что-то в этом роде.","Skuld")
	await novel_interface.show_dialog("Согласно GPS моего телефона, я нахожусь в центральном парке Арай, недалеко от церкви.","Skuld")
	await novel_interface.show_dialog("Тот, кто привел меня сюда, вероятно, не имел в виду никакого вреда.","Skuld")
	await novel_interface.show_dialog("Я не знаю, принадлежал ли тот, кто устроил ловушку, и тот, кто привел меня сюда, к одной и той же фракции... Я не могу просто так вернуться назад.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд еще раз набирает номер Фабеллы. И снова речь идет о голосовой почте. Она проверяет все свои записи, и похоже, что Фабелла вообще с ней не связывалась.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Фабелла...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Наконец она звонит отцу, крепко сжимая телефон в маленькой руке.")
	await novel_interface.show_text_only("Он поднимает трубку в ту же секунду, как проходит звонок.")
	await novel_interface.show_dialog("Скульд? Это ты?","Отец")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Отец...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Где ты, черт возьми? Уже десять вечера. где вы находитесь. Все умирают от беспокойства!","Отец")
	await novel_interface.show_dialog("И ни ты, ни твоя горничная не взяли трубку! Что с вами двумя? Посол Хаггерти уже отправил команду искать вас!","Отец")
	await novel_interface.show_text_only("Похоже, ее отец злится, но Скульд просто рад услышать его голос.")
	await novel_interface.show_text_only("По крайней мере, никто не пытался ему чем-либо угрожать, используя ее в качестве заложницы.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Теперь я в безопасности, не волнуйся, но послушай—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мужчина сразу замолкает из-за настойчивости в тоне дочери.")
	await novel_interface.show_dialog("... Ты один?","Отец")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Да. Только я.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Подождите секундочку, я перезвоню вам по другому номеру.","Отец")
	await novel_interface.show_text_only("Она вешает трубку и тут же получает звонок с неизвестного номера.")
	await novel_interface.show_dialog("Хорошо, теперь ты можешь говорить. Что случилось?","Отец")
	await novel_interface.show_text_only("Скульд делает глубокий вдох. Согласно тому, что ей сейчас известно, должно быть две возможности:")
	await novel_interface.show_text_only("Если те, кто устроил ловушку, и те, кто привел ее сюда, были из одной группы, то их целью должна быть Фабелла, а не сама Скульд.")
	await novel_interface.show_text_only("Если они не из одной группы, то мишенью может стать она сама — тот, кто хотел ее, потерпел неудачу и в настоящее время держит в заложниках Фабеллу и отца Антона.")
	await novel_interface.show_text_only("Что бы это ни было, ее самый любимый человек в мире находится в опасности.")
	await novel_interface.show_text_only("И все же, если последнее, она не может просто пойти и поискать Фабеллу сама. Это было бы прямо в ловушку, и она, вероятно, тоже окажется заложницей, которую похитители смогут использовать против Отца и Комитета.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Можете ли вы сначала сделать что-нибудь для меня? Мне нужно, чтобы кто-нибудь проверил отца Антона из Троицкой церкви и сказал, в безопасности ли он.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Конечно, я немедленно пришлю кого-нибудь.\nТеперь расскажи мне, что происходит.","Отец")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Не так давно мы с Фабеллой попали в засаду возле посольства. Вероятно, они использовали какой-то галлюциноген или наркотики, изготовленные из вещества H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что?","Отец")
	await novel_interface.show_text_only("Использование химического оружия или оружия, изготовленного с использованием вещества H, на международной территории практически равносильно объявлению войны Объединенному Конгрессу.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Фабелла рисковала своей жизнью, чтобы спасти меня. Я не знаю, где она сейчас...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Эти ребята, должно быть, прислали мне сообщение, представившись отцом Антоном, и заманили меня туда.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… Понятно.","Отец")
	await novel_interface.show_dialog("Форум Мира состоится в следующем месяце... почему вам пришлось ехать в Новую Опулентию в такой ответственный момент...?","Отец")
	await novel_interface.show_dialog("Тот, кто осмелится сделать это, определенно будет очень осторожен в отношении своей личности.","Отец")
	await novel_interface.show_dialog("Хотя бывший босс Фабеллы в Южной Америке скончался, у него все еще немало врагов...","Отец")
	await novel_interface.show_dialog("В любом случае, где ты сейчас?\nЯ устрою кое-что с внешними связями и верну тебя обратно в Ньюморидас.","Отец")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Сначала ты должен мне пообещать! Обещай мне, что спасешь Фабеллу!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Голос Скулда дрожит, глаза наполняются слезами.")
	await novel_interface.show_dialog("…","Отец")
	await novel_interface.show_text_only("На другом конце линии тишина.")
	await novel_interface.show_text_only("Скульд знает, что ее отец чрезвычайно опытен и всегда хорошо информирован. Он сможет легко проанализировать ситуацию и решить, как лучше действовать.")
	await novel_interface.show_text_only("Ее отец является основателем компании хедж-фонда, которая процветала на финансовом рынке во время войны благодаря его отличным навыкам принятия решений. Так он заслужил себе место в Комитете.")
	await novel_interface.show_text_only("Но именно так он заработал бесчисленное количество врагов. В конце концов, падение акций сильно отличается от падения страны.")
	await novel_interface.show_text_only("Скульд вырос в среде, наполненной ненавистью и опасностями. Но ее отец был на удивление настойчив и отказался изменить свое поведение ради дочери.")
	await novel_interface.show_text_only("Возможно, это как-то связано с ее матерью, которая умерла, когда она была очень маленькой.")
	await novel_interface.show_text_only("Внезапно Скульд замечает небольшую красную рамку на экране своего телефона.\nЭто указывает на то, что ее местоположение отслеживается во время разговора.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она тут же кладет трубку.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Теперь они знают мое местоположение! Надо уйти отсюда...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Скульд вбегает на лестницу ближайшей автостоянки.")
	await novel_interface.show_text_only("Она набирает номер прачечной самообслуживания в своих контактах. Фабелла дала ей этот номер в крайнем случае.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Думаю, у меня сейчас нет выбора!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Присев на ступеньки, девушка набирает номер.")
	await novel_interface.show_text_only("После трёх звонков говорит милая дама.")
	await novel_interface.show_text_only("Прачечная Рексхилл. Рад служить вам.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Я Скульд Аксельрод, международный идентификационный номер. АХ1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Понятно. Пожалуйста, подождите...")
	await novel_interface.show_text_only("Мисс Аксельрод, ваше белье готово. Мы отправим его вам?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Конечно. Кстати, моей подруге из Мемориальной церкви Нью-Опулентия нужно забрать белье.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Понятно.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Я сейчас…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мы знаем, где вы находитесь. Пожалуйста, будьте терпеливы.")
	await novel_interface.show_text_only("Женщина вешает трубку.")
	await novel_interface.show_text_only("Десять мучительных минут спустя на парковку въезжает черный внедорожник.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Добрый день, мисс Аксельрод.","SID-изображение")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Вы из... Сида?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Да. Мы уже нашли вашего друга.","SID Agent")
	await novel_interface.show_dialog("Пожалуйста, входите.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
