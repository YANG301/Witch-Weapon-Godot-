# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella è ancora seduta su di me, nell'ombra di qualche oggetto concreto.")
	await novel_interface.show_dialog("So come evitare che l'obiettivo rifletta la luce.","Fabella")
	await novel_interface.show_text_only("Dice lei, immobilizzandomi a terra con una mano.")
	await novel_interface.show_dialog("Eh?\n(Aspetta, cosa farà?)","Ren")
	await novel_interface.show_text_only("La mano sinistra di Fabella è a terra accanto al mio viso, sostenendo il suo peso. Il suo ginocchio destro si infila tra le mie gambe. Quel sorrisetto sul suo viso... inquietante.")
	await novel_interface.show_text_only("Poi abbassa la mano destra e mi tira dolcemente le calze di seta...")
	await novel_interface.show_dialog("Shh.","Fabella")
	await novel_interface.show_text_only("Incapace di vedere le sue azioni dal mio punto di vista, posso solo immaginare cosa sta facendo da quello che sento laggiù.")
	await novel_interface.show_dialog("(No... per favore, no...)\n(Per favore, non laggiù...)","Ren")
	await novel_interface.show_text_only("Mi bruciano le guance, il cuore mi batte all'impazzata nel torace. Le mie dita cercano a tentoni il terreno in una sorta di riflesso.")
	await novel_interface.show_dialog("(Non importa come la vedo, questo... non è l'ideale...)","Ren")
	await novel_interface.show_text_only("Fabella sembra abbastanza soddisfatta della mia espressione agitata e in preda al panico. Forse da tempo desiderava dare una lezione a questo novellino.")
	await novel_interface.show_text_only("All'improvviso, la sua presa si stringe e subito dopo mi viene strappato un buco dalle calze di seta.")
	await novel_interface.show_text_only("Non posso fare a meno di gridare nel momento in cui accade.")
	await novel_interface.show_dialog("Ahh!","Ren")
	await novel_interface.show_text_only("Sento nel mio auricolare il suono di qualcuno che deglutisce a fatica, seguito da Cassel che tossisce violentemente.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Continuando dall'apertura, Fabella stacca ancora un po' la stoffa, poi mi toglie le scarpe e mi toglie dalle gambe ciò che resta delle calze.") #换行问题
	await novel_interface.show_text_only("Riesco a malapena a parlare per l'imbarazzo mentre lei mi aiuta a rimettermi le scarpe.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Aw, andiamo...)\n(Le mie gambe sono tutte fredde adesso...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, hai le gambe morbide.\nNessun muscolo.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Haha, mi dispiace, immagino?")
	await novel_interface.show_text_only("Non ho ancora ripreso la calma, ma Fabella è già tornata a comportarsi in modo professionale, da comandante quale è.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Tutti quanti, rimettetevi in ​​sesto.","Fabella")
	await novel_interface.show_dialog("Abbiamo bisogno di un piano. Dopo aver individuato la posizione del cecchino, come lo eliminiamo?","Fabella") #换行问题
	await novel_interface.show_dialog("Credo che il loro compito sia semplicemente quello di distrarci dal vero campo di battaglia laggiù...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella indica il tratto di strada in fiamme dietro di noi, dove si sentono i colpi di spari rapidi.")
	await novel_interface.show_dialog("Hm... il dispositivo di accelerazione elettromagnetica a breve distanza impiega circa 4,5 secondi per caricarsi.","Russel")
	await novel_interface.show_dialog("Il dispositivo richiede un mirino per essere calibrato, quindi anche se il cecchino utilizza una di quelle pistole che sparano più colpi contemporaneamente, l'attrezzatura non gli consentirà di farlo.","Russel")
	await novel_interface.show_dialog("Dobbiamo trovare la loro posizione dopo che hanno sparato una volta ed eliminarli prima che possano sparare una seconda volta.","Russel")
	await novel_interface.show_dialog("Il problema è che il nostro fucile da cecchino è ancora nel bagagliaio. E come facciamo a farli sparare contro di noi senza metterci in pericolo?","Cassel")
	await novel_interface.show_text_only("Fabella studia silenziosamente la strada davanti a sé con un riflettore e nota la portiera di un'auto abbandonata che pende dalla coda di un veicolo blindato rovesciato.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("...Deve essere caduto durante l'esplosione.","Fabella")
	await novel_interface.show_dialog("Ragazzi, potete trovarmi alcuni dati su quanto sia durevole l'armatura di Sostanza H su quel nostro camion ridicolmente costoso?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vuoi dire... vuoi usarlo come scudo...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Probabilmente sarà un buon scudo.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ah?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("C'è un video online di un miliardario che ha utilizzato quel tipo di veicolo in un esperimento di tiro.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche sotto il fuoco di un Barretta M82A1 dotato di un dispositivo di accelerazione stabilizzante elettromagnetico, il camion non è stato minimamente influenzato.")
	await novel_interface.show_text_only("Quel miliardario si stava solo mettendo in mostra con le sue mazzette di banconote e il suo accento russo. Ma non si può negare che il video fosse popolare.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Se pensi che sia sicuro, lo fai.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Eh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella fruga sulla mia giacca militare, come se cercasse il punto perfetto, poi dal nulla mi sferra un pugno.")
	await novel_interface.show_text_only("È stato un pugno davvero impressionante. Solo guardandolo, ero convinto che mi avrebbe ucciso in quel momento. Ma tutto ciò che sentivo era un leggero tremore nella parte superiore del corpo.")
	await novel_interface.show_text_only("Il fluido non newtoniano che riempie la mia maglietta, sebbene normalmente morbido, si indurisce nel momento in cui viene colpito da una forza qualsiasi.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Bella giacca. Quando in seguito sollevi la portiera della macchina, ricordati di appoggiarti ad essa e di lasciare che la giacca assorba lo shock invece di usare le mani.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Io—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prima che possa protestare, Fabella mi mette una maschera sulla bocca.")
	await novel_interface.show_text_only("Poi tira fuori dalla cintura una pistola simile a un giocattolo e mira al tetto dell'edificio di fronte.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Bomba flash da sei secondi, pronta...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("Un puntino di luce ultraluminoso vola fuori dalla pistola, spazzando oltre il bellissimo cielo notturno prima di scendere finalmente.")
	await novel_interface.show_text_only("Fabella aspetta che il puntino sia sceso abbastanza in basso prima di trascinarmi con una corsa folle fino al camion ribaltato, dietro il quale ci nascondiamo entrambi.")
	await novel_interface.show_text_only("Anche Cassel e Russel ci seguono fino a un blocco vicino dove possono vederci e comunicare con noi.")
	await novel_interface.show_text_only("Fabella inserisce la password nella porta sul retro del bagagliaio e recupera uno Scout leggero dalla rastrelliera delle armi.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Questo è migliore per mirare rapidamente.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, prepara il drone. Tienilo dietro l'angolo dell'edificio in modo che il cecchino non possa vederlo. Lascialo uscire solo quando è abbastanza alto.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ordina Fabella, gettando a Cassel le calze di seta che mi ha strappato dalle gambe, avvolte attorno ad una pietra.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Appena sfornato!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel mi lancia un'occhiata mentre afferra l'oggetto, con un'aria leggermente imbarazzata, e io faccio del mio meglio per evitare il suo sguardo, con la faccia cremisi.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, tieni gli occhi sulle immagini trasmesse e riferiscimelo.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Roger, quello.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella poi solleva la portiera della macchina, controlla l'armatura riflettente di Sostanza H a forma di alveare su di essa e me la infila tra le braccia.")
	await novel_interface.show_text_only("È più leggero di quanto pensassi. Potrei sollevarlo anche con una mano.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Ma perché devo fare da esca?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Anche se non è che io sappia fare qualcos'altro...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella mi stringe a sé e mi sussurra all'orecchio:")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ascolta attentamente. Non appena darò l'ordine, tu esci da quel lato con il fumo pesante, nascosto dietro questa porta.","Fabella")
	await novel_interface.show_dialog("Il cecchino dovrebbe trovarsi tra i piani trenta e cinquanta. Rimani coperto, non lasciare che ti vedano il sedere o altro...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Altrimenti non avrai più il sedere.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Subito dopo aver finito di parlare mi spinge nel fumo e mi fa cenno di aspettare lì.")
	await novel_interface.show_text_only("Intanto Cassel ha già coperto l'obiettivo della telecamera con le calze, e ha fatto volare il drone fino a una decina di piani di altezza, nascosto nell'ombra.")
	await novel_interface.show_text_only("Il rivestimento che rifrange la luce del drone gli consente di mimetizzarsi perfettamente con l'ambiente circostante. Nessuno sarebbe in grado di dire che è lì a meno che non guardi molto, molto attentamente,")
	await novel_interface.show_text_only("Cassel e Russel danno entrambi l'ok, e Fabella carica il fucile di precisione tra le sue mani. Lei mi fa un cenno...")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Devo affrontare il problema...","Ren")
	await novel_interface.show_dialog("(Aya ha detto che starò bene anche se \"morissi\"...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Aspetta, non ha detto che sarei un semplice osservatore e non potrei interagire con l'ambiente?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel mio momento di esitazione, qualcosa mi colpisce il sedere. È Fabella con la sua pistola. Sembra pronta a farmi saltare la testa se non inizio a muovermi presto.")
	await novel_interface.show_text_only("Sospiro, avanzando scontroso fuori dal fumo, nascosto dietro la portiera della macchina.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(Quel miliardario avrebbe fatto meglio a non usare oggetti di scena falsi quando ha realizzato quel video...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continuo ad avanzare, finché sono a cinque o sei passi dal fumo pesante.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(... Nessuno mi spara?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il cecchino dovrebbe essere in grado di vedermi facilmente. Potrebbero dire che sono un'esca?")
	await novel_interface.show_text_only("All'improvviso, da dietro arriva un rumore di passi. Dalla periferia della mia visione, Fabella scivola con grazia alla vista, finendo in posizione semiaccovacciata ai miei piedi.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—C-cosa?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Coprimi!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Qualcosa si schianta contro la porta che sto sostenendo con un forte botto. La forza devastante mi fa barcollare all'indietro, facendomi perdere l'equilibrio.") #文字错误
	await novel_interface.show_text_only("Atterro a sedere, la porta spalancata. Io e Fabella siamo bersagli facili e completamente aperti.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh no!)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Al quarantaduesimo piano! Terza finestra da destra! Hanno la guida laser accesa!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È in quel momento che il nostro drone, nascosto nel cielo notturno, spara un laser rosso contro la finestra dell'edificio di fronte.")
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("Bang! Bang!")
	await novel_interface.show_text_only("Fabella spara, tre volte di seguito.")
	await novel_interface.show_text_only("Poi il silenzio: un silenzio senza vita, che induce alla disperazione. Posso praticamente sentire il mio cuore pompare il sangue nel cervello.")
	await novel_interface.show_text_only("Secondo dopo il secondo passaggio. Trattengo il respiro, immaginandomi di essere fatto a pezzi da un raggio di luce.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Obiettivo eliminato. Ripeto, obiettivo eliminato!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("Ahah!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Ben fatto!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Invece di festeggiare, Fabella continua ad inginocchiarsi nella stessa posizione, con l'arma pronta.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Shh, tranquillo. Ragazzi, avete sentito...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tendendo l'orecchio, mi accorgo che sento effettivamente un elicottero che si avvicina.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cos'è quello... un VTOL?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
