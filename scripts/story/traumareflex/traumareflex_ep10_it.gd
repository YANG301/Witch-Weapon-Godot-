	await novel_interface.show_text_only("È noto per trasportare dodici missili anticarro, rendendolo perfetto per le campagne di annientamento.")
	await novel_interface.show_text_only("La mietitrice a strisce gialle e nere appare dal cielo e atterra tra noi e l'edificio di fronte.")
	await novel_interface.show_text_only("È allora che mi rendo conto che abbiamo finito.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
