	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Aham, deixe-me praticar um pouco mais...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se eu for demitido antes mesmo de passar no treinamento, Mariru provavelmente me pisoteará até a morte.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Bem-vindo de volta, Mestre!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("O que o Mestre gostaria que eu escrevesse na sua omelete, nyan?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ugh, isso é tão embaraçoso!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ok, vamos tentar mais uma vez...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ah, está ficando tarde. Tenho que tirar essa roupa ridícula e ir para a cama...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Essa roupa de empregada fica bem em você.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Sim! Você será uma empregada tão boa!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Saio do banheiro e encontro Mariru e Aya no sofá do meu apartamento, parecendo incrivelmente divertidas.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Mariru? E Aya também?","Ren")
	await novel_interface.show_dialog("Quando... quando você chegou aqui?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Já estamos aqui há algum tempo, na verdade.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Então... minha prática...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Ouvimos tudo, claro!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("Mate-me agora...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ah... enfim, o que você está fazendo aqui?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Para ver você se vestir de empregada doméstica e realizar todas as suas fantasias na frente do espelho, claro!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você teve que colocar dessa forma?\n(Embora ela não esteja errada, suponho...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Não é minha culpa ter que treinar para a missão secreta que você me deu.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você realmente acha que será uma boa empregada apenas repetindo algumas falas? Não é tão fácil, você sabe.","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("O helicóptero está esperando no telhado. Vamos.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein? Você tem uma missão para mim? A esta hora da noite?\nEspere um segundo, preciso sair dessa...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Tudo bem. Nosso alvo para esta missão também é uma empregada doméstica, então você se encaixará perfeitamente.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ela apenas sorriu? Ela definitivamente fez isso! Eca!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mas... essa roupa...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Não será um problema. Quando você encontrou o alvo pela última vez, você também estava vestido com uma roupa de empregada.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Venha conosco e você verá.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Nós três levamos o helicóptero para um grande centro médico, atualmente meio vazio, pois a maior parte do pessoal já havia ido para casa.")
	await novel_interface.show_text_only("O prédio está silencioso, exceto pelo som das máquinas zumbindo ao fundo. Nossos passos ecoam nas paredes silenciosas e caiadas.")
	await novel_interface.show_text_only("Não há ninguém à vista. Os corredores bem iluminados parecem ainda mais macabros do que a escuridão total.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Isto é... um hospital?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu poderia dizer que esta deve ser uma operação secreta pelo fato de os pilotos do helicóptero serem ambos agentes com os quais estou familiarizado.")
	await novel_interface.show_text_only("Mariru raramente participa de missões, mas é óbvio que, desta vez, ela quer garantir que quanto menos pessoas souberem disso, melhor.")
	await novel_interface.show_text_only("Também noto que todas as câmeras de segurança aqui foram torcidas para ficarem de frente para as paredes.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Este é o Departamento de Medicação Experimental do Centro de Pesquisa da Harima Tech.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("A identidade do nosso alvo desta vez é extremamente sensível. A missão é ultrassecreta, nem mesmo o Senado pode saber.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Harima Tech... mas não pertence ao Senado?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Durante meu treinamento SID, tive que memorizar os nomes de todas as organizações para evitar. Harima Tech é uma delas.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("E o Dr. Bright não era um pesquisador aqui?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ah, aquele homem gorila? Ele está estabelecido de forma independente agora. Este lugar não tem mais nada a ver com ele.","Mariru")
	await novel_interface.show_dialog("Este é um departamento de pesquisa prática. O SID faz muitos pedidos desse tipo de organização.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Encomendamos muitos equipamentos especiais daqui! Na verdade, a maioria dos edifícios deste departamento foram construídos exclusivamente para...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por dinheiro. Aya não precisa dizer isso.")
	await novel_interface.show_text_only("Ha, uma relação comprador-vendedor muito... confiável, hein?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Nosso alvo se chama Fabella. Você a conheceu uma vez, na missão no Sky Hotel.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ela é a empregada que te puxou de lado e te repreendeu por ser um desajeitado.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ah, ela? Eu lembro. Ela usava óculos de armação vermelha, certo? E ela estava trabalhando para uma garotinha...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Isso mesmo. Skurd Axelrod. Filha única de um membro de alto escalão do Comitê Municipal da Segunda Academia.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ela nos enviou uma mensagem há quatro horas através da lavanderia.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Então ela quer... trair seu povo?","Ren")
	await novel_interface.show_dialog("(Skuld não é muito jovem? Pelo que me lembro, ela provavelmente tem a mesma idade de Elluka...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Com base no que Skuld nos contou, nossa equipe de resgate conseguiu encontrar Fabella inconsciente em uma igreja na Zona Desmilitarizada Acordada.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Detectamos compostos do complexo dietilamida do ácido lisérgico em seu sangue. Dispositivos de distribuição de aerossóis químicos de nível militar também foram encontrados nos terrenos da igreja.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Armas químicas alucinógenas, né? Um método muito imaginativo para fazer com que seus inimigos se voltem uns contra os outros, pelo que vejo.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Foi um ataque terrorista?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Não, mais como uma armadilha para mosca.","Mariru")
	await novel_interface.show_dialog("Skuld já nos contou. Fabela é uma bruxa.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Hein?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Agora eu meio que entendo por que eles me pediram para vir até aqui à meia-noite.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Depois de neutralizarmos os alucinógenos no sistema de Fabella, ela ainda está em coma profundo...","Aya")
	await novel_interface.show_dialog("Não conseguimos acordá-la mesmo depois de injetar uma grande quantidade de Levodopa.","Aya")
	await novel_interface.show_dialog("Seu nível de metabolismo celular está disparando e sua temperatura corporal... não fomos capazes de controlá-la nem mesmo mergulhando-a em água gelada.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Qualquer ser humano normal teria perdido a maioria de seus órgãos em condições como esta - mas seu corpo parece ter uma tolerância incrível a altas temperaturas.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Skuld nos contou que Fabella é uma bruxa do fogo. Possuído pela magia do fogo.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Possuído?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Este termo me parece estranho.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("De acordo com nossa análise dos dados que coletamos atualmente, podemos ver a magia como um campo que manipula “informações”.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fabella não é como Elluka, que pode controlar campos elétricos diretamente. A situação dela é mais como... “certas informações poderosas” escolheram possuí-la.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Você está falando como se a informação tivesse vontade própria.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Eles fazem. Se uma série de informações tiver uma densidade suficientemente alta e um valor de entropia suficientemente baixo, ela poderá ganhar um testamento.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Quando Fabella perdeu a consciência, a “informação viva” começou a tomar conta de seu corpo...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De certa forma, isso me lembra aquela notícia em que um dono em coma foi comido por seu próprio animal de estimação. Estou ficando arrepiado só de pensar nisso.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Logo percebi que o motivo pelo qual não conseguíamos acordá-la era porque ela já estava “acordada” em primeiro lugar.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Escaneamos seu hipocampo e córtex pré-frontal, e ambos estavam ocupados no trabalho, como se ela estivesse relembrando alguma coisa.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("No entanto, seu tronco cerebral não enviou nenhum sinal reflexivo eficaz. É como se algo estivesse bloqueando isso.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As palavras de Aya saem rapidamente. Ela parece muito ansiosa.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("E quando escaneamos seu cérebro com um sensor Boltzmann, detectamos traços de mutações...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Espere... você quer dizer que há casulos de bruxa... no cérebro dela?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Bingo!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Então pensei, acontece que temos um dispositivo que nos permite invadir o cérebro de alguém, por assim dizer. A Harima Tech já o desenvolve para o SID há algum tempo.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("É apenas um protótipo, mas já passou no teste alfa.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Então sou seu rato de laboratório agora?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Você é nosso último recurso.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Já enviamos quatro agentes para o cérebro de Fabella, mas algo os “rejeitava”.","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("Os agentes descreveram-no como “um muro sem fim no caminho”.","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
