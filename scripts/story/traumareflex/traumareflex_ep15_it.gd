# traumareflex_ep15.gd - 创伤反射篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第15话剧本
	traumareflex_ep15_script()

func play_script():
	pass

# 创伤反射篇第15话 - 正式剧本
func traumareflex_ep15_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Cecità di Anton.")
	await novel_interface.show_text_only("Malattia in cui il paziente, pur essendo cieco, persiste nel credere di poter ancora vedere.")
	await novel_interface.show_text_only("Anche se il paziente può avere piccoli lividi sugli arti a causa dello scontro con gli oggetti, troverà comunque diverse ragioni per spiegarlo.")
	await novel_interface.show_text_only("Ecco come funziona il cervello. Forgia nuovi ricordi per fornire una spiegazione a cose che non riesce a capire.")
	await novel_interface.show_text_only("È una sorta di istinto di autoconservazione che abbiamo quando affrontiamo l’ignoto.")
	await novel_interface.show_text_only("Forse è semplicemente perché non siamo ancora preparati ad affrontare l'oscurità dietro il cielo stellato?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	await novel_interface.show_text_only("Uhm. Se quei ragni non fossero stati mandati dagli uomini di Rina...")
	await novel_interface.show_text_only("Allora da dove venivano? Armi meccaniche, su scala così grande, compaiono all'interno della Seconda Città Accademia proprio così. Inaudito.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Forse anche qualcun altro ha portato certi elementi in questo ricordo? Non solo io?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O forse non è qualcuno, ma... qualcosa dotato di volontà propria.")
	await novel_interface.show_text_only("Ricordo che, prima che iniziasse questa missione...")
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Skuld ci ha detto che Fabella è una strega del fuoco. Posseduto dalla magia del fuoco.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Posseduto?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Fabella non è come Elluka, che può controllare direttamente i campi elettrici. La sua situazione è più simile a quella... \"certe informazioni potenti\" hanno scelto di possederla.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Parli come se l'informazione avesse una volontà propria.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Lo fanno. Se una stringa di informazioni ha una densità sufficientemente elevata e un valore di entropia sufficientemente basso, può acquisire una volontà.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Quando Fabella perse conoscenza, le \"informazioni viventi\" iniziarono a impossessarsi del suo corpo...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Informazioni viventi... che prendono il sopravvento...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Può essere?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quei ragni robot sono creati da quel “qualcosa” che possiede Fabella?")
	await novel_interface.show_text_only("Ed è per questo che devo presentarmi, per evitare che quella \"informazione con volontà\" distorca i ricordi di Fabella?")
	await novel_interface.show_text_only("Ma sembra che ci abbia provato molte volte e abbia continuato a fallire.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Come dovrei gestire questi bug, allora?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervosamente frugo nella mia attrezzatura. Se ogni cosa su di me avesse uno scopo...")
	await novel_interface.show_text_only("L’unico che non ho ancora utilizzato è il piccolo kit di emergenza.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Non può fare molto tranne, sai, \"recuperare HP minimi\", però... considerato praticamente inutile in quei giochi di zombi...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faccio scorrere le dita sulla morbida borsa a forma di cubo nel mio zaino.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Aspetta...)\n(Sembra che...)","Ren")
	await novel_interface.hide_character()

	# 战斗部分剧本
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Spara, quegli insetti stanno arrivando.","Russel")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	await novel_interface.show_text_only("Seguo il rumore del rumore e vedo più di una dozzina di ragni arrampicarsi sulla tromba dell'ascensore. Altri stanno arrivando da dietro di loro.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Tutti, al vostro posto!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La squadra entra immediatamente in modalità battaglia e inizia a sparare.")
	await novel_interface.show_text_only("Fabella con una mano carica il fucile, con l'altra impugna un pugnale. Usa l'avambraccio sinistro come supporto per la pistola mentre mira.")
	await novel_interface.show_text_only("Fa fuori due ragni con due colpi netti, poi ne fa a pezzi un terzo con il pugnale e il piede sinistro, sopraffatta dalla rabbia verso quei mostri che hanno preso la sua amica.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Sto finendo le munizioni!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel lancia una rivista a Cassel.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Questo è l'ultimo. Vai a controllare gli scaffali di stoccaggio e vedi se qualcosa è utilizzabile.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel annuisce, ricarica la pistola e continua a indietreggiare mentre continua a sparare, finché non scompare dietro una fila di scaffali.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("Skuld, mettiti dietro di me!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stringo forte il mio fucile mitragliatore, passando alla modalità a colpo singolo.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Mi restano solo una dozzina di proiettili circa...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ehi, Russel, indovina cosa ho trovato!\nUn'intera cassa di vodka distillata polacca, invecchiata di quindici anni.","Cassel")
	await novel_interface.show_text_only("Cassel sembra straordinariamente eccitato.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Idiota, stai cercando di preparare una bomba Molotov?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Penso che funzionerebbe. Dice una gradazione alcolica del 96%... sicuramente non è pensato per essere bevuto.","Cassel")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Rina ha detto che quei ragni individuano i loro bersagli sentendo il calore.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Le bombe molotov non sono così semplici da preparare.","Fabella")
	await novel_interface.show_dialog("Devi prima sigillare l'apertura della bottiglia, altrimenti probabilmente ti brucerai. E hai bisogno di qualcosa che possa assorbire l'acqua, come una striscia di stoffa, da usare come miccia.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella ha già abbattuto una decina di ragni, ma dalle porte dell'ascensore ne stanno arrivando altri.")
	await novel_interface.show_text_only("Stiamo finendo le munizioni e non abbiamo altra scelta che fare marcia indietro, avvicinandoci.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("I nostri completi sono tutti realizzati in fibra impermeabile. Dove troviamo tessuti in grado di assorbire liquidi? Dobbiamo spogliarci e restare in mutande o qualcosa del genere?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("E-ehi, prova questo!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lancio il mio “piccolo zaino di emergenza” a Cassel prima di voltarmi e correre verso le colline.")
	await novel_interface.show_dialog("Ehm? Che cos'è questo?","Cassel")
	await novel_interface.show_dialog("Serie F... confezione da 18... alta traspirabilità, senza agenti fluorescenti...","Cassel")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("Smettila di leggerlo ad alta voce!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Periodo mestruale... per pelli sensibili... lungo 250 mm...\nPuò essere...","Cassel")
	novel_interface.show_character("ren_mercenary","shy_left")
	await novel_interface.show_dialog("Avanti, idiota, non leggerlo ad alta voce!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, vedo di cosa si tratta. È perfetto.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella mi lancia uno sguardo significativo.")
	await novel_interface.show_dialog("Ooh, è meraviglioso!\nSi gonfia anche un po' dopo aver assorbito l'acqua. Sigillerà perfettamente la bottiglia!","Cassel")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Vuoi davvero entrare nei dettagli? Andiamo...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Presto Cassel riappare da dietro lo scaffale con le sue bombe Molotov appena create.")
	await novel_interface.show_text_only("Seguendo gli ordini di Fabella, teniamo Cassel coperto mentre ci muoviamo tutti insieme verso l'ascensore.")
	await novel_interface.show_text_only("Lancia alcune bottiglie molotov e l'ingresso dell'ascensore va in fiamme.")
	await novel_interface.show_text_only("Eliminiamo il resto dei ragni con le munizioni e le armi da mischia rimanenti.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Per ora dovremmo essere a posto...","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel ha diversi graffi sul gomito e Cassel ha una ferita a una gamba.")
	await novel_interface.show_text_only("Fabella finalmente si calma un po' dopo la caotica battaglia. Lei si avvicina a me e mi dà una pacca silenziosa sulla spalla.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(C-cosa intende con questo?)","Ren")
	await novel_interface.show_dialog("(E perché sorride come se sapesse qualcosa?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sono rimasti solo due proiettili nel caricatore.")
	await novel_interface.show_text_only("Anche se per ora siamo al sicuro, in realtà non mi sono rimasti oggetti utili.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Forse nell'ultimo round, io... sono morto qui?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fisso con ansia le fiamme arancioni che divorano l'ingresso dell'ascensore, e mi chiedo...")
	await novel_interface.show_text_only("Qual è lo scopo di questa situazione del giorno della marmotta?")
	await novel_interface.show_text_only("Non importa quante volte ripeto questa esperienza... quanti nuovi gadget porto con me...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Morirò ancora ancora e ancora?")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("…")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Quello che devi fare è trovare le informazioni chiave nei ricordi del bersaglio. Non lasciare nulla di intentato.","Mariru")
	await novel_interface.show_dialog("L'obiettivo è attualmente alto sulla scala del coma. Non sappiamo molto del suo passato, quindi non siamo sicuri in quale parte della sua memoria sia attualmente bloccata.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ciò significa che devi prestare attenzione ad ogni dettaglio... anche se il tuo obiettivo è sotto la doccia!","Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Aspetta. Quando è avvenuta questa conversazione? In ospedale? Nella sede del SID?")
	await novel_interface.show_text_only("La mia memoria si sta offuscando...")
	await novel_interface.show_text_only("Qual era quella \"informazione chiave\" menzionata da Mariru?")
	await novel_interface.show_text_only("Ha menzionato questo termine?")
	await novel_interface.show_dialog("Signorina Ren...","Skuld")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Signorina Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld, tirandomi per la manica, mi riporta alla realtà.")
	novel_interface.show_character("ren_mercenary","gratified")
	await novel_interface.show_dialog("Ehm?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Quella cosa che hai dato a Cassel... Cos'è?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiede Skuld, studiando la borsa quadrata che ha tra le mani con occhi puri e innocenti.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("Uh... è...","Ren")
	await novel_interface.show_dialog("(Il cielo mi aiuti! Non chiedermelo davanti a tutti!)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tu... non sei abbastanza grande per quello, ahah.","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Neanche io ho molta esperienza nell'usarlo...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cerco goffamente di cambiare argomento. Non voglio davvero spiegare una cosa del genere a una ragazzina così giovane...")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Aspetta. Una ragazzina così giovane...")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(La prima volta che ho incontrato Skuld, era solo leggermente più grande di Elluka.)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma questo ricordo dovrebbe essere di due anni fa. Le ragazze di questa età di solito cambiano molto in due anni.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_text_only("Ma questo Skuld che vedo davanti a me è identico a quello che ho visto in ospedale.")
	await novel_interface.show_text_only("Il suo vestito, l'acconciatura, l'altezza, il viso, persino il leggero odore di latte tra i suoi capelli... esattamente lo stesso.")
	await novel_interface.show_text_only("L'ho... “costruita” secondo i miei ricordi?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella era il capo di una squadra di forze speciali sotto Ritnalap, un'organizzazione di intelligence nella Seconda Città Accademia.")
	await novel_interface.show_text_only("Ma in seguito divenne una cameriera-guardia del corpo per Skuld.")
	await novel_interface.show_text_only("Se questa fosse la prima volta che si incontrassero... cosa è successo esattamente qui?")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Ehi, quegli insetti si stanno riversando dal tetto!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel urla all'improvviso, indicando il soffitto.")
	await novel_interface.show_text_only("Diversi piccoli ragni robot sono entrati di corsa dalla presa d'aria sopra il magazzino.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Uffa, odio gli insetti!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continuo a fissare questo “Skuld” e non mi prendo nemmeno la briga di prendere un'arma da mischia per la nostra ultima resistenza.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Continuo a portare nuovi oggetti di cui ho bisogno in questo mondo...)","Ren")
	await novel_interface.show_text_only("Ma colei che in realtà ha il compito di tenere a bada quelle “informazioni con volontà” è Fabella stessa.")
	await novel_interface.show_text_only("La chiave per invertire la tendenza era già apparsa prima ancora che lo facesse il primo ragno robot, giusto?")
	await novel_interface.show_text_only("Quell'oggetto... sembrava richiedere la mia attenzione, spingendomi a toccarlo...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Skuld, lasciamelo prestare per un po'.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Prendo da Skuld la cartellina di pelle di coccodrillo nera e tiro fuori l'antico manoscritto sbiadito.")
