	await novel_interface.show_dialog("Fuoco... magia...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, un piccolo robot salta e si avventa su Skuld.")
	await novel_interface.show_text_only("Fabella di riflesso gli dà un pugno direttamente sul corpo. In meno di un secondo, il ragno robot nero viene divorato da una palla di fuoco.")
	await novel_interface.show_text_only("Si frantuma in innumerevoli minuscoli componenti, che bruciano tutti in cenere prima ancora di toccare il suolo.")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Cos'è questo...?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella fissa confusa le fiamme sulle sue mani. Si allargarono verso l'esterno, formando una barriera attorno a lei.")
	await novel_interface.show_text_only("Qualunque ragno che osa avvicinarsi alla sua periferia prende spontaneamente fuoco.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/FactoryL.png")
	await novel_interface.show_text_only("La barriera fiammeggiante continua ad espandere la sua portata, come un'immagine 2D che viene bruciata in uno spazio 3D.")
	await novel_interface.show_text_only("Tutto lo spazio rimanente nel magazzino sembra brillare di un'inquietante luce bianca, come se fosse accesa da fiamme provenienti da un piano ancora più alto.")
