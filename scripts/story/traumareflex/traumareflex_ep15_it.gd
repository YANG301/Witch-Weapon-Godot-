	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	await novel_interface.show_text_only("Uno strato di vive fiamme è avvolto attorno al braccio di Fabella, eppure non sento alcun calore, anche se la mia mano tiene la sua.")
