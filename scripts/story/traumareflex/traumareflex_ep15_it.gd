	await novel_interface.show_text_only("Se osservo attentamente riesco effettivamente a distinguere ogni runa. Ma li metto tutti insieme e non riesco a capire niente.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Proprio come la prima volta che ho incontrato Elluka...)","Ren")
	await novel_interface.show_dialog("(Questo manoscritto deve essere una pagina di un Grimorio...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I ragnetti scendono saltellando dal soffitto e strisciano verso di noi. I membri della squadra iniziano a colpirli con pali d'acciaio e piedi di porco.")
	await novel_interface.show_text_only("Prendo da parte Fabella in mezzo a tutto il caos.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Ehi! Cosa pensi di fare?","Fabella")
	await novel_interface.hide_character()
