	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("ใช่ แค่ฉัน.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("รอสักครู่ ฉันจะโทรกลับพร้อมหมายเลขอื่น","พ่อ")
	await novel_interface.show_text_only("เธอวางสายและรับสายจากหมายเลขที่ไม่รู้จักทันที")
	await novel_interface.show_dialog("เอาล่ะ คุยกันได้แล้ว เกิดอะไรขึ้น","พ่อ")
	await novel_interface.show_text_only("สกัลด์หายใจเข้าลึกๆ จากสิ่งที่เธอรู้ในปัจจุบัน ควรมีความเป็นไปได้สองประการ:")
	await novel_interface.show_text_only("ถ้าคนที่วางกับดักและคนที่พาเธอมาที่นี่มาจากกลุ่มเดียวกัน เป้าหมายของพวกเขาต้องเป็นฟาเบลล่า ไม่ใช่สกัลด์เอง")
	await novel_interface.show_text_only("หากพวกเขาไม่ได้มาจากกลุ่มเดียวกัน เธอเองก็อาจเป็นเป้าหมายได้ ใครก็ตามที่ต้องการให้เธอล้มเหลว และขณะนี้จับฟาเบลลาและคุณพ่อแอนตันเป็นตัวประกัน")
	await novel_interface.show_text_only("ไม่ว่าจะเป็นอะไรก็ตาม คนที่เธอชื่นชอบที่สุดในโลกกำลังตกอยู่ในอันตราย")
	await novel_interface.show_text_only("ถึงกระนั้น หากเป็นอย่างหลัง เธอก็ไม่สามารถออกไปตามหาฟาเบลลาด้วยตัวเองได้ มันคงจะเดินตรงเข้าไปในกับดัก และเธอก็อาจจะตกเป็นตัวประกันด้วย ซึ่งผู้ลักพาตัวสามารถใช้ต่อสู้กับพ่อและคณะกรรมการได้")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("คุณช่วยทำอะไรให้ฉันก่อนได้ไหม? ฉันต้องการคนมาตรวจสอบคุณพ่อแอนตันจากโบสถ์ทรินิตี และบอกฉันว่าเขาปลอดภัยหรือไม่","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("แน่นอน ฉันจะส่งคนไปทันที\nตอนนี้ บอกฉันว่าเกิดอะไรขึ้น","พ่อ")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("ฉันกับฟาเบลลาถูกซุ่มโจมตีใกล้สถานทูตเมื่อไม่นานมานี้ พวกเขาอาจใช้ยาหลอนประสาทบางชนิดหรือยาที่ทำจากสาร H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("อะไร?","พ่อ")
	await novel_interface.show_text_only("การใช้อาวุธเคมีหรืออาวุธที่สร้างด้วยสาร H ในดินแดนระหว่างประเทศค่อนข้างจะเทียบเท่ากับการประกาศสงครามกับรัฐสภาคองเกรส")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("ฟาเบลลาเสี่ยงชีวิตเพื่อช่วยฉัน ฉันไม่รู้ว่าตอนนี้เธออยู่ที่ไหน...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("คนพวกนั้นคงส่งข้อความปลอมเป็นคุณพ่อแอนตันมาให้ฉันและล่อฉันไปที่นั่น","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… ฉันเห็นแล้ว","พ่อ")
	await novel_interface.show_dialog("Forum of Peace กำลังจะจัดขึ้นในเดือนหน้า... ทำไมคุณต้องไปที่ New Opulentia ในเวลาอันละเอียดอ่อนเช่นนี้...?","พ่อ")
	await novel_interface.show_dialog("ใครก็ตามที่กล้าทำเช่นนี้จะต้องระมัดระวังอย่างมากเกี่ยวกับตัวตนของพวกเขา","พ่อ")
	await novel_interface.show_dialog("แม้ว่าอดีตหัวหน้าของฟาเบลลาในอเมริกาใต้จะเสียชีวิตไปแล้ว แต่เขายังคงมีศัตรูอยู่บ้าง...","พ่อ")
	await novel_interface.show_dialog("อย่างไรก็ตาม ตอนนี้คุณอยู่ที่ไหนแล้ว?\nฉันจะจัดเตรียมบางอย่างเกี่ยวกับความสัมพันธ์ระหว่างประเทศและนำคุณกลับไปที่นิวโมริดาส","พ่อ")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("คุณต้องสัญญากับฉันก่อน! สัญญากับฉันว่าจะช่วยฟาเบลล่า!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เสียงของ Skuld สั่น ดวงตาเต็มไปด้วยน้ำตา")
	await novel_interface.show_dialog("…","พ่อ")
	await novel_interface.show_text_only("อีกด้านหนึ่งของสาย ความเงียบ")
	await novel_interface.show_text_only("สคูลด์รู้ดีว่าพ่อของเธอเก่งมาก มีความรู้ดีอยู่เสมอ เขาสามารถวิเคราะห์สถานการณ์ได้อย่างง่ายดายและตัดสินใจเลือกแนวทางปฏิบัติที่ดีที่สุด")
	await novel_interface.show_text_only("พ่อของเธอเป็นผู้ก่อตั้งบริษัทกองทุนเฮดจ์ฟันด์ ซึ่งเจริญรุ่งเรืองในตลาดการเงินในช่วงสงครามเนื่องจากทักษะการตัดสินใจที่ยอดเยี่ยมของเขา ด้วยเหตุนี้เขาจึงได้รับตำแหน่งในคณะกรรมการสำหรับตนเอง")
	await novel_interface.show_text_only("แต่นั่นก็เป็นสาเหตุที่ทำให้เขาได้รับศัตรูจำนวนนับไม่ถ้วน การนำหุ้นลงนั้นแตกต่างอย่างมากจากการนำประเทศลง")
	await novel_interface.show_text_only("สกัลด์เติบโตขึ้นมาในสภาพแวดล้อมที่เต็มไปด้วยความเกลียดชังและอันตราย แต่พ่อของเธอยืนหยัดอย่างผิดปกติและปฏิเสธที่จะเปลี่ยนวิธีการเพื่อลูกสาวของเขา")
	await novel_interface.show_text_only("มันอาจจะเกี่ยวข้องกับแม่ของเธอที่เสียชีวิตตั้งแต่เธอยังเด็กมาก")
	await novel_interface.show_text_only("ทันใดนั้น Skuld สังเกตเห็นกรอบสีแดงเล็กๆ บนหน้าจอโทรศัพท์ของเธอ\nสิ่งนี้บ่งบอกว่าตำแหน่งของเธอถูกติดตามในระหว่างการโทร")
