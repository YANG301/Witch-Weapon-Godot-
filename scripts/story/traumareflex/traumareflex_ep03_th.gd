# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("เฮ้ คุณเคยรู้สึกแบบนั้นบ้างไหม?")
	await novel_interface.show_text_only("คุณจำฉากหนึ่งได้... แต่ไม่รู้ว่ามันเกิดขึ้นเมื่อใด")
	await novel_interface.show_text_only("ฉันไม่ได้หมายถึงเดจาวู ทุกคนมีเวลานั้นบ้าง")
	await novel_interface.show_text_only("ฉันหมายถึง มีบางอย่างที่คุณรู้มาโดยตลอดว่าสักวันหนึ่งจะต้องเกิดขึ้น และในที่สุดมันก็เกิดขึ้น")
	await novel_interface.show_text_only("คุณรู้มาตลอดว่ามันจะเกิดขึ้น คุณเคยเห็นมันในรูปแบบของภาพย้อนหลังด้วยซ้ำ คุณไม่สามารถแน่ใจได้ว่าจะเกิดขึ้นเมื่อใด")
	await novel_interface.show_text_only("สิ่งที่เราเรียกว่าเดจาวูเป็นเพียงการยืนยันว่าลางสังหรณ์ของคุณเป็นจริง")
	await novel_interface.show_text_only("คุณรู้ว่ามันจะเกิดขึ้น คุณรู้อยู่เสมอ")
	await novel_interface.show_text_only("ใช่ไหมล่ะ?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("อืม…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เด็กสาวผมบลอนด์ลืมตาขึ้นอย่างเมามาย ลูบหน้า และพบว่าตัวเองนอนอยู่บนม้านั่ง")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("ฟาเบลล่า... เราอยู่ที่ไหน?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("แต่ฟาเบลล่าไม่ตอบ แปลก. สาวใช้มักจะปรากฏตัวทันทีที่ชื่อของเธอถูกเรียก")
	await novel_interface.show_text_only("เด็กสาวมองไปรอบๆ เพื่อดูถนนที่ว่างเปล่า มีโคมไฟถนนเรียงรายสองข้างทาง ถนนสายนี้ดูจะดำเนินต่อไปตลอดกาลในความเงียบอันน่าขนลุก ราวกับเป็นจักรวาลคู่ขนาน")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("เราอยู่ในโบสถ์ไม่ใช่เหรอ...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("อ่า... ฟาเบลล่า!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("สกัลด์ลุกขึ้นยืน โดยมีมือนวดขมับที่ปวดของเธอ")
	await novel_interface.show_text_only("เธอจำฝันร้ายที่เธอมีได้ จำภาพบิดเบี้ยวบนหน้าต่างโมเสก แต่มันเป็นเพียงฝันร้ายจริงๆเหรอ?")
	await novel_interface.show_text_only("เธอจำฟาเบลลาได้ โดยไล่เธอออกจากโบสถ์ ปลดปล่อยเธอออกจากความมืดมิดที่อาจทำร้ายเธอ...")
	await novel_interface.show_text_only("สกัลด์ตรวจสอบข้าวของของเธอ โทรศัพท์มือถือของเธอ กระเป๋าสตางค์ของเธอ เครื่องประดับของเธอ... ทั้งหมดอยู่ที่นั่น")
	await novel_interface.show_text_only("มีสายที่ไม่ได้รับในโทรศัพท์ของเธอสามสิบสองสาย")
	await novel_interface.show_text_only("ถ้าฟาเบลลาไม่ได้ติดตั้งซอฟต์แวร์ป้องกันการติดตามบนโทรศัพท์ สถานทูตก็คงจะพบเธอแล้ว")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("สิบแปดนาฬิกา...มันสายไปแล้วเหรอ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เธอหลับตาลง พยายามควบคุมการหายใจให้ดีที่สุด เพื่อจัดการกับความทรงจำที่พันกันยุ่งวุ่นวายของเธอ")
	await novel_interface.show_text_only("เธอต้องสงบสติอารมณ์ นั่นคือสิ่งที่พ่อและฟาเบลลาคงปรารถนา พวกเขามักจะบอกเธอเสมอว่ายิ่งสถานการณ์อันตรายมากเท่าไร เธอก็ยิ่งต้องรักษาสมองให้ปลอดโปร่งมากขึ้นเท่านั้น")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("โบสถ์นั้น... และข้อความจากคุณพ่อแอนตัน... ต้องเป็นกับดักแน่ๆ","Skuld")
	await novel_interface.show_dialog("ไม่ว่าใครก็ตามจะต้องมุ่งเป้าไปที่ฉัน พ่อหรือฟาเบลล่า","Skuld")
	await novel_interface.show_dialog("ฉันได้ยินเสียงรถยนต์จากถนนใกล้ๆ และแม้แต่นักแสดงข้างถนนที่เล่นเพลงที่อยู่ห่างไกลออกไป... และฉันไม่ได้ถูกมัดหรืออะไรเลย","Skuld")
	await novel_interface.show_dialog("จาก GPS ในโทรศัพท์ของฉัน ฉันอยู่ที่ Arai Central Park ไม่ไกลจากโบสถ์มากนัก","Skuld")
	await novel_interface.show_dialog("ใครก็ตามที่พาฉันมาที่นี่คงไม่ได้ทำอันตรายใดๆ","Skuld")
	await novel_interface.show_dialog("ฉันไม่รู้ว่าใครก็ตามที่วางกับดักและใครก็ตามที่พาฉันมาที่นี่ เป็นคนกลุ่มเดียวกันหรือเปล่า... ฉันกลับไปแบบนี้ไม่ได้","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("สกัลด์หมุนหมายเลขของฟาเบลลาอีกครั้ง และอีกครั้งไปที่วอยซ์เมล เธอตรวจสอบบันทึกทั้งหมดของเธอ และดูเหมือนว่าฟาเบลลาจะไม่ได้ติดต่อกับเธอเลย") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("ฟาเบลลา...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ในที่สุด เธอก็โทรหาพ่อของเธอโดยกำโทรศัพท์ไว้ในมือเล็ก ๆ ของเธอแน่น")
	await novel_interface.show_text_only("เขารับสายวินาทีที่ผ่านไป")
	await novel_interface.show_dialog("สกัลด์เหรอ? นั่นคือคุณเหรอ?","พ่อ")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("พ่อ...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("คุณอยู่ที่ไหนห่า? สิบโมงกว่าแล้ว คุณอยู่ที่ไหน ทุกคนต่างกังวลใจจะตาย!","พ่อ")
	await novel_interface.show_dialog("และทั้งคุณและสาวใช้ของคุณก็ไม่รับสาย! คุณสองคนเป็นอะไรกัน? ท่านเอกอัครราชทูตแฮ็กเกอร์ตีได้ส่งทีมออกไปตามหาคุณแล้ว!","พ่อ")
	await novel_interface.show_text_only("พ่อของเธอฟังดูโกรธมาก แต่สกัลด์ก็โล่งใจที่ได้ยินเสียงของเขา")
	await novel_interface.show_text_only("อย่างน้อยก็ไม่มีใครพยายามข่มขู่เขาด้วยการใช้เธอเป็นตัวประกัน")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("ตอนนี้ฉันปลอดภัยแล้ว ไม่ต้องกังวล แต่ฟังนะ—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ชายคนนั้นเงียบลงทันทีด้วยน้ำเสียงของลูกสาวอย่างเร่งด่วน")
