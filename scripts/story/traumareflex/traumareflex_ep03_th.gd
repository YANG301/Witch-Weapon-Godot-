	await novel_interface.show_text_only("เธอเรียกหมายเลขร้านซักรีดในรายชื่อติดต่อของเธอ ฟาเบลลาให้หมายเลขนี้แก่เธอเป็นทางเลือกสุดท้าย")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... เดาว่าฉันไม่มีทางเลือกแล้ว!","Skuld")
