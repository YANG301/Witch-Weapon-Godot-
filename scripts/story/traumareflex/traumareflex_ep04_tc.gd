	await novel_interface.show_dialog("就是那個看妳笨手笨腳，把妳拉到一邊臭罵一頓的女僕。","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("是那個人啊！ 嗯，我記得好像戴著一副紅框眼鏡吧，她的主人是個小女孩，叫什麼……","小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("斯庫爾德·艾克斯羅德，第二學園都市董事會成員的獨生女。","莉琉")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("四小時前，她透過「洗衣房」傳了訊息給我們。","莉琉")
