	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("那個大猩猩現在有自己地盤了，早就跟這裡沒什麼關係了。","莉琉")
	await novel_interface.show_dialog("說穿了也是個應用型研究部門，SID也會經常對這些機構下訂單喔。","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("特種設備訂單的金額可不小哦～這棟實驗醫療部的大樓就是為此修建的。","愛衣")
