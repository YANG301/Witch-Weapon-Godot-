	await novel_interface.show_dialog("O que é isso... um VTOL?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Droga! É um Siskin!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("O quê? Um Siskin, aqui? Centro da cidade?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um Siskin é um tipo de helicóptero militar não tripulado, desenvolvido em Masada Ford durante a Guerra dos Sete Anos.")
	await novel_interface.show_text_only("É conhecido por transportar doze mísseis antitanque, o que o torna perfeito para campanhas de aniquilação.")
	await novel_interface.show_text_only("O ceifador listrado amarelo e preto surge do céu, pousando entre nós e o prédio do outro lado.")
	await novel_interface.show_text_only("É quando eu percebo, bem, estamos acabados.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
