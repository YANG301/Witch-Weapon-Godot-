# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella ainda está sentada em cima de mim, nas sombras de algum objeto concreto.")
	await novel_interface.show_dialog("Eu sei como evitar que a lente reflita luz.","Fabella")
	await novel_interface.show_text_only("Ela diz, enquanto me prende no chão com uma mão.")
	await novel_interface.show_dialog("Hein?\n(Espere, o que ela vai fazer?)","Ren")
	await novel_interface.show_text_only("A mão esquerda de Fabella está no chão ao lado do meu rosto, sustentando seu peso. Seu joelho direito aparece entre minhas pernas. Aquele sorriso no rosto dela... sinistro.")
	await novel_interface.show_text_only("Então ela se abaixa com a mão direita e puxa suavemente minhas meias de seda...")
	await novel_interface.show_dialog("Shh.","Fabella")
	await novel_interface.show_text_only("Incapaz de ver suas ações do meu ângulo, só posso imaginar o que ela está fazendo pelo que estou sentindo lá embaixo.")
	await novel_interface.show_dialog("(Não... por favor, não...)\n(Por favor, aí não...)","Ren")
	await novel_interface.show_text_only("Minhas bochechas estão queimando, o coração batendo loucamente em minhas costelas. Meus dedos procuram apoio no chão em algum tipo de reflexo.")
	await novel_interface.show_dialog("(Não importa como eu olhe, isso... não é o ideal...)","Ren")
	await novel_interface.show_text_only("Fabella parece bastante satisfeita com minha expressão nervosa e em pânico. Talvez ela quisesse dar uma lição a esse novato há algum tempo.")
	await novel_interface.show_text_only("De repente, seu aperto aumenta, e a próxima coisa que sei é que um buraco foi aberto em minhas meias de seda.")
	await novel_interface.show_text_only("Não posso deixar de chorar no segundo que isso acontece.")
	await novel_interface.show_dialog("Ah!","Ren")
	await novel_interface.show_text_only("Ouço o som de alguém engolindo em seco no meu fone de ouvido, seguido por Cassel tossindo loucamente.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Continuando a partir da abertura, Fabella tira mais um pouco o tecido, depois tira meus sapatos e tira o que sobrou da meia das minhas pernas.") #换行问题
	await novel_interface.show_text_only("Mal consigo falar de vergonha enquanto ela me ajuda a calçar os sapatos novamente.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Ah, vamos lá...)\n(Minhas pernas estão frias agora...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, você tem pernas macias.\nNenhum músculo.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Haha, desculpe por isso, eu acho?")
	await novel_interface.show_text_only("Ainda nem recuperei a compostura, mas a Fabella já voltou a agir toda profissional, como a comandante que é.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Todos, controlem-se.","Fabella")
	await novel_interface.show_dialog("Precisamos de um plano. Depois de localizarmos o atirador, como podemos eliminá-lo?","Fabella") #换行问题
	await novel_interface.show_dialog("Acredito que o trabalho deles é simplesmente nos distrair do verdadeiro campo de batalha ali...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella aponta para o trecho em chamas da estrada atrás de nós, onde sons de tiros rápidos podem ser ouvidos.")
	await novel_interface.show_dialog("Hm... o dispositivo de aceleração eletromagnética de curta distância precisa de cerca de 4,5 segundos para carregar.","Russel")
	await novel_interface.show_dialog("O dispositivo requer uma mira para calibrar, portanto, mesmo que o atirador esteja usando uma daquelas armas que disparam vários tiros ao mesmo tempo, o equipamento não permitirá que ele faça isso.","Russel")
	await novel_interface.show_dialog("Devemos encontrar a localização deles depois que eles atirarem uma vez e eliminá-los antes que possam atirar uma segunda vez.","Russel")
	await novel_interface.show_dialog("O problema é que nosso rifle de precisão ainda está no porta-malas. E como podemos fazê-los atirar em nós sem nos colocarmos em perigo?","Cassel")
	await novel_interface.show_text_only("Fabella estuda a estrada à frente silenciosamente com um refletor e percebe uma porta de carro perdida pendurada na traseira de um veículo blindado tombado.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... Isso deve ter caído durante a explosão.","Fabella")
	await novel_interface.show_dialog("Vocês podem me encontrar alguns dados sobre quão durável é exatamente a armadura de Substância H naquele nosso caminhão ridiculamente caro?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quer dizer... você quer usá-lo como escudo...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Provavelmente será um bom escudo.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ah?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("Há um vídeo online de um bilionário que usou esse tipo de veículo em um experimento fotográfico.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mesmo quando foi atacado por um Barretta M82A1 equipado com um dispositivo de aceleração estabilizadora eletromagnética, o caminhão não foi afetado nem um pouco.")
	await novel_interface.show_text_only("Aquele bilionário estava apenas se exibindo com seus maços de notas e sotaque russo. Mas não há como negar que o vídeo era popular.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Se você acha que é seguro, você faz.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Hein?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella tateia minha jaqueta de combate, como se estivesse procurando o lugar perfeito, então dá um soco em mim do nada.")
	await novel_interface.show_text_only("Esse foi um soco muito impressionante. Só de olhar para ele, tive certeza de que isso me mataria naquele momento. Mas tudo que senti foi um leve tremor na parte superior do corpo.")
	await novel_interface.show_text_only("O fluido não newtoniano que preenche minha camisa, embora normalmente macio, endurece no segundo em que é atingido por qualquer força.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Bela jaqueta. Mais tarde, quando você segurar a porta do carro, lembre-se de inclinar-se sobre ela e deixar a jaqueta absorver o choque em vez de usar as mãos.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Eu—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que eu possa protestar, Fabella coloca uma máscara na minha boca.")
	await novel_interface.show_text_only("Ela então tira uma pistola parecida com um brinquedo de seu cinto e aponta para o telhado do prédio.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Bomba flash de seis segundos, pronta...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("Uma partícula de luz ultrabrilhante voa para fora da pistola, passando pelo lindo céu noturno antes de finalmente descer.")
	await novel_interface.show_text_only("Fabella espera até que a partícula desça o suficiente antes de me arrastar em uma corrida louca até o caminhão tombado, atrás do qual nós dois nos escondemos.")
	await novel_interface.show_text_only("Cassel e Russel também nos seguem até um bloqueio próximo onde podem ver e se comunicar conosco.")
	await novel_interface.show_text_only("Fabella digita a senha na porta traseira do porta-malas e pega um Scout leve do suporte de armas.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Este é melhor para mira rápida.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, prepare o drone. Mantenha-o atrás da esquina do prédio para que o atirador não possa vê-lo. Só deixe sair quando estiver alto o suficiente.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella ordena, enquanto joga as meias de seda que arrancou das minhas pernas para Cassel, enroladas em uma pedra.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Acabado de sair do forno!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel olha para mim enquanto pega o objeto, parecendo um pouco envergonhado, e eu tento o meu melhor para evitar seu olhar, rosto vermelho.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, fique de olho nas imagens transmitidas e reporte-me.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Entendido.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella então levanta a porta do carro, verifica a armadura refletiva de Substância H com padrão de colméia e a coloca em meus braços.")
	await novel_interface.show_text_only("É mais leve do que pensei que seria. Eu poderia levantá-lo mesmo com uma mão.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Mas por que tenho que agir como isca?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Embora eu não saiba fazer mais nada...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella me puxa para perto e sussurra em meu ouvido:")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ouça com atenção. Assim que eu der as ordens, você sai daquele lado com a fumaça pesada, escondida atrás desta porta.","Fabella")
	await novel_interface.show_dialog("O atirador deve estar em algum lugar entre os andares trinta e cinquenta. Fique coberto, não deixe que eles vejam sua bunda nem nada...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ou então você não terá mais bunda.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela me empurra na fumaça logo depois de terminar de falar e gesticula para que eu espere ali.")
	await novel_interface.show_text_only("Enquanto isso, Cassel já cobriu a lente da câmera com as meias e enviou o drone até cerca de dez andares de altura, escondido nas sombras.")
	await novel_interface.show_text_only("O revestimento refrator de luz do drone permite que ele se misture perfeitamente ao ambiente. Ninguém seria capaz de dizer que está lá, a menos que olhasse com muito, muito cuidado.")
	await novel_interface.show_text_only("Cassel e Russel dão permissão e Fabella carrega o rifle de precisão em suas mãos. Ela acena para mim—")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Tenho que enfrentar isso…","Ren")
	await novel_interface.show_dialog("(Aya disse que ficarei bem mesmo se eu “morrer”...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Espere, ela não disse que eu seria um simples observador e não poderia interagir com o ambiente?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No meu momento de hesitação, algo cutuca minha bunda. É Fabella com sua arma. Parece que ela está pronta para explodir minha cabeça se eu não começar a me mover logo.")
	await novel_interface.show_text_only("Eu suspiro, avançando mal-humorado para fora da fumaça, escondido atrás da porta do carro.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(É melhor que aquele cara bilionário não estivesse usando adereços falsos quando fez aquele vídeo...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continuo avançando, até estar a cinco ou seis passos da fumaça densa.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(... Ninguém está atirando em mim?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O atirador deve ser capaz de me ver facilmente. Eles poderiam dizer que sou uma isca?")
	await novel_interface.show_text_only("De repente, o som de passos batendo veio de trás. Do ponto de vista periférico da minha visão, Fabella desliza graciosamente à vista, terminando em uma posição meio agachada aos meus pés.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—O-o quê?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Cubra-me!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algo bate na porta que estou segurando com um estrondo forte. A força devastadora me faz cambalear para trás, me desequilibrando.") #文字错误
	await novel_interface.show_text_only("Eu caio de bunda, a porta aberta. Fabella e eu somos alvos fáceis e completamente abertos.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Ah, não!)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("No quadragésimo segundo andar! Terceira janela à direita! Eles estão com o guia do laser!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É quando nosso drone, escondido no céu noturno escuro, dispara um laser vermelho na janela do prédio em frente.")
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("Bang! Bang!")
	await novel_interface.show_text_only("Fabella atira, três vezes seguidas.")
	await novel_interface.show_text_only("Depois o silêncio – um silêncio sem vida e que induz ao desespero. Praticamente posso ouvir meu coração bombeando sangue para meu cérebro.")
	await novel_interface.show_text_only("Segundo após segundo deslizamento. Prendo a respiração, imaginando-me sendo despedaçado por um raio de luz.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Alvo eliminado. Repito, alvo eliminado!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("Ahaha!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Muito bem!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Em vez de comemorar, Fabella continua ajoelhada na mesma posição, arma em punho.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Shh, quieto. Vocês ouviram—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aguçando os ouvidos, percebo que realmente posso ouvir um helicóptero se aproximando.")
