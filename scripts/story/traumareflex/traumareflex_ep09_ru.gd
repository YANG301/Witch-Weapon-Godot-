# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("—Что? Подозреваемый мертв?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Наша цель превратила свой дом в целую крепость. И он как сумасшедший обстреливал спасательную команду из тяжелого оружия, как только они прибыли.","SID Agent")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Разве поисковая группа не должна быть оснащена только нелетальным оружием? Почему цель умерла?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Команда не нанесла смертельного ранения цели.","SID Agent")
	await novel_interface.show_dialog("Вместо этого цель, похоже, умерла либо от передозировки нейрофармацевтических препаратов, либо от потери крови.","SID Agent")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("... Понятно. Вы можете идти сейчас.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Да, Босс.","SID Agent")
	await novel_interface.show_text_only("Мариру просматривает файлы подозреваемого и выглядит очень раздраженной, когда Ая входит в диспетчерскую.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Рен сейчас дома?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Да. Кажется, все довольно стабильно.","Aya") #文字错误
	await novel_interface.show_dialog("Это... результаты вскрытия подозреваемого?","Aya")
	await novel_interface.show_dialog("Антонио Хосе Уркиса... военачальник мафии, который действовал довольно активно в Южной Америке во время Семилетней войны. Сейчас он не более чем лидер мелкой банды.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Жаль, что наркотики сильно подожгли ему мозги... или мы могли бы попытаться допросить его с помощью этого устройства.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая бормочет, просматривая стопку файлов.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Южная Америка... значит, целью действительно была Фабелла, да?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Мы пока не можем быть уверены.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру с мрачным лицом качает головой, изучая целевой профиль, отображаемый на экране.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Небольшое количество радиоактивных маркеров было обнаружено в химическом распределительном устройстве, которое мы нашли в церкви.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("И благодаря этому мы легко нашли другое место с такими же радиоактивными маркерами... прямо внутри Новой Опулентии.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("О? Получается, что преступник даже не удосужился спрятаться.","Aya")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вот почему мне это кажется таким подозрительным...","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Антонио... у этого чувака есть мотив причинить вред Фабелле?","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ага, и какой мотив...","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("На второй год войны экономика Южной Америки рухнула. Дальше произошло то, что банды захватили политическую сцену со своими конфликтами и мелкими драками.","Mariru")
	await novel_interface.show_dialog("Фабелла, потерявшая родителей на войне, была усыновлена ​​полковником и выросла в строгой военной среде.","Mariru")
	await novel_interface.show_dialog("Вскоре она проявила животные боевые инстинкты и стала самой молодой национальной гвардией в истории.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Я слышал, что однажды она пробралась на вражескую территорию в одиночку и молча убила командира, который оказался старшим сыном Антонио.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Вот это действительно какой-то мотив.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру вызывает портрет мужчины, одетого в военную форму, и указывает на экран.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это был полковник, усыновивший Фабеллу: Карлос Бранко.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Вы имеете в виду «Мясника реки Чурун» Бранко?","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Резня на реке Чурун произошла вскоре после того, как шесть Академгородов сформировали Объединенный Конгресс.")
	await novel_interface.show_text_only("46 тысяч мирных жителей были казнены у реки, их кровь окрасила водопад Сальто-Анхель ниже по течению в красный цвет.")
	await novel_interface.show_text_only("Эти несколько недель это было во всех новостях. По общему мнению, за всем этим стоял Карлос Бранко, самый могущественный военачальник того времени.")
	await novel_interface.show_text_only("Гротескные зрелища этого инцидента вызвали широко распространенные антивоенные настроения среди широкой общественности, и с тех пор Бранко был известен как Мясник реки Чурун.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Вскоре Объединенный Конгресс принял военные меры против Карлоса Бранко, осудив его за антигуманитарные и расовые преступления.")
	await novel_interface.show_text_only("Наконец, Lancer Penetrator взорвал пещеру, в которой прятался Бранко, и тем самым положил конец эпохе монополизации банд в Южной Америке.")
	await novel_interface.show_text_only("Это поставило Объединенный Конгресс в хорошие книги большинства людей. Широкая общественность рассматривала их как символ мира и справедливости. После их успеха шесть стран в Конгрессе были переименованы в Академические города.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—По крайней мере, это официальная версия, напечатанная в учебниках по истории.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру ухмыляется, а Ая понимающе кивает.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("После этого шестеро оставшихся военачальников в Южной Америке просто исчезли в один момент, как будто они были по какому-то соглашению. Объединенный Конгресс вскоре захватил их территорию.","Aya")
	await novel_interface.show_dialog("Вы знаете, что произошло на самом деле, не так ли?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— спрашивает Ая, наклоняясь к Мариру и толкая ее локтем за талию, как любопытный котенок.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Да. Резня действительно произошла, но те, кто погиб, были выходцами с территорий шести военачальников.","Mariru")
	await novel_interface.show_dialog("Они согласились отправить этих людей к реке, и... сами знаете, что произошло дальше.","Mariru")
	await novel_interface.show_dialog("Кто-то подкупил их, чтобы они это сделали.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Единственным, кто отказался принять взятку, был Карлос Бранко.","Mariru")
	await novel_interface.show_dialog("Так он получил роль «необходимого зла» в нашем нынешнем мире.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Итак, те, кто подкупил полевых командиров...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая смотрит широко раскрытыми глазами. Ответ слишком ясен.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Те полевые командиры, которые исчезли, должно быть, просто переехали куда-то еще, сменили имена и всю оставшуюся жизнь наслаждались тратой полученных денег.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что касается доказательств вины Бранко... они, должно быть, были подделаны для силовиков самим Объединённым Конгрессом.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Если Объединенный Конгресс поймет, что Антонио вернулся, чтобы отомстить, они захотят покончить с этим как можно скорее.","Aya")
	await novel_interface.show_dialog("Неудивительно, что вся эта ситуация кажется такой неловкой.","Aya")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("О? Неловко как?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Галлюциногены, которые мы обнаружили в крови цели, того же типа, что и те, что мы нашли на Фабелле.","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я знал это.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("И мы нашли тип стимулятора, который часто использовали полевые командиры, чтобы держать своих солдат в боевой готовности. На самом деле это была настоящая причина смерти Антонио.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это тоже есть в отчете.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Стимулятор делает человека, которому его вводят, сверхчувствительным. Они будут слышать больше, чувствовать больше.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Его так много в его крови, что, если бы в него попала резиновая пуля, это, вероятно, было бы так же больно, как выстрел из пушки.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Но в течение двадцати минут или около того, пока обе стороны стреляли друг в друга, цель была поражена несколько раз...","Mariru")
	await novel_interface.show_dialog("Цель была четко видна с пятой минуты видеозаписи этой сцены. И он никогда ничего себе не вводил.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("При вскрытии также не обнаружили у него повреждений нервной системы.","Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("Н-означает ли это, что этот парень действительно наслаждается болью? Ох уж этот мазохист...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру быстро сворачивает бумагу и шлепает Аю по голове, как будто она делала это всю свою жизнь.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ой... в любом случае, они уже выяснили, кто привел Скулда в парк?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Кто бы это ни был, он держался подальше от камер наблюдения. Хрестоматийный пример отличного похитителя.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Кто-то, кто знаком с расположением камер наблюдения... и может ходить по городу с девушкой на спине, не вызывая при этом подозрений...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Да. Эти подсказки — все, что у нас есть.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру почесывает подбородок, глубоко задумавшись.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Если Антонио на самом деле был козлом отпущения, тщательно выбранным в качестве «виновника»…","Mariru")
	await novel_interface.show_dialog("Тогда тот, кто за всем этим стоит, скорее всего, преследует Фабеллу — или, точнее, ее колдовские силы.","Mariru")
	await novel_interface.show_dialog("Я не думаю, что они получили то, что хотели.","Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Но она весьма ценный экземпляр, поэтому вместо того, чтобы убить ее тут же, они решили оставить ее там на поимку Объединенного Конгресса...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Так вот почему они использовали такого драгоценного «козла отпущения»?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ну, она ведьма, одержимая магией огня, так что...\nХм, подождите, «информация с завещанием»…","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Информация...?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Потрясенные глаза Мариру встречаются с глазами Аи. Они пришли к такому же выводу.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Если похитители на самом деле хотели украсть информацию из головы Фабеллы...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Возможно, они используют то же оборудование, что и мы. Harima Tech разработала эти устройства для взлома мозга на основе некоторых опубликованных статей, доступных широкой публике.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("В этом случае они, вероятно, столкнулись с той же проблемой, что и мы.","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("Первых четырёх агентов, попытавшихся взломать мозг Фабеллы, встретила одна и та же бесконечная стена.")
	await novel_interface.show_text_only("Как брандмауэр, защищающий от злоумышленников.")
	await novel_interface.show_dialog("Если это брандмауэр наступательного типа—","Aya")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ая, приготовься разбудить Рена, как только я отдам приказ.","Mariru")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
