	await novel_interface.show_text_only("Klinisch wird dieses Phänomen Anton-Blindheit genannt.")
	await novel_interface.show_text_only("Um eine vernünftige Erklärung für eine unvorstellbare Situation zu liefern, erzeugt das Gehirn eine Reihe von Bildern, um den Körper davon zu überzeugen, dass alles in Ordnung ist.")
	await novel_interface.show_text_only("Vielleicht ist es ein angeborener Reflex, den alle Menschen besitzen.")
	await novel_interface.show_text_only("Ein uralter Schutzmechanismus gegen das Unbekannte, programmiert in unseren Genen.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	await novel_interface.show_text_only("Ich habe Kopfschmerzen.")
