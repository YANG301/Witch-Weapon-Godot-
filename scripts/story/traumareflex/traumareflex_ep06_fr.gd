# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("— Boum !")
	await novel_interface.show_text_only("Encore une explosion. La tête de notre camion est soulevée brusquement et je suis projetée à terre.")
	await novel_interface.show_text_only("L'extérieur du camion, fortifié avec la Substance magique H, est à peine affecté, mais on ressent toujours la force d'écrasement de l'intérieur.")
	await novel_interface.show_text_only("Alors que le camion roule sur le côté, mon estomac se tord. J'ai l'impression que je pourrais vomir mes tripes à ce moment-là.")
	await novel_interface.show_text_only("C'est vrai... le blindage du camion est peut-être invincible, mais le sol ne l'est certainement pas. Il suffit de faire exploser le sol et le camion sera rendu immobile.")
	await novel_interface.show_text_only("Quelle conception stupide et inutilement coûteuse...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Un mal de tête...")
	await novel_interface.show_text_only("Mes oreilles bourdonnent, mes yeux peinent à se concentrer.")
	await novel_interface.show_text_only("Heureusement, je porte une veste de combat remplie de liquide non newtonien, sinon j'aurais probablement cassé la plupart de mes os lors du désordre précédent.")
	await novel_interface.show_text_only("Je ne sais pas qui a choisi l’équipement pour moi, mais je suppose que je devrais lui en être reconnaissant.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Pourtant, est-ce qu'ils ont dû me faire porter des bas de soie ?)\n(Et il y a des trous dedans maintenant !)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Boum ! Boum ! Boum ! Boum ! Boum !")
	await novel_interface.show_text_only("Fabella ouvre à coups de poing le couvercle du bouton de sortie de secours de la voiture. Les cordeaux détonants sur le toit du camion explosent les uns après les autres.")
	await novel_interface.show_text_only("Un trou béant apparaît sur le toit, désormais positionné vers le côté. Une fumée âcre et des flammes envahissent mon nez et l'intérieur du véhicule.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Bon sang... tout le monde dehors !","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Toux* Hé, est-ce que le débutant va bien ?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toujours à peine accroché à ma conscience, je suis récupéré par Fabella et jeté hors du camion.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La fumée me brûle les yeux, me faisant pleurer de manière incontrôlable et bloquant ma vision.")
	await novel_interface.show_text_only("Je prends deux grandes bouffées d'air mais je n'obtiens que de la fumée. Mes poumons sont sur le point de s'enflammer...")
	await novel_interface.show_text_only("Je commence à tousser et à avoir des nausées sèches par réflexe, incapable de reprendre mon souffle.")
	await novel_interface.show_text_only("Mon corps se contracte alors que je m'étouffe, mes yeux rencontrant enfin le masque suspendu à mon cou. Je l'appuie rapidement sur mon nez et ma bouche d'une main.")
	await novel_interface.show_text_only("Ouf...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Département de médecine expérimentale, Harima Tech>")
	await novel_interface.show_text_only("Après avoir parcouru les détails de base concernant Fabella avec moi, Mariru et Aya descendent pour régler certains équipements, me laissant assis là tout seul.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Alors ils sont juste... partis ? Comme ça?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les couloirs silencieux de l'hôpital semblent tout d'un coup oppressants.")
	await novel_interface.show_text_only("Je suis assise là sur une chaise près du mur, vêtue d'une tenue de femme de chambre totalement décalée.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("J'ai l'impression d'être dans un jeu de tir zombie classé R...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non. Les zombies n'existent pas. Par contre les fantômes...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ouais, haha. Les zombies ne...","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Attendez, qui était-ce ?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me lève d'un bond à la voix soudaine venant des escaliers.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Je suis désolé, est-ce que je t'ai fait peur ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une petite fille regarde du coin.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Et nous nous retrouvons, Miss Ren !","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Les cheveux blonds de la jeune fille tombent jusqu’à sa taille en une délicate tresse. Elle a l’air éthérée, comme quelque chose hors de ce monde. Pas une aura que je pourrais jamais oublier.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Oh, Skurd ?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Est-ce qu'elle m'a appelé... Mademoiselle ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld me sourit timidement. Elle semble anxieuse, inquiète.")
	await novel_interface.show_text_only("Pas du tout élégant et gracieux, comme à l'époque où nous nous sommes rencontrés au Sky Hotel.")
	await novel_interface.show_text_only("Oh, c'est vrai ! Fabella est sa servante. Bien sûr, elle sera inquiète...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Je sais que tu es là parce que Mariru t'a fait venir...\nMais je t'aurais quand même demandé...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle semble hésitante, frissonnant un peu, retenant vaillamment ses larmes pendant qu'elle parle.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("S'il vous plaît... sauvez Fabella...","Skuld")
	await novel_interface.show_dialog("C'était entièrement de ma faute si je l'avais fait sortir avec moi...","Skuld")
	await novel_interface.show_dialog("Je ne m'attendais pas à ce que cela arrive...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hé, calme-toi !","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Oh non, elle va pleurer !)\n(Qu'est-ce que je fais ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je tends presque la main pour la réconforter, mais ça ne me semble tout simplement pas bien de serrer dans mes bras une petite fille... dans le couloir d'un hôpital à minuit... en jarretelles et en tenue de bonne.")
	await novel_interface.show_text_only("Je m'arrête, les bras en l'air, et elle se jette dans ma poitrine.")
	await novel_interface.show_text_only("Ses doux cheveux blonds tombent sur mes coudes. La fille sent un peu le lait. Mon rythme cardiaque s'accélère, mon cerveau bourdonne.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(Elle est si petite !)\n(Quelle mignonne !)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ici, avec son visage enfoui dans ma poitrine, elle semble plus petite qu'elle n'en avait l'air. Son corps frêle tremble, comme un animal acculé.")
	await novel_interface.show_text_only("Hum. Aya a-t-elle mentionné quelque chose à propos du piratage des cerveaux ? Je ne m'en souviens pas. Je m'en fiche.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Je vais t'aider ! Je vais certainement vous aider !\nLaissez-moi tout faire !","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe a cessé de fonctionner. Je dirais oui à tout ce qu'elle me demande de faire. Même bombarder le Sénat...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("C'est bon. Je suis ici.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je suis horrible à réconforter les autres. À quoi lui servirait le fait d'être « ici » ? Qui sait, mais les gens ne disent-ils pas généralement des choses comme ça dans ce genre de situation ?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Oui.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dans mes bras, Skuld hoche doucement la tête.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Je crois en toi. Vous pouvez le faire.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vraiment ? Je peux?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Parce que... tu es cette personne spéciale... dans mes souvenirs.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Ok... attends, quoi ?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Moi, spécial ? Ma tenue de femme de chambre lui a-t-elle laissé une si grande impression ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld se calme un peu, sèche ses larmes et me regarde avec des yeux pleins de confiance.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Je peux vous confier tous mes secrets.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comme... inattendu. Je ne sais pas comment réagir.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Vous aurez peut-être du mal à y croire, mais s'il vous plaît, écoutez.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La petite fille fragile devant moi redevient soudainement sobre, et je ne peux m'empêcher de me pencher, me sentant tout à fait sérieux.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("J'ai une... capacité vraiment spéciale.","Skuld")
	await novel_interface.show_dialog("Je me souviens de choses qui ne se sont pas encore produites... ou devrais-je dire... il y a des choses qui ne se sont pas encore produites, mais je les vois déjà, comme des souvenirs.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Des souvenirs... qui ne sont pas encore arrivés ?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Ces fragments existent dans mes souvenirs depuis le tout début, donc je ne peux même pas dire quels sont les souvenirs du passé et ceux du futur.","Skuld")
	await novel_interface.show_dialog("Je dois voir cela se produire pour en être sûr.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Donc c’est un peu comme une prophétie ?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela semble incroyable, mais j'ai vécu tellement de folies ces derniers mois que je me suis déjà habitué à croire six choses impossibles avant le petit-déjeuner.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("C'est un peu comme... un bonbon. Un peu sucré, un peu aigre, laisse un goût mentholé en bouche lorsqu'il fond.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hm, j'ai déjà mangé ce genre de bonbons, mais je ne sais pas quand...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("C'est vrai !","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Vous pouvez décrire en détail le goût de ce bonbon, mais vous ne pouvez pas dire quand ni où vous l'avez goûté.","Skuld")
	await novel_interface.show_dialog("Vous ne réaliserez « oh, ça y est » que lorsque vous aurez vraiment l’occasion de le goûter un jour.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je pense que je commence à comprendre. Si des fragments pouvant provenir du passé ou du futur existent tous deux dans vos souvenirs, il serait difficile de dire lequel est lequel.")
	await novel_interface.show_text_only("Il ne s’agit pas de voir l’avenir, pour être exact. Parce qu’elle ne peut pas dire quels souvenirs viennent du futur.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Attendez... mais elle serait sûrement capable de le comprendre avec quelques indices dans l'environnement ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est comme si Skuld lisait dans mes pensées. Elle explique :")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Vous pensez peut-être : c'est vrai que vous ne pourrez peut-être pas dire si quelque chose s'est produit le mois prochain ou le mois dernier, mais l'environnement dans dix ans sera sûrement très différent de ce qu'il est aujourd'hui, n'est-ce pas ?","Skuld")
	await novel_interface.show_dialog("Mais les souvenirs... ce ne sont pas des séquences vidéo. Tout ce que nous obtenons, ce sont des fragments...","Skuld")
	await novel_interface.show_dialog("Notre cerveau ne peut reconstruire toute la scène d'un souvenir que lorsque nous nous concentrons très fort dessus, vous savez ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cela a du sens. Je me souviens de cette phrase d'un film :")
	await novel_interface.show_text_only("« Les souvenirs sont des interprétations, pas des enregistrements. »")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Par conséquent, il n'est en fait pas si facile de trouver des fragments dans mes souvenirs qui me permettent de situer la période de temps.\nD'ailleurs...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("Vous n’avez pas l’habitude de fouiller dans vos souvenirs sans aucune raison, n’est-ce pas ?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Hum ?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Par exemple, vous ne vous souviendrez pas de votre cours de mathématiques à l'école primaire et de ce que le professeur a écrit au tableau, juste pour vous amuser, n'est-ce pas ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bien sûr. Cours de mathématiques... professeurs... certainement pas amusant.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Je te crois, c'est juste... wow. C'est incroyable.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Attendez. Alors, le « moi » dans vos souvenirs que vous venez de mentionner…","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld hoche la tête.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Quoi qu’il en soit, il n’y a qu’une seule chose dans mes souvenirs qui, j’en suis sûr, s’est produite dans le futur.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Je retiens mon souffle. J’ai soudain l’impression que je peux deviner à quoi elle fait référence…")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... C'est un souvenir du moment où le monde se termine.","Skuld")
	await novel_interface.show_dialog("Mais dans ce souvenir, tu es un garçon.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
