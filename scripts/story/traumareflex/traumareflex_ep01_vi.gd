	await novel_interface.show_text_only("Anosognosia—")
	await novel_interface.show_text_only("Trạng thái mà trong đó một người, trong một khoảng thời gian nhất định, không thể cảm nhận được sự mất đi một chức năng hữu cơ nhất định của chính mình.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	await novel_interface.show_text_only("Ví dụ, một người mù tin rằng họ vẫn có thể nhìn thấy và trên thực tế có thể mô tả một cách sống động môi trường tưởng tượng xung quanh họ.")
	await novel_interface.show_text_only("Một người bị liệt tin rằng họ vẫn có thể cử động tay chân như bình thường, đến mức họ nghĩ rằng tất cả những người khác cũng cử động tay chân của họ theo cách tương tự.")
	await novel_interface.show_text_only("Về mặt lâm sàng, hiện tượng này được gọi là Bệnh mù của Anton.")
	await novel_interface.show_text_only("Bộ não, để đưa ra lời giải thích hợp lý cho một tình huống không thể hiểu được, sẽ tạo ra một loạt hình ảnh để thuyết phục cơ thể rằng mọi thứ đều ổn.")
	await novel_interface.show_text_only("Có lẽ đó là phản xạ bẩm sinh mà tất cả con người đều sở hữu.")
	await novel_interface.show_text_only("Một cơ chế bảo vệ cổ xưa chống lại những điều chưa biết, được lập trình trong gen của chúng ta.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	await novel_interface.show_text_only("Tôi bị đau đầu.")
	await novel_interface.show_text_only("Đau đầu thực sự nghiêm trọng.")
	await novel_interface.show_text_only("Cảm giác như có ai đổ một bao xi măng vào não và hiện đang khuấy động nó.")
	await novel_interface.show_text_only("Đầu óc tôi ong ong, tai ù đi.")
	await novel_interface.show_text_only("Tôi... có ở trong không?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur.png")
	await novel_interface.show_text_only("Tôi chớp mắt mở mắt ra, đồng tử dần quen với môi trường sáng sủa xung quanh.")
	await novel_interface.show_text_only("Tuy nhiên, tai tôi dường như vẫn chưa điều chỉnh được. Cảm giác như mọi âm thanh đều bị bóp nghẹt, đến từ rất xa, rất xa.")
	await novel_interface.show_text_only("Không khí có mùi như nước hoa trộn lẫn với da thuộc và mùi rỉ sét, mùi đồng.")
	await novel_interface.show_text_only("Trong không gian chật hẹp, được bao bọc bởi lớp mạ nặng nề, hai hàng ghế được bố trí quay mặt vào nhau. Những người lính ngồi trên đó đang cãi nhau, cười đùa.")
	await novel_interface.show_text_only("Họ không có đồng phục cố định, nhưng có thể dễ dàng nhận ra rằng họ thuộc cùng một đơn vị qua các thiết bị IFF hình tròn, phát sáng mà họ đang đeo.")
	await novel_interface.show_text_only("Đặc trưng của một đội đặc nhiệm dưới sự chỉ huy của Ritnalap, tổ chức tình báo ở Thành phố Học viện thứ hai.")
	await novel_interface.show_text_only("Nếu tôi không nhầm thì tôi đang ở trong bụng một chiếc xe tải F-950 SWAT…")
	await novel_interface.show_text_only("Cách đây vài năm, một tỷ phú đã mua một trong những chiếc xe bọc thép chở quân đắt tiền đó và cải tạo nó để trông giống một hộp đêm sang trọng hơn là một chiếc xe quân sự.")
	await novel_interface.show_text_only("Sau đó, anh ta cho một số người khác dùng vũ khí bắn vào chiếc xe tải trong khi anh ta ngồi bên trong nhấm nháp sâm panh với một vài phụ nữ.")
	await novel_interface.show_text_only("Đoạn video đã lan truyền trên mạng, mang lại danh tiếng rộng rãi cho tàu sân bay bọc thép của lực lượng đặc biệt này, được tăng cường chất H.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/NewMoridas.png")
	await novel_interface.show_text_only("Trên màn hình máy chiếu trong xe, cảnh quay thời gian thực được ghi lại bởi camera trên đầu xe tải đang được phát.")
	await novel_interface.show_text_only("Ánh đèn thành phố trông tuyệt đẹp dưới bầu trời đêm. Có hàng chục tòa nhà chọc trời vẫn đang được xây dựng trong tầm mắt.")
	await novel_interface.show_text_only("Những thanh thép dường như vươn thẳng lên trời—như những biểu tượng đại diện cho lòng tham vô tận, trần trụi của con người.")
	await novel_interface.show_text_only("Đằng sau các cụm tòa nhà chọc trời, bán cầu đen khổng lồ được gọi là Vương quốc bóng tối hiện ra lờ mờ ở đường chân trời.")
	await novel_interface.show_text_only("Dưới sự quản lý của Ủy ban Mười bảy quý ông, Thành phố Học viện này đã giữ được vị thế là trung tâm kinh tế và tài chính của thế giới ngay cả sau chiến tranh.")
	await novel_interface.show_text_only("Đúng rồi—đây là nơi tôi đang ở hiện tại. Thành phố Học viện thứ hai: Newmoridas.")
