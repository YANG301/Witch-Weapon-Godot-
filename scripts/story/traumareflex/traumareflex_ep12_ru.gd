# traumareflex_ep12.gd - 创伤反射篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第12话剧本
	traumareflex_ep12_script()

func play_script():
	pass

# 创伤反射篇第12话 - 正式剧本
func traumareflex_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Привет, мисс Рен.","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Мы снова встретились!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("А? Артикул—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вовремя ловлю себя на том, что проглатываю слова.")
	await novel_interface.show_text_only("Эти воспоминания произошли два года назад. Мы со Скулдом тогда еще не должны были встретиться.")
	novel_interface.show_character("ren_mercenary","stare")
	await novel_interface.show_dialog("(Могла ли она узнать меня благодаря своим особым пророческим способностям?)","Ren")
	await novel_interface.show_dialog("(Скульд сказала, что она помнит, что видела меня в своих воспоминаниях...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("А ты Фабелла, да?\nИ Рассел, Кассель...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд поворачивается к остальным членам отряда, его лицо сияет и невинно.") #换行问题
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("О, кто-нибудь научил вас нашим именам?\nДочь нашего работодателя действительно умная малышка.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("(Ха-ха, возможно, она не так сложна, как я думал.)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Приятно познакомиться!\nТы намного красивее, чем на фото—","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рассел толкает Касселя локтем под ребра, чтобы тот заткнулся.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("О, пожалуйста, не думай, что я не заметил, как ты смотрел на аукционе.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд рассмеялся, глядя на покрасневшее лицо Касселя. Напряженная атмосфера немного разрядилась.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Слушайте, наши войска поддержки все еще задерживаются за пределами зоны. Нам нужно будет найти способ добраться до точки эвакуации самостоятельно.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Мы временно объединяем команды. Все следуют приказам капитана Пернарда.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла кивает Пернарду, протягивает ему несколько магазинов для винтовки, а сама берет в руки дробовик.")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("(Кажется, они доверяют друг другу. Много ли они ссорились вместе?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Вскоре мы можем столкнуться с новыми противниками. Ребята, проведите инвентаризацию. Посмотрите, сколько у нас оборудования и боеприпасов, и доложите через пять минут.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Я уже проверил свой рюкзак. В нем есть три магазина, небольшой аварийный набор и баллончик с аэрогелем.")
	await novel_interface.show_text_only("Это что-то вроде лака для волос. Пена, выходящая из баллона, сразу же увеличится в размерах и застынет, как только окажется на воздухе.")
	await novel_interface.show_text_only("Однажды Энни использовала его, чтобы запечатать дверь в комнату для гостей в отеле Sky.")
	await novel_interface.show_dialog("(Почему это в моей сумке...?)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Пока все проводят инвентаризацию, Фабелла тащит Пернарда через улицу.") #换行问题
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Наш враг действительно пришел подготовленным.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Да. Кажется, у них уже расписан весь наш маршрут. Даже удалось эвакуировать мирных жителей в идеальное время с фальшивым предупреждением.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("А это значит, что они знают, когда аукцион закончился.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Сколько противников вы встретили после того, как дорога была взорвана?","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Снайпер и Чиж. Ты?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Три снайпера, четыре дрона с автоматическим вооружением.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Именно тогда Фабелла наконец замечает забрызганные кровью ветровку Пернарда. Она нервно спрашивает:")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Их так много? Тебе больно?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Не серьёзно. Рина отличный стрелок, легко их всех расстреляла.","Pernard")
	await novel_interface.show_dialog("Они расставили снайперов на идеальных позициях даже в районе с таким количеством высотных зданий. Это означает, что они знают, что «багаж» находится у команды «Альфа».","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла хмурится.")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Но разве этот избалованный мальчишка не решил, в какой машине ехать, только после окончания аукциона?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Это означает, что... кто-то из нас мог слить информацию.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пернард и Фабелла молча смотрят на оставшихся четырех членов отряда, шутя и смеясь, окружая блондинку.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Враги, конечно, преследуют ее, но они, вероятно, не хотят ее убивать.","Pernard")
	await novel_interface.show_dialog("Или же они могли бы легко сделать это в другой раз.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("...Так они хотят ее похитить?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Тогда хотя бы присылайте наземный отряд или бронетехнику.","Pernard")
	await novel_interface.show_dialog("В любом случае, держитесь подальше от открытых пространств. Продолжайте идти в тени зданий.","Pernard") #原文多字
	await novel_interface.show_dialog("Берегите себя.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Да, и ты тоже.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На другой стороне дороги я слушаю, как Скулд и трое других обсуждают аукцион, на котором они присутствовали сегодня вечером.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Та рукопись, которую ты купил сегодня вечером... она обошлась тебе в 36 миллионов?","Cassel")
	await novel_interface.show_dialog("Но разве это не какой-то дурацкий старый свиток? Что в нем такого ценного? На нем есть все будущие номера лотереи или что-то в этом роде?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("О, пожалуйста. Вы не знали бы ценности древних реликвий.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","pleased")
	await novel_interface.show_dialog("Я тоже мало что знаю о реликвиях. Я просто почему-то очень сильно почувствовал, что мне нужно его купить.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ах, это то, что я всегда чувствую, когда вижу новейшие шутеры!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кассель понимающе кивает.")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("(Вы уверены, что действительно поняли?)\n(Скульд, вероятно, купила этот предмет из-за чего-то, что она увидела в своих воспоминаниях...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Если подумать, многие древние письмена действительно были утеряны после войны. Я слышал, что кто-то когда-то купил рукопись Архимеда даже за миллионы долларов.","Rina")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Так что же это за свиток, который ты купил?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Согласно датировке по углероду-14, ему уже тысячи лет. Я думаю, это какой-то рецепт, написанный древними рунами. Я тоже не могу это прочитать.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— говорит Скульд, показывая нам выцветшую бумагу, которую она хранит в изысканной папке в своей черной сумке из крокодиловой кожи.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Безопасно ли показывать нам... просто так?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Текстура бумаги кажется напоминающей какую-то ткань. На нем изображены бесчисленные неопознанные руны, а также иллюстрации, очень похожие на руки осьминога.")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Это папирус? Но папирус не смог бы так хорошо сохраниться, если бы он просуществовал тысячи лет.","Rina")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Разве вам не следует надеть перчатки или что-то в этом роде, прежде чем прикасаться к нему?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Всё в порядке, покрыто слоем герметичного аэрозоля.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Вау. Интересно, какое блюдо можно приготовить по этому рецепту. Стоимость 36 миллионов...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("В следующий раз тебе лучше научить маму это готовить, Расс. В последний раз, когда я ел блюдо, которое она приготовила, я чуть не попал в больницу.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Не могу винить в этом мою маму. У тебя случился взрывной понос только потому, что ты слишком много съел, а не из-за того, что она готовила.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Итак... эти ребята... может быть, им нужен этот свиток?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Но Чижик уже стоит более 20 миллионов. Если этот свиток не содержит действительно важного скрытого сообщения, он того не стоит.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld")
	await novel_interface.show_dialog("Скрытое сообщение?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд держит рукопись в воздухе, изучая ее в свете прожектора со стороны здания напротив.")
	await novel_interface.show_text_only("Остальные сгрудились, и я тоже не могу не присоединиться к ним.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ну…","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Насколько я понимаю...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Ничего подозрительного в этом нет...","Rina")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("На самом деле, что мне действительно кажется подозрительным, так это...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ну, я задавался этим вопросом с тех пор, как мы впервые оказались на этой улице.")
	await novel_interface.show_text_only("Здесь множество ночных клубов, баров и освещенных рекламных щитов.")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("Но почему этот прожектор направлен на нас, а не на рекламу или вход в магазин?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("... Хм, правда...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Привет!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла, которая находится через дорогу, вдруг кричит на нас.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Двигайтесь!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Бум!")
	await novel_interface.show_text_only("Едва нам удается разбежаться, как с неба падает гигантский черный объект, приземляясь именно в том месте, куда указывает прожектор.")
	await novel_interface.show_text_only("Среди облака пыли и разбитого асфальта мы слышим зловещий шум трения металла и жужжание механических соединений.")
	await novel_interface.show_text_only("Из дыма торчит огромный шип, сияющий холодным синим металлическим светом.")
	await novel_interface.show_text_only("К шипу прикреплена гладкая механическая рука, которая, в свою очередь, прикреплена к…")
	await novel_interface.show_dialog("Ч-что это за черт?","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Big_Spider.png")
	await novel_interface.show_text_only("Фабелла предупреждала нас, что враг может послать какую-то армию роботов, но я, конечно, не ожидал такого.")
	await novel_interface.show_text_only("У него восемь гибких, острых, шипастых ног, поддерживающих гигантское тело, которое продолжает издавать механические звуки.")
	await novel_interface.show_text_only("...Робот-паук из сплава, почти метр высотой. Оснащен шипами на каждой ноге, которые легко могут проткнуть человеческое тело.")
	await novel_interface.show_text_only("Смертоносный робот-хищник изучает нас моргающими красными глазами на своей «голове».")
	await novel_interface.show_dialog("Ты шутишь...","Rina")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Фабелла и Пернард тут же поднимают оружие и открывают огонь.")
	await novel_interface.show_text_only("Свинцовые пули падают на легированную броню, летят искры, когда пули рикошетят от тела паука.")
	await novel_interface.show_text_only("Сам паук, похоже, вообще не пострадал. Он поворачивается лицом к Фабелле и одним плавным движением набрасывается на нее.")
	await novel_interface.show_text_only("Пернард уклоняется в сторону, а Фабелла спускается и выскальзывает под брюхо паука.")
	await novel_interface.show_text_only("Громкий грохот раздался позади меня, выведя меня из ошеломленного состояния. Это Рина тоже начала стрелять.")
	await novel_interface.show_text_only("Ноги паука дрожат, но даже антиматериальная снайперская винтовка Рины оставляет лишь небольшую вмятину на легированной броне.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(Что мне делать...?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Используете аэрогель? Ни за что. Он поджарит меня заживо прежде, чем я смогу приблизиться и распылить на него аэрогель.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Да ладно, должен же быть способ...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Гигантский паукообразный теперь преследует Пернарда, который разбивает окно такси, припаркованного на обочине, и прыгает в него.")
	await novel_interface.show_text_only("Прежде чем он успел запустить двигатель, паук оторвал ногой дверь автомобиля.")
	await novel_interface.show_text_only("Пернард снова рискует выкатиться из машины, хватая дверцу машины и перекидывая ее через себя, прежде чем паук сможет наброситься на него.")
	await novel_interface.show_text_only("Одна из шипастых ног паука пронзает дверь и застревает там. Внизу Пернард, который изо всех сил старается удержать дверцу машины на месте, его лицо покраснело от напряжения.")
	novel_interface.show_character("ren_mercenary","shout")
	await novel_interface.show_dialog("Ух, сейчас или никогда!","Ren")
