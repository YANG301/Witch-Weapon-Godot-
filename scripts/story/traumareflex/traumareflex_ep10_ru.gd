# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Фабелла все еще сидит на мне, в тени какого-то конкретного объекта.")
	await novel_interface.show_dialog("Я знаю, как сделать так, чтобы объектив не отражал свет.","Fabella")
	await novel_interface.show_text_only("Говорит она, прижимая меня к земле одной рукой.")
	await novel_interface.show_dialog("А?\n(Подожди, что она собирается делать?)","Ren")
	await novel_interface.show_text_only("Левая рука Фабеллы лежит на земле рядом с моим лицом, поддерживая ее вес. Ее правое колено просовывается между моими ногами. Эта ухмылка на ее лице... зловещая.")
	await novel_interface.show_text_only("Затем она протягивает правую руку и осторожно дергает мои шелковые чулки...")
	await novel_interface.show_dialog("Тсс.","Fabella")
	await novel_interface.show_text_only("Не имея возможности видеть ее действия под своим углом, я могу только представить, что она делает, исходя из того, что я чувствую там внизу.")
	await novel_interface.show_dialog("(Нет... пожалуйста, нет...)\n(Пожалуйста, не там...)","Ren")
	await novel_interface.show_text_only("Мои щеки горят, сердце бешено колотится в грудной клетке. Мои пальцы рефлекторно царапают землю.")
	await novel_interface.show_dialog("(Как ни посмотри, это... не идеально...)","Ren")
	await novel_interface.show_text_only("Фабелла, кажется, вполне довольна моим паническим и растерянным выражением лица. Возможно, она уже давно хотела преподать этому новичку урок.")
	await novel_interface.show_text_only("Внезапно ее хватка становится сильнее, и следующее, что я помню, — в моих шелковых чулках вырывается дыра.")
	await novel_interface.show_text_only("Я не могу удержаться от крика, как только это происходит.")
	await novel_interface.show_dialog("Ааа!","Ren")
	await novel_interface.show_text_only("Я слышу в наушнике звук чьего-то тяжелого глотания, а затем безумный кашель Касселя.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Продолжая от начала, Фабелла еще немного отдирает ткань, затем снимает с меня туфли и стягивает с моих ног остатки чулок.") #换行问题
	await novel_interface.show_text_only("Я едва могу говорить от смущения, поскольку она помогает мне снова надеть туфли.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Ой, да ладно...)\n(У меня теперь все ноги холодные...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Хм, у тебя мягкие ноги.\nНикаких мышц.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ха-ха, извини, наверное?")
	await novel_interface.show_text_only("Я еще даже не пришел в себя, но Фабелла уже снова ведет себя профессионально, как командир, которым она является.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Все, возьмите себя в руки.","Fabella")
	await novel_interface.show_dialog("Нам нужен план. После того как мы определим местоположение снайпера, как нам его уничтожить?","Fabella") #换行问题
	await novel_interface.show_dialog("Я считаю, что их задача — просто отвлечь нас от настоящего поля битвы...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла указывает на горящий участок дороги позади нас, где слышны звуки быстрой стрельбы.")
	await novel_interface.show_dialog("Хм... устройству электромагнитного ускорения ближнего действия требуется около 4,5 секунд для зарядки.","Russel")
	await novel_interface.show_dialog("Для калибровки устройства требуется прицел, поэтому даже если снайпер использует одно из тех орудий, которые стреляют несколькими выстрелами одновременно, оборудование не позволит ему это сделать.","Russel")
	await novel_interface.show_dialog("Мы должны найти их местонахождение после того, как они выстрелят один раз, и уничтожить их, прежде чем они смогут выстрелить во второй раз.","Russel")
	await novel_interface.show_dialog("Проблема в том, что наша снайперская винтовка все еще находится в багажнике. И как нам заставить их стрелять в нас, не подвергая себя опасности?","Cassel")
	await novel_interface.show_text_only("Фабелла тихо изучает дорогу впереди с помощью отражателя и замечает беспризорную дверь автомобиля, свисающую с хвоста перевернутой бронетехники.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... Должно быть, это выпало во время взрыва.","Fabella")
	await novel_interface.show_dialog("Ребята, можете ли вы найти мне данные о том, насколько прочна броня из вещества H на нашем смехотворно дорогом грузовике?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ты имеешь в виду... ты хочешь использовать его как щит...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Наверное, из него получится хороший щит.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
