# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("No momento em que o mundo acabar?","Ren")
	await novel_interface.show_dialog("(Espere, esse desastre afetou o mundo inteiro?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mas todos não pareciam bem no dia seguinte?")
	await novel_interface.show_text_only("A única coisa que “acabou” foi a minha...")
	await novel_interface.show_dialog("(O que eu fiz para merecer isso?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Mas nessa memória, você é um menino.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("...Eh?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Então, você é um menino, senhorita Ren?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Uh... Hum...\nUh, eu...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Manchetes de notícias como “Travestis masculinos vão entrar furtivamente na enfermaria feminina do hospital” passam pela minha mente.")
	await novel_interface.show_text_only("Skuld se aproxima, parecendo incrivelmente presunçosa, como se ela tivesse acabado de me pegar fazendo algo ilegal.")
	await novel_interface.show_text_only("Me sinto encurralado, como um cervo diante dos faróis.")
	await novel_interface.show_text_only("Inconscientemente, cubro meu peito e me movo para trás, e então tento segurar minha saia também...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Ugh, essa saia é realmente muito curta! Não consigo mantê-la parada!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Uh, espere, por que estou tão nervoso?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ah, vamos lá, sou uma menina!\nHahaha...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não me pareço em nada com um menino agora. De jeito nenhum Skuld poderia ter conectado meu eu atual com minha identidade original.")
	await novel_interface.show_text_only("Além disso, Mariru fez muito para encobrir meus rastros. Nem mesmo a melhor agência de inteligência seria capaz de dizer quem eu era.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Mas aquela silhueta nas ruínas de Nova Opulentia... é definitivamente um menino em minhas memórias.","Skuld")
	await novel_interface.show_text_only("Skuld se move na minha frente, estudando meu rosto com muita perplexidade.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("E depois de um flash de luz branca, eu vi seu rosto.","Skuld")
	await novel_interface.show_dialog("Demorou menos de um segundo, mas nunca me lembro errado.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Você é a pessoa em minhas memórias.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fico ali sentado, com as costas apoiadas na parede, apavorado com a aura imponente dessa garotinha.")
	await novel_interface.show_text_only("Não é de admirar que nesses romances clássicos de fantasia, não importa quão grande seja o mundo, nunca pode haver mais do que dois profetas. O autor não saberá o que fazer com eles.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Esse tipo de habilidade... é como trapaça, não é?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Ainda assim, foi apenas um fragmento. E as memórias nem sempre são confiáveis.","Skuld")
	await novel_interface.show_dialog("Acho que também não posso ter certeza se você é menino ou menina, só por aquele vislumbre em minhas memórias.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A loira cede um pouco, me deixando algum espaço para respirar.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Mesmo assim, consegui confirmar quando você me abraçou agora há pouco. Seu corpo, sua estrutura, seu cabelo...","Skuld")
	await novel_interface.show_dialog("Não sei por que, mas a Srta. Ren é definitivamente uma garota, pelo menos agora.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("E eles se sentem... bem...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sorri maliciosamente.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Eles?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela enterrou o rosto no meu peito porque queria confirmar se “eles” eram reais?")
	await novel_interface.show_text_only("E ela até checou meu cabelo...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Aposto que Mariru vai me repreender mais tarde por baixar a guarda tão facilmente!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld levanta a cabeça e limpa a garganta.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Enfim... trocamos segredos, então... somos amigos agora, certo?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela pergunta, com cautela, com expectativa.")
	await novel_interface.show_text_only("Meu coração palpita. Meu instinto me diz que este é o verdadeiro Skuld por trás de tudo, indisfarçável, vulnerável.")
	await novel_interface.show_text_only("Ela deve ter crescido em um mundo sem confiança. Ela ainda é tão jovem... não pode ter mais de treze anos...")
	await novel_interface.show_text_only("Mesmo que suas habilidades proféticas não sejam tão poderosas, provavelmente há muitas pessoas que adorariam usá-la.")
	await novel_interface.show_text_only("Se o segredo dela for revelado, ela ficará arruinada.")
	await novel_interface.show_text_only("Mesmo assim ela arriscou tudo e me contou, mesmo sabendo que eu poderia muito bem estar monitorada e usando um dos besouros da Mariru...")
	await novel_interface.show_text_only("Talvez tudo o que ela quisesse era um amigo, alguém com quem pudesse ser honesta.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Sim. Seu segredo está seguro comigo.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu levanto meu dedo mínimo.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Porque eu sou... “especial” para você, certo?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Uau, isso é tão extravagante...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld olha fixamente e depois começa a rir.")
	await novel_interface.show_text_only("Nós prometemos o mindinho.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Quando Aya entra no bar, ela imediatamente avista Mariru no sofá ao lado da janela, girando suavemente a taça de vinho em sua mão.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("As “medidas de segurança” do protótipo foram configuradas de acordo com suas solicitações.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Muito rápido, não é?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Você queria que eu monitorasse os estímulos do nervo vago de Ren e a desconectasse do sistema imediatamente se algo anormal ocorresse. Mas isso não é um pouco violento?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("É como se fosse um fusível de segurança. Afinal, ainda não sabemos muito sobre como funcionam as memórias, pelo menos cientificamente.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("E quem sabe se é mesmo como dizem os filmes... “seu cérebro frita se ocorrerem memórias contraditórias”.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya parece bastante animada ao ver o cérebro de alguém fritar.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Se conduzirmos um experimento com algumas dezenas de pessoas aleatórias, saberemos, certo?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru levanta o copo, estudando o formato dos cubos de gelo dentro dele sob a iluminação.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Não...","Mariru")
	await novel_interface.show_dialog("Mesmo que uma pessoa possua dois conjuntos de memórias completamente contraditórias, ela ainda encontrará uma maneira de racionalizá-los.","Mariru")
	await novel_interface.show_dialog("Por exemplo, memórias de uma vida passada, ou de um universo paralelo. Ou talvez algum tipo de epifania divina.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quem sabe eles podem até iniciar um culto com esse tipo de conhecimento.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("É verdade, mas...","Aya")
	await novel_interface.show_dialog("Mas você não pediu ao pessoal da Harima Tech para não estimular seu córtex pré-frontal, a fim de manter a área de memória em seu cérebro cortada?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Você quer que ela esqueça a maior parte das informações que teve depois que acordar, como se fosse tudo um sonho... certo?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se vira para olhar pela janela as luzes virtuais da cidade.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella era escoteira quando criança. Ela foi criada por um senhor da guerra na América do Sul.","Mariru")
	await novel_interface.show_dialog("Ela sabe demais, mais do que pode suportar.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ah?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Certo, você não disse ao Skuld para convencer Ren a aceitar esta missão? Funcionou?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Claro. Esse idiota não será capaz de dizer não para uma linda garota.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Tão simples, tão ingênuo. Eu meio que invejo ela.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mas espere, nesse caso, por que você—","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya para no meio da frase, percebendo que já tem a resposta para sua própria pergunta.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Você quer estabelecer uma espécie de “ponto de ancoragem de memória” para Ren, hein?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorri e bebe graciosamente de seu copo.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("O jeito mais direto é sempre o melhor, né?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Você com certeza a mima, não é?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Ah. Está na hora, vamos.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
