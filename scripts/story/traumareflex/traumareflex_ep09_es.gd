# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("—¿Qué? ¿El sospechoso está muerto?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nuestro objetivo había renovado su casa y la había convertido en una fortaleza completa. Y ha estado disparando al equipo de recuperación como loco con armas pesadas en el momento en que llegaron.","SID Agent")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("¿No debería el equipo de recuperación estar equipado únicamente con armas no letales? ¿Por qué murió el objetivo?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("El equipo no hirió fatalmente al objetivo.","SID Agent")
	await novel_interface.show_dialog("En cambio, el objetivo parece haber muerto por una sobredosis de neurofármacos o por pérdida de sangre.","SID Agent")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("... Ya veo. Puedes irte ahora.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sí, jefe.","SID Agent")
	await novel_interface.show_text_only("Mariru está hojeando los archivos del sospechoso, luciendo muy molesta, cuando Aya ingresa a la sala de control.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("¿Está Ren ahora?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sí. Todo parece bastante estable.","Aya") #文字错误
	await novel_interface.show_dialog("¿Son estos los... resultados de la autopsia del sospechoso?","Aya")
	await novel_interface.show_dialog("Antonio José Urquiza... un señor de la guerra mafioso que solía ser bastante activo en América del Sur durante la Guerra de los Siete Años. En este momento, no es más que el líder de una pandilla menor.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Lástima que las drogas prácticamente le frieron el cerebro... o podríamos haber intentado interrogarlo con ese dispositivo.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya murmura mientras hojea su pila de archivos.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Sudamérica... entonces el objetivo realmente era Fabella, ¿eh?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aún no podemos estar seguros.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru niega con la cabeza, con cara sombría, mientras estudia el perfil del objetivo que se muestra en la pantalla.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se ha detectado una pequeña cantidad de marcadores radiactivos en el dispositivo de distribución de productos químicos que encontramos en la iglesia.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Y a partir de ahí, encontramos fácilmente otra ubicación con los mismos marcadores radiactivos... justo dentro de Nueva Opulentia.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("¿Ah? Así que es casi como si el culpable ni siquiera se molestara en esconderse.","Aya")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por eso me parece tan sospechoso...","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Antonio... ¿este tipo tiene algún motivo para lastimar a Fabella?","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí, y que motivo...","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("En el segundo año de la guerra, la economía de América del Sur colapsó. Lo que sucedió después fue que las pandillas se apoderaron de la escena política con sus conflictos y pequeñas peleas.","Mariru")
	await novel_interface.show_dialog("Fabella, quien perdió a sus padres en la guerra, fue adoptada por un coronel y creció en un ambiente militar estricto.","Mariru")
	await novel_interface.show_dialog("Pronto mostró instintos animales de combate y se convirtió en la guardia nacional más joven de la historia.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Escuché que una vez se coló en territorio enemigo, sola, y asesinó silenciosamente al comandante, que resultó ser el hijo mayor de Antonio.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Ese sí que es un motivo.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru evoca el retrato de un hombre, vestido con traje militar, y señala la pantalla.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Este fue el coronel que adoptó a Fabella: Carlos Branco.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("¿Te refieres a “Carnicero del Río Churun” Branco?","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La Masacre del Río Churun ​​ocurrió poco después de que las seis Ciudades Academia formaran el Congreso Unido.")
	await novel_interface.show_text_only("46 mil civiles fueron ejecutados junto al Río, tiñendo de rojo su sangre aguas abajo el Salto Ángel.")
	await novel_interface.show_text_only("Estuvo en todas las noticias esas pocas semanas. La opinión común era que Carlos Branco, el caudillo más poderoso de la época, estaba detrás de todo.")
	await novel_interface.show_text_only("Las grotescas vistas del incidente provocaron sentimientos pacifistas generalizados entre el público en general, y Branco fue conocido desde entonces como el Carnicero del río Churun.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Pronto, el Congreso Unido tomó medidas militares contra Carlos Branco, condenándolo por sus crímenes antihumanitarios y raciales.")
	await novel_interface.show_text_only("Finalmente, un Lancer Penetrator hizo estallar la cueva en la que Branco se escondía, poniendo así fin a la era monopolizada por las pandillas en Sudamérica.")
	await novel_interface.show_text_only("Esto puso al Congreso Unido en la buena opinión de la mayoría de la gente. Fueron vistos por el público en general como un símbolo de paz y justicia. Tras su éxito, las seis naciones en el Congreso pasaron a llamarse Ciudades Academia.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—Al menos esa es la versión oficial impresa en los libros de historia.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sonríe y Aya asiente comprensivamente.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Después de eso, los seis señores de la guerra que quedaban en América del Sur simplemente desaparecieron todos de una vez, como si estuvieran bajo algún tipo de acuerdo. El Congreso Unido pronto se apoderó de su territorio.","Aya")
	await novel_interface.show_dialog("Sabes lo que realmente pasó, ¿no?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunta Aya, inclinándose cerca de Mariru y empujando su cintura con un codo, como un gatito curioso.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Sí. La masacre realmente ocurrió, pero los que murieron procedían de los territorios de los seis señores de la guerra.","Mariru")
	await novel_interface.show_dialog("Acordaron enviar a esas personas al río, y... ya sabes lo que pasó después.","Mariru")
	await novel_interface.show_dialog("Alguien los había sobornado para que hicieran eso.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("El único que se negó a aceptar el soborno fue Carlos Branco.","Mariru")
	await novel_interface.show_dialog("Así recibió el papel de “mal necesario” en nuestro mundo actual.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Entonces los que sobornaron a los señores de la guerra...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya mira fijamente, con los ojos muy abiertos. La respuesta es demasiado clara.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Esos señores de la guerra que desaparecieron debieron simplemente haberse mudado a otro lugar, cambiaron sus nombres y disfrutaron el resto de sus vidas gastando el dinero que recibieron.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("En cuanto a la prueba de la culpabilidad de Branco... debe haber sido falsificada para los soldados de seguridad por el propio Congreso Unido.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Si el Congreso Unido se da cuenta de que Antonio ha vuelto en busca de venganza, querrán terminar con esto lo antes posible.","Aya")
	await novel_interface.show_dialog("No es de extrañar que toda esta situación parezca tan incómoda.","Aya")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Ah? ¿Incómodo cómo?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Los alucinógenos que encontramos en la sangre del objetivo son del mismo tipo que encontramos en Fabella.","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo sabía.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Y encontramos un tipo de estimulante, de esos que los señores de la guerra solían utilizar para mantener alerta a sus soldados. En realidad, ese fue el verdadero motivo de la muerte de Antonio.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eso también está en el informe.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("El estimulante vuelve hipersensible a quien se lo inyecta. Oirán más, sentirán más.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hay tanto en su sangre que, si fuera alcanzado por una bala de goma, probablemente le dolería tanto como si le dispararan un cañón.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pero durante los veinte minutos aproximadamente en los que los dos bandos se disparaban entre sí, el objetivo fue alcanzado varias veces...","Mariru")
	await novel_interface.show_dialog("El objetivo ha sido claramente visible desde el quinto minuto en las imágenes de la escena. Y nunca se inyectó nada.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tampoco encontraron lesiones en su sistema nervioso durante la autopsia.","Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("¿N-significa esto que este tipo realmente disfruta del dolor? Vaya, el masoquista definitivo...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru rápidamente enrolla un papel y golpea a Aya en la cabeza, como si hubiera estado haciendo esto toda su vida.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Aw... de todos modos, ¿ya descubrieron quién trajo a Skuld al parque?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Quienquiera que fuera se mantuvo alejado de todas las cámaras de vigilancia. Un ejemplo de libro de texto de un excelente secuestrador.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Alguien familiarizado con la ubicación de las cámaras de vigilancia... y que pudiera caminar por la ciudad con una chica a la espalda, sin ser visto como sospechoso...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sí. Estas pistas son todo lo que tenemos.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se rasca la barbilla, sumida en sus pensamientos.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si Antonio fue en realidad un chivo expiatorio, cuidadosamente elegido para actuar como el “culpable”...","Mariru")
	await novel_interface.show_dialog("Entonces, quienquiera que esté detrás de todo esto probablemente esté detrás de Fabella—o, más específicamente, de sus poderes de bruja.","Mariru")
	await novel_interface.show_dialog("No creo que consiguieran lo que querían.","Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Pero ella es un espécimen bastante valioso, así que en lugar de matarla en ese momento, decidieron dejarla allí para que el Congreso Unido la capture...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("¿Entonces fue por eso que usaron un “chivo expiatorio” tan precioso?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bueno, ella es una bruja poseída por magia de fuego, así que...\nHmm, espera, “información con voluntad”...","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¿Información...?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los ojos sorprendidos de Mariru se encuentran con los de Aya. Han llegado a la misma conclusión.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Si lo que realmente querían esos secuestradores era robar la información del interior de la cabeza de Fabella...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Es posible que estén usando el mismo tipo de equipo que nosotros también. Harima Tech había diseñado estos dispositivos para piratear cerebros basándose en algunos artículos publicados disponibles para el público en general.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("En ese caso, es probable que hayan encontrado el mismo problema que nosotros.","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("Los primeros cuatro agentes que intentaron hackear el cerebro de Fabella se encontraron con el mismo muro interminable.")
	await novel_interface.show_text_only("Como un firewall que mantiene alejados a los intrusos.")
	await novel_interface.show_dialog("Si es un tipo ofensivo de firewall—","Aya")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aya, prepárate para despertar a Ren tan pronto como dé las órdenes.","Mariru")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
