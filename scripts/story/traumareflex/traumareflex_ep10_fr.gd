# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella est toujours assise sur moi, dans l'ombre d'un objet concret.")
	await novel_interface.show_dialog("Je sais comment empêcher l'objectif de réfléchir la lumière.","Fabella")
	await novel_interface.show_text_only("Dit-elle en me plaquant au sol d'une main.")
	await novel_interface.show_dialog("Hein ?\n(Attends, qu'est-ce qu'elle va faire ?)","Ren")
	await novel_interface.show_text_only("La main gauche de Fabella est au sol à côté de mon visage, supportant son poids. Son genou droit passe entre mes jambes. Ce sourire narquois sur son visage... menaçant.")
	await novel_interface.show_text_only("Puis elle tend la main droite et tire doucement sur mes bas de soie...")
	await novel_interface.show_dialog("Chut.","Fabella")
	await novel_interface.show_text_only("Incapable de voir ses actions sous mon angle, je ne peux qu'imaginer ce qu'elle fait à partir de ce que je ressens là-bas.")
	await novel_interface.show_dialog("(Non... s'il vous plaît non...)\n(S'il vous plaît, pas là-bas...)","Ren")
	await novel_interface.show_text_only("Mes joues brûlent, mon cœur bat à tout rompre dans ma cage thoracique. Mes doigts cherchent un achat au sol dans une sorte de réflexe.")
	await novel_interface.show_dialog("(Peu importe comment je vois les choses, ce... n'est pas idéal...)","Ren")
	await novel_interface.show_text_only("Fabella semble assez satisfaite de mon expression paniquée et troublée. Peut-être qu'elle voulait donner une leçon à ce débutant depuis un certain temps.")
	await novel_interface.show_text_only("Soudain, sa prise se resserre, et la prochaine chose que je sais, un trou est arraché de mes bas de soie.")
	await novel_interface.show_text_only("Je ne peux m'empêcher de crier à la seconde où cela arrive.")
	await novel_interface.show_dialog("Ahh !","Ren")
	await novel_interface.show_text_only("J'entends le bruit de quelqu'un qui déglutit difficilement dans mon oreillette, suivi de Cassel qui tousse follement.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("En continuant à partir de l'ouverture, Fabella enlève encore le tissu, puis enlève mes chaussures et retire ce qui reste des bas de mes jambes.") #换行问题
	await novel_interface.show_text_only("Je peux à peine parler par gêne alors qu'elle m'aide à remettre mes chaussures.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Oh, allez...)\n(Mes jambes sont toutes froides maintenant...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, tu as des jambes douces.\nPas de muscle du tout.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Haha, désolé pour ça, je suppose ?")
	await novel_interface.show_text_only("Je n'ai même pas encore retrouvé mon calme, mais Fabella a déjà recommencé à agir de manière professionnelle, comme le commandant qu'elle est.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Tout le monde, ressaisissez-vous.","Fabella")
	await novel_interface.show_dialog("Nous avons besoin d'un plan. Après avoir identifié l'emplacement du tireur d'élite, comment pouvons-nous l'éliminer ?","Fabella") #换行问题
	await novel_interface.show_dialog("Je crois que leur travail consiste simplement à nous distraire du véritable champ de bataille là-bas...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella désigne la section de route en feu derrière nous, où des bruits de tirs rapides peuvent être entendus.")
	await novel_interface.show_dialog("Hm... le dispositif d'accélération électromagnétique à courte distance a besoin d'environ 4,5 secondes pour se charger.","Russel")
	await novel_interface.show_dialog("L'appareil nécessite une lunette pour être calibré, donc même si le tireur d'élite utilise une de ces armes qui tirent plusieurs balles à la fois, l'équipement ne lui permettra pas de le faire.","Russel")
	await novel_interface.show_dialog("Nous devons trouver leur emplacement après qu'ils aient tiré une première fois, et les éliminer avant qu'ils puissent tirer une deuxième fois.","Russel")
	await novel_interface.show_dialog("Le problème est que notre fusil de précision est toujours dans le coffre. Et comment faire pour qu’ils nous tirent dessus sans nous mettre en danger ?","Cassel")
	await novel_interface.show_text_only("Fabella étudie tranquillement la route devant lui avec un réflecteur et remarque une portière de voiture égarée accrochée à la queue d'un véhicule blindé renversé.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... Cela a dû tomber lors de l'explosion.","Fabella")
	await novel_interface.show_dialog("Pouvez-vous me trouver des données sur la durabilité exacte de l'armure Substance H de notre camion ridiculement cher ?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tu veux dire... tu veux l'utiliser comme bouclier... ?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Cela fera probablement un bon bouclier.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ah ?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("Il existe une vidéo en ligne d'un milliardaire qui a utilisé ce genre de véhicule dans une expérience de tir.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Même sous le feu d’un Barretta M82A1 équipé d’un dispositif d’accélération de stabilisation électromagnétique, le camion n’a pas été affecté du tout.")
	await novel_interface.show_text_only("Ce milliardaire ne faisait que s'exhiber avec ses liasses de billets et son accent russe. Mais force est de constater que la vidéo était populaire.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Si vous pensez que c’est sécuritaire, vous le faites.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Hein ?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella tâtonne sur ma veste de combat, comme si elle cherchait l'endroit parfait, puis m'enfonce son poing sorti de nulle part.")
	await novel_interface.show_text_only("C'était un coup de poing très impressionnant. Rien qu’en le regardant, j’étais convaincu que cela me tuerait sur-le-champ. Mais tout ce que j’ai ressenti, c’est un léger tremblement dans le haut de mon corps.")
	await novel_interface.show_text_only("Le fluide non newtonien remplissant ma chemise, bien que normalement doux, durcit à la seconde où il est touché par une force.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Jolie veste. Lorsque vous retiendrez la portière de la voiture plus tard, n'oubliez pas de vous pencher dessus et de laisser la veste absorber le choc au lieu d'utiliser vos mains.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Je—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avant que je puisse protester, Fabella me met un masque sur la bouche.")
	await novel_interface.show_text_only("Elle sort ensuite de sa ceinture un pistolet ressemblant à un jouet et vise le toit de l'immeuble d'en face.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Bombe flash de six secondes, prête...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bang !")
	await novel_interface.show_text_only("Un point de lumière ultra-lumineux sort du pistolet, balayant le magnifique ciel nocturne avant de finalement descendre.")
	await novel_interface.show_text_only("Fabella attend que la tache soit tombée suffisamment bas avant de me traîner dans une course folle vers le camion porteur renversé, derrière lequel nous nous cachons tous les deux.")
	await novel_interface.show_text_only("Cassel et Russel nous suivent également jusqu'à un blocage voisin où ils peuvent nous voir et communiquer avec nous.")
	await novel_interface.show_text_only("Fabella entre le mot de passe dans la porte arrière du coffre et récupère un Scout léger dans le râtelier d'armes.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Celui-ci est meilleur pour une visée rapide.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, prépare le drone. Gardez-le derrière le coin du bâtiment afin que le tireur d’élite ne puisse pas le voir. Ne le laissez sortir que lorsqu'il est suffisamment haut.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella ordonne, tout en jetant les bas de soie qu'elle a arrachés de mes jambes à Cassel, enroulés autour d'une pierre.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Fraîchement sorti du four !","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel me regarde alors qu'il attrape l'objet, l'air légèrement embarrassé, et je fais de mon mieux pour éviter son regard, le visage cramoisi.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, garde un œil sur les images transmises et fais-moi un rapport.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Roger ça.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella soulève ensuite la portière de la voiture, vérifie l'armure réfléchissante Substance H à motif de ruche dessus et la met dans mes bras.")
	await novel_interface.show_text_only("C’est plus léger que je ne le pensais. Je pourrais le soulever même d'une seule main.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Mais pourquoi dois-je jouer le rôle de leurre ?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Même si ce n'est pas comme si je savais faire autre chose...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella me rapproche et me murmure à l'oreille :")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Écoutez attentivement. Dès que je donne l'ordre, vous sortez de ce côté avec l'épaisse fumée, cachée derrière cette porte.","Fabella")
	await novel_interface.show_dialog("Le tireur d'élite devrait se trouver quelque part entre les étages trente et cinquante. Restez couvert, ne les laissez pas voir vos fesses ou quoi que ce soit...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ou alors, tu n’auras plus de fesses.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle me pousse dans la fumée juste après avoir fini de parler et me fait signe d'attendre là.")
	await novel_interface.show_text_only("Pendant ce temps, Cassel a déjà recouvert l'objectif de la caméra avec les bas, et a envoyé le drone jusqu'à une dizaine d'étages de hauteur, dissimulé dans l'ombre.")
	await novel_interface.show_text_only("Le manteau réfractant la lumière du drone lui permet de se fondre parfaitement dans son environnement. Personne ne serait capable de dire qu'il est là à moins de regarder très, très attentivement,")
	await novel_interface.show_text_only("Cassel et Russel donnent tous deux leur accord, et Fabella charge le fusil de sniper dans ses mains. Elle me fait un signe de tête...")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Il va falloir braver…","Ren")
	await novel_interface.show_dialog("(Aya a dit que tout ira bien même si je « meurs »...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Attendez, n'a-t-elle pas dit que je serais un simple observateur et que je ne peux pas interagir avec l'environnement ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dans mon moment d'hésitation, quelque chose me pique les fesses. C'est Fabella avec son arme. On dirait qu’elle est prête à m’exploser la tête si je ne commence pas à bouger bientôt.")
	await novel_interface.show_text_only("Je soupire, m'avançant d'un air maussade hors de la fumée, caché derrière la portière de la voiture.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(Ce mec milliardaire aurait intérêt à ne pas utiliser de faux accessoires lorsqu'il a réalisé cette vidéo...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je continue d'avancer, jusqu'à être à cinq ou six pas de l'épaisse fumée.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(... Personne ne me tire dessus ?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le tireur d'élite devrait pouvoir me voir facilement. Pourraient-ils dire que je suis un leurre ?")
	await novel_interface.show_text_only("Soudain, un bruit de pas crépitant vient de derrière. Depuis le périphérique de ma vision, Fabella glisse gracieusement dans ma vue, se retrouvant à moitié accroupie à mes pieds.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—Quoi ?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Couvre-moi !","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quelque chose s’écrase contre la porte que je tiens avec un grand bruit. La force dévastatrice me fait reculer, me déséquilibrant.") #文字错误
	await novel_interface.show_text_only("Je atterris sur le cul, la porte écartée. Fabella et moi sommes des cibles faciles et complètement ouvertes.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh non !)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Au quarante-deuxième étage ! Troisième fenêtre en partant de la droite ! Ils ont le guide laser !","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C’est alors que notre drone, dissimulé dans le ciel nocturne sombre, tire un laser rouge sur la fenêtre du bâtiment d’en face.")
	await novel_interface.show_text_only("Bang !")
	await novel_interface.show_text_only("Bang ! Claquer!")
	await novel_interface.show_text_only("Fabella tire, trois fois de suite.")
	await novel_interface.show_text_only("Puis le silence – un silence sans vie et désespérant. Je peux pratiquement entendre mon cœur pomper le sang dans mon cerveau.")
	await novel_interface.show_text_only("Seconde après seconde, elles passent. Je retiens mon souffle, m'imaginant être réduit en morceaux par un faisceau de lumière.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Cible éliminée. Je le répète, cible éliminée !","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("Ahaha !","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Bravo !","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Au lieu de faire la fête, Fabella continue à s'agenouiller dans la même position, l'arme à la main.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Chut, calme-toi. Est-ce que vous entendez...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En tendant l'oreille, je réalise que j'entends effectivement un hélicoptère approcher.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Qu'est-ce que c'est... un VTOL ?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Bon sang ! C'est un Tarin !","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Quoi ? Un tarin, ici ? Centre-ville ?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un Tarin est un type d'hélicoptère militaire sans pilote, développé à Masada Ford pendant la guerre de Sept Ans.")
	await novel_interface.show_text_only("Il est connu pour transporter douze missiles antichar, ce qui le rend parfait pour les campagnes d'anéantissement.")
	await novel_interface.show_text_only("La faucheuse rayée jaune et noire apparaît du ciel et atterrit entre nous et le bâtiment d'en face.")
	await novel_interface.show_text_only("C’est à ce moment-là que je réalise, eh bien, nous sommes finis.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
