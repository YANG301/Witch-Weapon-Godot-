	await novel_interface.show_text_only("莉琉和愛衣介紹完法貝拉的基本情況後，就說要先去樓下調一下設備，要我在這裡待命。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("她們兩個……就這麼走掉了？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("半夜裡空無一人的醫院走廊有種莫名的壓迫感。")
	await novel_interface.show_text_only("我穿著與四周完全不搭的女僕裝，坐在靠牆的座椅上。")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("怎麼有點像某個R級的殭屍遊戲……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("醫院怎麼會有殭屍呢，通常是鬧鬼吧～","？？？")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("哈哈哈哈～～說的也是，殭屍什麼的也太──","小憐")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("──咦啊啊啊啊啊啊！！！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("空蕩蕩的樓梯間突然冒出一個接話聲，我嚇得咚一聲從椅子上跳了起來。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("啊啊～非常抱歉，嚇到妳了嗎？","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一個嬌小的少女從轉彎處探出頭來。")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("又見面了呢，小憐姐姐～","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女金髮編成的辮子乖巧地垂落到腰間，那種散發著靈氣的超然氣質，只要見過一次就忘不了。")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("妳是……斯庫爾德？","小憐")
