# traumareflex_ep11.gd - 创伤反射篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第11话剧本
	traumareflex_ep11_script()

func play_script():
	pass

# 创伤反射篇第11话 - 正式剧本
func traumareflex_ep11_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Jilguero. Un helicóptero militar no tripulado.")
	await novel_interface.show_text_only("Una pesadilla para todas las unidades terrestres, este vehículo de gran potencia de fuego fue desarrollado por Masada Ford en la Tercera Ciudad Academia durante la Guerra de los Siete Años.")
	await novel_interface.show_text_only("Es capaz de realizar acciones de combate basadas en un algoritmo automatizado y puede aclimatarse fácilmente a entornos militares con interrupciones de ondas de radio.")
	await novel_interface.show_text_only("Su tecnología de reconocimiento de IA, que no es perfecta, es su único punto débil. Es conocido por fallar con frecuencia, dejando a muchos civiles muertos o heridos.")
	await novel_interface.show_text_only("Varios países han firmado un acuerdo para prohibir los dispositivos destructivos operados por máquinas. Sin embargo, Masada Ford sigue negándose a formar parte del acuerdo.")
	await novel_interface.show_text_only("Y ahora, esta pesadilla de rayas amarillas y negras está aterrizando lentamente desde arriba del edificio frente a nosotros.")
	await novel_interface.show_text_only("Los doce misiles de púas a cada lado del vehículo pueden fácilmente convertir todo el bloque en nada más que cenizas.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Shh, no te muevas.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella permanece arrodillada, con una rodilla en el suelo. Lentamente coloca su rifle de francotirador en el suelo y levanta ambos brazos en gesto de rendición.")
	await novel_interface.show_text_only("Mientras tanto, todavía estoy sentado allí, apenas capaz de respirar por la fuerza aplastante de la bala del rifle de francotirador que acababa de destruir mi cobertura.")
	await novel_interface.show_text_only("En las sombras, veo una silueta acercándose silenciosamente al Jilguero desde debajo de él.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Un avión de reconocimiento... ¿no es ese de esos que pueden autodestruirse?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El Siskin, flotando en el aire, escanea el entorno y de repente envía docenas de misiles de color naranja.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("...!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(¡Ay no!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los misiles dejan varios arcos brillantes en el aire, se extienden alrededor del Siskin y explotan todos a la vez.")
	await novel_interface.show_text_only("Varias filas de ventanas de vidrio se rompen en el edificio de atrás. El avión de reconocimiento también queda reducido a fragmentos relucientes en el aire.")
	await novel_interface.show_text_only("La luz del cartel rojo y azul detrás de toda la escena hace que parezca un glorioso espectáculo de fuegos artificiales a gran escala.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("(Así que dispara bengalas señuelo cuando no puede señalar la ubicación exacta de una amenaza...)","Fabella")
	await novel_interface.show_dialog("(Qué máquina de guerra tan brillante. Su programación de IA es algo extraordinario.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El helicóptero luego gira lentamente, gira, hasta que queda directamente frente a Fabella y a mí.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	await novel_interface.show_text_only("La lente del ojo compuesto debajo de su cuerpo apunta con su punto láser rojo de la muerte hacia nosotros dos, sentados allí expuestos justo en el medio de la carretera.")
	await novel_interface.show_text_only("Es como si el tiempo se hubiera detenido allí mismo.")
	await novel_interface.show_text_only("Los pocos segundos antes de la muerte son mucho más aterradores que la muerte misma.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Justo… ¿cuánto tiempo ha pasado?)","Ren")
	await novel_interface.show_dialog("(Si esto es parte de la memoria de Fabella, realmente debe haber sucedido.)","Ren")
	await novel_interface.show_text_only("Pero algo simplemente no se siente bien...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.show_text_only("De la nada, el jilguero se sacude violentamente y luego—")
	await novel_interface.show_text_only("Después de crujidos estáticos y varios ruidos metálicos, algunas partes del helicóptero se sueltan.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(¿Alguien... le disparó?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El helicóptero blindado gira hacia un lado y comienza a caer, pero pronto logra mantener la altitud.")
	await novel_interface.show_text_only("Intenta ascender una vez más. El sistema debe estar ajustando la posición del vehículo de acuerdo con el daño que ha sufrido.")
	await novel_interface.show_text_only("Una repentina voz femenina proviene de mi auricular, que había estado en silencio durante tanto tiempo que había olvidado que existía.")
	await novel_interface.show_dialog("¡Perdón por hacerlos esperar, mis bebés!","Voz Femenina")
	await novel_interface.show_dialog("Pero recuerde: el acelerador electromagnético móvil solo se puede utilizar una vez. Las balas normales no pueden atravesarlo.","Voz Femenina")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡Rina! ¿Cómo le va al equipo Alpha?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Preocúpate por ti mismo primero. ¡Aún tienes que lidiar con ese helicóptero!","Voz Masculina")
	await novel_interface.show_text_only("Una voz masculina profunda y ronca nos advierte.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("¿Dónde está...\nFabella?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy cuenta de que Fabella, que estaba agachada a mi lado, ya no está. Soy el único que queda, sentado en medio de la calle como un idiota.")  #换行问题
	await novel_interface.show_text_only("Segundos después, una sombra oscura con una cola naranja llameante emerge de debajo del camión blindado derribado con un chirrido agudo.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("¡Todos abajo!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Auge!")
	await novel_interface.show_text_only("Como destrozado por el fuerte grito de Fabella, el helicóptero estalla en llamas anaranjadas y amarillas en un lado.")
	await novel_interface.show_text_only("Pronto, el helicóptero es tragado por un fuego furioso. El Siskin gira y gira en el cielo, dejando un rastro de humo oscuro, y finalmente se estrella contra el suelo y muere.")
	await novel_interface.show_text_only("Una aleta de hélice sale zumbando en medio del denso humo y aterriza justo entre mis piernas, sobresaliendo de la superficie de alquitrán de la carretera.")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("?","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("…","Ren")
	await novel_interface.show_dialog("¡Aaaaaaaah!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Rápidamente retrocedo a cuatro patas, sintiendo como si mi corazón estuviera a punto de salirse de mi boca.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Jaja, pobre niña. ¿Todavía puedes pararte?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella aparece detrás del camión blindado, arrojando un cartucho de aguijón vacío a un lado.")
	await novel_interface.show_text_only("Subo, tratando de domar mi peinado desordenado.")
	await novel_interface.show_dialog("¡Bien hecho!","Voz Masculina")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("¿Pernard? ¿Cómo te va por ahí?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿No me vas a agradecer primero?","Voz Femenina")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Bien. ¡Gracias, oh gran Mirkin!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Amigo. ¿Por qué te quedaste callado todo este tiempo y sólo te emocionaste cuando ves a una chica?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("El “equipaje” está bien. Perdimos a Schwartz. Azoulay está caído.","Voz Masculina")
	await novel_interface.show_text_only("El hombre de voz ronca explica la situación con unas pocas palabras sencillas. Tan profesional, tan carente de emociones.")
	await novel_interface.show_dialog("La policía y Ritnalap enviaron apoyo, pero probablemente estén atrapados fuera del área. Probablemente habrá otra ola de ataques.","Voz Masculina")
	await novel_interface.show_dialog("Esta vía se encuentra barricada en ambos lados. Nos encontramos en la calle del lado este.","Voz Masculina")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Entendido.","Fabella")
	await novel_interface.show_dialog("¡Coge el equipo y prepárate para partir!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡Sí!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¿Qué pasa con el tipo de la camioneta?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("Dejemos al idiota aquí.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡Sí!","Cassel")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Partimos hacia la calle vecina rompiendo algunas ventanas de un hotel de la calle y atravesándola, llevando el resto de nuestras municiones y suministros.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Aquí todas las luces están encendidas. ¿No debería haber alguien cerca?","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("El Centro de Control de Enfermedades emitió aquí una advertencia de fuga de riesgo biológico de grado 3 hace noventa minutos. Sin embargo, ahora ha sido cancelado.","Russel")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Russel explica, mientras se desplaza por los mensajes en su tableta.")
	novel_interface.show_character("fabiola_battle","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("La guerra terminó el año pasado y los civiles todavía están paranoicos. ¿Quién quiere que le atrape una cara llena de ántrax, verdad?","Russel")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella pregunta, frunciendo el ceño:")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Ese jilguero... ¿no ha sido prohibido en el mercado a nivel mundial?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Por supuesto. Esos tipos se enorgullecen de su sistema de control de inteligencia artificial ultrasecreto. Ciertamente no se lo venderán a nadie.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Entonces, ¿qué pasa si recogemos la unidad de control de los escombros? De esa manera podremos estudiarlo, robar la tecnología...","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("El chip se autodestruyó en el momento en que el helicóptero se estrelló, idiota.","Russel")
	await novel_interface.show_dialog("Escuché que sus módulos de ataque y defensa en realidad están separados. Hace un par de meses, un oficial de Masada huyó de su país con una muestra de uno de esos módulos.","Russel")
	await novel_interface.show_dialog("Cuando Menorah se enteró, fueron tras ese pobre tipo, lo hicieron añicos a él y a su transporte. Incluso recogieron las cenizas y las enviaron de regreso a su país, por si acaso.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Su agencia de inteligencia también suena bastante loca...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡Están aquí!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sigo el sonido de pasos para ver a varios soldados deambulando desde el final de la calle.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Tienes cuatro aquí, eh... oh, ¿y un novato también?","Pernard")
	await novel_interface.show_dialog("Necesito un mapa de la zona.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El alto y fornido Capitán del Equipo Alfa, con un ojo cubierto por un parche, inmediatamente comienza a estudiar el mapa con Fabella.")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Qué lindo.\nSoy Rina Mirkin. Encantado de conocerlo.","Rina")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	await novel_interface.show_dialog("Encantado de conocerte. Llámame Ren.","Ren")
	await novel_interface.show_dialog("(¿No fue ella quien disparó el tiro que nos salvó el trasero?)","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Rina parece una hippie sofisticada, con su colorido pañuelo tejido y su rifle de francotirador.")
	novel_interface.show_character("leena")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mmm. Tu traje...","Rina")
	await novel_interface.show_dialog("¿Es lo que los jóvenes llaman girly punk?","Rina")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("Eh, no...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mis medias de seda con agujeros parecen... punk, sin embargo.")
	await novel_interface.show_text_only("Bueno…")
	await novel_interface.show_text_only("De repente, detrás de los anchos hombros del líder del Equipo Alfa, aparece una figura familiar.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Hola, señorita Ren.","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¡Nos volvemos a encontrar!","Skuld")

	print("=== 创伤反射篇第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
