# traumareflex_ep02.gd - 创伤反射篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第02话剧本
	traumareflex_ep02_script()

func play_script():
	pass

# 创伤反射篇第02话 - 正式剧本
func traumareflex_ep02_script():
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("<Fifth Academy City, Campus East Rd.>")
	await novel_interface.show_text_only("Night is fast approaching in the bustling business district. Students clad in uniforms of the private academy in the area are milling about.")
	await novel_interface.show_text_only("A girl, dressed in a maid outfit, is making her way briskly through the crowds.")
	await novel_interface.show_text_only("As there’s a maid cafe open 24/7 in the street across, her outfit doesn’t attract much attention.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Miss Skuld! Slow down! It’s dangerous!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Come on, stop nagging!\nLet me enjoy my few seconds of freedom in peace!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The blond girl twirls around and around, smiling like the sun.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("Relax!\nThis is the safest place in the world. Besides...","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("I have Fabella to protect me!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella finally catches up with her petite mistress and sighs at how energetic the little girl seems.")
	novel_interface.show_character("fabiola_maid","smile")
	await novel_interface.show_dialog("Few seconds of freedom, huh...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("For a little girl often shut inside by her overprotective father, New Opulentia is indeed the safest place she could be. It’s not like Newmoridas, where all residents are licensed to carry guns, or Salmonton, with its drab streets full of refugees and hobos.")
	await novel_interface.show_text_only("The Lebona Islands, too, are now home to prominent gangs that had relocated there during the war.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Also, since the International Forum of Peace will be held in New Opulentia next month, the security has been increased in the whole city.")
	await novel_interface.show_text_only("Fabella finally has a chance to come out with her little mistress without needing to carry an automatic weapon.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Yeah, it’s safe here, but you still gotta watch the traffic! And don’t wander out of my sight—","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Got it, got it!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The blond girl cuts off Fabella’s sentence by leaping forward and nuzzling her face in the maid’s chest.")
	novel_interface.character_light(0.35,"perspire")
	await novel_interface.show_dialog("Oh, you! You’re wearing a bulletproof vest even now?","Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Isn’t that a bit restricting?\nYou should let your boobs breathe!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","blush")
	await novel_interface.show_dialog("Breathe?","Fabella")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("All right, stop it...\n(Whispers) Don’t do this in public...","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Heehee, I knew Fabella’s the best! Thanks for pulling one over the guys in the Embassy for me and helping me sneak out!","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("Old Haggerty is so gonna kill us when we get back...\nStill, will the person we’re looking for really show up in this area?","Fabella")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I think so. Last time in Sky Hotel, I remember getting this really strong feeling... “That’s it, that’s the one”.","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You mean that clumsy maid?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The one I’m looking for should be a boy, though...","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Well...\nActually, boys can dress up as maids too, you know...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("See, actually, a lot of boys like to dress up in girly outfits...","Fabella")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ooh?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("They put on cute accessories and makeup too. How adorable is that?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ooh! And?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Some can talk in high-pitched girly voices too. A lot of them have huge followings online!","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella is so excited that her voice is practically trembling.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Oh, I remember seeing pictures before in your Instagraph favorites.","Skuld")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("In that case, maybe the maid we saw wasn’t a girl, but a boy dressed as one...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl seems to be deep in thought.")
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("Uh... hey!","Fabella")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Miss Skuld, leave my phone alone!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Come on, your phone’s got an encrypted connection so Father’s people won’t be able to tap in. Besides, your password is so easy to guess!","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("I never asked you to make my birthday your password!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld makes a face at Fabella, then turns around.")
	await novel_interface.show_text_only("She stares into the evening skies, dyed red by the setting sun, with a faraway, slightly disappointed look.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Anyway, no matter it’s a boy or girl, I guess it’s too late for us to find them today.","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("At least we got to enjoy the fresh air out here, right?","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("So... shall we go home now?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("There’s another place I want to visit. It’s near the Embassy. Come with me?","Skuld")
	await novel_interface.show_dialog("Do you remember Father Anton from the Trinity Church?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I think we’ve met only once... he’s the one in Newmoridas who would always listen to your confessions since you were little, right?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah. He sent me a text yesterday that said:","Skuld")
	await novel_interface.show_dialog("“New Opulentia Memorial Church”","Skuld")
	novel_interface.character_light(0.35,"thought")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I called him with your phone, but he never picked up. I’m a bit worried, so I thought I should visit the church he mentioned...","Skuld") #换行问题
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hm. The church is in the Agreed Demilitarized Zone and also close to the Embassy, so it’s probably safe.","Fabella") #文字错误
	novel_interface.change_2nd_expression("perspire")
	await novel_interface.show_dialog("But hey, when did you call him with my phone? And I didn’t even notice... how unprofessional of me...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ha, don’t be so hard on yourself!\nYou were busy cooking!","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A tiny smirk sneaks upon Skuld’s face at the thought of Fabella’s cooking.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Dusk.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("The duo arrive in front of a brown-colored stone church building, its outer walls covered by a massive religious mural.")
	await novel_interface.show_text_only("There’s a cross on top of the roof, looking dignified and solemn. Several domes with intricate carvings exude a grand, stately aura.")
	novel_interface.show_character("fabiola_maid","normal")
	await novel_interface.show_dialog("I didn’t know there was such a big church near the Embassy.","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("New Opulentia is a sort of academic city, you see. It’s all about science, so there’s not a lot of religious constructions around here.","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella switches her electronic map to Satellite View, curious about the topography structure and architecture in the area.")
	await novel_interface.show_text_only("It’s a habit she had cultivated back in the special ops squad.")
	novel_interface.show_character("fabiola_maid","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("skuld","normal",0.25)
	novel_interface.character_dark()
	await novel_interface.show_dialog("Weird. Such a huge church, yet there’s no model of it on the map. Is there some sort of restriction for buildings like this in international territory?","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("It’s probably because the church hadn’t even been opened until recently. It must be built for the Forum next month. See? The murals still look new.","Skuld")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Your father will be here next month, right? As a member of the Committee.","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("I think so. Anyway, let’s go inside!","Skuld")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Entering the church feels like stepping into the world’s most ancient shrine.")
	await novel_interface.show_text_only("The walls are entirely marble. Colossal columns stand somberly. The oil paintings on the domed ceiling and the surrounding colorful mosaic windows create an atmosphere of holiness and peace.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Hurry up! Look! Look! This place is structured just like the Trinity Church!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("W-wait for me!","Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Skuld skips around the place, drinking in every detail in delight, while Fabella remains vigilant, holding the entrance gate open.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("(There are still some wooden racks over there on the stairs...)","Fabella")
	await novel_interface.show_dialog("(This church must be still under construction.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella takes a few steps forward.The air around her vibrates—almost imperceptibly, but it’s there. All her hairs are standing on end, as if affected by static.")
	await novel_interface.show_text_only("She’s always been extra sensitive to danger, due to her childhood years on the battlefields in South America.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("(Wait... something’s off...)","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("A mere few steps ahead of Fabella, Skuld suddenly falls silent. She stands rooted in place, hands falling limp by her sides.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Dammit! We need to leave!","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass1.png")
	await novel_interface.show_text_only("In all but a millisecond, Fabella’s vision dims. The colors of the window panes, depicting Bible stories, seem to glow brighter, invading all her senses.")
	await novel_interface.show_text_only("The colors distort, twist, crowd her vision like a swarm of bees.")
	await novel_interface.show_text_only("The orange light from the setting sun outside writhes and warps, gradually melting into some entirely different color.")
	await novel_interface.show_text_only("Everything seems to merge together, seeping into Fabella’s nose and ears, like an ominous rustling approaching in an alarming speed.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella desperately tries to focus.")
	await novel_interface.show_text_only("It doesn’t clear her head much, but she manages to force her eyes open, only to see that Skuld has collapsed on the rug not far ahead from her.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Dang it!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The second she lifts a foot, trying to get to her little mistress, her legs give out.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("... I can’t see...","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass2.png")
	await novel_interface.show_text_only("The mosaic windows coil and convulse, closer, closer, like an oil painting melting into a flash flood of colors.")
	await novel_interface.show_text_only("The objects depicted in the mosaic paintings seem to be rearranging themselves in bizarre positions.")
	await novel_interface.show_text_only("The maid’s body sways, unconsciousness approaching fast—and the colorful invasion into her mind continues.")
	await novel_interface.show_text_only("The light penetrating through the window casts shadows on the ground, swallowing the last of her senses inch by inch.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella curls up abruptly, pulls out a dagger from inside a dagger.")
	await novel_interface.show_text_only("She aims for a spot with no main arteries, and slams the dagger into her thigh without a second of hesitation.")
	await novel_interface.show_text_only("The fresh blood dyes the girl’s fair skin red, but at least the burst of pain buys her a few seconds of clarity.")
	await novel_interface.show_text_only("Gritting her teeth, Fabella stumbles to Skuld’s side and picks the little girl up.")
	await novel_interface.show_text_only("She turns and staggers a few steps forward.")
	await novel_interface.show_text_only("Aiming at the main entrance, where there’s still light, she throws Skuld outside the building with what’s left of her will power before the darkness takes her.")
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("At least she’s safe now, Fabella thinks. Then her eyes fall shut, finally giving into the shadows.")

	print("=== 创伤反射篇第02话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
