# traumareflex_ep11.gd - 创伤反射篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第11话剧本
	traumareflex_ep11_script()

func play_script():
	pass

# 创伤反射篇第11话 - 正式剧本
func traumareflex_ep11_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Zeisig. Ein unbemannter Militärhubschrauber.")
	await novel_interface.show_text_only("Dieses Fahrzeug mit schwerer Feuerkraft war ein Albtraum für alle Bodeneinheiten und wurde während des Siebenjährigen Krieges von Masada Ford in der Dritten Akademiestadt entwickelt.")
	await novel_interface.show_text_only("Es ist in der Lage, Kampfhandlungen auf der Grundlage eines automatisierten Algorithmus durchzuführen und kann sich leicht an militärische Umgebungen mit Funkwellenstörungen gewöhnen.")
	await novel_interface.show_text_only("Seine nicht perfekte KI-Erkennungstechnologie ist sein einziger Schwachpunkt. Es ist berüchtigt für seine häufigen Fehlzündungen, bei denen viele Zivilisten getötet oder verletzt werden.")
	await novel_interface.show_text_only("Mehrere Länder haben eine Vereinbarung zum Verbot maschinell betriebener Zerstörungsgeräte unterzeichnet. Allerdings weigert sich Masada Ford weiterhin, Teil der Vereinbarung zu werden.")
	await novel_interface.show_text_only("Und jetzt landet dieser gelb-schwarz gestreifte Albtraum langsam über dem Gebäude vor uns.")
	await novel_interface.show_text_only("Die zwölf Spike-Raketen auf beiden Seiten des Fahrzeugs können leicht den gesamten Block in nichts als Asche sprengen.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Psst, beweg dich nicht.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella bleibt kniend, ein Knie auf dem Boden. Sie legt ihr Scharfschützengewehr langsam auf den Boden und hebt beide Arme in einer Geste der Kapitulation.")
	await novel_interface.show_text_only("Unterdessen sitze ich immer noch da und kann kaum atmen wegen der erdrückenden Wucht der Scharfschützengewehrkugel, die gerade meine Deckung weggesprengt hat.")
	await novel_interface.show_text_only("Im Schatten sehe ich eine Silhouette, die sich lautlos dem Zeisig nähert.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Ein Aufklärungsflugzeug... ist das nicht eines von denen, die sich selbst zerstören können?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der in der Luft schwebende Zeisig scannt die Umgebung und feuert plötzlich Dutzende orange leuchtende Raketen ab.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("...!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh nein!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Raketen hinterlassen mehrere helle Bögen in der Luft, breiten sich um den Zeisig aus und explodieren auf einmal.")
	await novel_interface.show_text_only("Im Gebäude dahinter zersplittern mehrere Reihen Glasfenster. Auch das Aufklärungsflugzeug zerfällt zu glitzernden Scherben in der Luft.")
	await novel_interface.show_text_only("Das Licht der rot-blauen Werbetafel hinter der gesamten Szene lässt es wie ein herrliches Großfeuerwerk aussehen.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("(Es feuert also Täuschungsraketen ab, wenn es nicht in der Lage ist, den genauen Standort einer Bedrohung zu lokalisieren ...)","Fabella")
	await novel_interface.show_dialog("(Was für eine brillante Kriegsmaschine. Ihre KI-Programmierung ist etwas ganz Besonderes.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Hubschrauber dreht sich dann langsam, dreht sich, bis er direkt auf Fabella und mich gerichtet ist.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	await novel_interface.show_text_only("Die Facettenaugenlinse unter seinem Körper richtet seinen roten Laserpunkt des Todes auf uns beide, die wir da mitten auf der Straße sitzen.")
	await novel_interface.show_text_only("Es ist, als ob die Zeit genau dort stehen geblieben wäre.")
	await novel_interface.show_text_only("Die wenigen Sekunden vor dem Tod sind weitaus schrecklicher als der Tod selbst.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Nur... wie viel Zeit ist vergangen?)","Ren")
	await novel_interface.show_dialog("(Wenn dies Teil von Fabellas Erinnerung ist, muss es tatsächlich passiert sein.)","Ren")
