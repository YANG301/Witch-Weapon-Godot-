	await novel_interface.show_dialog("Haha, armes Mädchen. Kannst du noch stehen?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella erscheint hinter dem gepanzerten Lastwagen und wirft eine leere Stinger-Patrone beiseite.")
	await novel_interface.show_text_only("Ich klettere hinauf und versuche, meine unordentliche Frisur zu bändigen.")
	await novel_interface.show_dialog("Gut gemacht!","Männliche Stimme")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Pernard? Wie läuft es da drüben?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Du wirst mir nicht zuerst danken?","Weibliche Stimme")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Gut. Danke, oh toller Mirkin!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Alter. Warum bist du die ganze Zeit still geblieben und hast dich nur aufgeregt, wenn du ein Mädchen siehst?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Das „Gepäck“ ist in Ordnung. Wir haben Schwartz verloren. Azoulay ist am Boden.","Männliche Stimme")
	await novel_interface.show_text_only("Der Mann mit der heiseren Stimme erklärt die Situation mit ein paar einfachen Worten. So sachlich, so emotionslos.")
	await novel_interface.show_dialog("Die Polizei und Ritnalap haben Unterstützung geschickt, aber sie sitzen wahrscheinlich außerhalb des Gebiets fest. Es wird wahrscheinlich eine weitere Angriffswelle geben.","Männliche Stimme")
	await novel_interface.show_dialog("Diese Straße ist auf beiden Seiten verbarrikadiert. Treffen wir uns an der Straße auf der Ostseite.","Männliche Stimme")
