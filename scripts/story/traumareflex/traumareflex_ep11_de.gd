	await novel_interface.show_text_only("Bald wird der Hubschrauber von wütendem Feuer verschluckt. Der Zeisig wirbelt am Himmel herum, zieht dunklen Rauch hinter sich her, stürzt schließlich zu Boden und erleidet seinen Untergang.")
	await novel_interface.show_text_only("Eine Propellerklappe zischt aus dem dichten Rauch hervor, landet genau zwischen meinen Beinen und ragt aus der Teeroberfläche der Straße hervor.")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("?","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("…","Ren")
	await novel_interface.show_dialog("Aaaaaaaah!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich setze mich schnell auf alle Viere zurück und habe das Gefühl, als würde mir das Herz gleich aus dem Mund springen.")
