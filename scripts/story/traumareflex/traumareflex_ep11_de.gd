	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("Das Disease Control Center hat hier vor neunzig Minuten eine Warnung vor biologischer Gefahr der Stufe 3 herausgegeben. Es wurde jedoch jetzt abgesagt.","Russel")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("erklärt Russel, während er durch die Nachrichten auf seinem Tablet scrollt.")
	novel_interface.show_character("fabiola_battle","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("Der Krieg endete erst letztes Jahr und die Zivilbevölkerung ist immer noch paranoid. Wer möchte doch schon von einer Anthrax-Gesicht getroffen werden, oder?","Russel")
