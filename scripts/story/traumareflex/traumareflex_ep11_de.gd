	await novel_interface.show_text_only("Fabella fragt finster:")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Dieser Zeisig... ist er nicht weltweit auf dem Markt verboten?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Natürlich. Diese Jungs sind stolz auf ihr streng geheimes KI-Kontrollsystem. Sie werden es sicherlich niemandem verkaufen.","Russel")
