	await novel_interface.show_text_only("Plötzlich ertönt eine weibliche Stimme aus meinem Ohrhörer – der so lange still war, dass ich vergessen hatte, dass er existiert.")
	await novel_interface.show_dialog("Tut mir leid, dass ich euch warten ließ, meine Babys!","Weibliche Stimme")
	await novel_interface.show_dialog("Aber denken Sie daran: Der mobile elektromagnetische Beschleuniger kann nur einmal verwendet werden. Normale Kugeln können es nicht durchdringen.","Weibliche Stimme")
