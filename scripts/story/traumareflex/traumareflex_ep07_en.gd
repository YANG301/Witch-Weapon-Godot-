# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("The moment the world ends?","Ren")
	await novel_interface.show_dialog("(Wait, did that disaster affect the whole world?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("But didn’t everyone seem just fine the next day?")
	await novel_interface.show_text_only("The only thing that “ended” was my...")
	await novel_interface.show_dialog("(What did I do to deserve this?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("But in that memory, you’re a boy.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("... Eh?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So, are you a boy, Miss Ren?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Uh... Um...\nUh, I...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("News headlines such as “Male Crossdresses to Sneak into Girl’s Hospital Ward” flash across my mind.")
	await novel_interface.show_text_only("Skuld inches closer, looking unbelievably smug, like she just caught me doing something illegal.")
	await novel_interface.show_text_only("I feel cornered, like a deer in the headlights.")
	await novel_interface.show_text_only("Unconsciously, I cover my chest and move backward, and then attempt to hold down my skirt too...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Ugh, this skirt is really too short! Can’t get it to stay put!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Uh, wait, what am I so nervous about?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aw, come on, I’m a girl!\nHahaha...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I don’t look anything like a boy right now. No way Skuld could have connected my current self with my original identity.")
	await novel_interface.show_text_only("Besides, Mariru did a lot to cover my tracks. Not even the best intelligence agency would be able to tell who I used to be.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("But that silhouette in the ruins of New Opulentia... it’s definitely a boy in my memories.","Skuld")
	await novel_interface.show_text_only("Skuld moves in front of me, studying my face with much bemusement.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("And after a flash of white light, I saw your face.","Skuld")
	await novel_interface.show_dialog("It was less than a second, but I never remember wrong.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("You’re the person in my memories.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I sit there, back pressed against the wall, terrified by the imposing aura of this small girl.")
	await novel_interface.show_text_only("No wonder in those classic fantasy novels, no matter how big the world is, there can never be more than two prophets. The author won’t know what to do with them.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(This kind of ability... it’s like cheating, isn’t it?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Still, it was just a fragment. And memories aren’t always reliable.","Skuld")
	await novel_interface.show_dialog("I guess I can’t be sure if you’re a boy or a girl either, just from that glimpse in my memories.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The blond girl relents a little, leaving me some space to breathe.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Still, I managed to confirm when you hugged me just now. Your body, your frame, your hair...","Skuld")
	await novel_interface.show_dialog("I’m not sure why, but Miss Ren is definitely a girl, at least right now.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("And they feel... nice...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld grins, mischievously.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("They?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Did she bury her face into my chest because she wanted to confirm if “they” were real?")
	await novel_interface.show_text_only("And she even checked my hair...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(I bet Mariru’s gonna scold me later for letting my guard down so easily!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld raises her head and clears her throat.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Anyway... we’ve exchanged secrets, so... we’re friends now, right?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She asks, cautiously, expectantly.")
	await novel_interface.show_text_only("My heart throbs. My instinct tells me that this is the real Skuld underneath it all, undisguised, vulnerable.")
	await novel_interface.show_text_only("She must have grown up in a world without trust. She’s still so young... can’t be more than thirteen years old...")
	await novel_interface.show_text_only("Even though her prophetic abilities aren’t that powerful, there’s probably tons of people who would love to use her.")
	await novel_interface.show_text_only("If her secret gets out, she’ll be ruined.")
	await novel_interface.show_text_only("Yet, she risked everything and told me, even though I could very well be monitored and wearing one of Mariru’s bugs...")
	await novel_interface.show_text_only("Perhaps all she wanted was a friend, someone she could be honest with.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Yeah. Your secret is safe with me.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hold up my pinky finger.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Because I’m... “special” to you, right?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wow, that’s so cheesy...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld stares, and then bursts into giggles.")
	await novel_interface.show_text_only("We pinky promise.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("When Aya enters the bar, she immediately spots Mariru on the window-side couch, gently swirling the glass of wine in her hand.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("The “security measures” for the prototype have been configured according to your requests.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Pretty fast, aren’t you?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("You wanted me to keep track of the stimulations to Ren’s vagus nerve, and disconnect her from the system immediately if something abnormal occurs. Isn’t that a bit violent, though?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("It’s kind of like a safety fuse. After all, we still don’t know much about how memories work, at least scientifically.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("And who knows if it’s indeed like what the movies say... “your brain gets fried if contradictory memories occur”.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya seems quite excited to watch someone’s brain get fried.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("If we conduct an experiment on a few dozen random people, we’ll know, right?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru raises her glass, studying the shape of the ice cubes inside it under the lighting.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Nah...","Mariru")
	await novel_interface.show_dialog("Even if a person does own two sets of completely contradictory memories, they’ll still find a way to rationalize it.","Mariru")
	await novel_interface.show_dialog("For example, memories from a past life, or a parallel universe. Or maybe some kind of divine epiphany.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Who knows, they can even start a cult with that kind of knowledge.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("True, but...","Aya")
	await novel_interface.show_dialog("But didn’t you ask the people at Harima Tech to not stimulate her prefrontal cortex, in order to keep the memory area in her brain cut off?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("You want her to forget most of the information she had after she wakes up, as if it were all a dream... right?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru turns to gaze out of the window at the virtual city lights.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella was a scout when she was a kid. She was raised by a warlord in South America.","Mariru")
	await novel_interface.show_dialog("She knows way too much, more than she can bear.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Oh?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Right, didn’t you tell Skuld to convince Ren to take this mission? Did it work?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Of course. That idiot won’t be able to say no to a cute girl.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("So simple, so naive. I kind of envy her.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("But wait, in that case, why did you—","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya stops mid-sentence, realizing that she already has the answer to her own question.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("You want to set down a sort of “memory anchor point” for Ren, huh?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru smiles and sips gracefully from her glass.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("The straightforward way is always the best, eh?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("You sure spoil her, don’t you?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eh. It’s time, let’s go.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
