	await novel_interface.show_dialog("之後，其他六個南美軍閥就像約定好一樣，一起人間蒸發，地盤也乖乖交給聯合議會的傀儡接管……","愛衣")
	await novel_interface.show_dialog("妳一定知道內情吧？","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣像隻好奇的小貓一樣湊近莉琉，用手肘推了推她的腰。")
