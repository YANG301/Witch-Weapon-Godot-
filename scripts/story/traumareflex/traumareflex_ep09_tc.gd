	await novel_interface.show_dialog("這我知道。","莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("我還檢測到一種興奮劑，是軍閥常用來讓士兵提神的藥物──這種藥物過量才是真正的死因。","愛衣")
