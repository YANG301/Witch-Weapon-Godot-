	await novel_interface.show_dialog("Ugh, je déteste les bugs !","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je continue de regarder ce « Skuld » et je ne prends même pas la peine de ramasser une arme de mêlée pour notre dernier combat.")
