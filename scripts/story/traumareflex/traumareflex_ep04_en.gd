# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Well, come back—no, that’s not right...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Welcome back, M-master...","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Still sounds weird...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Anyway...","Ren")
	await novel_interface.show_dialog("Why do I have to take up a part-time job in a maid cafe?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("What kind of secret mission is that? Mariru just wants to watch me suffer, I bet!")
	await novel_interface.show_text_only("The maid cafe in the embassy area is indeed quite popular and I’ve read articles online about it too.")
	await novel_interface.show_text_only("Elegant atmosphere, great food, classy silverware... and, last but not least, the maids are all super cute!")
	await novel_interface.show_text_only("But I’m the type who gets embarrassed easily if a girl calls me “Master”, so I never went.")
	await novel_interface.show_text_only("I was so naive then...")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("Because now I’m the one who’ll be calling others “Master” instead—and that’s even more embarrassing!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(And this maid outfit is so unnecessarily complicated!)","Ren")
	await novel_interface.show_dialog("(The skirt is already pretty short to begin with...)\n(And now, with a crinoline to puff it up, it’s even shorter! How do they expect me to walk?)","Ren")
	await novel_interface.show_dialog("(And garters... this is the first time I’ve worn them.)\n(So the clasp... it goes on the waist, huh?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stare down at the white lace garters on my legs.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(So this is how garters look from a first-person perspective...)\n(... Hm, pretty cute!)","Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Lemme snap a pic. No one has to know!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Click!")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Ahem, let me practice some more...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("If I get fired before I can even pass the training, Mariru would probably trample me to death.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Welcome back, Master!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("What would Master like me to write on your omelet, nyan?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ugh, this is so embarrassing!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Okay, let’s try it one more time...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ah, it’s getting late. Gotta change out of this ridiculous outfit and go to bed...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... This maid outfit looks good on you.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Yeah! You’ll make such a good maid!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I exit the bathroom to find Mariru and Aya on my apartment couch, looking incredibly amused.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Mariru? And Aya too?","Ren")
	await novel_interface.show_dialog("When... when did you get here?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("We’ve been here for a while, actually.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("So... my practicing...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("We heard all of it, of course!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("Kill me now...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Aw... anyway, what are you doing here?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("To watch you dress up as a maid and act out all your fantasies in front of a mirror, of course!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Did you have to put it like that?\n(Though she’s not wrong, I suppose...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("It’s not my fault I have to train for the undercover mission you gave me.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You really think you’ll be a good maid just by repeating some lines? It’s not that easy, you know.","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("The helicopter’s waiting on the roof. Let’s go.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh? You’ve got a mission for me? At this time of the night?\nGimme a sec, gotta change out of this...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("It’s fine. Our target for this mission is actually a maid too, so you’ll fit right in.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Did she just smirk? She definitely did! Ugh!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("But... this outfit...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Won’t be a problem. When you last ran into the target, you were dressed in a maid outfit too.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Just come with us and you’ll see.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("The three of us take the helicopter to a large medical facility, currently half-empty as most of the personnel had gone home.")
	await novel_interface.show_text_only("The building is silent, save for the sound of machines whirring in the background. Our footsteps echo off the quiet, whitewashed walls.")
	await novel_interface.show_text_only("There’s no one in sight. The brightly-lit corridors somehow seem even more macabre than pitch blackness.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Is this... a hospital?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I could tell that this must be a covert operation from how the helicopter pilots were both agents I’m familiar with.")
	await novel_interface.show_text_only("Mariru rarely participates in missions herself, but it’s obvious that, this time, she wants to ensure that the fewer people who knows about this, the better.")
	await novel_interface.show_text_only("I also notice that all the security cameras here have been twisted to face the walls.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("This is the Experimental Medication Department in Harima Tech’s Research Center.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("The identity of our target this time is extremely sensitive. The mission is top secret, not even the Senate can know.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Harima Tech... doesn’t it belong to the Senate, though?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("During my SID training, I had to memorize the names of all the organizations to steer clear of. Harima Tech is one of them.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("And wasn’t Dr. Bright a researcher here?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Oh, that gorilla man? He’s established independently now. This place has nothing to do with him anymore.","Mariru")
	await novel_interface.show_dialog("This is a practical research department. SID orders from this kind of organization a lot.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("We’ve ordered a lot of special equipment from here! In fact, most of the buildings of this department have been built solely for...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("For money. Aya doesn’t have to say it.")
	await novel_interface.show_text_only("Ha, a very... reliable buyer-seller relationship, eh?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Our target is called Fabella. You’ve met her once, back in the mission at Sky Hotel.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("She’s the maid who pulled you aside and scolded you for being a klutz.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Oh, her? I remember. She wore red-rimmed glasses, right? And she was working for a little girl...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("That’s right. Skurd Axelrod. Only daughter of a high-standing member of the Second Academy City Committee.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("She messaged us four hours ago via the Laundromat.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("So she wants to... betray her people?","Ren")
	await novel_interface.show_dialog("(Isn’t Skuld really young? As far as I can remember, she’s probably the same age as Elluka...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Based on what Skuld told us, our retrieval team managed to find Fabella unconscious in a church in the Agreed Demilitarized Zone.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("We detected lysergic acid diethylamide complex compounds in her blood. Military-grade chemical aerosol distribution devices were also found in the church grounds.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Hallucinogenic chemical weapons, huh? A very imaginative method to make your enemies turn upon each other, I see.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Was it a terrorist attack?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("No, more like a fly trap.","Mariru")
	await novel_interface.show_dialog("Skuld told us already. Fabella is a witch.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Huh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Now I kind of understand why they’ve asked me to come all the way here at midnight.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("After we neutralized the hallucinogens in Fabella’s system, she’s still in a deep coma...","Aya")
	await novel_interface.show_dialog("We couldn’t wake her even after injecting a large amount of Levodopa.","Aya")
	await novel_interface.show_dialog("Her cell metabolism level is skyrocketing, and her body temperature... we weren’t able to control it even by immersing her in ice water.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Any normal human would have lost most of their organs in conditions like this—but her body seems to have incredible tolerance for high temperatures.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Skuld told us that Fabella is a fire witch. Possessed by fire magic.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Possessed?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("This term strikes me as weird.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("According to our analysis on the data we’ve currently gathered, we can see magic as a field that manipulates “information”.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fabella’s not like Elluka, who can control electric fields directly. Her situation is more like... “certain powerful information” has chosen to possess her.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("You’re talking as if information had a will of its own.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("They do. If a string of information has a high enough density and a low enough entropy value, it can gain a will.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("When Fabella lost consciousness, the “living information” began taking over her body...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In a way, it reminds me of that news article in which a comatose owner got eaten by his own pet. I’m getting goosebumps just by thinking of it.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Soon, I realized that the reason we couldn’t wake her was that she was already “awake” in the first place.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("We scanned her hippocampus and prefrontal cortex, and they were both busy at work, as if she’s reminiscing over something.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("However, her brain stem didn’t send any effective reflective signals. It’s like something’s blocking it.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya’s words come out in a rush. She sounds way too eager.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("And when we scanned her brain with a Boltzmann sensor, we detected traits of mutations...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Wait... you mean that there are witch's cocoons... in her brain?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Bingo!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("So I thought, we happen to have a device that lets us hack into someone’s brain, so to speak. Harima Tech has been developing it for SID for a while.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("It’s just a prototype, but it’s already passed the alpha test.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("So I’m your lab rat now?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("You’re our last resort.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("We’ve already sent four agents into Fabella’s brain, but something kept “rejecting” them.","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("The agents described it as “an endless wall standing in the way”.","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
