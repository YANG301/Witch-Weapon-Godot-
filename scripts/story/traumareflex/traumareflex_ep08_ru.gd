# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Этот мир жесток.")
	await novel_interface.show_text_only("Война десятилетней давности оставила нам мало на что жить.")
	await novel_interface.show_text_only("В приюте было много таких детей, как я, но я все равно думал, что мне повезло меньше всего.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Perhaps I felt like what I lost was the most important. Но, может быть, тот факт, что я их потерял, сделал их еще более важными?")
	await novel_interface.show_text_only("И все же мне, беженцу, защищенному Эгидой, было трудно представить…")
	await novel_interface.show_text_only("Какой будет жизнь тех, кому пришлось продолжать выживать на поле битвы после потери своих близких.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Хафф... хаф...")
	await novel_interface.show_text_only("Хафф... хаф...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Я выбираюсь из густого дыма и падаю за машиной на обочине дороги, хрипло дыша в маску.")
	await novel_interface.show_text_only("Земля покрыта щебнем. Крики и звуки взрывов, кажется, доносятся со всех сторон.")
	await novel_interface.show_text_only("Сквозь пламя и дым я все еще могу различить красочную рекламу, играющую на экране далекого небоскреба.")
	await novel_interface.show_text_only("Все это кажется таким… сюрреалистичным.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Интересно, сколько подобных переживаний сохранилось в воспоминаниях Фабеллы...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ее жизнь так отличается от моей.")
	await novel_interface.show_text_only("После присоединения к SID я прошел некоторое обучение, но оно в основном связано с тактикой и манипулированием информацией.")
	await novel_interface.show_text_only("Я никогда не участвовал в настоящих учениях с настоящим оружием и пулями. Даже когда у нас была стрельба по стрельбе, я тяготел к небольшому количеству орудий меньшего размера с самой слабой отдачей. Мариру и Энни всегда смеялись надо мной.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Если бы только Энни была здесь...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Хм. Этот пистолет в моей руке... это КРИСС?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Пистолет-пулемет KRISS Vector, известный своей уменьшенной отдачей. Пули дозвуковые, бесшумные. Неудивительно, что Мариру называет это водяным пистолетом для слабаков.")
	await novel_interface.show_text_only("... Эй, не всем нравится носить с собой большое оружие, как ей, понимаешь?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Это оружие... не так уж и плохо, может быть, я справлюсь...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на расширенный магазин внизу и глотаю.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Нет. Лучше пока не включать предохранитель. Я не хочу ударить союзника.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я выглядываю, пытаясь наблюдать за ситуацией снаружи.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Кассель, там все в порядке?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Водитель мертв! Подожди... какого черта?\nОх, чувак все еще дышит!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Наденьте ему на лицо противогаз и бросьте в багажник. Тогда хватайте свое снаряжение и ищите укрытие!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Члены отряда не колеблются. Фабелла с черной сумкой перепрыгивает на другую сторону машины, за которой я прячусь.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Ух ты, не могу поверить своим глазам... она движется так быстро!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рассел помещает верхнюю палубу, отлетевшую от взрыва, рядом со стопкой камней, создавая слепую зону, которую он может использовать в качестве укрытия, и перебегает улицу.")
	await novel_interface.show_text_only("Через несколько секунд из ниоткуда из дыма выпадает огромный рюкзак, затем Кассель проезжает мимо и быстро исчезает в тени за углом.")
	await novel_interface.show_text_only("Эта ситуация, вероятно, пустяк для таких членов спецназа, как эти ребята. В конце концов, все они воевали на передовой.")
	await novel_interface.show_text_only("Но на этот раз вместо зоны боевых действий они сражаются во Втором Академгороде.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Остерегайтесь механических войск и отправьте дрон на разведку окружающей среды.\nРассел, уже связался с командой Альфа?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Ответа нет. Они по ту сторону взрыва вместе с нашим «багажом».","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я следую за взглядом Рассела. Улица впереди разнесена вдребезги, а мы застряли где-то посередине дороги.")
	await novel_interface.show_text_only("Смола на земле горит, как завтрашний день, поэтому трудно сказать, что происходит впереди.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Кто-то заранее закопал здесь бомбы?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Привет! Новичок! Ты действительно думаешь, что там безопасно прятаться?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—А?\n(Она со мной разговаривает?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем я успеваю среагировать, Фабелла схватила меня за воротник куртки и потащила в тень за банкоматом на обочине улицы.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Да ладно, врагу слишком легко доставить вас туда. И не знаешь, откуда будут стрелять.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Прежде чем я успеваю сформулировать ответ, она указывает на Рассела, который находится на другой стороне улицы, а Рассел отвечает, показывая большой палец вверх.")
	await novel_interface.show_text_only("Через несколько секунд из-за машины, где спрятан Рассел, поднимается серый дискообразный летающий объект.")
	await novel_interface.show_text_only("Фабелла достает из-за пояса небольшой планшет и начинает изучать с высоты птичьего полета зону, захваченную дроном.")
	await novel_interface.show_text_only("Два внедорожника, возглавляющие отряд, теперь представляют собой не что иное, как дымящиеся огненные шары.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Эти охранники... наверное, все мертвы. По крайней мере, команда Альфа и «багаж» остались позади...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно экран планшета растворяется в помехах, после чего раздается оглушительный «бум».")
	await novel_interface.show_text_only("Со слабым шипящим звуком серый дрон вспыхивает в небе.")
	await novel_interface.show_text_only("Его мелкие детали падают дождем, врезаясь в крыши машин вокруг нас с металлическим звоном.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("...Снайпер?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Должно быть, в здании напротив. Вероятно, используется антишпионское электромагнитное ускорительное устройство ближнего действия. Смотри, где ты прячешься. Убедитесь, что выбранное вами препятствие достаточно толстое.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это устройство, в котором металлические пули постоянно ускоряются за счет электромагнитной энергии. Чрезвычайно мощный, хотя устройство обычно громоздкое, и его трудно таскать с собой.")
	await novel_interface.show_text_only("Эти пули могут пробивать очень толстые препятствия. Во время войны премьер-министр был убит кем-то с расстояния более 0,3 мили, хотя он находился за цементной стеной толщиной три фута. Именно поэтому этот тип универсального снайперского устройства получил широкую известность.")
	await novel_interface.show_text_only("Подобные вещи на самом деле не были частью моих тренировок, я просто знаю об этом, потому что, ну, это в одной из моих любимых игр. В комплект также входит эксклюзивный скин по непомерной цене.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Глаз упал! Повторяю, Глаз упал!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Снайпер должен быть примерно в полумиле от нас. У нас есть еще один дрон с преломляющей поверхностью и на нем установлено «Всевидящее око». Они, вероятно, не заметят, если мы отправим это письмо.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Подождите, Всевидящее Око... радиус его линзы 15 мм, верно?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— спрашивает Фабелла, наблюдая через отражатель за ярко освещенным зданием напротив.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Значит, линза все еще может отражать свет. Даже когда ночь. Мы не можем его точно покрыть светопреломляющей поверхностью.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Значит, дрон они еще засекут, да... И мы не можем просто так открыть огонь по зданию. Это обычное жилое здание, и там живут невиновные люди.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Для снайпера, работающего с громоздким снаряжением, перезарядка которого требует длительного времени, приоритетом является не быть замеченным противником (нами).")
	await novel_interface.show_text_only("Я помню, как узнал об этом на тактических тренировках.")
	await novel_interface.show_text_only("Однако я помню ещё кое-что из того же учебника...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(Их приоритетом является то, чтобы их не заметили, это правда, но также... разве они не должны стараться вообще не сообщать нам о своем существовании?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Съёмка нашего дрона, естественно, означает, что мы узнаем об их существовании.")
	await novel_interface.show_text_only("Что, конечно же, сделает их мишенью. Кто бы это ни был, должно быть, либо новичок, который не знает, что делает…")
	await novel_interface.show_text_only("Или тот, кто уже уверен, что знает, куда стрелять дальше, и сможет эвакуироваться сразу после завершения работы.")
	await novel_interface.show_text_only("Мое сердце замирает.")
	await novel_interface.show_text_only("Я инстинктивно подпрыгиваю, заставляя Фабеллу упасть на землю, прочь от завала, за которым она прячется.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Что ты делаешь? Идиот—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В следующую же секунду завал, на который она опиралась, разлетается на куски.")
	await novel_interface.show_text_only("После разрушения покрытия пуля продолжает пробивать стену здания, создавая в стене выпуклость размером девять квадратных футов.")
	await novel_interface.show_text_only("Доски банкомата подбрасываются в воздух. Бесчисленные купюры взлетают в небо и в конце концов падают на землю, как снежинки, на фоне белых уличных фонарей.")
	await novel_interface.show_text_only("Это как сцена из нуара.")
	await novel_interface.show_text_only("Я смотрю, как завороженный, но Фабелла уже обхватила меня ногами за талию, заставляя меня катиться в тень, отбрасываемую стопкой цементных кирпичей.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Э? Почему она меня держит?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("С вами все в порядке, босс?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("А, я в порядке.\nК счастью, у нашего новичка сообразительность.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла отвечает, поглаживая меня по щекам. Это выглядело бы милым жестом, если бы она не ехала на мне.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("И я нашел способ не дать линзе отражать свет.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она говорит, протягивая руку к моим бедрам:")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
