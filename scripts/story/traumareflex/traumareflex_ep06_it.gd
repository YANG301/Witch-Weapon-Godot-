# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("—Bum!")
	await novel_interface.show_text_only("Ancora un'altra esplosione. La testata del nostro camion si solleva di colpo e io vengo scaraventato a terra.")
	await novel_interface.show_text_only("L'esterno del camion, fortificato con la magica Sostanza H, è appena intaccato, ma possiamo ancora sentire la forza schiacciante dall'interno.")
	await novel_interface.show_text_only("Mentre il camion si ribalta su un fianco, mi si contorce lo stomaco. Mi sento come se potessi vomitare le budella in quel momento.")
	await novel_interface.show_text_only("Esatto... la corazza del camion può essere invincibile, ma il terreno certamente non lo è. Basta far saltare il terreno e il camion sarà reso immobile.")
	await novel_interface.show_text_only("Che progetto insensato e inutilmente costoso...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Un mal di testa...")
	await novel_interface.show_text_only("Mi fischiano le orecchie, gli occhi riescono a malapena a mettere a fuoco.")
	await novel_interface.show_text_only("Per fortuna indosso una giacca da combattimento piena di fluido non newtoniano, altrimenti probabilmente mi sarei rotto la maggior parte delle ossa durante il pasticcio precedente.")
	await novel_interface.show_text_only("Non so chi abbia scelto l'attrezzatura per me, ma immagino che dovrei essergli grato.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Tuttavia, dovevano farmi indossare delle calze di seta?)\n(E adesso ci sono dei buchi!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pam! Pam! Pam! Pam! Pam!")
	await novel_interface.show_text_only("Fabella apre con un pugno il coperchio sopra il pulsante dell'uscita di emergenza nell'auto. Le micce detonanti sul tetto del camion esplodono una dopo l’altra.")
	await novel_interface.show_text_only("Sul tetto appare un buco, ora posizionato verso il lato. Fumo acre e fiamme invadono il mio naso e l'interno del veicolo.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Maledizione... tutti fuori!","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Tossisce* Ehi, il novellino sta bene?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ancora quasi incosciente, vengo preso da Fabella e gettato fuori dal camion.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Il fumo mi brucia gli occhi, facendomi piangere in modo incontrollabile e bloccandomi la vista.")
	await novel_interface.show_text_only("Prendo due grandi boccate d'aria ma esce solo fumo. I miei polmoni stanno per bruciare...")
	await novel_interface.show_text_only("Comincio a tossire e ad avere conati di vomito di riflesso, senza riuscire a riprendere fiato.")
	await novel_interface.show_text_only("Il mio corpo sussulta mentre soffoco, i miei occhi finalmente incontrano la maschera che pende dal mio collo. Lo premo velocemente sul naso e sulla bocca con una mano.")
	await novel_interface.show_text_only("Wow...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Dipartimento di farmaci sperimentali, Harima Tech>")
	await novel_interface.show_text_only("Dopo aver esaminato con me i dettagli di base riguardanti Fabella, Mariru e Aya scendono le scale per mettere a punto alcune apparecchiature, lasciandomi seduto lì tutto solo.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Quindi se ne sono semplicemente... andati via? Proprio così?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I corridoi silenziosi dell'ospedale sembrano improvvisamente opprimenti.")
	await novel_interface.show_text_only("Mi siedo su una sedia vicino al muro, vestita con un completo da cameriera totalmente fuori posto.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Mi sento come se fossi in uno sparatutto di zombie classificato come R...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No. Gli zombi non esistono. I fantasmi, invece...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Sì, ahah. Gli zombi non...","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Aspetta, chi era quello?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Balzo in piedi alla voce improvvisa che viene dalle scale.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Mi dispiace, ti ho spaventato?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una ragazza minuta fa capolino da un angolo.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("E ci incontriamo di nuovo, signorina Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I capelli biondi della ragazza le cadono fino alla vita in una delicata treccia. Sembra eterea, come qualcosa fuori dal mondo. Non un'aura che potrei mai dimenticare.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Oh, Skurd?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Mi ha chiamato... signorina?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld mi sorride timidamente. Sembra ansiosa, a disagio.")
	await novel_interface.show_text_only("Per nulla elegante e gentile, come quando ci incontrammo allo Sky Hotel.")
	await novel_interface.show_text_only("Oh, giusto! Fabella è la sua cameriera. Ovviamente sarà preoccupata...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("So che sei qui perché Mariru ti ha fatto venire...\nMa te lo avrei chiesto comunque...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lei sembra esitante, trema un po', trattenendo valorosamente le lacrime mentre parla.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Per favore... salva Fabella...","Skuld")
	await novel_interface.show_dialog("È stata tutta colpa mia se l'ho fatta uscire di nascosto con me...","Skuld")
	await novel_interface.show_dialog("Non mi aspettavo che ciò accadesse...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ehi, calmati!","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Oh no, piangerà!)\n(Cosa devo fare?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quasi le tendo una mano per consolarla, ma non mi sembra giusto abbracciare una bambina... nel corridoio di un ospedale a mezzanotte... con le giarrettiere e un vestito da cameriera.")
	await novel_interface.show_text_only("Mi fermo, con le braccia in aria, e lei si lancia nel mio petto.")
	await novel_interface.show_text_only("I suoi morbidi capelli biondi mi cadono sui gomiti. La ragazza odora un po' di latte. Il mio battito cardiaco accelera, il cervello ronza.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(È così piccola!)\n(Che carino!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ecco, col viso affondato nel mio petto, mi sembra più piccola di quanto sembrasse. Il suo corpo fragile trema, come un animale in trappola.")
	await novel_interface.show_text_only("Uhm. Aya ti ha parlato di hackerare cervelli? Non ricordo. Non importa.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Ti aiuterò! Ti aiuterò sicuramente!\nLascia fare tutto a me!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe ha smesso di funzionare. Direi di sì a qualsiasi cosa mi chieda di fare. Anche bombardare il Senato...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Va bene. Sono proprio qui.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sono pessimo nel confortare gli altri. A cosa le servirà il fatto di essere \"proprio qui\"? Chissà, ma di solito la gente non dice cose del genere in questo tipo di situazione?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Sì.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel mio abbraccio, Skuld annuisce dolcemente.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Credo in te. Puoi farlo.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Davvero? Io posso?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Perché... tu sei quella persona speciale... nei miei ricordi.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Ok... aspetta, cosa?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Io, speciale? Il mio vestito da cameriera le ha lasciato una grande impressione?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld si calma un po', si asciuga le lacrime, e mi guarda con occhi pieni di fiducia.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Posso raccontarti tutti i miei segreti.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Come... inaspettato. Non ho idea di come reagire.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Potresti trovare difficile crederlo, ma per favore ascolta.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La piccola e fragile ragazza di fronte a me improvvisamente torna sobria e non posso fare a meno di chinarmi, sentendomi tutto serio.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Ho una... capacità davvero speciale.","Skuld")
	await novel_interface.show_dialog("Ricordo cose che non sono ancora accadute... o dovrei dire... ci sono alcune cose che non sono ancora accadute, ma le vedo già, come ricordi.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Ricordi... che non sono ancora accaduti?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Quei frammenti esistono nei miei ricordi fin dall'inizio, quindi non riesco nemmeno a dire quali ricordi provengano dal passato e quali provengano dal futuro.","Skuld")
	await novel_interface.show_dialog("Devo vederlo accadere per essere sicuro.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Quindi è una specie di profezia?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembra incredibile, ma in questi mesi ho vissuto così tante follie che mi sono già abituato a credere a sei cose impossibili prima di colazione.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("È un po' come... una caramella. Un po' dolce, un po' acido, lascia un sapore di menta in bocca quando si scioglie.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hm, ho già mangiato quel tipo di caramelle, ma non sono sicuro di quando...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Esatto!","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Puoi descrivere in dettaglio il sapore di quella caramella, ma non puoi dire quando o dove l'hai assaggiata.","Skuld")
	await novel_interface.show_dialog("Ti renderai conto \"oh, questo è tutto\" solo quando un giorno riuscirai davvero ad assaggiarlo.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Penso di cominciare a capire. Se nei tuoi ricordi esistono frammenti che possono provenire dal passato o dal futuro, sarebbe difficile dire quale sia l'uno e l'altro.")
	await novel_interface.show_text_only("Per essere precisi, non è vedere il futuro. Perché non riesce a capire quali ricordi provengano dal futuro.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Aspetta... ma sicuramente sarebbe in grado di capirlo con qualche indizio nell'ambiente?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È come se Skuld mi leggesse nel pensiero. Lei spiega:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Potresti pensare: è vero potresti non essere in grado di dire se è successo qualcosa nel prossimo mese o nell'ultimo, ma l'ambiente tra dieci anni sarà sicuramente molto diverso da quello che è adesso, giusto?","Skuld")
	await novel_interface.show_dialog("Ma i ricordi... non sono come le riprese video. Tutto ciò che otteniamo sono frammenti...","Skuld")
	await novel_interface.show_dialog("Il nostro cervello può ricostruire l'intera scena di un ricordo solo quando ci concentriamo molto su di esso, sai?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ha senso. Ricordo questa frase di un film:")
	await novel_interface.show_text_only("“I ricordi sono interpretazioni, non registrazioni”.")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Pertanto in realtà non è così facile trovare nei miei ricordi frammenti che mi permettano di individuare l'arco temporale.\nInoltre...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("Di solito non approfondisci i tuoi ricordi senza motivo, giusto?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Ehm?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Ad esempio, non ricorderai la lezione di matematica della scuola elementare e ciò che l'insegnante ha scritto sulla lavagna, solo per divertimento, giusto?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Naturalmente. Lezione di matematica... insegnanti... certamente non divertenti.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Ti credo, è solo... wow. È incredibile.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Aspetta. Quindi, il \"me\" nei tuoi ricordi che hai appena menzionato...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld annuisce.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Comunque, c'è solo una cosa nei miei ricordi che sono sicuro accadrà in futuro.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Trattengo il respiro. All'improvviso ho la sensazione di poter indovinare a cosa si riferisce...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... È un ricordo del momento in cui il mondo finisce.","Skuld")
	await novel_interface.show_dialog("Ma in quel ricordo, sei un ragazzo.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
