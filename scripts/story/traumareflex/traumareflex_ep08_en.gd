# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("This world is a cruel one.")
	await novel_interface.show_text_only("The war ten years ago left us with little to live on.")
	await novel_interface.show_text_only("There were tons of kids like me in the orphanage—but I still thought I was the least lucky one.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Perhaps I felt like what I lost was the most important. But then, perhaps the fact that I lost them made them all the more important?")
	await novel_interface.show_text_only("Still, it was hard for me, a refugee protected under the Aegis, to imagine—")
	await novel_interface.show_text_only("What life would be like, for those who had to continue surviving on the battlefield after losing their loved ones.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Huff... huff...")
	await novel_interface.show_text_only("Huff... huff...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("I stagger out of the heavy smoke and slump down behind a car at the roadside, breathing harshly into my mask.")
	await novel_interface.show_text_only("The ground is covered with rubble. Screams and the sound of explosions seem to be coming from every direction.")
	await novel_interface.show_text_only("Through the flames and smoke, I can still distinguish the colorful commercial playing on the screen on a faraway skyscraper.")
	await novel_interface.show_text_only("It all seems so... surreal.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(I wonder how many experiences of this kind exist in Fabella’s memories...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Her life is so different from mine.")
	await novel_interface.show_text_only("I’ve undergone some training after joining SID, but it’s mostly related to tactics and manipulation of info.")
	await novel_interface.show_text_only("I’ve never been in a real drill with real guns and bullets. Even when we had target practice, I gravitated towards the few smaller guns with the weakest recoil. Mariru and Annie would always laugh at me.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(If only Annie were here...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hm. This gun in my hand... is it a KRISS?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A KRISS Vector submachine gun, known for its reduced recoil. The bullets are subsonic, the silent kind. No wonder Mariru calls this a water pistol for wussies.")
	await novel_interface.show_text_only("... Hey, not everyone enjoys carrying big guns like she does, you know?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("This weapon... not too bad, maybe I can manage...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I gaze at the extended magazine on the bottom and swallows.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Nah. Better keep the safety off for now. I don’t want to hit an ally.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I peek out, trying to observe the situation out there.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, everything okay over there?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("The driver’s dead! Wait... what the heck?\nOh my, dude’s still breathing!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Put a gas mask over his face and toss him into the trunk. Then grab your equipment and seek cover!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The squad members do not hesitate. Fabella, carrying a black bag, leaps over to the other side of the car I’m hiding behind.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Wow, can’t believe my eyes... she moves so fast!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel places the top deck that had flown off in the blast by a stack of stones, creating a blind zone he can use as cover, and shimmies his way across the street.")
	await novel_interface.show_text_only("Seconds later, a huge backpack drops in out of nowhere from the smoke, then Cassel rolls past and disappears swiftly into the shadows at the corner.")
	await novel_interface.show_text_only("This situation is probably a piece of cake for special ops squad members like these guys. They’ve all fought on the frontlines after all.")
	await novel_interface.show_text_only("But this time, instead of a war zone, they’re fighting in the Second Academy City.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Watch out for the mechanical troops and send a drone to scout out the environment.\nRussel, got in contact with Team Alpha yet?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("There’s no reply. They’re on the other side of the explosion, along with our “baggage”.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I follow Russel’s gaze. The street up ahead has been blasted into orderly smithereens, while we are stuck somewhere near the middle of the road.")
	await novel_interface.show_text_only("The tar on the ground is burning like no tomorrow, making it hard to tell what’s going on up ahead.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Did someone bury the bombs here beforehand?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Hey! Newbie! You really think it’s safe to hide there?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—Huh?\n(Is she talking to me?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before I can even react, Fabella has picked me up by the jacket collar and dragged me to the shadows behind the ATM machine at the side of the street.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("C’mon, it’s way too easy for the enemy to get you there. And you don’t know where they’ll be firing from.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before I can formulate a reply, she gestures to Russel, who‘s at the other side of the street, while Russel replies with a thumbs-up.")
	await novel_interface.show_text_only("Seconds later, a grey, disc-shaped flying object rises from behind the car where Russel is concealed.")
	await novel_interface.show_text_only("Fabella takes out a small tablet from her belt and begins studying the bird’s eye view of the zone captured by the drone.")
	await novel_interface.show_text_only("The two SUVs leading the troop are now nothing but smoking balls of fire.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Those security guards... probably all dead. At least Team Alpha and the “baggage” were behind us...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly the tablet screen fades away into static, followed by a deafening “boom”.")
	await novel_interface.show_text_only("With a faint, fizzling sound, the grey drone combusts in the sky.")
	await novel_interface.show_text_only("Its small components come raining down, slamming into the roofs of the cars around us with metallic clangs.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... A sniper?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Must be in the building across. Probably using a short-distance anti-espionage electromagnetic acceleration device. Watch where you’re hiding. Make sure the obstacle you choose is thick enough.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s a device that comes with metal bullets accelerated steadily by electromagnetic energy. Extremely powerful, though the device is usually cumbersome and hard to lug around.")
	await novel_interface.show_text_only("Those bullets can penetrating really thick obstacles. During the war, a Prime Minister was killed by one from over 0.3 miles away, even though he was behind a three-foot thick cement wall. That was how this type of comprehensive sniping device got its widespread fame.")
	await novel_interface.show_text_only("Stuff like this wasn’t actually part of my training, I simply know about it because, well, it’s in one of my favorite games. It comes with an exclusive skin too, for an exorbitant price.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("The Eye is down! I repeat, the Eye is down!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("The sniper should be around half a mile away from us. We have another drone with a refractive surface and it’s got an All-Seeing Eye mounted on it. They probably won’t notice if we send that one.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Wait, the All-Seeing Eye... the radius of its lens is 15mm, right?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella asks, as she observes the brightly-lit building across with a reflector.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("The lens can still reflect light, then. Even when it’s night. We can’t exactly cover it with a light-refracting surface.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("So they can still spot the drone, huh... And we can’t open fire at the building just like that. It’s a common resident building and innocent people live there.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("For a sniper working with a piece of cumbersome equipment that takes a long time to reload, the priority is to not be spotted by the enemy (us).")
	await novel_interface.show_text_only("I remember learning about that in tactical training.")
	await novel_interface.show_text_only("However, I also remember something else from the same textbook...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(Their priority is to not be spotted, that’s true, but also... shouldn’t they also try to not let us know about their existence at all?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Shooting our drone, naturally, means that we’ll know of their existence.")
	await novel_interface.show_text_only("Which will, of course, make them a target. Whoever it is must either be a rookie who doesn’t know what they’re doing—")
	await novel_interface.show_text_only("Or someone who’s already confident that they know where to shoot next and can evacuate immediately after they finish the job.")
	await novel_interface.show_text_only("My heart skips a beat.")
	await novel_interface.show_text_only("I leap up instinctively, forcing Fabella to the ground, away from the blockage she’s hiding behind.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("What are you doing? Idiot—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The very next second, the blockage she had been leaning on blows up into pieces.")
	await novel_interface.show_text_only("After destroying the cover, the bullet goes on to penetrate the wall of the building, creating a bulge sized nine square feet in the wall.")
	await novel_interface.show_text_only("The boards by the ATM machine are flung into the air. Countless bills flutter into the skies, eventually drifting down to the ground like snowflakes, with the white street lights as backdrop.")
	await novel_interface.show_text_only("It’s like a scene straight out of a film noir.")
	await novel_interface.show_text_only("I look on, mesmerized, but Fabella has already clamped her legs over my waist, sending me rolling into the shadows cast by a stack of cement bricks.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Eh? Why is she holding me down?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You okay, Boss?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, I’m fine.\nLuckily our newbie’s got quick wits.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella replies, patting my cheeks. Would have seemed like a sweet gesture if she hadn’t been riding on me.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("And I found a way to keep the lens from reflecting light.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She says, reaching towards my thighs—")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
