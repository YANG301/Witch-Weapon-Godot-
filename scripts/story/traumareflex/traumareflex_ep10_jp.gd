# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("コンクリートの陰の中で、ファビオラは俺の\n腰の上にまたがっていた。")
	await novel_interface.show_dialog("さてと。\nレンズの反射を防止する策を思い付いたわ──","ファビオラ")
	await novel_interface.show_text_only("彼女はそう言いながら、俺を地面にしっかりと\n押さえ付ける。")
	await novel_interface.show_dialog("えっ？\n（ちょっ……何をするつもりだっ！？）","レン")
	await novel_interface.show_text_only("ファビオラは左手を支えにして、右膝を俺の\n股の間に挿し込みながら、\n非常に嫌な予感のする笑みを浮かべた。")
	await novel_interface.show_text_only("彼女は右手を下に伸ばし、そっと俺の太ももの\nストッキングに指をかける……")
	await novel_interface.show_dialog("しっ──","ファビオラ")
	await novel_interface.show_text_only("そのまま視界を遮られて、彼女の動きが全く\n見えなくなった。\n皮膚を通して伝わる感触から、起きている事を\n脳裏で想像するしかできない。")
	await novel_interface.show_dialog("（やっ、やめ…………）\n\n（そ、そんな…………）","レン")
	await novel_interface.show_text_only("頬が熱くなり、胸がドキドキとなり続ける。\n\n条件反射で指に力が入ってしまう。")
	await novel_interface.show_dialog("（どう思い描いても……）\n\n（変な絵面しか想像できないッ！！！）","レン")
	await novel_interface.show_text_only("彼女を押し倒し、少し得意げになっていた\n俺への仕返しなのだろうか。\nあたふたと照れている俺の表情に、\nファビオラは生き生きとしている気がする。")
	await novel_interface.show_text_only("彼女は腕に力を入れ始めた。\n\n引っ張られるような感覚と共に「シュッ」と\n言う音を立てながらストッキングに穴が開く。")
	await novel_interface.show_text_only("同時に、俺は情けない声を出してしまう……")
	await novel_interface.show_dialog("やぁ……んッ……！","レン")
	await novel_interface.show_text_only("通信機のイヤホン越しに、\n唾を飲んだキャセールが咳き込む音が聞こえた。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("そんな事も気にせずファビオラはストッキングを\n丸ごと引き裂き、俺の靴を奪った。\nそして、足になぞってストッキングを段々と\n脱がせていく……") #换行问题
	await novel_interface.show_text_only("彼女が再び靴を履かせてくれた時には、\nもう恥ずかしくて何も言えなかった。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("（ううぅぅ…………）\n（足が……すーすーする……）","レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("へぇ、白くてモッチモチじゃないの……\n筋肉が全然付いてないわね。","ファビオラ")
