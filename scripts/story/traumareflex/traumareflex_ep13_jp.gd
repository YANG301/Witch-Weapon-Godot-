# traumareflex_ep13.gd - 创伤反射篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第13话剧本
	traumareflex_ep13_script()

func play_script():
	pass

# 创伤反射篇第13话 - 正式剧本
func traumareflex_ep13_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Vectorの極少の反動と超高速連射のおかげで、\n\nマガジン内に装填されていた28発の弾丸は\n2秒も経たずして撃ち尽くされた。")
	await novel_interface.show_text_only("「ポン」といった音に伴い、空中に投げられた\nエアロゲルスプレーが蜘蛛の頭上で爆発し、\n大量の泡が瞬く間に溢れ出る。")
	await novel_interface.show_text_only("泡はロボットの胴体と8本の脚を覆うように\n飛び散り、空気に反応して変色と膨張を始めた。\nまるで何もない場所から急に肉塊が現れたか\nのように──")
	await novel_interface.show_text_only("そして数秒後、ロボットの関節が薄緑色に固まり\n動かなくなる。")
	await novel_interface.show_text_only("機体内部の駆動系が必死に動作を促して\n不快な異音を響かせているが、\nもはや悪足掻きにしかなっていない。")
	await novel_interface.show_text_only("ファビオラは動けなくなった蜘蛛によじのぼり\nナイフを取り出す。\nそして、頭部にあった赤く点滅する探査装置に\n突き刺した。")
	await novel_interface.show_text_only("だが、強固な透明カバーに守られおりナイフの\n刃は3分の1のところまでしか刺さらなかった。\n蜘蛛の頭部がピクリと痙攣すると、さらに全身を\n震わせ始める。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("死ね――ッ！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラは振り向きざま、渾身の蹴りを\nナイフの柄に目掛けて放つ。\n凄まじい力によって、ナイフが蜘蛛の頭部に\n完全に突き刺さった。")
	await novel_interface.show_text_only("間もなくして……\n赤く光っていたライトが暗くなる。\n機体が完全に機能停止した合図なのだろうか。")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("……や、やったのかっ？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("未だ動揺中の俺はギュッと銃を握りしめて、\n警戒を続けた。\nファビオラが攻撃する間にマガジン交換も済ませ\nいつでも撃てる状態にしている。")
	await novel_interface.show_text_only("ファビオラとキャセールは蜘蛛を押し退け、\n下敷きになっているべルナドットを助け出した。")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("いまの奴は何よッ！？","リナ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("虫の巣だ……","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("べルナドットは車を背に、地面に腰を下ろして\n息を切らしていた。\nどうやら先ほどの戦いで体力をかなり消耗して\nしまったようだ。")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("そいつはとっくの昔にボツになった兵器の\nコンセプトじゃないのか……？","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("どういう事……？","リナ")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("昔に流行した兵器の設計理念だ。経験豊富な\n兵士の動きをプログラム学習させても、\n短期間で作戦に参加できる機械を作り出せないと\nすれば──","ラッセル")
	await novel_interface.show_dialog("パターンの少ない昆虫の動きを学習させて、\n群れで単純な行動をできるようにすればいい。","ラッセル")
	await novel_interface.show_dialog("しかし理由は分からんが、このコンセプトは\n廃棄されたんだ。\nそこに転がっているのは、ネット上に落ちていた\n設計図と良く似ているが……","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("その理由は新豊洲の『イージス』システムが、\n全世界に複雑なAIの将来性を示したからよ。\nそれで投資家達の援助も打ち切られ、\n研究開発は凍結される事態に陥ってしまった。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("だから『イエローヘッド』みたいなモノが\n出来上がったのよ……","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("（待って、集団で……行動？）","レン")
	await novel_interface.show_text_only("俺は今、すごく不味い言葉に気付いてしまった\nような──")
	await novel_interface.show_dialog("くそったれ、何だあれはッ！？","キャセール")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Spider_Cluster.png")
	await novel_interface.show_text_only("俺はキャセールの指さす暗い道の先を見る。")
	await novel_interface.show_text_only("遠くで10匹以上の小さな赤い点が蠢いている。\n\nそこから見える影は、さっき俺達を襲ってきた\nものより小型の蜘蛛だけど……")
	await novel_interface.show_text_only("……蜘蛛は何かの信号に呼び出されたかのように\n両サイドのビルから這い降りてきた。")
	await novel_interface.show_dialog("やっぱりぃ――ッ！？","レン")
	await novel_interface.show_text_only("昆虫の中には、死亡時に匂いを放出して\n同族を引き寄せようとする種も存在する。")
	await novel_interface.show_text_only("その匂いに引き寄せられた同族達は、\n襲撃者に対して猛烈な復讐を展開する。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("赤い点が次々と集まっていき、真っ先に集まった\n第一波の蜘蛛がこちらに飛びかかってきた。")
	await novel_interface.show_text_only("俺達6人は半円形状にスクルドを囲み、\n彼女をガードする。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("射撃開始ッ！！　各自の判断で良いッ！！","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("1匹の蜘蛛が直接、俺に飛んできた。\n\n──すぐさま銃で反撃する。")
	await novel_interface.show_text_only("さっきの奴よりは装甲も薄いみたいで、\n弾丸を撃ち込めば倒せはしている。")
	await novel_interface.show_text_only("しかし、小ささを生かした動きは非常に素早く、\nビルの窓からも降ってきて攻撃が立体的だ。")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("頭上注意ッ！！","リナ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("リナは拳銃で、建物から飛び出た蜘蛛を\n撃ち落とした。")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("どんどん湧いてきやがる……\n俺のマガジンは残り2つだッ！！","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("（俺も最後の1つだよッ！！）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("ラッセル。\n近くに窓のない閉鎖式の建物はあるか？\n出入口は複数あるのが望ましいが。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("窓のない建物…………あった！\n\n近くに2階建ての補強倉庫がある。\nこれなら天井から屋上に登れるぞ。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("そいつだ。","ベルナドット")
	await novel_interface.show_dialog("リナは先に行け。\n建物の近くで適切な狙撃ポイントを探せ。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("了解。","リナ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("ファビオラ。\nお前は隊員達を連れてそこに行け。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("分かった。","ファビオラ")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("──え、私……？\n\nなんで、ベルナドットが連れて行けば……？","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("べルナドットはファビオラの最後の手榴弾2つを\nポケットから抜き取る。\nそれから、黒いコートの片側をめくった。")
	await novel_interface.show_text_only("左側の肋骨の下には……大きな傷口が見える。\n\n暗い色の血液が、止めどなく溢れ出ていた。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("べルナドット！！！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("さっきのデカいやつは厳しかったぜ……","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──全員が無言になった。\n\nこのような傷は、戦場じゃなくとも最悪の状況を\n意味する。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("俺は足手まといだ。\n\nだからここで時間を稼ごうって事よ──","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("べルナドットは新しいマガジンに交換して、\nファビオラの肩をポンポンと叩いた。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("お前は隊員達を率いて、すぐに移動しろ……\n\n……これは命令だッ！！","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("言い終わるとべルナドットは振り返り、\n蜘蛛の群れに向かって手榴弾を投げ、\n断続的な射撃を開始した。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("──気を付けろよ。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…………","ファビオラ")
	await novel_interface.show_dialog("行く…………","ファビオラ")
	await novel_interface.show_text_only("ファビオラは俺達に背を向け、俯いたまま\n身体を震わせていた。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("……行くわよッ！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("振り返った彼女の瞳に、確固たる何かが見えた。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("これより移動するッ！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…………")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	await novel_interface.show_text_only("──その倉庫はビルの裏側に隠れるように\n存在していた。\n俺達は急いで貨物用エレベーターに乗り、\n2階の倉庫に上がる。")
	await novel_interface.show_text_only("遠くから聞こえていた銃声はすでに止んでいる。\n\n……全員が黙り込んだ。") #换行问题
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("ボス……","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","sad")
	await novel_interface.show_dialog("ラッセル。\n本部に現在地を知らせて支援を要請しなさい。\nあとEMP爆弾を持参させるように。","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラの瞳には涙がきらめいている\nようだった。")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("あ……ああッ！！　分かった！","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("感情的になりそうなのを抑え込んでいる様子だ。\nファビオラはゆっくりと拳銃を取り出す。\nそして素早くリロードを済ませると——\n\n銃口を俺の頭へと向けてきた。")
	await novel_interface.show_dialog("…………えっ？","レン")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Muzzle.png")
	await novel_interface.show_dialog("お前は、一体誰よ？","ファビオラ")
	await novel_interface.show_text_only("突然の事で防ぎようもなく、黒々とした銃口に\n俺は驚くばかり。\n心臓の鼓動が早まり、額から汗が滲むのを\n感じた。")
	await novel_interface.show_dialog("脚に筋肉もなければ、カバーポイントの探し方も\n分からない。\nお前のような人間がこの部隊の選考を通る\nなんて事があるはずがないわ。","ファビオラ")
	await novel_interface.show_dialog("私達全員は敵味方を識別できる装置を\n身に着けてるけど……\nさっきの『イエローヘッド』が攻撃を仕掛けて\nこなかったのは──\nお前という『味方』を誤って傷付けないため\nだったんでしょ？","ファビオラ")
	await novel_interface.show_dialog("それにお前がさっき使っていた泡の武器、\nあんなモノを見た事がないわ。\n大方、どこかの諜報機関の特殊装備だろうけど？","ファビオラ")
	await novel_interface.show_dialog("白状なさい……お前は一体、何者なのッ！！","ファビオラ")
	await novel_interface.show_text_only("俺は彼女の視線を避けるしかできなかった。\n\nエアロゲルスプレーは間違いなく、\n諜報機関の特殊装備だ。")
	await novel_interface.show_dialog("スナイパーの攻撃意図の判断や\nロボット蜘蛛の落下予測……","ファビオラ")
	await novel_interface.show_dialog("私ですら察知の難しい危機を、お前のような\nド素人が分かったって言うだけで不思議よ。","ファビオラ")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──俺は言葉が出なくなってしまった。")
	await novel_interface.show_text_only("それから……\n\n……また、違和感が頭の中によぎってくる。")
	await novel_interface.show_text_only("ふとした時に現れる、この『違和感』は\n一体何なのだろうか？\n……俺にも分からない。")
	await novel_interface.show_text_only("ねぇ……\nこんな経験した事はない？")
	await novel_interface.show_text_only("ある光景を急に思い出すんだけど、\nいつの記憶なのか思い出せない。")
	await novel_interface.show_text_only("ずっと前から起きる事を知っていて、\n最終的には答えが証明されるような感じ。")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Muzzle.png")
	await novel_interface.show_text_only("──ファビオラに銃を突き付けられるのも。")
	await novel_interface.show_text_only("俺は事前にこうなる事を知っていた……？")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("──そうなのか？")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("待ってッ！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("気が付くと、スクルドの小さな体が俺と銃口の\n間を塞いでいた。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("レンお姉ちゃんはパパがこの部隊に入れたの。\nあたし達とは長い付き合いよ。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("…………え？\n\n（マジで、えーと、そんな設定が？）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("…………","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("あの泡の武器は『理事会』が研究機関に\n依頼して開発した試作品なの。\nまだ『パランティア』には配備されて\nいないだけ。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("（いや、これ完全に嘘だッ！！）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("あたしはこの部隊に見張りを置かないように\nパパに勧めていたのだけど……\nパパがどうしても心配だからって……","スクルド")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("だからレンお姉ちゃんを傷付けないで！\n彼女は絶対にあたし達を裏切ったりしないから。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髪の少女は、今にも泣き出しそうな辛い表情を\n浮かべていた。")
	await novel_interface.show_text_only("純真無垢な瞳と向き合って、しばらくすると\nファビオラは少し動揺したかのように銃を下す。")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("うむ……『イエローヘッド』のAIモジュールは\n攻防それぞれが独立している。\nさっきは防御モジュールがたまたま展開して\nいただけの可能性はあるな。","ラッセル")
	await novel_interface.show_dialog("でなければ……マサダブルクがニューモリダスに\n対して宣戦布告に近い行動をするのは不合理だ。","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラはしばらく考え、そして銃を\nホルスターに収めた。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("くそッ──","ファビオラ")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("今回の護衛経路、時間、人員を含めた車両情報も\n全てが漏れていたッ！！\nそして……")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラはイラ立ちを隠せず、コンテナを\n力いっぱい蹴った。")
	await novel_interface.show_text_only("その間にスクルドは、疑問符を浮かべている俺を\n引っ張って近くに座らせると、\n俺に向けて神秘的な微笑みを浮かべた。")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("ビックリしたでしょ～～？\n\nまず水でも飲んで落ち着かないとね。\nキャンディ食べる？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女はピンクの水筒を俺に手渡して\nそれから金属製の缶を取り出した。\n缶から飴玉を二粒ほどシャカシャカして出すと\n俺の手の平の上に乗せてくれる。")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("（この水筒、直接口を付けても良いのかな？）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("レンお姉ちゃん、あなたもそうなんでしょ……？","スクルド")
	await novel_interface.hide_character()
