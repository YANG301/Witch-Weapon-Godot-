# traumareflex_ep01.gd - 创伤反射篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第01话剧本
	traumareflex_ep01_script()

func play_script():
	pass

# 创伤反射篇第01话 - 正式剧本
func traumareflex_ep01_script():
	novel_interface.show_background("res://assets/images/bg/Fabiola/Brain.png")
	await novel_interface.show_text_only("Anosognosia—")
	await novel_interface.show_text_only("Un estado en el que una persona, durante un cierto período de tiempo, no puede sentir su propia pérdida de una determinada función orgánica.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	await novel_interface.show_text_only("Por ejemplo, una persona ciega cree que todavía puede ver y, de hecho, puede describir vívidamente su entorno imaginario.")
	await novel_interface.show_text_only("Una persona paralizada cree que todavía puede mover sus extremidades con normalidad, hasta el punto de pensar que todos los demás están moviendo sus extremidades de la misma manera.")
	await novel_interface.show_text_only("Clínicamente, este fenómeno se llama ceguera de Anton.")
	await novel_interface.show_text_only("El cerebro, para dar una explicación razonable a una situación insondable, genera una serie de imágenes para convencer al cuerpo de que todo está bien.")
	await novel_interface.show_text_only("Quizás sea un reflejo innato que todos los humanos poseen.")
	await novel_interface.show_text_only("Un antiguo mecanismo de protección contra lo desconocido, programado en nuestros genes.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	await novel_interface.show_text_only("Me duele la cabeza.")
	await novel_interface.show_text_only("Un dolor de cabeza realmente serio.")
	await novel_interface.show_text_only("Se siente como si alguien hubiera vertido un saco de cemento en mi cerebro y actualmente lo estuviera removiendo.")
	await novel_interface.show_text_only("Mi cerebro zumba, mis oídos zumban.")
	await novel_interface.show_text_only("¿Estoy... dentro?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur.png")
	await novel_interface.show_text_only("Parpadeo y abro los ojos, las pupilas se acostumbran gradualmente al entorno brillante.")
	await novel_interface.show_text_only("Sin embargo, mis oídos no parecen haberse adaptado todavía. Se siente como si todos los sonidos estuvieran amortiguados y vinieran de muy, muy lejos.")
	await novel_interface.show_text_only("El aire huele a colonia mezclada con cuero y un aroma oxidado y cobrizo.")
	await novel_interface.show_text_only("En el estrecho espacio, envuelto por un pesado revestimiento, se disponen dos filas de asientos, uno frente al otro. Los soldados sentados sobre ellos discuten y ríen.")
	await novel_interface.show_text_only("No tienen un uniforme fijo, pero es fácil saber que pertenecen a la misma unidad por los dispositivos IFF redondos y brillantes que llevan.")
	await novel_interface.show_text_only("Característica de un escuadrón de fuerza especial bajo Ritnalap, organización de inteligencia en la Segunda Ciudad Academia.")
	await novel_interface.show_text_only("Si estoy en lo cierto, estoy en la panza de un camión F-950 SWAT...")
	await novel_interface.show_text_only("Hace unos años, un multimillonario compró uno de esos exorbitantes vehículos blindados de transporte de personal y lo renovó para que pareciera más un lujoso club nocturno que un vehículo militar.")
	await novel_interface.show_text_only("Luego hizo que otros dispararan contra el camión con armas mientras él estaba sentado dentro bebiendo champán con algunas damas.")
	await novel_interface.show_text_only("El video se volvió viral en línea, dándole amplia fama a este vehículo blindado de transporte de personal de fuerza especial, fortificado con Sustancia H.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/NewMoridas.png")
	await novel_interface.show_text_only("En la pantalla del proyector del vehículo, se reproducen imágenes en tiempo real capturadas por la cámara situada en la parte superior del camión.")
	await novel_interface.show_text_only("Las luces de la ciudad se ven impresionantes bajo el cielo nocturno. Hay decenas de rascacielos aún en construcción a la vista.")
	await novel_interface.show_text_only("Las barras de acero parecen extenderse hasta el cielo, como símbolos que representan la infinita y desnuda codicia de los humanos.")
	await novel_interface.show_text_only("Detrás de los grupos de edificios que perforan el cielo, el gigantesco hemisferio negro conocido como el Reino Oscuro se asoma en el horizonte.")
	await novel_interface.show_text_only("Bajo la dirección del Comité de Diecisiete Caballeros, esta Ciudad Academia ha mantenido su posición como el centro económico y financiero del mundo incluso después de la guerra.")
	await novel_interface.show_text_only("Así es, aquí es donde estoy ahora. La Segunda Ciudad Academia: Newmoridas.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("<Hace unas horas>")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Entonces... ¿quieres que hackee el cerebro del objetivo y acceda a sus recuerdos?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("En pocas palabras... sí.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Espera, ¿es eso siquiera factible?","Ren")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Un dispositivo que puede conectarse al cerebro...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No importa si recupera recuerdos a un servidor, o si nos otorga acceso a los pensamientos de alguien...")
	await novel_interface.show_text_only("¡Simplemente no parece seguro! He visto este tipo de dispositivo en toneladas de anime y películas, ¡y nunca funcionan bien!")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Oye, no te retuerzas las bragas.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Es un dispositivo experimental proporcionado por Harima Tech. Diseñado especialmente para desenterrar información, ¿o debería decir interrogatorio?","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Además, yo mismo actualicé el sistema de seguridad. Incluso si ocurren lesiones o la muerte dentro de la cabeza del objetivo, no sufrirás daño en la vida real.","Aya")
	await novel_interface.show_dialog("Te despertarán automáticamente después de estar conectado durante seis horas. Es completamente seguro.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Eh, está bien...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hago lo mejor que puedo para convencerme de que si Aya parece tan segura, debe estar bien.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Escucha, cuando estás conectado al dispositivo, no tienes una presencia real. Sólo estás ahí para observar, como... un fantasma.","Mariru")
	await novel_interface.show_dialog("Lo que debes hacer es encontrar información clave en los recuerdos del objetivo. No dejes ninguna piedra sin remover.","Mariru")
	await novel_interface.show_dialog("El objetivo se encuentra actualmente en lo alto de la escala de coma. No sabemos mucho sobre su pasado, por lo que no estamos seguros de en qué parte de su memoria está atrapada actualmente.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Lo que significa que debes prestar atención a cada detalle... ¡incluso si tu objetivo está en la ducha!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¡Oye, no quiero ser un voyeur!","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Simplemente no mires donde no deberías.","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Mmm…","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("¡Está bien, lo tengo!","Aya")
	await novel_interface.show_dialog("Lástima que este dispositivo no activa estimulaciones nerviosas, o de lo contrario también podrás interactuar con el entorno...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya ya se está dejando llevar por su imaginación.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Oye, lo que sea que estés pensando, no lo haré!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru enrolla algunos papeles y golpea a Aya en la espalda con ellos.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Parece que ahora he logrado entrar en los recuerdos del objetivo.")
	await novel_interface.show_text_only("Pensé que sería como un juego de disparos en primera persona...")
	await novel_interface.show_text_only("Pero en realidad, es mucho más complicado.")
	await novel_interface.show_text_only("Todo está borroso. Tengo que entrecerrar mucho los ojos para poder concentrarme.")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("En este momento, estoy en un camión blindado con varios hombres aficionados. Me esfuerzo el oído para escuchar su conversación.")
	await novel_interface.show_dialog("El Congreso Unido ya lleva más de un año en tregua. Pero el resto de países del mundo siguen luchando sin parar.","Voz Masculina A")
	await novel_interface.show_dialog("Los líderes de las seis naciones en el Consejo Unido están celebrando un Foro Internacional de Paz en estos momentos. Multitudes de manifestantes marchan por la Primera Avenida mientras hablamos.","Voz Masculina A")
	await novel_interface.show_text_only("Escucho una voz masculina ronca proveniente del asiento del pasajero, pero no puedo decir cómo se ve desde mi punto de vista.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¿No es ya el segundo Foro de Paz? Es claramente inútil.","Hombre B")
	await novel_interface.show_dialog("Todavía ocurren dos o tres explosiones cada semana a sólo dos millas de la Tercera Ciudad Academia.","Hombre B")
	await novel_interface.show_dialog("Mi tía que vive allí ya está acostumbrada. Incluso los bebés de la zona apenas reaccionan a las explosiones.","Hombre B")
	await novel_interface.show_text_only("La persona que habla a continuación es un hombre de piel pálida, de unos treinta o cuarenta años, con cabello castaño impecable.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mmm. Un año después de la tregua. Y el segundo Foro Internacional de la Paz...")
	await novel_interface.show_text_only("Esto me permite fechar este recuerdo hace aproximadamente dos años.")
	await novel_interface.show_text_only("Después de todo, el cuarto Foro Internacional de la Paz se celebrará el próximo mes en Nueva Opulentia.")
	await novel_interface.show_text_only("Recuerdo que Mariru se quejó la semana pasada sobre cómo la Zona Desmilitarizada Acordada probablemente será un desastre cuando llegue el momento.")
	await novel_interface.show_dialog("Esos terroristas... ¡están locos!","Voz Masculina A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Basta con mirar los nuevos planes de defensa urbana en Masada. Parece que pretenden transformar su ciudad en una súper fortaleza o algo así.","Hombre C")
	await novel_interface.show_text_only("El hombre sentado frente a mí parece tener unos veinte años, con piel bronceada y una bufanda con estampado de esqueleto.")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Eh, la guerra es demasiado común en Masada. Quién sabe, tal vez algún día de estos les caiga otra bomba nuclear sobre la cabeza.","Hombre B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ah, por cierto, ¿se enteraron? Los del Consejo...","Voz Masculina A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¿Esas personas? ¿Qué pasa con ellos ahora?","Hombre B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Están permitiendo que voluntarios realicen expediciones al Reino Oscuro!","Voz Masculina A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Oh, ¿te refieres a esa cosa espeluznante con forma de cúpula negra cerca de Long Island?","Hombre B")
	await novel_interface.show_dialog("Nada de lo que entra allí nunca sale, ni siquiera los drones.","Hombre B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Si no fuera por esa cosa que apareció de la nada y se tragó doce flotas de portaaviones, el Consejo ya no existiría.","Voz Masculina A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Quién sabe, tal vez esté conectado a la cocina de la mamá de Russel, ¿eh?","Hombre C")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡Mira quién habla, Cassel! Quizás conduzca a otro planeta. Ya sabes, de donde vienes.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Mmm. ¿La gente exige entrar al Reino Oscuro ahora? Un montón de idiotas con demasiado tiempo libre.","Voz Femenina")
	await novel_interface.show_text_only("Espera, ¿era una chica la que hablaba?")
	await novel_interface.show_text_only("Suena especialmente fuera de lugar en una cacofonía de voces masculinas ásperas.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_text_only("Sigo el sonido y veo a una chica de cabello rosado escondida detrás de los anchos hombros de Cassel, con una boina y anteojos con montura roja.")
	await novel_interface.show_text_only("La reconozco inmediatamente por las gafas. Ella es nuestro objetivo: Fabella, la chica que conocí una vez en el Sky Hotel.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una tos desde el asiento del pasajero interrumpe mis pensamientos.")
	await novel_interface.show_dialog("¡Fabella tiene razón! Ah, por cierto, ¿no había una nueva científica emergente en Nueva Opulentia llamada... Marie o algo así?","Voz Masculina A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Marirú. ¡La recuerdo!","Cassel")
	await novel_interface.show_dialog("¡Estuvo en la portada del número anterior de la revista Science! Usando medias negras. ¡Mmm! Todos esos nerds del departamento de investigación estaban babeando.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¿Lees la revista Science? ¿Crees que puedes conseguir una chica con física cuántica o algo así?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("No es mi culpa que Max haya comprado veinte números a la vez.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Entonces Mariru ya era muy popular hace dos años? A mí también me encantaría ver esa revista...")
	await novel_interface.show_dialog("Escuché que tiene curvas en todos los lugares correctos.","Voz Masculina A")
	await novel_interface.show_text_only("¿Estás fantaseando con el cuerpo de un científico? ¿Ser convertido en un espécimen es tu tipo de perversión?")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡El capitán te está mirando!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Uf. No tienes remedio. Ver a una chica bonita e inmediatamente perder todas las células cerebrales.","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Será mejor que tengas cuidado, o algún día terminarás siendo arrojado desnudo en el cementerio de autos, como aquella vez que probaste un sitio web de citas.","Fabella")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Uno habría pensado que tuviste relaciones sexuales con ese Cherokee de 1962. Tiene edad suficiente para ser tu abuela, ¿eh?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ja, jefe, deja de asar al pobre. Toda la sucursal sur ya lo sabe.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Jefe? Espera, ¿esa adolescente es la jefa de este escuadrón de fuerzas especiales?")
	await novel_interface.show_text_only("Ella no se parece en nada a la criada que vi la última vez. ¿Qué pasó entre entonces y ahora?")
	await novel_interface.show_text_only("No, espera. Esto fue hace dos años. Entonces debería haber dicho: ¿Qué pasó entre ahora y entonces?")
	await novel_interface.show_text_only("De todos modos, he localizado a mi objetivo. Sin embargo, mi visión todavía está un poco borrosa y todavía tengo un dolor de cabeza intenso.")
	await novel_interface.show_dialog("¡Oh, vamos, cállate!","Voz Masculina A")
	await novel_interface.show_dialog("Ejem... de todos modos, ¿no tenemos un novato uniéndose al equipo hoy?","Voz Masculina A")
	await novel_interface.show_dialog("Así que no bromeemos. Las primeras impresiones son importantes...","Voz Masculina A")
	await novel_interface.show_text_only("¿Un novato?")
	await novel_interface.show_text_only("Para escuadrones de combate como este, los miembros del equipo deben estar sincronizados para trabajar bien juntos. Un recién llegado puede cambiar toda la dinámica.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Chico, has estado inquieto sin parar. ¿Qué te pasa?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¿Estás buscando tu propia cabeza o algo así? ¡Está ahí pegado a tu cuello!","Cassel")
	await novel_interface.show_dialog("Aún así, quién sabe, puede que lo pierdas en esta misión...","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("Deja de asustar al chico nuevo. Él no es un bebé.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Eh? ¿A quién se dirigen?")
	await novel_interface.show_text_only("Instintivamente levanto una mano, queriendo frotarme los ojos borrosos, pero mi nudillo golpea una especie de barrera invisible.")
	await novel_interface.show_text_only("—Espera, ¿puedo sentir y controlar mi mano...?")
	await novel_interface.show_text_only("Y he tenido dolor de cabeza desde el principio...")
	await novel_interface.show_text_only("Pero Aya dijo que no sería capaz de controlar ni sentir nada... ¿verdad?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("De repente, Cassel extiende sus brazos y me quita el casco adjunto. Mi visión se aclara de inmediato. Oh, por eso todo estaba tan borroso y los sonidos amortiguados.")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Vaya.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Oh...","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡Es una niña!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Una niña? Lindo.","Voz Masculina A")
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("¿Eh...?","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("¿Q-qué está pasando...?","Ren")

	print("=== 创伤反射篇第01话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
