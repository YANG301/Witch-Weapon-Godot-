# traumareflex_ep12.gd - 创伤反射篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第12话剧本
	traumareflex_ep12_script()

func play_script():
	pass

# 创伤反射篇第12话 - 正式剧本
func traumareflex_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Hi, Miss Ren.","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("We meet again!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("Huh? Sku—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I catch myself just in time, swallowing my words.")
	await novel_interface.show_text_only("These memories are from two years ago. Skuld and I shouldn’t have met yet back then.")
	novel_interface.show_character("ren_mercenary","stare")
	await novel_interface.show_dialog("(Could she know me because of her special prophetic abilities?)","Ren")
	await novel_interface.show_dialog("(Skuld did say she remembered seeing me in her memories...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("And you’re Fabella, right?\nAnd Russel, Cassel...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld turns to the other squad members, face bright and innocent.") #换行问题
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Oh, did someone teach you our names?\nOur employer’s daughter is a clever little one indeed.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("(Haha, maybe she’s not as complicated as I thought.)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Nice to meet you!\nYou’re much prettier than in the photo—","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel elbows Cassel in the ribs to shut him up.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Oh please, don’t think I didn’t catch you staring on the auction.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld bursts out laughing at Cassel’s flushed face. The tense atmosphere is lightened a little.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Listen, our support troops are still held up outside the zone. We’ll need to figure out a way to reach the evacuation point ourselves.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("We’re temporarily merging teams. Everyone follow Captain Pernard’s orders.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella nods at Pernard, hands him several rifle magazines, while she herself picks up a shotgun.")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("(They seem to trust each other. Have they fought together a lot?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("We might encounter more hostiles soon. Everyone, take inventory now. See how much equipment and ammo we have and report back in five minutes.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("I’ve already checked my backpack. It’s got three magazines, a small emergency kit and a can of aerogel spray.")
	await novel_interface.show_text_only("It’s kind of like hairspray. The foam coming from the canister will immediately expand in size and congeal as soon as it’s exposed in the air.")
	await novel_interface.show_text_only("Annie once used it to seal up the door to a guest room back in Sky Hotel.")
	await novel_interface.show_dialog("(Why is this in my bag...?)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("While everyone is taking inventory, Fabella drags Pernard across the street.") #换行问题
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Our enemy really came prepared.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Yeah. They seem to have our whole itinerary mapped out. Even managed to evacuate the civilians at the perfect timing with a fake warning.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Which means that they know when the auction ended.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("How many hostiles have you encountered after the road was blasted?","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("A sniper and a Siskin. You?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Three snipers, four drones mounted with automated weapons.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That’s when Fabella finally notices the splattered blood on Pernard’s windbreaker. She asks nervously:")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("So many of them? Are you hurt?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Not seriously. Rina is an excellent shot, took them all out easily.","Pernard")
	await novel_interface.show_dialog("They dispatched the snipers in the perfect positions even in an area with so many tall buildings. This means that they know the “baggage” is with Team Alpha.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella frowns.")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("But didn’t that spoiled brat decide which car to go in only after the auction ended?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("This means that... one of us might have leaked the info.","Pernard")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pernard and Fabella stare in silence at the remaining four squad members, joking and laughing, surrounding the blond girl.")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("The enemy must be after her, of course, but they probably don’t want to kill her.","Pernard")
	await novel_interface.show_dialog("Or else, they could have done so easily some other time.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("... So they want to kidnap her?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Then at least send a ground squad or an armored vehicle.","Pernard")
	await novel_interface.show_dialog("Anyway, steer clear of open spaces. Proceed in the shadows of the buildings.","Pernard") #原文多字
	await novel_interface.show_dialog("Take care.","Pernard")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Yeah, you too.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On the other side of the road, I listen to Skuld and the three others discuss the auction they attended tonight.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("That manuscript you bought tonight... it cost you 36 million?","Cassel")
	await novel_interface.show_dialog("But isn’t it just some stupid old scroll? What’s so precious about it? Got all the future lotto numbers on it or something?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Oh please. You wouldn’t know the value of ancient relics.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","pleased")
	await novel_interface.show_dialog("I don’t really know much about relics either. I just somehow felt really strongly that I needed to buy it.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ah, that’s what I always feel when I see the newest shooter games!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel nods, understandingly.")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("(Are you sure you really understood?)\n(Skuld probably bought the item because of something she saw in her memories...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Come to think of it, lots of ancient scripts were indeed lost after the war. I heard that someone bought Archimedes’s manuscript sometime ago for millions of dollars, even.","Rina")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("So what’s this scroll you bought?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("It’s already thousands of years old according to carbon-14 dating. It’s some kind of recipe written in ancient runes, I think. I can’t read it either.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld says, showing us the faded paper, which she’s keeping in an exquisite folder in her black crocodile-skin bag.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Is it safe to show us... just like that?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The texture of the paper seems to resemble some kind of fabric. On it are countless unidentifiable runes, along with illustrations much like octopus arms.")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("Is this papyrus? But papyrus couldn’t have been preserved so well if it had been around for thousands of years.","Rina")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Shouldn’t you wear gloves or something before touching it?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("It’s fine, it’s covered with a layer of airtight spray.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Wow. Wonder what dish you can make with this recipe. Worth 36 million...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("You’d better teach your mom to cook it next time, Russ. Last time I had a dish she made I nearly ended up in the hospital.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Can’t blame my mom for that. You got explosive diarrhea only because you ate too much, not because of her cooking.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("So... those guys... maybe they’re after this scroll?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("But a Siskin costs over 20 million already. Unless this scroll holds some really important hidden message, it’s not worth it.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld")
	await novel_interface.show_dialog("Hidden message?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld holds the manuscript in the air, studying it under the spotlight from the building across.")
	await novel_interface.show_text_only("The others all huddle over, and I can’t help but join them too.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Well…","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("As far as I can see...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("There’s nothing suspicious about it...","Rina")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("Actually, what really strikes me as suspicious is...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Well, I’ve been wondering since we first arrived on this street.")
	await novel_interface.show_text_only("There are tons of nightclubs, bars and illuminated billboards around here.")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("But why is this spotlight pointing at us, instead of an ad or the entrance of a store?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("... Hm, true...","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Hey!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella, who’s across the street, suddenly shouts at us.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Move!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Boom!")
	await novel_interface.show_text_only("We barely manage to scatter before a gigantic black object crashes down from the skies, landing in the exact spot where the spotlight is pointing at.")
	await novel_interface.show_text_only("Amidst the cloud of dust and shattered asphalt, we hear the ominous noise of metal friction and mechanical joints whirring.")
	await novel_interface.show_text_only("A huge spike pokes out of the smoke, gleaming in a cold, blue metallic light.")
	await novel_interface.show_text_only("Attached to the spike is a sleek mechanical arm, which is in turn attached to—")
	await novel_interface.show_dialog("W-what the heck is that?","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Big_Spider.png")
	await novel_interface.show_text_only("Fabella did warn us that the enemy might send some kind of robot army—but I certainly wasn’t expecting, well, this.")
	await novel_interface.show_text_only("It’s got eight lithe, sharp, spiked legs, supporting a gigantic body that keeps making mechanical noises.")
	await novel_interface.show_text_only("... An alloy robot spider, nearly a meter tall. Equipped with spikes on every leg that can easily pierce through the human body.")
	await novel_interface.show_text_only("The deadly robot predator studies us with blinking red eyes on its “head”.")
	await novel_interface.show_dialog("Are you kidding me...","Rina")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("Fabella and Pernard promptly raise their weapons and open fire.")
	await novel_interface.show_text_only("The lead bullets rain on the alloy armor, sparks flying as the bullets ricochet off the spider’s body.")
	await novel_interface.show_text_only("The spider itself doesn’t seem affected at all. It turns to face Fabella and pounces onto her in one fluid move.")
	await novel_interface.show_text_only("Pernard ducks aside, while Fabella gets down and base-slides out under the spider’s belly.")
	await novel_interface.show_text_only("A loud boom comes from behind me, jolting me out of my dazed state. It’s Rina, who has started firing away too.")
	await novel_interface.show_text_only("The spider’s legs tremble, but even Rina’s anti-material sniper rifle leaves only a small dent on the alloy armor.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(What should I do...?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Use the aerogel? No way. It’ll roast me alive before I can even get close to spray my aerogel on it.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(C’mon, there’s gotta be a way...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The giant arachnid is now after Pernard, who smashes the window of a taxi parked at the roadside and hops in.")
	await novel_interface.show_text_only("Before he can even start the engine, the spider has detached a car door with a leg.")
	await novel_interface.show_text_only("Pernard takes the chance to roll out of the car again, grabbing the car door and slinging it over himself before the spider can pounce onto him.")
	await novel_interface.show_text_only("One of the spider’s spiked legs pierce right through the door and gets stuck there. Underneath is Pernard, who is trying his best to keep the car door in place, face ruddy from exertion.")
	novel_interface.show_character("ren_mercenary","shout")
	await novel_interface.show_dialog("Ugh, it’s now or never!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I make my decision and toss my whole can of aerosol spray at the spider.")
	await novel_interface.show_text_only("Next, I switch my KRISS Vector submachine gun to burst-fire mode and starts firing rapidly in the direction of the can I just threw into the air.")

	print("=== 创伤反射篇第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
