# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Diese Welt ist grausam.")
	await novel_interface.show_text_only("Der Krieg vor zehn Jahren hat uns wenig Lebensgrundlage hinterlassen.")
	await novel_interface.show_text_only("Es gab jede Menge Kinder wie mich im Waisenhaus – aber ich dachte immer noch, ich hätte das geringste Glück.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Vielleicht hatte ich das Gefühl, dass das, was ich verloren habe, das Wichtigste war. Aber vielleicht hat die Tatsache, dass ich sie verloren habe, sie umso wichtiger gemacht?")
	await novel_interface.show_text_only("Dennoch fiel es mir, einem unter der Ägide geschützten Flüchtling, schwer, mir vorzustellen:")
	await novel_interface.show_text_only("Wie das Leben derjenigen aussehen würde, die nach dem Verlust ihrer Lieben weiterhin auf dem Schlachtfeld überleben mussten.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Huff... huff...")
	await novel_interface.show_text_only("Huff... huff...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Ich stolpere aus dem dichten Rauch und lasse mich hinter ein Auto am Straßenrand fallen, wobei ich schwer in meine Maske atme.")
	await novel_interface.show_text_only("Der Boden ist mit Schutt bedeckt. Schreie und Explosionsgeräusche scheinen aus allen Richtungen zu kommen.")
	await novel_interface.show_text_only("Durch die Flammen und den Rauch kann ich immer noch den farbenfrohen Werbespot erkennen, der auf einem weit entfernten Wolkenkratzer auf dem Bildschirm läuft.")
	await novel_interface.show_text_only("Es scheint alles so... surreal.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Ich frage mich, wie viele Erfahrungen dieser Art in Fabellas Erinnerungen existieren...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ihr Leben ist so anders als meines.")
	await novel_interface.show_text_only("Ich habe nach meinem Beitritt zum SID einige Schulungen absolviert, die sich jedoch hauptsächlich mit Taktiken und der Manipulation von Informationen befassen.")
	await novel_interface.show_text_only("Ich habe noch nie an einer echten Übung mit echten Waffen und Kugeln teilgenommen. Selbst als wir Schießübungen hatten, tendierte ich zu den wenigen kleineren Geschützen mit dem schwächsten Rückstoß. Mariru und Annie haben mich immer ausgelacht.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Wenn nur Annie hier wäre...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hm. Diese Waffe in meiner Hand... ist das eine KRISS?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eine KRISS Vector-Maschinenpistole, bekannt für ihren reduzierten Rückstoß. Die Kugeln sind Unterschallgeschosse, die lautlose Art. Kein Wunder, dass Mariru das eine Wasserpistole für Weicheier nennt.")
	await novel_interface.show_text_only("... Hey, nicht jeder trägt so gerne große Waffen wie sie, wissen Sie?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Diese Waffe... nicht so schlecht, vielleicht schaffe ich es...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich starre auf das herausgezogene Magazin unten und schlucke.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Nein. Lassen Sie die Sicherung vorerst besser ausgeschaltet. Ich möchte keinen Verbündeten treffen.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue hinaus und versuche, die Situation da draußen zu beobachten.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, ist da drüben alles in Ordnung?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Der Fahrer ist tot! Warte... was zum Teufel?\nOh mein Gott, der Kerl atmet immer noch!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Setzen Sie ihm eine Gasmaske über das Gesicht und werfen Sie ihn in den Kofferraum. Dann schnappen Sie sich Ihre Ausrüstung und suchen Sie Schutz!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Truppmitglieder zögern nicht. Fabella springt mit einer schwarzen Tasche auf die andere Seite des Autos, hinter dem ich mich verstecke.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Wow, ich kann meinen Augen nicht trauen... sie bewegt sich so schnell!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel platziert das Oberdeck, das bei der Explosion weggeflogen war, neben einem Steinhaufen, wodurch eine blinde Zone entsteht, die er als Deckung nutzen kann, und balanciert über die Straße.")
	await novel_interface.show_text_only("Sekunden später fällt aus dem Rauch ein riesiger Rucksack auf, dann rollt Cassel vorbei und verschwindet schnell im Schatten an der Ecke.")
	await novel_interface.show_text_only("Diese Situation ist für Mitglieder einer Spezialeinheit wie diese Jungs wahrscheinlich ein Kinderspiel. Schließlich haben sie alle an der Front gekämpft.")
	await novel_interface.show_text_only("Aber dieses Mal kämpfen sie statt in einem Kriegsgebiet in der Zweiten Akademiestadt.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Achten Sie auf die mechanischen Truppen und schicken Sie eine Drohne, um die Umgebung zu erkunden.\nRussel, haben Sie schon Kontakt zu Team Alpha aufgenommen?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Es kommt keine Antwort. Sie befinden sich zusammen mit unserem „Gepäck“ auf der anderen Seite der Explosion.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich folge Russels Blick. Die Straße vor uns wurde in geordnete Stücke gesprengt, während wir irgendwo in der Mitte der Straße festsitzen.")
	await novel_interface.show_text_only("Der Teer auf dem Boden brennt wie kein Morgen und es ist schwer zu sagen, was vor uns vor sich geht.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Hat hier vorher jemand die Bomben vergraben?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Hey! Neuling! Glaubst du wirklich, dass es sicher ist, sich dort zu verstecken?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("– Hä?\n(Redet sie mit mir?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bevor ich überhaupt reagieren kann, hat Fabella mich am Jackenkragen hochgehoben und in den Schatten hinter dem Geldautomaten am Straßenrand gezerrt.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Komm schon, es ist viel zu einfach für den Feind, dich dorthin zu bringen. Und Sie wissen nicht, von wo aus sie schießen werden.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bevor ich eine Antwort formulieren kann, deutet sie auf Russel, der auf der anderen Straßenseite steht, während Russel mit erhobenem Daumen antwortet.")
	await novel_interface.show_text_only("Sekunden später erhebt sich ein graues, scheibenförmiges Flugobjekt hinter dem Auto, in dem Russel versteckt ist.")
	await novel_interface.show_text_only("Fabella holt ein kleines Tablet aus ihrem Gürtel und beginnt, die von der Drohne erfasste Zone aus der Vogelperspektive zu betrachten.")
	await novel_interface.show_text_only("Die beiden SUVs an der Spitze der Truppe sind nur noch rauchende Feuerbälle.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Diese Sicherheitsleute... wahrscheinlich alle tot. Zumindest Team Alpha und das „Gepäck“ hatten wir hinter uns...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich wird der Tablet-Bildschirm zu einem Rauschen, gefolgt von einem ohrenbetäubenden „Boom“.")
	await novel_interface.show_text_only("Mit einem leisen, zischenden Geräusch verbrennt die graue Drohne am Himmel.")
	await novel_interface.show_text_only("Seine kleinen Bestandteile prasseln herab und schlagen mit metallischem Klirren auf die Dächer der Autos um uns herum.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Ein Scharfschütze?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Muss sich im gegenüberliegenden Gebäude befinden. Vermutlich mit einem elektromagnetischen Beschleunigungsgerät zur Spionageabwehr für kurze Distanzen. Pass auf, wo du dich versteckst. Stellen Sie sicher, dass das von Ihnen gewählte Hindernis dick genug ist.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es handelt sich um ein Gerät, das mit Metallgeschossen ausgestattet ist, die durch elektromagnetische Energie stetig beschleunigt werden. Äußerst leistungsstark, obwohl das Gerät normalerweise unhandlich und schwer zu transportieren ist.")
	await novel_interface.show_text_only("Diese Kugeln können wirklich dicke Hindernisse durchdringen. Während des Krieges wurde ein Premierminister aus einer Entfernung von über 0,5 Meilen von jemandem getötet, obwohl er sich hinter einer drei Fuß dicken Betonmauer befand. Dadurch erlangte diese Art von umfassendem Scharfschützengerät seine weitverbreitete Berühmtheit.")
	await novel_interface.show_text_only("So etwas war eigentlich nicht Teil meines Trainings, ich weiß es einfach, weil es in einem meiner Lieblingsspiele ist. Es kommt auch mit einem exklusiven Skin zu einem exorbitanten Preis.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Das Auge ist unten! Ich wiederhole: Das Auge ist unten!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Der Scharfschütze sollte etwa eine halbe Meile von uns entfernt sein. Wir haben eine weitere Drohne mit einer brechenden Oberfläche und einem darauf montierten Allsehenden Auge. Sie werden es wahrscheinlich nicht bemerken, wenn wir das schicken.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Warte, das Allsehende Auge ... der Radius seiner Linse beträgt 15 mm, oder?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("fragt Fabella, während sie mit einem Reflektor das hell erleuchtete Gebäude gegenüber beobachtet.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Die Linse kann dann immer noch Licht reflektieren. Auch wenn es Nacht ist. Wir können es nicht genau mit einer lichtbrechenden Oberfläche bedecken.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Damit sie die Drohne immer noch erkennen können, hm... Und wir können nicht einfach so das Feuer auf das Gebäude eröffnen. Es ist ein gewöhnliches Wohngebäude, in dem unschuldige Menschen leben.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Für einen Scharfschützen, der mit einem schwerfälligen Gerät arbeitet, dessen Nachladen lange dauert, besteht die Priorität darin, vom Feind (uns) nicht entdeckt zu werden.")
	await novel_interface.show_text_only("Ich erinnere mich, dass ich das im taktischen Training gelernt habe.")
	await novel_interface.show_text_only("Ich erinnere mich jedoch auch an etwas anderes aus demselben Lehrbuch ...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(Ihre Priorität ist es, nicht entdeckt zu werden, das stimmt, aber auch... sollten sie nicht auch versuchen, uns überhaupt nichts von ihrer Existenz zu verraten?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Abfeuern unserer Drohne bedeutet natürlich, dass wir von ihrer Existenz erfahren.")
	await novel_interface.show_text_only("Was sie natürlich zum Ziel machen wird. Wer auch immer es ist, muss entweder ein Neuling sein, der nicht weiß, was er tut –")
	await novel_interface.show_text_only("Oder jemand, der bereits sicher ist, dass er weiß, wo er als nächstes schießen muss, und sofort nach Abschluss der Arbeit evakuieren kann.")
	await novel_interface.show_text_only("Mein Herz setzt einen Schlag aus.")
	await novel_interface.show_text_only("Ich springe instinktiv auf und zwinge Fabella zu Boden, weg von der Blockade, hinter der sie sich versteckt.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Was machst du? Idiot—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Schon in der nächsten Sekunde zerplatzt die Blockade, auf die sie sich gestützt hatte.")
	await novel_interface.show_text_only("Nachdem die Abdeckung zerstört wurde, dringt die Kugel in die Wand des Gebäudes ein und hinterlässt eine etwa neun Quadratfuß große Ausbuchtung in der Wand.")
	await novel_interface.show_text_only("Die Tafeln am Geldautomaten werden in die Luft geschleudert. Unzählige Geldscheine flattern in den Himmel und treiben schließlich wie Schneeflocken zu Boden, im Hintergrund die weißen Straßenlaternen.")
	await novel_interface.show_text_only("Es ist wie eine Szene direkt aus einem Film Noir.")
	await novel_interface.show_text_only("Ich schaue fasziniert zu, aber Fabella hat ihre Beine bereits um meine Taille geklemmt und lässt mich in den Schatten rollen, der von einem Stapel Betonziegeln geworfen wird.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Äh? Warum hält sie mich fest?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Geht es dir gut, Boss?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, mir geht es gut.\nZum Glück hat unser Neuling eine schnelle Auffassungsgabe.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella antwortet und tätschelt meine Wangen. Wäre eine nette Geste gewesen, wenn sie nicht auf mir geritten wäre.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("Und ich habe einen Weg gefunden, die Linse davon abzuhalten, Licht zu reflektieren.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie sagt und greift nach meinen Schenkeln –")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
