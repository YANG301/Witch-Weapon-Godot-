# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Ehi, provi mai questo tipo di sensazione?")
	await novel_interface.show_text_only("Ti ricordi una scena... ma non hai idea di quando sia accaduta.")
	await novel_interface.show_text_only("Non intendo deja vu. Tutti lo hanno prima o poi.")
	await novel_interface.show_text_only("Voglio dire, c'è qualcosa che hai sempre saputo che un giorno accadrà, e finalmente accadrà.")
	await novel_interface.show_text_only("Hai sempre saputo che ciò accadrà. L'hai anche visto, sotto forma di flashback. Non puoi semplicemente essere sicuro di quando accadrà.")
	await novel_interface.show_text_only("Ciò che chiamiamo deja vu è semplicemente una sorta di conferma che le tue premonizioni si sono avverate.")
	await novel_interface.show_text_only("Sapevi che sarebbe successo. Lo hai sempre saputo.")
	await novel_interface.show_text_only("Non è vero?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Uhm…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza bionda apre stordita gli occhi, si strofina il viso e si ritrova sdraiata su una panchina.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabella... dove siamo?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma Fabella non risponde. Strano. La cameriera di solito appare nel momento in cui viene chiamata per nome.")
	await novel_interface.show_text_only("La ragazza si guarda intorno e vede una strada vuota, fiancheggiata da lampioni ordinati su entrambi i lati. La strada sembra proseguire all'infinito in un silenzio inquietante, come se questo fosse un universo alternativo.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Non eravamo in una chiesa...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ahh... Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld si alza in piedi, massaggiandole la tempia dolorante con una mano.")
	await novel_interface.show_text_only("Si ricorda dell'incubo che ha avuto. Ricorda le immagini distorte sulle finestre a mosaico. Ma è stato davvero solo un incubo?")
	await novel_interface.show_text_only("Si ricorda di Fabella, che la buttò fuori dalla chiesa, liberandola dall'oscurità che altrimenti l'avrebbe reclamata...")
	await novel_interface.show_text_only("Skuld controlla le sue cose. Il suo cellulare, il suo portafoglio, i suoi accessori... tutto lì.")
	await novel_interface.show_text_only("Sul suo telefono ci sono trentadue chiamate perse.")
	await novel_interface.show_text_only("Se Fabella non avesse installato sul telefono un software anti-localizzazione, probabilmente l'Ambasciata l'avrebbe già trovata.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Le dieci e diciotto di sera... è già così tardi?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lei stringe gli occhi, facendo del suo meglio per regolare il respiro, per districare il groviglio che sono i suoi ricordi.")
	await novel_interface.show_text_only("Doveva restare calma, così avrebbero voluto il babbo e Fabella. Le hanno sempre detto che più la situazione è pericolosa, più ha bisogno di mantenere la lucidità.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Quella chiesa... e il testo di Padre Anton... devono essere una trappola.","Skuld")
	await novel_interface.show_dialog("Chiunque sia stato, deve aver preso di mira me, Padre o Fabella.","Skuld")
	await novel_interface.show_dialog("Sento le macchine nelle strade vicine e anche gli artisti di strada che suonano una canzone lontano... e non sono legato o altro.","Skuld")
	await novel_interface.show_dialog("Secondo il GPS del mio telefono, sono nell'Arai Central Park, non troppo lontano dalla chiesa.","Skuld")
	await novel_interface.show_dialog("Chiunque mi abbia portato qui probabilmente non intendeva fare del male.","Skuld")
	await novel_interface.show_dialog("Non so se chi ha teso la trappola e chi mi ha portato qui appartenesse alla stessa fazione... Non posso tornare indietro così.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld compone ancora una volta il numero di Fabella. E ancora una volta va alla segreteria telefonica. Controlla tutti i suoi documenti e non sembra che Fabella l'abbia contattata affatto.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabella...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alla fine chiama suo padre, stringendo forte il telefono nella sua piccola mano.")
	await novel_interface.show_text_only("Risponde non appena arriva la chiamata.")
	await novel_interface.show_dialog("Skuld? Sei tu?","Padre")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Padre...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Dove diavolo sei? Sono già passate le dieci di sera. dove sei. Tutti muoiono di preoccupazione!","Padre")
	await novel_interface.show_dialog("E né tu né la tua cameriera avete preso il telefono! Che avete voi due? L'ambasciatore Haggerty ha già inviato una squadra a cercarti!","Padre")
	await novel_interface.show_text_only("Suo padre sembra arrabbiato, ma Skuld è semplicemente sollevato nel sentire la sua voce.")
	await novel_interface.show_text_only("Almeno nessuno ha cercato di minacciarlo in alcun modo, usandola come ostaggio.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Sono al sicuro ora, non preoccuparti, ma ascolta...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'uomo si calma subito per l'urgenza del tono di sua figlia.")
	await novel_interface.show_dialog("...Sei solo?","Padre")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Sì. Solo io.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aspetta un attimo, ti richiamo con un altro numero.","Padre")
	await novel_interface.show_text_only("Riattacca e riceve immediatamente una chiamata da un numero sconosciuto.")
	await novel_interface.show_dialog("Ok, puoi parlare adesso. Quello che è successo?","Padre")
	await novel_interface.show_text_only("Skuld fa un respiro profondo. Secondo quanto sa attualmente, le possibilità dovrebbero essere due:")
	await novel_interface.show_text_only("Se coloro che hanno teso la trappola e quelli che l'hanno portata qui appartenevano allo stesso gruppo, allora il loro obiettivo deve essere Fabella, non la stessa Skuld.")
	await novel_interface.show_text_only("Se non appartengono allo stesso gruppo, allora lei stessa potrebbe essere l'obiettivo: chiunque la volesse ha fallito e attualmente tiene in ostaggio Fabella e padre Anton.")
	await novel_interface.show_text_only("Non importa quale sia, la sua persona preferita al mondo è in pericolo.")
	await novel_interface.show_text_only("Tuttavia, se si tratta della seconda ipotesi, non può andare a cercare Fabella da sola. Sarebbe finire dritto in una trappola, e probabilmente anche lei finirebbe come ostaggio, che i rapitori potrebbero usare contro mio padre e il Comitato.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Puoi fare qualcosa per me prima? Ho bisogno che qualcuno controlli padre Anton della Trinity Church e mi dica se è al sicuro.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Certo, manderò subito qualcuno.\nOra dimmi cosa sta succedendo.","Padre")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella ed io siamo caduti in un'imboscata nei pressi dell'Ambasciata non molto tempo fa. Probabilmente usavano qualche tipo di allucinogeno o droghe fatte con la sostanza H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cosa?","Padre")
	await novel_interface.show_text_only("Usare armi chimiche o fabbricate con la sostanza H in un territorio internazionale equivale praticamente a dichiarare guerra al Congresso Unito.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella ha rischiato la vita per salvarmi. Non so dove sia adesso...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Quei ragazzi devono avermi mandato un messaggio fingendo di essere padre Anton e attirarmi lì.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… capisco.","Padre")
	await novel_interface.show_dialog("Il Forum della Pace è il mese prossimo... perché sei dovuto andare a New Opulentia in un momento così delicato...?","Padre")
	await novel_interface.show_dialog("Chiunque osasse fare una cosa del genere sarebbe sicuramente molto attento alla propria identità.","Padre")
	await novel_interface.show_dialog("Anche se l'ex capo di Fabella in Sud America è morto, ha ancora parecchi nemici...","Padre")
	await novel_interface.show_dialog("Comunque, dove sei adesso?\nOrganizzerò qualcosa con le relazioni estere e ti riporterò a Newmoridas.","Padre")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Devi prima promettermelo! Promettimi che salverai Fabella!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce di Skuld trema, gli occhi colmi di lacrime.")
	await novel_interface.show_dialog("…","Padre")
	await novel_interface.show_text_only("Dall'altro capo del filo silenzio.")
	await novel_interface.show_text_only("Skuld sa che suo padre è estremamente abile, sempre ben informato. Sarebbe in grado di analizzare facilmente la situazione e decidere la migliore linea d’azione.")
	await novel_interface.show_text_only("Suo padre è il fondatore di una società di hedge fund, che fiorì sul mercato finanziario durante la guerra grazie alle sue eccellenti capacità decisionali. Fu così che si guadagnò un posto nel Comitato.")
	await novel_interface.show_text_only("Ma fu anche così che si guadagnò innumerevoli nemici. Dopotutto, far crollare le azioni è molto diverso dal far crollare un paese.")
	await novel_interface.show_text_only("Skuld è cresciuto in un ambiente pieno di odio e pericolo. Ma suo padre era stranamente persistente e si rifiutava di cambiare i suoi modi per sua figlia.")
	await novel_interface.show_text_only("Potrebbe avere qualcosa a che fare con sua madre, che era morta quando lei era molto giovane.")
	await novel_interface.show_text_only("All'improvviso, Skuld nota una piccola cornice rossa sullo schermo del suo telefono.\nCiò indica che la sua posizione viene tracciata durante la chiamata.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Riattacca immediatamente.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Adesso hanno la mia posizione! Devo uscire di qui...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld si precipita nella tromba delle scale di un vicino parcheggio.")
	await novel_interface.show_text_only("Richiama tra i suoi contatti il ​​numero di una lavanderia a gettoni. Fabella le aveva dato quel numero come ultima risorsa.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Immagino di non avere scelta adesso!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Accovacciata sui gradini, la ragazza compone il numero.")
	await novel_interface.show_text_only("Dopo tre squilli, parla una gentile signora.")
	await novel_interface.show_text_only("Lavanderia a gettoni Rexhill. Piacere di servirti.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Sono Skuld Axelrod, ID internazionale n. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Capito. Per favore aspetta...")
	await novel_interface.show_text_only("Signorina Axelrod, la vostra biancheria è pronta. Te lo inviamo?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Certo. A proposito, la mia amica della New Opulentia Memorial Church ha bisogno che le venga ritirata la biancheria.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Capito.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Sono a—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sappiamo dove ti trovi. Per favore sii paziente.")
	await novel_interface.show_text_only("La signora riattacca.")
	await novel_interface.show_text_only("Dieci minuti da brividi dopo, un SUV nero entra nel parcheggio.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Buon giorno, signorina Axelrod.","SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Sei di... SID?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Yes. Abbiamo già recuperato il tuo amico.","SID Agent")
	await novel_interface.show_dialog("Per favore, entra.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
