# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("—Бум!")
	await novel_interface.show_text_only("Еще один взрыв. Голова нашего грузовика резко поднимается, и меня швыряет на землю.")
	await novel_interface.show_text_only("Внешняя часть грузовика, усиленного магическим веществом H, почти не пострадала, но мы все еще можем чувствовать сокрушительную силу изнутри.")
	await novel_interface.show_text_only("Когда грузовик перекатывается на бок, у меня скручивает желудок. Такое ощущение, что меня тут же выблевут.")
	await novel_interface.show_text_only("Верно... броня грузовика, возможно, и непобедима, но земля уж точно нет. Просто взорвите землю, и грузовик станет неподвижным.")
	await novel_interface.show_text_only("Какой глупый, бессмысленно дорогой дизайн...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Головная боль...")
	await novel_interface.show_text_only("В ушах звенит, глаза едва могут сфокусироваться.")
	await novel_interface.show_text_only("К счастью, на мне боевая куртка, наполненная неньютоновской жидкостью, иначе я бы, вероятно, сломал большую часть своих костей во время предыдущего беспорядка.")
	await novel_interface.show_text_only("Я не знаю, кто выбрал для меня оборудование, но думаю, я должен быть ему благодарен.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(И все же им пришлось заставлять меня носить шелковые чулки?)\n(И теперь в них дырки!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бам! Бам! Бам! Бам! Бам!")
	await novel_interface.show_text_only("Фабелла ударом руки открывает крышку кнопки аварийного выхода в машине. Детонационные шнуры на крыше грузовика взрываются один за другим.")
	await novel_interface.show_text_only("На крыше появляется зияющая дыра, теперь расположенная сбоку. Едкий дым и пламя проникают мне в нос и салон автомобиля.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Черт... все вон!","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Кашляет* Эй, с новичком все в порядке?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Все еще едва сохраняя сознание, Фабелла подхватывает меня и выбрасывает из грузовика.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Дым обжигает мои глаза, заставляя меня плакать безудержно и блокируя зрение.")
	await novel_interface.show_text_only("Я делаю два больших глотка воздуха, но получаю только дым. Мои легкие вот-вот сгорят...")
	await novel_interface.show_text_only("Я рефлекторно начинаю кашлять и кашлять, не в силах отдышаться.")
	await novel_interface.show_text_only("Мое тело сопротивляется, я задыхаюсь, мои глаза наконец встречаются с маской, свисающей с моей шеи. Я быстро прижимаю его к носу и рту одной рукой.")
	await novel_interface.show_text_only("Вот...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Отдел экспериментальной медицины, Технологический институт Харима>")
	await novel_interface.show_text_only("Обсудив со мной основные детали, касающиеся Фабеллы, Мариру и Ая спускаются вниз, чтобы настроить какое-то оборудование, оставляя меня сидеть там совсем одного.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Так они просто... ушли? Просто так?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тихие больничные коридоры вдруг кажутся гнетущими.")
	await novel_interface.show_text_only("Я сижу на стуле у стены, одетая в совершенно неуместный костюм горничной.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Такое ощущение, будто я нахожусь в зомби-шутере с рейтингом R...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Нет. Зомби не существует. Призраки, наоборот...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Да, хаха. Зомби не…","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Подождите, кто это был?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вскакиваю на ноги от внезапного голоса, доносящегося с лестницы.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Простите, я вас напугал?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Из угла выглядывает миниатюрная девочка.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("И мы снова встретились, мисс Рен!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Светлые волосы девушки заплетены в тонкую косу до талии. Она выглядит неземной, как что-то из этого мира. Это не та аура, которую я когда-либо мог забыть.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("О, Скурд?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Она звала меня... Мисс?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд застенчиво улыбается мне. Она кажется встревоженной, беспокойной.")
	await novel_interface.show_text_only("Совсем не элегантный и грациозный, как тогда, когда мы встретились в отеле Sky.")
	await novel_interface.show_text_only("О, верно! Фабелла — ее горничная. Конечно, она будет волноваться...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Я знаю, что ты здесь, потому что Мариру заставила тебя кончить...\nНо я бы все равно тебя спросил...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, она колеблется, немного дрожит и доблестно сдерживает слезы, пока говорит.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Пожалуйста... спасите Фабеллу...","Skuld")
	await novel_interface.show_dialog("Это была моя вина, что я заставил ее сбежать со мной...","Skuld")
	await novel_interface.show_dialog("Я не ожидал, что это произойдет...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Эй, успокойся!","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(О нет, она заплачет!)\n(Что мне делать?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я почти протягиваю руку, чтобы утешить ее, но мне кажется неправильным обнимать маленькую девочку... в полночь в коридоре больницы... в подвязках и костюме горничной.")
	await novel_interface.show_text_only("Я делаю паузу, поднимаю руки вверх, и она бросается мне на грудь.")
	await novel_interface.show_text_only("Ее мягкие светлые волосы падают мне на локти. Девушка пахнет немного молоком. Мое сердцебиение учащается, мозг гудит.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(Она такая крошечная!)\n(Какая милашка!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Здесь, уткнувшись лицом в мою грудь, она кажется меньше, чем выглядела. Ее хрупкое тело дрожит, как загнанное животное.")
	await novel_interface.show_text_only("Хм. Ая упоминал что-нибудь о взломе мозгов? Не могу вспомнить. Плевать.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Я помогу тебе! Я обязательно тебе помогу!\nПредоставь всё мне!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe перестал работать. Я бы сказал «да» всему, что она меня попросит. Даже бомбить Сенат...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Все в порядке. Я здесь.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я ужасно умею утешать других. Какая польза от того, что я буду «здесь», ей вообще принесет? Кто знает, но разве люди обычно не говорят подобные вещи в подобных ситуациях?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Да.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В моих объятиях Скульд мягко кивает.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Я верю в тебя. Вы можете это сделать.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Правда? Я могу?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Потому что... ты тот особенный человек... в моих воспоминаниях.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Ладно... подожди, что?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Я особенная? Неужели мой наряд горничной произвел на нее такое большое впечатление?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд немного успокаивается, вытирает слезы и смотрит на меня глазами, полными доверия.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Я могу рассказать тебе все свои секреты.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как... неожиданно. Я понятия не имею, как реагировать.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Возможно, вам трудно в это поверить, но, пожалуйста, послушайте.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Маленькая, хрупкая девочка передо мной внезапно трезвеет, и я не могу не наклониться, чувствуя себя серьезной.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("У меня есть... действительно особенная способность.","Skuld")
	await novel_interface.show_dialog("Я могу вспомнить то, что еще не произошло... или лучше сказать... есть некоторые вещи, которые еще не произошли, но я уже вижу их, как воспоминания.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Воспоминания... которых еще не было?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Эти фрагменты существовали в моих воспоминаниях с самого начала, поэтому я даже не могу сказать, какие воспоминания из прошлого, а какие из будущего.","Skuld")
	await novel_interface.show_dialog("Мне нужно увидеть, как это произойдет, чтобы быть уверенным.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("То есть это что-то вроде пророчества?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это звучит невероятно, но за эти несколько месяцев я пережил столько безумия, что уже привык перед завтраком верить в шесть невозможных вещей.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Это что-то вроде... конфеты. Немного сладкий, немного кисловатый, при таянии оставляет во рту мятный привкус.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Хм, я уже ела такие конфеты, но не знаю, когда...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Верно!","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Вы можете подробно описать вкус этой конфеты, но не можете сказать, когда и где вы ее попробовали.","Skuld")
	await novel_interface.show_dialog("Вы поймете «о, вот оно!» только тогда, когда однажды действительно попробуете это.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, я начинаю понимать. Если в ваших воспоминаниях существуют фрагменты, которые могут быть как из прошлого, так и из будущего, будет трудно сказать, что есть что.")
	await novel_interface.show_text_only("It’s not seeing the future, to be exact. Потому что она не может сказать, какие воспоминания из будущего.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Подождите... но наверняка она сможет разобраться в этом с помощью каких-то подсказок в окружающей среде?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд как будто читает мои мысли. Она объясняет:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Вы можете подумать: это правда, что вы, возможно, не сможете сказать, произошло ли что-то в следующем месяце или в прошлом, но окружающая среда через десять лет наверняка будет сильно отличаться от того, что происходит сейчас, не так ли?","Skuld")
	await novel_interface.show_dialog("Но воспоминания... они не похожи на видеозаписи. Все, что мы получаем, это фрагменты...","Skuld")
	await novel_interface.show_dialog("Наш мозг может восстановить всю сцену воспоминаний только тогда, когда мы очень сильно на ней концентрируемся, понимаете?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это имеет смысл. Я помню эту строчку из фильма:")
	await novel_interface.show_text_only("«Воспоминания — это интерпретации, а не записи».")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Поэтому на самом деле не так-то просто найти в моих воспоминаниях фрагменты, позволяющие точно определить временные рамки.\nКроме того...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("Обычно ты не копаешься в своих воспоминаниях просто так, верно?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Хм?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Например, вы ведь не будете вспоминать урок математики в начальной школе и то, что учитель написал на доске, просто для развлечения, верно?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Конечно. Урок математики... учителя... конечно, невесело.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Я верю тебе, это просто... вау. Это невероятно.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Подожди. Итак, «я» в твоих воспоминаниях, о котором ты только что упомянул…","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд кивает.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("В любом случае, в моих воспоминаниях есть только одно событие, которое, я уверен, произошло в будущем.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Я задерживаю дыхание. У меня внезапно возникает ощущение, что я могу догадаться, о чем она говорит...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... Это воспоминание о моменте конца света.","Skuld")
	await novel_interface.show_dialog("Но в этом воспоминании ты мальчик.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
