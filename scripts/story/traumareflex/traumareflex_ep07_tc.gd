# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("「世界終結時」……的記憶？","小憐")
	await novel_interface.show_dialog("（等等，難道那次災難波及到了全世界！？）","小憐")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("但是第二天大家不是都還好好的嘛──")
	await novel_interface.show_text_only("唯一被「終結」的只有我的……")
	await novel_interface.show_dialog("（嗚嗚嗚嗚……我快不行了啦……）","小憐")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("只不過，在那段記憶裡，小憐姐姐，妳是男孩子喔～。","斯庫爾德")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("……欸？","小憐")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("到底是不是呢……小憐姐姐？","斯庫爾德")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("呃？ 欸，啊啊～\n那、那個……我不──","小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("我腦中快速閃過一堆《女裝變態半夜潛入少女病房》之類的新聞標題。")
	await novel_interface.show_text_only("斯庫爾德慢慢逼近，露出一副「被我逮到了吧？」的得意表情。")
	await novel_interface.show_text_only("我卻有種偷偷穿著女裝上街，暴露之後又被人逼到暗巷牆角的感覺……")
	await novel_interface.show_text_only("我下意識地摀住了胸部往後退，又覺得有點不對，然後試圖用手擋住裙子……")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("（這裙子這麼短完全擋不住嘛！！）","小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("（欸？ 等等……不對啊，我為什麼要慌張！）","小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("我、我當然是女生啊～\n哈哈哈哈……","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我現在應該和還是男生時的外貌差異頗大。")
	await novel_interface.show_text_only("而且莉琉已經做足了背景情報的修飾，就算是頂級偵察機構也無法將現在的我和以前的我做出連結。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("我記得新豐洲廢墟中的那個背影，確實是個男孩子。","斯庫爾德")
	await novel_interface.show_text_only("斯庫爾德走到我的面前，目不轉睛地盯著我。")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("一陣白光之後，我看到了妳的臉──","斯庫爾德")
	await novel_interface.show_dialog("雖然只有一瞬間，但我絕對不會記錯！","斯庫爾德")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("妳，就是我記憶中的那個人。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我被面前這個小女孩的氣勢壓得後背緊緊貼在走廊牆壁上。")
	await novel_interface.show_text_only("怪不得那些經典奇幻小說中，世界觀再宏大再完整，最多也只容得下一兩個預言家。")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("（這種能力根本就是開外掛啊！）","小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("但畢竟只是破碎的片段，而且我們總會不自覺修飾自己的記憶──","斯庫爾德")
	await novel_interface.show_dialog("僅憑腦海中的一張臉，我也無法確認妳是男是女。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髮少女稍稍退後了一點，給了我一些喘息空間。")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("不過剛才抱妳的時候確認過了，無論身體、骨架還是頭髮──","斯庫爾德")
	await novel_interface.show_dialog("雖然原因不明，但小憐姐姐現在絕對是正港的女孩子。","斯庫爾德")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("而且還軟軟的呢～","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("斯庫爾德露出一個調皮的笑容。")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("軟、軟的……？ 什麼啊！！","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("剛才她主動抱我，還把頭埋在我胸口，就是為了確認這些事嗎？")
	await novel_interface.show_text_only("而且那麼短的時間裡，連頭髮都檢查過了……")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("（感覺我回去又要被莉琉修理了！！）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("斯庫爾德抬起頭，清了清嗓子。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("那……我們算是彼此交換過祕密的朋友了，對嗎？","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她小心翼翼地問道，眼神期待著我的回覆。")
	await novel_interface.show_text_only("我的心臟忽然抽了一下，直覺告訴我這才是她卸下偽裝和防禦的樣子。")
	await novel_interface.show_text_only("她應該從小就生活在時時得懷疑和提防身邊所有人的環境吧？ 明明只是十二三歲的小女孩……")
	await novel_interface.show_text_only("雖然只是模糊的預言能力，但不知會被多少有心人覬覦。")
	await novel_interface.show_text_only("這個祕密一旦公開，她將面臨的處境可想而知。")
	await novel_interface.show_text_only("她卻選擇在可能被莉琉監聽的情況下，將這種能力告訴了我……")
	await novel_interface.show_text_only("如果可以，她應該很希望與人坦誠相待吧。")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("嗯，我會好好守護妳的祕密的。","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我伸出小拇指，做出「打勾勾」的手勢。")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("因為、因為我是妳「最特別」的那個人嘛！！","小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（這句台詞說出來簡直蠢、爆、了！）","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("斯庫爾德先是一愣，接著噗嗤一聲笑了出來。")
	await novel_interface.show_text_only("然後，我們兩人的小拇指就勾在一起了。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("愛衣走進酒吧，一眼就看到莉琉正坐在窗邊的沙發上，拿著一杯酒輕輕搖晃。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("原型機的「保險措施」已經照妳的要求配置好了。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("動作還挺快的嘛～","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("隨時檢查小憐迷走神經的反射，有異常就立刻切斷連結……這樣會不會太粗暴了？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("這樣也只能發揮「保險絲」的作用吧，畢竟現在科學對記憶的理解還是太少了。","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("也不知道會不會像那部電影裡所說，「一旦出現互相矛盾的記憶，大腦就會燒掉」之類的……","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣一臉躍躍欲試──")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("偷偷找幾十個傢伙做個試驗好了！","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉舉高酒杯，透過燈光端詳著其中的球形冰塊。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("我猜不會──","莉琉")
	await novel_interface.show_dialog("即使同時擁有兩套完全矛盾的記憶，人也會為自己找到一條出路。","莉琉")
	await novel_interface.show_dialog("像是用「前世記憶」或「平行宇宙」之類的說法來安慰自己，或者乾脆說自己受到了神諭。","莉琉")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("說不定還能騙來一群信徒呢～","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("說是這麼說啦～","愛衣")
	await novel_interface.show_dialog("但妳不是還特地要求播磨腦研的人不要刺激她的前額葉皮質，以確保阻斷記憶區嗎？","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("這樣她醒來之後就會像做夢一樣，很快就忘掉絕大部分的情報吧～","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉轉頭看著窗上模擬出來的城市夜景。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("法貝拉從小就是童子軍，被南美的軍閥收養。","莉琉")
	await novel_interface.show_dialog("有些情報她不一定能承受得了～","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("哦～？","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("話說，妳不是要斯庫爾德親自取得小憐的同意嗎，進展如何了？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("那個笨蛋不用五秒鐘就會被小丫頭征服吧～","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("真是簡單易懂的青春期呢……","愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("既然如此，那妳為什麼還多此一──","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("說到一半，愛衣恍然大悟。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("妳是要給小憐埋下一個記憶錨點？！","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉笑了笑，拿起酒杯小酌一口。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("有時候老方法可能更有效哦。","莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("妳真的太溺愛她了～","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("時間差不多了，我們走吧。","莉琉")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
