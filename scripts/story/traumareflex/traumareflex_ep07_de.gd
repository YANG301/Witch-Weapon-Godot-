# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("Der Moment, in dem die Welt untergeht?","Ren")
	await novel_interface.show_dialog("(Moment, hat diese Katastrophe die ganze Welt betroffen?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Aber schien es am nächsten Tag nicht allen gut zu gehen?")
	await novel_interface.show_text_only("Das Einzige, was „endete“, war mein...")
	await novel_interface.show_dialog("(Womit habe ich das verdient?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Aber in dieser Erinnerung bist du ein Junge.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("... Äh?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sind Sie also ein Junge, Miss Ren?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Äh... Ähm...\nÄh, ich...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Schlagzeilen wie „Männer-Crossdresses schleichen sich in die Krankenstation für Mädchen“ schießen mir durch den Kopf.")
	await novel_interface.show_text_only("Skuld kommt nur wenige Zentimeter näher und sieht unglaublich selbstgefällig aus, als hätte sie mich gerade dabei erwischt, etwas Illegales zu tun.")
	await novel_interface.show_text_only("Ich fühle mich in die Enge getrieben, wie ein Reh im Scheinwerferlicht.")
	await novel_interface.show_text_only("Unbewusst bedecke ich meine Brust, bewege mich nach hinten und versuche dann, auch meinen Rock festzuhalten ...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Ugh, dieser Rock ist wirklich zu kurz! Ich kriege ihn einfach nicht hin!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Äh, warte, warum bin ich so nervös?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ach, komm schon, ich bin ein Mädchen!\nHahaha...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sehe im Moment überhaupt nicht wie ein Junge aus. Skuld hätte mein jetziges Ich auf keinen Fall mit meiner ursprünglichen Identität in Verbindung bringen können.")
	await novel_interface.show_text_only("Außerdem hat Mariru viel getan, um meine Spuren zu verwischen. Nicht einmal der beste Geheimdienst könnte sagen, wer ich einmal war.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Aber diese Silhouette in den Ruinen von New Opulentia ... in meiner Erinnerung ist es definitiv ein Junge.","Skuld")
	await novel_interface.show_text_only("Skuld geht vor mir her und betrachtet mein Gesicht mit großer Verwirrung.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("Und nach einem weißen Lichtblitz sah ich dein Gesicht.","Skuld")
	await novel_interface.show_dialog("Es dauerte weniger als eine Sekunde, aber ich erinnere mich nie an etwas Falsches.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Du bist die Person in meinen Erinnerungen.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sitze da, mit dem Rücken an die Wand gedrückt, voller Angst vor der imposanten Aura dieses kleinen Mädchens.")
	await novel_interface.show_text_only("Kein Wunder, dass es in diesen klassischen Fantasy-Romanen nie mehr als zwei Propheten geben kann, egal wie groß die Welt ist. Der Autor weiß nicht, was er damit anfangen soll.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Diese Art von Fähigkeit ... es ist wie Betrug, nicht wahr?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Dennoch war es nur ein Fragment. Und Erinnerungen sind nicht immer zuverlässig.","Skuld")
	await novel_interface.show_dialog("Ich glaube, ich kann auch nicht sicher sein, ob du ein Junge oder ein Mädchen bist, allein aufgrund dieses flüchtigen Blicks in meinen Erinnerungen.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das blonde Mädchen gibt ein wenig nach und lässt mir etwas Luft zum Atmen.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Dennoch konnte ich es bestätigen, als du mich gerade umarmt hast. Dein Körper, deine Figur, deine Haare...","Skuld")
	await novel_interface.show_dialog("Ich weiß nicht warum, aber Miss Ren ist definitiv ein Mädchen, zumindest im Moment.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("Und sie fühlen sich... nett... an","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld grinst verschmitzt.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Sie?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hat sie ihr Gesicht an meiner Brust vergraben, weil sie bestätigen wollte, ob „sie“ echt waren?")
	await novel_interface.show_text_only("Und sie hat sogar meine Haare überprüft...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Ich wette, Mariru wird mich später ausschimpfen, weil ich so leicht auf der Hut war!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld hebt ihren Kopf und räuspert sich.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Wie auch immer... wir haben Geheimnisse ausgetauscht, also... sind wir jetzt Freunde, oder?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie fragt vorsichtig, erwartungsvoll.")
	await novel_interface.show_text_only("Mein Herz pocht. Mein Instinkt sagt mir, dass dies der wahre Skuld ist, unverhüllt und verletzlich.")
	await novel_interface.show_text_only("Sie muss in einer Welt ohne Vertrauen aufgewachsen sein. Sie ist noch so jung... kann nicht älter als dreizehn Jahre sein...")
	await novel_interface.show_text_only("Auch wenn ihre prophetischen Fähigkeiten nicht so stark sind, gibt es wahrscheinlich jede Menge Menschen, die sie gerne nutzen würden.")
	await novel_interface.show_text_only("Wenn ihr Geheimnis ans Licht kommt, ist sie ruiniert.")
	await novel_interface.show_text_only("Dennoch riskierte sie alles und erzählte es mir, obwohl ich durchaus überwacht werden und einen von Marirus Käfern tragen könnte ...")
	await novel_interface.show_text_only("Vielleicht wollte sie nur einen Freund, jemanden, zu dem sie ehrlich sein konnte.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Ja. Dein Geheimnis ist bei mir sicher.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich halte meinen kleinen Finger hoch.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Weil ich... „besonders“ für dich bin, oder?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wow, das ist so kitschig...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld starrt ihn an und bricht dann in Kichern aus.")
	await novel_interface.show_text_only("Wir versprechen es.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Als Aya die Bar betritt, entdeckt sie sofort Mariru auf der Couch am Fenster, wie sie sanft das Glas Wein in ihrer Hand schwenkt.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Die „Sicherheitsmaßnahmen“ für den Prototyp wurden nach Ihren Wünschen konfiguriert.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Ziemlich schnell, nicht wahr?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Sie wollten, dass ich die Stimulationen von Rens Vagusnerv im Auge behalte und sie sofort vom System trenne, wenn etwas Ungewöhnliches auftritt. Ist das nicht ein bisschen gewalttätig?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Es ist so etwas wie eine Sicherung. Schließlich wissen wir zumindest wissenschaftlich immer noch nicht viel darüber, wie Erinnerungen funktionieren.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Und wer weiß, ob es tatsächlich so ist, wie es in den Filmen heißt ... „Dein Gehirn wird gebraten, wenn widersprüchliche Erinnerungen auftauchen.“","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya scheint ziemlich aufgeregt zu sein, zuzusehen, wie jemandes Gehirn gebraten wird.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Wenn wir ein Experiment mit ein paar Dutzend zufällig ausgewählten Personen durchführen, wissen wir es, oder?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hebt ihr Glas und studiert im Licht der Beleuchtung die Form der Eiswürfel darin.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Nein...","Mariru")
	await novel_interface.show_dialog("Selbst wenn eine Person zwei Sätze völlig widersprüchlicher Erinnerungen besitzt, wird sie dennoch einen Weg finden, dies zu rationalisieren.","Mariru")
	await novel_interface.show_dialog("Zum Beispiel Erinnerungen aus einem früheren Leben oder einem Paralleluniversum. Oder vielleicht eine Art göttliche Offenbarung.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Wer weiß, mit dieser Art von Wissen können sie sogar einen Kult gründen.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Stimmt, aber...","Aya")
	await novel_interface.show_dialog("Aber haben Sie die Leute von Harima Tech nicht gebeten, ihren präfrontalen Kortex nicht zu stimulieren, um den Gedächtnisbereich in ihrem Gehirn abgeschnitten zu halten?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Sie möchten, dass sie die meisten Informationen, die sie hatte, nach dem Aufwachen vergisst, als wäre alles ein Traum ... richtig?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dreht sich um und blickt aus dem Fenster auf die virtuellen Lichter der Stadt.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella war als Kind Pfadfinderin. Sie wurde von einem Kriegsherrn in Südamerika erzogen.","Mariru")
	await novel_interface.show_dialog("Sie weiß viel zu viel, mehr als sie ertragen kann.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Oh?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Richtig, hast du Skuld nicht gesagt, er solle Ren davon überzeugen, diese Mission anzunehmen? Hat es funktioniert?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Natürlich. Dieser Idiot wird zu einem süßen Mädchen nicht nein sagen können.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("So einfach, so naiv. Ich beneide sie irgendwie.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Aber warten Sie, warum haben Sie in diesem Fall –","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya hält mitten im Satz inne, als ihr klar wird, dass sie bereits die Antwort auf ihre eigene Frage hat.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Du willst doch eine Art „Gedächtnisankerpunkt“ für Ren setzen, oder?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lächelt und nippt anmutig aus ihrem Glas.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Der direkte Weg ist immer der beste, oder?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Du verwöhnst sie wirklich, nicht wahr?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Äh. Es ist Zeit, lass uns gehen.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
