	await novel_interface.show_text_only("Fabella passa la sua mappa elettronica alla Vista Satellite, incuriosita dalla struttura topografica e dall'architettura della zona.")
	await novel_interface.show_text_only("È un'abitudine che aveva coltivato nella squadra operativa speciale.")
	novel_interface.show_character("fabiola_maid","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("skuld","normal",0.25)
	novel_interface.character_dark()
	await novel_interface.show_dialog("Strano. Una chiesa così grande, eppure non c’è nessun modello sulla mappa. Esiste una sorta di restrizione per edifici come questo in territorio internazionale?","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Probabilmente è perché la chiesa non era nemmeno stata aperta fino a poco tempo fa. Deve essere costruito per il Forum del mese prossimo. Vedere? I murali sembrano ancora nuovi.","Skuld")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tuo padre sarà qui il mese prossimo, giusto? Come membro del Comitato.","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Penso di sì. Comunque entriamo!","Skuld")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Entrando in chiesa è come entrare nel santuario più antico del mondo.")
	await novel_interface.show_text_only("Le pareti sono interamente di marmo. Colonne colossali si ergono cupamente. I dipinti ad olio sul soffitto a cupola e le circostanti finestre a mosaico colorate creano un'atmosfera di santità e pace.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Sbrigati! Aspetto! Aspetto! Questo posto è strutturato proprio come la Chiesa della Trinità!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("W-aspettami!","Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Skuld saltella qua e là, bevendo con gioia ogni dettaglio, mentre Fabella rimane vigile, tenendo aperto il cancello d'ingresso.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("(Ci sono ancora delle rastrelliere di legno laggiù sulle scale...)","Fabella")
	await novel_interface.show_dialog("(Questa chiesa deve essere ancora in costruzione.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella fa qualche passo avanti. L'aria intorno a lei vibra, quasi impercettibilmente, ma c'è. Tutti i suoi capelli sono ritti, come se fossero colpiti dall'elettricità statica.")
	await novel_interface.show_text_only("È sempre stata molto sensibile al pericolo, a causa degli anni della sua infanzia sui campi di battaglia in Sud America.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("(Aspetta... qualcosa non va...)","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("A pochi passi da Fabella, Skuld improvvisamente tace. Lei resta radicata sul posto, con le mani che cadono inerti lungo i fianchi.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Maledizione! Dobbiamo andarcene!","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass1.png")
	await novel_interface.show_text_only("In un attimo, la vista di Fabella si offusca. I colori dei vetri delle finestre, raffiguranti storie bibliche, sembrano brillare più luminosi, invadendo tutti i suoi sensi.")
	await novel_interface.show_text_only("I colori distorcono, torcono, affollano la sua visione come uno sciame di api.")
	await novel_interface.show_text_only("La luce arancione proveniente dal sole al tramonto all'esterno si contorce e si deforma, sciogliendosi gradualmente in un colore completamente diverso.")
	await novel_interface.show_text_only("Tutto sembra fondersi insieme, penetrando nel naso e nelle orecchie di Fabella, come un fruscio sinistro che si avvicina con una velocità allarmante.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella cerca disperatamente di concentrarsi.")
	await novel_interface.show_text_only("Non le schiarisce molto le idee, ma riesce ad aprire gli occhi con forza, solo per vedere che Skuld è crollato sul tappeto non molto lontano da lei.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Maledizione!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel momento in cui alza un piede, cercando di raggiungere la sua padroncina, le sue gambe cedono.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("...non riesco a vedere...","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass2.png")
	await novel_interface.show_text_only("Le finestre a mosaico si avvolgono e si contorcono, sempre più vicine, come un dipinto ad olio che si scioglie in un lampo di colori.")
	await novel_interface.show_text_only("Gli oggetti raffigurati nei dipinti a mosaico sembrano riorganizzarsi in posizioni bizzarre.")
	await novel_interface.show_text_only("Il corpo della cameriera ondeggia, l'incoscienza si avvicina rapidamente e la colorata invasione nella sua mente continua.")
	await novel_interface.show_text_only("La luce che penetra dalla finestra proietta ombre sul terreno, inghiottendo centimetro dopo centimetro gli ultimi sensi.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella si rannicchia all'improvviso, estrae un pugnale da dentro un pugnale.")
	await novel_interface.show_text_only("Essa mira ad un punto senza arterie principali, e senza un secondo di esitazione si pianta il pugnale nella coscia.")
	await novel_interface.show_text_only("Il sangue fresco tinge di rosso la pelle chiara della ragazza, ma almeno l'esplosione di dolore le regala qualche secondo di lucidità.")
