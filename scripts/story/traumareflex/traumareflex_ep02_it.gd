	await novel_interface.show_text_only("Lei si volta e fa qualche passo barcollante in avanti.")
	await novel_interface.show_text_only("Mirando all'ingresso principale, dove c'è ancora luce, lancia Skuld fuori dall'edificio con ciò che resta della sua forza di volontà prima che l'oscurità la colga.")
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Almeno adesso è al sicuro, pensa Fabella. Poi i suoi occhi si chiudono, cedendo finalmente all'ombra.")

	print("=== 创伤反射篇第02话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
