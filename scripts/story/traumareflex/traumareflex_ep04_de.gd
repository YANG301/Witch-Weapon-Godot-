# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Nun, komm zurück – nein, das ist nicht richtig ...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Willkommen zurück, M-Meister...","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Klingt immer noch komisch...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Wie auch immer...","Ren")
	await novel_interface.show_dialog("Warum muss ich einen Teilzeitjob in einem Dienstmädchencafé annehmen?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Was ist das denn für eine geheime Mission? Ich wette, Mariru will mich nur leiden sehen!")
	await novel_interface.show_text_only("Das Dienstmädchencafé im Botschaftsbereich ist in der Tat sehr beliebt und ich habe auch online Artikel darüber gelesen.")
	await novel_interface.show_text_only("Elegante Atmosphäre, tolles Essen, edles Besteck ... und nicht zuletzt sind die Zimmermädchen alle supersüß!")
	await novel_interface.show_text_only("Aber ich bin der Typ, dem es schnell peinlich ist, wenn ein Mädchen mich „Meister“ nennt, also bin ich nie hingegangen.")
	await novel_interface.show_text_only("Ich war damals so naiv...")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("Denn jetzt bin ich derjenige, der andere stattdessen „Meister“ nennt – und das ist noch peinlicher!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Und dieses Dienstmädchen-Outfit ist so unnötig kompliziert!)","Ren")
	await novel_interface.show_dialog("(Der Rock ist schon von Anfang an ziemlich kurz...)\n(Und jetzt, mit einer Krinoline zum Aufblähen, ist er sogar noch kürzer! Wie sollen sie von mir erwarten, dass ich laufe?)","Ren")
	await novel_interface.show_dialog("(Und Strumpfbänder... das ist das erste Mal, dass ich sie trage.)\n(Also der Verschluss... er geht an die Taille, oder?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich starre auf die weißen Spitzenstrumpfbänder an meinen Beinen.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(So sehen Strumpfbänder also aus der Ich-Perspektive aus...)\n(... Hm, ziemlich süß!)","Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Lass mich ein Foto machen. Niemand muss es wissen!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Klick!")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Ähm, lass mich noch etwas üben...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wenn ich gefeuert werde, bevor ich das Training überhaupt bestehen kann, würde Mariru mich wahrscheinlich zu Tode trampeln.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Willkommen zurück, Meister!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Was möchte der Meister, dass ich auf dein Omelett schreibe, Nyan?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ugh, das ist so peinlich!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Okay, lass es uns noch einmal versuchen ...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ah, es wird spät. Ich muss dieses lächerliche Outfit ausziehen und ins Bett gehen ...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Dieses Dienstmädchen-Outfit steht dir gut.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Ja! Du wirst eine so gute Magd abgeben!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich verlasse das Badezimmer und finde Mariru und Aya auf meiner Wohnungscouch vor, die unglaublich amüsiert aussehen.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Mariru? Und Aya auch?","Ren")
	await novel_interface.show_dialog("Wann... wann bist du hier angekommen?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Wir sind eigentlich schon eine Weile hier.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Also... mein Üben...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Wir haben natürlich alles gehört!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("Töte mich jetzt...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ach... überhaupt, was machst du hier?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Zu sehen, wie Sie sich als Dienstmädchen verkleiden und vor dem Spiegel all Ihre Fantasien ausleben, natürlich!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mussten Sie es so ausdrücken?\n(Obwohl sie sich nicht irrt, nehme ich an...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Es ist nicht meine Schuld, dass ich für die Undercover-Mission, die du mir gegeben hast, trainieren muss.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Glaubst du wirklich, dass du ein gutes Dienstmädchen wirst, wenn du nur ein paar Zeilen wiederholst? Es ist nicht so einfach, wissen Sie.","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Der Helikopter wartet auf dem Dach. Lass uns gehen.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä? Du hast eine Mission für mich? Um diese Zeit in der Nacht?\nGib mir einen Moment, ich muss mich hier umziehen ...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Es ist in Ordnung. Unser Ziel für diese Mission ist eigentlich auch ein Dienstmädchen, also passen Sie genau dazu.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Hat sie nur gegrinst? Das hat sie definitiv getan! Pfui!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Aber... dieses Outfit...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Wird kein Problem sein. Als Sie das letzte Mal auf das Ziel gestoßen sind, trugen Sie ebenfalls ein Dienstmädchen-Outfit.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Kommen Sie einfach mit und Sie werden sehen.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Wir drei fliegen mit dem Hubschrauber zu einer großen medizinischen Einrichtung, die derzeit halb leer ist, da der Großteil des Personals nach Hause gegangen ist.")
	await novel_interface.show_text_only("Im Gebäude herrscht Stille, bis auf das Surren der Maschinen im Hintergrund. Unsere Schritte hallen von den stillen, weiß getünchten Wänden wider.")
	await novel_interface.show_text_only("Es ist niemand in Sicht. Irgendwie wirken die hell erleuchteten Flure noch makaberer als die völlige Dunkelheit.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ist das... ein Krankenhaus?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich konnte erkennen, dass es sich hierbei um eine verdeckte Operation handelte, da die Hubschrauberpiloten beide mir bekannte Agenten waren.")
	await novel_interface.show_text_only("Mariru nimmt selbst selten an Missionen teil, aber es ist offensichtlich, dass sie dieses Mal sicherstellen möchte, dass es umso besser ist, je weniger Menschen davon erfahren.")
	await novel_interface.show_text_only("Mir fällt auch auf, dass alle Überwachungskameras hier so gedreht sind, dass sie auf die Wände gerichtet sind.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Dies ist die Abteilung für experimentelle Medikamente im Forschungszentrum von Harima Tech.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Die Identität unseres Ziels ist dieses Mal äußerst empfindlich. Die Mission ist streng geheim, nicht einmal der Senat darf davon erfahren.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Harima Tech ... gehört es aber nicht dem Senat?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während meiner SID-Ausbildung musste ich mir die Namen aller Organisationen merken, die ich meiden sollte. Harima Tech ist einer von ihnen.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Und war Dr. Bright hier nicht ein Forscher?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Oh, dieser Gorilla-Mann? Mittlerweile hat er sich selbstständig gemacht. Dieser Ort hat nichts mehr mit ihm zu tun.","Mariru")
	await novel_interface.show_dialog("Dies ist eine praktische Forschungsabteilung. SID bestellt viel bei dieser Art von Organisation.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Wir haben hier jede Menge Spezialausrüstung bestellt! Tatsächlich wurden die meisten Gebäude dieser Abteilung ausschließlich für ... gebaut.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Für Geld. Aya muss es nicht sagen.")
	await novel_interface.show_text_only("Ha, eine sehr... zuverlässige Käufer-Verkäufer-Beziehung, oder?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Unser Ziel heißt Fabella. Du hast sie einmal getroffen, damals in der Mission im Sky Hotel.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Sie ist das Dienstmädchen, das dich beiseite nahm und dich ausschimpfte, weil du ein Tollpatsch warst.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Oh, sie? Ich erinnere mich. Sie trug eine rotgeränderte Brille, oder? Und sie arbeitete für ein kleines Mädchen...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Das stimmt. Skurd Axelrod. Einzige Tochter eines hochrangigen Mitglieds des Second Academy City Committee.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Sie hat uns vor vier Stunden über den Waschsalon eine Nachricht geschickt.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Sie will also... ihr Volk verraten?","Ren")
	await novel_interface.show_dialog("(Ist Skuld nicht wirklich jung? Soweit ich mich erinnern kann, ist sie wahrscheinlich im gleichen Alter wie Elluka ...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Basierend auf dem, was Skuld uns erzählte, gelang es unserem Bergungsteam, Fabella bewusstlos in einer Kirche in der vereinbarten entmilitarisierten Zone zu finden.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Wir haben in ihrem Blut Lysergsäure-Diethylamid-Komplexverbindungen nachgewiesen. Auf dem Kirchengelände wurden auch Geräte zur Verteilung chemischer Aerosole in militärischer Qualität gefunden.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Halluzinogene chemische Waffen, nicht wahr? Ich verstehe, eine sehr einfallsreiche Methode, um die Feinde dazu zu bringen, sich gegenseitig anzugreifen.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("War es ein Terroranschlag?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Nein, eher wie eine Fliegenfalle.","Mariru")
	await novel_interface.show_dialog("Skuld hat es uns bereits erzählt. Fabella ist eine Hexe.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Hä?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jetzt verstehe ich irgendwie, warum sie mich gebeten haben, den ganzen Weg hierher um Mitternacht zu kommen.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Nachdem wir die Halluzinogene in Fabellas Körper neutralisiert haben, liegt sie immer noch im tiefen Koma ...","Aya")
	await novel_interface.show_dialog("Wir konnten sie nicht wecken, selbst nachdem wir ihr eine große Menge Levodopa injiziert hatten.","Aya")
	await novel_interface.show_dialog("Ihr Zellstoffwechsel schießt in die Höhe und ihre Körpertemperatur ... wir konnten sie nicht einmal dadurch kontrollieren, dass wir sie in Eiswasser tauchten.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Jeder normale Mensch hätte unter solchen Bedingungen die meisten seiner Organe verloren – aber ihr Körper scheint eine unglaubliche Toleranz gegenüber hohen Temperaturen zu haben.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Skuld erzählte uns, dass Fabella eine Feuerhexe ist. Von Feuermagie besessen.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Besessen?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dieser Begriff kommt mir seltsam vor.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Laut unserer Analyse der Daten, die wir derzeit gesammelt haben, können wir Magie als ein Feld betrachten, das „Informationen“ manipuliert.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fabella ist nicht wie Elluka, der elektrische Felder direkt steuern kann. Ihre Situation ist eher so, als ob „bestimmte mächtige Informationen“ beschlossen hätten, von ihr Besitz zu ergreifen.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Sie reden, als hätten Informationen einen eigenen Willen.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Das tun sie. Wenn eine Informationsfolge eine ausreichend hohe Dichte und einen ausreichend niedrigen Entropiewert aufweist, kann sie einen Willen erlangen.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Als Fabella das Bewusstsein verlor, begannen die „lebendigen Informationen“ ihren Körper zu übernehmen ...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In gewisser Weise erinnert es mich an den Nachrichtenartikel, in dem ein komatöser Besitzer von seinem eigenen Haustier gefressen wurde. Ich bekomme eine Gänsehaut, wenn ich nur daran denke.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Bald wurde mir klar, dass wir sie nicht wecken konnten, weil sie bereits „wach“ war.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Wir haben ihren Hippocampus und ihren präfrontalen Kortex gescannt, und beide waren mit der Arbeit beschäftigt, als würde sie sich an etwas erinnern.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Allerdings sendete ihr Hirnstamm keine wirksamen Reflexionssignale. Es ist, als würde etwas es blockieren.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ayas Worte kommen in Eile heraus. Sie klingt viel zu eifrig.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Und als wir ihr Gehirn mit einem Boltzmann-Sensor scannten, entdeckten wir Merkmale von Mutationen ...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Moment... du meinst, dass es Hexenkokons... in ihrem Gehirn gibt?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Bingo!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Also dachte ich, wir haben zufällig ein Gerät, mit dem wir uns sozusagen in das Gehirn von jemandem hacken können. Harima Tech entwickelt es schon seit einiger Zeit für SID.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Es ist nur ein Prototyp, aber es hat den Alpha-Test bereits bestanden.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Also bin ich jetzt deine Laborratte?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Du bist unser letzter Ausweg.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Wir haben bereits vier Agenten in Fabellas Gehirn geschickt, aber irgendetwas hat sie immer wieder „abgelehnt“.","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("Die Agenten beschrieben es als „eine endlose Mauer, die im Weg steht“.","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
