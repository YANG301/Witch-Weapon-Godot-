# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("――ドドォォーーンッッ！！！！！")
	await novel_interface.show_text_only("巨大な音と共に車の前部が荒々しく持ち上がり、\nその反動で俺は床へと叩き付けられた。")
	await novel_interface.show_text_only("異質物によって特殊補強されているため\n車体のダメージは軽微。\nだが、衝撃はそのまま車体内部へと伝わる。")
	await novel_interface.show_text_only("車体が転がると、まるで胃の半分を\n吐き出すかのような痙攣が腹部に襲い掛かった。")
	await novel_interface.show_text_only("そうか…この輸送車の装甲が無敵だとしても……\n\n走行不能の状態にさえすれば、\n結局は使い物にならなくなる……")
	await novel_interface.show_text_only("高価なくせに頭の悪い設計だな、この車──")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("……頭が痛い。")
	await novel_interface.show_text_only("……耳元でガンガンと音が鳴り、視線のピントが\n全く合わない。")
	await novel_interface.show_text_only("幸いにも着ていた戦術ジャケットには、\n非ニュートン流体が仕込まれていたみたいだ。\nおかげで身体がバラバラにならずに済んだ。")
	await novel_interface.show_text_only("誰が選んでくれた装備かは知らないけど、\n本当にありがとう……")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("（でも下はストッキングなんだよな……）\n\n（あッ！もう穴が開いたじゃんかッ！！）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バンッ！　バンッ！バンッ！バンッ────")
	await novel_interface.show_text_only("ファビオラが車内にある非常用脱出ボタンの\nガードカバーを拳で叩き割った。\nすると車の上部に装設されていた2本の爆導索が\n次々と爆発する。")
	await novel_interface.show_text_only("瞬間、横転した車の天井に大きな穴が開く。\n\n鼻を突く濃煙が火花と共に車内に押し寄せた。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("くそ……っ！　すぐに降りなさいっ！！！","ファビオラ")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("ごほっごほっ──\nおいっ！！ 新入りはまだ生きてるっ？","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("呆然としていた俺はファビオラに掴まれると、\nそのまま車外へと放り出された……")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("濃煙が俺の目に染み込み、涙が止まらない。\n\nあふれ出る涙で視界は完全に塞がれている。")
	await novel_interface.show_text_only("不注意にも二息ほど煙を吸ってしまい、\n気管を焼かれたような感覚がした……")
	await novel_interface.show_text_only("咳が止まらなくなり、息が全くできない。")
	await novel_interface.show_text_only("咽せながら身を丸くすると、\nふと自分の首から垂れ下るマスクに気付いた。\nすぐにマスクを手に取り、鼻にギュッと\n押さえ付ける。")
	await novel_interface.show_text_only("ふっ──")
	await novel_interface.show_text_only("…………")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("──播磨脳研、実験医療部門。")
	await novel_interface.show_text_only("マリルと愛衣がファビオラの現状を\n説明してくれた。\nこれから下の階で設備の調整に取り掛かるらしく\n俺はここで待機となった。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("2人とも……そのまま行っちゃったのか？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("夜中の誰もいない病院の廊下は、何とも言えない\n「圧迫感」がある。")
	await novel_interface.show_text_only("この場に似つかわしくないメイド服姿の俺は、\nとりあえず壁際の座席に座った。")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("何だかR指定のゾンビゲームみたいだ……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("どうしてゾンビなの？\n普通は幽霊じゃないかな～～？","？？？")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("アハハハ。そうだよな、ゾンビなんて──","レン")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("──はぇぇぇぇ……ッッッッ！！！！？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は驚いて椅子から飛び上がる。\n\n誰もいないはずの廊下から突如として、\n声が聞こえてきた。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("あら、ごめんなさい。ビックリさせちゃった？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("小柄な少女が廊下の角から顔を出した。")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("また……会えたねっ！　レンお姉ちゃ～ん！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……太陽のような髪に、編み込みのおさげが\n腰まで伸びていて……\n……彼女の発するオーラと雰囲気は、\n一度体験すれば忘れられない。")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("君は……スクルド？","レン")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（今、俺の事…お姉ちゃんって呼んだよな？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは少し恥ずかしがりながら笑顔で\n俺に近付いてきたが、\nその顔には焦燥と不安を浮かべていた。")
	await novel_interface.show_text_only("以前スカイホテルのパーティーで会った時の\n優雅な感じとは違う──")
	await novel_interface.show_text_only("ああ！\nそもそもファビオラは……彼女のメイドだ。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("これはマリルに頼まれた事なんだけど……\n\nでも、元々あたしは直接あなたに\n頼みたかったの……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は少し何かを言い淀んでいる。\n\n小さな身体を震わせ、熱くなる目から\n涙が零れないように我慢しているようだ。")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("どうかお願い……ファビオラを助けて……","スクルド")
	await novel_interface.show_dialog("あたしが彼女に、大使館を抜け出そうなんて\n言わなければ……","スクルド")
	await novel_interface.show_dialog("こ、こんなことになるなんて思わなかったの……","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("お、落ち着いて……っ！","レン")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("（ど、どどどどうしよう～～っ！？）\n\n（なんか泣き出しそうなんだけど！！）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("思わず手を伸ばして彼女を慰めようとした。\n\n真夜中の病院の廊下、ガーターベルトを履いて\nメイド服姿で少女を抱きしめようとする……\n……なんだこの状況は。")
	await novel_interface.show_text_only("宙に固まって動けない腕を、\nどの位置に持っていけばいいのか分からない。\nそんな俺の思考に追い打ちをかけるかのように、\n急に彼女の方から抱きしめてきた。")
	await novel_interface.show_text_only("柔らかな髪が俺の腕に触れると、ふんわりとした\nミルクの香りが鼻をくすぐる。\n急加速する心臓に思考が追い付かない──")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("（あぁぁぁぁち、小さいぃぃぃーーっ！！）\n\n（しかも可愛いぃぃ……っ！）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("見た目以上に彼女は小さく、俺の胸に顔を埋め\n小動物のように小刻みに震えている。")
	await novel_interface.show_text_only("さっき愛衣が説明していた、脳のリスクが潜入で\nなんだっけ？　\nハハッ！構うものかよッ──")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("お、俺が絶対助けるからッ！！\n安心してくれ！！","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ああっ、もう頭が働かない……！\n\nもし今、彼女に元老院を爆破せよって頼まれても\n二つ返事で引き受けてしまいそう……ッ！！")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("だ、大丈夫だ、俺がいるから……！！","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺って人を慰めるスキルが本当に皆無だ……\n\n大口を叩いた割には、俺に何ができるのかを\n実際には分かっていない。\nでも、場の雰囲気的に男ならこう言うでしょ？")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("……うん。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("胸元のスクルドが軽く頷いた。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("あなたなら、きっとできる……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("え？　俺、本当にできるの？")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("だってあなたは、あたしの記憶の中で……\n\n……最も特別な存在だから。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("うんうん……んんんっ？","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（俺のメイド姿って……）\n\n（そんなにも深い印象を与えていたのか？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは気分を落ち着かせたのか、\n涙を拭い確信に満ちたまなざしで俺を見つめる。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("──だから、あたしの秘密を全て教えるわ。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("思いも寄らない展開に、どう対応すれば良いのか\n分からない。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("信じられないかもしれないけど、\nまずはあたしの話を聞いて欲しいの。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女の口調が厳粛なものに変わった。\n\n俺も釣られて襟を正す。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("あたしには……とても特別な能力があるわ。","スクルド")
	await novel_interface.show_dialog("覚えているの。\n\n起きてない出来事というか、\n未来に起きる出来事といえばいいのか。\nそんな出来事をまるで記憶のようにあたしは\n持っている……","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("未来の……出来事……記憶？","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("そう。\n断片的で、見分けはつかないけどね。\n頭の中にそんな記憶があるだけで、\nどれが過去で、どれが未来なのか……","スクルド")
	await novel_interface.show_dialog("その記憶の光景を実際にこの目で見てから、\nようやく確信する事ができる。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("予言のような能力って事か？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ここ数か月間の出来事によってか、\nいつのまにか俺は不可解な事に対しても、\n「ひとまず受け入れる」耐性ができていた。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("例えば最近、\nこんなキャンディーを食べた覚えはない？\n甘過ぎず、ほど良い酸味があって\n口の中で溶けていく時は爽やかな感じがする。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("うーん、食べた事あるような気はするけど\n最近だったかな…正直良く覚えてないや……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("そう、そんな感じ！","スクルド")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("その食感と味はハッキリと覚えているのに、\nどこで何を食べたのかが思い出せない。","スクルド")
	await novel_interface.show_dialog("そしてある日、ふとした時に食べるタイミングが\n来て──\nようやく明確に「記憶の中にあるやつだ！」\nって事が分かるの。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("なんだか理解できたような気がする。\n起こるかもしれない出来事が頭にあるとして、\nふんわりとした記憶だけじゃ言い表す事さえ\n難しいのだろう。")
	await novel_interface.show_text_only("未来予知とは違い、未来か過去かすらも\n分からないのだから。")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("（待てよ……？）\n\n（それが遠い過去や未来の話ならどうだろう？）\n\n時代の流れで大きく景色や人は変わるし、\n断片な記憶でも、印象にさえ残っていれば──\nある程度は過去か未来かを判断できるかも？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そんな俺の考えを読み取ったかのように、\nスクルドは言葉を続ける。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("断片的な記憶から印象を感じた事を手掛かりに\n予測しようと私も思ったわ。","スクルド")
	await novel_interface.show_dialog("でも、記憶というのは録画とは違うの……\n\n主体となる部分しか正確じゃなくて、\n残りの細かい情報は脳が完璧に模写できない。","スクルド")
	await novel_interface.show_dialog("人間の記憶は、自分の脳内で再構築された\n元と似て非なるものを思い出すの。\nだから細かい部分は実際と違ったり、\nぼんやりだったりで……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ある映画で見たセリフを、ふと思い出した──")
	await novel_interface.show_text_only("「記憶は思い込みだ、記録じゃない」")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("結局あたしの記憶だけじゃ、時間軸を決定付ける\n痕跡が限りなく少ないわ。\nさらに厄介なのは──","スクルド")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("えっと、普通は特に理由もなく特定の何かを\n思い出そうとは思わないよね？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("うん？","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("嫌いな先生が教える数学の授業があるとして。\n\nその先生が黒板に何を書いていたかを、\n具体的に思い出そうとはしないよね……？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は黒板どころか、先生が口を開いた途端に\n記憶を失っていると思う。")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("確かに……不思議だ。","レン")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("でも待って！ 記憶の中での俺が特別！？\n特別って言うぐらいだから……\nまさか見たものって──","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは頷いた。")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("あたしの記憶の中で最も特別で、\n決して忘れてはいけないもの。\n最終的に起きてしまうと、\n唯一確信が持てる出来事があるの……","スクルド")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("俺は息を飲んだ。\n\n彼女が告げようとしている出来事の\n見当が付いたからだ。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("──それは『世界が終焉を迎えた時』の記憶。","スクルド")
	await novel_interface.show_dialog("でもその記憶では、あなたは男の子だった──","スクルド")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
