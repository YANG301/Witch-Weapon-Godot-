# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella sigue sentada sobre mí, en la sombra de algún objeto concreto.")
	await novel_interface.show_dialog("Sé cómo evitar que la lente refleje la luz.","Fabella")
	await novel_interface.show_text_only("Dice, mientras me inmoviliza en el suelo con una mano.")
	await novel_interface.show_dialog("¿Eh?\n(Espera, ¿qué va a hacer?)","Ren")
	await novel_interface.show_text_only("La mano izquierda de Fabella está en el suelo junto a mi cara, soportando su peso. Su rodilla derecha asoma entre mis piernas. Esa sonrisa en su rostro... siniestra.")
	await novel_interface.show_text_only("Luego baja su mano derecha y tira suavemente de mis medias de seda...")
	await novel_interface.show_dialog("Shh.","Fabella")
	await novel_interface.show_text_only("Incapaz de ver sus acciones desde mi ángulo, solo puedo imaginar lo que está haciendo desde lo que siento allí abajo.")
	await novel_interface.show_dialog("(No... por favor no...)\n(Por favor, por ahí no...)","Ren")
	await novel_interface.show_text_only("Mis mejillas arden, el corazón late locamente en mi caja torácica. Mis dedos luchan por agarrarse al suelo en una especie de reflejo.")
	await novel_interface.show_dialog("(No importa cómo lo mire, esto... no es ideal...)","Ren")
	await novel_interface.show_text_only("Fabella parece bastante satisfecha con mi expresión de pánico y nerviosismo. Quizás había querido darle una lección a este novato desde hacía algún tiempo.")
	await novel_interface.show_text_only("De repente, su agarre se aprieta y lo siguiente que sé es que me arrancan un agujero de las medias de seda.")
	await novel_interface.show_text_only("No puedo evitar llorar en el momento en que sucede.")
	await novel_interface.show_dialog("¡Ah!","Ren")
	await novel_interface.show_text_only("Escucho el sonido de alguien tragando saliva en mi auricular, seguido de Cassel tosiendo locamente.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Continuando desde la abertura, Fabella me quita un poco más la tela, luego me quita los zapatos y me quita lo que queda de las medias de las piernas.") #换行问题
	await novel_interface.show_text_only("Apenas puedo hablar por la vergüenza mientras ella me ayuda a ponerme los zapatos nuevamente.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Aw, vamos...)\n(Mis piernas están todas frías ahora...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, tienes piernas suaves.\nSin ningún músculo.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Jaja, ¿lo siento, supongo?")
	await novel_interface.show_text_only("Ni siquiera he recuperado la compostura todavía, pero Fabella ya ha vuelto a actuar de forma profesional, como la comandante que es.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Todos, recupérense.","Fabella")
	await novel_interface.show_dialog("Necesitamos un plan. Después de fijar la ubicación del francotirador, ¿cómo lo eliminamos?","Fabella") #换行问题
	await novel_interface.show_dialog("Creo que su trabajo es simplemente distraernos del verdadero campo de batalla que se encuentra allí...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella señala la sección de la carretera en llamas detrás de nosotros, donde se escuchan disparos rápidos.")
	await novel_interface.show_dialog("Hm... el dispositivo de aceleración electromagnética de corta distancia necesita alrededor de 4,5 segundos para cargarse.","Russel")
	await novel_interface.show_dialog("El dispositivo requiere una mira telescópica para calibrarse, por lo que incluso si el francotirador está usando una de esas armas que disparan varias balas a la vez, el equipo no les permitirá hacerlo.","Russel")
	await novel_interface.show_dialog("Debemos encontrar su ubicación después de que disparen una vez y eliminarlos antes de que puedan disparar una segunda vez.","Russel")
	await novel_interface.show_dialog("El problema es que nuestro rifle de francotirador todavía está en el maletero. ¿Y cómo hacemos para que nos disparen sin ponernos en peligro?","Cassel")
	await novel_interface.show_text_only("Fabella estudia la carretera en silencio con un reflector y nota la puerta de un automóvil perdido que cuelga de la parte trasera de un vehículo blindado derribado.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... Eso debe haberse caído durante la explosión.","Fabella")
	await novel_interface.show_dialog("¿Pueden encontrarme algunos datos sobre qué tan duradera es exactamente la armadura de Sustancia H en ese camión ridículamente caro nuestro?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Quieres decir... que quieres usarlo como escudo...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Probablemente será un buen escudo.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("¿Ah?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("Hay un video en línea de un multimillonario que usó ese tipo de vehículo en un experimento de tiro.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incluso cuando fue atacado por un Barretta M82A1 equipado con un dispositivo de aceleración estabilizador electromagnético, el camión no se vio afectado en lo más mínimo.")
	await novel_interface.show_text_only("Ese multimillonario solo estaba luciendo con sus fajos de billetes y su acento ruso. Pero no se puede negar que el vídeo fue popular.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Si crees que es seguro, lo haces.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("¿Eh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella palpa mi chaqueta de combate, como si buscara el lugar perfecto, y luego me golpea con el puño de la nada.")
	await novel_interface.show_text_only("Ese fue un golpe muy impresionante. Con solo mirarlo, estaba convencido de que me mataría en ese mismo momento. Pero lo único que sentí fue un ligero temblor en la parte superior de mi cuerpo.")
	await novel_interface.show_text_only("El fluido no newtoniano que llena mi camisa, aunque normalmente es suave, se endurece en el momento en que lo golpea cualquier fuerza.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Bonita chaqueta. Cuando levante la puerta del auto más tarde, recuerde inclinarse hacia ella y dejar que la chaqueta absorba el impacto en lugar de usar las manos.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Yo—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes de que pueda protestar, Fabella me pone una máscara en la boca.")
	await novel_interface.show_text_only("Luego saca una pistola que parece un juguete de su cinturón y apunta al techo del edificio de enfrente.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Bomba flash de seis segundos, lista...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Explosión!")
	await novel_interface.show_text_only("Un punto de luz ultrabrillante sale volando de la pistola, barriendo el hermoso cielo nocturno antes de finalmente caer.")
	await novel_interface.show_text_only("Fabella espera hasta que la mota haya bajado lo suficiente antes de arrastrarme en una carrera loca hacia el camión de transporte derribado, detrás del cual ambos nos escondemos.")
	await novel_interface.show_text_only("Cassel y Russel también nos siguen hasta un bloqueo cercano donde pueden vernos y comunicarse con nosotros.")
	await novel_interface.show_text_only("Fabella ingresa la contraseña en la puerta trasera del baúl y recupera un Scout liviano del estante de armas.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Éste es mejor para apuntar rápidamente.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, prepara el dron. Mantenlo detrás de la esquina del edificio para que el francotirador no pueda verlo. Sólo déjalo salir cuando esté lo suficientemente alto.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ordena Fabella, mientras arroja las medias de seda que arrancó de mis piernas a Cassel, envueltas alrededor de una piedra.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("¡Recién salido del horno!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel me mira mientras atrapa el objeto, luciendo un poco avergonzado, y hago todo lo posible para evitar su mirada, con el rostro sonrojado.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, mantén tus ojos en las imágenes transmitidas e infórmame.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Entendido.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella luego levanta la puerta del auto, revisa la armadura reflectante de Sustancia H con estampado de colmena y la empuja a mis brazos.")
	await novel_interface.show_text_only("Es más liviano de lo que pensé que sería. Podría levantarlo incluso con una mano.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(¿Pero por qué tengo que actuar como señuelo?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Aunque no es que sepa hacer nada más...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella me acerca y me susurra al oído:")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Escuche atentamente. Tan pronto como doy la orden, sales por ese lado con el humo denso, escondido detrás de esta puerta.","Fabella")
	await novel_interface.show_dialog("El francotirador debe estar entre los pisos treinta y cincuenta. Mantente cubierto, no dejes que te vean el trasero ni nada...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("O sino ya no tendrás trasero.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella me empuja hacia el humo justo después de terminar de hablar y me hace un gesto para que espere allí.")
	await novel_interface.show_text_only("Mientras tanto, Cassel ya cubrió la lente de la cámara con las medias y envió el dron a unos diez pisos de altura, oculto en las sombras.")
	await novel_interface.show_text_only("La capa refractaria de luz del dron le permite integrarse perfectamente en su entorno. Nadie podría decir que está allí a menos que miren con mucho, mucho cuidado.")
	await novel_interface.show_text_only("Cassel y Russel dan el visto bueno y Fabella carga el rifle de francotirador en sus manos. Ella me saluda con la cabeza—")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Tengo que afrontarlo…","Ren")
	await novel_interface.show_dialog("(Aya dijo que estaré bien incluso si \"muero\"...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Espera, ¿no dijo que sería un simple observador y que no podría interactuar con el entorno?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En mi momento de vacilación, algo me toca el trasero. Es Fabella con su arma. Parece que está lista para volarme la cabeza si no empiezo a moverme pronto.")
	await novel_interface.show_text_only("Suspiro, avanzando de mal humor fuera del humo, escondido detrás de la puerta del auto.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(Será mejor que ese tipo multimillonario no haya usado accesorios falsos cuando hizo ese video...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sigo avanzando, hasta estar a cinco o seis pasos del denso humo.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(... ¿Nadie me está disparando?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El francotirador debería poder verme fácilmente. ¿Podrían darse cuenta de que soy un señuelo?")
	await novel_interface.show_text_only("De repente, el sonido de pasos viene desde atrás. Desde el perímetro de mi visión, Fabella se desliza con gracia hacia mi vista y termina en una posición medio agachada a mis pies.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—¿Q-qué?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("¡Cúbreme!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Algo choca contra la puerta que estoy sosteniendo con un fuerte golpe. La fuerza devastadora me hace tambalear hacia atrás, haciéndome perder el equilibrio.") #文字错误
	await novel_interface.show_text_only("Aterrizo sobre mi trasero, con la puerta abierta a un lado. Fabella y yo somos blancos fáciles y completamente abiertos.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(¡Ay no!)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡En el piso cuarenta y dos! ¡Tercera ventana desde la derecha! ¡Tienen la guía láser puesta!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fue entonces cuando nuestro dron, oculto en el oscuro cielo nocturno, dispara un láser rojo a la ventana del edificio de enfrente.")
	await novel_interface.show_text_only("¡Explosión!")
	await novel_interface.show_text_only("¡Explosión! ¡Estallido!")
	await novel_interface.show_text_only("Fabella dispara, tres veces seguidas.")
	await novel_interface.show_text_only("Luego silencio, un silencio sin vida que induce a la desesperación. Prácticamente puedo oír mi corazón bombeando sangre hacia mi cerebro.")
	await novel_interface.show_text_only("Pasan segundo tras segundo. Contengo la respiración, imaginándome siendo despedazado por un rayo de luz.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Objetivo eliminado. Repito, ¡objetivo eliminado!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("¡Jajaja!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡Bien hecho!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En lugar de celebrar, Fabella continúa arrodillada en la misma posición, con el arma lista.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Shh, silencio. ¿Escuchan ustedes...?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esforzando mis oídos, me doy cuenta de que efectivamente puedo escuchar un helicóptero acercándose.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¿Qué es eso... un VTOL?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡Maldita sea! ¡Es un jilguero!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("¿Qué? ¿Un jilguero, aquí? ¿Centro?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un Siskin es un tipo de helicóptero militar no tripulado, desarrollado en Masada Ford durante la Guerra de los Siete Años.")
	await novel_interface.show_text_only("Es conocido por llevar doce misiles antitanque, lo que lo hace perfecto para campañas de aniquilación.")
	await novel_interface.show_text_only("La parca rayada amarilla y negra aparece desde el cielo y aterriza entre nosotros y el edificio de enfrente.")
	await novel_interface.show_text_only("Ahí es cuando me doy cuenta, bueno, estamos acabados.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
