	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Muoviti!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Bum!")
	await novel_interface.show_text_only("Riusciamo a malapena a disperderci prima che un gigantesco oggetto nero precipiti dal cielo, atterrando nel punto esatto in cui sono puntati i riflettori.")
	await novel_interface.show_text_only("In mezzo alla nuvola di polvere e all'asfalto frantumato, sentiamo il rumore minaccioso dell'attrito metallico e del ronzio dei giunti meccanici.")
