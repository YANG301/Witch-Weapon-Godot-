	await novel_interface.hide_character()
	await novel_interface.show_text_only("La trama della carta sembra assomigliare a una specie di tessuto. Su di esso ci sono innumerevoli rune non identificabili, insieme a illustrazioni molto simili a braccia di polpo.")
