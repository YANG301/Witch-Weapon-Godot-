	await novel_interface.show_dialog("C-che diavolo è quello?","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Big_Spider.png")
	await novel_interface.show_text_only("Fabella ci ha avvertito che il nemico avrebbe potuto inviare una sorta di esercito di robot, ma di certo non mi aspettavo questo.")
	await novel_interface.show_text_only("Ha otto gambe agili, affilate e appuntite, che sostengono un corpo gigantesco che continua a emettere rumori meccanici.")
	await novel_interface.show_text_only("...Un ragno robot in lega, alto quasi un metro. Dotato di punte su ogni gamba che possono facilmente perforare il corpo umano.")
	await novel_interface.show_text_only("Il micidiale predatore robot ci studia con gli occhi rossi lampeggianti sulla sua “testa”.")
	await novel_interface.show_dialog("Mi stai prendendo in giro...","Rina")
