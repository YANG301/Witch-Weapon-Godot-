	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Quindi... quei ragazzi... forse stanno cercando questa pergamena?","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Ma un Lucherino costa già più di 20 milioni. A meno che questa pergamena non contenga qualche messaggio nascosto davvero importante, non ne vale la pena.","Russel")
