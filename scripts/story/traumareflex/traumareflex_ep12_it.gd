	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Non dovresti indossare guanti o qualcosa del genere prima di toccarlo?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Va bene, è coperto con uno strato di spray ermetico.","Skuld")
