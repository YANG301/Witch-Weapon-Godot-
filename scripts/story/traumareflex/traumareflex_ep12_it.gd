	novel_interface.show_character("skuld")
	await novel_interface.show_dialog("Messaggio nascosto?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld tiene il manoscritto in aria, studiandolo sotto i riflettori dell'edificio di fronte.")
