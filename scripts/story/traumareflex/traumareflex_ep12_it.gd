	await novel_interface.show_dialog("Ma quel moccioso viziato non ha deciso su quale macchina entrare solo dopo la fine dell'asta?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("Ciò significa che... uno di noi potrebbe aver fatto trapelare l'informazione.","Pernard")
