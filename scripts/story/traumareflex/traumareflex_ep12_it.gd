	await novel_interface.show_dialog("(Potrebbe conoscermi a causa delle sue speciali capacità profetiche?)","Ren")
	await novel_interface.show_dialog("(Skuld ha detto che si ricordava di avermi visto nei suoi ricordi...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
