# traumareflex_ep12.gd - 创伤反射篇第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第12话剧本
	traumareflex_ep12_script()

func play_script():
	pass

# 创伤反射篇第12话 - 正式剧本
func traumareflex_ep12_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("こんにちは、レンお姉ちゃんっ。","スクルド")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("また会えたね～～っ。","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("え？　スクル──","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は違和感を感じ取り、言いかけた言葉を\n飲み込んだ。")
	await novel_interface.show_text_only("ここはファビオラの2年前の記憶であり、\nまだ俺とスクルドは会った事がないはずだ。")
	novel_interface.show_character("ren_mercenary","stare")
	await novel_interface.show_dialog("（もしかして、彼女の能力によるものか？）","レン")
	await novel_interface.show_dialog("（スクルドは確か……）\n\n（記憶の中で俺を見た事があるって……）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("あの……あなたがファビオラさんでしょ？\n\nそれにラッセルさんと、キャセールさん。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは他の小隊員に向き直り、\n無邪気な顔で話す。") #换行问题
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("おお？　私達護衛の名前まで覚えているの？\n流石あのお偉いさんとこの娘だね～～！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("（あはは……俺の考えすぎだったようだ……）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("やあやあ、どうもどうもっ！！\n写真より実物の方が可愛、ゴホォッ――！？","キャセール")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラッセルがボディーブローを打ち込んで、\nキャセールの発言を中断させた。")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("お前はちょっと黙っとけ。\n\nさっきのオークション会場でやたらと見ていた\nだろうが。","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドはキャセールの様子に、堪えきれず\n笑ってしまった。\n戦いで張りつめていた隊員達の雰囲気も\n少しだけ和らいだ。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("──全員聞け。\n支援部隊は今、街の外周で足止めを受けている。\n俺達は撤退ポイントに自力で到達せねばならん。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("私達は今からべルナドット隊長の指揮下に\n入るわ。","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラはべルナドットに頷くと、\nライフルマガジンをいくつか渡した。\nそして、散弾銃へと武器を持ち換える。")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("（信頼が築かれている感じ……）\n\n（……2人は昔からの仲間なのかな？）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("今後も戦闘に遭遇する可能性は非常に高い。\n\n今から5分の間、各員は装備のメンテナンスと\n残弾の確認をしろ。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("実はさっき、俺はこっそりチェックしていた。\nショルダーバッグにはマガジンが3つあった他。\n小型救急セット1つにエアロゲルスプレーが\n1缶入っていた。")
	await novel_interface.show_text_only("エアロゲルスプレーの外見はヘアスプレーと\nほぼ同じ。\n噴出すると泡が出て、空気に触れると急速に\n膨張し凝固する。")
	await novel_interface.show_text_only("以前にスカイホテルで、アニーがエアロゲルを\n使って客室のドアを封鎖したことがある。")
	await novel_interface.show_dialog("（俺、なんでこんなもの持ってんだろう……）","レン")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("隊員達が装備を点検している間、ファビオラが\nべルナドットを道路の向こう側へ連れて行った。") #换行问题
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("今回の敵は明らかに綿密な計画を立てているわ。","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("そうだな。\n奴らは事前に俺達の護衛ルートを把握していた。\nしかも偽の情報を流して、民衆を避難させる\nタイミングも緻密にコントロールしてやがる。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("つまり……オークションの進捗状況すらも\n把握してたって事？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("道が爆破された後、そっちの部隊は何人の敵と\n遭遇したんだ？","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("スナイパー1人と『イエローヘッド』1機ね。\nそっちは？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("スナイパー3人と、\n自動武器を搭載した無人機が4機だ。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラはべルナドットのコートにつく血痕に\n気付き、少し緊張を露にした口調で尋ねる。")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("そんなに敵が……ッ！？怪我は大丈夫なの……？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("こんなもん、かすり傷だ。\nリナの銃の腕は申し分ねえからな。\nスナイパーは1人残らず蹴散らした。","ベルナドット")
	await novel_interface.show_dialog("この辺りはビルが密集している市街地だ、\nスナイパーはあらかじめ位置に着く必要がある。\nつまり……相手はアルファ隊の車に\n『荷物』があると知っていたな。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラは息を飲む──")
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("でも、どの車に乗るかは、あのお嬢様が\nオークション会場を出てから決めたでしょ？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("──俺達の中に、裏切り者がいるかもしれねえ。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("べルナドットとファビオラは、お嬢様を囲んで\n談笑する4人の隊員にひっそりと視線を向ける。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("相手方の行動の狙いは彼女。\nしかし、目的は彼女を殺す事じゃねえようだ。","ベルナドット")
	await novel_interface.show_dialog("殺すチャンスはいくらでもあったんだ。\nなのに奴らは俺達を先に殺そうとしていた。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("……誘拐が目的？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("それなら地上部隊を展開するだろう。\nそれに、有人の兵器を出してくるはずだ。","ベルナドット")
	await novel_interface.show_dialog("ともかくここからは視野の広い場所を可能な\n限り避け、建物の陰に隠れながら進むとしよう。","ベルナドット") #原文多字
	await novel_interface.show_dialog("お前は自分を守れ。","ベルナドット")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("ええ……あなたもね。","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一方、俺は3人とスクルドが今夜のオークション\nについて話し合っているのを聞いていた。")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("今日落札していたあの古文書って、\n3600万もすんのかよ？","キャセール")
	await novel_interface.show_dialog("たかが黄ばんだ一枚の紙じゃねえか……\n未来のロト番号が10回分書いてあんのか？","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("そんなに驚く事じゃない。\n文化財の価値は、お前に分かるもんじゃねえよ。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","pleased")
	await novel_interface.show_dialog("あたしも文化財ってあまり詳しく知らないの。\nでも強烈に「買うべき」って予感がして……","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("おお！　俺がGT-Rを見る時と同じ感覚だな！","キャセール")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("キャセールは「分かるわそれ」っていう\n様子を見せている。")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("（絶対分かってないぞ……っ！）\n\n（スクルドの感覚は能力だろうからな……）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("戦時中、多くの古文書が流出したって話ね。\n\nこの間もアルキメデスの原稿が何千万もの値段で\n落札されたわ。","リナ")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("ならこいつは？","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("放射性炭素年代測定によれば、\n1000年前以上の歴史があるみたい。\n古代文字で書かれたレシピみたいで、\nあたしも読めないの……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言うと、スクルドが黒いワニ革でできた\nフォルダから、1枚の黄ばんだ紙を取り出した。")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("（そのまま取り出しちゃったッ！？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("黄ばんだ紙には織物のような紋様があり、奇妙な\n文字とタコの触手のような絵も描かれている。")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("これってパピルス？　\n\nいえ違うわ……1000年前のものにしては\n保存状態が良すぎる。","リナ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("て、手袋とか着けなくていいの？","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("大丈夫よ。表面を空気遮断スプレーで\nコーティングしてあるからね～～","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("ほほぅ、3600万もするレシピか……\nどんな料理が載っているんだろうな……","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("ラッセル。お前のお袋にこのレシピの内容を\n教えてやれよ。\nこの前なんて、危うく入院するところだったぜ。","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("ったく、ぬかしやがる。\nお前が鍋ごと食っちまうからだろ。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("あのさぁ……\nあいつらって、これが狙いじゃねえよな？","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("『イエローヘッド』を1機作成するに\n2000万ちょっとだ。\nこれに価値のある情報が隠されているのなら……","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld")
	await novel_interface.show_dialog("──隠された情報？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは原稿を高く持ち上げ向かいのビルから\n照射されているサーチライトを使って観察する。")
	await novel_interface.show_text_only("3人もスクルドを取り囲んで確認しているので、\n好奇心に抗えず俺も覗いてみる。")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("う～～ん……","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("特に……","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("何かがあるようには見えないわね？","リナ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…………")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("えーとっ、何かがあるというか……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺達がこのストリートに着いてから、\n少しおかしいと思っていた事がある。")
	await novel_interface.show_text_only("この辺りにはクラブやバーとか、\nたくさんの広告灯があるけど……")
	novel_interface.show_character("ren_mercenary","worry")
	await novel_interface.show_dialog("どうして、あのサーチライトはこの場所を\n照らしてるんだ？\nここには広告も置いないし……\n店の入り口もないのに……","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("……そういえば……だな。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("はやくッ──！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("道路を挟んでファビオラは俺達に向かって\n大声で叫んだ。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("避けてッッ！！！！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("ドゴオオォォォーーンッッッ！！！！")
	await novel_interface.show_text_only("ファビオラの声を聴き、俺達は即座にその場を\n離れる。\n次の瞬間、サーチライトが照らす地面に、\n空から巨大な黒い影が降ってきた。")
	await novel_interface.show_text_only("衝撃で割れた地面から土埃が舞い上がる中、\n\n不吉な金属の摩擦音と機械関節の回転音が\n聞こえてくる。")
	await novel_interface.show_text_only("淡い青色に輝く1本の金属の先端が、\nまず土煙の中から姿を現した。")
	await novel_interface.show_text_only("続いて滑らかな機械の腕、その巨体を支える\n分厚い関節が露になる。")
	await novel_interface.show_dialog("アレは……なんだッ！？","レン")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Big_Spider.png")
	await novel_interface.show_text_only("敵に機械部隊が存在する可能性があると\nファビオラからの警告は聞いていた。\nだがその全容は、俺の想像を遥かに超えていた。")
	await novel_interface.show_text_only("8本の鋭く尖った金属製の「脚」が、\nしなやかな動きを見せて\n機械的な異音を発する「体」を支えている。")
	await novel_interface.show_text_only("蜘蛛を象った合金製のロボットだろう。\n\n全高１メートル程はある「脚」は\n人類の身体を貫く事ぐらい容易いと想像できる。")
	await novel_interface.show_text_only("殺戮の気配を惜しみなく放つ機械の捕食者が、\n頭部の赤い部分を点滅させて、俺達を凝視する。")
	await novel_interface.show_dialog("冗談でしょ……","リナ")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("ファビオラとべルナドットは手に持つ武器を\n即座に構え、射撃を開始する。")
	await novel_interface.show_text_only("大量の弾丸がロボットの合金装甲に跳ね返され、\n火花が飛び散った。")
	await novel_interface.show_text_only("機械の蜘蛛はダメージを全く受けてないようで、\n身体を揺り動かすとファビオラの方を向いた。\nそして凄まじいスピードで彼女に飛びかかる。")
	await novel_interface.show_text_only("べルナドットは片側に退き、ファビオラは\nスライディングで蜘蛛の股下を抜けて行く。")
	await novel_interface.show_text_only("続けて俺の背後から驚くほど大きな音が響いた。\n\nリナもライフルを構えて攻撃に参加したのだ。")
	await novel_interface.show_text_only("リナの放つ銃弾で、蜘蛛の脚が一瞬よろめいた。\n\nしかし対物ライフルを以てしても、\n合金装甲には小さな跡を残す事しかできない。")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("（どうすれば……）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("エアロゲルで……？\nダメだ、きっと噴き終わる前に串刺しにされる。")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("（は、早く、考えるんだ……）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ロボットの次の標的はべルナドットだった。\n\n彼は道端に停まっていたワゴン車の窓に\n身体を翻して飛び込んだ。")
	await novel_interface.show_text_only("しかしワゴン車の厚さなど怪物の前では\n安全な遮蔽物にはならない。\n機械の蜘蛛はすぐさま駆け付けて\n車体のドアを軽々とぶち壊した。")
	await novel_interface.show_text_only("隙を見て彼は外へと転がり出て、追撃を受ける\n直前に地面に落ちたドアを担ぎ構えた。")
	await novel_interface.show_text_only("ドアを貫いた蜘蛛の脚は自分で空けた穴に挟まり\n動き辛そうにしている。\nべルナドットは地面に押さえつけられながらも、\n必死にドアの位置を固定しようとしていた。")
	novel_interface.show_character("ren_mercenary","shout")
	await novel_interface.show_dialog("やってみるしかないッ！！","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺はイチかバチかエアロゲルスプレーを\n機械の蜘蛛に向かって投げ付けた。")
	await novel_interface.show_text_only("同時に持っていたVectorを構えて、\n射撃スイッチを連射モードに切り替える。\n空中を飛んでいくスプレー缶に向けて\n思いっきり引き金を引いた──")

	print("=== 创伤反射篇第12话结束 ===")

