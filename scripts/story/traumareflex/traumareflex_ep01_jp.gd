# traumareflex_ep01.gd - 创伤反射篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第01话剧本
	traumareflex_ep01_script()

func play_script():
	pass

# 创伤反射篇第01话 - 正式剧本
func traumareflex_ep01_script():
	novel_interface.show_background("res://assets/images/bg/Fabiola/Brain.png")
	await novel_interface.show_text_only("『病態失認』とは────")
	await novel_interface.show_text_only("自分が何らかの感覚を失っていたとしても、\n全くそれを認識できない状態を指している。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	await novel_interface.show_text_only("失明しているのに視覚に支障はないと信じ、\n\n想像上での光景を、まるで本当に見えているかの\nように話す。")
	await novel_interface.show_text_only("例え半身不随を患ったとしても、身体の動作は\n正常であると信じてしまう。\nそのうえ、視界に映る他の正常な人間を見ても、\n自分と同じ動作を行っているのだと思い込む……")
	await novel_interface.show_text_only("このような現象を、臨床研究では\n『アントン症候群』と呼んでいる。")
	await novel_interface.show_text_only("矛盾した現象を合理的に解釈するために、\n「脳」は虚実のイメージを作り続ける。")
	await novel_interface.show_text_only("これは人間に備わる1つの原始本能なのかも\nしれない──")
	await novel_interface.show_text_only("遺伝子に刻まれた……未知の物事に直面した時に\n起きる太古の自己防御メカニズム。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…………")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	await novel_interface.show_text_only("──頭痛がする。")
	await novel_interface.show_text_only("──猛烈な頭痛だ。")
	await novel_interface.show_text_only("誰かが脳にセメントを流し込んで、\nじわじわとかき混ぜているかのようだ……")
	await novel_interface.show_text_only("頭の中にガンガンと響き、激しい耳鳴りが\n俺を襲う。")
	await novel_interface.show_text_only("俺…………成功しているのか？")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur.png")
	await novel_interface.show_text_only("俺はゆっくりと目を開けた。\n\n少しずつ瞳孔が周囲の光に適応し始める。")
	await novel_interface.show_text_only("声と音は全て、遠い向こうに仕切りでも\nあるかのように聞こえてはっきりしない。\n──耳の適応は遅れているようだ。")
	await novel_interface.show_text_only("──嗅覚は……空気中にコロンの匂いと、\n皮革と黄銅特有の錆の匂いを感じる……")
	await novel_interface.show_text_only("見渡すとそこは重厚な装甲に包まれた狭い空間で\n2列の座席が向かい合わせに並んでいた。\n座っている人達が笑顔で談笑している様子を\nうかがえる。")
	await novel_interface.show_text_only("彼ら全員のユニフォームは統一されていない。\n\nしかし、お互いが敵味方を見分けられるように、\n光を帯びた円形装置を身に着けていた。")
	await novel_interface.show_text_only("これは第二学園都市情報機関……\n\n『パランティア』に所属する特殊攻撃部隊の\n装備の特徴だ。")
	await novel_interface.show_text_only("もしかして……F-950 SWAT TRUCKの中に\n俺は今いるのか？？")
	await novel_interface.show_text_only("数年前、この装甲兵員輸送車を高額で購入した\n成金野郎が内部をド派手なクラブ風に改装した。")
	await novel_interface.show_text_only("車体を様々な武器で攻撃させつつ、\nビクともしない車内で数人の美女と戯れる。\n優雅にシャンパンを飲む姿は、自慢の仕方が\n間違ってると思わず言いたくなる感じだった。")
	await novel_interface.show_text_only("そんな映像だけに、ネット上でしばらくの間\nトレンドとなっていた。\nかくして異質物で強化された装甲兵員輸送車は\nその名を色々な意味で世界中に轟かせたのだ。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/NewMoridas.png")
	await novel_interface.show_text_only("車体上部に設置されたカメラは、リアルタイムで\n捉えた映像を車内のスクリーンに映している。")
	await novel_interface.show_text_only("夜空の下──\n輝くネオンに包まれた煌びやかな大都市。\n建造中の摩天楼が、視認できる範囲でも\n数多く立ち並んでいた。")
	await novel_interface.show_text_only("裸の鉄筋鉄骨は天に向かって突き出し、\n人々の野心を赤裸々に物語っているかのようだ。")
	await novel_interface.show_text_only("密集した高層建造群の遥か向こうには、\n闇夜の中に見え隠れする『ブラックゾーン』\n海面に巨大な黒い半球状の「何か」が\n浮んでいる。")
	await novel_interface.show_text_only("そんな未知なる存在が間近にあろうとも\n『十七紳士理事会』の管理下でこの学園都市は、\n戦前における世界経済と金融の中心的地位を\n受け継ぎ、過去に勝る繁栄を手にしていた。")
	await novel_interface.show_text_only("そう、それこそが栄えある『第二学園都市』\n\n────ニューモリダスである。")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("数時間前──")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("えーと、つまりはこういう事か？\n「ターゲットの脳内に潜入して記憶を読み取れ」","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("簡単に言えばそうだ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("待て待て、そんな事が本当にできるのかよ？","レン")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("脳に直結できる装置なんて……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("どっかのサーバーにアクセスするとか、\n人間の脳内に入るとか……")
	await novel_interface.show_text_only("俺がこれまでに見てきたアニメや映画の知識を\n総動員すると……\nこんな感じの装置って非常にヤバイ設定ばかり\nだったはず！！")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("まぁまぁ……落ち着きなさいな。","愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("これは播磨脳研が提供してくれた試験型装置で、\n元々は情報収集用（拷問）に設計された物だから\n基本的に問題はないはずよ。","愛衣")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("しかも！今回は私自らの手で、安全装置を\nアップグレードしておいたから\n脳内での傷害や死によって何かの影響が\n現実の身体に及ぶ事なんて絶対にありえないわ。","愛衣")
	await novel_interface.show_dialog("6時間接続し続けると自動的に目覚めるようにも\n設定してあるし、安全性の高さは保証するよ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("そ、そうか……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣の自信満々な表情を見て、俺は少しだけ\n安心した。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("いいか？　接続中、お前は実体を持たない\n純然たる観察者となる。\n幽霊のようなモノと言えば分かりやすいだろう。","マリル")
	await novel_interface.show_dialog("接続した記憶の中に埋まっている情報を\nできるだけ探し出し、\n細部に至っても見逃さないようにしろ。","マリル")
	await novel_interface.show_dialog("ターゲットは現在、深い昏睡状態にある。\n\n私達は彼女の生い立ちを良く知らない上、どんな\n記憶の中に閉じ込められているかも分からない。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("つまり！\n例えターゲットがお風呂に入っていたとしても！\nその細部まで見逃してはいけないって事よ！！","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("なっ、なんだそれ！\n俺は覗き魔なんかになりたくないぞっ！","レン")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("でも、まあ……\n見なきゃいけないのなら見るけど……","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("に……任務だし……","レン")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("大丈夫！ その気持ち分かる！","愛衣")
	await novel_interface.show_dialog("でもこの装置だと神経に刺激を送れないから、\n残念だけど触れる事はできないのよね……","愛衣")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そう言って愛衣は顔を赤らめながら、\n自らを抱きしめる素振りをしている。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("お、お、俺は別にそんな事！\nやりたいわけじゃない！！","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは手にしていた紙を丸め、\n「バチコンッ」と愛衣の頭を叩いた。")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("俺は現在、順調にターゲットの記憶へと\n潜り込めているようだ。")
	await novel_interface.show_text_only("最初はFPSゲームのような視点になるのかと\n思っていたけど。")
	await novel_interface.show_text_only("実際はそれよりも複雑で──")
	await novel_interface.show_text_only("記憶の中でも細やかな部分というのは、\nそのほとんどがぼやけている。\n注視するだけでも非常に苦労する感じだった。")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("今、車内には体格の良い男が何人か座っている。\n\n俺は頑張って彼らの言葉を聞き取ろうと\n耳を澄ませた……")
	await novel_interface.show_dialog("連合議会が停戦を宣告してから1年以上経つが、\n6つの加盟国以外の地域は、\n相変わらずクソったれだ……","男の声A")
	await novel_interface.show_dialog("6か国の首脳が『国際平和フォーラム』を\n開いてるってのに──\n中央通りの向こうじゃ羽虫のような\nデモの大群で埋まってやがる。","男の声A")
	await novel_interface.show_text_only("コックピットの助手席から掠れた男の声が\n聞こえたが、今の視界だと姿が確認できない。")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("平和フォーラムは今回で2回目になるのか？\n相変わらず役に立たん。","男性B")
	await novel_interface.show_dialog("第三学園都市の城外3キロ地点を超えれば、\n依然とも週に2、3度は必ず爆破テロが起きる。","男性B")
	await novel_interface.show_dialog("そこに住んでいる俺の伯母達も今では\n慣れてしまったみたいでな。\n家の真横で爆発でも起きない限り、\nガキどもは泣きもしなくなったそうだ。","男性B")
	await novel_interface.show_text_only("助手席の彼と話しているのは30代か40代の\n目つきの鋭い男。\n青白い肌に、焦げ茶色の髪がキチンと整えられて\nいる。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("連合議会の停戦宣告から1年以上経っていて…\n第2回『国際平和フォーラム』ってなると……")
	await novel_interface.show_text_only("……この記憶は2年前のものか？")
	await novel_interface.show_text_only("来月には新豊洲市で第4回の\n『国際平和フォーラム』が開催される。")
	await novel_interface.show_text_only("マリルが先週、愚痴を言っていた覚えがある。\n\n開催すれば、協定非武装地域の混乱を\n助長する結果になるのが何故分からんのかって…")
	await novel_interface.show_dialog("あのテロリストどもはイカレちまってるぜ！","男の声A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("マサダの新都市計画を見る限り、都市そのものを\n巨大要塞にするつもりだろうよ。","男性C")
	await novel_interface.show_text_only("向かい側に座っているのは20代前半の男だ。\n\n小麦色の肌に髑髏模様のスカーフを\n首に巻いている。")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("あぁ、マサダで戦争は日常茶飯事みたいな\nもんだ。\nまた核ミサイルが落ちてこようが、\n何らおかしい事じゃない。","男性B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ったく近頃も相変わらず物騒続きだぜ。\n\nそういや知ってるか？　理事会の奴らが──","男の声A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("お偉いさん方がどうしたんだ？","男性B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("あいつ等、志願者で結成された調査団に\n『ブラックゾーン』の進入を許可したそうだ！","男の声A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("黒いドーム状の不気味なアレにか？\n\nあのロングアイランドの外れにあるやつだよな？","男性B")
	await novel_interface.show_dialog("ドローンを飛ばしても観測が途絶えるし、俺は\nあそこから帰ってきた奴を未だに見た事がない。","男性B")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("いきなり出て来たかと思えば航空空母12隻を\n部隊ごと飲み込んじまったからな。\nそりゃ、理事会の奴らも躍起になるわけだ。","男の声A")
	novel_interface.show_character("cassell")
