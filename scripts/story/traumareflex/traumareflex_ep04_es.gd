# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Bueno, regresa—no, eso no está bien...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Bienvenido de nuevo, M-maestro...","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Todavía suena raro...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("De todos modos...","Ren")
	await novel_interface.show_dialog("¿Por qué tengo que aceptar un trabajo de medio tiempo en un café de limpieza?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Qué tipo de misión secreta es esa? Mariru sólo quiere verme sufrir, ¡apuesto!")
	await novel_interface.show_text_only("El Maid Café en el área de la embajada es bastante popular y también he leído artículos en línea sobre él.")
	await novel_interface.show_text_only("Ambiente elegante, excelente comida, cubiertos con clase... y, por último, pero no menos importante, ¡las criadas son súper lindas!")
	await novel_interface.show_text_only("Pero soy del tipo que se avergüenza fácilmente si una chica me llama “Maestro”, así que nunca fui.")
	await novel_interface.show_text_only("Fui tan ingenuo entonces...")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("Porque ahora seré yo quien llamará a los demás “Maestro”, ¡y eso es aún más vergonzoso!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(¡Y este traje de sirvienta es tan innecesariamente complicado!)","Ren")
	await novel_interface.show_dialog("(La falda ya es bastante corta para empezar...)\n(¡Y ahora, con una crinolina para hincharla, es aún más corta! ¿Cómo esperan que camine?)","Ren")
	await novel_interface.show_dialog("(Y ligas... esta es la primera vez que las uso.)\n(Entonces el broche... va en la cintura, ¿eh?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro las ligas de encaje blanco en mis piernas.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(Así es como se ven las ligas desde una perspectiva en primera persona...)\n(... ¡Hm, muy lindo!)","Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Déjame tomar una foto. ¡Nadie tiene por qué saberlo!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Haz clic!")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Ejem, déjame practicar un poco más...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si me despiden antes de que pueda pasar el entrenamiento, Mariru probablemente me pisotearía hasta la muerte.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("¡Bienvenido de nuevo, Maestro!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("¿Qué le gustaría al Maestro que escribiera en tu tortilla, nyan?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("¡Uf, esto es tan vergonzoso!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Bien, intentémoslo una vez más...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ah, se hace tarde. Tengo que cambiarme este ridículo traje e irme a la cama...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Este traje de mucama te queda bien.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("¡Sí! ¡Serás una buena doncella!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Salgo del baño y encuentro a Mariru y Aya en el sofá de mi departamento, luciendo increíblemente divertidas.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("¿Marirú? ¿Y Aya también?","Ren")
	await novel_interface.show_dialog("¿Cuándo… cuándo llegaste aquí?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hemos estado aquí por un tiempo, en realidad.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Entonces... mi práctica...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("¡Lo escuchamos todo, por supuesto!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("¡Mátame ahora...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Aw... en fin, ¿qué haces aquí?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("¡Verte disfrazarte de sirvienta y representar todas tus fantasías frente a un espejo, por supuesto!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Tenías que decirlo así?\n(Aunque no se equivoca, supongo...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("No es mi culpa tener que entrenar para la misión encubierta que me diste.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿De verdad crees que serás una buena sirvienta con solo repetir algunas líneas? No es tan fácil, ¿sabes?","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("El helicóptero está esperando en el techo. Vamos.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh? ¿Tienes una misión para mí? ¿A esta hora de la noche?\nDame un segundo, tengo que cambiarme de esto...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Está bien. Nuestro objetivo para esta misión también es una sirvienta, así que encajarás perfectamente.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¿Ella simplemente sonrió? ¡Definitivamente lo hizo! ¡Puaj!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Pero... este traje...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("No será un problema. La última vez que te topaste con el objetivo, también vestías un traje de sirvienta.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Sólo ven con nosotros y verás.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Los tres tomamos el helicóptero hasta un gran centro médico, actualmente medio vacío ya que la mayoría del personal se había ido a casa.")
	await novel_interface.show_text_only("El edificio está en silencio, salvo por el sonido de las máquinas zumbando de fondo. Nuestros pasos resuenan en las silenciosas paredes encaladas.")
	await novel_interface.show_text_only("No hay nadie a la vista. Los pasillos brillantemente iluminados de alguna manera parecen incluso más macabros que la oscuridad total.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("¿Esto es... un hospital?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me di cuenta de que esta debe ser una operación encubierta por el hecho de que los pilotos del helicóptero eran agentes con los que estoy familiarizado.")
	await novel_interface.show_text_only("Mariru rara vez participa en misiones, pero es obvio que, esta vez, quiere asegurarse de que cuantas menos personas sepan sobre esto, mejor.")
	await novel_interface.show_text_only("También noto que todas las cámaras de seguridad aquí han sido giradas para mirar hacia las paredes.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Este es el Departamento de Medicamentos Experimentales en el Centro de Investigación de Harima Tech.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("La identidad de nuestro objetivo esta vez es extremadamente sensible. La misión es ultrasecreta, ni siquiera el Senado puede saberlo.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Harima Tech... ¿no pertenece al Senado?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Durante mi capacitación en SID, tuve que memorizar los nombres de todas las organizaciones de las que debía mantenerme alejado. Harima Tech es uno de ellos.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("¿Y no era el Dr. Bright un investigador aquí?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Oh, ¿ese hombre gorila? Ahora está establecido de forma independiente. Este lugar ya no tiene nada que ver con él.","Mariru")
	await novel_interface.show_dialog("Este es un departamento de investigación práctica. SID realiza muchos pedidos a este tipo de organizaciones.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("¡Hemos pedido muchos equipos especiales desde aquí! De hecho, la mayoría de los edificios de este departamento han sido construidos únicamente para...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por dinero. Aya no tiene que decirlo.")
	await novel_interface.show_text_only("Ja, una relación comprador-vendedor muy... confiable, ¿eh?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Nuestro objetivo se llama Fabella. La conociste una vez, en la misión en Sky Hotel.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ella es la criada que te llevó a un lado y te regañó por ser torpe.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ah, ¿ella? Recuerdo. Llevaba gafas con montura roja, ¿verdad? Y ella estaba trabajando para una niña...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Así es. Skurd Axelrod. Hija única de un miembro de alto rango del Comité de la Segunda Ciudad Academia.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ella nos envió un mensaje hace cuatro horas a través de la lavandería.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("¿Entonces ella quiere... traicionar a su pueblo?","Ren")
	await novel_interface.show_dialog("(¿No es Skuld realmente joven? Hasta donde puedo recordar, probablemente tenga la misma edad que Elluka...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Según lo que nos dijo Skuld, nuestro equipo de recuperación logró encontrar a Fabella inconsciente en una iglesia en la Zona Desmilitarizada Acordada.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Detectamos compuestos del complejo de dietilamida del ácido lisérgico en su sangre. También se encontraron dispositivos de distribución de aerosoles químicos de grado militar en los terrenos de la iglesia.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Armas químicas alucinógenas, ¿eh? Veo que es un método muy imaginativo para hacer que tus enemigos se vuelvan unos contra otros.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("¿Fue un ataque terrorista?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("No, más bien como una trampa para moscas.","Mariru")
	await novel_interface.show_dialog("Skuld ya nos lo dijo. Fabella es una bruja.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("¿Eh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ahora entiendo por qué me pidieron que viniera hasta aquí a medianoche.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Después de que neutralizamos los alucinógenos en el sistema de Fabella, ella todavía está en coma profundo...","Aya")
	await novel_interface.show_dialog("No pudimos despertarla ni siquiera después de inyectarle una gran cantidad de Levodopa.","Aya")
	await novel_interface.show_dialog("Su nivel de metabolismo celular se está disparando, y su temperatura corporal... no pudimos controlarla ni siquiera sumergiéndola en agua helada.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Cualquier ser humano normal habría perdido la mayoría de sus órganos en condiciones como esta, pero su cuerpo parece tener una tolerancia increíble a las altas temperaturas.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Skuld nos dijo que Fabella es una bruja de fuego. Poseído por la magia del fuego.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("¿Poseído?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Este término me parece extraño.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Según nuestro análisis de los datos que hemos recopilado actualmente, podemos ver la magia como un campo que manipula la \"información\".","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fabella no es como Elluka, que puede controlar los campos eléctricos directamente. Su situación es más como... “cierta información poderosa” ha elegido poseerla.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Estás hablando como si la información tuviera voluntad propia.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Lo hacen. Si una cadena de información tiene una densidad lo suficientemente alta y un valor de entropía lo suficientemente bajo, puede ganar voluntad.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Cuando Fabella perdió el conocimiento, la “información viva” comenzó a apoderarse de su cuerpo...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En cierto modo, me recuerda ese artículo de noticias en el que un dueño en coma fue devorado por su propia mascota. Se me pone la piel de gallina con sólo pensarlo.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Pronto, me di cuenta de que la razón por la que no podíamos despertarla era que, en primer lugar, ya estaba “despierta”.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Escaneamos su hipocampo y corteza prefrontal, y ambos estaban ocupados en el trabajo, como si ella estuviera recordando algo.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Sin embargo, su tronco encefálico no envió ninguna señal reflectante efectiva. Es como si algo lo estuviera bloqueando.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las palabras de Aya salen rápidamente. Suena demasiado ansiosa.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Y cuando escaneamos su cerebro con un sensor Boltzmann, detectamos rasgos de mutaciones...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Espera... ¿Quieres decir que hay capullos de bruja... en su cerebro?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("¡Bingo!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Entonces pensé, resulta que tenemos un dispositivo que nos permite piratear el cerebro de alguien, por así decirlo. Harima Tech lo ha estado desarrollando para SID por un tiempo.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Es solo un prototipo, pero ya pasó la prueba alfa.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("¿Entonces ahora soy tu rata de laboratorio?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eres nuestro último recurso.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Ya enviamos cuatro agentes al cerebro de Fabella, pero algo seguía “rechazándolos”.","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("Los agentes lo describieron como “un muro interminable que se interpone en el camino”.","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
