# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("Au moment où le monde se terminera ?","Ren")
	await novel_interface.show_dialog("(Attendez, ce désastre a-t-il affecté le monde entier ?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Mais tout le monde ne semblait-il pas bien le lendemain ?")
	await novel_interface.show_text_only("La seule chose qui a \"terminé\" c'est mon...")
	await novel_interface.show_dialog("(Qu'ai-je fait pour mériter ça ?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Mais dans ce souvenir, tu es un garçon.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("... Hein ?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alors, êtes-vous un garçon, Miss Ren ?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Euh... Euh...\nEuh, je...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Des titres d’actualité tels que « Des hommes travestis se faufilent dans le service d’hôpital pour filles » me viennent à l’esprit.")
	await novel_interface.show_text_only("Skuld se rapproche, l'air incroyablement suffisant, comme si elle venait de me surprendre en train de faire quelque chose d'illégal.")
	await novel_interface.show_text_only("Je me sens coincé, comme un cerf dans les phares.")
	await novel_interface.show_text_only("Inconsciemment, je couvre ma poitrine et recule, puis j'essaie de maintenir ma jupe aussi...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Ugh, cette jupe est vraiment trop courte ! Impossible de la faire rester en place !)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Euh, attends, pourquoi suis-je si nerveux ?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, allez, je suis une fille !\nHahaha...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne ressemble pas du tout à un garçon en ce moment. Skuld n’aurait jamais pu relier mon moi actuel à mon identité d’origine.")
	await novel_interface.show_text_only("De plus, Mariru a fait beaucoup pour brouiller mes traces. Même la meilleure agence de renseignement ne serait pas en mesure de dire qui j’étais.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Mais cette silhouette dans les ruines de New Opulentia... c'est définitivement un garçon dans mes souvenirs.","Skuld")
	await novel_interface.show_text_only("Skuld se déplace devant moi, étudiant mon visage avec beaucoup de perplexité.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("Et après un éclair de lumière blanche, j'ai vu ton visage.","Skuld")
	await novel_interface.show_dialog("C'était moins d'une seconde, mais je ne me souviens jamais de mal.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Vous êtes la personne dans mes souvenirs.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je suis assise là, le dos appuyé contre le mur, terrifiée par l'aura imposante de cette petite fille.")
	await novel_interface.show_text_only("Pas étonnant que dans ces romans fantastiques classiques, quelle que soit la taille du monde, il ne puisse jamais y avoir plus de deux prophètes. L’auteur ne saura pas quoi en faire.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Ce genre de capacité... c'est comme tricher, n'est-ce pas ?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Pourtant, ce n’était qu’un fragment. Et les souvenirs ne sont pas toujours fiables.","Skuld")
	await novel_interface.show_dialog("Je suppose que je ne peux pas non plus être sûr si tu es un garçon ou une fille, juste à partir de cet aperçu de mes souvenirs.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille blonde cède un peu, me laissant un peu d'espace pour respirer.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Pourtant, j'ai réussi à confirmer quand tu m'as serré dans tes bras tout à l'heure. Votre corps, votre silhouette, vos cheveux...","Skuld")
	await novel_interface.show_dialog("Je ne sais pas pourquoi, mais Miss Ren est définitivement une fille, du moins pour le moment.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("Et ils se sentent... gentils...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sourit malicieusement.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Ils ?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A-t-elle enfoui son visage dans ma poitrine parce qu'elle voulait confirmer si « ils » étaient réels ?")
	await novel_interface.show_text_only("Et elle a même vérifié mes cheveux...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Je parie que Mariru va me gronder plus tard pour avoir baissé ma garde si facilement !)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld lève la tête et s'éclaircit la gorge.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Quoi qu'il en soit... nous avons échangé des secrets, alors... nous sommes amis maintenant, n'est-ce pas ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle demande, prudemment, dans l'expectative.")
	await novel_interface.show_text_only("Mon cœur bat. Mon instinct me dit que c'est le vrai Skuld qui se cache derrière tout ça, non dissimulé, vulnérable.")
	await novel_interface.show_text_only("Elle a dû grandir dans un monde sans confiance. Elle est encore si jeune... elle ne peut pas avoir plus de treize ans...")
	await novel_interface.show_text_only("Même si ses capacités prophétiques ne sont pas si puissantes, il y a probablement des tonnes de gens qui adoreraient l'utiliser.")
	await novel_interface.show_text_only("Si son secret est révélé, elle sera ruinée.")
	await novel_interface.show_text_only("Pourtant, elle a tout risqué et me l'a dit, même si je pouvais très bien être surveillé et porter un des bugs de Mariru...")
	await novel_interface.show_text_only("Peut-être que tout ce qu'elle voulait, c'était un ami, quelqu'un avec qui elle pourrait être honnête.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Ouais. Votre secret est en sécurité avec moi.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je lève mon petit doigt.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Parce que je suis... « spécial » pour toi, n'est-ce pas ?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wow, c'est tellement ringard...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld le regarde fixement, puis éclate de rire.")
	await novel_interface.show_text_only("Nous le promettons petit à petit.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Quand Aya entre dans le bar, elle aperçoit immédiatement Mariru sur le canapé près de la fenêtre, faisant doucement tourner le verre de vin dans sa main.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Les « mesures de sécurité » du prototype ont été configurées selon vos demandes.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Assez vite, n'est-ce pas ?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vous vouliez que je garde une trace des stimulations du nerf vague de Ren et que je la déconnecte immédiatement du système si quelque chose d'anormal se produit. N'est-ce pas un peu violent, cependant ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("C’est un peu comme un fusible de sécurité. Après tout, nous ne savons toujours pas grand-chose sur le fonctionnement de la mémoire, du moins scientifiquement.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Et qui sait si c'est effectivement comme ce que disent les films... « votre cerveau se grille si des souvenirs contradictoires surviennent ».","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya semble très excitée de voir le cerveau de quelqu'un griller.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Si on fait une expérience sur quelques dizaines de personnes au hasard, on le saura, non ?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru lève son verre, étudiant la forme des glaçons à l'intérieur sous l'éclairage.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Non...","Mariru")
	await novel_interface.show_dialog("Même si une personne possède deux ensembles de souvenirs complètement contradictoires, elle trouvera toujours un moyen de les rationaliser.","Mariru")
	await novel_interface.show_dialog("Par exemple, des souvenirs d'une vie passée, ou d'un univers parallèle. Ou peut-être une sorte d’épiphanie divine.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Qui sait, ils peuvent même créer une secte avec ce genre de connaissances.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("C'est vrai, mais...","Aya")
	await novel_interface.show_dialog("Mais n’avez-vous pas demandé aux gens de Harima Tech de ne pas stimuler son cortex préfrontal, afin de garder la zone mémoire de son cerveau coupée ?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Vous voulez qu'elle oublie la plupart des informations qu'elle avait après son réveil, comme si tout cela n'était qu'un rêve... n'est-ce pas ?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se tourne pour regarder par la fenêtre les lumières virtuelles de la ville.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella était éclaireuse quand elle était enfant. Elle a été élevée par un chef de guerre en Amérique du Sud.","Mariru")
	await novel_interface.show_dialog("Elle en sait beaucoup trop, plus qu'elle ne peut supporter.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ah ?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Bien, n'avez-vous pas dit à Skuld de convaincre Ren d'accepter cette mission ? Est-ce que ça a marché ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Bien sûr. Cet idiot ne pourra pas dire non à une jolie fille.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Si simple, si naïf. Je l'envie un peu.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mais attendez, dans ce cas, pourquoi avez-vous—","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya s'arrête au milieu de sa phrase, réalisant qu'elle a déjà la réponse à sa propre question.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vous voulez établir une sorte de « point d’ancrage mémoriel » pour Ren, hein ?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sourit et sirote gracieusement dans son verre.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("La méthode simple est toujours la meilleure, hein ?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Vous la gâtez certainement, n'est-ce pas ?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eh. Il est temps, allons-y.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
