# traumareflex_ep09.gd - 创伤反射篇第09话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep09_script()

func play_script():
	pass

func traumareflex_ep09_script():
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("—Cosa? Il sospettato è morto?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Il nostro obiettivo aveva ristrutturato la sua casa trasformandola in un'intera fortezza. E ha sparato come un matto contro la squadra di recupero con armi pesanti nel momento in cui sono arrivati.","SID Agent")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("La squadra di recupero non dovrebbe essere equipaggiata solo con armi non letali? Perché il bersaglio è morto?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La squadra non ha ferito mortalmente il bersaglio.","SID Agent")
	await novel_interface.show_dialog("Invece, il bersaglio sembra essere morto per overdose di neurofarmaci o per perdita di sangue.","SID Agent")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("... capisco. Puoi andare adesso.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sì, capo.","SID Agent")
	await novel_interface.show_text_only("Mariru sta sfogliando i file del sospettato, con l'aria molto seccata, quando Aya entra nella sala di controllo.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ren è qui adesso?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sì. Tutto sembra abbastanza stabile.","Aya") #文字错误
	await novel_interface.show_dialog("Sono questi i... risultati dell'autopsia del sospettato?","Aya")
	await novel_interface.show_dialog("Antonio Jose Urquiza... un signore della guerra mafioso che era piuttosto attivo in Sud America durante la Guerra dei Sette Anni. In questo momento, non è altro che il leader di una banda minore.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Peccato che i farmaci gli abbiano praticamente fritto il cervello... altrimenti avremmo potuto provare a interrogarlo con quell'apparecchio.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya mormora mentre sfoglia la sua pila di file.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Sud America... quindi l'obiettivo era proprio Fabella, eh?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Non possiamo ancora esserne sicuri.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru scuote la testa, con espressione cupa, mentre studia il profilo del bersaglio visualizzato sullo schermo.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Un piccolo numero di marcatori radioattivi è stato rilevato nel dispositivo di distribuzione chimica che abbiamo trovato nella chiesa.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("E da lì, abbiamo facilmente trovato un'altra posizione con gli stessi marcatori radioattivi... proprio all'interno di New Opulentia.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","dizzy",0.25)
	await novel_interface.show_dialog("Ah? Quindi è quasi come se il colpevole non si preoccupasse nemmeno di nascondersi.","Aya")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ecco perché lo trovo così sospetto...","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Antonio... questo tizio ha un motivo per ferire Fabella?","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì, e che motivo...","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Nel secondo anno di guerra l'economia dell'America del Sud crollò. Quello che è successo dopo è che le bande hanno preso il sopravvento sulla scena politica con i loro conflitti e piccole risse.","Mariru")
	await novel_interface.show_dialog("Fabella, che perse i genitori in guerra, fu adottata da un colonnello, e crebbe in un ambiente strettamente militare.","Mariru")
	await novel_interface.show_dialog("Ben presto dimostrò istinti di combattimento animaleschi e divenne la guardia nazionale più giovane della storia.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Ho sentito dire che una volta si intrufolò in territorio nemico, da sola, e uccise silenziosamente il comandante, che era il figlio maggiore di Antonio.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Questo sì che è un motivo.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru richiama il ritratto di un uomo, vestito con abiti militari, e indica lo schermo.")
	novel_interface.show_character("liliu_research","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ai","wink",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo era il colonnello che adottò Fabella: Carlos Branco.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Intendi Branco, il \"Macellaio del fiume Churun\"?","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Il massacro del fiume Churun ​​avvenne non molto tempo dopo che le sei Città Accademia formarono il Congresso Unito.")
	await novel_interface.show_text_only("46mila civili furono giustiziati lungo il fiume, il loro sangue tingeva di rosso le cascate del Salto Ángel a valle.")
	await novel_interface.show_text_only("In quelle poche settimane era su tutti i giornali. L'opinione comune era che dietro tutto ciò ci fosse Carlos Branco, il più potente signore della guerra dell'epoca.")
	await novel_interface.show_text_only("Le scene grottesche dell'incidente suscitarono diffusi sentimenti contro la guerra da parte del grande pubblico, e da allora Branco fu conosciuto come il Macellaio del fiume Churun.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Ben presto, il Congresso Unito prese misure militari contro Carlos Branco, condannandolo per i suoi crimini antiumanitari e razziali.")
	await novel_interface.show_text_only("Alla fine, un Lancer Penetrator fece saltare in aria la grotta in cui si nascondeva Branco, ponendo così fine all'era del monopolio delle bande in Sud America.")
	await novel_interface.show_text_only("Ciò ha messo il Congresso Unito negli annali migliori della maggior parte delle persone. Erano visti dal grande pubblico come un simbolo di pace e giustizia. In seguito al loro successo, le sei nazioni partecipanti al Congresso furono ribattezzate Città Accademia.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("—Almeno questa è la versione ufficiale stampata sui libri di storia.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sorride compiaciuta e Aya annuisce comprensiva.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Successivamente, i sei signori della guerra rimasti in Sud America semplicemente scomparvero all'improvviso, come se fossero legati da una sorta di accordo. Il Congresso Unito presto conquistò il loro territorio.","Aya")
	await novel_interface.show_dialog("Sai cosa è successo veramente, vero?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("chiede Aya, avvicinandosi a Mariru e toccandole la vita con un gomito, come un gattino curioso.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Sì. Il massacro è avvenuto davvero, ma i morti provenivano dai territori dei sei signori della guerra.","Mariru")
	await novel_interface.show_dialog("Hanno deciso di spedire quelle persone al fiume, e... sai cosa è successo dopo.","Mariru")
	await novel_interface.show_dialog("Qualcuno li aveva corrotti per farlo.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("L'unico che rifiutò di accettare la tangente fu Carlos Branco.","Mariru")
	await novel_interface.show_dialog("Fu così che egli ricevette il ruolo del “male necessario” nel nostro mondo attuale.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","normal",0.25)
	await novel_interface.show_dialog("Quindi quelli che hanno corrotto i signori della guerra...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya la fissa, con gli occhi spalancati. La risposta è fin troppo chiara.")
	novel_interface.show_character("liliu_research","speak")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ai","think",0.25)
	await novel_interface.show_dialog("Quei signori della guerra scomparsi devono essersi semplicemente trasferiti altrove, cambiato nome e godersi il resto della vita spendendo il denaro ricevuto.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quanto alla prova della colpevolezza di Branco... deve essere stata falsificata per i soldati della sicurezza dallo stesso Congresso Unito.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Se il Congresso Unito si rendesse conto che Antonio vuole vendicarsi, vorrebbe farla finita al più presto possibile.","Aya")
	await novel_interface.show_dialog("Non c'è da stupirsi che l'intera situazione sembri così imbarazzante.","Aya")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah? Imbarazzante come?","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Gli allucinogeni che abbiamo trovato nel sangue del bersaglio sono dello stesso tipo di quelli che abbiamo trovato su Fabella.","Aya")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo sapevo.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("E abbiamo trovato un tipo di stimolante, del tipo che spesso i signori della guerra usavano per tenere vigili i loro soldati. Quella fu infatti la vera ragione della morte di Antonio.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Anche questo è nel rapporto.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Lo stimolante rende ipersensibile chi lo inietta. Sentiranno di più, sentiranno di più.","Aya")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ce n'è così tanta nel suo sangue che, se fosse colpito da un proiettile di gomma, probabilmente gli farebbe tanto male quanto se fosse colpito da un cannone.","Aya")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ma durante i venti minuti circa in cui le due parti si spararono a vicenda, il bersaglio fu colpito più volte...","Mariru")
	await novel_interface.show_dialog("Il bersaglio è chiaramente visibile fin dal quinto minuto nel filmato della scena. E non si è mai iniettato nulla.","Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Durante l'autopsia non è stata riscontrata alcuna lesione nel suo sistema nervoso.","Aya")
	novel_interface.change_2nd_expression("blush_dizzy")
	await novel_interface.show_dialog("D-questo significa che a questo ragazzo piace davvero tanto il dolore? Wow, il masochista definitivo...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru arrotola rapidamente della carta e dà una pacca sulla testa ad Aya, come se avesse fatto così per tutta la vita.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Aw... comunque, hanno già scoperto chi ha portato Skuld al parco?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Chiunque fosse, si è tenuto lontano da tutte le telecamere di sorveglianza. Un esempio da manuale di eccellente rapitore.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Qualcuno che abbia familiarità con la posizione delle telecamere di sorveglianza... e che possa passeggiare per la città con una ragazza sulla schiena, senza essere visto come sospetto...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sì. Questi indizi sono tutto ciò che abbiamo.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru si gratta il mento, immersa nei suoi pensieri.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se Antonio fosse effettivamente un capro espiatorio, scelto con cura per fungere da “colpevole”...","Mariru")
	await novel_interface.show_dialog("Allora chiunque ci sia dietro tutto questo probabilmente è alla ricerca di Fabella o, più specificamente, dei suoi poteri da strega.","Mariru")
	await novel_interface.show_dialog("Non credo che abbiano ottenuto ciò che volevano.","Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ma è un esemplare piuttosto prezioso, quindi invece di ucciderla sul posto, hanno deciso di lasciarla lì affinché il Congresso Unito la catturasse...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Allora fu per questo che usarono un “capro espiatorio” così prezioso?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Beh, è una strega posseduta dalla magia del fuoco, quindi...\nHmm, aspetta, \"informazioni con volontà\"...","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Informazioni...?","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gli occhi scioccati di Mariru incontrano quelli di Aya. Sono giunti alla stessa conclusione.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Se ciò che realmente volevano quei rapitori era rubare le informazioni dalla testa di Fabella...","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Potrebbero utilizzare lo stesso tipo di attrezzatura che utilizziamo anche noi. Harima Tech aveva progettato questi dispositivi per l'hacking del cervello sulla base di alcuni documenti pubblicati a disposizione del grande pubblico.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("In tal caso, probabilmente hanno riscontrato lo stesso problema che abbiamo riscontrato noi.","Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_text_only("I primi quattro agenti che hanno tentato di hackerare il cervello di Fabella si sono scontrati con lo stesso muro infinito.")
	await novel_interface.show_text_only("Come un firewall che tiene lontani gli intrusi.")
	await novel_interface.show_dialog("Se si tratta di un tipo di firewall offensivo:","Aya")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Aya, preparati a svegliare Ren non appena darò gli ordini.","Mariru")

	print("=== 创伤反射篇第09话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
