# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("吶……你有沒有過那種感覺？")
	await novel_interface.show_text_only("突然想起某個畫面，卻忘記是何時的記憶。")
	await novel_interface.show_text_only("我指的並不是那種很多人都經歷過的，稱為「既視感」的體驗。")
	await novel_interface.show_text_only("而是你早就知道會發生的一幕，終於被驗證了。")
	await novel_interface.show_text_only("你已經預知到，甚至看到了似曾相識的畫面，只是當時無法確認。")
	await novel_interface.show_text_only("而所謂「既視感」，僅僅是對這種預知的驗證。")
	await novel_interface.show_text_only("你早知道事情會變這樣的──")
	await novel_interface.show_text_only("不是嗎？")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("唔……","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髮少女迷迷糊糊醒來，揉了揉眼睛，發現自己正躺在一張長椅上。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("法貝拉……這裡是哪裡？","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("形影不離的女僕並未如往常那樣，在第一時間出現在自己面前。")
	await novel_interface.show_text_only("路上空無一人，兩側路燈整齊地延伸到遠方，讓少女產生了一種恍若隔世的詭異寧靜感。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("我記得……剛剛在教堂……","斯庫爾德")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("啊──法貝拉！！！","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("強忍著劇烈的頭痛，斯庫爾德猛然從長椅上站起。")
	await novel_interface.show_text_only("剛才好像做了惡夢，彩繪玻璃上扭曲恐怖的畫面還深深烙印在腦海中。")
	await novel_interface.show_text_only("最後似乎是法貝拉將自己從黑暗中推了出去……")
	await novel_interface.show_text_only("斯庫爾德檢查了身上帶的東西，手機、財物和飾品都還在。")
	await novel_interface.show_text_only("少女拿出手機，32通未接來電。")
	await novel_interface.show_text_only("如果不是法貝拉幫自己裝了反追蹤軟體，恐怕大使館的人早就追上了吧……")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("22：18…已經這麼晚了嗎？","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女坐在長椅上，閉上眼調整呼吸，試圖釐清紛亂的記憶與資訊。")
	await novel_interface.show_text_only("父親和法貝拉之前都教過自己應對方法——面臨越是複雜危險的環境，越要保持頭腦清醒。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("那座教堂……還有安東神父的簡訊，應該是特別針對我所設的陷阱。","斯庫爾德")
	await novel_interface.show_dialog("所以對方真正的目標應該是我、父親或者法貝拉三者之一。","斯庫爾德")
	await novel_interface.show_dialog("能隱約聽到附近路上的車聲，遠處還傳來街頭樂隊演奏的聲音，自己的行動自由應該沒有受到限制。","斯庫爾德")
	await novel_interface.show_dialog("依照手機定位，這裡是新井中心公園，離那座教堂不到兩公里……","斯庫爾德")
	await novel_interface.show_dialog("──把我帶到這裡的人，應該沒有敵意。","斯庫爾德")
	await novel_interface.show_dialog("但不知道設置陷阱的人和把我帶來這裡的人是不是同個陣營……所以暫時也不能貿然回去。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("法貝拉的號碼始終沒有接通，少女查了所有記錄，這段時間也沒有任何聯絡的跡象。") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("法貝拉……","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女握緊手機，按下父親的號碼。")
	await novel_interface.show_text_only("電話幾乎是撥通的瞬間就被接起，聽筒中傳來一個焦急的聲音。")
	await novel_interface.show_dialog("喂？ 斯庫爾德嗎？","父親")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("爸爸……","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("妳跑到哪裡去了！ 到現在還不回去！ 那邊已經晚上十點多了吧？","父親")
	await novel_interface.show_dialog("妳和那個女僕都不接電話，偷跑出去就算了，還玩得這麼晚！ 妳知不知道哈格蒂大使派人在四處找妳……","父親")
	await novel_interface.show_text_only("聽到父親劈頭就是一頓責罵，斯庫爾德稍稍鬆了口氣──")
	await novel_interface.show_text_only("看來沒有人在過去幾小時裡利用自己威脅他。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("我現在很安全，但是您聽我說──","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("電話那頭的男人聽到女兒嚴肅的口氣，立刻意識到了問題。")
	await novel_interface.show_dialog("……妳身邊有其他人嗎？","父親")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("沒有，我一個人。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("好，老樣子。","父親")
	await novel_interface.show_text_only("她掛斷電話，很快接到一通「未知號碼」的來電。")
	await novel_interface.show_dialog("好了，發生什麼事了？","父親")
	await novel_interface.show_text_only("斯庫爾德再次做了個深呼吸，根據現在的資訊，有兩種可能的情況──")
	await novel_interface.show_text_only("如果設置陷阱和把自己帶到這裡的是同一批人，那麼對方的目標一開始就是法貝拉。")
	await novel_interface.show_text_only("如果兩批人並非同一陣營，那麼對方的目標並未達成，法貝拉和安東神父就是他們手上的籌碼。")
	await novel_interface.show_text_only("無論如何，對自己最重要的那個人目前一定處於危險之中……")
	await novel_interface.show_text_only("如果是第二種情況，自己去找法貝拉絕對是自投羅網，還可能白白送上機會來威脅父親和董事會。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("我需要您先幫我做一件事，去確認一下三一教堂安東神父的安全。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("好，我這就請人去確認。\n現在可以說妳遇到什麼狀況了嗎？","父親")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("我和法貝拉剛剛在大使館附近遇到埋伏了，應該是某種迷幻藥劑或是異質物武器。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("什麼──？","父親")
	await novel_interface.show_text_only("在國際領土上使用化學或異質物武器，不管是誰，都等同於向聯合議會發佈宣戰聲明。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("法貝拉拚命把我救出來，但她自己現在下落不明……","斯庫爾德")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("那些人應該是偽裝成安東神父，傳訊息誘導我過去的。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……瞭解。","父親")
	await novel_interface.show_dialog("下個月就要召開和平論壇，早說過不要在這個敏感的時間來新豐洲，妳偏不聽……","父親")
	await novel_interface.show_dialog("那幫人敢在這個時機點這麼做，一定會特別小心隱藏自己的身分。","父親")
	await novel_interface.show_dialog("法貝拉之前在南美的長官雖然不在了，但不少仇家可都還在……","父親")
	await novel_interface.show_dialog("妳現在在哪？\n我先透過外交管道安排妳回紐摩利達斯。","父親")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("您先跟我保證，一定會救法貝拉出來──","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("斯庫爾德聲音有些顫抖，眼淚在她的眼眶中打轉。")
	await novel_interface.show_dialog("……","父親")
	await novel_interface.show_text_only("電話的另一頭只有一陣沉默。")
	await novel_interface.show_text_only("她知道，以父親的訊息管道和能力一定已經分析出了利弊，並做出他認為的最佳判斷。")
	await novel_interface.show_text_only("父親是一家避險基金的創始人，戰爭期間在金融市場殺伐決斷，最終獲得了進入「董事會」的資格。")
	await novel_interface.show_text_only("但他也因此樹敵無數；事實證明，平時做空一支股票和戰爭期間做空一個國家的意義全然不同。")
	await novel_interface.show_text_only("斯庫爾德從小就在仇恨與危險的環境中長大，但父親不知道在堅持什麼，從不為家人改變行事風格。")
	await novel_interface.show_text_only("可能跟她很小的時候就過世的母親有關吧……")
	await novel_interface.show_text_only("突然，斯庫爾德發現手機螢幕上亮起一個小紅框，\n那是通話期間被定位的警示。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("──？！","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她立刻掛斷了電話。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("暴露位置了嗎？ 得先離開這裡……","斯庫爾德")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("斯庫爾德跑到附近一座停車場的樓梯間裡。")
	await novel_interface.show_text_only("此時她手機上顯示的是通訊錄中一家洗衣店的號碼，那是法貝拉交給她的「最終保險」措施。")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("……只能賭一把了！","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女蹲在樓梯台階上，撥通了電話──")
	await novel_interface.show_text_only("三聲鈴聲之後，一個溫柔的女性聲音接起了電話。")
	await novel_interface.show_text_only("您好，瑞希爾洗衣店。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("……我是斯庫爾德·艾克斯羅德，外交識別碼是AX1832。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("好的，請稍等……")
	await novel_interface.show_text_only("您的衣服已經洗好了，需要替您送過去嗎？")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("嗯，我還有朋友在新豐洲紀念教堂。","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("好的，我記下了。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("我的位置在……","斯庫爾德")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我們知道您的位置，請稍候。")
	await novel_interface.show_text_only("電話掛斷了。")
	await novel_interface.show_text_only("10分鐘後，一隊黑色的SUV車隊開進了停車場。")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("您好，艾克斯羅德小姐。","SID特工")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("你們是……SID的人嗎？","斯庫爾德")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("是的，您的朋友已經被我們回收了。","SID探員")
	await novel_interface.show_dialog("請上車吧。","SID探員")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
