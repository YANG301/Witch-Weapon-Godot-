# traumareflex_ep02.gd - 创伤反射篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第02话剧本
	traumareflex_ep02_script()

func play_script():
	pass

# 创伤反射篇第02话 - 正式剧本
func traumareflex_ep02_script():
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("<Пятый Академгород, Кампус Ист Роуд.>")
	await novel_interface.show_text_only("В оживленном деловом районе быстро приближается ночь. Вокруг слоняются студенты, одетые в форму частной академии, расположенной в этом районе.")
	await novel_interface.show_text_only("Девушка, одетая в костюм горничной, быстрым шагом пробирается сквозь толпу.")
	await novel_interface.show_text_only("Поскольку на улице напротив круглосуточно открыто горничное кафе, ее наряд не привлекает особого внимания.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Мисс Скульд! Замедлять! Это опасно!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Да ладно, хватит придираться!\nДайте мне спокойно насладиться несколькими секундами свободы!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Блондинка вертится вокруг и вокруг, улыбаясь, как солнце.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("Расслабьтесь!\nЭто самое безопасное место в мире. Кроме того...","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("Фабелла меня защитит!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла наконец догоняет свою миниатюрную хозяйку и вздыхает от того, какой энергичной кажется маленькая девочка.")
	novel_interface.show_character("fabiola_maid","smile")
	await novel_interface.show_dialog("Несколько секунд свободы, да...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Для маленькой девочки, которую часто запирает внутри ее чрезмерно опекающий отец, Новая Опулентия действительно является самым безопасным местом, где она может быть. Это не Ньюморидас, где все жители имеют лицензию на ношение оружия, или Салмонтон с его серыми улицами, полными беженцев и бродяг.")
	await novel_interface.show_text_only("Острова Лебона теперь также являются домом для известных банд, переехавших туда во время войны.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Кроме того, поскольку в следующем месяце в Новой Опулентии пройдет Международный Форум Мира, во всем городе усилена безопасность.")
	await novel_interface.show_text_only("У Фабеллы наконец-то появился шанс выйти на улицу со своей маленькой хозяйкой без необходимости носить с собой автоматическое оружие.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Да, здесь безопасно, но всё равно надо следить за движением! И не уходи с глаз моих —","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Понятно, понятно!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Блондинка прерывает предложение Фабеллы, прыгнув вперед и уткнувшись лицом в грудь горничной.")
	novel_interface.character_light(0.35,"perspire")
	await novel_interface.show_dialog("Ох ты! Ты даже сейчас носишь бронежилет?","Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Разве это не ограничивает вас?\nВы должны позволить своей груди дышать!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","blush")
	await novel_interface.show_dialog("Breathe?","Fabella")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Ладно, прекрати...\n(Шепотом) Не делай этого публично...","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Хи-хи, я знал, что Фабелла лучшая! Спасибо, что остановил для меня одного из парней в посольстве и помог мне сбежать!","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("Старый Хаггерти собирается убить нас, когда мы вернемся...\nИ все же, действительно ли человек, которого мы ищем, появится в этой области?","Fabella")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Думаю, да. Помню, в последний раз, когда я был в отеле Sky, у меня возникло очень сильное чувство... «Вот оно, вот оно».","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ты имеешь в виду ту неуклюжую горничную?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Однако тот, кого я ищу, должен быть мальчик...","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ну...\nНа самом деле, мальчики тоже могут переодеваться горничными, знаете ли...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Видите ли, многие мальчики любят наряжаться в девчачьи наряды...","Fabella")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ох?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("Они также надели милые аксессуары и сделали макияж. Насколько это восхитительно?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ох! И?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Некоторые тоже могут говорить высокими девичьими голосами. У многих из них огромное количество подписчиков в Интернете!","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Фабелла так взволнована, что ее голос практически дрожит.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("О, я помню, как раньше видел фотографии в твоем избранном в Instagram.","Skuld")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("В таком случае, возможно, горничная, которую мы видели, была не девочкой, а мальчиком, одетым как девочка...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка, кажется, глубоко задумалась.")
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("Э... эй!","Fabella")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Мисс Скульд, оставьте мой телефон в покое!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Да ладно, у твоего телефона зашифрованное соединение, поэтому люди Отца не смогут подключиться. Кроме того, твой пароль так легко угадать!","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Я никогда не просил тебя сделать мой день рождения своим паролем!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд корчит рожу Фабелле, затем оборачивается.")
	await novel_interface.show_text_only("Она смотрит в вечернее небо, окрашенное в красный цвет заходящим солнцем, отстраненным, слегка разочарованным взглядом.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("В любом случае, неважно, мальчик это или девочка, думаю, сегодня нам уже слишком поздно их искать.","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("По крайней мере, мы должны здесь насладиться свежим воздухом, верно?","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("Итак... пойдем домой?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Есть еще одно место, которое я хочу посетить. Это недалеко от посольства. Пойдем со мной?","Skuld")
	await novel_interface.show_dialog("Помните отца Антона из Троицкого храма?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Думаю, мы встречались только один раз... он единственный в Ньюморидасе, который всегда выслушивал твои признания с тех пор, как ты была маленькой, верно?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да. Вчера он прислал мне сообщение, в котором говорилось:","Skuld")
	await novel_interface.show_dialog("«Мемориальная церковь Новая Опулентия»","Skuld")
	novel_interface.character_light(0.35,"thought")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я звонила ему на твой телефон, но он так и не взял трубку. Я немного волнуюсь, поэтому подумала, что мне стоит посетить церковь, о которой он упомянул...","Skuld") #换行问题
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Хм. Церковь находится в согласованной демилитаризованной зоне, а также недалеко от посольства, так что, вероятно, здесь безопасно.","Fabella") #文字错误
	novel_interface.change_2nd_expression("perspire")
	await novel_interface.show_dialog("Но эй, когда ты звонил ему с моего телефона? А я даже не заметил... как непрофессионально с моей стороны...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ха, не будь так строга к себе!\nТы была занята готовкой!","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Легкая ухмылка появляется на лице Скулда при мысли о готовке Фабеллы.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Dusk.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Дуэт приближается к каменному церковному зданию коричневого цвета, внешние стены которого покрыты массивной религиозной фреской.")
	await novel_interface.show_text_only("На крыше стоит крест, выглядит достойно и торжественно. Несколько куполов с замысловатой резьбой излучают величественную ауру.")
	novel_interface.show_character("fabiola_maid","normal")
	await novel_interface.show_dialog("Я не знал, что рядом с посольством есть такая большая церковь.","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Видите ли, Новая Опулентия — это своего рода академический город. Все дело в науке, поэтому религиозных построек здесь не так много.","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Фабелла переключает свою электронную карту на вид со спутника, интересуясь топографической структурой и архитектурой местности.")
	await novel_interface.show_text_only("Эту привычку она выработала еще в отряде специального назначения.")
	novel_interface.show_character("fabiola_maid","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("skuld","normal",0.25)
	novel_interface.character_dark()
	await novel_interface.show_dialog("Странно. Такая огромная церковь, а ее модели на карте нет. Существуют ли какие-то ограничения на строительство подобных зданий на международной территории?","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Вероятно, потому, что церковь до недавнего времени даже не открывалась. Его должны построить к Форуму в следующем месяце. Видеть? Фрески до сих пор выглядят новыми.","Skuld")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Твой отец будет здесь в следующем месяце, верно? В качестве члена Комитета.","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Думаю, да. В любом случае, пойдем внутрь!","Skuld")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Вход в церковь напоминает вход в самую древнюю святыню в мире.")
	await novel_interface.show_text_only("Стены полностью мраморные. Колоссальные колонны стоят мрачно. Картины маслом на куполообразном потолке и окружающих красочных мозаичных окнах создают атмосферу святости и покоя.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Поторопитесь! Смотреть! Смотреть! Это место устроено так же, как Троицкая церковь!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("П-подожди меня!","Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Скульд скачет по помещению, в восторге всматриваясь в каждую деталь, а Фабелла остается начеку, держа входные ворота открытыми.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("(Там, на лестнице, еще стоят деревянные стеллажи...)","Fabella")
	await novel_interface.show_dialog("(Эта церковь, должно быть, еще строится.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Фабелла делает несколько шагов вперед. Воздух вокруг нее вибрирует — почти незаметно, но он есть. Все ее волосы стоят дыбом, словно от статики.")
	await novel_interface.show_text_only("Она всегда была особенно чувствительна к опасности из-за детских лет, проведенных на полях сражений в Южной Америке.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("(Подожди... что-то не так...)","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Всего в нескольких шагах от Фабеллы Скульд внезапно замолкает. Она стоит как вкопанная, руки безвольно падают по бокам.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Черт возьми! Нам нужно уйти!","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass1.png")
	await novel_interface.show_text_only("За исключением миллисекунды, зрение Фабеллы тускнеет. Цвета оконных стекол, изображающих библейские сюжеты, кажутся ярче, захватывая все ее чувства.")
	await novel_interface.show_text_only("Цвета искажаются, искажаются, загромождают ее поле зрения, словно рой пчел.")
	await novel_interface.show_text_only("Оранжевый свет заходящего солнца снаружи корчится и искажается, постепенно плавясь в совершенно другой цвет.")
	await novel_interface.show_text_only("Кажется, все сливается воедино, просачиваясь в нос и уши Фабеллы, словно зловещий шорох, приближающийся с пугающей скоростью.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Фабелла отчаянно пытается сосредоточиться.")
	await novel_interface.show_text_only("Это не особо проясняет ее голову, но ей удается заставить глаза открыться только для того, чтобы увидеть, что Скульд рухнул на ковер недалеко от нее.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Черт возьми!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В ту секунду, когда она поднимает ногу, пытаясь добраться до своей маленькой хозяйки, ее ноги подкашиваются.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("...не вижу...","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass2.png")
	await novel_interface.show_text_only("Мозаичные окна скручиваются и трясутся все ближе и ближе, словно картина маслом, тающая во внезапном потоке цветов.")
	await novel_interface.show_text_only("Предметы, изображенные на мозаичных картинах, словно перестраиваются в причудливые положения.")
	await novel_interface.show_text_only("Тело горничной покачивается, потеря сознания быстро приближается — и красочное вторжение в ее разум продолжается.")
	await novel_interface.show_text_only("Свет, проникающий через окно, отбрасывает тени на землю, поглощая последние чувства дюйм за дюймом.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Фабелла резко сворачивается калачиком и вытаскивает кинжал из кинжала.")
	await novel_interface.show_text_only("Она целится в точку, где нет главных артерий, и без секунды колебания вонзает кинжал себе в бедро.")
	await novel_interface.show_text_only("Свежая кровь окрашивает светлую кожу девушки в красный цвет, но, по крайней мере, вспышка боли дает ей несколько секунд ясности.")
	await novel_interface.show_text_only("Стиснув зубы, Фабелла подходит к Скулду и поднимает маленькую девочку на руки.")
	await novel_interface.show_text_only("Она поворачивается и, шатаясь, делает несколько шагов вперед.")
	await novel_interface.show_text_only("Нацеливаясь на главный вход, где еще светло, она выбрасывает Скулда за пределы здания с остатками силы воли, прежде чем тьма поглотит ее.")
	await novel_interface.hide_background_with_fade()
