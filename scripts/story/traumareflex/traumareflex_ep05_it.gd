# traumareflex_ep05.gd - 创伤反射篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep05_script()

func play_script():
	pass

func traumareflex_ep05_script():
