# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("¿El momento en que se acaba el mundo?","Ren")
	await novel_interface.show_dialog("(Espera, ¿ese desastre afectó al mundo entero?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¿Pero no todos parecían estar bien al día siguiente?")
	await novel_interface.show_text_only("Lo único que “terminó” fue mi...")
	await novel_interface.show_dialog("(¿Qué hice para merecer esto?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Pero en ese recuerdo, eres un niño.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("...¿Eh?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Entonces, ¿es usted un niño, señorita Ren?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Uh... Um...\nUh, yo...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Titulares de noticias como “Travestis masculinos para colarse en la sala del hospital de niñas” pasan por mi mente.")
	await novel_interface.show_text_only("Skuld se acerca unos centímetros más, viéndose increíblemente engreída, como si acabara de pillarme haciendo algo ilegal.")
	await novel_interface.show_text_only("Me siento acorralado, como un ciervo ante los faros.")
	await novel_interface.show_text_only("Inconscientemente, cubro mi pecho y me muevo hacia atrás, y luego intento sujetar mi falda también...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(¡Uf, esta falda es realmente demasiado corta! ¡No puedo dejarla quieta!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Uh, espera, ¿por qué estoy tan nervioso?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¡Ay, vamos, soy una niña!\nJajaja...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No me parezco en nada a un niño en este momento. De ninguna manera Skuld podría haber conectado mi yo actual con mi identidad original.")
	await novel_interface.show_text_only("Además Mariru hizo mucho para tapar mis huellas. Ni siquiera la mejor agencia de inteligencia sería capaz de decir quién era yo.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Pero esa silueta en las ruinas de Nueva Opulentia... definitivamente es un niño en mis recuerdos.","Skuld")
	await novel_interface.show_text_only("Skuld se mueve frente a mí, estudiando mi rostro con mucha perplejidad.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("Y después de un destello de luz blanca, vi tu rostro.","Skuld")
	await novel_interface.show_dialog("Fue menos de un segundo, pero nunca recuerdo mal.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Eres la persona en mis recuerdos.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me siento allí, con la espalda apoyada contra la pared, aterrorizada por el aura imponente de esta pequeña niña.")
	await novel_interface.show_text_only("No es de extrañar que en esas novelas clásicas de fantasía, no importa cuán grande sea el mundo, nunca pueda haber más de dos profetas. El autor no sabrá qué hacer con ellos.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Este tipo de habilidad... es como hacer trampa, ¿no?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Aún así, era sólo un fragmento. Y los recuerdos no siempre son confiables.","Skuld")
	await novel_interface.show_dialog("Supongo que tampoco puedo estar seguro de si eres un niño o una niña, solo por ese vistazo en mis recuerdos.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia cede un poco, dejándome algo de espacio para respirar.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Aún así, logré confirmarlo cuando me abrazaste hace un momento. Tu cuerpo, tu figura, tu cabello...","Skuld")
	await novel_interface.show_dialog("No estoy seguro de por qué, pero la señorita Ren definitivamente es una niña, al menos en este momento.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("Y se sienten... lindos...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sonríe con picardía.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("¿Ellos?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Enterró su cara en mi pecho porque quería confirmar si “ellos” eran reales?")
	await novel_interface.show_text_only("Y hasta me revisó el cabello...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(¡Apuesto a que Mariru me regañará más tarde por bajar la guardia tan fácilmente!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld levanta la cabeza y se aclara la garganta.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("De todos modos… hemos intercambiado secretos, así que… ahora somos amigos, ¿verdad?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunta, cautelosa, expectante.")
	await novel_interface.show_text_only("Mi corazón late. Mi instinto me dice que este es el verdadero Skuld debajo de todo, sin disfraz, vulnerable.")
	await novel_interface.show_text_only("Ella debe haber crecido en un mundo sin confianza. Ella todavía es muy joven... no puede tener más de trece años...")
	await novel_interface.show_text_only("Aunque sus habilidades proféticas no son tan poderosas, probablemente hay toneladas de personas a quienes les encantaría usarla.")
	await novel_interface.show_text_only("Si su secreto sale a la luz, quedará arruinada.")
	await novel_interface.show_text_only("Sin embargo, ella arriesgó todo y me dijo, aunque bien podría ser monitoreado y usando uno de los bichos de Mariru...")
	await novel_interface.show_text_only("Quizás todo lo que quería era un amigo, alguien con quien pudiera ser honesta.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Sí. Tu secreto está a salvo conmigo.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Levanto mi dedo meñique.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Porque soy... “especial” para ti, ¿verdad?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Wow, eso es tan cursi...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld mira fijamente y luego estalla en risitas.")
	await novel_interface.show_text_only("Lo prometemos con el meñique.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Cuando Aya entra al bar, inmediatamente ve a Mariru en el sofá junto a la ventana, haciendo girar suavemente la copa de vino en su mano.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Las “medidas de seguridad” para el prototipo han sido configuradas de acuerdo a sus solicitudes.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Bastante rápido, ¿no?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Querías que realizara un seguimiento de las estimulaciones del nervio vago de Ren y que la desconectara del sistema inmediatamente si ocurre algo anormal. ¿No es eso un poco violento?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Es como un fusible de seguridad. Después de todo, todavía no sabemos mucho sobre cómo funcionan los recuerdos, al menos científicamente.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Y quién sabe si efectivamente es como lo que dicen las películas… “se te fríe el cerebro si ocurren recuerdos contradictorios”.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya parece bastante emocionada de ver cómo se fríe el cerebro de alguien.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Si realizamos un experimento con unas pocas docenas de personas al azar, lo sabremos, ¿verdad?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru levanta su vaso, estudiando la forma de los cubitos de hielo en su interior bajo la iluminación.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("No...","Mariru")
	await novel_interface.show_dialog("Incluso si una persona posee dos conjuntos de recuerdos completamente contradictorios, igual encontrará una manera de racionalizarlos.","Mariru")
	await novel_interface.show_dialog("Por ejemplo, recuerdos de una vida pasada o de un universo paralelo. O tal vez algún tipo de epifanía divina.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Quién sabe, incluso pueden iniciar una secta con ese tipo de conocimiento.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Cierto, pero...","Aya")
	await novel_interface.show_dialog("¿Pero no le pediste a la gente de Harima Tech que no estimularan su corteza prefrontal para mantener aislada el área de la memoria en su cerebro?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Quieres que olvide la mayor parte de la información que tenía después de despertar, como si todo fuera un sueño... ¿verdad?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se gira para mirar por la ventana las luces virtuales de la ciudad.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Fabella era exploradora cuando era niña. Fue criada por un señor de la guerra en América del Sur.","Mariru")
	await novel_interface.show_dialog("Ella sabe demasiado, más de lo que puede soportar.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("¿Ah?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Bien, ¿no le dijiste a Skuld que convenciera a Ren para aceptar esta misión? ¿Funcionó?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Por supuesto. Ese idiota no podrá decirle que no a una linda chica.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Tan simple, tan ingenuo. En cierto modo la envidio.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Pero espera, en ese caso, ¿por qué—?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya se detiene a mitad de la frase y se da cuenta de que ya tiene la respuesta a su propia pregunta.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Quieres establecer una especie de “punto de anclaje de la memoria” para Ren, ¿eh?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sonríe y sorbe con gracia de su vaso.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("La forma sencilla es siempre la mejor, ¿eh?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Seguro que la mimas, ¿no?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Eh. Ya es hora, vámonos.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
