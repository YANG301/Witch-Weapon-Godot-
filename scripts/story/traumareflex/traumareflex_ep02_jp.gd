# traumareflex_ep02.gd - 创伤反射篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第02话剧本
	traumareflex_ep02_script()

func play_script():
	pass

# 创伤反射篇第02话 - 正式剧本
func traumareflex_ep02_script():
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("第五学園都市、学区東道。")
	await novel_interface.show_text_only("夕方の賑わいを見せる商店街のあっちこっちに、\n私立学校の制服を着た学生達の姿が見える。")
	await novel_interface.show_text_only("そんな日常風景の中、メイド服姿の少女が\n人込みの間を疾走する。")
	await novel_interface.show_text_only("付近に24時間営業のメイドカフェがあるためか\nそこまで彼女は注目を浴びている様子はない。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("ご主人様！　そんなに走らないでくださいませ！\n危険な目にあったらどうするんですか！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("へっへん、大丈夫！\n今日みたいに自由な日は滅多にないんだもん！","スクルド")
	novel_interface.character_dark()
	await novel_interface.show_text_only("金髪の少女は軽快に振り返り、太陽のような\nまぶしい笑顔を見せた。")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("もっとリラックスしようよ～～！\nここは世界で一番安全な場所だし、しかも──","スクルド")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("ファビオラがあたしの側にいるからね～～！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラは小さな主人に追い付くと\n彼女の喜ぶ様子を見て、\n仕方がないとばかりに溜め息を吐く。")
	novel_interface.show_character("fabiola_maid","smile")
	await novel_interface.show_dialog("滅多にない……自由ですか……","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("確かに、新豊洲はニューモリダスのように\n全ての市民が銃を持っているわけでもないし、\nサモントンのように難民とホームレスが\n溢れているわけでもない。")
	await novel_interface.show_text_only("かつて大勢力だった数々の暴力団も、\n戦争中にリバーナ諸島へと移った。")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("更には来月に『国際平和フォーラム』の開催が\n控えており、街全体の警備も強化されている。")
	await novel_interface.show_text_only("ファビオラも主人と外出するにあたって、\n本日は珍しく銃火器を携帯していない。")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("とは言え、走り回ってはいけません！\n交通安全の注意は怠るべからずです！\nそれに私の視界から離れないでくださいと\n何度も何度も……ッ！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("はいは～～い！","スクルド")
	novel_interface.character_dark()
	await novel_interface.show_text_only("金色の髪をなびかせた少女はファビオラを\n抱きしめる。\nお説教を誤魔化すかのように、ファビオラの胸に\n頬ずりをした。")
	novel_interface.character_light(0.35,"perspire")
	await novel_interface.show_dialog("あなたったら、まだ下に防弾チョッキを\n着ているのね──","スクルド")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("苦しくないの？\nせっかくあんなに柔らかいのに……","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","blush")
	await novel_interface.show_dialog("え？","ファビオラ")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("わ、分かりましたから……\nこんなに大勢が見ている前で……","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("ふふ、やっぱりファビオラは最高ねっ。\n\nあなたが外出カードを偽造して大使館の人を\n騙してくれたおかげで、抜け出せたんだもんっ。","スクルド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("帰ったらハグディーの爺さんに何を\n言われるのやら……\nそれにしても本当に『あの人』は\nこの辺りに現れるのですか？","ファビオラ")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うん、覚えてるわ……この前スカイホテルで\n出会った時に強く感じたの。\nきっと『あの人』だって。","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("あのすっとこどっこいのメイドがですか？","ファビオラ")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("でも男の子のはずなのよ。おっかしいなぁ……","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("コホン……\nそういう類の人も世の中には少なくないのです。","ファビオラ")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ほぇ？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("男の子だけど、女の子の身なりをする人です……","ファビオラ")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("へぇ～～？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("色々な可愛い服を着せてあげて、\nお化粧してあげると……\n率直に申し上げて超萌えます。","ファビオラ")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それでそれで？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("素質のある人は声すらも隙がなく、\nネット上でも大人気でございますっ！","ファビオラ")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("興奮したファビオラの声が少し震えている。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("うんうん、知ってるよ。\n\nファビオラのInstagraphのブックマークで\n見た事があるもん。","スクルド")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("言われてみると、確かにその可能性も……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髪の少女は真面目に考え始めた。")
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("あの髪の毛がウイッグだと仮定すると………\n…………えっ？","ファビオラ")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("ご、ご主人様、かかかか勝手に私の携帯を\n見ないでください～～ッ！！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("だってあなたの携帯回線は暗号化されているから\nパパに盗聴される心配がないんだもん。\nおまけにパスワードも分かりやすいし──","スクルド")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("あたしの誕生日をパスワードなんかにしちゃ\nダメだよ～～！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドはファビオラに対して、おどけた感じで\nあっかんべーっと舌を出して振り返った。")
	await novel_interface.show_text_only("少女は夕焼けに赤く染まる雲を眺めながら、\n少し落ち込んでいる。")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("『あの人』が男性にしても女性にしても、\nもうこんな時間じゃ会えないよね……","スクルド")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("……まあ、風にあたるのも悪くないかな。","スクルド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("……もう帰られますか？","ファビオラ")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("帰る前に寄りたいところがあるわ\n……大使館の近くよ。","スクルド")
	await novel_interface.show_dialog("トリニティ教会のアントン神父を覚えている？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ええ、会った事は1度しかございませんが……\n\nニューモリダスで幼い頃から、ご主人様の話を\n良く聞いて下さっていたという──\n──あの神父さんですね？","ファビオラ")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うん。昨日ね、彼からのメッセージが届いたの。\n内容は一行だけ──","スクルド")
	await novel_interface.show_dialog("『新豊洲記念教会』","スクルド")
	novel_interface.character_light(0.35,"thought")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ファビオラの携帯を使ってかけなおしても、\n誰も出なくて少し心配で……","スクルド") #换行问题
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("そうですね……その教会なら協定非武装地域に\n位置してます。\n大使館のすぐ近くでもございますし、\n大方危険はないでしょう。","ファビオラ") #文字错误
	novel_interface.change_2nd_expression("perspire")
	await novel_interface.show_dialog("ですが、ご主人様。\nいつ私の携帯を使用されたのです？\n全く気付きもしなかったなんて……\n……私の職務怠慢です。","ファビオラ")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("アハハハ──気にしないで……\nあの時、あなたは料理研究に夢中だったから……","スクルド")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ファビオラの料理について言及したスクルドの\n口元が、無意識にピクっと痙攣した。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Dusk.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("2人の前には、黄褐色の石造りの教会。\n外壁には巨大な宗教壁画が描かれている。")
	await novel_interface.show_text_only("建物の上部にある厳かな十字架と、緻密に彫刻が\n施されたヴォールトが重厚な質感を醸し出す。")
	novel_interface.show_character("fabiola_maid","normal")
	await novel_interface.show_dialog("大使館の近くにこんな大きな教会が\nあったのですね……","ファビオラ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("新豊洲は『学院政体』だし科学至上主義だから、\nこんな大きな宗教建築物は珍しいと思う──","スクルド")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ファビオラはデジタルマップを『衛星画像』に\n切り替えて、\n3Dマップから教会と周辺地区の構造を\n把握しようとした。")
	await novel_interface.show_text_only("それは彼女が特殊攻撃部隊にいた頃から、\n培われている習慣だ。")
	novel_interface.show_character("fabiola_maid","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("skuld","normal",0.25)
	novel_interface.character_dark()
	await novel_interface.show_dialog("おっかしいですね、これほど大きな教会なのに\nマップモデルがないなんて……\n国際領土におけるスキャン規制のせいですかね？","ファビオラ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("最近、使われ始めたからじゃないかな？　\n\nおそらく来月のフォーラムへ向けて\n建造されたのよ。壁画も新しいからね～～","スクルド")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("来月にはお父上も参加されますかと……\n『理事会』の一員でございますので。","ファビオラ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("そうかもね……とにかく早く入ってみようっ！","スクルド")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("教会に入ると、まるで最古の神殿に\n足を踏み入れたかのようだった。")
	await novel_interface.show_text_only("大理石の壁、端粛と整列する巨大な石柱、\nドームに描かれた油絵や周囲のステンドグラス、\nこれが神聖な静けさを讃えていた。")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("きてきてっ！ここの構造ってトリニティ大聖堂と\n良く似ているわっ！","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("お、お待ちくださいっ！","ファビオラ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("スクルドが楽しげに見学をしている中、\n扉を開けたままファビオラは警戒を怠らない。")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("（あそこの階段にまだ……）\n\n（取り外されていない仮設の足場がある……）","ファビオラ")
	await novel_interface.show_dialog("（この教会、まだ未完成なの？）","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラが数歩進むと、\n周囲の空気から微かな振動を感じ取る。\n──静電気でも流れたかのように毛が逆立つ。")
	await novel_interface.show_text_only("幼い頃に南米の戦場で身に付けた生存本能が、\n「何か」の危険を察知した。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("（様子が、おかしい……）","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("ファビオラの数メートル前方。\nスクルドが急に声を止めて立ち尽くしている……")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("マズい、早く出ないとッ！！！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass1.png")
	await novel_interface.show_text_only("突如としてファビオラの視界がぼやけ始めた。\n\n教会の両サイドにある聖書の物語を象った\nステンドガラスが、とてつもなく輝いて見える。")
	await novel_interface.show_text_only("ガラスの絵が歪んで変形し、視界の全部を\n占拠していく。")
	await novel_interface.show_text_only("ガラスを照らす夕日も、じわじわと不気味な色に\n変化していく。")
	await novel_interface.show_text_only("色は次第に広がり聴覚や嗅覚にまで達した。\n\n遠くから近付いてくるノイズのような音に、\n全てを奪われてしまうかのような──")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("──ファビオラは全力を尽くして、\n精神を集中させる。")
	await novel_interface.show_text_only("我に返ると少し離れた床のカーペットに、\nスクルドが倒れ込んでいる事に気が付いた。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("くそっ！！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("すぐに彼女の側へと駆け付けようとするが、\n力を入れるだけで足元がよろめきそうになる。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("視界が……もう……","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass2.png")
	await novel_interface.show_text_only("両サイドのステンドガラスが、\n溶けた油絵のように崩れて視野を覆い尽くす。")
	await novel_interface.show_text_only("見えるもの全てが、歪な姿で再現されていく。")
	await novel_interface.show_text_only("前後不覚に陥ったかのように、\nファビオラの身体は揺れ動く。\n──なおも続く精神の浸食。")
	await novel_interface.show_text_only("ガラス越しの光が、床に影を生み出した。\n\n最後の理性を少しずつ暗闇に溶かすかのように。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("ファビオラは身体を丸め、ひと握りの理性を\n振り絞る。\nブーツの片側から装備していたナイフを\n引き抜いた。")
	await novel_interface.show_text_only("そして、一瞬で主要な血管を外せるポイントに\n狙いを定め────\n迷わずナイフを自分の太ももに突き刺す。")
	await novel_interface.show_text_only("鮮血が少女の透き通った肌を赤く染める。\n\n強烈な痛みを利用して、ひと時の覚醒を\n得たのだ。")
