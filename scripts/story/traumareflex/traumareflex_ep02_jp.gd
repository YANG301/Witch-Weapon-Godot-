	await novel_interface.show_text_only("霞む視界の中、小さな体躯が扉の外に出たのを\n確認する…………\n……ファビオラの意識は暗闇に飲み込まれた。")

	print("=== 创伤反射篇第02话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
