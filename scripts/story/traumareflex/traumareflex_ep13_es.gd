	await novel_interface.show_dialog("La tendencia era solo una tendencia y pronto fue olvidada. Pero esta araña... se parece a algunos de los planos que he visto en línea.","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
