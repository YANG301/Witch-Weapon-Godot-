# traumareflex_ep03.gd - 创伤反射篇第03话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep03_script()

func play_script():
	pass

func traumareflex_ep03_script():
	await novel_interface.show_text_only("Hé, as-tu déjà ressenti ce genre de sentiment ?")
	await novel_interface.show_text_only("Vous vous souvenez d'une scène... mais vous n'avez aucune idée du moment où elle s'est produite.")
	await novel_interface.show_text_only("Je ne veux pas dire du déjà-vu. Tout le monde a ça à un moment ou à un autre.")
	await novel_interface.show_text_only("Je veux dire, il y a quelque chose dont vous avez toujours su qu’il se produirait un jour, et cela arrive enfin.")
	await novel_interface.show_text_only("Vous avez toujours su que cela arriverait. Vous l’avez même vu, sous forme de flashback. Vous ne pouvez tout simplement pas être sûr du moment où cela va se produire.")
	await novel_interface.show_text_only("Ce que nous appelons du déjà vu est simplement une sorte de confirmation que vos prémonitions se sont réalisées.")
	await novel_interface.show_text_only("Vous saviez que cela allait arriver. Vous l’avez toujours su.")
	await novel_interface.show_text_only("N'est-ce pas ?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Night_Park.png")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Hum…","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeune fille blonde ouvre les yeux groggy, se frotte le visage et se retrouve allongée sur un banc.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Fabella... où en sommes-nous ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais Fabella ne répond pas. Étrange. La femme de chambre apparaît généralement à la seconde où son nom est appelé.")
	await novel_interface.show_text_only("La jeune fille regarde autour d'elle et voit une rue vide, bordée de lampadaires ordonnés des deux côtés. La rue semble continuer éternellement dans un silence étrange, comme si c'était un univers alternatif.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("N'étions-nous pas dans une église...?","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ahh... Fabella !","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld se lève, une main massant sa tempe douloureuse.")
	await novel_interface.show_text_only("Elle se souvient du cauchemar qu'elle a fait. Il se souvient des images tordues sur les fenêtres en mosaïque. Mais n’était-ce vraiment qu’un cauchemar ?")
	await novel_interface.show_text_only("Elle se souvient que Fabella l'a chassée de l'église, la libérant des ténèbres qui l'auraient autrement réclamée...")
	await novel_interface.show_text_only("Skuld vérifie ses affaires. Son téléphone portable, son portefeuille, ses accessoires... tout y est.")
	await novel_interface.show_text_only("Il y a trente-deux appels manqués sur son téléphone.")
	await novel_interface.show_text_only("Si Fabella n’avait pas installé un logiciel anti-pistage sur le téléphone, l’ambassade l’aurait probablement déjà retrouvée.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Dix-huit heures... il est déjà si tard ?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle ferme les yeux, faisant de son mieux pour réguler sa respiration, pour démêler le désordre enchevêtré que sont ses souvenirs.")
	await novel_interface.show_text_only("Elle doit rester calme, c'est ce qu'auraient voulu Père et Fabella. On lui a toujours dit que plus la situation était dangereuse, plus elle devait garder les idées claires.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Cette église... et le texte du Père Anton... doivent être un piège.","Skuld")
	await novel_interface.show_dialog("Qui que ce soit, il doit me cibler, Père ou Fabella.","Skuld")
	await novel_interface.show_dialog("J'entends les voitures venant des routes à proximité et même les artistes de rue qui jouent une chanson à distance... et je ne suis pas attaché ou quoi que ce soit.","Skuld")
	await novel_interface.show_dialog("D'après le GPS de mon téléphone, je suis à Arai Central Park, pas trop loin de l'église.","Skuld")
	await novel_interface.show_dialog("Celui qui m’a amené ici ne voulait probablement pas de mal.","Skuld")
	await novel_interface.show_dialog("Je ne sais pas si celui qui a tendu le piège et celui qui m'a amené ici appartenaient à la même faction... Je ne peux pas repartir comme ça.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld compose à nouveau le numéro de Fabella. Et encore une fois, cela va à la messagerie vocale. Elle vérifie tous ses dossiers et il ne semble pas non plus que Fabella l'ait contactée.") #换行问题
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Fabella...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Finalement, elle appelle son père en serrant fermement son téléphone dans sa petite main.")
	await novel_interface.show_text_only("Il décroche à la seconde où l'appel passe.")
	await novel_interface.show_dialog("Skulde ? Est-ce que tu?","Père")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Père...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Où diable es-tu ? Il est déjà dix heures passées. où tu es. Tout le monde meurt d’inquiétude !","Père")
	await novel_interface.show_dialog("Et ni vous ni votre servante n'avez décroché le téléphone ! Qu'est-ce qu'il y a entre vous deux ? L’ambassadeur Haggerty a déjà envoyé une équipe à votre recherche !","Père")
	await novel_interface.show_text_only("Son père a l'air fou, mais Skuld est simplement soulagé d'entendre sa voix.")
	await novel_interface.show_text_only("Au moins, personne n'a essayé de le menacer de quoi que ce soit, en l'utilisant comme otage.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Je suis en sécurité maintenant, ne vous inquiétez pas, mais écoutez—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L’homme se calme aussitôt devant l’urgence du ton de sa fille.")
	await novel_interface.show_dialog("... Etes-vous seul ?","Père")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Ouais. Juste moi.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Attendez une seconde, je vous rappelle avec un autre numéro.","Père")
	await novel_interface.show_text_only("Elle raccroche et reçoit immédiatement un appel d'un numéro inconnu.")
	await novel_interface.show_dialog("D'accord, vous pouvez parler maintenant. Ce qui s'est passé?","Père")
	await novel_interface.show_text_only("Skuld prend une profonde inspiration. D'après ce qu'elle sait actuellement, il devrait y avoir deux possibilités :")
	await novel_interface.show_text_only("Si ceux qui ont tendu le piège et ceux qui l'ont amenée ici appartenaient au même groupe, alors leur cible doit être Fabella, pas Skuld elle-même.")
	await novel_interface.show_text_only("S'ils ne font pas partie du même groupe, alors elle-même pourrait être la cible : celui qui la voulait a échoué et tient actuellement en otage Fabella et le père Anton.")
	await novel_interface.show_text_only("Quoi qu'il en soit, sa personne préférée au monde est en danger.")
	await novel_interface.show_text_only("Pourtant, si c’est le dernier cas, elle ne peut pas aller chercher Fabella elle-même. Ce serait tomber directement dans un piège, et elle finirait probablement aussi en otage, que les ravisseurs pourraient utiliser contre Père et le Comité.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Pouvez-vous d'abord faire quelque chose pour moi ? J’ai besoin que quelqu’un vérifie le père Anton de Trinity Church et me dise s’il est en sécurité.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bien sûr, j'enverrai quelqu'un tout de suite.\nMaintenant, dites-moi ce qui se passe.","Père")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella et moi avons été pris dans une embuscade près de l'ambassade il n'y a pas longtemps. Ils ont probablement consommé une sorte d’hallucinogène ou des drogues à base de substance H.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Quoi ?","Père")
	await novel_interface.show_text_only("Utiliser des armes chimiques ou celles fabriquées avec la substance H sur un territoire international équivaut à peu près à déclarer la guerre au Congrès uni.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Fabella a risqué sa vie pour me sauver. Je ne sais pas où elle est maintenant...","Skuld")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ces gars ont dû m'envoyer un texto en se faisant passer pour le père Anton et m'ont attiré là-bas.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("… Je vois.","Père")
	await novel_interface.show_dialog("Le Forum de la Paix aura lieu le mois prochain... pourquoi avez-vous dû vous rendre à New Opulentia à un moment aussi sensible... ?","Père")
	await novel_interface.show_dialog("Celui qui oserait faire cela ferait certainement très attention à son identité.","Père")
	await novel_interface.show_dialog("Même si l'ex-patron de Fabella en Amérique du Sud est décédé, il a encore pas mal d'ennemis...","Père")
	await novel_interface.show_dialog("Bref, où es-tu maintenant ?\nJe vais arranger quelque chose avec les relations étrangères et te ramener à Newmoridas.","Père")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Tu dois me le promettre d'abord ! Promets-moi que tu sauveras Fabella !","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voix de Skuld tremble, les yeux remplis de larmes.")
	await novel_interface.show_dialog("…","Père")
	await novel_interface.show_text_only("A l'autre bout du fil, silence.")
	await novel_interface.show_text_only("Skuld sait que son père est extrêmement compétent, toujours bien informé. Il serait capable d’analyser facilement la situation et de décider de la meilleure marche à suivre.")
	await novel_interface.show_text_only("Son père est fondateur d'une société de fonds spéculatifs, qui a prospéré sur le marché financier pendant la guerre grâce à ses excellentes capacités de prise de décision. C'est ainsi qu'il a gagné sa place au sein du Comité.")
	await novel_interface.show_text_only("Mais c'est aussi ainsi qu'il se fit d'innombrables ennemis. Après tout, faire chuter les stocks est très différent de faire tomber un pays.")
	await novel_interface.show_text_only("Skuld a grandi dans un environnement rempli de haine et de danger. Mais son père était étrangement persistant et refusait de changer ses habitudes pour sa fille.")
	await novel_interface.show_text_only("Cela pourrait avoir quelque chose à voir avec sa mère, décédée quand elle était très jeune.")
	await novel_interface.show_text_only("Soudain, Skuld remarque un petit cadre rouge sur l'écran de son téléphone.\nCela indique que sa position est suivie pendant l'appel.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("...!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle raccroche aussitôt.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("Ils ont ma position maintenant ! Je dois sortir d'ici...","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Parking_Lot.png")
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("Skuld se précipite dans la cage d'escalier d'un parking voisin.")
	await novel_interface.show_text_only("Elle appelle le numéro d'une laverie automatique dans ses contacts. Fabella lui avait donné ce numéro en dernier recours.")
	novel_interface.show_character("skuld","panic")
	await novel_interface.show_dialog("... Je suppose que je n'ai plus le choix maintenant !","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Accroupie sur les marches, la jeune fille compose le numéro.")
	await novel_interface.show_text_only("Après trois sonneries, une gentille dame prend la parole.")
	await novel_interface.show_text_only("Laverie Rexhill. Au plaisir de vous servir.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("... Je m'appelle Skuld Axelrod, numéro d'identification international. AX1832.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Compris. Veuillez patienter...")
	await novel_interface.show_text_only("Mademoiselle Axelrod, votre lessive est prête. Devons-nous vous l'envoyer ?")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Bien sûr. Au fait, mon amie de la New Opulentia Memorial Church a besoin que son linge soit ramassé.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Compris.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("J'en suis à—","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nous savons où vous êtes. S'il vous plaît soyez patient.")
	await novel_interface.show_text_only("La dame raccroche.")
	await novel_interface.show_text_only("Dix minutes plus tard, un SUV noir roule dans le parking.")
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Bonjour, Mademoiselle Axelrod.","SID Agent")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Êtes-vous du... SID ?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Oui. Nous avons déjà récupéré votre ami.","SID Agent")
	await novel_interface.show_dialog("Veuillez entrer.","SID Agent")


	print("=== 创伤反射篇第03话结束 ===")
	await novel_interface.end_story_episode(0.5)
