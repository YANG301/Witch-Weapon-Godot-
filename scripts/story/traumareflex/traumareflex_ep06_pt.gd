# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("—Bum!")
	await novel_interface.show_text_only("Mais uma explosão. A cabeça do nosso caminhão é levantada abruptamente e sou jogado no chão.")
	await novel_interface.show_text_only("O exterior do caminhão, fortificado com a mágica Substância H, quase não é afetado, mas ainda podemos sentir a força esmagadora vinda de dentro.")
	await novel_interface.show_text_only("Quando o caminhão tomba de lado, meu estômago se revira. Parece que eu poderia vomitar ali mesmo.")
	await novel_interface.show_text_only("Certo... a blindagem do caminhão pode ser invencível, mas o chão certamente não é. Basta explodir o chão e o caminhão ficará imóvel.")
	await novel_interface.show_text_only("Que design tolo e inutilmente caro...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Uma dor de cabeça...")
	await novel_interface.show_text_only("Meus ouvidos estão zumbindo, meus olhos mal conseguem focar.")
	await novel_interface.show_text_only("Felizmente estou vestindo uma jaqueta de combate cheia de fluido não newtoniano, ou então provavelmente teria quebrado a maioria dos meus ossos durante a bagunça anterior.")
	await novel_interface.show_text_only("Não sei quem escolheu o equipamento para mim, mas acho que deveria ficar grato.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Mesmo assim, eles tiveram que me fazer usar meias de seda?)\n(E agora há buracos nelas!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pá! Pá! Pá! Pá! Pá!")
	await novel_interface.show_text_only("Fabella abre a tampa do botão de saída de emergência do carro com um soco. Os cabos de detonação no teto do caminhão explodem um após o outro.")
	await novel_interface.show_text_only("Um buraco aparece no telhado, agora posicionado na lateral. Fumaça acre e chamas invadem meu nariz e o interior do veículo.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Droga... todos fora!","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Tosse* Ei, o novato está bem?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ainda mal recuperando a consciência, sou pego por Fabella e jogado para fora da caminhonete.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("A fumaça queima meus olhos, me fazendo chorar incontrolavelmente e bloqueando minha visão.")
	await novel_interface.show_text_only("Tomo duas grandes tragadas de ar, mas só consigo fumaça. Meus pulmões estão prestes a entrar em combustão...")
	await novel_interface.show_text_only("Começo a tossir e a vomitar por reflexo, incapaz de recuperar o fôlego.")
	await novel_interface.show_text_only("Meu corpo resiste enquanto eu engasgo, meus olhos finalmente encontrando a máscara pendurada em meu pescoço. Eu rapidamente pressiono sobre meu nariz e boca com uma mão.")
	await novel_interface.show_text_only("Ufa...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Departamento de Medicamentos Experimentais, Harima Tech>")
	await novel_interface.show_text_only("Depois de passar pelos detalhes básicos sobre Fabella comigo, Mariru e Aya descem as escadas para afinar alguns equipamentos, deixando-me sentado lá sozinho.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Então eles simplesmente... foram embora? Simples assim?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os silenciosos corredores do hospital parecem opressivos de repente.")
	await novel_interface.show_text_only("Eu sento ali em uma cadeira perto da parede, vestida com uma roupa de empregada totalmente fora do lugar.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Parece que estou em um jogo de tiro com zumbis censurado...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Não. Zumbis não existem. Fantasmas, por outro lado...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Sim, haha. Zumbis não—","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Espere, quem foi?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu pulo de pé ao ouvir a voz repentina vinda da escada.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Me desculpe, eu te assustei?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma menina pequena espia do canto.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("E nos encontramos novamente, senhorita Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O cabelo loiro da garota cai até a cintura em uma trança delicada. Ela parece etérea, como algo fora deste mundo. Não é uma aura que eu possa esquecer.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ah, Skurd?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ela me ligou... Senhorita?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld sorri para mim timidamente. Ela parece ansiosa, inquieta.")
	await novel_interface.show_text_only("Nada elegante e gracioso, como quando nos conhecemos no Sky Hotel.")
	await novel_interface.show_text_only("Ah, certo! Fabella é sua empregada. Claro que ela ficará preocupada...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Eu sei que você está aqui porque Mariru fez você vir...\nMas eu teria perguntado de qualquer maneira...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela parece hesitante, tremendo um pouco, contendo valentemente as lágrimas enquanto fala.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Por favor... salve Fabella...","Skuld")
	await novel_interface.show_dialog("Foi tudo minha culpa por fazê-la fugir comigo...","Skuld")
	await novel_interface.show_dialog("Eu não esperava que isso acontecesse...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ei, calma!","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Ah, não, ela vai chorar!)\n(O que eu faço?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quase estendo a mão para consolá-la, mas simplesmente não me parece certo abraçar uma garotinha... no corredor de um hospital à meia-noite... usando ligas e roupa de empregada.")
	await novel_interface.show_text_only("Faço uma pausa, braços no ar, e ela se joga em meu peito.")
	await novel_interface.show_text_only("Seu cabelo loiro e macio cai sobre meus cotovelos. A menina cheira um pouco a leite. Meu batimento cardíaco acelera, meu cérebro zumbindo.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(Ela é tão pequenininha!)\n(Que fofa!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aqui, com o rosto enterrado no meu peito, ela parece menor do que parecia. Seu corpo frágil treme, como um animal encurralado.")
	await novel_interface.show_text_only("Hum. Aya mencionou algo sobre hackear cérebros? Não consigo me lembrar. Não se importe.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Eu vou te ajudar! Com certeza vou ajudar você!\nDeixe tudo comigo!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe parou de funcionar. Eu diria sim a qualquer coisa que ela me pedisse para fazer. Até bombardear o Senado...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Está tudo bem. Estou bem aqui.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sou péssimo em consolar os outros. Que bem eu estar “bem aqui” faria para ela? Quem sabe, mas as pessoas não costumam dizer coisas assim nesse tipo de situação?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Sim.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Em meu abraço, Skuld acena gentilmente.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Eu acredito em você. Você pode fazer isso.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sério? Eu posso?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Porque... você é aquela pessoa especial... nas minhas lembranças.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Ok... espere, o que?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Eu, especial? Minha roupa de empregada deixou uma impressão tão grande nela?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld se acalma um pouco, enxuga as lágrimas e olha para mim com olhos cheios de confiança.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Posso te contar todos os meus segredos.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Que... inesperado. Não tenho ideia de como reagir.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Você pode achar difícil de acreditar, mas por favor ouça.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A menina pequena e frágil na minha frente de repente fica sóbria, e não posso deixar de me inclinar, me sentindo toda séria.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Eu tenho uma... habilidade muito especial.","Skuld")
	await novel_interface.show_dialog("Posso me lembrar de coisas que ainda não aconteceram... ou devo dizer... tem algumas coisas que ainda não aconteceram, mas já posso vê-las, como lembranças.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Memórias... que ainda não aconteceram?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Esses fragmentos existem em minhas memórias desde o início, então não consigo nem dizer quais memórias são do passado e quais são do futuro.","Skuld")
	await novel_interface.show_dialog("Tenho que ver isso acontecer para ter certeza.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Então é como uma profecia?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso parece incrível, mas passei por tantas loucuras nesses últimos meses que já me acostumei a acreditar em seis coisas impossíveis antes do café da manhã.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("É como... um doce. Um pouco doce, um pouco azedo, deixa um gosto mentolado na boca quando derrete.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hm, eu já comi esse tipo de doce antes, mas não tenho certeza de quando...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Isso mesmo!","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Você pode descrever em detalhes o gosto daquele doce, mas não pode dizer quando ou onde o provou.","Skuld")
	await novel_interface.show_dialog("Você só vai perceber “ah, é isso” quando um dia realmente provar.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Acho que estou começando a entender. Se fragmentos que podem ser do passado ou do futuro existirem em suas memórias, seria difícil dizer qual é qual.")
	await novel_interface.show_text_only("Não é ver o futuro, para ser exato. Porque ela não sabe dizer quais memórias são do futuro.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Espere... mas certamente ela seria capaz de descobrir isso com algumas pistas no ambiente?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É como se Skuld lesse minha mente. Ela explica:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Você pode estar pensando: é verdade que você pode não ser capaz de dizer se algo aconteceu no próximo mês ou no último, mas o ambiente daqui a dez anos certamente será muito diferente do que é agora, certo?","Skuld")
	await novel_interface.show_dialog("Mas memórias... elas não são como vídeos. Tudo o que conseguimos são fragmentos...","Skuld")
	await novel_interface.show_dialog("Nosso cérebro só consegue reconstruir toda a cena de uma memória quando focamos muito nela, sabe?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faz sentido. Lembro-me desta frase de um filme:")
	await novel_interface.show_text_only("“Memórias são interpretações, não gravações.”")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Portanto, na verdade não é tão fácil encontrar fragmentos em minhas memórias que me permitam identificar o período de tempo.\nAlém disso...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("Você não costuma mergulhar em suas memórias sem motivo algum, certo?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Hum?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Por exemplo, você não vai relembrar sua aula de matemática do ensino fundamental e o que a professora escreveu na lousa, só por diversão, certo?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Claro. Aula de matemática... professores... certamente não é divertida.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Eu acredito em você, é só... uau. É incrível.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Espere. Então, o “eu” em suas memórias que você acabou de mencionar...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld assente.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("De qualquer forma, só há uma coisa em minhas memórias que tenho certeza que aconteceu no futuro.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Prendo a respiração. De repente, tenho a sensação de que posso adivinhar a que ela está se referindo...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... É uma lembrança do momento em que o mundo acaba.","Skuld")
	await novel_interface.show_dialog("Mas nessa memória, você é um menino.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
