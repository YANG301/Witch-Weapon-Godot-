# traumareflex_ep10.gd - 创伤反射篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep10_script()

func play_script():
	pass

func traumareflex_ep10_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_FightingP.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Fabella is still sitting on me, in the shadows of some concrete object.")
	await novel_interface.show_dialog("I know how to keep the lens from reflecting light.","Fabella")
	await novel_interface.show_text_only("She says, as she pins me down on the ground with one hand.")
	await novel_interface.show_dialog("Huh?\n(Wait, what’s she gonna do?)","Ren")
	await novel_interface.show_text_only("Fabella’s left hand is on the ground beside my face, supporting her weight. Her right knee pokes between my legs. That smirk on her face... ominous.")
	await novel_interface.show_text_only("Then she reaches down with her right hand, gently tugs at my silk stockings...")
	await novel_interface.show_dialog("Shh.","Fabella")
	await novel_interface.show_text_only("Unable to see her actions from my angle, I can only imagine what she’s doing from what I’m feeling down there.")
	await novel_interface.show_dialog("(No... please no...)\n(Please, not over there...)","Ren")
	await novel_interface.show_text_only("My cheeks are burning up, heart ramming madly in my rib cage. My fingers scrabble for purchase at the ground in some kind of reflex.")
	await novel_interface.show_dialog("(No matter how I look at it, this... isn’t ideal...)","Ren")
	await novel_interface.show_text_only("Fabella seems quite satisfied with my panicked, flustered expression. Perhaps she had wanted to teach this newbie a lesson for some time.")
	await novel_interface.show_text_only("Suddenly, her grip tightens, and the next thing I know, a hole is ripped out of my silk stockings.")
	await novel_interface.show_text_only("I can’t help crying out the second it happens.")
	await novel_interface.show_dialog("Ahh!","Ren")
	await novel_interface.show_text_only("I hear the sound of someone swallowing hard in my earpiece, followed by Cassel coughing madly.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Continuing from the opening, Fabella peels off the fabric some more, then takes off my shoes and pulls what’s remaining of the stockings off my legs.") #换行问题
	await novel_interface.show_text_only("I can barely speak out of embarrassment as she helps me put on my shoes again.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Aw, come on...)\n(My legs are all cold now...)","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_battle","mock",0.25)
	await novel_interface.show_dialog("Hm, you’ve got soft legs.\nNo muscle at all.","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Haha, sorry about that, I guess?")
	await novel_interface.show_text_only("I haven’t even regained composure yet, but Fabella is already back to acting all professional, like the commander she is.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Everyone, pull yourselves together.","Fabella")
	await novel_interface.show_dialog("We need a plan. After we lock on to the sniper’s location, how do we take them out?","Fabella") #换行问题
	await novel_interface.show_dialog("I believe their job is simply to distract us from the real battlefield over there...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella motions at the burning section of the road behind us, where sounds of rapid gunfire can be heard.")
	await novel_interface.show_dialog("Hm... the short-distance electromagnetic acceleration device needs around 4.5 seconds to charge.","Russel")
	await novel_interface.show_dialog("The device requires a scope to calibrate, so even if the sniper is using one of those guns that fire multiple rounds at once, the equipment won’t allow them to do that.","Russel")
	await novel_interface.show_dialog("We must find their location after they fire once, and take them out before they can fire a second time.","Russel")
	await novel_interface.show_dialog("Problem is, our sniping rifle is still in the trunk. And how do we make them fire at us without putting ourselves in danger?","Cassel")
	await novel_interface.show_text_only("Fabella studies the road ahead quietly with a reflector and notices a stray car door hanging off the tail of a toppled armored vehicle.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("... That must have fallen out during the explosion.","Fabella")
	await novel_interface.show_dialog("Can you guys find me some data on how durable that Substance H armor on that ridiculously expensive truck of ours is exactly?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You mean... you want to use it as a shield...?","Russel")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... It’ll probably make a good shield.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Oh?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sprite")
	await novel_interface.show_dialog("There’s a video online of a billionaire who used that kind of vehicle in a shooting experiment.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Even when under fire by a Barretta M82A1 equipped with an electromagnetic stabilizing acceleration device, the truck wasn’t affected one bit.")
	await novel_interface.show_text_only("That billionaire was just showing off with his wads of bills and Russian accent. But there’s no denying that the video was popular.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("If you think it’s safe, you do it.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("Huh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella feels around on my combat jacket, as if seeking the perfect spot, then rams her fist into me out of nowhere.")
	await novel_interface.show_text_only("That was a very impressive punch. Just by looking at it, I was convinced it would kill me then and there. But all I felt was a slight tremor in my upper body.")
	await novel_interface.show_text_only("The non-Newtonian fluid filling in my shirt, though normally soft, hardens up the second it is hit by any force.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Nice jacket. When you hold up the car door later, remember to lean into it and let the jacket absorb the shock instead of using your hands.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("I—","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Before I can protest, Fabella clamps a mask over my mouth.")
	await novel_interface.show_text_only("She then takes out a toy-like pistol from her belt and aims at the roof of the building across.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Six-second flash bomb, ready...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("An ultra-bright speck of light flies out of the pistol, sweeping past the beautiful night sky before finally coming down.")
	await novel_interface.show_text_only("Fabella waits until the speck has dropped low enough before dragging me in a mad dash to the toppled carrier truck, which we both hide behind.")
	await novel_interface.show_text_only("Cassel and Russel, too, follow us to a nearby blockage where they can see and communicate with us.")
	await novel_interface.show_text_only("Fabella enters the password into the back door of the trunk, and retrieves a lightweight Scout from the weapon rack.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("This one is better for quick aiming.","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("Cassel, get the drone ready. Keep it behind the corner of the building so that the sniper can’t see it. Only let it out when it gets high up enough.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella orders, as she tosses the silk stockings she ripped from my legs to Cassel, wrapped around a stone.")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Fresh outta the oven!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel glances at me as he catches the object, looking slightly embarrassed, and I try my best to avoid his gaze, face crimson.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Russel, keep your eyes on the images transmitted and report back to me.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Roger that.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella then lifts the car door, checks the beehive-patterned reflective Substance H armor on it, and shoves it into my arms.")
	await novel_interface.show_text_only("It’s lighter than I thought it would be. I could raise it even with one hand.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(But why do I have to act as the decoy?)","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Though it’s not like I know how to do anything else...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella pulls me close and whispers into my ear:")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Listen closely. As soon as I give the orders, you walk out from that side with the heavy smoke, concealed behind this door.","Fabella")
	await novel_interface.show_dialog("The sniper should be somewhere between the floors thirty to fifty. Stay covered, don’t let them see your butt or anything...","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Or else, you’ll no longer have a butt.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She shoves me into the smoke right after she finishes speaking, and gestures at me to wait there.")
	await novel_interface.show_text_only("Meanwhile, Cassel has already covered the camera lens with the stockings, and sent the drone up to around ten floors high, concealed in the shadows.")
	await novel_interface.show_text_only("The drone’s light-refracting coat enables it to blend into its surroundings perfectly. No one would be able to tell it’s there unless they look very, very carefully,")
	await novel_interface.show_text_only("Cassel and Russel both give the okay, and Fabella loads the sniper rifle in her hands. She nods at me—")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("Have to brave it out…","Ren")
	await novel_interface.show_dialog("(Aya did say that I’ll be fine even if I “die”...)","Ren")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("(Wait, didn’t she say I’d be a simple observer and can’t interact with the environment?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In my moment of hesitation, something pokes at my butt. It’s Fabella with her gun. She looks like she’s ready to blast off my head if I don’t start moving soon.")
	await novel_interface.show_text_only("I sigh, grumpily moving forwards out of the smoke, hidden behind the car door.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(That billionaire dude had better not been using fake props when he made that video...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I continue advancing, until I’m five or six steps away from the heavy smoke.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("(... No one’s firing at me?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The sniper should be able to see me easily. Could they tell that I’m a decoy?")
	await novel_interface.show_text_only("Suddenly, the sound of pattering footsteps come from behind. From the peripheral of my vision, Fabella slides gracefully into sight, ending up in a half-crouched position at my feet.")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("—W-what?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Cover me!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Something crashes into the door I’m holding up with a heavy bang. The devastating force sends me reeling backwards, knocking me off balance.") #文字错误
	await novel_interface.show_text_only("I land on my ass, the door flung aside. Fabella and I are completely open, easy targets.")
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("(Oh no!)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("On the forty-second floor! Third window from the right! They have the laser guide on!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That’s when our drone, concealed in the dark night sky, fires a red laser at the window in the building across.")
	await novel_interface.show_text_only("Bang!")
	await novel_interface.show_text_only("Bang! Bang!")
	await novel_interface.show_text_only("Fabella fires, three times in a row.")
	await novel_interface.show_text_only("Then silence—a lifeless, despair-inducing silence. I can practically hear my heart pumping blood into my brain.")
	await novel_interface.show_text_only("Second after second slip by. I hold my breath, imagining myself being blasted into pieces by a beam of light.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Target eliminated. I repeat, target eliminated!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("Ahaha!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Well done!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Instead of celebrating, Fabella continues kneeling in the same position, weapon at the ready.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Shh, quiet. Do you guys hear—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Straining my ears, I realize that I can indeed hear a helicopter approaching.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("What’s that... a VTOL?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Dammit! It’s a Siskin!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("What? A Siskin, here? Downtown?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A Siskin is a type of unmanned military helicopter, developed in Masada Ford during the Seven Years War.")
	await novel_interface.show_text_only("It’s known for carrying twelve anti-tank missiles, making it perfect for annihilation campaigns.")
	await novel_interface.show_text_only("The yellow-and-black striped reaper comes into sight from the skies, landing between us and the building across.")
	await novel_interface.show_text_only("That’s when I realize, well, we’re done for.")

	print("=== 创伤反射篇第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
