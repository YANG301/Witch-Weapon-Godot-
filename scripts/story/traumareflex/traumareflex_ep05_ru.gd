# traumareflex_ep05.gd - 创伤反射篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep05_script()

func play_script():
	pass

func traumareflex_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("Несколько агентов ведут Скулд к бару с панорамным видом и говорят ей сесть.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Что это за место...? И с моей подругой всё в порядке?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("Пожалуйста, подождите здесь.","SID Agent")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Паб довольно хорошо оформлен. Ковер, диванчики, подушки, бокалы для вина и обстановка в целом кажутся стильными.")
	await novel_interface.show_text_only("Успокаивающая фоновая музыка и огни города за окнами несколько успокаивают блондинку.")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Нравится вид?","Mariru")
	await novel_interface.show_dialog("Я прихожу сюда много выпить.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Э, ты...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Но ты еще недостаточно взрослый, чтобы пить. Я заказал для тебя сок.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Легко уклоняясь от вопроса, Мариру машет рукой официанту и заказывает напитки.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Вы... доктор Мариру фон Браун?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Просто Мариру в порядке.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("И не волнуйтесь. У нас есть ваш друг в нашем медицинском центре. Она все еще без сознания, но ее жизни ничего не угрожает.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру подносит планшет Скулду. На экране четыре окна, в реальном времени отображающие кадры из палаты Фабеллы в высоком разрешении.")
	await novel_interface.show_text_only("Она ясно видит Фабеллу на больничной койке, окруженную медицинским оборудованием. Видно и окно палаты.")
	await novel_interface.show_text_only("А за окном на вершине небоскреба стоит гигантский красно-синий рекламный щит.")
	await novel_interface.show_text_only("Скульд выглядывает из окна бара и видит то же самое здание. Это значит, что Фабелла должна быть где-то рядом.")
	await novel_interface.show_text_only("Блондинка опускает голову, начиная дрожать, наблюдая за затрудненным дыханием подруги под кислородной маской.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Пожалуйста... спасите ее...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она всхлипывает, давится голосом.")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("Фабелла... моя лучшая подруга...\nПожалуйста...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("И, ​​наконец, она плачет, давление, скопившееся на ее хрупких плечах, сразу ослабло. Огромные слезы одна за другой падают на экран планшета.")
	await novel_interface.show_text_only("Мариру делает глоток вина, изучая маленькую девочку, свернувшуюся калачиком над планшетом.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Хм, бармен сегодня превзошёл самого себя.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она садится рядом со Скулдом и похлопывает ее по плечу. Наклонившись к ее уху, она шепчет:")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Твой отец входит в состав Комитета, верно? И он будет здесь, в Новой Опулентии, на Форуме Мира...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд продолжает рыдать, опустив голову.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Видите, на люстре перед нами... микрокамера.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Рыдания начинают стихать.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Дочь высокопоставленного чиновника Второго Академгорода, болтающая с высокопоставленным лицом разведывательного агентства другой страны, как старые друзья...","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Если запись утекла...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд поднимает голову, вздыхает, берет две салфетки, чтобы вытереть слезы, и сглатывает, пытаясь успокоить дыхание.")
	await novel_interface.show_text_only("Мариру ласкает ее волосы, затем поглаживает ее по голове.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Это больше похоже на это. Большие девочки не плачут.","Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","thought",0.25)
	await novel_interface.show_dialog("Люди возненавидят тебя, если ты продолжишь это говорить...","Skuld")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я не против иметь хейтеров, если они меня не убьют.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мариру отвечает, все улыбаются.")
	await novel_interface.show_text_only("Скульд берет стакан со стола и делает глоток. По вкусу он точно такой же, как ее любимый напиток в ее любимом магазине десертов в Ньюморидасе.")
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("skuld","talk",0.25)
	await novel_interface.show_dialog("... Вы действительно провели много исследований обо мне, да?","Skuld")
