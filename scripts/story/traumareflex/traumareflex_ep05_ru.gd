	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("skuld","talk",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ты... впечатляешь.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Неудивительно, что вам удалось настроить своих идиотов-похитителей друг против друга в нежном десятилетнем возрасте.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Увидев самодовольное выражение лица Мариру, блондинка не могла не ответить.")
