	await novel_interface.show_dialog("Подождите, на люстре вообще нет микрокамеры, я уверен?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру усмехается, кладя руку на плечо расстроенной девушки.")
