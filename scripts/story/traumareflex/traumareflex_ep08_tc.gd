	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("（嗚嗚，要是安妮在就好了……）","小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("話說我手中這把是……KRISS？","小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("短劍衝鋒槍，以超低的後座力聞名，次音速的子彈也能夠保護耳膜，被莉琉戲稱為「噴水槍」。")
	await novel_interface.show_text_only("……誰像她總喜歡用那種大炮似的玩意啊！！")
