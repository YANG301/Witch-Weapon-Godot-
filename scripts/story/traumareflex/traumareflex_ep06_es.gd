# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("—¡Auge!")
	await novel_interface.show_text_only("Otra explosión más. La parte delantera de nuestro camión se levanta abruptamente y yo soy arrojado al suelo.")
	await novel_interface.show_text_only("El exterior del camión, fortificado con la mágica Sustancia H, apenas se ve afectado, pero aún podemos sentir la fuerza aplastante desde el interior.")
	await novel_interface.show_text_only("Mientras el camión rueda hacia un lado, mi estómago se retuerce. Se siente como si pudiera vomitar en ese mismo momento.")
	await novel_interface.show_text_only("Cierto... el blindaje del camión puede ser invencible, pero el suelo ciertamente no lo es. Simplemente explote el suelo y el camión quedará inmóvil.")
	await novel_interface.show_text_only("Qué diseño más tonto e inútilmente caro...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Un dolor de cabeza...")
	await novel_interface.show_text_only("Me zumban los oídos y los ojos apenas pueden enfocar.")
	await novel_interface.show_text_only("Afortunadamente, llevo una chaqueta de combate llena de líquido no newtoniano, de lo contrario probablemente me habría roto la mayoría de los huesos durante el desastre anterior.")
	await novel_interface.show_text_only("No sé quién eligió el equipo para mí, pero supongo que debería estar agradecido.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Aun así, ¿tuvieron que obligarme a usar medias de seda?)\n(¡Y ahora tienen agujeros!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Bam! ¡Bam! ¡Bam! ¡Bam! ¡Bam!")
	await novel_interface.show_text_only("Fabella abre con un puñetazo la tapa del botón de salida de emergencia del coche. Los cordones detonantes del techo del camión explotan uno tras otro.")
	await novel_interface.show_text_only("Aparece un gran agujero en el techo, ahora colocado hacia un lado. Humo acre y llamas invaden mi nariz y el interior del vehículo.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Maldita sea... ¡todos fuera!","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Tosiendo* Oye, ¿está bien el novato?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aún apenas aferrándome a la conciencia, Fabella me levanta y me arroja fuera del camión.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("El humo me quema los ojos, haciéndome llorar incontrolablemente y bloqueando mi visión.")
	await novel_interface.show_text_only("Tomo dos grandes bocanadas de aire pero solo sale humo. Mis pulmones están a punto de arder...")
	await novel_interface.show_text_only("Empiezo a toser y a sentir arcadas por reflejo, incapaz de recuperar el aliento.")
	await novel_interface.show_text_only("Mi cuerpo se sacude mientras me ahogo, mis ojos finalmente se encuentran con la máscara que cuelga de mi cuello. Rápidamente lo presiono sobre mi nariz y boca con una mano.")
	await novel_interface.show_text_only("Uf...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Departamento de Medicación Experimental, Harima Tech>")
	await novel_interface.show_text_only("Después de repasar conmigo los detalles básicos sobre Fabella, Mariru y Aya bajan las escaleras para ajustar algunos equipos, dejándome sentada allí sola.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Entonces simplemente… ¿se fueron? ¿Así?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los silenciosos pasillos del hospital parecen opresivos de repente.")
	await novel_interface.show_text_only("Me siento allí en una silla junto a la pared, vestida con un traje de mucama totalmente fuera de lugar.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Me siento como si estuviera en un juego de disparos de zombies con clasificación R...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No. Los zombis no existen. Los fantasmas, por otro lado...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Sí, jaja. Los zombis no...","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Espera, ¿quién era ese?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me levanto de un salto ante la repentina voz que viene desde las escaleras.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Lo siento, ¿te asusté?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Una niña pequeña se asoma desde la esquina.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¡Y nos volvemos a encontrar, señorita Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El cabello rubio de la niña cae hasta su cintura en una delicada trenza. Parece etérea, como algo fuera de este mundo. No es un aura que pueda olvidar jamás.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ah, ¿Skurd?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(¿Me llamó... Señorita?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld me sonríe tímidamente. Parece ansiosa, inquieta.")
	await novel_interface.show_text_only("Para nada elegante y gracioso, como cuando nos conocimos en el Sky Hotel.")
	await novel_interface.show_text_only("¡Ah, claro! Fabella es su doncella. Por supuesto que estará preocupada...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Sé que estás aquí porque Mariru te hizo venir...\nPero te hubiera preguntado de todos modos...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella parece vacilante, temblando un poco, valientemente aguantando las lágrimas mientras habla.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Por favor... salven a Fabella...","Skuld")
	await novel_interface.show_dialog("Todo fue mi culpa por hacerla escaparse conmigo...","Skuld")
	await novel_interface.show_dialog("No esperaba que esto sucediera...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("¡Oye, cálmate!","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(¡Oh no, ella va a llorar!)\n(¿Qué hago?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Casi extiendo una mano para consolarla, pero simplemente no me parece bien abrazar a una niña pequeña… en el pasillo de un hospital a medianoche… vestida con ligas y traje de mucama.")
	await novel_interface.show_text_only("Hago una pausa, con los brazos en el aire, y ella se lanza contra mi pecho.")
	await novel_interface.show_text_only("Su suave cabello rubio cae sobre mis codos. La niña huele un poco a leche. Los latidos de mi corazón se aceleran y mi cerebro zumba.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(¡Es tan pequeña!)\n(¡Qué lindura!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aquí, con su rostro enterrado en mi pecho, parece más pequeña de lo que parecía. Su frágil cuerpo tiembla, como un animal acorralado.")
	await novel_interface.show_text_only("Mmm. ¿Aya mencionó algo sobre hackear cerebros? No lo recuerdo. No me importa.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("¡Yo te ayudaré! ¡Definitivamente te ayudaré!\n¡Déjamelo todo a mí!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe ha dejado de funcionar. Yo diría que sí a cualquier cosa que ella me pida que haga. Incluso bombardeando el Senado...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Está bien. Estoy justo aquí.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soy horrible consolando a los demás. ¿De qué le servirá a ella estar “justo aquí”? Quién sabe, ¿pero la gente no suele decir cosas así en este tipo de situaciones?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Sí.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En mi abrazo, Skuld asiente suavemente.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Creo en ti. Puedes hacerlo.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿En serio? ¿Puedo?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Porque... eres esa persona especial... en mis recuerdos.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Está bien... espera, ¿qué?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Yo, ¿especial? ¿Mi traje de sirvienta le dejó una gran impresión?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld se calma un poco, se seca las lágrimas y me mira con ojos llenos de confianza.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Puedo contarte todos mis secretos.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Qué... inesperado. No tengo idea de cómo reaccionar.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Puede que te resulte difícil de creer, pero por favor escucha.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La niña pequeña y frágil frente a mí de repente se pone sobria y no puedo evitar inclinarme, sintiéndome muy serio.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Tengo una... habilidad realmente especial.","Skuld")
	await novel_interface.show_dialog("Puedo recordar cosas que aún no han sucedido... o debería decir... hay algunas cosas que aún no han sucedido, pero ya puedo verlas, como recuerdos.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("¿Recuerdos... que aún no han sucedido?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Esos fragmentos han existido en mis recuerdos desde el principio, por lo que ni siquiera puedo decir qué recuerdos son del pasado y cuáles son del futuro.","Skuld")
	await novel_interface.show_dialog("Tengo que verlo para estar seguro.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("¿Entonces es como una profecía?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esto suena increíble, pero he pasado por tantas locuras estos meses que ya me he acostumbrado a creer seis cosas imposibles antes del desayuno.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Es como... un caramelo. Un poco dulce, un poco ácido, deja un sabor a menta en la boca cuando se derrite.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hm, he comido ese tipo de dulces antes, pero no estoy seguro de cuándo...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¡Así es!","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Puedes describir en detalle cómo sabe ese dulce, pero no puedes decir cuándo ni dónde lo probaste.","Skuld")
	await novel_interface.show_dialog("Solo te darás cuenta de “oh, esto es todo” cuando realmente lo pruebes un día.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Creo que estoy empezando a entender. Si en tus recuerdos existen fragmentos que pueden ser del pasado o del futuro, sería difícil saber cuál es cuál.")
	await novel_interface.show_text_only("No es ver el futuro, para ser exactos. Porque no puede decir qué recuerdos son del futuro.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Espera... ¿pero seguramente ella podría resolverlo con algunas pistas en el entorno?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es como si Skuld leyera mi mente. Ella explica:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Podrías estar pensando: es cierto que es posible que no puedas saber si algo sucedió en el próximo mes o en el último, pero el entorno dentro de diez años seguramente se verá muy diferente de lo que es ahora, ¿verdad?","Skuld")
	await novel_interface.show_dialog("Pero los recuerdos... no son como secuencias de video. Todo lo que tenemos son fragmentos...","Skuld")
	await novel_interface.show_dialog("Nuestros cerebros sólo pueden reconstruir toda la escena de un recuerdo cuando nos concentramos mucho en él, ¿sabes?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tiene sentido. Recuerdo esta línea de una película:")
	await novel_interface.show_text_only("“Los recuerdos son interpretaciones, no grabaciones.”")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Por lo tanto, en realidad no es tan fácil encontrar fragmentos en mis recuerdos que me permitan determinar el período de tiempo.\nAdemás...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("No sueles ahondar en tus recuerdos sin ningún motivo, ¿verdad?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("¿Mmmm?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Por ejemplo, no recordarás tu clase de matemáticas de la escuela primaria y lo que la maestra escribió en la pizarra, solo por diversión, ¿verdad?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Por supuesto. Clase de matemáticas... profesores... ciertamente no es divertida.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Te creo, es simplemente... guau. Eso es increíble.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Espera. Entonces, el “yo” en tus recuerdos que acabas de mencionar...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld asiente.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("De todos modos, solo hay una cosa en mis recuerdos que estoy seguro sucedió en el futuro.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Contengo la respiración. De repente tengo la sensación de que puedo adivinar a qué se refiere...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... Es un recuerdo del momento en que se acaba el mundo.","Skuld")
	await novel_interface.show_dialog("Pero en ese recuerdo, eres un niño.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
