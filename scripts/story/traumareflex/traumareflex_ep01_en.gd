@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第01话剧本
	traumareflex_ep01_script()

func play_script():
	pass

# 创伤反射篇第01话 - 正式剧本
