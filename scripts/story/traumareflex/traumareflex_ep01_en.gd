	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Isn’t it the second Forum of Peace already? It’s clearly useless.","Male B")
	await novel_interface.show_dialog("Two to three explosions still occur every week just two miles from the Third Academy City.","Male B")
