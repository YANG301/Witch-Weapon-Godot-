	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Not my fault Max bought twenty issues at once.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("So Mariru was already really popular two years ago? I’d love to see that magazine too...")
	await novel_interface.show_dialog("Heard she’s got curves in all the right places.","Male Voice A")
	await novel_interface.show_text_only("You’re fantasizing about the body of a scientist? Is being made into a specimen your kind of kink?")
