	await novel_interface.hide_character()
	await novel_interface.show_dialog("If it weren’t for that thing that appeared out of nowhere and swallowed twelve fleets of aircraft carriers, the Council wouldn’t even exist anymore.","Male Voice A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Who knows, maybe it’s connected to Russel’s mama’s kitchen, eh?","Male C")
	await novel_interface.hide_character()
