	await novel_interface.show_text_only("Some coughing from the passenger’s seat interrupts my thoughts.")
	await novel_interface.show_dialog("Fabella’s right! Oh, by the way, wasn’t there this new emerging scientist in New Opulentia called... Marie or something?","Male Voice A")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Mariru. I remember her!","Cassel")
	await novel_interface.show_dialog("She was on the cover on the previous issue of the Science magazine! Wearing black stockings. Yum! Those nerds in the research department were all drooling.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
