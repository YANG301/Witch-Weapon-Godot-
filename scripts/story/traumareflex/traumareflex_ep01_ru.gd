# traumareflex_ep01.gd - 创伤反射篇第01话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第01话剧本
	traumareflex_ep01_script()

func play_script():
	pass

# 创伤反射篇第01话 - 正式剧本
func traumareflex_ep01_script():
	novel_interface.show_background("res://assets/images/bg/Fabiola/Brain.png")
	await novel_interface.show_text_only("Анозогнозия —")
	await novel_interface.show_text_only("Состояние, при котором человек в течение определенного периода времени не может ощущать потерю определенной органической функции.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	await novel_interface.show_text_only("Например, слепой человек верит, что он все еще может видеть, и на самом деле может ярко описать свое воображаемое окружение.")
	await novel_interface.show_text_only("Парализованный человек верит, что он все еще может двигать конечностями как обычно, до такой степени, что он думает, что все остальные двигают конечностями точно так же.")
	await novel_interface.show_text_only("Клинически это явление называется Антоновской слепотой.")
	await novel_interface.show_text_only("Мозг, чтобы дать разумное объяснение непостижимой ситуации, генерирует серию изображений, чтобы убедить тело, что все в порядке.")
	await novel_interface.show_text_only("Возможно, это врожденный рефлекс, которым обладают все люди.")
	await novel_interface.show_text_only("Древний защитный механизм от неизведанного, запрограммированный в наших генах.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("…")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	await novel_interface.show_text_only("У меня болит голова.")
	await novel_interface.show_text_only("Очень сильная головная боль.")
	await novel_interface.show_text_only("Такое ощущение, будто кто-то залил мне в мозг мешок цемента и сейчас его помешивает.")
	await novel_interface.show_text_only("В мозгу гудит, в ушах звенит.")
	await novel_interface.show_text_only("Я... внутри?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur.png")
	await novel_interface.show_text_only("Я моргаю, открываю глаза, зрачки постепенно привыкают к яркому окружению.")
	await novel_interface.show_text_only("Однако мои уши, кажется, еще не привыкли. Такое ощущение, будто все звуки приглушены, доносящиеся издалека-далека.")
	await novel_interface.show_text_only("В воздухе пахнет одеколоном, смешанным с кожей, и ржавым, медным ароматом.")
	await novel_interface.show_text_only("В узком пространстве, обтянутом тяжелой обшивкой, расположены два ряда сидений, обращенных друг к другу. Сидящие на них солдаты переругиваются, смеются.")
	await novel_interface.show_text_only("У них нет установленной униформы, но по круглым светящимся устройствам IFF, которые они носят, легко определить, что они принадлежат к одному и тому же подразделению.")
	await novel_interface.show_text_only("Характеристика отряда специального назначения под командованием Ритналапа, разведывательной организации во Втором Академгороде.")
	await novel_interface.show_text_only("Если я прав, я нахожусь в брюхе спецназа F-950...")
	await novel_interface.show_text_only("Несколько лет назад миллиардер купил один из этих непомерных бронетранспортеров и отремонтировал его, чтобы он больше походил на роскошный ночной клуб, чем на военную машину.")
	await novel_interface.show_text_only("Затем он приказал нескольким другим стрелять по грузовику из оружия, в то время как он сидел внутри и потягивал шампанское с несколькими дамами.")
	await novel_interface.show_text_only("Видео стало вирусным в сети, принеся широкую известность этому бронетранспортеру спецназа, усиленному веществом H.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/NewMoridas.png")
	await novel_interface.show_text_only("На экране проектора в транспортном средстве в реальном времени воспроизводится запись, снятая камерой на крыше грузовика.")
	await novel_interface.show_text_only("Огни города выглядят потрясающе под ночным небом. В поле зрения находятся десятки небоскребов, которые все еще строятся.")
	await novel_interface.show_text_only("Кажется, что стальные прутья уходят в небо — словно символы, олицетворяющие бесконечную, обнаженную жадность людей.")
	await novel_interface.show_text_only("За группами пронзающих небо зданий на горизонте маячит гигантское черное полушарие, известное как Темное Царство.")
	await novel_interface.show_text_only("Под управлением Комитета семнадцати джентльменов этот Академгород сохранил свою позицию мирового экономического и финансового центра даже после войны.")
	await novel_interface.show_text_only("Верно, я сейчас здесь. Второй Академгород: Ньюморидас.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("<Несколько часов назад>")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Итак... вы хотите, чтобы я взломал мозг цели и получил доступ к ее воспоминаниям?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Проще говоря... да.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","bored")
	await novel_interface.show_dialog("Подождите, это вообще осуществимо?","Ren")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Устройство, которое может подключаться к мозгу...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Неважно, передает ли он воспоминания на сервер или предоставляет нам доступ к чьим-то мыслям...")
	await novel_interface.show_text_only("Это просто небезопасно! Я видел подобные устройства во множестве аниме и фильмов, но они никогда не работали хорошо!")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Эй, не перекручивай трусики.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Это экспериментальное устройство, предоставленное Harima Tech. Создан специально для сбора информации — или лучше сказать, для допроса?","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Кроме того, я сам обновил отказоустойчивую систему. Даже если травмы или смерть произойдут внутри головы цели, в реальной жизни вам не причинят вреда.","Aya")
	await novel_interface.show_dialog("Вы будете автоматически разбужены после шести часов соединения. Это совершенно безопасно.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Э, ладно...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я изо всех сил стараюсь убедить себя, что если Ая выглядит так уверенно, значит, все в порядке.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Слушай, при подключении к устройству у тебя нет реального присутствия. Ты здесь просто для того, чтобы наблюдать, как... призрак.","Mariru")
	await novel_interface.show_dialog("Что вам нужно сделать, так это найти ключевую информацию в воспоминаниях цели. Не оставляйте ни одного камня на камне.","Mariru")
	await novel_interface.show_dialog("Цель в настоящее время находится на высоком уровне комы. Мы мало что знаем о ее прошлом, поэтому не знаем, в какой части ее памяти она сейчас застряла.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Это означает, что вам нужно обращать внимание на каждую деталь... даже если ваша цель в душе!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Эй, я не хочу быть вуайеристом!","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Только не смотри туда, куда не следует.","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Хм…","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_stare",0.25)
	await novel_interface.show_dialog("Хорошо, я понял!","Aya")
	await novel_interface.show_dialog("Жаль, что это устройство не вызывает нервную стимуляцию, иначе вы тоже сможете взаимодействовать с окружающей средой...","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ая уже увлекается воображением.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Эй, о чём бы ты ни думал, я этого не делаю!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру сворачивает несколько бумаг и бьет ими Аю по спине.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Кажется, теперь я проник в воспоминания цели.")
	await novel_interface.show_text_only("Я думал, это будет что-то вроде шутера от первого лица...")
	await novel_interface.show_text_only("Но на самом деле все гораздо сложнее.")
	await novel_interface.show_text_only("Все размыто. Мне приходится сильно щуриться, чтобы хотя бы сосредоточиться.")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("Прямо сейчас я нахожусь в бронированном грузовике с несколькими любителями. Я напрягаю слух, чтобы прислушаться к их разговору.")
	await novel_interface.show_dialog("Объединённый Конгресс уже больше года находится в состоянии перемирия. Но остальные страны мира продолжают бороться безостановочно.","Мужской голос А")
	await novel_interface.show_dialog("Лидеры шести стран, входящих в Объединённый совет, прямо сейчас проводят Международный форум мира. Пока мы говорим, толпы протестующих маршируют по Первой авеню.","Мужской голос А")
	await novel_interface.show_text_only("Я слышу грубый мужской голос, доносящийся с пассажирского сиденья, но не могу сказать, как он выглядит с моей точки зрения.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Разве это уже не второй Форум Мира? Это явно бесполезно.","Мужчина Б")
	await novel_interface.show_dialog("Два-три взрыва по-прежнему происходят каждую неделю всего в двух милях от Третьего Академгорода.","Мужчина Б")
	await novel_interface.show_dialog("Моя тетя, которая там живет, уже к этому привыкла. Даже дети в этом районе уже почти не реагируют на взрывы.","Мужчина Б")
	await novel_interface.show_text_only("Следующим говорит человек, бледнокожий мужчина лет тридцати-сорока с безупречными каштановыми волосами.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Хм. Год спустя после перемирия. И второй Международный Форум Мира...")
	await novel_interface.show_text_only("Это позволяет мне датировать это воспоминание примерно двумя годами ранее.")
	await novel_interface.show_text_only("Ведь в следующем месяце в Новой Опулентии пройдет четвертый Международный Форум Мира.")
	await novel_interface.show_text_only("Я помню, как Мариру ворчала на прошлой неделе о том, что в Согласованной демилитаризованной зоне, вероятно, будет беспорядок, когда придет время.")
	await novel_interface.show_dialog("Эти террористы... они с ума сошли!","Мужской голос А")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Достаточно взглянуть на новые планы городской обороны в Масаде. Такое ощущение, что они стремятся превратить свой город в суперкрепость или что-то в этом роде.","Мужчина C")
	await novel_interface.show_text_only("Мужчина, сидящий напротив меня, на вид лет двадцати, с загорелой кожей и шарфом со скелетным узором.")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Эх, война слишком распространена в Масаде. Кто знает, может быть, на их головы однажды упадет еще одна ядерная бомба.","Мужчина Б")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("О, кстати, вы, ребята, слышали? Те, что в Совете...","Мужской голос А")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Эти люди? Что с ними сейчас?","Мужчина Б")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Они разрешают добровольцам совершать экспедиции в Темное Царство!","Мужской голос А")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("О, вы имеете в виду ту жуткую черную куполообразную штуку возле Лонг-Айленда?","Мужчина Б")
	await novel_interface.show_dialog("Ничего из того, что туда попадает, никогда не выходит наружу, даже дроны.","Мужчина Б")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Если бы не та штука, которая появилась из ниоткуда и поглотила двенадцать флотов авианосцев, Совета бы вообще не существовало.","Мужской голос А")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Кто знает, может быть, это связано с кухней мамы Рассела, а?","Мужчина C")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Посмотри, кто говорит, Кассель! Возможно, он ведет на другую планету. Знаешь, тот, из которого ты пришел.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Хм. Люди сейчас требуют войти в Темное Царство? Куча идиотов, у которых слишком много свободного времени.","Женский голос")
	await novel_interface.show_text_only("Подождите, это говорила девушка?")
	await novel_interface.show_text_only("Особенно неуместно это звучит в какофонии грубых мужских голосов.")
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_text_only("Я следую за звуком и замечаю розоволосую девушку, спрятавшуюся за широкими плечами Касселя, в берете и очках в красной оправе.")
	await novel_interface.show_text_only("Я сразу узнаю ее по очкам. Она наша цель — Фабелла, девушка, которую я однажды встретил в отеле Sky.")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мои мысли прерывает кашель с пассажирского сиденья.")
	await novel_interface.show_dialog("Fabella’s right! О, кстати, разве в Новой Опулентии не было нового начинающего ученого по имени... Мари или что-то в этом роде?","Мужской голос А")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Мариру. Я помню ее!","Cassel")
	await novel_interface.show_dialog("Она была на обложке предыдущего номера журнала Science! Ношение черных чулок. Ням! Все эти ботаники из исследовательского отдела пускали слюни.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Ты читаешь журнал Science? Думаешь, ты сможешь найти девушку с квантовой физикой или чем-то еще?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Не моя вина, что Макс купил сразу двадцать номеров.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("То есть Мариру уже была очень популярна два года назад? Я бы тоже хотела посмотреть этот журнал...")
	await novel_interface.show_dialog("Слышал, что у нее изгибы во всех нужных местах.","Мужской голос А")
	await novel_interface.show_text_only("Вы фантазируете о теле учёного? Превращение в образец - это твоя извращенность?")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Капитан наблюдает за тобой!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","normal")
	await novel_interface.show_dialog("Ух. Ты безнадежен. Увидишь симпатичную девушку и сразу потеряешь все клетки мозга.","Fabella")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Тебе лучше быть осторожным, иначе однажды тебя бросят голым на кладбище машин, как в тот раз, когда ты заходил на сайт знакомств.","Fabella")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Можно было подумать, что ты занимался сексом с тем Чероки 1962 года. Она достаточно взрослая, чтобы быть твоей бабушкой, да?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Ха, Босс, хватит поджаривать беднягу. Весь южный филиал уже знает об этом.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Босс? Подождите, эта девочка-подросток — босс этого отряда специального назначения?")
	await novel_interface.show_text_only("Она совсем не похожа на ту горничную, которую я видел в прошлый раз. Что произошло между тем и сейчас?")
	await novel_interface.show_text_only("Нет, подожди. Это было два года назад. Поэтому я должен был сказать: что произошло между сейчас и потом?")
	await novel_interface.show_text_only("В общем, я нашел свою цель. Однако мое зрение все еще немного затуманено, и у меня все еще сильно болит голова.")
	await novel_interface.show_dialog("Ой, да ладно, заткнись!","Мужской голос А")
	await novel_interface.show_dialog("Кхм... в любом случае, разве сегодня к нашей команде не присоединится новичок?","Мужской голос А")
	await novel_interface.show_dialog("Так что давайте не будем шутить. Первое впечатление важно...","Мужской голос А")
	await novel_interface.show_text_only("Новичок?")
	await novel_interface.show_text_only("В таких боевых отрядах члены команды должны быть синхронизированы, чтобы хорошо работать вместе. Новичок может встряхнуть всю динамику.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Малыш, ты безостановочно ерзал. Что с тобой?","Russel")
