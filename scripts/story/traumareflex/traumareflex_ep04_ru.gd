# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ну, вернёмся — нет, это не так...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("С возвращением, М-мастер...","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Всё равно звучит странно...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("В любом случае...","Ren")
	await novel_interface.show_dialog("Почему я должен подрабатывать в горничной?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что это за секретная миссия? Держу пари, Мариру просто хочет посмотреть, как я страдаю!")
	await novel_interface.show_text_only("Горничная в районе посольства действительно довольно популярна, и я тоже читал об этом статьи в Интернете.")
	await novel_interface.show_text_only("Элегантная атмосфера, вкусная еда, классная посуда... и, что не менее важно, горничные все очень милые!")
	await novel_interface.show_text_only("Но я из тех, кто легко смущается, если девушка называет меня «Мастер», поэтому я никогда не ходил.")
	await novel_interface.show_text_only("Я тогда был таким наивным...")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("Потому что теперь я буду называть других «Мастерами» — и это еще более неловко!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(И этот наряд горничной такой излишне сложный!)","Ren")
	await novel_interface.show_dialog("(Начнем с того, что юбка и так довольно короткая...)\n(А теперь, с кринолином, чтобы ее надуть, она стала еще короче! Как они хотят, чтобы я ходил?)","Ren")
	await novel_interface.show_dialog("(И подвязки... я их впервые ношу.)\n(Итак, застежка... она идет на талии, да?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на белые кружевные подвязки на своих ногах.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(Так вот как подвязки выглядят от первого лица...)\n(... Хм, довольно мило!)","Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Дайте мне сделать снимок. Никто не должен знать!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Щелкни!")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Кхм, позвольте мне еще немного попрактиковаться...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Если меня уволят еще до того, как я смогу пройти обучение, Мариру, вероятно, затопчет меня до смерти.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("С возвращением, Мастер!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Что бы Хозяин хотел, чтобы я написал на твоем омлете, ня?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ох, это так неловко!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ладно, попробуем еще раз...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ах, уже поздно. Надо переодеться в этот нелепый наряд и пойти спать...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Этот наряд горничной тебе идет.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Да! Из тебя выйдет такая хорошая горничная!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я выхожу из ванной и обнаруживаю Мариру и Аю на диване в моей квартире, выглядящие невероятно удивленными.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Мариру? И Айя тоже?","Ren")
	await novel_interface.show_dialog("Когда... когда ты сюда приехал?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("На самом деле мы здесь уже давно.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Итак... моя практика...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Конечно, мы всё это слышали!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("Убей меня сейчас...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ой... вообще, что ты здесь делаешь?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Конечно же, наблюдать, как ты наряжаешься горничной и разыгрываешь все свои фантазии перед зеркалом!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Тебе обязательно было это так выразиться?\n(Хотя она не ошибается, я полагаю...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Я не виноват, что мне приходится готовиться к секретной миссии, которую вы мне поручили.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ты действительно думаешь, что станешь хорошей горничной, просто повторив несколько строк? Это не так-то просто, знаешь ли.","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Вертолет ждет на крыше. Пойдем.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А? У тебя есть для меня задание? В такое время ночи?\nПодожди секунду, пора переодеваться...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Всё в порядке. Наша цель в этой миссии на самом деле тоже горничная, так что вы отлично впишетесь.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она только что ухмыльнулась? Она определенно это сделала! Фу!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Но... этот наряд...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Никаких проблем. Когда вы в последний раз столкнулись с целью, вы тоже были одеты в костюм горничной.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Просто пойдем с нами, и ты увидишь.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Мы втроем едем на вертолете в большое медицинское учреждение, которое в настоящее время полупустое, так как большая часть персонала разошлась по домам.")
	await novel_interface.show_text_only("В здании тихо, если не считать шума жужжащих машин на заднем плане. Наши шаги эхом отражаются от тихих, побеленных стен.")
	await novel_interface.show_text_only("Никого не видно. Ярко освещенные коридоры почему-то кажутся еще более жуткими, чем кромешная тьма.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Это... больница?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я мог сказать, что это, должно быть, тайная операция, поскольку оба пилота вертолета были агентами, с которыми я знаком.")
	await novel_interface.show_text_only("Мариру сама редко участвует в миссиях, но очевидно, что на этот раз она хочет добиться того, чтобы чем меньше людей об этом знало, тем лучше.")
	await novel_interface.show_text_only("Еще я заметил, что все камеры видеонаблюдения здесь повернуты лицом к стенам.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Это отдел экспериментальных препаратов исследовательского центра Harima Tech.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("На этот раз личность нашей цели чрезвычайно деликатна. Миссия совершенно секретна, даже Сенат не может знать.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Харима Тек... разве он не принадлежит Сенату?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Во время обучения SID мне приходилось запоминать названия всех организаций, которых следует избегать. Harima Tech – одна из них.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("А разве доктор Брайт не был здесь исследователем?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("О, этот человек-горилла? Сейчас он обосновался самостоятельно. Это место больше не имеет к нему никакого отношения.","Mariru")
	await novel_interface.show_dialog("Это отдел практических исследований. СИД заказов у ​​такого рода организаций очень много.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Мы заказали здесь много спецтехники! На самом деле, большинство зданий этого ведомства построены исключительно для...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("За деньги. Айе не обязательно это говорить.")
	await novel_interface.show_text_only("Ха, очень... надежные отношения между покупателем и продавцом, да?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Нашу цель зовут Фабелла. Вы встречали ее однажды, еще на миссии в отеле Sky.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Это горничная, которая отвела тебя в сторону и отругала за неуклюжесть.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("О, она? Я помню. Она носила очки в красной оправе, верно? И она работала на маленькую девочку...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Верно. Скурд Аксельрод. Единственная дочь высокопоставленного члена Второго Академгородского комитета.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Она написала нам четыре часа назад через прачечную самообслуживания.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Значит, она хочет... предать свой народ?","Ren")
	await novel_interface.show_dialog("(Разве Скульд не очень молода? Насколько я помню, она, вероятно, того же возраста, что и Эллука...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Основываясь на том, что нам рассказал Скульд, нашей спасательной группе удалось найти Фабеллу без сознания в церкви в Согласованной демилитаризованной зоне.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("В ее крови мы обнаружили комплексные соединения диэтиламида лизергиновой кислоты. На территории церкви также были обнаружены устройства для распределения химических аэрозолей военного назначения.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Галлюциногенное химическое оружие, да? Я вижу очень изобретательный метод заставить ваших врагов напасть друг на друга.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Это был теракт?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Нет, больше похоже на ловушку для мух.","Mariru")
	await novel_interface.show_dialog("Скульд уже рассказал нам. Фабелла — ведьма.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("А?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Теперь я вроде как понимаю, почему меня попросили приехать сюда в полночь.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("После того, как мы нейтрализовали галлюциногены в организме Фабеллы, она все еще находится в глубокой коме...","Aya")
	await novel_interface.show_dialog("Мы не смогли ее разбудить даже после инъекции большого количества леводопы.","Aya")
	await novel_interface.show_dialog("Уровень ее клеточного метаболизма стремительно растет, а температуру тела... мы не смогли ее контролировать, даже погрузив ее в ледяную воду.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Любой нормальный человек потерял бы большую часть своих органов в таких условиях, но ее тело, похоже, обладает невероятной устойчивостью к высоким температурам.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Скульд рассказал нам, что Фабелла — огненная ведьма. Обладает магией огня.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Одержим?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Этот термин кажется мне странным.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Согласно нашему анализу данных, которые мы собрали в настоящее время, мы можем рассматривать магию как поле, которое манипулирует «информацией».","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Фабелла не похожа на Эллуку, которая может напрямую управлять электрическими полями. Ее ситуация больше похожа на то, что «определенная мощная информация» решила овладеть ею.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Вы говорите так, как будто информация имеет собственную волю.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Да. Если строка информации имеет достаточно высокую плотность и достаточно низкое значение энтропии, она может обрести волю.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Когда Фабелла потеряла сознание, «живая информация» начала овладевать ее телом...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В каком-то смысле это напоминает мне ту новостную статью, в которой хозяина, находящегося в коме, съел собственный питомец. У меня мурашки по коже от одной мысли об этом.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Вскоре я понял, что причина, по которой мы не смогли ее разбудить, заключалась в том, что она уже «проснулась».","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Мы просканировали ее гиппокамп и префронтальную кору, и они оба были заняты на работе, как будто она о чем-то вспоминает.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Однако ствол ее мозга не посылал никаких эффективных рефлексивных сигналов. Как будто что-то блокирует это.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Слова Аи звучат стремительно. Она звучит слишком нетерпеливо.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("И когда мы просканировали ее мозг с помощью датчика Больцмана, мы обнаружили признаки мутаций...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Подожди... ты имеешь в виду, что ведьмы коконы... в ее мозгу?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Бинго!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Я подумал, что у нас есть устройство, которое позволяет нам, так сказать, взломать чей-то мозг. Harima Tech уже некоторое время разрабатывает его для SID.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Это всего лишь прототип, но он уже прошел альфа-тест.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Так я теперь твоя лабораторная крыса?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Вы — наша последняя надежда.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Мы уже отправили в мозг Фабеллы четырех агентов, но что-то продолжало их «отвергать».","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("Агенты описали это как «бесконечную стену, стоящую на пути».","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
