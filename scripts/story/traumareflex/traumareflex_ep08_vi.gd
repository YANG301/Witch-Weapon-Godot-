# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Thế giới này thật tàn khốc.")
	await novel_interface.show_text_only("Cuộc chiến mười năm trước khiến chúng tôi chẳng còn gì để sống.")
	await novel_interface.show_text_only("Có rất nhiều đứa trẻ giống tôi ở trại trẻ mồ côi—nhưng tôi vẫn nghĩ mình là người kém may mắn nhất.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Có lẽ tôi cảm thấy thứ mình đánh mất là quan trọng nhất. Nhưng rồi, có lẽ việc tôi đánh mất chúng khiến chúng càng trở nên quan trọng hơn?")
	await novel_interface.show_text_only("Tuy nhiên, thật khó để tôi, một người tị nạn được bảo vệ dưới Aegis, có thể tưởng tượng—")
	await novel_interface.show_text_only("Cuộc sống sẽ như thế nào, đối với những người phải tiếp tục sống sót trên chiến trường sau khi mất đi người thân.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Hừ... hừ...")
	await novel_interface.show_text_only("Hừ... hừ...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Tôi loạng choạng thoát ra khỏi làn khói dày đặc và ngồi xuống sau một chiếc ô tô bên đường, thở một cách khó nhọc vào chiếc mặt nạ của mình.")
	await novel_interface.show_text_only("Mặt đất được bao phủ bởi đống đổ nát. Tiếng la hét và tiếng nổ dường như đến từ mọi hướng.")
	await novel_interface.show_text_only("Qua làn khói và lửa, tôi vẫn có thể phân biệt được đoạn quảng cáo đầy màu sắc đang chiếu trên màn hình của một tòa nhà chọc trời ở xa.")
	await novel_interface.show_text_only("Tất cả dường như thật... siêu thực.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Tôi tự hỏi có bao nhiêu trải nghiệm kiểu này tồn tại trong ký ức của Fabella...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuộc sống của cô ấy quá khác so với tôi.")
	await novel_interface.show_text_only("Tôi đã trải qua một số khóa đào tạo sau khi gia nhập SID, nhưng nó chủ yếu liên quan đến chiến thuật và thao túng thông tin.")
	await novel_interface.show_text_only("Tôi chưa bao giờ tham gia một cuộc tập trận thực sự với súng và đạn thật. Ngay cả khi chúng tôi thực hành nhắm mục tiêu, tôi vẫn hướng về một số khẩu súng nhỏ hơn có độ giật yếu nhất. Mariru và Annie luôn cười nhạo tôi.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Giá như Annie ở đây...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Ừm. Khẩu súng trong tay tôi... có phải là KRISS không?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Một khẩu súng tiểu liên KRISS Vector, được biết đến với độ giật giảm. Đạn là loại đạn cận âm, loại không gây tiếng ồn. Không có gì ngạc nhiên khi Mariru gọi đây là súng lục nước dành cho những kẻ yếu đuối.")
	await novel_interface.show_text_only("... Này, không phải ai cũng thích mang súng to như cô ấy đâu, bạn biết không?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Loại vũ khí này... không tệ lắm, có lẽ tôi có thể xoay sở được...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn vào cuốn tạp chí mở rộng ở phía dưới và nuốt xuống.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Không. Tốt hơn hết hãy tắt sự an toàn ngay bây giờ. Tôi không muốn đánh đồng minh.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi lén nhìn ra ngoài, cố gắng quan sát tình hình ngoài kia.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, mọi chuyện ở đó ổn chứ?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Tài xế chết rồi! Đợi đã... cái quái gì thế?\nÔi chao, anh bạn vẫn còn thở!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Đắp mặt nạ phòng độc lên mặt anh ta và ném anh ta vào cốp xe. Sau đó lấy thiết bị của bạn và tìm chỗ ẩn nấp!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Các thành viên trong đội không hề ngần ngại. Fabella, mang theo một chiếc túi màu đen, nhảy sang phía bên kia chiếc xe mà tôi đang trốn phía sau.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Wow, không thể tin được vào mắt mình... cô ấy di chuyển nhanh quá!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel đặt boong trên cùng đã bay ra trong vụ nổ bởi một đống đá, tạo ra một vùng mù mà anh ta có thể sử dụng làm chỗ ẩn nấp và di chuyển qua đường.")
	await novel_interface.show_text_only("Vài giây sau, một chiếc ba lô khổng lồ bất ngờ rơi xuống từ làn khói, sau đó Cassel lăn qua và nhanh chóng biến mất vào bóng tối ở góc phố.")
	await novel_interface.show_text_only("Tình huống này có lẽ là chuyện dễ dàng đối với những thành viên trong đội đặc nhiệm như những anh chàng này. Rốt cuộc họ đều đã chiến đấu ở tiền tuyến.")
	await novel_interface.show_text_only("Nhưng lần này, thay vì vùng chiến sự, họ đang chiến đấu ở Thành phố Học viện thứ hai.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Hãy coi chừng đội quân máy móc và gửi máy bay không người lái để trinh sát môi trường.\nRussel, đã liên lạc được với Đội Alpha chưa?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Không có câu trả lời. Họ đang ở phía bên kia vụ nổ, cùng với “hành lý” của chúng tôi.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn theo ánh mắt của Russel. Con đường phía trước đã bị nổ tung thành những mảnh vụn có trật tự, trong khi chúng tôi bị mắc kẹt ở đâu đó gần giữa đường.")
	await novel_interface.show_text_only("Nhựa đường trên mặt đất đang bốc cháy như không có ngày mai, khiến thật khó để biết điều gì đang xảy ra phía trước.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Có ai chôn bom ở đây trước không?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Này! Người mới! Bạn thực sự nghĩ rằng trốn ở đó là an toàn?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—Huh?\n(Cô ấy đang nói chuyện với tôi à?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trước khi tôi kịp phản ứng, Fabella đã túm lấy cổ áo khoác của tôi và kéo tôi vào bóng tối phía sau máy ATM bên đường.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Thôi nào, kẻ địch có thể đưa bạn đến đó quá dễ dàng. Và bạn không biết họ sẽ bắn từ đâu.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trước khi tôi kịp trả lời, cô ấy ra hiệu cho Russel, người đang ở bên kia đường, trong khi Russel trả lời bằng cách giơ ngón tay cái lên.")
	await novel_interface.show_text_only("Vài giây sau, một vật thể bay hình đĩa màu xám bay lên từ phía sau xe nơi Russel đang ẩn náu.")
	await novel_interface.show_text_only("Fabella lấy ra một chiếc máy tính bảng nhỏ từ thắt lưng của mình và bắt đầu nghiên cứu tầm nhìn toàn cảnh về khu vực được máy bay không người lái chụp lại.")
	await novel_interface.show_text_only("Hai chiếc SUV dẫn đầu đoàn quân giờ chẳng còn gì ngoài những quả cầu lửa bốc khói.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Đám bảo vệ đó... chắc chết hết rồi. Ít nhất thì Đội Alpha và “hành lý” đã ở phía sau chúng tôi…","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên màn hình máy tính bảng chuyển sang trạng thái tĩnh, sau đó là một tiếng “bùm” điếc tai.")
	await novel_interface.show_text_only("Với âm thanh xèo xèo yếu ớt, chiếc máy bay không người lái màu xám bốc cháy trên bầu trời.")
	await novel_interface.show_text_only("Các bộ phận nhỏ của nó rơi xuống như mưa, đập vào nóc ô tô xung quanh chúng tôi tạo ra tiếng kêu kim loại.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Một tay bắn tỉa?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Phải ở tòa nhà đối diện. Có lẽ là sử dụng thiết bị tăng tốc điện từ chống gián điệp ở khoảng cách ngắn. Xem nơi bạn đang trốn. Hãy chắc chắn rằng chướng ngại vật bạn chọn đủ dày.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đó là một thiết bị đi kèm với đạn kim loại được tăng tốc ổn định bằng năng lượng điện từ. Cực kỳ mạnh mẽ, mặc dù thiết bị thường cồng kềnh và khó mang theo.")
	await novel_interface.show_text_only("Những viên đạn đó có thể xuyên qua những chướng ngại vật rất dày. Trong chiến tranh, một Thủ tướng đã bị giết ở khoảng cách hơn 0,3 dặm, mặc dù ông ta đang ở sau bức tường xi măng dày 3 foot. Đó là lý do loại thiết bị bắn tỉa toàn diện này trở nên nổi tiếng rộng rãi.")
	await novel_interface.show_text_only("Những thứ như thế này thực ra không phải là một phần trong quá trình đào tạo của tôi, tôi chỉ đơn giản biết về nó bởi vì nó nằm trong một trong những trò chơi yêu thích của tôi. Nó còn đi kèm với một lớp da độc quyền với mức giá cắt cổ.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Mắt rơi rồi! Tôi nhắc lại, Con mắt đã bị hỏng!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Tay bắn tỉa chắc phải ở cách chúng ta khoảng nửa dặm. Chúng tôi có một máy bay không người lái khác có bề mặt khúc xạ và nó được gắn một Mắt nhìn thấy mọi thứ. Họ có thể sẽ không chú ý nếu chúng tôi gửi cái đó.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Đợi đã, Con mắt nhìn thấu mọi thứ... bán kính thấu kính của nó là 15mm, phải không?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella hỏi khi cô ấy quan sát tòa nhà được chiếu sáng rực rỡ bằng một tấm phản xạ.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Vậy thì thấu kính vẫn có thể phản chiếu ánh sáng. Ngay cả khi trời tối. Chính xác thì chúng ta không thể phủ nó bằng một bề mặt khúc xạ ánh sáng.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Vậy là họ vẫn có thể phát hiện ra máy bay không người lái à... Và chúng ta không thể nổ súng vào tòa nhà như thế được. Đó là một tòa nhà dân cư chung và những người dân vô tội sống ở đó.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đối với một tay bắn tỉa làm việc với một thiết bị cồng kềnh, mất nhiều thời gian để nạp đạn thì ưu tiên hàng đầu là không bị kẻ địch (chúng ta) phát hiện.")
	await novel_interface.show_text_only("Tôi nhớ đã học về điều đó trong buổi huấn luyện chiến thuật.")
	await novel_interface.show_text_only("Tuy nhiên, tôi cũng nhớ một điều khác từ cùng một cuốn sách giáo khoa...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(Ưu tiên của họ là không bị phát hiện, điều đó đúng, nhưng... chẳng phải họ cũng nên cố gắng không cho chúng ta biết về sự tồn tại của họ sao?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Việc bắn máy bay không người lái của chúng tôi đương nhiên có nghĩa là chúng tôi sẽ biết về sự tồn tại của chúng.")
	await novel_interface.show_text_only("Điều này tất nhiên sẽ khiến họ trở thành mục tiêu. Dù đó là ai thì chắc hẳn là tân binh không biết mình đang làm gì—")
	await novel_interface.show_text_only("Hoặc ai đó đã tự tin rằng họ biết nơi để quay tiếp theo và có thể sơ tán ngay sau khi hoàn thành công việc.")
	await novel_interface.show_text_only("Tim tôi lỡ nhịp.")
	await novel_interface.show_text_only("Tôi nhảy lên theo bản năng, buộc Fabella xuống đất, tránh xa khối chắn mà cô ấy đang ẩn nấp phía sau.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Bạn đang làm gì vậy? Đồ ngốc—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ngay giây tiếp theo, khối chắn mà cô đang tựa vào vỡ tung thành từng mảnh.")
	await novel_interface.show_text_only("Sau khi phá hủy lớp vỏ bọc, viên đạn tiếp tục xuyên qua bức tường của tòa nhà, tạo ra một chỗ phình có kích thước 9 feet vuông trên tường.")
	await novel_interface.show_text_only("Các tấm bảng của máy ATM bị ném lên không trung. Vô số tờ tiền bay lên trời, cuối cùng rơi xuống mặt đất như những bông tuyết, trên nền là ánh đèn đường trắng xóa.")
	await novel_interface.show_text_only("Nó giống như một cảnh bước ra từ một bộ phim noir.")
	await novel_interface.show_text_only("Tôi nhìn vào, bị mê hoặc, nhưng Fabella đã kẹp hai chân qua eo tôi, khiến tôi lăn vào bóng tối do một đống gạch xi măng tạo ra.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Eh? Tại sao cô ấy lại giữ tôi lại?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bạn ổn chứ, Sếp?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("À, tôi ổn.\nMay mắn là người mới của chúng ta rất nhanh trí.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella trả lời, vỗ nhẹ vào má tôi. Có lẽ đó sẽ là một cử chỉ ngọt ngào nếu cô ấy không cưỡi lên tôi.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("Và tôi đã tìm ra cách để ống kính không bị phản chiếu ánh sáng.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy nói, đưa tay về phía đùi tôi—")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
