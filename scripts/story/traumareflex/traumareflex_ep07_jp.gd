# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("『世界が終焉を迎えた時』……の記憶？","レン")
	await novel_interface.show_dialog("（いやー待て待て、まさか……）\n\n（あの災厄は全世界に影響があったのかっ？）","レン")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("でも次の日には、みんな元気にしてたし──")
	await novel_interface.show_text_only("唯一「終焉を迎えた」のは、俺の……")
	await novel_interface.show_dialog("（うううう……）","レン")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("でもね、その記憶の中では、\nあなたは確か男の子だったんだけどね。","スクルド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("……えっ？","レン")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("どうしてなんだろうね……レンお姉ちゃん？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("えっと？　あ、あ～～！　\nそ、それは……いや――","レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("唖然としている中、しどろもどろと誤魔化すのを\n試みる。\n『女装変態男！真夜中に少女の病室に潜入！』\nというニューステロップが俺の脳裏に流れた。")
	await novel_interface.show_text_only("ゆっくりと近付いてきて、「観念なさい」と\n言わんばかりの得意げな表情を見せるスクルド。")
	await novel_interface.show_text_only("こっそり女の子の服を着て街へと出かけてみたが\nバレて暗い路地裏に追い詰められた……\n……そんな感じの今の俺。")
	await novel_interface.show_text_only("無意識に両腕で胸を守りつつ後退する。\n\n下の弱点にも気付き、すぐさまスカートを\n押さえてガードしようとした。")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("（っていうか、これ短いってッ！）\n\n（こんな短いので隠せるわけないだろッ！）","レン")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("（待てよ？　 俺は何を焦ってるんだ……？）","レン")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("お、俺は女の子だよ～～\nアハハハ……","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("今の俺は男だった時と比べ、外見に大きな\n差がある。")
	await novel_interface.show_text_only("しかもマリルが指揮した隠蔽工作は完璧なはず。\n\n例えトップクラスの情報機関が調査しても、\n以前の俺との関連性を結び付ける事は不可能だ。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("私の頭の中にある、廃墟と化した新豊洲の記憶。\n\nそこに立っていた後ろ姿は、間違いなく\n男の子だったよ。","スクルド")
	await novel_interface.show_text_only("スクルドは俺の前に来ると、俺の事を\nじっと見つめてきた。")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("白い光のあと、あたしはあなたの顔を見た。","スクルド")
	await novel_interface.show_dialog("たった一瞬だったけど……\n絶対に間違えたりしないわっ！","スクルド")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("あなたは、あたしの記憶の中にいた『あの人』","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("目の前の小さな女の子の勢いに押され、\n廊下の壁に背中がピッタリとくっ付く。")
	await novel_interface.show_text_only("なるほど。有名なファンタジー小説なんかで\nどれだけ壮大な世界観だったとしても、\n1人か2人しか予言者が出てこない理由が\n今になって分かった。")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("（もはやカンニングじゃないか……）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("……まあ、そうやって考えを決めつけても\n結局は支離滅裂なんだけどね。\n記憶は常に頭の中で霞がかってるから。","スクルド")
	await novel_interface.show_dialog("記憶の中で見た顔だけじゃ、\nあなたが男か女かちゃんと確認できないわ。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("少女は迫る身を少し引っ込ませ、\nようやく俺に息を吐く間を与えてくれた。")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("男の子だと思ったんだけど……抱き付いた時に\n確認できた。身体も、骨格も髪の毛も──","スクルド")
	await novel_interface.show_dialog("原因はまだ分からないけど、\nレンお姉ちゃんは今、正真正銘の女の子よ。","スクルド")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("それに……柔らかかったもんね～～！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドはイタズラな笑みを浮かべた。")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("や、やわらか……？　はっ！？！？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("抱き付いてきたり、俺の胸に顔を埋めたのは、\n俺の性別を確認するためにやったのかっ！？")
	await novel_interface.show_text_only("しかも、髪までチェックされていたなんて……")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("（またマリルに怒られそうな予感がする！！）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("それからスクルドは顔を上げ、咳払いをした。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("その……これでもうあたし達、秘密を交換した\n友達だよね？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女はおずおずと俺に尋ねた。\nその瞳から俺の返事を期待する光がうかがえる。")
	await novel_interface.show_text_only("心がキュッと締め付けられるような感じがした。\n\n今の状態が彼女の警戒心を解いた姿なんだ、と\n直感が俺に訴えかけてくる。")
	await novel_interface.show_text_only("彼女は小さい頃から、周囲の全ての人間を\n疑わざるを得ない環境にあったのだろうか？\nまだ12、3歳の小さな女の子だというのに……")
	await novel_interface.show_text_only("不鮮明な予言能力だけど、悪意を持つ連中ならば\n十分な利用価値があると考えるに違いない。")
	await novel_interface.show_text_only("この秘密が公然となれば、彼女が直面する立場は\n想像するに容易い。")
	await novel_interface.show_text_only("しかも、マリルの監視下にあるかもしれない\nこの状況で能力の事を話してくれた……")
	await novel_interface.show_text_only("できる事なら素直な自分でありたいと、\n望んでいるから。\nだからこうして話してくれたんじゃないかな？")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("うん……君の秘密はちゃんと守るから。","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は小指を伸ばし「指切り」のジェスチャーを\nする。")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("俺は君にとって『一番特別な』人だしな！！","レン")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（言ってはみたものの……）\n\n（アホ臭いセリフだったかも……）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは一瞬ポカンとした表情を見せたが、\n次にはパァッと笑顔を咲かせた。")
	await novel_interface.show_text_only("そして、俺達2人の小指は繋がった。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("愛衣がバーに入ると、窓際に置かれたソファーに\n座るマリルが酒の入ったグラスを、\n軽く揺らしてるのが見えた。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("プロトタイプ機の『安全装置』だけど、\nご要望通りに設定したわよ。","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("なんだ、早いじゃないか。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("レンちゃんの迷走神経のストレス反応を常に\n監視して、異常があれば即時接続を切断する……\nこのやり方は、ちょっと乱暴じゃないかな？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("確かに乱暴ではあるが、このやり方ですら\n「ヒューズ」の役割しか果たせないからな…\n今の科学界において、記憶に対する作用形態の\nノウハウは少なすぎる。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("あの映画のセリフのようになるかもよ？　\n\n「矛盾した記憶が現れたら、脳が焼失する」\nっていうさ……","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不穏な事を言いながらも、\n愛衣はワクワクしているのを隠さなかった──")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("何人か適当に被検体をひっ捕らえて、\nこっそり実験すればさ？\n一瞬で事実を究明できると思うんだけどなぁ～！","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルはグラスを高く持ち上げ、球状の氷を\n照明で透かして眺めた。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("私はそうと思わない──","マリル")
	await novel_interface.show_dialog("完全に矛盾した2つの記憶が同時に\n存在したとしても、\n人はいつでも自分のために都合良く解釈できる。","マリル")
	await novel_interface.show_dialog("「前世の記憶」やら「平行宇宙」やら、\nそんな言葉を借りて自分を慰める。\nもしくは自分が神託を受けたなどと\n言い放つだろう。","マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("それで熱心な信徒達を騙せるかもしれないしな。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("そうは言うけど……","愛衣")
	await novel_interface.show_dialog("播磨脳研の人に頼んでレンちゃんの前頭前皮質を\n活性化させないように要求したよね？","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("あれは記憶領域の完全シャットアウトが\n狙いじゃないの？\n彼女が目覚めた時、刺激が強い記憶を\n忘れさせてあげる処置としての。","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは振り返って、偽りの窓から見える夜景を\n眺める。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("ファビオラは幼い頃より少女兵として、\n南米の軍閥に引き取られた。","マリル")
	await novel_interface.show_dialog("あの子が知ると、耐えられない情報もある。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("ほ～～？","愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("まあそれはそうとして、レンちゃんの同意は\n自力で取れってスクルドちゃんに言ってたけど、\nあっちは上手くいってるの？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("あのバカなら5秒も経たないうちに\n小娘の手玉だろうな。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("思春期特有の分かりやすいやつか……","愛衣")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("だったら、なんでそんな結果が分かり切っている\n意味のない事を──","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("続きを言いかけたが、途端に愛衣は悟ったような\n表情を見せた。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("レンちゃんが夢に惑わされないよう、現実世界で\n強い印象を与えてアンカリングを行ったの？","愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは笑い、グラスの中身を一口だけ含む。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("時には古い方法が、最も効果的な場合も\nあるって事だ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("彼女を溺愛し過ぎじゃないかなぁ……？","愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("──そろそろ時間だ、行くとしよう。","マリル")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
