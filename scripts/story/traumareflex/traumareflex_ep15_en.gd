# traumareflex_ep15.gd - 创伤反射篇第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第15话剧本
	traumareflex_ep15_script()

func play_script():
	pass

# 创伤反射篇第15话 - 正式剧本
func traumareflex_ep15_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Anton's_Blindness.png")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	await novel_interface.show_text_only("Anton’s Blindness.")
	await novel_interface.show_text_only("A disease where the patient, though blind, persists in believing that they can still see.")
	await novel_interface.show_text_only("Even though the patient may have small bruises on their limbs from running into things, they’ll still come up with different reasons to explain it.")
	await novel_interface.show_text_only("That’s how the brain works. It forges new memories to provide an explanation for things that it cannot understand.")
	await novel_interface.show_text_only("That’s a sort of self-preservation instinct we have when facing the unknown.")
	await novel_interface.show_text_only("Perhaps it’s because we’re simply not yet prepared to face the darkness behind the starry skies?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	await novel_interface.show_text_only("Hm. If those spiders weren’t sent by Rina’s people...")
	await novel_interface.show_text_only("Then where did they come from? Mechanical weapons, at such a large scale, appearing inside the Second Academy City just like that. Unheard of.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Maybe someone else has brought certain elements into this memory too? Not just me?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Or maybe it’s not someone, but... something with its own will.")
	await novel_interface.show_text_only("I remember, before this mission began...")
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Skuld told us that Fabella is a fire witch. Possessed by fire magic.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Possessed?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Fabella’s not like Elluka, who can control electric fields directly. Her situation is more like... “certain powerful information” has chosen to possess her.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("You’re talking as if information had a will of its own.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("They do. If a string of information has a high enough density and a low enough entropy value, it can gain a will.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("When Fabella lost consciousness, the “living information” began taking over her body...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Living information... taking over...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Can it be?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Those robot spiders are created by that “something” that’s possessing Fabella?")
	await novel_interface.show_text_only("And that’s why I have to show up, to keep that “information with a will” from twisting Fabella’s memories?")
	await novel_interface.show_text_only("But it seems that I’ve tried a lot of times and kept failing.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(How should I deal with those bugs, then?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervously, I rummage through my equipment. If every item on me has a purpose...")
	await novel_interface.show_text_only("The only one I haven’t used yet is the small emergency kit.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(It can’t do much except, you know, “recover minimal HP”, though... considered pretty much useless in those zombie games...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I run my fingers over the softly packaged cube-shaped bag in my backpack.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Wait...)\n(This feels like...)","Ren")
	await novel_interface.hide_character()

	# 战斗部分剧本
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Shoot, those bugs are coming.","Russel")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	await novel_interface.show_text_only("I follow the scuttling sounds and see over a dozen spiders scaling the elevator shaft. More are coming from behind them.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Everyone, in your position!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The squad immediately gets into battle mode and begins firing.")
	await novel_interface.show_text_only("Fabella loads her shotgun with one hand, grasping a dagger with the other. She uses her left forearm as a support for the gun as she aims.")
	await novel_interface.show_text_only("She takes out two spiders with two clean shots, then rips apart a third with her dagger and left foot, overcome with rage at those monsters that took her friend.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("I’m running out of ammo!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel tosses a magazine to Cassel.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("This is the last one. Go check the storage racks and see if something’s usable.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel nods, reloads his gun and keeps backing up as he continues firing, until he disappears behind a row of storage racks.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("Skuld, get behind me!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I grip my submachine gun tight, switching it to single-shot mode.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(I only have around a dozen bullets left...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hey, Russel, guess what I found!\nA whole crate of Polish distilled vodka, fifteen years old.","Cassel")
	await novel_interface.show_text_only("Cassel sounds extraordinarily excited.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Idiot, are you trying to make a Molotov cocktail?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I think it’d work. It says 96% alcohol content... surely it’s not meant for drinking.","Cassel")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Rina did say those spiders detect their targets by sensing heat.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Molotov cocktails are not that simple to make.","Fabella")
