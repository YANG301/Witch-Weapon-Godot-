# traumareflex_ep05.gd - 创伤反射篇第05话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep05_script()

func play_script():
	pass

func traumareflex_ep05_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("スクルドは数人の捜査員にエスコートされ、\nとあるビルの高層階に位置するバーに来ていた。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("ここはどこなの……？\n\nあたしの友人はどうなったの？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("agent")
	await novel_interface.show_dialog("ここでしばらくお待ちください。","SID捜査員")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("バーの内装はカーペット、ソファー、クッション\nグラスに至るまで高級感に溢れ居心地は良い。")
	await novel_interface.show_text_only("ゆったりとしたバックミュージックが流れる中、\n窓から見える都市の夜景を眺め、\n金髪の少女は少しだけ落ち着きを取り戻した。")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("どうだ？　ここの景色は良いものだろう？","マリル")
	await novel_interface.show_dialog("私も時々ここで、景色を肴に1杯やる。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("……あなたは？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("君はまだ小さいから、お酒じゃなくジュースで\n我慢してくれ。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは相手の疑問に答えず、自ら給仕を呼んで\n飲み物を運ばせた。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("マリル・フォン・ブラウン博士……？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("マリルで構わないさ。","マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("安心してくれ、君の友人は医療センターにいる。\n\nまだ昏睡状態にあるが、命に別状はないだろう。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言ってマリルは、1台のタブレットを\nスクルドに手渡した。\n画面には4つのリアルタイムモニターが表示され\n病床のファビオラを映し出している。")
	await novel_interface.show_text_only("モニターによって彼女の様子や周囲の装置が\nはっきりと確認できる。\nその画面中の1つに、病室の窓の外を\nうかがえる物があった。")
	await novel_interface.show_text_only("そこには、赤と青の看板を目立たせているビルが\nはっきりと見える。")
	await novel_interface.show_text_only("スクルドは少し振り返って、今度はバーの窓から\n外を確認する。\n彼女の座る位置からも、ちょうど同じ建物が\n遠くに見えた……")
	await novel_interface.show_text_only("金髪の少女は俯いたまま、人工呼吸器を着けた\nファビオラを見て、身体をわずかに震えさせる。")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("お願い……彼女を助けて……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("声を殺して泣いているようで、\n鼻をすすらせていた。")
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("ファビオラはあたしの……\nあたしの大切な友人なの……\nお願い、助けて……","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("遂には堪えられなくなり、大粒の雫が雨のように\nポタポタとタブレットへ落ちる。")
	await novel_interface.show_text_only("マリルはタブレットを抱えて身を丸める少女を\n見つつ、口付けをするようにグラスを傾ける。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("相変わらずここのバーテンダーの腕は\n素晴らしい……","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は立ち上がり、スクルドの隣の席へ\n移動した。\n小さな肩を軽く叩きながら、耳元に近付き\nそっと優しく囁く──")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("君の父上は理事会のメンバーだね？\n\n来月に開かれる新豊洲の平和フォーラムにも\n出席される……","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは依然として俯いたまま、\n涙を溢れさせている。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("ほら、私達の前を見なさい──\n\nあのシャンデリアにはマイクロカメラが\n仕込まれている。","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("すすり泣く声が次第に止んでいく。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("第二学園都市上層部の娘が、他国の情報機関の\nリーダーと親しく内緒話をしている──","マリル")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("もし、こんな素敵な写真が「うっかり」外部に\n漏れてしまうと……","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドが頭を上げて息を吐いた。\n\nテーブルからティッシュを2枚取って涙を拭き、\n呼吸を整える。")
	await novel_interface.show_text_only("マリルはスクルドの髪を整え、\nその頭を撫でながら──")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("それでいい。\n\n女性の涙は、長ければ長いほど不必要となる\nからな。","マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","thought",0.25)
	await novel_interface.show_dialog("あなた、そんな事してると嫌われるわよ……","スクルド")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("私を嫌う奴は、私に何もできないさ。","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは明るい笑みを零した。")
	await novel_interface.show_text_only("スクルドはテーブルに置かれたジュースを飲む。\n\nニューモリダスで彼女が最も好きなスイーツ店の\n味と全く同じだ。")
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("skuld","talk",0.25)
	await novel_interface.show_dialog("……こうした小さい情報さえも見逃さないのね？","スクルド")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("だから言っただろう？\nここのバーテンダーの腕は良いと……","マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("あなた……心の中で笑っていたでしょう。","スクルド")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("スクルドは不満げに聞いた。")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light(0)
	novel_interface.show_2nd_character("skuld","talk",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("とても印象的だったさ。","マリル")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("流石は10歳にして、自分を拉致した誘拐犯達を\n巧妙な言葉だけで内輪揉めに導いた小娘だ。","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルの得意げな表情を見て、金髪の少女も\n負けじと言葉をかぶせる。")
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("skuld","stare",0.25)
	await novel_interface.show_dialog("あなたも話で聞いたよりは恐ろしくないわ。","スクルド")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("ここの照明や音楽、雰囲気も全て意図的に\n設計したものなのでしょう？\n特設の「尋問室」にしては優しすぎない\nかしら？","スクルド")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("再度マリルは、グラスの中身に口を付ける。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("私は少女を相手にする時は、\n丁重に扱うように努めていてね……","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("圧倒的に優位な卓上で、あたしに挽回できる\n余地を見せて……\n敵わない状況なのは分かっているから、\nもう、弄ぶのは止めてよ！","スクルド")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("そもそも、嘘ついたでしょ！\nシャンデリアにマイクロカメラがあるって！\n「巧妙な言葉」っていう言葉は、\nあなたの方がお似合いよ！","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("金髪少女の騙されて悔しそうな様子を見て、\nマリルは軽く彼女を抱きしめる。")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("ともかく、この場で聞きたいのは1つ──","マリル")
	await novel_interface.show_dialog("我々が君の友人を救い出したとして。\nその恩を、君はどうやって返すつもりだ？","マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("スクルドは頭を上げ、マリルを真剣に見つめる。")
	novel_interface.show_character("liliu_research","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("……約束して、あたしがあなたに連絡した事を\n誰にもバラさないって。","スクルド")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("問題ない。\n大使館に対しても完璧な説明を用意してある。","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("スクルドは鍵の形をしたヘアピンを外し、\n底にあるカラクリを捻じって、\n中からマイクロメモリーを取り出した。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("理事会のメンバーの中に、『再建計画』へ\n干渉しようとしている人間がいるわ。\nまだ誰なのかは分からないけど、たぶん来月には\n行動を始めると思う……","スクルド")
	await novel_interface.show_dialog("彼らの依頼を受諾したかもしれない人間……\n\n暗号通貨の口座を制御する金融請負人の情報が、\nここにある。","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは驚いた自らの表情を隠さなかった。\n\n給仕にメモリカードを受け取るようにと、\n指を鳴らして合図を送る。")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("来月は出席しないようにって忠告したんだけど、\nお父様は聞いてくれなくて……\nこれぐらいの情報だけじゃ、\nあたしには調べようがないわ。","スクルド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","smile",0.25)
	await novel_interface.show_dialog("私にも君みたいな娘がいたらな。","マリル")
	novel_interface.character_light(0.35,"thought")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あたしのお父様を…巻き込まないようにできる？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("彼が今回の件に関与してなければな？","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そんな会話がしばらく続いたが、躊躇しつつも\nずっと我慢していた大事な質問を、\nスクルドは投げかける。")
	novel_interface.show_character("skuld","painful")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","speak",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……ファビオラの容態は……悪いの？","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("…………","マリル")
	novel_interface.character_light(0.35,"painful")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あたしはてっきり、幹部クラスの人が\n尋問に来るだけで終わるのかと思ってた……","スクルド")
	await novel_interface.show_dialog("SIDのトップが自ら出向いてきたという事は、\nあたしが思っている以上に事態は深刻なのね。","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("……現在の彼女の容態は、\n非常に特殊な状況下に置かれている。\nもし本当に彼女を救いたいのであれば、\n彼女の情報を私達に渡してくれ。","マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うん……彼女に会わせてくれない？\n全てを話すから。","スクルド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("よし。","マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルが手を叩いた瞬間、バーの窓が全て\n真っ黒になった。\nその漆黒の中心には、SIDのマークが\n浮かび上がっている。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR2.png")
	novel_interface.show_character("skuld","perspire")
	await novel_interface.show_dialog("こ、この窓……全部スクリーンだったの？？","スクルド")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("君の眼球の動きを察知して、視野角の変化を\nシミュレートしていたのさ。","マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","worry")
	await novel_interface.show_dialog("なら……ここは一体どこなの？","スクルド")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは持っていたグラスの中身を\n一気に飲み干した。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("行こうじゃないか。ファビオラは下の階だ。","マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/APC.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("兵員輸送車内では、攻撃部隊の隊員が\n「新入り」を囲んで騒いでいる。")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("え──？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("俺は聞き逃さなかったぞぉぉッッ！！\nマジかよ女の声がしたぁぁッ！！","男の声A")
	await novel_interface.show_dialog("俺達の隊にもついに……\nついに待望の乙女がぁぁ……","男の声A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("ウォッホンっ！\n俺達の隊長は紅一点ではなかったかな？","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("あっ……","男の声A")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("ほぉ～～？","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラはナイフを取り出し、\n助手席の背後にある金属デッキを切り付けた。")
	await novel_interface.show_text_only("金属同士がぶつかり、火花と共にキーンと響く\n耳障りな音を発する。")
	await novel_interface.show_dialog("も、もちろんッ！！ ファ、ファビオラの姉御が\n世界で一番美しいですよッ！？\n姉御に一生付いていきますッッ！！！","男の声A")
	await novel_interface.show_text_only("彼らの注意が少し逸れて、やっと止まっていた\n息を吐いた。\nあれだけの注目を一手に受けるなんて、\n息苦しい以外の何モノでもない。")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("（一体、どうなってるんだ？？？）","レン")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（──待てよ、なぜ俺の手には銃が！？？）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("今回の護衛任務は市街地内をドライブだ。\n新人に場数を踏ませるのにはちょうどいい。","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("金持ってると被害妄想が酷くなってくるんだよ。\n\nオークションに向かうだけで、\n武装護衛をチャーターするぐらいだしな……","男の声A")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("どうせ『パランティア』はビジネスよ。\n\n金さえ出せば完全武装で犬の散歩だって\nしてやるわ。","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("聞けば今回の護衛対象は「理事会」の\nお偉いさんとこの娘だって？","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("あの雇い主、最初に反地雷仕様のM133車両を\n引っ張り出そうとしたらしいが、\nなんと交通省に拒否られたそうだ。","男の声A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("ハハハ、戦時中にやましい事をやり過ぎて、\n夜も安心して寝られないってタチだろうさ。","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("皮肉の効いた会話が繰り広げられている中で、\n隣に座っているキャセールだけが、\n振り向いて俺の事をじろじろと見てくる。")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("お前のその身なり……\nどっかのお嬢様が職場体験しに来たわけか？","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("実はさっきから気になってはいたんだが……\n\nそいつはNewcon社のバイパー式戦術マスク\nだろう？","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("なんだってぇぇッッ！？？","男の声A")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("『ダ・チ』の店に6万以上で売ってたのを\n覚えててな……","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("マジでッッ！！？？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は手元の銃を落としそうになる。")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("ふふ、着ている本人がなんで動揺してるのよ？\n随分と高級な衣装を見繕ってきたようね。\nだけどキャセールが言いたいのは\n何も金だけの話じゃない──","ファビオラ")
	await novel_interface.hide_character()
