# traumareflex_ep07.gd - 创伤反射篇第07话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep07_script()

func play_script():
	pass

func traumareflex_ep07_script():
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.show_dialog("В тот момент, когда наступит конец света?","Ren")
	await novel_interface.show_dialog("(Подождите, эта катастрофа затронула весь мир?)","Ren")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Но разве на следующий день все не выглядели прекрасно?")
	await novel_interface.show_text_only("Единственное, что «закончилось» — это мой...")
	await novel_interface.show_dialog("(Чем я заслужил это?)","Ren")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","normal")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_dialog("Но в этом воспоминании ты мальчик.","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","awkward",0.25)
	await novel_interface.show_dialog("... Э?","Ren")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Итак, вы мальчик, мисс Рен?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("Uh... Um...\nUh, I...","Ren")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Заголовки новостей, такие как «Мужские переодевания проберутся в женское больничное отделение», мелькают у меня в голове.")
	await novel_interface.show_text_only("Скульд приблизилась на несколько дюймов, выглядя невероятно самодовольной, как будто она только что поймала меня на чем-то незаконном.")
	await novel_interface.show_text_only("Я чувствую себя загнанным в угол, как олень в свете фар.")
	await novel_interface.show_text_only("Неосознанно я прикрываю грудь и отодвигаюсь назад, а затем пытаюсь придержать и юбку...")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("(Ух, эта юбка действительно слишком короткая! Не могу заставить ее оставаться на месте!)","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Эм, подожди, чего я так нервничаю?)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ой, да ладно, я же девочка!\nХахаха...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Сейчас я совсем не похож на мальчика. Скульд ни в коем случае не мог связать мое нынешнее «я» с моей первоначальной личностью.")
	await novel_interface.show_text_only("Кроме того, Мариру многое сделала, чтобы замести мои следы. Даже лучшая разведывательная служба не сможет сказать, кем я был раньше.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Но этот силуэт в руинах Новой Опулентии... в моих воспоминаниях это определенно мальчик.","Skuld")
	await novel_interface.show_text_only("Скульд движется передо мной, изучая мое лицо с большим изумлением.")
	novel_interface.show_background("res://assets/images/bg/Fabiola/YumeRen.png")
	await novel_interface.show_dialog("И после вспышки белого света я увидел твое лицо.","Skuld")
	await novel_interface.show_dialog("Прошло меньше секунды, но я никогда не ошибаюсь.","Skuld")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("skuld","proud")
	await novel_interface.show_dialog("Ты человек в моих воспоминаниях.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я сижу, прижавшись спиной к стене, в ужасе от внушительной ауры этой маленькой девочки.")
	await novel_interface.show_text_only("Неудивительно, что в классических фэнтезийных романах, независимо от того, насколько велик мир, никогда не может быть больше двух пророков. Автор не будет знать, что с ними делать.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Такая способность... это похоже на мошенничество, не так ли?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Тем не менее, это был всего лишь фрагмент. А воспоминания не всегда надежны.","Skuld")
	await novel_interface.show_dialog("Наверное, я не могу быть уверен, мальчик ты или девочка, просто по этому отблеску в моих воспоминаниях.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Блондинка немного смягчается, оставляя мне немного места, чтобы дышать.")
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Тем не менее, мне удалось убедиться, когда ты только что обнял меня. Твое тело, твое тело, твои волосы...","Skuld")
	await novel_interface.show_dialog("Я не знаю почему, но Мисс Рен определенно девочка, по крайней мере, сейчас.","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("И они чувствуют себя... приятно...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд озорно ухмыляется.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Они?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она уткнулась лицом мне в грудь, потому что хотела убедиться, реальны ли «они»?")
	await novel_interface.show_text_only("И она даже проверила мои волосы...")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("(Могу поспорить, что Мариру потом отругает меня за то, что я так легко потерял бдительность!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд поднимает голову и откашливается.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("В любом случае... мы обменялись секретами, так что... теперь мы друзья, верно?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— осторожно и выжидающе спрашивает она.")
	await novel_interface.show_text_only("Мое сердце бьется. Мой инстинкт подсказывает мне, что под всем этим настоящий Скульд, неприкрытый, уязвимый.")
	await novel_interface.show_text_only("Должно быть, она выросла в мире, где нет доверия. Она еще так молода... не может быть больше тринадцати лет...")
	await novel_interface.show_text_only("Несмотря на то, что ее пророческие способности не так уж сильны, вероятно, найдется множество людей, которые хотели бы ее использовать.")
	await novel_interface.show_text_only("Если ее тайна выйдет наружу, она погибнет.")
	await novel_interface.show_text_only("Тем не менее, она рискнула всем и рассказала мне, хотя за мной вполне могли следить и носить один из жучков Мариру...")
	await novel_interface.show_text_only("Возможно, все, что ей было нужно, это друг, с которым она могла бы быть честной.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Да. Со мной твоя тайна в безопасности.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я поднимаю мизинец.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("Потому что я... «особенный» для тебя, верно?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ух ты, это так банально...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Скульд смотрит на него, а затем разражается смехом.")
	await novel_interface.show_text_only("Мы обещаем на мизинце.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/BAR.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("Когда Ая входит в бар, она сразу же замечает Мариру, сидящую на диване у окна и осторожно крутящую в руке бокал вина.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("«Меры безопасности» прототипа были настроены в соответствии с вашими запросами.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Довольно быстро, не так ли?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Вы хотели, чтобы я отслеживал стимуляцию блуждающего нерва Рен и немедленно отключал ее от системы, если произойдет что-то ненормальное. Не слишком ли это жестоко?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Это что-то вроде предохранителя. В конце концов, мы до сих пор мало что знаем о том, как работают воспоминания, по крайней мере, с научной точки зрения.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("И кто знает, действительно ли это похоже на то, что говорят в фильмах... «Ваш мозг перегорает, если возникают противоречивые воспоминания».","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая, кажется, очень взволнован, наблюдая, как у кого-то поджаривается мозг.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Если мы проведем эксперимент на нескольких десятках случайных людей, мы узнаем, верно?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру поднимает свой стакан, изучая форму кубиков льда внутри него при освещении.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Нет...","Mariru")
	await novel_interface.show_dialog("Даже если у человека есть два набора совершенно противоречивых воспоминаний, он все равно найдет способ их рационализировать.","Mariru")
	await novel_interface.show_dialog("Например, воспоминания из прошлой жизни или параллельной вселенной. Или, может быть, какое-то божественное прозрение.","Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Кто знает, возможно, с такими знаниями они даже могут основать культ.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Верно, но...","Aya")
	await novel_interface.show_dialog("Но разве вы не просили сотрудников Технологического института Харимы не стимулировать ее префронтальную кору, чтобы отключить область памяти в ее мозгу?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Вы хотите, чтобы она забыла большую часть информации, которая у нее была после того, как она проснется, как если бы все это было сном... верно?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру поворачивается и смотрит в окно на виртуальные огни города.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Фабелла в детстве была разведчиком. Она была воспитана военачальником в Южной Америке.","Mariru")
	await novel_interface.show_dialog("Она знает слишком много, больше, чем может вынести.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("О?","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Верно, разве ты не сказал Скулду убедить Рена взяться за эту миссию? Это сработало?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Конечно. Этот идиот не сможет отказать милой девушке.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Так просто, так наивно. Я ей отчасти завидую.","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Но подожди, в таком случае, почему ты...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая останавливается на полуслове, понимая, что у нее уже есть ответ на свой вопрос.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Вы хотите установить для Рена своего рода «точку привязки воспоминаний», да?","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мариру улыбается и изящно отпивает из своего стакана.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Прямой путь всегда лучше, не так ли?","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ты ее точно балуешь, не так ли?","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Эх. Пора, поехали.","Mariru")

	print("=== 创伤反射篇第07话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
