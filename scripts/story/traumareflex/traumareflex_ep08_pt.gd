# traumareflex_ep08.gd - 创伤反射篇第08话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep08_script()

func play_script():
	pass

func traumareflex_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Este mundo é cruel.")
	await novel_interface.show_text_only("A guerra há dez anos deixou-nos com pouco para viver.")
	await novel_interface.show_text_only("Havia muitas crianças como eu no orfanato - mas eu ainda achava que era o menos sortudo.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Mother.png")
	await novel_interface.show_text_only("Talvez eu sentisse que o que perdi era o mais importante. Mas então, talvez o facto de os ter perdido os tenha tornado ainda mais importantes?")
	await novel_interface.show_text_only("Ainda assim, era difícil para mim, um refugiado protegido sob a Égide, imaginar—")
	await novel_interface.show_text_only("Como seria a vida daqueles que tiveram que continuar sobrevivendo no campo de batalha depois de perderem seus entes queridos.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Huff... huff...")
	await novel_interface.show_text_only("Huff... huff...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("Eu cambaleio para fora da fumaça pesada e caio atrás de um carro na beira da estrada, respirando com dificuldade através da minha máscara.")
	await novel_interface.show_text_only("O chão está coberto de entulho. Gritos e sons de explosões parecem vir de todas as direções.")
	await novel_interface.show_text_only("Através das chamas e da fumaça, ainda consigo distinguir o comercial colorido passando na tela de um arranha-céu distante.")
	await novel_interface.show_text_only("Tudo parece tão... surreal.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Eu me pergunto quantas experiências desse tipo existem nas memórias de Fabella...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A vida dela é tão diferente da minha.")
	await novel_interface.show_text_only("Passei por algum treinamento depois de ingressar no SID, mas é principalmente relacionado a táticas e manipulação de informações.")
	await novel_interface.show_text_only("Nunca participei de um exercício de verdade com armas e balas de verdade. Mesmo quando praticávamos tiro ao alvo, eu gravitava em torno das poucas armas menores com o recuo mais fraco. Mariru e Annie sempre riam de mim.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(Se ao menos Annie estivesse aqui...)","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hum. Esta arma na minha mão... é uma KRISS?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uma submetralhadora KRISS Vector, conhecida por seu recuo reduzido. As balas são subsônicas, do tipo silencioso. Não é à toa que Mariru chama isso de pistola d'água para covardes.")
	await novel_interface.show_text_only("... Ei, nem todo mundo gosta de carregar armas grandes como ela, sabe?")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_mercenary","uneasy")
	await novel_interface.show_dialog("Essa arma... não é tão ruim, talvez eu consiga...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho para a revista estendida no fundo e engulo.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Nah. É melhor manter a segurança desligada por enquanto. Não quero atingir um aliado.)","Ren")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Espio, tentando observar a situação lá fora.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Cassel, está tudo bem aí?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("O motorista morreu! Espere... que diabos?\nNossa, o cara ainda está respirando!","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Coloque uma máscara de gás no rosto dele e jogue-o no porta-malas. Então pegue seu equipamento e procure cobertura!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Os membros do esquadrão não hesitam. Fabella, carregando uma bolsa preta, salta para o outro lado do carro atrás do qual estou me escondendo.")
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("(Uau, não consigo acreditar no que vejo... ela se move tão rápido!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel coloca o convés superior que voou na explosão perto de uma pilha de pedras, criando uma zona cega que ele pode usar como cobertura, e atravessa a rua.")
	await novel_interface.show_text_only("Segundos depois, uma mochila enorme surge do nada vinda da fumaça, então Cassel passa rolando e desaparece rapidamente nas sombras do canto.")
	await novel_interface.show_text_only("Esta situação é provavelmente moleza para membros do esquadrão de operações especiais como esses caras. Afinal, todos eles lutaram na linha de frente.")
	await novel_interface.show_text_only("Mas desta vez, em vez de uma zona de guerra, eles estão lutando na Segunda Cidade Acadêmica.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Cuidado com as tropas mecânicas e envie um drone para explorar o ambiente.\nRussel, já entrou em contato com a Equipe Alfa?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Não há resposta. Eles estão do outro lado da explosão, junto com a nossa “bagagem”.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sigo o olhar de Russel. A rua à frente foi destruída em pedacinhos ordenados, enquanto estamos presos em algum lugar perto do meio da estrada.")
	await novel_interface.show_text_only("O alcatrão no chão está queimando como se não houvesse amanhã, tornando difícil dizer o que está acontecendo à frente.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("(Alguém enterrou as bombas aqui antes?)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Ei! Novato! Você realmente acha que é seguro se esconder lá?","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("—Huh?\n(Ela está falando comigo?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que eu possa reagir, Fabella me pegou pela gola da jaqueta e me arrastou para as sombras atrás do caixa eletrônico na beira da rua.")
	novel_interface.show_character("fabiola_battle","perspire")
	await novel_interface.show_dialog("Vamos, é muito fácil para o inimigo levar você até lá. E você não sabe de onde eles estarão atirando.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Antes que eu possa formular uma resposta, ela gesticula para Russel, que está do outro lado da rua, enquanto Russel responde com um sinal de positivo.")
	await novel_interface.show_text_only("Segundos depois, um objeto voador cinza em forma de disco surge de trás do carro onde Russel está escondido.")
	await novel_interface.show_text_only("Fabella tira um pequeno tablet do cinto e começa a estudar a visão aérea da zona capturada pelo drone.")
	await novel_interface.show_text_only("Os dois SUVs que lideram a tropa agora não passam de bolas de fogo fumegantes.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Aqueles seguranças... provavelmente todos mortos. Pelo menos a Equipe Alpha e a “bagagem” estavam atrás de nós...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, a tela do tablet desaparece em estática, seguida por um “boom” ensurdecedor.")
	await novel_interface.show_text_only("Com um som fraco e efervescente, o drone cinza entra em combustão no céu.")
	await novel_interface.show_text_only("Seus pequenos componentes caem como uma chuva, batendo nos tetos dos carros ao nosso redor com sons metálicos.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("... Um atirador de elite?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Deve estar no prédio em frente. Provavelmente usando um dispositivo de aceleração eletromagnética antiespionagem de curta distância. Observe onde você está se escondendo. Certifique-se de que o obstáculo escolhido seja grosso o suficiente.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É um dispositivo que vem com balas de metal aceleradas de forma constante por energia eletromagnética. Extremamente poderoso, embora o dispositivo geralmente seja pesado e difícil de transportar.")
	await novel_interface.show_text_only("Essas balas podem penetrar obstáculos muito grossos. Durante a guerra, um primeiro-ministro foi morto por um homem a mais de 0,5 km de distância, embora estivesse atrás de uma parede de cimento de um metro de espessura. Foi assim que esse tipo de dispositivo de atirador abrangente ganhou fama generalizada.")
	await novel_interface.show_text_only("Coisas assim não faziam parte do meu treinamento, eu simplesmente sei disso porque, bem, está em um dos meus jogos favoritos. Vem com uma skin exclusiva também, por um preço exorbitante.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("O Olho está abaixado! Repito, o Olho está abaixado!","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("O atirador deve estar a cerca de oitocentos metros de distância de nós. Temos outro drone com uma superfície refrativa e um Olho Que Tudo Vê montado nele. Eles provavelmente não notarão se enviarmos esse.","Cassel")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","panic")
	await novel_interface.show_dialog("Espere, o Olho Que Tudo Vê... o raio de sua lente é de 15mm, certo?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella pergunta, enquanto observa o prédio bem iluminado com um refletor.")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("A lente ainda pode refletir luz, então. Mesmo quando é noite. Não podemos exatamente cobri-lo com uma superfície refratária de luz.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("Então eles ainda conseguem localizar o drone, hein... E não podemos abrir fogo no prédio desse jeito. É um edifício residencial comum e pessoas inocentes vivem lá.","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Para um atirador que trabalha com um equipamento pesado e que demora muito para recarregar, a prioridade é não ser avistado pelo inimigo (nós).")
	await novel_interface.show_text_only("Lembro-me de ter aprendido sobre isso no treinamento tático.")
	await novel_interface.show_text_only("Porém, também me lembro de outra coisa do mesmo livro...")
	novel_interface.show_character("ren_mercenary","normal1")
	await novel_interface.show_dialog("(A prioridade deles é não serem vistos, isso é verdade, mas também... eles também não deveriam tentar não nos deixar saber sobre sua existência?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Atirar em nosso drone, naturalmente, significa que saberemos de sua existência.")
	await novel_interface.show_text_only("O que, é claro, fará deles um alvo. Quem quer que seja deve ser um novato que não sabe o que está fazendo—")
	await novel_interface.show_text_only("Ou alguém que já está confiante de que sabe onde atirar em seguida e pode evacuar imediatamente após terminar o trabalho.")
	await novel_interface.show_text_only("Meu coração dispara.")
	await novel_interface.show_text_only("Eu pulo instintivamente, forçando Fabella a cair no chão, longe do bloqueio atrás do qual ela está se escondendo.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("O que você está fazendo? Idiota—","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No segundo seguinte, o bloqueio em que ela estava apoiada explode em pedaços.")
	await novel_interface.show_text_only("Após destruir a tampa, a bala passa a penetrar na parede do prédio, criando uma protuberância de quase nove metros quadrados na parede.")
	await novel_interface.show_text_only("As placas do caixa eletrônico são lançadas ao ar. Inúmeras notas flutuam no céu, eventualmente caindo no chão como flocos de neve, com as luzes brancas da rua como pano de fundo.")
	await novel_interface.show_text_only("É como uma cena saída de um filme noir.")
	await novel_interface.show_text_only("Eu olho, hipnotizado, mas Fabella já prendeu as pernas na minha cintura, me fazendo rolar nas sombras projetadas por uma pilha de tijolos de cimento.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Eh? Por que ela está me segurando?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Você está bem, chefe?","Cassel")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, estou bem.\nFelizmente, nosso novato tem raciocínio rápido.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella responde, dando tapinhas em minhas bochechas. Teria parecido um gesto doce se ela não estivesse me perseguindo.")
	novel_interface.show_character("fabiola_battle","wink")
	await novel_interface.show_dialog("E descobri uma maneira de evitar que a lente reflita luz.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela diz, alcançando minhas coxas—")

	print("=== 创伤反射篇第08话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
