# traumareflex_ep14.gd - 创伤反射篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第14话剧本
	traumareflex_ep14_script()

func play_script():
	pass

