# traumareflex_ep02.gd - 创伤反射篇第02话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第02话剧本
	traumareflex_ep02_script()

func play_script():
	pass

# 创伤反射篇第02话 - 正式剧本
func traumareflex_ep02_script():
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	await novel_interface.show_text_only("<Quinta Ciudad Academia, Campus East Rd.>")
	await novel_interface.show_text_only("La noche se acerca rápidamente en el bullicioso distrito comercial. Los estudiantes vestidos con uniformes de la academia privada de la zona están dando vueltas.")
	await novel_interface.show_text_only("Una chica, vestida con un traje de sirvienta, se abre paso rápidamente entre la multitud.")
	await novel_interface.show_text_only("Como hay un café de limpieza abierto las 24 horas, los 7 días de la semana en la calle de enfrente, su atuendo no llama mucho la atención.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("¡Señorita Skuld! ¡Desacelerar! ¡Es peligroso!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¡Vamos, deja de regañar!\n¡Déjame disfrutar de mis pocos segundos de libertad en paz!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La chica rubia da vueltas y vueltas, sonriendo como el sol.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("¡Relájate!\nEste es el lugar más seguro del mundo. Además...","Skuld")
	novel_interface.change_expression("proud")
	await novel_interface.show_dialog("¡Tengo a Fabella para protegerme!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella finalmente alcanza a su pequeña amante y suspira por lo enérgica que parece la niña.")
	novel_interface.show_character("fabiola_maid","smile")
	await novel_interface.show_dialog("Unos segundos de libertad, eh...","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Para una niña a menudo encerrada en casa por su padre sobreprotector, New Opulentia es de hecho el lugar más seguro en el que podría estar. No es como Newmoridas, donde todos los residentes tienen licencia para portar armas, o Salmonton, con sus calles monótonas llenas de refugiados y vagabundos.")
	await novel_interface.show_text_only("Las Islas Lebona también son ahora el hogar de pandillas prominentes que se habían trasladado allí durante la guerra.")
	novel_interface.change_background("res://assets/images/bg/Shot/storyBGPol.png")
	await novel_interface.show_text_only("Además, dado que el Foro Internacional de la Paz se llevará a cabo en Nueva Opulentia el próximo mes, la seguridad se ha incrementado en toda la ciudad.")
	await novel_interface.show_text_only("Fabella finalmente tiene la oportunidad de salir con su pequeña ama sin necesidad de portar un arma automática.")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Sí, es seguro aquí, ¡pero aun así debes vigilar el tráfico! Y no te pierdas de mi vista.","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¡Entendido, entendido!","Skuld")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La chica rubia interrumpe la frase de Fabella saltando hacia adelante y acariciando su rostro en el pecho de la criada.")
	novel_interface.character_light(0.35,"perspire")
	await novel_interface.show_dialog("¡Ay, tú! ¿Llevas un chaleco antibalas incluso ahora?","Skuld")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿No es eso un poco restrictivo?\n¡Deberías dejar que tus senos respiren!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","blush")
	await novel_interface.show_dialog("¿Respirar?","Fabella")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Está bien, basta...\n(Susurros) No hagas esto en público...","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Jejeje, ¡sabía que Fabella es la mejor! ¡Gracias por llamar la atención de los chicos de la Embajada y ayudarme a escabullirme!","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("El viejo Haggerty nos va a matar cuando regresemos...\nAun así, ¿la persona que estamos buscando realmente aparecerá en esta área?","Fabella")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Creo que sí. La última vez que estuve en Sky Hotel, recuerdo haber tenido una sensación realmente fuerte... \"Eso es, ese es el indicado\".","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Te refieres a esa sirvienta torpe?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aunque el que estoy buscando debería ser un niño...","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Bueno...\nEn realidad, los niños también pueden disfrazarse de sirvientas, ya sabes...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Verás, en realidad, a muchos niños les gusta vestirse con trajes femeninos...","Fabella")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Oh?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"laugh")
	await novel_interface.show_dialog("También se ponen lindos accesorios y maquillaje. ¿Qué tan adorable es eso?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Oh! ¿Y?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Algunas también pueden hablar con voces femeninas agudas. ¡Muchos de ellos tienen muchos seguidores en línea!","Fabella")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella está tan emocionada que su voz prácticamente tiembla.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Oh, recuerdo haber visto fotos antes en tus favoritos de Instagraph.","Skuld")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("En ese caso, tal vez la criada que vimos no era una niña, sino un niño vestido como tal...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La chica rubia parece estar sumida en sus pensamientos.")
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("Eh... ¡oye!","Fabella")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("¡Señorita Skuld, deje mi teléfono en paz!","Fabella")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","stare")
	await novel_interface.show_dialog("Vamos, tu teléfono tiene una conexión cifrada para que la gente de mi padre no pueda acceder. Además, ¡tu contraseña es muy fácil de adivinar!","Skuld")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("¡Nunca te pedí que establecieras mi cumpleaños como tu contraseña!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld le hace una mueca a Fabella, luego se da vuelta.")
	await novel_interface.show_text_only("Ella mira fijamente el cielo nocturno, teñido de rojo por el sol poniente, con una mirada lejana y ligeramente decepcionada.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("De todos modos, no importa si es un niño o una niña, supongo que ya es demasiado tarde para que podamos encontrarlos hoy.","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Al menos podemos disfrutar del aire fresco aquí, ¿verdad?","Skuld")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("fabiola_maid","normal",0.25)
	await novel_interface.show_dialog("Entonces… ¿nos vamos a casa ahora?","Fabella")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hay otro lugar que quiero visitar. Está cerca de la embajada. ¿Venga conmigo?","Skuld")
	await novel_interface.show_dialog("¿Recuerdas al Padre Anton de la Iglesia de la Trinidad?","Skuld")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Creo que nos hemos visto solo una vez... él es el que en Newmoridas siempre escuchaba tus confesiones desde que eras pequeño, ¿verdad?","Fabella")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí. Ayer me envió un mensaje de texto que decía:","Skuld")
	await novel_interface.show_dialog("“Iglesia Memorial Nueva Opulentia”","Skuld")
	novel_interface.character_light(0.35,"thought")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo llamé con tu teléfono, pero nunca contestó. Estoy un poco preocupado, así que pensé que debería visitar la iglesia que mencionó...","Skuld") #换行问题
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mmm. La iglesia está en la Zona Desmilitarizada Acordada y también cerca de la Embajada, por lo que probablemente sea segura.","Fabella") #文字错误
	novel_interface.change_2nd_expression("perspire")
	await novel_interface.show_dialog("Pero bueno, ¿cuándo lo llamaste con mi teléfono? Y ni siquiera me di cuenta... de lo poco profesional que soy...","Fabella")
	novel_interface.character_light(0.35,"perspire")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Ja, no seas tan duro contigo mismo!\n¡Estabas ocupado cocinando!","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Una pequeña sonrisa se cuela en el rostro de Skuld al pensar en la cocina de Fabella.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Dusk.png")
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	await novel_interface.show_text_only("El dúo llega frente a una iglesia de piedra de color marrón, con sus paredes exteriores cubiertas por un enorme mural religioso.")
	await novel_interface.show_text_only("Hay una cruz en la parte superior del techo, luciendo digna y solemne. Varias cúpulas con intrincados tallados exudan un aura grandiosa y majestuosa.")
	novel_interface.show_character("fabiola_maid","normal")
	await novel_interface.show_dialog("No sabía que había una iglesia tan grande cerca de la Embajada.","Fabella")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("New Opulentia es una especie de ciudad académica, ya ves. Se trata de ciencia, por lo que no hay muchas construcciones religiosas por aquí.","Skuld")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Fabella cambia su mapa electrónico a Vista Satélite, curiosa sobre la estructura topográfica y la arquitectura de la zona.")
	await novel_interface.show_text_only("Es un hábito que había cultivado en el escuadrón de operaciones especiales.")
	novel_interface.show_character("fabiola_maid","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("skuld","normal",0.25)
	novel_interface.character_dark()
	await novel_interface.show_dialog("Extraño. Es una iglesia tan grande, pero no hay ningún modelo de ella en el mapa. ¿Existe algún tipo de restricción para construcciones como ésta en territorio internacional?","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Probablemente sea porque la iglesia ni siquiera había sido abierta hasta hace poco. Debe construirse para el Foro el próximo mes. ¿Ver? Los murales todavía parecen nuevos.","Skuld")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu padre estará aquí el próximo mes, ¿verdad? Como miembro del Comité.","Fabella")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Creo que sí. De todos modos, ¡entremos!","Skuld")
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Entrar a la iglesia se siente como entrar en el santuario más antiguo del mundo.")
	await novel_interface.show_text_only("Las paredes son enteramente de mármol. Columnas colosales se alzan sombríamente. Las pinturas al óleo en el techo abovedado y las coloridas ventanas de mosaico que lo rodean crean una atmósfera de santidad y paz.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("¡Date prisa! ¡Mirar! ¡Mirar! ¡Este lugar está estructurado como la Iglesia de la Trinidad!","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","panic")
	await novel_interface.show_dialog("¡E-espérame!","Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Skuld salta por el lugar, disfrutando de cada detalle con deleite, mientras Fabella permanece vigilante, manteniendo abierta la puerta de entrada.")
	novel_interface.character_light(0.35,"normal")
	await novel_interface.show_dialog("(Aún quedan algunos estantes de madera allá en las escaleras...)","Fabella")
	await novel_interface.show_dialog("(Esta iglesia debe estar aún en construcción.)","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella da unos pasos hacia adelante. El aire a su alrededor vibra, casi imperceptiblemente, pero está ahí. Todos sus pelos están erizados, como afectados por la estática.")
	await novel_interface.show_text_only("Ella siempre ha sido muy sensible al peligro, debido a sus años de infancia en los campos de batalla de América del Sur.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("(Espera... algo anda mal...)","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	await novel_interface.show_text_only("A sólo unos pasos delante de Fabella, Skuld de repente se queda en silencio. Ella se queda clavada en el lugar, con las manos cayendo inertes a los costados.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("¡Maldita sea! ¡Tenemos que irnos!","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass1.png")
	await novel_interface.show_text_only("En menos de un milisegundo, la visión de Fabella se oscurece. Los colores de los cristales de las ventanas, que representan historias bíblicas, parecen brillar más, invadiendo todos sus sentidos.")
	await novel_interface.show_text_only("Los colores distorsionan, retuercen, abarrotan su visión como un enjambre de abejas.")
	await novel_interface.show_text_only("La luz naranja del sol poniente afuera se retuerce y se deforma, fundiéndose gradualmente en un color completamente diferente.")
	await novel_interface.show_text_only("Todo parece fusionarse, filtrándose en la nariz y los oídos de Fabella, como un crujido siniestro que se acerca a una velocidad alarmante.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella intenta desesperadamente concentrarse.")
	await novel_interface.show_text_only("No le aclara mucho la cabeza, pero logra abrir los ojos a la fuerza, solo para ver que Skuld se ha desplomado en la alfombra no muy lejos de ella.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("¡Maldita sea!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el momento en que levanta un pie, tratando de llegar a su pequeña ama, sus piernas fallan.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("... No puedo ver...","Fabella")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church_Stained_Glass2.png")
	await novel_interface.show_text_only("Las ventanas de mosaico se enrollan y convulsionan, cada vez más cerca, como una pintura al óleo que se funde en una inundación repentina de colores.")
	await novel_interface.show_text_only("Los objetos representados en las pinturas en mosaico parecen reorganizarse en posiciones extrañas.")
	await novel_interface.show_text_only("El cuerpo de la criada se balancea, la inconsciencia se acerca rápidamente y la colorida invasión en su mente continúa.")
	await novel_interface.show_text_only("La luz que penetra a través de la ventana proyecta sombras en el suelo, tragándose el último de sus sentidos centímetro a centímetro.")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Church.png")
	await novel_interface.show_text_only("Fabella se acurruca abruptamente, saca una daga del interior de una daga.")
	await novel_interface.show_text_only("Apunta a un lugar sin arterias principales y golpea la daga en su muslo sin dudarlo un segundo.")
	await novel_interface.show_text_only("La sangre fresca tiñe de rojo la piel clara de la niña, pero al menos el estallido de dolor le da unos segundos de claridad.")
	await novel_interface.show_text_only("Apretando los dientes, Fabella tropieza al lado de Skuld y levanta a la niña.")
	await novel_interface.show_text_only("Ella se da vuelta y se tambalea unos pasos hacia adelante.")
	await novel_interface.show_text_only("Apuntando a la entrada principal, donde todavía hay luz, arroja a Skuld fuera del edificio con lo que le queda de fuerza de voluntad antes de que la oscuridad se la lleve.")
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("Al menos ahora está a salvo, piensa Fabella. Luego sus ojos se cierran y finalmente ceden a las sombras.")

	print("=== 创伤反射篇第02话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
