# traumareflex_ep11.gd - 创伤反射篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	# 播放创伤反射篇第11话剧本
	traumareflex_ep11_script()

func play_script():
	pass

# 创伤反射篇第11话 - 正式剧本
func traumareflex_ep11_script():
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("無人武装ヘリコプター……『イエローヘッド』")
	await novel_interface.show_text_only("七年戦争中にマサダブルクが研究開発した\nこの重火力無人ヘリは、\n地上にいる人々に悪夢を振り撒いた。")
	await novel_interface.show_text_only("自律アルゴリズムのみで戦闘判定を行うため、\n\n例え外部とのコミュニケーションが、\n一切遮断されたとしても戦場に適応が可能。")
	await novel_interface.show_text_only("ただしAIによる識別技術が完璧ではなく、\n度々大規模な民間人殺傷事件を起こした。\nそのため今も世界中にこの死神の悪名は\n轟いている。")
	await novel_interface.show_text_only("多くの国が条約を締結し、\nターゲットを自動識別する破壊兵器の使用を\n禁止しているが、マサダブルクは未だに\nこの条約を拒否。")
	await novel_interface.show_text_only("悪名が轟こうとも黄黒の死神は潰えず──\n\n今宵も機械的に悪夢を運び、上空からゆっくりと\n死を告げにくる。")
	await novel_interface.show_text_only("機体の両側に搭載された12発の\nスパイクミサイル。\n市街地を真っ平に整地するのには十分な\n威力である。")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("しっ、動かないで──","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラは片膝を突けたまま、手に持っていた\n狙撃銃を地面に置いた。\nそして両手を少し広げ、攻撃意思がない事を示す\n姿勢をとった。")
	await novel_interface.show_text_only("俺はスナイパーに撃たれた衝撃で、尻もちを\n突いたままだ。\nそこから緊張感で全身が凍り付いてしまい、\n呼吸も自由が利かなくなる。")
	await novel_interface.show_text_only("そんなフリーズした思考の中、何か朧げな影が\n『イエローヘッド』の真下から\n近付いているのが見えた。")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("（あのドローン……）\n\n（自爆機能とか付いてたっけ？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("何か策があるのか、上昇するドローンが、\n『イエローヘッド』の付近にまで到達する。\nしかし突如、『イエローヘッド』の尾翼から\nオレンジ色に光る数十発の弾頭が発射された。")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("──ッ！！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("（き、気付かれたかッ！？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("弾頭は弧を描いて『イエローヘッド』の周囲に\n均等に散らばり爆発する。")
	await novel_interface.show_text_only("ヘリの背後にあったビルの窓ガラスと\n飛ばしたドローンが爆発に巻き込まれた。\n宙に広がる炎と混ざり合い、\nキラキラと輝く破片と化す。")
	await novel_interface.show_text_only("赤と青に輝いている看板に破片が照らされ、\nまるで幻想的な花火を見ているかのようだった。")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("（具体的な脅威かどうかを確認できなくても、\n　ミサイル迎撃用の妨害弾を放つなんて……）","ファビオラ")
	await novel_interface.show_dialog("（これが人工知能が制御する戦争兵器……）","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ヘリコプターは角度を調整し、俺とファビオラに\n機首を向ける──")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_VTOL.png")
	await novel_interface.show_text_only("機体の下部に搭載された複眼レンズの\n小さな赤い点。\n無防備な俺達をじっくりと見つめてくる。")
	await novel_interface.show_text_only("息が詰まるような空気の中で、時間の流れは\n限りなく遅く感じた。")
	await novel_interface.show_text_only("死が迫ってくるというのは、死そのものよりも\n恐ろしい。")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("（どれだけ……時間が経ったのだろう）","レン")
	await novel_interface.show_dialog("（ここはファビオラの記憶の中……）\n\n（……つまり実際にあった出来事なんだろ？）","レン")
	await novel_interface.show_text_only("でも、この身に感じる妙な違和感はなんだ……")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Street_Fighting1.png")
	await novel_interface.show_text_only("──『イエローヘッド』が突然傾いた。")
	await novel_interface.show_text_only("金属の衝撃音が響いたと同時に、機体から\nいくつもの破片が剥がれ落ちる。")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("（こ、これって狙撃っ！？）","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("武装ヘリコプターはバランスを崩し落下するも、\nすぐさま飛行を安定状態へと戻した。")
	await novel_interface.show_text_only("ぎこちない動きながらも、下がった高度を\n上昇させる。\n損傷状況に応じて制御システムがバランスを\n調整しているのだろう。")
	await novel_interface.show_text_only("長い間、静かだったイヤホンが音を拾い始める。\n\nノイズのような音の中に、凛とした女性の声が\n混じっていた。")
	await novel_interface.show_dialog("待たせたわね、ひよっ子達！！","女の声")
	await novel_interface.show_dialog("なーんて、登場したのは良いけど……\n\n移動レールガン装置は1度しか使用できないわ。\n普通の弾じゃ、あれを撃ち抜けないからね。","女の声")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("リナッ！？　アルファ隊の様子はッ！？","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("まずは自分達の心配をしろ、あいつはまだ落ちて\nねえぞ！","男の声")
	await novel_interface.show_text_only("かすれた男の声が、まだ危機を脱していない\n事実を俺達に告げる。")
	novel_interface.show_character("ren_mercenary","panic")
	await novel_interface.show_dialog("ファビオラ……\nあれ？？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さっきまで隣でしゃがんでいたファビオラの姿が\n見えない。\n道路の真ん中でボケェっと突っ立っているのは\n俺だけになっていた。")  #换行问题
	await novel_interface.show_text_only("その刹那、転倒した装甲車の背後から\n鋭い音が聞こえてくる。\nオレンジ色の噴射炎をまとった黒い影が、\nヘリコプターに向かって飛翔していった──")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("伏せなさいッッ！！！！","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ズドオォォォーーン――――ッッ！！！！！")
	await novel_interface.show_text_only("俺にはファビオラの咆哮で切り裂かれたか\nのように見えた。\nヘリコプターが大きな音を響かせ、側面から\n赤い炎を吹き出す。")
	await novel_interface.show_text_only("あっという間に炎に包まれる機体。\n\nそして『イエローヘッド』は黒い煙を吐いて、\n回転しながら地面へと叩き付けられた。")
	await novel_interface.show_text_only("再び猛烈な爆発音が鳴ると、歪んだプロペラの\n羽が煙の中から高速で飛び出し──\n──俺の両足の間に突き刺さった。")
	novel_interface.show_character("ren_mercenary","wry_smile")
	await novel_interface.show_dialog("……？","レン")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("……………………？？","レン")
	await novel_interface.show_dialog("うぉわあああああああああッッッ！？！？！？","レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は手足をバタバタさせながら後ずさる。\n\nあまりの恐怖に心臓が飛び出るところだった……")
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("ハハハッ、良い反応ねっ。\nまだ立てるっ？","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("装甲車の後ろからファビオラが出てくる。\n\n使い終わったスティンガーをポイっと捨てて、\n俺の方を見ながらニヤニヤと笑っていた。")
	await novel_interface.show_text_only("俺は顔を真っ赤にしながらも、\n地面から起き上がり乱れた髪を整えた。")
	await novel_interface.show_dialog("やるじゃねえか。","男の声")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("べルナドット？　そっちはどうなったの？","ファビオラ")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("あら、先にありがとうは言ってくれないの？","女の声")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("マーキン先輩、あざぁっすッ！！","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("お前は……女性が前だとすぐこれだ……","ラッセル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("『荷物』は無事だが、\nシュヴァルツは犠牲になった……\nアゾレも重傷だ。","男の声")
	await novel_interface.show_text_only("かすれ声の男が簡潔に状況を説明した。\nいかにも場馴れしていて、冷徹さを感じる。")
	await novel_interface.show_dialog("警察とパランティアの増援は足止めを\n食らっている。\n次の襲撃が来る可能性は高いぞ。","男の声")
	await novel_interface.show_dialog("この道路の両端は封鎖された。\n東のストリートで合流だ。","男の声")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("分かったわ。","ファビオラ")
	await novel_interface.show_dialog("直ちに装備を整理して、即時移動よッ！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("了解ッ！","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("車に残ってるあいつは……","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","bored")
	await novel_interface.show_dialog("あのアホはひとまず放置！","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("了解ッ！","キャセール")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Fabiola/Street_Fighting2.png")
	await novel_interface.show_text_only("補給の弾薬を確保し、道沿いに建っていた\nホテルの窓を破って、隣の道へと移動する。")
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("ここら辺は明かりが灯っているのに、\n人影が1つもないわね……\n……どうしてかしら？","ファビオラ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("疾病管理予防センターの起因らしいがな。\n\n90分前、この辺一帯に\n第3級バイオ危険物漏洩警報を発令したようだ。\n現在は撤回されているみたいだが……","ラッセル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ラッセルはタブレットを動かしながら語る。")
	novel_interface.show_character("fabiola_battle","thinking")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("russell","",0.25)
	await novel_interface.show_dialog("去年休戦したばかりで市民達も、未だ過敏に\nなっているだろう。\nわざわざ警報が出ているのに、首を突っ込もうと\nする物好きはいないだろうよ。","ラッセル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ファビオラは眉間をひそめ、再度問いかける──")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("あの『イエローヘッド』……\n確か全世界で販売禁止になっていたはずよね？","ファビオラ")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("当然だ。あれに搭載されている制御システムは\nやつらの最高機密だぞ。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("それじゃ制御ユニットを外しちまえば……","キャセール")
	await novel_interface.hide_character()
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("やってみたらどうだ？\n墜落した瞬間チップは自爆するがな。","ラッセル")
	await novel_interface.show_dialog("AIモジュールは攻撃と防御、\nそれぞれに独立しているらしい。\nマサダブルクの将校が数か月前、\n片方のモジュールのサンプルを持って離反した。","ラッセル")
	await novel_interface.show_dialog("だが他国の領土すら関係なく追撃するのが、\nマサダの情報機関『マノーラ』のやり方だ。\nその将校を果てまで追って\n最後には乗り物ごと消し炭にしたんだとよ。\n最終的にはこれ見よがしに、炭になった将校を\n自国まで運んだってな。","ラッセル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","wail")
	await novel_interface.show_dialog("（ハハ……そっちの情報機関も超怖えぇ……）","レン")
	await novel_interface.hide_character()
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("おっ、来たぜっ！","キャセール")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は声を合図に振り返ると、後ろから何人かが\nこちらへと歩いてきた。")
	novel_interface.show_character("bernardo")
	await novel_interface.show_dialog("そっちの戦力はまだ4人いるな……\n……1人は新入りか？","ベルナドット")
	await novel_interface.show_dialog("この付近の地図を見せてくれ。","ベルナドット")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("1人は眼帯をしていて、ガタイがすごい\nアルファ隊の隊長。\n合流するや否やファビオラと付近の地理情報の\n分析に没頭している。")
	novel_interface.show_character("leena")
	await novel_interface.show_dialog("あら、かわいいお嬢さん！\n私がリナ・マーキンよ。よろしくね。","リナ")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	await novel_interface.show_dialog("よろしくお願いします。\n……レンと呼んでください。","レン")
	await novel_interface.show_dialog("（さっき狙撃銃で助けてくれた人かな？）","レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("もう1人は、狙撃銃を両手に持ち、\nカラフルなスカーフを頭に巻いているお姉さん。\n俺を上から下まで観察している。")
	novel_interface.show_character("leena")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_mercenary","gratified",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あぁ……あなたのスタイルって……","リナ")
	await novel_interface.show_dialog("若者が言うパンク少女ってやつね？","リナ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_dialog("違いますッ！！","レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("だけど片足だけ穴の開いたストッキングを\n穿いている姿……\n……全く説得力がないな。")
	await novel_interface.show_text_only("うん……")
	await novel_interface.show_text_only("そして隊長の背後から、見覚えのある姿が\nもう1人。")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("こんにちは、レンお姉ちゃんっ。","スクルド")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("また会えたね～～っ。","スクルド")

	print("=== 创伤反射篇第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
