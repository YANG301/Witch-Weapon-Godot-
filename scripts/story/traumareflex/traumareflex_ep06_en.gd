# traumareflex_ep06.gd - 创伤反射篇第06话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep06_script()

func play_script():
	pass

func traumareflex_ep06_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	await novel_interface.show_text_only("—Boom!")
	await novel_interface.show_text_only("Yet another blast. The head of our truck is lifted abruptly, and I am tossed onto the ground.")
	await novel_interface.show_text_only("The exterior of the truck, fortified with the magical Substance H, is barely affected, but we can still feel the crushing force from the inside.")
	await novel_interface.show_text_only("As the truck rolls onto its side, my stomach twists. Feels like I could puke out my guts then and there.")
	await novel_interface.show_text_only("Right... the truck’s armor may be invincible, but the ground certainly isn’t. Just blast the ground and the truck will be rendered immobile.")
	await novel_interface.show_text_only("What a foolish, pointlessly expensive design...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/APC_Blur2.png")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("A headache...")
	await novel_interface.show_text_only("My ears are ringing, eyes barely able to focus.")
	await novel_interface.show_text_only("Luckily I’m wearing a combat jacket filled with non-Newtonian fluid, or else I’d probably have broken most of my bones during the previous mess.")
	await novel_interface.show_text_only("I don’t know who chose the equipment for me, but I guess I should be grateful.")
	novel_interface.show_character("ren_mercenary","awkward")
	await novel_interface.show_dialog("(Still, did they have to make me wear silk stockings?)\n(And there are holes in them now!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bam! Bam! Bam! Bam! Bam!")
	await novel_interface.show_text_only("Fabella punches open the cover over the emergency exit button in the car. The detonation cords on the truck’s roof blow up one after another.")
	await novel_interface.show_text_only("A gaping hole appears on the roof, now positioned towards the side. Acrid smoke and flames invade my nose and the interior of the vehicle.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("Dammit... everyone out!","Fabella")
	novel_interface.change_expression("thinking")
	await novel_interface.show_dialog("*Coughing* Hey, is the newbie okay?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Still barely clinging onto consciousness, I am picked up by Fabella and tossed outside the truck.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("The smoke burns my eyes, making me tear up uncontrollably and blocking my vision.")
	await novel_interface.show_text_only("I take two big gulps of air but get only smoke. My lungs are about to combust...")
	await novel_interface.show_text_only("I begin coughing and dry-heaving by reflex, unable to catch my breath.")
	await novel_interface.show_text_only("My body bucks as I choke, my eyes finally meeting the mask hanging from my neck. I quickly press it over my nose and mouth with one hand.")
	await novel_interface.show_text_only("Whew...")
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	await novel_interface.show_text_only("<Experimental Medication Department, Harima Tech>")
	await novel_interface.show_text_only("After going through the basic details regarding Fabella with me, Mariru and Aya head downstairs to tune some equipment, leaving me sitting there all alone.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("So they just... left? Just like that?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The silent hospital corridors seem oppressive all of a sudden.")
	await novel_interface.show_text_only("I sit there on a chair by the wall, dressed in a totally out-of-place maid outfit.")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Feels like I’m in an R-rated zombie shooter game...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Nah. Zombies don’t exist. Ghosts, on the other hand...","???")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Yeah, haha. Zombies don’t—","Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Wait, who was that?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I leap to my feet at the sudden voice coming from the stairs.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("I’m sorry, did I scare you?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A petite girl peeks out from the corner.")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("And we meet again, Miss Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl’s blond hair falls to her waist in a delicate braid. She looks ethereal, like something out of this world. Not an aura I could ever forget.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Oh, Skurd?","Ren")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Did she call me... Miss?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld smiles at me shyly. She seems anxious, uneasy.")
	await novel_interface.show_text_only("Not at all elegant and gracious, like back when we met in Sky Hotel.")
	await novel_interface.show_text_only("Oh, right! Fabella is her maid. Of course she’ll be worried...")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("I know you’re here because Mariru made you come...\nBut I would have asked you anyway...","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She seems hesitant, shivering a little, valiantly holding in tears as she speaks.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Please... save Fabella...","Skuld")
	await novel_interface.show_dialog("It was all my fault for making her sneak out with me...","Skuld")
	await novel_interface.show_dialog("I didn’t expect this to happen...","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hey, calm down!","Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Oh no, she’s gonna cry!)\n(What do I do?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I almost extend a hand to comfort her, but it just doesn’t seem right for me to hug a little girl... in the corridor of a hospital at midnight... wearing garters and a maid outfit.")
	await novel_interface.show_text_only("I pause, arms in the air, and she flings herself into my chest.")
	await novel_interface.show_text_only("Her soft blond hair falls over my elbows. The girl smells a little bit like milk. My heartbeat quickens, brain buzzing.")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("(She’s so tiny!)\n(What a cutie!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Here, with her face buried in my chest, she seems smaller than she looked. Her frail body trembles, like a cornered animal.")
	await novel_interface.show_text_only("Hm. Did Aya mention something about hacking brains? Can’t remember. Don’t care.")
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("I’ll help you! I’ll definitely help you!\nLeave it all to me!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren.exe has stopped working. I’d say yes to anything she asks me to do. Even bombing the Senate...")
	novel_interface.show_character("ren_maid","blush")
	await novel_interface.show_dialog("It’s okay. I’m right here.","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I’m horrible at comforting others. What good will me being “right here” even do her? Who knows, but don’t people usually say things like that in this kind of situation?")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Yes.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In my embrace, Skuld nods gently.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("I believe in you. You can do it.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Really? I can?")
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("Because... you’re that special person... in my memories.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Okay... wait, what?","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Me, special? Did my maid outfit leave that big of an impression on her?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld calms herself a little, dries her tears, and looks up at me with eyes full of trust.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("I can tell you all my secrets.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("How... unexpected. I have no idea how to react.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("You might find it hard to believe, but please listen.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The small, fragile girl in front of me suddenly sobers up, and I can’t help leaning in, feeling all serious.")
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("I have a... really special ability.","Skuld")
	await novel_interface.show_dialog("I can remember things that haven’t happened yet... or should I say... there are some things that haven’t happened yet, but I can already see them, like memories.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Memories... that haven’t happened yet?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","thought")
	await novel_interface.show_dialog("Those fragments have existed in my memories ever since the very beginning, so I can’t even tell what memories are from the past and what’s from the future.","Skuld")
	await novel_interface.show_dialog("I have to see it happen to be sure.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("So it’s kind of like prophecy?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("This does sound incredible, but I’ve been through so much craziness these few months that I’ve already gotten used to believing six impossible things before breakfast.")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("It’s kind of like... a candy. A little bit sweet, a little bit sour, leaves a minty taste in your mouth when it melts.","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Hm, I’ve had that kind of candy before, but I’m not sure when...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","smile")
	await novel_interface.show_dialog("That’s right!","Skuld")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("You can describe in detail how that candy tastes like, but you can’t tell when or where you tasted it.","Skuld")
	await novel_interface.show_dialog("You’ll only realize “oh, this is it” when you really do get to taste it one day.","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I think I’m beginning to understand. If fragments that can be from the past or the future both exist in your memories, it’d be hard to tell which is which.")
	await novel_interface.show_text_only("It’s not seeing the future, to be exact. Because she can’t tell which memories are from the future.")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Wait... but surely she’d be able to figure it out with some clues in the environment?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It’s as if Skuld reads my mind. She explains:")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("You might be thinking: it’s true you might not be able to tell if something happened in the next month or the last, but the environment ten years in the future will surely look very different from what it does now, right?","Skuld")
	await novel_interface.show_dialog("But memories... they’re not like video footage. All we get is fragments...","Skuld")
	await novel_interface.show_dialog("Our brains can only rebuild the whole scene of a memory when we focus very hard on it, you know?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It makes sense. I remember this line from a movie:")
	await novel_interface.show_text_only("“Memories are interpretations, not recordings.”")
	novel_interface.show_character("skuld","think")
	await novel_interface.show_dialog("Therefore, it’s actually not that easy to find fragments in my memories that allow me to pinpoint the time frame.\nBesides...","Skuld")
	novel_interface.change_expression("thought")
	await novel_interface.show_dialog("You don’t usually delve into your memories for no reason at all, right?","Skuld")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Hmm?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("For example, you won’t reminisce about your elementary school math class and what the teacher wrote on the blackboard, just for fun, right?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Of course. Math class... teachers... certainly not fun.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("I believe you, it’s just... wow. That’s incredible.","Ren")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Wait. So, the “me” in your memories that you just mentioned...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld nods.")
	novel_interface.show_character("skuld","painful")
	await novel_interface.show_dialog("Anyway, there’s only one thing in my memories that I’m sure happened in the future.","Skuld")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/Soul_Sacrifice.png")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("I hold my breath. I suddenly have a feeling that I can guess what she’s referring to...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... It’s a memory of the moment the world ends.","Skuld")
	await novel_interface.show_dialog("But in that memory, you’re a boy.","Skuld")

	print("=== 创伤反射篇第06话结束 ===")
	await novel_interface.end_story_episode(0.5)
