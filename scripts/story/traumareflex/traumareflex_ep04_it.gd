# traumareflex_ep04.gd - 创伤反射篇第04话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	traumareflex_ep04_script()

func play_script():
	pass

func traumareflex_ep04_script():
	novel_interface.change_background("res://assets/images/bg/APT/washingRoom.png")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Bene, torna indietro... no, non è giusto...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Bentornato, M-maestro...","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Sembra comunque strano...","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Comunque...","Ren")
	await novel_interface.show_dialog("Perché devo accettare un lavoro part-time in un maid café?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Che razza di missione segreta è questa? Mariru vuole solo vedermi soffrire, scommetto!")
	await novel_interface.show_text_only("Il maid café nell'area dell'ambasciata è davvero piuttosto popolare e ho letto anche articoli online a riguardo.")
	await novel_interface.show_text_only("Ambiente elegante, ottimo cibo, argenteria di classe... e, ultimo ma non meno importante, le cameriere sono tutte carinissime!")
	await novel_interface.show_text_only("Ma io sono il tipo che si imbarazza facilmente se una ragazza mi chiama “Maestro”, quindi non sono mai andato.")
	await novel_interface.show_text_only("Ero così ingenuo allora...")
	novel_interface.show_character("ren_maid","shy_left")
	await novel_interface.show_dialog("Perché ora invece sono io a chiamare gli altri “Maestro” – e questo è ancora più imbarazzante!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(E questo vestito da cameriera è così inutilmente complicato!)","Ren")
	await novel_interface.show_dialog("(La gonna è già piuttosto corta all'inizio...)\n(E ora, con una crinolina per gonfiarla, è ancora più corta! Come vogliono che io cammini?)","Ren")
	await novel_interface.show_dialog("(E le giarrettiere... questa è la prima volta che le indosso.)\n(Quindi la chiusura... va in vita, eh?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Guardo le giarrettiere di pizzo bianco sulle mie gambe.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(Quindi ecco come appaiono le giarrettiere da una prospettiva in prima persona...)\n(... Hm, che carino!)","Ren")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Fammi scattare una foto. Nessuno deve saperlo!)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Clicca!")
	novel_interface.show_character("ren_maid","uneasy")
	await novel_interface.show_dialog("Ehm, lasciami esercitarmi ancora un po'...","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se venissi licenziato prima ancora di poter superare l'addestramento, Mariru probabilmente mi calpesterebbe a morte.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Bentornato, Maestro!","Ren")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Cosa vorrebbe il Maestro che scrivessi sulla tua frittata, nyan?","Ren")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Uffa, è così imbarazzante!","Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ok, proviamolo ancora una volta...","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ah, si sta facendo tardi. Devo togliermi questo vestito ridicolo e andare a letto...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("... Questo vestito da cameriera ti sta bene.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Sì! Sarai una bravissima cameriera!","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esco dal bagno e trovo Mariru e Aya sul divano del mio appartamento, che sembrano incredibilmente divertite.")
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Mariru? E anche Aya?","Ren")
	await novel_interface.show_dialog("Quando... quando sei arrivato qui?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Siamo qui da un po', a dire il vero.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Quindi... la mia pratica...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Abbiamo sentito tutto, ovviamente!","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_text_only("Uccidimi adesso...!")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Aw... comunque, cosa ci fai qui?","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","happy",0.25)
	await novel_interface.show_dialog("Per vederti vestire da cameriera e mettere in atto tutte le tue fantasie davanti a uno specchio, ovviamente!","Mariru") #少字问题
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dovevi dirla così?\n(Anche se non ha torto, suppongo...)","Ren")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("Non è colpa mia se devo addestrarmi per la missione sotto copertura che mi hai affidato.","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pensi davvero che diventerai una brava domestica semplicemente ripetendo alcune righe? Non è così facile, lo sai.","Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("L'elicottero aspetta sul tetto. Andiamo.","Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh? Hai una missione per me? A quest'ora della notte?\nDammi un secondo, devo cambiare...","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Va bene. Anche il nostro obiettivo per questa missione è in realtà una cameriera, quindi ti adatterai perfettamente.","Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ha semplicemente sorriso? Lo ha fatto sicuramente! Uffa!")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ma... questo vestito...","Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","stare",0.25)
	await novel_interface.show_dialog("Non sarà un problema. L'ultima volta che hai incontrato il bersaglio, anche tu indossavi un completo da cameriera.","Aya")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa?","Ren")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wink")
	await novel_interface.show_dialog("Vieni con noi e vedrai.","Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("…")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	await novel_interface.show_text_only("Noi tre portiamo l'elicottero in una grande struttura medica, attualmente semivuota poiché la maggior parte del personale era andata a casa.")
	await novel_interface.show_text_only("L'edificio è silenzioso, a parte il ronzio delle macchine in sottofondo. I nostri passi risuonano sulle silenziose pareti imbiancate.")
	await novel_interface.show_text_only("Non c'è nessuno in vista. I corridoi ben illuminati sembrano in qualche modo ancora più macabri dell’oscurità totale.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Questo è... un ospedale?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Potrei dire che questa deve essere un'operazione segreta da come i piloti degli elicotteri erano entrambi agenti con cui ho familiarità.")
	await novel_interface.show_text_only("Mariru partecipa raramente alle missioni lei stessa, ma è ovvio che, questa volta, vuole assicurarsi che meno persone lo sappiano, meglio è.")
	await novel_interface.show_text_only("Noto anche che tutte le telecamere di sicurezza qui sono state ruotate verso le pareti.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Questo è il dipartimento di farmaci sperimentali nel centro di ricerca di Harima Tech.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("L'identità del nostro obiettivo questa volta è estremamente delicata. La missione è top secret, nemmeno il Senato può saperlo.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("Harima Tech... non appartiene però al Senato?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Durante il mio addestramento al SID, ho dovuto memorizzare i nomi di tutte le organizzazioni da cui evitare. Harima Tech è uno di questi.")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("E il Dr. Bright non era un ricercatore qui?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Oh, quell'uomo gorilla? Ora si è stabilito in modo indipendente. Questo posto non ha più niente a che fare con lui.","Mariru")
	await novel_interface.show_dialog("Questo è un dipartimento di ricerca pratica. La SID ordina moltissimo da questo tipo di organizzazione.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Abbiamo ordinato un sacco di attrezzatura speciale da qui! Infatti, la maggior parte degli edifici di questo dipartimento sono stati costruiti esclusivamente per...","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Per soldi. Aya non ha bisogno di dirlo.")
	await novel_interface.show_text_only("Ah, un rapporto acquirente-venditore molto... affidabile, eh?")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Il nostro obiettivo si chiama Fabella. L'hai incontrata una volta, nella missione allo Sky Hotel.","Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Lei è la cameriera che ti ha preso da parte e ti ha rimproverato di essere un maldestro.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Oh, lei? Mi ricordo. Portava occhiali dalla montatura rossa, vero? E lavorava per una ragazzina...","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Esatto. Skurd Axelrod. Figlia unica di un membro di alto rango del Secondo Comitato Cittadino dell'Accademia.","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ci ha inviato un messaggio quattro ore fa tramite la lavanderia a gettoni.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Quindi lei vuole... tradire il suo popolo?","Ren")
	await novel_interface.show_dialog("(Skuld non è davvero giovane? Per quanto ricordo, probabilmente ha la stessa età di Elluka...)","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Sulla base di ciò che ci ha detto Skuld, la nostra squadra di recupero è riuscita a trovare Fabella priva di sensi in una chiesa nella Zona Demilitarizzata Concordata.","Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Abbiamo rilevato composti del complesso dietilammidico dell'acido lisergico nel suo sangue. Nel cortile della chiesa sono stati rinvenuti anche dispositivi di distribuzione di aerosol chimici di livello militare.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Armi chimiche allucinogene, eh? Vedo che è un metodo molto fantasioso per far sì che i tuoi nemici si rivolteranno l'uno contro l'altro.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("È stato un attacco terroristico?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("No, più come una trappola per mosche.","Mariru")
	await novel_interface.show_dialog("Skuld ce lo ha già detto. Fabella è una strega.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Eh?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Adesso capisco perché mi hanno chiesto di venire fin qui a mezzanotte.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Dopo che abbiamo neutralizzato gli allucinogeni nell'organismo di Fabella, è ancora in coma profondo...","Aya")
	await novel_interface.show_dialog("Non siamo riusciti a svegliarla nemmeno dopo aver iniettato una grande quantità di Levodopa.","Aya")
	await novel_interface.show_dialog("Il suo livello di metabolismo cellulare è alle stelle e la sua temperatura corporea... non siamo riusciti a controllarla nemmeno immergendola in acqua ghiacciata.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Qualsiasi essere umano normale avrebbe perso la maggior parte dei propri organi in condizioni come queste, ma il suo corpo sembra avere un'incredibile tolleranza alle alte temperature.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Skuld ci ha detto che Fabella è una strega del fuoco. Posseduto dalla magia del fuoco.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Posseduto?","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questo termine mi sembra strano.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Secondo la nostra analisi sui dati attualmente raccolti, possiamo vedere la magia come un campo che manipola le \"informazioni\".","Mariru")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Fabella non è come Elluka, che può controllare direttamente i campi elettrici. La sua situazione è più simile a quella... \"certe informazioni potenti\" hanno scelto di possederla.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Parli come se l'informazione avesse una volontà propria.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Lo fanno. Se una stringa di informazioni ha una densità sufficientemente elevata e un valore di entropia sufficientemente basso, può acquisire una volontà.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Quando Fabella perse conoscenza, le \"informazioni viventi\" iniziarono a impossessarsi del suo corpo...","Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In un certo senso, mi ricorda quell'articolo in cui un proprietario in coma veniva mangiato dal suo stesso animale domestico. Mi viene la pelle d’oca solo a pensarci.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Ben presto, mi sono reso conto che il motivo per cui non potevamo svegliarla era che era già \"sveglia\".","Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Abbiamo scansionato il suo ippocampo e la corteccia prefrontale, ed erano entrambi impegnati al lavoro, come se stesse ricordando qualcosa.","Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Tuttavia, il suo tronco cerebrale non ha inviato alcun segnale riflessivo efficace. È come se qualcosa lo stesse bloccando.","Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le parole di Aya escono in fretta. Sembra davvero troppo ansiosa.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("E quando abbiamo scansionato il suo cervello con un sensore Boltzmann, abbiamo rilevato tratti di mutazioni...","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Aspetta... vuoi dire che ci sono dei bozzoli di strega... nel suo cervello?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Bingo!","Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Quindi ho pensato che abbiamo un dispositivo che ci permette di hackerare il cervello di qualcuno, per così dire. Harima Tech lo sta sviluppando per SID da un po'.","Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("È solo un prototipo, ma ha già superato il test alfa.","Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Quindi adesso sono il tuo topo da laboratorio?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Sei la nostra ultima risorsa.","Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Abbiamo già inviato quattro agenti nel cervello di Fabella, ma qualcosa continuava a \"respingerli\".","Mariru")
	novel_interface.show_background("res://assets/images/bg/Fabiola/TheWall.png")
	await novel_interface.show_dialog("Gli agenti lo hanno descritto come “un muro infinito che si frappone”.","Mariru")

	print("=== 创伤反射篇第04话结束 ===")
	await novel_interface.end_story_episode(0.5)
