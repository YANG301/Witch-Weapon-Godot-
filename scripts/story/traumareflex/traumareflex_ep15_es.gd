	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella ya ha derribado alrededor de diez arañas, pero están entrando más por las puertas del ascensor.")
	await novel_interface.show_text_only("Nos estamos quedando sin munición y no tenemos más remedio que retroceder, acercándonos.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Todos nuestros conjuntos están hechos de fibra impermeable. ¿Dónde encontramos telas que puedan absorber líquidos? ¿Tenemos que quedarnos en ropa interior o algo así?","Russel")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_mercenary","perspire1")
	await novel_interface.show_dialog("¡E-oye, prueba esto!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le lanzo mi “pequeña mochila de emergencia” a Cassel antes de darme la vuelta y correr hacia las colinas.")
	await novel_interface.show_dialog("¿Eh? ¿Qué es esto?","Cassel")
	await novel_interface.show_dialog("Serie F... paquete de 18... alta transpirabilidad, sin agente fluorescente...","Cassel")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("¡Deja de leerlo en voz alta!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Período de menstruación... para pieles sensibles... 250 mm de largo...\n¿Puede ser...?","Cassel")
	novel_interface.show_character("ren_mercenary","shy_left")
	await novel_interface.show_dialog("¡Vamos, idiota, no lo leas en voz alta!","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","mock")
	await novel_interface.show_dialog("Ah, ya veo lo que es. Es perfecto.","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella me envía una mirada significativa.")
	await novel_interface.show_dialog("¡Oh, esto es maravilloso!\nIncluso se hincha un poco después de absorber agua. ¡Sellará la botella a la perfección!","Cassel")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(¿De verdad tienes que entrar en detalles? Vamos...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Pronto, Cassel reaparece detrás del estante con sus cócteles Molotov recién creados.")
	await novel_interface.show_text_only("Siguiendo las órdenes de Fabella, mantenemos a Cassel cubierto mientras todos nos movemos como uno solo hacia el ascensor.")
	await novel_interface.show_text_only("Lanza algunos cócteles Molotov y la entrada del ascensor arde en llamas.")
	await novel_interface.show_text_only("Eliminamos el resto de arañas con la munición y armas cuerpo a cuerpo que nos quedan.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Deberíamos estar bien por ahora...","Russel")
	await novel_interface.hide_character()
