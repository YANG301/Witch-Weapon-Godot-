	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(¿Q-qué quiere decir con eso?)","Ren")
	await novel_interface.show_dialog("(¿Y por qué sonríe como si supiera algo?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Solo me quedan dos balas en mi cargador.")
	await novel_interface.show_text_only("Aunque estamos a salvo por ahora, realmente no me queda ningún elemento útil.")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(Quizás en la, eh, última ronda, yo... ¿morí aquí?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro ansiosamente las llamas anaranjadas que devoran la entrada del ascensor, y me pregunto...")
	await novel_interface.show_text_only("¿Cuál es el sentido de esta situación del día de la marmota?")
	await novel_interface.show_text_only("No importa cuantas veces repita esta experiencia...cuantos gadgets nuevos traigo conmigo...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¿Todavía moriré una y otra vez?")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("…")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Lo que debes hacer es encontrar información clave en los recuerdos del objetivo. No dejes ninguna piedra sin remover.","Mariru")
	await novel_interface.show_dialog("El objetivo se encuentra actualmente en lo alto de la escala de coma. No sabemos mucho sobre su pasado, por lo que no estamos seguros de en qué parte de su memoria está atrapada actualmente.","Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Lo que significa que debes prestar atención a cada detalle... ¡incluso si tu objetivo está en la ducha!","Aya")
