	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Me duele la cabeza.")
	await novel_interface.show_text_only("Un dolor de cabeza realmente serio.")
	await novel_interface.show_text_only("Se siente como un saco de cemento en mi cerebro y alguien lo está removiendo. Se siente familiar...")
