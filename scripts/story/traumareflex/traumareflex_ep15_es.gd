	await novel_interface.show_dialog("(¿Quizás alguien más también ha traído ciertos elementos a este recuerdo? ¿No solo yo?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("O tal vez no sea alguien, sino… algo con voluntad propia.")
	await novel_interface.show_text_only("Recuerdo, antes de que comenzara esta misión...")
	await novel_interface.show_text_only("…")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Skuld nos dijo que Fabella es una bruja de fuego. Poseído por la magia del fuego.","Mariru")
