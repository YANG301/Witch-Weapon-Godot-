	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(¿Cómo debería lidiar con esos errores entonces?)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervioso, rebusco entre mi equipo. Si cada objeto en mí tiene un propósito...")
	await novel_interface.show_text_only("El único que aún no he usado es el pequeño kit de emergencia.")
	novel_interface.show_character("ren_mercenary","sob")
	await novel_interface.show_dialog("(No puede hacer mucho excepto, ya sabes, “recuperar HP mínimo”, aunque... se considera bastante inútil en esos juegos de zombies...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Paso mis dedos sobre la bolsa en forma de cubo suavemente empaquetada en mi mochila.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("(Espera...)\n(Esto se siente como...)","Ren")
