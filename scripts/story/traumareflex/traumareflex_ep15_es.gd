	await novel_interface.show_dialog("¿Qué es esto...?","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella mira las llamas en sus manos confundida. Se extendieron hacia afuera, formando una barrera a su alrededor.")
