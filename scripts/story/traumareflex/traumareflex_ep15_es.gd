	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/War Drum.mp3")
	await novel_interface.show_text_only("Sigo los sonidos de hundimiento y veo más de una docena de arañas escalando el hueco del ascensor. Detrás de ellos vienen más.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("¡Todos, en su lugar!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El escuadrón inmediatamente entra en modo batalla y comienza a disparar.")
	await novel_interface.show_text_only("Fabella carga su escopeta con una mano y agarra una daga con la otra. Utiliza su antebrazo izquierdo como soporte para el arma mientras apunta.")
	await novel_interface.show_text_only("Elimina dos arañas con dos tiros limpios, luego destroza una tercera con su daga y su pie izquierdo, abrumada por la rabia hacia aquellos monstruos que se llevaron a su amiga.")
	novel_interface.show_character("cassell")
	await novel_interface.show_dialog("¡Me estoy quedando sin munición!","Cassel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel le lanza una revista a Cassel.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Este es el último. Vaya a revisar los estantes de almacenamiento y vea si hay algo utilizable.","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cassel asiente, recarga su arma y sigue retrocediendo mientras continúa disparando, hasta que desaparece detrás de una fila de estantes de almacenamiento.")
	novel_interface.show_character("ren_mercenary","serious")
	await novel_interface.show_dialog("¡Skuld, ponte detrás de mí!","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Agarro con fuerza mi metralleta y la cambio al modo de disparo único.")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("(Solo me quedan alrededor de una docena de balas...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Oye, Russel, adivina lo que encontré!\nUna caja entera de vodka destilado polaco, de quince años.","Cassel")
	await novel_interface.show_text_only("Cassel suena extraordinariamente emocionado.")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("Idiota, ¿estás intentando hacer un cóctel molotov?","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Creo que funcionaría. Dice 96% de contenido de alcohol... seguramente no es para beber.","Cassel")
	novel_interface.show_character("ren_mercenary","solemn")
	await novel_interface.show_dialog("Rina dijo que esas arañas detectan sus objetivos al sentir el calor.","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_battle","thinking")
	await novel_interface.show_dialog("Los cócteles molotov no son tan sencillos de preparar.","Fabella")
