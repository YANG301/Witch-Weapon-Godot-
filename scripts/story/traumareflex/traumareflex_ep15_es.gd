	await novel_interface.show_text_only("¿Quizás sea porque simplemente aún no estamos preparados para enfrentar la oscuridad detrás de los cielos estrellados?")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Factory.png")
	await novel_interface.show_text_only("Mmm. Si esas arañas no fueron enviadas por la gente de Rina...")
	await novel_interface.show_text_only("Entonces ¿de dónde vinieron? Armas mecánicas, a tan gran escala, aparecen dentro de la Segunda Ciudad Academia así como así. Inaudito.")
