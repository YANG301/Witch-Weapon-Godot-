	await novel_interface.show_text_only("¿Yo... la “construí” según mis propios recuerdos?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fabella solía ser líder de escuadrón de fuerza especial bajo Ritnalap, organización de inteligencia en la Segunda Ciudad Academia.")
	await novel_interface.show_text_only("Pero más tarde se convirtió en una sirvienta-guardaespaldas de Skuld.")
	await novel_interface.show_text_only("Si esta fuera la primera vez que se conocieran.. ¿qué pasó aquí exactamente?")
	novel_interface.show_character("russell")
	await novel_interface.show_dialog("¡Oye, esos insectos están entrando a raudales desde el techo!","Russel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Russel grita de repente, señalando el techo.")
	await novel_interface.show_text_only("Varias pequeñas arañas robot se han escabullido desde el respiradero sobre el almacén.")
	novel_interface.show_character("fabiola_battle","angry")
	await novel_interface.show_dialog("¡Uf, odio los insectos!","Fabella")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continúo mirando este “Skuld” y ni siquiera me molesto en recoger un arma cuerpo a cuerpo para nuestra última batalla.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Sigo trayendo nuevos elementos que necesito a este mundo...)","Ren")
	await novel_interface.show_text_only("Pero la que realmente se encarga de mantener a raya esa “información con voluntad” es la propia Fabella.")
	await novel_interface.show_text_only("La clave para cambiar el rumbo ya había aparecido antes de que lo hiciera la primera araña robot, ¿verdad?")
	await novel_interface.show_text_only("Ese objeto... parecía estar demandando mi atención, instándome a tocarlo...")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("ren_mercenary","solemn")
