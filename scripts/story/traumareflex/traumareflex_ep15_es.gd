	await novel_interface.show_dialog("Señorita Ren...","Skuld")
	novel_interface.show_background("res://assets/images/bg/Fabiola/Factory.png")
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("¡Señorita Ren!","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Skuld tirando de mi manga me devuelve a la realidad.")
	novel_interface.show_character("ren_mercenary","gratified")
	await novel_interface.show_dialog("¿Mmmm?","Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("skuld","normal")
	await novel_interface.show_dialog("Esa cosa que le diste a Cassel... ¿Qué es eso?","Skuld")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pregunta Skuld, estudiando la bolsa de forma cuadrada en sus manos con ojos puros e inocentes.")
	novel_interface.show_character("ren_mercenary","shy")
	await novel_interface.show_dialog("Eh... es...","Ren")
	await novel_interface.show_dialog("(¡Dios me ayude! ¡No me preguntes esto delante de todos!)","Ren")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tú… no tienes edad suficiente para eso, jaja.","Ren")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("(Tampoco tengo mucha experiencia en usarlo...)","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intento torpemente cambiar de tema. Realmente no quiero explicarle algo como esto a una niña tan joven...")
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Espera. Una niña tan joven...")
	novel_interface.show_character("ren_mercenary","upset")
	await novel_interface.show_dialog("(La primera vez que conocí a Skuld, ella era solo un poco mayor que Elluka).","Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pero este recuerdo debería ser de hace dos años. Las niñas de esta edad suelen cambiar mucho en dos años.")
