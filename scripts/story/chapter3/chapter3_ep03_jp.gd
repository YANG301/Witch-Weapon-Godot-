# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("まさか……奴に関する第三者的な情報を、\\n全て削除しちゃう気か？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("いいや、その逆だ。より多くの情報を加える。", "マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("んんんっ！？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルの笑顔が不気味になる。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("現在、お前の顔をした犯人に関しての情報は、\\n非常に不鮮明な映像に基づいているだけだ。", "マリル")
	await novel_interface.show_dialog("さて、ここで問題だ。世界中において、\\nあの平凡な顔と似た人間は何人いると思う？", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("ちょっと待ってくれ、\\n平凡って遠回しな嫌味だよねそれ！？")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("「俺」と似ている人はいるかもしれないけど、\\nちょっと調べてみたら分かる事じゃないのか？", "小憐")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("その人が、その日にどこで何をしたか　なんて、\\n防犯カメラのデータを調べれば一目瞭然だろ？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("そうだな……実在する人物を調べる行為は、\\nさほど難しい事ではない。", "マリル")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("だが、もしも調査対象の中の一部に存在しない\\n人間が含まれていたとしたら？", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それって……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("容疑者の顔と非常に似ている偽装のターゲットが\\n複数人も存在してしまえば、\\n世界が滅びるまで捜索しようとも\\n発見できるはずがない。", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("そして私たち以外の人間には、あの連中も"+GameConfig.player_name+"と同じく、奇妙に姿を消した行方不明者にすぎない。", "マリル")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("そうなってしまっては、本物のターゲットが一体\\n誰なのかを誰がどうやって判断するのだろうな？", "マリル")
	await novel_interface.show_dialog("早い話が、壁の汚れを消す方法は2つという事。\\n\\n汚れを1つずつ落としていくか、\\n汚れと同じ色のペンキを撒き散らすか。", "マリル")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("なんか大規模なプロジェクトでも開始するか\\nのように聞こえるけど……それって……", "小憐")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("そうだ。簡単な事をあえて複雑化し、\\n国民の血税を投入する事で、\\n納税という愉悦を国民に分け与えるのと同義だ。", "マリル")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("マリルによるその節の発言を聞くたび、\\n世の中のために通報したくなる。", "小憐")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("そういえば、元のお前の個人情報について、\\n照合していた時に矛盾を発見した。", "マリル")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("え？　それは？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("お前の両親についてだ。", "マリル")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("両親という単語を聞き、俺の心が急に重くなる。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("以前のお前の話では、母親は早くに亡くなり\\n父親も現在行方不明。", "マリル")
	await novel_interface.show_dialog("これが思い出したくない記憶だとしても、\\nどうも不可解なんだ。\\nだから、お前に改めて確認を取りたい。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("うん……", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルが事前にメモしていた、俺の昔のデータを\\n取り出した。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("ここに表示されている内容によると、\\n母親：2026年7月25日\\n『大災難の日』に失踪し、推測により死亡認定。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…………", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("新豊洲北西側の海底廃墟は、『大災難の日』の前\\nまでは繁栄した都市だった。")
	await novel_interface.show_text_only("あの辺りの記憶は、俺もぼんやりしている……")
	await novel_interface.show_text_only("あの都市が聖痕兵器により滅ばされたと同時に、\\nイージスシステムの防御フィールドが展開した。\\n新豊洲はフィールドの内部に位置していたため、\\n何とか攻撃を免れる事ができたが……")
	await novel_interface.show_text_only("……その事件こそが『七年戦争』の引き金と\\nなったのは、言うまでもない。")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("父親：2026年12月より行方不明、推測……", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("や……やめてくれ、お願いだ。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("無情な推測で語られるのが嫌なんだ……\\n\\nおそらく「死亡」だなんて。")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("父さんはまだ、生きているかもしれない……\\n俺はずっとそう思っている。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("……そうだな。\\n息子が立派な美人へと育ったのだから、\\nお父さんもきっと喜んでくれている事だろう。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("予想外のマリルの言葉で笑ってしまった。\\nまったく、皮肉だって言うのに。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("それはさておきだ、まずはここを見てみろ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが俺の両親の記録をクリックして開く。\\nそこには2種の番号表記があった。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ここに記録されている内容は──", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──母親、番号　オフライン\\n──父親、番号　オフライン")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("……何か問題でもあるのか？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("イージスの展開前か、防御フィールドの範囲外で\\n遭難したのであれば……\\nお前の母親は『イージス上での番号』を\\n持っているはずがないんだ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("……えっ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは何かを考えながら、俺を見つめる。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("お前にも分からないのか？\\n記録に問題はないはずなんだ。\\n私も引き続き調査をしてみよう……", "マリル")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
