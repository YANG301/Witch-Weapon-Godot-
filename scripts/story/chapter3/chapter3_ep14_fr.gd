# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Administrateur de Smite \\nElluka…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Derrière lui, je vois plusieurs militaires de la sécurité allongés sur le sol.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ils viennent de s'évanouir. Tuer dans la zone démilitarisée ne fait pas partie de mes plans.", "Jacob")
	await novel_interface.show_dialog("J'avais l'intention de reprendre des pages du livre culte des Sept Philosophes, et je ne m'attendais pas à un tel bonus…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Livre des Sept Philosophes…) \\n(Est-ce le Grimoire lié au Papillon d'Or ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren… J'ai trouvé beaucoup de vieilles blessures sur le corps de Elluka lorsque je l'ai aidée à se laver.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Vous avez lavé Elluka ?) \\n(Quand !?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(Non, ce n'est pas le sujet.) \\n(Vieilles blessures… Ça veut dire…!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Aucun enfant ordinaire ne pourrait endurer une expérience aussi traumatisante !", "Annie")
	await novel_interface.show_dialog("Ce doit être ce type ..., c'est lui !!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oh... \\nOn dirait que cette chose n'est pas encore cassée.", "Jacob")
	await novel_interface.show_dialog("Eh bien, je suppose que SID a déjà fait de l'ingénierie inverse… \\nLa technologie que j'ai utilisée dessus.", "Jacob")
	await novel_interface.show_dialog("Si j'avais su que cela causerait autant de problèmes, j'aurais installé un dispositif d'autodestruction dessus.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Vous—!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Connard !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La prochaine chose que je sais, Annie rebondit furieusement et essaie de donner un coup de pied à Jacob au visage.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Grincement—")
	await novel_interface.show_text_only("Avec un cri, la pièce est éclairée par un énorme arc électrique. Pendant un instant, je suis aveuglé.")
	await novel_interface.show_text_only("Il faut quelques secondes pour que l'éblouissement disparaisse. Une douleur cuisante persiste dans mes yeux.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie… !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie perd connaissance et tombe au sol. Une bande de marques de brûlure en forme de branche apparaît sur sa peau.")
	await novel_interface.show_text_only("Le soldat à côté de Jacob tient un pistolet fumant… Est-ce l'arme qu'ils ont utilisée tout à l'heure ?")
	await novel_interface.show_text_only("Le soldat retire rapidement une munition de type batterie, de la taille d'un petit cylindre.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Nous savons comment tirer le meilleur parti des sorcières…", "Jacob")
	await novel_interface.show_dialog("Je préfère les attraper vivants. Mais la salope SID arrive bientôt…", "Jacob")
	await novel_interface.show_dialog("Maintenant que nous manquons de temps…", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob sort un morceau de métal en forme de tarte. La coquille vert grisâtre dégage un éclat bleu clair familier.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Est-ce… une arme Substance H ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Je ressens… le flux du pouvoir magique…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Qu'est-ce que tu fais ? C'est une zone démilitarisée !", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Ren)", "Mariru")
	await novel_interface.show_text_only("La voix de Mariru sort soudainement des écouteurs.")
	await novel_interface.show_dialog("(C'est un piège fait de fibres auto-liantes.) \\n(C'est une arme Substance H non mortelle.)", "Mariru")
	await novel_interface.show_dialog("(Il explose trois secondes après la détonation.) \\n(Et les fibres se répandront partout. Il est impossible de s'échapper.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Alors, garde tes forces pour le moment.) \\n(Je vais trouver comment te faire sortir…)", "Mariru")
	await novel_interface.show_text_only("Jacob lève lentement le piège dans sa main droite. Des lignes dorées apparaissent sur sa paume, comme si elles étaient prêtes à se battre.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Sa main… est-ce une inscription magique ?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Enfin… À mon tour de découvrir l'arme Substance H…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Désolé pour ça…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice m'attrape soudainement d'une main et arrache le collier de Raphael de l'autre.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout d’un coup, le pendentif émeraude émet un rayon éblouissant et se transforme en une puissante épée avec des inscriptions sur la lame.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Regardez ces âmes misérables implorant d'effacer leur péché...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Quoi…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Tais-toi !", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice enfonce lourdement l'épée dans le sol.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob ouvre la bouche, mais rien ne sort. \\nLa pièce est remplie d'un silence de mort.")
	await novel_interface.show_text_only("Le sol sous Jacob se fissure, ne révélant rien d'autre qu'une obscurité totale.")
	await novel_interface.show_text_only("Un bruit effrayant vient des profondeurs de l’obscurité, comme si des millions de personnes pleuraient et hurlaient de l’enfer.")
	await novel_interface.show_text_only("Une fumée noire jaillit de la fissure et envahit tous les coins de la pièce, désormais enveloppés dans une obscurité infernale en un rien de temps.")
	await novel_interface.show_text_only("Frappé d’un frisson jusqu’aux os et d’un profond sentiment de terreur, mes cheveux se dressent et je ne peux plus bouger…")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Mais quelques secondes plus tard, l’obscurité se dissipe. \\nEt la fissure est introuvable.")
	await novel_interface.show_text_only("Comme s'il souffrait d'une crise de panique, Jacob tombe au sol et se gratte follement le cou si fort qu'il saigne.")
	await novel_interface.show_text_only("Son visage devient rouge alors qu'il a du mal à respirer. Mais ses poumons semblent avoir été vidés d'air, le laissant haleter en vain.")
	await novel_interface.show_text_only("Il lui faut un certain temps avant de reprendre un léger souffle.")
	await novel_interface.show_text_only("L'homme grand et bien bâti se recroqueville sur le tapis, tremblant, les bras croisés sur la poitrine.")
	await novel_interface.show_text_only("Ses yeux injectés de sang sont pleins de peur. Les larmes sortent à la suite de la décompression.")
	await novel_interface.show_text_only("Les lignes sur sa main ont complètement disparu, et le piège tombé sur le tapis a également perdu de son éclat.")
	await novel_interface.show_text_only("Les soldats masqués sont tous immobiles, tremblants.")
	await novel_interface.show_text_only("Sur leurs visages vides, ils semblent saisis par l’horreur de voir une réalité au-delà de toute description.")
	await novel_interface.show_text_only("Si vous regardez longtemps dans un abîme, l’abîme vous regarde aussi…")
	await novel_interface.show_text_only("Face à une véritable horreur, même la respiration…")
	await novel_interface.show_text_only("Vous fait vous sentir exposé à un désespoir indescriptible.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Allons-y !", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Ren, sors de là !)", "Mariru")
	await novel_interface.show_text_only("Ce n’est que maintenant que j’ai repris mes esprits. Avec un signe de tête à Beatrice, je quitte la pièce avec Annie dans mes bras.")
	await novel_interface.show_text_only("Beatrice entraîne Raphael, qui est toujours hébété. Nous nous précipitons vers l’ascenseur…")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
