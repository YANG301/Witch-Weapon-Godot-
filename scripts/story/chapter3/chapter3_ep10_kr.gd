	await novel_interface.hide_character()
	await novel_interface.show_text_only("게다가 앤은 방금 마법을 사용하지 않았잖아?!\\n마리루가 평소에 어떤 훈련을 시켰길래……")
	await novel_interface.show_text_only("복도의 보안요원들을 다 해결한 앤이 가장 안쪽에 있는 스위트룸으로 간다.")
