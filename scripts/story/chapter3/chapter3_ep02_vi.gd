# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Hồ sơ SID cho thấy Trung tâm Akatraz thu thập Substance H lớp EX bị Quốc hội Hoa Kỳ cấm thử nghiệm và nghiên cứu.")
	await novel_interface.show_text_only("Dưới lòng đất của Trung tâm, nó được kết nối với lối vào một di tích cổ Chate Cave-house bị cấm vào và thậm chí không thể được xếp hạng.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Loại EX Substance H… Đây có phải là loại vật liệu cực kỳ nguy hiểm không?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Hầu hết chúng là những vật phẩm thiêng liêng có ý nghĩa tôn giáo. Vì chúng đặc biệt đối với những người theo tôn giáo nên chúng có thể được thu thập nhưng việc nghiên cứu bị cấm.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nghe như đang tự lừa dối mình.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Hah, tôi cũng cảm thấy như vậy. \\nTuy nhiên, theo một cách nào đó nó có ý nghĩa.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Một số hiện vật trong truyền thuyết tôn giáo được cho là có sức mạnh sát thần hoặc kích hoạt Sự phán xét cuối cùng,", "Mariru")
	await novel_interface.show_dialog("Một khi được kích hoạt, chúng có thể gây ra một thảm họa có quy mô tận thế.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Điều đó thật tệ.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Mặc dù một số vật phẩm được tôn kính trong các câu chuyện tôn giáo sau này hóa ra lại yếu kém—hoặc thậm chí không có tác dụng một cách đáng xấu hổ ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Điều gì đó ngớ ngẩn?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Đúng rồi, một ví dụ là đôi giày thần thánh này. Ai hôn mũi giày thì không thể cưỡng lại được vệt - thật là xấu hổ cho tôn giáo.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Điều đó thật kinh tởm. \\nVậy. cái còn thiếu này thuộc loại nào?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Đó là Destiny Spear—một lớp EX Substance H dưới sự giám hộ chung của tất cả các thành phố học viện.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ồ. \\nTôi hiểu rồi, nghe hay đấy.", "Lian")
	await novel_interface.show_dialog("Chính xác thì Destiny Spear là gì?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Bây giờ bạn trông giống như một thằng ngốc hoàn toàn.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Này, tôi thực sự không có ý kiến gì cả! \\nTôi chỉ là một học sinh trung học.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru nhìn tôi bất lực, như thể đang tự hỏi nên bắt đầu từ đâu.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Tóm lại, đây là loại Substance H đầu tiên, được cho là có sức mạnh hủy diệt.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Rất ít mô tả về Destiny Spear được tìm thấy trong các tài liệu phổ biến, ngoại trừ việc nó “không tan chảy ở nhiệt độ cao” và nó “tăng trọng lượng khi vung”.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Thế thôi à?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nếu tìm hiểu sâu hơn, bạn sẽ thấy một trong hai đặc điểm sẽ khiến nó trở thành lớp XK Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Có thể có một số đặc điểm nguy hiểm khác, chưa được biết đến. Đó là lý do tại sao họ không nên thu hút quá nhiều sự chú ý của giới truyền thông.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Điều này làm tôi nổi da gà. Ngay cả những đứa trẻ nhỏ cũng biết Substance H lớp XK là gì…")
	await novel_interface.show_text_only("Nó sẽ dẫn đến thảm họa ngày tận thế hoặc tạo ra một Substance H khác có sức mạnh tương tự. Hiện tại, chỉ có sáu vật phẩm thuộc loại này được biết đến trên toàn thế giới.")
	await novel_interface.show_text_only("Mỗi người trong số họ thuộc về một trong sáu Thành phố Học viện. Chính xác hơn, chỉ những người sở hữu Substance H như vậy mới được Quốc hội Hoa Kỳ công nhận.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Hả? \\nĐiều đó có nghĩa là ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bây giờ bạn đã biết “bạn” đã phạm tội gì nghiêm trọng chưa?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Tôi sốc đến mức mọi thứ đối với tôi dường như siêu thực.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Xin lỗi. \\nKhông! Tại sao tôi lại nói xin lỗi? Tôi không phải là tên trộm!", "Lian")
	await novel_interface.show_dialog("(Chết tiệt. Tên đó chắc chắn phải cực kỳ nguy hiểm!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Nhưng may mắn là tin đó đã được gỡ bỏ.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Họ làm vậy chỉ để tránh sự hoảng loạn của công chúng.\\nCuộc điều tra vẫn sẽ tiếp tục một cách bí mật.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Vì lý do bảo mật, lệnh truy nã sẽ không được gửi đến Bộ Quốc phòng. Nhưng tất cả các cơ quan tình báo, bao gồm SID, chắc hẳn đã được thông báo rồi.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Vậy nên vẫn còn sớm để cảm thấy nhẹ nhõm, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Đúng rồi… tôi cũ vẫn đang gặp nguy hiểm phải không?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("Điều gì sẽ xảy ra nếu… ý tôi là nếu… \\n…ai đó theo dõi tôi…", "Lian")
	await novel_interface.show_dialog("Kể cả bây giờ tôi có là con gái thì chắc chắn tôi cũng có thể bị nhốt phải không?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cuối cùng bạn đã hiểu được nó.", "Mariru")
	await novel_interface.show_dialog("Cơ quan tình báo đã kiểm tra tất cả các đoạn phim CCTV có sẵn và phát hiện ra anh chàng này xuất hiện ở một số Khu vực Flux khác, vẫn với khuôn mặt cũ của bạn.", "Mariru")
	await novel_interface.show_dialog("Vì chúng tôi có thể truy xuất dữ liệu từ nguồn của bên thứ ba nên các dịch vụ tình báo khác cũng có thể có thông tin này.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Tái phạm rồi à? \\nTương lai của tôi có vẻ ảm đạm ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Tôi hình dung mình bị tra tấn trong vô số cuộc thẩm vấn…")
	await novel_interface.show_text_only("Tôi có cảm giác như mình sẽ bị bắt bất cứ lúc nào và bị coi là tội phạm chống lại loài người.")
	await novel_interface.show_text_only("Bị nhốt trong nhà tù tàn bạo nhất, bị kết án hơn 200 năm tù.")
	await novel_interface.show_text_only("Tôi có thể có một người bạn tù cực kỳ nguy hiểm, và anh ta…")
	await novel_interface.show_text_only("Waah, dừng lại đi! \\nKhông cần suy nghĩ nữa!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hahaha. Bạn đang rất sợ hãi và trông rất xanh xao.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Bình tĩnh nào Ren. Tôi có thể đảm bảo với bạn mức độ an toàn 98% miễn là bạn ở trong New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Vậy là tôi vẫn có 2% khả năng bị bắt?", "Lian")
	await novel_interface.show_dialog("(Hai giây không chắc chắn trong mỗi trăm giây!) \\n(Điều đó không an toàn chút nào!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Rằng những con chó già ở Quốc hội Thống nhất đã đạt được sự đồng thuận trong một thông báo ngắn như vậy… Có điều gì đó không ổn.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Và đây chính là yếu tố chưa biết 2% mà tôi đang nói đến.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Tôi không thể tưởng tượng được nó đã gây ra sự chấn động như thế nào đối với những vụ nổ lớn đó…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vì vậy, các cơ quan tình báo của các Thành phố Học viện khác hẳn đã sử dụng rất nhiều nguồn lực để truy lùng tên trộm.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tôi… tôi nên làm gì đây?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Kẻ thù hữu hình luôn dễ dàng đối phó. Hãy để nó cho SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
