# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Grâce à Skurd, il semble que Fabella décide de me laisser partir.")
	await novel_interface.show_text_only("Au moment où Skurd se détourne, plusieurs invités bien habillés s'approchent et lui parlent.")
	await novel_interface.show_text_only("La fille a à peu près le même âge que Elluka, mais elle brille dans une occasion sociale aussi chic…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Est-elle issue d'une famille noble ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que Fabella tourne son attention vers son maître, je me faufile de l'autre côté de la salle de banquet.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ça me fait flipper… \\nLe petit maître et sa servante, n'est-ce pas ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("On dirait que la servante ne va pas me coincer. \\nVoulait-elle seulement me tromper ?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, tu es là !", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Je suis peut-être tombé sur un indice majeur !", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tout à l'heure, j'ai suivi secrètement la délégation jusqu'à l'étage exécutif, et là j'ai vu l'entourage de Raphael portant une valise spéciale.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Une valise… Qu’est-ce qu’il y a dedans ?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je ne sais pas. Mais je me souviens que la formation SID mentionnait le matériel utilisé dans la valise !", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("C'est un métal vert grisâtre avec un éclat bleu clair particulier—", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Un éclat bleu clair… \\nQuoi ! N'est-ce pas…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Je me souviens d'un alliage qui réduit ou élimine les effets des psychoactifs et des mèmes Substance H…")
	await novel_interface.show_text_only("Les conteneurs Substance H fabriqués à partir de cet alliage peuvent échapper à la plupart des numérisations de teintes.")
	await novel_interface.show_text_only("L'alliage lui-même est un Substance H : 98 % sont des métaux connus et les 2 % restants sont des substances inconnues.")
	await novel_interface.show_text_only("En raison de sa rareté, son prix sur le marché noir a grimpé en flèche.")
	await novel_interface.show_text_only("Je suis presque sûr que tout ce qui se trouve dans cette valise a quelque chose à voir avec Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Putain de merde ! \\nAvez-vous signalé cela à Mariru ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La délégation Salmonton n'a pas signalé au Sénat qu'elle apporterait du Substance H avec elle.")
	await novel_interface.show_text_only("Tout Substance H destructeur introduit clandestinement dans le champ de force de protection peut provoquer une catastrophe sur New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Je lui ai dit immédiatement. Elle doit demander un mandat de perquisition au Sénat en ce moment même.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais je l'ai juste vu d'un coup d'œil et je n'ai pris aucune photo. \\nJe ne pense pas qu’ils puissent entrer par effraction dans la pièce sans autre preuve…", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("C'est pourquoi Mariru vient de mettre à jour notre mission pour « Sécuriser et télécharger les preuves dès que possible ».", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Si c’est le cas, la seule chance est de se faufiler dans leurs chambres…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ouais… la chambre des filles. Ce n’est pas une tâche facile.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm… Il va falloir le jouer à l'oreille maintenant.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("L'étage exécutif est réservé à la délégation. Nous y arrivons par l'ascenseur de service.")
	await novel_interface.show_text_only("Je pousse le chariot de service « emprunté » vers le couloir fortement gardé. Annie se cache dessous…")
	await novel_interface.show_dialog("Hé! N'es-tu pas censé être au banquet en bas ? \\nVous n'êtes pas autorisé ici. Partez maintenant.", "Sécurité")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Tant d’agents de sécurité, bien sûr…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hein ? Mais un invité de la Suite Royale vient de commander en room service du foie gras accompagné de whisky flamboyant !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le leader n’a pas du tout l’air impressionné.")
	await novel_interface.show_text_only("De toute évidence, je l’ai sous-estimé. Je dois trouver un autre moyen…")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Euh… Peut-être que le service de chambre a fait une erreur. Mes excuses, monsieur…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai à peine fini de parler que Annie se précipite dehors et lui frappe le cou avec la batte de baseball.")
	await novel_interface.show_text_only("Puis elle se retourne et lance une balle de baseball directement au visage d'un autre garde à 10 mètres.")
	await novel_interface.show_text_only("Le garde restant est abasourdi par l’attaque. Avant qu'il ne puisse atteindre son émetteur-récepteur, Annie lui donne un coup de pied en plein menton.")
	await novel_interface.show_text_only("Trois hommes s’effondrent presque d’un seul coup. La chauve-souris rebondit sur le sol et revient dans la main de Annie.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Clairement !", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Quoi… Qu'as-tu fait ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Rien. Laissez-les simplement se reposer un moment.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, c'est tellement Annie… \\n(Dieu merci, je suis avec elle…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Et elle n'a même pas utilisé de magie ! \\nQuel genre de formation elle reçoit…")
	await novel_interface.show_text_only("Après avoir écarté les gardes, Annie m'emmène dans la suite à double porte au bout du couloir.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ici.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nous échangeons un regard. \\nAu moment où nous sommes sur le point de coller nos oreilles contre la porte…")
	await novel_interface.show_text_only("Il s'ouvre brusquement de l'intérieur. Nous sommes pris au dépourvu et tombons au sol à l’intérieur de la pièce.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Owwww…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En levant les yeux, je vois un visage familier et arrogant.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael est entourée de plusieurs gardes du corps et de son entourage, affichant un air de mépris sur le visage.")
	await novel_interface.show_text_only("Wow, tant de femmes matures et jolies !")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hein ? N'es-tu pas ce monstre du travestissement qui vient de ce dépotoir d'école ? Que faites-vous ici?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("En tenue de servante française ! Vous ne vous sentez pas assez pervers ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("W… quelle coïncidence ! \\nJe travaille juste à temps partiel ici avec mon camarade de classe…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, et… la salle de banquet en bas, n'est-ce pas ? \\nNous sommes peut-être tombés au mauvais endroit.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Désolé, Annie, je suis nul de mentir !")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("C'est bizarre. Les agents de sécurité ne vous ont-ils pas arrêté ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Confus, Raphael regarde dans le couloir.")
	await novel_interface.show_text_only("Raphael est consternée lorsqu'elle trouve les gardes de sécurité, tous assommés par terre.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("— Attrapez-les !", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
