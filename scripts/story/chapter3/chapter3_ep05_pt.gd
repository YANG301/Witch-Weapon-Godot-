# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru envia Annie e Elluka embora assim que retornamos à Sede.")
	await novel_interface.show_text_only("Agora estou chateado. Não sei se seria interrogado com perguntas estranhas novamente…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("O que aconteceu?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("E se nada acontecer? Você vai continuar sorrindo para Elluka como um pervertido?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você… Você deve estar me observando pela câmera de vigilância!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Hehe, isso é tudo que você consegue pensar?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O que mais poderia ser…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Por exemplo—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru me olha maldosamente da cabeça aos pés.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("O Departamento de Pesquisa desenvolveu um wafer que pode até decidir quando você vai ao banheiro!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("O que... banheiro? \\nUgh, parece nojento!", "Lian")
	await novel_interface.show_dialog("Deve ser inventado por Aya! \\nEspere, não me diga que você o implantou secretamente em meu corpo!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eu só estava brincando.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A maneira como você diz isso não parece uma piada!")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ou… Há algo estranho que passa pela sua cabeça?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Ugh, droga…", "Lian")
	await novel_interface.show_dialog("(A última vez que corri durante a assembleia da escola…) \\n(Isso significa…?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hahahaha! Não leve isso a sério!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ri alto, esfregando minha cabeça com força.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya só fez um protótipo antes de eu cancelar o projeto. \\nPor que usaríamos isso em alguém como você!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Ah, devo dizer obrigado?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha, você tem sujeira em sua mente, certo?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh… Graças a Deus não existe máquina de ler mentes! Pense em como seria vergonhoso!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Ei, não engula isso. É muito divertido ver você revidando.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Desculpe por decepcionar você.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm… Eu me pergunto como um simplório como você poderia extrair informações de alvos importantes.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru enxuga as lágrimas de tanto rir e faz sua cara arrogante de sempre.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Alvos principais… Parece mais significativo do que atender você… Mas por que o Sr. Big falaria com um garoto do ensino médio!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Desta vez você abordará seu alvo como estudante. O alvo…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, neta do prefeito de Salmonton. Ela virá com a Delegação Salmonton.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ela é uma garota muito bem nascida. Excitado?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Por que eu deveria estar animado?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut-tut, você só gosta de garotinhas, hein?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Ei, pare de me descrever como um criminoso!", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Ahem. \\nDe qualquer forma, o que você quer que eu ganhe dessa garota bem-nascida?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh, você não é muito falador... \\nEspero que consiga sobreviver pelo menos um dia.", "Mariru")
	await novel_interface.show_dialog("Ok, sério, o que você sabe sobre Salmonton?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Hum… acho que é o maior exportador de alimentos?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Falando em Salmonton… o que me vem à mente são as dezenas de arranha-céus ao longo do Reno.")
	await novel_interface.show_text_only("Os jardins verdejantes atrás das estufas… \\nSempre fazem papéis de parede perfeitos.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("E há muitas igrejas. Todos os cidadãos têm uma crença religiosa. Eles até formaram uma Aliança Sagrada…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Isso é tudo que consigo lembrar. Não sou bom em geografia. Muita memorização de fatos aleatórios.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("O poder económico e político de Salmonton depende em grande parte do seu controlo sobre os genes das culturas.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Mas os incidentes após o desaparecimento do Cálice de Ross representaram graves ameaças para eles.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por ameaças, você quer dizer… o Fluxo do Espaço-Tempo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Isso mesmo. Segundo minhas informações, sofreu múltiplos fluxos. Mas os danos ainda são desconhecidos.", "Mariru")
	await novel_interface.show_dialog("A julgar pela recente volatilidade no preço dos futuros dos cereais, o impacto parece bastante grande… Talvez ocorram fomes esporádicas.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso é grave!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Não sei nada sobre o mercado futuro. Achei que o impacto estava confinado a uma pequena área.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sim… O fracasso na colheita não causará danos imediatos. De qualquer forma, os países têm reservas de risco.", "Mariru")
	await novel_interface.show_dialog("Parece que Salmonton é a primeira a entrar em colapso, entre todas as Cidades Acadêmicas.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Despachou uma delegação para New Opulentia, que já está a caminho.", "Mariru")
	await novel_interface.show_dialog("Como principal importador de alimentos, não podemos dizer não.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eles vão… suspeitar de Annie e de mim?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Isso é o que você vai fazer.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O quê?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Embora esteja sob a bandeira de um programa de “intercâmbio cultural”, a delegação tem estado sob forte proteção do Serviço Real de Segurança.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("O Royal Security Service… A agência de inteligência de Salmonton, também conhecida como Rosenkreutz.")
	await novel_interface.show_text_only("Para um serviço de inteligência, é famoso demais graças aos filmes do Agente nº 7.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso causará alguns problemas?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Claro. SID ainda tem dificuldade em coletar informações básicas.", "Mariru")
	await novel_interface.show_dialog("Até agora, o que é relevante para você é que a garota irá visitar a Escola Secundária Feminina Gosakuragawa.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Minha escola?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Isso era de se esperar. Ela tem mais ou menos a idade de uma estudante do ensino médio.", "Mariru")
	await novel_interface.show_dialog("Então o que você precisa fazer é descobrir o real propósito da visita deles.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Os serviços de inteligência fizeram um livreto sobre Salmonton e a família Dekkers. Agora vá e leia.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ops, tarefa de memorização de novo… \\nEu cuido disso!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("A propósito, cuidado com o pervertido no caminho para casa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("O-O que!?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
