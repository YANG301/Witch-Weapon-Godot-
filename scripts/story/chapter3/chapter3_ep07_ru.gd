# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Прошло два дня с тех пор, как Mariru поручил мне это задание.")
	await novel_interface.show_text_only("Вчера вечером делегация «Культурного обмена» наконец прибыла в международный Aiпорт New Opulentia.")
	await novel_interface.show_text_only("Итак... Моя миссия вот-вот начнется.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Но пытаюсь вытянуть информацию из этой девушки ..., я не знаю.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("В любом случае, она не обычная девушка. Что, если она откажется со мной разговаривать?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Посмотрите на девушку там! Она не носит нашу школьную форму.", "Студент 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("А та, что рядом с ней, похожа на служанку __ЭЛЛИПСИС__ Она что, принцесса какая-то?", "Студент 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я оглядываюсь и вижу стройную девушку в зеленом пальто. \\nОна стоит перед лужайкой.")
	await novel_interface.show_text_only("Цель моей миссии — Raphael Dekkers.")
	await novel_interface.show_text_only("Я только что видел заместителя директора и почетный оркестр, ожидающих у ворот школы. Она пробралась в кампус?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Мисс, сюда, пожалуйста.", "Свита")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Это школьное здание спроектировано в стиле Тюдоров золотого века.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Но атриум слишком тесен, чтобы передать ощущение величия.", "Raphael")
	await novel_interface.show_dialog("А резьба на плинтусе слишком неуклюжа, чтобы поддерживать структуру и дизайн.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Мисс, какой у вас необыкновенный вкус к искусству!", "Свита")
	await novel_interface.show_dialog("Подобная архитектура эпохи Тюдоров должна иметь более высокий атриум.", "Свита")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, ты не понимаешь. \\nПросто увеличить высоту не получится.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Вы совершенно правы, мисс. Газон тоже надо расширить.", "Свита")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А? Это выглядело бы просто нескоординировано. \\nВедь весь двор уже забит…", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Конечно. Мисс Raphael даже не назвала бы этот неорганизованный участок земли двором перед домом, не так ли?", "Свита")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael, кажется, несколько недоволен этими словами.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… Нет, я не об этом думаю.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("О! \\nКак мило с вашей стороны, мисс Raphael!", "Свита")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Почему ее сопровождающий не видит, что ее улыбка уже натянута?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Эй, ты, переодевающийся урод.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Что?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Уродец-переодевалка ... Она говорит обо мне?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("При ее словах все оборачиваются и смотрят на меня.")
	await novel_interface.show_text_only("Не привыкший к тому, чтобы на меня смотрели так много глаз, я чувствую, что краснею.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Нет, я... я не...! \\n(Mariru заставил меня носить форму!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Будь мужчиной и признай это, ладно?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Я не знал, что New Opulentia настолько либерален, что такого извращенца, как ты, можно принять в школу для девочек.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, я передумал! Я не хочу этого делать!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Хм… Рен — наш одноклассник. Она девочка!", "Студент 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Что? \\nХватит шутить.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael выглядит так, будто она обиделась.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Она не шутит! Мы все можем вас заверить. \\nРен настоящая девушка.", "Студент 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Спасибо, что высказались за меня. Но я точно не девочка.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("…Тьфу-тьфу, я думал, ты мальчик.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Почему! Я совсем не похож на мальчика! \\n(О, нет...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ух... Хреново предать прежнего себя...")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Хорошо. Забудь это.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Что вы думаете об архитектуре в вашей школе?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я понятия не имею об архитектуре. Если вы настаиваете…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Просто говорите все, что приходит вам на ум.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм ..., как школьное здание, атриум не слишком низкий.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Здание не радует глаз... может быть, потому, что оно... недостаточно симпатичное?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Стыдясь своего скудного словарного запаса, я пытаюсь уловить выражение лица Raphael.")
	await novel_interface.show_text_only("Как и ожидалось, она презрительно улыбается.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Мило? Я не могу поверить своим ушам. Это все, что вы можете найти для описания архитектуры?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ну, это только то, что я чувствую по этому поводу!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Я имею в виду, может быть, было бы лучше... Если деревья не будут идеально выровнены...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Хм... \\nТипа, эээ...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Эх… почему я должен отвечать на этот вопрос?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Вы хотите сказать, что деревья следует располагать поочередно, чтобы придать дизайну больше глубины?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Точно. \\n(Что она только что сказала?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael наконец слабо улыбнулся мне.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ох, извращенец намного лучше, чем подхалим!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Нет, я не…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Мисс…", "Свита")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Оставьте нас. Подожди меня возле школы.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Ты Рен, да? Пойдем. Покажи мне свою замечательную школу, ладно?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Э…? \\nО... Хорошо!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
