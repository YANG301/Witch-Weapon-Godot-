# chapter3_ep13.gd - 第3章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep13_script()

func play_script():
	pass

func chapter3_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Beatrice blinks her eyes and licks her lips unconsciously.")
	await novel_interface.show_text_only("I feel a surging heat quickly spreads to every part of my body.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, Ren?!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Mwahaha…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Hey!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stare blankly for a moment before coming back to my senses. \\nBut I can't help looking at Beatrice again.")
	novel_interface.show_character("beatrice_battle","smile3")
	await novel_interface.show_dialog("Excuse my thirst for a drink… \\nBut may I have a glass of wine?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Is she… talking to me? \\nPulse racing, I can almost hear my heart thumping loudly.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Does that mean she wanna drink wine?", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("I'll get you some right away!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Ah— for goodness’ sake! \\nRen is acting like an idiot!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael stares hard at the unexpected guest as if trying to relate her to the golden butterfly.")
	await novel_interface.show_text_only("Picky as Raphael is, there’s no room for her to fuss about Beatrice's beauty.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Miss, shouldn't you explain to us why you're suddenly here?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("You're dressed as a medieval European nobility… \\nAnd you asked for wine when thirsty…", "Raphael")
	await novel_interface.show_dialog("Are you from a costume party? Or did you teleport yourself here?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("If the golden butterfly is a Witch's Shard…", "Annie")
	await novel_interface.show_dialog("And since Ren's here… Maybe she is…", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("—A witch?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As I pass over the wine, the word \"witch\" grabs my attention.")
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("Witch…", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("The priests at the Courthouse used to call me that. \\nA name acquainted yet unfamiliar to me…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice seems to be thinking hard about something.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Courthouse? \\nUsed to?", "Annie")
	novel_interface.change_expression("unhappy")
	await novel_interface.show_dialog("(Oh no, come on…)", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("They forced me to drink a glass of wine at the court…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice returns from her memory and takes up the glass with a smile.")
	novel_interface.show_character("ren_maid","heart")
	await novel_interface.show_dialog("(Wow… She looks amazing, definitely…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("To walk in newness of life, thou must forget and forgive.", "Beatrice")
	await novel_interface.show_dialog("This verse was written by one of my admirers…", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Are you the one who gives me this newness of life?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Me? \\nWhat, umm…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Is this some kind of joke?", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Did you say that the poem was written for you? Hah, don't tell me you've met him at the gate of the heavenly kingdom!", "Raphael") 
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Witches… \\nThey only exist in made-up legends. There's no such thing as witches.", "Raphael") 
	await novel_interface.show_dialog("Are your brains broken? \\nEven Substance H can't do that.", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Because… \\nBecause…!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Because Substance H has one basic attribute: it can't reverse time.", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mariru?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No wonder you're the favorite grandchild of Dr. Dekkers! That's only taught in postgraduate courses!", "Mariru")
	novel_interface.show_character("ren_maid","sprite")
	await novel_interface.show_dialog("Hey, my boobs vibrate as you talk!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("And… it tickles!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Is someone speaking inside your clothes?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ugh, it's in my body. \\nBut I don’t wanna talk about this now…")
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Miss Raphael Dekkers, this is Mariru Von Braun, head of SID of New Opulentia.", "Mariru")
	await novel_interface.show_dialog("We've detected intermittent spacetime fluxes around the Sky Hotel since last night.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Please cooperate with our two agents from now on. Otherwise, I cannot ensure your safety.", "Mariru")
	await novel_interface.show_dialog("Just now, Dr. Dekkers has sent me the security key— \\nNoblesse Oblige.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Grandpa…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("I'm not a kid!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("With great power comes great responsibility. \\nYour grandfather seems to be a great man.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hmm, I just hope you're trustworthy.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Then, can you tell me something about your suitcase?", "Mariru")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ask your own men! I mean the cross-dressing freak and that little girl.", "Raphael")
	await novel_interface.show_dialog("If they hadn’t broken into my room, I wouldn't have noticed the suitcase at all.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","speechless")
	await novel_interface.show_dialog("Cross-dressing freak?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Without realizing it, I pluck at my French maid outfits. \\nWhat a shame!")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Well, now that I think back… Only one thing was strange.", "Raphael")
	await novel_interface.show_dialog("This afternoon, my bodyguards were somehow absent-minded and upset.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("I guess… I know the reason.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oh, do you?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("The pendant on your necklace—it is an emerald, I suppose?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice points to Raphael's chest.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("How do you know? \\nIt's under my clothes…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael pulls up the necklace in surprise. There is an emerald indeed.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("If I remember correctly, that's the jewel on the saber my father entrusted to me.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("What?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Just now, it resonated violently with me in the darkness…", "Beatrice")
	await novel_interface.show_dialog("Even though there was a barrier in between, I was sure because I never mistake things that belong to me.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Nonsense! This necklace belongs to the Dekkers family… It’s been with us for hundreds of years!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Is it the resonance between a witch's belongings and Witch's Shard?", "Annie")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Wait, then the first one affected should be…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Leave this aside, okay? The guys outside are breaking in.", "Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Oh, almost forget about these useless idiots!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Phew, I can finally get rid of this outfit!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Just as I start to feel some relief, a chill sweeps over me.")
	await novel_interface.show_text_only("A white spot appears on the aerogel crust. It gradually expands, making a crackling sound.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Are security soldiers… usually armed with liquid nitrogen injectors?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With a loud crack, the aerogel crust falls into pieces like broken glass.")
	await novel_interface.show_text_only("A group of armed men rush in and surround us.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("What do you want?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I don't know who they are, but from their strange dark blue masks, I can tell they are not security soldiers.")
	await novel_interface.show_dialog("Didn't expect this day so soon…", "Male Voice")
	await novel_interface.show_text_only("A familiar male voice comes from behind the door.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("You are—?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Nice to meet you… again.", "Jacob")

	print("=== 第3章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
