# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("We rush all the way down to the underground parking lot as directed by Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru told me that the Administrator's men has pulled out from another exit instead of running after us.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Let me check her wound… I've learned first aid before.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael signals me to lay Annie flat on a flat surface. Then she checks Annie's pulse and breathing.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Luckily, there is no v-fib, although her breath is quite shallow and the burns are severe. No idea if the’s any internal injury …", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("That's brutal! Treating a girl like this!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Hmm… Miss?", "Beatrice")
	await novel_interface.show_dialog("Do you often attract small animals? \\nFor example—", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We turn and look over. There are two pigeons near us.")
	await novel_interface.show_dialog("Coo— Coo—", "Pigeon")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("What's strange about this? Pigeons are found everywhere.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Nope, it's Basement Three in here!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("So what? \\nThey're not endangered animals.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Coo— Coo— Coo—", "Pigeon")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(… Nobility, hah. No common sense at all.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Healing magic does attract small animals. But if she's not aware of that…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice pulls me nearer to Raphael, taking her hands and mine.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Come, try this—", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Hmm?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice puts my hand on Raphael's, and presses our hands hard with her palm.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("What are you doing—?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I didn't expect... \\nRaphael's hand to be this soft and warm...")
	await novel_interface.show_text_only("No, wait! \\nAm I—")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Holding her hands…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I see surprise and anger in Raphael's face. She is glaring at me, almost breathing fire.")
	await novel_interface.show_text_only("I shudder at the thought of being called a pervert and beaten up black and blue.")
	await novel_interface.show_text_only("Suddenly, Raphael turns to look at Beatrice, as if coming to realize something. Beatrice nods slightly.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael closes her eyes, with an intense look on her face. And Beatrice slowly moves her palm away.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(What? Does she enjoy holding my hand?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All of a sudden, a pleasant warmth flows through my body, and I feel more relaxed than ever.")
	await novel_interface.show_text_only("Phew— It suddenly dawns on me that the air is so fresh, even in his underground parking lot.")
	await novel_interface.show_text_only("And somehow the horrible scene stops haunting me.")
	await novel_interface.show_dialog("Ah-em…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I see the burn scars on Annie's body fading away at an incredible speed.")
	await novel_interface.show_text_only("The warmth gradually subsides. Raphael heaves a sigh of relief and opens her eyes.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, where are we…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie looks at me sleepily, as if just waking up.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("We're safe now. Just waiting for Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Why…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Haven't you… noticed this before?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("A witch with such a wonderful healing magic… \\nYou're amazing!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Yeah, really! I've also felt the magic!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Witch? Magic? What nonsense!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael frowns sternly.")
	novel_interface.character_light()
	await novel_interface.show_dialog("What have you done to me? \\nWhy do her wounds heal so quickly?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I know it's hard to assimilate so much information all at once. So I remain silent.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Who are those attacking our security soldiers? \\nHow dare they use Substance H weapon here…", "Raphael")
	await novel_interface.show_dialog("Why did a person dead for hundreds of years suddenly come to life? And I'm wearing her necklace!", "Raphael")
	await novel_interface.show_dialog("And I've seen… \\nThe nightmare…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael's voice trembles as she thinks of the horrible scene.")
	await novel_interface.show_text_only("I turn to Beatrice. A calm smile appears on her beautiful face.")
	await novel_interface.show_text_only("The emerald returned to its original state, and Beatrice handed it back to Raphael.")
	await novel_interface.show_text_only("It seemed as if that terrifying scene a moment ago had nothing to do with her.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("The magic on the Book of Seven Philosophers does disturb the mind… \\nIt's perfectly normal to feel fear at your first encounter.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("But fear is an important emotion. Knowing your weakness helps you survive crises.", "Beatrice")
	await novel_interface.show_dialog("What's really horrible is those dominated by fear…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice seems to be drawn into memories, with a sad look in her eyes.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Be that as it may, I'd rather never have opened that book, and never have made that wish…", "Beatrice")
	await novel_interface.show_dialog("And never… have gained the cursed power…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Cursed?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("The Grimoire has endowed me with a magic… \\nI can't control myself from exuding a charm that draws men.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(That's why…!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice turns to me and taps my throat with the tip of her finger.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("May I ask a question?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Yes… Please!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Your name is Ren, right? \\nYou're special…", "Beatrice")
	await novel_interface.show_dialog("As a girl, you should be immune to my charm. So why were you... sneaking glances at me?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("She's noticed! \\nSoooooo ashamed!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("But… unlike men, you don't completely lose control… or behave like mad.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Is it because of my magic?…) \\n(No no no, I did lose control completely!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice slowly lifts my jaw with one finger, and then gently touches my nose.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I don't mind... Honestly, I have to admit... you're cute.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("I gulp unconsciously.")
	await novel_interface.show_text_only("Is that... just the effect of magic?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A short while later, a black SUV limo whizzed to a stop in front of us.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, get in!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, right? I hope you'll go with us.", "Mariru")
	await novel_interface.show_dialog("I've found all the documents available… In case you're interested in the life of those you know.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Your secret admirer, the poet, has written verses that have been passed down through centuries.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Fine. I'm also interested in this cutie here.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Meeting Beatrice's eyes, I blush again…")
	await novel_interface.show_text_only("Is… Is that really just the effect of her magic?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("And Raphael, you just go back to your room. The gang has already left. It's safe now.", "Mariru")
	await novel_interface.show_dialog("If the delegation finds you missing… You don't want to scare them, you know.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("We've carried contraband… and caused such turmoil…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael looks at Beatrice. \\nWell, the contraband has turned into a beautiful lady. How sweet!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("And you're letting me go just like this?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("In exchange, Dr. Dekkers has agreed that my designated traders will be first in line for Salmonton's produce in the coming year.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("And he has also promised to turn a blind eye to my trading activities in Newmoridas Futures Exchange.", "Mariru")
	await novel_interface.show_dialog("The agreement is already sitting on my office desk. So, rest assured. SID is not a charity group.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Wait! We've risked our lives only for you to make money!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Fine. I promise I won't tell anyone about this incident before sorting it all out.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("It's such a pleasure working with the Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, I'll definitely figure this magic thing out after I'm back to Salmonton!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Please do! I think you really have wonderful magic power.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael turns away but stops abruptly. \\nShe takes off her necklace, and throws it to me.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("This is from your family collection, isn't it? How can you…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("It's yours now.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("A gallant girl! You'll become an outstanding lady when you grow up.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, I won't forget to do a background check on you.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Take care, everyone. We will meet again.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
