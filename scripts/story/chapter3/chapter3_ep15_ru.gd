# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Мы несемся вниз к подземной парковке по указанию Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru сообщил мне, что люди Администратора выдвинулись из другого выхода вместо того, чтобы побежать за нами.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Позвольте мне осмотреть ее рану… Я уже научился оказывать первую помощь.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael сигнализирует мне положить Annie на плоскую поверхность. Затем она проверяет пульс и дыхание Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("К счастью, фибрилляции у нее нет, хотя дыхание у нее поверхностное, а ожоги серьезные. Понятия не имею, есть ли какие-либо внутренние повреждения…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Это жестоко! Такое обращение с девушкой!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Хм… Мисс?", "Beatrice")
	await novel_interface.show_dialog("Вы часто привлекаете мелких животных? \\nНапример—", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мы поворачиваемся и осматриваемся. Рядом с нами два голубя.")
	await novel_interface.show_dialog("ку- ку-", "Голубь")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Что в этом странного? Голуби встречаются повсюду.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Нет, здесь третий подвал!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("И что? \\nОни не находятся под угрозой исчезновения.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ку- ку- ку-", "Голубь")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(…Благородство, ха. Никакого здравого смысла.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Исцеляющая магия привлекает мелких животных. Но если она об этом не знает…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice притягивает меня ближе к Raphael, беря ее и мои руки.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Давай, попробуй это —", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Хм?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice кладет мою руку на Raphael и крепко сжимает наши руки своей ладонью.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("Что ты делаешь?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я не ожидал, что рука ... \\nRaphael будет такой мягкой и теплой ...")
	await novel_interface.show_text_only("Нет, подожди! \\nЯ—")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Держа ее за руки…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я вижу удивление и гнев на лице Raphael. Она смотрит на меня, почти выдыхая огонь.")
	await novel_interface.show_text_only("Я содрогаюсь при мысли, что меня назовут извращенцем и избьют до синяков.")
	await novel_interface.show_text_only("Внезапно Raphael поворачивается и смотрит на Beatrice, как будто что-то осознавая. Beatrice слегка кивает.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael закрывает глаза с напряженным выражением лица. И Beatrice медленно убирает ладонь.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(Что? Ей нравится держать меня за руку?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно по моему телу разливается приятное тепло, и я чувствую себя более расслабленным, чем когда-либо.")
	await novel_interface.show_text_only("Уф, до меня вдруг дошло, что воздух такой свежий, даже на его подземной парковке.")
	await novel_interface.show_text_only("И каким-то образом эта ужасная сцена перестала меня преследовать.")
	await novel_interface.show_dialog("Э-эм…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вижу, как шрамы от ожогов на теле Annie исчезают с невероятной скоростью.")
	await novel_interface.show_text_only("Тепло постепенно спадает. Raphael вздыхает с облегчением и открывает глаза.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Рен, где мы...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie сонно смотрит на меня, словно только что проснулся.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Теперь мы в безопасности. Просто жду Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Почему…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Разве ты… не замечал этого раньше?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Ведьма с такой чудесной исцеляющей магией… \\nТы потрясающая!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Да, правда! Я тоже почувствовала волшебство!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Ведьма? Магия? Какая ерунда!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael строго хмурится.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Что ты со мной сделал? \\nПочему ее раны так быстро заживают?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я знаю, что трудно усвоить столько информации одновременно. Поэтому я молчу.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Кто те, кто нападает на наших силовиков? \\nКак они смеют использовать здесь оружие Substance H…", "Raphael")
	await novel_interface.show_dialog("Почему человек, умерший сотни лет назад, вдруг ожил? И я ношу ее ожерелье!", "Raphael")
	await novel_interface.show_dialog("И я видел... \\nКошмар...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Голос Raphael дрожит, когда она думает об этой ужасной сцене.")
	await novel_interface.show_text_only("Я перехожу к Beatrice. На ее прекрасном лице появляется спокойная улыбка.")
	await novel_interface.show_text_only("Изумруд вернулся в исходное состояние, и Beatrice передал его Raphael.")
	await novel_interface.show_text_only("Казалось, что та ужасающая сцена, произошедшая минуту назад, не имела к ней никакого отношения.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Магия «Книги семи философов» действительно тревожит разум… \\nСовершенно нормально чувствовать страх при первой встрече.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Но страх – важная эмоция. Знание своей слабости помогает пережить кризисы.", "Beatrice")
	await novel_interface.show_dialog("Что действительно ужасно, так это те, кто находится во власти страха…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice, кажется, погрузилась в воспоминания, с грустным взглядом.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Как бы то ни было, лучше бы я никогда не открывал эту книгу и никогда не загадывал такого желания…", "Beatrice")
	await novel_interface.show_dialog("И никогда… не обретал проклятую силу…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Проклятый?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Гримуар наделил меня магией… \\nЯ не могу сдержаться и не излучаю очарование, привлекающее мужчин.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(Вот почему...!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice поворачивается ко мне и касается моего горла кончиком пальца.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Могу я задать вопрос?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Да… Пожалуйста!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Тебя зовут Рен, да? \\nТы особенный…", "Beatrice")
	await novel_interface.show_dialog("Будучи девушкой, ты должна быть невосприимчива к моему обаянию. Так почему ты ... украдкой поглядывал на меня?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Ее заметили! \\nОоооочень стыдно!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Но… в отличие от мужчин, ты не теряешь контроль полностью… и не ведешь себя как сумасшедший.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Это из-за моей магии?…) \\n(Нет-нет-нет, я полностью потерял контроль!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice медленно поднимает мою челюсть одним пальцем, а затем осторожно касается моего носа.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Я не против ... Честно говоря, я должен признать, ..., ты милый.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Я бессознательно сглатываю.")
	await novel_interface.show_text_only("Это __ЭЛЛИПСИС__ просто эффект магии?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вскоре перед нами остановился черный лимузин-внедорожник.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Рен, Annie, садись!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, верно? Надеюсь, ты пойдешь с нами.", "Mariru")
	await novel_interface.show_dialog("Я нашел все имеющиеся документы... Если вас интересует жизнь тех, кого вы знаете.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ваш тайный поклонник, поэт, написал стихи, которые прошли сквозь века.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Хорошо. Меня тоже интересует вот эта милашка.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Встретив взгляд Beatrice, я снова краснею…")
	await novel_interface.show_text_only("Неужели… Неужели это просто эффект ее магии?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("И Raphael, ты просто вернешься в свою комнату. Банда уже ушла. Теперь это безопасно.", "Mariru")
	await novel_interface.show_dialog("Если делегация обнаружит, что вы пропали без вести… Знаете, вы не хотите их пугать.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Мы провезли контрабанду... и устроили такой беспорядок...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael смотрит на Beatrice. \\nНу, контрабанда превратилась в прекрасную даму. Как мило!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("И ты отпускаешь меня просто так?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Взамен д-р Dekkers согласился, что мои назначенные трейдеры будут первыми в очереди за продукцией Salmonton в наступающем году.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("А еще он пообещал закрыть глаза на мою торговую деятельность на фьючерсной бирже Ньюморидас.", "Mariru")
	await novel_interface.show_dialog("Соглашение уже лежит у меня на столе. Так что будьте уверены. SID не является благотворительной группой.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Подожди! Мы рисковали своей жизнью только ради того, чтобы ты заработал деньги!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Хм…", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Хорошо. Обещаю, что никому не расскажу об этом инциденте, пока во всем не разберусь.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Очень приятно работать с Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Рен, я обязательно разберусь с этой волшебной штукой, когда вернусь в Salmonton!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Пожалуйста, сделайте! Я думаю, ты действительно обладаешь чудесной магической силой.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael отворачивается, но резко останавливается. \\nОна снимает ожерелье и бросает его мне.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Это из вашей семейной коллекции, не так ли? Как ты можешь…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Теперь оно твое.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Галантная девушка! Когда вырастешь, ты станешь выдающейся женщиной.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Хм, я не забуду проверить твои данные.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Берегите себя. Мы встретимся снова.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
