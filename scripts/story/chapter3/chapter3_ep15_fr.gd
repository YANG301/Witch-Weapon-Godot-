# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Nous nous précipitons jusqu'au parking souterrain selon les instructions de Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru m'a dit que les hommes de l'Administrateur s'étaient retirés par une autre sortie au lieu de nous courir après.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Laissez-moi vérifier sa blessure… J'ai déjà appris les premiers secours.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me signale de poser Annie à plat sur une surface plane. Elle vérifie ensuite le pouls et la respiration de Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Heureusement, il n’y a pas de fibrillation virale, même si sa respiration est assez superficielle et les brûlures graves. Aucune idée s’il s’agit d’une blessure interne…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("C'est brutal ! Traiter une fille comme ça !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Hmm… Mademoiselle ?", "Beatrice")
	await novel_interface.show_dialog("Attirez-vous souvent les petits animaux ? \\nPar exemple :", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nous nous retournons et regardons. Il y a deux pigeons près de chez nous.")
	await novel_interface.show_dialog("Roucou— Roucou—", "Pigeon")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Qu'y a-t-il d'étrange à cela ? Les pigeons se trouvent partout.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Non, c'est le sous-sol trois ici !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Et alors ? \\nCe ne sont pas des animaux en voie de disparition.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Roucou— Roucou— Roucou—", "Pigeon")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(… Noblesse, hah. Aucun bon sens du tout.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("La magie curative attire les petits animaux. Mais si elle n'en est pas consciente...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice me rapproche de Raphael, prenant ses mains et les miennes.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Viens, essaie ça—", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Hum ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice puts my hand on Raphael's, and presses our hands hard with her palm.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("Que fais-tu...?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je ne m'attendais pas à ce que la main de ... \\nRaphael soit aussi douce et chaude ...")
	await novel_interface.show_text_only("Non, attends ! \\nSuis-je—")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lui tenant les mains…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je vois de la surprise et de la colère sur le visage de Raphael. Elle me regarde, crachant presque du feu.")
	await novel_interface.show_text_only("Je frémis à l’idée d’être traité de pervers et battu noir et bleu.")
	await novel_interface.show_text_only("Soudain, Raphael se tourne vers Beatrice, comme s'il réalisait quelque chose. Beatrice hoche légèrement la tête.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael ferme les yeux, avec un regard intense sur le visage. Et Beatrice éloigne lentement sa paume.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(Quoi ? Est-ce qu'elle aime me tenir la main ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout d’un coup, une agréable chaleur traverse mon corps et je me sens plus détendu que jamais.")
	await novel_interface.show_text_only("Ouf... Je me rends compte soudain que l'air est si frais, même dans son parking souterrain.")
	await novel_interface.show_text_only("Et d’une manière ou d’une autre, cette scène horrible cesse de me hanter.")
	await novel_interface.show_dialog("Ah-em…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je vois les cicatrices de brûlures sur le corps de Annie disparaître à une vitesse incroyable.")
	await novel_interface.show_text_only("La chaleur diminue progressivement. Raphael pousse un soupir de soulagement et ouvre les yeux.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, où en sommes-nous…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me regarde d'un air endormi, comme s'il venait de se réveiller.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Nous sommes en sécurité maintenant. J'attends juste Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Pourquoi…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("N'avez-vous pas… remarqué cela auparavant ?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Une sorcière avec une magie de guérison si merveilleuse… \\nTu es incroyable !", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Ouais, vraiment ! J'ai aussi ressenti la magie !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Sorcière ? Magie? Quelle absurdité !", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael fronce les sourcils sévèrement.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Qu'est-ce que tu m'as fait ? \\nPourquoi ses blessures guérissent-elles si vite ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je sais qu'il est difficile d'assimiler autant d'informations d'un coup. Alors je reste silencieux.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Qui sont ceux qui attaquent nos soldats de sécurité ? \\nComment osent-ils utiliser l'arme Substance H ici…", "Raphael")
	await novel_interface.show_dialog("Pourquoi une personne morte depuis des centaines d’années a-t-elle soudainement repris vie ? Et je porte son collier !", "Raphael")
	await novel_interface.show_dialog("Et j'ai vu… \\nLe cauchemar…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voix de Raphael tremble en pensant à cette horrible scène.")
	await novel_interface.show_text_only("Je me tourne vers Beatrice. Un sourire calme apparaît sur son beau visage.")
	await novel_interface.show_text_only("L'émeraude est revenue à son état d'origine et Beatrice l'a rendue à Raphael.")
	await novel_interface.show_text_only("Il semblait que la scène terrifiante d’il y a un instant n’avait rien à voir avec elle.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("La magie du Livre des Sept Philosophes perturbe l'esprit… \\nIl est tout à fait normal de ressentir de la peur lors de votre première rencontre.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Mais la peur est une émotion importante. Connaître votre faiblesse vous aide à survivre aux crises.", "Beatrice")
	await novel_interface.show_dialog("Ce qui est vraiment horrible, ce sont ceux dominés par la peur…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice semble être entraînée dans les souvenirs, avec un regard triste dans les yeux.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Quoi qu’il en soit, j’aurais préféré ne jamais ouvrir ce livre et ne jamais faire ce vœu…", "Beatrice")
	await novel_interface.show_dialog("Et je n’ai jamais… obtenu le pouvoir maudit…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Maudit ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Le Grimoire m'a doté d'une magie… \\nJe ne peux pas me empêcher de dégager un charme qui attire les hommes.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(C'est pourquoi…!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice se tourne vers moi et me tapote la gorge du bout de son doigt.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Puis-je poser une question ?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Oui… S'il vous plaît !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Votre nom est Ren, n'est-ce pas ? \\nTu es spécial…", "Beatrice")
	await novel_interface.show_dialog("En tant que fille, tu devrais être immunisée contre mon charme. Alors pourquoi ... me jetiez-vous des regards furtifs ?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elle est remarquée ! \\nTellement honte !")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mais… contrairement aux hommes, vous ne perdez pas complètement le contrôle… et vous ne vous comportez pas comme un fou.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Est-ce à cause de ma magie ?…) \\n(Non non non, j'ai complètement perdu le contrôle !)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice soulève lentement ma mâchoire avec un doigt, puis touche doucement mon nez.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("... ne me dérange pas Honnêtement, je dois admettre ... que tu es mignon.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("J'avale inconsciemment.")
	await novel_interface.show_text_only("Est-ce que ... est juste l'effet de la magie ?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Peu de temps après, une limousine SUV noire s’est arrêtée en sifflant devant nous.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, entre !", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, n'est-ce pas ? J'espère que tu viendras avec nous.", "Mariru")
	await novel_interface.show_dialog("J'ai trouvé tous les documents disponibles… Au cas où vous seriez intéressé par la vie de ceux que vous connaissez.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Votre admirateur secret, le poète, a écrit des vers qui ont traversé les siècles.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Très bien. Je suis aussi intéressé par cette mignonne ici.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En rencontrant les yeux de Beatrice, je rougis à nouveau…")
	await novel_interface.show_text_only("Est-ce que... Est-ce vraiment juste l'effet de sa magie ?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Et Raphael, tu retournes dans ta chambre. Le gang est déjà parti. C'est sûr maintenant.", "Mariru")
	await novel_interface.show_dialog("Si la délégation constate que vous avez disparu… Vous ne voulez pas leur faire peur, vous savez.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Nous avons transporté de la contrebande… et provoqué de tels troubles…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael regarde Beatrice. \\nEh bien, la contrebande s'est transformée en une belle dame. How sweet!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Et tu me laisses partir comme ça ?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("En échange, le Dr Dekkers a accepté que mes commerçants désignés soient les premiers à acheter les produits de Salmonton au cours de l'année à venir.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Et il a également promis de fermer les yeux sur mes activités commerciales au Newmoridas Futures Exchange.", "Mariru")
	await novel_interface.show_dialog("L’accord se trouve déjà sur mon bureau. Alors rassurez-vous. SID n'est pas un groupe caritatif.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Attendez ! Nous avons risqué nos vies uniquement pour que vous gagniez de l'argent !?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Très bien. Je promets de ne parler à personne de cet incident avant d'avoir tout réglé.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("C'est un tel plaisir de travailler avec le Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, je vais certainement comprendre cette chose magique après mon retour à Salmonton !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("S'il vous plaît, faites-le ! Je pense que tu as vraiment un merveilleux pouvoir magique.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se détourne mais s'arrête brusquement. \\nElle enlève son collier et me le lance.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Cela vient de votre collection familiale, n'est-ce pas ? Comment peux-tu…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("C'est à toi maintenant.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Une fille vaillante ! Quand tu seras grande, tu deviendras une femme exceptionnelle.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, je n'oublierai pas de vérifier vos antécédents.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Prenez soin de vous, tout le monde. Nous nous reverrons.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
