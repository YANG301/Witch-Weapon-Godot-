# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Ich fühlte mich unruhig, als ich Raphael durch den Campus ging.")
	await novel_interface.show_text_only("Ich hätte nie gedacht, dass ich das Ziel so leicht erreichen könnte.")
	await novel_interface.show_text_only("Der stellvertretende Schulleiter sieht, wie seine lange vorbereitete Begrüßungszeremonie scheitert, und knabbert verärgert irgendwo hinter uns an einem Taschentuch.")
	await novel_interface.show_text_only("Allerdings scheint die junge Dame mit unserer kleinen Tour nicht zufrieden zu sein, obwohl sie inzwischen deutlich besser gelaunt ist.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Ist es das?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Ähm, wenn du die Tour meinst.", "Lian")
	await novel_interface.show_dialog("Wenn Sie diesen Weg fortsetzen, gelangen Sie in das Gewerbegebiet.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Viele Gebäude hier imitieren Architekturstile aus der Vorkriegszeit und versuchen, ein Gefühl von Kultur zu vermitteln.", "Raphael")
	await novel_interface.show_dialog("Allerdings ist dieser Campus so klein, dass es keinen Puffer zwischen Gebäuden unterschiedlicher Stilrichtungen gibt.", "Raphael")
	await novel_interface.show_dialog("Das macht es hier zu erdrückend, finden Sie nicht auch?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia ist eine auf Ruinen wieder aufgebaute Stadt. Die meisten seiner historischen Stätten wurden niedergebrannt.")
	await novel_interface.show_text_only("Es ist tatsächlich ziemlich luxuriös, so ein Stück Land innerhalb des Schutzschildes zu haben, wo Land knapp ist.")
	await novel_interface.show_text_only("Irgendwie fühle ich mich durch ihre Worte beleidigt ...")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Hm...", "Lian")
	await novel_interface.show_dialog("Sie müssen Raphael Dekkers aus der Forth Academic City sein.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Warum also besuchst du die Schule, wenn es dir hier nicht gefällt?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Wow, weißt du, wer ich bin?", "Raphael")
	await novel_interface.show_dialog("Hm... Das liegt alles an meinem Opa. Er möchte, dass ich in einer anderen akademischen Stadt studiere ...", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Aber diese Nachahmerschule ohne jegliche Geschichte … Ich würde sie nie wieder betreten.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Also ist sie einfach unzufrieden mit dem Plan ihres Großvaters…) \\n(Warum hat sie sich nicht einfach zu Wort gemeldet?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mist! Ihre Worte haben mich irgendwie berührt. Alle Gebäude in der Schule wirken plötzlich seltsam.")
	await novel_interface.show_text_only("Verdammt! Vergessen Sie diese Kommentare! Jetzt!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Wow, da du so enttäuscht bist ...", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Warum sagst du deinem Opa nicht einfach, was du denkst?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix kommt auf uns zu, elegant wie immer.")
	await novel_interface.show_text_only("Als sich ihre Blicke treffen, glaube ich das knisternde Geräusch einer Hochspannungsentladung zu hören.")
	await novel_interface.show_text_only("Es muss … eine Halluzination sein, oder?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Wer bist du?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Nun, ich bin einfach ein Niemand an dieser Schule.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Ich frage mich nur, was Sie hierher führt, meine Dame?", "Nix")
	await novel_interface.show_dialog("Warum haben Sie überhaupt zugestimmt, hierher zu kommen? Liegt es am familiären Druck?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Meine Familienangelegenheit geht dich nichts an.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Lass mich raten. Ein egozentrisches Kind, das sich nie dem Willen seiner Eltern widersetzt hat.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Warum stufen Sie sich selbst höher ein? Wer gibt Ihnen das Recht, über eine Schule zu urteilen? Schließlich hat sie sich freiwillig bereit erklärt, Ihnen alles zu zeigen.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Verzeihung?! Wann habe ich mich für überlegen gehalten?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Hey, du Perverser. War ich jemals so hochmütig?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Nicht wirklich...", "Lian")
	await novel_interface.show_text_only("Warte, ich bin kein Perverser!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Sehen Sie? Das habe ich nicht gesagt.", "Raphael")
	await novel_interface.show_dialog("Übrigens, das Ding um deinen Hals...", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Ist Schmuck in dieser Schule erlaubt?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Eigentlich gibt es bei uns keine Einschränkungen beim Tragen von Schmuck …", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Und die Halskette von Nix ist so süß!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Die Band mag zurückhaltend sein, aber definitiv nicht das Juwel daran – der Orlov Black Diamond. Dieses königliche Juwel zerbrach in drei Teile und ging während der Turbulenzen vor Kriegsausbruch verloren.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mit nur einem Stück kann man hier wahrscheinlich ein paar Gebäude kaufen.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Was?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Sich als gewöhnlicher Student ausgeben und für ihn eintreten … Was willst du? Diesem Cross-Dressing-Perversen vorzutäuschen, dass du auf ihrer Seite bist?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hör auf, mich einen Perversen zu nennen!")
	await novel_interface.show_text_only("Und warum sieht Nix so subtil und traurig aus?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Ich trage einfach etwas, das zu mir passt.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Was ist mit dir? Sie versuchen, unabhängig zu wirken, sind aber stolz darauf, den Reichtum Ihrer Familie zu genießen. Das ist urkomisch.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Ich erinnere mich, dass alle drei Teile in die Hände eines Mafiabosses fielen. Ein schwarzer Diamant, der mit unrechtmäßig erworbenem Geld gekauft wurde – er steht Ihnen gut.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nun, ich muss zugeben, dass es meiner Familie weniger gut geht. Schließlich kann sich nicht jeder durch das Getreidemonopol ein Vermögen und einen Adelstitel verdienen.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Denn nur unsere Ernte könnte den Menschen helfen, die Schwarze Pest zu verhindern. Sie verdienen es zu leben. Im Gegensatz zu dir, von innen nach außen verrottet.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie bestehen darauf, den Glauben zu bewahren, während Sie der Welt mit Hunger drohen. Warum denkst du nicht zuerst über deine eigene Seele nach?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ich muss das nicht mit Leuten wie dir machen. Es wird mir nur Schande bereiten.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Oh, das kommt mir bekannt vor. Ich möchte auch nichts über euch Verlierer erfahren.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Die Nachmittagssonne scheint sanft auf uns.")
	await novel_interface.show_text_only("Da ich zwischen den beiden stehe, habe ich keine Ahnung, wie ich diesen Streit beilegen soll.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Sind Sie sicher, dass Sie sich noch nie zuvor getroffen haben?)", "Lian")
	await novel_interface.show_dialog("(Sind Sie wirklich keine lebenslangen Feinde?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der stellvertretende Schulleiter in der Ferne ist bereits ausgeflippt und wurde zur Notfallbehandlung abtransportiert.")
	await novel_interface.show_text_only("Egal. Ich habe alle Informationen, die Mariru benötigt.")
	await novel_interface.show_text_only("Es geht mich sowieso nichts an.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
