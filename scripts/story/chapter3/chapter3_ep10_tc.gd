# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("由於斯庫爾德的出現，那名叫法貝拉的暴力女僕似乎決定放我一馬。")
	await novel_interface.show_text_only("而斯庫爾德剛剛才跟我們打過照面，就馬上有好幾位打扮講究的賓客圍上來跟她打招呼。")
	await novel_interface.show_text_only("明明是和伊露卡差不多年紀的小姑娘，卻能在這樣的社交場合應對自如……")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("（斯庫爾德……是誰家的大小姐嗎？ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("趁法貝拉把注意力轉移到她的小主人身上，我馬上逃到了宴會廳的另一側。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("嚇死我了……\\n那兩人是主僕關係吧？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("那個女僕好像也沒有要揭穿我的意思，\\n說那樣的話是想要騙我嗎？")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("小憐，我找妳好久了！", "安妮")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("我可能發現了關鍵線索喲！", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("哎？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我剛才偷偷跟著考察團的人到了行政樓層，看到拉斐爾的隨從拿著一個特別的手提箱。", "安妮")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("手提箱……裡面裝了什麼？", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒看到，但是那個手提箱的材質，我在參加SID培訓的時候學到過！", "安妮")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("灰綠色的金屬，周圍散發著特有的淡藍色光暈──", "安妮")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("藍色光暈……\\n難、難道是！ ！", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("我也想起來了，那是一種可以減弱或遮蔽精神和迷因類「異質物」影響的合金特性。")
	await novel_interface.show_text_only("使用那種材料打造的容器裝載「異質物」，就可以躲過絕大部分的色相掃描。")
	await novel_interface.show_text_only("那種合金本身也是異質物，98%的構成物質是已知金屬，剩下的2%為未知物質。")
	await novel_interface.show_text_only("由於存量稀少，幾乎被不法人士在黑市上哄抬成了天價。")
	await novel_interface.show_text_only("所以那個手提箱裡，幾乎可以肯定是與「異質物」有關的東西。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("這、這不是大條了嗎！ ！\\n妳向莉琉報告了嗎？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("本次薩蒙頓的考察團入境時，並未向元老院申報攜帶任何「異質物」。")
	await novel_interface.show_text_only("如果是高殺傷性的「異質物」被偷運到防護力場內，可能會讓新豐洲瞬間毀滅。")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("已經在第一時間報告了，莉琉小姐現在應該正在向元老院申請調查令。", "安妮")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("但我只是一閃而過時看到的，並沒有拍到照片。 \\n怕是很難僅憑我的證詞就硬闖……", "安妮")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("所以，莉琉小姐剛才已經將我們的命令更改為「盡快取得證據並上傳」了！", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("這樣的話，那我們得想辦法潛入他們的房間才有機會查清楚……", "小憐")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯……潛入那個貴族小姐的房間，可能難度不小呀。", "安妮")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("事到如今……也只能走一步算一步了……", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("我和安妮搭員工電梯到了被考察團包下的整層行政樓層。")
	await novel_interface.show_text_only("我推著從廚房「借」來的餐車，讓安妮藏在餐車底下，向守在走廊的幾個保全走去……")
	await novel_interface.show_dialog("喂！ 妳是樓下宴會的女僕吧？ \\n這裡不是妳該來的地方，馬上離開。", "保全")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("（果然和想像中一樣守衛非常森嚴啊。 ）", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("哎？ 剛才皇室套房點了客房服務，指明要女僕現場製作火焰威士忌鵝肝呢。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("帶頭的保全仍然一臉嚴肅，絲毫不為所動。")
	await novel_interface.show_text_only("看來我想的還是太天真了，得想想其他辦法……")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("啊哈哈……那可能是客房服務部搞錯了，抱歉打擾了……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我還沒來得及把話說完，安妮已經一個箭步衝了上去，一個肘擊正中帶頭保全的頸部。")
	await novel_interface.show_text_only("接著迴轉身體借力拋出一顆棒球，精準地擊中了十公尺外另一名保全的臉。")
	await novel_interface.show_text_only("剩下的保全被突如其來的攻擊打亂了陣腳，還沒來得及按下通訊器就被安妮一記飛踢擊中了下巴。")
	await novel_interface.show_text_only("三名保全幾乎同時倒地，而那顆被拋出的棒球只在地上彈了一下便又回到了安妮手中。")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("好，解決啦！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("妳、妳把他們怎麼樣了？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("放心吧，只是讓他們稍微睡一會兒而已。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("哈哈，還真是符合安妮的風格啊……\\n（唔…還好我和安妮是一國的……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("而且剛才安妮並沒有使用魔法吧？ ！\\n莉琉平時都給她安排了什麼樣的訓練啊……")
	await novel_interface.show_text_only("解決了走廊上的保全之後，安妮帶著我走向最裡面兩側開門的套房。")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("就是這裡。", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我和安妮對看了一眼，\\n正準備趴在房門上偷聽的時候——")
	await novel_interface.show_text_only("有人從裡面開門，害我們毫無防備地摔了進去。")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("哎唷喂呀……好痛", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我坐在地上，抬頭看到了那張熟悉又高傲的臉。")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("……拉斐爾？ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("拉斐爾依舊一臉鄙夷的表情，她的身邊還站著好幾個保鏢和隨行人員。")
	await novel_interface.show_text_only("啊，居然都是御姐型的漂亮大姐姐呢……")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("嗯～？ 你不是那所破爛學校裡的女裝癖嗎？ 鬼鬼祟祟的在幹嘛？", "拉斐爾")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("這次還換了女僕裝，你這變態的特殊興趣又更惡劣了嗎……", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("好、好巧啊～\\n我只是跟同學來這裡打工……", "小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("啊，對了，宴會廳是在樓下吧！ \\n我們好像走錯地方了。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮對不起，我真的太不擅長撒謊了！")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("奇怪了，保全沒有攔住你們嗎？", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("拉斐爾疑惑地向走廊看了一眼。")
	await novel_interface.show_text_only("她注意到走廊上倒地不起的保全們後，露出了震驚的表情。")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("——給我抓住她們！", "拉斐爾")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
