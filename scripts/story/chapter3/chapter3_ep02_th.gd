# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("บันทึก SID แสดงให้เห็นว่าศูนย์ Akatraz รวบรวม EX-คลาส Substance H ที่รัฐสภาห้ามไม่ให้ทำการทดสอบและวิจัย")
	await novel_interface.show_text_only("ใต้พื้นดินของศูนย์เชื่อมต่อกับทางเข้าบ้านถ้ำ Chate โบราณวัตถุที่ห้ามเข้าและไม่สามารถประเมินได้")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX-class Substance H… มันเป็นสิ่งที่อันตรายมากหรือเปล่า?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("ส่วนใหญ่เป็นสิ่งของศักดิ์สิทธิ์ที่มีความสำคัญทางศาสนา เนื่องจากเป็นสิ่งพิเศษสำหรับสาวกทางศาสนาจึงสามารถรวบรวมได้ แต่ห้ามการวิจัย", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฟังดูเหมือนหลอกตัวเอง", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("ฮ่า ฉันก็รู้สึกแบบนั้นเหมือนกัน \\nแต่ มันก็สมเหตุสมผลในทางหนึ่ง", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("สิ่งประดิษฐ์บางชิ้นในตำนานทางศาสนาว่ากันว่ามีพลังในการสังหารพระเจ้าหรือจุดชนวนการพิพากษาครั้งสุดท้าย", "Mariru")
	await novel_interface.show_dialog("เมื่อเปิดใช้งานแล้ว พวกมันอาจทำให้เกิดภัยพิบัติระดับวันสิ้นโลกได้", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ที่ไม่ดี.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("แม้ว่าบางรายการที่ได้รับการนับถือในเรื่องราวทางศาสนาในเวลาต่อมากลับกลายเป็นว่าอ่อนแอ—หรือแม้แต่ไร้ผลอย่างน่าเขินอาย ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มีอะไรโง่เหรอ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("ใช่ ตัวอย่างหนึ่งก็คือรองเท้าศักดิ์สิทธิ์คู่นี้ ใครก็ตามที่จูบปลายรองเท้าก็ไม่สามารถต้านทานการจูบได้ ถือเป็นเรื่องน่าเสียดายสำหรับศาสนา", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("นั่นน่าขยะแขยง \\nดังนั้น. ของที่หายไปนี้เป็นของประเภทไหนคะ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("นี่คือ Destiny Spear ซึ่งเป็นอดีตคลาส Substance H ภายใต้การดูแลร่วมของเมืองแห่งสถาบันการศึกษาทั้งหมด", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("โอ้. \\nฉันเข้าใจแล้ว ฟังดูเท่ดี", "Lian")
	await novel_interface.show_dialog("Destiny Spear คืออะไรกันแน่?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("ตอนนี้คุณดูเหมือนคนงี่เง่าโดยสมบูรณ์", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("เฮ้ ฉันไม่รู้จริงๆ นะ! \\nฉันเป็นแค่นักเรียนมัธยมปลาย", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru มองมาที่ฉันอย่างช่วยไม่ได้ ราวกับสงสัยว่าจะเริ่มจากตัวฉันตรงไหนดี")
	novel_interface.character_light()
	await novel_interface.show_dialog("โดยสรุป นี่คือ Substance H ประเภทแรก ซึ่งเชื่อกันว่ามีพลังในการทำลายล้าง", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("คำอธิบาย Destiny Spear มีน้อยมากในวรรณกรรมที่เผยแพร่ต่อสาธารณะ ยกเว้นว่า \"ไม่ละลายในอุณหภูมิสูง\" และ \"มีน้ำหนักเพิ่มขึ้นเมื่อเหวี่ยง\"", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("แค่นั้นแหละ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("หากคุณเจาะลึกลงไปอีก คุณจะพบว่าลักษณะใดลักษณะหนึ่งจะทำให้เป็นคลาส XK Substance H", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("อาจมีลักษณะที่เป็นอันตรายและไม่ทราบสาเหตุอื่นๆ นั่นเป็นเหตุผลที่พวกเขาไม่ควรดึงดูดความสนใจของสื่อมากเกินไป", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("นี่ทำให้ฉันขนลุก แม้แต่เด็กเล็ก ๆ ก็รู้ว่า XK-class Substance H คืออะไร...")
	await novel_interface.show_text_only("มันจะนำไปสู่หายนะวันโลกาวินาศหรือสร้าง Substance H ขึ้นมาอีกอันที่มีพลังเท่ากัน ปัจจุบันมีเพียงหกรายการประเภทนี้ที่รู้จักในโลก")
	await novel_interface.show_text_only("แต่ละแห่งอยู่ในหนึ่งในหกเมืองแห่งการศึกษา แม่นยำยิ่งขึ้น เฉพาะผู้ที่ครอบครอง Substance H ดังกล่าวเท่านั้นที่ได้รับการยอมรับจาก United Congress")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("ฮะ? \\nซึ่งหมายถึง ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ตอนนี้คุณรู้แล้วว่า \"คุณ\" ก่ออาชญากรรมร้ายแรงอะไร?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ฉันตกใจมากจนทุกอย่างดูเหมือนเหนือจริงสำหรับฉัน")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… ขออภัย \\nไม่! ทำไมฉันถึงบอกว่าขอโทษ? ฉันไม่ใช่หัวขโมย!", "Lian")
	await novel_interface.show_dialog("(บ้าเอ๊ย ผู้ชายคนนั้นต้องอันตรายสุดๆ เลย!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("แต่โชคดีที่ข่าวถูกลบออกไป", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("พวกเขาทำเพียงเพื่อหลีกเลี่ยงความตื่นตระหนกในที่สาธารณะ\\nการสืบสวนยังคงดำเนินต่อไปอย่างลับๆ", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("ด้วยเหตุผลด้านการรักษาความลับ จะไม่มีการออกประกาศที่ต้องการไปยังกระทรวงกลาโหม แต่หน่วยข่าวกรองทั้งหมด รวมถึง SID จะต้องได้รับแจ้งแล้ว", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ยังเร็วไปที่จะรู้สึกโล่งใจ เร็น", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("ใช่… ฉันคนเดิมยังตกอยู่ในอันตรายใช่ไหม?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("จะเกิดอะไรขึ้นถ้า... ฉันหมายถึงจะเกิดอะไรขึ้นถ้า... \\n...มีคนติดตามฉัน...", "Lian")
	await novel_interface.show_dialog("แม้ว่าตอนนี้ฉันจะเป็นผู้หญิง ฉันก็คงถูกขังใช่ไหม?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ในที่สุดคุณก็ได้รับมัน", "Mariru")
	await novel_interface.show_dialog("หน่วยสืบราชการลับได้ตรวจสอบภาพจากกล้องวงจรปิดที่มีอยู่ทั้งหมด และพบว่าชายคนนี้ปรากฏตัวขึ้นในพื้นที่ฟลักซ์อื่นๆ โดยที่ยังคงมีใบหน้าเก่าของคุณอยู่", "Mariru")
	await novel_interface.show_dialog("เนื่องจากเราสามารถดึงข้อมูลจากแหล่งบุคคลที่สามได้ หน่วยข่าวกรองอื่นๆ อาจมีข้อมูลนี้อยู่แล้วเช่นกัน", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("กระทำความผิดซ้ำแล้ว? \\nอนาคตของฉันดูมืดมน ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ฉันนึกภาพตัวเองถูกทรมานในการสอบสวนไม่รู้จบ...")
	await novel_interface.show_text_only("ฉันรู้สึกเหมือนว่าฉันจะถูกจับกุมทุกเมื่อและถูกตราหน้าว่าเป็นอาชญากรต่อมนุษยชาติ")
	await novel_interface.show_text_only("ถูกขังอยู่ในคุกที่โหดร้ายที่สุดซึ่งถูกตัดสินจำคุกกว่า 200 ปี")
	await novel_interface.show_text_only("ฉันอาจมีเพื่อนร่วมห้องขังที่อันตรายสุดๆ และเขา...")
	await novel_interface.show_text_only("วาหยุดนะ! \\nไม่ต้องคิดอีกแล้ว!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("ฮ่าๆ คุณกลัวมากและดูซีดมาก", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("ใจเย็นๆนะเรน ฉันรับประกันความปลอดภัย 98% ให้กับคุณได้ตราบใดที่คุณอยู่ใน New Opulentia", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("ฉันยังมีโอกาส 2% ที่จะโดนจับเหรอ?", "Lian")
	await novel_interface.show_dialog("(สองวินาทีของความไม่แน่นอนในทุก ๆ ร้อยวินาที!) \\n(นั่นไม่ปลอดภัยเลย!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("การที่สุนัขแก่ๆ เหล่านั้นใน United Congress บรรลุข้อตกลงร่วมกันโดยแจ้งล่วงหน้าสั้นๆ เช่นนั้น... มีบางอย่างไม่ถูกต้อง", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("และนี่คือปัจจัยที่ไม่ทราบ 2% ที่ฉันพูดถึง", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("ฉันนึกภาพไม่ออกเลยว่ามันทำให้เกิดความปั่นป่วนอะไรในหมู่คนสำคัญเหล่านั้น...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ดังนั้น หน่วยข่าวกรองของ Academy Cities อื่นๆ ต้องใช้ทรัพยากรจำนวนมากเพื่อตามล่าหัวขโมย", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ว... ฉันควรทำอย่างไร?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("ศัตรูที่มองเห็นนั้นง่ายต่อการจัดการเสมอ ปล่อยให้เป็น SID เถอะ", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
