# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Nous sommes entourés des gardes du corps de Raphael. Annie me fait un clin d'œil—")
	await novel_interface.show_text_only("Je comprends tout de suite son point de vue et libère toute la pression qu'elle a accumulée lorsque nous étions dans le couloir.")
	await novel_interface.show_text_only("Tout d’un coup, des centaines de balles de baseball jaillissent, frappant un gars et rebondissant immédiatement vers un autre.")
	await novel_interface.show_text_only("N'ayant visiblement jamais vu cela auparavant, les gardes du corps paniquent et sont abattus les uns après les autres.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Je n'ai jamais utilisé cette astuce sur des gens ordinaires auparavant. Ça marche si bien…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Bien sûr ! Les humains sensés sont beaucoup plus faciles à gérer que les sorcières folles !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Tirez ! Vous êtes des idiots…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Comment osez-vous, fauteurs de troubles ! Les soldats de la sécurité ne vous lâcheront pas !", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je remarque juste qu'après le combat, la Suite Royale de Raphael est devenue un véritable désastre, ses gardes du corps gisant partout sur le sol.")
	await novel_interface.show_text_only("Annie et moi voulions juste nous faufiler et recueillir des preuves, mais il semble que nous ayons provoqué un grave désastre diplomatique…")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Merde… Annie ! \\nC… allez ! Attachez-la !!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Paniqué, je donne à Annie une instruction folle.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Oui ! Ça ira!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie descend agilement Raphael, ouvre un rideau tombé sur le sol pendant le combat et, avec lui, attache rapidement la jeune fille en difficulté.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Comment oses-tu—!! \\nEspèce de pervers travesti ! Que voulez-vous de moi?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Maintenant, Raphael, l'invitée d'honneur de l'État dans New Opulentia, petite-fille du maire de la Quatrième Cité Académie, est attachée à une chaise dans sa propre suite—")
	await novel_interface.show_text_only("Annie est vraiment doué pour ça !! \\nEt on dirait que je ne pourrai jamais me débarrasser de ma réputation de pervers…")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Je suis vraiment désolé pour cela, mais nous devons nous assurer que vous ne déclencherez pas l'alarme…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je montre un bouton rouge sur le mur. Une fois le bouton appuyé, une équipe de soldats de sécurité lourdement armés encerclera la pièce dans les 3 minutes.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, alors qu'est-ce que tu veux ?", "Raphael")
	await novel_interface.show_dialog("Vous ne cachez pas votre identité et vous ne semblez pas avoir de plan d'évacuation... \\nCe n'est pas un enlèvement contre rançon, n'est-ce pas ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Même attachée à une chaise, Raphael a toujours l'air confiant et pense clairement… Quelle noble dame.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Qui es-tu ? \\nVoulez-vous simplement utiliser les armes Substance H ?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ses paroles me rappellent ma tâche prioritaire du moment.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Mme Raphael, nous voulons juste comprendre une chose. \\nIl s'agit de cette valise…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Quelle valise ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael a l'air perplexe et semble n'avoir aucune idée de ce que j'ai dit.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("On dirait… qu'il est déjà cassé !", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Quoi ?! Je pensais que l'alliage devait être très solide !", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je regarde vers où Annie pointe et je vois la valise, maintenant brisée avec d'énormes trous laissés par les tirs de balles de baseball.")
	await novel_interface.show_text_only("Le couvercle en plastique noir de la valise est brisé, révélant une couche métallique dégageant une lumière bleu pâle.")
	await novel_interface.show_text_only("Le plastique est une couverture amovible courante. Annie a dû remarquer la couche intérieure de la valise.")
	await novel_interface.show_text_only("La serrure est détruite, les composants et pièces métalliques se dispersent sur le tapis.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est bizarre, mes balles de baseball ne ciblent que des cibles vivantes…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael semble avoir également remarqué le matériau qui émet de la lumière bleue. Elle a l'air surprise et nerveuse.")
	await novel_interface.show_text_only("Au milieu des mousses antichocs et des pièces métalliques éparpillées, j'aperçois une petite chose scintillante.")
	await novel_interface.show_text_only("C'est un accessoire doré en forme de papillon. Avec de délicats motifs découpés sur les ailes, il ressemble à un véritable papillon.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Serait-ce cette chose… qui a attiré vos balles de baseball pour viser la valise ?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Attention ! Il pourrait s'agir d'un Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le papillon doré réaliste semble prêt à voler à tout moment. Même Raphael est fasciné. Je ne peux m'empêcher de tendre la main…")
	await novel_interface.show_dialog("Hé, idiot. \\nJ'ai dit de ne pas y toucher—", "Mariru")
	await novel_interface.show_text_only("La voix de Mariru sort de nulle part. Quelque part dans mon corps, j’ai soudain l’impression de bourdonner. J'ai l'impression qu'elle parlait à côté de moi.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Euh ? \\n… Qu'est-ce que c'est !?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fais le tour de mon corps, dans l'espoir de découvrir d'où vient la voix et de m'assurer de ne voir aucun haut-parleur quelque part.")
	await novel_interface.show_dialog("Si la balle de baseball de Annie avait pu laisser un trou aussi profond sur l'alliage d'une dureté Rockwell de 70, les têtes des gardes du corps auraient été réduites en poussière.", "Mariru")
	await novel_interface.show_dialog("Il est plus probable que le petit gadget ait simplement voulu utiliser les chocs des balles de baseball pour éclater…", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ces trous… ont été laissés par l'accessoire lui-même ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Euh, très probablement. Alors, tu veux toujours toucher à une chose aussi dangereuse ?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Attendez, le problème est— \\nMariru !!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bon sang ! Je trouve la source de sa voix !")
	await novel_interface.show_text_only("C'est directement de ma poitrine ! Pas étonnant que mon corps bourdonne à chaque fois qu’elle parle…")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Comment as-tu pu planter une puce dans mon corps !!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vous venez de révéler notre technologie secrète à un étranger ! Voulez-vous vous faire tamponner à nouveau ?", "Mariru")
	await novel_interface.show_dialog("Annie, endors la dame un moment ! \\nMais soyez prudent. Ne faites pas de mal à notre invité d'honneur.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Hé! N'ose pas...!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie jette habilement un couteau sur la nuque de Raphael, la plongeant dans un état de panne de courant.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Il est interdit à Mme Mariru, Substance H d'entrer dans New Opulentia sans l'approbation officielle, n'est-ce pas ?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bien sûr ! Humph, ils m'ont passé ça sous le nez ! Le Dr Dekkers devra expliquer cela au Sénat.", "Mariru")
	await novel_interface.show_dialog("… Attendez ! Je pense que les gardes de sécurité à l'extérieur ont attiré l'attention.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Euh, c'est rapide.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Les soldats de la sécurité en bas se rassemblent dans le hall. \\nJe fais appel à l'équipe de collecte pour vous aider. Nous arriverons dans 8 minutes.", "Mariru")
	await novel_interface.show_dialog("Annie, scellez la porte avec des aérogels maintenant.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Oui, madame !", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
