# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("昨晚開始，SID就偵測到「天空酒店」那裡出現了數起間歇性的時空相位波動。")
	await novel_interface.show_text_only("巧合的是，薩蒙頓的考察團也在昨晚全員入住了這座地處「協議非武裝區」的豪華酒店。")
	await novel_interface.show_text_only("而今晚他們還要在酒店舉行藝術品交流晚宴，並邀請了各個學園都市的名流。")
	await novel_interface.show_text_only("但拉斐爾和她的隨從卻沒有出現在晚宴名單上。")
	await novel_interface.show_text_only("——因此，我和安妮再次被莉琉派到了這個麻煩的地方執行任務。")
	await novel_interface.show_text_only("站在富麗堂皇的宴會廳門口，我有些侷促不安。")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("唔……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("怎麼啦，妳看起來很緊張耶？", "安妮")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("當然會緊張吧，這可是女僕裝欸！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("沒錯，今晚我和安妮是以偽裝身分潛入會場。")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("而且為什麼妳是御櫻川的學生會代表，我就是服侍賓客的女僕啊！ ！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("女僕裝不是男人的夢想嗎？", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("但是那絕對不包括「自己穿女僕裝」這項吧！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("唔……\\n好像也是呢～", "安妮")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("明明打扮的這麼可愛，卻無法欣賞到自己的身影，\\n嗯嗯，我懂，難怪妳如此急躁……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮退後幾步，拿出手機，\\n「喀嚓」一聲拍了張照片。")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("嗯……果然雙馬尾也很合適小憐呢。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("不要拍啊──快刪掉！", "小憐")
	await novel_interface.show_dialog("（這種羞恥的……）\\n（萬一被……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮的手機傳出了訊息傳送成功的音效。")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("已經傳給妳和莉琉啦～", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("完蛋了。")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("嘿嘿，別害羞嘛～\\n這種荷葉邊和小憐的風格超級搭的！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("我拿出手機，看到安妮傳來的照片。")
	await novel_interface.show_text_only("似乎還……不錯？")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("才、才沒有咧！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("此時，耳機裡傳來了熟悉的聲音。")
	await novel_interface.show_dialog("好啦，小姑娘們，自拍時間結束，目前的狀況妳們都瞭解了吧。", "莉琉")
	await novel_interface.show_dialog("因為第四學園都市向聯合議會申請，所以今晚酒店周圍的保安警察，全都戒備森嚴。", "莉琉")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("總之，查明相位波動的原因就立刻撤離對吧？ \\n我知道啦～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("這回我不能像上次那樣硬來了，所以妳們倆都給我機靈點，尤其是小憐──", "莉琉")
	await novel_interface.show_dialog("打扮的這麼可愛，萬一被抓到了，說不定會被某個權貴看上然後帶回家……", "莉琉")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("妳夠了唷！ ！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("啊，那邊薩蒙頓教育委員會的代表在叫我，\\n正好趁機去偷聽一下。", "安妮")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("小憐妳也去找找機會吧！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("話剛說完，安妮就換上一臉商業笑容，\\n轉身向幾個穿著禮服的男人揮手然後跑過去了。")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("安妮還真是得心應手啊……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("可是女僕到底該做些什麼啊？", "小憐")
	await novel_interface.show_dialog("這個酒盤，有點不好平衡……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("請給我一杯Dom Perignon，謝謝。", "客人甲")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("啊？ ……好的！ 馬上來！ \\n唔…麻煩您再說一次，您要一杯什麼？ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("……", "客人甲")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("（糟糕，我好像問了很蠢的問題……）\\n唔，呃……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("沒有接受過女僕的職業培訓，我完全不知道這種時候該怎麼應付啊。")
	await novel_interface.show_dialog("嘖嘖，明明是以女僕為賣點的宴會廳，\\n居然這麼不專業？", "客人甲")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("對不起，那個……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("喂喂，妳傻乎乎地在這裡發什麼呆呢？", "粉色頭髮的女僕")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("為什麼？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我轉過頭，面前出現一位粉色頭髮、長相清秀、戴著紅框眼鏡的女僕。")
	await novel_interface.show_text_only("她禮貌地向客人微笑了一下，但臉在轉向我的瞬間表情迅速轉為憤怒。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("快跟我去給客人拿香檳！", "粉色頭髮的女僕")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("欸？ 妳是……？ \\n（這身裝扮看起來好像不是這家酒店的……）", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("粉色頭髮的女僕不由分說地拉起我的手走向沒人的角落，我才發現她的力量大得驚人。")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("瞧妳笨手笨腳的樣子，一點都不專業！", "粉色頭髮的女僕")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("那、那個……我……", "小憐")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("對不起，我剛就職不到一個小時！")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("等等，明明妳說話的語氣也不像女僕啊……")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳那是什麼眼神？ \\n難道是在質疑我身為女僕的權威嗎？", "粉色頭髮的女僕")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("妳給我聽好了──在我的主人面前，我絕對是萬能的女僕！ 這一點任何人都不准懷疑。", "粉色頭髮的女僕")
	novel_interface.character_dark()
	await novel_interface.show_text_only("紅框眼鏡突然做出了自豪的宣言。")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("好、好的……", "小憐")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("不管如何，剛才謝謝妳替我解圍……\\n不然我還真不知道該怎麼辦。", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("喂──所以說，妳為什麼會到這裡來？", "粉色頭髮的女僕")
	novel_interface.character_dark()
	await novel_interface.show_text_only("面前的人突然語氣嚴肅起來，\\n透出一絲寒氣")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("敢撒謊的話，我就把妳燒成焦炭喲！", "粉色頭髮的女僕")
	novel_interface.character_dark()
	await novel_interface.show_text_only("紅框眼鏡一邊威脅我，一邊露出了爽朗的笑容，給人的感覺完全不像是在開玩笑！")
	novel_interface.character_light()
	await novel_interface.show_dialog("怎麼？ 是在想著怎麼編謊話嗎？", "粉色頭髮的女僕")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("（糟糕，我的身分暴露了嗎？ ）\\n（她…到底是什麼人啊！ ）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("我知道妳的身分哦──\\n畢竟……", "粉色頭髮的女僕")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("法貝拉，不能無禮喲。", "？？？")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("我循聲望去，打斷我們的，是一個穿著禮服式法蘭裙袍的金髮女孩。")
	await novel_interface.show_text_only("身材嬌小的少女，陽光般的金髮編成的辮子乖巧地落在腰間，眼神也如湖水般清澈明亮……")
	await novel_interface.show_text_only("這個精靈般的少女，空靈般的氣質和眼前奢華的宴會場顯得有些格格不入。")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("斯庫爾德小姐！ \\n真的非常抱歉，居然讓這種小事驚動了您。", "法貝拉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("剛才還凶神惡煞的女僕，在見到這個小女孩後，態度居然變得這麼恭敬。")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("妳看她都不敢說話啦，一定被妳嚇壞了。", "斯庫爾德")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("總之今天就先放過她吧，好不好？", "斯庫爾德")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("遵命。", "法貝拉")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
