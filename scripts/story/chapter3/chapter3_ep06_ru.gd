# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Я покидаю штаб-квартиру с буклетом, в котором указаны все подробности о девушке из элитного общества. Mariru также присылает мне свои фотографии.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Raphael родилась в одной из благородных семей Salmonton и является внучкой доктора Томаса Dekkers, президента Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Ух ты… Я читал о нем в учебниках! \\nЭто становится немного сумасшествием…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Поймал тебя! Привет, дорогая!")
	await novel_interface.show_text_only("Кто-то обнимает меня сзади.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Вааа!", "Lian")
	await novel_interface.show_dialog("…Ая, это ты! Какого черта ты делаешь?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Каждый раз, когда я возвращаюсь из зоны потока, мне приходится проходить полный медицинский осмотр и лечение у Аи.")
	await novel_interface.show_text_only("Ненавижу это признавать, но инструмент Аи в форме осьминога весьма помогает в заживлении ран.")
	await novel_interface.show_text_only("И мне ненавистно то, что я привыкаю к психопатическим действиям Аи…")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Почему ты выглядишь таким разочарованным? \\nМне становится больно.", "Ai")
	await novel_interface.show_dialog("Я не заботился о тебе с тех пор, как ты вернулся с подстанции…", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Итак, я отвезу тебя в школу... \\nИ дам тебе несколько незабываемых уроков.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Что? Ждать…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Убери от меня руки! Это средь бела дня!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("Извращенец Mariru напомнил мне, чтобы я остерегался... \\nДолжно быть, это Ая!")
	await novel_interface.show_text_only("Ая тащит меня в медицинский центр. Я ничего не могу сделать, кроме как лежать на кровати.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Просто медицинский осмотр... Вы слишком драматизируете.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Ты выглядишь разочарованным. Предпочитаете особый режим, да?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, спасибо. \\nПросто регулярный осмотр, пожалуйста.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(И ваш распорядок достаточно особенный!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая, как обычно, достает странный инструмент. Имиджер снова мигает непонятными изображениями.")
	await novel_interface.show_text_only("Чтобы убить время, я достаю мобильный телефон и продолжаю читать о Raphael.")
	await novel_interface.show_text_only("У нее длинные и темно-серые волосы. Ее глаза фиолетовые и острые, как будто готовы читать мысли людей.")
	await novel_interface.show_text_only("Глядя на фотографию, я чувствую, как сильно бьется мое сердце, а тело начинает неудержимо дрожать.")
	await novel_interface.show_text_only("Затем у меня восстанавливается дыхание, и все это в одно мгновение. Ая занята стетоскопом и, кажется, не замечает происходящего.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(Что случилось?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я чувствую, что… даже по фотографии в Raphael есть что-то, что резонирует с инструментом.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Почему…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Бип-бип-")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Что это за шум?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кривая на экране резко колеблется.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Ой, а почему вдруг все зашкалило?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Застал ли я Рена за просмотром чего-то с рейтингом X…?", "Ai")
	await novel_interface.show_dialog("Я забыл, что ты подросток!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Нет, это не так!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Странное ощущение резонанса исчезает.")
	await novel_interface.show_text_only("Это прерывает Ая?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Что это за колеблющийся параметр?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Это... секрет!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Забудь об этом.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Извините. Можно мне войти?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix быстрым шагом входит в медицинский центр.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Привет, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Привет, Рен. Я не ожидал встретить тебя здесь.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix поворачивается к прибору с озадаченным видом, словно пытаясь понять, что я делаю.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("Что это...?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она указывает на голубоватое четырехконтактное устройство в руке Аи.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("О, это для экспериментов на людях.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Что? Ты только что сказал это прямо?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ох…", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("О, госпожа Айя, я не очень хорошо себя чувствую. Могу ли я отдохнуть здесь?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix потрясающий. Как она могла продолжать улыбаться, не комментируя удивительный ответ Аи?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Нет проблем, ты можешь использовать эту кровать. \\nЧтобы закончить то, что я делаю, потребуется еще 15 минут.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая снимает экран с прибора и выходит из комнаты, чтобы загрузить данные.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Спасибо.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix кивает Ае и ложится на кровать рядом со мной.")
	await novel_interface.show_text_only("Кровать находится всего в руке. Nix не закрывает занавес.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(Она просто ложится вот так перед незнакомцем?) \\n(Ааа, да, мы все девочки…)", "Lian")
	await novel_interface.show_dialog("(Черт побери. Мое сердце бьется быстро.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я украдкой оборачиваюсь, глядя на нее. То, как она заправляет волосы за ухо, очень изящно.")
	await novel_interface.show_text_only("Мы так близко. Я даже чувствую ее слабый аромат…")
	await novel_interface.show_text_only("Пока я предаюсь мечтательным мыслям, Nix поворачивается и смотрит прямо на меня.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Что случилось?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("О! Ааа... \\nЭээ...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я вдруг прихожу в себя и чувствую себя ребенком, которого поймали на розыгрыше.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("Что мне делать? Должен ли я что-то сказать?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Нет, подожди ... )", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("Я не нервничаю и не стесняюсь… Это…")
	await novel_interface.show_text_only("Я чувствую там жжение…")
	await novel_interface.show_text_only("Это... похожее чувство, когда я увидел фотографию Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Черт, я настолько настойчив, что любая девушка меня возбуждает?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ты выглядишь бледным. Вы хорошо себя чувствуете?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да… Хорошо, я думаю.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("О, кто это?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix смотрит на мой мобильный телефон. \\nОна поднимает брови, глядя на фотографию на экране.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("Вы ее знаете?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Нет, я не знаю.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Но Nix выглядит с отвращением...) \\n(Возможно, я ошибаюсь.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
