# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("I leave the Headquarters with the booklet carrying all the details of the jet-set girl. Mariru also texts me photos of her.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Born into one of Salmonton's noble families, Raphael is the granddaughter of Dr. Thomas Dekkers, president of Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Wow… I've read about him in textbooks! \\nThis is getting a little crazy…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Caught ya! Hello sweetheart!")
	await novel_interface.show_text_only("Someone hugs me from behind.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Waaah—!", "Lian")
	await novel_interface.show_dialog("… Aya, it's you! What the heck are you doing?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I have to undergo a full physical examination and treatment by Aya every time I return from a Flux Area.")
	await novel_interface.show_text_only("I hate to admit it, but Aya's octopus-shaped instrument is quite helpful in healing wounds.")
	await novel_interface.show_text_only("And I hate it that I am getting used to Aya's psychopathic actions…")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Why do you look so disappointed? \\nI'm starting to feel hurt.", "Ai")
	await novel_interface.show_dialog("I haven't taken good care of you since you came back from the Substation…", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("So I'm gonna take you to school… \\nAnd give you some unforgettable lessons.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("What? Wait…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Take your hands off me! It's in broad daylight!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("The pervert Mariru reminded me to watch out for… \\nMust be Aya!")
	await novel_interface.show_text_only("Aya drags me to the health center. I can do nothing but lie on the bed.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Just a physical examination… You're being overly dramatic.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("You look disappointed. Prefer a special treatment, huh?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, thanks. \\nJust the regular checkup, please.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(And your routine is special enough!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya takes out the strange instrument as usual. The imager is once again flashing with incomprehensible images.")
	await novel_interface.show_text_only("To kill time, I take out my cellphone and continue to read about Raphael.")
	await novel_interface.show_text_only("She has long and dark gray hair. Her eyes are purple and sharp, as if ready to read people’s mind.")
	await novel_interface.show_text_only("Looking at the photo, I feel my heart beating violently, and my body starts trembling uncontrollably.")
	await novel_interface.show_text_only("Then I get my breath back, all in an instant. Aya is occupied by the stethoscope and doesn't seem to have noticed what's happening.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(What's wrong?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I feel that… even through the photo, there's something in Raphael that resonates with the instrument.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Why…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beep— beep—")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("What's that noise?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The curve on the screen is fluctuating sharply.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Oops, why does it go wild all of a sudden?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Have I caught Ren checking out something X-rated…?", "Ai")
	await novel_interface.show_dialog("I forgot you're a teenage boy!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("No, it's not!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The strange feeling of resonance disappears.")
	await novel_interface.show_text_only("Is it interrupted by Aya?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("What's that fluctuating parameter?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("That's… a secret!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Forget it.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Excuse me. May I come in?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix walks into the health center briskly.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Hey, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Hey, Ren. I didn't expect to meet you here.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix turns to the instrument, looking puzzled, as if trying to figure out what I'm doing.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("What's this…?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("She points to the bluish four-pronged device in Aya's hand.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, it's for human experiments.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("What? Did you just say that straight out?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Oh…", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, Ms Aya, I'm not feeling very well. Can I have a rest here?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix is awesome. How could she keep smiling without commenting on Aya's astonishing reply?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("No problem, you can use that bed. \\nIt will take another 15 minutes to finish what I'm doing.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya takes the screen off the instrument and leaves the room to upload data.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Thanks.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix nods to Aya and lies down on the bed next to me.")
	await novel_interface.show_text_only("The bed is only an arm away. Nix doesn't close the curtain.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(She just lies down like this in front of a stranger?) \\n(Ahh yeah, we're all girls…)", "Lian")
	await novel_interface.show_dialog("(Darn it. My heart is beating fast.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I turn around stealthily, peeping at her. The way she tucks her hair behind her ear is so graceful.")
	await novel_interface.show_text_only("We're so close. I can even smell the faint fragrance on her…")
	await novel_interface.show_text_only("As I indulge myself in dreamy thoughts, Nix turns and looks straight at me.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("What's up?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh! Ahh… \\nUh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I suddenly come to my senses and feel like a child who got caught playing a prank.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("What should I do? Should I say something?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(No, wait...)", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("I'm not feeling nervous or shy… It is…")
	await novel_interface.show_text_only("I feel a burning sensation down there…")
	await novel_interface.show_text_only("It's… a similar feeling when I saw the photo of Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Crap, am I so hard up to the point that any girl makes me horny?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You look pale. Are you feeling well?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah… All right, I think.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Oh, who's that?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix is staring at my cellphone. \\nShe raises her eyebrows at the photo on the screen.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("Do you know her?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("No, I don’t.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(But Nix looks disgusted…) \\n(Maybe I've got her wrong.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
