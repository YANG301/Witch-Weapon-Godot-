# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Seit der Veröffentlichung der Fahndungsanzeige sind einige Tage vergangen.")
	await novel_interface.show_text_only("Wie von Mariru vorhergesagt, scheint der Vorfall keine Auswirkungen auf das tägliche Leben der Menschen zu haben.")
	await novel_interface.show_text_only("Auch von der Ablenkungstechnik von Mariru ist kaum etwas zu spüren.")
	await novel_interface.show_text_only("Es fühlt sich wie ein Albtraum an.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Guten Morgen, Schwester Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Hexe mit besonderen Fähigkeiten wird Elluka von SID genau beobachtet.")
	await novel_interface.show_text_only("Aber das Kind scheint an mir zu hängen. Mariru schickt sie jeden Tag zu mir und behauptet, sie sei nur nett.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Guten Morgen, Elluka. \\nMöchten Sie etwas zwischen den Mahlzeiten essen?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hey! Geben Sie Kindern nicht zu viele Snacks!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Das ist in Ordnung. Das sind kaum zu viele.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Oh, komm schon, das sagst du immer.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Und ist es in Ordnung, dass sie den ganzen Tag bei uns bleibt?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Äh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Kinder in ihrem Alter sollten zur Schule gehen. \\nNicht wahr?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Ähm, sie ist nicht nur ein Kind, denke ich.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Klar, aber ich mache mir trotzdem ein bisschen Sorgen …", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Es ist alles deine Schuld. Wenn du sie weiter fütterst, mache ich mir langsam Sorgen um ihr Gewicht!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, schlecht.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka starrt Annie mit verletztem Blick an. Und Annie macht ein trauriges Gesicht.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Jetzt weiß ich, wie es sich anfühlt, eine strenge Mutter zu sein ...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Alles klar. Sei nicht so hart.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Hier, Elluka, heute ein letztes Stück Schokolade. Nicht mehr. \\nAls nächstes bringe ich dich zu meiner Schule.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka darf sich nur gemäß Mariru frei zwischen unserer Wohnung und der Schule bewegen.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ach...", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Trotzdem traurig.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich streichle ihren Kopf und bringe sie zusammen mit Annie zur Schule.")
	await novel_interface.show_text_only("Hmm, was für ein schöner Tag. Nicht zu heiß, nicht zu kalt.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Fühl dich nicht schlecht, Schatz.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka hebt plötzlich den Kopf und schaut mir in die Augen, Schokolade auf den Lippen.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Schwester Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Oh bitte, sieh mich nicht so an!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka geht auf Zehenspitzen, um meine Hand zu ergreifen und legt sie auf ihren Kopf.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Schon wieder.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Ist das eine Charmeoffensive!? \\nOh nein, dem kann kein Mensch widerstehen!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, du magst Lolita, oder?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Hehe, das denke ich.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich höre die Stimme von Nix hinter mir.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wie konnte sie ohne Lärm in unsere Nähe kommen?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Entschuldigung, habe ich dich erschreckt?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nein, nur... \\nDas ist in Ordnung.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich schäme mich bei dem Gedanken, dabei erwischt zu werden, wie ich dumm auf Elluka starre.")
	await novel_interface.show_text_only("Und ich bin erleichtert, dass Nix dieses Thema nicht fortsetzt. Sie ist so schön und elegant!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Ihr Name ist Elluka, oder?", "Nix")
	await novel_interface.show_dialog("Wenn du Nachtisch magst, kaufe ich dir das nächste Mal einen Biskuitkuchen, okay?", "Nix")
	await novel_interface.show_dialog("Ich kenne eine tolle Bäckerei in der Theater Street. Es gibt wirklich guten Ahornsirup, der fast nach Karamell schmeckt.", "Nix")
	await novel_interface.show_dialog("Und Sie werden die charakteristische Schokoladencreme im Kuchen lieben.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka denkt eine Weile nach und nickt, da sie der Versuchung des Essens nicht widerstehen kann.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, du nimmst kein Essen von Fremden an!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Es ist okay. Nix ist sowieso unser Senior.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Ja, aber...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Liegt es nur an mir?")
	await novel_interface.show_text_only("Es scheint, dass Annie seit ihrem ersten Treffen misstrauisch gegenüber Nix war.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Dann ist es ein Deal, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Deal!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich klingelt mein Telefon. \\nEs ist Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Hallo?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ugh, nicht schon wieder eine Mission!) \\n(Ehrlich gesagt, es kommt nicht jeden Tag vor, dass ich Elluka rausnehme!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
