# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("距離通緝令事件已經過了幾天。")
	await novel_interface.show_text_only("果然如莉琉所言，在一般民眾的生活裡，這件事並沒有掀起什麼波瀾。")
	await novel_interface.show_text_only("就連莉琉所說發佈不實訊息的作法，對現實生活也幾乎毫無影響。")
	await novel_interface.show_text_only("整件事宛如一場惡夢。")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("小憐姊姊，早安。", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("由於伊露卡的魔女身分和特殊能力，SID不得不對她進行收容控管。")
	await novel_interface.show_text_only("但這個小傢伙對我似乎產生了依賴感，莉琉也順勢自稱日行一善地將她送到我這來。")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("早安，伊露卡。 \\n今天想吃什麼好吃的呢？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("喂！ 小孩子不能吃太多零食！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("嗚……", "伊露卡")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("沒關係，偶爾吃一點嘛～", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("妳的「偶爾」也太頻繁了吧！", "安妮")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("而且伊露卡一直和我們待在一起，真的沒關係嗎？", "安妮")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("她還是個小孩子吧……\\n這個年齡不是應該去上學嗎？", "安妮")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……大概不能用普通小孩的模式來定義伊露卡吧？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("話是這麼說，但還是有點擔心……", "安妮")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("都怪小憐啦，總是亂餵她，我都開始擔心她的成長問題了呢！", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("安妮，壞！", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡委屈地看著安妮，安妮被那道目光擊中，露出了慘不忍睹的表情。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("我好像，突然明白了被孩子討厭的媽媽的心情……", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("好啦，別這麼嚴厲嘛。", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("喏，伊露卡，今天只能再吃一塊巧克力了哦～\\n等等我們帶妳去學校繞繞。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("根據莉琉的要求，我們只能在包括公寓和學校在內的一小塊範圍內帶著伊露卡自由活動。")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("哦……", "伊露卡")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("……還是，難過。", "伊露卡")
	novel_interface.character_dark()
	await novel_interface.show_text_only("我輕輕地摸了摸伊露卡的頭，和安妮一起帶著伊露卡來到了學校。")
	await novel_interface.show_text_only("嗯～今天天氣不錯，微風拂過也不會覺得太熱。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("要乖哦，別難過啦。", "小憐")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("伊露卡突然抬起頭，連嘴角沾上的巧克力都沒有來得及舔掉，認真地望著我。")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("小憐姊姊……", "伊露卡")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("（哇，別用這種眼神看著我啊！ ）", "小憐")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("伊露卡踮起腳尖，抓住我的手又放回了她的頭上。")
	novel_interface.character_light()
	await novel_interface.show_dialog("再摸摸。", "伊露卡")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("這、這是蘿莉向我發起的攻擊嗎！ ？\\n報告指揮部，我今天要死在這裡了！ ！")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("還真是個無可救藥的笨蛋蘿莉控啊。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("嘿嘿，我也這麼認為呢。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯學姐的聲音從我身後傳來。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("倪克斯學姐？ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她是怎麼無聲無息地出現在我們身後的……")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("抱歉，嚇到妳了嗎？", "倪克斯")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不、只是……\\n沒有啦！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("想到被學姐看到自己對著伊露卡犯傻的樣子，一股巨大的羞恥感湧了出來！")
	await novel_interface.show_text_only("幸好她沒有窮追猛打地捉弄我，跟優雅大方的人相處真好啊～")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("妳是叫伊露卡，對嗎？", "倪克斯")
	await novel_interface.show_dialog("如果伊露卡喜歡甜點的話，下次帶妳去吃海綿蛋糕怎麼樣？", "倪克斯")
	await novel_interface.show_dialog("劇院街有一家店，她們特製的楓糖漿非常香醇，會有一點焦糖的味道。", "倪克斯")
	await novel_interface.show_dialog("蛋糕的內餡還有店長特製的巧克力奶油，妳一定會喜歡的。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("伊露卡認真地思考了一會兒，終究無法抵抗食物的引誘，乖巧地點了點頭。")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("伊露卡，小孩子不能隨便接受陌生人的食物哦！", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("有什麼關係嘛，這是學姐欸。", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("唔，雖然是這樣啦……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("是我的錯覺嗎？")
	await novel_interface.show_text_only("從第一次見面起，安妮似乎就對倪克斯抱有微妙的警覺心。")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("那就說定了哦，伊露卡。", "倪克斯")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("嗯！", "伊露卡")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我的手機忽然響了起來，\\n——是莉琉小姐的來電。")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("……喂？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（又有什麼任務給我嗎？ ）\\n（真是的，難得有空帶伊露卡出來逛逛……）", "小憐")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
