# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Smite \\nElluka’s Administrator…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Behind him, I see several security soldiers lying on the floor.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("They just passed out. Killing in the demilitarized zone is not in my plan.", "Jacob")
	await novel_interface.show_dialog("I intended to take back pages of the cult classic Book of Seven Philosophers, and didn't expect such a bonus…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Book of Seven Philosophers…) \\n(Is this the Grimoire linked to the Golden Butterfly?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren… I found a lot of old wounds on Elluka's body when I helped her to get washed.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(You washed Elluka?) \\n(When!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(No, that's not the point.) \\n(Old wounds… That means…!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("No ordinary child could endure such traumatic experience!", "Annie")
	await novel_interface.show_dialog("It has to be this guy... this is the one!!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oh— \\nSeems that thing hasn't broken yet.", "Jacob")
	await novel_interface.show_dialog("Tut-tut, I guess SID has already reverse engineered… \\nThe technology I used on it.", "Jacob")
	await novel_interface.show_dialog("Had I known it would cause so much trouble, I would have installed a self-destruct device on it.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("You—!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Asshole!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The next thing I know, Annie bounces up furiously and tries to kick Jacob in the face.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Squeak—")
	await novel_interface.show_text_only("With a shriek, the room is lightened by a huge electric arc. For a moment, I'm blinded.")
	await novel_interface.show_text_only("It takes seconds for the glare to disappear. A stinging pain lingers in my eyes.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie…!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie loses her consciousness and falls on the ground. A strip of branch-shaped burning marks appears on her skin.")
	await novel_interface.show_text_only("The soldier next to Jacob is holding a smoking gun…  Is that the weapon they used just now?")
	await novel_interface.show_text_only("The soldier quickly unloads a battery-like bullet the size of a canister.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("We know how to make the best out of witches…", "Jacob")
	await novel_interface.show_dialog("I prefer to catch them alive. But the SID bitch is coming soon…", "Jacob")
	await novel_interface.show_dialog("Now that we're running out of time…", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob takes out a pie-shaped piece of metal. The grayish-green shell gives off a familiar light blue radiance.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Is that… a Substance H weapon?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("I feel… the flow of magic power…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("What the hell are you up to? This is demilitarized zone!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Ren)", "Mariru")
	await novel_interface.show_text_only("Mariru's voice suddenly comes from the earphones.")
	await novel_interface.show_dialog("(That's a booby trap made of self-binding fibers.) \\n(It's a non-lethal Substance H weapon.)", "Mariru")
	await novel_interface.show_dialog("(It explodes three seconds after detonation.) \\n(And the fibers will spread all over the place. It's impossible to escape.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(So, save your strength for the moment.) \\n(I'll figure out how to get you out…)", "Mariru")
	await novel_interface.show_text_only("Jacob slowly raises the booby trap in his right hand. Golden lines appear on his palm, as if ready for a fight.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("His hand… is that magic inscription?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Finally… My turn to experience the Substance H weapon…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Sorry for this…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice suddenly grabs me with one hand and snatches the necklace from Raphael with the other.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("What?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All of a sudden, the emerald pendant emits a glaring beam and turns into a mighty sword with inscriptions on the blade.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Look at these wretched souls imploring to clear their sin—", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("What…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Shut up!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice shoves the sword heavily into the floor.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob opens his mouth, but nothing comes out. \\nThe room is filled with a deadly silence.")
	await novel_interface.show_text_only("The floor beneath Jacob cracks, revealing nothing but thorough darkness.")
	await novel_interface.show_text_only("There comes a creepy sound from the depth of the darkness, as if millions of people are mourning and howling from hell.")
	await novel_interface.show_text_only("Dark smoke spouts out from the crack and takes over every corner of the room, now shrouded in hellish darkness in no time.")
	await novel_interface.show_text_only("Struck by a chill to my bones and a deep sense of terror, my hair stands on end and I cannot move…")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("But just seconds later, the darkness is dissipated. \\nAnd the crack is nowhere to be found.")
	await novel_interface.show_text_only("As if suffering from a panic attack, Jacob falls to the floor and madly scratches his neck so hard that it bleeds.")
	await novel_interface.show_text_only("His face turns red as he struggles to breathe. But his lungs seem to be vacuumed of air, leaving him gasping nosily in vain.")
	await novel_interface.show_text_only("It takes a while before he regains a faint breath.")
	await novel_interface.show_text_only("The tall, well-built man curls up on the carpet, trembling, his arms crossed over his chest.")
	await novel_interface.show_text_only("His bloodshot eyes are full of fear. Tears come out as a result of decompression.")
	await novel_interface.show_text_only("The lines on his hand have completely disappeared, and the booby trap fallen on the carpet has also lost its luster.")
	await novel_interface.show_text_only("The masked soldiers are all standing still, trembling.")
	await novel_interface.show_text_only("From their blank faces, they seem to be seized by the horror of seeing a reality beyond any description.")
	await novel_interface.show_text_only("If you gaze long into an abyss, the abyss also gazes into you…")
	await novel_interface.show_text_only("In the face of real horror, even breathing…")
	await novel_interface.show_text_only("Makes you feel exposed to an indescribable desperation.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Let's go!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Ren, get out of there!)", "Mariru")
	await novel_interface.show_text_only("Not until now have I come to my senses. With a nod at Beatrice, I leave the room with Annie in my arms.")
	await novel_interface.show_text_only("Beatrice drags Raphael, who is still in a daze. We dash to the elevator…")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
