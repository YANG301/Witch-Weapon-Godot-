# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru renvoie Annie et Elluka juste au moment où nous retournons au quartier général.")
	await novel_interface.show_text_only("Maintenant, je suis contrarié. Je ne sais pas si je serais à nouveau interrogé avec des questions étranges…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("Que s'est-il passé ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Et si rien ne se passait ? Vas-tu continuer à sourire à Elluka comme un pervers ?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous… Vous avez dû me surveiller à travers la caméra de surveillance !", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Héhé, c'est tout ce à quoi tu penses ?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Qu'est-ce que ça pourrait être d'autre...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Par exemple—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru me regarde méchamment de la tête aux pieds.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Le Département de Recherche a développé une plaquette qui peut même décider quand vous allez aux toilettes !", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("Quoi… salle de bain ? \\nEuh, ça a l'air dégoûtant !", "Lian")
	await novel_interface.show_dialog("Cela doit être inventé par Aya ! \\nAttendez, ne me dites pas que vous l'avez secrètement implanté dans mon corps !", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je plaisantais.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La façon dont tu le dis n’a rien d’une blague !")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ou… Y a-t-il quelque chose d’étrange qui vous traverse l’esprit ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Ugh, bon sang…", "Lian")
	await novel_interface.show_dialog("(La dernière fois que j'ai couru pendant l'assemblée de l'école…) \\n(Est-ce que ça veut dire… ?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hahahaha ! Ne le prenez pas au sérieux !", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru éclate de rire en me frottant la tête avec force.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya n'a fait qu'un prototype avant que j'annule le projet. \\nPourquoi l'utiliserions-nous sur quelqu'un comme vous !", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Oh, devrais-je dire merci ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha, tu as de la crasse en tête, n'est-ce pas ?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh… Dieu merci, il n'y a pas de machine à lire dans les pensées ! Imaginez à quel point ce serait honteux !")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Hé, ne te fais pas de soucis. C'est tellement amusant de te voir riposter.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Désolé de vous avoir laissé tomber.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm… Je me demande comment un simplet comme vous pourrait extraire des informations de cibles clés.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru essuie ses larmes de rire et affiche son visage arrogant habituel.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Cibles clés… Cela semble plus significatif que de s'occuper de vous… Mais pourquoi M. Big parlerait-il à un lycéen !", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cette fois, vous approcherez votre cible en tant qu'étudiant. La cible…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, petite-fille du maire de Salmonton. Elle viendra avec la délégation Salmonton.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("C'est une vraie fille de haute naissance. Excité?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Pourquoi devrais-je être excité ?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu n'aimes que les petites filles, hein ?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Hé, arrête de me décrire comme un criminel !", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Hum. \\nQuoi qu'il en soit, que veux-tu que je reçoive de cette fille bien née ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh, vous n'êtes pas très bavard… \\nJ'espère que vous pourrez passer au moins une journée.", "Mariru")
	await novel_interface.show_dialog("D'accord, sérieusement, que savez-vous de Salmonton ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Euh… je suppose que c'est le plus grand exportateur de produits alimentaires ?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("En parlant de Salmonton… ce qui me vient à l’esprit, ce sont les dizaines de serres de grande hauteur qui bordent le Rhin.")
	await novel_interface.show_text_only("Les jardins verdoyants derrière les serres… \\nContient toujours des papiers peints parfaits.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Et il y a beaucoup d'églises. Tous les citoyens ont une croyance religieuse. Ils ont même formé une Alliance Sacrée…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est tout ce dont je me souviens. Je ne suis pas bon en géographie. Trop de mémorisation de faits aléatoires.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Le pouvoir économique et politique de Salmonton dépend en grande partie de son contrôle sur les gènes des cultures.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Mais les incidents survenus après la disparition du Ross Goblet ont constitué de graves menaces pour eux.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Par menaces, vous voulez dire… le flux spatio-temporel ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("C'est vrai. Selon mes informations, il a souffert de multiples flux. Mais les dégâts sont encore inconnus.", "Mariru")
	await novel_interface.show_dialog("À en juger par la récente volatilité des prix à terme des céréales, l’impact semble assez important… Peut-être que des famines sporadiques surviendront.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est grave !", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Je ne connais rien au marché à terme. Je pensais que l'impact était limité à une petite zone.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Ouais… Les mauvaises récoltes ne causeront pas de dommages immédiats. Les pays disposent de toute façon de réserves de risque.", "Mariru")
	await novel_interface.show_dialog("Il semble que Salmonton soit la première à s'effondrer, parmi toutes les villes universitaires.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Elle a envoyé une délégation à New Opulentia, qui est déjà en route.", "Mariru")
	await novel_interface.show_dialog("En tant que principal importateur de produits alimentaires, nous ne pouvons pas dire non.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vont-ils… soupçonner Annie et moi ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("C'est ce que vous allez faire.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Bien qu'elle s'inscrive dans le cadre d'un programme d'\"échange culturel\", la délégation est sous étroite protection de la part du Royal Security Service.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Le Royal Security Service… L'agence de renseignement de Salmonton, également connue sous le nom de Rosenkreutz.")
	await novel_interface.show_text_only("Pour un service de renseignement, c'est trop célèbre grâce aux films Agent n°7.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cela va-t-il causer des problèmes ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Bien sûr. SID a même des difficultés à collecter des informations de base.", "Mariru")
	await novel_interface.show_dialog("Pour l'instant, ce qui vous intéresse, c'est que la jeune fille fréquente le lycée pour filles de Gosakuragawa.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mon école ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Il faut s'y attendre. Elle a à peu près l’âge d’une lycéenne.", "Mariru")
	await novel_interface.show_dialog("Ce que vous devez donc faire, c’est découvrir le véritable objectif de leur visite.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Les services de renseignement ont réalisé une brochure sur Salmonton et la famille Dekkers. Maintenant, allez-y et lisez-le.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Oups, encore une tâche de mémorisation… \\nJe m'en occupe !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Au fait, faites attention au pervers sur le chemin du retour.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("W-Quoi !?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
