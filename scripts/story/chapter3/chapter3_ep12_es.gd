# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("El Aerogel Spray es un arma similar a la laca inventada por el Dr. Aya. Produce grandes cantidades de espuma en una fracción de segundo.")
	await novel_interface.show_text_only("Una vez en el aire, la espuma se inflará y solidificará rápidamente, volviéndose tan dura que es impenetrable incluso para las balas.")
	await novel_interface.show_text_only("Mientras Annie sella la puerta con aerogel, nuevamente me siento atraído por la mariposa dorada en el suelo.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Parece una obra de arte preciosa…)", "Lian")
	await novel_interface.show_dialog("(Pero ... no puedo evitarlo ... tengo muchas ganas de tocarlo ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un impulso ardiente me atrapa y todo lo que tengo delante emite un brillo deslumbrante. No puedo evitar acercarme")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("¡¡Para!! ¡¡Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me agarra la muñeca. Entonces, de repente vuelvo en mí.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Quizás esta cosa pueda invadir la mente de las personas… ¿Será por eso que tienen que guardarla en esa maleta?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("¡Ah! Casi ... qué diablos ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Esta mariposa dorada me resulta familiar... \\nSospecho que se trata de un fragmento de bruja.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿El fragmento de una bruja?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Mmmm, ¿cómo debería decirlo...?", "Annie")
	await novel_interface.show_dialog("El poder mágico es en realidad un tipo de conocimiento que el cerebro humano absorbe de un tipo único de \"información\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Pero la gente obtiene y asegura este conocimiento normalmente a costa de su cordura.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Me vienen a la mente las brujas en la Subestación y los enemigos en las áreas de flujo.")
	await novel_interface.show_text_only("Su locura debe ser causada por la acumulación excesiva de \"conocimiento\" que su cuerpo no puede soportar.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("En realidad, la \"información\" se puede dividir en partes y almacenar por separado. A Witch's Shard es un contenedor de pequeñas piezas de \"información\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("En cuanto al motivo de este diseño, supongo que está creado para que los humanos superen sus límites...", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Para descubrir hasta qué punto pueden salirse con la suya sin perder la cordura, ¿utilizan Witch's Shards para absorber el conocimiento poco a poco?", "Lian")
	await novel_interface.show_text_only("¡El acto en sí suena bastante loco!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Seguir anhelando y persiguiendo nuevos conocimientos sin fin; en todo caso, esa es la naturaleza humana ...", "Annie")
	await novel_interface.show_dialog("Incluso si están condenados a la destrucción ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué pasa si una chica común y corriente obtiene el fragmento de bruja, pero no tiene la habilidad de usarlo? ¿Se convertirá en una de las brujas que conocimos en la subestación?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Muy probable. Y no hay ningún escudo alrededor del Witch's Shard, por lo que cualquiera puede tocarlo directamente.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("¿No es súper peligroso entonces?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—¡Auge! \\n—¡Auge!")
	await novel_interface.show_text_only("Fuera de la habitación se oyen sonidos bajos y profundos de fuertes martillazos en la puerta de madera.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("¡Los soldados de seguridad!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—¡¡Crack!! \\nDespués de sólo dos golpes, la puerta de la Suite Real es destrozada por un interruptor de puerta.")
	await novel_interface.show_text_only("—¡Golpe! -¡Golpear! -¡Golpear! \\n—¡Golpe! -¡Golpear! -¡Golpear!")
	await novel_interface.show_text_only("Luego se oyen los ruidos de los rompedores de puertas que golpean en vano la sólida espuma del aerogel.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tal vez podría aguantar hasta que llegue la Sra. Mariru... \\nMira, ¡el invento de la Dra. Aya funciona!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me toco el pecho, donde Mariru tiene plantado el altavoz sin mi conocimiento.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ajá... \\nSí, funciona...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, Raphael ya despierta, se lanza hacia mí, con la silla todavía atada a su cuerpo.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("¡Nunca… te quitarás nada!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¡¡Pervertido montado en el altavoz!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se libera cuando la silla cae al suelo. Luego se apresura a agarrar la mariposa dorada.")
	await novel_interface.show_text_only("Al ver esto, me lanzo hacia la mariposa, casi a punto de chocar contra ella.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("¡¡No Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡Explosión!")
	await novel_interface.show_dialog("(¿Eh? ¿Lo entendí?) \\n(Ups...)", "Lian")
	await novel_interface.show_dialog("(Lo suave es…)", "Lian")
	await novel_interface.show_dialog("(Se siente familiar. Acabo de tocarlo)", "Lian")
	await novel_interface.show_dialog("(Espera. ¡Podría ser…!)", "Lian")
	await novel_interface.show_dialog("… ¡Tú!", "Raphael")
	await novel_interface.show_dialog("Pervertido!!!", "Raphael")
	await novel_interface.show_text_only("—¡Bofetada!")
	await novel_interface.show_text_only("La bofetada resonante me marea.")
	await novel_interface.show_text_only("Imágenes visuales pasan por mi mente, todo se silenció en un instante.")
	await novel_interface.show_text_only("Me siento como en otro mundo. La extraña sensación desaparece en un abrir y cerrar de ojos.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Cuando abro los ojos, me encuentro todavía en la Suite Real.")
	await novel_interface.show_text_only("El accesorio dorado cobra vida y aterriza en mi pecho, irradiando una luz brillante.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("¿Cómo sería esto…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando la luz se vuelve más tenue y desaparece gradualmente, siento que me acarician suavemente la cara. Ese toque suave y mágico está grabado en mi mente.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("—¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el espacio abierto de esta sala aparece una hermosa mujer.")
	await novel_interface.show_text_only("Mis ojos están fijos en sus ojos y cabello rojo claro, su cuerpo delgado y su piel de jade.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… ¿Qué pasó?) \\n(¡Algo tocó mis labios!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Jajaja, ¡nada!) \\n(¿En qué estaba pensando? ¡Es imposible!)", "Lian")
	await novel_interface.show_dialog("(¡¡No… no es imposible!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Mierda, el sentimiento… El sentimiento…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, el calor perdido hace mucho tiempo del cuerpo humano.", "Mujer inesperada")
	await novel_interface.show_dialog("¡Buenas noches, señoritas!", "Mujer inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi corazón late más rápido. No puedo evitar caminar hacia ella. Mis miembros ya no son míos.")
	await novel_interface.show_text_only("Extiendo mis brazos y la envuelvo con fuerza, a la vista de todos.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Hola cariño. No te sientes bien, ¿verdad…?", "Mujer inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Disculpe…", "Lian")
	await novel_interface.show_dialog("¿Puedo saber tu nombre por favor...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es raro. Su cuerpo parece volverse más y más pesado... \\nY su temperatura aumenta...")
	await novel_interface.show_text_only("¡¡Qué me pasa!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… ¡Ooh la la! \\nEsto es tan increíble.", "Mujer inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—¡¡Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me aleja de la mujer.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¿Quién... eres tú?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Si mi nombre no es un tabú en tu época… Por favor llámame Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Que hermoso nombre….", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren... \\n¡Empiezas a parecer un perro caliente!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
