# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("SID records show that the Akatraz Center collects the EX-class Substance H that is prohibited by the United Congress to be tested and researched.")
	await novel_interface.show_text_only("Under the Center's ground, it's connected to the entrance to an ancient relic Chate Cave-house that's prohibited from entering and can't even be rated.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX-class Substance H… Is it some kind of highly hazardous stuff?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Most of them are sacred items of religious significance. As they're special to religious followers, they can be collected, but research is prohibited.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sound like self-deception.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Hah, I felt the same way. \\nBut, it makes sense in a way.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Some artifacts in religious lore are said to possess god-slaying power, or to trigger the Last Judgment,", "Mariru")
	await novel_interface.show_dialog("Once activated, they could cause an apocalyptic-scale catastrophe.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's bad.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Although some items revered in religious stories later turned out to be weak—or even embarrassingly ineffective...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Something silly?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Right, one example is this pair of holy shoes. Whoever kisses the tip of the shoe can't resist to streak—what a shame for the religion.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That’s disgusting. \\nSo. which type does this missing one belong to?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("It's the Destiny Spear—an EX-class Substance H under the joint custodianship of all academy cities.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh. \\nI see, sounds cool.", "Lian")
	await novel_interface.show_dialog("What exactly is the Destiny Spear then?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("You look like a complete idiot right now.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Hey, I really have no idea! \\nI'm just a high school student.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru looks at me helplessly, as if wondering where to even begin with me.")
	novel_interface.character_light()
	await novel_interface.show_dialog("In a nutshell, it's the first type of Substance H, which is believed to have deicidal powers.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Very little description of the Destiny Spear is found in publicly available literature, except that it “does not melt in high temperature\" and that it “gains weight when swung”.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("That’s it?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If you dig deeper, you will find either trait will make it an XK-class Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("There may be some other dangerous, unknown traits. That’s why they should not draw too much media attention.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("This gives me goosebumps. Even little kids know what an XK-class Substance H is…")
	await novel_interface.show_text_only("It would either lead to a doomsday disaster or create another Substance H with the same power. Currently, there're only six known items of this kind in the whole world.")
	await novel_interface.show_text_only("Each of them belongs to one of the six Academy Cities. More precisely, only those in possession of such Substance H are recognized by United Congress.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Huh? \\nWhich means...?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Now you know what a serious crime “you” have committed?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I'm so shocked to the point that everything seems surreal to me.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Sorry. \\nNo! Why did I say sorry? I'm not the burglar!", "Lian")
	await novel_interface.show_dialog("(Crap. That guy must be super dangerous!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("But luckily the news was removed.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("They did it just to avoid public panic.\\nInvestigation would still go on, secretly.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("For confidentiality reasons, the wanted notice won't be issued to the Defense Ministry. But all the intelligence services, including SID, must have been notified already.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("So it's still early to feel relieved, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Right… the old me is still in danger, right?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("What if… I mean what if… \\n…someone does track me down…", "Lian")
	await novel_interface.show_dialog("Even if I'm now a girl, I could probably be locked up, right?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You finally got it.", "Mariru")
	await novel_interface.show_dialog("The intelligence service has checked all available CCTV footages, and found the guy showed up in some other Flux Areas, still with your old face.", "Mariru")
	await novel_interface.show_dialog("Since we can retrieve the data from a third-party source, other intelligence services probably have this information already as well.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("A repeat offender already? \\nMy future looks bleak...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("I picture myself tortured in endless interrogations…")
	await novel_interface.show_text_only("I feel like I'll be arrested anytime and labeled as a criminal against humanity.")
	await novel_interface.show_text_only("Got locked up in the most brutal prison, sentenced to over 200 years in jail.")
	await novel_interface.show_text_only("I might have an extremely dangerous cellmate, and he …")
	await novel_interface.show_text_only("Waah, stop it! \\nNo more thinking!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hahaha. You're so frightened and look so pale.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Take it easy, Ren. I can assure you 98% safety as long as you are in New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("So I still got a 2% chance of getting busted?", "Lian")
	await novel_interface.show_dialog("(Two seconds of uncertainty out of every hundred seconds!) \\n(That’s not safe at all!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That those old dogs in the United Congress reached consensus in such a short notice… Something isn’t right.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("And this, is the 2% unknown factor I was talking about.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("I can't imagine what a stir it has caused among those big shots…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So, the intelligence services of other Academy Cities must have used lots of resources to hunt the burglar.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W… what should I do?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("A visible enemy is always easy to deal with. Let's leave it to SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
