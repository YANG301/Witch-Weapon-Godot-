# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Das Aerogel-Spray ist eine haarsprayähnliche Waffe, die von Dr. Aya erfunden wurde. Es erzeugt im Bruchteil einer Sekunde große Mengen Schaum.")
	await novel_interface.show_text_only("In der Luft bläht sich der Schaum schnell auf, verfestigt sich und wird so hart, dass selbst Kugeln ihn nicht durchdringen können.")
	await novel_interface.show_text_only("Als Annie die Tür mit Aerogel versiegelt, werde ich erneut von dem goldenen Schmetterling auf dem Boden angezogen.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Es scheint einfach ein wunderschönes Kunstwerk zu sein…)", "Lian")
	await novel_interface.show_dialog("(Aber ... Ich kann nicht anders ... Ich möchte es wirklich anfassen ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein brennender Drang erfasst mich und alles vor mir erstrahlt in einem blendenden Glanz. Ich kann nicht anders, als Kontakt aufzunehmen –")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Stopp!! Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie packt mein Handgelenk. Dann komme ich plötzlich zu mir.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Vielleicht kann dieses Ding in die Gedanken der Leute eindringen ... Müssen sie es deshalb in diesem Koffer aufbewahren?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ach! Ich ... was zum Teufel ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Dieser goldene Schmetterling kommt mir bekannt vor ... \\nIch vermute, dass es sich um einen Hexensplitter handelt.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eine Hexenscherbe?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hmm, wie soll ich es ausdrücken ...", "Annie")
	await novel_interface.show_dialog("Magische Kraft ist eigentlich eine Art Wissen, das das Gehirn eines Menschen aus einer einzigartigen Art von „Informationen“ aufnimmt.", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Aber Menschen erwerben und sichern sich dieses Wissen meist auf Kosten ihrer geistigen Gesundheit.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mir fallen die Hexen im Umspannwerk und die Feinde in den Flüchtlingsgebieten ein.")
	await novel_interface.show_text_only("Ihr Wahnsinn muss durch die übermäßige Anhäufung von „Wissen“ verursacht werden, das ihr Körper nicht ertragen kann.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Die „Informationen“ können tatsächlich in Teile zerlegt und separat gespeichert werden. Ein Hexensplitter ist ein Behälter mit solchen kleinen „Informationen“.", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Was den Grund für dieses Design angeht, denke ich, dass es für den Menschen geschaffen wurde, um an seine Grenzen zu gehen …", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um herauszufinden, inwieweit sie davonkommen können, ohne ihren Verstand zu verlieren, verwenden sie Hexensplitter, um nach und nach Wissen zu absorbieren?", "Lian")
	await novel_interface.show_text_only("Der Auftritt selbst klingt verrückt genug!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Sich ständig nach neuem Wissen zu sehnen und es zu verfolgen – wenn überhaupt, liegt das in der menschlichen Natur ...", "Annie")
	await novel_interface.show_dialog("Auch wenn sie der Zerstörung geweiht sind ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was wäre, wenn ein gewöhnliches Mädchen den Hexensplitter bekommt, aber nicht das Talent hat, ihn zu benutzen? \\nWird sie eine der Hexen werden, die wir im Umspannwerk getroffen haben?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Sehr wahrscheinlich. Und es gibt keinen Schild um den Hexensplitter herum, sodass jeder ihn direkt berühren kann.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Ist es dann nicht supergefährlich?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("– Bumm! \\n – Boom!")
	await novel_interface.show_text_only("Draußen aus dem Raum erklangen leise und tiefe Geräusche von schwerem Hämmern an der Holztür.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Die Sicherheitssoldaten!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("– Knack!! \\nNach nur zwei Treffern wird die Tür der Royal Suite von einem Türbrecher in Stücke gerissen.")
	await novel_interface.show_text_only("– Klopf! -Schlag! -Schlag! \\n – Schlag! -Schlag! -Schlag!")
	await novel_interface.show_text_only("Dann ertönt das Geräusch von Türbrechern, die vergeblich auf den festen Aerogelschaum schlagen.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Vielleicht könnte es so lange dauern, bis Frau Mariru eintrifft ... \\nSehen Sie, Dr. Ayas Erfindung funktioniert!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich berühre meine Brust, wo Mariru den Lautsprecher ohne mein Wissen platziert hat.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Aha… \\nJa, es funktioniert…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich stürzt sich Raphael, jetzt wach, auf mich zu, den Stuhl immer noch an ihren Körper gefesselt.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Nimm dir niemals etwas weg!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Du perverser Lautsprecher!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael löst sich, als der Stuhl auf dem Boden aufschlägt. Dann eilt sie los, um den goldenen Schmetterling zu ergreifen.")
	await novel_interface.show_text_only("Als ich das sehe, stürze ich mich auf den Schmetterling zu und wäre fast kurz davor, mit ihr zusammenzustoßen …")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Nein, Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Knall –!")
	await novel_interface.show_dialog("(Äh? Habe ich es verstanden?) \\n(Ups…)", "Lian")
	await novel_interface.show_dialog("(Das Weiche ist…)", "Lian")
	await novel_interface.show_dialog("(Es kommt mir bekannt vor. Ich habe es gerade berührt)", "Lian")
	await novel_interface.show_dialog("(Warte. Könnte es sein...!)", "Lian")
	await novel_interface.show_dialog("… Du!", "Raphael")
	await novel_interface.show_dialog("Pervers!!!", "Raphael")
	await novel_interface.show_text_only("– Schlag!")
	await novel_interface.show_text_only("Der laute Schlag macht mich schwindelig.")
	await novel_interface.show_text_only("Visuelle Bilder schießen mir durch den Kopf, alles verstummte augenblicklich.")
	await novel_interface.show_text_only("Ich fühle mich wie in einer anderen Welt. Das seltsame Gefühl verschwindet im Handumdrehen.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Als ich meine Augen öffne, befinde ich mich immer noch in der Royal Suite.")
	await novel_interface.show_text_only("Das goldene Accessoire erwacht zum Leben, landet auf meiner Brust und strahlt ein glitzerndes Licht aus.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Wie würde das...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wenn das Licht schwächer wird und allmählich verschwindet, spüre ich, wie mein Gesicht sanft gestreichelt wird. Diese sanfte, magische Berührung hat sich in mein Gedächtnis eingeprägt.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("– Äh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Im offenen Raum dieses Raumes erscheint eine wunderschöne Frau.")
	await novel_interface.show_text_only("Mein Blick ist auf ihre hellroten Augen und Haare, ihren schlanken Körper und ihre jadeähnliche Haut gerichtet.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… Was ist passiert?) \\n(Meine Lippen wurden von etwas berührt!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Hahaha, nichts!) \\n(Woran habe ich gedacht? Es ist unmöglich!)", "Lian")
	await novel_interface.show_dialog("(Nein… nicht unmöglich!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Mist, das Gefühl... Das Gefühl...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, die lange verlorene Wärme eines menschlichen Körpers.", "Unerwartete Frau")
	await novel_interface.show_dialog("Guten Abend, junge Damen!", "Unerwartete Frau")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mein Herz schlägt schneller. Ich kann nicht anders, als auf sie zuzugehen. Meine Gliedmaßen gehören nicht mehr mir.")
	await novel_interface.show_text_only("Ich breite meine Arme aus und schlinge sie fest um sie, sodass jeder sie sehen kann.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Hallo, Süße. Dir geht es nicht gut, oder?", "Unerwartete Frau")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Entschuldigung ...", "Lian")
	await novel_interface.show_dialog("Darf ich bitte Ihren Namen erfahren?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es ist seltsam. Ihr Körper scheint immer schwerer zu werden ... \\nUnd ihre Temperatur steigt ...")
	await novel_interface.show_text_only("Was ist los mit mir!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ooh la la! \\nDas ist so unglaublich.", "Unerwartete Frau")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie zieht mich von der Frau weg.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Wer... bist du?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Wenn mein Name in Ihrer Zeit kein Tabu ist ... Nennen Sie mich bitte Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Was für ein schöner Name…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren… \\nDu siehst aus wie ein Trottel!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
