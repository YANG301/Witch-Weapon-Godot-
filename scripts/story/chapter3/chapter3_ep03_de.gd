# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Du meinst ... alle Informationen Dritter über diesen Kerl zu löschen?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Nein. Im Gegenteil, ich werde weitere Informationen hinzufügen.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ein erschreckendes Lächeln huscht über das Gesicht von Mariru.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Jetzt sind die einzigen Informationen über den Einbrecher nur noch Filmmaterial mit niedriger Auflösung.", "Mariru")
	await novel_interface.show_dialog("Stellen Sie sich vor, wie viele Menschen auf der ganzen Welt so unscheinbare Gesichter haben.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Warte – hast du gerade „einfach“ gesagt? Das brennt.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Und selbst wenn jemand wie „ich“ aussieht, wäre es dennoch leicht herauszufinden.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Überwachungskameras zeichnen alles auf, was er an diesem Tag getan hat!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Natürlich ist es nicht schwer, eine echte Person herauszugreifen.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Aber was wäre, wenn... diese Person nicht existiert?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du meinst...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Wenn wir einige gefälschte Identitäten mit ähnlichen Gesichtszügen wie der Verdächtige einschleichen, wird es fast unmöglich sein, das herauszufinden.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Und für alle außer uns unterscheiden sich diese Menschen nicht von "+GameConfig.player_name+" — sie sind nur weitere auf mysteriöse Weise verschwundene Personen.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Wie ist es dann möglich, das wahre Ziel herauszufinden?", "Mariru")
	await novel_interface.show_dialog("Um ein Reiskorn zu verstecken, nimmt man es entweder mit oder streut einen ganzen Beutel Reis darüber, um es zu verdecken.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Klingt nach einem riesigen Projekt …", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Nur ein bisschen mehr Komplexität für ein einfaches Problem, damit die Steuerzahler zufrieden damit sind, wofür ihr Geld ausgegeben wird. Sehen? Zwei Fliegen mit einer Klappe.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Jedes Mal, wenn Sie solch unangemessene Kommentare abgeben, möchte ich die Polizei rufen.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Übrigens habe ich einige Widersprüche in Ihren Identitätsinformationen festgestellt.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Hä? Welcher Teil?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Über deine Eltern.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mein Herz sinkt, wenn ich das Wort „Eltern“ höre.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Du hast mir erzählt, dass deine Mutter früh gestorben ist und dein Vater verschwunden ist.", "Mariru")
	await novel_interface.show_dialog("Ich weiß, dass du darüber nicht reden willst. Aber es ist wichtig. Ich muss mich bei Ihnen erkundigen.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Gut…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ruft die von ihr gesicherten Daten ab.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Hier steht, dass Ihre Mutter am 25. Juli 2026 vermisst wurde und vermutlich tot ist. \\nDas war die Große Trübsal.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Vor diesem Tag waren die Unterwasserruinen im Nordwesten New Opulentia eine geschäftige Stadt gewesen.")
	await novel_interface.show_text_only("Ich habe nur eine vage Erinnerung daran …")
	await novel_interface.show_text_only("In dem Moment, als die Stadt durch Devine Touch-Waffen zerstört wurde, erzeugte Aegis ein Schutzfeld. New Opulentia war kurz davor.")
	await novel_interface.show_text_only("Und... Das markierte den Beginn des Siebenjährigen Krieges.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Vater, seit Dezember 2026 vermisst. Vermutlich…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hör auf... bitte!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich hasse diese kalte Phrase – Vermutlich … tot.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Ich sage mir immer... \\nVielleicht... lebt Papa noch...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Nun, dein Vater muss glücklich sein. Sein Junge ist zu einem wunderschönen Mädchen herangewachsen!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich lache über ihre Worte. \\nVerdammt, ich weiß, dass sie mich neckt!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Schauen Sie sich das an.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie klickt auf die Profile meiner Eltern. Es werden zwei Codes angezeigt.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Laut Profil –", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mutter, Code offline. \\nVater, Code offline.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Stimmt etwas nicht?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis hätte Ihrer Mutter keinen Code zugewiesen, wenn sie gestorben wäre, bevor das Schutzfeld aktiviert wurde oder irgendwo außerhalb seiner Reichweite.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Äh...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru sieht mich nachdenklich an.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Du hast auch keine Ahnung? \\nDie Dateien würden nicht lügen. Ich werde darauf achten ...", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
