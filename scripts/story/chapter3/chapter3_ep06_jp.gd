# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("本部から帰る際、\\n重要情報が満載のマニュアルを受け取り、\\n更にお嬢様の映像データを携帯に、転送して\\nもらった。")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("ラファエル・デックス。\\nサモントンの名家で生まれる。\\n祖父はモントン遺伝子発展会社の最高責任者、\\nトーマス・デックス博士。", "小憐")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("うわ……教科書にも載ってる大物じゃん。\\nでも、な～んか妙な感じがするような……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ひとりぼっちの美少女、確保──ッ！")
	await novel_interface.show_text_only("背後から何者かが、俺の身体にしがみつく。")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("うわあああぁぁッ！？", "小憐")
	await novel_interface.show_dialog("………ってなんだ、愛衣かよ。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは異変区域に出入りするたび、\\n愛衣による検査と治療を必ず受けるように、\\n厳しいルールを敷いている。")
	await novel_interface.show_text_only("認めたくはないが、\\n愛衣の発明したタコのような機械は、\\nちゃんと傷を治してくれる優れものだ。")
	await novel_interface.show_text_only("更に認めたくないが、愛衣が滅茶苦茶する事にも\\n慣れてきた自分がいる……")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("なーにーその沈んだ表情は！\\nくっ、こんな子に育ってしまって……っ！", "愛衣")
	await novel_interface.show_dialog("前回の変電所の事件から、\\nしばらくちゃ～んとお世話できていないし……\\n私の育て方が悪かったわね……", "愛衣")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("だから決めたわ！　今すぐ学校に連行よ──！\\n\\n愛の教育を始めるわ！ ", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("はぁ？　ちょっ、まっ――！", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("服を引っ張るなってッ！　街の中だぞッ！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("今更ながら思い出した。帰る時に気を付けろって\\nマリルが言っていたのは──\\n──多分こいつの事だろう……")
	await novel_interface.show_text_only("愛衣に引きずられながら保健室に到着した。\\n\\n俺は大人しく保健室のベッドの上に横たわる。")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("ただの検査じゃないか……毎回驚かせやがって。", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("あ～ら～？　がっかりさせちゃったみたいね。\\n\\nやっぱりここは、スペシャルメニューを\\n追加したほうがかしら？", "愛衣")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("いいえっ！　結構ですからっ！\\n是非、普通の検査でお願いします！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("（そもそも愛衣の検査方法は最初っから\\n　スペシャルすぎるんだよ！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("普段通り、愛衣は風変わりな計器を運んできた。\\n\\nモニターには理解しがたい複雑な画像が\\n表示されている。")
	await novel_interface.show_text_only("待つ以外やる事がないので、俺は携帯を取り出し\\nターゲットであるラファエルの資料を見てみた。")
	await novel_interface.show_text_only("画面に映ったラファエルは、鈍色の長い髪を\\nしている。\\n淡紫色の瞳は透き通っていて……\\nまるで人の心を見透かすかのようだった。")
	await novel_interface.show_text_only("彼女の写真を見ていると、心臓が猛烈に躍動し、\\nなぜか全身が震え始めた。")
	await novel_interface.show_text_only("その後、すぐさま身体は正常に戻ったが……\\n\\n聴診器を弄っている愛衣は、どうやら俺の変化に\\n気付いていないようだ。")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("（なんだ今のは！？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("写真を通して見ただけだが、\\nラファエルの周囲に異様なオーラを感じた。\\nそして、間もなく愛衣の機器も共鳴を始める。")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("これは、一体……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ピー、ピー、ピ――ピ――")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("何の音？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("顔を上げると、モニターの波形が激しく\\n揺れ動いているのが目に入った。")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("あらら、そんなに揺れちゃってどうしたの。", "愛衣")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("もしかして何かトキめいちゃう物でも\\n見ちゃったのかな？", "愛衣")
	await novel_interface.show_dialog("例えば～～年頃の男の子がよく見ちゃうアレ……", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("見てないって！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──そして、異様な共鳴感は消えてしまった。")
	await novel_interface.show_text_only("愛衣がふざけた事を言うから、中断されたのか…")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("さっき急に動いていた波形の数値って、\\n一体、何なんだ？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("それは……ひ・み・つ……♡", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("うん……こいつに聞くのが間違いだった。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("失礼します、入ってもよろしいでしょうか？", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そんなやり取りをしている最中、ニュクス先輩が\\n柔和な足取りで保健室に入ってきた。")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("ニュクス先輩！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("ごきげんよう、レンちゃん。\\nここで会えるなんて思ってもいなかったわ。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そう言いながら、先輩は不思議そうに、\\n俺と周囲の器具をまじまじと見ている。\\n確かに誰だって、今の俺と愛衣の状況を見たら\\n理解に苦しむだろう。")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("失礼ですが、そちらは一体なんでしょう……？", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ニュクスは愛衣の手にある、4本の爪を持つ\\n道具を指差した。")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("人体実験だよ、人体実験～～", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("オイッ！　ちょっと待て！\\n何物騒な事を軽いノリで答えてるんだッ？")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("は、はぁ……", "ニュクス")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("──あっ、そうでした、愛衣さん。\\n\\n少し具合が悪いので、しばらくここで休んでも\\nよろしいでしょうか？", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さすがニュクス先輩だ。\\n\\n愛衣の発言にツッコミを入れず、\\n優雅な微笑みを維持できるなんて……")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("うん、大丈夫だよ、隣のベッドを使って～～\\n\\nレンちゃんの方は、まだ15分ぐらい必要だよ。", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は会話しつつ機器からモニターを取り外し、\\nさっきのデータをアップロードするから　と、\\nこの場から離れた。")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("ありがとうございます。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ニュクス先輩は愛衣にお礼を言った後、\\n隣のベッドに横たわった。")
	await novel_interface.show_text_only("1メートルにも満たない距離……\\nなのに先輩はカーテンを閉めていない。")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("（普通こんな無防備に寝転ぶものなのか？）\\n\\n（まあ、女同士だし警戒する必要もないのか…）", "小憐")
	await novel_interface.show_dialog("（やばい……ドキドキしてきた！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("隣で寝ている先輩の背中を、横目で見つめる。\\n髪を耳の後ろへと寄せる動作すらも優雅だ。")
	await novel_interface.show_text_only("この距離でも、彼女の淡い匂いが……")
	await novel_interface.show_text_only("俺が夢のような雰囲気に浸っていると、\\n突然、ニュクス先輩がこっちを向いた。\\n──その瞬間、目と目が逢ってしまった。")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("──どうしたの？", "ニュクス")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("へぇ？　あっ……！\\nいや…その……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("我に返って慌てふためく。\\n\\n悪戯現場を目撃されてしまった子供のように、\\n誤魔化しきれず途方に暮れてしまいそうになる。")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("どうしよう……\\nこんな時は何か言った方がいいのか？")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("（ん？　ちょっと待てよ……）", "小憐")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("これは目が合って恥ずかしいから緊張している\\nとかではなく……")
	await novel_interface.show_text_only("下腹部から伝ってくる、この悶々とした熱さは…")
	await novel_interface.show_text_only("これ……さっきラファエルの写真を見ていた時と\\nちょっと似てる………")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("ってあああああぁっ！\\n俺はもう既に、どんな女性に対しても、\\n妄想が暴走してしまうような変質者に\\n成り下がってしまったのか！？？")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("顔色が優れないようですが、大丈夫かしら？", "ニュクス")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("だ…、大丈夫です。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("あら、それは……？", "ニュクス")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("ニュクス先輩の目線が、俺の携帯に止まる。\\n\\n彼女は眉をひそめて、不愉快そうにモニター上に\\n映る写真を見つめていた。")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("ニュクス先輩、この人を知ってるんですか？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("いいえ……知らないわ。", "ニュクス")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("（でも、あんな嫌そうな顔をして……）\\n\\n（俺の見間違い……？）", "小憐")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
