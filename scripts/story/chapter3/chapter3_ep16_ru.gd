# chapter3_ep16.gd - 第三章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep16_script()

func play_script():
	pass

func chapter3_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Прошла неделя с тех пор, как в отеле Sky Hotel были обнаружены Пространственно-временные потоки.")
	await novel_interface.show_text_only("Доктор Айя сделал Beatrice изящный браслет из металла Substance H, используемого во внутренней оболочке чемодана.")
	await novel_interface.show_text_only("Благодаря браслету она теперь может свободно включать и выключать свою магию, привлекающую мужчин.")
	await novel_interface.show_text_only("Взамен Beatrice присоединился к SID в качестве агента, как и Annie.")
	await novel_interface.show_text_only("Mariru помещает ее в комнату для гостей в этой роскошной квартире.")
	await novel_interface.show_text_only("Сначала я боялся, что солдаты службы безопасности опознают нас по записям с камер видеонаблюдения на руководящем этаже.")
	await novel_interface.show_text_only("Но, что удивительно, никто из нас не попал на камеру. Как и Jacob и его товарищи.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mariru, какой силой на самом деле обладает SID?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("А? Почему ты спрашиваешь?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Поскольку на этот раз в дело вмешался более одного Академгорода, я подумал, что наводить порядок будет неприятным занятием.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Я очень рад, что вы так сильно верите в SID…", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Но вы и Annie никогда бы не смогли выбраться из этого места целыми и невредимыми, если бы не Сенат. Как вы знаете, Сенат имеет большое влияние в Объединенном Конгрессе.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Доктор Кирс, старик с бесстрастным лицом, всегда разыгрывает свои карты, прикрывая грудь. Так что я не знаю, что именно он сделал.", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Покерное лицо… старик?) \\nЯ думал, что Сенат поделится своими сведениями с SID…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ты слишком наивен…", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Никакие спецслужбы не будут делиться всей своей разведывательной информацией с главами государств и правительств.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А? Почему?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Как говорится, знать – значит владеть.", "Mariru")
	await novel_interface.show_dialog("Сенат является высшим органом власти в New Opulentia. Поэтому, естественно, SID должен с этим работать. Другими словами, SID и Сенат являются партнерами.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Если бы вы были начальником, вы бы предоставили всю конфиденциальную информацию своему партнеру бесплатно?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм… Конечно, нет…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("А если у вашего партнера есть ценная конфиденциальная информация, которая вам действительно нужна, что бы вы сделали?", "Mariru")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Посмотрим… \\nМожет быть, я подкуплю какого-нибудь дворника.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Умная девочка. Пока агентство достаточно велико, его всегда можно взломать изнутри, независимо от того, насколько строгим является его протокол безопасности.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если… если это так, то в SID у нас тоже есть родинки?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Держу пари. В SID работают тысячи сотрудников, и некоторые из них, должно быть, шпионы, будь то из Сената, иностранных спецслужб или других организаций.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Вот почему нам нужно держать в курсе лишь небольшую группу людей, когда дело доходит до ключевых разведданных.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А что насчет Зала Слоновой Кости…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Это не то, о чем вам следует беспокоиться. Наивные девушки вроде тебя никогда не смогут проникнуть в Сенат.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Все члены Сената являются экспертами в области Substance H с минимальным рейтингом уровня SS.", "Mariru")
	await novel_interface.show_dialog("У этих экспертов есть множество предметов Substance H для экспериментов. Если вы проберетесь туда, вам могут промыть мозги еще до того, как вы это заметите.", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Но… в этом деле еще много сомнительных моментов.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Например, почему делегация Salmonton переправила Золотую бабочку в New Opulentia?", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("И это ожерелье Raphael, довольно старомодное, явно не ее чашка чая. Обычно она заправляет его под воротник.", "Lian")
	await novel_interface.show_dialog("На самом деле, Raphael, которого я знаю… никогда бы не стал носить такие украшения…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Вы правы. Золотая бабочка имеет свойства, аналогичные свойствам инфекционного мема Substance H. Защитный щит, который мы используем для такого опасного предмета, обычно размером с грузовик.", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Но они просто засунули его в чемодан. Утечку энергии из этого чемодана можно обнаружить даже с помощью спутников.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Если они действительно хотели провезти это контрабандой, почему им пришлось заставлять это делать правительственных чиновников? Зачем им идти на такой большой политический риск?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Возможно, никакого риска вообще нет. Возможно, это приказ кого-то выше, кто дал им гарантию…", "Lian")
	await novel_interface.show_dialog("Членам делегации не нужно декларировать свою ручную кладь на пункте досмотра. И они сознательно выбрали отель за пределами нашей юрисдикции.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Вы говорите…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Наконец получили?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Сенат приказал им это сделать? Просто чтобы держать SID в неведении?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Jacob — военный атташе Salmonton, и данные Elluka показывают, что они некоторое время изучали ведьм.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Золотая бабочка принадлежит ведьме, и внезапно появился Jacob и присоединился к битве. \\nПодумайте об этом…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Гонка за контроль над сверхъестественной силой повергла мир в хаос Семилетней войны. Is that going to happen again?")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Будут ли тогда созданы еще ведьмы?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Пришло время подготовиться к этой битве под столом.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Несколько недель спустя")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Ннмм ... Я едва могу держать глаза открытыми ... \\nЯ не спал всю ночь, играя в игру ...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Эй, трансвеститный урод.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("???", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Знакомый голос…")
	await novel_interface.show_text_only("Знакомое место…")
	await novel_interface.show_text_only("И знакомое приветствие…")
	await novel_interface.show_text_only("Девушка, стоящая передо мной… Это снова она!")
	await novel_interface.show_text_only("Этот острый на язык смутьян Raphael!")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ра-Raphael? \\nПочему ты здесь?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("В этой школе вас не учат элементарным манерам, не так ли?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Я твой старший. Проявите немного уважения!", "Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("До сих пор я этого не замечал... \\nС сумкой под рукой она носит форму и туфли для младших школьников.")
	novel_interface.show_character("ren_uniform","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я думал, ты ненавидишь эту школу…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("У меня не было другого выбора. \\nВсе школы в New Opulentia — отстой.", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Для меня, как ведьмы, эта школа может быть лучшим выбором.", "Raphael")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Кажется, Raphael провела все исследования и приняла решение за такое короткое время. Какой гений.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Твоя семья... Ты сказала им, что ты ведьма?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Зачем беспокоиться? Ничего, кроме беспокойства, это им не принесет.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Эй, стать ведьмой — это не то же самое, что вступить в внеклассный клуб!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Представляешь, они отправили меня за границу просто чтобы я залегла на дно после того дурацкого интервью?", "Raphael")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Если они узнают об этом, они, вероятно, взбесятся, как когда узнали, что у меня есть татуировка.", "Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Нет, нет, нет. Это просто детская игра по сравнению с превращением в ведьму! \\nНу, если у тебя действительно есть татуировка, покажи мне ее, пожалуйста...")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Кстати... что, черт возьми, ты сказал в интервью?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ты из каменного века что ли? Это видео уже должно было разлететься по Интернету.", "Raphael")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Кстати говоря, я тоже довольно популярен в Интернете. \\nВ конце концов, я разыскиваемый преступник по всему миру…")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Честно говоря, я, должно быть, пропустил некоторые важные новости, потому что полностью увлекся игрой в Legend of Zelda.")
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Перестань смотреть на меня так…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я достаю телефон, чтобы узнать последние новости. Raphael не лжет. Her name has made headlines all over the world.")
	await novel_interface.show_text_only("Я включаю одно из этих видео, и вскоре раздается голос Raphael.")
	await novel_interface.show_dialog("Почему они верят, что всех грешников можно искупить, если они помолятся богам? Молитва не приносит им ничего, кроме какого-то жалкого утешения.", "Raphael")
	await novel_interface.show_dialog("… Этот мусор бесполезен, куда бы он ни пошел. Почему наше правительство должно беречь свои задницы? Просто дайте им гнить.", "Raphael")
	await novel_interface.show_text_only("Я не могу поверить, что эти противоречивые комментарии сделаны Raphael, внучкой губернатора Salmonton. Неудивительно, что это вызвало такой ажиотаж.")
	novel_interface.show_character("ren_uniform","speechless")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я помню, что Salmonton — это религиозное государство всеобщего благосостояния… \\nУ вас действительно хватает смелости делать такие провокационные комментарии.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Так много государств объявили войны во имя богов. Так почему я не могу сказать, что у меня на уме?", "Raphael")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Война? You mean… the Seven Years War?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Nope, you idiot. Конечно грядущие войны!", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("В Salmonton мы призываем людей иметь свою собственную религию, независимо от того, в какого бога они верят.", "Raphael")
	await novel_interface.show_dialog("В результате массовых миграций после Семилетней войны в эти бесполезные группы хлынули бесчисленные отбросы, и их алчность не знает границ.", "Raphael")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Дедушка слишком снисходителен к ним. Эти ленивцы должны оказаться на бойнях…", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Стоп! Теперь становится жутко…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Теперь вы находитесь в центре этого масштабного перехода. Тебе просто все равно, или нет?", "Raphael")
	novel_interface.change_2nd_expression("thinking")
	await novel_interface.show_dialog("Может быть, никто, кроме таких идиотов, как ты, не сможет прожить такую оптимистичную жизнь.", "Raphael")

	print("=== 第三章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
