	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("라파엘 아가씨의 눈엔 이렇게 원예가 부족하고 어수선한 곳은 화원이라고 할 수 없겠죠?", "수행요원")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("라파엘이 조금 불만족스러운 표정을 짓는다.")
