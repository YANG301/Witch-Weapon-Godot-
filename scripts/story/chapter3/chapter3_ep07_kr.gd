	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("건축학 같은 건 전혀 몰라요. 저한테 물어보셔도....", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("그냥 느껴지는 대로 얘기해 봐. ", "라파엘")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("음, 강의동은, 중앙 로비의 높이가 특별히 낮지는 않아요.", "샤오롄")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("마음에 들지 않는 이유가 어쩌면……귀엽지 않아서?", "샤오롄")
	novel_interface.character_dark()
	await novel_interface.show_text_only("나는 라파엘의 표정을 관찰하며 자신의 부족한 어휘량을 자책했다.")
	await novel_interface.show_text_only("역시 예상대로 경멸의 미소를 짓는다. ")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("귀여워?!정말 믿을 수 없군! 이런 얕은 어휘로 건물을 설명하는 사람이 있다니.", "라파엘")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그, 그냥 느낌 같은 거예요!", "샤오롄")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("나무를 가지런히 놓지 않으면 더 좋을 거란 뜻이죠.", "샤오롄")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("흠……\\n예를 들어……음……", "샤오롄")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("그러게 왜 나한테 묻고 그래요!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("나무를 어긋나게 교차 배열하면 시야가 더 깊어질 거란 거지?", "라파엘")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("네.\\n(방금 무슨 말을 하신 건지...??)", "샤오롄")
