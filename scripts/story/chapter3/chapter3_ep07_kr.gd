	await novel_interface.show_text_only("임무가 시작된 건가?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("하지만 내가 말을 걸어도……정말 문제 없을까?", "샤오롄")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("상대는 명문 가문의 아가씨다. 만약 대꾸도 안 하면 어떡해야 하지?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("저 사람 옷 좀 봐. 우리 학교 학생이 아니잖아?", "동급생1")
