	await novel_interface.show_dialog("……쳇, 난 또~남잔 줄 알았네.", "라파엘")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("어, 어디가 남자 같다는 거야…\\n(아, 아니……)", "샤오롄")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("아──스스로를 배신하는 느낌이 이렇게 씁씁한 거였나?")
