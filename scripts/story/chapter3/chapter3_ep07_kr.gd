	await novel_interface.show_text_only("저 수행원은 옆에 있는 아가씨의 얼굴색이 점점 나빠지는 게 안보이는 걸까?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("이봐, 거기 여장 변태. ", "라파엘")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("……에헥?!", "샤오롄")
