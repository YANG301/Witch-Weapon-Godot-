# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Sono passati due giorni da quando Mariru mi ha assegnato l'attività.")
	await novel_interface.show_text_only("Ieri sera, la delegazione \"Scambio Culturale\" è finalmente arrivata al New Opulentia International Airport.")
	await novel_interface.show_text_only("Quindi… La mia missione sta per iniziare.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Ma cercare di estorcere informazioni a quella ragazza ... non lo so.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Comunque non è una ragazza normale. E se si rifiuta di parlarmi?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Guarda la ragazza laggiù! Non indossa la nostra uniforme scolastica.", "Studente 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("E quella accanto a lei sembra un'attendente ... È una specie di principessa?", "Studente 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi alzo e vedo una ragazza snella con un cappotto verde. \\nLei è in piedi davanti al prato.")
	await novel_interface.show_text_only("L'obiettivo della mia missione: Raphael Dekkers.")
	await novel_interface.show_text_only("Ho visto proprio adesso il vicepreside e la banda d'onore aspettare fuori dal cancello della scuola. Si è intrufolata nel campus?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Signorina, da questa parte, per favore.", "Seguito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Questo edificio scolastico è progettato nello stile Tudor dell'età dell'oro.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Ma l'atrio è troppo angusto per mostrare un senso di grandiosità.", "Raphael")
	await novel_interface.show_dialog("E l'intaglio sul battiscopa è troppo goffo per supportare la struttura e il design.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Signorina, che gusto straordinario per l'arte ha!", "Seguito")
	await novel_interface.show_dialog("L'architettura Tudor come questa dovrebbe avere un atrio più alto.", "Seguito")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, non capisci. \\nSemplicemente aumentare l'altezza non funzionerebbe.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ha perfettamente ragione, signorina. Anche il prato dovrebbe essere ampliato.", "Seguito")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh? Sembrerebbe semplicemente scoordinato. \\nDopo tutto, l'intero cortile è già congestionato...", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Naturalmente. La signorina Raphael non chiamerebbe nemmeno un cortile questo pezzo di terra disorganizzato, vero?", "Seguito")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael sembra essere un po' insoddisfatto di queste parole.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… No, non è quello che intendo.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Oh! \\nChe carino da parte tua, signorina Raphael!", "Seguito")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Perché il suo assistente non riesce a vedere che il suo sorriso è già rigido?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Ehi, maniaco del travestitismo.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cosa?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Il maniaco del travestitismo ... Sta parlando di me?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alle sue parole tutti si voltano a guardarmi.")
	await novel_interface.show_text_only("Non avevo così tanti occhi puntati su di me, e mi sento arrossire.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("No, io... non sono...! \\n(Mariru mi ha fatto indossare l'uniforme!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Sii un uomo e ammettilo, ok?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Non sapevo che New Opulentia fosse così liberale che un pervertito come te potesse essere ammesso in una scuola femminile.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, ho cambiato idea! Non voglio farlo!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Umm... Ren è il nostro compagno di classe. E' una ragazza!", "Studente 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Cosa? \\nSmettila di prendermi in giro.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael sembra offesa.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Non sta scherzando! Ve lo possiamo assicurare tutti. \\nRen è assolutamente una ragazza.", "Studente 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Grazie per aver parlato per me. Ma sicuramente non sono una ragazza.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("…Tut-tut, pensavo fossi un maschio.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Perché! Non assomiglio per niente a un ragazzo! \\n(Oh, no...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Uffa... fa schifo tradire il vecchio me...")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Va bene. Lasci perdere.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Cosa ne pensi dell'architettura della tua scuola?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non ho idea di architettura. Se insisti...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Dì semplicemente quello che ti viene in mente.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uhm ... come edificio scolastico, l'atrio non è troppo basso.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("L'edificio non è gradevole alla vista... forse perché... non è abbastanza carino?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Vergognandomi per il mio povero vocabolario, cerco di cogliere lo sguardo sul volto di Raphael.")
	await novel_interface.show_text_only("Come previsto, sorride con disprezzo.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Carino? Non posso credere alle mie orecchie. È questa la parola che riesci a trovare per descrivere un'architettura?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Beh, è proprio quello che penso!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Voglio dire, potrebbe essere meglio... Se gli alberi non sono perfettamente allineati...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Uhm... \\nCome, uh...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh... perché devo rispondere a questa domanda?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Stai cercando di dire che gli alberi dovrebbero essere disposti alternativamente per aggiungere più profondità al design?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esattamente. \\n(Cosa ha appena detto?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael alla fine mi ha fatto un debole sorriso.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ah, un pervertito è molto meglio di uno yes-man!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("No, non sono...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Signorina...", "Seguito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Lasciaci. Aspettami fuori dalla scuola.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Tu sei Ren, vero? Andiamo. Mostrami la tua fantastica scuola, ok?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Eh…? \\nO... Va bene!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
