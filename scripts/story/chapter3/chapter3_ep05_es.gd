# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru envía a Annie y Elluka justo cuando regresamos a la sede.")
	await novel_interface.show_text_only("Ahora estoy molesto. No sé si me volverían a interrogar con preguntas extrañas…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("¿Qué pasó?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("¿Qué pasa si no pasa nada? ¿Vas a seguir sonriéndole a Elluka como un pervertido?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tú… ¡Debes haber estado mirándome a través de la cámara de vigilancia!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Jeje, ¿eso es todo lo que se te ocurre?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué más podría ser...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Por ejemplo—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru me mira con maldad de pies a cabeza.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("¡El Departamento de Investigación ha desarrollado una oblea que puede incluso decidir cuándo vas al baño!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("¿Qué… baño? \\n¡Uf, suena asqueroso!", "Lian")
	await novel_interface.show_dialog("¡Debe ser inventado por Aya! \\n¡Espera, no me digas que lo has implantado en secreto en mi cuerpo!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Solo estaba bromeando.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("¡La forma en que lo dices no es ninguna broma!")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O… ¿Hay algo extraño que se te pasa por la cabeza?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Uf, maldita sea…", "Lian")
	await novel_interface.show_dialog("(La última vez tuve carreras durante la asamblea escolar...) \\n(¿Eso significa...?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Jajajaja! ¡No te lo tomes en serio!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru se ríe a carcajadas y me frota la cabeza con fuerza.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya sólo hizo un prototipo antes de que yo cancelara el proyecto. \\n¿Por qué lo usaríamos con alguien como tú?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Oh, ¿debería decir gracias?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jaja, tienes porquería en la cabeza, ¿verdad?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh… ¡Gracias a Dios que no hay una máquina para leer la mente! ¡Piensa en lo vergonzoso que sería!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Oye, no aguantes. Es muy divertido verte defenderte.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Perdón por decepcionarte.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm… Me pregunto cómo podría un tonto como tú extraer información de objetivos clave.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru se seca las lágrimas de risa y pone su habitual cara arrogante.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Objetivos clave... Suena más significativo que atenderte a ti... ¡Pero por qué Mr. Big hablaría con un chico de secundaria!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esta vez te acercarás a tu objetivo como estudiante. El objetivo…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, nieta del alcalde de Salmonton. Ella vendrá con la Delegación Salmonton.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ella es una verdadera chica de alta cuna. ¿Entusiasmado?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("¿Por qué debería estar emocionado?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut-tut, sólo te gustan las niñas, ¿eh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("¡Oye, deja de describirme como un criminal!", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Ejem. \\nDe todos modos, ¿qué quieres que obtenga de esta chica de alta cuna?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uf, no hablas mucho... \\nEspero que puedas pasar al menos un día.", "Mariru")
	await novel_interface.show_dialog("Bien, en serio, ¿qué sabes sobre Salmonton?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Umm… ¿Supongo que es el mayor exportador de alimentos?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Hablando de Salmonton... lo que me viene a la mente son las decenas de invernaderos de gran altura que bordean el Rin.")
	await novel_interface.show_text_only("Los verdes jardines detrás de los invernaderos... \\nSiempre crea fondos de pantalla perfectos.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Y hay muchas iglesias. Todos los ciudadanos tienen una creencia religiosa. Incluso han formado una Alianza Sagrada...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eso es todo lo que puedo recordar. No soy bueno en geografía. Demasiada memorización de hechos aleatorios.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("El poder económico y político de Salmonton depende en gran medida de su control sobre los genes de los cultivos.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Pero los incidentes posteriores a la desaparición del Ross Goblet han planteado graves amenazas para ellos.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Por amenazas te refieres... al flujo del espacio-tiempo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Así es. Según mi información, ha sufrido múltiples flujos. Pero aún se desconocen los daños.", "Mariru")
	await novel_interface.show_dialog("A juzgar por la reciente volatilidad en el precio de los futuros de cereales, el impacto parece bastante grande... Tal vez se produzcan hambrunas esporádicas.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Eso es grave!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("No sé nada sobre el mercado de futuros. Pensé que el impacto se limitaba a un área pequeña.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sí... Las malas cosechas no causarán un daño inmediato. Los países tienen reservas de riesgo de todos modos.", "Mariru")
	await novel_interface.show_dialog("Parece que Salmonton es la primera en colapsar, entre todas las Ciudades Academia.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ha enviado una delegación a New Opulentia, que ya está en camino.", "Mariru")
	await novel_interface.show_dialog("Como su principal importador de alimentos, no podemos decir que no.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Sospecharán de Annie y de mí?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Eso es lo que vas a hacer.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Qué?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Aunque está bajo el lema de un programa de \"intercambio cultural\", la delegación ha estado bajo estricta protección por parte del Servicio Real de Seguridad.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("El Servicio Real de Seguridad... La agencia de inteligencia de Salmonton, también conocida como Rosenkreutz.")
	await novel_interface.show_text_only("Para ser un servicio de inteligencia, es demasiado famoso gracias a las películas del Agente No. 7.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Will it cause some troubles?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Por supuesto. SID incluso tiene dificultades para recopilar información general.", "Mariru")
	await novel_interface.show_dialog("Hasta ahora, lo que es relevante para ti es que la niña visitará la escuela secundaria para niñas de Gosakuragawa.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Mi escuela?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Eso es de esperarse. Tiene aproximadamente la edad de una estudiante de secundaria.", "Mariru")
	await novel_interface.show_dialog("Entonces, lo que debes hacer es descubrir el verdadero propósito de su visita.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Los servicios de inteligencia hicieron un folleto sobre Salmonton y la familia Dekkers. Ahora ve y léelo detenidamente.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ups, tarea de memorización otra vez... \\n¡Yo me encargo!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Por cierto, ten cuidado con el pervertido de camino a casa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("¿¡Q-Qué!?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
