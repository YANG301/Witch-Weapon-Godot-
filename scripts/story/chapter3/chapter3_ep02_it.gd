# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("I registri di SID mostrano che il Centro Akatraz raccoglie la classe EX Substance H di cui è vietato testare e ricercare dal Congresso Unito.")
	await novel_interface.show_text_only("Sotto il terreno del Centro, è collegato all'ingresso di un'antica casa-grotta di Chate, a cui è vietato entrare e non può nemmeno essere classificata.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Classe EX Substance H... È una specie di materiale altamente pericoloso?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("La maggior parte di essi sono oggetti sacri di significato religioso. Poiché sono speciali per i seguaci religiosi, possono essere raccolti, ma la ricerca è vietata.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sembra un autoinganno.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Ah, mi sono sentito allo stesso modo. \\nMa in un certo senso ha senso.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Si dice che alcuni artefatti nella tradizione religiosa possiedano il potere di uccidere gli dei o di innescare il Giudizio Universale.", "Mariru")
	await novel_interface.show_dialog("Una volta attivati, potrebbero causare una catastrofe su scala apocalittica.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questo è brutto.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sebbene alcuni elementi venerati nelle storie religiose in seguito si siano rivelati deboli o addirittura imbarazzanti inefficaci ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Qualcosa di stupido?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Esatto, un esempio è questo paio di scarpe sacre. Chi bacia la punta della scarpa non resiste alla striatura: che vergogna per la religione.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("È disgustoso. \\nAllora. a quale tipologia appartiene questo mancante?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("È il Destiny Spear, un Substance H di classe EX sotto la custodia congiunta di tutte le città accademiche.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ah. \\nCapisco, sembra fantastico.", "Lian")
	await novel_interface.show_dialog("Cos'è esattamente il Destiny Spear allora?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sembri un completo idiota in questo momento.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Ehi, non ne ho davvero idea! \\nSono solo uno studente delle superiori.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru mi guarda impotente, come se si chiedesse da dove cominciare.")
	novel_interface.character_light()
	await novel_interface.show_dialog("In poche parole, è il primo tipo di Substance H, che si ritiene abbia poteri deicidi.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Nella letteratura disponibile al pubblico si trova pochissima descrizione del Destiny Spear, tranne che \"non si scioglie ad alta temperatura\" e che \"acquista peso quando viene fatto oscillare\".", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Tutto qui?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se scavi più a fondo, scoprirai che entrambi i tratti lo renderanno un Substance H di classe XK.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Potrebbero esserci altri tratti pericolosi e sconosciuti. Ecco perché non dovrebbero attirare troppa attenzione da parte dei media.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Questo mi fa venire la pelle d'oca. Anche i bambini piccoli sanno cos'è un Substance H di classe XK...")
	await novel_interface.show_text_only("Porterebbe a un disastro apocalittico o creerebbe un altro Substance H con lo stesso potere. Attualmente sono conosciuti solo sei oggetti di questo tipo in tutto il mondo.")
	await novel_interface.show_text_only("Ognuna di esse appartiene ad una delle sei Città Accademia. Più precisamente, solo chi è in possesso di tale Substance H è riconosciuto dal Congresso Unito.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Eh? \\nChe significa ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Adesso sai quale grave crimine “tu” hai commesso?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sono così scioccato al punto che tutto mi sembra surreale.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Mi dispiace. \\nNo! Perché ho chiesto scusa? Non sono io il ladro!", "Lian")
	await novel_interface.show_dialog("(Merda. Quel ragazzo deve essere super pericoloso!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Ma per fortuna la notizia è stata rimossa.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo hanno fatto solo per evitare il panico pubblico.\\nLe indagini sarebbero andate avanti ancora, in segreto.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Per ragioni di riservatezza, la notifica di ricercato non verrà inviata al Ministero della Difesa. Ma tutti i servizi segreti, compreso SID, devono essere già stati avvisati.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Quindi è ancora presto per sentirsi sollevati, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Giusto... il vecchio me è ancora in pericolo, giusto?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("E se... intendo dire, e se... \\n...qualcuno mi rintracciasse...", "Lian")
	await novel_interface.show_dialog("Anche se adesso fossi una ragazza, probabilmente potrei essere rinchiusa, giusto?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Finalmente hai capito.", "Mariru")
	await novel_interface.show_dialog("I servizi segreti hanno controllato tutti i filmati CCTV disponibili e hanno scoperto che il ragazzo si è presentato in altre aree di Flux, con ancora la tua vecchia faccia.", "Mariru")
	await novel_interface.show_dialog("Poiché possiamo recuperare i dati da una fonte terza, probabilmente anche altri servizi di intelligence dispongono già di queste informazioni.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Già recidivo? \\nIl mio futuro sembra cupo ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mi immagino torturato in interminabili interrogatori…")
	await novel_interface.show_text_only("Sento che da un momento all'altro verrò arrestato ed etichettato come un criminale contro l'umanità.")
	await novel_interface.show_text_only("È stato rinchiuso nella prigione più brutale, condannato a oltre 200 anni di prigione.")
	await novel_interface.show_text_only("Potrei avere un compagno di cella estremamente pericoloso, e lui...")
	await novel_interface.show_text_only("Waah, smettila! \\nNon pensare più!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ahahah. Sei così spaventato e sembri così pallido.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Vacci piano, Ren. Posso assicurarti una sicurezza del 98% finché rimarrai nel New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Quindi ho ancora il 2% di possibilità di essere beccato?", "Lian")
	await novel_interface.show_dialog("(Due secondi di incertezza ogni cento secondi!) \\n(Non è affatto sicuro!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Che quei vecchi cani del Congresso Unito abbiano raggiunto il consenso in così poco tempo… Qualcosa non va.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("E questo è l'incognita del 2% di cui parlavo.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Non riesco a immaginare quale scalpore abbia suscitato tra quei pezzi grossi...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quindi, i servizi segreti di altre Città Accademia devono aver utilizzato molte risorse per dare la caccia al ladro.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W... cosa dovrei fare?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Un nemico visibile è sempre facile da affrontare. Lasciamo fare a SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
