# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Причудливый кошмар, смутный разговор, тень во сне. \\nПлюс красное предупреждение…")
	await novel_interface.show_text_only("Как только я собирался принять свою новую личность и решить взять себя в руки, они снова все испортили.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Хм?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Вы видели новости? \\nЭто он! Нет, я, это я!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Я не слепой. Конечно, я знаю, что это ты прямо передо мной, потеющая, глупая девчонка.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Нет! \\nЧерт возьми. это я в новостях!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В панике даже не знаю с чего начать. \\nMariru кряхтит и стучит меня по голове рукой.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Такой бесполезный идиот. После всех этих тренировок ты даже не можешь внятно отчитаться перед своим офицером.", "Mariru")
	await novel_interface.show_dialog("Разве речь не идет о парне, который выглядит так, будто тебя разыскивают по всему миру, потому что он ограбил Коллекционно-исследовательский центр Второго Академгорода?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да, да, да! Точно!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Спецслужбы сообщили об этой новости задолго до того, как она стала вирусной.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Ты выглядишь глупо, когда напуган~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ущипнул меня за щеку. Я попытался остановить ее сразу.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, будь серьёзен!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Самый разыскиваемый во всем мире. Это не шутка!", "Lian")
	await novel_interface.show_text_only("Мне никогда не могло прийти в голову, что однажды меня упомянут в новостях из-за кражи со взломом.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("И это тройное замечание! Насколько я помню, последний разыскиваемый парень с таким уровнем боевой готовности был взорван насмерть в Южной Америке разрушителем бункеров.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Этот проклятый грабитель просто так украл мою прежнюю личность… Я почти плачу при мысли об этом.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("В данном случае... \\nЕдинственное, на что я могу рассчитывать, это Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Как бы мне ни хотелось видеть, как ты так страдаешь…", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Я вынужден попросить вас еще раз проверить новости.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("Это необходимо? У меня уже все это запечатлелось в голове.")
	await novel_interface.show_dialog("Возможно, изображение нечеткое и ясное, но я уверен, что в детстве он выглядел почти так же, как я!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Чтобы доказать свои слова, я открываю новости на своем телефоне.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Видишь, это... \\nЭ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Уведомления о розыске, которое меня напугало, больше нет. Его заменило обычное объявление о пропаже человека.")
	await novel_interface.show_text_only("Недавно пропал семидесятилетний карикатурист Иноуэ. \\nЕсли кто-либо знает его местонахождение, немедленно обратитесь в полицию.")
	await novel_interface.show_text_only("Я проверил другие сайты и даже искал по ключевым словам, но новостей нигде не было.")
	await novel_interface.show_text_only("Глядя на выражение лица Mariru, я очень благодарен.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Это был ты...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru подходит и вытирает мне слезы.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Посмотри на себя — весь задохнулся.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Если ты действительно хочешь отблагодарить меня — тогда будь моим рабом~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("И…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Когда ты сказал: «Единственный, на кого я могу рассчитывать, это Mariru», \\nты выглядел таким милым…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru нежно поднимает мой подбородок указательным пальцем.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Эй, прекрати это!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Насколько я вижу, я уже порабощен…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Мне бы хотелось это сделать. Но, насколько мне известно, есть только одно агентство, которое может закрыть все социальные сети во всем мире.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Э?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Это должно быть распоряжение Объединенного Конгресса.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Высший конгресс, представляющий все шесть Академгородов… решил удалить эту новость?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Почему…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru смотрит на меня и загадочно улыбается.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Не глупи. Очевидно, они сделали это не для того, чтобы защитить грабителя.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Они просто не хотят, чтобы общественность знала, что было похищено.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Кто этот грабитель? Почему он использовал мою личность?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Кем бы он ни был, он, должно быть, гений, чтобы выбраться из Коллекционно-исследовательского центра Акатраса целым и невредимым.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Дело в том, что ему нетрудно закрыть лицо.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Но он не решился и даже осмелился выйти на некоторое время на крышу здания...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Согласно специальной подготовке, самые незначительные вещи либо отсутствуют там, где им положено появиться…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Или присутствуют там, где их не должно быть.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
