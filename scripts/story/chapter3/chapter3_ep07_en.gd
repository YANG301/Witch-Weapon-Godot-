# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("It's been two days since Mariru assigned me the task.")
	await novel_interface.show_text_only("Last night, the \"Cultural Exchange\" delegation finally arrived at New Opulentia International Airport.")
	await novel_interface.show_text_only("So… My mission is about to begin.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("But trying to coax information out of that girl... I don't know.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Anyway, she's no ordinary girl. What if she refuses to talk to me?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Look at the girl over there! She's not wearing our school uniform.", "Student 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("And the one beside her looks like an attendant... Is she some kind of princess?", "Student 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look over and see a slender girl in a green coat. \\nShe is standing in front of the lawn.")
	await novel_interface.show_text_only("The target of my mission—Raphael Dekkers.")
	await novel_interface.show_text_only("I saw the vice principal and the honor band waiting outside the school gate just now. Did she sneak into the campus?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Miss, this way please.", "Entourage")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("This school building is designed in the Tudor style of the golden age.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("But the atrium is too cramped to show a sense of grandeur.", "Raphael")
	await novel_interface.show_dialog("And the carving on the baseboard is too clumsy to support the structure and design.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Miss, what an extraordinary taste for art you have!", "Entourage")
	await novel_interface.show_dialog("Tudor architecture like this should have a taller atrium.", "Entourage")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, you don't get it. \\nJust increasing the height would not work.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You are perfectly right, Miss. The lawn should be expanded as well.", "Entourage")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh? That would just look uncoordinated. \\nThe whole front yard is already congested after all…", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Of course. Miss Raphael wouldn’t even call this disorganized piece of land a front yard, would you?", "Entourage")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael seems to be somewhat dissatisfied with these words.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… No, that's not what I'm thinking.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Oh! \\nHow nice of you, Miss Raphael!", "Entourage")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Why can't her attendant see that her smile is already stiff?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Hey, you cross-dressing freak.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("What?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Cross-dressing freak... Is she talking about me?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At her words, everyone turns to look at me.")
	await novel_interface.show_text_only("Not used to have so many eyes on me, I feel myself blushing.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("No, I'm…  I'm not…! \\n(Mariru made me wear the uniform!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Be a man and admit it, will you?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("I didn't know New Opulentia was so liberal that a pervert like you could get admitted to a girls' school.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, I've changed my mind! I don't want to do this!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Umm… Ren is our classmate. She's a girl!", "Student 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("What? \\nStop kidding me.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael looks as if she's offended.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("She's not kidding! We can all assure you. \\nRen is absolutely a girl.", "Student 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Thank you for speaking up for me. But I'm definitely not a girl.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, I thought you're a boy.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Why! I look nothing like a boy! \\n(Oh, no…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh… It sucks to betray the old me…")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("All right. Forget it.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("What do you think of the architecture in your school?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I have no idea about architecture. If you insist…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Just say whatever comes to your mind.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um... as a school building, the atrium isn't too low.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("The building is not pleasing to the eye… maybe because it's… not cute enough?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ashamed for my poor vocabulary, I try to catch the look on Raphael's face.")
	await novel_interface.show_text_only("As expected, she smiles scornfully.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Cute? I can't believe my ears. Is that word all you can find to describe an architecture?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Well, it’s just what I feel about it!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("I mean, it might be better… If the trees are not perfectly aligned…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Umm… \\nLike, uh…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh… why do I have to answer this question?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Are you trying to say, the trees should be alternately arranged to add more depth to design?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactly. \\n(What did she just say?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael finally gave me a faint smile.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ah, a pervert is way better than a yes-man!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("No, I'm not…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Miss…", "Entourage")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Leave us. Wait for me outside the school.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("You're Ren, right? Let's go. Show off your amazing school to me, will you?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Eh…? \\nO… Okay!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
