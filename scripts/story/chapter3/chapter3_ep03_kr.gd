# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("설마… 그 사람과 관련된 제3자 자료를 모두 지워버리려고?", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("아니. 그 반대야. 더 많은 정보를 추가할 거야.", "마리루")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("뭐?!", "샤오롄")
	novel_interface.character_dark()
	await novel_interface.show_text_only("마리루가 서늘한 웃음을 짓는다.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("현재 강도에 관한 정보는 선명하지 않은 짧은 영상뿐이야.", "마리루")
	await novel_interface.show_dialog("그렇다면 전 세계에 그 평범하기 짝이 없는 얼굴과 비슷한 사람이 몇 명이나 될까? ", "마리루")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("잠깐, 평범하다니, 너무 하잖아!")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("하지만 “나”와 비슷한 사람이라도 조금만 조사하면 확실히 분별할 수 있잖아?", "샤오롄")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("그 사람이 당시 어디에 가서 뭘 했는지 감시 카메라 영상을 조사하면 다 알 수 있을 거야.", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("맞아. 실제로 존재하는 사람을 조사하는 건 어려운 일이 아니지. ", "마리루")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("하지만 조사 대상 중 존재하지 않는 사람들이 있다면? ", "마리루")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("네 말은…", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("용의자와 용모가 매우 비슷한 위조 타겟을 여럿 만들면, 세상 마지막 날까지 찾는대도 그 사람들을 찾을 수 없을 거야. ", "마리루")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("그리고 우리를 제외한 다른 사람들 눈에는, 그 사람들도 "+GameConfig.player_name+"과 마찬가지로 기이하게 사라진 실종자일 뿐이야.", "마리루")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("이렇게 되면 누가 진짜 타겟인지 어떻게 분별해내겠어?", "마리루")
	await novel_interface.show_dialog("탁자 위 쌀알이 사라지게 하려면, 하나하나 주워다 버리거나 같은 품종의 쌀을 쏟아부으면 돼.", "마리루")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("엄청난 프로젝트처럼 들리는데…", "샤오롄")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("간단한 일을 복잡하게 만들면 세금이 큰 일에 쓰인다며 다들 행복해 할 걸?", "마리루")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("네가 그런 말을 할 때마다 신고하고 싶어.", "샤오롄")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("그나저나, 너의 원래 신분 자료를 대조 확인하다가 이상한 부분을 발견했어.", "마리루")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("엣?뭐가?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("너의 부모님.", "마리루")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("부모님이라는 단어를 듣자마자 마음이 가라앉는다.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("네 말에 따르면, 어머니는 예전에 돌아가셨고, 아버지는 실종되셨어.", "마리루")
	await novel_interface.show_dialog("떠올리고 싶지 않은 기억이겠지만, 이상한 부분이 있어서 확실히 확인해야겠어.", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("알았어……", "샤오롄")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("마리루가 미리 준비한 나의 예전 데이터를 불러온다.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("여기 표시된 내용은 모친: 2026년 7월 25일\\n『대재난일』 당일 실종, 사망 추측.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("……", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("신토요스 서북 해저의 폐허는 『대재난일』 전에는 번화한 도시였다.")
	await novel_interface.show_text_only("그곳의 기억은 아주 흐릿하다……")
	await novel_interface.show_text_only("그 도시가 기적 무기에 의해 소멸됨과 동시에 아이기스 시스템의 방호 역장이 펼쳐졌고, 신토요스는 마침 역장의 변방에 위치했다.")
	await novel_interface.show_text_only("게다가…그 사건은 『7년 전쟁』의 서막이였다.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("부친,2026년 12월부터 행방불명, 추측...…", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("그만해……제발.", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("그렇게 냉정하게——사망이라고 추측하는 건 정말 싫어.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("아버지는 살아계실지도 모른다고……\\n줄곧 생각해왔어.", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("……응, 아들이 이렇게 아름답게 컸으니, 그분도 분명 감격하시겠지.", "마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("나는 마리루의 의외의 발언에 웃음이 터졌다.\\n쳇, 날 놀리는 게 분명하다!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("알았어. 우선 여길 좀 봐.", "마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("마리루가 부모님의 기록을 클릭하자, 두 개의 일련번호가 나타난다. ")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("여기에 기록된 내용은──", "마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("모친, 일련번호 오프라인\\n부친, 일련번호 오프라인")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("……뭐가 잘못됐어?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("아이기스 발동 전이나 방호 역장 범위 밖에서 희생 되셨다면, 아이기스에 일련번호가 있을 리가 없어.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("에……?", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("마리루가 생각에 잠겨 날 쳐다본다.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("너도 모르겠어?\\n기록 오류는 아닐 거야. 내가 계속 조사해볼게……", "마리루")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
