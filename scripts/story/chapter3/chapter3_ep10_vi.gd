# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Nhờ Skurd, có vẻ như Fabella đã quyết định để tôi đi.")
	await novel_interface.show_text_only("Ngay khi Skurd quay đi, một số vị khách ăn mặc bảnh bao bước tới và nói chuyện với cô.")
	await novel_interface.show_text_only("Cô gái này trạc tuổi Elluka, nhưng cô ấy lại tỏa sáng trong một dịp xã hội sang trọng như vậy…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Cô ấy xuất thân từ một gia đình quý tộc phải không?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Khi Fabella chuyển sự chú ý của cô ấy sang chủ nhân của mình, tôi lẻn sang phía bên kia phòng tiệc.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Điều này làm tôi phát điên… \\nCậu chủ nhỏ và người giúp việc của cô ấy, phải không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Có vẻ như cô hầu gái sẽ không bắt nạt tôi. \\nCô ấy chỉ muốn lừa tôi thôi sao?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, cậu đến rồi!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Tôi có thể đã tình cờ tìm được một manh mối quan trọng!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Ơ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vừa rồi tôi bí mật theo phái đoàn lên tầng điều hành, ở đó tôi thấy đoàn tùy tùng của Raphael đang mang một chiếc vali đặc biệt.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Một chiếc vali… Có gì trong đó?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Không biết. Nhưng tôi nhớ khóa đào tạo SID đã đề cập đến chất liệu được sử dụng trong vali!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Đó là một kim loại màu xanh xám với ánh sáng xanh nhạt đặc biệt—", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Ánh sáng xanh nhạt… \\nCái gì! Phải không…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Tôi nhớ lại một hợp kim có tác dụng làm giảm hoặc loại bỏ tác dụng của chất kích thích thần kinh và meme Substance H…")
	await novel_interface.show_text_only("Substance H hộp đựng làm bằng hợp kim này có thể tránh được hầu hết quá trình quét màu sắc.")
	await novel_interface.show_text_only("Bản thân hợp kim này là Substance H—98% trong số đó là kim loại đã biết và 2% còn lại là chất chưa biết.")
	await novel_interface.show_text_only("Vì sự khan hiếm nên giá của nó trên thị trường chợ đen đã tăng vọt.")
	await novel_interface.show_text_only("Tôi gần như chắc chắn rằng bất cứ thứ gì trong vali đó đều có liên quan đến Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Mẹ kiếp! \\nBạn đã báo cáo điều này với Mariru chưa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Phái đoàn Salmonton chưa báo cáo với Thượng viện rằng họ sẽ mang theo bất kỳ Substance H nào bên mình.")
	await novel_interface.show_text_only("Bất kỳ sự phá hoại nào Substance H được đưa lậu vào trường lực lượng bảo vệ đều có thể mang lại thảm họa cho New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Tôi nói với cô ấy ngay lập tức. Cô ấy chắc chắn đang xin lệnh khám xét từ Thượng viện ngay bây giờ.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Nhưng tôi chỉ nhìn thoáng qua chứ không chụp ảnh. \\nTôi không nghĩ họ có thể đột nhập vào phòng mà không có thêm bằng chứng nào…", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Đó là lý do tại sao Mariru vừa cập nhật sứ mệnh của chúng tôi là “Bảo mật và tải lên bằng chứng càng sớm càng tốt”.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Nếu vậy thì cơ hội duy nhất là lẻn vào phòng họ…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ừ… phòng con gái. Đây không phải là một nhiệm vụ dễ dàng.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm… Bây giờ chúng ta sẽ phải chơi nó bằng tai.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("Tầng điều hành được dành riêng cho phái đoàn. Chúng tôi đến đó bằng thang máy dịch vụ.")
	await novel_interface.show_text_only("Tôi đẩy chiếc xe chở đồ ăn \"mượn\" về phía hành lang được canh gác nghiêm ngặt. Annie đang ẩn dưới nó…")
	await novel_interface.show_dialog("Này! Không phải bạn đáng lẽ phải tham dự bữa tiệc ở tầng dưới sao? \\nBạn không được phép ở đây. Hãy rời đi ngay bây giờ.", "Bảo mật")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Có quá nhiều nhân viên bảo vệ, chắc chắn rồi…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hả? Nhưng một vị khách từ Royal Suite vừa yêu cầu dịch vụ phục vụ phòng gan ngỗng với rượu whisky rực lửa!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Người đứng đầu trông không có ấn tượng gì cả.")
	await novel_interface.show_text_only("Rõ ràng là tôi đã đánh giá thấp anh ấy. Phải tìm cách khác…")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Uh… Có lẽ Dịch vụ phòng đã nhầm lẫn. Tôi xin lỗi, thưa ông…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi chưa kịp nói xong thì Annie lao ra và dùng gậy bóng chày đập vào cổ anh ta.")
	await novel_interface.show_text_only("Sau đó, cô ấy quay lại và ném một quả bóng chày vào mặt một người bảo vệ khác cách đó 10 thước.")
	await novel_interface.show_text_only("Người bảo vệ còn lại chết lặng trước đòn tấn công. Trước khi anh ấy kịp chạm tới bộ thu phát của mình, Annie đá thẳng vào cằm anh ấy.")
	await novel_interface.show_text_only("Ba người đàn ông gần như gục ngã cùng một lúc. Cây gậy nảy trên sàn và nhảy trở lại tay của Annie.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Rõ ràng!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Cái gì… Bạn đã làm gì thế?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Không có gì. Chỉ để họ nghỉ ngơi một lát thôi.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, đúng là Annie… \\n(Ơn chúa, tôi ở bên cô ấy…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Và cô ấy thậm chí còn không sử dụng bất kỳ phép thuật nào! \\nCô ấy đang được đào tạo kiểu gì…")
	await novel_interface.show_text_only("Sau khi đuổi đám lính canh ra ngoài, Annie đưa tôi đến căn phòng hai cửa ở cuối hành lang.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Đây.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chúng tôi trao đổi một cái nhìn. \\nNgay lúc chúng ta chuẩn bị áp tai vào cửa…")
	await novel_interface.show_text_only("Nó đột nhiên mở ra từ bên trong. Chúng tôi mất cảnh giác và ngã xuống sàn trong phòng.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Ối…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhìn lên, tôi thấy một khuôn mặt quen thuộc, kiêu ngạo.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael được bao quanh bởi một số vệ sĩ và đoàn tùy tùng của cô ấy, với vẻ mặt khinh thường.")
	await novel_interface.show_text_only("Wow, có rất nhiều quý cô trưởng thành và xinh đẹp!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hửm? Bạn có phải là kẻ thích ăn mặc khác giới ở trường học bỏ hoang không? Bạn đang làm gì ở đây?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Trong trang phục hầu gái Pháp! Bạn chưa cảm thấy đủ biến thái sao?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("W…thật trùng hợp! \\nTôi chỉ đang làm việc bán thời gian ở đây với bạn cùng lớp…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ồ, và… phòng tiệc ở tầng dưới phải không? \\nCó thể chúng ta đã đến nhầm chỗ.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Xin lỗi, Annie, tôi nói dối rất tệ!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Điều đó thật kỳ lạ. Nhân viên bảo vệ không ngăn cản bạn sao?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bối rối, Raphael nhìn xuống hành lang.")
	await novel_interface.show_text_only("Raphael kinh hoàng khi tìm thấy các nhân viên bảo vệ, tất cả đều bị đánh gục trên sàn.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("—Bắt chúng lại!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
