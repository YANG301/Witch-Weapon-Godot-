# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru manda via Annie e Elluka proprio mentre torniamo al quartier generale.")
	await novel_interface.show_text_only("Ora sono sconvolto. Non so se verrei interrogato ancora con domande strane...")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("Cosa è successo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("E se non succede nulla? Continuerai a sorridere a Elluka come un pervertito?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu... devi avermi osservato attraverso la telecamera di sorveglianza!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Hehe, è tutto quello a cui riesci a pensare?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cos’altro potrebbe essere…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Per esempio—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru mi guarda malvagiamente dalla testa ai piedi.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Il Dipartimento di Ricerca ha sviluppato un wafer che può decidere anche quando vai in bagno!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("Quale... bagno? \\nUffa, sembra disgustoso!", "Lian")
	await novel_interface.show_dialog("Deve essere stato inventato da Aya! \\nAspetta, non dirmi che me lo hai impiantato di nascosto nel corpo!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Stavo solo scherzando.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Il modo in cui lo dici non è affatto uno scherzo!")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oppure... c'è qualcosa di strano che ti passa per la mente?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Uffa, dannazione...", "Lian")
	await novel_interface.show_dialog("(L'ultima volta che ho fatto le corse durante l'assemblea scolastica...) \\n(Vuol dire...?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahahahah! Non prenderlo sul serio!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ride ad alta voce, massaggiandomi la testa con forza.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya ha realizzato solo un prototipo prima che io annullassi il progetto. \\nPerché dovremmo usarlo su nessuno come te!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Oh, dovrei dire grazie?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha, hai qualcosa di sporco in mente, vero?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh… Meno male che non esiste una macchina per leggere il pensiero! Pensa quanto sarebbe vergognoso!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Ehi, non fare cazzate. È così divertente vederti reagire.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Mi dispiace per averti deluso.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm... mi chiedo come possa un sempliciotto come te estrarre informazioni da obiettivi chiave.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru si asciuga le lacrime dalle risate e assume la sua solita faccia arrogante.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Obiettivi chiave... Sembra più significativo che provvedere a te... Ma perché Mr. Big dovrebbe parlare con un ragazzo delle superiori!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Questa volta ti avvicinerai al tuo obiettivo come studente. L’obiettivo…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, nipote del sindaco di Salmonton. Verrà con la delegazione Salmonton.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("È una vera ragazza di alto lignaggio. Eccitato?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Perché dovrei essere emozionato?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut-tut, ti piacciono solo le bambine, eh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Ehi, smettila di descrivermi come un criminale!", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Ehm. \\nComunque, cosa vuoi che ottenga da questa ragazza nobile?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uffa, non sei un gran chiacchierone... \\nSpero che tu possa farcela almeno un giorno.", "Mariru")
	await novel_interface.show_dialog("Ok, sul serio, cosa sai di Salmonton?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Umm... immagino che sia il più grande esportatore di cibo?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("A proposito di Salmonton… quello che mi viene in mente sono le decine di grattacieli che costeggiano il Reno.")
	await novel_interface.show_text_only("I giardini verdeggianti dietro le serre... \\nCrea sempre sfondi perfetti.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("E ci sono molte chiese. Tutti i cittadini hanno un credo religioso. Hanno persino formato una Sacra Alleanza...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Questo è tutto quello che posso ricordare. Non sono bravo in geografia. Troppa memorizzazione di fatti casuali.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Il potere economico e politico di Salmonton dipende in gran parte dal suo controllo sui geni delle colture.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ma gli incidenti successivi alla scomparsa di Ross Goblet hanno rappresentato per loro gravi minacce.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Per minacce intendi... il flusso spaziotemporale?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Esatto. Secondo le mie informazioni, ha sofferto di molteplici flussi. Ma i danni sono ancora sconosciuti.", "Mariru")
	await novel_interface.show_dialog("A giudicare dalla recente volatilità dei prezzi dei futures del grano, l’impatto sembra piuttosto ampio… Forse si verificheranno carestie sporadiche.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("È grave!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Non so nulla del mercato dei futures. Pensavo che l'impatto fosse limitato ad una piccola area.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Sì... il cattivo raccolto non causerà danni immediati. I paesi hanno comunque riserve di rischio.", "Mariru")
	await novel_interface.show_dialog("Sembra che Salmonton sia la prima a crollare, tra tutte le Città Accademia.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ha inviato una delegazione a New Opulentia, che è già in viaggio.", "Mariru")
	await novel_interface.show_dialog("Essendo il loro principale importatore di prodotti alimentari, non possiamo dire di no.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sospetteranno... di me e di Annie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Questo è quello che farai.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sebbene sia sotto la bandiera di un programma di \"scambio culturale\", la delegazione è stata sotto stretta protezione da parte del Servizio di Sicurezza Reale.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Il Royal Security Service… L'agenzia di intelligence di Salmonton, conosciuta anche come Rosenkreutz.")
	await novel_interface.show_text_only("Per un servizio di intelligence è troppo famoso grazie ai film dell'Agente n. 7.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Causerà qualche problema?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Naturalmente. SID ha persino difficoltà a raccogliere informazioni di base.", "Mariru")
	await novel_interface.show_dialog("Finora, ciò che ti interessa è che la ragazza visiterà la scuola superiore femminile di Gosakuragawa.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La mia scuola?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("C'è da aspettarselo. Ha più o meno l'età di uno studente delle superiori.", "Mariru")
	await novel_interface.show_dialog("Quindi quello che devi fare è scoprire il vero scopo della loro visita.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("I servizi segreti hanno realizzato un opuscolo su Salmonton e la famiglia Dekkers. Adesso vai a leggerlo fino in fondo.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ops, ancora un compito di memorizzazione... \\nCi penso io!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("A proposito, fai attenzione al pervertito mentre torni a casa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("C-cosa!?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
