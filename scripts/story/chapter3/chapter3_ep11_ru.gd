# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Нас окружают телохранители Raphael. Annie подмигивает мне—")
	await novel_interface.show_text_only("Я сразу понял ее точку зрения и выпустил всю силу давления, которую она накопила, когда мы были в коридоре.")
	await novel_interface.show_text_only("Внезапно из него вылетают сотни бейсбольных мячей, поражая одного парня и тут же отскакивая к другому.")
	await novel_interface.show_text_only("Очевидно, никогда не видя этого раньше, телохранители впадают в панику, и их сбивают один за другим.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Я никогда раньше не использовал этот трюк с обычными людьми. Это так хорошо работает…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Конечно! С здравомыслящими людьми гораздо легче иметь дело, чем с безумными ведьмами!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Стреляй! Вы идиоты…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Как вы смеете, смутьяны! Охранники вас не отпустят!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я только заметил, что после боя в королевских апартаментах Raphael царил полный беспорядок, ее телохранители валялись по всему полу.")
	await novel_interface.show_text_only("Annie и я просто хотели пробраться сюда и собрать доказательства, но, похоже, мы устроили серьёзную дипломатическую катастрофу…")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Черт… Annie! \\nC… давай! Свяжи ее!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В панике я даю Annie сумасшедшую инструкцию.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Да! Сделаю!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie ловко сбивает Raphael, разрезает занавеску, упавшую на землю во время боя, и ею быстро связывает борющуюся девушку.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Как ты посмел-!! \\nТы, переодевшийся извращенец! Чего ты хочешь от меня?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Теперь Raphael, почётный гость штата в New Opulentia, внучка мэра Четвёртого Академгорода, привязана к стулу в своём собственном номере —")
	await novel_interface.show_text_only("Annie действительно хорош в этом!! \\nИ похоже, мне никогда не избавиться от репутации извращенца…")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Мне очень жаль, но мы должны позаботиться о том, чтобы вы не включили тревогу…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я указываю на красную кнопку на стене. После ее нажатия группа тяжеловооруженных солдат охраны окружит комнату в течение 3 минут.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Хм, так чего ты хочешь?", "Raphael")
	await novel_interface.show_dialog("Вы не скрываете свою личность и, похоже, у вас нет плана эвакуации — \\nЭто не похищение с целью выкупа, не так ли?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Даже будучи привязанной к стулу, Raphael по-прежнему выглядит уверенно и ясно мыслит… Какая благородная дама.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Кто ты? \\nВы только что использовали Substance H оружие?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ее слова напоминают мне о моей приоритетной задаче на данный момент.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Г-жа Raphael, мы просто хотим выяснить одну вещь. \\nРечь идет об этом чемодане…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Какой чемодан?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael выглядит озадаченным и, похоже, понятия не имеет, что я сказал.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Похоже… он уже сломан!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Что?! Я думал, что сплав должен быть очень прочным!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я смотрю, куда указывает Annie, и вижу чемодан, теперь разбитый с огромными дырами, оставленными летающими бейсбольными мячами.")
	await novel_interface.show_text_only("Черная пластиковая крышка чемодана разбита, обнажая металлический слой, излучающий бледно-голубой свет.")
	await novel_interface.show_text_only("Пластик представляет собой обычную съемную крышку. Annie, должно быть, случайно заметил внутренний слой чемодана.")
	await novel_interface.show_text_only("Замок разрушен, детали и металлические детали разбросаны по ковру.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это странно — мои бейсбольные мячи поражают только живые цели…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael, похоже, также заметил материал, излучающий синий свет. Она выглядит удивленной и нервной.")
	await novel_interface.show_text_only("Среди разбросанного противоударного пенопласта и металлических кусочков я вижу маленькую блестящую штуку.")
	await novel_interface.show_text_only("Это золотой аксессуар в форме бабочки. Благодаря изящным вырезам на крыльях она похожа на настоящую бабочку.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Может быть, именно эта штука... привлекла ваши бейсбольные мячи к чемодану?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Берегись! Это может быть Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Реалистичная золотая бабочка, кажется, готова взлететь в любой момент. Даже Raphael загипнотизирован. Я не могу не обратиться…")
	await novel_interface.show_dialog("Эй, идиот. \\nЯ сказал, не трогай его—", "Mariru")
	await novel_interface.show_text_only("Голос Mariru приходит из ниоткуда. Где-то в моем теле внезапно появляется жужжание. Такое ощущение, будто она говорила рядом со мной.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Э? \\n... Что это!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я осматриваю свое тело, надеясь выяснить, откуда исходит голос, и убедиться, что не вижу где-нибудь говорящих.")
	await novel_interface.show_dialog("Если бы бейсбольный мяч Annie мог оставить такую глубокую дыру в сплаве с твердостью по Роквеллу 70, головы телохранителей были бы разбиты в грязь.", "Mariru")
	await novel_interface.show_dialog("Более вероятно, что маленький гаджет просто хотел использовать удары бейсбольных мячей, чтобы вырваться…", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Эти дырочки… остались от самого аксессуара?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Угу, очень вероятно. Итак, вы все еще хотите прикоснуться к такой опасной вещи?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Подождите, проблема в том — \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Черт возьми! Я нашёл источник её голоса!")
	await novel_interface.show_text_only("Это прямо из моей груди! Неудивительно, что мое тело звенит каждый раз, когда она говорит…")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Как ты мог вживить чип в мое тело?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вы только что случайно раскрыли иностранцу нашу секретную технологию! Хочешь снова получить штамп?", "Mariru")
	await novel_interface.show_dialog("Annie, усыпи даму на некоторое время! \\nНо будьте осторожны. Не обижайте нашего почетного гостя.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Эй! Не смей!..", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie умело бросает нож в шею Raphael, в результате чего она теряет сознание.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Г-же Mariru, Substance H запрещено входить в New Opulentia без официального разрешения, не так ли?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Конечно! Хм, они пронесли это мне под нос! Доктору Dekkers придется объяснить это Сенату.", "Mariru")
	await novel_interface.show_dialog("… Держись! Я думаю, что охранники снаружи привлекли некоторое внимание.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ха, это быстро.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Солдаты охраны внизу собираются в вестибюле. \\nЯ беру команду по сбору мусора, чтобы помочь вам. Мы прибудем через 8 минут.", "Mariru")
	await novel_interface.show_dialog("Annie, немедленно заклей дверь аэрогелем.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Да, мэм!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
