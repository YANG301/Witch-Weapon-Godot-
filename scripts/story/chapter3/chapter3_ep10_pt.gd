# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Graças ao Skurd, parece que Fabella decide me deixar ir.")
	await novel_interface.show_text_only("Assim que Skurd se vira, vários convidados bem vestidos se aproximam e conversam com ela.")
	await novel_interface.show_text_only("A garota tem mais ou menos a mesma idade de Elluka, mas ela brilha em uma ocasião social tão chique…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Ela é de família nobre?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Enquanto Fabella volta sua atenção para seu mestre, eu me esgueiro para o outro lado do salão de banquetes.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Isso está me assustando… \\nPequena mestra e sua empregada, não são?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parece que a empregada não vai me pegar. \\nEla só queria me enganar?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, você está aqui!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Posso ter tropeçado em uma pista importante!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agora mesmo, segui secretamente a delegação até o andar executivo, e lá vi a comitiva de Raphael carregando uma mala especial.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Uma mala… O que há nela?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não sei. Mas lembro que o treinamento SID mencionou o material usado na mala!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("É um metal verde acinzentado com um peculiar brilho azul claro.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Brilho azul claro… \\nO quê! Não é…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Lembro-me de uma liga que reduz ou elimina os efeitos do psicoativo e do meme Substance H…")
	await novel_interface.show_text_only("Os recipientes Substance H feitos desta liga podem escapar da maioria das varreduras de matiz.")
	await novel_interface.show_text_only("A liga em si é um Substance H – 98% dela são metais conhecidos e os 2% restantes são substâncias desconhecidas.")
	await novel_interface.show_text_only("Devido à sua escassez, o seu preço no mercado negro disparou.")
	await novel_interface.show_text_only("Tenho quase certeza de que qualquer coisa naquela mala tem algo a ver com Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Caramba! \\nVocê relatou isso para Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A delegação Salmonton não informou ao Senado que traria qualquer Substance H consigo.")
	await novel_interface.show_text_only("Qualquer Substance H destrutivo contrabandeado para o campo de força de proteção pode trazer uma catástrofe para New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Eu avisei ela imediatamente. Ela deve estar solicitando um mandado de busca ao Senado neste exato momento.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mas eu vi de relance e não tirei nenhuma foto. \\nEu não acho que eles possam invadir a sala sem mais evidências...", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("É por isso que Mariru acaba de atualizar nossa missão de “Proteger e enviar evidências o mais rápido possível”.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Nesse caso, a única chance é entrar furtivamente em seus quartos…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim... o quarto das meninas. Não é uma tarefa fácil.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm… Teremos que tocar de ouvido agora.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("O andar executivo é reservado à delegação. Chegamos lá pelo elevador de serviço.")
	await novel_interface.show_text_only("Empurro o carrinho de serviço “emprestado” em direção ao corredor fortemente vigiado. Annie is hiding under it…")
	await novel_interface.show_dialog("Ei! Você não deveria estar no banquete lá embaixo? \\nVocê não tem permissão para entrar aqui. Saia agora.", "Segurança")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Tantos seguranças, com certeza…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hein? Mas um hóspede da Suíte Real acabou de pedir serviço de quarto de foie gras com uísque flamejante!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O líder não parece nem um pouco impressionado.")
	await novel_interface.show_text_only("Claramente, eu o subestimei. Tenho que encontrar outra maneira…")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Uh… Talvez o serviço de quarto tenha cometido um erro. My apologies, sir…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mal terminei de falar quando Annie sai correndo e bate no pescoço com o taco de beisebol.")
	await novel_interface.show_text_only("Então ela se vira e arremessa uma bola de beisebol bem na cara de outro guarda a 10 metros de distância.")
	await novel_interface.show_text_only("O guarda restante fica pasmo com o ataque. Antes que ele pudesse alcançar seu transceptor, Annie o chuta bem no queixo.")
	await novel_interface.show_text_only("Três homens desmaiam quase todos de uma vez. O taco quica no chão e volta para a mão de Annie.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Claro!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("O que… O que você fez?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Nada. Apenas deixando-os descansar um pouco.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, isso é tão Annie… \\n(Graças a Deus, estou com ela…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E ela nem usou magia! \\nQue tipo de treinamento ela está recebendo...")
	await novel_interface.show_text_only("Depois de tirar os guardas do caminho, Annie me leva para a suíte de porta dupla no final do corredor.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Aqui.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trocamos um olhar. \\nQuando estamos prestes a pressionar nossos ouvidos na porta…")
	await novel_interface.show_text_only("De repente, abre por dentro. Somos pegos de surpresa e caímos no chão dentro da sala.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Awwwwww…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olhando para cima, vejo um rosto familiar e arrogante.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael está cercada por vários guarda-costas e sua comitiva, com uma expressão de desprezo no rosto.")
	await novel_interface.show_text_only("Nossa, tantas mulheres maduras e bonitas!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hum? Você não é aquela aberração travesti daquele lixo de escola? O que você está fazendo aqui?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Em trajes de empregada francesa! Você não está se sentindo pervertido o suficiente?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("O… que coincidência! \\nSó estou trabalhando meio período aqui com meu colega de classe…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ah, e… o salão de banquetes lá embaixo, certo? \\nPodemos ter vindo ao lugar errado.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Desculpe, Annie, sou péssimo em mentir!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Isso é estranho. Os seguranças não pararam você?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Confuso, Raphael olha para o corredor.")
	await novel_interface.show_text_only("Raphael fica horrorizada ao encontrar os seguranças, todos nocauteados no chão.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("—Pegue-os!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
