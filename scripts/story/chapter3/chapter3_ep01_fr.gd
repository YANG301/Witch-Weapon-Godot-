# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Le cauchemar bizarre, la conversation vague, l'ombre dans le rêve. \\nPlus une alerte rouge…")
	await novel_interface.show_text_only("Alors que je suis sur le point d’accepter ma nouvelle identité et de décider de me ressaisir, ils ont encore tout gâché.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hum ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Avez-vous vu les nouvelles ? \\nC'est lui ! Non, moi, c'est moi !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Je ne suis pas aveugle. Bien sûr, je sais que c'est toi juste devant moi, espèce de fille en sueur, idiote.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Non ! \\nMerde. c'est moi aux infos !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Paniqué, je ne sais même pas par où commencer. \\nMariru grogne et me frappe la tête avec sa main.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Quel idiot inutile. Après toutes ces formations, vous ne pouvez même pas faire rapport clairement à votre officier.", "Mariru")
	await novel_interface.show_dialog("Ne s’agit-il pas simplement d’un gars qui vous ressemble qui est recherché dans le monde entier parce qu’il cambriole le centre de collecte et de recherche de la deuxième ville universitaire ?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oui, oui, oui ! Exactement!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Les services de renseignement avaient rapporté la nouvelle bien avant qu’elle ne devienne virale.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Tu as l'air idiot quand tu es terrifié~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru m'a pincé la joue. J'ai essayé de l'arrêter tout de suite.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, soyez sérieux !", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Les plus recherchés dans le monde. Ce n'est pas une blague !", "Lian")
	await novel_interface.show_text_only("Il n'aurait jamais pu me venir à l'esprit qu'un jour je serais aux infos pour Burrary.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Et c'est un avis triple A ! Si je me souviens bien, le dernier homme recherché avec un tel niveau d'alerte a été bombardé à mort en Amérique du Sud par un briseur de bunker.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Ce foutu cambrioleur a volé mon ancienne identité comme ça… Je suis presque en larmes à cette pensée.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Dans ce cas… \\nLe seul sur lequel je peux compter est Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Autant j'ai envie de te voir souffrir comme ça…", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Je dois vous demander de vérifier à nouveau les nouvelles.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("Est-ce nécessaire ? J’ai déjà tout gravé dans ma tête.")
	await novel_interface.show_dialog("L’image n’est peut-être pas nette et claire, mais je suis sûr qu’il me ressemble presque exactement quand j’étais un garçon !", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Pour prouver ce que j'ai dit, j'affiche les nouvelles sur mon téléphone.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Vous voyez, c'est... \\nEh ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'avis de recherche qui m'a fait flipper n'est plus là. Elle a été remplacée par une annonce normale de personne disparue.")
	await novel_interface.show_text_only("Le caricaturiste de soixante-dix ans, M. Inoue, a récemment disparu. \\nSi quelqu'un sait où il se trouve, veuillez contacter immédiatement la police.")
	await novel_interface.show_text_only("J'ai consulté d'autres sites Web et même effectué des recherches par mots-clés, mais les nouvelles étaient introuvables.")
	await novel_interface.show_text_only("En regardant le visage de Mariru, je suis très reconnaissant.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Était-ce vous… ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru vient et essuie mes larmes.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Regardez-vous, tout étouffé.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Si tu veux vraiment me remercier, sois mon esclave alors ~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Et…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Quand tu as dit \"le seul sur qui je peux compter est Mariru\", \\ntu avais l'air si mignon…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru soulève tendrement mon menton avec son index.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hé, arrête ça !", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Autant que je sache, je suis déjà asservi…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("J'aimerais pouvoir faire ça. Mais à ma connaissance, il n’existe qu’une seule agence capable de faire taire l’ensemble des réseaux sociaux du monde entier.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Il doit s'agir d'un décret du Congrès uni.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Le congrès suprême représentant les six Cités Académies… a décidé de retirer la nouvelle ?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Pourquoi…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me regarde et me fait un sourire mystérieux.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ne sois pas stupide. Évidemment, ils n’ont pas fait cela pour protéger le cambrioleur.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ils ne veulent tout simplement pas que le public sache ce qui a été pris.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Qui est ce cambrioleur ? Pourquoi a-t-il utilisé mon identité ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Quel qu'il soit, il doit être un génie pour pouvoir sortir sain et sauf du Centre de Collection et de Recherche d'Akatraz.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Le fait est qu’il n’est pas difficile pour lui de se couvrir le visage.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Mais il ne l’a pas fait, et a même osé monter sur le toit d’un immeuble pendant un moment…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Selon la formation spécialisée, les choses les plus négligeables sont soit absentes de là où elles sont censées apparaître…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Ou sont présents là où ils ne devraient pas être.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
