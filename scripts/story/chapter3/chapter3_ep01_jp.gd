# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("不気味な悪夢、不思議な会話、夢の中の黒い影。\\nそしてネットの海にアップされている……\\n\\nAAA級の指名手配画像……")
	await novel_interface.show_text_only("やっと新しい身分と生活を受け入れて\\n立ち直り始めたって時なのに……\\nそれらが俺の全てを再び狂わせたのだ。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("────マリルッ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ふむ？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("ニュースを見たか？\\n彼……いや、お、俺が現れたぞ！！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("私は盲目ではない。\\n当然、お前が汗まみれのアホみたいな顔して、\\n目の前に立っているのも見えているぞ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("違うよ──\\nくっそ、ニュースの事だよッ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("パニック状態で、どこから話せばいいのか\\n分からなくなった。\\nマリルはフンと鼻を鳴らして、手刀で俺の頭を\\nポカッと叩いた。")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("あれだけ訓練を受けていると言うに、\\nなぜそれを活かせない。\\nこのぐらいの事で長官への正確な報告すらも\\nできなくなるとは……", "マリル")
	await novel_interface.show_dialog("つまりは昔のお前と似た顔をしている誰かが、\\n第二学園都市の収容基地へ強盗に入り込み、\\n全世界に指名手配されたって事だろう？", "マリル")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そうそうっ、そう、その通り！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("ネット上で飛び交っているニュースは、\\n情報部門からとっくに報告があがってきている。", "マリル")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("お前と来たら、顔面蒼白状態で戸惑って、\\n実に滑稽だったぞ～～", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルが俺の口元を左右に引っ張った。\\n俺は慌ててマリルの動かす手を掴んだ。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("……マ～リ～ル～、\\n今はふぉんな冗談を言っふぇる場合ふぁ？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("全世界に指名手配されちゃったんだ。\\nただ事じゃ済まないでしょッ？", "小憐")
	await novel_interface.show_text_only("初めてニュースに載るのが、こんな形だなんて\\n夢にも思わなかったぞ！")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("し・か・もAAA級の指名手配！！　\\n確か以前にAAA級の指名手配を受けた奴が、\\n南米の山奥で地中貫通爆弾による直接爆撃を\\n食らっていたのを覚えているぞっ！！")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("あの強盗犯め……\\n俺の人生を無茶苦茶にしやがって……\\n……そう思ったら急に泣けてきた。")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("こうなったら……\\n頼れるのは、マリルしかいない……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("お前の慌てふためく様子を、\\nもう少し楽しみたかったのだが……", "マリル")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("まあいい、もう一度ニュースを確認してみろ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("再確認する必要なんてあるのか？\\nニュースの内容は完全に覚えているぞ？")
	await novel_interface.show_dialog("画像が荒くて見えにくいけど、俺が男の時の姿と\\n全く一緒だ、ほぼ俺自身だよッ！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("納得せずに口ではそう言った俺だったが、\\nとにかく携帯を取り出して、\\n朝に見たニュースページを開いてみた。")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("ほら、ちゃんと────\\nええッ！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺を混乱の渦に叩き込んだ指名手配のニュースは\\n普通の人探しのお知らせになっていた。")
	await novel_interface.show_text_only("70歳の漫画家井上先生が、ここ数日行方不明と\\nなっております。\\n何らかの情報をお持ちの方は、直ちに警察まで\\nご連絡ください……")
	await novel_interface.show_text_only("他のニュースサイトも確認し、各検索エンジンで\\n検索してみたが、あのニュースは見当たらない。\\n……まるで最初から存在しなかったかのように。")
	await novel_interface.show_text_only("意地悪く笑っているマリルを見て、\\n思わず堪えていた涙が込み上げてくる。")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("マ、マリルがやったのか……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルが俺に近付くと、俺の目尻を軽く拭った。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ほら、泣きそうになっているぞ。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("本当に感謝しているのなら、今後一生私に仕えて\\n馬車馬のように働け～～", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("それに……", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("「頼れるのは、マリルしかいない」\\nと言ってたお前の姿が。\\n実に可愛くてたまらない……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは人差し指で、俺の顎を軽く持ち上げた。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("か、からかわないでよ――ッ！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("そもそも既に、馬車馬のように働かされている…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("しかしまぁ、私がやった──\\nと言いたいところなんだがな。\\n全世界のマスコミを操作するなんて芸当は、\\n現状世界で1つの機関しかできない。", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("えっ？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("『連合議会』からの強制命令だ。", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("『連合議会』って6つの学園都市から構成された\\n最高議会だよな……\\nそれがなんで俺のニュースの隠蔽を命令したの？", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("どうして……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは俺を見つめ、謎の微笑みを浮かべた。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("お前はちょっと思い上がっているようだな。\\n\\n 彼らが今回このような真似に出たのは、\\nお前を守るためにやった訳じゃない。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("盗まれたものが一体何なのか、一般市民に\\n知られたくないだけだ。", "マリル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あの強盗犯はいったい誰で、どうして俺の姿で\\n現れたんだろう？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("アルカトラズ収容基地を強襲して、\\n無傷で逃亡したのは確かに感心したがな。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("しかし問題は、そこまでの実力があるのに、\\n一切顔を隠さなかった点だ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("顔を隠すどころか、屋上で姿を見せた挙句\\nしばらくアイツは悠々と突っ立っていた。", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("以前、訓練で教えてもらった。\\n\\n見落としやすいのは、\\n必要な情報が自然と欠けているものか──", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("分かりやすい情報の裏に、\\n潜んでいる本当の意味か──", "マリル")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
