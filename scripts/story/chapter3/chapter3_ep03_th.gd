# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("คุณหมายถึง… เพื่อล้างข้อมูลบุคคลที่สามทั้งหมดเกี่ยวกับผู้ชายคนนั้นเหรอ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ไม่ ตรงกันข้าม ฉันจะเพิ่มข้อมูลเพิ่มเติม", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อะไรนะ!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("รอยยิ้มเยือกเย็นปรากฏบนใบหน้าของ Mariru")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ตอนนี้ข้อมูลเดียวเกี่ยวกับหัวขโมยเป็นเพียงภาพที่มีความละเอียดต่ำ", "Mariru")
	await novel_interface.show_dialog("ลองจินตนาการดูว่ามีกี่คนในโลกที่มีใบหน้าที่ดูเรียบๆ แบบนี้", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("เดี๋ยวก่อน - คุณเพิ่งพูดว่าธรรมดาเหรอ? นั่นต่อย")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("และถึงแม้บางคนจะดูเหมือน \"ฉัน\" ก็ยังง่ายต่อการค้นหา", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("กล้องวงจรปิดบันทึกทุกอย่างที่เขาทำในวันนั้น!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("แน่นอนว่าการระบุตัวตนที่แท้จริงไม่ใช่เรื่องยาก", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("แต่จะเกิดอะไรขึ้นถ้า… คนนี้ไม่มีอยู่จริง?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คุณหมายถึง...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("หากเราแอบปลอมแปลงตัวตนที่มีลักษณะใบหน้าคล้ายกับผู้ต้องสงสัย ก็แทบจะเป็นไปไม่ได้เลยที่จะค้นพบ", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("และสำหรับทุกคนนอกจากเรา คนพวกนั้นก็ไม่ต่างจาก "+GameConfig.player_name+" — เป็นเพียงผู้สูญหายอย่างลึกลับอีกคนเท่านั้น.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("แล้วจะรู้เป้าหมายที่แท้จริงได้อย่างไร?", "Mariru")
	await novel_interface.show_dialog("หากต้องการซ่อนเมล็ดข้าว ให้คุณนำมันออกไปหรือโรยข้าวทั้งถุงเพื่อกลบ", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("ถือเป็นโครงการใหญ่…", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("ความซับซ้อนเพิ่มเติมเล็กน้อยสำหรับปัญหาง่ายๆ เพื่อให้ผู้เสียภาษีพอใจกับการใช้เงินของตน ดู? นกสองตัวกับหินก้อนเดียว", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("ทุกครั้งที่คุณแสดงความคิดเห็นที่ไม่เหมาะสม ฉันจะแจ้งตำรวจ", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("อย่างไรก็ตาม ฉันพบความขัดแย้งบางประการในข้อมูลประจำตัวของคุณ", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("ฮะ? ส่วนไหน?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("เกี่ยวกับพ่อแม่ของคุณ", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ใจละลายเมื่อได้ยินคำว่าพ่อแม่")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("คุณบอกฉันว่าแม่ของคุณเสียชีวิตเร็ว และพ่อของคุณหายตัวไป", "Mariru")
	await novel_interface.show_dialog("ฉันรู้ว่าคุณไม่อยากพูดเรื่องนี้ แต่มันสำคัญ ฉันต้องตรวจสอบกับคุณ", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("ก็ได้…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru ดึงข้อมูลที่เธอสำรองไว้")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("ข้อความนี้บอกว่าแม่ของคุณหายตัวไปเมื่อวันที่ 25 กรกฎาคม 2026 สันนิษฐานว่าเสียชีวิตแล้ว \\nนั่นคือความทุกข์ยากครั้งใหญ่", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("ก่อนวันนั้น ซากปรักหักพังใต้น้ำทางตะวันตกเฉียงเหนือ New Opulentia เคยเป็นเมืองที่พลุกพล่าน")
	await novel_interface.show_text_only("ฉันมีเพียงความทรงจำที่คลุมเครือเท่านั้น…")
	await novel_interface.show_text_only("ช่วงเวลาที่เมืองถูกทำลายด้วยอาวุธ Devine Touch Aegis ได้สร้างสนามป้องกัน New Opulentia อยู่ตรงขอบของมัน")
	await novel_interface.show_text_only("และ… นั่นเป็นจุดเริ่มต้นของสงครามเจ็ดปี")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("พ่อหายตัวไปตั้งแต่ธันวาคม 2569 สันนิษฐาน...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("หยุด…ได้โปรด!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันเกลียดวลีเย็นชานี้—สันนิษฐานว่า… ตายแล้ว")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("ฉันบอกตัวเองเสมอว่า... \\nบางที... พ่ออาจจะยังมีชีวิตอยู่...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… พ่อของคุณต้องมีความสุข ลูกชายของเขาโตเป็นสาวสวยแล้ว!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันหัวเราะกับคำพูดของเธอ \\nให้ตายเถอะ ฉันรู้ว่าเธอกำลังล้อฉัน!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ดูนี่สิ", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เธอคลิกไปที่โปรไฟล์พ่อแม่ของฉัน รหัสสองอันปรากฏขึ้น")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ตามโปรไฟล์—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("แม่ครับ โค้ดออฟไลน์ครับ \\nพ่อ รหัสออฟไลน์")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… มีอะไรผิดปกติหรือเปล่า?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis จะไม่กำหนดรหัสให้กับแม่ของคุณหากเธอเสียชีวิตก่อนที่จะเปิดใช้งานสนามป้องกันหรือที่ไหนสักแห่งที่อยู่นอกระยะ", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("เอ๊ะ…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru มองมาที่ฉันอย่างครุ่นคิด")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("คุณไม่มีความคิดเหมือนกันเหรอ? \\nไฟล์จะไม่โกหก ฉันจะระวังเรื่องนี้…", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
