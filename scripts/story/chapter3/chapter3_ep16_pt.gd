	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("Você não aprende boas maneiras básicas nesta escola, não é?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Eu sou seu sênior. Mostre algum respeito!", "Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eu não tinha percebido isso até agora… \\nCom uma mochila em mãos, ela veste o uniforme e os sapatos dos alunos do primeiro ano.")
	novel_interface.show_character("ren_uniform","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Achei que você odiava essa escola...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Eu não tive outra escolha. \\nTodas as escolas em New Opulentia são péssimas.", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Como bruxa, esta escola pode ser a melhor escolha para mim.", "Raphael")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Parece que Raphael fez toda a pesquisa e tomou sua decisão em tão pouco tempo. Que gênio.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Sua família… Você contou a eles que é uma bruxa?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Por que se preocupar? Isso não traria nada além de preocupações para eles.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Ei, tornar-se uma bruxa não é nada como entrar para um clube depois da escola!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você pode imaginar que eles me mandaram para o exterior só para me deixar ficar quieto depois daquela entrevista estúpida?", "Raphael")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Se descobrirem isso, provavelmente vão surtar, como quando souberam que eu tinha feito uma tatuagem.", "Raphael")
