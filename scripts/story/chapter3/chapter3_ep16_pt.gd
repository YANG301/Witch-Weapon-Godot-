	novel_interface.change_2nd_expression("thinking")
	await novel_interface.show_dialog("Talvez ninguém além de idiotas como você possa viver uma vida tão otimista.", "Raphael")

	print("=== 第三章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
