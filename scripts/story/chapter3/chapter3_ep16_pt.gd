	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Finalmente conseguindo?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O Senado ordenou que o fizessem? Apenas para manter SID no escuro?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
