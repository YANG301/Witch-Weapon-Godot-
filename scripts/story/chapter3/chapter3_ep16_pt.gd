	await novel_interface.show_dialog("A Borboleta Dourada pertence a uma bruxa e Jacob apareceu de repente e se juntou à luta. \\nPense nisso…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A corrida pelo controle do poder sobrenatural lançou o mundo no caos da Guerra dos Sete Anos. Isso vai acontecer de novo?")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haverá mais bruxas produzidas então?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("É hora de se preparar para essa luta por baixo da mesa.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Algumas semanas depois")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Nnngh ... Mal consigo manter os olhos abertos ... \\nFiquei acordado a noite toda jogando um jogo ...", "Lian")
