	await novel_interface.show_dialog("A propósito… o que diabos você disse na entrevista?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você é da Idade da Pedra ou o quê? Esse vídeo já deveria estar circulando pela Internet.", "Raphael")
