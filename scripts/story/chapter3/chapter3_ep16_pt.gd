	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Falando nisso, também sou bastante popular na Internet. \\nAfinal, sou um criminoso procurado em todo o mundo…")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Para ser justo, devo ter perdido algumas grandes notícias porque fui completamente absorvido por jogar Legend of Zelda.")
