	await novel_interface.show_text_only("A voz familiar…")
	await novel_interface.show_text_only("O lugar familiar…")
	await novel_interface.show_text_only("E a saudação familiar…")
	await novel_interface.show_text_only("A garota que está na minha frente… É ela de novo!")
	await novel_interface.show_text_only("Este encrenqueiro de língua afiada Raphael!")
	novel_interface.show_character("ren_uniform","wail")
