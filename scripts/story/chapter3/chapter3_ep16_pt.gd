	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Não, não, não. Isso é apenas uma brincadeira de criança em comparação com se transformar em uma bruxa! \\nBem, se você realmente tem alguma tatuagem, mostre-a para mim, por favor…")
