# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Ich verlasse das Hauptquartier mit der Broschüre mit allen Einzelheiten über das Jetset-Mädchen. Mariru schickt mir auch Fotos von ihr.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Raphael wurde in eine der Adelsfamilien von Salmonton hineingeboren und ist die Enkelin von Dr. Thomas Dekkers, Präsident der Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Wow ... ich habe in Lehrbüchern über ihn gelesen! \\nDas wird langsam etwas verrückt …", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Habe dich erwischt! Hallo Schatz!")
	await novel_interface.show_text_only("Jemand umarmt mich von hinten.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Waaah –!", "Lian")
	await novel_interface.show_dialog("… Aya, du bist es! Was zum Teufel machst du?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jedes Mal, wenn ich aus einer Flux Area zurückkomme, muss ich mich einer vollständigen körperlichen Untersuchung und Behandlung durch Aya unterziehen.")
	await novel_interface.show_text_only("Ich gebe es nur ungern zu, aber Ayas krakenförmiges Instrument ist sehr hilfreich bei der Wundheilung.")
	await novel_interface.show_text_only("Und ich hasse es, dass ich mich an Ayas psychopathische Handlungen gewöhne ...")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Warum siehst du so enttäuscht aus? \\nIch fange an, mich verletzt zu fühlen.", "Ai")
	await novel_interface.show_dialog("Ich habe mich nicht gut um dich gekümmert, seit du aus dem Umspannwerk zurückgekommen bist ...", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Also werde ich dich zur Schule bringen ... \\nUnd dir unvergessliche Lektionen geben.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Was? Warten…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Nimm deine Hände von mir! Es ist heller Tag!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("Der Perverse Mariru erinnerte mich daran, aufpassen zu müssen … \\nMuss Aya sein!")
	await novel_interface.show_text_only("Aya schleppt mich zum Gesundheitszentrum. Ich kann nichts anderes tun, als auf dem Bett zu liegen.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Nur eine körperliche Untersuchung ... Sie sind zu dramatisch.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Du siehst enttäuscht aus. Bevorzugen Sie eine besondere Behandlung, oder?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nein, danke. \\nNur die regelmäßige Untersuchung, bitte.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(Und deine Routine ist schon etwas Besonderes!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya holt wie üblich das seltsame Instrument heraus. Der Imager blinkt erneut mit unverständlichen Bildern.")
	await novel_interface.show_text_only("Um die Zeit totzuschlagen, zücke ich mein Handy und lese weiter über Raphael.")
	await novel_interface.show_text_only("Sie hat langes und dunkelgraues Haar. Ihre Augen sind violett und scharf, als ob sie bereit wäre, die Gedanken anderer zu lesen.")
	await novel_interface.show_text_only("Wenn ich mir das Foto ansehe, spüre ich, wie mein Herz heftig schlägt und mein Körper unkontrolliert zu zittern beginnt.")
	await novel_interface.show_text_only("Dann komme ich augenblicklich wieder zu Atem. Aya ist mit dem Stethoskop beschäftigt und scheint nicht bemerkt zu haben, was passiert.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(Was ist los?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe das Gefühl, dass ... selbst auf dem Foto etwas in Raphael steckt, das mit dem Instrument in Resonanz steht.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Warum…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Piep – piep –")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Was ist das für ein Geräusch?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Kurve auf dem Bildschirm schwankt stark.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Ups, warum wird es plötzlich wild?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Habe ich Ren dabei erwischt, wie er sich etwas X-Rated ansieht …?", "Ai")
	await novel_interface.show_dialog("Ich habe vergessen, dass du ein Teenager bist!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Nein, ist es nicht!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das seltsame Resonanzgefühl verschwindet.")
	await novel_interface.show_text_only("Wird es von Aya unterbrochen?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Was ist das für ein schwankender Parameter?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Das ist... ein Geheimnis!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Vergiss es.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Entschuldigung. Darf ich reinkommen?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix betritt zügig das Gesundheitszentrum.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Hey, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Hallo, Ren. Ich hatte nicht erwartet, dich hier zu treffen.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix dreht sich verwirrt zum Instrument, als versuche er herauszufinden, was ich tue.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("Was ist das...?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sie zeigt auf das bläuliche vierzackige Gerät in Ayas Hand.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, es ist für Menschenexperimente.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Was? Hast du das gerade direkt gesagt?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ach...", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, Frau Aya, mir geht es nicht sehr gut. Kann ich mich hier ausruhen?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix ist großartig. Wie konnte sie weiter lächeln, ohne Ayas erstaunliche Antwort zu kommentieren?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Kein Problem, Sie können das Bett benutzen. \\nEs wird weitere 15 Minuten dauern, bis ich fertig bin.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya nimmt den Bildschirm vom Instrument ab und verlässt den Raum, um Daten hochzuladen.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Danke.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix nickt Aya zu und legt sich neben mich auf das Bett.")
	await novel_interface.show_text_only("Das Bett ist nur einen Arm entfernt. Nix schließt den Vorhang nicht.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(Sie legt sich einfach so vor einem Fremden hin?) \\n(Ahh ja, wir sind alle Mädchen…)", "Lian")
	await novel_interface.show_dialog("(Verdammt. Mein Herz schlägt schnell.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich drehe mich verstohlen um und schaue sie an. Die Art, wie sie ihr Haar hinters Ohr steckt, ist so anmutig.")
	await novel_interface.show_text_only("Wir sind so nah dran. Ich kann sogar den schwachen Duft an ihr riechen ...")
	await novel_interface.show_text_only("Während ich mich verträumten Gedanken hingibt, dreht sich Nix um und sieht mich direkt an.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Was ist los?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh! Ahh… \\nÄh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich komme plötzlich zur Besinnung und fühle mich wie ein Kind, das beim Streichen erwischt wurde.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("Was soll ich tun? Soll ich etwas sagen?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Nein, warte ... )", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("Ich bin weder nervös noch schüchtern … Es ist …")
	await novel_interface.show_text_only("Da unten spüre ich ein brennendes Gefühl …")
	await novel_interface.show_text_only("Es ist… ein ähnliches Gefühl, als ich das Foto von Raphael sah.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Mist, bin ich so hart, dass mich jedes Mädchen geil macht?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Du siehst blass aus. Fühlst du dich gut?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja... Alles klar, denke ich.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Oh, wer ist das?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix starrt auf mein Handy. \\nSie zieht die Augenbrauen hoch, als sie das Foto auf dem Bildschirm sieht.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("Kennst du sie?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Nein, das tue ich nicht.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Aber Nix sieht angewidert aus …) \\n(Vielleicht habe ich sie falsch verstanden.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
