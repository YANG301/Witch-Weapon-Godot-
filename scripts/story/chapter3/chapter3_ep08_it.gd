# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Mi sentivo irrequieto mentre giravo Raphael per il campus.")
	await novel_interface.show_text_only("Non avrei mai pensato di poter avvicinarmi all'obiettivo così facilmente.")
	await novel_interface.show_text_only("Il vicepreside, vedendo vanificare la sua cerimonia di benvenuto preparata da tempo, pizzica un fazzoletto con risentimento da qualche parte dietro di noi.")
	await novel_interface.show_text_only("La signorina però non sembra soddisfatta del nostro piccolo giro, anche se ora è di umore decisamente migliore.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("È tutto?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Uhm, se intendi il tour.", "Lian")
	await novel_interface.show_dialog("Se continui così arriverai alla zona commerciale.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Molti edifici qui imitano gli stili architettonici prebellici, tentando di portare un senso di cultura.", "Raphael")
	await novel_interface.show_dialog("Ma questo campus è così piccolo che non c’è spazio tra edifici di stili contrastanti.", "Raphael")
	await novel_interface.show_dialog("Questo rende tutto troppo soffocante qui, non credi?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia è una città ricostruita sulle rovine. La maggior parte dei suoi siti storici furono bruciati.")
	await novel_interface.show_text_only("In realtà è piuttosto lussuoso avere un tratto di terra del genere all’interno dello scudo protettivo dove la terra è scarsa.")
	await novel_interface.show_text_only("In qualche modo mi sento offeso dalle sue parole…")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Mhm...", "Lian")
	await novel_interface.show_dialog("Devi essere Raphael Dekkers della Quarta Città Accademica.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Allora perché visiti la scuola se non ti piace qui?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Wow, sai chi sono?", "Raphael")
	await novel_interface.show_dialog("Hm… È tutta colpa di mio nonno. Vuole che studi in un’altra Città Accademica…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ma questa scuola imitatrice senza alcuna storia... non ci avrei mai più messo piede.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Quindi è semplicemente scontenta del piano di suo nonno...) \\n(Perché non ha parlato apertamente?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Merda! Le sue parole in qualche modo mi hanno colpito. Tutti gli edifici della scuola sembrano improvvisamente strani.")
	await novel_interface.show_text_only("Maledizione! Dimentica quei commenti! Ora!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Whoa, visto che sei così deluso...", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Perché non dici a tuo nonno cosa ne pensi?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix si avvicina a noi, elegante come sempre.")
	await novel_interface.show_text_only("Quando i loro occhi si incontrano, mi sembra di sentire il crepitio di una scarica ad alto voltaggio.")
	await novel_interface.show_text_only("Deve essere... un'allucinazione, giusto?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Chi sei?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Beh, non sono proprio nessuno in questa scuola.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Mi sto solo chiedendo cosa ti porta qui, mia signora?", "Nix")
	await novel_interface.show_dialog("Innanzitutto perché hai accettato di venire qui? È a causa della pressione familiare?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Le questioni della mia famiglia non sono affari tuoi.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Fammi indovinare. Una ragazzina egocentrica che non ha mai sfidato la volontà dei suoi genitori.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Perché ti consideri più in alto? Chi ti dà il diritto di giudicare una scuola? Dopotutto, si è offerta volontaria per portarti in giro.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Scusate?! Quando mi sono considerato superiore?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ehi, pervertito. Sono mai stato così altezzoso?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Non proprio…", "Lian")
	await novel_interface.show_text_only("Aspetta, non sono un pervertito!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Vedi? Non ho detto questo.", "Raphael")
	await novel_interface.show_dialog("A proposito, quella cosa attorno al tuo collo...", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("I gioielli sono ammessi in questa scuola?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("In realtà, non abbiamo alcuna restrizione sull'uso di ornamenti...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E la collana di Nix è così carina!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("La band può essere di basso profilo, ma sicuramente non è la gemma: gli Orlov Black Diamond. Questa gemma reale si spezzò in tre pezzi e andò perduta durante le turbolenze prima dello scoppio della guerra.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Probabilmente puoi comprare un paio di edifici qui con un solo pezzo.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cosa?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Fingendosi uno studente normale e parlando a suo nome... Cosa vuoi? Per ingannare questo pervertito travestito che tu sei dalla sua parte?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Smettila di chiamarmi pervertito!")
	await novel_interface.show_text_only("E perché Nix ha questo aspetto sottile e dispiaciuto?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Indosso solo qualcosa che mi sta bene.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("E tu? Cerchi di sembrare indipendente ma sei orgoglioso di goderti la ricchezza della tua famiglia. È divertente.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Ricordo che tutti e tre i pezzi finirono nelle mani di un boss mafioso. Un diamante nero acquistato con denaro illecito: ti sta bene.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Beh, devo ammettere che la mia famiglia è meno fortunata. Dopotutto, non tutti possono guadagnare una fortuna e un titolo nobiliare attraverso il monopolio sui cereali.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Questo perché solo i nostri raccolti potrebbero aiutare le persone a prevenire la peste nera. Meritano di vivere. A differenza di te, marcio dentro e fuori.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Insisti a mantenere la fede mentre minacci il mondo con la fame. Perché non rifletti prima sulla tua anima?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Non ho bisogno di farlo con persone come te. Mi porterà solo vergogna.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Oh, sembra familiare. Nemmeno io voglio conoscere voi perdenti.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Il sole pomeridiano splende dolcemente su di noi.")
	await novel_interface.show_text_only("Stando tra i due, non ho idea di come risolvere questa lotta.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Sei sicuro di non esservi mai incontrati prima?)", "Lian")
	await novel_interface.show_dialog("(Non siete davvero nemici per tutta la vita?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il vice preside in lontananza è già andato fuori di testa e portato via per cure d'urgenza.")
	await novel_interface.show_text_only("Non importa. Ho tutte le informazioni che Mariru desidera.")
	await novel_interface.show_text_only("Non sono affari miei comunque.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
