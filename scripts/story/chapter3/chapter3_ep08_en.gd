# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("I was feeling restless when touring Raphael around the campus.")
	await novel_interface.show_text_only("I never thought I could approach the target so easily.")
	await novel_interface.show_text_only("The vice principal, seeing his long-prepared welcoming ceremony get blown off, nips a handkerchief with resentment somewhere behind us.")
	await novel_interface.show_text_only("However, the young lady doesn't seem satisfied with our little tour, though she is in a much better mood now.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Is that it?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Um-hum, if you mean the tour.", "Lian")
	await novel_interface.show_dialog("If you continue that way, you'll get to the commercial zone.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("A lot of buildings here mimic pre-war architectural styles, attempting to bring a sense of culture.", "Raphael")
	await novel_interface.show_dialog("But, this campus is so small that there’s no buffer between buildings of contrasting styles.", "Raphael")
	await novel_interface.show_dialog("This makes it all too stifling here, don't you think so?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia is a city rebuilt on ruins. Most of its historical sites were burnt down.")
	await novel_interface.show_text_only("It’s actually pretty luxurious to have such a stretch of land within the protective shield where land is scarce.")
	await novel_interface.show_text_only("I somehow feel offended by her words…")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Hm…", "Lian")
	await novel_interface.show_dialog("You must be Raphael Dekkers from the Forth Academic City.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("So why do you visit the school if you don’t like it here?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Wow, you know who I am?", "Raphael")
	await novel_interface.show_dialog("Hm… It's all because of my grandpa. He wants me to study in another Academic City…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("But this copycat school with no history at all… I'd never set my foot on it again.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(So she is simply unhappy about her grandfather's plan…) \\n(Why didn’t she just speak out?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Crap! Her words have somehow affected me. All the buildings in the school suddenly seem weird-looking.")
	await novel_interface.show_text_only("Darn it! Forget about those comments! Now!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Whoa, since you're so disappointed…", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Why don't you just tell your grandpa what you think?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix walks up to us, elegant as she always is.")
	await novel_interface.show_text_only("As their eyes meet, I think I hear the crackling sound of a high voltage discharge.")
	await novel_interface.show_text_only("It must be… a hallucination, right?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Who are you?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Well, I’m a just a nobody at this school.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("I’m just wondering what brings you here, my lady?", "Nix")
	await novel_interface.show_dialog("Why did you agree to come here in the first place? Is it because of the family pressure?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("My family matter is none of your business.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Let me guess. A self-centered kid who’s never defied her parents' will.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Why do you consider yourself higher up? Who gives you the right to judge a school? After all, she volunteered to show you around.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Pardon?! When did I consider myself superior?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Hey, you pervert. Have I ever been so haughty?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Not really…", "Lian")
	await novel_interface.show_text_only("Wait, I’m not a pervert!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("See? I didn't say that.", "Raphael")
	await novel_interface.show_dialog("By the way, the thing around your neck…", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Is jewelry allowed in this school?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Actually, we don't have any restrictions on wearing ornaments…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("And Nix's necklace is so cute!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("The band may be low-key, but definitely not the gem on it—the Orlov Black Diamond. This royal gem broke into three pieces and was lost during the turbulence before the war broke out.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("You can probably buy a couple of buildings here with just one piece.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("What?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Posing as an ordinary student and speaking up for them… What do you want? To fool this cross-dressing pervert that you're on her side?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stop calling me a pervert!")
	await novel_interface.show_text_only("And why does Nix have this subtle, sorry look?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("I'm just wearing something that suits me.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("What about you? You try to look independent but take pride in enjoying your family's wealth. That's hilarious.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("I remember all the three pieces fell into the hands of a mafia boss. A Black Diamond bought with ill-gotten money—it does suit you well.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Well, I have to admit my family is less fortunate. After all, not everyone can earn a fortune and a noble title through the monopoly on grains.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("That’s because only our crops could help people prevent the Black Plague. They deserve to live. Unlike you, rotten inside out.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You insist on keeping faith while you threaten the world with hunger. Why don’t you reflect on your own soul first?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("I don’t need to do that with people like you. It will only bring me shame.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Oh, that sounds familiar. I don’t want to get to know about you losers, either.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("The afternoon sun shines gently on us.")
	await novel_interface.show_text_only("Standing between the two, I have no idea how to settle this fight.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Are you sure you haven’t met each other before?)", "Lian")
	await novel_interface.show_dialog("(Are you really not lifelong enemies?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The vice principal in the distance has already freaked out and taken away for emergency treatment.")
	await novel_interface.show_text_only("Never mind. I've got all the information Mariru wants.")
	await novel_interface.show_text_only("It's none of my business anyway.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
