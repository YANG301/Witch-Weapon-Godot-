# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("We're surrounded by Raphael's bodyguards. Annie gives me a wink—")
	await novel_interface.show_text_only("I get her point right away, and let off all the pressure power she collected when we were in the corridor.")
	await novel_interface.show_text_only("All of a sudden, hundreds of baseballs shoot out, hitting one guy and immediately bouncing towards another.")
	await novel_interface.show_text_only("Obviously having never seen this before, the bodyguards fall into a panic, and are hit down one after another.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("I've never used this trick on ordinary people before. It works so well…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Of course! Sane humans are much easier to deal with than insane witches!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Shoot! You idiots…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("How dare you, troublemakers! The security soldiers will not let you off!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I just notice that after the fight, Raphael's Royal Suite has become a total mess, her bodyguards lying all over the floor.")
	await novel_interface.show_text_only("Annie and I just wanted to sneak in and collect evidence, but we seem to have caused a serious diplomatic disaster…")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Crap… Annie! \\nC… come on! Tie her up!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In a panic, I give Annie a crazy instruction.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Yes! Will do!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie nimbly takes Raphael down, slices open a curtain dropped on the ground during the fight, and with it, quickly ties up the struggling girl.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("How dare you—!! \\nYou cross-dressing pervert! What do you want from me?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Now, Raphael, the state guest of honor in New Opulentia, granddaughter of the mayor of the Fourth Academy City, is tied to a chair in her own suite—")
	await novel_interface.show_text_only("Annie is really good at this!! \\nAnd looks like I can never get rid of the reputation as a pervert…")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("I'm really sorry about this, but we must make sure you won't trigger the alarm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I point to a red button on the wall. Once it's pressed, a team of heavily armed security soldiers will encircle the room within 3 minutes.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, so what do you want?", "Raphael")
	await novel_interface.show_dialog("You are not hiding your identities, and you don’t seem to have an evacuation plan— \\nThis is not an abduction for ransom, is it?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Even when tied to a chair, Raphael still looks confident and thinks clearly… What a noble lady.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Who are you? \\nDid you just use Substance H Weapons?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Her words remind me of my priority task at the moment.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Ms. Raphael, we just want to figure out one thing. \\nIt's about that suitcase…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("What suitcase?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael looks puzzled, and appears to have no clue about what I said.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Looks like… it's already broken!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("What?! I thought the alloy should be very sturdy!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I look where Annie is pointing and see the suitcase, now broken with huge holes left by the shooting baseballs.")
	await novel_interface.show_text_only("The black plastic cover of the suitcase is shattered, revealing a metal layer giving off pale blue light.")
	await novel_interface.show_text_only("The plastic is a common detachable cover. Annie must have happened to notice the inner layer of the suitcase.")
	await novel_interface.show_text_only("The lock is destroyed, with the components and metal pieces scattering on the carpet.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("It's weird—my baseballs only target living targets…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael appears to have also noticed the material that emanates blue light. She looks surprised and nervous.")
	await novel_interface.show_text_only("Amid the scattered shockproof foams and metal pieces, I see a small glittering thing.")
	await novel_interface.show_text_only("It's a butterfly-shaped golden accessory. With delicate cut-out patterns on the wings, it looks like a real butterfly.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Could it be this thing… that attracted your baseballs to target the suitcase?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Watch out! It could be a Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The lifelike golden butterfly seems ready to fly at any moment. Even Raphael is mesmerized. I can't help reaching out…")
	await novel_interface.show_dialog("Hey, idiot. \\nI said don't touch it—", "Mariru")
	await novel_interface.show_text_only("Mariru's voice comes out of nowhere. Somewhere in my body suddenly feels buzzing. It feels like she was speaking next to me.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Uh? \\n… What’s that!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I scout around my body, hoping to find out where the voice was from and make sure I don't see any speakers somewhere.")
	await novel_interface.show_dialog("If Annie's baseball could leave such a deep hole on the alloy with a Rockwell hardness of 70, the heads of the bodyguards would have been smashed to mud.", "Mariru")
	await novel_interface.show_dialog("It's more likely that the small gadget just wanted to use the baseballs' shocks to break out…", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Those holes… were left by the accessory itself?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh-huh, very likely. So, do you still want to touch such a dangerous thing?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Wait, the problem is— \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Damn it! I find the source of her voice!")
	await novel_interface.show_text_only("It's right from my chest! No wonder my body feels buzzing every time she speaks…")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("How could you plant a chip in my body!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You just casually revealed our secret technology to a foreigner! Wanna get stamped again?", "Mariru")
	await novel_interface.show_dialog("Annie, get the lady asleep for a while! \\nBut be careful. Don't hurt our guest of honor.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Hey! Don’t you dare—!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie skillfully throws a knife-hand at the back of Raphael's neck, putting her into a blackout.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ms. Mariru, Substance H is prohibited from entering New Opulentia without official approval, isn’t it?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Of course! Humph, they smuggled this under my nose! Dr. Dekkers will have to explain this to the Senate.", "Mariru")
	await novel_interface.show_dialog("… Hang on! I think the security guards outside have attracted some attention.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Huh, that’s fast.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Security soldiers downstairs are gathering in the lobby. \\nI'm taking the Collection Team to help you. We'll arrive in 8 minutes.", "Mariru")
	await novel_interface.show_dialog("Annie, seal the door with aerogels now.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Yes, ma'am!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
