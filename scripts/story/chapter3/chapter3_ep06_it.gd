# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Esco dal quartier generale con il libretto che riporta tutti i dettagli della ragazza del jet set. Mariru mi manda anche messaggi con le sue foto.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Nato in una delle famiglie nobili di Salmonton, Raphael è la nipote del dottor Thomas Dekkers, presidente della Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Wow… ho letto di lui nei libri di testo! \\nLa situazione sta diventando un po' pazzesca...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Preso! Ciao tesoro!")
	await novel_interface.show_text_only("Qualcuno mi abbraccia da dietro.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Waaah—!", "Lian")
	await novel_interface.show_dialog("… Sì, sei tu! Che diavolo stai facendo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Devo sottopormi ad un esame fisico completo e ad un trattamento da parte di Aya ogni volta che torno da un'Area Flux.")
	await novel_interface.show_text_only("Odio ammetterlo, ma lo strumento a forma di polipo di Aya è molto utile per curare le ferite.")
	await novel_interface.show_text_only("E odio il fatto che mi sto abituando alle azioni psicopatiche di Aya...")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Perché sembri così deluso? \\nComincio a sentirmi ferito.", "Ai")
	await novel_interface.show_dialog("Non mi sono preso cura di te da quando sei tornato dalla sottostazione...", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Quindi ti porterò a scuola... \\nE ti darò delle lezioni indimenticabili.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Cosa? Aspettare…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Toglimi le mani di dosso! È in pieno giorno!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("Il pervertito Mariru mi ha ricordato di fare attenzione a... \\nDeve essere Aya!")
	await novel_interface.show_text_only("Aya mi trascina al centro sanitario. Non posso fare altro che sdraiarmi sul letto.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Solo un esame fisico... Sei eccessivamente drammatico.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Sembri deluso. Preferisci un trattamento speciale, eh?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, grazie. \\nSolo il controllo regolare, per favore.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(E la tua routine è abbastanza speciale!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya tira fuori lo strano strumento come al solito. L'imager lampeggia ancora una volta con immagini incomprensibili.")
	await novel_interface.show_text_only("Per ammazzare il tempo, tiro fuori il cellulare e continuo a leggere di Raphael.")
	await novel_interface.show_text_only("Ha i capelli lunghi e grigio scuro. I suoi occhi sono viola e taglienti, come se fossero pronti a leggere nella mente delle persone.")
	await novel_interface.show_text_only("Guardando la foto, sento il mio cuore battere violentemente e il mio corpo inizia a tremare in modo incontrollabile.")
	await novel_interface.show_text_only("Poi riprendo fiato, tutto in un istante. Aya è occupata dallo stetoscopio e non sembra essersi accorta di quello che sta succedendo.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(Cosa c'è che non va?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sento che... anche attraverso la foto, c'è qualcosa in Raphael che risuona con lo strumento.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Perché…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bip... bip...")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Cos'è quel rumore?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La curva sullo schermo fluttua bruscamente.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Ops, perché tutto all'improvviso si scatena?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Ho sorpreso Ren a controllare qualcosa di vietato ai minori...?", "Ai")
	await novel_interface.show_dialog("Avevo dimenticato che sei un adolescente!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("No, non lo è!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La strana sensazione di risonanza scompare.")
	await novel_interface.show_text_only("Is it interrupted by Aya?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Qual è questo parametro fluttuante?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Questo è... un segreto!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Lascia perdere.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Scusami. Posso entrare?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix entra a passo spedito nel centro sanitario.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Ehi, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Ehi, Ren. Non mi aspettavo di incontrarti qui.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix si gira verso lo strumento, con aria perplessa, come se cercasse di capire cosa sto facendo.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("Cos'è questo...?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Indica il dispositivo bluastro a quattro punte nella mano di Aya.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, è per esperimenti umani.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cosa? L'hai appena detto apertamente?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Oh...", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, signorina Aya, non mi sento molto bene. Posso riposarmi qui?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix è fantastico. Come poteva continuare a sorridere senza commentare la sorprendente risposta di Aya?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Nessun problema, puoi usare quel letto. \\nCi vorranno altri 15 minuti per finire quello che sto facendo.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya toglie lo schermo dallo strumento ed esce dalla stanza per caricare i dati.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Grazie.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix fa un cenno ad Aya e si sdraia sul letto accanto a me.")
	await novel_interface.show_text_only("Il letto è a solo un braccio di distanza. Nix non chiude il sipario.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(Si sdraia così davanti a uno sconosciuto?) \\n(Ahh sì, siamo tutte ragazze...)", "Lian")
	await novel_interface.show_dialog("(Dannazione. Il mio cuore batte forte.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi giro di soppiatto, sbirciandola. Il modo in cui si sistema i capelli dietro l'orecchio è così aggraziato.")
	await novel_interface.show_text_only("Siamo così vicini. Posso persino sentire la leggera fragranza su di lei...")
	await novel_interface.show_text_only("Mentre mi concedo pensieri sognanti, Nix si gira e mi guarda dritto negli occhi.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Che succede?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oh! Ahh... \\nUh...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("All'improvviso torno in me e mi sento come un bambino sorpreso a fare uno scherzo.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("Cosa devo fare? Dovrei dire qualcosa?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(No, aspetta ...)", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("Non mi sento nervoso o timido... È...")
	await novel_interface.show_text_only("Sento una sensazione di bruciore laggiù...")
	await novel_interface.show_text_only("È... una sensazione simile quando ho visto la foto di Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Cavolo, sono così duro al punto che qualsiasi ragazza mi fa arrapare?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sembri pallido. Ti senti bene?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì... va bene, penso.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Oh, chi è quello?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix sta fissando il mio cellulare. \\nAlza le sopracciglia vedendo la foto sullo schermo.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("La conosci?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("No, non lo so.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Ma Nix sembra disgustato…) \\n(Forse ho capito male.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
