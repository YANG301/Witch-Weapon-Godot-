	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("まあ、ギアーズ博士は一貫して秘密主義者だ。\\n\\nあの顔面神経麻痺のポーカーフェイスジジイが\\n何を実際やったのか、私も完全に把握してない。", "マリル")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（ポーカーフェイス……ジジイ）\\n\\n元老院はSIDと情報共有をしないのか？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("お前はアホの子か……", "マリル")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("情報組織というのは、自国の元首や統治者に対し\\n情報を完全に共有する事などありえない。", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("えっ──マジで！？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("情報とは、すなわち権利。\\nKnowing is Owningだ。", "マリル")
	await novel_interface.show_dialog("元老院は新豊洲各方面の権利の統合者だ。\\n\\nSIDと元老院は、ただ本来の立場に基づいた\\n協力関係に過ぎない。", "マリル")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("さて、ここで問題だ。\\n\\nお前は会社の機密情報をパートナーに、\\n無償で渡すか？", "マリル")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("う～ん……そりゃ……当然しないね……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("相手が価値のある秘密情報を擁していた場合、\\nどうしてもそれを知りたいとすれば？", "マリル")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うーん……\\n清掃員でも買収するかな？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("その通り。\\n相手組織の人数が多ければ多いほど、\\nどれだけ厳重な安保協議も、社会工学によって\\n破る事が可能となる。", "マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("でも、そ、その説明だと……\\nSIDの内部にもスパイがいるって事だよな！？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("うちのスタッフは1万人以上いるからな。\\n潜り込まれている可能性は少なくないだろう──\\n元老院、外国情報機関や各種組織も含めてな。", "マリル")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("だから、結局は重要な情報の流通範囲を、\\nしっかりと制限しておけばいいという話なのだ。", "マリル")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それじゃ『象牙のロビー』の中にも……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("お前がそんな心配をしなくてもいい。\\n\\n元老院のお膝元は、お前のような甘い考えで\\n侵入できる場所ではないからな。", "マリル")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("元老院のメンバーは全員が異質物研究の権威だ。\\nSS級の科学者である事なんて、\\n基本的な条件に過ぎない。", "マリル")
	await novel_interface.show_dialog("彼らは試験的な異質物の道具をいくつも所持して\\nいる。\\nお前が潜入したところで、知らない間に\\n洗脳されるのがオチだ。", "マリル")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("しかし今回の事件って……疑問点が満載だな。", "小憐")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("例えば、なんでサモントンの視察団の人達が、\\n黄金バタフライを新豊洲に密輸したんだ？", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("ラファエルの例のネックレスだって、\\nすごい年代物って感じでさ。\\nそれを本人も嫌がっている様子で、\\n服の中に隠していたようだし。", "小憐")
	await novel_interface.show_dialog("だけど、ラファエルの性格からすると……\\n嫌なものを、自分から着けないはずだしなぁ……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("確かに、『黄金バタフライ』の特性は感染性の\\nミーム類異質物と酷似している。\\n普通ならトラック並みの保管装置に収容しても\\n不十分なぐらいだ。", "マリル")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("しかし彼らはそれをアタッシュケースの中に\\n無理矢理詰め込み、\\n結果として溢れ出たエナジーは、\\n衛星でも検出できてしまうほどだった。", "マリル")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("それに、本当に密輸目的だとしたら、\\n国の公式使節による運搬なんぞ下策。\\nなぜここまで大きな政治的リスクを冒したのか？", "マリル")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("元々そのリスクとかは存在していなくて、\\nあるいは依頼主が保証できる人間だとすると……", "小憐")
	await novel_interface.show_dialog("視察団の荷物は税関に申告する必要がない。\\n\\nそしてわざわざ、俺達が管轄権を持ってない\\nホテルを選んだ……", "小憐")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("まさか……！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("ようやく気付いたか？", "マリル")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("元老院がサモントンに要求したのか？\\nSIDを蚊帳の外に置くために……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("あのヤコブという男は第三学園都市の人間だ。\\nイルカのデータから察する限り、\\n奴は長きに渡り、魔女を研究してるみたいだな。", "マリル")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("黄金バタフライも魔女と関係している。\\nそしてヤコブの横槍も入った。\\nこれらの事象を結び付ければ……", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("七年戦争中に浮上したっていう、\\n特殊な力をコントロールしようと企む連中が、\\n再び台頭してきたというのか？")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("製造された魔女……\\n今後はさらに増えるのか……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("どうやら私達も水面下で、力比べの準備を\\nしなければならないようだな。", "マリル")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("　―　数週間後　―")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("はぁあ──眠い～～……\\n\\n昨夜はバッテリーが切れるまで、\\nケンタウロス相手に周回していたからなぁ……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ったく　相変わらずね、女装癖。")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("？？？？？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("覚えのある声……")
	await novel_interface.show_text_only("覚えのある場所……")
	await novel_interface.show_text_only("覚えのある呼称……")
	await novel_interface.show_text_only("俺の目の前に現れたのは、やはりあの……")
	await novel_interface.show_text_only("手に負えない毒舌お嬢様。ラファエル！")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("ラ、ラファエル？\\nなんで来たの？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("この学校は礼儀に対して、ここまで非礼で\\n返すように教育しているのかしら？", "ラファエル")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("今後あんたはラファエル「先輩」と呼びなさい。", "ラファエル")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("へっ！？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ラファエルに言われてから気付いたけど……\\n\\n彼女はカバンを持っているし、\\n学校指定である二年生の靴も履いている。")
	novel_interface.show_character("ren_uniform","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","mock",0.25)
	novel_interface.character_2nd_dark()
