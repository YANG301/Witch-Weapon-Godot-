	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("多くの人々が神の名の元に戦争を起こしている。\\n\\n私にそれを言っちゃいけない理由なんて、\\n一体どこにあるのかしら？", "ラファエル")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("戦争？　七年戦争……の事？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("もちろん新しい戦争の事よッ！", "ラファエル")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("元々サモントンの主張は、人に必要なのは\\n信仰だけであるというものよ。\\nあらゆる信仰にも包容的な態度を取っている。", "ラファエル")
	await novel_interface.show_dialog("だけど戦後の大移民のせいで、廃棄物の寄せ集め\\nみたいな愚かな団体が徐々に貪欲となったわ。\\n彼らは今でも果てのない利益と権利を\\n要求し続けている。", "ラファエル")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("お爺様は彼らに寛容すぎるわ。\\n\\nああいう役立たずのゴミどもは全部屠殺所に\\n送ればいいのに……", "ラファエル")
