	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("やめて……、そんな目で見るなよ……", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("携帯で検索すると、ニュースランキングで\\nラファエルの名前がトップに載っていた。")
	await novel_interface.show_text_only("再生ボタンを押すとラファエルの声が聞こえる。")
	await novel_interface.show_dialog("なぜ人は、「神に祈れば救われる」と\\n皆、思っているのかしら？\\nそれは尻尾を振りながら哀れみを求め、\\n自己の慰めを望んでいるだけに過ぎないわ。", "ラファエル")
	await novel_interface.show_dialog("……「ろくでなし」は、どこへ行こうと\\nただの「ろくでなし」よ。\\nなんでこの国はこんな連中を飼ってるのかしら？\\n泥中で腐らせて肥料にすれば、まだマシなのに。", "ラファエル")
	await novel_interface.show_text_only("サモントン総督の孫娘として、\\n随分インパクトのある発言だなおいッッ！！")
	novel_interface.show_character("ren_uniform","speechless")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","worry",0.25)
