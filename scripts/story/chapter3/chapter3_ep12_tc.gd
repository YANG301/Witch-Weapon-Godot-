	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("那種「訊息」其實是可以切割和分塊儲存的，魔導器就是能儲存這種小塊「訊息」的載體。", "安妮")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("至於為什麼有這種設計，我猜可能是為了方便人們探求自己的極限吧……", "安妮")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("為了測試自己在不喪失理智的情況下所能承受的極限，而靠魔導器一點一滴地吸收魔法的知識？", "小憐")
	await novel_interface.show_text_only("這件事聽起來就很瘋狂了！")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("會不斷地如飢似渴地追求新的知識，不如說這就是人類的天性吧……", "安妮")
	await novel_interface.show_dialog("就算註定會走向毀滅……", "安妮")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("如果沒有足夠天賦的普通人接觸到魔導器，\\n是不是就會變成變電所的女巫那樣……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("很有可能，而且魔導器上沒有覆蓋結界，任何人都可以直接觸碰。", "安妮")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("這樣不是超級危險！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──轟！ \\n──轟！")
	await novel_interface.show_text_only("突然間，房外傳來木質大門受到重擊的聲音。")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("是保安警察！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("只撞了兩下，皇室套房的大門就被破門錘砸爛了。")
	await novel_interface.show_text_only("──咚～──咚～──咚～\\n──咚～──咚～──咚～")
	await novel_interface.show_text_only("隨後傳來的，是破門錘徒勞無功地砸在硬化氣凝膠上的聲音。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("應該能撐到莉琉小姐到吧……\\n愛衣博士的裝備真厲害呢。", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我摸了摸自己被強行添加了擴音器功能的胸部。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("啊哈哈，雖然體檢時總是怪怪的……\\n但是她的確很厲害呢……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然，不知何時醒來的拉斐爾連著綁著她的椅子一同朝我撞了過來。")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("絕不會……絕不會讓妳拿走任何東西！", "拉斐爾")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("妳這個內建音響的死變態！ ！", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("拉斐爾趁著椅子倒地的撞擊掙脫了束縛，緊接著就想搶走落在地上的黃金蝴蝶。")
	await novel_interface.show_text_only("我見狀立即撲了過去，眼看馬上就要和拉斐爾撞在一起──")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("不行啊！ 小憐！ ！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("砰──！")
	await novel_interface.show_dialog("（欸？ 是我搶到了嗎？ ）\\n（不太對……）", "小憐")
	await novel_interface.show_dialog("（這種柔軟的觸感……）", "小憐")
	await novel_interface.show_dialog("（還有熟悉的手感，似乎不久前還摸到過……）", "小憐")
	await novel_interface.show_dialog("（等等，難道……！ ）", "小憐")
	await novel_interface.show_dialog("你……你這個！", "拉斐爾")
	await novel_interface.show_dialog("臭流氓！ ！！", "拉斐爾")
	await novel_interface.show_text_only("──啪！")
	await novel_interface.show_text_only("一個清脆的巴掌後，一陣失重的眩暈感傳來。")
	await novel_interface.show_text_only("許多支離破碎的影像碎片在我的腦海中閃過，周圍的聲音在剎那間全消失了。")
	await novel_interface.show_text_only("我好像進入了另一個世界。 但那種奇怪的感覺，轉瞬即逝。")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("當我再次睜開雙眼時，發現自己依舊站在酒店的房間裡。")
	await novel_interface.show_text_only("但那個黃金蝴蝶好像活起來了，展翅飛到我的胸口上，形成了一道耀眼的閃光。")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("怎麼會……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("當光芒化作星沙，緩緩消失之後，我感覺臉頰被輕柔的撫過，有一種奇妙而溫軟的觸感刻到了心裡。")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("──咦？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("房間原本的空地上，出現了一位美艷動人的女性。")
	await novel_interface.show_text_only("淡紅的雙眸與長髮，修長的身形，柔白無瑕的肌膚，令人無法移開目光……")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("（發生什麼事情了？ ？）\\n（嘴唇，剛剛好像被什麼給碰了一下！ ）", "小憐")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（……哈哈哈，不對不對！ ）\\n（我在想什麼呢，才不可能發生這種好事呢！ ）", "小憐")
	await novel_interface.show_dialog("（不、不可能的！ ！！ ）", "小憐")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("（糟糕，這種感覺，這種感覺……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("啊，終於感受到久違的溫度了。", "突然降臨的女性")
	await novel_interface.show_dialog("晚安啊，各位年輕的小姐～", "突然降臨的女性")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我的心跳不斷加快，情不自禁地靠近她，四肢完全不聽使喚。")
	await novel_interface.show_text_only("眾目睽睽下，我張開雙臂，用力抱住了她。")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("哎，這位漂亮的小姐，妳身體不適嗎……？", "突然降臨的女性")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("請問……", "小憐")
	await novel_interface.show_dialog("可以告訴我妳的名字嗎……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("奇怪，對方似乎不斷變重……\\n連體溫也不斷地升高……")
	await novel_interface.show_text_only("我到底是……怎麼了啊！ ！")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("……哎呀呀！ \\n這還真是不可思議呢。", "突然降臨的女性")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("！ ！？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("──小憐！ ！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮一把將我從對方懷裡拉開。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("妳……究竟是誰？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("呵～如果我的名字在這個時代沒有被列入禁忌的話……請叫我貝阿特麗切吧。", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("不但人美，連名字都好好聽喔……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("小憐……\\n小憐好像變成花痴了啊！ ！", "安妮")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
