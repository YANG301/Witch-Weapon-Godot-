	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("唔，怎麼說好呢……", "安妮")
	await novel_interface.show_dialog("所謂魔法，其實是一種特殊的「訊息」經由人的大腦轉化而成的「知識」。", "安妮")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("但人類想要獲得和累積這種知識，往往是以喪失理智做為代價……", "安妮")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("我想到了之前在變電所遇到的女巫和異變空間中的那些敵人。")
	await novel_interface.show_text_only("那就是因為獲得了自己無法承受的「知識」，反而完全喪失了理智吧。")
