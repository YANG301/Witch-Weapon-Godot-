# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("「氣凝膠噴霧」是愛衣博士發明、像髮膠一樣的罐裝噴劑，可以瞬間噴出超大量的泡沫。")
	await novel_interface.show_text_only("泡沫接觸空氣後會快速膨脹並凝固，凝固後的強度可以抵抗步槍子彈的衝擊。")
	await novel_interface.show_text_only("安妮拿著氣凝膠噴霧在房門周圍忙碌的時候，我的注意力再次被地上的黃金蝴蝶吸引了。")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("（看上去只是精巧的藝術品嘛……）", "小憐")
	await novel_interface.show_dialog("（但是……忍不住……好想摸摸看……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我感到小腹一陣發熱，眼前的光亮不斷擴散，情不自禁地想要伸出手──")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("喂！ ！小憐！ ！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮一把抓住了我的手腕，我才突然回過神來。")
