# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("本部に戻るや否や、マリルはアニーとイルカを\\n別の任務に送り出した。")
	await novel_interface.show_text_only("また妙な尋問をされる予感がして、\\n俺は内心不安になる……")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("何かあったの？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("何もなければ、イルカの隣でずっと変態みたいな\\nニヤケ面を晒し続けるつもりだったか？", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("なっ…！や、やっぱり学校の監視カメラで\\n盗み見していたな！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("はっはっはっ～～\\nお前はそんなダサい方法しか思いつかないのか？", "マリル")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("えっ…それ以外にどうやって……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("例えばだな──", "マリル")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("マリルは俺を上から下まで嘗め回すように見つめ\\n邪悪な表情を浮かべる。")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("戦術研究部にとある特殊なチップがある。\\n\\nそれを植え付けてしまえば、排泄欲求まで\\n完全にコントロールが可能だ。", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("コ、コントロールッ？\\nま、マジでそれは倫理的にダメなやつ！", "小憐")
	await novel_interface.show_dialog("そんな怪しい物、どうせ愛衣の発明だろうけど…\\n\\nって、ちょっと待って！\\nあんたら、まさかそれを俺に……っ！", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("────冗談だ。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そんな適当な返事をされても、まったく冗談に\\n聞こえないからな！")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それともなんだ……何か心当たりでもあるのか？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("うっ……それは……", "小憐")
	await novel_interface.show_dialog("（この前の全校集会で並んでいた時に……\\n 　突然お腹が痛くなったのは……）\\n（も、もしやッ！？）", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……ぷっ、くくははは～～\\n本気でそんなモノを埋め込まれたと思ったのか？", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("マリルは大笑いしながら、俺の頭を揉みしだく。")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そんなモノ、愛衣がプロトタイプを作った時点で\\n私が厳しく叱っている。\\nそ～もそも、お前みたいな無意味な目標に\\n超高度テクノロジーを使う必要がないしな～", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("そりゃ、ありがたい事で……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ところで、先程はど～んな恥ずかしい事を\\n思い出していたのかな～～？", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ううっ……\\n思考を可視化できる機械とかなくて良かった。\\nじゃないと……\\nどこかの穴に入らなくちゃいけなくなる。")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("なんだ、すぐ諦めたような顔をするな。\\nそれでは面白さがなくなるじゃないか。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("……がっかりさせて、悪かったな。")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("やれやれ。現在のお前の能力で重要人物から、\\n情報を聞き出すという任務を全うできるか……", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("マリルは笑いすぎで出てきた涙を拭き、\\nいつもの自信満々の表情に切り替える。")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("重要人物って……マリルの悪趣味を\\n満足させるよりは、よっぽど有意義と思うけど。\\nでも一介の学生ごときに何が聞き出せるんだよ。", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そう今回はまさに、お前のその学生という身分を\\n利用するんだ。\\n今回の目標は第四学園都市視察団の代表──", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("サモントン市長の孫娘、ラファエル・デックス。\\n\\n正真正銘、貴族のお嬢様だぞ。", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("どうだ、すごい興奮するだろう？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("何にだよッ！", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ふむ、やはりお前はちっちゃな女の子にしか、\\n興奮できないのか……", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("その危険人物設定を俺に押し付けるなッ！", "小憐")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("……ゴホンっ。とっ…とにかく、\\nそのお嬢様から何を聞き出したいんだ？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("話題をそらす技術が下手だなぁ……\\n一瞬でバレそうで心配だ。", "マリル")
	await novel_interface.show_dialog("まあ、それはさておき。\\n\\nお前は、第四学園都市についてはどれぐらい\\n知っている？", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("え――っと……確か現在は、最大の食料輸出国\\nって事は知っているけど……", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("サモントン市の第一印象は、ライン河畔に林立した数十階にも及ぶ立体温室が印象に残っている。")
	await novel_interface.show_text_only("温室群のガラス窓を覗くと、生気に満ち溢れる\\n緑色が見える。\\nディスプレイの壁紙として人気だったはずだ。")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("そう言えば、サモントンって教会が多くて\\nみんなが信心深いんだっけ。\\n『神聖同盟』とか言うのも設立してたり……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("覚えているのはこれぐらいだ。\\n\\n地理とかいう知識の丸暗記科目を思い出すと、\\n頭も胃もダブルで痛くなった。")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("第四学園都市の経済と発言力の根源は、\\n農作物の遺伝子コントロール技術に、\\n大きく依存している。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("しかし『ロス・ゴールド』が消えた後に\\n起き始めた一連の事件が、\\n彼らの根源を揺るがす脅威となった。", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("脅威って言うと……空間異変の事？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("そうだ、第四学園都市の領内にて異変多発との\\n報告があった。\\n実際の損失状況は不明ではあるが……", "マリル")
	await novel_interface.show_dialog("ここ数日の穀物と豆類における先物取引の異様な\\n価格変動から察するに、\\n影響はそれなりに大きいと見える……\\n一部地区に飢饉が起こる可能性もあるだろう。", "マリル")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そんなに深刻なのか……", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("その先物なんちゃらは詳しくないけど、\\n\\n空間異変の脅威は限られた範囲だけのものだ\\nと思っていた。")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("そうだな。食糧減産の影響は、通常ある程度\\n遅れてからやって来るものだ。\\nそれに、各国にはリスクに対して備えもある。", "マリル")
	await novel_interface.show_dialog("だが、どうやら他の5つの学園都市の内で、\\n最初に我慢できなくなったのは彼らのようだ。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("サモントンは視察団を結成し、すでに新豊洲へと出発している。", "マリル")
	await novel_interface.show_dialog("こちらとしても主要食糧輸入国として、\\n彼らの要求を拒否する事はできない。", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("もしかして……俺とアニーが疑われているのか？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("さあ、どうだろうかな……？\\n兎にも角にも、この視察団が非常に厄介だ。", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("何か問題があるのか？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("今回彼らは『芸術交流』という名目を掲げて、\\n新豊洲までわざわざ来て下さる訳だが。\\n彼ら視察団の安全管理を務めているのが、\\nどうやら皇家保衛局らしくてな。", "マリル")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("皇家保安局……第四学園都市の情報機関\\n別名『十字薔薇』（Rosenkreutz）\\n優秀なのは言わずもがな。")
	await novel_interface.show_text_only("諜報機関なのに割と有名なのは、この機関に\\n所属していたエージェント77（ダブルセブン）\\nを描いた有名映画シリーズが出ているせいだ。")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それって相当厄介じゃないのか？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("そうだ、SIDも動きが制限されており、\\n調査を行いたくても、中々手が届かない。", "マリル")
	await novel_interface.show_dialog("お前と関係してくるのはここからだ。\\n現在入手した情報によれば、例の貴族のお嬢様は\\n新豊洲のとある場所へ見学に訪れるのだそうだ。\\n………そう御桜川女子高等学校に。", "マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("俺の学校に！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("別に特におかしな事ではないぞ。\\n彼女の年齢を普通に考えると、\\n現在は高校二年生にあたるのだからな。", "マリル")
	await novel_interface.show_dialog("お前の任務は端的に言えばこうだ。\\n\\n彼女が見学している間に、\\n視察団の具体的な目標とその真意を探り出せ。", "マリル")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("情報部門に頼んで、サモントンとデックス家に\\n関する情報をまとめさせた。\\n帰ってから、ちゃんと勉強するように。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("えぇぇ――また暗記かよぉ……\\nまぁ、とりあえず俺に任せろ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("あーそれと帰る時は変質者に気を付けるんだぞ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("おいっ！　ど、どういう意味だよっ！", "小憐")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
