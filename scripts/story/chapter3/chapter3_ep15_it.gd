# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Corriamo fino al parcheggio sotterraneo come indicato da Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru mi ha detto che gli uomini dell'Amministratore si sono allontanati da un'altra uscita invece di rincorrerci.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Fammi controllare la ferita... ho già imparato il primo soccorso.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mi segnala di appoggiare Annie su una superficie piana. Quindi controlla il polso e la respirazione di Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Fortunatamente non c'è fibrillazione atriale, anche se il suo respiro è piuttosto superficiale e le ustioni sono gravi. Non ho idea se ci sia qualche lesione interna...", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("È brutale! Trattare una ragazza così!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Hmm... signorina?", "Beatrice")
	await novel_interface.show_dialog("Attiri spesso piccoli animali? \\nAd esempio—", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ci voltiamo e guardiamo oltre. Ci sono due piccioni vicino a noi.")
	await novel_interface.show_dialog("Coo— Coo—", "Piccione")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Cosa c'è di strano in questo? I piccioni si trovano ovunque.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("No, qui è il terzo seminterrato!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("E allora? \\nNon sono animali a rischio di estinzione.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Coo— Coo— Coo—", "Piccione")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(... Nobiltà, ah. Nessun buon senso.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("La magia curativa attira i piccoli animali. Ma se lei non ne è consapevole...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice mi avvicina a Raphael, prendendo le sue mani e le mie.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Vieni, prova questo...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Ehm?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice mette la mia mano su quella di Raphael e preme forte le nostre mani con il suo palmo.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("Cosa stai facendo?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Non mi aspettavo che la mano di ... \\nRaphael fosse così morbida e calda ...")
	await novel_interface.show_text_only("No, aspetta! \\nSono—")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tenendole le mani…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Vedo sorpresa e rabbia sul volto di Raphael. Mi sta fissando, quasi sputando fuoco.")
	await novel_interface.show_text_only("Tremo al pensiero di essere chiamato pervertito e picchiato nero e blu.")
	await novel_interface.show_text_only("All'improvviso, Raphael si gira a guardare Beatrice, come se si rendesse conto di qualcosa. Beatrice annuisce leggermente.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael chiude gli occhi, con uno sguardo intenso sul viso. E Beatrice allontana lentamente il palmo della mano.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(Cosa? Le piace tenermi la mano?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, un piacevole calore attraversa il mio corpo e mi sento più rilassato che mai.")
	await novel_interface.show_text_only("Uff... All'improvviso mi rendo conto che l'aria è così fresca, anche nel suo parcheggio sotterraneo.")
	await novel_interface.show_text_only("E in qualche modo la scena orribile smette di perseguitarmi.")
	await novel_interface.show_dialog("Ah-em…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedo le cicatrici delle ustioni sul corpo di Annie svanire a una velocità incredibile.")
	await novel_interface.show_text_only("Il calore si attenua gradualmente. Raphael tira un sospiro di sollievo e apre gli occhi.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, dove siamo...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie mi guarda assonnato, come se si fosse appena svegliato.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Siamo al sicuro adesso. Aspetto solo Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Perché…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Non... l'hai notato prima?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Una strega con una magia curativa così meravigliosa... \\nSei fantastica!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Sì, davvero! Ho anche sentito la magia!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Strega? Magia? Che sciocchezza!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael aggrotta la fronte severamente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Cosa mi hai fatto? \\nPerché le sue ferite guariscono così velocemente?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("So che è difficile assimilare così tante informazioni tutte in una volta. Quindi rimango in silenzio.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Chi sono quelli che attaccano i nostri soldati della sicurezza? \\nCome osano usare l'arma Substance H qui...", "Raphael")
	await novel_interface.show_dialog("Perché una persona morta da centinaia di anni è improvvisamente tornata in vita? E indosso la sua collana!", "Raphael")
	await novel_interface.show_dialog("E ho visto... \\nL'incubo...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce di Raphael trema mentre pensa alla scena orribile.")
	await novel_interface.show_text_only("Mi rivolgo a Beatrice. Un sorriso calmo appare sul suo bel viso.")
	await novel_interface.show_text_only("Lo smeraldo è tornato al suo stato originale e Beatrice lo ha restituito a Raphael.")
	await novel_interface.show_text_only("Sembrava che quella scena terrificante di un attimo prima non avesse niente a che fare con lei.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("La magia del Libro dei Sette Filosofi disturba la mente... \\nÈ perfettamente normale provare paura al primo incontro.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Ma la paura è un’emozione importante. Conoscere la tua debolezza ti aiuta a sopravvivere alle crisi.", "Beatrice")
	await novel_interface.show_dialog("Ciò che è veramente orribile è chi è dominato dalla paura...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sembra essere trascinato nei ricordi, con uno sguardo triste negli occhi.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Comunque sia, preferirei non aprire mai quel libro e non esprimere mai quel desiderio...", "Beatrice")
	await novel_interface.show_dialog("E mai... hanno ottenuto il potere maledetto...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Maledetto?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Il Grimorio mi ha dotato di una magia... \\nNon riesco a trattenermi dal emanare un fascino che attira gli uomini.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(Ecco perché...!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice si gira verso di me e mi tocca la gola con la punta del dito.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Posso fare una domanda?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Sì... per favore!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Il tuo nome è Ren, vero? \\nSei speciale...", "Beatrice")
	await novel_interface.show_dialog("Da ragazza, dovresti essere immune al mio fascino. Allora perché mi ... lanciavi occhiate furtive?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Se n'è accorta! \\nMolto vergognoso!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ma... a differenza degli uomini, non perdi completamente il controllo... né ti comporti come un matto.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(È a causa della mia magia?...) \\n(No no no, ho perso completamente il controllo!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice mi solleva lentamente la mascella con un dito e poi mi tocca delicatamente il naso.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Non mi dispiace ... Onestamente, devo ammettere che ... sei carino.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Deglutisco inconsciamente.")
	await novel_interface.show_text_only("È ... solo l'effetto della magia?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Poco dopo, un SUV limousine nero si fermò sfrecciando davanti a noi.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, entra!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, giusto? Spero che verrai con noi.", "Mariru")
	await novel_interface.show_dialog("Ho trovato tutti i documenti disponibili… Nel caso ti interessi la vita di chi conosci.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Il tuo ammiratore segreto, il poeta, ha scritto versi che sono stati tramandati attraverso i secoli.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Bene. Anche a me interessa questo tesoro qui.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incontrando gli occhi di Beatrice, arrossisco di nuovo...")
	await novel_interface.show_text_only("È... è davvero solo l'effetto della sua magia?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("E Raphael, torna nella tua stanza. La banda è già partita. E' sicuro adesso.", "Mariru")
	await novel_interface.show_dialog("Se la delegazione ti trova scomparso... Non vorrai spaventarli, lo sai.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Abbiamo trasportato contrabbando... e causato un tale tumulto...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael guarda Beatrice. \\nEbbene, la contrabbandiera si è trasformata in una bella signora. Che dolcezza!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("E mi lasci andare proprio così?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("In cambio, il Dr. Dekkers ha accettato che i miei commercianti designati saranno i primi in fila per i prodotti di Salmonton nel prossimo anno.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("E ha anche promesso di chiudere un occhio sulle mie attività di trading al Newmoridas Futures Exchange.", "Mariru")
	await novel_interface.show_dialog("L'accordo è già sulla scrivania del mio ufficio. Quindi stai tranquillo. SID non è un gruppo di beneficenza.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Aspetta! Abbiamo rischiato la nostra vita solo per te per fare soldi!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Bene. Prometto che non dirò a nessuno di questo incidente prima di aver chiarito tutto.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("È un vero piacere lavorare con Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, troverò sicuramente una soluzione a questa magia una volta tornato a Salmonton!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Per favore, fallo! Penso che tu abbia davvero un meraviglioso potere magico.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael si volta ma si ferma di colpo. \\nSi toglie la collana e me la lancia.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Questo viene dalla tua collezione di famiglia, vero? Come puoi...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("E' tuo adesso.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Una ragazza galante! Diventerai una donna eccezionale quando sarai grande.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, non dimenticherò di controllare i tuoi precedenti.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Fate attenzione, tutti. Ci incontreremo di nuovo.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
