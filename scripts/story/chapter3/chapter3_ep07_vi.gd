# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Đã hai ngày kể từ khi Mariru giao nhiệm vụ cho tôi.")
	await novel_interface.show_text_only("Đêm qua, đoàn “Giao lưu văn hóa” cuối cùng đã đến cảng New Opulentia Quốc tế Ai.")
	await novel_interface.show_text_only("Vậy… Nhiệm vụ của tôi sắp bắt đầu.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Nhưng cố gắng lấy thông tin từ cô gái đó ... tôi không biết.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Dù sao thì cô ấy cũng không phải là một cô gái bình thường. Nếu cô ấy từ chối nói chuyện với tôi thì sao?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Hãy nhìn cô gái đằng kia! Cô ấy không mặc đồng phục của trường chúng tôi.", "Sinh viên 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Và người bên cạnh cô ấy trông giống như một người phục vụ ... Cô ấy có phải là một loại công chúa không?", "Sinh viên 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn qua và thấy một cô gái mảnh khảnh trong chiếc áo khoác màu xanh lá cây. \\nCô ấy đang đứng trước bãi cỏ.")
	await novel_interface.show_text_only("Mục tiêu nhiệm vụ của tôi—Raphael Dekkers.")
	await novel_interface.show_text_only("Vừa nãy tôi thấy hiệu phó và ban nhạc danh dự đang đợi ngoài cổng trường. Cô ấy lẻn vào khuôn viên trường à?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Cô ơi, mời đi lối này.", "Tùy tùng")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Tòa nhà trường học này được thiết kế theo phong cách Tudor của thời kỳ hoàng kim.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Nhưng tâm nhĩ quá chật chội để thể hiện cảm giác hùng vĩ.", "Raphael")
	await novel_interface.show_dialog("Và các đường chạm khắc trên ván chân tường quá vụng về để hỗ trợ cho kết cấu và thiết kế.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Thưa cô, cô có khiếu nghệ thuật thật đặc biệt!", "Tùy tùng")
	await novel_interface.show_dialog("Kiến trúc Tudor như thế này nên có giếng trời cao hơn.", "Tùy tùng")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Không, bạn không hiểu nó. \\nChỉ tăng chiều cao sẽ không hiệu quả.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Cô hoàn toàn đúng, thưa cô. Bãi cỏ cũng nên được mở rộng.", "Tùy tùng")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hả? Điều đó sẽ trông không phối hợp. \\nRốt cuộc thì cả sân trước đã ùn tắc rồi…", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tất nhiên. Cô Raphael thậm chí sẽ không gọi mảnh đất vô tổ chức này là sân trước phải không?", "Tùy tùng")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael có vẻ hơi bất mãn với những lời này.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… Không, đó không phải là điều tôi đang nghĩ.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Ôi! \\nThật tốt quá, cô Raphael!", "Tùy tùng")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Tại sao người phục vụ của cô ấy không thể nhìn thấy rằng nụ cười của cô ấy đã cứng ngắc?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Này, đồ quái đản mặc đồ khác giới.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Cái gì?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Kỳ dị mặc đồ khác giới ... Cô ấy đang nói về tôi phải không?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nghe lời cô ấy nói, mọi người đều quay lại nhìn tôi.")
	await novel_interface.show_text_only("Không quen có nhiều ánh mắt nhìn mình như vậy, tôi cảm thấy mình đỏ mặt.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Không, tôi… tôi không…! \\n(Mariru bắt tôi phải mặc đồng phục!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Hãy là một người đàn ông và thừa nhận điều đó, được không?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Tôi không biết New Opulentia lại hào phóng đến mức một kẻ biến thái như bạn lại có thể được nhận vào trường nữ sinh.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, tôi đã đổi ý rồi! Tôi không muốn làm điều này!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Umm… Ren là bạn cùng lớp của chúng tôi. Cô ấy là một cô gái!", "Sinh viên 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Cái gì? \\nĐừng đùa tôi nữa.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael có vẻ như đang bị xúc phạm.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Cô ấy không đùa đâu! Tất cả chúng tôi có thể đảm bảo với bạn. \\nRen chắc chắn là con gái.", "Sinh viên 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cảm ơn bạn đã lên tiếng cho tôi. Nhưng tôi chắc chắn không phải là con gái.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, tôi tưởng bạn là con trai.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Tại sao! Trông tôi chẳng giống con trai chút nào cả! \\n(Ồ, không…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh… Phản bội tôi cũ thật tệ…")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Được rồi. Quên nó đi.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Bạn nghĩ gì về kiến trúc ở trường học của bạn?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi không có ý tưởng gì về kiến trúc. Nếu bạn nhấn mạnh…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Chỉ cần nói bất cứ điều gì đến với tâm trí của bạn.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ừm ... là một ngôi trường, sân trong không quá thấp.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Tòa nhà không đẹp mắt… có lẽ vì nó… không đủ dễ thương?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Xấu hổ vì vốn từ vựng kém của mình, tôi cố gắng nhìn vào khuôn mặt của Raphael.")
	await novel_interface.show_text_only("Đúng như dự đoán, cô ấy cười khinh bỉ.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Dễ thương? Tôi không thể tin vào tai mình. Đó có phải là từ duy nhất bạn có thể tìm thấy để mô tả một kiến ​​trúc không?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ừm, đó chỉ là những gì tôi cảm nhận được thôi!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ý tôi là, có lẽ sẽ tốt hơn… Nếu những cái cây không được xếp thẳng hàng một cách hoàn hảo…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ừm… \\nGiống như, ừ…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh… tại sao tôi phải trả lời câu hỏi này?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ý bạn là, cây cối nên được sắp xếp xen kẽ nhau để tạo thêm chiều sâu cho thiết kế?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chính xác. \\n(Cô ấy vừa nói gì vậy?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael cuối cùng cũng nở một nụ cười yếu ớt với tôi.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("À, một kẻ biến thái còn tốt hơn một người đàn ông vâng lời!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Không, tôi không…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Cô…", "Tùy tùng")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hãy để chúng tôi đi. Đợi tôi ở ngoài trường.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Bạn là Ren phải không? Đi thôi. Hãy khoe ngôi trường tuyệt vời của bạn với tôi nhé?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Ơ…? \\nO… Được rồi!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
