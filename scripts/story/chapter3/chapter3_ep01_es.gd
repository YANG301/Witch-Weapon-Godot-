# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("La extraña pesadilla, la vaga conversación, la sombra en el sueño. \\nAdemás, un aviso de alerta roja...")
	await novel_interface.show_text_only("Justo cuando estoy a punto de aceptar mi nueva identidad y decidir recomponerme, volvieron a arruinar todo.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Mmmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Viste las noticias? \\n¡Es él! ¡No, yo, soy yo!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("No estoy ciego. Por supuesto, sé que eres tú justo delante de mí, chica tonta y sudando.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¡No! \\nMaldita sea. ¡soy yo en las noticias!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Presa del pánico, no sé ni por dónde empezar. \\nMariru gruñe y me golpea la cabeza con la mano.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Qué idiota tan inútil. Después de todos estos entrenamientos, ni siquiera puedes informar claramente a tu oficial.", "Mariru")
	await novel_interface.show_dialog("¿No se trata sólo de un tipo que se parece a ti siendo buscado en todo el mundo porque roba en el Centro de Colección e Investigación de la Segunda Ciudad Academia?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Sí, sí, sí! ¡Exactamente!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Los servicios de inteligencia habían informado de la noticia mucho antes de que se hiciera viral.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Te ves tonto cuando estás aterrorizado ~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru me pellizcó la mejilla. Intenté detenerla de inmediato.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, ¡ponte serio!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Los más buscados a nivel mundial. ¡No es una broma!", "Lian")
	await novel_interface.show_text_only("Nunca se me habría pasado por la cabeza que algún día aparecería en las noticias por burlarme.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("¡Y es un aviso triple A! Según recuerdo, el último hombre buscado con tal nivel de alerta fue asesinado a tiros en Sudamérica por un destructor de búnkeres.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Este maldito ladrón robó mi identidad anterior así como así... Estoy casi a punto de llorar al pensar en esto.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("En este caso… \\nEl único con el que puedo contar es Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Por mucho que quiera verte sufrir así...", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Tengo que pedirte que revises las noticias nuevamente.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("¿Es necesario? Ya lo tengo todo grabado en mi mente.")
	await novel_interface.show_dialog("Puede que la imagen no sea nítida y clara, ¡pero estoy seguro de que se parece casi exactamente a mí cuando era niño!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Para probar lo que dije, busco las noticias en mi teléfono.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Mira, esto es... \\n¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El aviso de búsqueda que me asustó ya no está. Fue reemplazado por un anuncio normal de persona desaparecida.")
	await novel_interface.show_text_only("El Sr. Inoue, caricaturista de setenta años, desapareció recientemente. \\nSi alguien sabe su paradero, por favor contacte a la policía inmediatamente.")
	await novel_interface.show_text_only("Revisé otros sitios web e incluso busqué con palabras clave, pero no encontré la noticia por ninguna parte.")
	await novel_interface.show_text_only("Mirando la cara de Mariru, estoy muy agradecido.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("¿Fuiste tú…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru se acerca y me seca las lágrimas.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Mírate, todo ahogado.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Si realmente quieres agradecerme, entonces sé mi esclavo~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Y…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Cuando dijiste \"el único con el que puedo contar es Mariru\", \\nte veías tan lindo...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru me levanta la barbilla tiernamente con su dedo índice.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("¡Oye, deja de hacer eso!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Por lo que puedo ver, ya estoy esclavizado…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Ojalá pudiera hacer eso. Pero que yo sepa, sólo hay una agencia que puede silenciar todas las redes sociales en todo el mundo.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Debe ser una orden ejecutiva del Congreso Unido.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("El congreso supremo que representa a las seis Ciudades Academia… ¿decidió borrar la noticia?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("¿Por qué…?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru me mira y me da una sonrisa misteriosa.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("No seas tonto. Obviamente, no hicieron esto para proteger al ladrón.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Simplemente no quieren que el público sepa qué fue robado.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Quién es este ladrón? ¿Por qué usó mi identidad?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Sea quien sea, debe ser un genio para poder salir sano y salvo del Centro de Investigación y Colección de Akatraz.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("La cuestión es que no le resulta difícil taparse la cara.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Pero no lo hizo, e incluso se atrevió a subir al techo del edificio por un tiempo…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Según el entrenamiento especial, las cosas más insignificantes están ausentes de donde se supone que deben aparecer…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… O están presentes donde no deberían estar.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
