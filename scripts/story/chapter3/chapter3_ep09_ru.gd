# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("По данным SID, со прошлой ночи возле отеля Sky было обнаружено несколько прерывистых пространственно-временных потоков.")
	await novel_interface.show_text_only("По совпадению, вчера вечером вся делегация Salmonton остановилась в этом роскошном отеле, расположенном в Согласованной демилитаризованной зоне.")
	await novel_interface.show_text_only("Сегодня вечером там устроят званый ужин по арт-обмену для знаменитостей со всех Академгородов.")
	await novel_interface.show_text_only("Но Raphael и ее сопровождающий не приглашены.")
	await novel_interface.show_text_only("Итак, Mariru снова отправил меня и Annie в это надоедливое место.")
	await novel_interface.show_text_only("Стоя у входа в великолепный банкетный зал, я чувствую себя довольно неуютно.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Хм…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("С тобой все в порядке? Ты выглядишь очень нервным.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Конечно, да. Я никогда не наряжалась горничной!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ага. Annie и я переодевшись вошли в помещение.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("И почему я должна быть горничной, если ты представитель студентов Госакурагавы?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Все мужчины любят платья горничных, не так ли?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Что ж, я почти уверен, что никто из них не любит носить это сам!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Хм… \\nВы правы.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Как жаль, ты не можешь увидеть, какая ты милая в этом чудесном платье. \\nНеудивительно, что ты такой беспокойный…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie делает несколько шагов назад, хватает телефон… \\nИ фотографирует меня.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ух ты… Рен, ты очаровательно выглядишь с хвостиками.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Стоп… Удали это, немедленно!", "Lian")
	await novel_interface.show_dialog("(Такой постыдный момент…) \\n(Если это видели…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Свистящий звук из телефона Annie подтверждает успешную передачу.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Я отправил его вам и Mariru!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Черт.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Хи-хи, не стесняйся. \\nЭта отделка с рюшами вам очень идет!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Я разблокирую телефон, и на экране появляется фотография.")
	await novel_interface.show_text_only("Неплохо…?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Ты сошел с ума!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно из наушников раздается знакомый голос.")
	await novel_interface.show_dialog("Ладно, никаких больше селфи, девочки. У вас есть все подробности, верно?", "Mariru")
	await novel_interface.show_dialog("Четвертый Академгородок получил разрешение Объединенного Конгресса на усиление безопасности мероприятия. Итак, сегодня вечером этот отель усиленно охраняется.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Все, что нам нужно сделать, это выяснить причины Пространственно-временных потоков и немедленно уйти, верно? \\nЯ понял.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("На этот раз я не могу сделать смелый шаг. Итак, вы двое, не забывайте играть на слух. Особенно ты, Рен…", "Mariru")
	await novel_interface.show_dialog("Если вы приглянетесь одному из этих воротил, у вас может никогда не появиться шанса сбежать...", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Хватит!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Мне пора идти. Со мной захотели поговорить несколько делегатов из Комиссии по образованию Salmonton. \\nЭто хороший шанс послушать.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Рен, просто делай то, что тебе нужно.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("В мгновение ока Annie изображает улыбку и оборачивается, \\nмашя рукой группе мужчин в костюмах.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie действительно хорош в этом…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Но что теперь делать горничной?", "Lian")
	await novel_interface.show_dialog("Держать сервировочный поднос так сложно…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Дом Периньон, пожалуйста.", "Гость А")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Э? Ух… Конечно, сэр. \\nХм… Повторишь ли ты это?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Гость А")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Дерьмо! Я что-то очень глупое спрашиваю?) \\nХммм…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Без должной подготовки я совершенно не представляю, как с этим справиться. Я даже не знаю, что должна делать горничная.")
	await novel_interface.show_dialog("Пфф, ты ведь знаешь, что это место известно своими горничными, да? \\nКак они могли впустить такого непрофессионала?", "Гость А")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Мне очень жаль, сэр…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Эй! Почему ты стоишь там, как шишка на бревне?", "Розоволосая горничная")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("А?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я оборачиваюсь и вижу розоволосую симпатичную горничную в очках в красной оправе.")
	await novel_interface.show_text_only("Она вежливо улыбается гостю. Когда она оборачивается, милая улыбка превращается в пламенный гнев.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Давай, пойдем за шампанским для гостя.", "Розоволосая горничная")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("А? Кто ты? \\n(Судя по тому, как она одевается, она не похожа на официантку в этом отеле...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Розоволосая горничная хватает меня за руку и, не говоря ни слова, направляется в угол. На удивление, она полна сил.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы, бабники! Что с тобой не так?", "Розоволосая горничная")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ух... я... я...", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Мне очень жаль. Я новичок в этой работе. Я здесь первый день…")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Подожди, как ты говоришь... Ты тоже не похож на горничную...")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Почему ты так на меня смотришь? \\nВы сомневаетесь в моих способностях горничной?", "Розоволосая горничная")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Слушай! Как горничная, я могу и сделаю все для своего хозяина. Никто не может в этом сомневаться.", "Розоволосая горничная")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Девушка в красных очках вдруг дает передо мной торжественную клятву.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("О… Ладно…", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("В любом случае, спасибо, что помогли мне сейчас… \\nЧестно говоря, я не знал, что делать дальше.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Итак, почему ты здесь?", "Розоволосая горничная")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ее голос внезапно становится холодным, как лед, от чего у меня по спине пробежал холодок.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Если ты солжешь мне, я сожгу тебя до куска кокаина.", "Розоволосая горничная")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Девушка разразилась серебристым смехом, произнося эти устрашающие слова, но я почти уверен, что она не шутила!")
	novel_interface.character_light()
	await novel_interface.show_dialog("Вы пытаетесь что-то придумать?", "Розоволосая горничная")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Черт побери. Меня арестовали?) \\n(Кто она, черт возьми?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("Я знаю, кто ты. \\nВедь…", "Розоволосая горничная")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, не груби.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("На звук я нахожу миниатюрную девушку в великолепном вечернем платье.")
	await novel_interface.show_text_only("Ее блестящие светлые волосы заплетены до талии, а глаза яркие и ясные, как хрусталь.")
	await novel_interface.show_text_only("Присутствие такой эльфийки на этом ярком мероприятии похоже на квадратный колышек в круглой дыре.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Мисс Скурд! \\nМне очень жаль, что я вас побеспокоил.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Свирепая, как лев, горничная мгновение назад превращается в котенка, когда появляется маленькая девочка.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Посмотрите на бедную девушку. Она слишком напугана, чтобы сказать хоть слово.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Просто отпусти ее пока, ладно?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Роджер это!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
