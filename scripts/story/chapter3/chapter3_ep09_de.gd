# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("Laut SID wurden seit letzter Nacht mehrere intermittierende Raumzeitflüsse in der Nähe des Sky Hotels festgestellt.")
	await novel_interface.show_text_only("Zufälligerweise hat die gesamte Salmonton-Delegation gestern Abend in diesem Luxushotel in der vereinbarten DMZ eingecheckt.")
	await novel_interface.show_text_only("Heute Abend veranstalten sie dort eine Kunstaustausch-Dinnerparty für Prominente aus allen akademischen Städten.")
	await novel_interface.show_text_only("Aber Raphael und ihre Begleiterin sind nicht eingeladen.")
	await novel_interface.show_text_only("Also schickte Mariru Annie und mich wieder an diesen nervigen Ort.")
	await novel_interface.show_text_only("Als ich am Eingang des prächtigen Bankettsaals stehe, fühle ich mich ziemlich unwohl.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Hm...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Geht es dir gut? Du scheinst ziemlich nervös zu sein.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Natürlich tue ich das. Ich habe mich noch nie als Dienstmädchen verkleidet!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ja. Annie und ich betraten verkleidet den Veranstaltungsort.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Und warum sollte ich das Dienstmädchen sein, während Sie ein Studentenvertreter von Gosakuragawa sind?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Alle Männer lieben Dienstmädchenkleider, nicht wahr?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Nun, ich bin mir ziemlich sicher, dass keiner von ihnen es selbst gerne trägt!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm... \\nDu hast recht.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Schade, man sieht in diesem schönen Kleid nicht, wie süß du bist. \\nKein Wunder, dass du so unruhig bist ...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie tritt ein paar Schritte zurück, schnappt sich ihr Handy ... \\nUnd macht ein Foto von mir.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Wow... Ren, du siehst bezaubernd aus mit Twintails.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Stopp... Löschen Sie es jetzt!", "Lian")
	await novel_interface.show_dialog("(So ein beschämender Moment…) \\n(Wenn es gesehen wird…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ein Rauschen auf dem Telefon von Annie bestätigt die erfolgreiche Übertragung.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Ich habe es Ihnen und Mariru geschickt!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Verdammt.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Hihi, sei nicht schüchtern. \\nDieser Rüschenbesatz steht dir gut!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Ich entsperre mein Telefon und das Foto erscheint auf dem Bildschirm.")
	await novel_interface.show_text_only("Nicht schlecht...?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Du bist verrückt!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich ertönt eine vertraute Stimme aus dem Headset.")
	await novel_interface.show_dialog("Alles klar, keine Selfies mehr, Mädels. Du hast alle Details, oder?", "Mariru")
	await novel_interface.show_dialog("Die Forth Academic City hat die Erlaubnis des Vereinigten Kongresses erhalten, die Sicherheit für die Veranstaltung zu erhöhen. Daher wird dieses Hotel heute Nacht streng bewacht.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Alles, was wir tun müssen, ist, die Ursachen der Raumzeitflüsse herauszufinden und uns sofort zurückzuziehen, oder? \\nIch habe es verstanden.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Diesmal kann ich keinen mutigen Schritt machen. Also ihr zwei, denkt daran, es nach Gehör zu spielen. Besonders du, Ren…", "Mariru")
	await novel_interface.show_dialog("Wenn einer dieser Bonzen Gefallen an Ihnen findet, werden Sie vielleicht nie die Chance bekommen, ihm zu entkommen …", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Genug!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Ich muss gehen. Ein paar Delegierte der Salmonton Bildungskommission wollten mit mir sprechen. \\nEs ist eine gute Gelegenheit, zuzuhören.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, tu einfach, was du tun musst.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Im Handumdrehen setzt Annie ein Lächeln auf, dreht sich um und winkt einer Gruppe Männer in Anzügen zu.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie ist wirklich gut darin…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aber was soll ein Dienstmädchen jetzt tun?", "Lian")
	await novel_interface.show_dialog("Das Serviertablett zu halten ist so schwer ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ein Dom Perignon, bitte.", "Gast A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Äh? Ugh... Natürlich, Sir. \\nHmm... Würden Sie das wiederholen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Gast A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Mist! Frage ich etwas wirklich Dummes?) \\nHmmm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ohne entsprechende Ausbildung habe ich absolut keine Ahnung, wie ich damit umgehen soll. Ich weiß nicht einmal, was ein Dienstmädchen tun soll.")
	await novel_interface.show_dialog("Pff, du weißt doch, dass dieser Ort für seine Dienstmädchen bekannt ist, oder? \\nWie konnten sie so einen Unprofessionellen reinlassen?", "Gast A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Es tut mir leid, Sir...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Hey! Warum stehst du da wie eine Beule auf einem Baumstamm?", "Rosahaariges Dienstmädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Hä?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich drehe mich um und sehe ein hübsches Dienstmädchen mit rosa Haaren und roter Brille.")
	await novel_interface.show_text_only("Sie schenkt dem Gast ein höfliches Lächeln. Als sie sich umdreht, verwandelt sich das süße Lächeln in feurige Wut.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Komm, lass uns den Champagner für den Gast holen.", "Rosahaariges Dienstmädchen")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Hä? Wer bist du? \\n(Aus ihrer Kleidung geht hervor, dass sie nicht wie eine Kellnerin in diesem Hotel aussieht …)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Das rosahaarige Dienstmädchen ergreift meine Hand und geht wortlos zur Ecke. Überraschenderweise ist sie voller Kraft.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ihr Butterfinger! Was ist los mit dir?", "Rosahaariges Dienstmädchen")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ugh... ich... ich...", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Es tut mir leid. Ich bin neu in diesem Job. Es ist mein erster Tag hier…")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Warte, so wie du sprichst ... Du klingst auch nicht wie ein Dienstmädchen ...")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Warum siehst du mich so an? \\nStellen Sie meine Fähigkeiten als Dienstmädchen in Frage?", "Rosahaariges Dienstmädchen")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Hör zu! Als Dienstmädchen kann und werde ich alles für meinen Herrn tun. Daran kann niemand zweifeln.", "Rosahaariges Dienstmädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Das Mädchen mit der roten Brille legt plötzlich vor mir ein feierliches Gelöbnis ab.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("O... Okay...", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Wie auch immer, danke, dass du mir gerade geholfen hast ... \\nEhrlich gesagt wusste ich nicht, was ich als nächstes tun sollte.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Also, warum bist du hier?", "Rosahaariges Dienstmädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ihre Stimme wird plötzlich eiskalt und erzeugt einen Schauer über meinen Rücken.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Wenn du mich anlügst, werde ich dich zu einem Stück Koks verbrennen.", "Rosahaariges Dienstmädchen")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Das Mädchen brach in silbriges Gelächter aus, als sie diese einschüchternden Worte aussprach, aber ich bin mir ziemlich sicher, dass es kein Scherz war!")
	novel_interface.character_light()
	await novel_interface.show_dialog("Versuchen Sie, etwas zu erfinden?", "Rosahaariges Dienstmädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Verdammt. Bin ich kaputt?) \\n(Wer zum Teufel ist sie?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("Ich weiß, wer du bist. \\nSchließlich...", "Rosahaariges Dienstmädchen")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, sei nicht unhöflich.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Ich folge dem Geräusch und finde ein zierliches Mädchen in einem fabelhaften Abendkleid.")
	await novel_interface.show_text_only("Ihr glänzendes blondes Haar reicht in Zöpfen bis zur Taille und ihre Augen sind strahlend und klar wie Kristall.")
	await novel_interface.show_text_only("Die Anwesenheit eines solchen Elfenmädchens bei diesem extravaganten Anlass ist wie ein quadratischer Pflock in einem runden Loch.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Fräulein Skurd! \\nEs tut mir so leid, dass ich dich gestört habe.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Eben noch wild wie ein Löwe, verwandelt sich das Dienstmädchen in ein Kätzchen, als das kleine Mädchen auftaucht.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Schau dir das arme Mädchen an. Sie hat zu viel Angst, um ein Wort zu sagen.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Lass sie einfach gehen, okay?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Verstehen Sie das!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
