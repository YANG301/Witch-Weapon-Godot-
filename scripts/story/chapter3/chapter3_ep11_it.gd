# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Siamo circondati dalle guardie del corpo di Raphael. Annie mi fa l'occhiolino—")
	await novel_interface.show_text_only("Capisco subito il suo punto e sprigiono tutta la potenza di pressione che ha accumulato quando eravamo nel corridoio.")
	await novel_interface.show_text_only("All'improvviso, centinaia di palle da baseball vengono sparate, colpendo un ragazzo e rimbalzando immediatamente verso un altro.")
	await novel_interface.show_text_only("Ovviamente non avendo mai visto una cosa del genere, le guardie del corpo cadono nel panico e vengono colpite una dopo l'altra.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Non ho mai usato questo trucco sulla gente comune prima. Funziona così bene...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Naturalmente! È molto più facile trattare con gli umani sani di mente che con le streghe pazze!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Spara! Idioti...", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Come vi permettete, piantagrane! I soldati della sicurezza non ti lasceranno andare!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noto solo che dopo il combattimento, la suite reale di Raphael è diventata un disastro totale, con le sue guardie del corpo stese sul pavimento.")
	await novel_interface.show_text_only("Io e Annie volevamo solo intrufolarci e raccogliere prove, ma sembra che abbiamo causato un grave disastro diplomatico...")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Merda… Annie! \\nC… andiamo! Legatela!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In preda al panico, do a Annie un'istruzione folle.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Sì! Andrà bene!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie abbassa agilmente Raphael, squarcia una tenda caduta a terra durante il combattimento e con essa lega rapidamente la ragazza in difficoltà.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Come osi—!! \\nPervertito travestito! Cosa vuole da me?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ora, Raphael, l'ospite d'onore di stato a New Opulentia, nipote del sindaco della Quarta Città Accademia, è legata a una sedia nella sua suite—")
	await novel_interface.show_text_only("Annie è davvero bravo in questo!! \\nE sembra che non potrò mai liberarmi della reputazione di pervertito...")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Mi dispiace davvero, ma dobbiamo assicurarci che tu non faccia scattare l'allarme...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Indico un pulsante rosso sul muro. Una volta premuto, una squadra di soldati di sicurezza pesantemente armati circonderà la stanza entro 3 minuti.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, allora cosa vuoi?", "Raphael")
	await novel_interface.show_dialog("Non nascondi la tua identità e non sembra che tu abbia un piano di evacuazione... \\nQuesto non è un rapimento a scopo di riscatto, vero?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Anche quando è legato a una sedia, Raphael sembra ancora sicuro di sé e pensa con lucidità... Che nobile signora.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Chi sei? \\nHai appena usato armi Substance H?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Le sue parole mi ricordano il mio compito prioritario in questo momento.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Signora Raphael, vogliamo solo capire una cosa. \\nSi tratta di quella valigia...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Quale valigia?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael sembra perplesso e sembra non avere la minima idea di quello che ho detto.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Sembra che... sia già rotto!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Cosa?! Pensavo che la lega dovesse essere molto robusta!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Guardo dove punta Annie e vedo la valigia, ormai rotta con enormi buchi lasciati dalle palle da baseball sparate.")
	await novel_interface.show_text_only("La copertura di plastica nera della valigia è in frantumi, rivelando uno strato di metallo che emette una luce azzurra.")
	await novel_interface.show_text_only("La plastica è una comune copertura staccabile. Annie deve aver notato lo strato interno della valigia.")
	await novel_interface.show_text_only("La serratura è distrutta, con componenti e pezzi di metallo sparsi sul tappeto.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("È strano: le mie palle da baseball prendono di mira solo bersagli viventi...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Anche Raphael sembra aver notato il materiale che emana luce blu. Sembra sorpresa e nervosa.")
	await novel_interface.show_text_only("Tra le schiume antiurto e i pezzi di metallo sparsi, vedo una piccola cosa luccicante.")
	await novel_interface.show_text_only("È un accessorio dorato a forma di farfalla. Con delicati motivi ritagliati sulle ali, sembra una vera farfalla.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Potrebbe essere questa cosa... ad aver attratto le tue palle da baseball a prendere di mira la valigia?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Attenzione! Potrebbe essere un Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La realistica farfalla dorata sembra pronta a volare in qualsiasi momento. Anche Raphael è ipnotizzato. Non posso fare a meno di contattare...")
	await novel_interface.show_dialog("Ehi, idiota. \\nHo detto di non toccarlo—", "Mariru")
	await novel_interface.show_text_only("La voce di Mariru viene fuori dal nulla. Da qualche parte nel mio corpo improvvisamente sento un ronzio. È come se stesse parlando accanto a me.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Eh? \\n... Cos'è quello!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esploro il mio corpo, sperando di scoprire da dove provenisse la voce e di assicurarmi di non vedere nessun altoparlante da qualche parte.")
	await novel_interface.show_dialog("Se la palla da baseball di Annie avesse potuto lasciare un buco così profondo sulla lega con una durezza Rockwell di 70, le teste delle guardie del corpo sarebbero state ridotte in frantumi.", "Mariru")
	await novel_interface.show_dialog("È più probabile che il piccolo gadget volesse semplicemente sfruttare gli shock delle palle da baseball per scoppiare...", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Quei buchi... sono stati lasciati dall'accessorio stesso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh-uh, molto probabile. Allora, vuoi ancora toccare una cosa così pericolosa?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Aspetta, il problema è... \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dannazione! Trovo la fonte della sua voce!")
	await novel_interface.show_text_only("Viene proprio dal mio petto! Non c'è da stupirsi che il mio corpo si senta vibrare ogni volta che parla...")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Come hai potuto piantare un chip nel mio corpo!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Hai appena casualmente rivelato la nostra tecnologia segreta a uno straniero! Vuoi farti timbrare di nuovo?", "Mariru")
	await novel_interface.show_dialog("Annie, fai addormentare la signora per un po'! \\nMa fai attenzione. Non fare del male al nostro ospite d'onore.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Ehi! Non osare...!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie lancia abilmente una mano con un coltello alla nuca di Raphael, mandandola in uno stato di blackout.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Alla signora Mariru, Substance H è vietato accedere a New Opulentia senza l'approvazione ufficiale, vero?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Naturalmente! Humph, me l'hanno messo di nascosto sotto il naso! Il dottor Dekkers dovrà spiegarlo al Senato.", "Mariru")
	await novel_interface.show_dialog("… Aspetta! Penso che le guardie di sicurezza all'esterno abbiano attirato l'attenzione.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Eh, è veloce.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I soldati della sicurezza al piano di sotto si stanno radunando nell'atrio. \\nPorterò il team di raccolta per aiutarti. Arriveremo tra 8 minuti.", "Mariru")
	await novel_interface.show_dialog("Annie, sigilla subito la porta con gli aerogel.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Sì, signora!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
