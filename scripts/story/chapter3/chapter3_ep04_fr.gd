# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Cela fait quelques jours que l'avis de recherche a été publié.")
	await novel_interface.show_text_only("Comme l'avait prédit Mariru, l'incident ne semble avoir aucun effet sur la vie quotidienne des gens.")
	await novel_interface.show_text_only("Il n'y a également pratiquement aucune trace de l'ingénierie de distraction de Mariru.")
	await novel_interface.show_text_only("Cela ne ressemble à rien d’autre qu’un cauchemar.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Bonjour, sœur Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En tant que sorcière dotée de capacités spéciales, Elluka est étroitement surveillée par SID.")
	await novel_interface.show_text_only("Mais le gamin semble attaché à moi. Mariru me l'envoie tous les jours, prétendant qu'elle est juste gentille.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Bonjour, Elluka. \\nTu veux manger quelque chose entre les repas ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hé! Ne donnez pas trop de collations aux enfants !", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Bouh…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("C'est bien. Ce n’est guère trop.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Oh, allez, tu dis toujours ça.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Et est-ce que ça va qu'elle reste avec nous toute la journée ?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Les enfants de son âge devraient aller à l'école. \\nN'est-ce pas ?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Euh, ce n'est pas qu'une enfant, je suppose.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Bien sûr, mais je suis toujours un peu inquiet…", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Tout est de ta faute. Tu continues à la nourrir, je commence à m'inquiéter pour son poids !", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, mauvais.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka regarde Annie avec un air blessé. Et Annie affiche un visage triste.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Maintenant, je sais ce que ça fait d'être une maman stricte…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Très bien. Ne sois pas si dur.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Tiens, Elluka, un dernier morceau de chocolat aujourd'hui. Pas plus. \\nEnsuite, je t'emmènerai à mon école.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka est uniquement autorisé à se déplacer librement entre notre appartement et l'école, comme l'exige Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ah…", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Pourtant, triste.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je lui caresse la tête et l'emmène à l'école avec Annie.")
	await novel_interface.show_text_only("Hmm, quelle belle journée. Ni trop chaud, ni trop froid.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Ne te sens pas mal, chérie.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka lève soudain la tête et me regarde dans les yeux, du chocolat sur les lèvres.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Sœur Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Oh s'il te plaît, ne me regarde pas comme ça !)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka se met sur la pointe des pieds pour attraper ma main et la pose sur sa tête.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Encore une fois.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Est-ce une offensive de charme !? \\nOh non, c'est une chose à laquelle aucun homme ne pourrait résister !")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, tu aimes Lolita, hein ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Héhé, je pense que oui.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'entends la voix de Nix derrière moi.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comment pourrait-elle s'approcher de nous sans aucun bruit ?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Désolé, est-ce que je t'ai fait peur ?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non, juste… \\nCe n'est pas grave.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("J'ai honte à l'idée d'être surpris en train de regarder bêtement Elluka.")
	await novel_interface.show_text_only("Et je suis soulagé que Nix ne continue pas ce sujet. Elle est si gentille et élégante !")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Votre nom est Elluka, n'est-ce pas ?", "Nix")
	await novel_interface.show_dialog("Si tu aimes les desserts, la prochaine fois je t'achèterai une génoise, d'accord ?", "Nix")
	await novel_interface.show_dialog("Je connais une boulangerie géniale dans Theatre Street. Ils servent un très bon sirop d'érable, qui a presque un goût de caramel.", "Nix")
	await novel_interface.show_dialog("Et vous allez adorer leur crème au chocolat signature à l'intérieur du gâteau.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka réfléchit un moment et hoche la tête car elle ne parvient pas à résister à la tentation de la nourriture.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, vous n'acceptez pas de nourriture provenant d'étrangers !", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("C'est bon. Nix est notre aîné de toute façon.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Ouais, mais…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Est-ce juste moi ?")
	await novel_interface.show_text_only("Il semble que Annie se méfie de Nix depuis leur première rencontre.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Alors c'est un accord, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Affaire !", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mon téléphone sonne soudainement. \\nNous sommes Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Bonjour ?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ugh, pas encore une autre mission !) \\n(Honnêtement, ce n'est pas tous les jours que je sors Elluka !)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
