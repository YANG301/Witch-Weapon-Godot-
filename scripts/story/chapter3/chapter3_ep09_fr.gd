# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("Selon le SID, plusieurs flux spatio-temporels intermittents ont été détectés près du Sky Hotel depuis hier soir.")
	await novel_interface.show_text_only("Par coïncidence, toute la délégation Salmonton s'est rendue hier soir dans cet hôtel de luxe situé dans la zone démilitarisée convenue.")
	await novel_interface.show_text_only("Ce soir, ils y organiseront un dîner d’échange d’art pour des célébrités de toutes les villes académiques.")
	await novel_interface.show_text_only("Mais Raphael et son accompagnateur ne sont pas invités.")
	await novel_interface.show_text_only("Donc, Mariru nous a de nouveau envoyé Annie et moi dans cet endroit ennuyeux.")
	await novel_interface.show_text_only("Debout à l’entrée de la magnifique salle de banquet, je me sens plutôt mal à l’aise.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Hum…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Est-ce que ça va ? Vous semblez plutôt nerveux.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bien sûr que oui. Je ne me suis jamais habillée en femme de chambre !", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ouais. Annie et moi sommes entrés dans la salle déguisés.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Et pourquoi devrais-je être la servante alors que vous êtes un représentant étudiant de Gosakuragawa ?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Tous les hommes aiment les robes de demoiselle d’honneur, n’est-ce pas ?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Eh bien, je suis presque sûr qu'aucun d'entre eux n'aime le porter lui-même !", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm… \\nVous avez raison.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Quel dommage, tu ne vois pas à quel point tu es mignonne dans cette jolie robe. \\nPas étonnant que vous soyez si agité…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie recule de quelques pas, prend son téléphone… \\nEt prend une photo de moi.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Wow… Ren, tu es adorable avec des twintails.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Arrêtez… Supprimez-le, maintenant !", "Lian")
	await novel_interface.show_dialog("(Un moment tellement honteux…) \\n(Si c'est vu…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un bruit sourd provenant du téléphone de Annie confirme une transmission réussie.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Je vous l'ai envoyé et Mariru !", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Merde.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Hé-hé, ne sois pas timide. \\nCette bordure à volants vous va bien !", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Je déverrouille mon téléphone et la photo apparaît à l'écran.")
	await novel_interface.show_text_only("Pas mal… ?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Vous êtes fou !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, une voix familière sort du casque.")
	await novel_interface.show_dialog("Très bien, plus de selfies, les filles. Vous avez tous les détails, n'est-ce pas ?", "Mariru")
	await novel_interface.show_dialog("La Quatrième Cité Académique a obtenu l'autorisation du Congrès Uni pour renforcer la sécurité de l'événement. Cet hôtel est donc fortement gardé ce soir.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Tout ce que nous avons à faire est de découvrir les causes des flux spatio-temporels et de nous retirer immédiatement, n'est-ce pas ? \\nJe l'ai compris.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Je ne peux pas faire de geste audacieux cette fois. Alors vous deux, n'oubliez pas de jouer à l'oreille. Surtout toi, Ren…", "Mariru")
	await novel_interface.show_dialog("Si l’un de ces gros bonnets s’intéresse à vous, vous n’aurez peut-être jamais la chance de vous échapper…", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Assez !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Je dois y aller. Quelques délégués de la Commission d'éducation Salmonton voulaient me parler. \\nC'est une bonne occasion d'écouter.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, fais juste ce que tu dois faire.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("En un clin d'œil, Annie simule un sourire et se retourne, \\nsaluant un groupe d'hommes en costume.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie est vraiment doué pour ça…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais qu’est-ce qu’une femme de chambre est censée faire maintenant ?", "Lian")
	await novel_interface.show_dialog("Tenir le plateau de service est si difficile…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Un Dom Pérignon, s'il vous plaît.", "Invité A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Euh ? Pouah… Bien sûr, monsieur. \\nHmm… Voudriez-vous répéter cela ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Invité A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Merde ! Est-ce que je demande quelque chose de vraiment stupide ?) \\nHmmm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sans formation adéquate, je n’ai absolument aucune idée de comment gérer cela. Je ne sais même pas ce qu'une femme de ménage devrait faire.")
	await novel_interface.show_dialog("Pff, tu sais que cet endroit est connu pour ses servantes, non ? \\nComment ont-ils pu laisser entrer quelqu'un d'aussi peu professionnel ?", "Invité A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Je suis désolé, monsieur…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Hé! Pourquoi restes-tu là comme une bosse sur une bûche ?", "Femme de ménage aux cheveux roses")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me retourne et vois une jolie femme de chambre aux cheveux roses et portant des lunettes à monture rouge.")
	await novel_interface.show_text_only("Elle adresse un sourire poli à l'invité. Alors qu’elle se retourne, le doux sourire se transforme en colère ardente.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Allez, allons chercher le champagne pour l'invité.", "Femme de ménage aux cheveux roses")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Hein ? Qui es-tu? \\n(De la façon dont elle s'habille, elle ne ressemble pas à une serveuse dans cet hôtel…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La servante aux cheveux roses me prend la main et se dirige vers le coin, sans un mot. Étonnamment, elle est pleine de force.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Espèces de doigts de beurre ! Qu'est-ce qui ne va pas?", "Femme de ménage aux cheveux roses")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pouah… je… je…", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Je suis désolé. Je suis nouveau dans ce travail. C'est mon premier jour ici…")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Attends, à ta façon de parler… Tu n’as pas non plus l’air d’une bonne…")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pourquoi me regardes-tu de cette façon ? \\nRemettez-vous en question mes capacités en tant que servante ?", "Femme de ménage aux cheveux roses")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Écoutez ! En tant que servante, je peux et je ferai tout pour mon maître. Personne ne peut en douter.", "Femme de ménage aux cheveux roses")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La fille aux lunettes rouges fait soudain un serment solennel devant moi.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("O… D’accord…", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Quoi qu'il en soit, merci de m'avoir aidé tout à l'heure... \\nHonnêtement, je ne savais pas quoi faire ensuite.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Alors, pourquoi es-tu ici ?", "Femme de ménage aux cheveux roses")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sa voix devient soudainement froide comme de la glace, \\n me faisant froid dans le dos.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Si tu me mens, je te réduirai en morceau de coca.", "Femme de ménage aux cheveux roses")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La fille a éclaté d’un rire argenté en prononçant ces mots intimidants, mais je suis presque sûr qu’elle ne plaisantait pas !")
	novel_interface.character_light()
	await novel_interface.show_dialog("Essayez-vous d'inventer quelque chose ?", "Femme de ménage aux cheveux roses")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Merde. Suis-je éclaté ?) \\n(Qui diable est-elle ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("Je sais qui tu es. \\nAprès tout…", "Femme de ménage aux cheveux roses")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, ne soyez pas impoli.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("En suivant le son, je trouve une petite fille vêtue d'une fabuleuse robe de soirée.")
	await novel_interface.show_text_only("Ses cheveux blonds brillants descendent jusqu'à la taille en tresses et ses yeux sont brillants et clairs comme du cristal.")
	await novel_interface.show_text_only("La présence d'une telle fille elfique à cette occasion flamboyante est comme une cheville carrée dans un trou rond.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Mademoiselle Skurd ! \\nJe suis vraiment désolé de vous avoir dérangé.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Féroce comme un lion il y a un instant, la bonne se transforme en chaton au moment où la petite fille apparaît.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Regardez la pauvre fille. Elle est trop terrifiée pour dire un mot.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Laisse-la partir pour le moment, d'accord ?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Roger ça !", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
