# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Я чувствовал беспокойство, когда Raphael гулял по кампусу.")
	await novel_interface.show_text_only("Никогда не думал, что смогу так легко приблизиться к цели.")
	await novel_interface.show_text_only("Заместитель директора, видя, как срывается его давно подготовленная церемония встречи, обиженно щипает носовой платок где-то позади нас.")
	await novel_interface.show_text_only("Однако юная леди, похоже, недовольна нашей маленькой экскурсией, хотя настроение у нее сейчас гораздо лучше.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Это все?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Угу, если вы имеете в виду тур.", "Lian")
	await novel_interface.show_dialog("Если вы продолжите в том же духе, вы попадете в коммерческую зону.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Многие здания здесь имитируют довоенный архитектурный стиль, пытаясь привнести ощущение культуры.", "Raphael")
	await novel_interface.show_dialog("Но этот кампус настолько мал, что между зданиями контрастных стилей нет буфера.", "Raphael")
	await novel_interface.show_dialog("Из-за этого здесь слишком душно, ты так не думаешь?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia — город, восстановленный на руинах. Большинство его исторических памятников сгорело.")
	await novel_interface.show_text_only("На самом деле это довольно роскошно иметь такой участок земли внутри защитного щита, где земли мало.")
	await novel_interface.show_text_only("Мне как-то обидно на ее слова…")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Хм…", "Lian")
	await novel_interface.show_dialog("Вы должны быть Raphael Dekkers из Четвертого Академгородка.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Так зачем же ты ходишь в школу, если тебе здесь не нравится?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Вау, ты знаешь, кто я?", "Raphael")
	await novel_interface.show_dialog("Хм… Это все из-за моего дедушки. Он хочет, чтобы я учился в другом Академгороде…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Но эта школа-подражатель, вообще без истории… Я никогда больше не ступлю на нее.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Значит, она просто недовольна планом дедушки...) \\n(Почему она просто не высказалась?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Дерьмо! Ее слова каким-то образом повлияли на меня. Все здания в школе вдруг кажутся странными.")
	await novel_interface.show_text_only("Черт возьми! Забудьте об этих комментариях! Сейчас!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ого, раз ты так разочарован…", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Почему бы тебе просто не сказать дедушке, что ты думаешь?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix подходит к нам, как всегда элегантная.")
	await novel_interface.show_text_only("Когда их взгляды встречаются, мне кажется, что я слышу потрескивающий звук разряда высокого напряжения.")
	await novel_interface.show_text_only("Должно быть, это… галлюцинация, да?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Кто ты?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Ну, я просто никто в этой школе.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Мне просто интересно, что привело вас сюда, миледи?", "Nix")
	await novel_interface.show_dialog("Почему ты вообще согласился приехать сюда? Это из-за давления семьи?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Мои семейные дела не твое дело.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Позвольте мне угадать. Эгоцентричный ребенок, который никогда не бросал вызов воле своих родителей.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Почему вы считаете себя выше? Кто дает вам право судить школу? В конце концов, она вызвалась показать вам окрестности.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Простите?! Когда я считал себя выше?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Эй, ты извращенец. Был ли я когда-нибудь таким высокомерным?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Не совсем…", "Lian")
	await novel_interface.show_text_only("Подождите, я не извращенец!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Видишь? Я этого не говорил.", "Raphael")
	await novel_interface.show_dialog("Кстати, эта штука на твоей шее…", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Разрешены ли украшения в этой школе?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("На самом деле никаких ограничений на ношение украшений у нас нет…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("А ожерелье Nix такое милое!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Группа, возможно, и скромная, но уж точно не ее жемчужина — «Черный бриллиант Орлова». Этот королевский драгоценный камень раскололся на три части и был потерян во время волнений перед началом войны.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Вероятно, здесь можно купить пару зданий всего по одной штуке.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Что?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Выдавать себя за обычного студента и говорить за них… Чего вы хотите? Чтобы обмануть эту переодевшуюся извращенку, что ты на ее стороне?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Перестань называть меня извращенцем!")
	await novel_interface.show_text_only("И почему у Nix такой тонкий, жалкий вид?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Я просто ношу то, что мне подходит.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("А ты? Вы пытаетесь выглядеть независимым, но гордитесь тем, что наслаждаетесь богатством своей семьи. Это весело.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Помню, все три куска попали в руки босса мафии. Черный бриллиант, купленный на нечестные деньги, — он вам очень идет.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что ж, я должен признать, что моей семье повезло меньше. Ведь не каждый может заработать состояние и дворянский титул благодаря монополии на зерно.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Это потому, что только наш урожай может помочь людям предотвратить Черную чуму. Они заслуживают того, чтобы жить. В отличие от тебя, гнилой наизнанку.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы настаиваете на сохранении веры, хотя угрожаете миру голодом. Почему бы тебе сначала не поразмышлять о своей душе?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Мне не нужно делать это с такими людьми, как ты. Это принесет мне только стыд.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("О, это звучит знакомо. О вас, неудачниках, я тоже знать не хочу.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Послеполуденное солнце нежно светит на нас.")
	await novel_interface.show_text_only("Находясь между ними, я понятия не имею, как разрешить этот бой.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Вы уверены, что не встречались раньше?)", "Lian")
	await novel_interface.show_dialog("(Вы действительно не враги на всю жизнь?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заместитель директора на расстоянии уже психанул и увезен на неотложную помощь.")
	await novel_interface.show_text_only("Неважно. У меня есть вся информация, которую хочет Mariru.")
	await novel_interface.show_text_only("В любом случае это не мое дело.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
