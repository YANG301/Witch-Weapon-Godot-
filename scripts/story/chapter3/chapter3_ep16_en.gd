# chapter3_ep16.gd - 第三章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep16_script()

func play_script():
	pass

func chapter3_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("It has been one week since the Spacetime Fluxes were detected at the Sky Hotel.")
	await novel_interface.show_text_only("Dr. Aya made Beatrice a delicate bracelet out of the Substance H metal used in the suitcase's inner shell.")
	await novel_interface.show_text_only("Thanks to the bracelet, now she can freely switch on or off her magic that attracts men.")
	await novel_interface.show_text_only("In exchange, Beatrice joined SID as an agent, just like Annie.")
	await novel_interface.show_text_only("Mariru puts her in a guest room in this luxurious apartment.")
	await novel_interface.show_text_only("At first, I was worried that the security soldiers would identify us from the CCTV footages for the executive floor.")
	await novel_interface.show_text_only("But surprisingly, none of us got caught on camera. Neither did Jacob and his fellows.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mariru, how much power does SID really have?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("Huh? Why do you ask?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Since more than one Academic City got involved this time, I thought it would be a nasty job to clean up the mess.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("I'm delighted that you have so much faith in SID…", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("But you and Annie could never have escaped from that place in one piece had it not been for the Senate. As you know, the Senate has a big say in the United Congress.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Dr. Kirs, the old guy with a poker face, always plays his cards close to his chest. So, I don't know what he has done exactly.", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Poker-faced… old guy?) \\nI thought the Senate would share their intelligence with SID…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("You're too naïve…", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("No intelligence agencies would share all their intelligence with the heads of state or government.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh? Why?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("As the saying goes, knowing is owning.", "Mariru")
	await novel_interface.show_dialog("The Senate is the highest authority in New Opulentia. So naturally, SID has to work with it. In other words, SID and the Senate are partners.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("If you were the boss, would you give all the confidential information to your partner for free?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm… Of course not…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("And if your partner has got some valuable confidential information you really want, what would you do?", "Mariru")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Let me see… \\nMaybe I'll buy off some janitor.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Smart girl. As long as the agency is big enough, it can always be broken from inside, no matter how strict its security protocol is.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("If… if that's the case, we've got moles in SID too?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("You bet. There are thousands of employees in SID and some of them must be spies, be it from the Senate, foreign intelligence agencies, or other organizations.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("That's why we need to keep only a small group of people in the loop when it comes to key intelligence.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("So what about the Ivory Hall…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("That's not something you should worry about. Naïve girls like you can never infiltrate into the Senate.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("All members of the Senate are experts in the field of Substance H with a minimum ranking of SS level.", "Mariru")
	await novel_interface.show_dialog("Those experts have got loads of Substance H items for experiment. If you sneak in there, you may get brainwashed before you know it.", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("But… there are still many questionable points in this case.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("For example, why did the Salmonton delegation smuggle the Golden Butterfly to New Opulentia?", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("And that necklace of Raphael, which is quite old-fashioned, is clearly not her cup of tea. She usually tucks it underneath the collar.", "Lian")
	await novel_interface.show_dialog("Actually, Raphael that I know… would never wear such ornaments…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("You've got a point. The Golden Butterfly has properties similar to those of infectious meme Substance H. The shield guard we use for such a dangerous item is usually as big as a truck.", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("But they just tucked it in a suitcase. The energy leaking from that suitcase can even be detected by satellites.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("If they really wanted to smuggle it in, why did they have to get those government officials to do it? Why would they take such a great political risk?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Maybe there is no risk at all. It's perhaps an order from someone higher up who has given them the guarantee…", "Lian")
	await novel_interface.show_dialog("Members of the delegation do not need to declare their hand luggage at the security checkpoint. And they deliberately chose a hotel outside of our jurisdiction.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Are you saying…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Finally getting it?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The Senate ordered them to do so? Just to keep SID in the dark?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Jacob is a military attaché of Salmonton and Elluka's data shows that they've been studying witches for a while.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("The Golden Butterfly belongs to a witch and Jacob suddenly appeared and joined the fight. \\nThink about it…", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The race for control of supernatural power threw the world into the chaos of the Seven Years War. Is that going to happen again?")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Will there be more witches produced then?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("It's time to get prepared for this fight under the table.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("A few weeks later")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Nnngh... I can barely keep my eyes open... \\nI stayed up all night grinding in a game...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Hey, cross-dressing freak.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("???", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The familiar voice…")
	await novel_interface.show_text_only("The familiar place…")
	await novel_interface.show_text_only("And the familiar greeting…")
	await novel_interface.show_text_only("The girl standing in front of me… It's her again!")
	await novel_interface.show_text_only("This sharp-tongued troublemaker Raphael!")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ra-Raphael? \\nWhy are you here?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("You aren’t taught any basic manners at this school, are you?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("I’m your senior. Show some respect!", "Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Huh?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I hadn't noticed that until now… \\nWith a satchel at hand, she wears the uniform and shoes for junior-year students.")
	novel_interface.show_character("ren_uniform","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I thought you hated this school…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("I had no other choice. \\nAll schools in New Opulentia suck.", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("As a witch, this school may be the best choice for me.", "Raphael")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("It seems that Raphael has done all the research and made her decision within such a short time. What a genius.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Your family… Have you told them that you're a witch?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Why bother? It would bring nothing but worries to them.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Hey, becoming a witch is nothing like joining an after-school club!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Can you imagine they sent me abroad just to let me lie low after that stupid interview?", "Raphael")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("If they find out about this, they will probably freak out, like when they heard that I had got a tattoo.", "Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("No, no, no. That’s just child’s play compared with turning into a witch! \\nWell, if you've really got some tattoo, show it to me please…")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("By the way… what on earth did you say in the interview?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Are you from the Stone Age or what? That video should have been flying around the Internet by now.", "Raphael")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Speaking of that, I'm quite popular on the Internet too. \\nAfter all, I'm a wanted criminal worldwide…")
	novel_interface.character_dark()
	await novel_interface.show_text_only("To be fair, I must have missed some big news because I’ve got completely sucked into playing the Legend of Zelda.")
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Stop looking at me that way…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I take out my phone to get the latest news. Raphael is not lying. Her name has made headlines all over the world.")
	await novel_interface.show_text_only("I play one of those videos, and soon Raphael's voice comes out.")
	await novel_interface.show_dialog("Why do they believe that all sinners can be redeemed as long as they pray to the gods? Prayer brings them nothing but some pathetic comfort.", "Raphael")
	await novel_interface.show_dialog("… Those trashes are useless wherever they go. Why should our government save their butts? Just let them rot.", "Raphael")
	await novel_interface.show_text_only("I can't believe that these controversial comments are made by Raphael, the granddaughter of the governor of Salmonton. No wonder it has caused such an uproar.")
	novel_interface.show_character("ren_uniform","speechless")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I remember that Salmonton is a religious welfare state… \\nYou've really got some guts to make those provoking comments.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("So many states have declared wars in the name of the gods. So, why can't I say what's on my mind?", "Raphael")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("War? You mean… the Seven Years War?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Nope, you idiot. Of course the coming wars!", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("At Salmonton, we encourage people to have their own religion, no matter which god they believe in.", "Raphael")
	await novel_interface.show_dialog("As a result of the massive migrations after the Seven Years War, countless trashes rushed into those useless groups, and their avarice knows no boundaries.", "Raphael")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Grandpa is too indulgent to them. Those lazybones should end up in slaughterhouses…", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Stop! It's getting creepy now…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Now you're at the heart of this massive transition. You just don’t care, or do you?", "Raphael")
	novel_interface.change_2nd_expression("thinking")
	await novel_interface.show_dialog("Maybe nobody but idiots like you can live such an optimistic life.", "Raphael")

	print("=== 第三章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
