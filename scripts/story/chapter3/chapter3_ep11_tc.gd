# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("拉斐爾的保鏢將我們團團圍住，安妮對我使了個眼色──")
	await novel_interface.show_text_only("我心領神會，將安妮剛才在走廊裡累積的能壓一口氣釋放出來。")
	await novel_interface.show_text_only("房間內頓時出現了大量高速射出的棒球，擊中一個人後又立刻彈向另一個。")
	await novel_interface.show_text_only("而那些保鏢顯然沒有應對這種場面的經驗，紛紛亂了陣腳，一個個中招倒地。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("嘿嘿，這還是第一次對普通人用這招呢，沒想到居然這麼快就全倒啦……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("當然囉，保有理智的人類比暴走的女巫好對付多了～", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("可惡，一群飯桶……", "拉斐爾")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("居然敢來這裡鬧事，保安警察不會放過你們的！", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我這下才發現拉斐爾的皇室套房裡因為戰鬥而變得一片狼藉，她的保鏢七橫八豎地倒在地上。")
	await novel_interface.show_text_only("本來我和安妮只想偷偷蒐集證據，看來反而製造了不得了的國際爭端……")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("糟了……安妮！ \\n快，快把她……綁起來！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("慌亂中，我向安妮發出了奇怪的指令。")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("欸？ 好哇！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮俐落地壓住拼命掙扎的拉斐爾，同時撕開散落在地上的窗簾，三兩下就將她五花大綁。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("你、你竟敢──！ ！\\n你這女裝變態，到底要對我做什麼？ ！", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("此時，新豐洲的國際賓客，第四學園都市市長的親孫女正被綁在自己酒店房間的椅子上──")
	await novel_interface.show_text_only("安妮，妳怎麼這麼熟練啊！ ！\\n而且這樣似乎完全無法洗刷變態的名聲了……")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("真的很抱歉，我們必須確保妳不會觸發警報器……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我指了指牆邊的紅色按鈕，那個一旦按下，3分鐘內就會有一隊手持重武器的保安警察將這裡包圍。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("哼，你們究竟想幹什麼？", "拉斐爾")
	await novel_interface.show_dialog("就這麼大剌剌闖進來，似乎也沒準備撤離方案──\\n你們應該不是想索取贖金的綁架犯吧？", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("就算被以如此不堪的姿勢綁在椅子上，依舊態度傲然、思路清晰……真不愧是貴族大小姐。")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("喂，妳們到底是什麼人？ \\n剛才用的是「異質物武器」嗎？", "拉斐爾")
	novel_interface.character_dark()
	await novel_interface.show_text_only("她這句話忽然讓我想起了現在最重要的任務。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("拉斐爾小姐，我們會來，只是要弄清楚一件事。 \\n關於那個手提箱……", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("手提箱？", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("拉斐爾露出了困惑的表情，好像完全不知道我在說什麼。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("啊！ 那個，好像……已經碎了呢！", "安妮")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("怎麼可能？ ！那種合金的強度應該很高吧？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("我朝著安妮手指的方向望去，在不遠處看到了一個被棒球砸出數個大坑的手提箱。")
	await novel_interface.show_text_only("外面的黑色塑膠殼已經破碎脫落，露出了裡面泛著淡藍色光暈的金屬內層。")
	await novel_interface.show_text_only("那種黑色塑膠殼是一種常見的可拆卸偽裝物，安妮應該是偶然看到了手提箱內層的材質。")
	await novel_interface.show_text_only("箱子的鎖扣也被砸壞了，內容物和一些金屬碎片散落在旁邊的地毯上。")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("奇怪，我的棒球應該只會追蹤有生命的目標才對……", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("拉斐爾似乎也看到了那個泛著淡藍色光暈的金屬材質，露出了驚訝和慌張的神情。")
	await novel_interface.show_text_only("一旁散落的減震海綿和金屬碎片堆裡，我發現了一個正在閃爍的小東西。")
	await novel_interface.show_text_only("那是一個蝴蝶樣式的金色飾品，造型栩栩如生，翅膀上的鏤空花紋十分精美。")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("會不會是因為這個……手提箱才被妳的棒球當做攻擊目標啊？", "小憐")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("欸！ 小心！ 那可能是「異質物」──", "安妮")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("精巧的黃金蝴蝶似乎隨時會振翅飛走一樣，不僅吸引了拉斐爾的注意，連我都忍不住伸手……")
	await novel_interface.show_dialog("喂喂，笨蛋。 \\n都叫妳別碰了──", "莉琉")
	await novel_interface.show_text_only("莉琉的聲音突然傳出，我的身體忽然一陣酥麻，就像她正在我身旁說話一樣。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("欸？ \\n什、什麼啊！ ！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我慌張地在身上尋找著聲音的源頭，確定自己衣服裡沒有帶著擴音器之類的東西。")
	await novel_interface.show_dialog("妳這笨蛋！ 要是安妮的棒球能把洛氏硬度70的合金砸出坑，那幾個保鏢的腦袋早就開花了。", "莉琉")
	await novel_interface.show_dialog("大概是這個小東西想借助棒球的衝擊力掙脫出來吧……", "莉琉")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("所以，那些坑洞……是它自己造成的？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("呵呵，很有可能喔，所以說這麼危險的東西妳還敢亂碰嗎？", "莉琉")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("這樣啊，那剛剛真是謝謝妳了……不對，重點是──\\n莉琉！ ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("可惡，我找到聲音來源了！")
	await novel_interface.show_text_only("聲音是從我的胸部傳出來的，怪不得莉琉一說話我就感覺麻麻的……")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("妳果然在我身上植入了什麼奇怪的晶片吧！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("居然當著外人隨意透露我們的機密技術，妳是不是太久沒被我踩了，皮在癢？ ？", "莉琉")
	await novel_interface.show_dialog("安妮，先讓那位大小姐睡一下吧～\\n不過小心點，別傷到我們的貴賓。", "莉琉")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("喂！ 妳們想──！", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮對著拉斐爾的後頸使出一記快速輕巧的手刀，拉斐爾瞬間暈了過去。")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("莉琉小姐，這類「異質物」未經申報不能帶入新豐洲市內吧？", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("當然了，哼，居然我的眼皮底下偷運這種東西，看來戴克斯博士必須給元老院一個交代了。", "莉琉")
	await novel_interface.show_dialog("……等等，走廊裡的保全似乎被發現了。", "莉琉")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("啊，這麼快？", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("現在樓下的保安警察正在大廳集合。 \\n我馬上帶著收容隊趕去，預計8分鐘內到達。", "莉琉")
	await novel_interface.show_dialog("安妮，妳現在用氣凝膠封住大門。", "莉琉")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("好的～馬上辦！", "安妮")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
