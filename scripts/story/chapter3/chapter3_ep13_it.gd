# chapter3_ep13.gd - 第3章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep13_script()

func play_script():
	pass

func chapter3_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Beatrice sbatte le palpebre e si lecca le labbra inconsciamente.")
	await novel_interface.show_text_only("Sento un calore crescente che si diffonde rapidamente in ogni parte del mio corpo.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, Ren?!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Mwahahah…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Ehi!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La guardo per un momento con sguardo assente prima di ritornare in me. \\nMa non posso fare a meno di guardare di nuovo Beatrice.")
	novel_interface.show_character("beatrice_battle","smile3")
	await novel_interface.show_dialog("Scusate la sete di drink… \\nMa posso avere un bicchiere di vino?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lei... sta parlando con me? \\nLe pulsazioni accelerano, riesco quasi a sentire il mio cuore battere forte.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Vuol dire che vuole bere vino?", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Te ne prendo subito un po'!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Ah... per l'amor del cielo! \\nRen si sta comportando da idiota!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael fissa intensamente l'ospite inaspettato come se cercasse di collegarla alla farfalla dorata.")
	await novel_interface.show_text_only("Per quanto esigente sia Raphael, non c'è spazio per lei di preoccuparsi della bellezza di Beatrice.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Signorina, non dovrebbe spiegarci perché all'improvviso è qui?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Sei vestita come una nobiltà europea medievale... \\nE hai chiesto del vino quando avevi sete...", "Raphael")
	await novel_interface.show_dialog("Vieni da una festa in maschera? O ti sei teletrasportato qui?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Se la farfalla d'oro è un frammento di strega...", "Annie")
	await novel_interface.show_dialog("E visto che Ren è qui... forse è...", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("—Una strega?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre passo il vino, la parola \"strega\" attira la mia attenzione.")
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("Strega…", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("I preti del Tribunale mi chiamavano così. \\nUn nome che conosco ma che non mi è familiare...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice sembra pensare intensamente a qualcosa.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Tribunale? \\nAbituato?", "Annie")
	novel_interface.change_expression("unhappy")
	await novel_interface.show_dialog("(Oh no, andiamo…)", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("Mi hanno obbligato a bere un bicchiere di vino a corte…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice ritorna dalla memoria e prende il bicchiere con un sorriso.")
	novel_interface.show_character("ren_maid","heart")
	await novel_interface.show_dialog("(Wow... è davvero fantastica, decisamente...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Per camminare in novità di vita, devi dimenticare e perdonare.", "Beatrice")
	await novel_interface.show_dialog("Questo verso è stato scritto da uno dei miei ammiratori...", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Sei tu che mi dai questa novità di vita?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Io? \\nCosa, uhm...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("È una specie di scherzo?", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Hai detto che la poesia è stata scritta per te? Ah, non dirmi che l'hai incontrato alla porta del regno dei cieli!", "Raphael") 
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Streghe... \\nEsistono solo nelle leggende inventate. Non esistono le streghe.", "Raphael") 
	await novel_interface.show_dialog("Hai il cervello rotto? \\nNemmeno Substance H può farlo.", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Perché... \\nPerché...!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Perché Substance H ha un attributo fondamentale: non può invertire il tempo.", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mariru?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non c'è da stupirsi che tu sia il nipote preferito del Dr. Dekkers! Questo viene insegnato solo nei corsi post-laurea!", "Mariru")
	novel_interface.show_character("ren_maid","sprite")
	await novel_interface.show_dialog("Ehi, le mie tette vibrano mentre parli!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("E... fa il solletico!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Qualcuno parla dentro i tuoi vestiti?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Uffa, è nel mio corpo. \\nMa non voglio parlare di questo adesso...")
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Signorina Raphael Dekkers, questo è Mariru Von Braun, capo di SID di New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Abbiamo rilevato flussi spaziotemporali intermittenti attorno allo Sky Hotel da ieri sera.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Si prega di collaborare con i nostri due agenti da ora in poi. Altrimenti non posso garantire la tua sicurezza.", "Mariru")
	await novel_interface.show_dialog("Proprio adesso, il Dr. Dekkers mi ha inviato la chiave di sicurezza: \\nNoblesse Oblige.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Nonno…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Non sono un bambino!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Da un grande potere derivano grandi responsabilità. \\nTuo nonno sembra essere un grand'uomo.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hmm, spero solo che tu sia degno di fiducia.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Allora, puoi dirmi qualcosa sulla tua valigia?", "Mariru")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Chiedi ai tuoi uomini! Intendo il maniaco del travestitismo e quella ragazzina.", "Raphael")
	await novel_interface.show_dialog("Se non fossero entrati nella mia stanza, non avrei notato affatto la valigia.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","speechless")
	await novel_interface.show_dialog("Maniaco del travestitismo?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Senza rendermene conto, mi tolgo i vestiti da cameriera francese. \\nChe peccato!")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Bene, ora che ci ripenso... Solo una cosa era strana.", "Raphael")
	await novel_interface.show_dialog("Questo pomeriggio, le mie guardie del corpo erano in qualche modo distratte e turbate.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Immagino... conosco il motivo.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oh, e tu?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Il ciondolo della tua collana... è uno smeraldo, suppongo?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice indica il petto di Raphael.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Come lo sai? \\nÈ sotto i miei vestiti...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael alza la collana sorpreso. C'è davvero uno smeraldo.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Se ricordo bene, quello è il gioiello della sciabola che mi ha affidato mio padre.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Cosa?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Proprio adesso, ha risuonato violentemente in me nell'oscurità...", "Beatrice")
	await novel_interface.show_dialog("Anche se in mezzo c'era una barriera, ne ero sicura perché non confondo mai le cose che mi appartengono.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Sciocchezze! Questa collana appartiene alla famiglia Dekkers… È con noi da centinaia di anni!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("È la risonanza tra gli averi di una strega e il frammento della strega?", "Annie")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Aspetta, il primo interessato dovrebbe essere...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lascia questo da parte, ok? I ragazzi fuori stanno facendo irruzione.", "Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Oh, quasi dimenticatevi di questi inutili idioti!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Uff, finalmente posso liberarmi di questo vestito!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Proprio quando inizio a provare un po’ di sollievo, un brivido mi percorre.")
	await novel_interface.show_text_only("Sulla crosta dell'aerogel appare una macchia bianca. Si espande gradualmente, producendo un suono scoppiettante.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("I soldati della sicurezza... sono solitamente armati di iniettori di azoto liquido?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Con un forte schiocco, la crosta dell'aerogel cade in pezzi come vetro rotto.")
	await novel_interface.show_text_only("Un gruppo di uomini armati irrompe e ci circonda.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Cosa vuoi?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non so chi siano, ma dalle loro strane maschere blu scuro posso dire che non sono soldati della sicurezza.")
	await novel_interface.show_dialog("Non mi aspettavo questo giorno così presto...", "Voce maschile")
	await novel_interface.show_text_only("Una voce maschile familiare proviene da dietro la porta.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Tu sei...?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Piacere di incontrarti... di nuovo.", "Jacob")

	print("=== 第3章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
