# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("O Aerogel Spray é uma arma semelhante a um spray de cabelo inventada pelo Dr. Produz grandes quantidades de espuma em uma fração de segundo.")
	await novel_interface.show_text_only("Uma vez no ar, a espuma se expande e endurece rapidamente, ficando tão rígida que nem balas conseguem atravessá-la.")
	await novel_interface.show_text_only("Enquanto Annie fecha a porta com aerogel, sou novamente atraído pela borboleta dourada no chão.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Parece uma obra de arte linda…)", "Lian")
	await novel_interface.show_dialog("(Mas ... não posso evitar ... eu realmente quero tocar nisso ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Um desejo ardente me toma, e tudo na minha frente emite um brilho deslumbrante. Não posso deixar de entrar em contato—")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Pare!! Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie agarra meu pulso. Então, de repente, volto a mim.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Talvez essa coisa possa invadir a mente das pessoas… É por isso que elas têm que guardar naquela mala?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ah! Eu quase ... o que diabos ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Esta borboleta dourada parece familiar... \\nSuspeito que seja um Fragmento de Bruxa.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um fragmento de bruxa?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hmm, como devo dizer…", "Annie")
	await novel_interface.show_dialog("O poder mágico é na verdade um tipo de conhecimento que o cérebro humano absorve de um tipo único de “informação”.", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mas as pessoas obtêm e asseguram esse conhecimento geralmente à custa da sua sanidade.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("As bruxas na Subestação e os inimigos nas áreas de fluxo vêm à minha mente.")
	await novel_interface.show_text_only("A sua insanidade deve ser causada pela acumulação excessiva de “conhecimento” que o seu corpo não suporta.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("A “informação” pode, na verdade, ser dividida em pedaços e armazenada separadamente. Um Fragmento de Bruxa é um recipiente com pequenos pedaços de “informação”.", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Quanto ao motivo deste design, acho que ele foi criado para que os humanos ultrapassem seus limites...", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Para descobrir até que ponto eles podem escapar impunes sem perder a sanidade, eles usam os Fragmentos de Bruxa para absorver o conhecimento aos poucos?", "Lian")
	await novel_interface.show_text_only("O ato em si parece bastante louco!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Continuar desejando e buscando novos conhecimentos sem fim - na verdade, essa é a natureza humana ...", "Annie")
	await novel_interface.show_dialog("Mesmo que estejam condenados à destruição ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E se uma garota comum conseguir o Fragmento de Bruxa, mas não tiver habilidade para usá-lo? Ela se tornará uma das bruxas que conhecemos na Subestação...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Muito provavelmente. E não há escudo ao redor do Fragmento da Bruxa, então qualquer um pode tocá-lo diretamente.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Não é super perigoso então?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Bum! \\n—Bum!")
	await novel_interface.show_text_only("Do lado de fora da sala ouvem-se sons baixos e profundos de batidas pesadas na porta de madeira.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Os soldados de segurança!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Rachadura!! \\nDepois de apenas dois golpes, a porta da Suíte Real é quebrada em pedaços por um arrombador.")
	await novel_interface.show_text_only("—Baque! —Baque! —Baque! \\n—Baque! —Baque! —Baque!")
	await novel_interface.show_text_only("Em seguida, vêm os sons de arrombadores de portas atingindo em vão a espuma sólida de aerogel.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Talvez possa aguentar até a Sra. Mariru chegar… \\nVeja, a invenção da Dra. Aya funciona!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toco meu peito, onde Mariru plantou o alto-falante sem meu conhecimento.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Aha… \\nSim, funciona…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, Raphael agora acordado, se joga em minha direção, a cadeira ainda amarrada ao seu corpo.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Nunca… você vai tirar nada!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Seu pervertido montado em alto-falante!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se liberta quando a cadeira atinge o chão. Então ela corre para agarrar a borboleta dourada.")
	await novel_interface.show_text_only("Vendo isso, eu corro em direção à borboleta, quase prestes a colidir com ela—")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Não, Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_dialog("(Uh? Eu entendi?) \\n(Ops…)", "Lian")
	await novel_interface.show_dialog("(O mais suave é…)", "Lian")
	await novel_interface.show_dialog("(Parece familiar. Acabei de tocá-lo)", "Lian")
	await novel_interface.show_dialog("(Espere. Poderia ser…!)", "Lian")
	await novel_interface.show_dialog("… Você!", "Raphael")
	await novel_interface.show_dialog("Pervertido!!!", "Raphael")
	await novel_interface.show_text_only("— Tapa!")
	await novel_interface.show_text_only("O tapa retumbante me deixa tonto.")
	await novel_interface.show_text_only("Imagens visuais passam pela minha mente, tudo foi silenciado em um instante.")
	await novel_interface.show_text_only("Eu me sinto em outro mundo. A sensação estranha desaparece num piscar de olhos.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Ao abrir os olhos, ainda me encontro na Suíte Real.")
	await novel_interface.show_text_only("O acessório dourado ganha vida e pousa no meu peito, irradiando uma luz brilhante.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Como isso seria…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando a luz fica mais fraca e desaparece gradualmente, sinto meu rosto suavemente acariciado. Esse toque suave e mágico está gravado em minha mente.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("—Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No espaço aberto desta sala, aparece uma linda mulher.")
	await novel_interface.show_text_only("Meus olhos estão fixados em seus olhos e cabelos vermelho-claros, corpo esguio e pele parecida com jade.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… O que aconteceu?) \\n(Meus lábios foram tocados por alguma coisa!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Hahaha, nada!) \\n(No que eu estava pensando? É impossível!)", "Lian")
	await novel_interface.show_dialog("(Não… não é impossível!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Merda, o sentimento... O sentimento...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, o calor há muito perdido do corpo humano.", "Mulher Inesperada")
	await novel_interface.show_dialog("Boa noite, jovens!", "Mulher Inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Meu coração está batendo mais rápido. Não posso deixar de caminhar em direção a ela. Meus membros não são mais meus.")
	await novel_interface.show_text_only("Abro meus braços e os envolvo firmemente em torno dela, à vista de todos.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Olá, querido. Você não se sente bem, está...?", "Mulher Inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Com licença…", "Lian")
	await novel_interface.show_dialog("Posso saber seu nome, por favor…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É estranho. Seu corpo parece ficar cada vez mais pesado... \\nE sua temperatura subindo...")
	await novel_interface.show_text_only("O que há de errado comigo!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ooh la la! \\nIsso é tão inacreditável.", "Mulher Inesperada")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me arrasta para longe da mulher.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Quem… é você?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Se meu nome não é um tabu em sua época… Por favor, me chame de Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Que nome lindo…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren… \\nVocê começa a parecer um horndog!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
