# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Вы имеете в виду... уничтожить всю стороннюю информацию об этом парне?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Нет. Как раз наоборот, добавлю больше информации.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("На лице Mariru расползается леденящая кровь улыбка.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Теперь единственной информацией о грабителе являются лишь кадры с низким разрешением.", "Mariru")
	await novel_interface.show_dialog("Только представьте, сколько людей во всем мире имеют такие невзрачные лица.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Подожди, ты только что сказал «просто»? Это жалит.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("И даже если кто-то действительно похож на «я», это все равно будет легко узнать.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Камеры видеонаблюдения фиксируют все, что он делал в тот день!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Конечно, выделить реального человека несложно.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Но что, если… этого человека не существует?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы имеете в виду…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Если мы подбросим какие-то поддельные личности с чертами лица, похожими на подозреваемого, выяснить это будет практически невозможно.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("И для всех, кроме нас, эти люди ничем не отличаются от "+GameConfig.player_name+" — это просто еще одни таинственно исчезнувшие люди.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Тогда как же узнать настоящую цель?", "Mariru")
	await novel_interface.show_dialog("Чтобы спрятать рисовое зерно, вы либо убираете его, либо насыпаете целый мешок риса, чтобы прикрыть его.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Звучит как огромный проект…", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Немного усложнить простую задачу, чтобы налогоплательщики были довольны тем, как тратятся их деньги. Видеть? Двух зайцев одним выстрелом.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Каждый раз, когда ты делаешь такие неуместные комментарии, мне хочется позвонить в полицию.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Кстати, я обнаружил некоторые противоречия в вашей идентификационной информации.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("А? Какая часть?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("О твоих родителях.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("У меня замирает сердце при слове «родители».")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ты сказал мне, что твоя мать рано умерла, а твой отец пропал.", "Mariru")
	await novel_interface.show_dialog("Я знаю, ты не хочешь об этом говорить. Но это важно. Я должен уточнить у тебя.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Хорошо…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru получает данные, резервную копию которых она создала.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Здесь написано, что ваша мать пропала 25 июля 2026 года и предположительно мертва. \\nЭто была Великая Скорбь.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("До этого дня подводные руины на северо-западе New Opulentia были шумным городом.")
	await novel_interface.show_text_only("У меня остались лишь смутные воспоминания об этом…")
	await novel_interface.show_text_only("В тот момент, когда город был разрушен оружием Божественного касания, Aegis создал защитное поле. New Opulentia был на грани этого.")
	await novel_interface.show_text_only("И… Это положило начало Семилетней войне.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Отец, пропал без вести в декабре 2026 года. Предположительно…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Остановитесь... пожалуйста!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ненавижу эту холодную фразу: «Предположительно… мёртвый».")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Я всегда говорю себе… \\nМожет быть… папа еще жив…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Что ж, твой папа, должно быть, счастлив. Его мальчик вырос и стал красивой девочкой!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смеюсь над ее словами. \\nЧерт побери, я знаю, что она меня дразнит!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ну, посмотри на это.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она заходит на профили моих родителей. Появятся два кода.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("По профилю —", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мама, код оффлайн. \\nОтец, код не в сети.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Что-то не так?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis не присвоил бы код вашей матери, если бы она умерла до активации защитного поля или где-то за пределами его действия.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Э…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru задумчиво смотрит на меня.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Вы тоже понятия не имеете? \\nФайлы не будут лгать. Я буду следить за этим…", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
