# chapter3_ep13.gd - 第3章第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep13_script()

func play_script():
	pass

func chapter3_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Beatrice моргает и бессознательно облизывает губы.")
	await novel_interface.show_text_only("Я чувствую, как нарастающий жар быстро распространяется по всем частям моего тела.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Рен, Рен?!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Мвахаха…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Эй!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю тупо на мгновение, прежде чем прийти в себя. \\nНо я не могу не взглянуть на Beatrice снова.")
	novel_interface.show_character("beatrice_battle","smile3")
	await novel_interface.show_dialog("Простите за жажду выпить… \\nНо можно мне бокал вина?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она… разговаривает со мной? \\nПульс учащенный, я почти слышу, как громко стучит мое сердце.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Означает ли это, что она хочет выпить вина?", "Lian")
	novel_interface.change_expression("blush")
	await novel_interface.show_dialog("Я принесу тебе немного прямо сейчас!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Ах, ради бога! \\nРен ведет себя как идиот!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael пристально смотрит на нежданную гостью, словно пытаясь связать ее с золотой бабочкой.")
	await novel_interface.show_text_only("Какой бы придирчивой ни была Raphael, ей негде беспокоиться о красоте Beatrice.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Мисс, не могли бы вы объяснить нам, почему вы вдруг здесь?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Вы одеты как средневековая европейская знать… \\nИ вы просите вина, когда хотите пить…", "Raphael")
	await novel_interface.show_dialog("Ты с костюмированной вечеринки? Или ты телепортировался сюда?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Если золотая бабочка — это осколок ведьмы…", "Annie")
	await novel_interface.show_dialog("И раз уж Рен здесь… Может быть, она…", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("— Ведьма?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда я прохожу мимо вина, мое внимание привлекает слово «ведьма».")
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("Ведьма…", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Священники в здании суда меня так называли. \\nЗнакомое, но незнакомое мне имя…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice, кажется, о чем-то напряженно думает.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Здание суда? \\nПривыкли?", "Annie")
	novel_interface.change_expression("unhappy")
	await novel_interface.show_dialog("(О нет, давай...)", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","normal")
	await novel_interface.show_dialog("При дворе меня заставили выпить бокал вина…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice возвращается из своих воспоминаний и с улыбкой берет стакан.")
	novel_interface.show_character("ren_maid","heart")
	await novel_interface.show_dialog("(Ух ты… Она определенно выглядит потрясающе…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Чтобы ходить в обновленной жизни, ты должен забыть и простить.", "Beatrice")
	await novel_interface.show_dialog("Этот стих написал один из моих поклонников…", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Ты тот, кто дает мне эту новизну жизни?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Я? \\nЧто, эмм…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Это какая-то шутка?", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Вы сказали, что стихотворение написано для вас? Ха, только не говори мне, что ты встретил его у ворот Царства Небесного!", "Raphael") 
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Ведьмы... \\nОни существуют только в вымышленных легендах. Ведьм не существует.", "Raphael") 
	await novel_interface.show_dialog("У тебя мозги сломаны? \\nДаже Substance H не может этого сделать.", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Потому что… \\nПотому что…!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Потому что у Substance H есть один базовый атрибут: он не может повернуть время вспять.", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mariru?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Неудивительно, что ты любимый внук доктора Dekkers! Этому учат только в аспирантуре!", "Mariru")
	novel_interface.show_character("ren_maid","sprite")
	await novel_interface.show_dialog("Эй, моя грудь вибрирует, когда ты говоришь!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("И… щекочет!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Кто-то говорит внутри твоей одежды?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ух, это в моем теле. \\nНо я не хочу сейчас об этом говорить...")
	await novel_interface.hide_background_with_fade()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Мисс Raphael Dekkers, это Mariru Фон Браун, руководитель SID New Opulentia.", "Mariru")
	await novel_interface.show_dialog("Со вчерашнего вечера мы обнаружили прерывистые пространственно-временные потоки вокруг отеля «Скай».", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Пожалуйста, сотрудничайте с нашими двумя агентами с этого момента. В противном случае я не смогу обеспечить вашу безопасность.", "Mariru")
	await novel_interface.show_dialog("Только что доктор Dekkers прислал мне ключ безопасности — \\nNoblesse Oblige.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Дедушка…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Я не ребенок!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("С большой силой приходит и большая ответственность. \\nТвой дедушка, кажется, великий человек.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Хм, я просто надеюсь, что ты заслуживаешь доверия.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Тогда можешь рассказать мне что-нибудь о своем чемодане?", "Mariru")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Спросите своих людей! Я имею в виду трансвестита и ту маленькую девочку.", "Raphael")
	await novel_interface.show_dialog("Если бы они не ворвались в мою комнату, я бы вообще не заметил чемодан.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","speechless")
	await novel_interface.show_dialog("Урод, переодевающийся в одежду другого пола?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Сама того не осознавая, я стягиваю с себя наряд французской горничной. \\nКакой позор!")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Ну, теперь, когда я вспоминаю… Только одно было странным.", "Raphael")
	await novel_interface.show_dialog("Сегодня днём мои телохранители были как-то рассеяны и расстроены.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Думаю… Я знаю причину.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("О, ты?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Кулон на твоем ожерелье — я полагаю, изумруд?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice указывает на грудь Raphael.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Откуда ты знаешь? \\nОно у меня под одеждой…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael удивленно снимает ожерелье. Изумруд действительно есть.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Если я правильно помню, это драгоценный камень на сабле, которую доверил мне отец.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Что?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Только сейчас это яростно резонировало со мной в темноте…", "Beatrice")
	await novel_interface.show_dialog("Несмотря на то, что между ними был барьер, я был уверен, потому что никогда не ошибаюсь в вещах, которые принадлежат мне.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Ерунда! Это ожерелье принадлежит семье Dekkers… Оно с нами уже сотни лет!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Это резонанс между вещами ведьмы и осколком ведьмы?", "Annie")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Подождите, тогда первым, кого затронет, должен быть…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Оставь это в стороне, ладно? Ребята снаружи врываются.", "Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Ох, почти забудьте об этих бесполезных идиотах!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Уф, наконец-то я могу избавиться от этого наряда!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как только я начинаю чувствовать некоторое облегчение, меня охватывает холод.")
	await novel_interface.show_text_only("На корочке аэрогеля появляется белое пятно. Он постепенно расширяется, издавая потрескивающий звук.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Солдаты службы безопасности… обычно вооружены инжекторами жидкого азота?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("С громким треском корка аэрогеля разваливается на куски, как битое стекло.")
	await novel_interface.show_text_only("Группа вооруженных людей врывается и окружает нас.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Чего ты хочешь?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я не знаю, кто они, но по их странным темно-синим маскам я могу сказать, что они не солдаты службы безопасности.")
	await novel_interface.show_dialog("Не ожидал, что этот день пройдет так скоро…", "Мужской голос")
	await novel_interface.show_text_only("Из-за двери доносится знакомый мужской голос.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Ты-?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Приятно познакомиться... снова.", "Jacob")

	print("=== 第3章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
