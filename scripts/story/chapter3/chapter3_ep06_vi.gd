	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ôi, cô Aya, tôi cảm thấy không được khỏe lắm. Tôi có thể nghỉ ngơi ở đây được không?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix thật tuyệt vời. Làm sao cô ấy có thể tiếp tục mỉm cười mà không bình luận về câu trả lời đáng kinh ngạc của Aya?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Không vấn đề gì, bạn có thể sử dụng chiếc giường đó. \\nSẽ mất thêm 15 phút nữa để hoàn thành việc tôi đang làm.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya tháo màn hình khỏi thiết bị và rời khỏi phòng để tải dữ liệu lên.")
