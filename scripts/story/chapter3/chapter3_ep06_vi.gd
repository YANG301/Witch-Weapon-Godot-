	await novel_interface.show_text_only("Tôi phải được Aya kiểm tra và điều trị toàn diện về thể chất mỗi khi tôi trở về từ Vùng Flux.")
	await novel_interface.show_text_only("Tôi ghét phải thừa nhận nhưng dụng cụ hình con bạch tuộc của Aya khá hữu ích trong việc chữa lành vết thương.")
