	await novel_interface.show_text_only("Nhìn vào bức ảnh, tôi cảm thấy tim mình đập dữ dội và cơ thể bắt đầu run rẩy không thể kiểm soát.")
	await novel_interface.show_text_only("Sau đó tôi lấy lại hơi thở, tất cả chỉ trong chốc lát. Aya đang mải mê sử dụng ống nghe và dường như không nhận thấy chuyện gì đang xảy ra.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(Có chuyện gì vậy?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cảm thấy rằng… thậm chí qua bức ảnh, có điều gì đó trong Raphael cộng hưởng với nhạc cụ.")
