	await novel_interface.show_dialog("Cảm ơn.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix gật đầu với Aya và nằm xuống giường cạnh tôi.")
	await novel_interface.show_text_only("Chiếc giường chỉ cách đó một cánh tay. Nix không đóng rèm.")
