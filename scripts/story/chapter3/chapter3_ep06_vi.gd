	await novel_interface.show_dialog("(Cô ấy cứ nằm như thế này trước mặt một người lạ sao?) \\n(À vâng, chúng ta đều là con gái…)", "Lian")
	await novel_interface.show_dialog("(Chết tiệt. Tim tôi đang đập nhanh.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi lén lút quay lại, lén nhìn cô ấy. Cách cô ấy vén tóc ra sau tai thật duyên dáng.")
	await novel_interface.show_text_only("Chúng tôi rất thân thiết. Tôi thậm chí có thể ngửi thấy mùi thơm thoang thoảng trên người cô ấy…")
	await novel_interface.show_text_only("Khi tôi đang chìm đắm trong những suy nghĩ mơ màng, Nix quay lại và nhìn thẳng vào tôi.")
