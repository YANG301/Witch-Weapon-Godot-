	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Không, không phải vậy!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cảm giác cộng hưởng kỳ lạ biến mất.")
	await novel_interface.show_text_only("Có phải nó bị gián đoạn bởi Aya?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Thông số dao động đó là gì?", "Lian")
	novel_interface.character_move_left(-0.25)
