# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Tôi rời Trụ sở chính với tập sách ghi đầy đủ thông tin chi tiết về cô gái mặc máy bay phản lực. Mariru cũng nhắn cho tôi ảnh của cô ấy.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Sinh ra trong một trong những gia đình quý tộc của Salmonton, Raphael là cháu gái của Tiến sĩ Thomas Dekkers, chủ tịch của Tập đoàn Phát triển Gen Monton.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Wow… Tôi đã đọc về anh ấy trong sách giáo khoa! \\nĐiều này đang trở nên hơi điên rồ…", "Lian")
