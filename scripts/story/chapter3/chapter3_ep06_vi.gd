	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Có chuyện gì thế?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ôi! À… \\nUh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Tôi chợt tỉnh lại và cảm thấy mình như một đứa trẻ bị bắt quả tang đang chơi khăm.")
