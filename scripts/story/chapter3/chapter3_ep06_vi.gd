	await novel_interface.show_text_only("Bắt được rồi! Xin chào em yêu!")
	await novel_interface.show_text_only("Có ai đó ôm tôi từ phía sau.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Waaa—!", "Lian")
	await novel_interface.show_dialog("… Aya, là bạn đây! Bạn đang làm cái quái gì vậy?", "Lian")
