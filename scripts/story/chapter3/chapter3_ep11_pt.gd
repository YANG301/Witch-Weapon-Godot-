# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Estamos cercados pelos guarda-costas de Raphael. Annie me dá uma piscadela—")
	await novel_interface.show_text_only("Eu entendi o que ela queria dizer imediatamente e liberei todo o poder de pressão que ela coletou quando estávamos no corredor.")
	await novel_interface.show_text_only("De repente, centenas de bolas de beisebol foram lançadas, atingindo um cara e imediatamente quicando em direção a outro.")
	await novel_interface.show_text_only("Obviamente, nunca tendo visto isso antes, os guarda-costas entram em pânico e são abatidos um após o outro.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Nunca usei esse truque com pessoas comuns antes. Funciona tão bem…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Claro! Humanos sãos são muito mais fáceis de lidar do que bruxas malucas!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Atire! Seus idiotas…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Como vocês ousam, encrenqueiros! Os soldados de segurança não vão deixar você escapar!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Acabei de notar que depois da luta, a Suíte Real de Raphael ficou uma bagunça total, seus guarda-costas espalhados pelo chão.")
	await novel_interface.show_text_only("Annie e eu só queríamos entrar furtivamente e coletar evidências, mas parece que causamos um sério desastre diplomático…")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Merda… Annie! \\nC… vamos lá! Amarre ela!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Em pânico, dou a Annie uma instrução maluca.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Sim! Vai fazer!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie agilmente derruba Raphael, abre uma cortina que caiu no chão durante a luta e, com isso, rapidamente amarra a garota que se debatia.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Como você ousa—!! \\nSeu pervertido travestido! O que você quer de mim?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Agora, Raphael, a convidada de honra do estado em New Opulentia, neta do prefeito da Quarta Cidade Acadêmica, está amarrada a uma cadeira em sua própria suíte—")
	await novel_interface.show_text_only("Annie é muito bom nisso!! \\nE parece que nunca conseguirei me livrar da reputação de pervertido…")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Sinto muito por isso, mas precisamos ter certeza de que você não acionará o alarme...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aponto para um botão vermelho na parede. Uma vez pressionado, uma equipe de soldados de segurança fortemente armados cercará a sala em 3 minutos.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, então o que você quer?", "Raphael")
	await novel_interface.show_dialog("Vocês não estão escondendo suas identidades e não parecem ter um plano de evacuação—\\nIsso não é um sequestro para obter resgate, não é?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mesmo quando amarrado a uma cadeira, Raphael ainda parece confiante e pensa com clareza… Que senhora nobre.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Quem é você? \\nVocê acabou de usar armas Substance H?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Suas palavras me lembram minha tarefa prioritária no momento.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Sra. Raphael, só queremos descobrir uma coisa. \\nÉ sobre aquela mala…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Que mala?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael parece confuso e não tem ideia do que eu disse.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Parece que… já está quebrado!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("O que?! Achei que a liga deveria ser bem resistente!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Olho para onde Annie está apontando e vejo a mala, agora quebrada com enormes buracos deixados pelos arremessos de bolas de beisebol.")
	await novel_interface.show_text_only("A tampa de plástico preto da mala está quebrada, revelando uma camada de metal que emite uma luz azul pálida.")
	await novel_interface.show_text_only("O plástico é uma capa removível comum. Annie deve ter notado a camada interna da mala.")
	await novel_interface.show_text_only("A fechadura está destruída, com os componentes e peças de metal espalhadas pelo carpete.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("É estranho – minhas bolas de beisebol só têm como alvo alvos vivos…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael parece também ter notado o material que emana luz azul. Ela parece surpresa e nervosa.")
	await novel_interface.show_text_only("Em meio às espumas à prova de choque e peças de metal espalhadas, vejo uma pequena coisa brilhante.")
	await novel_interface.show_text_only("É um acessório dourado em forma de borboleta. Com delicados padrões recortados nas asas, parece uma borboleta de verdade.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Será que foi essa coisa… que atraiu suas bolas de beisebol para atingir a mala?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cuidado! Poderia ser um Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A realista borboleta dourada parece pronta para voar a qualquer momento. Até Raphael está hipnotizado. Não posso deixar de entrar em contato…")
	await novel_interface.show_dialog("Ei, idiota. \\nEu disse para não tocar—", "Mariru")
	await novel_interface.show_text_only("A voz de Mariru surge do nada. Em algum lugar do meu corpo de repente sinto um zumbido. Parece que ela estava falando ao meu lado.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Uh? \\n… O que é isso!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu exploro meu corpo, na esperança de descobrir de onde veio a voz e ter certeza de que não vejo nenhum alto-falante em algum lugar.")
	await novel_interface.show_dialog("Se a bola de beisebol de Annie pudesse deixar um buraco tão profundo na liga com dureza Rockwell de 70, as cabeças dos guarda-costas teriam sido transformadas em lama.", "Mariru")
	await novel_interface.show_dialog("É mais provável que o pequeno dispositivo só quisesse usar os choques das bolas de beisebol para explodir…", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Esses buracos… foram deixados pelo próprio acessório?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh-huh, muito provavelmente. Então, você ainda quer tocar em algo tão perigoso?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Espere, o problema é— \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Droga! Eu encontro a fonte de sua voz!")
	await novel_interface.show_text_only("Está direto do meu peito! Não é à toa que meu corpo vibra toda vez que ela fala…")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Como você pôde plantar um chip no meu corpo!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Você acabou de revelar casualmente nossa tecnologia secreta para um estrangeiro! Quer ser carimbado de novo?", "Mariru")
	await novel_interface.show_dialog("Annie, deixe a senhora dormir um pouco! \\nMas tenha cuidado. Não machuque nosso convidado de honra.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Ei! Não se atreva—!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie habilmente lança uma faca na nuca de Raphael, deixando-a desmaiada.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("A Sra. Mariru, Substance H está proibida de entrar no New Opulentia sem aprovação oficial, não é?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Claro! Humph, eles contrabandearam isso debaixo do meu nariz! Dr. Dekkers terá que explicar isso ao Senado.", "Mariru")
	await novel_interface.show_dialog("… Espere! Acho que os seguranças lá fora atraíram alguma atenção.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Huh, isso é rápido.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Soldados de segurança lá embaixo estão se reunindo no saguão. \\nEstou levando a Equipe de Coleta para ajudar você. Chegaremos em 8 minutos.", "Mariru")
	await novel_interface.show_dialog("Annie, feche a porta com aerogéis agora.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Sim, senhora!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
