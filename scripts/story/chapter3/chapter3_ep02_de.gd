# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("SID-Aufzeichnungen zeigen, dass das Akatraz Center die EX-Klasse Substance H sammelt, deren Prüfung und Erforschung durch den Vereinigten Kongress verboten ist.")
	await novel_interface.show_text_only("Unter der Erde des Zentrums ist es mit dem Eingang zu einem antiken Relikt eines Chate-Höhlenhauses verbunden, dessen Zutritt verboten ist und das nicht einmal bewertet werden kann.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX-Klasse Substance H… Handelt es sich um hochgefährliches Zeug?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Die meisten von ihnen sind heilige Gegenstände von religiöser Bedeutung. Da sie speziell für religiöse Anhänger bestimmt sind, können sie gesammelt werden, Forschung ist jedoch verboten.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Klingt nach Selbsttäuschung.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Hah, mir ging es genauso. \\nAber es macht in gewisser Weise Sinn.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("In religiösen Überlieferungen heißt es, dass einige Artefakte gotttötende Kräfte besitzen oder das Jüngste Gericht auslösen können.", "Mariru")
	await novel_interface.show_dialog("Sobald sie aktiviert werden, könnten sie eine Katastrophe apokalyptischen Ausmaßes auslösen.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist schlecht.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Obwohl sich einige in religiösen Geschichten verehrte Gegenstände später als schwach herausstellten – oder sogar peinlich wirkungslos ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Etwas Dummes?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Richtig, ein Beispiel ist dieses Paar heiliger Schuhe. Wer die Schuhspitze küsst, kann einem Streifen nicht widerstehen – was für eine Schande für die Religion.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist widerlich. \\nAlso. Zu welchem ​​Typ gehört dieser fehlende?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Es ist der Destiny Spear – ein Substance H der EX-Klasse unter der gemeinsamen Obhut aller Akademiestädte.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Oh. \\nIch verstehe, klingt cool.", "Lian")
	await novel_interface.show_dialog("Was genau ist dann der Destiny Spear?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Du siehst im Moment wie ein Vollidiot aus.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Hey, ich habe wirklich keine Ahnung! \\nIch bin nur ein Gymnasiast.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru sieht mich hilflos an, als würde er sich fragen, wo er überhaupt mit mir anfangen soll.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Kurz gesagt handelt es sich um die erste Art von Substance H, von der angenommen wird, dass sie deizide Kräfte besitzt.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In der öffentlich zugänglichen Literatur findet sich nur sehr wenig Beschreibung des Destiny Spear, außer dass er „bei hohen Temperaturen nicht schmilzt“ und dass er „beim Schwingen an Gewicht zunimmt“.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Das ist es?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wenn Sie tiefer graben, werden Sie feststellen, dass beide Eigenschaften es zu einem Substance H der XK-Klasse machen.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Möglicherweise gibt es noch andere gefährliche, unbekannte Eigenschaften. Deshalb sollten sie nicht zu viel mediale Aufmerksamkeit erregen.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Da bekomme ich Gänsehaut. Sogar kleine Kinder wissen, was ein Substance H der XK-Klasse ist …")
	await novel_interface.show_text_only("Es würde entweder zu einer Weltuntergangskatastrophe führen oder ein weiteres Substance H mit der gleichen Macht schaffen. Derzeit sind weltweit nur sechs Exemplare dieser Art bekannt.")
	await novel_interface.show_text_only("Jeder von ihnen gehört zu einer der sechs Akademiestädte. Genauer gesagt werden nur diejenigen, die im Besitz eines solchen Substance H sind, vom Vereinigten Kongress anerkannt.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Hä? \\nWas bedeutet ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Jetzt wissen Sie, was für ein schweres Verbrechen „Sie“ begangen haben?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich bin so schockiert, dass mir alles surreal vorkommt.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Entschuldigung. \\nNein! Warum habe ich mich entschuldigt? Ich bin nicht der Einbrecher!", "Lian")
	await novel_interface.show_dialog("(Mist. Der Typ muss supergefährlich sein!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Aber zum Glück wurde die Nachricht entfernt.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie taten es nur, um öffentliche Panik zu vermeiden.\\nDie Ermittlungen würden weiterhin heimlich weitergehen.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Aus Gründen der Vertraulichkeit wird die Fahndungsanzeige nicht an das Verteidigungsministerium weitergeleitet. Aber alle Geheimdienste, einschließlich SID, müssen bereits benachrichtigt worden sein.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Es ist also noch zu früh, um erleichtert zu sein, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Richtig ... mein altes Ich ist immer noch in Gefahr, oder?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("Was wäre, wenn... ich meine, was wäre, wenn... \\n...jemand mich aufspürt...", "Lian")
	await novel_interface.show_dialog("Selbst wenn ich jetzt ein Mädchen wäre, könnte ich wahrscheinlich eingesperrt werden, oder?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du hast es endlich verstanden.", "Mariru")
	await novel_interface.show_dialog("Der Geheimdienst hat alle verfügbaren CCTV-Aufnahmen überprüft und festgestellt, dass der Typ in einigen anderen Flux Areas aufgetaucht ist, immer noch mit Ihrem alten Gesicht.", "Mariru")
	await novel_interface.show_dialog("Da wir die Daten aus einer Drittquelle abrufen können, verfügen andere Geheimdienste wahrscheinlich bereits über diese Informationen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Schon ein Wiederholungstäter? \\nMeine Zukunft sieht düster aus ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ich stelle mir vor, wie ich in endlosen Verhören gefoltert werde …")
	await novel_interface.show_text_only("Ich habe das Gefühl, jederzeit verhaftet und als Verbrecher gegen die Menschlichkeit abgestempelt zu werden.")
	await novel_interface.show_text_only("Wurde im brutalsten Gefängnis eingesperrt und zu über 200 Jahren Gefängnis verurteilt.")
	await novel_interface.show_text_only("Ich könnte einen äußerst gefährlichen Zellengenossen haben, und er …")
	await novel_interface.show_text_only("Waah, hör auf! \\nKein Nachdenken mehr!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hahaha. Du hast solche Angst und siehst so blass aus.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Sei ruhig, Ren. Ich kann Ihnen 98 % Sicherheit garantieren, solange Sie sich im New Opulentia befinden.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Ich habe also immer noch eine Chance von 2 %, erwischt zu werden?", "Lian")
	await novel_interface.show_dialog("(Zwei Sekunden Unsicherheit pro hundert Sekunden!) \\n(Das ist überhaupt nicht sicher!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dass diese alten Hunde im Vereinigten Kongress so kurzfristig einen Konsens erzielt haben … Irgendetwas stimmt nicht.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Und das ist der 2 % unbekannte Faktor, von dem ich gesprochen habe.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Ich kann mir nicht vorstellen, was für einen Aufruhr es bei diesen ganz Großen hervorgerufen hat …", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Die Geheimdienste anderer Akademiestädte müssen also viele Ressourcen eingesetzt haben, um den Einbrecher zu jagen.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W... was soll ich tun?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Ein sichtbarer Feind ist immer leicht zu bekämpfen. Überlassen wir es SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
