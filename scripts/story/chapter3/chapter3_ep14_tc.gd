# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("雅各·施密特。 \\n伊露卡的管理員……", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我看到雅各身後，幾個穿著保安警察制服的人倒在門口。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("他們只是暈過去了，我不打算在聯合議會的地盤鬧出人命。", "雅各")
	await novel_interface.show_dialog("本來只是想回收《七哲人書》那本邪典的書頁，沒想到有意外的收獲……", "雅各")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("……", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("（《七哲人書》……）\\n（就是「黃金蝴蝶」對應的魔導書嗎？ ）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("小憐……我幫伊露卡洗澡的時候，發現她的身上有非常多已經癒合的舊傷。", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("（幫伊露卡洗澡？ ）\\n（欸？ 什麼時候！ ？）", "小憐")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("（不對，那不是重點）\\n（如果是舊傷，就表示……！ ！）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("那種強度的創傷，如果是普通的小孩子，身心應該早就崩潰了。", "安妮")
	await novel_interface.show_dialog("一定是這傢伙……是這傢伙！！", "安妮")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("哦──\\n「那個東西」還沒壞掉喔？", "雅各")
	await novel_interface.show_dialog("嘖！ 本來打算用在「那個東西」上的技術，\\n已經被SID逆向分析研究了吧。", "雅各")
	await novel_interface.show_dialog("早知道就在「那個東西」上裝個自爆裝置，省得麻煩。", "雅各")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("你這──！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("──你這混蛋！ ！！", "安妮")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("沒等我反應過來，安妮已經爆氣，一個飛身就朝著雅各的臉踢了過去。")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("呲咻──！！！")
	await novel_interface.show_text_only("隨著一聲尖銳聲，一道巨大的電弧瞬間點亮整個房間，我的眼前頓時一片白。")
	await novel_interface.show_text_only("隨著強光散去，我花了好幾秒才慢慢恢復視力，眼球依然刺痛不堪。")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("安妮──！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("安妮失去知覺，重重地摔在地毯上，身上出現大片樹枝狀的灼燒痕跡。")
	await novel_interface.show_text_only("雅各身邊的一個士兵槍口還冒著煙……那就是剛才發射的武器嗎？")
	await novel_interface.show_text_only("那個士兵熟練地上膛，槍側彈出一枚霰彈大小的電池狀物體。")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("只要方法得當，魔女也是可以物盡其用的。", "雅各")
	await novel_interface.show_dialog("雖然我希望盡量抓活的，不過SID的那個瘋婆娘快要來了。", "雅各")
	await novel_interface.show_dialog("既然時間不多──", "雅各")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("雅各拿出一個巴掌大小的餅狀金屬物，灰綠色的金屬外殼散發著熟悉的淡藍色光暈。")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("難道是……異質物武器！ ？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("我感覺到有魔力的流動……", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("在中立區用這種東西，你想做什麼！", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("（小憐！ ）", "莉琉")
	await novel_interface.show_text_only("耳機裡突然傳來莉琉的聲音。")
	await novel_interface.show_dialog("（他拿的是用「自縛纖維」製作的誘捕炸彈！ ）\\n（是非致命性「異質物武器」。 ）", "莉琉")
	await novel_interface.show_dialog("（啟動後3秒內就會爆炸，）\\n（炸開的纖維會佈滿整個樓層，妳們逃不掉的。 ）", "莉琉")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("——！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("（暫且別做無謂的抵抗了，）\\n（我會想辦法救妳們出來的……）", "莉琉")
	await novel_interface.show_text_only("雅各慢慢抬起拿著誘捕炸彈的右手，漸漸浮現出數條金色的亮線，看來已經準備啟動了。")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("那隻手是……魔法刻印？", "小憐")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("（終於，要體驗一下異質物武器的滋味了嗎？ 我不想這樣體驗啊！ ）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("抱歉了……", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("貝阿特麗切突然拉住我的手，另一隻手則俐落地扯過拉斐爾手中的項鍊。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("什麼？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("一瞬間，綠寶石吊墜放出一道強光，在貝阿特麗切的手中變為了一把刻有銘文的大劍。")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("妄圖申辯掙扎的罪惡靈魂啊──", "貝阿特麗切")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("什……", "雅各")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("閉嘴！！！", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("貝阿特麗切將銳利的劍鋒深深插入地板。")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("雅各剛要張嘴，聲音就如同被什麼吞噬了一般，\\n房間裡只留下讓人窒息的寂靜。")
	await novel_interface.show_text_only("他的腳下出現一條裂縫，露出的不是下層的樓板或建築材料，而是一片漆黑。")
	await novel_interface.show_text_only("黑暗中傳出宛如數百萬人同時哀嚎般凄厲恐怖的聲音，有如被撕裂的地獄一角。")
	await novel_interface.show_text_only("就像厄運化成了實體，從裂口噴湧而出。 黑暗瞬間浸染了視力所及的每一個角落。")
	await novel_interface.show_text_only("我被徹骨的寒意和莫可名狀的恐懼包圍，渾身汗毛倒豎，無法動彈……")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("然後黑暗迅速消散，一切都發生在短短幾秒內，\\n那條裂縫像是從來沒有存在過一樣。")
	await novel_interface.show_text_only("雅各像恐慌症發作一樣跪倒在地，發瘋似地用指甲在脖子抓出一道道血痕。")
	await novel_interface.show_text_only("他滿臉通紅地拼命喘息，但肺部似乎瞬間被抽成了真空，鼻孔不斷傳出氣鳴聲。")
	await novel_interface.show_text_only("過了好一會兒，才有辦法從聲音判斷出他終於恢復了微弱的呼吸。")
	await novel_interface.show_text_only("此時這個身材高大的男人正蜷縮在地毯上，雙手交叉抱在胸前，身體止不住地顫抖。")
	await novel_interface.show_text_only("他的眼神充滿恐懼，眼睛血絲密布，眼眶裡滿是因體內失壓時從淚腺分泌出的液體。")
	await novel_interface.show_text_only("他手上的金色紋路已經完全消失，連誘捕炸彈也滾落到地毯上，失去光澤。")
	await novel_interface.show_text_only("屋子裡的蒙面士兵都愣在原地──止不住地顫抖著。")
	await novel_interface.show_text_only("從他們努力想要站穩的行為看來，似乎還無法脫離方才那種超乎意識的恐怖。")
	await novel_interface.show_text_only("當你凝視深淵時……深淵同時也在凝視著你……")
	await novel_interface.show_text_only("而面對真正的恐怖，就算僅僅只是呼吸…")
	await novel_interface.show_text_only("也會讓妳覺得自己暴露在那不可理喻的絕望面前。")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("快走！", "貝阿特麗切")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	await novel_interface.show_dialog("（小憐！ 快走啊！ ）", "莉琉")
	await novel_interface.show_text_only("我才回過神來，向貝阿特麗切點了點頭，抱起安妮快速離開了房間。")
	await novel_interface.show_text_only("貝阿特麗切拉住還處於失神狀態的拉斐爾，我們一行四人快速跑向了電梯……")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
