# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¿Quieres decir… borrar toda la información de terceros sobre ese tipo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("No. Todo lo contrario, iré añadiendo más información.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Qué?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Una sonrisa escalofriante aparece en el rostro de Mariru.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ahora la única información sobre el ladrón son sólo imágenes de baja resolución.", "Mariru")
	await novel_interface.show_dialog("Imagínese cuántas personas en todo el mundo tienen caras tan sencillas.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Espera, ¿acabas de decir, simple? Eso duele.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("E incluso si alguien se parece a \"yo\", sería fácil descubrirlo.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("¡Las cámaras de seguridad registran todo lo que hizo ese día!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Por supuesto, no es difícil distinguir a una persona real.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Pero ¿y si… esta persona no existe?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quieres decir...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Si introducimos algunas identidades falsificadas con rasgos faciales similares a los del sospechoso, será casi imposible descubrirlo.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Y para todos, excepto para nosotros, esas personas no son diferentes de "+GameConfig.player_name+": solo son más desaparecidos misteriosos.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Entonces, ¿cómo es posible descubrir el objetivo real?", "Mariru")
	await novel_interface.show_dialog("Para ocultar un grano de arroz, puedes quitarlo o espolvorear una bolsa entera de arroz para taparlo.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Suena como un gran proyecto...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Sólo un poco más de complejidad para un problema simple, para que los contribuyentes estén contentos con cómo se gasta su dinero. ¿Ver? Dos pájaros de un tiro.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Cada vez que haces comentarios tan inapropiados quiero llamar a la policía.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Por cierto, encontré algunas contradicciones en su información de identidad.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("¿Eh? ¿Qué parte?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Sobre tus padres.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mi corazón se hunde al escuchar la palabra \"padres\".")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Me dijiste que tu madre murió temprano y que tu padre estaba desaparecido.", "Mariru")
	await novel_interface.show_dialog("Sé que no quieres hablar de esto. Pero es importante. Tengo que consultar contigo.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Bien…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru recupera los datos de los que realizó una copia de seguridad.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Aquí dice que su madre desapareció el 25 de julio de 2026, se presume muerta. \\nEsa fue la Gran Tribulación.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Antes de ese día, las ruinas submarinas en el noroeste New Opulentia habían sido una ciudad bulliciosa.")
	await novel_interface.show_text_only("Sólo tengo un vago recuerdo de ello...")
	await novel_interface.show_text_only("En el momento en que la ciudad fue destruida por las armas Devine Touch, Aegis generó un campo protector. New Opulentia estaba justo al borde del problema.")
	await novel_interface.show_text_only("Y… Eso marcó el comienzo de la Guerra de los Siete Años.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Padre, desaparecido desde diciembre de 2026. Presunto…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("¡Para… por favor!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Odio esta fría frase: Presunto... muerto.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Siempre me digo a mí mismo... \\nTal vez... papá todavía está vivo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Bueno, tu padre debe de estar contento. ¡Su hijo creció y se convirtió en una hermosa chica!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me río de sus palabras. \\n¡Maldita sea, sé que me está tomando el pelo!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Bueno, mira esto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hace clic en los perfiles de mis padres. Aparecen dos códigos.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Según el perfil—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Madre, código fuera de línea. \\nPadre, código fuera de línea.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… ¿Algo malo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis no le habría asignado un código a su madre si hubiera muerto antes de que se activara el campo protector o en algún lugar fuera de su alcance.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("¿Eh…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru me mira pensativamente.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("¿Tú tampoco tienes idea? \\nLos archivos no mentirían. Estaré atento a esto...", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
