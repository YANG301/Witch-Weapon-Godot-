# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("เราถูกรายล้อมไปด้วยบอดี้การ์ดของ Raphael Annie ขยิบตาให้ฉัน—")
	await novel_interface.show_text_only("ฉันเข้าใจประเด็นของเธอทันที และปลดปล่อยพลังกดดันทั้งหมดที่เธอรวบรวมเมื่อเราอยู่ในทางเดินออกไป")
	await novel_interface.show_text_only("ทันใดนั้น ลูกเบสบอลหลายร้อยลูกก็ยิงออกไป โดนชายคนหนึ่งและกระเด้งเข้าหาอีกคนหนึ่งทันที")
	await novel_interface.show_text_only("เห็นได้ชัดว่าไม่เคยเห็นสิ่งนี้มาก่อน บอดี้การ์ดตกอยู่ในความตื่นตระหนกและถูกโจมตีทีละคน")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("ฉันไม่เคยใช้เคล็ดลับนี้กับคนธรรมดามาก่อน มันทำงานได้ดีมาก…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("แน่นอน! มนุษย์ที่มีสติจะจัดการได้ง่ายกว่าแม่มดที่บ้าคลั่ง!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("ยิง! คุณโง่…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("เจ้ากล้าดียังไงเจ้าปัญหา! ทหารรักษาความปลอดภัยจะไม่ปล่อยคุณไป!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันเพิ่งสังเกตเห็นว่าหลังจากการต่อสู้ ห้องรอยัลสวีทของ Raphael กลายเป็นเรื่องยุ่งวุ่นวายไปหมด บอดี้การ์ดของเธอนอนอยู่เต็มพื้น")
	await novel_interface.show_text_only("Annie และฉันแค่อยากจะแอบเข้าไปรวบรวมหลักฐาน แต่ดูเหมือนว่าเราจะก่อให้เกิดหายนะทางการทูตที่ร้ายแรง...")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("แย่จัง… Annie! \\nC… เอาน่า! มัดเธอไว้!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ด้วยความตื่นตระหนก ฉันจึงสั่งสอน Annie อย่างบ้าคลั่ง")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("ใช่! จะทำ!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie ลด Raphael ลงอย่างว่องไว เปิดม่านที่ตกลงบนพื้นระหว่างการต่อสู้ และจากนั้นก็มัดหญิงสาวที่กำลังดิ้นรนอย่างรวดเร็ว")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("กล้าดียังไง-!! \\nไอ้พวกแต่งตัวประหลาด! คุณต้องการอะไรจากฉัน!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ตอนนี้ Raphael แขกผู้มีเกียรติใน New Opulentia หลานสาวของนายกเทศมนตรีของ Fourth Academy City ถูกผูกติดกับเก้าอี้ในห้องสวีทของเธอเอง—")
	await novel_interface.show_text_only("Annie เก่งเรื่องนี้จริงๆ!! \\nและดูเหมือนว่าฉันจะไม่มีวันกำจัดชื่อเสียงในฐานะคนเลวทรามได้...")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("ฉันเสียใจจริงๆ เกี่ยวกับเรื่องนี้ แต่เราต้องทำให้แน่ใจว่าคุณจะไม่ส่งสัญญาณเตือน...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันชี้ไปที่ปุ่มสีแดงบนผนัง เมื่อกดแล้ว ทีมทหารรักษาความปลอดภัยติดอาวุธหนักจะล้อมห้องภายใน 3 นาที")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ฮึ่ม แล้วคุณต้องการอะไรล่ะ?", "Raphael")
	await novel_interface.show_dialog("คุณไม่ได้ซ่อนตัวตนของคุณ และดูเหมือนคุณไม่มีแผนอพยพ— \\nนี่ไม่ใช่การลักพาตัวเพื่อเรียกค่าไถ่ใช่ไหม", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("แม้จะผูกติดกับเก้าอี้ Raphael ก็ยังดูมั่นใจและคิดอย่างชัดเจน… ช่างเป็นสตรีผู้สูงศักดิ์จริงๆ")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("คุณเป็นใคร? \\nคุณเพิ่งใช้อาวุธ Substance H หรือไม่?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("คำพูดของเธอทำให้ฉันนึกถึงงานสำคัญที่สุดของฉันในขณะนี้")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("คุณ Raphael เราแค่อยากจะเข้าใจสิ่งหนึ่ง \\nมันเกี่ยวกับกระเป๋าเดินทางนั่น...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("กระเป๋าเดินทางอะไร?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael ดูงุนงง และดูเหมือนจะไม่มีเงื่อนงำเกี่ยวกับสิ่งที่ฉันพูด")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("ดูเหมือนว่า...มันพังไปแล้ว!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("อะไรนะ! ฉันคิดว่าโลหะผสมควรจะแข็งแรงมาก!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ฉันมองดูที่ Annie ชี้ไป และเห็นกระเป๋าเดินทางที่ตอนนี้แตกเป็นรูขนาดใหญ่จากการยิงลูกเบสบอล")
	await novel_interface.show_text_only("ฝาพลาสติกสีดำของกระเป๋าเดินทางแตกกระจาย เผยให้เห็นชั้นโลหะที่ทำให้เกิดแสงสีฟ้าอ่อน")
	await novel_interface.show_text_only("พลาสติกเป็นฝาปิดแบบถอดได้ทั่วไป Annie ต้องบังเอิญสังเกตเห็นชั้นในของกระเป๋าเดินทาง")
	await novel_interface.show_text_only("ตัวล็อคถูกทำลาย โดยมีส่วนประกอบและชิ้นส่วนโลหะกระจัดกระจายอยู่บนพรม")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มันแปลก—ลูกเบสบอลของฉันมุ่งเป้าไปที่เป้าหมายที่มีชีวิตเท่านั้น...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael ดูเหมือนจะสังเกตเห็นวัสดุที่เปล่งแสงสีน้ำเงินออกมาด้วย เธอดูประหลาดใจและกังวล")
	await novel_interface.show_text_only("ท่ามกลางโฟมกันกระแทกและชิ้นส่วนโลหะที่กระจัดกระจาย ฉันเห็นสิ่งเล็กๆ แวววาว")
	await novel_interface.show_text_only("เป็นเครื่องประดับสีทองรูปผีเสื้อ ด้วยลวดลายฉลุที่ละเอียดอ่อนบนปีก ทำให้ดูเหมือนผีเสื้อจริงๆ")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("เป็นไปได้ไหมว่าสิ่งนี้… ที่ดึงดูดลูกเบสบอลของคุณให้พุ่งเป้าไปที่กระเป๋าเดินทาง?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ระวัง! อาจเป็น Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ผีเสื้อสีทองเหมือนจริงดูเหมือนพร้อมจะบินได้ทุกเมื่อ แม้แต่ Raphael ก็น่าหลงใหล ฉันอดไม่ได้ที่จะติดต่อ...")
	await novel_interface.show_dialog("เฮ้ คนงี่เง่า \\nฉันบอกว่าอย่าแตะมัน-", "Mariru")
	await novel_interface.show_text_only("เสียงของ Mariru มาจากไหนไม่รู้ ที่ไหนสักแห่งในร่างกายของฉันก็รู้สึกหึ่งๆ รู้สึกเหมือนเธอกำลังพูดอยู่ข้างๆฉัน")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("เอ่อ? \\n… นั่นอะไรน่ะ!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันสำรวจไปรอบๆ ตัว โดยหวังว่าจะรู้ว่าเสียงนั้นมาจากไหน และต้องแน่ใจว่าฉันไม่เห็นลำโพงที่ไหนสักแห่ง")
	await novel_interface.show_dialog("หากลูกเบสบอลของ Annie สามารถทิ้งรูลึกไว้บนโลหะผสมที่มีความแข็งแบบร็อกเวลล์ที่ 70 ศีรษะของบอดี้การ์ดคงถูกทุบจนกลายเป็นโคลน", "Mariru")
	await novel_interface.show_dialog("มีความเป็นไปได้มากกว่าที่อุปกรณ์ขนาดเล็กเพียงต้องการใช้แรงกระแทกของลูกเบสบอลเพื่อแยกออก...", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("รูเหล่านั้น… ถูกทิ้งไว้โดยอุปกรณ์เสริมเองเหรอ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("เอ่อ เป็นไปได้มาก คุณยังต้องการสัมผัสสิ่งที่อันตรายเช่นนี้อีกหรือไม่?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("เดี๋ยวก่อน ปัญหาคือ— \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ประณามมัน! ฉันเจอต้นตอของเสียงของเธอแล้ว!")
	await novel_interface.show_text_only("มันส่งตรงจากหน้าอกของฉัน! ไม่น่าแปลกใจเลยที่ร่างกายของฉันรู้สึกหึ่งทุกครั้งที่เธอพูด...")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("ฝังชิปในร่างกายฉันได้ยังไง!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("คุณเพิ่งเปิดเผยเทคโนโลยีลับของเราให้ชาวต่างชาติฟังโดยบังเอิญ! อยากโดนประทับตราอีกมั้ย?", "Mariru")
	await novel_interface.show_dialog("Annie พาคุณผู้หญิงไปนอนสักพักเถอะ! \\nแต่ต้องระวังด้วย อย่าทำร้ายแขกผู้มีเกียรติของเรา", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("เฮ้! ไม่กล้า—!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie ขว้างมีดเข้าที่หลังคอของ Raphael อย่างช่ำชอง ทำให้เธอตกอยู่ในอาการไฟดับ")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("นางสาว Mariru, Substance H ถูกห้ามไม่ให้เข้าสู่ New Opulentia โดยไม่ได้รับการอนุมัติอย่างเป็นทางการใช่ไหม", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("แน่นอน! ฮืม พวกเขาลักลอบเอาสิ่งนี้มาไว้ใต้จมูกของฉัน! ดร. Dekkers จะต้องอธิบายเรื่องนี้ให้วุฒิสภาทราบ", "Mariru")
	await novel_interface.show_dialog("… เดี๋ยวก่อน! ฉันคิดว่าเจ้าหน้าที่รักษาความปลอดภัยด้านนอกดึงดูดความสนใจได้บ้าง", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("หึ มันเร็วไปนะ", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ทหารรักษาความปลอดภัยชั้นล่างกำลังรวมตัวกันที่ล็อบบี้ \\nฉันกำลังนำทีมเรียกเก็บเงินมาช่วยคุณ เราจะมาถึงใน 8 นาที", "Mariru")
	await novel_interface.show_dialog("Annie ปิดประตูด้วยแอโรเจลทันที", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("ใช่แหม่ม!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
