# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("『エアロゲルスプレー』愛衣博士が発明した\\n缶タイプのスプレーだ。\\n一見すればヘアスプレーのように見えるけど、\\n一瞬で超大量の泡を噴射できる。")
	await novel_interface.show_text_only("泡は空気に接触すると同時に、\\n素早く膨張して凝固する。\\nゲルが固まった時の強度は、小銃の弾程なら\\n簡単に防ぐ事ができる代物だ。")
	await novel_interface.show_text_only("アニーがエアロゲルスプレーを扉の周囲に\\n吹きかけている最中、\\n俺の注意は再び床にある黄金の形をした蝶に\\n惹きつけられていた。")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("（見た目は、精巧な芸術品に見えるだけ……）", "小憐")
	await novel_interface.show_dialog("（でも……我慢できない……触ってみたい……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("下腹部が熱くなり、\\n目の前で光が拡散していくのを感じる。\\n思わず手を伸ばそうとして──")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("ちょ、ちょっとッ！！ちょっとッ！！\\nレンちゃんッ！！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーに腕を掴まれ、俺は我に返った。")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("これって、人の精神に影響するモノかも……\\n\\nだからこの人達もアタッシュケースに入れて\\n保管してたんじゃないかな？", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("あっ！ もう少しで……いったい……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("この金色の蝶から、知っている気配を感じる……\\nこれは一種の『魔導器』だと思うの。", "アニー")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……魔導器？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("う～ん、なんて言ったらいいか……", "アニー")
	await novel_interface.show_dialog("魔法って、特殊な『情報』を人間の脳によって\\n転換した知識そのものなの。", "アニー")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("だけど、人間がそんな知識を獲得して蓄積すると\\n代償として理性を失うリスクが付きまとう……", "アニー")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("それを聞いてこの前変電所で遭遇したドールや、\\n異変空間にいた敵達の事を思い出した。")
	await novel_interface.show_text_only("あいつらは自分の許容範囲を超えた『知識』を\\n手に入れたことで完全に理性を失った状態に、\\nきっとなってしまったんだろう。")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("でも、この『情報』って実は分割して個別に\\n保存できちゃうのよ。\\n分割された『情報』を保存する受け皿。\\n……それが魔導器。", "アニー")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("なんでこんな方法があるのかと言うと、\\n\\nおそらくだけど、人間が自分の許容を限界まで\\n追求していくためにあるんだと思う……", "アニー")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("自分が理性を失わず、堪えれる限界を試すため、\\n魔導器で少しずつ魔法の知識を吸収するって事？", "小憐")
	await novel_interface.show_text_only("そんなの行為自体が既に狂ってるじゃないか。")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("尽きることなく飢えたように新しい知識を求め続ける――むしろそれが人間の本性なのだろう……", "アニー")
	await novel_interface.show_dialog("たとえ滅びへ向かう運命だとしても……", "アニー")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("じゃあ、もし魔導器に接触した一般人に、\\n十分な素質がない場合は……\\n変電所のドールのように……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("うん、その可能性は高いね。\\n\\nそれに魔導器は結界とかに覆われてないから、\\n誰でも直接触る事ができてしまうの。", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("それって、超危険じゃないか！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──カツン……ッ！\\n――ドンッ！！！")
	await novel_interface.show_text_only("外から、木製の扉を強く打ち付ける音がした。")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("保安軍か……！?", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──バキィッ！！！\\n\\nたった2回の音がしただけで、\\nロイヤルスイートの扉の元は破られた。")
	await novel_interface.show_text_only("──ドンッ！！　ドンッ！！　ドンッ！！\\n──ドンッ！！　ドンッ！！　ドンッ！！")
	await novel_interface.show_text_only("今度は凝固したエアロゲルを打ち付ける音が\\n聞こえたが、音の響きはさっきより断然薄く、\\n突入部隊は大分、手こずっているようだ。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("マリルさんの到着までは耐えれそうだね……\\n愛衣博士の発明って本当にすごい。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──知らぬ間にスピーカー機能が内蔵された\\n自分の胸元を触ってみた。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("アハハ……ホントニスゴイヨナ……\\nっておわッ！？！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──突然\\nいつの間にか眠りから目覚めたラファエルが、\\n椅子に縛り付けられたまま俺に向かって\\n倒れ込んできた。")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("何1つ奪わせたりはしない……絶対にっ！", "ラファエル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("このオーディオ内蔵仕様の変態め！！", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは椅子が地面に倒れた時の衝撃を\\n利用して束縛から抜け出し、\\n床に落ちている黄金の蝶を取り戻そうとする。")
	await novel_interface.show_text_only("その様子を見て俺もすぐに飛び掛かった。だが、\\n今にもラファエルとぶつかりそうになって──")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("ダメだよ！！レンちゃんッッ！！！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("ゴツン――ッ！")
	await novel_interface.show_dialog("（あれっ？　俺が取ったのか？）\\n（いや違う……）", "小憐")
	await novel_interface.show_dialog("（この柔らかい感触は……）", "小憐")
	await novel_interface.show_dialog("（なんだかこの感触、少し前にも触った事が\\n　ある気がする）", "小憐")
	await novel_interface.show_dialog("（ちょっと待ってくれ、まさか……！）", "小憐")
	await novel_interface.show_dialog("こ……この、あんたッ！", "ラファエル")
	await novel_interface.show_dialog("ど、ど変態めッ！！！", "ラファエル")
	await novel_interface.show_text_only("──バチンッ！！")
	await novel_interface.show_text_only("はっきりと聞こえるビンタの音。\\nまるで無重力のような目眩を感じた。")
	await novel_interface.show_text_only("走馬灯みたいな映像の破片が、\\n俺の脳裏を走っていく。\\nそして周りの音はあっという間に全てなくなる。")
	await novel_interface.show_text_only("まるで別の世界に入ったかのように。\\n\\nだけど、その変な感覚は一瞬で消えた──")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("再び目を開けた時、自分は依然としてホテルの\\n部屋の中で立っていることに気づいた。")
	await novel_interface.show_text_only("黄金の蝶のアクセサリーが、\\nまるで生きているかのように羽ばたく──\\nそして俺の胸に飛び込み、眩い輝きに変わった。")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("そんな……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──輝きが星の砂となり薄らかに消えていく。\\n\\n直後、俺の頬が優しく撫でられるのを感じ、\\n奇妙にも柔らかい触感が心に刻まれた。")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("──あれっ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("部屋の元々空いていたスペースに…\\n\\n……美しい女性が現れた。")
	await novel_interface.show_text_only("薄赤い瞳と長い髪。すらっとした姿。\\nきめ細やかな肌から、目線をそらせない……")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("（……一体何が起こった？）\\n（唇が、さっき何かに触れたみたいだけど！）", "小憐")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（……あはは～、違う違うっ！）\\n（何考えてるんだ俺、そんな事はあり得ない！）", "小憐")
	await novel_interface.show_dialog("（あ、あり得ないんだってッ！！！）", "小憐")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("（やばい、この感覚、この感覚は……）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("あぁ、──久しぶりに温度を感じたわ。", "突然現れた女性")
	await novel_interface.show_dialog("こんばんは、うら若きお嬢さん達。", "突然現れた女性")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…………", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の鼓動の加速が止まらない。\\n\\n手と足も言う事を聞かなくなり、思わず彼女に\\n近付いてしまう。")
	await novel_interface.show_text_only("みんなの目の前であるにも関わらず、\\n俺は両腕を広げ、力一杯に彼女を抱きしめた。")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("あらあら、可愛らしいお嬢さん、\\n具合でも悪いのかしら……？", "突然現れた女性")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("あ…あのぅ……", "小憐")
	await novel_interface.show_dialog("名前を……教えてくれませんか……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("おかしいな……\\n俺の身体がすごく重くなってきたように感じる…\\nなんか体温も異様に熱くなってきて……")
	await novel_interface.show_text_only("俺は一体……どうなっちまったんだ……ッ！！")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("……あらら\\n不思議なものね。", "突然現れた女性")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("ッ！！？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("────レ、レンちゃぁん！！！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーが部屋に現れた女性の懐から、\\n俺を一気に引き剥がした。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("あなた……一体何者？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("私の名前が、この時代においてタブーとされて\\nいなければ……\\nベアトリーチェと呼んでちょうだい。", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("素敵な名前だなぁ～……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("レンちゃぁん……\\nレンちゃんの頭の中が……\\nお花畑になっちゃったああぁぁぁ――ッッ！！！", "アニー")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
