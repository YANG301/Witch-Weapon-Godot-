# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Je quitte le quartier général avec le livret contenant tous les détails de la jet-set. Mariru m'envoie également des photos d'elle par SMS.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Née dans l'une des familles nobles de Salmonton, Raphael est la petite-fille du Dr Thomas Dekkers, président de Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Wow… j'ai lu des articles sur lui dans les manuels ! \\nCela devient un peu fou…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je t'ai attrapé ! Bonjour chérie !")
	await novel_interface.show_text_only("Quelqu’un me serre dans ses bras.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Waaah—!", "Lian")
	await novel_interface.show_dialog("… Ouais, c'est toi ! Qu'est-ce que tu fais ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je dois me soumettre à un examen physique complet et à un traitement par Aya à chaque fois que je reviens d'une zone Flux.")
	await novel_interface.show_text_only("Je déteste l'admettre, mais l'instrument en forme de pieuvre d'Aya est très utile pour guérir les blessures.")
	await novel_interface.show_text_only("Et je déteste le fait de m'habituer aux actions psychopathes d'Aya…")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Pourquoi as-tu l’air si déçu ? \\nJe commence à me sentir blessé.", "Ai")
	await novel_interface.show_dialog("Je n'ai pas bien pris soin de toi depuis que tu es revenu du Sous-Station…", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Alors je vais t'emmener à l'école… \\nEt te donner des leçons inoubliables.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Quoi ? Attendez…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Ne me touchez pas ! C'est en plein jour !", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("Le pervers Mariru m'a rappelé de faire attention à... \\nCe doit être Aya !")
	await novel_interface.show_text_only("Aya m'entraîne au centre de santé. Je ne peux rien faire d'autre que m'allonger sur le lit.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Juste un examen physique… Vous dramatisez trop.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Vous avez l'air déçu. Vous préférez un traitement spécial, hein ?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non, merci. \\nJuste un examen régulier, s'il vous plaît.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(Et votre routine est assez spéciale !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sort l'étrange instrument comme d'habitude. L'imageur clignote à nouveau avec des images incompréhensibles.")
	await novel_interface.show_text_only("Pour gagner du temps, je sors mon téléphone portable et continue à lire sur Raphael.")
	await novel_interface.show_text_only("Elle a les cheveux longs et gris foncé. Ses yeux sont violets et perçants, comme s’ils étaient prêts à lire dans les pensées des gens.")
	await novel_interface.show_text_only("En regardant la photo, je sens mon cœur battre violemment et mon corps se met à trembler de manière incontrôlable.")
	await novel_interface.show_text_only("Puis je reprends mon souffle, le tout en un instant. Aya est occupée par le stéthoscope et ne semble pas avoir remarqué ce qui se passe.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(Qu'est-ce qui ne va pas ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je sens que… même à travers la photo, il y a quelque chose dans Raphael qui résonne avec l'instrument.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Pourquoi…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bip— bip—")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("C'est quoi ce bruit ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La courbe sur l'écran fluctue fortement.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Oups, pourquoi ça se déchaîne tout d'un coup ?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Ai-je surpris Ren en train de vérifier quelque chose de classé X… ?", "Ai")
	await novel_interface.show_dialog("J'avais oublié que tu étais un adolescent !", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("Non, ce n'est pas le cas !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'étrange sensation de résonance disparaît.")
	await novel_interface.show_text_only("Est-ce interrompu par Aya ?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Quel est ce paramètre fluctuant ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("C'est… un secret !", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Oubliez ça.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Excusez-moi. Puis-je entrer ?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix entre d’un pas vif dans le centre de santé.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Hé, Nix !", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Salut, Ren. Je ne m'attendais pas à vous rencontrer ici.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix se tourne vers l'instrument, l'air perplexe, comme s'il essayait de comprendre ce que je fais.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("Qu'est-ce que c'est… ?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Elle montre l'appareil bleuâtre à quatre broches dans la main d'Aya.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, c'est pour les expériences humaines.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quoi ? Vous venez de dire ça franchement ?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ah…", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, Mme Aya, je ne me sens pas très bien. Puis-je me reposer ici ?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix est génial. Comment pouvait-elle garder le sourire sans commenter l'étonnante réponse d'Aya ?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Pas de problème, tu peux utiliser ce lit. \\nIl me faudra encore 15 minutes pour terminer ce que je fais.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya retire l'écran de l'instrument et quitte la pièce pour télécharger des données.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Merci.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix fait un signe de tête à Aya et s'allonge sur le lit à côté de moi.")
	await novel_interface.show_text_only("Le lit n'est qu'à un bras. Nix ne ferme pas le rideau.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(Elle s'allonge comme ça devant un inconnu ?) \\n(Ahh ouais, nous sommes toutes des filles…)", "Lian")
	await novel_interface.show_dialog("(Merde. Mon cœur bat vite.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me retourne furtivement et la regarde. La façon dont elle remet ses cheveux derrière son oreille est si gracieuse.")
	await novel_interface.show_text_only("Nous sommes si proches. Je peux même sentir le léger parfum sur elle…")
	await novel_interface.show_text_only("Alors que je me laisse aller à des pensées rêveuses, Nix se tourne et me regarde droit dans les yeux.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Quoi de neuf ?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah ! Ahh… \\nEuh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je reprends soudain mes esprits et je me sens comme un enfant surpris en train de faire une farce.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("Que dois-je faire ? Dois-je dire quelque chose ?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Non, attends ...)", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("Je ne me sens ni nerveux ni timide… C'est…")
	await novel_interface.show_text_only("Je ressens une sensation de brûlure là-bas…")
	await novel_interface.show_text_only("C'est… un sentiment similaire quand j'ai vu la photo de Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Merde, suis-je si dur au point qu'une fille m'excite ?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Vous avez l'air pâle. Vous sentez-vous bien ?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ouais… Très bien, je pense.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Oh, qui est-ce ?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix regarde mon téléphone portable. \\nElle lève les sourcils en voyant la photo à l'écran.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("La connaissez-vous ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Non, je ne le fais pas.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Mais Nix a l'air dégoûté…) \\n(Peut-être que je me trompe.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
