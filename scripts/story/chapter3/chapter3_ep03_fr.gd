# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Vous voulez dire… Effacer toutes les informations tierces sur ce type ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Non. Au contraire, j'ajouterai plus d'informations.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quoi ?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un sourire effrayant apparaît sur le visage de Mariru.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Désormais, les seules informations sur le cambrioleur ne sont que des images en basse résolution.", "Mariru")
	await novel_interface.show_dialog("Imaginez combien de personnes dans le monde entier ont des visages aussi simples.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Attends, tu viens de dire, clairement ? Ça pique.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Et même si quelqu'un ressemble à « moi », il serait toujours facile de le découvrir.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Les caméras de sécurité enregistrent tout ce qu'il a fait ce jour-là !", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Bien sûr, il n’est pas difficile de distinguer une personne réelle.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Mais et si… cette personne n'existait pas ?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tu veux dire…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Si nous glissons des identités forgées avec des traits du visage similaires à ceux du suspect, il sera presque impossible de le découvrir.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Et pour tous, sauf nous, ces gens ne sont pas différents de "+GameConfig.player_name+" : ce ne sont que d'autres disparus mystérieux.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Alors, comment est-il possible de découvrir la véritable cible ?", "Mariru")
	await novel_interface.show_dialog("Pour cacher un grain de riz, soit on l'enlève, soit on saupoudre tout un sac de riz pour le recouvrir.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Cela ressemble à un énorme projet…", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Juste un peu de complexité supplémentaire à un problème simple, pour que les contribuables soient satisfaits de la façon dont leur argent est dépensé. Voir? D’une pierre deux coups.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Chaque fois que vous faites des commentaires aussi inappropriés, j'ai envie d'appeler la police.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Au fait, j'ai trouvé quelques contradictions dans vos informations d'identité.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Hein ? Quelle partie ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("A propos de tes parents.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mon cœur se serre en entendant le mot « parents ».")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Vous m'avez dit que votre mère était décédée prématurément et que votre père avait disparu.", "Mariru")
	await novel_interface.show_dialog("Je sais que tu ne veux pas parler de ça. Mais c'est important. Je dois vérifier avec vous.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Très bien…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru récupère les données qu'elle a sauvegardées.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ici, il est dit que votre mère a disparu le 25 juillet 2026, présumée morte. \\nC'était la Grande Tribulation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Avant ce jour, les ruines sous-marines du nord-ouest de New Opulentia étaient une ville animée.")
	await novel_interface.show_text_only("Je n'en ai qu'un vague souvenir...")
	await novel_interface.show_text_only("Au moment où la ville a été détruite par les armes Devine Touch, Aegis a généré un champ de protection. New Opulentia était juste à la limite.")
	await novel_interface.show_text_only("Et… Cela marqua le début de la guerre de Sept Ans.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Père, disparu depuis décembre 2026. Présumé…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Arrêtez… s'il vous plaît !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je déteste cette phrase froide : Présumé… mort.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Je me dis toujours… \\nPeut-être… papa est toujours en vie…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Eh bien, ton père doit être heureux. Son garçon a grandi pour devenir une belle fille !", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ris à ses paroles. \\nMerde, je sais qu'elle me taquine !")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Eh bien, regarde ça.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle clique sur les profils de mes parents. Deux codes apparaissent.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Selon le profil...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mère, code hors ligne. \\nPère, code hors ligne.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Quelque chose ne va pas ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis n'aurait pas attribué de code à votre mère si elle était décédée avant que le champ de protection ne soit activé ou hors de sa portée.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hein… ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru me regarde pensivement.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Vous n'en avez aucune idée non plus ? \\nLes fichiers ne mentiraient pas. Je ferai attention à ça…", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
