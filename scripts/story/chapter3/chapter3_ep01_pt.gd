# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("O pesadelo bizarro, a conversa vaga, a sombra do sonho. \\nAlém de um aviso de alerta vermelho…")
	await novel_interface.show_text_only("Quando estou prestes a aceitar minha nova identidade e decidir me recompor, eles bagunçaram tudo de novo.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hum?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Você viu a notícia? \\nÉ ele! Não, eu, sou eu!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Eu não sou cego. Claro, eu sei que é você bem na minha frente, sua suada, garota boba.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Não! \\nDroga. sou eu quem está no noticiário!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Em pânico, nem sei por onde começar. \\nMariru grunhe e bate na minha cabeça com a mão.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Um idiota tão inútil. Depois de todos esses treinamentos, você não consegue nem se reportar claramente ao seu oficial.", "Mariru")
	await novel_interface.show_dialog("Não é apenas sobre um cara que se parece com você sendo procurado em todo o mundo porque ele assalta o Centro de Coleta e Pesquisa da Segunda Cidade Acadêmica?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim, sim, sim! Exatamente!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Os serviços de inteligência divulgaram a notícia muito antes de ela se tornar viral.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Você parece bobo quando está com medo ~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru beliscou minha bochecha. Tentei impedi-la imediatamente.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, fale sério!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Mais procurado em todo o mundo. Não é uma piada!", "Lian")
	await novel_interface.show_text_only("Nunca poderia ter passado pela minha cabeça que um dia eu seria notícia por roubo.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("E é um aviso triplo A! Pelo que me lembro, o último sujeito procurado com tal nível de alerta foi bombardeado até a morte na América do Sul por um destruidor de bunkers.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Esse maldito ladrão roubou minha identidade anterior assim... Estou quase chorando só de pensar nisso.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Neste caso… \\nO único com quem posso contar é Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Por mais que eu queira ver você sofrer assim...", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Tenho que pedir que você verifique as notícias novamente.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("É necessário? Já tenho tudo gravado em minha mente.")
	await novel_interface.show_dialog("A imagem pode não ser nítida e clara, mas tenho certeza de que ele se parece quase exatamente comigo quando menino!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Para provar o que eu disse, pego a notícia no meu telefone.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Veja, isso é… \\nEh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O aviso de procurado que me assustou não está mais lá. Foi substituído por um anúncio normal de pessoa desaparecida.")
	await novel_interface.show_text_only("O cartunista Sr. Inoue, de setenta anos, desapareceu recentemente. \\nSe alguém souber do seu paradeiro, entre em contato com a polícia imediatamente.")
	await novel_interface.show_text_only("Verifiquei outros sites e até pesquisei com palavras-chave, mas não encontrei a notícia em lugar nenhum.")
	await novel_interface.show_text_only("Olhando para a cara de Mariru, estou muito grato.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Foi você...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru vem e enxuga minhas lágrimas.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Olhe para você, todo emocionado.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Se você realmente quer me agradecer, seja meu escravo então ~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("E…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Quando você disse \"o único com quem posso contar é Mariru\", \\nvocê ficou tão fofo…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru levanta meu queixo ternamente com o dedo indicador.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ei, pare com isso!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Pelo que posso ver, já estou escravizado…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Eu gostaria de poder fazer isso. Mas, que eu saiba, só existe uma agência que pode calar toda a mídia social em todo o mundo.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Deve ser uma ordem executiva do Congresso Unido.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O congresso supremo que representa todas as seis Cidades Acadêmicas… decidiu retirar a notícia?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Por que…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru olha para mim e me dá um sorriso misterioso.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Não seja bobo. Obviamente, eles não fizeram isso para proteger o ladrão.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Eles simplesmente não querem que o público saiba o que foi levado.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quem é esse ladrão? Por que ele usou minha identidade?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Quem quer que seja, deve ser um gênio para poder sair inteiro do Centro de Coleta e Pesquisa de Akatraz.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("O problema é que não é difícil para ele cobrir o rosto.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Mas ele não o fez, e até se atreveu a subir um pouco no telhado do prédio ...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("De acordo com o treinamento especial, as coisas mais insignificantes estão ausentes de onde deveriam aparecer…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("…Ou estão presentes onde não deveriam estar.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
