# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("이상한 꿈, 의미를 알 수 없는 대화, 꿈 속의 검은 그림자\\n그리고 전 인터넷에 푸시 된 AAA급 지명 수배령…")
	await novel_interface.show_text_only("억지로 새로운 신분과 생활을 받아들이고 다시 시작하려고 할 때, 그것들이 모든 걸 다시 흔들어놓았다.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("──마리루!", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("응?", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("뉴스 봤어?\\n그……아니, 내가, 내가 나왔어!", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("나도 알아. 눈 앞에 땀 범벅이 되어서 안절부절 못하는 네가 잘 보인다구.", "마리루")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("그게 아니라——\\n뉴스에 말이야!!", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("혼란스러워서 어디서부터 얘길 해야할지 모르겠다.\\n마리루가 코웃음을 치며 손날로 내 머리를 친다.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("훈련을 그렇게 해놓고도 소용이 없구나. 이런 일 하나도 장관에게 정확히 보고하지 못하다니.", "마리루")
	await novel_interface.show_dialog("예전의 너와 닮은 사람이 제2학원도시의 수용 기지를 털어서 지명 수배령이 내린 것?", "마리루")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("응, 맞아!", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("인터넷에 퍼진 정보는 정보부 요원이 이미 보고했어.", "마리루")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("놀라서 창백해진 얼굴이 정말 바보 같아~", "마리루")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("내 입가를 잡아당기는 마리루의 손을 황급히 잡았다. ")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("……마리루, 지금 그런 농담을 할 때가 아니잖아?", "샤오롄")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("전세계에 지명수배가 내려진 게 어떻게 사소한 일이야?", "샤오롄")
	await novel_interface.show_text_only("이런 일로 뉴스에 나올 줄은 꿈에서도 생각 못했다구!")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("게다가 AAA급 지명수배야!지난번 같은 급의 범죄자가 남미 산에서 폭탄을 맞았어!")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("빌어먹을 강도가 내 인생을 이렇게 망가트리다니…생각만해도 눈물이 나올 것 같아.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("만약 그렇다면……\\n지금 의지할 수 있는 사람이 마리루 밖에 없어……", "샤오롄")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("너의 울먹거리는 모습을 계속 감상하고 싶지만…", "마리루")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("가서 다시 정보를 확인해 보도록 해.", "마리루")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("무슨 확인이 필요해? 뉴스 정보가 빠짐없이 내 머릿속에 각인됐다고!")
	await novel_interface.show_dialog("선명하지는 않지만 내가 남자일 때 모습이랑 완전 똑같아. 거의 나였어!", "샤오롄")
	novel_interface.character_dark()
	await novel_interface.show_text_only("난 여전히 인정할 수 없다는 듯 휴대폰을 꺼내 뉴스 페이지를 열었다.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("이것 봐. 여기——\\n에?!", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("오늘 새벽에 날 깜짝 놀라게 한 지명수배령이 실종 신고 공지로 바뀌어 있다.")
	await novel_interface.show_text_only("70살 만화가 이노우에씨가 최근 실종됐습니다.\\n단서를 아는 분은 즉시 경찰에 연락…")
	await novel_interface.show_text_only("다른 사이트에서 키워드를 검색해봤지만, 그 뉴스는 처음부터 없었던 것처럼 사라졌다.")
	await novel_interface.show_text_only("의미심장하게 웃고 있는 마리루를 보자 마음 속에서부터 감동이 솟아오른다. ")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("네, 네가 한 거야?……", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("마리루가 내게 다가와 다정하게 내 눈가를 닦아준다.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("이것 좀 봐. 곧 울 것 같잖아.", "마리루")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("정말 고마우면, 오늘 이후로 평생 열심히 날 위해 희생하라구~", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("그리고……", "마리루")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("의지할 수 있는 사람이 마리루밖에 없어\"라는 말은\\n정말 너무 귀여워서 참을 수가 없는데…… ", "마리루")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("마리루가 손가락으로 내 턱을 들어올린다. ")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("노, 놀리지마~!", "샤오롄")
	novel_interface.character_dark()
	await novel_interface.show_text_only("지금 상황으로 보니 나도 널 위해 희생하는 것 같은데……?")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("내 능력이라고 말하고 싶지만, 전세계의 미디어를 다룰 수 있는 건 한 기관밖에 없어.", "마리루")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("엣?", "샤오롄")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("『연합회의』가 하달한 강제령이야.", "마리루")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("6개 학원도시 연합이 만든 최고 회의가…내 뉴스를 없애라고 했단 말이야?", "샤오롄")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("어째서…", "샤오롄")
	novel_interface.character_dark()
	await novel_interface.show_text_only("마리루가 내 얼굴을 쳐다보더니 신비로운 미소를 짓는다. ")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("멋대로 생각하지 마. 그들이 이렇게 한 건 강도를 보호하기 위해서가 아니니까.", "마리루")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("뭘 도난당했는지 사람들에게 알리고 싶지 않아서야. ", "마리루")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("그 강도가 누군지는 모르겠지만, 왜 내 신분으로 나타났을까?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("알카트라즈 수용 기지에 들어갔다가 멀쩡히 빠져나가다니, 정말 대단해~", "마리루")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("진짜 문제는 이런 사람에게 모습을 감추는 것쯤은 간단한 일이라는 거지.", "마리루")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("하지만 그 녀석은 모습을 감추지 않고 옥상에 당당하게 서있었어……", "샤오롄")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("훈련 수업에서 배운 적 있어. 가장 놓치기 쉬운 것은 나타나야 할 것이 없는 것……", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("──그리고 있어선 안 되는 정보가 나타나는 것.", "마리루")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
