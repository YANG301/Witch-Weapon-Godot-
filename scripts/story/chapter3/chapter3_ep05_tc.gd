# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("剛回到總部，莉琉就指使安妮和伊露卡去執行別的任務。")
	await novel_interface.show_text_only("我有些忐忑，不知道是否又會面對奇怪的拷問……")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("發生什麼事了？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("沒事的話，妳想一直在伊露卡旁邊像個變態一樣傻笑嗎？", "莉琉")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳、妳果然用學校的監視器偷窺！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("呵呵呵～～妳只能想到那麼老土的方式嗎？", "莉琉")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("那還有什麼方法……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("比如說──", "莉琉")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("莉琉上下打量著我，露出了邪惡的神情。")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("戰研部有一種晶片，植入以後連妳什麼時候想上廁所都能完美的控制。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("控、控制？ \\n那也太糟糕了！ ！", "小憐")
	await novel_interface.show_dialog("這種奇怪的東西多半是愛衣做的吧……\\n等等，妳們不會偷偷給我植入了吧！", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("開玩笑的。", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("這麼敷衍的回答，一點也不像開玩笑！ ！")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("還是說……妳想到什麼奇怪的事情了？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("唔，可惡……", "小憐")
	await novel_interface.show_dialog("（上次全校集會的時候我忽然鬧肚子……）\\n（難、難道是！ ？）", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哈哈哈哈～～妳居然當真了喔？", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉大笑著揉了揉我的腦袋。")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("那種東西，愛衣只做了一個原型機就被我罵慘了，\\n怎麼可能用在妳這種沒價值的目標身上。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("沒價值的目標……還真是謝謝妳啊……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("話說，妳剛才在想什麼丟人的畫面啊～", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("嗚嗚……還好沒有顯示思考畫面的機器，不然我真要找個地洞鑽進去。")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("別馬上擺出認命的表情嘛，這樣就一點都不好玩了。", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("讓妳失望了，真是對不起。")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哎，以妳現在的能力，不知道能不能完成向重要目標套出資訊的工作。", "莉琉")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉抹了抹因大笑而盈眶的淚水，轉換成平時傲慢而自信的表情。")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("重要人物……雖然比滿足妳的惡搞有意義，但人家哪會跟我一個學生透露什麼啊。", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("就是要利用妳學生的身分，這次的目標是第四學園都市考察團的代表──", "莉琉")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("拉斐爾·戴克斯，薩蒙頓市市長的孫女，可是如假包換的超級貴族大小姐哦。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("是不是很激動？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("這有什麼好激動的。", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嘖，果然只有小女孩才能讓妳興奮起來嗎……", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("不要把這種犯罪者的設定套用到我身上啊！", "小憐")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("……咳咳。 \\n總之妳要我向那位大小姐打聽什麼消息？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("轉移話題的功夫真差勁……\\n妳不會真的一開始就被識破吧。", "莉琉")
	await novel_interface.show_dialog("先不計較了，妳有多瞭解第四學園都市？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("唔……我記得是現在最大的糧食出口國？", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("說起薩蒙頓市，第一印象就是萊茵河畔林立的幾十層樓高的立體溫室。")
	await novel_interface.show_text_only("那一大片從溫室群的玻璃罩裡透出生機盎然的綠色，\\n一向是電腦桌布的絕佳素材。")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("另外，薩蒙頓好像有很多教堂，大家都有宗教信仰，還成立了一個「神聖聯盟」之類的……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("只記得這些了，像地理這種知識重點分散又需要大段背誦的課程，光想就開始胃痛加頭痛。")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("第四學園都市的經濟和話語權，在相當程度上取決於他們對農作物基因的控制力。", "莉琉")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("不過「洛斯金盃」消失後發生的一連串事件，恐怕也威脅到了他們的根基。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("威脅是指……空間異變？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("沒錯，雖然報告指出第四學園都市境內也發生了多處異變，但一直無法判斷其損失情況。", "莉琉")
	await novel_interface.show_dialog("從這幾天穀物和豆類期貨的異動看來，影響應該不小……會在局部地區引起飢荒也說不定。", "莉琉")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這麼嚴重嗎……", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("雖然不懂那個什麼市場，但我之前一直認為，異變最多只會威脅到小範圍區域。")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("是啊，糧食減產引起的問題通常有一定的遲滯現象，畢竟各國都有風險儲備。", "莉琉")
	await novel_interface.show_dialog("看來另外五個學園都市裡，首先按捺不住的就是他們了。", "莉琉")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("薩蒙頓籌備了一支考察團，已經出發前往新豐洲了。", "莉琉")
	await novel_interface.show_dialog("我們作為主要糧食進口國，是無法拒絕他們的請求的。", "莉琉")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("難道他們……會懷疑到我和安妮頭上嗎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("這就是我找妳來的原因。", "莉琉")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("什麼？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("雖然打著「藝術交流」的名號，但這支考察團可是由皇家保衛局親自負責保密和安全工作的。", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("皇家保衛局……第四學園都市的情報機構，又稱十字玫瑰（Rosenkreutz）。")
	await novel_interface.show_text_only("雖然是間諜組織，卻因為描寫其7號特務的一系列電影而眾所周知。")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("那不是很麻煩嗎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("沒錯，就算SID想做個背景調查都會處處受限。", "莉琉")
	await novel_interface.show_dialog("目前得到的消息中，與妳有關的，就是那位貴族大小姐會去參觀御櫻川女子中學。", "莉琉")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("來我的學校？ ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("這倒是不奇怪，她的年紀應該在讀高二，也是高中生。", "莉琉")
	await novel_interface.show_dialog("所以需要妳在她參觀的過程中，搞清楚考察團的真正目的。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("我請情報部將薩蒙頓和戴克斯家族的背景知識做成了一本小冊子，回去好好溫習一下吧。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("哎，又要背書啊……\\n總之交給我吧！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("回家的時候要小心色狼哦。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("喂！ 什、什麼啦！", "小憐")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
