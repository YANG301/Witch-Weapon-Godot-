# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("距離莉琉交代任務開始已過了兩天。")
	await novel_interface.show_text_only("就在昨晚，這支打著「藝術交流」名號的考察團終於抵達了新豐洲國際機場。")
	await novel_interface.show_text_only("我的任務也要開始了吧？")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("不過我去套話……真的沒問題嗎？", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("說穿了，對方可是名門望族的大小姐，萬一根本不搭理我怎麼辦？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("看那邊那個人的衣服，不是我們學校的人吧？", "同學甲")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("身邊還跟著隨時站得筆直的隨從，是誰家的大小姐嗎？", "同學乙")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我順著她們的視線望過去，看見一位身材修長，\\n穿著綠色外套的少女站在草坪外。")
	await novel_interface.show_text_only("居然就是這次的目標──拉斐爾·戴克斯。")
	await novel_interface.show_text_only("剛才還看到副校長和儀隊在大門外準備歡迎儀式，她就這麼偷偷溜進來了？")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("小姐，請往這邊走。", "隨行人員")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("這棟教學大樓是仿照了黃金時期的都鐸式風格吧。", "拉斐爾")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("可惜庭院的格局太小，完全無法體現出空間的厚重感。", "拉斐爾")
	await novel_interface.show_dialog("裝飾牆面上的雕刻也不夠精美，根本沒有達到支撐結構和裝飾的雙重作用。", "拉斐爾")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("拉斐爾小姐果然對藝術有著非比尋常的品味呢！", "隨行人員")
	await novel_interface.show_dialog("像這樣的建築就應該再把中庭的高度提高一點才對啊。", "隨行人員")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳說什麼啊？ \\n單純提升高度解決不了問題。", "拉斐爾")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("是啊是啊，如果能把庭院的草坪面積再加大一些就好了。", "隨行人員")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哈？ 那樣不就顯得太突兀了嗎？ \\n畢竟教學大樓前面的花園也只有這麼一點面積……", "拉斐爾")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("在拉斐爾小姐的眼裡，像這種缺乏園藝規劃、植被凌亂的地方，連花園也稱不上吧？", "隨行人員")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("聽到這樣的話語，拉斐爾似乎有些不太滿意。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("……我才沒有這麼認為。", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("啊——！ \\n拉斐爾小姐實在很平易近人呢！", "隨行人員")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("那位儀態標準的隨行人員，妳還沒發現旁邊那位大小姐的臉色已經越來越難看了嗎？")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("喂，那邊的女裝癖。", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("……啊咧？ ！", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（女裝癖……是在說我嗎？ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("周圍的人順著拉斐爾的聲音，一同將目光轉向了我。")
	await novel_interface.show_text_only("瞬間被這麼多人圍觀，我感覺臉上一陣火熱。")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("不，我不是、我沒有……！ \\n（這件制服，是莉琉逼我穿的！ ）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("吞吞吐吐的像個男人嗎？", "拉斐爾")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("真是的，原來新豐洲市已經開放到連妳這種癖好也可以公然展示在大眾面前了啊。", "拉斐爾")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("莉琉，我現在拒絕這個任務，還來得及嗎？")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("那個……小憐是我們的同學哦，她是女生啦。", "同學甲")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("什麼？ \\n怎麼可能？", "拉斐爾")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("拉斐爾露出了權威受到挑戰的表情。")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("我沒有騙妳啊，我們都可以作證的。 \\n小憐絕對是真正的女孩子！", "同學乙")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("雖然很感謝這位仗義執言的同學，但我絕對不是真正的女孩子。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("……嘖，我還以為是個男人呢。", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("我哪、哪裡像男人了啊……\\n(不、不對……）", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("啊──背叛自己的滋味就是這樣的酸澀嗎。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("算了，不跟妳計較了。", "拉斐爾")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("妳覺得這裡的建築水準怎麼樣呢？", "拉斐爾")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("建築學什麼的我完全不瞭解，就算妳問我……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("妳照直覺回答就好了。", "拉斐爾")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("唔，作為教學大樓來說，中庭的高度已經不算特別低了吧。", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("會讓妳感到不順眼，或許是因為……不夠可愛？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("我一邊觀察著拉斐爾的神色，一邊為自己貧乏的詞彙量感到自責。")
	await novel_interface.show_text_only("果然不出所料，她的臉上露出了輕蔑的笑容。")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("可愛？ ！真是難以相信，居然會有人用這麼膚淺的詞彙來形容建築。", "拉斐爾")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("只、只是一種感覺啦！", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("我是說樹木的排列如果不那麼整齊，可能就會好一點。", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("呃……\\n比如……嗯……", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("所以說為什麼要問我啊！")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("妳想說讓樹陣層次錯落地交替布置，讓視野縱深加強吧？", "拉斐爾")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("是。 \\n（有聽沒有懂，您在說什麼啊？ ）", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("拉斐爾聽到這裡，終於露出了一點笑容。")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("雖然是個女裝癖，但比這個只知道附和的傢伙有用多了。", "拉斐爾")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("就跟妳說說我不是……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("大小姐……", "隨行人員")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("好了，妳去外面等我吧。", "拉斐爾")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("妳叫小憐？ 走吧，快點過來跟我炫耀一下這所學校的優點吧。", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("欸……？ \\n喔，好、好的！", "小憐")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
