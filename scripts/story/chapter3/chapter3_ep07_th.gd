# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("ผ่านมาสองวันแล้วตั้งแต่ Mariru มอบหมายงานให้ฉัน")
	await novel_interface.show_text_only("เมื่อคืนที่ผ่านมา คณะผู้แทน \"การแลกเปลี่ยนวัฒนธรรม\" มาถึง New Opulentia International Airport ในที่สุด")
	await novel_interface.show_text_only("ดังนั้น… ภารกิจของฉันกำลังจะเริ่มต้นขึ้น")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("แต่พยายามเกลี้ยกล่อมข้อมูลจากผู้หญิงคนนั้น ... ฉันไม่รู้", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("ยังไงซะเธอก็ไม่ใช่เด็กสาวธรรมดา ถ้าเธอปฏิเสธที่จะคุยกับฉันล่ะ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("ดูสาวตรงนั้นสิ! เธอไม่ได้สวมชุดนักเรียนของเรา", "นักเรียน 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("แล้วคนที่อยู่ข้างๆเธอดูเหมือนคนรับใช้ ... เธอเป็นเจ้าหญิงหรือเปล่านะ?", "นักเรียนคนที่ 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันมองไปเห็นหญิงสาวร่างผอมในชุดโค้ตสีเขียว \\nเธอยืนอยู่หน้าสนามหญ้า")
	await novel_interface.show_text_only("เป้าหมายของภารกิจของฉัน—Raphael Dekkers")
	await novel_interface.show_text_only("เมื่อกี้ฉันเห็นรองผู้อำนวยการและวงดนตรีเกียรติยศรออยู่หน้าประตูโรงเรียน เธอแอบเข้าไปในมหาวิทยาลัยเหรอ?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("คุณหญิง เชิญทางนี้ค่ะ", "ผู้ติดตาม")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("อาคารเรียนแห่งนี้ได้รับการออกแบบในสไตล์ทิวดอร์แห่งยุคทอง", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("แต่เอเทรียมแคบเกินไปที่จะแสดงความยิ่งใหญ่", "Raphael")
	await novel_interface.show_dialog("และการแกะสลักบนกระดานข้างก้นนั้นดูงุ่มง่ามเกินกว่าจะรองรับโครงสร้างและการออกแบบได้", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("คุณคะ คุณมีรสนิยมทางศิลปะที่ไม่ธรรมดาจริงๆ!", "ผู้ติดตาม")
	await novel_interface.show_dialog("สถาปัตยกรรมทิวดอร์แบบนี้ควรมีห้องโถงสูงกว่านี้", "ผู้ติดตาม")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ไม่ คุณไม่เข้าใจมัน \\nแค่เพิ่มความสูงคงไม่ได้ผล", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("คุณพูดถูกครับคุณหนู ควรขยายสนามหญ้าด้วย", "ผู้ติดตาม")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฮะ? นั่นก็จะดูไม่สอดคล้องกัน \\nทั้งลานด้านหน้าก็แออัดอยู่แล้ว...", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("แน่นอน. คุณ Raphael จะไม่เรียกที่ดินที่ไม่เป็นระเบียบนี้ว่าหน้าบ้านด้วยซ้ำใช่ไหม", "ผู้ติดตาม")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael ดูเหมือนจะค่อนข้างไม่พอใจกับคำเหล่านี้")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… ไม่ นั่นไม่ใช่สิ่งที่ฉันคิด", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("โอ้! \\nคุณช่างดีจริงๆ คุณ Raphael!", "ผู้ติดตาม")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ทำไมคนรับใช้ของเธอถึงไม่เห็นรอยยิ้มของเธอแข็งทื่ออยู่แล้ว?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("เฮ้ คุณเป็นคนที่แต่งตัวประหลาดข้ามเพศ", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("อะไรนะ?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(คนที่คลั่งไคล้การแต่งตัวข้ามเพศ ... เธอกำลังพูดถึงฉันหรือเปล่า?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เมื่อคำพูดของเธอ ทุกคนหันมามองมาที่ฉัน")
	await novel_interface.show_text_only("ไม่เคยมีสายตามากมายกับฉัน ฉันรู้สึกว่าตัวเองหน้าแดง")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ไม่ ฉัน... ฉันไม่...! \\n(Mariru ให้ฉันใส่ชุดนักเรียน!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("เป็นผู้ชายแล้วยอมรับมั้ย?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("ฉันไม่รู้ว่า New Opulentia เป็นคนเสรีนิยมมากจนคนนิสัยแย่อย่างคุณถึงสามารถเข้าเรียนในโรงเรียนหญิงล้วนได้", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru ฉันเปลี่ยนใจแล้ว! ฉันไม่อยากทำสิ่งนี้!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("อืม… เร็นเป็นเพื่อนร่วมชั้นของเรา เธอเป็นผู้หญิง!", "นักเรียน 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("อะไรนะ? \\nหยุดล้อเล่นฉันได้แล้ว", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael ดูราวกับว่าเธอขุ่นเคือง")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("เธอไม่ได้ล้อเล่น! เราทุกคนสามารถรับรองคุณได้ \\nเรนเป็นเด็กผู้หญิงจริงๆ", "นักเรียนคนที่ 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ขอบคุณที่พูดแทนฉัน แต่ฉันไม่ใช่ผู้หญิงแน่นอน")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("…ตุ๊ดตู่ ฉันคิดว่าคุณเป็นเด็กผู้ชาย", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("ทำไม! I look nothing like a boy! \\n(โอ้ ไม่…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("ฮึ… มันแย่มากที่ต้องทรยศต่อฉันคนเก่า…")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("เอาล่ะ. ลืมมันซะ", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("คุณคิดอย่างไรเกี่ยวกับสถาปัตยกรรมในโรงเรียนของคุณ?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันไม่มีความคิดเกี่ยวกับสถาปัตยกรรม หากคุณยืนกราน...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("แค่พูดอะไรก็ตามที่อยู่ในใจของคุณ", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เอิ่ม ... เป็นอาคารเรียน ห้องโถงไม่ต่ำเกินไป", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("ตึกไม่เจริญตา…อาจเป็นเพราะ…ไม่น่ารักพอเหรอ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ด้วยความละอายใจกับคำศัพท์ที่ไม่ค่อยดี ฉันพยายามจับตาดูสีหน้าของ Raphael")
	await novel_interface.show_text_only("ตามที่คาดไว้ เธอยิ้มอย่างดูถูก")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("น่ารัก? ฉันไม่อยากจะเชื่อหูของฉัน คำนั้นคือสิ่งเดียวที่คุณหามาอธิบายสถาปัตยกรรมได้ใช่ไหม", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มันเป็นแค่สิ่งที่ฉันรู้สึกเกี่ยวกับมัน!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("ฉันหมายความว่ามันอาจจะดีกว่า…ถ้าต้นไม้ไม่เรียงกันอย่างสมบูรณ์…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("อืม… \\nแบบว่า เอ่อ…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("เอ่อ…ทำไมฉันต้องตอบคำถามนี้ด้วย?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("คุณกำลังพยายามจะบอกว่าต้นไม้ควรสลับกันเพื่อเพิ่มความลึกในการออกแบบใช่ไหม?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เผงเลย \\n(เธอเพิ่งพูดอะไรไป?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael ในที่สุดก็ยิ้มบางๆ ให้ฉัน")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("อา คนนิสัยเสียดีกว่าคนใช่เยอะ!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("ไม่ ฉันไม่...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("นางสาว...", "ผู้ติดตาม")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ทิ้งเราไว้. รอฉันอยู่นอกโรงเรียน", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("คุณคือเรนใช่ไหม? ไปกันเลย อวดโรงเรียนที่น่าทึ่งของคุณให้ฉันดูหน่อยสิ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("เอ๊ะ…? \\nโอ… เอาล่ะ!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
