# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Es ist zwei Tage her, seit Mariru mir die Aufgabe zugewiesen hat.")
	await novel_interface.show_text_only("Gestern Abend traf die „Kulturaustausch“-Delegation endlich am New Opulentia International Airport ein.")
	await novel_interface.show_text_only("Also ... Meine Mission beginnt gleich.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Aber ich versuche, diesem Mädchen Informationen zu entlocken ... Ich weiß es nicht.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Wie auch immer, sie ist kein gewöhnliches Mädchen. Was ist, wenn sie sich weigert, mit mir zu reden?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Schau dir das Mädchen da drüben an! Sie trägt nicht unsere Schuluniform.", "Schüler 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Und die neben ihr sieht aus wie eine Dienerin. ... Ist sie eine Art Prinzessin?", "Schüler 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue hinüber und sehe ein schlankes Mädchen in einem grünen Mantel. \\nSie steht vor dem Rasen.")
	await novel_interface.show_text_only("Das Ziel meiner Mission – Raphael Dekkers.")
	await novel_interface.show_text_only("Ich sah gerade den stellvertretenden Schulleiter und die Ehrenkapelle vor dem Schultor warten. Hat sie sich auf den Campus geschlichen?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Fräulein, bitte hier entlang.", "Gefolge")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Dieses Schulgebäude ist im Tudor-Stil des Goldenen Zeitalters gestaltet.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Aber das Atrium ist zu eng, um ein Gefühl von Erhabenheit zu vermitteln.", "Raphael")
	await novel_interface.show_dialog("Und die Schnitzerei auf der Fußleiste ist zu ungeschickt, um die Struktur und das Design zu unterstützen.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Fräulein, was für einen außergewöhnlichen Geschmack für Kunst Sie haben!", "Gefolge")
	await novel_interface.show_dialog("Tudor-Architektur wie diese sollte ein höheres Atrium haben.", "Gefolge")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nein, du verstehst es nicht. \\nEinfaches Erhöhen der Höhe würde nicht funktionieren.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sie haben völlig recht, Frau. Auch der Rasen sollte erweitert werden.", "Gefolge")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hä? Das würde einfach unkoordiniert aussehen. \\nDer ganze Vorgarten ist schließlich schon verstopft …", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Natürlich. Miss Raphael würde dieses unorganisierte Stück Land doch nicht einmal als Vorgarten bezeichnen, oder?", "Gefolge")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael scheint mit diesen Worten etwas unzufrieden zu sein.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… Nein, das ist nicht das, was ich denke.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Oh! \\nWie nett von Ihnen, Miss Raphael!", "Gefolge")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Warum sieht ihre Begleiterin nicht, dass ihr Lächeln bereits steif ist?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Hey, du Cross-Dressing-Freak.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Was?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Cross-Dressing-Freak ... Spricht sie über mich?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bei ihren Worten drehen sich alle zu mir um.")
	await novel_interface.show_text_only("Da ich es nicht gewohnt bin, so viele Blicke auf mich zu haben, spüre ich, wie ich rot werde.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Nein, ich bin... ich bin nicht...! \\n(Mariru hat mich dazu gebracht, die Uniform zu tragen!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Sei ein Mann und gib es zu, ja?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Ich wusste nicht, dass New Opulentia so liberal ist, dass ein Perverser wie du auf eine Mädchenschule aufgenommen werden könnte.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, ich habe meine Meinung geändert! Ich möchte das nicht tun!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Ähm... Ren ist unser Klassenkamerad. Sie ist ein Mädchen!", "Schüler 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Was? \\nHör auf, mich zu veräppeln.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael sieht aus, als wäre sie beleidigt.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Sie macht keine Witze! Wir können es Ihnen alle versichern. \\nRen ist absolut ein Mädchen.", "Schüler 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vielen Dank, dass Sie sich für mich eingesetzt haben. Aber ich bin definitiv kein Mädchen.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, ich dachte, du wärst ein Junge.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Warum! Ich sehe überhaupt nicht wie ein Junge aus! \\n(Oh, nein…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh ... Es ist scheiße, mein altes Ich zu verraten ...")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Alles klar. Vergiss es.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Was halten Sie von der Architektur Ihrer Schule?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich habe keine Ahnung von Architektur. Wenn Sie darauf bestehen ...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Sagen Sie einfach, was Ihnen in den Sinn kommt.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ähm ... als Schulgebäude ist das Atrium nicht zu niedrig.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Das Gebäude ist für das Auge nicht angenehm … vielleicht, weil es … nicht süß genug ist?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ich schäme mich für meinen dürftigen Wortschatz und versuche, den Gesichtsausdruck von Raphael einzufangen.")
	await novel_interface.show_text_only("Wie erwartet lächelt sie verächtlich.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Süß? Ich kann meinen Ohren nicht trauen. Ist dieses Wort alles, was Sie finden können, um eine Architektur zu beschreiben?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nun, es ist genau das, was ich dabei empfinde!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Ich meine, es könnte besser sein ... Wenn die Bäume nicht perfekt ausgerichtet sind ...", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Ähm... \\nWie, äh...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh... warum muss ich diese Frage beantworten?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Wollen Sie damit sagen, dass die Bäume abwechselnd angeordnet werden sollten, um dem Design mehr Tiefe zu verleihen?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Genau. \\n(Was hat sie gerade gesagt?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael schenkte mir schließlich ein schwaches Lächeln.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ah, ein Perverser ist viel besser als ein Jasager!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nein, ich bin nicht...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Fräulein…", "Gefolge")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Verlass uns. Warte vor der Schule auf mich.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Du bist Ren, oder? Lass uns gehen. Zeigen Sie mir Ihre tolle Schule, ja?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Äh...? \\nO... Okay!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
