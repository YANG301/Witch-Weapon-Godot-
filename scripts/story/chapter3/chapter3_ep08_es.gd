# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Me sentía inquieto mientras recorría Raphael por el campus.")
	await novel_interface.show_text_only("Nunca pensé que podría acercarme al objetivo tan fácilmente.")
	await novel_interface.show_text_only("El subdirector, al ver que su ceremonia de bienvenida largamente preparada es frustrada, muerde un pañuelo con resentimiento en algún lugar detrás de nosotros.")
	await novel_interface.show_text_only("Sin embargo, la joven no parece satisfecha con nuestro pequeño recorrido, aunque ahora está de mucho mejor humor.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("¿Es eso todo?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Um-hum, si te refieres a la gira.", "Lian")
	await novel_interface.show_dialog("Si continúas por ese camino llegarás a la zona comercial.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Muchos edificios aquí imitan estilos arquitectónicos de antes de la guerra, intentando transmitir un sentido de cultura.", "Raphael")
	await novel_interface.show_dialog("Pero este campus es tan pequeño que no hay separación entre edificios de estilos contrastantes.", "Raphael")
	await novel_interface.show_dialog("Esto hace que todo aquí sea demasiado sofocante, ¿no lo crees?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia es una ciudad reconstruida sobre ruinas. La mayoría de sus sitios históricos fueron incendiados.")
	await novel_interface.show_text_only("En realidad, es bastante lujoso tener una extensión de tierra así dentro del escudo protector donde la tierra es escasa.")
	await novel_interface.show_text_only("De alguna manera me siento ofendido por sus palabras...")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Mmm...", "Lian")
	await novel_interface.show_dialog("Debes ser Raphael Dekkers de la Cuarta Ciudad Académica.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Entonces, ¿por qué visitas la escuela si no te gusta aquí?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Vaya, ¿sabes quién soy?", "Raphael")
	await novel_interface.show_dialog("Hm… Todo es gracias a mi abuelo. Quiere que estudie en otra Ciudad Académica…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Pero esta escuela imitadora sin ninguna historia… nunca volvería a poner un pie en ella.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Así que simplemente no está contenta con el plan de su abuelo...) \\n(¡¿Por qué no habló?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Mierda! Sus palabras de alguna manera me han afectado. De repente, todos los edificios de la escuela parecen extraños.")
	await novel_interface.show_text_only("¡Maldita sea! ¡Olvídate de esos comentarios! ¡Ahora!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Vaya, ya que estás tan decepcionado...", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("¿Por qué no le cuentas a tu abuelo lo que piensas?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se acerca a nosotros, elegante como siempre.")
	await novel_interface.show_text_only("Cuando sus miradas se encuentran, creo escuchar el crujido de una descarga de alto voltaje.")
	await novel_interface.show_text_only("Debe ser… una alucinación, ¿verdad?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("¿Quién eres?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Bueno, soy un don nadie en esta escuela.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Sólo me pregunto qué la trae por aquí, mi señora.", "Nix")
	await novel_interface.show_dialog("¿Por qué accediste a venir aquí en primer lugar? ¿Es por la presión familiar?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mi asunto familiar no es asunto tuyo.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Déjame adivinar. Una niña egocéntrica que nunca ha desafiado la voluntad de sus padres.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("¿Por qué te consideras más arriba? ¿Quién te da derecho a juzgar una escuela? Después de todo, ella se ofreció voluntaria para mostrarte los alrededores.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("¡¿Perdón?! ¿Cuándo me consideré superior?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Oye, pervertido. ¿Alguna vez he sido tan altivo?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Realmente no…", "Lian")
	await novel_interface.show_text_only("Espera, ¡no soy un pervertido!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¿Ves? Yo no dije eso.", "Raphael")
	await novel_interface.show_dialog("Por cierto, la cosa que llevas al cuello...", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("¿Se permiten joyas en esta escuela?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("En realidad, no tenemos ninguna restricción sobre el uso de adornos...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Y el collar de Nix es tan lindo!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("La banda puede ser discreta, pero definitivamente no es la gema que la contiene: el Orlov Black Diamond. Esta joya real se rompió en tres pedazos y se perdió durante las turbulencias antes de que estallara la guerra.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Probablemente puedas comprar un par de edificios aquí con solo una pieza.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¡¿Qué?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Hacerse pasar por un estudiante común y corriente y hablar por ellos… ¿Qué quieres? ¿Para engañar a este pervertido travesti diciéndole que estás de su lado?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Deja de llamarme pervertido!")
	await novel_interface.show_text_only("¿Y por qué Nix tiene ese aspecto sutil y lamentable?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Sólo llevo algo que me queda bien.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("¿Qué hay de ti? Intentas parecer independiente pero te enorgulleces de disfrutar de la riqueza de tu familia. Eso es gracioso.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Recuerdo que las tres piezas cayeron en manos de un jefe de la mafia. Un Diamante Negro comprado con dinero mal habido le sienta bien.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bueno, tengo que admitir que mi familia es menos afortunada. Después de todo, no todo el mundo puede ganar una fortuna y un título nobiliario gracias al monopolio de los cereales.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Eso es porque solo nuestros cultivos pueden ayudar a la gente a prevenir la peste negra. Ellos merecen vivir, a diferencia de ti, podrido por dentro y por fuera.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Insistes en mantener la fe mientras amenazas al mundo con el hambre. ¿Por qué no reflexionas primero sobre tu propia alma?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("No necesito hacer eso con gente como tú. Sólo me traerá vergüenza.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Oh, eso suena familiar. Tampoco quiero saber nada de ustedes, perdedores.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("El sol de la tarde brilla suavemente sobre nosotros.")
	await novel_interface.show_text_only("Entre los dos, no tengo idea de cómo resolver esta pelea.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(¿Estás seguro de que no se conocieron antes?)", "Lian")
	await novel_interface.show_dialog("(¿Realmente no sois enemigos de toda la vida?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El subdirector en la distancia ya se asustó y se lo llevaron para recibir tratamiento de emergencia.")
	await novel_interface.show_text_only("No importa. I've got all the information Mariru wants.")
	await novel_interface.show_text_only("De todos modos, no es asunto mío.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
