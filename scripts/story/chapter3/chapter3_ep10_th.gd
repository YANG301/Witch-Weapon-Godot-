# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("ต้องขอบคุณ Skurd ที่ทำให้ Fabella ตัดสินใจปล่อยฉันไป")
	await novel_interface.show_text_only("ขณะที่สเคิร์ดหันหลังกลับ แขกที่แต่งตัวดีหลายคนก็เดินเข้ามาคุยกับเธอ")
	await novel_interface.show_text_only("เด็กผู้หญิงคนนี้มีอายุประมาณ Elluka แต่เธอก็โดดเด่นในโอกาสทางสังคมที่หรูหราเช่นนี้...")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… เธอมาจากตระกูลขุนนางเหรอ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ขณะที่ Fabella หันไปสนใจเจ้านายของเธอ ฉันก็แอบไปที่อีกฟากหนึ่งของห้องจัดเลี้ยง")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("นี่ทำให้ฉันตกใจมาก… \\nนายน้อยและสาวใช้ของเธอใช่ไหม", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ดูเหมือนว่าสาวใช้จะไม่ตอกตะปูฉัน \\nเธอแค่อยากหลอกฉันเหรอ?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("เรน คุณมาแล้ว!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("ฉันอาจจะสะดุดกับเบาะแสสำคัญ!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("เอ๊ะ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เมื่อสักครู่นี้ ฉันเดินตามคณะผู้แทนไปยังชั้นผู้บริหารอย่างลับๆ และที่นั่นฉันเห็นคณะผู้ติดตามของ Raphael ถือกระเป๋าเดินทางพิเศษ", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("กระเป๋าเดินทาง... อะไรอยู่ในนั้น?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ไม่รู้สิ แต่ฉันจำได้ว่าการฝึกอบรม SID กล่าวถึงวัสดุที่ใช้ในกระเป๋าเดินทาง!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("มันเป็นโลหะสีเขียวอมเทาที่มีแสงสีฟ้าอ่อนที่แปลกประหลาด—", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("แสงสีฟ้าอ่อน… \\nอะไรนะ! ใช่ไหม…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ฉันจำโลหะผสมที่ลดหรือกำจัดผลกระทบของสารออกฤทธิ์ทางจิตและมีม Substance H...")
	await novel_interface.show_text_only("Substance H ภาชนะที่ทำจากโลหะผสมนี้สามารถหลบเลี่ยงการสแกนเฉดสีได้เกือบทั้งหมด")
	await novel_interface.show_text_only("โลหะผสมนั้นคือ Substance H—98% ของโลหะดังกล่าวเป็นโลหะที่รู้จัก และอีก 2% ที่เหลือไม่ใช่สารที่ไม่รู้จัก")
	await novel_interface.show_text_only("เนื่องจากความขาดแคลน ราคาในตลาดมืดจึงพุ่งสูงขึ้น")
	await novel_interface.show_text_only("ฉันเกือบจะแน่ใจว่าสิ่งของใดๆ ในกระเป๋าเดินทางใบนั้นเกี่ยวข้องกับ Substance H")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("อึศักดิ์สิทธิ์! \\nคุณได้รายงานเรื่องนี้กับ Mariru แล้วหรือยัง?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("คณะผู้แทน Salmonton ไม่ได้รายงานต่อวุฒิสภาว่าพวกเขาจะนำ Substance H ใดๆ ไปด้วย")
	await novel_interface.show_text_only("Substance H การทำลายล้างใดๆ ที่ลักลอบเข้าไปในสนามพลังป้องกันอาจนำหายนะมาสู่ New Opulentia")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("ฉันบอกเธอทันที เธอจะต้องยื่นขอหมายค้นจากวุฒิสภาในขณะนี้", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("แต่แค่เห็นแว๊บๆ เลยไม่ได้ถ่ายรูปไว้ \\nฉันไม่คิดว่าพวกเขาจะบุกเข้าไปในห้องได้โดยไม่มีหลักฐานใดๆ เพิ่มเติม...", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("นั่นเป็นเหตุผลที่ Mariru เพิ่งอัปเดตภารกิจของเราในการ \"รักษาความปลอดภัยและอัปโหลดหลักฐานโดยเร็วที่สุด\"", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("ถ้าเป็นเช่นนั้น โอกาสเดียวก็คือแอบเข้าไปในห้องของพวกเขา...", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ใช่แล้ว…ห้องของหญิงสาว ไม่ใช่งานง่าย", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("อืม… เราจะต้องเล่นมันด้วยหูตอนนี้", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("ชั้นผู้บริหารสงวนไว้สำหรับการมอบหมาย เราไปถึงที่นั่นด้วยลิฟต์บริการ")
	await novel_interface.show_text_only("ฉันเข็นรถเข็นเสิร์ฟ \"ยืม\" ไปที่ทางเดินที่มีการป้องกันอย่างแน่นหนา Annie ซ่อนอยู่ข้างใต้…")
	await novel_interface.show_dialog("เฮ้! คุณไม่ควรอยู่ที่งานเลี้ยงชั้นล่างเหรอ? \\nคุณไม่ได้รับอนุญาตที่นี่ ออกไปตอนนี้", "ความปลอดภัย")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(รปภ.เยอะมากนั่นเองค่ะ…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("ฮะ? แต่แขกจากห้องรอยัลสวีทเพิ่งสั่งรูมเซอร์วิสฟัวกราส์พร้อมวิสกี้เผา!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ผู้นำดูไม่ประทับใจเลย")
	await novel_interface.show_text_only("เห็นได้ชัดว่าฉันประเมินเขาต่ำไป ต้องหาทางอื่น...")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("เอ่อ…บางทีรูมเซอร์วิสอาจทำผิดพลาด ขออภัยครับท่าน...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันยังพูดไม่จบเมื่อ Annie รีบวิ่งออกไปใช้ไม้เบสบอลฟาดคอเขา")
	await novel_interface.show_text_only("จากนั้นเธอก็หันหลังกลับและขว้างลูกเบสบอลใส่หน้ายามอีกคนหนึ่งซึ่งอยู่ห่างออกไป 10 หลา")
	await novel_interface.show_text_only("ยามที่เหลือตกตะลึงกับการโจมตีนี้ ก่อนที่เขาจะไปถึงตัวรับส่งสัญญาณ Annie เตะเขาเข้าที่คาง")
	await novel_interface.show_text_only("ชายสามคนล้มลงเกือบทั้งหมดในคราวเดียว ไม้ตีกระดอนบนพื้นแล้วกระโดดกลับไปหามือของ Annie")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("เคลียร์!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("อะไรนะ… คุณทำอะไรลงไป?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("ไม่มีอะไร แค่ปล่อยให้พวกเขาได้พักผ่อนสักพัก", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("ฮ่าฮ่า นั่นสินะ Annie… \\n(ขอบคุณพระเจ้า ฉันอยู่กับเธอ…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("และเธอไม่ได้ใช้เวทมนตร์ใดๆ เลยด้วยซ้ำ! \\nเธอได้รับการฝึกอบรมประเภทไหน...")
	await novel_interface.show_text_only("หลังจากเอายามออกไปให้พ้นทาง Annie ก็พาฉันไปที่ห้องสวีทสองประตูตรงสุดทางเดิน")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("ที่นี่.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เราแลกเปลี่ยนรูปลักษณ์กัน \\nขณะที่เรากำลังจะแนบหูไปที่ประตู...")
	await novel_interface.show_text_only("ทันใดนั้นมันก็เปิดจากด้านใน เราไม่ทันระวังและล้มลงไปกองกับพื้นภายในห้อง")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("โอ้ววว…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เมื่อมองขึ้นไปฉันเห็นใบหน้าที่คุ้นเคยและเย่อหยิ่ง")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael ถูกรายล้อมไปด้วยบอดี้การ์ดหลายคนและผู้ติดตามของเธอ โดยมีสีหน้าดูถูกเหยียดหยาม")
	await novel_interface.show_text_only("ว้าว ผู้หญิงที่สวยและเป็นผู้ใหญ่มากมาย!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("หืม? คุณไม่ใช่คนบ้าแต่งตัวข้ามเพศจากกองขยะในโรงเรียนเหรอ? คุณกำลังทำอะไรที่นี่?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("ในชุดเมดฝรั่งเศส! คุณยังรู้สึกในทางที่ผิดไม่พอใช่ไหม?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("ระ… ช่างบังเอิญจริงๆ! \\nฉันแค่ทำงานพาร์ทไทม์ที่นี่กับเพื่อนร่วมชั้น…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("อ้อ แล้ว… ห้องจัดเลี้ยงชั้นล่างใช่ไหมล่ะ? \\nเราอาจมาผิดที่", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ขออภัย Annie ฉันโกหกเก่งจังเลย!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("นั่นมันแปลกนะ รปภ.ไม่ได้ห้ามคุณเหรอ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ด้วยความสับสน Raphael มองลงไปที่ทางเดิน")
	await novel_interface.show_text_only("Raphael ตกใจมากเมื่อพบเจ้าหน้าที่รักษาความปลอดภัย ทุกคนล้มลงกับพื้น")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("—จับพวกมัน!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
