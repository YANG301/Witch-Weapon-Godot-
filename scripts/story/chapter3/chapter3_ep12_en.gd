# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("The Aerogel Spray is a hairspray-like weapon invented by Dr. Aya. It produces large amounts of foam in a split second.")
	await novel_interface.show_text_only("Once in the air, the foam will quickly inflate and solidify, becoming so hard that’s impenetrable even by bullets.")
	await novel_interface.show_text_only("As Annie seals the door with aerogel, I'm again attracted by the golden butterfly on the floor.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(It seems just a gorgeous artwork…)", "Lian")
	await novel_interface.show_dialog("(But... I can't help it... I really want to touch it...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A burning urge catches me, and everything in front of me gives out a dazzling glow. I can't help reaching out—")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Stop!! Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie grabs my wrist. Then I suddenly come to myself.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Maybe this thing can invade people's mind… Is that why they have to keep it in that suitcase?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ah! I almost... what on earth...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("This golden butterfly seems familiar… \\nI suspect this is a Witch's Shard.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("A Witch's Shard?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hmm, how should I put it…", "Annie")
	await novel_interface.show_dialog("Magical power is actually a kind of knowledge that a human's brain absorbs from a unique type of \"information\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("But people obtain and secure this knowledge usually at the cost of their sanity.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("The witches in the Substation and enemies in flux areas come into my mind.")
	await novel_interface.show_text_only("Their insanity must be caused by the over accumulation of \"knowledge\" that their body cannot stand.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("The \"information\" can actually be divided into pieces and stored separately. A Witch's Shard is a container of such small pieces of “information\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("As to the reason for this design, I guess it's created for humans to push their limits…", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("To figure out the extent to which they can get away with without losing their sanity, they use Witch's Shards to absorb knowledge little by little?", "Lian")
	await novel_interface.show_text_only("The act itself sounds crazy enough!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("To keep craving and pursuing new knowledge without end—if anything, that's human nature...", "Annie")
	await novel_interface.show_dialog("Even if they are doomed to destruction...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What if an ordinary girl gets the Witch's Shard, but hasn’t got the knack to use it \\nWill she become one of the witches we met in the Substation…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Very likely. And there's no shield around the Witch's Shard, so anyone can directly touch it.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Isn't it super dangerous then?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Boom! \\n—Boom!")
	await novel_interface.show_text_only("Outside the room come low and deep sounds of heavy hammering on the wood door.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("The security soldiers!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Crack!! \\nAfter just two hits, the door of the Royal Suite is smashed into pieces by a door breaker.")
	await novel_interface.show_text_only("—Thump! —Thump! —Thump! \\n—Thump! —Thump! —Thump!")
	await novel_interface.show_text_only("Then come the sounds of door breakers hitting the solid aerogel foam in vain.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Maybe it could hold on until Ms. Mariru arrives… \\nSee, Dr. Aya's invention works!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I touch my chest, where Mariru has the speaker planted without my knowledge.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Aha… \\nYeah, it works…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, Raphael now awake, hurls herself towards me, the chair still tied to her body.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Never… will you take anything away!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("You speaker-mounted pervert!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael breaks free as the chair hits the floor. Then she rushes to grasp the golden butterfly.")
	await novel_interface.show_text_only("Seeing this, I pounce towards the butterfly, almost about to crash into her—")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("No, Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_dialog("(Uh? Did I get it?) \\n(Oops…)", "Lian")
	await novel_interface.show_dialog("(The soft thing is…)", "Lian")
	await novel_interface.show_dialog("(It feels familiar. I just touched it)", "Lian")
	await novel_interface.show_dialog("(Wait. Could it be…!)", "Lian")
	await novel_interface.show_dialog("… You!", "Raphael")
	await novel_interface.show_dialog("Pervert!!!", "Raphael")
	await novel_interface.show_text_only("—Slap!")
	await novel_interface.show_text_only("The resounding slap makes me dizzy.")
	await novel_interface.show_text_only("Visual images flash through my mind, everything was muted in an instant.")
	await novel_interface.show_text_only("I feel like in another world. The strange feeling disappears in the blink of an eye.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("As I open my eyes, I find myself still in the Royal Suite.")
	await novel_interface.show_text_only("The golden accessory comes alive and lands on my chest, beaming a glistening light.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("How would this…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("When the light grows dimmer and gradually disappears, I feel my face gently caressed. That soft, magical touch is engraved on my mind.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("—Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In the open space of this room, a gorgeous woman appears.")
	await novel_interface.show_text_only("My eyes are fixated on her light-red eyes and hair, slim body, and jade-like skins.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… What happened?) \\n(My lips were touched by something!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Hahaha, nothing!) \\n(What was I thinking about? It's impossible!)", "Lian")
	await novel_interface.show_dialog("(No… not impossible!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Crap, the feeling… The feeling…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, the long-lost warmth of a human's body.", "Unexpected Woman")
	await novel_interface.show_dialog("Good evening, young ladies!", "Unexpected Woman")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My heart is beating faster. I can't help walking towards her. My limbs are no longer mine.")
	await novel_interface.show_text_only("I spread my arms and wrap them tightly around her, in full view of everyone.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Hello, sweetie. You don’t feel well, are you…?", "Unexpected Woman")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Excuse me…", "Lian")
	await novel_interface.show_dialog("May I know your name please…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("It's weird. Her body seems to get heavier and heavier… \\nAnd her temperature rising…")
	await novel_interface.show_text_only("What’s wrong with me!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ooh la la! \\nThis is so unbelievable.", "Unexpected Woman")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie drags me away from the woman.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Who… are you?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("If my name is not a taboo in your era… Please call me Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("What a beautiful name…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren… \\nYou start to look like a horndog!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
