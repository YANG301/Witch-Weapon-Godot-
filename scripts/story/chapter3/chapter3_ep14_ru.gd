# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Ударить администратора \\nElluka…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Позади него я вижу нескольких солдат охраны, лежащих на полу.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Они просто отключились. Убийства в демилитаризованной зоне не входят в мои планы.", "Jacob")
	await novel_interface.show_dialog("Я намеревался перевернуть страницы культовой классической «Книги семи философов» и не ожидал такого бонуса…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Книга семи философов…) \\n(Это Гримуар, связанный с Золотой Бабочкой?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Рен… Я нашел много старых ран на теле Elluka, когда помогал ей мыться.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Вы мыли Elluka?) \\n(Когда!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(Нет, дело не в этом.) \\n(Старые раны... Это значит...!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Ни один обычный ребенок не смог бы пережить такого травмирующего опыта!", "Annie")
	await novel_interface.show_dialog("Должно быть, это тот парень ..., вот он!!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("О— \\nПохоже, эта штука еще не сломалась.", "Jacob")
	await novel_interface.show_dialog("Да-да, я думаю, SID уже провел реверс-инжиниринг… \\nТехнологию, которую я при этом использовал.", "Jacob")
	await novel_interface.show_dialog("Если бы я знал, что это вызовет столько проблем, я бы установил на него устройство самоуничтожения.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Ты...!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Придурок!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Следующее, что я помню, это то, как Annie яростно подпрыгивает и пытается пнуть Jacob по лицу.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Писк—")
	await novel_interface.show_text_only("С визгом комнату освещает огромная электрическая дуга. На мгновение я ослеп.")
	await novel_interface.show_text_only("Чтобы блики исчезли, требуются секунды. В глазах застыла жгучая боль.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie…!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie теряет сознание и падает на землю. На ее коже появляется полоса ожогов в форме ветвей.")
	await novel_interface.show_text_only("Солдат рядом с Jacob держит дымящийся пистолет… Это то оружие, которое они только что использовали?")
	await novel_interface.show_text_only("Солдат быстро выбрасывает батарейную пулю размером с канистру.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Мы знаем, как извлечь максимальную выгоду из ведьм…", "Jacob")
	await novel_interface.show_dialog("Я предпочитаю поймать их живыми. Но скоро появится сука SID...", "Jacob")
	await novel_interface.show_dialog("Теперь, когда у нас заканчивается время…", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob достает кусок металла в форме пирога. Серовато-зеленая оболочка излучает знакомое светло-голубое сияние.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Это… оружие Substance H?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Я чувствую… поток магической силы…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Что, черт возьми, ты задумал? Это демилитаризованная зона!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Рен)", "Mariru")
	await novel_interface.show_text_only("В наушниках внезапно раздается голос Mariru.")
	await novel_interface.show_dialog("(Это ловушка из самосвязывающихся волокон.) \\n(Это несмертельное оружие Substance H.)", "Mariru")
	await novel_interface.show_dialog("(Он взрывается через три секунды после детонации.) \\n(И волокна разлетятся повсюду. Убежать невозможно.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Итак, поберегите пока силы.) \\n(Я придумаю, как вас вытащить…)", "Mariru")
	await novel_interface.show_text_only("Jacob медленно поднимает ловушку в правой руке. На его ладони появляются золотые линии, словно он готов к бою.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Его рука… это волшебная надпись?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Наконец… Моя очередь испытать оружие Substance H…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Извините за это…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice внезапно хватает меня одной рукой, а другой вырывает ожерелье у Raphael.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Что?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно изумрудный кулон испускает яркий луч и превращается в могучий меч с надписями на клинке.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Посмотрите на эти несчастные души, умоляющие очистить свои грехи –", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Что…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Заткнись!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice тяжело швыряет меч в пол.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob открывает рот, но ничего не говорит. \\nКомната наполнена гробовой тишиной.")
	await novel_interface.show_text_only("Пол под Jacob трескается, не открывая ничего, кроме полной темноты.")
	await novel_interface.show_text_only("Из глубины тьмы доносится жуткий звук, как будто миллионы людей скорбят и воют из ада.")
	await novel_interface.show_text_only("Темный дым вырывается из щели и охватывает каждый уголок комнаты, теперь в мгновение ока окутанной адской тьмой.")
	await novel_interface.show_text_only("Охваченный холодом до костей и глубоким чувством ужаса, мои волосы встают дыбом, и я не могу пошевелиться...")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Но всего через несколько секунд тьма рассеялась. \\nИ трещины нигде нет.")
	await novel_interface.show_text_only("Словно страдая от панической атаки, Jacob падает на пол и безумно царапает шею так сильно, что течет кровь.")
	await novel_interface.show_text_only("Его лицо краснеет, он изо всех сил пытается дышать. Но его легкие, кажется, лишены воздуха, и он напрасно шумно задыхается.")
	await novel_interface.show_text_only("Проходит некоторое время, прежде чем он вновь обретает слабое дыхание.")
	await novel_interface.show_text_only("Высокий, хорошо сложенный мужчина, дрожа, свернулся калачиком на ковре, скрестив руки на груди.")
	await novel_interface.show_text_only("Его налитые кровью глаза полны страха. Слезы выходят в результате декомпрессии.")
	await novel_interface.show_text_only("Линии на его руке полностью исчезли, и мина-ловушка, упавшая на ковер, тоже потеряла свой блеск.")
	await novel_interface.show_text_only("Солдаты в масках стоят неподвижно и дрожат.")
	await novel_interface.show_text_only("Судя по их пустым лицам, их, кажется, охватывает ужас от того, что они видят реальность, не поддающуюся никакому описанию.")
	await novel_interface.show_text_only("Если долго смотреть в бездну, бездна тоже всмотрится в тебя…")
	await novel_interface.show_text_only("Перед лицом настоящего ужаса даже вздохнуть…")
	await novel_interface.show_text_only("Заставляет вас чувствовать себя подверженным неописуемому отчаянию.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Поехали!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Рен, уходи оттуда!)", "Mariru")
	await novel_interface.show_text_only("Только сейчас я пришел в себя. Кивнув Beatrice, я выхожу из комнаты с Annie на руках.")
	await novel_interface.show_text_only("Beatrice тащит Raphael, который все еще находится в оцепенении. Бежим к лифту…")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
