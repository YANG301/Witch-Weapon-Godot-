# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Chúng tôi bị bao vây bởi vệ sĩ của Raphael. Annie nháy mắt với tôi—")
	await novel_interface.show_text_only("Tôi hiểu ý cô ấy ngay lập tức và giải phóng toàn bộ áp lực mà cô ấy đã thu thập được khi chúng tôi ở hành lang.")
	await novel_interface.show_text_only("Đột nhiên, hàng trăm quả bóng chày bắn ra, trúng một anh chàng và ngay lập tức nảy về phía người khác.")
	await novel_interface.show_text_only("Rõ ràng là chưa từng nhìn thấy điều này trước đây, các vệ sĩ hoảng sợ và lần lượt bị đánh gục.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Tôi chưa bao giờ sử dụng thủ thuật này với người bình thường trước đây. Nó hoạt động rất tốt…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Tất nhiên! Con người tỉnh táo dễ đối phó hơn nhiều so với phù thủy điên rồ!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Bắn! Đồ ngốc…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Sao ngươi dám, kẻ gây rối! Những người lính an ninh sẽ không thả bạn ra!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi chỉ để ý rằng sau trận chiến, Royal Suite của Raphael đã trở thành một mớ hỗn độn, các vệ sĩ của cô ấy nằm khắp sàn.")
	await novel_interface.show_text_only("Annie và tôi chỉ muốn lẻn vào và thu thập bằng chứng, nhưng có vẻ như chúng tôi đã gây ra một thảm họa ngoại giao nghiêm trọng…")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Tệ thật… Annie! \\nC… cố lên! Hãy trói cô ấy lại!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trong cơn hoảng loạn, tôi đưa ra cho Annie một chỉ dẫn điên rồ.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Vâng! Sẽ làm được!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie nhanh chóng hạ Raphael xuống, xé toạc tấm màn rơi trên mặt đất trong trận chiến, và cùng với nó, nhanh chóng trói cô gái đang vùng vẫy lại.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Sao cậu dám—!! \\nĐồ biến thái ăn mặc khác giới! Bạn muốn gì ở tôi?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bây giờ, Raphael, vị khách danh dự của bang New Opulentia, cháu gái của thị trưởng Thành phố Học viện thứ tư, đang bị trói vào một chiếc ghế trong phòng riêng của cô ấy—")
	await novel_interface.show_text_only("Annie thực sự giỏi về khoản này!! \\nVà có vẻ như tôi không bao giờ thoát khỏi được cái tiếng là kẻ biến thái…")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Tôi thực sự xin lỗi về điều này, nhưng chúng tôi phải đảm bảo rằng bạn sẽ không kích hoạt báo động…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi chỉ vào một nút màu đỏ trên tường. Sau khi nhấn nút, một đội lính an ninh được trang bị vũ khí mạnh sẽ bao vây căn phòng trong vòng 3 phút.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hừm, vậy bạn muốn gì?", "Raphael")
	await novel_interface.show_dialog("Bạn không che giấu danh tính của mình và dường như bạn không có kế hoạch sơ tán— \\nĐây không phải là một vụ bắt cóc đòi tiền chuộc, phải không?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ngay cả khi bị trói vào ghế, Raphael trông vẫn tự tin và suy nghĩ chín chắn… Thật là một quý cô quý phái.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Bạn là ai? \\nBạn vừa sử dụng Substance H Vũ khí phải không?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Lời nói của cô ấy nhắc nhở tôi về nhiệm vụ ưu tiên của tôi lúc này.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Cô Raphael, chúng tôi chỉ muốn tìm hiểu một điều. \\nĐó là về chiếc vali đó…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hành lý gì?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael có vẻ bối rối và dường như không biết tôi đã nói gì.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Có vẻ như… nó đã hỏng rồi!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Cái gì?! Tôi nghĩ hợp kim phải rất chắc chắn!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tôi nhìn theo hướng Annie đang chỉ và thấy chiếc vali, giờ đã bị vỡ với những lỗ thủng lớn do những quả bóng chày đang bắn để lại.")
	await novel_interface.show_text_only("Lớp vỏ nhựa màu đen của vali bị vỡ vụn, lộ ra một lớp kim loại phát ra ánh sáng xanh nhạt.")
	await novel_interface.show_text_only("Nhựa là một loại vỏ có thể tháo rời phổ biến. Annie chắc hẳn đã vô tình để ý đến lớp bên trong của vali.")
	await novel_interface.show_text_only("Ổ khóa bị phá hủy, các bộ phận và mảnh kim loại vương vãi trên thảm.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Thật kỳ lạ—quả bóng chày của tôi chỉ nhắm vào mục tiêu sống…", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael dường như cũng đã chú ý đến vật liệu phát ra ánh sáng xanh. Cô ấy trông ngạc nhiên và lo lắng.")
	await novel_interface.show_text_only("Giữa đống bọt chống sốc và những mảnh kim loại nằm rải rác, tôi nhìn thấy một thứ nhỏ lấp lánh.")
	await novel_interface.show_text_only("Đó là một phụ kiện vàng hình con bướm. Với những đường cắt tinh tế trên cánh, nó trông giống như một con bướm thật.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Phải chăng thứ này… đã thu hút những quả bóng chày của bạn nhắm vào chiếc vali?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hãy coi chừng! Đó có thể là Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Con bướm vàng sống động như thật dường như sẵn sàng bay bất cứ lúc nào. Ngay cả Raphael cũng bị mê hoặc. Tôi không thể không tiếp cận…")
	await novel_interface.show_dialog("Này, đồ ngốc. \\nTôi đã nói đừng chạm vào nó—", "Mariru")
	await novel_interface.show_text_only("Giọng nói của Mariru không biết từ đâu vang lên. Đâu đó trong cơ thể tôi chợt cảm thấy ù ù. Có cảm giác như cô ấy đang nói chuyện bên cạnh tôi.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ờ? \\n… Đó là cái gì vậy!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi dò xét xung quanh cơ thể mình, hy vọng tìm ra giọng nói đó đến từ đâu và đảm bảo rằng tôi không nhìn thấy bất kỳ chiếc loa nào ở đâu đó.")
	await novel_interface.show_dialog("Nếu quả bóng chày của Annie có thể để lại một lỗ sâu như vậy trên hợp kim có độ cứng Rockwell là 70 thì đầu của các vệ sĩ sẽ bị đập nát thành bùn.", "Mariru")
	await novel_interface.show_dialog("Có nhiều khả năng là thiết bị nhỏ này chỉ muốn sử dụng cú sốc của quả bóng chày để nổ ra…", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Những cái lỗ đó… do chính phụ kiện đó để lại?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uh-huh, rất có thể. Vậy bạn còn muốn chạm vào thứ nguy hiểm như vậy không?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Đợi đã, vấn đề là— \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chết tiệt! Tôi đã tìm ra nguồn gốc giọng nói của cô ấy!")
	await novel_interface.show_text_only("Nó ở ngay từ ngực tôi! Thảo nào cơ thể tôi lại cảm thấy ù ù mỗi khi cô ấy nói…")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Làm sao bạn có thể cấy một con chip vào cơ thể tôi!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Bạn vừa tình cờ tiết lộ công nghệ bí mật của chúng tôi cho người nước ngoài! Muốn bị đóng dấu lần nữa à?", "Mariru")
	await novel_interface.show_dialog("Annie, cho tiểu thư ngủ một lát đi! \\nNhưng hãy cẩn thận. Đừng làm tổn thương vị khách danh dự của chúng ta.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Này! Bạn không dám—!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie khéo léo ném một con dao vào gáy Raphael, khiến cô ấy bất tỉnh.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Cô Mariru, Substance H bị cấm vào New Opulentia nếu không có sự chấp thuận chính thức, phải không?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tất nhiên! Hừm, họ lén lút đưa thứ này vào dưới mũi tôi! Tiến sĩ Dekkers sẽ phải giải thích điều này trước Thượng viện.", "Mariru")
	await novel_interface.show_dialog("… Đợi đã! Tôi nghĩ các nhân viên bảo vệ bên ngoài đã thu hút được sự chú ý.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hừ, nhanh thật đấy.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lính an ninh ở tầng dưới đang tập trung ở sảnh. \\nTôi đang nhờ Nhóm Thu thập giúp bạn. Chúng tôi sẽ đến trong 8 phút nữa.", "Mariru")
	await novel_interface.show_dialog("Annie, bịt kín cửa bằng aerogel ngay.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Vâng, thưa bà!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
