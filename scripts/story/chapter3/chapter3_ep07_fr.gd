# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Cela fait deux jours que Mariru m'a confié cette tâche.")
	await novel_interface.show_text_only("Hier soir, la délégation « Échange culturel » est enfin arrivée au rapport New Opulentia International Ai.")
	await novel_interface.show_text_only("Alors… Ma mission est sur le point de commencer.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Mais j'essaie de soutirer des informations à cette fille ..., je ne sais pas.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Quoi qu'il en soit, ce n'est pas une fille ordinaire. Et si elle refuse de me parler ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Regardez la fille là-bas ! Elle ne porte pas notre uniforme scolaire.", "Étudiant 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Et celle à côté d'elle ressemble à une servante ... Est-ce une sorte de princesse ?", "Étudiant 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je regarde et vois une fille mince dans un manteau vert. \\nElle se tient devant la pelouse.")
	await novel_interface.show_text_only("La cible de ma mission – Raphael Dekkers.")
	await novel_interface.show_text_only("J'ai vu le directeur adjoint et la fanfare attendre devant la porte de l'école à l'instant. Est-ce qu'elle s'est faufilée sur le campus ?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Mademoiselle, par ici s'il vous plaît.", "Suite")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Ce bâtiment scolaire est conçu dans le style Tudor de l’âge d’or.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Mais l’atrium est trop exigu pour donner une impression de grandeur.", "Raphael")
	await novel_interface.show_dialog("Et la sculpture sur la plinthe est trop maladroite pour soutenir la structure et le design.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Mademoiselle, quel goût extraordinaire vous avez pour l'art !", "Suite")
	await novel_interface.show_dialog("Une architecture Tudor comme celle-ci devrait avoir un atrium plus haut.", "Suite")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non, vous ne comprenez pas. \\nUne simple augmentation de la hauteur ne fonctionnerait pas.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Vous avez parfaitement raison, mademoiselle. La pelouse devrait également être agrandie.", "Suite")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein ? Cela semblerait simplement mal coordonné. \\nToute la cour avant est déjà encombrée après tout…", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Bien sûr. Miss Raphael n'appellerait même pas ce terrain désorganisé une cour avant, n'est-ce pas ?", "Suite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael semble quelque peu insatisfait de ces mots.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… Non, ce n'est pas ce à quoi je pense.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Ah ! \\nComme c'est gentil de votre part, Mademoiselle Raphael !", "Suite")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Pourquoi son assistante ne voit-elle pas que son sourire est déjà raide ?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Hé, espèce de maniaque du travestissement.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Quoi ?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Le travesti ... est-ce qu'elle parle de moi ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A ses mots, tout le monde se tourne vers moi.")
	await novel_interface.show_text_only("Je n’avais pas l’habitude d’avoir autant d’yeux rivés sur moi, je me sens rougir.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Non, je suis… je ne suis pas… ! \\n(Mariru m'a fait porter l'uniforme !)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Soyez un homme et admettez-le, voulez-vous ?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Je ne savais pas que New Opulentia était si libéral qu'un pervers comme toi pouvait être admis dans une école de filles.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, j'ai changé d'avis ! Je ne veux pas faire ça !")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Euh… Ren est notre camarade de classe. C'est une fille !", "Étudiant 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Quoi ? \\nArrêtez de vous moquer de moi.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael a l'air offensée.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Elle ne plaisante pas ! Nous pouvons tous vous l'assurer. \\nRen est absolument une fille.", "Étudiant 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Merci d'avoir parlé pour moi. Mais je ne suis définitivement pas une fille.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, je pensais que tu étais un garçon.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Pourquoi ! Je ne ressemble en rien à un garçon ! \\n(Oh, non…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh… C'est nul de trahir l'ancien moi…")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Très bien. Oublie ça.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Que pensez-vous de l'architecture de votre école ?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je n'ai aucune idée de l'architecture. Si vous insistez…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Dites simplement ce qui vous passe par la tête.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Euh ... en tant que bâtiment scolaire, l'atrium n'est pas trop bas.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Le bâtiment n'est pas agréable à regarder… peut-être parce qu'il n'est… pas assez mignon ?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Honteux de mon pauvre vocabulaire, j'essaie de saisir l'expression du visage de Raphael.")
	await novel_interface.show_text_only("Comme prévu, elle sourit avec mépris.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Mignon ? Je n'en crois pas mes oreilles. Est-ce que ce mot est tout ce que vous pouvez trouver pour décrire une architecture ?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh bien, c'est exactement ce que j'en ressens !", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Je veux dire, ce serait peut-être mieux… Si les arbres ne sont pas parfaitement alignés…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Euh… \\nComme, euh…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh… pourquoi dois-je répondre à cette question ?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Essayez-vous de dire que les arbres devraient être disposés en alternance pour ajouter plus de profondeur au design ?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactement. \\n(Qu'est-ce qu'elle vient de dire ?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael m'a finalement fait un léger sourire.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ah, un pervers vaut bien mieux qu'un béni-oui-oui !", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Non, je ne le suis pas…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Mademoiselle…", "Suite")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Laissez-nous. Attends-moi à l'extérieur de l'école.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Vous êtes Ren, n'est-ce pas ? Allons-y. Montre-moi ta formidable école, veux-tu ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Hein… ? \\nO... D'accord !", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
