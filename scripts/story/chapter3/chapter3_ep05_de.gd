# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru schickt Annie und Elluka weg, gerade als wir zum Hauptquartier zurückkehren.")
	await novel_interface.show_text_only("Jetzt bin ich verärgert. Ich weiß nicht, ob ich noch einmal mit seltsamen Fragen verhört werden würde ...")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("Was ist passiert?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Was ist, wenn nichts passiert? Wirst du Elluka weiterhin wie ein Perverser angrinsen?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Du... Du musst mich durch die Überwachungskamera beobachtet haben!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Hehe, ist das alles, was dir einfällt?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was könnte es sonst sein...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Zum Beispiel –", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru schaut mich von Kopf bis Fuß böse an.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Die Forschungsabteilung hat einen Wafer entwickelt, der sogar entscheiden kann, wann Sie auf die Toilette gehen!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("Was... Badezimmer? \\nUgh, klingt ekelhaft!", "Lian")
	await novel_interface.show_dialog("Es muss von Aya erfunden worden sein! \\nWarte, erzähl mir nicht, dass du es mir heimlich implantiert hast!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ich habe nur Spaß gemacht.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Die Art, wie du es sagst, ist kein Scherz!")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Oder... Gibt es etwas Seltsames, das Ihnen in den Sinn kommt?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Ugh, verdammt noch mal ...", "Lian")
	await novel_interface.show_dialog("(Das letzte Mal, als ich die Läufe während der Schulversammlung hatte…) \\n(Bedeutet das…?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hahahaha! Nimm es nicht ernst!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru lacht laut und reibt mir heftig den Kopf.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya hat nur einen Prototyp gemacht, bevor ich das Projekt abgebrochen habe. \\nWarum sollten wir es bei einem Niemand wie dir anwenden?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Oh, soll ich Danke sagen?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha, du hast doch Dreck im Kopf, oder?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh... Gott sei Dank gibt es keine Gedankenlesemaschine! Denken Sie nur daran, wie beschämend das wäre!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Hey, vermassle es nicht. Es macht so viel Spaß zu sehen, wie du dich wehrst.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Tut mir leid, dass ich Sie im Stich gelassen habe.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm ... ich frage mich, wie ein Einfaltspinsel wie Sie Informationen von wichtigen Zielen herausbekommen könnte.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru wischt sich die Tränen vor Lachen weg und setzt ihr gewohnt arrogantes Gesicht auf.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Hauptziele … Klingt für Sie bedeutungsvoller als die Bewirtung … Aber warum sollte Mr. Big mit einem High-School-Schüler reden?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Diesmal kommen Sie als Student Ihrem Ziel näher. Das Ziel…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, Enkelin des Bürgermeisters von Salmonton. Sie wird mit der Salmonton-Delegation kommen.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Sie ist ein wirklich hochgeborenes Mädchen. Aufgeregt?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Warum sollte ich aufgeregt sein?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut-tut, du stehst nur auf kleine Mädchen, oder?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Hey, hör auf, mich als Verbrecher zu bezeichnen!", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Ähm. \\nWie auch immer, was soll ich von diesem hochgeborenen Mädchen bekommen?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Uff, du bist kein großer Redner ... \\nIch hoffe, du schaffst es, wenigstens einen Tag durchzukommen.", "Mariru")
	await novel_interface.show_dialog("Okay, im Ernst, was wissen Sie über Salmonton?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Ähm ... ich schätze, es ist der größte Lebensmittelexporteur?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Apropos Salmonton … Mir fallen da Dutzende Hochhausgewächshäuser ein, die den Rhein säumen.")
	await novel_interface.show_text_only("Die grünen Gärten hinter Gewächshäusern ... \\nImmer perfekte Tapeten.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("Und es gibt viele Kirchen. Alle Bürger haben einen religiösen Glauben. Sie haben sogar eine Heilige Allianz gegründet …", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das ist alles, woran ich mich erinnern kann. Ich bin nicht gut in Geographie. Zu viel Auswendiglernen zufälliger Fakten.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Die wirtschaftliche und politische Macht von Salmonton hängt weitgehend von seiner Kontrolle über Nutzpflanzengene ab.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Doch Vorfälle nach dem Verschwinden des Ross-Kelchs stellten eine ernsthafte Bedrohung für sie dar.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mit Bedrohungen meinen Sie... den Raumzeitfluss?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Das ist richtig. Nach meinen Informationen hat es unter mehreren Flussmitteln gelitten. Der Schaden ist jedoch noch unbekannt.", "Mariru")
	await novel_interface.show_dialog("Gemessen an der jüngsten Volatilität der Preise für Getreide-Futures scheinen die Auswirkungen ziemlich groß zu sein … Möglicherweise kommt es zu sporadischen Hungersnöten.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Das ist schwerwiegend!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich weiß nichts über den Terminmarkt. Ich dachte, die Auswirkungen wären auf einen kleinen Bereich beschränkt.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Ja... Ernteausfälle werden keinen unmittelbaren Schaden anrichten. Länder verfügen ohnehin über Risikoreserven.", "Mariru")
	await novel_interface.show_dialog("Scheint, als wäre Salmonton von allen Akademiestädten die erste, die zusammenbricht.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Es hat eine Delegation nach New Opulentia entsandt, die bereits unterwegs ist.", "Mariru")
	await novel_interface.show_dialog("Als ihr größter Lebensmittelimporteur können wir nicht nein sagen.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Werden sie… Annie und mich verdächtigen?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Das ist es, was Sie tun werden.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Was?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Obwohl es sich um ein „Kulturaustausch“-Programm handelt, steht die Delegation unter strengem Schutz des Royal Security Service.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Der Royal Security Service… Der Geheimdienst von Salmonton, auch bekannt als Rosenkreutz.")
	await novel_interface.show_text_only("Für einen Geheimdienst ist es dank der Agent-Nr.-7-Filme zu berühmt.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wird es einige Probleme verursachen?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Natürlich. SID hat sogar Schwierigkeiten, Hintergrundinformationen zu sammeln.", "Mariru")
	await novel_interface.show_dialog("Was für Sie bisher relevant ist, ist, dass das Mädchen die Gosakuragawa Girls' High School besuchen wird.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Meine Schule?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("Das ist zu erwarten. Sie ist ungefähr im Alter einer Oberstufenschülerin.", "Mariru")
	await novel_interface.show_dialog("Sie müssen also den wahren Zweck ihres Besuchs herausfinden.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Die Geheimdienste haben eine Broschüre über Salmonton und die Dekkers-Familie erstellt. Nun los und lesen Sie es durch.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Ups, schon wieder eine Auswendiglernaufgabe ... \\nIch kümmere mich darum!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Passen Sie übrigens auf dem Heimweg auf den Perversen auf.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("W-Was!?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
