# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Wir sind von den Leibwächtern von Raphael umgeben. Annie zwinkert mir zu –")
	await novel_interface.show_text_only("Ich verstehe sofort, was sie meint, und lasse all die Druckkraft ab, die sie gesammelt hat, als wir im Korridor waren.")
	await novel_interface.show_text_only("Plötzlich schießen Hunderte von Baseballbällen heraus, treffen einen Kerl und prallen sofort auf einen anderen zu.")
	await novel_interface.show_text_only("Da sie das offensichtlich noch nie gesehen haben, geraten die Leibwächter in Panik und werden einer nach dem anderen niedergeschlagen.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ich habe diesen Trick noch nie bei gewöhnlichen Menschen angewendet. Es funktioniert so gut…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Natürlich! Mit vernünftigen Menschen ist es viel einfacher, mit verrückten Hexen umzugehen!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Schießen! Ihr Idioten...", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Wie könnt ihr es wagen, Unruhestifter! Die Sicherheitskräfte lassen Sie nicht im Stich!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mir fällt gerade auf, dass nach dem Kampf in der königlichen Suite von Raphael ein völliges Chaos herrscht und ihre Leibwächter überall auf dem Boden liegen.")
	await novel_interface.show_text_only("Annie und ich wollten uns nur einschleichen und Beweise sammeln, aber wir scheinen eine schwere diplomatische Katastrophe verursacht zu haben …")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mist… Annie! \\nC… komm schon! Binde sie fest!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In Panik gebe ich Annie eine verrückte Anweisung.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ja! Wird tun!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie nimmt Raphael geschickt herunter, schneidet einen Vorhang auf, der während des Kampfes auf den Boden gefallen ist, und fesselt damit schnell das kämpfende Mädchen.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Wie kannst du es wagen –!! \\nDu Cross-Dressing-Perverser! Was willst du von mir?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jetzt ist Raphael, der Ehrengast des Staates in New Opulentia, Enkelin des Bürgermeisters der Fourth Academy City, an einen Stuhl in ihrer eigenen Suite gefesselt –")
	await novel_interface.show_text_only("Annie ist wirklich gut darin!! \\nUnd es sieht so aus, als würde ich den Ruf als Perverser nie loswerden ...")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Es tut mir wirklich leid, aber wir müssen sicherstellen, dass Sie keinen Alarm auslösen ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich zeige auf einen roten Knopf an der Wand. Sobald die Taste gedrückt wird, wird innerhalb von 3 Minuten ein Team schwerbewaffneter Sicherheitssoldaten den Raum umstellen.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, also was willst du?", "Raphael")
	await novel_interface.show_dialog("Sie verheimlichen Ihre Identität nicht und scheinen keinen Evakuierungsplan zu haben – \\nDas ist keine Entführung zur Erpressung von Lösegeld, oder?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Selbst wenn sie an einen Stuhl gefesselt ist, sieht Raphael immer noch selbstbewusst aus und denkt klar ... Was für eine edle Dame.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("Wer bist du? \\nHaben Sie gerade Substance H Waffen verwendet?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ihre Worte erinnern mich an meine momentan vorrangige Aufgabe.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Frau Raphael, wir wollen nur eines herausfinden. \\nEs geht um diesen Koffer…", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Welcher Koffer?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael sieht verwirrt aus und scheint keine Ahnung zu haben, was ich gesagt habe.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Sieht so aus, als wäre es schon kaputt!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Was?! Ich dachte, die Legierung sollte sehr robust sein!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich schaue, wohin Annie zeigt, und sehe den Koffer, der jetzt mit riesigen Löchern zerbrochen ist, die die schießenden Baseballbälle hinterlassen haben.")
	await novel_interface.show_text_only("Die schwarze Plastikhülle des Koffers ist zersplittert und gibt eine Metallschicht frei, die blassblaues Licht ausstrahlt.")
	await novel_interface.show_text_only("Der Kunststoff ist eine übliche abnehmbare Abdeckung. Annie muss zufällig die Innenschicht des Koffers bemerkt haben.")
	await novel_interface.show_text_only("Das Schloss wird zerstört, die Einzelteile und Metallteile verstreuen sich auf dem Teppich.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es ist seltsam – meine Baseballbälle zielen nur auf lebende Ziele …", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael scheint auch das Material bemerkt zu haben, das blaues Licht ausstrahlt. Sie sieht überrascht und nervös aus.")
	await novel_interface.show_text_only("Inmitten der verstreuten stoßfesten Schaumstoffe und Metallteile sehe ich ein kleines glitzerndes Ding.")
	await novel_interface.show_text_only("Es ist ein schmetterlingsförmiges goldenes Accessoire. Mit zarten Ausschnittmustern auf den Flügeln sieht es aus wie ein echter Schmetterling.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("Könnte es dieses Ding sein, das Ihre Baseballbälle dazu gebracht hat, auf den Koffer zu zielen?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Achtung! Es könnte ein Substance H sein –", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Der lebensechte goldene Schmetterling scheint jederzeit flugbereit zu sein. Sogar Raphael ist fasziniert. Ich kann nicht anders, als Kontakt aufzunehmen ...")
	await novel_interface.show_dialog("Hey, Idiot. \\nIch sagte, fass es nicht an—", "Mariru")
	await novel_interface.show_text_only("Die Stimme von Mariru kommt aus dem Nichts. Irgendwo in meinem Körper spürt man plötzlich ein Summen. Es fühlt sich an, als würde sie neben mir sprechen.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Äh? \\n… Was ist das!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich suche meinen Körper ab, in der Hoffnung herauszufinden, woher die Stimme kam, und sicherzustellen, dass ich nicht irgendwo einen Lautsprecher sehe.")
	await novel_interface.show_dialog("Wenn der Baseball von Annie ein so tiefes Loch in der Legierung mit einer Rockwell-Härte von 70 hinterlassen könnte, wären die Köpfe der Leibwächter zu Schlamm zerschmettert worden.", "Mariru")
	await novel_interface.show_dialog("Es ist wahrscheinlicher, dass das kleine Gerät nur die Erschütterungen der Baseballbälle nutzen wollte, um auszubrechen …", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Diese Löcher... wurden vom Zubehör selbst hinterlassen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Äh-huh, sehr wahrscheinlich. Willst du also immer noch so ein gefährliches Ding anfassen?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Moment, das Problem ist – \\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Verdammt! Ich finde die Quelle ihrer Stimme!")
	await novel_interface.show_text_only("Es kommt direkt aus meiner Brust! Kein Wunder, dass mein Körper jedes Mal brummt, wenn sie spricht ...")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("Wie konntest du einen Chip in meinen Körper pflanzen!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sie haben gerade beiläufig einem Ausländer unsere geheime Technologie verraten! Willst du wieder abgestempelt werden?", "Mariru")
	await novel_interface.show_dialog("Annie, lass die Dame eine Weile schlafen! \\nAber sei vorsichtig. Tun Sie unserem Ehrengast nicht weh.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Hey! Wagen Sie es nicht –!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie wirft gekonnt eine Messerhand in den Nacken von Raphael, wodurch sie ohnmächtig wird.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Es ist Frau Mariru, Substance H verboten, New Opulentia ohne behördliche Genehmigung zu betreten, nicht wahr?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Natürlich! Humph, das haben sie mir vor die Nase geschmuggelt! Dr. Dekkers muss dies dem Senat erklären.", "Mariru")
	await novel_interface.show_dialog("… Warte! Ich denke, die Sicherheitsleute draußen haben einige Aufmerksamkeit erregt.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Huch, das ist schnell.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Unten in der Lobby versammeln sich Sicherheitskräfte. \\nIch nehme das Inkassoteam mit, um Ihnen zu helfen. Wir kommen in 8 Minuten an.", "Mariru")
	await novel_interface.show_dialog("Annie, jetzt die Tür mit Aerogelen abdichten.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Ja, gnädige Frau!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
