# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Dank Skurd scheint Fabella beschlossen zu haben, mich gehen zu lassen.")
	await novel_interface.show_text_only("Gerade als Skurd sich abwendet, kommen mehrere gut gekleidete Gäste auf sie zu und reden mit ihr.")
	await novel_interface.show_text_only("Das Mädchen ist ungefähr im gleichen Alter wie Elluka, aber sie glänzt bei so einem schicken gesellschaftlichen Anlass …")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Stammt sie aus einer Adelsfamilie?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als Fabella ihre Aufmerksamkeit ihrem Meister zuwendet, schleiche ich mich auf die andere Seite des Bankettsaals.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Das macht mich wahnsinnig ... \\nDas kleine Herrchen und seine Dienerin, nicht wahr?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Scheint, als würde mich das Dienstmädchen nicht festnageln. \\nWollte sie mich nur austricksen?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, du bist hier!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Vielleicht bin ich auf einen wichtigen Hinweis gestoßen!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Äh?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Gerade eben folgte ich der Delegation heimlich in die Chefetage und sah dort das Gefolge von Raphael, das einen besonderen Koffer trug.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Ein Koffer... Was ist drin?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Keine Ahnung. Aber ich erinnere mich, dass in der SID-Schulung das im Koffer verwendete Material erwähnt wurde!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Es ist ein graugrünes Metall mit einem eigenartigen hellblauen Glanz –", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Hellblauer Glanz… \\nWas! Ist es nicht...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ich erinnere mich an eine Legierung, die die Wirkung von Psychopharmaka und Meme Substance H reduziert oder beseitigt…")
	await novel_interface.show_text_only("Substance H Behälter aus dieser Legierung können sich den meisten Farbtonscans entziehen.")
	await novel_interface.show_text_only("Die Legierung selbst ist ein Substance H – 98 % davon sind bekannte Metalle und die restlichen 2 % sind unbekannte Substanzen.")
	await novel_interface.show_text_only("Aufgrund seiner Knappheit ist sein Preis auf dem Schwarzmarkt in die Höhe geschossen.")
	await novel_interface.show_text_only("Ich bin mir fast sicher, dass das Zeug in diesem Koffer etwas mit Substance H zu tun hat.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Heilige Scheiße! \\nHaben Sie dies Mariru gemeldet?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Die Salmonton-Delegation hat dem Senat nicht mitgeteilt, dass sie Substance H mitbringen würde.")
	await novel_interface.show_text_only("Jedes zerstörerische Substance H, das in das schützende Kraftfeld geschmuggelt wird, kann für New Opulentia eine Katastrophe bedeuten.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Ich habe es ihr sofort gesagt. Sie muss gerade einen Durchsuchungsbefehl beim Senat beantragen.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aber ich habe es nur auf den ersten Blick gesehen und keine Fotos gemacht. \\nIch glaube nicht, dass sie ohne weitere Beweise in den Raum einbrechen können ...", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Aus diesem Grund hat Mariru gerade unsere Mission auf „Beweise so schnell wie möglich sichern und hochladen“ aktualisiert.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Wenn ja, besteht die einzige Chance darin, sich in ihre Zimmer zu schleichen ...", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja... das Zimmer des Mädchens. Keine leichte Aufgabe.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm ... Wir müssen es jetzt nach Gehör spielen.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("Die Chefetage ist der Delegation vorbehalten. Wir gelangen dort über den Lastenaufzug.")
	await novel_interface.show_text_only("Ich schiebe den „geliehenen“ Servierwagen in Richtung des streng bewachten Korridors. Darunter verbirgt sich Annie…")
	await novel_interface.show_dialog("Hey! Sollten Sie nicht beim Bankett unten sein? \\nSie sind hier nicht erlaubt. Geh jetzt.", "Sicherheit")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(So viele Sicherheitsleute, tatsächlich …)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Hä? Aber ein Gast aus der Royal Suite hat gerade vom Zimmerservice Foie Gras mit flammendem Whiskey bestellt!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der Anführer sieht überhaupt nicht beeindruckt aus.")
	await novel_interface.show_text_only("Offensichtlich habe ich ihn unterschätzt. Ich muss einen anderen Weg finden ...")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Äh... Vielleicht hat der Zimmerservice einen Fehler gemacht. Es tut mir leid, Sir...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe kaum zu Ende gesprochen, als Annie herausstürmt und sich mit dem Baseballschläger auf den Hals schlägt.")
	await novel_interface.show_text_only("Dann dreht sie sich um und schleudert einen Baseball direkt ins Gesicht eines anderen Wachmanns, der 10 Meter entfernt ist.")
	await novel_interface.show_text_only("Der verbleibende Wachmann ist von dem Angriff sprachlos. Bevor er seinen Transceiver erreichen kann, tritt ihm Annie direkt gegen das Kinn.")
	await novel_interface.show_text_only("Drei Männer brechen fast gleichzeitig zusammen. Der Schläger springt auf den Boden und springt zurück zu Annies Hand.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Klar!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Was... Was hast du gemacht?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Nichts. Lassen Sie sie einfach eine Weile ruhen.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, das ist so Annie… \\n(Gott sei Dank, ich bin bei ihr…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Und sie benutzte nicht einmal Magie! \\nWelche Art von Ausbildung erhält sie?")
	await novel_interface.show_text_only("Nachdem ich die Wachen aus dem Weg geräumt habe, bringt mich Annie zu der Suite mit Doppeltür am Ende des Korridors.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Hier.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir tauschen einen Blick aus. \\nGerade als wir unsere Ohren an die Tür pressen wollen ...")
	await novel_interface.show_text_only("Es öffnet sich plötzlich von innen. Wir werden überrascht und fallen im Raum zu Boden.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Aua…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich aufblicke, sehe ich ein bekanntes, arrogantes Gesicht.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael ist von mehreren Leibwächtern und ihrem Gefolge umgeben und trägt einen verächtlichen Gesichtsausdruck.")
	await novel_interface.show_text_only("Wow, so viele reife und hübsche Damen!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hm? Bist du nicht der Cross-Dressing-Freak aus dieser Schulbude? Was machst du hier?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("In französischen Dienstmädchen-Outfits! Fühlen Sie sich nicht pervers genug?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("W... was für ein Zufall! \\nIch arbeite hier nur Teilzeit mit meinem Klassenkameraden ...", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, und ... der Bankettsaal unten, oder? \\nVielleicht sind wir am falschen Ort gelandet.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tut mir leid, Annie, ich kann nicht lügen!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Das ist seltsam. Haben Sie die Sicherheitskräfte nicht aufgehalten?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Verwirrt schaut Raphael den Korridor entlang.")
	await novel_interface.show_text_only("Raphael ist entsetzt, als sie die Sicherheitsleute bewusstlos auf dem Boden vorfindet.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("– Fang sie!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
