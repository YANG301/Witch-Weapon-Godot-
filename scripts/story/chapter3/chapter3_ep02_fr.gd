# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Les enregistrements SID montrent que le Centre Akatraz collecte la classe EX Substance H dont les tests et les recherches sont interdits par le Congrès uni.")
	await novel_interface.show_text_only("Sous le sol du Centre, il est relié à l'entrée d'une ancienne relique de Chate Cave-House dont l'entrée est interdite et ne peut même pas être évaluée.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Classe EX Substance H… Est-ce une sorte de substance très dangereuse ?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("La plupart d’entre eux sont des objets sacrés ayant une signification religieuse. Comme ils sont réservés aux adeptes de la religion, ils peuvent être collectés, mais la recherche est interdite.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cela ressemble à une auto-tromperie.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Hah, j'ai ressenti la même chose. \\nMais, d'une certaine manière, cela a du sens.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("On dit que certains artefacts religieux possèdent le pouvoir de tuer Dieu ou de déclencher le Jugement dernier.", "Mariru")
	await novel_interface.show_dialog("Une fois activés, ils pourraient provoquer une catastrophe apocalyptique.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est mauvais.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Bien que certains éléments vénérés dans les histoires religieuses se soient révélés plus tard faibles, voire même d'une inefficacité embarrassante, ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quelque chose de idiot ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Oui, un exemple est cette paire de chaussures sacrées. Celui qui embrasse le bout de la chaussure ne peut résister à l'envie de laisser une trace : quelle honte pour la religion.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est dégoûtant. \\nDonc. à quel type appartient celui qui manque ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Il s'agit du Destiny Spear, un Substance H de classe EX sous la garde conjointe de toutes les villes universitaires.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ah. \\nJe vois, ça a l'air cool.", "Lian")
	await novel_interface.show_dialog("Alors, quel est exactement le Destiny Spear ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tu as l'air d'un idiot complet en ce moment.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Hé, je n'en ai vraiment aucune idée ! \\nJe ne suis qu'un lycéen.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru me regarde, impuissant, comme s'il se demandait par où commencer avec moi.")
	novel_interface.character_light()
	await novel_interface.show_dialog("En un mot, il s’agit du premier type de Substance H, censé avoir des pouvoirs déicides.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Très peu de descriptions du Destiny Spear se trouvent dans la littérature accessible au public, sauf qu'il « ne fond pas à haute température » et qu'il « prend du poids lorsqu'il est balancé ».", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("C'est ça ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si vous creusez plus profondément, vous découvrirez que l’un ou l’autre trait en fera un Substance H de classe XK.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Il peut y avoir d’autres traits dangereux et inconnus. C’est pourquoi ils ne devraient pas trop attirer l’attention des médias.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Cela me donne la chair de poule. Même les petits enfants savent ce qu’est un Substance H de classe XK…")
	await novel_interface.show_text_only("Cela conduirait soit à un désastre apocalyptique, soit à créer un autre Substance H avec le même pouvoir. Actuellement, il n’existe que six objets de ce type connus dans le monde.")
	await novel_interface.show_text_only("Chacune d’entre elles appartient à l’une des six Cités Académies. Plus précisément, seuls ceux qui possèdent un tel Substance H sont reconnus par le Congrès Uni.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Hein ? \\nQue signifie ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Maintenant, vous savez quel crime grave « vous » avez commis ?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Je suis tellement choquée que tout me semble surréaliste.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Désolé. \\nNon ! Pourquoi ai-je dit pardon ? Je ne suis pas le cambrioleur !", "Lian")
	await novel_interface.show_dialog("(Merde. Ce type doit être super dangereux !)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Mais heureusement, la nouvelle a été supprimée.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ils l'ont fait juste pour éviter la panique du public.\\nL'enquête se poursuivrait, en secret.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Pour des raisons de confidentialité, l'avis de recherche ne sera pas délivré au ministère de la Défense. Mais tous les services de renseignement, y compris SID, doivent déjà avoir été prévenus.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Il est donc encore tôt pour se sentir soulagé, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("C'est vrai… l'ancien moi est toujours en danger, n'est-ce pas ?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("Et si… je veux dire, et si… \\n… quelqu'un me traquait…", "Lian")
	await novel_interface.show_dialog("Même si je suis maintenant une fille, je pourrais probablement être enfermée, non ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous l'avez enfin eu.", "Mariru")
	await novel_interface.show_dialog("Les services de renseignement ont vérifié toutes les images de vidéosurveillance disponibles et ont découvert que le type s'était présenté dans d'autres zones Flux, toujours avec votre ancien visage.", "Mariru")
	await novel_interface.show_dialog("Puisque nous pouvons récupérer les données auprès d’une source tierce, d’autres services de renseignement disposent probablement déjà de ces informations.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Déjà récidiviste ? \\nMon avenir s'annonce sombre ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Je m'imagine torturé dans des interrogatoires sans fin…")
	await novel_interface.show_text_only("J'ai l'impression que je serai arrêté à tout moment et qualifié de criminel contre l'humanité.")
	await novel_interface.show_text_only("A été enfermé dans la prison la plus brutale, condamné à plus de 200 ans de prison.")
	await novel_interface.show_text_only("Je pourrais avoir un compagnon de cellule extrêmement dangereux, et il…")
	await novel_interface.show_text_only("Waah, arrête ça ! \\nNe réfléchissez plus !")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hahaha. Tu as si peur et tu as l'air si pâle.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Vas-y doucement, Ren. Je peux vous assurer une sécurité à 98 % tant que vous êtes en New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Donc j'ai encore 2% de chances d'être arrêté ?", "Lian")
	await novel_interface.show_dialog("(Deux secondes d'incertitude toutes les cent secondes !) \\n(Ce n'est pas sûr du tout !)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Que ces vieux chiens du Congrès uni soient parvenus à un consensus dans un délai aussi court… Quelque chose ne va pas.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Et c’est le facteur inconnu de 2 % dont je parlais.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Je ne peux pas imaginer quel émoi cela a fait parmi ces gros bonnets…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ainsi, les services de renseignement des autres Cités Académies ont dû utiliser beaucoup de ressources pour traquer le cambrioleur.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W… que dois-je faire ?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Un ennemi visible est toujours facile à combattre. Laissons le soin à SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
