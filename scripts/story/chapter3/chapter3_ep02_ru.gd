# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Записи SID показывают, что Центр Акатраз собирает Substance H EX-класса, тестирование и исследование которого запрещено Объединенным Конгрессом.")
	await novel_interface.show_text_only("Под территорией Центра он соединен со входом в древний реликтовый дом в пещере Чейт, вход в который запрещен и даже не подлежит оценке.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX-класс Substance H… Это что-то очень опасное?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Большинство из них являются священными предметами религиозного значения. Поскольку они предназначены только для религиозных последователей, их можно собирать, но исследования запрещены.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Звучит как самообман.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Ха, я чувствовал то же самое. \\nНо в некотором смысле это имеет смысл.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("В религиозных преданиях говорится, что некоторые артефакты обладают богоубийственной силой или вызывают Страшный суд.", "Mariru")
	await novel_interface.show_dialog("Будучи активированными, они могут вызвать катастрофу апокалиптического масштаба.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это плохо.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Хотя некоторые предметы, почитаемые в религиозных историях, позже оказались слабыми или даже досадно неэффективными ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что-то глупое?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Да, одним из примеров является эта пара священной обуви. Тот, кто поцелует носок ботинка, не сможет удержаться от полоски — какой позор для религии.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Это отвратительно. \\nИтак. к какому типу относится этот недостающий?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Это Destiny Spear — Substance H EX-класса, находящийся под совместной опекой всех академических городов.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ох. \\nПонятно, звучит круто.", "Lian")
	await novel_interface.show_dialog("Что же тогда такое Destiny Spear?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Ты сейчас выглядишь полным идиотом.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Эй, я действительно понятия не имею! \\nЯ всего лишь старшеклассник.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru беспомощно смотрит на меня, как будто не зная, с чего начать.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Короче говоря, это первый тип Substance H, который, как полагают, обладает убийственными способностями.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("В общедоступной литературе можно найти очень мало описаний Destiny Spear, за исключением того, что он «не плавится при высокой температуре» и «набирает вес при раскачивании».", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("И все?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Если вы копнете глубже, вы обнаружите, что любая черта делает его классом XK Substance H.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Могут быть и другие опасные, неизвестные черты. Вот почему они не должны привлекать слишком много внимания средств массовой информации.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("У меня от этого мурашки по коже. Даже маленькие дети знают, что такое Substance H XK-класса…")
	await novel_interface.show_text_only("Это либо приведет к катастрофе Судного дня, либо создаст еще один Substance H с той же силой. На данный момент во всем мире известно всего шесть подобных предметов.")
	await novel_interface.show_text_only("Каждый из них принадлежит одному из шести Академгородов. Точнее, Объединенным Конгрессом признаются только те, кто обладает таким Substance H.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("А? \\nЧто означает ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Теперь вы знаете, какое тяжкое преступление «вы» совершили?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я настолько потрясен до такой степени, что мне все кажется сюрреалистичным.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Извините. \\nНет! Почему я сказал «извини»? Я не грабитель!", "Lian")
	await novel_interface.show_dialog("(Дерьмо. Этот парень, должно быть, очень опасен!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Но, к счастью, новость удалили.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Они сделали это только для того, чтобы избежать общественной паники.\\nРасследование все равно будет продолжаться тайно.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Из соображений конфиденциальности заявление в Минобороны не будет направлено. Но все спецслужбы, включая SID, наверняка уже были уведомлены.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Так что еще рано чувствовать облегчение, Рен.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Верно… старый я все еще в опасности, верно?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("Что, если... я имею в виду, что если... \\n...кто-то меня выследит...", "Lian")
	await novel_interface.show_dialog("Даже если я сейчас девочка, меня, наверное, могут запереть, да?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Вы наконец получили это.", "Mariru")
	await novel_interface.show_dialog("Разведывательная служба проверила все доступные записи с камер видеонаблюдения и обнаружила, что этот парень появлялся в некоторых других зонах потока, все еще с вашим старым лицом.", "Mariru")
	await novel_interface.show_dialog("Поскольку мы можем получить данные из стороннего источника, эта информация, вероятно, уже есть и у других спецслужб.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Уже рецидивист? \\nМое будущее выглядит мрачным ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Я представляю себя замученным бесконечными допросами…")
	await novel_interface.show_text_only("Я чувствую, что меня арестуют в любой момент и назовут преступником против человечества.")
	await novel_interface.show_text_only("Попал в самую жестокую тюрьму, приговорен к более чем 200 годам тюремного заключения.")
	await novel_interface.show_text_only("У меня мог быть чрезвычайно опасный сокамерник, и он…")
	await novel_interface.show_text_only("Ваа, прекрати! \\nХватит думать!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ха-ха-ха. Ты так напуган и выглядишь таким бледным.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Успокойся, Рен. Я могу гарантировать вам безопасность на 98%, пока вы находитесь в New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Значит, у меня все еще есть 2% шанс быть арестованным?", "Lian")
	await novel_interface.show_dialog("(Две секунды неопределенности из каждых ста секунд!) \\n(Это совсем небезопасно!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("То, что эти старые псы в Объединенном Конгрессе достигли консенсуса в такой короткий срок… Что-то не так.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("И это тот 2% неизвестный фактор, о котором я говорил.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Я не могу себе представить, какой ажиотаж это вызвало среди этих важных шишек…", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Таким образом, разведывательные службы других Академгородов, должно быть, использовали много ресурсов для охоты на грабителя.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ч… что мне делать?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("С видимым врагом всегда легко справиться. Оставим это SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
