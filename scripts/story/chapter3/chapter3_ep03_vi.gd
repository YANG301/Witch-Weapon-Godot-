# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Ý bạn là… Xóa sạch mọi thông tin của bên thứ ba về anh chàng đó?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Không. Ngược lại, tôi sẽ bổ sung thêm thông tin.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cái gì?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Một nụ cười lạnh lùng hiện lên trên khuôn mặt Mariru.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Bây giờ thông tin duy nhất về tên trộm chỉ là đoạn phim có độ phân giải thấp.", "Mariru")
	await novel_interface.show_dialog("Chỉ cần tưởng tượng có bao nhiêu người trên toàn thế giới có khuôn mặt đơn giản này.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Đợi đã—bạn vừa nói, đơn giản phải không? Điều đó thật đau đớn.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Và ngay cả khi ai đó trông giống \"tôi\" thì vẫn dễ dàng bị phát hiện.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Camera an ninh ghi lại mọi việc anh làm vào ngày hôm đó!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Tất nhiên, không khó để nhận ra một người thực sự.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Nhưng nếu… người này không tồn tại thì sao?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ý bạn là…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Nếu chúng ta đưa vào một số danh tính giả mạo có đặc điểm khuôn mặt giống với nghi phạm thì gần như không thể phát hiện ra.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Và trong mắt tất cả mọi người ngoài chúng ta, những kẻ đó cũng không khác "+GameConfig.player_name+" — chỉ là thêm những người mất tích một cách bí ẩn mà thôi.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Vậy thì làm sao có thể tìm ra mục tiêu thực sự?", "Mariru")
	await novel_interface.show_dialog("Để giấu một hạt gạo, bạn có thể đem đi hoặc rắc cả bao gạo lên trên.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Nghe như một dự án lớn…", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Chỉ cần thêm một chút phức tạp cho một vấn đề đơn giản để người nộp thuế hài lòng về cách chi tiêu tiền của họ. Nhìn thấy? Hai con chim với một hòn đá.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Mỗi lần bạn đưa ra những bình luận không phù hợp như vậy tôi đều muốn gọi cảnh sát.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Nhân tiện, tôi nhận thấy có một số mâu thuẫn trong thông tin nhận dạng của bạn.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Hả? Phần nào?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Về bố mẹ bạn.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Tim tôi thắt lại khi nghe đến từ “cha mẹ”.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Bạn kể với tôi rằng mẹ bạn mất sớm và bố bạn mất tích.", "Mariru")
	await novel_interface.show_dialog("Tôi biết bạn không muốn nói về điều này. Nhưng nó quan trọng. Tôi phải kiểm tra với bạn.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Được thôi…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru lấy lại dữ liệu cô ấy đã sao lưu.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Ở đây ghi mẹ bạn mất tích vào ngày 25 tháng 7 năm 2026, được cho là đã chết. \\nĐó chính là Đại nạn.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Trước ngày đó, tàn tích dưới nước ở Tây Bắc New Opulentia từng là một thành phố nhộn nhịp.")
	await novel_interface.show_text_only("Tôi chỉ có một ký ức mơ hồ về nó…")
	await novel_interface.show_text_only("Vào thời điểm thành phố bị phá hủy bởi vũ khí Devine Touch, Aegis đã tạo ra một trường bảo vệ. New Opulentia đã ở ngay rìa của nó.")
	await novel_interface.show_text_only("Và… Điều đó đánh dấu sự khởi đầu của Chiến tranh Bảy năm.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Cha, mất tích từ tháng 12 năm 2026. Được cho là…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Dừng lại… làm ơn!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi ghét cụm từ lạnh lùng này—Được cho là… đã chết.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Tôi luôn tự nhủ… \\nCó lẽ… bố vẫn còn sống…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Chà, bố cậu chắc chắn phải hạnh phúc lắm. Cậu bé của anh đã lớn lên trở thành một cô gái xinh đẹp!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi cười khúc khích trước lời nói của cô ấy. \\nChết tiệt, tôi biết cô ấy đang trêu chọc tôi!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nhìn này.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cô ấy nhấp vào hồ sơ của bố mẹ tôi. Hai mã xuất hiện.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Theo hồ sơ—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mẹ ơi, code nhé. \\nCha ơi, mã ngoại tuyến.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Có chuyện gì vậy?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis sẽ không gán mã cho mẹ bạn nếu bà chết trước khi trường bảo vệ được kích hoạt hoặc ở đâu đó ngoài phạm vi của nó.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Ơ…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nhìn tôi trầm tư.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Bạn cũng không biết à? \\nCác tập tin sẽ không nói dối. Tôi sẽ coi chừng việc này…", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
