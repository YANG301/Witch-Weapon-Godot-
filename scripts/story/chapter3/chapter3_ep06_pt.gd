# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Saio da Sede com o livreto com todos os detalhes da garota do jet set. Mariru também me manda fotos dela por mensagem.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Nascida em uma das famílias nobres de Salmonton, Raphael é neta do Dr. Thomas Dekkers, presidente da Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Uau… eu li sobre ele em livros didáticos! \\nIsso está ficando um pouco louco…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Peguei você! Olá, querido!")
	await novel_interface.show_text_only("Alguém me abraça por trás.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("Uau-!", "Lian")
	await novel_interface.show_dialog("… Aya, é você! O que diabos você está fazendo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tenho que passar por um exame físico completo e tratamento por Aya toda vez que retorno de uma Área de Fluxo.")
	await novel_interface.show_text_only("Odeio admitir, mas o instrumento em forma de polvo de Aya é bastante útil para curar feridas.")
	await novel_interface.show_text_only("E eu odeio estar me acostumando com as ações psicopáticas de Aya...")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Por que você parece tão desapontado? \\nEstou começando a me sentir magoado.", "Ai")
	await novel_interface.show_dialog("Não cuidei bem de você desde que voltou da Subestação…", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Então vou te levar para a escola… \\nE te dar algumas lições inesquecíveis.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("O quê? Espere…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("Tire suas mãos de mim! Está em plena luz do dia!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("O pervertido Mariru me lembrou de tomar cuidado com… \\nDeve ser Aya!")
	await novel_interface.show_text_only("Aya me arrasta para o centro de saúde. Não posso fazer nada além de deitar na cama.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Apenas um exame físico… Você está sendo dramático demais.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Você parece desapontado. Prefira um tratamento especial, né?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não, obrigado. \\nApenas o check-up regular, por favor.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(E sua rotina é bastante especial!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya pega o estranho instrumento como sempre. O gerador de imagens está mais uma vez piscando com imagens incompreensíveis.")
	await novel_interface.show_text_only("To kill time, I take out my cellphone and continue to read about Raphael.")
	await novel_interface.show_text_only("Ela tem cabelos longos e grisalhos escuros. Seus olhos são roxos e penetrantes, como se estivessem prontos para ler a mente das pessoas.")
	await novel_interface.show_text_only("Olhando para a foto, sinto meu coração bater violentamente e meu corpo começa a tremer incontrolavelmente.")
	await novel_interface.show_text_only("Então recupero o fôlego, tudo num instante. Aya está ocupada com o estetoscópio e parece não ter percebido o que está acontecendo.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(O que há de errado?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu sinto que… mesmo através da foto, há algo em Raphael que ressoa com o instrumento.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("Por que…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bip—bip—")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Que barulho é esse?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A curva na tela está flutuando acentuadamente.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Ops, por que isso enlouquece de repente?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("Eu peguei Ren verificando algo proibido para menores...?", "Ai")
	await novel_interface.show_dialog("Esqueci que você é um adolescente!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("No, it's not!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A estranha sensação de ressonância desaparece.")
	await novel_interface.show_text_only("Foi interrompido por Aya?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Qual é esse parâmetro flutuante?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Isso é… um segredo!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Esqueça.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Com licença. Posso entrar?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix entra rapidamente no centro de saúde.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Ei, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Olá, Ren. Eu não esperava encontrar você aqui.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix vira-se para o instrumento, parecendo confuso, como se estivesse tentando descobrir o que estou fazendo.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("O que é isso…?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ela aponta para o dispositivo azulado de quatro pontas na mão de Aya.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, é para experimentos humanos.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O quê? Você acabou de dizer isso diretamente?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ah…", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, Sra. Aya, não estou me sentindo muito bem. Posso descansar aqui?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix é incrível. Como ela poderia continuar sorrindo sem comentar a resposta surpreendente de Aya?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Não tem problema, você pode usar aquela cama. \\nLevarei mais 15 minutos para terminar o que estou fazendo.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya tira a tela do instrumento e sai da sala para fazer upload de dados.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Obrigado.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix acena para Aya e deita na cama ao meu lado.")
	await novel_interface.show_text_only("A cama está a apenas um braço de distância. Nix não fecha a cortina.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(Ela simplesmente se deita assim na frente de um estranho?) \\n(Ahh sim, somos todas garotas…)", "Lian")
	await novel_interface.show_dialog("(Droga. Meu coração está batendo rápido.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me viro furtivamente, espiando para ela. A maneira como ela coloca o cabelo atrás da orelha é tão graciosa.")
	await novel_interface.show_text_only("Estamos tão perto. Eu posso até sentir o cheiro da leve fragrância nela…")
	await novel_interface.show_text_only("Enquanto me entrego a pensamentos sonhadores, Nix se vira e olha diretamente para mim.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("O que houve?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah! Ahh… \\nUh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("De repente, recobro o juízo e me sinto como uma criança que foi pega pregando uma peça.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("O que devo fazer? Devo dizer alguma coisa?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(Não, espere ...)", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("Não estou me sentindo nervoso ou tímido… É…")
	await novel_interface.show_text_only("Sinto uma sensação de queimação lá embaixo...")
	await novel_interface.show_text_only("É… uma sensação parecida quando vi a foto de Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Droga, estou tão duro a ponto de qualquer garota me deixar com tesão?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você parece pálido. Você está se sentindo bem?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sim… Tudo bem, eu acho.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Ah, quem é esse?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix está olhando para meu celular. \\nShe raises her eyebrows at the photo on the screen.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("Você a conhece?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Não, eu não.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Mas Nix parece enojado…) \\n(Talvez eu a tenha entendido errado.)", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
