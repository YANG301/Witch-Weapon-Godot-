# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Der bizarre Albtraum, das vage Gespräch, der Schatten im Traum. \\nPlus ein roter Alarmhinweis…")
	await novel_interface.show_text_only("Gerade als ich meine neue Identität akzeptieren und beschließen wollte, mich zusammenzureißen, haben sie wieder alles durcheinander gebracht.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hast du die Nachrichten gesehen? \\nEr ist es! Nein, ich, ich bin es!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Ich bin nicht blind. Natürlich weiß ich, dass du es bist, der vor mir steht, du schwitzendes, dummes Mädchen.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Nein! \\nVerdammt. Ich bin es in den Nachrichten!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In Panik weiß ich nicht einmal, wo ich anfangen soll. \\nMariru grunzt und schlägt mir mit der Hand an den Kopf.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("So ein nutzloser Idiot. Nach all diesen Schulungen können Sie Ihrem Beamten nicht einmal klar berichten.", "Mariru")
	await novel_interface.show_dialog("Geht es nicht einfach um einen Typen, der aussieht wie Sie, und der weltweit gesucht wird, weil er in das Sammlungs- und Forschungszentrum der Zweiten Akademiestadt einbricht?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja, ja, ja! Genau!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Die Nachrichtendienste hatten die Nachricht lange bevor sie viral ging, gemeldet.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Du siehst albern aus, wenn du Angst hast~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru zwickte mich in die Wange. Ich versuchte sofort, sie aufzuhalten.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, mach ernst!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Weltweit meistgesucht. Es ist kein Witz!", "Lian")
	await novel_interface.show_text_only("Es wäre mir nie in den Sinn gekommen, dass ich eines Tages wegen Einbruchs in den Nachrichten stehen würde.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Und es ist ein Triple-A-Hinweis! Soweit ich mich erinnere, wurde der letzte gesuchte Mann mit einer solchen Alarmstufe in Südamerika von einem Bunkerbrecher bombardiert.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Dieser verdammte Einbrecher hat einfach so meine frühere Identität gestohlen ... Mir kommen bei dem Gedanken fast die Tränen.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In diesem Fall… \\nDer einzige, auf den ich zählen kann, ist Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("So sehr ich auch zusehen möchte, wie du so leidest ...", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Ich muss Sie bitten, die Nachrichten noch einmal zu lesen.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("Ist es notwendig? Ich habe das Ganze bereits in meinem Kopf verankert.")
	await novel_interface.show_dialog("Das Bild ist vielleicht nicht scharf und klar, aber ich bin mir sicher, dass er fast genauso aussieht wie ich als Junge!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Um zu beweisen, was ich gesagt habe, rufe ich die Nachrichten auf meinem Handy auf.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Sehen Sie, das ist... \\nEh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Der gesuchte Hinweis, der mich erschreckt hat, ist nicht mehr da. Es wurde durch eine normale Vermisstenmeldung ersetzt.")
	await novel_interface.show_text_only("Der siebzigjährige Karikaturist Mr. Inoue ist vor Kurzem verschwunden. \\nSollte jemand seinen Aufenthaltsort kennen, wenden Sie sich bitte umgehend an die Polizei.")
	await novel_interface.show_text_only("Ich habe andere Websites überprüft und sogar mit Schlüsselwörtern gesucht, aber die Nachrichten waren nirgendwo zu finden.")
	await novel_interface.show_text_only("Wenn ich mir das Gesicht von Mariru ansehe, bin ich sehr dankbar.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Warst du es...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru kommt vorbei und wischt mir die Tränen weg.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Schau dich an – ganz erstickt.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Wenn du mir wirklich danken willst – sei dann mein Sklave~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Und…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Als du sagtest: „Der Einzige, auf den ich zählen kann, ist Mariru“, \\ndu sahst so süß aus …", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru hebt zärtlich mein Kinn mit ihrem Zeigefinger.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hey, hör auf damit!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Soweit ich sehen kann, bin ich bereits versklavt ...")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Ich wünschte, ich könnte das tun. Aber meines Wissens gibt es nur eine Agentur, die die gesamten sozialen Medien weltweit zum Schweigen bringen kann.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Äh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Es muss eine Durchführungsverordnung des Vereinigten Kongresses sein.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Der Oberste Kongress, der alle sechs Akademiestädte vertritt, hat beschlossen, die Nachricht zu löschen?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Warum…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru sieht mich an und lächelt mich geheimnisvoll an.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sei nicht albern. Offensichtlich haben sie dies nicht getan, um den Einbrecher zu schützen.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Sie wollen einfach nicht, dass die Öffentlichkeit erfährt, was gestohlen wurde.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Wer ist dieser Einbrecher? Warum hat er meine Identität verwendet?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Wer auch immer er ist, er muss ein Genie sein, um heil aus dem Sammlungs- und Forschungszentrum von Akatraz herauszukommen.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Die Sache ist die: Es fällt ihm nicht schwer, sein Gesicht zu bedecken.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Aber er tat es nicht und wagte es sogar, eine Zeit lang auf das Dach des Gebäudes zu gehen ...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Gemäß der speziellen Ausbildung fehlen die unbedeutendsten Dinge entweder dort, wo sie erscheinen sollen …", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Oder sind da, wo sie nicht sein sollten.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
