# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Já se passaram dois dias desde que Mariru me atribuiu a tarefa.")
	await novel_interface.show_text_only("Ontem à noite, a delegação \"Intercâmbio Cultural\" finalmente chegou ao New Opulentia International Airport.")
	await novel_interface.show_text_only("Então… Minha missão está prestes a começar.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Mas tentar arrancar informações daquela garota ... eu não sei.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("De qualquer forma, ela não é uma garota comum. E se ela se recusar a falar comigo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("Olha a garota ali! Ela não está usando nosso uniforme escolar.", "Aluno 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("E a que está ao lado dela parece uma atendente ... Ela é algum tipo de princesa?", "Aluno 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Olho e vejo uma garota esbelta com um casaco verde. \\nEla está parada em frente ao gramado.")
	await novel_interface.show_text_only("O alvo da minha missão—Raphael Dekkers.")
	await novel_interface.show_text_only("Eu vi o vice-diretor e a banda de honra esperando do lado de fora do portão da escola agora há pouco. Ela entrou furtivamente no campus?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Senhorita, por aqui, por favor.", "Séquito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Este edifício escolar foi projetado no estilo Tudor da época de ouro.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Mas o átrio é demasiado apertado para mostrar uma sensação de grandeza.", "Raphael")
	await novel_interface.show_dialog("E o entalhe no rodapé é muito desajeitado para suportar a estrutura e o design.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("Senhorita, que gosto extraordinário pela arte você tem!", "Séquito")
	await novel_interface.show_dialog("Arquitetura Tudor como esta deveria ter um átrio mais alto.", "Séquito")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não, você não entende. \\nApenas aumentar a altura não funcionaria.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você tem toda razão, senhorita. O gramado também deveria ser ampliado.", "Séquito")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hein? Isso pareceria descoordenado. \\nAfinal, todo o jardim da frente já está congestionado…", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Claro. A senhorita Raphael nem chamaria esse pedaço de terreno desorganizado de jardim da frente, chamaria?", "Séquito")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael parece estar um tanto insatisfeito com essas palavras.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… Não, não é isso que estou pensando.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Ah! \\nQue gentileza da sua parte, senhorita Raphael!", "Séquito")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Por que seu atendente não consegue ver que seu sorriso já está rígido?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Ei, sua aberração travesti.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("O quê?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Aberração travesti ... Ela está falando de mim?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Com suas palavras, todos se viram para olhar para mim.")
	await novel_interface.show_text_only("Não costumava ter tantos olhos em mim, sinto-me corar.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Não, estou... não estou...! \\n(Mariru me fez usar o uniforme!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Seja um homem e admita isso, certo?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Eu não sabia que New Opulentia era tão liberal que um pervertido como você poderia ser admitido em uma escola para meninas.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, mudei de ideia! I don't want to do this!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Hum… Ren é nosso colega de classe. Ela é uma menina!", "Aluno 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("O quê? \\nPare de brincar comigo.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael parece que está ofendida.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Ela não está brincando! Todos nós podemos garantir. \\nRen é absolutamente uma garota.", "Aluno 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Obrigado por falar por mim. Mas definitivamente não sou uma garota.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, pensei que você fosse um menino.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Por quê! Não me pareço em nada com um menino! \\n(Ah, não…)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh… É uma pena trair o velho eu…")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Tudo bem. Esqueça.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("O que você acha da arquitetura na sua escola?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não tenho ideia de arquitetura. Se você insiste…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Basta dizer o que vier à sua mente.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum ... como um prédio escolar, o átrio não é muito baixo.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("O prédio não é agradável à vista… talvez porque não seja… bonito o suficiente?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Envergonhado pelo meu vocabulário pobre, tento captar a expressão no rosto de Raphael.")
	await novel_interface.show_text_only("Como esperado, ela sorri com desdém.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Bonito? Eu não posso acreditar no que estou ouvindo. Essa palavra é tudo que você pode encontrar para descrever uma arquitetura?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bem, é exatamente o que sinto sobre isso!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Quer dizer, talvez seja melhor… Se as árvores não estiverem perfeitamente alinhadas…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Hum… \\nTipo, uh…", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Ugh… por que tenho que responder a essa pergunta?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Você está tentando dizer que as árvores devem ser dispostas alternadamente para adicionar mais profundidade ao design?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exatamente. \\n(O que ela acabou de dizer?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael finalmente me deu um leve sorriso.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Ah, um pervertido é muito melhor que um sim-homem!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Não, eu não estou…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Senhorita…", "Séquito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Deixe-nos. Espere por mim fora da escola.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Você é Ren, certo? Vamos. Mostre sua escola incrível para mim, certo?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("Ei...? \\nO… Ok!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
