# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Nos apresuramos hasta el estacionamiento subterráneo según las indicaciones de Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru me dijo que los hombres del Administrador se retiraron por otra salida en lugar de correr tras nosotros.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Déjame revisar su herida... He aprendido primeros auxilios antes.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me indica que coloque Annie sobre una superficie plana. Luego comprueba el pulso y la respiración de Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Afortunadamente, no tiene fibrilación auricular, aunque su respiración es bastante superficial y las quemaduras graves. No tengo idea si hay alguna lesión interna...", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¡Eso es brutal! ¡Tratar a una chica así!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Mmm… ¿Señorita?", "Beatrice")
	await novel_interface.show_dialog("¿Atraes a menudo animales pequeños? \\nPor ejemplo—", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nos damos vuelta y miramos. Hay dos palomas cerca de nosotros.")
	await novel_interface.show_dialog("Coo—Coo—", "paloma")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("¿Qué tiene de extraño esto? Las palomas se encuentran por todas partes.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("¡No, aquí está el Sótano Tres!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("¿Y qué? \\nNo son animales en peligro de extinción.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Coo—Coo—Coo—", "paloma")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(... Nobleza, ja. No hay ningún sentido común.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("La magia curativa atrae a los animales pequeños. Pero si ella no es consciente de eso...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice me acerca a Raphael, tomando sus manos y las mías.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Ven, prueba esto.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Mmmm?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice pone mi mano sobre la de Raphael y presiona nuestras manos con fuerza con su palma.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("¿Qué estás haciendo—?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("No esperaba que la mano de ... \\nRaphael fuera tan suave y cálida como ....")
	await novel_interface.show_text_only("¡No, espera! \\n¿Soy—?")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tomando sus manos…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Veo sorpresa e ira en el rostro de Raphael. Ella me mira fijamente, casi respirando fuego.")
	await novel_interface.show_text_only("Me estremezco ante la idea de que me llamen pervertido y me den una paliza negra y azul.")
	await novel_interface.show_text_only("De repente, Raphael gira para mirar a Beatrice, como si se diera cuenta de algo. Beatrice asiente levemente.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael cierra los ojos, con una mirada intensa en su rostro. Y Beatrice aleja lentamente la palma de su mano.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(¿Qué? ¿Le gusta tomar mi mano?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, un calor agradable fluye por mi cuerpo y me siento más relajado que nunca.")
	await novel_interface.show_text_only("Uf... De repente me doy cuenta de que el aire es tan fresco, incluso en su estacionamiento subterráneo.")
	await novel_interface.show_text_only("Y de alguna manera la horrible escena deja de atormentarme.")
	await novel_interface.show_dialog("Ah-em...", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Veo las cicatrices de quemaduras en el cuerpo de Annie desvanecerse a una velocidad increíble.")
	await novel_interface.show_text_only("El calor disminuye gradualmente. Raphael da un suspiro de alivio y abre los ojos.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, ¿dónde estamos...?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie me mira adormilado, como si acabara de despertar.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Estamos a salvo ahora. Solo esperando Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("¿Por qué…?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("¿No has... notado esto antes?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Una bruja con una magia curativa tan maravillosa... \\n¡Eres increíble!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("¡Sí, de verdad! ¡Yo también he sentido la magia!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… ¿Bruja? ¿Magia? ¡Qué tontería!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael frunce el ceño con severidad.")
	novel_interface.character_light()
	await novel_interface.show_dialog("¿Qué me has hecho? \\n¿Por qué sus heridas sanan tan rápido?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sé que es difícil asimilar tanta información a la vez. Así que me quedo en silencio.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("¿Quiénes son los que atacan a nuestros soldados de seguridad? \\n¿Cómo se atreven a usar el arma Substance H aquí...?", "Raphael")
	await novel_interface.show_dialog("¿Por qué una persona muerta durante cientos de años volvió repentinamente a la vida? ¡Y llevo su collar!", "Raphael")
	await novel_interface.show_dialog("Y he visto... \\nLa pesadilla...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz de Raphael tiembla al pensar en la horrible escena.")
	await novel_interface.show_text_only("Paso a Beatrice. Una sonrisa tranquila aparece en su hermoso rostro.")
	await novel_interface.show_text_only("La esmeralda volvió a su estado original y Beatrice se la devolvió a Raphael.")
	await novel_interface.show_text_only("Parecía como si esa aterradora escena de hace un momento no tuviera nada que ver con ella.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("La magia del Libro de los Siete Filósofos perturba la mente... \\nEs perfectamente normal sentir miedo en el primer encuentro.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Pero el miedo es una emoción importante. Conocer tu debilidad te ayuda a sobrevivir a las crisis.", "Beatrice")
	await novel_interface.show_dialog("Lo realmente horrible son aquellos dominados por el miedo…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice parece ser atraída por los recuerdos, con una mirada triste en sus ojos.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Sea como fuere, preferiría nunca haber abierto ese libro, y nunca haber pedido ese deseo…", "Beatrice")
	await novel_interface.show_dialog("Y nunca… he obtenido el poder maldito…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("¿Maldito?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("El Grimorio me ha dotado de una magia... \\nNo puedo evitar exudar un hechizo que atrae a los hombres.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(¡Por eso…!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice se gira hacia mí y me toca la garganta con la punta de su dedo.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("¿Puedo hacer una pregunta?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Sí… ¡Por favor!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Tu nombre es Ren, ¿verdad? \\nEres especial...", "Beatrice")
	await novel_interface.show_dialog("Como niña, deberías ser inmune a mi encanto. Entonces, ¿por qué me mirabas ... furtivamente?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("¡Ella se dio cuenta! \\n¡Muuuy avergonzado!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pero... a diferencia de los hombres, no pierdes completamente el control... ni te comportas como un loco.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Es por mi magia?…) \\n(No, no, ¡perdí el control por completo!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice levanta lentamente mi mandíbula con un dedo y luego toca suavemente mi nariz.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("No me importa ... Honestamente, tengo que admitir ... que eres lindo.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Trago inconscientemente.")
	await novel_interface.show_text_only("¿Es esa ... solo el efecto de la magia?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Poco después, una limusina SUV negra se detuvo frente a nosotros.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, ¡entra!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, ¿verdad? Espero que vayas con nosotros.", "Mariru")
	await novel_interface.show_dialog("He encontrado todos los documentos disponibles... En caso de que estés interesado en la vida de tus conocidos.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Su admirador secreto, el poeta, ha escrito versos que se han transmitido a través de los siglos.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Bien. También estoy interesado en esta monada aquí.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al encontrar los ojos de Beatrice, me sonrojo de nuevo...")
	await novel_interface.show_text_only("¿Es... es realmente sólo el efecto de su magia?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Y Raphael, simplemente regresa a tu habitación. La pandilla ya se fue. Es seguro ahora.", "Mariru")
	await novel_interface.show_dialog("Si la delegación descubre que has desaparecido... No querrás asustarlos, ¿sabes?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Hemos transportado contrabando... y hemos causado tal agitación...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael mira a Beatrice. \\nBueno, el contrabando se ha convertido en una bella dama. ¡Qué dulce!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("¿Y me dejas ir así?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("A cambio, el Dr. Dekkers acordó que mis comerciantes designados serán los primeros en recibir los productos de Salmonton el próximo año.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Y también ha prometido hacer la vista gorda ante mis actividades comerciales en Newmoridas Futures Exchange.", "Mariru")
	await novel_interface.show_dialog("El acuerdo ya está sobre el escritorio de mi oficina. Entonces, tenga la seguridad. SID no es un grupo benéfico.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("¡Espera! ¿¡Hemos arriesgado nuestras vidas sólo para que tú ganes dinero!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Bien. Prometo que no le contaré a nadie sobre este incidente antes de solucionarlo todo.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Es un gran placer trabajar con Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, ¡definitivamente descubriré esta cosa mágica cuando regrese a Salmonton!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("¡Por favor hazlo! Creo que realmente tienes un poder mágico maravilloso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se da vuelta pero se detiene abruptamente. \\nSe quita el collar y me lo arroja.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Esto es de tu colección familiar, ¿no? ¿Cómo puedes…?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Es tuyo ahora.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("¡Una muchacha galante! Te convertirás en una dama excepcional cuando seas mayor.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, no me olvidaré de hacerte una verificación de antecedentes.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Cuídense todos. Nos volveremos a encontrar.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
