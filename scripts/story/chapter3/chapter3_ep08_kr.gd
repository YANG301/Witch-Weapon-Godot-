	await novel_interface.show_text_only("갑자기 그렇게 얘기하니까, 기분이 불쾌한 걸……")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("음……", "샤오롄")
	await novel_interface.show_dialog("당신은 제4학원도시에서 오신 라파엘 덱스 아가씨죠?", "샤오롄")
