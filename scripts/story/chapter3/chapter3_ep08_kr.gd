	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("당신은 부모의 명령을 거역하지 못하는 제멋대로인 어린아이일 뿐이에요──", "닉스")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("뭐가 그리 잘나서 무료로 가이드까지 해주는 사람의 학교를 비난하는 거죠?", "닉스")
