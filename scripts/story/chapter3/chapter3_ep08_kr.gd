	await novel_interface.show_dialog("하?!내가 언제 잘났다고 그랬어?", "라파엘")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("이봐, 여장 변태, 내가 그랬어?", "라파엘")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("그건 아니지만……", "샤오롄")
	await novel_interface.show_text_only("젠장, 누가 여장 변태라는 거야!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("봐봐, 내가 언제 그랬다고 그래?", "라파엘")
	await novel_interface.show_dialog("그리고, 네 목에 차고 있는 그거……", "라파엘")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("학교에서 그런 걸 차고 있어도 정말 괜찮은 거야?", "라파엘")
