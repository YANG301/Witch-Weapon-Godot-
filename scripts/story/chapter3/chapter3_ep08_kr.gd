	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("건물 디자인이 전쟁 전 유명한 건축물과 비슷해. 문화 소양을 높이려는 의도겠지.", "라파엘")
	await novel_interface.show_dialog("학교 면적이 너무 작아서 여러 스타일의 건물들이 충돌하는 느낌이야. ", "라파엘")
	await novel_interface.show_dialog("이런 곳에 있으면 답답하지 않아? ", "라파엘")
