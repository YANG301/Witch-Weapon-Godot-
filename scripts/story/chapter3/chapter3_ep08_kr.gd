	await novel_interface.show_text_only("애써 환영회를 준비했다가 바람을 맞은 교감이 우리 뒤에서 손수건을 뜯고 있다.")
	await novel_interface.show_text_only("그리고 이 아가씨는 아직 만족한 것 같지는 않지만 아까보다 기분이 좋아진 듯 하다.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("이게 끝이야?", "라파엘")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("응?참관 내용 말인가요?", "샤오롄")
