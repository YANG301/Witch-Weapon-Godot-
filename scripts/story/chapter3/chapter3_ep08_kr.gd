	await novel_interface.show_text_only("게다가 선배의 목걸이는 아주 귀엽다고!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("일부러 저반광 소재를 쓴 걸 보니……전쟁 전 궁정에서 유출되어 세 조각이 난 『오를로프 블랙다이아』군.", "라파엘")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("이곳의 강의동 몇 채와 맞바꿀 수 있는 가격이라지?", "라파엘")
