	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("──뭐!!?", "샤오롄")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("평민을 대변하는 것처럼 굴지 마. 이 여장 바보가 널 같은 편이라고 여길 거라고 생각하는 거야?", "라파엘")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("……", "닉스")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("누가 여장 바보라는 거야!!")
	await novel_interface.show_text_only("닉스 선배는 왜 갑자기 도둑이 제 발 저리는 모습을 하는 거야?!")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("난 그저 나와 잘 어울리는 악세서리를 한 것뿐이에요.", "닉스")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("자유롭고 독립적이고 싶어하면서 가문의 그늘에서 거만하고 우쭐대는 당신이야말로 정말 가소롭군요. ", "닉스")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("블랙다이아는 마피아 대부의 손에 넘어갔다고 들었는데, 검은 돈으로 산 블랙 다이아라니, 정말 당신과 잘 어울리는군.", "라파엘")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("당신의 가문이 식량 무역을 독점해서 재물과 귀족 지위를 얻은 것과는 다르죠.  옷 하나도 이렇게 화려하다니.", "닉스")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("그러게 누가 우리 작물만이 『흑사병』을 예방하라 그랬나. 속까지 새까만 너와는 다르지.", "라파엘")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("기아로 전세계를 위협하면서, 신앙을 잃어서는 안 된다고 선전하던데, 스스로의 영혼은 탐구하지 않나 봐요?", "닉스")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("내 영혼은 너 같은 사람의 탐구는 필요 없어. 분명 인생의 오점이 될 거야. ", "라파엘")
