	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("……", "샤오롄")
	await novel_interface.show_dialog("(집안에서 시킨 것 때문에 화풀이를 하고 있군……)\\n(그런 일은 대화로 해결하면 되잖아!?)", "샤오롄")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("이런. 그녀의 말을 들으니, 나까지 학교의 건물 스타일이 갑자기 자연스럽지 않아 보인다. ")
	await novel_interface.show_text_only("정말 해로운 평가다. 빨리 잊어버리자! !")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("집안의 계획이 그렇게나 마음에 안 든다면", "닉스")
	novel_interface.change_expression("mock")
