# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("It has been a few days since the wanted announcement was published.")
	await novel_interface.show_text_only("Just as Mariru predicted, the incident seems to have no effect on people's daily life.")
	await novel_interface.show_text_only("There’s also hardly any trace of Mariru's distraction engineering.")
	await novel_interface.show_text_only("It feels like nothing but a nightmare.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Good morning, Sister Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As a witch with special abilities, Elluka is closely watched by SID.")
	await novel_interface.show_text_only("But the kid seems attached to me. Mariru sends her to me every day, claiming she's just being kind.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Good morning, Elluka. \\nWanna eat something between meals?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Hey! Don't give kids too many snacks!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("That's fine. That’s hardly too many.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Oh, come on, you always say that.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("And is it okay that she stays with us all day long?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Kids of her age should go to school. \\nIsn't it?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Umm, she's not just a kid, I guess.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Sure, but I'm still kinda worried…", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("It's all your fault. You keep feeding her, I'm starting to worry about her weight!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, bad.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka stares at Annie with an injured look. And Annie puts on a sad face.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Now I know how it feels to be a strict mom…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("All right. Don't be so harsh.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Here, Elluka, one last piece of chocolate today. No more. \\nNext, I'll take you to my school.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka is only allowed to move freely between our apartment and school, as required by Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Oh…", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Still, sad.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("I pat her head and take her to school together with Annie.")
	await novel_interface.show_text_only("Hmm, what a nice day. Not too hot, not too cold.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Don't feel bad, honey.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka suddenly raises her head and looks me in the eye, chocolate on her lips.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Sister Lian...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Oh please, don't look at me like this!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka tiptoes to grab my hand and puts it on her head.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Again.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Is this a charm offensive!? \\nOh no, that's something no man could resist!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, you like Lolita, eh?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Hehe, I think so.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hear Nix's voice behind me.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("How could she get near us without any noise?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Sorry, did I scare you?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, just… \\nThat's all right.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I feel ashamed at the thought of being caught staring stupidly at Elluka.")
	await novel_interface.show_text_only("And I'm relieved that Nix doesn't continue this topic. She's so nice and elegant!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Your name is Elluka, right?", "Nix")
	await novel_interface.show_dialog("If you like dessert, next time I'll buy you a sponge cake, all right?", "Nix")
	await novel_interface.show_dialog("I know an amazing bakery in Theater Street. They serve really good maple syrup, tastes almost like caramel.", "Nix")
	await novel_interface.show_dialog("And you're gonna love their signature chocolate cream inside the cake.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka thinks for a while, and nods as she fails to resist the temptation of food.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, you don’t accept food from strangers!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("It's okay. Nix is our senior anyway.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Yeah, but…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Is it just me?")
	await novel_interface.show_text_only("It seems Annie has been wary of Nix since the first time they met.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Then it's a deal, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Deal!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My phone suddenly rings. \\nIt's Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Hello?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ugh, not another mission again!) \\n(Honestly, it's not every day I take Elluka out!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
