# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Sono passati alcuni giorni dalla pubblicazione dell'annuncio di ricerca.")
	await novel_interface.show_text_only("Proprio come previsto da Mariru, l'incidente non sembra avere alcun effetto sulla vita quotidiana delle persone.")
	await novel_interface.show_text_only("Inoltre, non c'è quasi nessuna traccia dell'ingegneria della distrazione di Mariru.")
	await novel_interface.show_text_only("Sembra nient'altro che un incubo.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Buongiorno, sorella Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Essendo una strega con abilità speciali, Elluka è attentamente osservata da SID.")
	await novel_interface.show_text_only("Ma il ragazzo sembra affezionato a me. Mariru me la manda ogni giorno, sostenendo che è semplicemente gentile.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Buongiorno, Elluka. \\nVuoi mangiare qualcosa tra i pasti?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ehi! Non dare troppi snack ai bambini!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Va bene. Non sono certo troppi.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Oh, andiamo, lo dici sempre.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("E va bene che stia con noi tutto il giorno?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("I bambini della sua età dovrebbero andare a scuola. \\nNon è vero?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Umm, non è solo una ragazzina, immagino.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Certo, ma sono ancora un po' preoccupato...", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("È tutta colpa tua. Se continui a darle da mangiare, comincio a preoccuparmi per il suo peso!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, pessimo.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka fissa Annie con uno sguardo ferito. E Annie fa una faccia triste.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ora so come ci si sente ad essere una mamma severa...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Va bene. Non essere così duro.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Ecco, Elluka, un ultimo pezzo di cioccolato oggi. Non più. \\nPoi ti porterò alla mia scuola.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A Elluka è consentito spostarsi liberamente solo tra il nostro appartamento e la scuola, come richiesto da Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Oh...", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Comunque, triste.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Le accarezzo la testa e la porto a scuola insieme a Annie.")
	await novel_interface.show_text_only("Hmm, che bella giornata. Non troppo caldo, non troppo freddo.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Non sentirti male, tesoro.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka alza improvvisamente la testa e mi guarda negli occhi, cioccolato sulle labbra.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Sorella Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Oh per favore, non guardarmi così!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka in punta di piedi mi prende la mano e se la mette sulla testa.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Ancora una volta.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("È un fascino offensivo!? \\nOh no, è qualcosa a cui nessun uomo potrebbe resistere!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, ti piace Lolita, eh?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Eheh, penso di sì.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sento la voce di Nix dietro di me.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Come poteva avvicinarsi a noi senza fare rumore?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Scusa, ti ho spaventato?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, solo... \\nVa tutto bene.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mi vergogno al pensiero di essere sorpreso a fissare stupidamente Elluka.")
	await novel_interface.show_text_only("E sono sollevato dal fatto che Nix non continui questo argomento. È così carina ed elegante!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Il tuo nome è Elluka, giusto?", "Nix")
	await novel_interface.show_dialog("Se ti piace il dolce, la prossima volta ti comprerò un pan di spagna, va bene?", "Nix")
	await novel_interface.show_dialog("Conosco una panetteria fantastica in Theatre Street. Servono uno sciroppo d'acero davvero buono, ha un sapore quasi di caramello.", "Nix")
	await novel_interface.show_dialog("E adorerai la loro caratteristica crema al cioccolato all'interno della torta.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka ci pensa un po' e annuisce mentre non riesce a resistere alla tentazione del cibo.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, non accetti cibo dagli sconosciuti!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Va bene. Nix è comunque il nostro senior.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Sì, ma...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sono solo io?")
	await novel_interface.show_text_only("Sembra che Annie sia stato diffidente nei confronti di Nix sin dalla prima volta che si sono incontrati.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Allora è un accordo, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Affare!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il mio telefono squilla all'improvviso. \\nSono Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Pronto?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Uffa, non un'altra missione di nuovo!) \\n(Onestamente, non capita tutti i giorni di portare fuori Elluka!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
