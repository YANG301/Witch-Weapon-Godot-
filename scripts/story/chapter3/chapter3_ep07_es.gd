# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("Han pasado dos días desde que Mariru me asignó la tarea.")
	await novel_interface.show_text_only("Anoche finalmente llegó la delegación de \"Intercambio Cultural\" al New Opulentia International Airport.")
	await novel_interface.show_text_only("Entonces… Mi misión está por comenzar.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Pero tratar de sacarle información a esa chica ... no lo sé.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("De todos modos, ella no es una chica común y corriente. ¿Qué pasa si ella se niega a hablar conmigo?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("¡Mira a la chica de ahí! Ella no lleva nuestro uniforme escolar.", "Estudiante 1")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("Y la que está a su lado parece una asistente ... ¿Es alguna clase de princesa?", "Estudiante 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro y veo a una chica esbelta con un abrigo verde. \\nElla está parada frente al césped.")
	await novel_interface.show_text_only("El objetivo de mi misión: Raphael Dekkers.")
	await novel_interface.show_text_only("Vi al subdirector y la banda de honor esperando afuera de la puerta de la escuela hace un momento. ¿Se coló en el campus?")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Señorita, por aquí por favor.", "Séquito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Este edificio escolar está diseñado en el estilo Tudor de la época dorada.", "Raphael")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Pero el atrio es demasiado estrecho para mostrar una sensación de grandeza.", "Raphael")
	await novel_interface.show_dialog("Y el tallado en el zócalo es demasiado tosco para soportar la estructura y el diseño.", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("¡Señorita, qué extraordinario gusto tiene por el arte!", "Séquito")
	await novel_interface.show_dialog("La arquitectura Tudor como esta debería tener un atrio más alto.", "Séquito")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, no lo entiendes. \\nSimplemente aumentar la altura no funcionaría.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tiene toda la razón, señorita. También habría que ampliar el césped.", "Séquito")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh? Eso simplemente parecería descoordinado. \\nDespués de todo, todo el patio delantero ya está congestionado...", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Por supuesto. La señorita Raphael ni siquiera llamaría jardín delantero a este terreno desorganizado, ¿verdad?", "Séquito")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Raphael parece algo insatisfecho con estas palabras.")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("… No, eso no es lo que estoy pensando.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("¡Ah! \\n¡Qué amable de su parte, señorita Raphael!", "Séquito")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("¿Por qué su asistente no puede ver que su sonrisa ya está rígida?")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Oye, monstruo travesti.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¿Qué?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(El fenómeno del travestismo ... ¿Está hablando de mí?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ante sus palabras, todos se vuelven para mirarme.")
	await novel_interface.show_text_only("No estoy acostumbrado a tener tantos ojos puestos en mí, siento que me sonrojo.")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("¡No, yo... no soy...! \\n(¡Mariru me hizo usar el uniforme!)", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("Sé un hombre y admítelo, ¿quieres?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("No sabía que New Opulentia era tan liberal como para que un pervertido como tú pudiera ser admitido en una escuela de niñas.", "Raphael")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru, ¡he cambiado de opinión! ¡No quiero hacer esto!")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("Umm… Ren es nuestro compañero de clase. ¡Es una niña!", "Estudiante 1")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("¿Qué? \\nDeja de bromear.", "Raphael")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Raphael parece ofendida.")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("¡Ella no está bromeando! Todos te lo podemos asegurar. \\nRen es absolutamente una niña.", "Estudiante 2")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Gracias por hablar por mí. Pero definitivamente no soy una niña.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("… Tut-tut, pensé que eras un niño.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("¡Por qué! ¡No me parezco en nada a un niño! \\n(Oh, no...)", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("Ugh... Apesta traicionar a mi viejo yo...")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("Muy bien. Olvídalo.", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("¿Qué opinas de la arquitectura de tu escuela?", "Raphael")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No tengo idea de arquitectura. Si insistes...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Simplemente di lo que se te ocurra.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Um ... como edificio escolar, el atrio no es demasiado bajo.", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("El edificio no es agradable a la vista... tal vez porque... ¿no es lo suficientemente lindo?", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Avergonzado por mi pobre vocabulario, trato de captar la expresión del rostro de Raphael.")
	await novel_interface.show_text_only("Como era de esperar, ella sonríe con desdén.")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("¿Lindo? No puedo creer lo que oigo. ¿Es esa palabra todo lo que puedes encontrar para describir una arquitectura?", "Raphael")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bueno, ¡es justo lo que siento al respecto!", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Quiero decir, podría ser mejor… Si los árboles no están perfectamente alineados…", "Lian")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("Umm... \\nComo, eh...", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("Uf… ¿por qué tengo que responder esta pregunta?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Estás tratando de decir que los árboles deberían disponerse alternativamente para agregar más profundidad al diseño?", "Raphael")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exacto. \\n(¿Qué acaba de decir?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("Raphael finalmente me dio una leve sonrisa.")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("¡Ah, un pervertido es mucho mejor que un hombre que dice sí!", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("No, no lo soy…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("Señorita…", "Séquito")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Déjanos. Espérame afuera de la escuela.", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Eres Ren, ¿verdad? Vamos. Muéstrame tu increíble escuela, ¿quieres?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("¿Eh…? \\nNo... ¡Está bien!", "Lian")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
