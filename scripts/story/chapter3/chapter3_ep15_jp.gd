	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("いやいや、ここは地下3階の駐車場だぞ……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("だから何よ？\\n普通でしょ？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("クルッポ─クックッ──", "ハト")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("（……まさかこのお嬢様）\\n\\n（……こういう事に限っては常識がない？）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("たしか治癒系の魔法は小動物を惹きつける力が\\nあったはず。\\nもし、本人に自覚がないのであれば……", "ベアトリーチェ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェが俺の事をラファエルの傍まで\\n引き寄せると、俺達2人の腕をそれぞれ掴んだ。")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("さあ、試してみて──", "ベアトリーチェ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("え？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ベアトリーチェがラファエルと俺の手を\\n重ね合わせる。\\nそして外側から自らの手でしっかりと押さえた。")
	novel_interface.show_character("ren_maid","upset")
