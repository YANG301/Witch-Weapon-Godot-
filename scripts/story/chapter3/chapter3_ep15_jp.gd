	await novel_interface.show_dialog("追手はもう来てないよ。\\n\\nさっきマリルが通信で教えてくれたんだけど、\\nもう1つの通路から撤退したみたい。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("彼女の傷を見せなさい……\\n応急手当は一通り学んでいるわ。", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは付近の台にアニーを寝かせるよう\\n合図をする。\\nそして、すぐに脈拍と呼吸を確認し始めた。")
	novel_interface.show_character("raphael","smile")
