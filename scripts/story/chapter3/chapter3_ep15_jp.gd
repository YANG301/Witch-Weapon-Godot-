	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ラファエル、君はホテルに戻った方がいい。\\nあの連中はすでに撤退した。\\n現在はホテル内での安全を保証できる。", "マリル")
	await novel_interface.show_dialog("それに、お前がいなくなったのを視察団が\\n気付いてしまったら、騒ぎは余計に大きくなる。", "マリル")
