	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("本当だよラファエル！　俺も感じたっ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("……何が魔女よ……\\nあんた達はふざけているのか！？", "ラファエル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ラファエルは相変わらず眉をひそめている。")
	novel_interface.character_light()
	await novel_interface.show_dialog("私に何をしたの！\\nどうして彼女の傷は急に治ったのよ！？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("どうやら、この貴族のお嬢様の世界観に、\\n過去にない程の、大きな衝撃が激突したようだ。\\n俺もどう彼女に説明すればいいか分からない。")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("それに、あの保安軍を襲った連中は何者なのよ？\\nこんな場所で異質物武器を使うなんて……", "ラファエル")
	await novel_interface.show_dialog("何百年も前に亡くなっている人が突如復活して、\\n私がそいつの遺品を持っていて、", "ラファエル")
