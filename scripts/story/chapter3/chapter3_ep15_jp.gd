	await novel_interface.show_dialog("あの狂人達め、女の子一人を相手にこんな……ッ", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("──ねぇ、お嬢さん", "ベアトリーチェ")
	await novel_interface.show_dialog("いきなりで悪いんだけど、あなたの身の回りに、\\n良く小動物が現れたりしないかしら？\\n例えば──", "ベアトリーチェ")
