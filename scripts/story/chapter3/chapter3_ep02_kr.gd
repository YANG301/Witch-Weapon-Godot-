	novel_interface.character_dark()
	await novel_interface.show_text_only("너무 놀라 실감이 나지 않는다. ")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("……미안\\n아니!내가 왜 사과하는 거야!내가 훔친 게 아니잖아!!", "샤오롄")
	await novel_interface.show_dialog("(젠장, 그 녀석 엄청 위험하잖아?)", "샤오롄")
