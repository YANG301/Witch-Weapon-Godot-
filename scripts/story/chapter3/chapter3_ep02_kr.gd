	await novel_interface.show_dialog("지금은 여자라고 해도 관련 인물로 취조를 받을 수 있잖아?", "샤오롄")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("네가 드디어 문제를 파악했구나~", "마리루")
	await novel_interface.show_dialog("정보부가 감시 영상을 확보해서 네 얼굴을 한 녀석을 찾아냈어. 최근에 변이 구역에 나타났더군.", "마리루")
	await novel_interface.show_dialog("우린 제3자의 데이터를 통해 찾아냈지만, 다른 기관도 아마 이 정보를 파악했을 거야.", "마리루")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("상습범인가?\\n어째 내 앞길이 이미 어두워진 것 같아……", "샤오롄")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("순간 수많은 고문을 당하는 화면이 머리속을 스친다……")
	await novel_interface.show_text_only("언제든지 끌려가서 반인류 어쩌고 하는 죄명을 뒤집어 쓰고……")
	await novel_interface.show_text_only("가장 엄격한 감옥에 갇히고,2백 년 이상의 형을 선고 받겠지.")
	await novel_interface.show_text_only("무서운 감방 동기라도 만난다면……")
	await novel_interface.show_text_only("흐아～그만!!!\\n그만 생각하자!!!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("하하하, 겁먹어서 얼굴이 창백해졌네……?", "마리루")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("걱정 마. 신토요스 안에서는 내가 너의 안전을 98% 보호할 수 있어.", "마리루")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("그 말은 2%는 어떻게 될지 모른다는 거잖아?!", "샤오롄")
	await novel_interface.show_dialog("(100초마다 2초의 사고가 일어날 수 있잖아!?)\\n(전혀 안도감이 없다고!!)", "샤오롄")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("연합회의가 역사 상 이렇게 빨리 의견 일치를 본 적이 없어…어쩌면 배후에 내가 모르는 힘이 있을지도 몰라.", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("그리고 이게 바로……그 2%의 확신할 수 없는 요인이야.", "마리루")
