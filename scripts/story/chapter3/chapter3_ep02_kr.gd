	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("바보, 뉴스를 내린 건 공포를 확산시키지 않기 위해서야.\\n수배는 비밀리에 진행되고 있어.", "마리루")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("보안을 위해 수배령이 방위청까지 내려가진 않을 테지만,\\nSID를 포함한 각국의 정보 기관은 이미 통보를 받았어. ", "마리루")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("그러니까 아직 안도의 한숨을 쉬긴 일러~", "마리루")
