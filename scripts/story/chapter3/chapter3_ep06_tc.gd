# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("從總部離開時，除了寫滿相關知識的小冊子，莉琉還將那位貴族大小姐的影像傳到了我的手機。")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("拉斐爾·戴克斯，生於薩蒙頓的名門望族，祖父是蒙頓基因發展公司的主席托馬斯·戴克斯博士。", "小憐")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("哇──這不是教科書上出現過的人物嗎？ \\n不過，怎麼有一種怪怪的感覺……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("抓到了一個落單的美少女！")
	await novel_interface.show_text_only("一雙手從背後摟住了我的身體。")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("哇啊——！", "小憐")
	await novel_interface.show_dialog("……搞什麼嘛，是愛衣啊。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉嚴格規定，要我每次進出異變區域都要接受愛衣的全面檢查和修復。")
	await novel_interface.show_text_only("雖然很不想承認，但愛衣製作的那個機器章魚造型儀器，確實有助於傷口恢復。")
	await novel_interface.show_text_only("更不想承認的是，我似乎已經對她毛手毛腳的舉動習以為常了……")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("什麼嘛，一臉失望的表情！ \\n妳這孩子，太讓人受傷了。", "愛衣")
	await novel_interface.show_dialog("上次從變電所回來以後都沒有好好照顧妳……", "愛衣")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("所以我決定，現在就要帶妳去學校──\\n進行愛的教育！", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("欸？等等——！", "小憐")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("不要這樣拉我的衣服，現在是在大街上啊！ ！", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("我忽然回想起，剛才莉琉叫我回家的時候小心的，\\n大概就是這個傢伙……")
	await novel_interface.show_text_only("我被愛衣一路拉到保健室，只能乖乖的躺在內部休息室的床上。")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("只是檢查嘛……每次都說的那麼嚇人。", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("妳好像有點失望呢，果然應該加一些特殊項目嗎？", "愛衣")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不！ 麻煩妳！ \\n只要普通的體檢就好！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("（而且妳的流程已經非常特殊了！ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣一如往常地把她那架古怪的儀器搬了出來，成像儀上跳躍著難以理解的複雜圖像。")
	await novel_interface.show_text_only("我躺在床上無聊，就拿出手機繼續查看拉斐爾的資料。")
	await novel_interface.show_text_only("螢幕上的拉斐爾一頭深灰色的長髮，淡紫色的瞳孔明亮通透，彷彿能看穿人心。")
	await novel_interface.show_text_only("看著她的照片，我感覺自己的心臟忽然猛烈的跳動，全身也隨之顫抖。")
	await novel_interface.show_text_only("但是很快的又恢復了正常，愛衣還在擺弄著聽診器，似乎完全沒注意到。")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("（剛才是怎麼回事！ ？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("好像透過照片都能感受到，拉斐爾的周圍有一種奇異的氣場，與愛衣的儀器產生了共鳴。")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("這究竟是……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("滴滴滴——滴——")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("什麼聲音？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我抬起頭，看到螢幕上的波形正在劇烈的抖動。")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("哦呀呀，忽然波動的這麼厲害。", "愛衣")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("難道是小憐在偷看什麼讓人臉紅心跳的東西嗎？", "愛衣")
	await novel_interface.show_dialog("比如說……像妳這個年紀的男孩子都會看的那種……", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("才沒有啦！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("奇異的共鳴感消失了。")
	await novel_interface.show_text_only("是被愛衣的胡鬧打斷了嗎……")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("剛才那個突然波動的是什麼參數？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("是……祕·密·喲～", "愛衣")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("……早知道不該問妳的。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("妳好，請問可以進來嗎？", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯從保健室外面輕輕地走了進來。")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("倪克斯學姐！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("妳好呀，小憐，沒想到會在這裡見面。", "倪克斯")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("學姐疑惑地看了看我身邊的儀器，試圖搞清楚我正在做什麼。")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("請問這是……？", "倪克斯")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("倪克斯指了指愛衣手中的藍色四爪型道具。")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("在做人體實驗啦，人體實驗～", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("等等！ 居然這麼大方地承認啦？")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("哦……", "倪克斯")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("對了，愛衣小姐，我身體有點不舒服，請問可以在這裡休息一下嗎？", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("不愧是倪克斯學姐，面對這種發言居然可以忍住不吐槽，並且繼續保持得體的微笑。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("沒問題，妳就在旁邊那張床上休息吧～\\n小憐這邊還需要15分鐘左右。", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣邊說邊將螢幕從儀器上拿了下來，說要去上傳一下剛才的數據。")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("謝謝。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯學姐向愛衣點了點頭，然後走到我旁邊的床上躺下。")
	await novel_interface.show_text_only("那張床距離我大概不到一公尺，學姐並沒有拉上隔簾。")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("（她這麼毫無防備地躺下了嗎？ ）\\n（也對哦，都是女生有什麼好防備的……）", "小憐")
	await novel_interface.show_dialog("（糟糕，心跳得好快。 ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我側過臉，偷偷看著背對我躺在一旁的學姐，連把髮絲撩到耳後的動作也那麼優雅。")
	await novel_interface.show_text_only("這樣的距離，還可以聞到她身上淡淡的香味……")
	await novel_interface.show_text_only("在我有點沉浸在這樣夢幻的氛圍時，倪克斯學姐轉身把臉朝向我，正好和我四目相對。")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("怎麼了？", "倪克斯")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哎！ 啊？ ……\\n那個……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("我猛然清醒過來，就像做了壞事卻被現場逮到的小孩一樣手足無措。")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("怎麼辦，這種時候應該說點什麼嗎？")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("（不對，等等……）", "小憐")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("好像剛才並不是因為害羞而緊張，而是……")
	await novel_interface.show_text_only("小腹處好像傳來陣陣的躁熱感……")
	await novel_interface.show_text_only("這是……和剛才看到拉斐爾的照片產生的感覺有點類似。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("啊啊啊，我該不會已經墮落到對哪個女生都會產生遐想的程度了吧！ ？")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("妳的臉色看起來有點差，沒事吧？", "倪克斯")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("沒、沒事的。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("啊，那是……？", "倪克斯")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("倪克斯學姐的目光停留在我的手機上。 \\n她微微皺眉，有些不悅地盯著螢幕上的照片。")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("倪克斯學姐，妳認識這個人嗎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("不，不認識。", "倪克斯")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("（可是學姐的表情明明那麼厭惡……）\\n（我應該看錯了吧？ ）", "小憐")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
