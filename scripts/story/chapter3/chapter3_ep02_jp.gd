# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("SIDの記録によれば、アルカトラズ収容基地には\\n連合議会がテスト、研究を禁止した──\\nEX級の『異質物』が収容されている。")
	await novel_interface.show_text_only("地下に至っては立ち入りが固く禁止されており、\\n評価及び格付けすら出来ない古代遺跡\\n『シャドウ洞窟』に繋がっている。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX級の『異質物』か……\\nそれってやっぱ、特別に危険な物なのか？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("種類は色々あるが、その大多数が宗教にまつわる\\n『聖物』だ。\\n信徒にとっては特別な意味があるため、それを\\n加味して収容は許されるが研究は許されてない。", "マリル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("許されている範囲と許されない範囲の切り分けが\\n随分と中途半端だな……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("ははっ、私もそう思っているが──\\nまあ、彼らには彼らの理屈があるのだ。", "マリル")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("宗教伝承には、神をも殺す力を持つ品や、終末の審判を引き起こす品がある。", "マリル")
	await novel_interface.show_dialog("ひとたび起動すれば、世界の終末級の災厄を招きかねない。", "マリル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("それは確かに……ヤバい。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("他の一部の物も、叙事詩や歴史物語などでは、\\n神聖な扱いを受けている。\\n試しに使った奴が言うには、効力が弱すぎたり、\\n笑える効果しかなかったらしいが……", "マリル")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("笑える効果って？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("例えば『聖人の靴』は、靴の先端にキスした途端\\n全裸になりたいという謎の衝動に駆られる。\\nそれだと、さすがに宗教のメンツが立たない。", "マリル")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そんな悪趣味なモノもあるのかよ……\\nじゃ、今回失くしたのはどんなタイプなんだ？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("……今回奴に強奪されたのは、全ての学園都市が\\n共同で監視・保護していたEX『異質物』──\\n──『天命の矛』だ。", "マリル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("おおッ！\\nなるほど！ なんか、すごい！", "小憐")
	await novel_interface.show_dialog("で、『天命の矛』って、一体なんなんだ？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…………", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("溜め息を吐いても良いか？", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("し、知らないものはしょうがないだろう！？\\n『天命の矛』っていきなり言われても……\\n俺は普通の高校生だし……", "小憐")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("マリルは仕方なさそうに俺を見た。\\n\\nどうやって俺に分かり易く筋道を立てながら、\\n話そうかを考えているように見える。")
	novel_interface.character_light()
	await novel_interface.show_dialog("要約すると、アレはカテゴリー1に属している。\\n伝承では神殺しの能力を持つ異質物だ。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("公開されている文献において、天命の矛ついての\\n記述は非常にシンプルな2点のみだ。\\n『高温で融解しない』と『振り回すと重くなる』", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("そ、それだけ？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ただ、より研究を重ね、この2つの特性を更に\\n向上させた場合は、\\nXK級の『異質物』になる可能性もある。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("他に発見されていない特質があれば、\\nなおさらの危険性を孕む。\\nそんな物がマスコミの前に露出するなど論外だ。", "マリル")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("俺は思わず唾を飲み込んだ。\\nXK級の『異質物』なら子供でも知っている──")
	await novel_interface.show_text_only("世界崩壊レベルの災害と同等、\\nまたは同レベルの力を持つ『異質物』\\n現在世界で知られているのは6つだけだ。")
	await novel_interface.show_text_only("XK級異質物は、6か所の学園都市のそれぞれが\\n所持・管理している。\\n逆説的に言えばXK級異質物を持つ事で、\\n初めて連合議会の都市承認を得られるのだ。")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("……えっと？\\nつ、つまり……？", "小憐")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ニュースに映っていた「お前」が犯した\\n罪の重さをやっと理解できたか？", "マリル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("驚きすぎて、かえって実感がなくなってきた。")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("…ご…ごめんなさい……\\n\\nって いや違う！ なんで俺が謝るっ！\\n俺が盗んだわけじゃないし！！", "小憐")
	await novel_interface.show_dialog("（くそ～～～アイツ超危険人物じゃないか！）", "小憐")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("で、でもニュースが隠蔽されたのは\\n不幸中の幸いってやつだよな……", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("愚か者めが。\\n表の世界のニュースが取り下げられたのは、\\n世間でのパニックを防ぐため。\\n指名手配は秘密裏に執行されている。", "マリル")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("秘密保持のため防衛庁には届かないが、\\nSIDを含め各国の情報機関は、\\n既に通報を受け取っているはずだ。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("だ～からまだお前がほっとするには\\n早いんだな～～これが。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("やっぱり、あの指名手配犯……\\n俺の元の姿って今危険な状態だよな？", "小憐")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("万が一……万が一だけどっ！誰かが指名手配の\\n写真を調査して、俺の元までたどり着いたら……", "小憐")
	await novel_interface.show_dialog("今でこそ女の子の身体だけど、関係者として尋問される可能性があるってことか？", "小憐")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("や～っと問題点を口に出したな。", "マリル")
	await novel_interface.show_dialog("情報部門が可能な限り、解析できる映像データを\\n入手し、今お前の顔を持っている奴を追跡した。\\n結果として、最近奴がいくつかの異変区域に、\\n現れていた事が判明した。", "マリル")
	await novel_interface.show_dialog("第三者のデータで私達が把握できてしまう以上、\\n他の機関もこれらの情報を容易く入手するだろう", "マリル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("しかも、常習犯かよアイツ。\\nなんだか、俺の人生はお先真っ暗な……", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("無数の拷問を受ける俺……\\n頭の中で、鮮明に映像として構築されていく。")
	await novel_interface.show_text_only("なんだか……\\nいつも誰かに連行されているような気がする……\\nおそらく、これからも反人類罪とか……\\n色々な罪を着せられて……")
	await novel_interface.show_text_only("最も厳しい監獄に閉じ込められて……\\n\\n懲役200年以上の判決に処されて……")
	await novel_interface.show_text_only("超怖すぎる獄友に出会ってしまうかもしれない。\\nそして出会った後は……")
	await novel_interface.show_text_only("のわああぁぁぁ止めろぉッッ！！！\\n考えちゃだめだ　俺ぇぇぇ！！！")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("ははは、そうか顔面蒼白になるほど怖かったか…", "マリル")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("安心しろ！ 私が保証してやる。\\n新豊洲の区域内なら、安全指数は98%だ！", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("ねぇ！ 2%は！？\\n残り2%は一体何なの！？！？", "小憐")
	await novel_interface.show_dialog("（100回運転して2回事故るって事じゃん！？）\\n\\n（全然安心できないんだけど！！）", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("元々、連合議会の老獪どもがここまで早く\\n合意を取り付ける事自体が、前代未聞なんだ……\\nひょっとすると、その裏側では何かしらの\\n私でも知らない力が動いているかもしれない。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("そう……それこそが、2%の不確定要素だ。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("今回の件が、偉い人達の中でどれほどの騒ぎを\\n巻き起こしているのか……\\nもう想像するだけで怖いよ……", "小憐")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("きっと他の学園都市の情報部門も、\\n大量の人的資源を投入して、\\n画面上のアイツを躍起になって、探している\\nのだろうさ。", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("じゃ、じゃあ俺、どうしたらいいの？", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("目に見える敵は手強くない。\\nそういう専門の仕事はSIDに任せておけ。", "マリル")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
