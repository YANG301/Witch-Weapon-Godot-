# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru ส่ง Annie และ Elluka ไปทันทีเมื่อเรากลับไปที่สำนักงานใหญ่")
	await novel_interface.show_text_only("ตอนนี้ฉันอารมณ์เสีย ไม่รู้จะโดนสอบปากคำด้วยคำถามแปลกๆอีกหรือเปล่า…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("เกิดอะไรขึ้น?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("เกิดอะไรขึ้นถ้าไม่มีอะไรเกิดขึ้น? คุณจะยิ้มเยาะต่อ Elluka เหมือนคนโรคจิตหรือเปล่า?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คุณ… คุณต้องดูฉันผ่านกล้องวงจรปิดแน่ๆ!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("อิอิ คิดได้แค่นี้เหรอ?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มันจะเป็นอะไรได้อีก…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("ตัวอย่างเช่น—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru มองฉันอย่างชั่วร้ายตั้งแต่หัวจรดเท้า")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("ฝ่ายวิจัยได้พัฒนาเวเฟอร์ที่สามารถตัดสินใจได้ว่าจะเข้าห้องน้ำเมื่อไร!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("อะไร… ห้องน้ำ? \\nฮึ ฟังดูแย่มาก!", "Lian")
	await novel_interface.show_dialog("ก็ต้องคิดค้นโดยอายะ! \\nเดี๋ยวก่อน อย่าบอกนะว่าคุณแอบฝังมันไว้ในร่างกายของฉัน!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันแค่ล้อเล่น", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("วิธีที่คุณพูดมันไม่ใช่เรื่องตลกเลย!")
