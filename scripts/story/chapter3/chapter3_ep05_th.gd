	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("ขอโทษที่ทำให้คุณผิดหวัง")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อืม… ฉันสงสัยว่าคนธรรมดาอย่างคุณจะขุดข้อมูลจากเป้าหมายหลักได้อย่างไร", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru ปาดน้ำตาแห่งความหัวเราะและทำหน้าเย่อหยิ่งตามปกติของเธอ")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("เป้าหมายสำคัญ... ฟังดูมีความหมายมากกว่าที่จะตอบสนองความต้องการของคุณ... แต่ทำไมคุณบิ๊กถึงไปคุยกับเด็กมัธยมปลายล่ะ!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("คราวนี้คุณจะเข้าใกล้เป้าหมายของคุณในฐานะนักเรียน เป้าหมาย…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers หลานสาวของนายกเทศมนตรีของ Salmonton เธอจะมาพร้อมกับคณะผู้แทน Salmonton", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("เธอเป็นสาวสูงส่งจริงๆ ตื่นเต้น?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("ทำไมฉันต้องตื่นเต้นด้วย?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ตุ๊ดตู่ชอบแต่สาวน้อยใช่ไหมล่ะ?", "Mariru")
