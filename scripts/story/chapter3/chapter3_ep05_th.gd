	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("หน่วยรักษาความปลอดภัยหลวง... หน่วยข่าวกรองของ Salmonton หรือที่รู้จักในชื่อ Rosenkreutz")
	await novel_interface.show_text_only("สำหรับหน่วยสืบราชการลับ มันโด่งดังเกินไป ต้องขอบคุณหนังสายลับหมายเลข 7")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("มันจะทำให้เกิดปัญหาบางอย่างหรือไม่?", "Lian")
