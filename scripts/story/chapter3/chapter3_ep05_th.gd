	await novel_interface.show_dialog("ดังนั้นสิ่งที่คุณต้องทำคือค้นหาจุดประสงค์ที่แท้จริงของการมาเยือนของพวกเขา", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("หน่วยข่าวกรองจัดทำหนังสือเล่มเล็กเกี่ยวกับ Salmonton และตระกูล Dekkers ตอนนี้คุณไปอ่านมันผ่าน", "Mariru")
