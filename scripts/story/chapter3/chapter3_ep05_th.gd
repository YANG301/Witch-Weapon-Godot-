	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("หรือ… มีอะไรแปลก ๆ เข้ามาในใจคุณบ้างไหม?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("เอ่อ ให้ตายเถอะ...", "Lian")
	await novel_interface.show_dialog("(ครั้งสุดท้ายที่ฉันได้วิ่งระหว่างการประชุมของโรงเรียน…) \\n(นั่นหมายความว่า…?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฮ่าๆๆๆ! อย่าไปจริงจังนะ!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru หัวเราะออกมาดังๆ พร้อมลูบหัวฉันอย่างแรง")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อายะเพิ่งสร้างต้นแบบก่อนที่ฉันจะยกเลิกโปรเจ็กต์นี้ \\nทำไมเราถึงใช้มันกับใครเหมือนคุณ!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("เอ่อ ฉันควรจะขอบคุณมั้ยล่ะ?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฮ่าๆ คุณมีความสกปรกอยู่ในใจใช่ไหม?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("อ่า… ขอบคุณพระเจ้าที่ไม่มีเครื่องอ่านใจ! คิดดูสิว่าจะน่าละอายขนาดไหน!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("เฮ้ อย่าดูดมันสิ มันสนุกมากที่ได้ดูคุณต่อสู้กลับ", "Mariru")
