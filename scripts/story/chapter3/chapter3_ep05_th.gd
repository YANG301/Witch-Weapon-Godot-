	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("เมื่อพูดถึง Salmonton… สิ่งที่อยู่ในใจของฉันคือเรือนกระจกสูงหลายสิบหลังที่เรียงรายอยู่ริมแม่น้ำไรน์")
	await novel_interface.show_text_only("สวนเขียวขจีด้านหลังเรือนกระจก… \\nสร้างวอลเปเปอร์ที่สมบูรณ์แบบเสมอ")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("และมีโบสถ์มากมาย ประชาชนทุกคนมีความเชื่อทางศาสนา พวกเขายังได้ก่อตั้งพันธมิตรอันศักดิ์สิทธิ์...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("นั่นคือทั้งหมดที่ฉันจำได้ ฉันไม่เก่งภูมิศาสตร์ ท่องจำข้อเท็จจริงแบบสุ่มมากเกินไป")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Salmontonอำนาจทางเศรษฐกิจและการเมืองส่วนใหญ่ขึ้นอยู่กับการควบคุมยีนของพืชผล", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("แต่เหตุการณ์หลังจากที่ Ross Goblet หายตัวไป กลับกลายเป็นภัยคุกคามร้ายแรงต่อพวกเขา", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("จากการคุกคาม คุณหมายถึง... Spacetime Flux เหรอ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("ถูกต้องแล้ว จากข้อมูลของฉัน มันได้รับผลกระทบจากการไหลหลายครั้ง แต่ยังไม่ทราบความเสียหาย", "Mariru")
	await novel_interface.show_dialog("เมื่อพิจารณาจากความผันผวนของราคาธัญพืชล่วงหน้าเมื่อเร็ว ๆ นี้ ผลกระทบดูเหมือนจะค่อนข้างใหญ่... บางทีความอดอยากจะเกิดขึ้นเป็นระยะ ๆ", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ร้ายแรงมาก!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ฉันไม่รู้อะไรเกี่ยวกับตลาดฟิวเจอร์ส ฉันคิดว่าผลกระทบนั้นจำกัดอยู่ในพื้นที่เล็กๆ")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ใช่… ความล้มเหลวของพืชผลจะไม่ทำให้เกิดอันตรายในทันที ประเทศต่างๆ ก็มีทุนสำรองอยู่แล้ว", "Mariru")
	await novel_interface.show_dialog("ดูเหมือนว่า Salmonton จะเป็นเมืองแรกที่พังทลายลง ในบรรดา Academy Cities ทั้งหมด", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("ได้ส่งการมอบหมายไปยัง New Opulentia ซึ่งกำลังดำเนินการอยู่", "Mariru")
	await novel_interface.show_dialog("ในฐานะผู้นำเข้าอาหารรายใหญ่ เราไม่สามารถปฏิเสธได้", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
