	await novel_interface.show_dialog("แน่นอน. SID ยังประสบปัญหาในการรวบรวมข้อมูลความเป็นมาอีกด้วย", "Mariru")
	await novel_interface.show_dialog("จนถึงตอนนี้ สิ่งที่เกี่ยวข้องกับคุณคือหญิงสาวจะไปเยี่ยมโรงเรียนมัธยมหญิง Gosakuragawa", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("โรงเรียนของฉัน!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
