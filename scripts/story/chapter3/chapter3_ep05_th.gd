	await novel_interface.show_dialog("… อะแฮ่ม \\nอย่างไรก็ตาม คุณอยากให้ฉันได้อะไรจากเด็กสาวที่สูงส่งคนนี้?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฮึ คุณเป็นคนไม่ค่อยพูด… \\nหวังว่าคุณจะผ่านมันไปได้อย่างน้อยหนึ่งวัน", "Mariru")
	await novel_interface.show_dialog("เอาล่ะ จริงๆ แล้วคุณรู้อะไรเกี่ยวกับ Salmonton บ้าง", "Mariru")
