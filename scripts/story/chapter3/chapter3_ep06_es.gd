# chapter3_ep06.gd - 第3章第6话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep06_script()

func play_script():
	pass

func chapter3_ep06_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street3.png")
	await novel_interface.show_text_only("Salgo del Cuartel General con el cuadernillo que contiene todos los detalles de la chica de la jet set. Mariru también me envía fotos de ella por mensaje de texto.")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Nacida en una de las familias nobles de Salmonton, Raphael es nieta del Dr. Thomas Dekkers, presidente de Monton Gene Development Corporation.", "Lian")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Vaya… ¡he leído sobre él en los libros de texto! \\nEsto se está poniendo un poco loco...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Te atrapé! ¡Hola cariño!")
	await novel_interface.show_text_only("Alguien me abraza por detrás.")
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("¡Waah—!", "Lian")
	await novel_interface.show_dialog("… ¡Aya, eres tú! ¿Qué diablos estás haciendo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tengo que someterme a un examen físico completo y a un tratamiento por parte de Aya cada vez que regreso de un Área Flux.")
	await novel_interface.show_text_only("Odio admitirlo, pero el instrumento con forma de pulpo de Aya es muy útil para curar heridas.")
	await novel_interface.show_text_only("Y odio estar acostumbrándome a las acciones psicópatas de Aya...")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("¿Por qué te ves tan decepcionado? \\nEstoy empezando a sentirme herido.", "Ai")
	await novel_interface.show_dialog("No te he cuidado bien desde que regresaste de la Subestación...", "Ai")
	novel_interface.change_expression("dizzy")
	await novel_interface.show_dialog("Así que te llevaré a la escuela... \\nY te daré algunas lecciones inolvidables.", "Ai")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("¿Qué? Esperar…!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("¡Quita tus manos de mí! ¡Está a plena luz del día!", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/School/BG_School_heathRoom.png")
	await novel_interface.show_text_only("El pervertido Mariru me recordó que tuviera cuidado con... \\n¡Debe ser Aya!")
	await novel_interface.show_text_only("Aya me arrastra al centro de salud. No puedo hacer nada más que tumbarme en la cama.")
	novel_interface.show_character("ren_uniform","stare")
	await novel_interface.show_dialog("Sólo un examen físico... Estás siendo demasiado dramático.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Pareces decepcionado. Prefieres un trato especial, ¿eh?", "Ai")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("No, gracias. \\nSolo el chequeo regular, por favor.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("(¡Y tu rutina es bastante especial!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya saca el extraño instrumento como de costumbre. La cámara vuelve a emitir imágenes incomprensibles.")
	await novel_interface.show_text_only("Para matar el tiempo, saco mi celular y sigo leyendo sobre Raphael.")
	await novel_interface.show_text_only("Tiene el pelo largo y gris oscuro. Sus ojos son morados y agudos, como si estuvieran listos para leer la mente de las personas.")
	await novel_interface.show_text_only("Al mirar la foto, siento que mi corazón late violentamente y mi cuerpo comienza a temblar incontrolablemente.")
	await novel_interface.show_text_only("Luego recupero el aliento, todo en un instante. Aya está ocupada con el estetoscopio y no parece haberse dado cuenta de lo que está pasando.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("(¿Qué pasa?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Siento que… incluso a través de la foto, hay algo en Raphael que resuena con el instrumento.")
	novel_interface.show_character("ren_uniform","solemn")
	await novel_interface.show_dialog("¿Por qué…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bip—bip—")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("¿Qué es ese ruido?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La curva en la pantalla fluctúa bruscamente.")
	novel_interface.show_character("ren_uniform","normal2")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","wink",0.25)
	await novel_interface.show_dialog("Vaya, ¿por qué se vuelve loco de repente?", "Ai")
	novel_interface.change_2nd_expression("blush_think")
	await novel_interface.show_dialog("¿He pillado a Ren mirando algo con clasificación X...?", "Ai")
	await novel_interface.show_dialog("¡Olvidé que eres un adolescente!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"awkward")
	await novel_interface.show_dialog("¡No, no lo es!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La extraña sensación de resonancia desaparece.")
	await novel_interface.show_text_only("¿Es interrumpido por Aya?")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("¿Cuál es ese parámetro fluctuante?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ai","blush_think",0.25)
	await novel_interface.show_dialog("Eso es… ¡un secreto!", "Ai")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("… Olvídalo.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Disculpe. ¿Puedo entrar?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix entra rápidamente al centro de salud.")
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("¡Hola, Nix!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Hola, Ren. No esperaba encontrarte aquí.", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Nix se vuelve hacia el instrumento, luciendo desconcertado, como si tratara de descubrir qué estoy haciendo.")
	novel_interface.show_character("ren_uniform","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_normal","speak",0.25)
	await novel_interface.show_dialog("¿Qué es esto…?", "Nix")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Señala el dispositivo azulado de cuatro puntas en la mano de Aya.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Oh, es para experimentos con humanos.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Qué? ¿Dijiste eso directamente?")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Ah...", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, señora Aya, no me siento muy bien. ¿Puedo descansar aquí?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix es increíble. ¿Cómo podía seguir sonriendo sin comentar la sorprendente respuesta de Aya?")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("No hay problema, puedes usar esa cama. \\nMe llevará otros 15 minutos terminar lo que estoy haciendo.", "Ai")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya quita la pantalla del instrumento y sale de la habitación para cargar datos.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Gracias.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix le hace un gesto a Aya y se acuesta en la cama junto a mí.")
	await novel_interface.show_text_only("La cama está a sólo un brazo de distancia. Nix no cierra el telón.")
	novel_interface.show_character("ren_uniform","blush")
	await novel_interface.show_dialog("(¿Simplemente se acuesta así frente a un extraño?) \\n(Ahh sí, todas somos chicas...)", "Lian")
	await novel_interface.show_dialog("(Maldita sea. Mi corazón late rápido).", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy vuelta sigilosamente y la miro furtivamente. La forma en que se mete el pelo detrás de la oreja es muy elegante.")
	await novel_interface.show_text_only("Estamos muy cerca. Incluso puedo oler la leve fragancia en ella...")
	await novel_interface.show_text_only("Mientras me entrego a pensamientos soñadores, Nix se gira y me mira directamente.")
	novel_interface.show_character("ren_uniform","blush")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("¿Qué pasa?", "Nix")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Ah! Ahh… \\nUh…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("De repente recobro el sentido y me siento como un niño al que pillaron haciendo una broma.")
	novel_interface.character_light(0.35,"perspire1")
	await novel_interface.show_text_only("¿Qué debo hacer? ¿Debería decir algo?")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("(No, espera ...)", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_text_only("No me siento nervioso ni tímido... Es...")
	await novel_interface.show_text_only("Siento una sensación de ardor ahí abajo...")
	await novel_interface.show_text_only("Es… una sensación similar cuando vi la foto de Raphael.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Mierda, ¿soy tan dura que cualquier chica me pone cachonda?")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Te ves pálido. ¿Te sientes bien?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí... Está bien, creo.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("¿Quién es ese?", "Nix")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Nix está mirando mi teléfono celular. \\nElla levanta las cejas ante la foto en la pantalla.")
	novel_interface.character_light(0.35,"happy")
	await novel_interface.show_dialog("¿La conoces?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("No, no lo hago.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("(Pero Nix parece disgustada...) \\n(Quizás me equivoqué).", "Lian")

	print("=== 第3章第6话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
