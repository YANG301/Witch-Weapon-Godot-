	await novel_interface.show_dialog("Tại Salmonton, chúng tôi khuyến khích mọi người có tôn giáo riêng, bất kể họ tin vào vị thần nào.", "Raphael")
	await novel_interface.show_dialog("Kết quả của những cuộc di cư ồ ạt sau Chiến tranh Bảy năm, vô số kẻ rác rưởi đã đổ xô vào những nhóm vô dụng đó, và lòng tham của họ không có ranh giới.", "Raphael")
	novel_interface.change_2nd_expression("angry")
