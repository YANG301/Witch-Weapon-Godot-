# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Прошло несколько дней с момента публикации объявления о розыске.")
	await novel_interface.show_text_only("Как и предсказывал Mariru, инцидент, похоже, не оказал никакого влияния на повседневную жизнь людей.")
	await novel_interface.show_text_only("Также почти не осталось следов отвлекающей техники Mariru.")
	await novel_interface.show_text_only("Это похоже на кошмар.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Доброе утро, сестра Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как ведьма с особыми способностями, Elluka находится под пристальным наблюдением SID.")
	await novel_interface.show_text_only("Но ребенок, кажется, привязан ко мне. Mariru присылает ее мне каждый день, утверждая, что она просто добра.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Доброе утро, Elluka. \\nХочешь съесть что-нибудь между приемами пищи?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Эй! Не давайте детям слишком много перекусов!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Фууу…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Это нормально. Это вряд ли слишком много.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Ой, да ладно, ты всегда так говоришь.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("И ничего, что она остается с нами весь день?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Э?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Дети ее возраста должны ходить в школу. \\nНе так ли?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Хм, я думаю, она не просто ребенок.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Да, конечно, но я все равно немного волнуюсь…", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Это все твоя вина. Ты продолжаешь ее кормить, а я начинаю переживать за ее вес!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, плохо.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka смотрит на Annie обиженным взглядом. И Annie делает грустное лицо.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Теперь я знаю, каково быть строгой мамой…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Хорошо. Не будь таким суровым.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Вот, Elluka, сегодня последний кусочек шоколада. Больше не надо. \\nДалее я отвезу тебя в свою школу.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka разрешено свободно перемещаться между нашей квартирой и школой только в соответствии с требованиями Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ох…", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… И все же грустно.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Я глажу ее по голове и отвожу в школу вместе с Annie.")
	await novel_interface.show_text_only("Хм, какой хороший день. Не слишком жарко, не слишком холодно.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Не расстраивайся, дорогая.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka внезапно поднимает голову и смотрит мне в глаза с шоколадом на губах.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Сестра Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Ой, пожалуйста, не смотри на меня так!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka на цыпочках хватает мою руку и кладет ее себе на голову.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Опять.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Это наступление обаяния!? \\nО нет, перед этим не сможет устоять ни один мужчина!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Тьфу-тьфу, тебе нравится Лолита, да?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Хе-хе, я так думаю.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я слышу позади себя голос Nix.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как она могла подойти к нам бесшумно?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Простите, я вас напугал?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Нет, просто... \\nВсе в порядке.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Мне стыдно при мысли, что меня поймают на том, что я тупо смотрю на Elluka.")
	await novel_interface.show_text_only("И я рад, что Nix не продолжает эту тему. Она такая милая и элегантная!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Тебя зовут Elluka, верно?", "Nix")
	await novel_interface.show_dialog("Если тебе нравится десерт, в следующий раз я куплю тебе бисквит, ладно?", "Nix")
	await novel_interface.show_dialog("Я знаю замечательную пекарню на Театральной улице. Там подают действительно хороший кленовый сироп, по вкусу почти как карамель.", "Nix")
	await novel_interface.show_dialog("И вам понравится их фирменный шоколадный крем внутри торта.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka некоторое время задумывается и кивает, не в силах устоять перед искушением поесть.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, ты не принимаешь еду от незнакомцев!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Все в порядке. Nix в любом случае наш старший.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Да, но…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это только я?")
	await novel_interface.show_text_only("Кажется, Annie опасается Nix с момента их первой встречи.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Тогда дело сделано, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Сделка!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мой телефон внезапно звонит. \\nЭто Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Алло?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ух, опять не миссия!) \\n(Честно говоря, я не каждый день вытаскиваю Elluka!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
