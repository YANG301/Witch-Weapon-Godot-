# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Corremos até o estacionamento subterrâneo conforme orientação de Mariru.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru me disse que os homens do Administrador saíram de outra saída em vez de correr atrás de nós.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Deixe-me verificar o ferimento dela... Já aprendi primeiros socorros antes.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael me sinaliza para colocar Annie em uma superfície plana. Então ela verifica o pulso e a respiração de Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Felizmente, não há v-fib, embora sua respiração seja bastante superficial e as queimaduras sejam graves. Não faço ideia se há alguma lesão interna…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Isso é brutal! Tratar uma garota assim!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Hmm… Senhorita?", "Beatrice")
	await novel_interface.show_dialog("Você costuma atrair pequenos animais? \\nPor exemplo—", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nós nos viramos e olhamos. Há dois pombos perto de nós.")
	await novel_interface.show_dialog("Coo— Coo—", "Pombo")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("O que há de estranho nisso? Os pombos são encontrados em todos os lugares.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Não, aqui é o Porão Três!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("E daí? \\nEles não são animais em extinção.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Coo— Coo— Coo—", "Pombo")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(... Nobreza, hah. Nenhum bom senso.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("A magia de cura atrai pequenos animais. Mas se ela não está ciente disso...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice me puxa para mais perto de Raphael, pegando as mãos dela e as minhas.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Venha, tente isso—", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Hum?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice coloca minha mão na de Raphael e pressiona nossas mãos com força com a palma.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("O que você está fazendo?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Eu não esperava que a mão de ... \\nRaphael fosse tão macia e quente ...")
	await novel_interface.show_text_only("Não, espere! \\nEu sou—")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Segurando as mãos dela…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Vejo surpresa e raiva no rosto de Raphael. Ela está olhando para mim, quase cuspindo fogo.")
	await novel_interface.show_text_only("Estremeço com a ideia de ser chamado de pervertido e espancado até ficar preto e azul.")
	await novel_interface.show_text_only("De repente, Raphael se vira para olhar para Beatrice, como se percebesse algo. Beatrice acena levemente com a cabeça.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael fecha os olhos, com uma expressão intensa no rosto. E Beatrice afasta lentamente a palma da mão.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(O quê? Ela gosta de segurar minha mão?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, um calor agradável percorre meu corpo e me sinto mais relaxado do que nunca.")
	await novel_interface.show_text_only("Ufa— De repente me dei conta de que o ar é tão fresco, mesmo em seu estacionamento subterrâneo.")
	await novel_interface.show_text_only("E de alguma forma a cena horrível para de me assombrar.")
	await novel_interface.show_dialog("Ah-em…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vejo as cicatrizes de queimaduras no corpo de Annie desaparecendo a uma velocidade incrível.")
	await novel_interface.show_text_only("O calor diminui gradualmente. Raphael dá um suspiro de alívio e abre os olhos.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, onde estamos...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie olha para mim sonolento, como se tivesse acabado de acordar.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Estamos seguros agora. Apenas esperando por Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Por que…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Você não… notou isso antes?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Uma bruxa com uma magia de cura tão maravilhosa... \\nVocê é incrível!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Sim, sério! Eu também senti a magia!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Bruxa? Magia? Que bobagem!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael franze a testa severamente.")
	novel_interface.character_light()
	await novel_interface.show_dialog("O que você fez comigo? \\nPor que suas feridas cicatrizam tão rapidamente?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu sei que é difícil assimilar tanta informação de uma só vez. Então eu permaneço em silêncio.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Quem são aqueles que atacam nossos soldados de segurança? \\nComo eles ousam usar a arma Substance H aqui…", "Raphael")
	await novel_interface.show_dialog("Por que uma pessoa morta há centenas de anos de repente ganhou vida? E eu estou usando o colar dela!", "Raphael")
	await novel_interface.show_dialog("E eu vi… \\nO pesadelo…", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz de Raphael treme ao pensar na cena horrível.")
	await novel_interface.show_text_only("Eu vou para Beatrice. Um sorriso calmo aparece em seu lindo rosto.")
	await novel_interface.show_text_only("A esmeralda voltou ao seu estado original e Beatrice a devolveu a Raphael.")
	await novel_interface.show_text_only("Parecia que aquela cena aterrorizante de pouco tempo atrás não tinha nada a ver com ela.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("A magia do Livro dos Sete Filósofos perturba a mente... \\nÉ perfeitamente normal sentir medo no primeiro encontro.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Mas o medo é uma emoção importante. Conhecer sua fraqueza o ajuda a sobreviver às crises.", "Beatrice")
	await novel_interface.show_dialog("O que é realmente horrível são aqueles dominados pelo medo…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice parece ser atraída pelas memórias, com uma expressão triste nos olhos.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Seja como for, preferiria nunca ter aberto esse livro e nunca ter feito esse desejo…", "Beatrice")
	await novel_interface.show_dialog("E nunca... ganhei o poder amaldiçoado...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Amaldiçoado?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("O Grimório me dotou de uma magia... \\nNão consigo me controlar para não exalar um encanto que atrai os homens.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(É por isso que…!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice se vira para mim e bate na minha garganta com a ponta do dedo.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Posso fazer uma pergunta?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Sim… por favor!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Seu nome é Ren, certo? \\nVocê é especial…", "Beatrice")
	await novel_interface.show_dialog("Quando menina, você deveria ser imune ao meu charme. Então, por que você ... estava olhando furtivamente para mim?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Ela notou! \\nMuuuuita vergonha!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Mas... ao contrário dos homens, você não perde completamente o controle... nem se comporta como um louco.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(É por causa da minha magia?…) \\n(Não, não, não, perdi completamente o controle!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice levanta lentamente meu queixo com um dedo e depois toca suavemente meu nariz.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Não me importo com ... Honestamente, tenho que admitir ... você é fofo.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Eu engulo inconscientemente.")
	await novel_interface.show_text_only("Isso ... é apenas o efeito da magia?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pouco tempo depois, uma limusine SUV preta parou na nossa frente.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, entre!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, certo? Espero que você vá conosco.", "Mariru")
	await novel_interface.show_dialog("Encontrei todos os documentos disponíveis… Caso você se interesse pela vida de quem você conhece.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Seu admirador secreto, o poeta, escreveu versos que foram transmitidos ao longo dos séculos.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Tudo bem. Também estou interessado nessa fofura aqui.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Encontrando os olhos de Beatrice, eu coro novamente…")
	await novel_interface.show_text_only("É… Isso é realmente apenas o efeito da magia dela?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("E Raphael, volte para o seu quarto. A turma já foi embora. É seguro agora.", "Mariru")
	await novel_interface.show_dialog("Se a delegação descobrir que você desapareceu… Você não vai querer assustá-los, sabe.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Carregamos contrabando... e causamos tanta agitação...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael olha para Beatrice. \\nBem, o contrabando se transformou em uma bela dama. Que fofo!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("E você está me deixando ir assim?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Em troca, o Dr. Dekkers concordou que meus comerciantes designados serão os primeiros na fila para os produtos de Salmonton no próximo ano.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("E ele também prometeu fechar os olhos às minhas atividades comerciais na Bolsa de Futuros de Newmoridas.", "Mariru")
	await novel_interface.show_dialog("O acordo já está na minha mesa do escritório. Então, fique tranquilo. SID não é um grupo de caridade.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Espere! Arriscamos nossas vidas apenas para você ganhar dinheiro!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tudo bem. Prometo que não contarei a ninguém sobre esse incidente antes de resolver tudo.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("É um prazer trabalhar com o Dekkers.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, com certeza vou descobrir essa coisa mágica depois de voltar ao Salmonton!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Por favor, faça! Eu acho que você realmente tem um poder mágico maravilhoso.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se vira, mas para abruptamente. \\nEla tira o colar e joga para mim.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Isto é da coleção de sua família, não é? Como você pode…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("É seu agora.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Uma garota galante! Você se tornará uma senhora notável quando crescer.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, não vou esquecer de fazer uma verificação de seus antecedentes.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Tome cuidado, pessoal. Nos encontraremos novamente.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
