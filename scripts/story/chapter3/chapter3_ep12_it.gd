# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("L'Aerogel Spray è un'arma simile alla lacca per capelli inventata dalla Dr. Aya. Produce grandi quantità di schiuma in una frazione di secondo.")
	await novel_interface.show_text_only("Una volta in aria, la schiuma si gonfierà e si solidificherà rapidamente, diventando così dura da essere impenetrabile anche dai proiettili.")
	await novel_interface.show_text_only("Mentre Annie sigilla la porta con l'aerogel, sono nuovamente attratto dalla farfalla dorata sul pavimento.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Sembra semplicemente un'opera d'arte meravigliosa...)", "Lian")
	await novel_interface.show_dialog("(Ma ... non posso farci niente ... voglio davvero toccarlo ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un desiderio ardente mi prende e tutto davanti a me emana un bagliore abbagliante. Non posso fare a meno di contattarti...")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Fermare!! Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie mi afferra il polso. Poi all'improvviso torno in me.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Forse questa cosa può invadere la mente delle persone... È per questo che devono tenerla in quella valigia?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ah! Ho quasi ... cosa diavolo ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Questa farfalla dorata mi sembra familiare... \\nSospetto che si tratti di un frammento di strega.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Un frammento di strega?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hmm, come dovrei dirlo...", "Annie")
	await novel_interface.show_dialog("Il potere magico è in realtà un tipo di conoscenza che il cervello umano assorbe da un tipo unico di \"informazioni\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Ma le persone ottengono e si assicurano questa conoscenza di solito a costo della loro sanità mentale.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mi vengono in mente le streghe nella sottostazione e i nemici nelle aree di flusso.")
	await novel_interface.show_text_only("La loro follia deve essere causata dall'eccessivo accumulo di \"conoscenza\" che il loro corpo non può sopportare.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Le \"informazioni\" possono effettivamente essere suddivise in parti e archiviate separatamente. Il Frammento di una strega è un contenitore di piccoli pezzi di \"informazione\".", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Per quanto riguarda il motivo di questo design, immagino che sia stato creato per consentire agli esseri umani di superare i propri limiti...", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Per capire fino a che punto possono farla franca senza perdere la sanità mentale, usano i frammenti della strega per assorbire la conoscenza poco a poco?", "Lian")
	await novel_interface.show_text_only("L'atto in sé sembra già abbastanza folle!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Continuare a desiderare e perseguire nuove conoscenze senza fine: se non altro, questa è la natura umana ...", "Annie")
	await novel_interface.show_dialog("Anche se sono destinati alla distruzione ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa succede se una ragazza normale ottiene il frammento della strega, ma non ha l'abilità di usarlo \\nDiventerà una delle streghe che abbiamo incontrato nella sottostazione...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Molto probabile. E non c'è nessuno scudo attorno al frammento della strega, quindi chiunque può toccarlo direttamente.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Non è super pericoloso allora?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Bum! \\n—Bum!")
	await novel_interface.show_text_only("Dall'esterno della stanza giungono suoni bassi e profondi di colpi pesanti sulla porta di legno.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("I soldati della sicurezza!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Crepa!! \\nDopo soli due colpi, la porta della Suite Reale viene fatta a pezzi da uno scassinatore.")
	await novel_interface.show_text_only("—Tonfo! —Tonfo! —Tonfo! \\n—Bum! —Tonfo! —Tonfo!")
	await novel_interface.show_text_only("Poi arrivano i suoni degli scassinatori che colpiscono invano la solida schiuma di aerogel.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Forse potrebbe resistere fino all'arrivo della signora Mariru... \\nVedi, l'invenzione della dottoressa Aya funziona!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi tocco il petto, dove Mariru ha piantato l'altoparlante a mia insaputa.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Aha... \\nSì, funziona...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, Raphael ormai sveglia, si lancia verso di me, la sedia ancora legata al corpo.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Mai… porterai via nulla!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Pervertito montato sugli altoparlanti!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael si libera mentre la sedia tocca il pavimento. Quindi si precipita ad afferrare la farfalla d'oro.")
	await novel_interface.show_text_only("Vedendo questo, balzo verso la farfalla, quasi sul punto di schiantarmi contro di lei...")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("No, Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_dialog("(Uh? Ho capito?) \\n(Ops...)", "Lian")
	await novel_interface.show_dialog("(La cosa morbida è...)", "Lian")
	await novel_interface.show_dialog("(Mi sembra familiare. L'ho appena toccato)", "Lian")
	await novel_interface.show_dialog("(Aspetta. Potrebbe essere...!)", "Lian")
	await novel_interface.show_dialog("…Tu!", "Raphael")
	await novel_interface.show_dialog("Pervertito!!!", "Raphael")
	await novel_interface.show_text_only("—Schiaffo!")
	await novel_interface.show_text_only("Lo schiaffo sonoro mi dà le vertigini.")
	await novel_interface.show_text_only("Immagini visive mi attraversano la mente, tutto si è spento in un istante.")
	await novel_interface.show_text_only("Mi sento come in un altro mondo. La strana sensazione scompare in un batter d'occhio.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Quando apro gli occhi mi ritrovo ancora nella Royal Suite.")
	await novel_interface.show_text_only("L'accessorio dorato si anima e si posa sul mio petto, irradiando una luce scintillante.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Come sarebbe questo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando la luce si affievolisce e gradualmente scompare, sento il mio viso accarezzarmi dolcemente. Quel tocco morbido e magico è impresso nella mia mente.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("—Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nello spazio aperto di questa stanza appare una donna meravigliosa.")
	await novel_interface.show_text_only("I miei occhi sono fissati sui suoi occhi e capelli rosso chiaro, sul corpo snello e sulla pelle color giada.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(…Cosa è successo?) \\n(Le mie labbra sono state toccate da qualcosa!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(…Ahahah, niente!) \\n(A cosa stavo pensando? È impossibile!)", "Lian")
	await novel_interface.show_dialog("(No… non impossibile!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Merda, la sensazione... La sensazione...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, il calore perduto da tempo del corpo umano.", "Donna inaspettata")
	await novel_interface.show_dialog("Buonasera, signorine!", "Donna inaspettata")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il mio cuore batte più forte. Non posso fare a meno di camminare verso di lei. Le mie membra non sono più mie.")
	await novel_interface.show_text_only("Allargo le braccia e le avvolgo strettamente attorno a lei, sotto gli occhi di tutti.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Ciao, tesoro. Non ti senti bene, vero...?", "Donna inaspettata")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Scusami…", "Lian")
	await novel_interface.show_dialog("Posso sapere il tuo nome, per favore...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("È strano. Il suo corpo sembra diventare sempre più pesante... \\nE la sua temperatura aumenta...")
	await novel_interface.show_text_only("Cosa c'è che non va in me!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ooh la la! \\nÈ così incredibile.", "Donna inaspettata")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie mi trascina lontano dalla donna.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Chi… sei?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Se il mio nome non è un tabù nella tua epoca… Per favore chiamami Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Che bel nome…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren... \\nInizi a sembrare un cane cornuto!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
