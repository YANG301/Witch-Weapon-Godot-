# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Eu estava me sentindo inquieto durante a turnê do Raphael pelo campus.")
	await novel_interface.show_text_only("Nunca pensei que pudesse me aproximar do alvo tão facilmente.")
	await novel_interface.show_text_only("O vice-diretor, vendo sua cerimônia de boas-vindas há muito preparada ser frustrada, corta um lenço com ressentimento em algum lugar atrás de nós.")
	await novel_interface.show_text_only("No entanto, a jovem não parece satisfeita com o nosso pequeno passeio, embora esteja com um humor muito melhor agora.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("É isso?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hum-hum, se você quer dizer o passeio.", "Lian")
	await novel_interface.show_dialog("Se continuar por esse caminho, chegará à zona comercial.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Muitos edifícios aqui imitam estilos arquitetônicos anteriores à guerra, tentando trazer um senso de cultura.", "Raphael")
	await novel_interface.show_dialog("Mas este campus é tão pequeno que não há separação entre edifícios de estilos contrastantes.", "Raphael")
	await novel_interface.show_dialog("Isso torna tudo muito sufocante aqui, você não acha?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia é uma cidade reconstruída sobre ruínas. A maioria de seus locais históricos foram incendiados.")
	await novel_interface.show_text_only("Na verdade, é muito luxuoso ter um pedaço de terra dentro do escudo protetor onde a terra é escassa.")
	await novel_interface.show_text_only("De alguma forma, me sinto ofendido por suas palavras...")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Hum…", "Lian")
	await novel_interface.show_dialog("Você deve ser Raphael Dekkers da Quarta Cidade Acadêmica.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Então por que você visita a escola se não gosta daqui?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Uau, você sabe quem eu sou?", "Raphael")
	await novel_interface.show_dialog("Hm… É tudo por causa do meu avô. Ele quer que eu estude em outra cidade acadêmica…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mas essa escola imitadora, sem nenhuma história... eu nunca mais colocaria os pés nela.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Então ela está simplesmente infeliz com o plano do avô…) \\n(Por que ela simplesmente não falou?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Merda! Suas palavras de alguma forma me afetaram. Todos os prédios da escola de repente parecem estranhos.")
	await novel_interface.show_text_only("Droga! Esqueça esses comentários! Agora!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Uau, já que você está tão decepcionado...", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Por que você não diz ao seu avô o que você pensa?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix vem até nós, elegante como sempre.")
	await novel_interface.show_text_only("Quando seus olhos se encontram, acho que ouço o som crepitante de uma descarga de alta voltagem.")
	await novel_interface.show_text_only("Deve ser… uma alucinação, certo?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Quem é você?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Bem, eu sou simplesmente um ninguém nesta escola.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Só estou me perguntando o que a traz aqui, minha senhora?", "Nix")
	await novel_interface.show_dialog("Por que você concordou em vir aqui em primeiro lugar? É por causa da pressão familiar?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Meu assunto de família não é da sua conta.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Deixe-me adivinhar. Uma criança egocêntrica que nunca desafiou a vontade dos pais.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Por que você se considera superior? Quem lhe dá o direito de julgar uma escola? Afinal, ela se ofereceu para lhe mostrar o local.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Perdão?! Quando me considerei superior?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Ei, seu pervertido. Já fui tão arrogante?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Na verdade não…", "Lian")
	await novel_interface.show_text_only("Espere, eu não sou um pervertido!")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Veja? Eu não disse isso.", "Raphael")
	await novel_interface.show_dialog("A propósito, a coisa em volta do seu pescoço...", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Jóias são permitidas nesta escola?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Na verdade, não temos nenhuma restrição ao uso de enfeites…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E o colar de Nix é tão fofo!")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("A banda pode ser discreta, mas definitivamente não é a joia dela – o Orlov Black Diamond. Esta joia real quebrou em três pedaços e foi perdida durante a turbulência antes do início da guerra.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Você provavelmente pode comprar alguns prédios aqui com apenas uma peça.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("O que?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Fazendo-se passar por um estudante comum e falando por eles... O que você quer? Para enganar essa pervertida travesti dizendo que você está do lado dela?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pare de me chamar de pervertido!")
	await novel_interface.show_text_only("E por que Nix tem essa aparência sutil de desculpa?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Só estou vestindo algo que combina comigo.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("E você? Você tenta parecer independente, mas se orgulha de desfrutar da riqueza de sua família. Isso é hilário.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Lembro-me que todas as três peças caíram nas mãos de um chefe da máfia. Um Diamante Negro comprado com dinheiro obtido de forma ilícita – combina bem com você.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bem, tenho que admitir que minha família é menos afortunada. Afinal, nem todos podem ganhar uma fortuna e um título de nobreza através do monopólio dos grãos.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Isto porque só as nossas colheitas poderiam ajudar as pessoas a prevenir a Peste Negra. Eles merecem viver. Ao contrário de você, podre de dentro para fora.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você insiste em manter a fé enquanto ameaça o mundo com a fome. Por que você não reflete primeiro sobre sua própria alma?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Não preciso fazer isso com pessoas como você. Isso só vai me trazer vergonha.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Ah, isso parece familiar. Também não quero saber de vocês, perdedores.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("O sol da tarde brilha suavemente sobre nós.")
	await novel_interface.show_text_only("Entre os dois, não tenho ideia de como resolver essa briga.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Tem certeza de que não se conheceram antes?)", "Lian")
	await novel_interface.show_dialog("(Vocês realmente não são inimigos para toda a vida?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O vice-diretor à distância já surtou e foi levado para tratamento de emergência.")
	await novel_interface.show_text_only("Não importa. Tenho todas as informações que Mariru deseja.")
	await novel_interface.show_text_only("De qualquer forma, não é da minha conta.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
