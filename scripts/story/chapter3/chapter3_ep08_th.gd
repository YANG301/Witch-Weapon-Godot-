	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("อะไรนะ!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("แกล้งทำเป็นนักเรียนธรรมดาๆ และพูดแทนพวกเขา... คุณต้องการอะไร? เพื่อหลอกพวกแต่งตัวประหลาดนี้ที่คุณอยู่ข้างเธอเหรอ?", "Raphael")
