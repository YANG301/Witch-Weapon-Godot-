	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(เธอเลยไม่พอใจกับแผนของปู่ของเธอ…) \\n(ทำไมเธอไม่พูดออกมาเลย!)", "Lian")
