	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("นั่นเป็นเพราะพืชผลของเราเท่านั้นที่สามารถช่วยให้ผู้คนป้องกันกาฬโรคได้ พวกเขาสมควรที่จะมีชีวิตอยู่ ต่างจากคุณที่เน่าเสียจากภายในสู่ภายนอก", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
