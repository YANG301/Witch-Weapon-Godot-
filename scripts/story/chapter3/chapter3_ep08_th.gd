	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ฉันต้องยอมรับว่าครอบครัวของฉันโชคดีน้อยกว่า ท้ายที่สุดแล้วไม่ใช่ทุกคนที่จะได้รับโชคลาภและตำแหน่งอันสูงส่งจากการผูกขาดธัญพืช", "Nix")
