# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Cơn ác mộng kỳ lạ, cuộc trò chuyện mơ hồ, bóng tối trong giấc mơ. \\nCộng với thông báo cảnh báo đỏ…")
	await novel_interface.show_text_only("Ngay khi tôi chuẩn bị chấp nhận danh tính mới của mình và quyết định vực dậy bản thân thì họ lại làm mọi thứ rối tung lên.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ừm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Bạn đã xem tin tức chưa? \\nLà anh ấy! Không, tôi, là tôi!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Tôi không mù. Tất nhiên, tôi biết trước mặt tôi là em, em đang đổ mồ hôi, cô gái ngốc nghếch.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Không! \\nChết tiệt. là tôi trên bản tin!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trong cơn hoảng loạn, tôi thậm chí không biết bắt đầu từ đâu. \\nMariru càu nhàu và dùng tay gõ vào đầu tôi.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Đúng là một tên ngốc vô dụng. Sau tất cả những khóa đào tạo này, bạn thậm chí không thể báo cáo rõ ràng với sĩ quan của mình.", "Mariru")
	await novel_interface.show_dialog("Không phải đó chỉ là về một anh chàng trông giống như bạn đang bị truy nã trên toàn thế giới vì anh ta đột nhập vào Trung tâm Nghiên cứu và Thu thập của Thành phố Học viện Thứ hai sao?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vâng, vâng, vâng! Chính xác!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Cơ quan tình báo đã báo cáo tin tức này rất lâu trước khi nó được lan truyền rộng rãi.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Bạn trông thật ngớ ngẩn khi bạn sợ hãi~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru nhéo má tôi. Tôi đã cố gắng ngăn cô ấy lại ngay lập tức.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, nghiêm túc đi!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Bị truy nã gắt gao nhất trên toàn thế giới. Đó không phải là một trò đùa!", "Lian")
	await novel_interface.show_text_only("Tôi chưa bao giờ có thể nghĩ đến việc một ngày nào đó tôi sẽ được đưa tin về khoản trợ cấp.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Và đó là một thông báo ba chữ A! Theo tôi nhớ, kẻ bị truy nã cuối cùng với mức độ cảnh giác như vậy đã bị một kẻ phá boongke đánh bom chết ở Nam Mỹ.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Tên trộm chết tiệt này đã đánh cắp danh tính trước đây của tôi như thế… Tôi gần như rơi nước mắt khi nghĩ đến điều này.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Trong trường hợp này… \\nNgười duy nhất tôi có thể tin cậy là Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Anh rất muốn nhìn em đau khổ như thế này…", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Tôi phải yêu cầu bạn kiểm tra lại tin tức.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("Có cần thiết không? Tôi đã khắc ghi toàn bộ điều đó vào tâm trí rồi.")
	await novel_interface.show_dialog("Hình ảnh có thể không sắc nét và rõ ràng, nhưng tôi chắc chắn rằng anh ấy trông gần giống hệt tôi khi còn bé!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Để chứng minh điều mình vừa nói, tôi mở tin tức trên điện thoại.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Thấy chưa, đây là… \\nEh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lệnh truy nã khiến tôi hoảng sợ đã không còn nữa. Nó được thay thế bằng một thông báo người mất tích thông thường.")
	await novel_interface.show_text_only("Họa sĩ truyện tranh bảy mươi tuổi ông Inoue đã mất tích gần đây. \\nNếu ai biết tung tích của anh ta hãy liên hệ ngay với cảnh sát.")
	await novel_interface.show_text_only("Tôi đã kiểm tra các trang web khác và thậm chí còn tìm kiếm bằng từ khóa, nhưng không tìm thấy tin tức nào cả.")
	await novel_interface.show_text_only("Nhìn vào khuôn mặt nói với bạn của Mariru, tôi rất biết ơn.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Có phải là bạn…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru đến lau nước mắt cho tôi.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nhìn bạn kìa - tất cả đều nghẹn ngào.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Nếu bạn thực sự muốn cảm ơn tôi—hãy làm nô lệ của tôi nhé~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Và…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Khi bạn nói \"người duy nhất tôi có thể tin cậy là Mariru\", \\nbạn trông thật dễ thương…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru nhẹ nhàng nâng cằm tôi lên bằng ngón trỏ của cô ấy.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Này, dừng lại đi!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Theo những gì tôi thấy, tôi đã trở thành nô lệ rồi…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Tôi ước gì tôi có thể làm được điều đó. Nhưng theo hiểu biết của tôi, chỉ có một cơ quan có thể đóng cửa toàn bộ mạng xã hội trên toàn thế giới.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ơ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Đó chắc hẳn là một mệnh lệnh hành pháp từ Quốc hội Thống nhất.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quốc hội tối cao đại diện cho cả sáu Thành phố Học viện… quyết định gỡ bỏ tin tức này?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Tại sao…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru nhìn tôi và nở một nụ cười bí ẩn.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Đừng ngớ ngẩn. Rõ ràng, họ không làm điều này để bảo vệ tên trộm.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Họ chỉ không muốn công chúng biết những gì đã bị chụp.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tên trộm này là ai? Tại sao anh ta lại sử dụng danh tính của tôi?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Dù anh ta là ai thì chắc chắn anh ta phải là thiên tài mới có thể nguyên vẹn thoát ra khỏi Trung tâm Nghiên cứu và Thu thập Akatraz.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Vấn đề là, anh ấy không khó để che mặt.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Nhưng anh ta không làm vậy, thậm chí còn dám lên nóc tòa nhà một lúc…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Theo quá trình huấn luyện đặc biệt, những thứ không đáng kể nhất đều vắng mặt ở nơi chúng đáng lẽ phải xuất hiện…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Hoặc có mặt ở nơi họ không nên có mặt.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
