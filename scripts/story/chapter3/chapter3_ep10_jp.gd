# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("スクルドが登場したお陰か、ファビオラとかいう\\n凶暴メイドは俺を見逃してくれるようだ。")
	await novel_interface.show_text_only("スクルドは俺との邂逅が終わった途端、\\n身なりが整ったゲスト達に取り囲まれながら、\\n挨拶を始めていた。")
	await novel_interface.show_text_only("イルカと歳が変わらないぐらいの女の子なのに、\\nこんな社交場でスムーズに対応ができるなんて…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("（あの子は……どこかの家のお嬢様なのか？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ファビオラが小さな主人に気を向けている間に、\\n俺は素早く宴会場の反対側へと逃げた。")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("ふぅ、肝が冷えたよ……\\nあの2人は主従関係だったのかな？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("あのメイドも俺の正体をバラす気はなさそうだ。\\nあんな事を怖い事を言いつつも、\\n実の所は俺を試していたのかもしれない。")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("レンちゃん、探したよ！", "アニー")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("実は、重要な手掛かりが見つけちゃったかも！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("え？", "小憐")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("さっき、視察団の人にこっそり付いて行って、\\nエグゼクティブフロアに上がったの。\\nそしたら、ラファエルの従者さんが少し特別な\\nアタッシュケースを持っているのを見たのよ。", "アニー")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("アタッシュケース……？\\n中には何が入っていたんだ？", "小憐")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("う～ん。\\nさすがに中身までは確認できなかったけど、\\nあのアタッシュケースの材質はSIDの訓練で\\n前に学んだやつだったのよ！", "アニー")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("あのケースは灰緑色の金属で出来ていて、\\n周囲に独特な薄青い光を漂わせていたわ。", "アニー")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("青い光……\\nって…ま、まさかっ！！", "小憐")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("俺も習ったことを思い出した。\\n\\nそれは精神系やミーム系『異質物』の影響力を\\n弱めたり、遮断できたりする合金の特徴だ。")
	await novel_interface.show_text_only("たしか、その合金で制作した容器に『異質物』\\nを入れると、大体の色相スキャンを回避できた。")
	await novel_interface.show_text_only("合金自体も異質物であって、質量の98%は\\n既知の金属、残りの2%は未知の物質なはず。")
	await novel_interface.show_text_only("流通量が非常に少なく、不法者達の闇市場では\\n法外な価格で取引されている。")
	await novel_interface.show_text_only("つまりは、そのアタッシュケースの中身も……\\n『異質物』と関係がある物に違いない。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("そ、それって大変じゃないか！！\\nもうマリルに報告したっ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("今回の入国時に、サモントンの視察団は元老院へ\\n『異質物』の持ち込みを申告してはいない。")
	await novel_interface.show_text_only("新豊洲の防御フィールド内で殺傷能力の高い\\n『異質物』が発動でもしたら、\\n新豊洲は一瞬で壊滅する恐れすらもある。")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("もちろん。いの一番に報告したよ。マリルさんは\\n今、調査許可を元老院に申請しているはず。", "アニー")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("でも見えたのは一瞬だけだったから、\\n写真も撮れていないの。\\n恐らく私の証言だけで、強引に押し切るのは\\nきっと難しいよ……", "アニー")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("だからね～　マリルさんから命令の変更！私達は\\n「できるだけ早く証拠を入手、上に報告する事」", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("だったら、奴らの部屋に侵入して調査する方法を\\nどうにかして考えないと……", "小憐")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あの貴族のお嬢様の部屋か……難易度高そうね。", "アニー")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("うん……でもなんとか、やるしかないなぁ……", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("俺とアニーはスタッフ用のエレベーターを使い、\\n視察団が貸し切ってるエグゼクティブフロアまで\\nどうにか到着した。")
	await novel_interface.show_text_only("厨房から「借りた」サービス用ワゴンを押して、\\n廊下を見張る警備員へと向かって歩いた……\\nちなみにアニーは台車の下に隠れている。")
	await novel_interface.show_dialog("おい！　お前は下の宴会場のメイドだな？\\n\\nここはお前が来るべき場所じゃない、\\nすぐに立ち去れ。", "警備員")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("（思ってた通り、とても厳重な警備だ）", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("あれれっ？ 先ほどロイヤルスイートの部屋から\\nルームサービスのご注文を承りましたが……\\nファイアーウィスキーのフォアグラを、\\nその場でメイドに料理させるようにと。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("リーダーらしき警備員は依然として厳めしく、\\nまったく動揺していない。")
	await novel_interface.show_text_only("う～ん　俺の考えが甘過ぎた。\\n何か別の方法を考えないと……")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("あははは……恐らくルームサービス部門の者が、\\n間違えたのかもしれません。失礼いたしま……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──と俺が言い終わる前に、アニーは矢のように\\n突進し、肘でリーダーっぽい警備員の首を打つ。")
	await novel_interface.show_text_only("続けざまに身体を勢いよく捻り、\\n野球のボールを投げつけ、何メートルか先にいた\\nもう1人の警備員の顔面に直撃させた。")
	await novel_interface.show_text_only("残された警備員は突然の攻撃で混乱状態に陥り、\\n通信機を取る間もなくアニーの飛び蹴りが命中。")
	await novel_interface.show_text_only("3人の警備員はほぼ同時に床に倒れた。\\n\\nそして、投げられた野球ボールは地面に\\n1回だけ弾みアニーの手に戻る。")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("OK！　これで解決ね！", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("あ、アニー、今何をやったの？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("安心して、ちょっと眠ってもらっただけだから。", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("あはは、アニーらしいな……\\n（うん……アニーが味方でよかった……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("しかも今の、アニーは魔法を使っていないよな？\\n普段どんな訓練をマリルから受けているんだ……")
	await novel_interface.show_text_only("廊下に転がっている警備員を片付けた後、\\n\\n俺はアニーの後に続いて一番奥にあった\\n両開き扉のスイートルームへ向かった。")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("……ここね。", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーと顔を見合わせる。\\n扉にくっ付いて聞き耳を立てようとした瞬間──")
	await novel_interface.show_text_only("扉が中より開けられ、俺達は無防備な形で\\n部屋に転がりこんだ。")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("あいたたたたた……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("床に座って見上げると、見覚えのある傲慢な顔が\\nそこには有った。")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("……ラファエル！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは相変わらず見下すような表情を\\n浮かべている。\\n周囲にはボディーガードと従者が立っていた。")
	await novel_interface.show_text_only("あっ、なんと、まあ皆さん綺麗なお姉さん方で…")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ん……？\\nあんたはあの地味な学校にいた女装癖じゃない？\\nこそこそ何をしているのよ？", "ラファエル")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("……しかも今回はメイド服にまで着替えて、\\n\\nあんたのその変態っぷりは悪化の一途を辿って\\nいるのかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("い、いやぁ、き、奇遇だな～～\\n\\n俺はただ、クラスメートと一緒にホテルで\\nアルバイトをしていただけで……", "小憐")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("あ、そうだ、宴会場って下のフロアだったかな？\\n俺達、場所を間違えちゃったみたい。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーごめんっ！\\n俺は噓をつくのが本当に下手だ！")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("…おかしいわね、あんた達廊下にいた警備員に\\n止められなかったの？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは疑問に思いながら廊下を見渡した。")
	await novel_interface.show_text_only("廊下に倒れている警備員に気付き、\\nラファエルは驚いた表情を浮かべる。")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("──この2人を捕えなさい！", "ラファエル")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
