# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Thanks to Skurd, it seems Fabella decides to let me go.")
	await novel_interface.show_text_only("Just as Skurd turns away, several well-dressed guests walk up and talk to her.")
	await novel_interface.show_text_only("The girl is about the same age as Elluka, but she shines in such a fancy social occasion…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Is she from a noble family?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As Fabella turns her attention to her master, I sneak to the other side of the banquet hall.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("This is freaking me out… \\nLittle master and her maid, aren’t they?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seems the maid is not going to nail me. \\nDid she only want to trick me?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, you're here!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("I might have stumbled upon a major clue!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Just now, I followed the delegation secretly to the executive floor, and there I saw Raphael's entourage carrying a special suitcase.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("A suitcase… What’s in it?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dunno. But I remember the SID training mentioned the material used in the suitcase!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("It’s a grayish green metal with a peculiar light blue radiance—", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Light blue radiance… \\nWhat! Isn't it…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("I recall an alloy which reduces or eliminates the effects of psychoactive and meme Substance H…")
	await novel_interface.show_text_only("Substance H containers made of this alloy can elude most hue scanning.")
	await novel_interface.show_text_only("The alloy itself is a Substance H—98% of it is known metals and the remaining 2% is unknown substance.")
	await novel_interface.show_text_only("Because of its scarcity, its price on the black market has skyrocketed.")
	await novel_interface.show_text_only("I'm almost sure that whatever stuff in that suitcase has something to do with Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Holy crap! \\nHave you reported this to Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The Salmonton delegation hasn't reported to the Senate that they would bring any Substance H with them.")
	await novel_interface.show_text_only("Any destructive Substance H smuggled into the protective force field may bring catastrophe to New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("I told her immediately. She must be applying for a search warrant from the Senate right now.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("But I just saw it at a glance and didn't take any photos. \\nI don’t think they can break into the room without any further evidence…", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("That’s why Mariru has just updated our mission to “Secure and upload evidence ASAP”.", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("If so, the only chance is to sneak into their rooms…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah… the girl's room. Not an easy task.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm… We’ll have to play it by ear now.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("The executive floor is reserved for the delegation. We arrive there through the service elevator.")
	await novel_interface.show_text_only("I push the \"borrowed\" serving cart towards the heavily guarded corridor. Annie is hiding under it…")
	await novel_interface.show_dialog("Hey! Aren’t you supposed to be at the banquet downstairs? \\nYou are not allowed here. Leave now.", "Security")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(So many security guards, sure enough…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Huh? But a guest from the Royal Suite just ordered room service of foie gras with flaming whiskey!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The leader doesn't look impressed at all.")
	await novel_interface.show_text_only("Clearly, I’ve underestimated him. Got to find another way…")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Uh… Maybe Room Service made a mistake. My apologies, sir…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I've hardly finished speaking when Annie rushes out and hits his neck with the baseball bat.")
	await novel_interface.show_text_only("Then she turns around and hurls a baseball right into the face of another guard 10 yards away.")
	await novel_interface.show_text_only("The remaining guard is dumbstruck by the attack. Before he could reach his transceiver, Annie kicks him right in the chin.")
	await novel_interface.show_text_only("Three men collapse almost all at once. The bat bounces on the floor and jumps back to Annie's hand.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Clear!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("What… What did you do?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Nothing. Just letting them rest for a while.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, that’s so Annie… \\n(Thank goodness, I'm with her…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("And she didn't even use any magic! \\nWhat kind of training she's receiving…")
	await novel_interface.show_text_only("After getting the guards out of the way, Annie takes me to the double-door suite at the end of the corridor.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Here.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("We exchange a look. \\nJust as we are about to press our ears on the door…")
	await novel_interface.show_text_only("It suddenly opens from the inside. We are caught off guard and fall to the floor inside the room.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Owwww…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Looking up, I see a familiar, arrogant face.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael is surrounded by several bodyguards and her entourage, wearing a look of contempt on her face.")
	await novel_interface.show_text_only("Wow, so many mature and pretty ladies!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Hm? Aren't you that cross-dressing freak from that dump of a school? What are you doing here?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("In French maid outfits! Are you not feeling perverted enough?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("W… what a coincidence! \\nI'm just working part-time here with my classmate…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, and… the banquet hall downstairs, right? \\nWe might have come to the wrong place.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sorry, Annie, I suck at lying!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("That's weird. Didn't the security guards stop you?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Confused, Raphael looks down the corridor.")
	await novel_interface.show_text_only("Raphael is appalled when she finds the security guards, all knocked out on the floor.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("—Catch them!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
