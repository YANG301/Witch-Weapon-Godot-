# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("難道……妳打算把那個人相關的第三方資料都清除掉嗎？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("不，正好相反，我會加入更多的資訊。", "莉琉")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("什麼？ ！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉小姐露出了令人不寒而慄的笑容。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("目前關於劫匪的情報，只有那一段不甚清晰的影片而已。", "莉琉")
	await novel_interface.show_dialog("那麼在全世界，與那張平庸無奇的臉孔相似的人有多少個呢？", "莉琉")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("等一下，平庸無奇這四個字也太傷人了吧！")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("就算會有人和「我」長得差不多，但稍微調查一下就能分清楚吧？", "小憐")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("那個人在當天去了哪裡做了什麼，只要調查監視影片就一目了然了。", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("是啊，想調查一個真實存在的人並不是件難事。", "莉琉")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("但如果調查對象中有些人並不存在呢？", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("妳是說……", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("一群與嫌疑人面部特徵相符度極高的偽造目標，他們就算搜尋到世界毀滅也不可能真的找到那些人。", "莉琉")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("而除了我們以外，在其他人看來，那些人和"+GameConfig.player_name+"一樣，都是離奇消失的失蹤人口罷了。", "莉琉")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("這樣要怎樣才能分辨出，誰才是真正的目標呢？", "莉琉")
	await novel_interface.show_dialog("讓桌上的米粒消失有兩種辦法，要麼把米一粒粒拿走，要麼就在桌面上撒一整袋同樣品種的米。", "莉琉")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("聽起來是個浩大的工程啊……", "小憐")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("讓簡單的事情變得複雜，讓國民們認為他們繳納的稅金派上了大用場，這樣才能讓大家都幸福嘛。", "莉琉")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("每次聽到妳這種的發言都想報警。", "小憐")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("話說回來，我在核對關於妳原來身分的資料時，發現了矛盾之處。", "莉琉")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("嗯？ 是什麼？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("妳的父母。", "莉琉")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("聽到父母這個詞時，我的心忽然一沉。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("按照妳的說法，母親很早就去世，父親失蹤。", "莉琉")
	await novel_interface.show_dialog("就算這些是妳不願提及的回憶，但事有蹊蹺，我還是想跟妳核對清楚。", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("好……", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉調出了過去的我的備份數據。")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("這裡顯示的內容是，母親：2026年7月25日，\\n「大災難日」當天失蹤，推測死亡。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("……", "小憐")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("新豐洲西北側海底的廢墟，在「大災難日」前曾是一座繁華的都市。")
	await novel_interface.show_text_only("我對那裡只有很模糊的記憶了……")
	await novel_interface.show_text_only("那座都市被神蹟武器毀滅的同時，埃癸斯系統的防護力場展開，新豐洲恰好處於力場的邊緣。")
	await novel_interface.show_text_only("而且……那次事件是「七年戰爭」的開端。")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("父親，2026年12月起行蹤不明，推測……", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("停一下……拜託了。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我討厭那個冷冰冰的——推測……死亡。")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("父親他可能，還活著……\\n我一直這麼想。", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("……嗯，兒子還長成了一個大美人，他老人家一定會感到欣慰呢。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我被莉琉意外的發言逗笑了，\\n討厭，明明是在挖苦我。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("好啦，妳先看這裡。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉點開了屬於我父母的記錄，上面有兩行編號。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("在這上面記載的內容──", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("母親，編號離線。 \\n父親，編號離線。")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("……有什麼問題嗎？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("如果妳母親是在埃癸斯展開防護力場前或是在防護力場範圍外遇難的話，埃癸斯是不會有她的編號的。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("咦……？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉小姐若有所思地看著我。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("妳也不清楚嗎？ \\n應該不是記錄問題，我會繼續調查的……", "莉琉")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
