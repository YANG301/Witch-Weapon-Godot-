# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Já se passaram alguns dias desde que o anúncio de procurado foi publicado.")
	await novel_interface.show_text_only("Tal como Mariru previu, o incidente parece não ter qualquer efeito na vida quotidiana das pessoas.")
	await novel_interface.show_text_only("Também quase não há vestígios da engenharia de distração de Mariru.")
	await novel_interface.show_text_only("Parece nada além de um pesadelo.")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Bom dia, irmã Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como uma bruxa com habilidades especiais, Elluka é observado de perto por SID.")
	await novel_interface.show_text_only("Mas o garoto parece ligado a mim. Mariru a manda para mim todos os dias, alegando que ela está apenas sendo gentil.")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Bom dia, Elluka. \\nQuer comer algo entre as refeições?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Ei! Não dê muitos lanches às crianças!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("Boohoo…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("Tudo bem. Isso não é demais.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("Ah, vamos lá, você sempre diz isso.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("E está tudo bem que ela fique conosco o dia todo?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Crianças da idade dela deveriam ir à escola. \\nNão é?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… Hum, ela não é apenas uma criança, eu acho.", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("Claro, mas ainda estou meio preocupado...", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("É tudo culpa sua. Você continua alimentando ela, estou começando a me preocupar com o peso dela!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie, ruim.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka encara Annie com um olhar magoado. E Annie faz uma cara triste.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Agora eu sei como é ser uma mãe rígida…", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("Tudo bem. Não seja tão duro.", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Aqui, Elluka, um último pedaço de chocolate hoje. Não mais. \\nEm seguida, vou levá-lo para minha escola.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka só pode circular livremente entre nosso apartamento e a escola, conforme exigido por Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ah…", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Ainda assim, triste.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Dou um tapinha na cabeça dela e a levo para a escola junto com Annie.")
	await novel_interface.show_text_only("Hum, que dia lindo. Nem muito quente, nem muito frio.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Não se sinta mal, querido.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka de repente levanta a cabeça e me olha nos olhos, chocolate nos lábios.")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("Irmã Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(Oh, por favor, não me olhe assim!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka fica na ponta dos pés para pegar minha mão e coloca na cabeça dela.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Novamente.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Isso é uma ofensiva de charme!? \\nAh, não, isso é algo que nenhum homem poderia resistir!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, você gosta de Lolita, né?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Hehe, acho que sim.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu ouço a voz de Nix atrás de mim.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como ela poderia chegar perto de nós sem fazer barulho?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Desculpe, eu te assustei?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Não, apenas… \\nTudo bem.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sinto vergonha de ser pego olhando estupidamente para Elluka.")
	await novel_interface.show_text_only("E estou aliviado porque Nix não dá continuidade a este tópico. Ela é tão legal e elegante!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Seu nome é Elluka, certo?", "Nix")
	await novel_interface.show_dialog("Se você gosta de sobremesa, da próxima vez eu compro um pão de ló para você, certo?", "Nix")
	await novel_interface.show_dialog("Conheço uma padaria incrível na Theatre Street. Eles servem xarope de bordo muito bom, tem gosto quase de caramelo.", "Nix")
	await novel_interface.show_dialog("E você vai adorar o creme de chocolate exclusivo dentro do bolo.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka pensa um pouco e acena com a cabeça enquanto não consegue resistir à tentação da comida.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, você não aceita comida de estranhos!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Está tudo bem. Nix é nosso veterano de qualquer maneira.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Sim, mas…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sou só eu?")
	await novel_interface.show_text_only("Parece que Annie tem sido cauteloso com Nix desde a primeira vez que se conheceram.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Então é um acordo, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Acordo!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Meu telefone toca de repente. \\nÉ Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Olá?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ugh, outra missão de novo não!) \\n(Honestamente, não é todo dia que tiro Elluka!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
