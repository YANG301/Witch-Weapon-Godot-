# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Аэрогель-спрей — это оружие, похожее на лак для волос, изобретенное доктором Аей. Он производит большое количество пены за доли секунды.")
	await novel_interface.show_text_only("Попадая в воздух, пена быстро надувается и затвердевает, становясь настолько твердой, что ее непроницаемы даже для пуль.")
	await novel_interface.show_text_only("Пока Annie запечатывает дверь аэрогелем, меня снова привлекает золотая бабочка на полу.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Кажется, это просто великолепное произведение искусства…)", "Lian")
	await novel_interface.show_dialog("(Но ... я ничего не могу поделать ... мне очень хочется прикоснуться к нему ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Меня охватывает жгучее желание, и все передо мной излучает ослепительный свет. Я не могу не протянуть руку…")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Стоп!! Рен!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie хватает меня за запястье. Потом я внезапно прихожу в себя.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Может быть, эта штука может проникнуть в сознание людей… Поэтому им приходится хранить ее в этом чемодане?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ах! Я почти ..., что за черт ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Эта золотая бабочка кажется знакомой… \\nЯ подозреваю, что это Осколок Ведьмы.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Осколок ведьмы?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Хм, как бы это сказать…", "Annie")
	await novel_interface.show_dialog("Магическая сила на самом деле представляет собой своего рода знания, которые человеческий мозг усваивает из уникального типа «информации».", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Но люди получают и сохраняют эти знания обычно ценой своего здравомыслия.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Мне на ум приходят ведьмы на подстанции и враги в зонах потока.")
	await novel_interface.show_text_only("Их безумие должно быть вызвано чрезмерным накоплением «знаний», которые их тело не может вынести.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("«Информацию» на самом деле можно разделить на части и хранить отдельно. Ведьмин осколок — это контейнер таких маленьких кусочков «информации».", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Что касается причины этого дизайна, я думаю, он создан для того, чтобы люди расширяли свои возможности…", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Чтобы выяснить, в какой степени им это сойдет с рук, не теряя рассудка, они используют Ведьмины осколки, чтобы постепенно поглощать знания?", "Lian")
	await novel_interface.show_text_only("Сам поступок звучит достаточно безумно!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Постоянно жаждать и стремиться к новым знаниям без конца — во всяком случае, это человеческая природа ...", "Annie")
	await novel_interface.show_dialog("Даже если они обречены на уничтожение ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что, если обычная девушка получит Осколок Ведьмы, но не сможет им воспользоваться?\\nСтанет ли она одной из ведьм, которых мы встретили на Подстанции...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Очень вероятно. И вокруг Осколка Ведьмы нет щита, так что любой может напрямую прикоснуться к нему.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("Разве это не очень опасно?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Бум! \\n—Бум!")
	await novel_interface.show_text_only("Из комнаты доносятся тихие и глубокие звуки тяжелого стука в деревянную дверь.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Солдаты безопасности!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Крэк!! \\nВсего после двух ударов дверь Королевского люкса разбивается на куски дверным выключателем.")
	await novel_interface.show_text_only("— Туп! — Туп! — Туп! \\n—Там! — Туп! — Туп!")
	await novel_interface.show_text_only("Затем раздаются звуки дверных выключателей, которые тщетно ударяются о твердую пену аэрогеля.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Возможно, он сможет продержаться до тех пор, пока не прибудет г-жа Mariru… \\nВидите, изобретение доктора Аи работает!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я прикасаюсь к своей груди, куда Mariru без моего ведома воткнул динамик.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Ага... \\nДа, это работает...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно Raphael, уже проснувшаяся, бросается ко мне, стул все еще привязан к ее телу.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Никогда... ты ничего не заберешь!", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Ты извращенец с динамиком!!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael вырывается на свободу, когда стул падает на пол. Затем она бросается хватать золотую бабочку.")
	await novel_interface.show_text_only("Увидев это, я бросаюсь к бабочке, чуть не врезавшись в нее…")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Нет, Рен!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Бах!")
	await novel_interface.show_dialog("(Э? Я понял?) \\n(Упс…)", "Lian")
	await novel_interface.show_dialog("(Самое мягкое — это…)", "Lian")
	await novel_interface.show_dialog("(Это кажется знакомым. Я только что прикоснулся к нему)", "Lian")
	await novel_interface.show_dialog("(Подожди. Может ли это быть...!)", "Lian")
	await novel_interface.show_dialog("… Ты!", "Raphael")
	await novel_interface.show_dialog("Извращенец!!!", "Raphael")
	await novel_interface.show_text_only("— Шлёп!")
	await novel_interface.show_text_only("От громкого шлепка у меня кружится голова.")
	await novel_interface.show_text_only("В моей голове мелькают визуальные образы, все мгновенно стихло.")
	await novel_interface.show_text_only("Я чувствую себя как в другом мире. Странное ощущение исчезает в мгновение ока.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Открывая глаза, я все еще нахожусь в Королевском люксе.")
	await novel_interface.show_text_only("Золотой аксессуар оживает и приземляется мне на грудь, излучая блестящий свет.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Как бы это…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда свет тускнеет и постепенно исчезает, я чувствую, как нежно ласкают мое лицо. Это мягкое, волшебное прикосновение запечатлено в моей памяти.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("— Э?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На открытом пространстве этой комнаты появляется великолепная женщина.")
	await novel_interface.show_text_only("Мой взгляд прикован к ее светло-красным глазам и волосам, стройному телу и нефритовой коже.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… Что случилось?) \\n(Что-то коснулось моих губ!)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Ха-ха-ха, ничего!) \\n(О чем я думал? Это невозможно!)", "Lian")
	await novel_interface.show_dialog("(Нет… не невозможно!!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Дерьмо, это чувство... Ощущение...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Хммм, давно утраченное тепло человеческого тела.", "Неожиданная женщина")
	await novel_interface.show_dialog("Добрый вечер, барышни!", "Неожиданная женщина")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мое сердце бьется быстрее. Я не могу не подойти к ней. Мои конечности больше не мои.")
	await novel_interface.show_text_only("Я раскинул руки и крепко обнял их на виду у всех.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Привет, сладкий. Ты плохо себя чувствуешь, да...?", "Неожиданная женщина")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Извините…", "Lian")
	await novel_interface.show_dialog("Могу я узнать ваше имя, пожалуйста…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Это странно. Кажется, ее тело становится все тяжелее и тяжелее… \\nИ температура повышается…")
	await novel_interface.show_text_only("Что со мной не так!!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ох-ля-ля! \\nЭто так невероятно.", "Неожиданная женщина")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Рен!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie утаскивает меня от женщины.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Кто... ты?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Если мое имя не является табу в вашу эпоху… Пожалуйста, зовите меня Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Какое красивое имя…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Рен… \\nТы начинаешь выглядеть как собака!", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
