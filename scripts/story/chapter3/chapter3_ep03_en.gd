# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("You mean… To wipe out all third-party information about that guy?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Nope. Just the opposite, I'll add more information.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A chilling smile creeps onto Mariru's face.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Now the only information about the burglar is just low-resolution footage.", "Mariru")
	await novel_interface.show_dialog("Just imagine how many people in the whole world have this plain-looking faces.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Wait—did you just say, plain? That stings.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("And even if someone does look like \"me\", it would still be easy to find out.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Security cameras record everything he did on that day!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Of course, it's not difficult to single out a real person.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("But what if… this person doesn't exist?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You mean…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("If we slip in some forged identities with similar facial features to the suspect, it will be almost impossible to find out.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("And to everyone except us, those people are no different from "+GameConfig.player_name+"—just more mysteriously missing persons.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Then how is it possible to find out the real target?", "Mariru")
	await novel_interface.show_dialog("To hide a grain of rice, you either take it away, or sprinkle a whole bag of rice to cover it up.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Sounds like a huge project…", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Just a bit of extra complexity to a simple problem, so that taxpayers are happy about how their money is spent. See? Two birds with one stone.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Every time you make such inappropriate comments I want to call the police.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("By the way, I've found some contradictions in your identity information.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Huh? Which part?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("About your parents.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("My heart sinks when hearing the word \"parents\".")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("You told me your mother died early and your father was missing.", "Mariru")
	await novel_interface.show_dialog("I know you don't want to talk about this. But it's important. I have to check with you.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Fine…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru retrieves the data she has backed up.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Here it says your mother went missing on July 25, 2026, presumed dead. \\nThat was the Great Tribulation.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Before that day, the underwater ruins in Northwest New Opulentia had been a bustling city.")
	await novel_interface.show_text_only("I have only a vague memory of it…")
	await novel_interface.show_text_only("The moment the city was destroyed by Devine Touch weapons, Aegis generated a protective field. New Opulentia was right on the edge of it.")
	await novel_interface.show_text_only("And… That marked the beginning of the Seven Years War.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Father, missing since December 2026. Presumed…", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Stop… please!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hate this cold phrase—Presumed… dead.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("I always tell myself… \\nMaybe… dad is still alive…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Well, your dad must be happy. His boy has grown up to become a beautiful girl!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I chuckle at her words. \\nDarn it, I know she's teasing me!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Well, look at this.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She clicks on my parents’ profiles. Two codes show up.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("According to the profile—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mother, code offline. \\nFather, code offline.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Anything wrong?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis wouldn’t have assigned a code to your mother had she died before the protective field was activated or somewhere out of its range.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Eh…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru looks at me thoughtfully.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("You have no idea either? \\nThe files wouldn't lie. I'll watch out for this…", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
