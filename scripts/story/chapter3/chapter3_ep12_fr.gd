# chapter3_ep12.gd - 第3章第12话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep12_script()

func play_script():
	pass

func chapter3_ep12_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("L'Aerogel Spray est une arme semblable à de la laque inventée par le Dr Aya. Il produit de grandes quantités de mousse en une fraction de seconde.")
	await novel_interface.show_text_only("Une fois en l’air, la mousse se gonflera et se solidifiera rapidement, devenant si dure qu’elle sera impénétrable même par les balles.")
	await novel_interface.show_text_only("Alors que Annie scelle la porte avec de l'aérogel, je suis à nouveau attiré par le papillon doré sur le sol.")
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("(Cela semble juste une magnifique œuvre d’art…)", "Lian")
	await novel_interface.show_dialog("(Mais ... je n'y peux rien ... j'ai vraiment envie d'y toucher ...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une envie brûlante m’envahit et tout devant moi émet une lueur éblouissante. Je ne peux m'empêcher de tendre la main...")
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Arrêtez !! Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie attrape mon poignet. Puis je reviens soudain à moi-même.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Peut-être que cette chose peut envahir l'esprit des gens… Est-ce pour cela qu'ils doivent la garder dans cette valise ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Ah ! J'ai presque ... qu'est-ce que diable ...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","unhappy",0.25)
	await novel_interface.show_dialog("Ce papillon doré semble familier… \\nJe soupçonne qu'il s'agit d'un éclat de sorcière.", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Un éclat de sorcière ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Hmm, comment devrais-je le dire…", "Annie")
	await novel_interface.show_dialog("Le pouvoir magique est en fait une sorte de connaissance que le cerveau humain absorbe à partir d’un type unique d’« informations ».", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Mais les gens obtiennent et conservent ces connaissances généralement au détriment de leur santé mentale.", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Les sorcières de la sous-station et les ennemis dans les zones de flux me viennent à l'esprit.")
	await novel_interface.show_text_only("Leur folie doit être causée par une accumulation excessive de « connaissances » que leur corps ne peut pas supporter.")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Les « informations » peuvent en fait être divisées en morceaux et stockées séparément. Un Éclat de Sorcière est un conteneur de petites « informations ».", "Annie")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("Quant à la raison de cette conception, je suppose qu’elle a été créée pour que les humains repoussent leurs limites…", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pour comprendre dans quelle mesure ils peuvent s'en sortir sans perdre la raison, ils utilisent des Éclats de Sorcière pour absorber les connaissances petit à petit ?", "Lian")
	await novel_interface.show_text_only("L’acte en lui-même semble assez fou !")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Continuer à avoir envie et à rechercher de nouvelles connaissances sans fin - c'est plutôt la nature humaine ...", "Annie")
	await novel_interface.show_dialog("Même s'ils sont voués à la destruction ...", "Annie")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Et si une fille ordinaire obtenait l'Éclat de Sorcière, mais n'avait pas le don de l'utiliser ? Deviendra-t-elle l'une des sorcières que nous avons rencontrées dans la Sous-station...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Très probablement. Et il n'y a pas de bouclier autour de l'Éclat de Sorcière, donc n'importe qui peut le toucher directement.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"serious")
	await novel_interface.show_dialog("N'est-ce pas super dangereux alors ?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("— Boum ! \\n—Boum !")
	await novel_interface.show_text_only("À l’extérieur de la pièce, des bruits sourds et profonds de martèlements lourds sur la porte en bois retentissent.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Les soldats de la sécurité !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("—Crack !! \\nAprès seulement deux coups, la porte de la Suite Royale est brisée en morceaux par un cambrioleur.")
	await novel_interface.show_text_only("— Boum ! -Cogner! -Cogner! \\n—Boum ! -Cogner! -Cogner!")
	await novel_interface.show_text_only("Viennent ensuite les bruits des enfonceurs de portes frappant en vain la mousse solide d'aérogel.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Peut-être que cela pourrait tenir jusqu'à l'arrivée de Mme Mariru… \\nVous voyez, l'invention du Dr Aya fonctionne !", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je touche ma poitrine, là où Mariru a planté le haut-parleur à mon insu.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Aha… \\nOuais, ça marche…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Soudain, Raphael désormais réveillée, se précipite vers moi, la chaise toujours attachée à son corps.")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Jamais… tu n’enlèveras rien !", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Espèce de pervers monté sur haut-parleur !!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael se libère lorsque la chaise touche le sol. Puis elle se précipite pour saisir le papillon doré.")
	await novel_interface.show_text_only("Voyant cela, je me jette sur le papillon, presque sur le point de lui rentrer dedans...")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Non, Ren !!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bang—!")
	await novel_interface.show_dialog("(Euh ? J'ai compris ?) \\n(Oups…)", "Lian")
	await novel_interface.show_dialog("(Ce qui est doux, c'est…)", "Lian")
	await novel_interface.show_dialog("(Cela me semble familier. Je viens de le toucher)", "Lian")
	await novel_interface.show_dialog("(Attendez. Serait-ce…!)", "Lian")
	await novel_interface.show_dialog("… Toi !", "Raphael")
	await novel_interface.show_dialog("Pervers !!!", "Raphael")
	await novel_interface.show_text_only("— Gifle !")
	await novel_interface.show_text_only("La claque retentissante me donne le vertige.")
	await novel_interface.show_text_only("Des images visuelles me traversent l’esprit, tout s’est assourdi en un instant.")
	await novel_interface.show_text_only("J'ai l'impression d'être dans un autre monde. La sensation étrange disparaît en un clin d’œil.")
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("En ouvrant les yeux, je me retrouve toujours dans la Suite Royale.")
	await novel_interface.show_text_only("L'accessoire doré prend vie et se pose sur ma poitrine, rayonnant d'une lumière scintillante.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Comment cela pourrait-il… ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lorsque la lumière diminue et disparaît peu à peu, je sens mon visage doucement caressé. Cette touche douce et magique est gravée dans mon esprit.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("— Hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dans l’espace ouvert de cette pièce, une femme magnifique apparaît.")
	await novel_interface.show_text_only("Mes yeux sont fixés sur ses yeux et ses cheveux rouge clair, son corps mince et sa peau semblable à du jade.")
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("(… Que s'est-il passé ?) \\n(Mes lèvres ont été touchées par quelque chose !)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(… Hahaha, rien !) \\n(A quoi je pensais ? C'est impossible !)", "Lian")
	await novel_interface.show_dialog("(Non… pas impossible !!)", "Lian")
	novel_interface.change_expression("timid")
	await novel_interface.show_dialog("(Merde, le sentiment… Le sentiment…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Hmmm, la chaleur perdue depuis longtemps du corps humain.", "Femme inattendue")
	await novel_interface.show_dialog("Bonsoir, mesdames !", "Femme inattendue")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mon cœur bat plus vite. Je ne peux m'empêcher de marcher vers elle. Mes membres ne m'appartiennent plus.")
	await novel_interface.show_text_only("J'écarte mes bras et les enroule étroitement autour d'elle, à la vue de tout le monde.")
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Bonjour, chérie. Vous ne vous sentez pas bien, n'est-ce pas… ?", "Femme inattendue")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Excusez-moi…", "Lian")
	await novel_interface.show_dialog("Puis-je connaître votre nom s'il vous plaît…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est bizarre. Son corps semble devenir de plus en plus lourd… \\nEt sa température augmente…")
	await novel_interface.show_text_only("Qu'est-ce qui ne va pas chez moi !!")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("… Ouh la la ! \\nC'est tellement incroyable.", "Femme inattendue")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("!!?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("—Ren!!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie m'éloigne de la femme.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Qui… es-tu ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Si mon nom n'est pas un tabou à votre époque… S'il vous plaît, appelez-moi Beatrice.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Quel beau nom…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Ren… \\nTu commences à ressembler à un horndog !", "Annie")

	print("=== 第3章第12话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
