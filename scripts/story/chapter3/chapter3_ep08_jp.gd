# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("不安になりながらも、俺はラファエルに学園を\\n案内した。")
	await novel_interface.show_text_only("まさかこんな簡単に目標人物と接近できるとは、\\n思っていなかった。")
	await novel_interface.show_text_only("全力で歓迎式典を用意していたけど、\\n完全にすっぽかされた副校長は、\\n俺達の後ろに隠れて、悔しそうにハンカチを\\n噛んでいる。")
	await novel_interface.show_text_only("当のお嬢様は満足してる　とは言い難いが、\\n先ほどよりは大分機嫌が良さそうだ。")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("……これで終わりかしら？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("うん？　学校の案内か？", "小憐")
	await novel_interface.show_dialog("この先は商業地区で、学校の外だしなぁ……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ここの多くのデザインは、戦前の有名な建築を\\n真似ているわね。\\nそれでいて、自分達の文化が基礎レベルより高い\\nって主張している。", "ラファエル")
	await novel_interface.show_dialog("だけど、キャンパスの面積が小さすぎて、\\n各建築様式の間に緩衝と適度なスペースがない…", "ラファエル")
	await novel_interface.show_dialog("……こんな場所にいて、あんたは鬱陶しく\\nならないの？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("新豊洲は廃墟の上に再建された都市であり、\\n歴史的な建造物なんて残ってはいない。")
	await novel_interface.show_text_only("しかも防御フィールドの中と言う、\\n限られた貴重な土地。\\nこの敷地面積だって実は十分に贅沢だ。")
	await novel_interface.show_text_only("突然そんなこと言われて、カチンときた……")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("うーん……", "小憐")
	await novel_interface.show_dialog("……君は第四学園都市から来た\\nラファエル・デックスさんだよね？", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("ここがそんなに気に入らないのなら、\\nどうして見学になんて来たんだ？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("へぇ？　私を知ってるのね？", "ラファエル")
	await novel_interface.show_dialog("お爺様が、私を他の学園都市に留学させようと\\nしているのよ。\\nそうでなければ……", "ラファエル")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("こんな模倣だけの中身が空っぽな場所なんて、\\n\\n──足を踏み入れる価値さえないわ！", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…………", "小憐")
	await novel_interface.show_dialog("（要は家族とそりが合わないから、不満が\\n　溜まってるわけか……）\\n（そんな事はっきり言えばいいじゃないか！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……まずい、彼女に言われてから、\\n俺にも学校のデザインが不自然に見え始めた。")
	await novel_interface.show_text_only("あんな毒舌コメントなんて、忘れるんだ俺！！")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("あらあら……\\nそんなにご家族の事が不満なのでしたら──", "ニュクス")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("どうして自分の考えを直接、伝えないのかしら？", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("相変わらずの優雅さで、ニュクス先輩が\\n俺達の後ろから歩いてきた。")
	await novel_interface.show_text_only("先輩とラファエルの目が逢った瞬間、\\n空気を裂く電流の音が聞こえた気がする。")
	await novel_interface.show_text_only("(き、気のせい……だよな？)")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("──あんた、誰よ？", "ラファエル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("この学校に通う、ごくごく一般の生徒です。", "ニュクス")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("そこの貴族のお嬢様は、先ほどからずっと私達の\\n学校を侮辱してばかりですね。", "ニュクス")
	await novel_interface.show_dialog("それでしたら、なぜわざわざこちらにお越しに？\\n家族からの圧力かしら？", "ニュクス")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("私と家族との関係性について、\\nあんたに指図される義理はないわ。", "ラファエル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("あぁ、なるほど。\\nつまり、あなたは両親の命令に逆らえない\\n『我儘な子供』という事でしょうか──", "ニュクス")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("──そんなあなたが、\\n他人より優れていると自惚れながら、\\n善意で学校案内をしてくれている生徒に対して、\\nよくその子の学校の悪口を言えたものね？", "ニュクス")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("はぁッ？\\n私がいつ他人より優れていると言ったのッ？", "ラファエル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("ねえ、女装癖？\\n私がそんな事を言った覚えはないわよね？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("いや…あの…、言ってなかった……かな……？", "小憐")
	await novel_interface.show_text_only("(誰が女装癖だっ！)")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("ほら見なさい、言っていないでしょう？", "ラファエル")
	await novel_interface.show_dialog("ところで、あんたの首に着けているそれ……", "ラファエル")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("そんなものを着けて学校に来ているなんて、\\nあんたこそ、大丈夫なの？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("俺達の学校はアクセサリーを禁止してないし……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("それに先輩のチョーカーめちゃ可愛いからOK！")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("わざと低反射素材で隠しているようだけど……\\nそれ、戦前の動乱で宮廷から流出した挙句……\\n3つに割れた『ブラックオルロフ』\\nじゃないかしら？", "ラファエル")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("それを売ったら、ここの教室数棟分ぐらい容易く\\n買えるんじゃない？", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("──なんだってッ！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("庶民の代弁をするフリをしているようだけど、\\n\\nそこの女装バカに仲間だと\\nあんたは思われたい訳ね。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…………", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("だから、誰が女装バカだよっ！")
	await novel_interface.show_text_only("そして、ニュクス先輩もなんで後ろめたい感じに\\nなってるの！？")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("……私はただ、自分に相応しいアクセサリーを\\n付けているだけです。", "ニュクス")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("むしろあなたこそ、自由と独立を表現したい\\nのでしょう？\\nなのに家族の権威を笠に着て優越感に浸る姿は、\\n正直な所、非常に滑稽と思いますが。", "ニュクス")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("確か3つのブラックダイヤはマフィアの\\n首領の手に落ちたと聞いたわ。\\nドス黒い金で買った黒いダイヤ……\\n……確かにあんたに相応しいわよ。", "ラファエル")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あなたのご家族とは違うわ。\\n\\n食糧貿易の独占で得た財産と貴族の地位は、\\n服さえも野菜みたいな緑色にするようですね。", "ニュクス")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("そうね。確かに私達の作物は『黒糸病』を\\nちゃんと予防しているわ。\\nそのお陰で、あんたみたいにどこを切っても\\n中身が真っ黒じゃないのよ。", "ラファエル")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("常に飢餓で世界を脅かし続けているてる人間が、\\n信仰心を失うなと吹聴する。\\n神道ではなく、人道の方を私が代わりに教えて\\n差し上げましょうか？", "ニュクス")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("あんたのような人間に、道についてなんて\\n聞きたくもないわ。\\nそれこそ私の人生の汚点となってしまうもの。", "ラファエル")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("あら、とても奇遇ね。\\nゴミの山に積まれているゴミの形について、\\n私も研究したくないもの。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("午後の太陽が俺達3人を暖かく照らす。")
	await novel_interface.show_text_only("俺は2人の間に立っているが、壮絶な罵り合いを\\n仲裁できる方法なんてさっぱり浮かばなかった。")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（君ら、本当に初対面かな？）", "小憐")
	await novel_interface.show_dialog("（実は幼い頃からの仇敵とかではなく？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…遠くにいた副校長はとっくの昔に泡を吹いて、\\nどこかに運ばれていった。")
	await novel_interface.show_text_only("まぁ、幸いにもマリルが欲しい情報はすでに\\n入手できてるし。")
	await novel_interface.show_text_only("……気にしなくていいんじゃね？")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
