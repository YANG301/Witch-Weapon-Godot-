# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru sends Annie and Elluka away just as we return to the Headquarters.")
	await novel_interface.show_text_only("Now I'm upset. I don't know if I would be interrogated with strange questions again…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("What happened?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("What if nothing happens? Are you gonna keep on smirking at Elluka like a pervert?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You… You must have been watching me through the surveillance camera!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Hehe, is that all you can think of?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What else could it be…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("For example—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru looks at me evilly from head to toe.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("The Research Department has developed a wafer that can even decide when you go to the bathroom!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("What… bathroom? \\nUgh, sounds gross!", "Lian")
	await novel_interface.show_dialog("It must be invented by Aya! \\nWait, don't tell me you've secretly implanted it in my body!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("I was just kidding.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The way you say it is nothing like a joke!")
	novel_interface.show_character("liliu_uniform2","speak2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Or… Is there something strange that crosses your mind?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Ugh, darn it…", "Lian")
	await novel_interface.show_dialog("(Last time I had the runs during the school assembly…) \\n(Does that mean…?)", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hahahaha! Don't take it seriously!", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru laughs out loud, rubbing my head forcefully.")
	novel_interface.show_character("liliu_uniform2","normal2")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_uniform","shy",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aya only made a prototype before I called the project off. \\nWhy would we use it on a nobody like you!", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_right")
	await novel_interface.show_dialog("Oh, should I say thank you?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Haha, you've got filth on your mind, right?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Ahh… Thank goodness there's no mind-reading machine! Just think how shameful it would be!")
	novel_interface.character_light(0.35,"speak2")
	await novel_interface.show_dialog("Hey, don't suck it up. It's so much fun watching you fighting back.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_text_only("Sorry for letting you down.")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm… I wonder how could a simpleton like you dig out information from key targets.", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru wipes tears of laughter and puts on her usual arrogant face.")
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Key targets… Sounds like more meaningful than catering to you… But why would Mr. Big talk to a high school kid!", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("This time you will approach your target as a student. The target…", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Raphael Dekkers, granddaughter of the mayor of Salmonton. She'll come with the Salmonton Delegation.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("She's a real highborn girl. Excited?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Why should I be excited?", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut-tut, you only like little girls, huh?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wry_smile")
	await novel_interface.show_dialog("Hey, stop describing me like a criminal!", "Lian")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("… Ahem. \\nAnyway, what do you want me to get from this highborn girl?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ugh, you're not much of a talker… \\nHope you can get through at least one day.", "Mariru")
	await novel_interface.show_dialog("Okay, seriously, what do you know about Salmonton?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Umm… I guess it's the biggest food exporter?", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Speaking of Salmonton… what comes to my mind is the tens of high-rise greenhouses lining the Rhine.")
	await novel_interface.show_text_only("The verdant gardens behind greenhouses… \\nAlways make perfect wallpapers.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("And there are a lot of churches. All citizens have a religious belief. They've even formed a Sacred Alliance…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That's all I can remember. I'm not good at geography. Too much memorization of random facts.")
	novel_interface.show_character("ren_uniform","normal1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Salmonton's economic and political power largely depends on its control over crop genes.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("But incidents after the Ross Goblet disappeared have posed severe threats to them.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("By threats, you mean… the Spacetime Flux?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("That's right. According to my information, it has suffered from multiple fluxes. But the damage is still unknown.", "Mariru")
	await novel_interface.show_dialog("Judging from the recent volatility in the price of grain futures, the impact seems fairly large… Maybe sporadic famines will occur.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("That's severe!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I know nothing about the futures market. I thought the impact was confined to a small area.")
	novel_interface.show_character("ren_uniform","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Yeah… Crop failure won't cause immediate harm. Countries have risk reserves anyway.", "Mariru")
	await novel_interface.show_dialog("Seems Salmonton is the first to collapse, among all Academy Cities.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("It has dispatched a delegation to New Opulentia, which is already on the way.", "Mariru")
	await novel_interface.show_dialog("As their major food importer, we cannot say no.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Will they… suspect Annie and me?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("That's what you're going to do.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("What?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Although it's under the banner of a \"cultural exchange\" program, the delegation has been under tight protection by the Royal Security Service.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The Royal Security Service… The intelligence agency of Salmonton, also known as Rosenkreutz.")
	await novel_interface.show_text_only("For an intelligence service, it's too famous thanks to the Agent No. 7 movies.")
	novel_interface.show_character("ren_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Will it cause some troubles?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Of course. SID even has difficulty in collecting background information.", "Mariru")
	await novel_interface.show_dialog("So far, what's relevant to you is that the girl will visit the Gosakuragawa Girls' High School.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("My school?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal1")
	await novel_interface.show_dialog("That's to be expected. She's about the age of a high school student.", "Mariru")
	await novel_interface.show_dialog("So what you need to do is to find out the real purpose of their visit.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("The intelligence services made a booklet about Salmonton and the Dekkers family. Now off you go and read it through.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("Oops, memorization task again… \\nI'll take care of it!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("By the way, watch out for the pervert on your way home.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","awkward")
	await novel_interface.show_dialog("W-What!?", "Lian")

	print("=== 第三章第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
