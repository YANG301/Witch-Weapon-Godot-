# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Punisci \\nElluka Amministratore…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dietro di lui vedo diversi soldati della sicurezza stesi sul pavimento.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sono appena svenuti. Uccidere nella zona smilitarizzata non rientra nei miei piani.", "Jacob")
	await novel_interface.show_dialog("Avevo intenzione di riprendere le pagine del classico cult Libro dei sette filosofi e non mi aspettavo un bonus del genere...", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Libro dei Sette Filosofi...) \\n(Il Grimorio è legato alla Farfalla d'Oro?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren... ho trovato molte vecchie ferite sul corpo di Elluka quando l'ho aiutata a lavarsi.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Hai lavato Elluka?) \\n(Quando!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(No, non è questo il punto.) \\n(Vecchie ferite... Ciò significa...!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Nessun bambino normale potrebbe sopportare un’esperienza così traumatica!", "Annie")
	await novel_interface.show_dialog("Deve essere questo ragazzo ... questo è quello!!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oh— \\nSembra che quella cosa non si sia ancora rotta.", "Jacob")
	await novel_interface.show_dialog("Tut-tut, immagino che SID abbia già effettuato il reverse engineering... \\nLa tecnologia che ho usato su di esso.", "Jacob")
	await novel_interface.show_dialog("Se avessi saputo che avrebbe causato così tanti problemi, ci avrei installato sopra un dispositivo di autodistruzione.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Tu...!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Stronzo!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Subito dopo, Annie rimbalza furiosamente e cerca di dare un calcio in faccia a Jacob.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Squittio—")
	await novel_interface.show_text_only("Con un grido la stanza viene illuminata da un enorme arco elettrico. Per un attimo sono accecato.")
	await novel_interface.show_text_only("Ci vogliono pochi secondi perché il bagliore scompaia. Un dolore lancinante mi permane negli occhi.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie…!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie perde conoscenza e cade a terra. Sulla sua pelle appare una striscia di segni bruciati a forma di ramo.")
	await novel_interface.show_text_only("Il soldato accanto a Jacob ha in mano una pistola fumante… È questa l'arma che hanno usato poco fa?")
	await novel_interface.show_text_only("Il soldato scarica rapidamente un proiettile simile a una batteria delle dimensioni di un contenitore.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sappiamo come trarre il meglio dalle streghe...", "Jacob")
	await novel_interface.show_dialog("Preferisco prenderli vivi. Ma la stronza SID arriverà presto...", "Jacob")
	await novel_interface.show_dialog("Ora che il tempo a nostra disposizione sta per scadere...", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob tira fuori un pezzo di metallo a forma di torta. Il guscio verde-grigiastro emana un familiare splendore azzurro.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Quella è... un'arma Substance H?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Sento... il flusso del potere magico...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Che diavolo stai facendo? Questa è zona demilitarizzata!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Ren)", "Mariru")
	await novel_interface.show_text_only("La voce di Mariru esce all'improvviso dagli auricolari.")
	await novel_interface.show_dialog("(È una trappola esplosiva fatta di fibre autoleganti.) \\n(È un'arma Substance H non letale.)", "Mariru")
	await novel_interface.show_dialog("(Esplode tre secondi dopo la detonazione.) \\n(E le fibre si diffonderanno ovunque. È impossibile scappare.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Quindi risparmia le forze per il momento.) \\n(Troverò come tirarti fuori...)", "Mariru")
	await novel_interface.show_text_only("Jacob solleva lentamente la trappola esplosiva che tiene nella mano destra. Sul suo palmo compaiono linee dorate, come se fosse pronto a combattere.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("La sua mano... è un'iscrizione magica quella?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Finalmente... tocca a me provare l'arma Substance H...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Mi dispiace per questo…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice all'improvviso mi afferra con una mano e con l'altra strappa la collana a Raphael.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Cosa?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, il pendente di smeraldo emette un raggio abbagliante e si trasforma in una possente spada con iscrizioni sulla lama.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Guarda queste anime miserabili che implorano di cancellare i loro peccati...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Cosa…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Stai zitto!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice affonda pesantemente la spada nel pavimento.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob apre la bocca, ma non esce nulla. \\nLa stanza è piena di un silenzio mortale.")
	await novel_interface.show_text_only("Il pavimento sotto Jacob si spacca, rivelando nient'altro che completa oscurità.")
	await novel_interface.show_text_only("Dal profondo dell'oscurità arriva un suono inquietante, come se milioni di persone piangessero e ululassero dall'inferno.")
	await novel_interface.show_text_only("Dalla fessura fuoriesce del fumo scuro che invade ogni angolo della stanza, che in un batter d'occhio viene avvolta in un'oscurità infernale.")
	await novel_interface.show_text_only("Colpito da un brivido alle ossa e da un profondo senso di terrore, mi si rizzano i capelli e non riesco a muovermi…")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Ma pochi secondi dopo, l’oscurità si è dissipata. \\nE la crepa non si trova da nessuna parte.")
	await novel_interface.show_text_only("Come se soffrisse di un attacco di panico, Jacob cade a terra e si gratta follemente il collo così forte da farlo sanguinare.")
	await novel_interface.show_text_only("Il suo viso diventa rosso mentre fatica a respirare. Ma i suoi polmoni sembrano svuotati d'aria, lasciandolo ansimare rumorosamente invano.")
	await novel_interface.show_text_only("Ci vuole un po' prima che riacquisti un debole respiro.")
	await novel_interface.show_text_only("L'uomo alto e ben fatto si rannicchia sul tappeto, tremante, con le braccia incrociate sul petto.")
	await novel_interface.show_text_only("I suoi occhi iniettati di sangue sono pieni di paura. Le lacrime escono come risultato della decompressione.")
	await novel_interface.show_text_only("Le rughe sulla sua mano sono completamente scomparse e anche la trappola esplosiva caduta sul tappeto ha perso la sua lucentezza.")
	await novel_interface.show_text_only("I soldati mascherati sono tutti immobili, tremanti.")
	await novel_interface.show_text_only("Dai loro volti inespressivi, sembrano colti dall'orrore di vedere una realtà al di là di ogni descrizione.")
	await novel_interface.show_text_only("Se guardi a lungo nell’abisso, anche l’abisso guarderà dentro di te…")
	await novel_interface.show_text_only("Di fronte al vero orrore, anche respirare…")
	await novel_interface.show_text_only("Ti fa sentire esposto ad una disperazione indescrivibile.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Andiamo!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Ren, vattene da lì!)", "Mariru")
	await novel_interface.show_text_only("Solo adesso sono tornato in me. Con un cenno a Beatrice, esco dalla stanza con Annie tra le braccia.")
	await novel_interface.show_text_only("Beatrice trascina Raphael, che è ancora stordito. Corriamo verso l'ascensore...")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
