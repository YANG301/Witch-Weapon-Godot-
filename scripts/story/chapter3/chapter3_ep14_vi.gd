	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ồ— \\nCó vẻ như thứ đó vẫn chưa hỏng.", "Jacob")
	await novel_interface.show_dialog("Tut-tut, tôi đoán SID đã được thiết kế ngược rồi… \\nCông nghệ tôi đã sử dụng trên đó.", "Jacob")
	await novel_interface.show_dialog("Nếu biết nó sẽ gây ra nhiều rắc rối như vậy thì tôi đã lắp thiết bị tự hủy vào đó rồi.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Bạn—!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("- Đồ khốn!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Điều tiếp theo tôi biết, Annie bật dậy giận dữ và cố đá vào mặt Jacob.")
