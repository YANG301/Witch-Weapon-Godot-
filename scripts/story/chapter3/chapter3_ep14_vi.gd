	await novel_interface.show_dialog("Họ vừa mới ngất đi. Giết chóc ở khu phi quân sự không nằm trong kế hoạch của tôi.", "Jacob")
	await novel_interface.show_dialog("Tôi định lấy lại những trang của cuốn sách kinh điển đình đám Book of Seven Philosophers, và không ngờ phần thưởng như vậy…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Sách Bảy Nhà Triết Học…) \\n(Đây có phải là cuốn Grimoire có liên quan đến Bướm Vàng không?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren… Tôi tìm thấy rất nhiều vết thương cũ trên cơ thể Elluka khi tôi giúp cô ấy tắm rửa.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Bạn đã giặt Elluka?) \\n(Khi nào!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(Không, vấn đề không phải ở chỗ đó.) \\n(Vết thương cũ… Nghĩa là…!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Không một đứa trẻ bình thường nào có thể chịu đựng được trải nghiệm đau thương như vậy!", "Annie")
