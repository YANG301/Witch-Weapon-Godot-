	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Chào buổi sáng chị Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Là một phù thủy có khả năng đặc biệt, Elluka được SID theo dõi chặt chẽ.")
