	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Đừng cảm thấy tồi tệ, em yêu.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka đột nhiên ngẩng đầu lên và nhìn thẳng vào mắt tôi, sô cô la trên môi cô ấy.")
