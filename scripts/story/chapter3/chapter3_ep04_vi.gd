	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka chỉ được phép di chuyển tự do giữa căn hộ và trường học của chúng tôi, theo yêu cầu của Mariru.")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("Ồ…", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("… Tuy nhiên, vẫn buồn.", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Tôi xoa đầu cô ấy và đưa cô ấy đến trường cùng với Annie.")
