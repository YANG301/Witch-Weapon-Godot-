	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Tut-tut, bạn thích lolita phải không?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Hehe, tôi nghĩ vậy.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nghe thấy giọng nói của Nix phía sau tôi.")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Làm sao cô ấy có thể đến gần chúng tôi mà không gây ra tiếng động?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Xin lỗi, tôi làm bạn sợ phải không?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Không, chỉ là… \\nKhông sao đâu.", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Tôi cảm thấy xấu hổ khi nghĩ đến việc bị bắt gặp đang nhìn chằm chằm vào Elluka một cách ngu ngốc.")
	await novel_interface.show_text_only("Và tôi cảm thấy nhẹ nhõm vì Nix không tiếp tục chủ đề này. Cô ấy thật xinh đẹp và thanh lịch!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Tên bạn là Elluka phải không?", "Nix")
	await novel_interface.show_dialog("Nếu bạn thích món tráng miệng, lần sau tôi sẽ mua cho bạn một chiếc bánh bông lan, được chứ?", "Nix")
	await novel_interface.show_dialog("Tôi biết một tiệm bánh tuyệt vời ở Phố Theater. Họ phục vụ xi-rô phong rất ngon, có vị gần giống như caramel.", "Nix")
	await novel_interface.show_dialog("Và bạn sẽ thích món kem sô cô la đặc trưng bên trong chiếc bánh.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka suy nghĩ một lúc rồi gật đầu khi không cưỡng lại được sự cám dỗ của đồ ăn.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka, bạn không nhận đồ ăn từ người lạ!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("Không sao đâu. Nix dù sao cũng là tiền bối của chúng tôi.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("Ừ, nhưng…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chỉ có tôi thôi à?")
	await novel_interface.show_text_only("Có vẻ như Annie đã cảnh giác với Nix kể từ lần đầu họ gặp nhau.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Vậy thì thỏa thuận rồi, Elluka.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("Thỏa thuận!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Điện thoại của tôi đột nhiên đổ chuông. \\nĐó là Mariru.")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("… Xin chào?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(Ugh, không còn nhiệm vụ nào nữa!) \\n(Thành thật mà nói, không phải ngày nào tôi cũng thực hiện Elluka!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
