	await novel_interface.show_dialog("Một lần nữa.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("Đây có phải là một sự quyến rũ xúc phạm không!? \\nỒ không, đó là điều mà không người đàn ông nào có thể cưỡng lại được!")
