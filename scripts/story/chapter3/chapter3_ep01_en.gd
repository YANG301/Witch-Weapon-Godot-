# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("The bizarre nightmare, the vague conversation, the shadow in the dream. \\nPlus a red alert notice…")
	await novel_interface.show_text_only("Just as I’m about to accept my new identity and decide to pull myself together, they messed everything up again.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Hmm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Did you see the news? \\nIt’s him! No, me, it's me!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("I'm not blind. Of course, I know it's you right before me, you sweating, silly girl.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("No! \\nDamn it. it's me on the news!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In a panic, I don't even know where to start. \\nMariru grunts and knocks my head with her hand.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Such a useless idiot. After all these trainings, you can't even report to your officer clearly.", "Mariru")
	await novel_interface.show_dialog("Isn’t it just about a guy that looks like you getting wanted worldwide because he burgles the Collection and Research Center of the Second Academy City?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yes, yes, yes! Exactly!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("The intelligence services had reported the news long before it went viral.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("You look silly when you are terrified~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru pinched my cheek. I tried to stop her right away.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, get serious!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Most wanted worldwide. It’s not a joke!", "Lian")
	await novel_interface.show_text_only("It could never have crossed my mind that one day I would be on the news for burlary.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("And it's a triple-A notice! As I recall, the last wanted guy with such an alert level was bombed to death in South America by a bunker buster.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("This damned burglar stole my previous identity just like that… I am almost in tears at the thought of this.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In this case… \\nThe only one I can count on is Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("As much as I want to watch you suffer like this…", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("I have to ask you to check the news again.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("Is it necessary? I’ve got the whole thing engraved in my mind already.")
	await novel_interface.show_dialog("The image might not be crisp and clear, but I am sure he looks almost exactly like me as a boy!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("To prove what I said, I pull up the news on my phone.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("See, this is… \\nEh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The wanted notice that freaked me out is no longer there. It was replaced by a normal missing person announcement.")
	await novel_interface.show_text_only("Seventy-year-old cartoonist Mr. Inoue went missing recently. \\nIf anyone knows his whereabouts, please contact the police immediately.")
	await novel_interface.show_text_only("I checked other websites, and even searched with keywords, but the news was nowhere to be found.")
	await novel_interface.show_text_only("Looking at Mariru's told-you face, I'm very grateful.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Was it you…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru comes over and wipes my tears.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Look at you—all choked up.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("If you really want to thank me—be my slave then~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("And…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("When you said \"the only one I can count on is Mariru\", \\nyou looked so cute…", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru raises my chin tenderly with her index finger.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Hey, stop that!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("As far as I can see, I am already enslaved…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("I wish I could do that. But to my knowledge, there’s only one agency that can shut up the entire social media worldwide.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("It must be an executive order from the United Congress.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The supreme congress representing all six Academy Cities… decided to take down the news?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Why…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru looks at me and gives me a mysterious smile.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Don't be silly. Obviously, they didn't do this to protect the burglar.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("They just don't want the public to know what was taken.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Who is this burglar? Why did he use my identity?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Whoever he is, he must be a genius to be able to get out of Akatraz's Collection and Research Center in one piece.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("The thing is, it’s not difficult for him to cover his face.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("But he didn’t, and even dare to go on the roof of building for a while…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("According to the special training, the most negligible things are either absent from where they are supposed to appear…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Or are present where they should not be.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
