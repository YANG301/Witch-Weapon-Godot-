# chapter3_ep03.gd - 第三章第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep03_script()

func play_script():
	pass

func chapter3_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Vuoi dire... Per cancellare tutte le informazioni di terze parti su quel ragazzo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("No. Al contrario, aggiungerò ulteriori informazioni.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa?!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Un sorriso agghiacciante si insinua sul volto di Mariru.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ora le uniche informazioni sul ladro sono solo filmati a bassa risoluzione.", "Mariru")
	await novel_interface.show_dialog("Immagina quante persone in tutto il mondo hanno facce così semplici.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Aspetta, hai appena detto semplice? Questo brucia.")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("E anche se qualcuno somigliasse a \"me\", sarebbe comunque facile scoprirlo.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Le telecamere di sicurezza registrano tutto ciò che ha fatto quel giorno!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Certo, non è difficile individuare una persona reale.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Ma cosa succede se... questa persona non esiste?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vuoi dire...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("Se inseriamo alcune identità contraffatte con caratteristiche facciali simili a quelle del sospettato, sarà quasi impossibile scoprirlo.", "Mariru")
	novel_interface.change_2nd_expression("normal2")
	await novel_interface.show_dialog("E per tutti, tranne noi, quelle persone non sono diverse da "+GameConfig.player_name+": sono solo altri scomparsi misteriosamente.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Allora come è possibile scoprire il vero obiettivo?", "Mariru")
	await novel_interface.show_dialog("Per nascondere un chicco di riso, lo porti via o cospargi un intero sacchetto di riso per coprirlo.", "Mariru")
	novel_interface.character_2nd_move_left(-0.25)
	novel_interface.show_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Sembra un progetto enorme...", "Lian")
	novel_interface.character_2nd_light()
	novel_interface.character_dark()
	await novel_interface.show_dialog("Solo un po’ di complessità in più per un problema semplice, in modo che i contribuenti siano contenti di come vengono spesi i loro soldi. Vedere? Due piccioni con una fava.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Ogni volta che fai commenti così inappropriati vorrei chiamare la polizia.", "Lian")
	novel_interface.character_2nd_light(0.35,"normal1")
	novel_interface.character_dark()
	await novel_interface.show_dialog("A proposito, ho trovato alcune contraddizioni nelle informazioni sulla tua identità.", "Mariru")
	novel_interface.character_2nd_dark()
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("Eh? Quale parte?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Dei tuoi genitori.", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Il mio cuore sprofonda quando sento la parola \"genitori\".")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Mi hai detto che tua madre è morta prematuramente e tuo padre era scomparso.", "Mariru")
	await novel_interface.show_dialog("So che non vuoi parlare di questo. Ma è importante. Devo verificare con te.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","upset",0.25)
	await novel_interface.show_dialog("Bene…", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru recupera i dati di cui ha eseguito il backup.")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Qui dice che tua madre è scomparsa il 25 luglio 2026, presumibilmente morta. \\nQuella fu la Grande Tribolazione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/seabed.png")
	await novel_interface.show_text_only("Prima di quel giorno, le rovine sottomarine nel nord-ovest New Opulentia erano state una città vivace.")
	await novel_interface.show_text_only("Ne ho solo un vago ricordo...")
	await novel_interface.show_text_only("Nel momento in cui la città è stata distrutta dalle armi Devine Touch, Aegis ha generato un campo protettivo. New Opulentia era proprio al limite.")
	await novel_interface.show_text_only("E... Ciò segnò l'inizio della Guerra dei Sette Anni.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform2","serious")
	await novel_interface.show_dialog("Padre, scomparso dal dicembre 2026. Presumibilmente...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Smettila... per favore!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hate this cold phrase—Presumed… dead.")
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Mi dico sempre... \\nForse... papà è ancora vivo...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("… Beh, tuo padre deve essere felice. Il suo ragazzo è cresciuto fino a diventare una bellissima ragazza!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ridacchio alle sue parole. \\nMaledizione, so che mi sta prendendo in giro!")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Bene, guarda questo.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fa clic sui profili dei miei genitori. Vengono visualizzati due codici.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Secondo il profilo—", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mamma, codifica offline. \\nPadre, codice offline.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("… Qualcosa non va?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Aegis non avrebbe assegnato un codice a tua madre se fosse morta prima che il campo protettivo fosse attivato o da qualche parte fuori dalla sua portata.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Eh…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mi guarda pensieroso.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Nemmeno tu ne hai idea? \\nI file non mentirebbero. Farò attenzione a questo...", "Mariru")

	print("=== 第三章第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
