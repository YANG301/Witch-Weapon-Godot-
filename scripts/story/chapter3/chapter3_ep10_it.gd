# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Grazie a Skurd, sembra che Fabella abbia deciso di lasciarmi andare.")
	await novel_interface.show_text_only("Proprio mentre Skurd si allontana, diversi ospiti ben vestiti si avvicinano e le parlano.")
	await novel_interface.show_text_only("La ragazza ha più o meno la stessa età di Elluka, ma brilla in un'occasione sociale così elegante...")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Appartiene a una famiglia nobile?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre Fabella rivolge la sua attenzione al suo padrone, mi intrufolo dall'altra parte della sala del banchetto.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Questo mi sta spaventando... \\nIl piccolo padrone e la sua cameriera, non è vero?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sembra che la cameriera non mi inchioderà. \\nVoleva solo ingannarmi?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ren, sei qui!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Potrei essermi imbattuto in un indizio importante!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Proprio ora ho seguito di nascosto la delegazione al piano esecutivo e lì ho visto l'entourage di Raphael portare una valigia speciale.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Una valigia... cosa c'è dentro?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non lo so. Ma ricordo che la formazione SID menzionava il materiale utilizzato nella valigia!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("È un metallo verde grigiastro con una particolare luminosità azzurra...", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Splendore azzurro... \\nCosa! Non è...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Ricordo una lega che riduce o elimina gli effetti degli psicoattivi e dei meme Substance H…")
	await novel_interface.show_text_only("I contenitori Substance H realizzati con questa lega possono eludere la maggior parte della scansione delle tonalità.")
	await novel_interface.show_text_only("La lega stessa è un Substance H: il 98% è costituito da metalli noti e il restante 2% è una sostanza sconosciuta.")
	await novel_interface.show_text_only("A causa della sua scarsità, il suo prezzo sul mercato nero è salito alle stelle.")
	await novel_interface.show_text_only("Sono quasi sicuro che qualunque cosa in quella valigia abbia qualcosa a che fare con Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Santo cielo! \\nHai segnalato questo a Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La delegazione Salmonton non ha riferito al Senato che porterebbe con sé alcun Substance H.")
	await novel_interface.show_text_only("Qualsiasi Substance H distruttivo introdotto di nascosto nel campo di forza protettivo può portare la catastrofe a New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Gliel'ho detto subito. Probabilmente starà richiedendo un mandato di perquisizione al Senato in questo momento.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ma l'ho visto a colpo d'occhio e non ho scattato nessuna foto. \\nNon credo che possano entrare nella stanza senza ulteriori prove...", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Ecco perché Mariru ha appena aggiornato la nostra missione in \"Proteggere e caricare prove al più presto\".", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Se è così, l’unica possibilità è intrufolarsi nelle loro stanze…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì... la stanza della ragazza. Non è un compito facile.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Hmm... Dovremo suonarlo a orecchio adesso.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("Il piano esecutivo è riservato alla delegazione. Ci arriviamo tramite l'ascensore di servizio.")
	await novel_interface.show_text_only("Spingo il carrello di servizio \"preso in prestito\" verso il corridoio pesantemente sorvegliato. Annie si nasconde sotto...")
	await novel_interface.show_dialog("Ehi! Non dovresti essere al banchetto di sotto? \\nNon sei autorizzato qui. Vattene adesso.", "Sicurezza")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Così tante guardie di sicurezza, sicuramente...)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Eh? Ma un ospite della Royal Suite ha appena ordinato il servizio in camera di foie gras con whisky fiammeggiante!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il leader non sembra affatto impressionato.")
	await novel_interface.show_text_only("Chiaramente l’ho sottovalutato. Devo trovare un altro modo...")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Uh... forse il servizio in camera ha commesso un errore. Le mie scuse, signore...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho appena finito di parlare che Annie si precipita fuori e si colpisce al collo con la mazza da baseball.")
	await novel_interface.show_text_only("Poi si gira e lancia una palla da baseball direttamente in faccia a un'altra guardia a 10 metri di distanza.")
	await novel_interface.show_text_only("La guardia rimasta rimane sbalordita dall'attacco. Prima che possa raggiungere il ricetrasmettitore, Annie gli dà un calcio dritto al mento.")
	await novel_interface.show_text_only("Tre uomini crollano quasi tutti insieme. La mazza rimbalza sul pavimento e torna nella mano di Annie.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Chiaro!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Cosa... cosa hai fatto?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Niente. Lasciarli riposare solo per un po'.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Haha, è così Annie… \\n(Grazie a Dio, sono con lei…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("E non ha nemmeno usato la magia! \\nChe tipo di formazione sta ricevendo...")
	await novel_interface.show_text_only("Dopo aver allontanato le guardie, Annie mi porta nella suite a doppia porta alla fine del corridoio.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ecco.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ci scambiamo uno sguardo. \\nProprio mentre stiamo per premere le orecchie sulla porta...")
	await novel_interface.show_text_only("Si apre improvvisamente dall'interno. Veniamo colti di sorpresa e cadiamo a terra all'interno della stanza.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Owwww…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alzando lo sguardo, vedo un volto familiare e arrogante.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael è circondata da diverse guardie del corpo e dal suo entourage, con un'espressione di disprezzo sul viso.")
	await novel_interface.show_text_only("Wow, così tante donne mature e carine!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Ehm? Non sei tu quel maniaco del travestitismo che viene da quella discarica di scuola? Cosa stai facendo qui?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("In abiti da cameriera francese! Non ti senti abbastanza pervertito?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("W... che coincidenza! \\nLavoro part-time qui con il mio compagno di classe...", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Oh, e... la sala banchetti al piano di sotto, giusto? \\nPotremmo essere arrivati ​​nel posto sbagliato.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Scusa, Annie, faccio schifo a mentire!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("È strano. Le guardie di sicurezza non ti hanno fermato?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Confuso, Raphael guarda in fondo al corridoio.")
	await novel_interface.show_text_only("Raphael è sconvolto quando trova le guardie di sicurezza, tutte stese sul pavimento.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("—Prendili!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
