	await novel_interface.show_dialog("Attendez, alors le premier concerné devrait être…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Laisse ça de côté, d'accord ? Les gars dehors font irruption.", "Mariru")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Oh, oublie presque ces idiots inutiles !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","smile")
	await novel_interface.show_dialog("Ouf, je peux enfin me débarrasser de cette tenue !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alors que je commence à ressentir un certain soulagement, un frisson m’envahit.")
	await novel_interface.show_text_only("Une tache blanche apparaît sur la croûte de l'aérogel. Il se dilate progressivement, produisant un crépitement.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Les soldats de sécurité… sont-ils généralement armés d’injecteurs d’azote liquide ?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avec un grand craquement, la croûte de l'aérogel tombe en morceaux comme du verre brisé.")
	await novel_interface.show_text_only("Un groupe d’hommes armés se précipite et nous encercle.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Que veux-tu ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je ne sais pas qui ils sont, mais à leurs étranges masques bleu foncé, je peux dire que ce ne sont pas des soldats de la sécurité.")
	await novel_interface.show_dialog("Je ne m'attendais pas à ce jour si tôt…", "Voix masculine")
	await novel_interface.show_text_only("Une voix masculine familière vient de derrière la porte.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Vous êtes—?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Ravi de vous rencontrer… encore.", "Jacob")

	print("=== 第3章第13话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
