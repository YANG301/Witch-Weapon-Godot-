	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("C'est absurde ! Ce collier appartient à la famille Dekkers… Il est avec nous depuis des centaines d'années !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Est-ce la résonance entre les affaires d'une sorcière et l'Éclat de Sorcière ?", "Annie")
