	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Si je me souviens bien, c'est le joyau du sabre que mon père m'a confié.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("Quoi ?!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Tout à l’heure, cela a résonné violemment en moi dans l’obscurité…", "Beatrice")
	await novel_interface.show_dialog("Même s’il y avait une barrière entre les deux, j’en étais sûr car je ne me méprends jamais sur les choses qui m’appartiennent.", "Beatrice")
