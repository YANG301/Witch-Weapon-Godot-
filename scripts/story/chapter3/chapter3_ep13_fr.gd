	await novel_interface.show_dialog("Eh bien, maintenant que j'y repense… Une seule chose était étrange.", "Raphael")
	await novel_interface.show_dialog("Cet après-midi, mes gardes du corps étaient quelque peu distraits et contrariés.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Je suppose… je connais la raison.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Oh, et toi ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Le pendentif de votre collier… c'est une émeraude, je suppose ?", "Beatrice")
