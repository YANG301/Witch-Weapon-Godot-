	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Êtes-vous celui qui me donne cette nouveauté de vie ?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","timid")
	await novel_interface.show_dialog("Moi ? \\nQuoi, euh…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Est-ce une sorte de blague ?", "Raphael")
	novel_interface.change_expression("jeer")
