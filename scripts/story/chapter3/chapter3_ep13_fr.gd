	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("Grand-père…", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Je ne suis pas un enfant !", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Un grand pouvoir implique de grandes responsabilités. \\nVotre grand-père semble être un grand homme.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Hmm, j'espère juste que vous êtes digne de confiance.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Alors, peux-tu me parler de ta valise ?", "Mariru")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Demandez à vos propres hommes ! Je veux dire le monstre du travestissement et cette petite fille.", "Raphael")
	await novel_interface.show_dialog("S’ils n’étaient pas entrés par effraction dans ma chambre, je n’aurais pas du tout remarqué la valise.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","speechless")
	await novel_interface.show_dialog("Amateur de travestissement ?", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sans m'en rendre compte, j'arrache mes tenues de servante française. \\nQuel dommage !")
