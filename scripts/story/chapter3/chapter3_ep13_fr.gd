	await novel_interface.show_dialog("Witches… \\nThey only exist in made-up legends. Les sorcières n'existent pas.", "Raphael") 
	await novel_interface.show_dialog("Votre cerveau est brisé ? \\nMême Substance H ne peut pas faire ça.", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Parce que… \\nParce que… !", "Raphael")
	await novel_interface.hide_character()
