# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Os registros SID mostram que o Akatraz Center coleta a classe EX Substance H que é proibida pelo Congresso Unido para ser testada e pesquisada.")
	await novel_interface.show_text_only("Sob o solo do Centro, ele está conectado à entrada de uma antiga relíquia Chate Cave-house, cuja entrada é proibida e nem sequer pode ser avaliada.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("EX-class Substance H… É algum tipo de coisa altamente perigosa?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("A maioria deles são itens sagrados de significado religioso. Por serem especiais para seguidores religiosos, podem ser coletados, mas a pesquisa é proibida.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Parece autoengano.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Hah, eu me senti da mesma maneira. \\nMas, de certa forma, faz sentido.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Diz-se que alguns artefatos na tradição religiosa possuem poder de matar deuses ou de desencadear o Juízo Final.", "Mariru")
	await novel_interface.show_dialog("Uma vez ativados, eles poderiam causar uma catástrofe em escala apocalíptica.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso é ruim.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Embora alguns itens reverenciados em histórias religiosas mais tarde se revelassem fracos – ou mesmo embaraçosamente ineficazes ...", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Algo bobo?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Certo, um exemplo é este par de sapatos sagrados. Quem beija a ponta do sapato não resiste a riscar – que vergonha para a religião.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso é nojento. \\nEntão. a que tipo pertence esse que falta?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("É o Destiny Spear - um Substance H da classe EX sob a custódia conjunta de todas as cidades acadêmicas.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ah. \\nEntendo, parece legal.", "Lian")
	await novel_interface.show_dialog("O que exatamente é o Destiny Spear então?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Você parece um completo idiota agora.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("Ei, eu realmente não tenho ideia! \\nSou apenas um estudante do ensino médio.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru olha para mim desamparado, como se estivesse se perguntando por onde começar comigo.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Resumindo, é o primeiro tipo de Substance H, que se acredita ter poderes deicidas.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Muito pouca descrição do Destiny Spear é encontrada na literatura disponível publicamente, exceto que “não derrete em altas temperaturas” e que “ganha peso quando balançado”.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("É isso?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se você se aprofundar, descobrirá que qualquer uma das características o tornará um Substance H da classe XK.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Pode haver algumas outras características perigosas e desconhecidas. É por isso que não devem chamar muita atenção da mídia.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Isso me dá arrepios. Até as crianças sabem o que é um Substance H da classe XK…")
	await novel_interface.show_text_only("Isso levaria a um desastre apocalíptico ou criaria outro Substance H com o mesmo poder. Atualmente, existem apenas seis itens desse tipo conhecidos em todo o mundo.")
	await novel_interface.show_text_only("Cada uma delas pertence a uma das seis Cidades Acadêmicas. Mais precisamente, apenas aqueles que possuem tal Substance H são reconhecidos pelo Congresso Unido.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Hein? \\nO que significa ... ?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agora você sabe que crime grave “você” cometeu?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Estou tão chocada a ponto de tudo me parecer surreal.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Desculpe. \\nNão! Por que eu pedi desculpas? Eu não sou o ladrão!", "Lian")
	await novel_interface.show_dialog("(Merda. Esse cara deve ser super perigoso!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Mas felizmente a notícia foi removida.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eles fizeram isso apenas para evitar o pânico público.\\nA investigação ainda continuaria, secretamente.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Por questões de confidencialidade, a notificação de procuração não será enviada ao Ministério da Defesa. Mas todos os serviços de inteligência, incluindo SID, já devem ter sido notificados.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Então ainda é cedo para se sentir aliviado, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Certo... o velho eu ainda está em perigo, certo?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("E se... quero dizer, e se... \\n...alguém me rastrear...", "Lian")
	await novel_interface.show_dialog("Mesmo que agora eu seja uma menina, provavelmente poderia ser presa, certo?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Você finalmente entendeu.", "Mariru")
	await novel_interface.show_dialog("O serviço de inteligência verificou todas as imagens disponíveis do CCTV e descobriu que o cara apareceu em outras áreas do Flux, ainda com seu rosto antigo.", "Mariru")
	await novel_interface.show_dialog("Como podemos recuperar os dados de uma fonte terceirizada, outros serviços de inteligência provavelmente também já possuem essas informações.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("Já é reincidente? \\nMeu futuro parece sombrio ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Imagino-me torturado em intermináveis interrogatórios…")
	await novel_interface.show_text_only("Sinto que serei preso a qualquer momento e rotulado como um criminoso contra a humanidade.")
	await novel_interface.show_text_only("Foi preso na prisão mais brutal, condenado a mais de 200 anos de prisão.")
	await novel_interface.show_text_only("Posso ter um companheiro de cela extremamente perigoso, e ele...")
	await novel_interface.show_text_only("Uau, pare com isso! \\nChega de pensar!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Hahaha. Você está tão assustado e parece tão pálido.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Calma, Ren. Posso garantir 98% de segurança enquanto você estiver em New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("Então ainda tenho 2% de chance de ser pego?", "Lian")
	await novel_interface.show_dialog("(Dois segundos de incerteza em cada cem segundos!) \\n(Isso não é nada seguro!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Que aqueles velhos do Congresso Unido tenham chegado a um consenso em tão pouco tempo... Algo não está certo.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("E este é o fator desconhecido de 2% de que eu estava falando.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Não consigo imaginar a agitação que isso causou entre aqueles figurões...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Portanto, os serviços de inteligência de outras Cidades Acadêmicas devem ter usado muitos recursos para caçar o ladrão.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("O… o que devo fazer?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Um inimigo visível é sempre fácil de lidar. Vamos deixar para SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
