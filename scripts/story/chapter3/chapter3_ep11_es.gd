# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Estamos rodeados por los guardaespaldas de Raphael. Annie me guiña un ojo—")
	await novel_interface.show_text_only("Entendí su punto de inmediato y liberé todo el poder de presión que acumuló cuando estábamos en el pasillo.")
	await novel_interface.show_text_only("De repente, cientos de pelotas de béisbol salen disparadas, golpeando a un hombre e inmediatamente rebotando hacia otro.")
	await novel_interface.show_text_only("Obviamente, como nunca antes habían visto esto, los guardaespaldas entran en pánico y son golpeados uno tras otro.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Nunca antes había usado este truco con gente común y corriente. Funciona tan bien…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("¡Por supuesto! ¡Es mucho más fácil tratar con humanos cuerdos que con brujas locas!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("¡Dispara! Ustedes idiotas...", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("¡Cómo os atrevéis, alborotadores! ¡Los soldados de seguridad no te dejarán escapar!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sólo me doy cuenta de que después de la pelea, la Suite Real de Raphael se ha convertido en un desastre total, con sus guardaespaldas tirados por el suelo.")
	await novel_interface.show_text_only("Annie y yo sólo queríamos colarnos y recopilar pruebas, pero parece que hemos causado un grave desastre diplomático...")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mierda… Annie! \\nC... ¡vamos! ¡¡Átala!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Presa del pánico, le doy a Annie una instrucción loca.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("¡Sí! ¡Servirá!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie derriba ágilmente a Raphael, abre una cortina que cayó al suelo durante la pelea y, con ella, ata rápidamente a la chica que lucha.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("¡¡Cómo te atreves—!! \\n¡Pervertido travesti! ¡¿Qué quieres de mí?!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ahora, Raphael, la invitada de honor estatal en New Opulentia, nieta del alcalde de la Cuarta Ciudad Academia, está atada a una silla en su propia suite—")
	await novel_interface.show_text_only("¡¡Annie es realmente bueno en esto!! \\nY parece que nunca podré deshacerme de la reputación de pervertido...")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Lamento mucho esto, pero debemos asegurarnos de que no actives la alarma...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Señalo un botón rojo en la pared. Una vez presionado, un equipo de soldados de seguridad fuertemente armados rodeará la habitación en 3 minutos.")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, entonces ¿qué quieres?", "Raphael")
	await novel_interface.show_dialog("No ocultan sus identidades y no parecen tener un plan de evacuación. \\nEsto no es un secuestro para pedir rescate, ¿verdad?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incluso cuando está atada a una silla, Raphael todavía parece confiada y piensa con claridad... Qué dama tan noble.")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("¿Quién eres? \\n¿Acabas de usar armas Substance H?", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sus palabras me recuerdan mi tarea prioritaria en este momento.")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Sra. Raphael, solo queremos aclarar una cosa. \\nSe trata de esa maleta...", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("¿Qué maleta?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael parece desconcertado y parece no tener idea de lo que dije.")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Parece que… ¡ya está roto!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("¡¿Qué?! ¡Pensé que la aleación debería ser muy resistente!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Miro hacia donde apunta Annie y veo la maleta, ahora rota con enormes agujeros dejados por los tiros de pelotas.")
	await novel_interface.show_text_only("La cubierta de plástico negro de la maleta está rota, dejando al descubierto una capa de metal que emite una luz azul pálida.")
	await novel_interface.show_text_only("El plástico es una cubierta desmontable común. Annie debe haber notado la capa interior de la maleta.")
	await novel_interface.show_text_only("La cerradura está destruida y los componentes y piezas de metal quedan esparcidos por la alfombra.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es extraño: mis pelotas de béisbol solo apuntan a objetivos vivos...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Raphael parece haber notado también el material que emana luz azul. Ella parece sorprendida y nerviosa.")
	await novel_interface.show_text_only("Entre las espumas antigolpes y las piezas de metal esparcidas, veo una pequeña cosa brillante.")
	await novel_interface.show_text_only("Es un accesorio dorado con forma de mariposa. Con delicados patrones recortados en las alas, parece una mariposa real.")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("¿Podría ser esta cosa... que atrajo tus pelotas de béisbol para apuntar a la maleta?", "Lian")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Cuidado! Podría ser un Substance H—", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La realista mariposa dorada parece lista para volar en cualquier momento. Incluso Raphael está hipnotizado. No puedo evitar acercarme...")
	await novel_interface.show_dialog("Oye, idiota. \\nDije que no lo toques.", "Mariru")
	await novel_interface.show_text_only("La voz de Mariru surge de la nada. De repente, en algún lugar de mi cuerpo siento un zumbido. Se siente como si estuviera hablando a mi lado.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("¿Eh? \\n... ¿¡Qué es eso!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Exploro alrededor de mi cuerpo, esperando descubrir de dónde viene la voz y asegurarme de no ver ningún altavoz en alguna parte.")
	await novel_interface.show_dialog("Si la pelota de béisbol de Annie pudiera dejar un agujero tan profundo en la aleación con una dureza Rockwell de 70, las cabezas de los guardaespaldas se habrían convertido en barro.", "Mariru")
	await novel_interface.show_dialog("Es más probable que el pequeño artilugio solo quisiera usar los amortiguadores de las pelotas de béisbol para escapar...", "Mariru")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Esos agujeros… ¿los dejó el propio accesorio?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ajá, muy probable. Entonces, ¿todavía quieres tocar algo tan peligroso?", "Mariru")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Espera, el problema es... ¡¡¡\\nMariru!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡Maldita sea! ¡Encuentro la fuente de su voz!")
	await novel_interface.show_text_only("¡Está directamente desde mi pecho! No es de extrañar que mi cuerpo sienta un zumbido cada vez que ella habla...")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("¡¡Cómo pudiste poner un chip en mi cuerpo!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Acabas de revelar casualmente nuestra tecnología secreta a un extranjero! ¿Quieres que te sellen otra vez?", "Mariru")
	await novel_interface.show_dialog("Annie, ¡que duerma un rato a la señora! \\nPero ten cuidado. No lastimes a nuestro invitado de honor.", "Mariru")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("¡Oye! ¡No te atrevas—!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie lanza hábilmente la mano de un cuchillo a la nuca de Raphael, dejándola sin conocimiento.")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("La Sra. Mariru, Substance H tiene prohibido ingresar a New Opulentia sin aprobación oficial, ¿no es así?", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Por supuesto! ¡Humph, me pasaron esto de contrabando delante de mis narices! El Dr. Dekkers tendrá que explicar esto al Senado.", "Mariru")
	await novel_interface.show_dialog("… ¡Espera! Creo que los guardias de seguridad de afuera han llamado algo de atención.", "Mariru")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("Eh, eso es rápido.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Los soldados de seguridad de abajo se están reuniendo en el vestíbulo. \\nVoy a llevar al equipo de recolección para ayudarte. Llegaremos en 8 minutos.", "Mariru")
	await novel_interface.show_dialog("Annie, selle la puerta con aerogeles ahora.", "Mariru")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("¡Sí, señora!", "Annie")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
