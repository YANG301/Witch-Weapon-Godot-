	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Non, non, non. Ce n’est qu’un jeu d’enfant comparé à se transformer en sorcière ! \\nEh bien, si vous avez vraiment un tatouage, montrez-le-moi s'il vous plaît…")
