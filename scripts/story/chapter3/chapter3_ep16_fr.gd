	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Pouvez-vous imaginer qu'ils m'ont envoyé à l'étranger juste pour me laisser faire profil bas après cette stupide interview ?", "Raphael")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("S’ils découvrent cela, ils vont probablement paniquer, comme lorsqu’ils ont appris que je m’étais fait tatouer.", "Raphael")
