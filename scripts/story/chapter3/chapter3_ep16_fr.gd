	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("De nombreux États ont déclaré des guerres au nom des dieux. Alors pourquoi je ne peux pas dire ce que je pense ?", "Raphael")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La guerre ? Vous voulez dire… la guerre de Sept Ans ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Non, espèce d'idiot. Bien sûr les guerres à venir !", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Chez Salmonton, nous encourageons les gens à avoir leur propre religion, quel que soit le dieu en lequel ils croient.", "Raphael")
	await novel_interface.show_dialog("À la suite des migrations massives qui ont suivi la guerre de Sept Ans, d’innombrables déchets se sont précipités sur ces groupes inutiles, et leur avarice ne connaît pas de frontières.", "Raphael")
