	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Vous avez raison. Le papillon doré a des propriétés similaires à celles du mème infectieux Substance H. Le bouclier que nous utilisons pour un objet aussi dangereux est généralement aussi gros qu’un camion.", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Mais ils l'ont juste mis dans une valise. L’énergie qui s’échappe de cette valise peut même être détectée par les satellites.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("S’ils voulaient vraiment l’introduire clandestinement, pourquoi ont-ils dû demander à ces représentants du gouvernement de le faire ? Pourquoi prendraient-ils un si grand risque politique ?", "Mariru")
