	await novel_interface.show_text_only("La course au contrôle du pouvoir surnaturel a plongé le monde dans le chaos de la guerre de Sept Ans. Est-ce que cela va se reproduire ?")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y aura-t-il alors plus de sorcières produites ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Il est temps de se préparer à ce combat sous la table.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Quelques semaines plus tard")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Nnngh ... J'arrive à peine à garder les yeux ouverts ... \\nJe suis resté éveillé toute la nuit à jouer à un jeu ...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Hé, maniaque du travestissement.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("???", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The familiar voice…")
	await novel_interface.show_text_only("L'endroit familier…")
	await novel_interface.show_text_only("Et la salutation familière…")
	await novel_interface.show_text_only("La fille qui se tient devant moi… C'est encore elle !")
	await novel_interface.show_text_only("Ce fauteur de troubles à la langue acérée Raphael !")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ra-Raphael ? \\nPourquoi es-tu ici ?", "Lian")
