	await novel_interface.show_dialog("Le Sénat est la plus haute autorité de New Opulentia. Alors naturellement, SID doit travailler avec. En d’autres termes, SID et le Sénat sont partenaires.", "Mariru")
	novel_interface.change_2nd_expression("smile")
