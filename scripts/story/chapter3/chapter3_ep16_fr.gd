	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mais… il y a encore beaucoup de points discutables dans cette affaire.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Par exemple, pourquoi la délégation Salmonton a-t-elle introduit clandestinement le Papillon d'Or à New Opulentia ?", "Lian")
