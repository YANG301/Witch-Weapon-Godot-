	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Fille intelligente. Tant que l’agence est suffisamment grande, elle peut toujours être démantelée de l’intérieur, quel que soit le degré de rigueur de son protocole de sécurité.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si… si c'est le cas, nous avons aussi des grains de beauté dans SID ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Vous pariez. Il y a des milliers d'employés dans SID et certains d'entre eux doivent être des espions, qu'ils proviennent du Sénat, d'agences de renseignement étrangères ou d'autres organisations.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("C'est pourquoi nous ne devons tenir informé qu'un petit groupe de personnes lorsqu'il s'agit de renseignements clés.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Alors qu’en est-il de la Salle d’Ivoire…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
