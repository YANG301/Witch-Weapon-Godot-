	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Peut-être qu’il n’y a aucun risque. C'est peut-être un ordre de quelqu'un de plus haut placé qui leur a donné la garantie…", "Lian")
	await novel_interface.show_dialog("Les membres de la délégation n'ont pas besoin de déclarer leur bagage à main au contrôle de sécurité. Et ils ont délibérément choisi un hôtel en dehors de notre juridiction.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Êtes-vous en train de dire…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Vous l'avez enfin compris ?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Le Sénat leur a ordonné de le faire ? Juste pour garder SID dans le noir ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Jacob est un attaché militaire de Salmonton et les données de Elluka montrent qu'ils étudient les sorcières depuis un certain temps.", "Mariru")
