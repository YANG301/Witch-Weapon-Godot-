# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("我忐忑不安地帶著拉斐爾參觀校園。")
	await novel_interface.show_text_only("沒想到接近任務目標的這個步驟如此順利。")
	await novel_interface.show_text_only("挖空心思籌備歡迎儀式卻被放鴿子的副校長，正蹲在我們身後不遠處，牙癢癢地咬著手帕。")
	await novel_interface.show_text_only("而這位大小姐，雖然並沒有多滿意的樣子，但心情似乎比剛才好了不少。")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("就這樣嗎？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("嗯？ 妳是說參觀內容嗎？", "小憐")
	await novel_interface.show_dialog("再往那邊就是校外的商業區了……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("這裡很多設計是仿照戰前的知名建築，試圖提升自己的文化底蘊。", "拉斐爾")
	await novel_interface.show_dialog("但園區面積太小，各種風格的建築之間沒有緩衝和過渡的區域。", "拉斐爾")
	await novel_interface.show_dialog("在這種地方，妳們不會感到鬱悶嗎？", "拉斐爾")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("新豐洲是在廢墟上重建的城市，本來就沒留下多少有歷史底蘊的建築。")
	await novel_interface.show_text_only("而且在防護力場內這種寸土寸金的地方，有如此規模的占地面積已經相當奢侈了。")
	await novel_interface.show_text_only("突然被這麼說，總覺得有些不爽……")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("唔……", "小憐")
	await novel_interface.show_dialog("妳應該就是來自第四學園都市的拉斐爾·戴克斯小姐吧？", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("既然這麼看不上這裡，為什麼還來參觀啊？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("哦？ 妳知道我是誰啊。", "拉斐爾")
	await novel_interface.show_dialog("哼，要不是爺爺想安排我到其他學園都市留學……", "拉斐爾")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("像這種只知道模仿，沒有半點文化精髓的地方──我根本連一步都不想踏進去！", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("……", "小憐")
	await novel_interface.show_dialog("（所以是不滿意家人的安排而心生怨念嘛……)\\n（這麼簡單的事情說清楚不就好了！ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("真是糟糕，被她一說，我也開始覺得學校裡的建築風格有點彆扭不自然了。")
	await novel_interface.show_text_only("真是有毒的批評，快點忘掉！ ！")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("哎呀呀，既然對家人的安排這麼不滿意──", "倪克斯")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("為什麼不直接說出自己的想法呢？", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("倪克斯學姐從我們身後逐漸走了過來，姿態還是那麼優雅自然。")
	await novel_interface.show_text_only("學姐和拉斐爾眼神相遇的瞬間，我彷彿聽到了高壓放電擊穿空氣的聲音。")
	await novel_interface.show_text_only("是……錯覺吧？")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("妳又是誰？", "拉斐爾")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("我只是這所學校裡一名普通的學生罷了。", "倪克斯")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("倒是這位貴族大小姐，從剛才起，就對我們學校充滿鄙視呢。", "倪克斯")
	await novel_interface.show_dialog("既然這樣，為什麼還要紆尊降貴地來這裡呢？ 是家族的壓力嗎？", "倪克斯")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我和我家裡的關係，輪不到妳來指手畫腳！", "拉斐爾")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("所以說到底，妳根本只是不敢違抗父母命令的任性小孩──", "倪克斯")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("憑什麼自認為高人一等，對給妳當免費嚮導的人的校園指指點點呢？", "倪克斯")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("哈？ ！我什麼時候說過高人一等的話了？", "拉斐爾")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("喂，女裝癖，我有說過那種話嗎？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("倒也不算啦……", "小憐")
	await novel_interface.show_text_only("可惡，誰是女裝癖啊！")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("妳看，我明明沒說過。", "拉斐爾")
	await novel_interface.show_dialog("而且話說回來，妳脖子上戴的那個……", "拉斐爾")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("上學還戴著這種東西，真的沒問題嗎？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("其實我們學校沒有禁止戴首飾的規定啦……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("而且學姐的項鍊明明很可愛！")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("雖然故意鑲嵌在低反光材料上……但那是戰前從動蕩的宮廷流出並碎裂成了三塊的「奧爾洛夫黑鑽」吧。", "拉斐爾")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("實際價格能換這裡幾棟教學大樓了吧？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("──啥！ ！？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("妳還裝出一副替平民發聲的樣子，該不會想讓這個女裝笨蛋以為妳和她是同一邊的吧？", "拉斐爾")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("……", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("誰是女裝笨蛋啊！ ！")
	await novel_interface.show_text_only("還有倪克斯學姐為什麼突然露出心虛的樣子啊？ ！")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("我只是戴了與自己相稱的飾品而已。", "倪克斯")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("反而是妳，既想表現自由獨立，又仗著家族庇蔭趾高氣昂的樣子，真是太可笑了。", "倪克斯")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("我記得那三塊黑鑽後來落到了黑手黨教父手裡，用黑錢買的黑鑽，真的和妳很相稱呢。", "拉斐爾")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("不像您的家族，用壟斷糧食貿易獲取龐大財富和貴族地位，連衣服都這麼鬱鬱蔥蔥的。", "倪克斯")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("沒辦法，就是只有我們的作物可以預防「黑縷病」啊，總不能像妳一樣，連切開都是黑的。", "拉斐爾")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("明明用飢餓威脅著全世界，還宣揚著什麼人不能失去信仰，妳們平時都不探究一下自己的靈魂嗎？", "倪克斯")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("我的靈魂不需要妳這種人來探究，那絕對會成為我人生的污點。", "拉斐爾")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("哎呀真巧，我也不想踩到垃圾堆裡研究廢物的真實形態呢。", "倪克斯")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("午後陽光溫暖地灑在我們三人身上。")
	await novel_interface.show_text_only("我站在她們中間，看著兩位的背景似乎都很不得了的少女鬥嘴，全然不知如何勸架。")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("（妳們兩位，真的是第一次見面嗎？ ）", "小憐")
	await novel_interface.show_dialog("（真的不是從小到大的仇人嗎？ ）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("遠處的副校長已經緊張得昏厥過去，被抬走了。")
	await novel_interface.show_text_only("算了，反正莉琉要我打聽的情報已經到手了。")
	await novel_interface.show_text_only("……就別在意了吧？")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
