# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("詭異的惡夢、意義不明的對話、夢中的黑影，\\n以及在全世界網路放送的AAA級通緝令……")
	await novel_interface.show_text_only("在我勉強接受了新的身分和生活，重新開始振作起來的時候，它們又把這一切打亂了。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("──莉琉！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("嗯？", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("妳看到新聞了嗎？ \\n他……不對，是我，我出現了啊！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("我又沒瞎，當然看見了妳正滿頭大汗又傻乎乎地站在我面前呢。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("不是啦——\\n可惡，是新聞上那個啦！ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("忙亂之中，我一時不知該從何說起，\\n莉琉哼了一聲，用手刀敲了下我的腦袋。")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("訓練這麼久，妳怎麼還是這麼沒用啊，連這點事都不能向長官準確回報。", "莉琉")
	await novel_interface.show_dialog("不就是一個和以前的妳長得很相似的人，搶劫了第二學園都市的收容基地，然後被全世界通緝了嗎？", "莉琉")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("對對對，就是這樣沒錯！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("這種在網路上瘋傳的消息，情報部門的人早就報上來了。", "莉琉")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("瞧妳一副花容失色的樣子，實在太蠢了～", "莉琉")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("莉琉小姐捏了我的嘴角，我連忙抓住莉琉小姐亂動的手。")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("……莉琉，現在是開諸（這）宗（種）玩笑的時候嗎？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("被全球通緝欸，這怎麼能算小事？", "小憐")
	await novel_interface.show_text_only("我做夢也想不到，第一次上新聞居然是因為這種事啊！")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("而且是AAA級通緝！ ！我記得上一個獲此殊榮的傢伙是在南美山區裡被鑽地彈直接打爆的。")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("這個可惡的搶劫犯，就這麼偷走了我的人生……想到這裡我就著急到快哭出來了。")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("如果是這樣……\\n我能依靠的，只有莉琉了……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("雖然很想再繼續欣賞妳花容失色的樣子……", "莉琉")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("不過，妳要不要再確認一遍看看。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("這種事還需要再確認嗎？ 新聞上的資訊已經完全印刻在我腦海裡了。")
	await novel_interface.show_dialog("雖然那上面的影像不太清楚，但和我男生時樣子完全一樣，幾乎就是我本人啊！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("雖然嘴上這麼說著，但我還是不服氣地拿出手機打開了那個新聞網頁。")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("你看，這明明就——\\n咦？ ！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("今天清晨那則讓我驚慌失措的通緝令，已經變成了一則普通的尋人啟示。")
	await novel_interface.show_text_only("70歲的漫畫家井上先生於近日走失，\\n如有能夠提供線索者，請及時與警察聯絡……")
	await novel_interface.show_text_only("我又翻查其他網站，甚至用關鍵詞搜尋，那則新聞就像從未存在過一樣。")
	await novel_interface.show_text_only("望著眼前笑得有些不懷好意的莉琉，我心中湧上了一股感激之情。")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("是、是妳做的嗎？ ……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉走近我，輕輕地擦了擦我的眼角。")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("妳看妳，都快要哭出來了。", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("如果真的想要感謝我的話，今後就為我做牛做馬，一輩子供我使喚吧～", "莉琉")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("而且……", "莉琉")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("妳說出「我能依靠的只有莉琉了」這種話的樣子，\\n實在是可愛地讓人欲罷不能呢……", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("莉琉用食指輕輕抬起我的下巴。")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("別、別捉弄我啦～！", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("而且從現狀看來，我也一直在為妳做牛做馬啊……")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("——雖然很想說我有這個本事，但是目前能做到讓全世界的媒體都乖乖聽話的，目前只有一個機構。", "莉琉")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哎？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("是「聯合議會」下達的強制令。", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("六個學園都市聯合組成的最高議會……居然會下令撤除我的新聞？", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("為什麼……", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("莉琉定神打量了我片刻，勾起一抹神祕的笑容。")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("妳少自以為是了，他們這麼做顯然不是為了保護劫匪。", "莉琉")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("而是不能讓大眾知道，被搶走的是什麼。", "莉琉")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("那個劫匪究竟是誰，他為什麼會以我的身分出現？", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("能闖入阿卡特拉茲收容基地並全身而退的人，十分值得欽佩啊～", "莉琉")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("真正的問題是，這樣的人如果想要遮住樣貌應該很簡單。", "莉琉")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("但那個傢伙非但不遮掩，還很囂張地在樓頂站了一會……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("培訓課程裡學過，最容易被忽視的，是那些本該出現但卻沒有……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("──以及本不該有卻出現了的訊息。", "莉琉")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
