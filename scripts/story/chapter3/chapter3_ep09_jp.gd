# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("昨晩より、SIDは「スカイホテル」の地点にて、\\n断続的な時空位相波動を観測している。")
	await novel_interface.show_text_only("偶然にもサモントン視察団の全員が、\\nこの『協定非武装区域』に存在している、\\n豪華ホテルにチェックインしている。")
	await novel_interface.show_text_only("彼らは今夜、各学園都市の名士を招待しての、\\n芸術品交流のディナーパーティをホテル内にて\\n開催する模様だ。")
	await novel_interface.show_text_only("しかしラファエルと彼女の従者達は、\\nディナーのゲストリストに載っていなかった。")
	await novel_interface.show_text_only("そのため、俺とアニーはこの厄介な場所に\\n直接足を踏み入れ────\\n再びマリルに与えられた任務に挑む。")
	await novel_interface.show_text_only("豪華な宴会所の入口で不安に襲われ、\\n俺はそわそわしていた。")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("うーん……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("どうしたの、緊張してるの？", "アニー")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("緊張するに決まってるだろっ！\\nこれメイド服だぞっ！？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そう。\\n今夜俺とアニーは変装して会場に潜入している。")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("だけどなんで、アニーが御桜川の生徒会代表で、\\n俺が接客担当のメイドなんだよ！！", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("メイド服って男の子のロマンでしょっ？", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("そのロマンには「自分がメイド服を着る」って\\n項目は含まれてないからな！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("まぁ……\\nそれもそうか～～", "アニー")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("こんなに可愛いのに、自分で姿を見られないなら\\n不満があってもしょうがないね……", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーは少し下り、携帯を取り出して……\\nパシャ！　っと写真を撮った。")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("うん……\\nやっぱレンちゃんはツインテールも似合う！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("やめろぉぉ　撮るなぁ────\\n消せ、早く消せっ！", "小憐")
	await novel_interface.show_dialog("（こんな恥ずかしい事が……）\\n\\n（万が一にも流しゅ……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーの携帯から送信成功のメロディが流れた。")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("レンちゃんとマリルさんに送信したよ～～", "アニー")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("＼(^o^)／")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("えへへ、そんなに恥ずかしがらなくてもさ～～\\nこのフリルなんてレンちゃん超似合ってるから！", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("携帯を取り出し、アニーから受信した写真を\\n自ら確認した。")
	await novel_interface.show_text_only("思ったより……悪くないかも……？")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("って、悪くないかも……じゃないわっ！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然、イヤホンから馴染みのある声が聞こえた。")
	await novel_interface.show_dialog("よしよし、小娘達の自撮りタイムは終了だ。\\n現在の状況は理解しているだろう？", "マリル")
	await novel_interface.show_dialog("第四学園都市が連合議会に申請を提出した結果、\\n今夜ホテル周辺は厳戒態勢に入っている。", "マリル")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("位相波動の原因を突き止めたら、\\nとにかくすぐに脱出すればいいんだろ？\\n分かってるって～～", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("今回は前回のような強引な手法は使えん。\\nだから、お前達も機転を利かせて行動しろ。\\n特にレン、お前だ──", "マリル")
	await novel_interface.show_dialog("そんなに可愛い姿になってしまったばっかりに、\\n万が一にでも捕まったりしたら、\\nどこかの権力者の変態紳士様によって、\\n自宅へお持ち帰りされるかもしれないぞ……", "マリル")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("変な想像させないでくれ！！", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("あっ、あそこのサモントン教育委員会の代表さん\\n私を呼んでるみたい。\\nちょっとあっちの会話を探ってみるよ。", "アニー")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("レンちゃんも！\\nチャンスを探してLet'sゴーだからね！", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("話を終えると、アニーは営業スマイルに切り替え\\nスーツを着た男達の方へと走って行った。")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("アニーは本当に器用だな……", "小憐")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("しかし、メイドって何をすればいいんだろう？", "小憐")
	await novel_interface.show_dialog("このトレイ、なんかバランス悪いし……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("君、Dom Perignonを1杯もらえるかな。", "客A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("は？……あっ、はい！　すぐに！\\n\\n…………………………\\nえっと……すみません。\\nドリンクの名前をもう一度聞いてもいいですか？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("………………", "客A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("あっ、えっと……\\n（しまった、バカな質問をしたみたい……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("メイドの研修なんて受けた事ないから、\\nこんな時どうすればいいか全然分からないよっ！")
	await novel_interface.show_dialog("なんだね君は？\\n今日はスタッフも一流と聞いていたが……\\nまるで素人みたいではないか。", "客A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("すみません、その……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("おいおい、何ぼんやり突っ立てやがるんですか？", "ピンク髪のメイド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("ほぇ？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("振り返ると、ピンク髪で清楚な顔をした、\\n赤縁メガネのメイドがそこに立っていた。")
	await novel_interface.show_text_only("客に礼儀正しく微笑んだ彼女は、\\n俺の方に顔を向けた途端、\\n瞬時に怒りの表情へ切り替わった。")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("お客様にシャンパンを取りに行くッ！\\n付いて来きなさいッ！", "ピンク髪のメイド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("えっ…と？　あなたは……？\\n（ホテルの人じゃなさそうだけど……？）", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ピンク髪のメイドは何も言わずに俺の手を引き、\\n人がいない隅の方へと移動した。\\n彼女の力は、驚くほど強い。")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あのぎこちない振舞いはなんだバカッ！　\\n全然プロとしてなってないわッ！", "ピンク髪のメイド")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("あ、あの……俺……", "小憐")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("すみません！　\\nメイド経験まだ1時間未満なんです！")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("と言うか、この人の口調も、\\nメイドっぽくないんだけど……")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("なんですか、その目は？\\n私のメイドパワーを疑ってる目ですね？", "ピンク髪のメイド")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("よく聞きなさい──\\n私は、御主人様の名の下において\\n絶対万能のメイドです！！\\nこの点は何人たりとも疑う事を許さないわ！！", "ピンク髪のメイド")
	novel_interface.character_dark()
	await novel_interface.show_text_only("──赤縁メガネが突然誇らしげに宣言した。")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("は、はぁ……", "小憐")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("とにかく、さっきは助けてくれてありがとう……\\nあの時は本当どうすればいいか分からなかった！", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("ねぇ……\\n\\nなぜあなたは分からないのに、この場にいるの？", "ピンク髪のメイド")
	novel_interface.character_dark()
	await novel_interface.show_text_only("目の前にいるメイドの口調が突如冷徹に変わり、\\nわずかだが寒気を感じた。")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("嘘をついたら、消し炭にするわよ？", "ピンク髪のメイド")
	novel_interface.character_dark()
	await novel_interface.show_text_only("赤縁メガネは爽やかな笑顔で俺を脅す。\\n全然冗談には聞こえないな、これは……")
	novel_interface.character_light()
	await novel_interface.show_dialog("ん？　どうした？\\n言い逃れを考えてやがる途中ですか？", "ピンク髪のメイド")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("（やばい、俺の正体がバレているのか？）\\n（このメイドは一体何者だ……！？）", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("私はあなたの正体なんて既にお見通し──\\nなにせ……", "ピンク髪のメイド")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("ファビオラ。あまり無礼はダメだよ。", "？？？")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("声に沿って視線を向ける。\\n\\n俺達に割って入ったのは、\\nフランネルガウンを着ている金髪の少女。")
	await novel_interface.show_text_only("太陽の光のような髪。編み込みのお下げが、\\n小柄な少女の腰辺りまで伸びている。\\n目は湖のように澄み切っており……")
	await novel_interface.show_text_only("それはまるで精霊のようだった。\\n\\nそして、この俗っぽい宴会場とは些か\\n不釣り合いなようにも見えた。")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("ス……スクルド様！\\n瑣末な事でお騒がせして、申し訳ありません。", "ファビオラ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("先程まで凶悪だったメイドが、この娘を見た途端\\n謙遜な態度へ豹変した。")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("驚かせ過ぎたみたいね。\\n声が出せなくなっちゃったかな。", "スクルド")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("今日は見逃してあげて。\\n\\nいいでしょう？", "スクルド")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……仰せのままに。", "ファビオラ")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
