# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("ผ่านไปสองสามวันแล้วนับตั้งแต่ประกาศที่ต้องการถูกเผยแพร่")
	await novel_interface.show_text_only("เช่นเดียวกับที่ Mariru คาดการณ์ไว้ เหตุการณ์ดังกล่าวดูเหมือนจะไม่มีผลกระทบต่อชีวิตประจำวันของผู้คน")
	await novel_interface.show_text_only("แทบไม่มีร่องรอยของวิศวกรรมการเบี่ยงเบนความสนใจของ Mariru เลย")
	await novel_interface.show_text_only("รู้สึกเหมือนไม่มีอะไรนอกจากฝันร้าย")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("สวัสดียามเช้าค่ะพี่สาว Lian.", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ในฐานะแม่มดที่มีความสามารถพิเศษ Elluka ได้รับการจับตามองอย่างใกล้ชิดโดย SID")
	await novel_interface.show_text_only("แต่ดูเหมือนเด็กคนนั้นจะผูกพันกับฉัน Mariru ส่งเธอมาหาฉันทุกวัน โดยอ้างว่าเธอใจดี")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("สวัสดีตอนเช้า Elluka \\nอยากกินอะไรระหว่างมื้อไหม?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("เฮ้! อย่าให้ขนมแก่เด็กมากเกินไป!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("บู้…", "Elluka")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("ไม่เป็นไร. นั่นแทบจะไม่มากเกินไป", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("โอ้ เอาน่า คุณพูดแบบนั้นเสมอ", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("แล้วเธอจะอยู่กับเราทั้งวันจะโอเคไหม?", "Annie")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เอ๊ะ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("เด็กในวัยของเธอควรไปโรงเรียน \\nไม่ใช่เหรอ?", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("… อืม เธอไม่ใช่แค่เด็กนะ ฉันคิดว่า", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("แน่นอน แต่ฉันก็ยังกังวลอยู่บ้าง…", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("มันเป็นความผิดของคุณทั้งหมด คุณให้นมเธอต่อไป ฉันเริ่มกังวลเรื่องน้ำหนักของเธอแล้ว!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("Annie แย่", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka จ้องมอง Annie ด้วยท่าทางที่ได้รับบาดเจ็บ และ Annie ทำหน้าเศร้า")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("ตอนนี้ฉันรู้แล้วว่าการเป็นแม่ที่เข้มงวดรู้สึกอย่างไร...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("เอาล่ะ. อย่ารุนแรงขนาดนั้น", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("นี่ Elluka ช็อกโกแลตชิ้นสุดท้ายในวันนี้ ไม่มีอีกแล้ว \\nต่อไป ฉันจะพาคุณไปโรงเรียนของฉัน", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka ได้รับอนุญาตให้เคลื่อนย้ายได้อย่างอิสระระหว่างอพาร์ตเมนต์และโรงเรียนของเราเท่านั้น ตามที่ Mariru กำหนด")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("โอ้...", "Elluka")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("…ยังคงเศร้าอยู่", "Elluka")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ฉันลูบหัวเธอแล้วพาเธอไปโรงเรียนพร้อมกับ Annie")
	await novel_interface.show_text_only("อืม ช่างเป็นวันที่ดีจริงๆ ไม่ร้อนเกินไปไม่เย็นเกินไป")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("อย่ารู้สึกแย่นะที่รัก", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka จู่ๆ ก็เงยหน้าขึ้นและมองตาฉัน โดยมีช็อกโกแลตอยู่บนริมฝีปากของเธอ")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("น้องสาว Lian ...", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("(โอ้ ได้โปรดอย่ามองฉันแบบนี้นะ!)", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Elluka ย่อเท้าเพื่อคว้ามือของฉันและวางบนหัวของเธอ")
	novel_interface.character_light()
	await novel_interface.show_dialog("อีกครั้ง.", "Elluka")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("นี่คือเสน่ห์ที่น่ารังเกียจ!? \\nโอ้ ไม่นะ นั่นคือสิ่งที่ไม่มีมนุษย์คนไหนต้านทานได้!")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("ตุ๊ดตุ๊ดชอบโลลิต้าใช่มั้ยล่ะ?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("อิอิ ผมคิดว่าอย่างนั้นครับ", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันได้ยินเสียงของ Nix ข้างหลังฉัน")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Nix?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เธอจะเข้ามาใกล้เราโดยไม่มีเสียงรบกวนได้อย่างไร?")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("ขอโทษ ฉันทำให้คุณกลัวหรือเปล่า?", "Nix")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ไม่ แค่... \\nไม่เป็นไร", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ฉันรู้สึกละอายใจที่ถูกจับได้ว่าจ้องมอง Elluka อย่างโง่เขลา")
	await novel_interface.show_text_only("และฉันรู้สึกโล่งใจที่ Nix จะไม่พูดถึงหัวข้อนี้อีกต่อไป เธอสวยและสง่างามมาก!")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("คุณชื่อ Elluka ใช่ไหม?", "Nix")
	await novel_interface.show_dialog("ถ้าคุณชอบของหวาน คราวหน้าฉันจะซื้อเค้กสปันจ์ให้คุณ ตกลงไหม?", "Nix")
	await novel_interface.show_dialog("ฉันรู้จักร้านเบเกอรี่ที่น่าทึ่งแห่งหนึ่งใน Theatre Street พวกเขาเสิร์ฟน้ำเชื่อมเมเปิ้ลที่ดีมาก รสชาติเกือบจะเหมือนคาราเมล", "Nix")
	await novel_interface.show_dialog("และคุณจะต้องชอบครีมช็อคโกแลตอันเป็นเอกลักษณ์ของพวกเขาภายในเค้ก", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elluka คิดอยู่พักหนึ่ง และพยักหน้าขณะที่เธอไม่สามารถต้านทานสิ่งล่อใจของอาหารได้")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Elluka คุณไม่รับอาหารจากคนแปลกหน้า!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("ไม่เป็นไร. Nix ยังไงก็เป็นรุ่นพี่ของเรา", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("ใช่ แต่...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("มันเป็นแค่ฉันเหรอ?")
	await novel_interface.show_text_only("ดูเหมือนว่า Annie จะระมัดระวัง Nix ตั้งแต่ครั้งแรกที่พบกัน")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("ถ้าอย่างนั้นก็เป็นข้อตกลง Elluka", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("ดีล!", "Elluka")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("โทรศัพท์ของฉันก็ดังขึ้นทันที \\nมันคือ Mariru")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("…สวัสดี?", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("(ฮึ ไม่ใช่ภารกิจอื่นอีกแล้ว!) \\n(จริงๆ แล้ว ไม่ใช่ทุกวันที่ฉันจะออกไป Elluka!)", "Lian")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
