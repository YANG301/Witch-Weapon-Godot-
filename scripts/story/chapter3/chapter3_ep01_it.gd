# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("L'incubo bizzarro, la conversazione vaga, l'ombra nel sogno. \\nInoltre un avviso di allerta rossa...")
	await novel_interface.show_text_only("Proprio mentre stavo per accettare la mia nuova identità e decidere di rimettermi in sesto, hanno incasinato di nuovo tutto.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ehm?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("Hai visto le novità? \\nÈ lui! No, io, sono io!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Non sono cieco. Certo, so che sei tu proprio davanti a me, sudata, sciocca ragazza.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("No! \\nDannazione. sono io al telegiornale!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("In preda al panico, non so nemmeno da dove cominciare. \\nMariru grugnisce e mi colpisce la testa con la mano.")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Un idiota così inutile. Dopo tutti questi addestramenti, non puoi nemmeno riferire chiaramente al tuo ufficiale.", "Mariru")
	await novel_interface.show_dialog("Non si tratta semplicemente di un ragazzo che sembra essere ricercato in tutto il mondo perché svaligia il Centro di raccolta e ricerca della Seconda Città Accademia?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì, sì, sì! Esattamente!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("I servizi segreti avevano riportato la notizia molto prima che diventasse virale.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Sembri stupido quando sei terrorizzato~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru mi ha pizzicato la guancia. Ho provato a fermarla subito.")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru, fai sul serio!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("I più ricercati in tutto il mondo. Non è uno scherzo!", "Lian")
	await novel_interface.show_text_only("Non mi sarebbe mai passato per la mente che un giorno sarei finito al telegiornale per furto con scasso.")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("Ed è un avviso tripla A! Se ricordo bene, l'ultimo ricercato con un tale livello di allerta è stato bombardato a morte in Sud America da un anti-bunker.")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("Questo dannato ladro mi ha rubato la vecchia identità in un attimo... Sono quasi in lacrime al pensiero.")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In questo caso... \\nL'unico su cui posso contare è Mariru.", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Per quanto vorrei vederti soffrire in questo modo...", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Devo chiederti di controllare di nuovo le notizie.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("È necessario? Ho già tutto impresso nella mia mente.")
	await novel_interface.show_dialog("L'immagine potrebbe non essere nitida e chiara, ma sono sicuro che assomiglia quasi esattamente a me da ragazzo!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Per dimostrare quello che ho detto, apro le notizie sul telefono.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Vedi, questo è... \\nEh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'avviso di ricerca che mi aveva spaventato non c'è più. È stato sostituito da un normale annuncio di persona scomparsa.")
	await novel_interface.show_text_only("Il fumettista settantenne Inoue è scomparso di recente. \\nSe qualcuno sa dove si trova, contatti immediatamente la polizia.")
	await novel_interface.show_text_only("Ho controllato altri siti web e ho anche cercato con parole chiave, ma la notizia non è stata trovata da nessuna parte.")
	await novel_interface.show_text_only("Guardando la faccia di Mariru che ti ha detto, sono molto grato.")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("Eri tu...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru si avvicina e mi asciuga le lacrime.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Guardati, tutto soffocato.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Se vuoi davvero ringraziarmi, allora sii mio schiavo~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("E…", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Quando hai detto \"l'unico su cui posso contare è Mariru\", \\nsei così carino...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru mi solleva teneramente il mento con il suo indice.")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("Ehi, smettila!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Per quanto posso vedere, sono già schiavo…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("Vorrei poterlo fare. Ma per quanto ne so, c’è solo un’agenzia che può mettere a tacere l’intero social media in tutto il mondo.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Deve essere un ordine esecutivo del Congresso Unito.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Il congresso supremo che rappresenta tutte e sei le Città Accademia… ha deciso di cancellare la notizia?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("Perché…", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru mi guarda e mi fa un sorriso misterioso.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Non essere sciocco. Ovviamente non l'hanno fatto per proteggere il ladro.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Semplicemente non vogliono che il pubblico sappia cosa è stato preso.", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Chi è questo ladro? Perché ha usato la mia identità?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Chiunque sia, deve essere un genio per riuscire a uscire tutto intero dalla Collezione e dal Centro Ricerche di Akatraz.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Il fatto è che non è difficile per lui coprirsi la faccia.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Ma non lo fece, e osò perfino salire sul tetto dell'edificio per un po'...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Secondo la formazione specifica, le cose più trascurabili o sono assenti dove dovrebbero apparire...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("…Oppure sono presenti dove non dovrebbero essere.", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
