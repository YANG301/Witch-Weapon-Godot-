# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("Según el SID, desde anoche se han detectado varios flujos espacio-temporales intermitentes cerca del Sky Hotel.")
	await novel_interface.show_text_only("Casualmente, toda la delegación Salmonton se registró anoche en este hotel de lujo ubicado en la zona desmilitarizada de Agreed.")
	await novel_interface.show_text_only("Esta noche, organizarán allí una cena de intercambio de arte para celebridades de todas las Ciudades Académicas.")
	await novel_interface.show_text_only("Pero Raphael y su asistente no están invitados.")
	await novel_interface.show_text_only("Entonces, Mariru nos envió a Annie y a mí a este lugar molesto nuevamente.")
	await novel_interface.show_text_only("De pie en la entrada del magnífico salón de banquetes, me siento bastante incómodo.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Mmm...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("¿Estás bien? Pareces bastante nervioso.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por supuesto que sí. ¡Nunca me he disfrazado de criada!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sí. Annie y yo entramos al lugar disfrazados.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Y por qué debería ser yo la sirvienta mientras tú eres un representante estudiantil de Gosakuragawa?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("A todos los hombres les encantan los vestidos de mucama, ¿no?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Bueno, ¡estoy bastante seguro de que a ninguno de ellos le encanta usarlo!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm... \\nTienes razón.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Qué lástima, no puedes ver lo linda que estás con este hermoso vestido. \\nNo es de extrañar que estés tan inquieto...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie retrocede unos pasos, toma su teléfono... \\nY me toma una foto.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Vaya... Ren, te ves adorable con dos coletas.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Detente… ¡Elimínalo, ahora!", "Lian")
	await novel_interface.show_dialog("(Qué momento tan vergonzoso…) \\n(Si se ve…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un silbido procedente del teléfono de Annie confirma una transmisión exitosa.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("¡Te lo envié a ti y a Mariru!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Maldita sea.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Je-je, no seas tímido. \\n¡Este ribete de volantes te queda bien!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Desbloqueo mi teléfono y aparece la foto en la pantalla.")
	await novel_interface.show_text_only("¿No está mal…?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("¡Estás loco!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, una voz familiar suena en los auriculares.")
	await novel_interface.show_dialog("Muy bien, no más selfies, chicas. Tienes todos los detalles, ¿verdad?", "Mariru")
	await novel_interface.show_dialog("La Cuarta Ciudad Académica obtuvo el permiso del Congreso Unido para reforzar la seguridad durante el evento. Entonces, este hotel está fuertemente vigilado esta noche.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Todo lo que tenemos que hacer es descubrir las causas de los flujos del espacio-tiempo y retirarnos de inmediato, ¿verdad? \\nLo tengo.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No puedo hacer ningún movimiento audaz esta vez. Entonces ustedes dos, recuerden tocar de oído. Especialmente tú, Ren...", "Mariru")
	await novel_interface.show_dialog("Si uno de esos peces gordos se enamora de ti, es posible que nunca tengas la oportunidad de escapar...", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("¡Suficiente!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Me tengo que ir. Un par de delegados de la Comisión de Educación Salmonton querían hablar conmigo. \\nEs una buena oportunidad para escuchar.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, solo haz lo que tengas que hacer.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("En un abrir y cerrar de ojos, Annie finge una sonrisa y se da vuelta, \\nsaludando a un grupo de hombres de traje.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie es realmente bueno en esto...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("¿Pero qué se supone que debe hacer una criada ahora?", "Lian")
	await novel_interface.show_dialog("Sostener la bandeja para servir es tan difícil...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Un Dom Pérignon, por favor.", "Invitado A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("¿Eh? Uf… Por supuesto, señor. \\nHmm... ¿Repetirías eso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Invitado A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(¡Mierda! ¿Estoy preguntando algo realmente tonto?) \\nHmmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sin la formación adecuada, no tengo ni idea de cómo manejar esto. Ni siquiera sé qué debería hacer una criada.")
	await novel_interface.show_dialog("Pff, sabes que este lugar es conocido por sus sirvientas, ¿verdad? \\n¿Cómo pudieron dejar entrar a alguien tan poco profesional?", "Invitado A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Lo siento, señor...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("¡Oye! ¿Por qué estás ahí parado como un bulto en un tronco?", "Sirvienta de pelo rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me doy la vuelta y veo a una hermosa doncella de cabello rosado y gafas con montura roja.")
	await novel_interface.show_text_only("Ella le lanza una sonrisa educada al invitado. Cuando se da vuelta, la dulce sonrisa se convierte en una ira ardiente.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Vamos, vamos a buscar champán para el invitado.", "Sirvienta de pelo rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("¿Eh? ¿Quién eres? \\n(Por su forma de vestir, no parece una camarera de este hotel...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La doncella de cabello rosado toma mi mano y se dirige hacia la esquina, sin decir una palabra. Sorprendentemente, está llena de fuerza.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Ustedes, dedos de mantequilla! ¿Qué sucede contigo?", "Sirvienta de pelo rosa")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uf… yo… yo…", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Lo siento. Soy nuevo en este trabajo. Es mi primer día aquí...")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Espera, la forma en que hablas... tampoco suenas como una sirvienta...")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Por qué me miras de esa manera? \\n¿Estás cuestionando mi habilidad como sirvienta?", "Sirvienta de pelo rosa")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("¡Escuchen! Como sirvienta, puedo y haré cualquier cosa por mi amo. Nadie puede dudar de eso.", "Sirvienta de pelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La chica de gafas rojas de repente hace una promesa solemne delante de mí.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("O… está bien…", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("De todos modos, gracias por ayudarme ahora... \\nHonestamente, no sabía qué hacer a continuación.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Entonces, ¿por qué estás aquí?", "Sirvienta de pelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Su voz de repente se vuelve fría como el hielo, provocando un escalofrío en mi columna.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Si me mientes, te quemaré hasta convertirlo en un trozo de coca.", "Sirvienta de pelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La niña estalló en una risa plateada mientras pronunciaba estas palabras intimidantes, ¡pero estoy bastante seguro de que no estaba bromeando!")
	novel_interface.character_light()
	await novel_interface.show_dialog("¿Estás intentando inventar algo?", "Sirvienta de pelo rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Damn it. Am I busted?) \\n(Who the hell is she?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("Sé quién eres. \\nDespués de todo…", "Sirvienta de pelo rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, no seas grosero.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Siguiendo el sonido, encuentro a una niña pequeña con un fabuloso vestido de noche.")
	await novel_interface.show_text_only("Su brillante cabello rubio llega hasta la cintura en trenzas y sus ojos son brillantes y claros como el cristal.")
	await novel_interface.show_text_only("La presencia de una chica tan elfa en esta ocasión extravagante es como una clavija cuadrada en un agujero redondo.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("¡Señorita Skurd! \\nLamento mucho haberte molestado.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Feroz como un león hace un momento, la criada se convierte en un gatito justo cuando aparece la niña.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Mira a la pobre chica. Está demasiado aterrorizada para decir una palabra.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Déjala ir por ahora, ¿vale?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Entendido!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
