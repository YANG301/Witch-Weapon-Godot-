# chapter3_ep07.gd - 第3章第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep07_script()

func play_script():
	pass

func chapter3_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_lawn.png")
	await novel_interface.show_text_only("マリルから任務を言い渡され、2日間が経った。")
	await novel_interface.show_text_only("そして、ついに昨晩『芸術交流』を名目とした\\n例の視察団が、新豊洲国際空港に到着した。")
	await novel_interface.show_text_only("つまり、俺のミッションもスタートってわけだ。")
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("俺が聞き出すって……本当に大丈夫かな？", "小憐")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("だって向こうは名家のお嬢様なわけだし……\\nもし相手にされなかったらどうしよう？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_1")
	await novel_interface.show_dialog("ねぇねぇ。あっちの人の服を見てみて！\\nあれって私達の学校の人じゃないよね？", "クラスメイトA")
	await novel_interface.hide_character()
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("しかも、傍に従者さんが待機していますわ。\\nどちらの家のご令嬢でしょう？", "クラスメイトB")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("周囲の話につられて視線を向けると、\\n緑色のコートを着た容姿端麗な少女が、\\n芝生の外れに立っていた。")
	await novel_interface.show_text_only("今回のターゲット──ラファエル・デックスだ。")
	await novel_interface.show_text_only("あれ？でもたしか副校長と儀礼隊が、\\n正門前で歓迎式の準備をしていたはず……\\nもしかして、彼女はこっそり入ってきたのか？")
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("──お嬢様、こちらへ。", "随行員")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("この教室棟は黄金時代のテューダー様式を\\n真似しているわね。", "ラファエル")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("ただ残念だけど、庭の造りが小さすぎて、\\n空間の重厚感が全然表現できていない。", "ラファエル")
	await novel_interface.show_dialog("羽目板の彫刻も精美に欠ける……\\n構造と装飾による二重効果も満たせていないわ。", "ラファエル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("servent","",0.25)
	await novel_interface.show_dialog("流石、ラファエルお嬢様は、やはり並外れた\\n芸術センスを持っていらっしゃいます。", "随行員")
	await novel_interface.show_dialog("確かにこのような建築であれば、ホールの高さを\\nもっと高くしなければなりませんね。", "随行員")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("──何を言ってるのかしら？\\n\\nただ、高さばかりを増やしても、\\n何も問題は解決しないわ。", "ラファエル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("おっしゃる通り。庭の芝生の面積を少しばかり\\n増やしておくのは如何でしょうか？", "随行員")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("はぁ？　そんな事じゃ違和感だらけでしょ？\\n\\nだって、教室棟前の花園はこれっぽっちしか、\\nないのよ……", "ラファエル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ラファエルお嬢様からすれば、こんな植生が\\n乱雑な場所は、花園とも呼べないのでは？", "随行員")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("その言葉を聞いて、ラファエルはやや不満げだ。")
	novel_interface.character_light(0.35,"normal2")
	await novel_interface.show_dialog("……私は、別にそんな事思ってないわよ。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0)
	await novel_interface.show_dialog("なるほど、思いやりも持っていらっしゃる。\\nラファエルお嬢様は親しみやすいお方です。", "随行員")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("あの従者さん…太鼓持ちしてるつもりだろうけど\\n\\n隣のお嬢様の顔色が険しくなっている事に\\n気付いていないのだろうか……")
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("ちょっと、そこの女装癖。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("………………はぇ！？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（女装癖って……俺の事か？）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルの声に合わせて、\\n周囲の人々の視線が一手に俺へと集中した。")
	await novel_interface.show_text_only("唐突に大勢の視線を浴びて、緊張で俺の顔が\\n火照っていくのが自分でも分かる。")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("ちがっ、俺は違う、俺は……っ！\\n（制服はマリルに無理矢理着せられたんだ！）", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","jeer",0.25)
	await novel_interface.show_dialog("何よ。口ごもって誤魔化してるつもり？\\nやっぱり男じゃない。", "ラファエル")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("まったく新豊洲は………\\nあんたみたいな性癖を堂々と公にできるほど、\\n開放的になったのか。", "ラファエル")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("（マリル、今から任務を断ってもいいか……）")
	novel_interface.character_move_left(-0.3)
	novel_interface.character_2nd_move_left(0,0.3,false)
	novel_interface.show_3rd_character("classmate_1","",0.3)
	await novel_interface.show_dialog("あの……\\nレンさんは私達の同級生で、女の子だよ？", "クラスメイトA")
	await novel_interface.hide_character()
	await novel_interface.hide_3rd_character()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("あんた、嘘が上手いわね？\\nまさかコイツが？", "ラファエル")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("ラファエルは自らの権威が挑発されたような\\n表情をしている。")
	novel_interface.show_character("classmate_2")
	await novel_interface.show_dialog("騙しておりませんわ、私達全員証言できます。\\nレンさんは正真正銘の女の子だと言う事を。", "クラスメイトB")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("うん……義理堅い同級生には感謝したいが、\\n俺は正真正銘、女の子ではない。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("……ふん、\\nどうも男のようにしか感じないけど。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("お、俺のどこが男なんだよ……\\n（このセリフは泣きたくなる……）", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_text_only("ああ──自分を裏切るってこんな味がするのか。\\n酸っぱくで苦い味だな……")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal2",0.25)
	await novel_interface.show_dialog("もういい、あんたと言い争うつもりはないわ。", "ラファエル")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("あんた、\\n率直に考えてここの建築レベルをどう思う？", "ラファエル")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("建築学なんて全然分からないし……\\n俺に聞かれても……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("直感の答えでいいわよ。", "ラファエル")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("うーん、教室棟とかのホールの高さは、\\n別に低くないと思うけどな……", "小憐")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("君が気に入らないのは、ひょっとして……\\n\\n……建物に可愛さが足りないから？", "小憐")
	novel_interface.character_dark()
	await novel_interface.show_text_only("ラファエルの表情を察した瞬間に、\\n自分の語彙力の乏しさを自責する。")
	await novel_interface.show_text_only("案の定、彼女は軽蔑の笑みを浮かべた。")
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("可愛い！？ 信じられない……！\\n\\nそんな薄っぺらい言葉だけで建物を形容する\\n人間がいるなんて……！", "ラファエル")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("た、ただの感覚だけで答えたんだよっ！", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("ほら、木の配置とか綺麗に揃っているけど、\\nこの辺とかを少しバラバラにすれば、\\n少しは良くなるかも……", "小憐")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("えっと……\\n例えばだな……うーん……", "小憐")
	novel_interface.change_expression("shy")
	await novel_interface.show_text_only("って、なんで俺が考えなきゃいけないんだよっ！")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("樹木を交互に配置して階層化する事で、\\n視野の奥行きを深める……\\nあんたが言いたいのはそれね？", "ラファエル")
	novel_interface.character_light(0.35,"sprite")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そ……その通りです。\\n（今の何語？）", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,false)
	await novel_interface.show_text_only("ここまで聞いてから、ラファエルはようやく\\n少し笑みを浮かべた。")
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("女装癖だけど、このイエスマンよりはマシね。", "ラファエル")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("だから俺は……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("servent")
	await novel_interface.show_dialog("お嬢様……", "随行員")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("あんたはもう良いわ。外で待ちなさい。", "ラファエル")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("レンって言ったかしら？　\\n\\n行くわよ。この学校を案内しながら、\\nさっさと自慢話の1つでも聞かせなさい。", "ラファエル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","panic")
	await novel_interface.show_dialog("へっ……？\\nは…、はいっ！", "小憐")

	print("=== 第3章第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
