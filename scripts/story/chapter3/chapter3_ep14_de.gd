# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Smite \\nEllukas Administrator…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hinter ihm sehe ich mehrere Sicherheitssoldaten auf dem Boden liegen.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sie sind einfach ohnmächtig geworden. Das Töten in der entmilitarisierten Zone ist nicht mein Plan.", "Jacob")
	await novel_interface.show_dialog("Ich hatte vor, Seiten des Kultklassikers „Buch der sieben Philosophen“ zurückzunehmen, hatte aber nicht mit einem solchen Bonus gerechnet …", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Buch der sieben Philosophen…) \\n(Ist das das Zauberbuch, das mit dem Goldenen Schmetterling verbunden ist?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren… Ich habe viele alte Wunden am Körper von Elluka gefunden, als ich ihr beim Waschen geholfen habe.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Du hast Elluka gewaschen?) \\n(Wann!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(Nein, darum geht es nicht.) \\n(Alte Wunden… Das heißt…!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Kein gewöhnliches Kind könnte solch ein traumatisches Erlebnis ertragen!", "Annie")
	await novel_interface.show_dialog("Es muss dieser Typ sein ... das ist der Richtige!!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oh- \\nScheint, das Ding ist noch nicht kaputt.", "Jacob")
	await novel_interface.show_dialog("Tut-tut, ich schätze, SID wurde bereits rückentwickelt ... \\nDie Technologie, die ich dafür verwendet habe.", "Jacob")
	await novel_interface.show_dialog("Hätte ich gewusst, dass es so viel Ärger verursachen würde, hätte ich ein Selbstzerstörungsgerät darauf installiert.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Du –!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("– Arschloch!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das nächste, was ich weiß, ist, dass Annie wütend aufspringt und versucht, Jacob ins Gesicht zu treten.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Quietschen—")
	await novel_interface.show_text_only("Mit einem Schrei wird der Raum von einem riesigen Lichtbogen erleuchtet. Für einen Moment bin ich geblendet.")
	await novel_interface.show_text_only("Es dauert Sekunden, bis die Blendung verschwindet. Ein stechender Schmerz bleibt in meinen Augen.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie…!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie verliert das Bewusstsein und fällt zu Boden. Auf ihrer Haut erscheint ein Streifen astförmiger Brandflecken.")
	await novel_interface.show_text_only("Der Soldat neben Jacob hält eine rauchende Waffe in der Hand ... Ist das die Waffe, die sie gerade benutzt haben?")
	await novel_interface.show_text_only("Der Soldat entlädt schnell eine batterieähnliche Kugel in der Größe eines Kanisters.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Wir wissen, wie man das Beste aus Hexen macht ...", "Jacob")
	await novel_interface.show_dialog("Ich bevorzuge es, sie lebend zu fangen. Aber die SID-Schlampe kommt bald ...", "Jacob")
	await novel_interface.show_dialog("Jetzt, wo uns die Zeit davonläuft …", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob nimmt ein tortenförmiges Stück Metall heraus. Die graugrüne Schale strahlt einen vertrauten hellblauen Glanz aus.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Ist das... eine Substance H-Waffe?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Ich spüre... den Fluss magischer Kraft...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Was zum Teufel hast du vor? Das ist eine entmilitarisierte Zone!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Ren)", "Mariru")
	await novel_interface.show_text_only("Plötzlich kommt die Stimme von Mariru aus den Kopfhörern.")
	await novel_interface.show_dialog("(Das ist eine Sprengfalle aus selbstbindenden Fasern.) \\n(Es ist eine nicht tödliche Substance H-Waffe.)", "Mariru")
	await novel_interface.show_dialog("(Es explodiert drei Sekunden nach der Detonation.) \\n(Und die Fasern verteilen sich überall. Es ist unmöglich zu entkommen.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Also sparen Sie sich für den Moment Ihre Kräfte.) \\n(Ich werde herausfinden, wie ich Sie da rausbekomme …)", "Mariru")
	await novel_interface.show_text_only("Jacob hebt langsam die Sprengfalle in seiner rechten Hand. Auf seiner Handfläche erscheinen goldene Linien, als wäre er zum Kampf bereit.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Seine Hand ... ist das eine magische Inschrift?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Endlich ... bin ich an der Reihe, die Substance H-Waffe zu erleben ...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Tut mir leid dafür...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice packt mich plötzlich mit einer Hand und entreißt Raphael mit der anderen die Halskette.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Was?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich strahlt der Smaragdanhänger einen grellen Strahl aus und verwandelt sich in ein mächtiges Schwert mit Inschriften auf der Klinge.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Schauen Sie sich diese elenden Seelen an, die darum flehen, ihre Sünden zu begleichen –", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Was…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Halt die Klappe!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice stößt das Schwert schwer auf den Boden.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob öffnet den Mund, aber es kommt nichts heraus. \\nDer Raum ist von tödlicher Stille erfüllt.")
	await novel_interface.show_text_only("Der Boden unter Jacob bricht auf und offenbart nichts als völlige Dunkelheit.")
	await novel_interface.show_text_only("Aus der Tiefe der Dunkelheit ertönt ein unheimliches Geräusch, als würden Millionen Menschen aus der Hölle trauern und heulen.")
	await novel_interface.show_text_only("Dunkler Rauch strömt aus dem Spalt und erobert jede Ecke des Raumes, der nun im Handumdrehen in höllische Dunkelheit gehüllt ist.")
	await novel_interface.show_text_only("Von einem Schauer bis in die Knochen und einem tiefen Gefühl des Schreckens heimgesucht, stehen mir die Haare zu Berge und ich kann mich nicht bewegen ...")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Doch nur Sekunden später löst sich die Dunkelheit auf. \\nUnd der Riss ist nirgends zu finden.")
	await novel_interface.show_text_only("Als ob er unter einer Panikattacke leiden würde, fällt Jacob zu Boden und kratzt sich wahnsinnig so heftig am Hals, dass es blutet.")
	await novel_interface.show_text_only("Sein Gesicht wird rot, während er Schwierigkeiten hat zu atmen. Aber seine Lungen scheinen völlig luftleer zu sein, so dass er vergeblich nach Luft schnappt.")
	await novel_interface.show_text_only("Es dauert eine Weile, bis er wieder zu Atem kommt.")
	await novel_interface.show_text_only("Der große, kräftige Mann rollt sich zitternd auf dem Teppich zusammen, die Arme vor der Brust verschränkt.")
	await novel_interface.show_text_only("Seine blutunterlaufenen Augen sind voller Angst. Durch die Dekompression treten Tränen aus.")
	await novel_interface.show_text_only("Die Linien auf seiner Hand sind vollständig verschwunden und auch die auf den Teppich gefallene Sprengfalle hat ihren Glanz verloren.")
	await novel_interface.show_text_only("Die maskierten Soldaten stehen alle zitternd still.")
	await novel_interface.show_text_only("Aus ihren ausdruckslosen Gesichtern geht hervor, dass sie von dem Schrecken erfasst werden, eine Realität zu sehen, die sich jeder Beschreibung entzieht.")
	await novel_interface.show_text_only("Wenn du lange in einen Abgrund starrst, blickt der Abgrund auch in dich hinein ...")
	await novel_interface.show_text_only("Angesichts des echten Grauens sogar das Atmen ...")
	await novel_interface.show_text_only("Man fühlt sich einer unbeschreiblichen Verzweiflung ausgesetzt.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Lass uns gehen!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Ren, verschwinde da!)", "Mariru")
	await novel_interface.show_text_only("Bis jetzt bin ich nicht zur Besinnung gekommen. Mit einem Nicken zu Beatrice verlasse ich den Raum mit Annie im Arm.")
	await novel_interface.show_text_only("Beatrice zerrt Raphael, der immer noch benommen ist. Wir rennen zum Aufzug…")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
