	await novel_interface.show_dialog("Đó là điều được mong đợi. Cô ấy đang ở độ tuổi của một học sinh trung học.", "Mariru")
	await novel_interface.show_dialog("Vì vậy điều bạn cần làm là tìm hiểu mục đích thực sự chuyến viếng thăm của họ.", "Mariru")
