# chapter3_ep05.gd - 第三章第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep05_script()

func play_script():
	pass

func chapter3_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru gửi Annie và Elluka đi ngay khi chúng tôi quay trở lại Trụ sở chính.")
	await novel_interface.show_text_only("Bây giờ tôi đang buồn. Tôi không biết liệu mình có bị thẩm vấn bằng những câu hỏi kỳ lạ nữa không…")
	novel_interface.show_character("ren_uniform","sprite")
	await novel_interface.show_dialog("Chuyện gì đã xảy ra vậy?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Nếu không có gì xảy ra thì sao? Bạn định tiếp tục cười nhạo Elluka như một kẻ hư hỏng à?", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bạn… Chắc chắn bạn đã theo dõi tôi qua camera giám sát!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Hehe, đó là tất cả những gì bạn có thể nghĩ đến à?", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Còn có thể là gì nữa…", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("Ví dụ—", "Mariru")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Mariru nhìn tôi ác độc từ đầu đến chân.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Phòng Nghiên cứu đã phát triển một loại bánh xốp thậm chí có thể quyết định thời điểm bạn đi vệ sinh!", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","perspire1",0.25)
	await novel_interface.show_dialog("Cái gì… phòng tắm? \\nUgh, nghe ghê quá!", "Lian")
	await novel_interface.show_dialog("Nó chắc chắn là do Aya phát minh ra! \\nĐợi đã, đừng nói với tôi là bạn đã bí mật cấy nó vào cơ thể tôi nhé!", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi chỉ đùa thôi.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Cách bạn nói không có gì giống như một trò đùa!")
