# chapter3_ep04.gd - 第三章第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep04_script()

func play_script():
	pass

func chapter3_ep04_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("指名手配の事件から数日が経った。")
	await novel_interface.show_text_only("やはりマリルの言った通り、普段の生活の中で、\\n事件の波風が立つような事は一切なかった。")
	await novel_interface.show_text_only("マリルが言っていた情報妨害プロジェクトも、\\n実生活には一切の影響がない。")
	await novel_interface.show_text_only("全ての悪夢は過ぎ去ったように感じていた。")
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("小憐お姉ちゃん、おはよう。", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカは魔女であり、危険な特殊能力を持つため\\nSIDが彼女を収容、保護せざるを得なかった。")
	await novel_interface.show_text_only("この子は俺を大事な拠り所としてくれたらしく、\\nマリルも「一日一善」と建前を述べながら、\\n彼女を俺の元へ届けてくれる。")
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("おはよう、イルカ。\\n今日はどんな美味しい物が食べたい？", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("こらっ！　子供にお菓子を与えすぎちゃダメっ！", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","worry")
	await novel_interface.show_dialog("ぅぅ……", "イルカ")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","happy")
	await novel_interface.show_dialog("たま～に食べるくらいは大丈夫だって～", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","stare",0.25)
	await novel_interface.show_dialog("レンちゃんは「たまに」が多すぎるの！", "アニー")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("それにイルカちゃんは、いつも私達と一緒に\\nいてくれるけど、本当に大丈夫なの？", "アニー")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("え？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("この子はまだ子供なのよ……？\\n\\nこの歳の子だったら、普通はちゃんと学校に\\n行くべきじゃない？", "アニー")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……多分、普通の子供っていう枠組みに\\nイルカを当てはめるのは無理じゃないかな。", "小憐")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"upset")
	await novel_interface.show_dialog("それは確かにそうなんだけど、やっぱりちょっと\\n心配だよ……", "アニー")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("レンちゃんが悪いんだよ！\\nいつも餌付けみたいな事ばかりしてるから。\\n私はこの子の成長が心配なのっ！", "アニー")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("iluka_normal","unhappy")
	await novel_interface.show_dialog("アニー、嫌い！", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカが悔しそうにアニーを見る。\\n\\nアニーはイルカのまなざしに当てられ、\\n見るに忍びない表情を浮かべた。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("私、子供に嫌われちゃう母親の気持ちが、\\n急に分かったわ……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","smile")
	await novel_interface.show_dialog("まあまあ、そんなに厳しくしなくたって。", "小憐")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("ほ～ら、イルカ。\\n今日の分のチョコレートは後1枚だけだからな～\\nあと、今日は学校に連れていってあげるから。", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アパートと学校を含めた狭い範囲だけだが、\\nマリルの要請によって、\\nイルカの自由行動が許されている。")
	novel_interface.show_character("iluka_normal","normal")
	await novel_interface.show_dialog("うん……", "イルカ")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("……やっぱり、悲しい。", "イルカ")
	novel_interface.character_dark()
	await novel_interface.show_text_only("そっとイルカの頭を撫でて、アニーと一緒に\\nイルカを学校へと連れて行く。")
	await novel_interface.show_text_only("う～ん、それにしても今日はいい天気だ。\\nそよ風が吹いていて、そこまで暑くもない。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("いい子だから、そんなに悲しまないで。", "小憐")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("イルカが急に顔を上げて、口元に付いたチョコを\\n舐める間もなく、真剣に俺を見つめる。")
	novel_interface.character_light(0.35,"gourmet")
	await novel_interface.show_dialog("小憐お姉ちゃん……", "イルカ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy_left")
	await novel_interface.show_dialog("（あっあっあっ、そんな目で俺を見ないでっ！）", "小憐")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("イルカはつま先立ちで、俺の手を自身の頭の上に引き寄せた。")
	novel_interface.character_light()
	await novel_interface.show_dialog("……もっと撫でて。", "イルカ")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"awkward")
	await novel_interface.show_text_only("コ、コイツは小動物が兼ね備えていいレベルの\\n攻撃力じゃない！！\\n司令部！司令部！ほ、報告ッ！！\\n我方、陥落セリッ！！")
	await novel_interface.hide_all_characters()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("本当、救いのないバカロリコンだね……", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("うふふ…、私もそう思うかも。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("後ろからニュクス先輩の声が聞こえた。")
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("ニュ、ニュクス先輩ッ！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女はいつのまに俺達の背後を……")
	novel_interface.show_character("ren_uniform","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("ごめんなさい、驚いたかしら？", "ニュクス")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("いえ、ただ……\\nいや、なんでもないですっ！", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("イルカに呆けていた姿を、ずっと先輩に見られていたと思うと、恥ずかしすぎるんだけど！")
	await novel_interface.show_text_only("幸いにも彼女がその事で、俺をからかいは\\nしなかった。\\nさすが優雅なニュクス先輩、最高だ！")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("あなたはイルカちゃんって、お名前かしら？", "ニュクス")
	await novel_interface.show_dialog("もしイルカちゃんがスイーツをお好きなら、\\n今度一緒にケーキのお店に行ってみません？", "ニュクス")
	await novel_interface.show_dialog("劇場街にあるお店なのだけど……\\n\\nそこの特製メープルシロップは独特の甘い香りに\\n加えて、ほんのりキャラメルの味がするんです。", "ニュクス")
	await novel_interface.show_dialog("それにケーキの中には、店長さん特製の\\nチョコクリームが入っていて……\\n間違いなく気に入ってくれると思うわ。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("イルカはしばらく真剣に考えていた。\\nだが、食べ物の誘惑に勝てなかったようで、\\nおとなしく頷いた。")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("イルカ！\\n知らない人から食べ物をもらっちゃだめよ！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_uniform","smile",0.25)
	await novel_interface.show_dialog("いいじゃないか、先輩だし。", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"worry")
	await novel_interface.show_dialog("うっ、それはそうだけど……", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の気のせいか？")
	await novel_interface.show_text_only("初めて会ったあの日以来、アニーはニュクスに\\n対して妙に警戒心を抱いているような気がする。")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("じゃあ、約束ね。イルカちゃん。", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("iluka_normal","smile")
	await novel_interface.show_dialog("うん！", "イルカ")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺の携帯が急に鳴り出した。\\n──マリルからの電話だ。")
	novel_interface.show_character("ren_uniform","normal1")
	await novel_interface.show_dialog("……もしもし？", "小憐")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("（やれやれ、また何かの任務か？）\\n\\n（せっかくイルカを遊びに連れ出せたのに……）", "小憐")

	print("=== 第三章第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
