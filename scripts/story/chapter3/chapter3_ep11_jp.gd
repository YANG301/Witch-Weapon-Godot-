# chapter3_ep11.gd - 第3章第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep11_script()

func play_script():
	pass

func chapter3_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("ラファエルのボディーガードが俺達を取り囲む。\\n\\nそれと同時にアニーは俺に目配せをした──")
	await novel_interface.show_text_only("俺は彼女が何をするのか瞬時に理解した。\\n\\nアニーが先ほど廊下で溜めていたエネルギーを\\n一気に開放する。")
	await novel_interface.show_text_only("部屋中へと大量のボールが瞬時に射出され、\\n1人に当たると、\\n更にもう1人へと連鎖的に反射していった。")
	await novel_interface.show_text_only("普通のボディーガード達がこんな特殊な状況に\\n対応できるはずもなく、\\nパニックに陥り、次々と床へ倒れていった。")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("一般人にこの技を初めて使ったけど、\\nこんなに早く全員を倒せちゃうのか……", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("もちろんだよ。\\n\\n暴走したドールよりは、理性のある人間の方が\\n片付けやすいからね～～", "アニー")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","subtle")
	await novel_interface.show_dialog("くっ、使えない奴達だ……っ。", "ラファエル")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("よくもこんな場所で騒ぎを起こせたものだな！　\\n保安軍はあんた達を見逃さないわ！", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルのロイヤルスイートルームは、\\nさっきのバトルで滅茶苦茶になってしまった。\\nそこらじゅうにラファエルのボディーガード達が\\n倒れている。")
	await novel_interface.show_text_only("アニーとこっそり証拠を集めるつもりだったが…\\n\\nどうやら大変な国際紛争の引き金を\\n引いてしまったかもしれない……")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("まずい……アニーっ！\\nは、早く……彼女を緊縛してッ！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("慌てた俺は、アニーに変な指示を出してしまう。")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("は～い、任せてっ！", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーは必死にもがくラファエルをテキパキと\\n抑え付け、散乱したカーテンを破いて、\\nちょちょいのちょいっと言った感じで彼女を\\n雁字搦めに縛り上げた。")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("よ、よくも――ッ！！\\nこの女装癖の変態野郎。\\n一体この私をどうするつもりだ！？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("新豊洲の国賓。\\n第四学園都市市長の孫娘。\\n彼女の緊縛を完遂した。\\nそう、それも彼女の自室の椅子の上で──")
	await novel_interface.show_text_only("って　アニーはなんでこんなに慣れてるんだよ！\\nこれじゃ、変態と罵られても言い訳できない……")
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("本当にごめん。\\nでも君が警報器に触れないよう、縛らないと……", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は壁際にある赤いボタンを指差した。\\n\\nあれを押されたら、3分間もせずに重火器を、\\n所持した保安軍の部隊に包囲されるだろう。")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("ふんっ、あんた達、一体どういうつもり？", "ラファエル")
	await novel_interface.show_dialog("身元も隠さず、撤退準備もしていないみたいね。\\n身代金目当ての誘拐犯にでもなるつもりかしら？\\nあんた達ごときが？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("こんなヤバい姿勢で椅子に縛り付けられても、\\n依然として傲慢な態度は変わらず……\\n思考の回転も速い……さすが貴族のお嬢様だ。")
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("あんた達は一体何者よ？\\nさっき使っていたのは『異質物武器』？", "ラファエル")
	novel_interface.character_dark()
	await novel_interface.show_text_only("彼女のその言葉で、俺は今回の一番大事な任務を\\n思い出した。")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("そう、ラファエル、俺達はただ1つだけ、\\nハッキリとさせなきゃいけない事があるんだ。\\nそのアタッシュケースについて……", "小憐")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("……アタッシュケース？", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ラファエルは戸惑いの表情を浮かべた。\\n\\nまるで俺が何を言っているのか全く\\n理解できていないようだ。")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("もう……割れてるよこれっ！", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("うえッ？！　\\nあの合金って相当硬いんじゃなかったか？", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("アニーが指さした方向へ振り向くと、\\n野球ボールサイズの穴がいくつも空いている\\nアタッシュケースが転がっていた。")
	await novel_interface.show_text_only("ケースの黒いプラスチックカバーはすでに剥がれ\\n薄青く光る金属の内装が露出している。")
	await novel_interface.show_text_only("このプラスチックカバーは良く見る偽装工作用の\\nの着脱可能なプラスチックカバーだ。\\nどうやらこの階に突入する前のアニーは、\\n偶然にもアタッシュケースの内側を見たらしい。")
	await novel_interface.show_text_only("ケースの留め具は壊れ、中身のいくつかと\\n金属の破片が付近の絨毯にまで散らばっている。")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("おっかしいな～　\\n\\n私のボールは生きているターゲットだけを\\n追跡するはずなのに……", "アニー")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ラファエルにも薄青い光が見えたようで、\\n驚きと焦りを混ぜたような表情をしている。")
	await novel_interface.show_text_only("俺は散らばる緩衝スポンジと金属破片の中から、\\n光っていた小さなものを見つけた。")
	await novel_interface.show_text_only("それは蝶の形をした金色のアクセサリー。\\n\\n生き生きとした形に、透かし彫りの模様を\\n施された羽がとても綺麗である。")
	novel_interface.show_character("anne_uniform","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_maid","serious",0.25)
	await novel_interface.show_dialog("これが原因で……アニーのボールはケースを\\nターゲットにしたのか？", "小憐")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("気を付けて！\\nそれってもしかしたら『異質物』かも───", "アニー")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("この精巧な黄金の蝶は今にも飛んで行きそうで、\\n縛られているラファエルの注意すら引き付けた。\\nつい俺は手が伸びてしまって……")
	await novel_interface.show_dialog("おいおい、このバカ。\\n触るんじゃない──", "マリル")
	await novel_interface.show_text_only("突然、俺の身体が急に痺れてマリルの声が\\n聞こえてきた。\\nまるで俺の隣から喋りかけているかのように……")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("えっ？\\nなっ！？なんだ！！？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("慌てて身体中から声の発生源を探す。\\n服の中にスピーカーが入っていないか確認した。")
	await novel_interface.show_dialog("アニーのボールが硬度HRC70の合金に、\\n穴を開ける事が可能であれば、\\nボディーガード達の頭や体は今頃穴だらけで、\\nここはもっとひどい惨状になっていたぞ。", "マリル")
	await novel_interface.show_dialog("おそらく、その小さな物がボールの衝撃を借りて\\n自ら脱出しようとしたんだろうな。", "マリル")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("あの開いている穴を……\\nこのアクセサリーが自分でやったっていうのか？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ふふ、その可能性は高いぞ～？\\n危険性はあるが、お前はそれでも触りたいのか？", "マリル")
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("いや違う、重要なのは──\\nマリルッ！！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("くそっ、音源を見つけた！")
	await novel_interface.show_text_only("マリルの声が俺の胸から聞こえてくる。\\n\\nどおりでマリルが話す声が聞こえるたびに、\\nびりびりした感じがするわけだ……")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("やっぱり、俺の身体に変なチップを植え付けた\\nだろッ！！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("部外者の前で我々の機密技術を漏洩するとは、\\nまた、私に踏まれたいようだな……", "マリル")
	await novel_interface.show_dialog("アニー。\\nまずはそのお嬢様に安眠を与えて差し上げろ～～\\nだが気を付けてくれよ？\\n我々の大事な貴賓を傷モノにしちゃいかんからな", "マリル")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("ちょっとっ！　あんた達は――ッ！", "ラファエル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("アニーはラファエルの首に軽く手刀を放ち、\\n彼女を気絶させた。")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("マリルさん。\\nこのタイプの『異質物』は申告なしの場合、\\n新豊洲市内に持ち込み禁止でしょう？", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("もちろんだ。\\nふん、私の目の前でこんなモノを密輸するとは。\\n元老院にデックス博士がどんな弁明をするのか\\n楽しみにしておこう。", "マリル")
	await novel_interface.show_dialog("……待て、\\n廊下にいる警備員が発見されたようだ。", "マリル")
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("ええっ？　こんなに早く？", "アニー")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("現在、下にいる保安軍がロビーに集結している。\\n\\n私も回収チームを連れてそちらに向かおう。\\n8分間以内に到着する予定だ。", "マリル")
	await novel_interface.show_dialog("アニー、お前はエアロゲルで扉を封鎖してくれ。", "マリル")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("よっし、任せてよっ！", "アニー")

	print("=== 第3章第11话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
