# chapter3_ep16.gd - 第三章第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep16_script()

func play_script():
	pass

func chapter3_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	await novel_interface.show_text_only("Ha pasado una semana desde que se detectaron flujos de espacio-tiempo en el Sky Hotel.")
	await novel_interface.show_text_only("La Dra. Aya hizo Beatrice una delicada pulsera con el metal Substance H usado en la carcasa interior de la maleta.")
	await novel_interface.show_text_only("Gracias a la pulsera, ahora puede activar o desactivar libremente su magia que atrae a los hombres.")
	await novel_interface.show_text_only("A cambio, Beatrice se unió a SID como agente, al igual que Annie.")
	await novel_interface.show_text_only("Mariru la aloja en una habitación de invitados de este lujoso apartamento.")
	await novel_interface.show_text_only("Al principio, me preocupaba que los soldados de seguridad nos identificaran por las imágenes de CCTV del piso ejecutivo.")
	await novel_interface.show_text_only("Pero, sorprendentemente, ninguno de nosotros fue captado por la cámara. Tampoco Jacob y sus compañeros.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Mariru, ¿cuánta potencia tiene realmente SID?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	await novel_interface.show_dialog("¿Eh? ¿Por qué lo preguntas?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Dado que esta vez se involucró más de una Ciudad Académica, pensé que sería un trabajo desagradable limpiar el desastre.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Me alegra que tengas tanta fe en SID…", "Mariru")
	novel_interface.change_2nd_expression("speak")
	await novel_interface.show_dialog("Pero usted y Annie nunca podrían haber escapado de ese lugar sanos y salvos si no hubiera sido por el Senado. Como usted sabe, el Senado tiene mucho que decir en el Congreso Unido.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("El Dr. Kirs, el viejo con cara de póquer, siempre juega sus cartas cerca del pecho. Entonces, no sé qué ha hecho exactamente.", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(¿Viejo con cara de póquer?) \\nPensé que el Senado compartiría su inteligencia con SID...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Eres demasiado ingenuo...", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ninguna agencia de inteligencia compartiría toda su inteligencia con los jefes de estado o de gobierno.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Eh? ¡¿Por qué?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Como dice el refrán, conocer es poseer.", "Mariru")
	await novel_interface.show_dialog("El Senado es la máxima autoridad en New Opulentia. Entonces, naturalmente, SID tiene que trabajar con él. En otras palabras, SID y el Senado son socios.", "Mariru")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Si fueras el jefe, ¿le darías toda la información confidencial a tu pareja de forma gratuita?", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mmm... Por supuesto que no...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Y si tu pareja tiene información confidencial valiosa que realmente deseas, ¿qué harías?", "Mariru")
	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Déjame ver... \\nTal vez compre a algún conserje.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Chica inteligente. Mientras la agencia sea lo suficientemente grande, siempre se puede romper desde adentro, sin importar cuán estricto sea su protocolo de seguridad.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si... si ese es el caso, ¿también tenemos lunares en SID?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Puedes apostar. Hay miles de empleados en SID y algunos de ellos deben ser espías, ya sea del Senado, agencias de inteligencia extranjeras u otras organizaciones.", "Mariru")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Es por eso que necesitamos mantener informados sólo a un pequeño grupo de personas cuando se trata de inteligencia clave.", "Mariru")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Entonces, ¿qué pasa con el Salón de Marfil?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Eso no es algo de lo que debas preocuparte. Las chicas ingenuas como tú nunca podrán infiltrarse en el Senado.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Todos los miembros del Senado son expertos en el campo de Substance H con una clasificación mínima de nivel SS.", "Mariru")
	await novel_interface.show_dialog("Esos expertos tienen un montón de Substance H elementos para experimentar. Si te cuelas allí, es posible que te laven el cerebro antes de que te des cuenta.", "Mariru")
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pero… todavía hay muchos puntos cuestionables en este caso.", "Lian")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Por ejemplo, ¿por qué la delegación Salmonton pasó de contrabando la Mariposa Dorada a New Opulentia?", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Y ese collar de Raphael, que está bastante pasado de moda, claramente no es su taza de té. Normalmente lo mete por debajo del cuello.", "Lian")
	await novel_interface.show_dialog("En realidad, Raphael que yo sepa… nunca usaría tales adornos…", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Tienes razón. La Mariposa Dorada tiene propiedades similares a las del meme infeccioso Substance H. El escudo protector que utilizamos para un objeto tan peligroso suele ser tan grande como un camión.", "Mariru")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("Pero simplemente lo metieron en una maleta. La energía que se escapa de esa maleta puede incluso ser detectada por satélites.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Si realmente querían introducirlo de contrabando, ¿por qué tuvieron que conseguir que esos funcionarios del gobierno lo hicieran? ¿Por qué correrían un riesgo político tan grande?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quizás no exista ningún riesgo. Quizás sea una orden de alguien superior que les ha dado la garantía…", "Lian")
	await novel_interface.show_dialog("Los miembros de la delegación no necesitan declarar su equipaje de mano en el control de seguridad. Y eligieron deliberadamente un hotel fuera de nuestra jurisdicción.", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("¿Estás diciendo…?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("¿Finalmente lo conseguiste?", "Mariru")
	novel_interface.character_light(0.35,"solemn")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿El Senado les ordenó hacerlo? ¿Solo para mantener a SID en la oscuridad?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak")
	await novel_interface.show_dialog("Jacob es agregado militar de Salmonton y los datos de Elluka muestran que han estado estudiando a las brujas por un tiempo.", "Mariru")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("La Mariposa Dorada pertenece a una bruja y Jacob apareció de repente y se unió a la pelea. \\nPiénsalo...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La carrera por el control del poder sobrenatural arrojó al mundo al caos de la Guerra de los Siete Años. ¿Eso va a volver a suceder?")
	novel_interface.show_character("ren_battle","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_research","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Se producirán más brujas entonces?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Es hora de prepararse para esta pelea debajo de la mesa.", "Mariru")
	await novel_interface.hide_all_characters()
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Unas semanas después")
	novel_interface.show_character("ren_uniform","sob")
	await novel_interface.show_dialog("Nnngh ... Apenas puedo mantener los ojos abiertos ... \\nMe quedé despierto toda la noche jugando ...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Oye, fanático del travestismo.")
	novel_interface.character_light(0.35,"wry_smile")
	await novel_interface.show_dialog("???", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz familiar...")
	await novel_interface.show_text_only("El lugar familiar...")
	await novel_interface.show_text_only("Y el saludo familiar...")
	await novel_interface.show_text_only("La chica parada frente a mí… ¡Es ella otra vez!")
	await novel_interface.show_text_only("¡Este alborotador de lengua afilada Raphael!")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Ra-Raphael? \\n¿Por qué estás aquí?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","stare",0.25)
	await novel_interface.show_dialog("No te enseñan modales básicos en esta escuela, ¿verdad?", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Soy tu mayor. ¡Muestre algo de respeto!", "Raphael")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Eh?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("No me había dado cuenta de eso hasta ahora... \\nCon una cartera en la mano, ella usa el uniforme y los zapatos para estudiantes de tercer año.")
	novel_interface.show_character("ren_uniform","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Pensé que odiabas esta escuela...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("No tuve otra opción. \\nTodas las escuelas en New Opulentia apestan.", "Raphael")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Como bruja, esta escuela puede ser la mejor opción para mí.", "Raphael")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Parece que Raphael hizo toda la investigación y tomó su decisión en tan poco tiempo. Que genio.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Tu familia… ¿Les has dicho que eres una bruja?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("¿Por qué molestarse? No les traería más que preocupaciones.", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Oye, ¡convertirse en bruja no es nada como unirse a un club extraescolar!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Te imaginas que me enviaron al extranjero sólo para dejarme pasar desapercibido después de esa estúpida entrevista?", "Raphael")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Si se enteran de esto, probablemente se asustarán, como cuando se enteraron de que me había hecho un tatuaje.", "Raphael")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("No, no, no. ¡Eso es un juego de niños comparado con convertirse en bruja! \\nBueno, si realmente tienes algún tatuaje, enséñamelo por favor...")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Por cierto… ¿qué diablos dijiste en la entrevista?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Eres de la Edad de Piedra o qué? Ese vídeo ya debería haber estado circulando por Internet.", "Raphael")
	novel_interface.character_light(0.35,"uneasy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Hablando de eso, también soy bastante popular en Internet. \\nDespués de todo, soy un criminal buscado en todo el mundo...")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Para ser justos, debo haberme perdido algunas noticias importantes porque estoy completamente absorbido por jugar Legend of Zelda.")
	novel_interface.character_light(0.35,"stare")
	await novel_interface.show_dialog("Deja de mirarme de esa manera...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Saco mi teléfono para recibir las últimas noticias. Raphael no miente. Su nombre ha aparecido en los titulares de todo el mundo.")
	await novel_interface.show_text_only("Reproduzco uno de esos videos y pronto sale la voz de Raphael.")
	await novel_interface.show_dialog("¿Por qué creen que todos los pecadores pueden ser redimidos siempre que oren a los dioses? La oración no les aporta nada más que un patético consuelo.", "Raphael")
	await novel_interface.show_dialog("… Esas basuras son inútiles dondequiera que vayan. ¿Por qué nuestro gobierno debería salvarles el trasero? Déjalos pudrirse.", "Raphael")
	await novel_interface.show_text_only("No puedo creer que estos comentarios controvertidos los haga Raphael, la nieta del gobernador de Salmonton. No es de extrañar que haya causado tanto revuelo.")
	novel_interface.show_character("ren_uniform","speechless")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","worry",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Recuerdo que Salmonton es un estado de bienestar religioso... \\nRealmente tienes agallas para hacer esos comentarios provocadores.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Muchos estados han declarado guerras en nombre de los dioses. Entonces, ¿por qué no puedo decir lo que tengo en mente?", "Raphael")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Guerra? ¿Quieres decir... la Guerra de los Siete Años?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("No, idiota. ¡Por supuesto las guerras venideras!", "Raphael")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("En Salmonton, animamos a las personas a tener su propia religión, sin importar en qué dios crean.", "Raphael")
	await novel_interface.show_dialog("Como resultado de las migraciones masivas después de la Guerra de los Siete Años, innumerables basuras se precipitaron hacia esos grupos inútiles, y su avaricia no conoce fronteras.", "Raphael")
	novel_interface.change_2nd_expression("angry")
	await novel_interface.show_dialog("El abuelo es demasiado indulgente con ellos. Esos vagos deberían acabar en los mataderos…", "Raphael")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡Para! Se está poniendo espeluznante ahora...", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ahora estás en el centro de esta transición masiva. Simplemente no te importa, ¿o sí?", "Raphael")
	novel_interface.change_2nd_expression("thinking")
	await novel_interface.show_dialog("Quizás nadie más que idiotas como tú pueda vivir una vida tan optimista.", "Raphael")

	print("=== 第三章第16话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
