# chapter3_ep01.gd - 第三章第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep01_script()

func play_script():
	pass

func chapter3_ep01_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("ฝันร้ายที่แปลกประหลาด บทสนทนาที่คลุมเครือ เงาในความฝัน \\nพร้อมการแจ้งเตือนสีแดง...")
	await novel_interface.show_text_only("ขณะที่ฉันกำลังจะยอมรับตัวตนใหม่ของฉันและตัดสินใจที่จะรวมตัว พวกเขาก็ทำให้ทุกอย่างวุ่นวายอีกครั้ง")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("อืม?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("เห็นข่าวมั้ย? \\nนี่เขาเอง! No, me, it's me!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("ฉันไม่ได้ตาบอด แน่นอน ฉันรู้ว่าเธออยู่ตรงหน้าฉัน เหงื่อออกเลย สาวน้อยโง่เขลา", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","perspire1")
	await novel_interface.show_dialog("ไม่! \\nให้ตายเถอะ ฉันเองที่อยู่ในข่าว!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ด้วยความตื่นตระหนก ฉันไม่รู้ด้วยซ้ำว่าจะเริ่มจากตรงไหน \\nMariru คำรามและเอามือทุบหัวฉัน")
	novel_interface.show_character("ren_battle","perspire1")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ช่างเป็นคนงี่เง่าที่ไร้ประโยชน์ หลังจากการฝึกอบรมทั้งหมดนี้ คุณจะไม่สามารถรายงานต่อเจ้าหน้าที่ของคุณได้อย่างชัดเจน", "Mariru")
	await novel_interface.show_dialog("ไม่ใช่แค่เกี่ยวกับผู้ชายที่ดูเหมือนว่าคุณเป็นที่ต้องการทั่วโลกเพราะเขาขโมยศูนย์รวบรวมและการวิจัยของ Second Academy City ไม่ใช่หรือ?", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ใช่ ใช่ ใช่! อย่างแน่นอน!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("หน่วยข่าวกรองได้รายงานข่าวดังกล่าวมานานแล้วก่อนที่จะแพร่ระบาด", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("คุณดูโง่เมื่อคุณกลัว ~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru บีบแก้มฉัน ฉันพยายามหยุดเธอทันที")
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Mariru เอาจริงดิ!", "Lian")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("ที่เป็นที่ต้องการมากที่สุดทั่วโลก ไม่ใช่เรื่องตลก!", "Lian")
	await novel_interface.show_text_only("ฉันไม่เคยนึกเลยว่าวันหนึ่งฉันจะมีข่าวเรื่องการลักทรัพย์")
	novel_interface.change_expression("wail")
	await novel_interface.show_text_only("และนี่คือประกาศสามเอ! ดังที่ฉันจำได้ ชายคนสุดท้ายที่ต้องการตัวซึ่งมีระดับตื่นตัวเช่นนี้ ถูกบังเกอร์บัสเตอร์ทิ้งระเบิดจนเสียชีวิตในอเมริกาใต้")
	novel_interface.change_expression("sob")
	await novel_interface.show_text_only("หัวขโมยผู้เคราะห์ร้ายคนนี้ขโมยตัวตนก่อนหน้านี้ของฉันไปแบบนั้น… ฉันแทบจะน้ำตาไหลเมื่อคิดถึงเรื่องนี้")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("ในกรณีนี้... \\nสิ่งเดียวที่ฉันวางใจได้คือ Mariru", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("ตราบเท่าที่ฉันอยากเห็นเธอต้องทนทุกข์แบบนี้…", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("ฉันต้องขอให้คุณตรวจสอบข่าวอีกครั้ง", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"sob")
	await novel_interface.show_text_only("จำเป็นไหม? ฉันมีสิ่งทั้งหมดฝังอยู่ในใจของฉันแล้ว")
	await novel_interface.show_dialog("ภาพอาจไม่คมชัดแต่มั่นใจว่าเขาดูเหมือนเด็กผู้ชายแทบทุกประการ!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("เพื่อพิสูจน์สิ่งที่ฉันพูด ฉันจึงหยิบข่าวขึ้นมาในโทรศัพท์")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("เห็นไหม นี่คือ… \\nเอ๊ะ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ประกาศตามหาที่ทำให้ฉันตกใจไม่อยู่ตรงนั้นแล้ว มันถูกแทนที่ด้วยการประกาศคนหายตามปกติ")
	await novel_interface.show_text_only("คุณอิโนะอุเอะ นักเขียนการ์ตูนวัย 70 ปี หายตัวไปเมื่อเร็วๆ นี้ \\nหากใครรู้ที่อยู่ของเขา โปรดติดต่อตำรวจทันที")
	await novel_interface.show_text_only("ฉันตรวจสอบเว็บไซต์อื่นและแม้แต่ค้นหาด้วยคำหลัก แต่ไม่พบข่าวเลย")
	await novel_interface.show_text_only("เมื่อมองดูสีหน้าที่คุณบอกของ Mariru แล้ว ฉันรู้สึกซาบซึ้งใจมาก")
	novel_interface.show_character("ren_battle","timid")
	await novel_interface.show_dialog("เป็นคุณ…?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru เข้ามาเช็ดน้ำตาให้")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("ดูคุณสิ - สำลักไปหมด", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("ถ้าคุณอยากขอบคุณฉันจริงๆ—มาเป็นทาสของฉันเถอะ~", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("และ...", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("เมื่อคุณพูดว่า \"สิ่งเดียวที่ฉันวางใจได้คือ Mariru\" \\nคุณดูน่ารักมาก...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru ยกคางของฉันขึ้นอย่างอ่อนโยนด้วยนิ้วชี้ของเธอ")
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("เฮ้ หยุดนะ!", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("เท่าที่ฉันเห็น ฉันตกเป็นทาสแล้ว…")
	novel_interface.character_move_left(-0.25,0.3,false)
	novel_interface.show_2nd_character("liliu_uniform2","normal2",0.25)
	await novel_interface.show_dialog("ฉันหวังว่าฉันจะทำอย่างนั้นได้ แต่ตามความรู้ของฉัน มีเพียงเอเจนซี่เดียวที่สามารถปิดโซเชียลมีเดียทั่วโลกได้", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เอ๊ะ?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("จะต้องเป็นคำสั่งบริหารจากรัฐสภาคองเกรสแห่งสหประชาชาติ", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("สภาสูงสุดที่เป็นตัวแทนของเมือง Academy ทั้งหกแห่ง… ตัดสินใจที่จะลบข่าวนี้ออกเหรอ?", "Lian")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("ทำไม...", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Mariru มองมาที่ฉันและยิ้มลึกลับให้ฉัน")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("อย่าโง่เลย แน่นอนว่าพวกเขาไม่ได้ทำสิ่งนี้เพื่อปกป้องหัวขโมย", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("พวกเขาแค่ไม่อยากให้สาธารณชนรู้ว่าเกิดอะไรขึ้น", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("หัวขโมยคนนี้คือใคร? ทำไมเขาถึงใช้ตัวตนของฉัน?", "Lian")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"normal2")
	await novel_interface.show_dialog("ไม่ว่าเขาจะเป็นใคร เขาต้องเป็นอัจฉริยะแน่ๆ ถึงจะสามารถออกจากศูนย์รวบรวมและวิจัยของอาคาทราซได้ในชิ้นเดียว", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("ประเด็นก็คือการปกปิดใบหน้าไม่ใช่เรื่องยากสำหรับเขา", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("แต่เขาไม่กล้าและยังกล้าขึ้นไปบนหลังคาอาคารสักพักด้วยซ้ำ...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("ตามการฝึกอบรมพิเศษ สิ่งที่ไม่สำคัญที่สุดจะหายไปจากที่ที่ควรปรากฏ...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("…หรืออยู่ในที่ที่ไม่ควรอยู่", "Mariru")

	print("=== 第三章第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
