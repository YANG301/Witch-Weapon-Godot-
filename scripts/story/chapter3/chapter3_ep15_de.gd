# chapter3_ep15.gd - 第3章第15话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep15_script()

func play_script():
	pass

func chapter3_ep15_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/parkingLot_night.png")
	await novel_interface.show_text_only("Wie von Mariru angewiesen, eilen wir den ganzen Weg hinunter zur Tiefgarage.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Mariru sagte mir, dass die Männer des Administrators sich von einem anderen Ausgang zurückgezogen haben, anstatt uns nachzulaufen.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Lass mich ihre Wunde untersuchen ... Erste Hilfe habe ich schon gelernt.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael signalisiert mir, Annie flach auf eine ebene Fläche zu legen. Dann überprüft sie den Puls und die Atmung von Annie.")
	novel_interface.show_character("raphael","smile")
	await novel_interface.show_dialog("Glücklicherweise gibt es kein V-Flimmern, obwohl ihr Atem ziemlich flach ist und die Verbrennungen schwerwiegend sind. Keine Ahnung, ob es sich um eine innere Verletzung handelt …", "Raphael")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Das ist brutal! Ein Mädchen so behandeln!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Hmm... Fräulein?", "Beatrice")
	await novel_interface.show_dialog("Locken Sie oft kleine Tiere an? \\nZum Beispiel –", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Wir drehen uns um und schauen hinüber. In unserer Nähe sind zwei Tauben.")
	await novel_interface.show_dialog("Gurren – Gurren –", "Taube")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Was ist daran seltsam? Tauben gibt es überall.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Nein, hier drin ist Keller drei!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Na und? \\nSie sind keine gefährdeten Tiere.", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Gurren – Gurren – Gurren –", "Taube")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(… Adel, hah. Überhaupt kein gesunder Menschenverstand.)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Heilmagie lockt kleine Tiere an. Aber wenn sie sich dessen nicht bewusst ist ...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice zieht mich näher an Raphael heran und nimmt ihre und meine Hände.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Kommen Sie, probieren Sie das aus –", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","upset")
	await novel_interface.show_dialog("Hmm?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice legt meine Hand auf die von Raphael und drückt unsere Hände fest mit ihrer Handfläche.")
	novel_interface.show_character("ren_maid","upset")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	await novel_interface.show_dialog("Was machst du?", "Raphael")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich hätte nicht erwartet, dass ... \\nRaphaels Hand so weich und warm ist ...")
	await novel_interface.show_text_only("Nein, warte! \\nBin ich –")
	novel_interface.show_character("ren_maid","perspire1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("raphael","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sie hält ihre Hände ...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ich sehe Überraschung und Wut im Gesicht von Raphael. Sie starrt mich wütend an und spuckt fast Feuer.")
	await novel_interface.show_text_only("Ich schaudere bei dem Gedanken, als Perverser bezeichnet und schwarz und blau zusammengeschlagen zu werden.")
	await novel_interface.show_text_only("Plötzlich dreht sich Raphael zu Beatrice um, als würde ihm etwas klar. Beatrice nickt leicht.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael schließt die Augen, mit einem intensiven Gesichtsausdruck. Und Beatrice bewegt langsam ihre Handfläche weg.")
	novel_interface.show_character("ren_maid","stare")
	await novel_interface.show_dialog("(Was? Macht es ihr Spaß, meine Hand zu halten?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich durchströmt mich eine angenehme Wärme und ich fühle mich entspannter als je zuvor.")
	await novel_interface.show_text_only("Puh – Mir wird plötzlich klar, dass die Luft so frisch ist, sogar in seiner Tiefgarage.")
	await novel_interface.show_text_only("Und irgendwie hört die schreckliche Szene auf, mich zu verfolgen.")
	await novel_interface.show_dialog("Ah-em…", "Annie")
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Annie?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich sehe, wie die Brandnarben am Körper von Annie mit unglaublicher Geschwindigkeit verschwinden.")
	await novel_interface.show_text_only("Die Wärme lässt allmählich nach. Raphael atmet erleichtert auf und öffnet die Augen.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Ren, wo sind wir...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie sieht mich schläfrig an, als würde er gerade erst aufwachen.")
	novel_interface.show_character("ren_maid","gratified")
	await novel_interface.show_dialog("Wir sind jetzt in Sicherheit. Ich warte nur auf Mariru.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","thinking")
	await novel_interface.show_dialog("…", "Raphael")
	await novel_interface.show_dialog("Warum…", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","worry")
	await novel_interface.show_dialog("Ist Ihnen das nicht schon einmal aufgefallen?", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Eine Hexe mit solch einer wunderbaren Heilmagie ... \\nDu bist unglaublich!", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Ja, wirklich! Ich habe auch die Magie gespürt!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("… Hexe? Magie? Was für ein Unsinn!", "Raphael")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Raphael runzelt streng die Stirn.")
	novel_interface.character_light()
	await novel_interface.show_dialog("Was hast du mit mir gemacht? \\nWarum heilen ihre Wunden so schnell?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich weiß, dass es schwierig ist, so viele Informationen auf einmal aufzunehmen. Also schweige ich.")
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("Wer greift unsere Sicherheitssoldaten an? \\nWie können sie es wagen, hier die Substance H-Waffe einzusetzen …", "Raphael")
	await novel_interface.show_dialog("Warum wurde ein Mensch, der seit Hunderten von Jahren tot war, plötzlich wieder lebendig? Und ich trage ihre Halskette!", "Raphael")
	await novel_interface.show_dialog("Und ich habe gesehen ... \\nDer Albtraum ...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphaels Stimme zittert, als sie an die schreckliche Szene denkt.")
	await novel_interface.show_text_only("Ich wende mich an Beatrice. Auf ihrem schönen Gesicht erscheint ein ruhiges Lächeln.")
	await novel_interface.show_text_only("Der Smaragd kehrte in seinen ursprünglichen Zustand zurück und Beatrice übergab ihn an Raphael.")
	await novel_interface.show_text_only("Es schien, als hätte die schreckliche Szene vor einem Moment nichts mit ihr zu tun.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Die Magie im Buch der Sieben Philosophen stört den Geist … \\nEs ist völlig normal, bei der ersten Begegnung Angst zu verspüren.", "Beatrice")
	novel_interface.change_expression("smile2")
	await novel_interface.show_dialog("Aber Angst ist ein wichtiges Gefühl. Wenn Sie Ihre Schwächen kennen, können Sie Krisen überstehen.", "Beatrice")
	await novel_interface.show_dialog("Was wirklich schrecklich ist, sind diejenigen, die von Angst beherrscht werden ...", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice scheint in Erinnerungen versunken zu sein, mit einem traurigen Ausdruck in ihren Augen.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Wie dem auch sei, ich hätte das Buch lieber nie aufgeschlagen und mir diesen Wunsch auch nie geäußert …", "Beatrice")
	await novel_interface.show_dialog("Und nie... habe ich die verfluchte Macht erlangt...", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","normal1")
	await novel_interface.show_dialog("Verflucht?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Das Zauberbuch hat mich mit einer Magie ausgestattet ... \\nIch kann mich nicht beherrschen, einen Charme auszustrahlen, der Männer anzieht.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("(Deshalb...!)", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice dreht sich zu mir um und klopft mir mit der Fingerspitze auf die Kehle.")
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Darf ich eine Frage stellen?", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Ja... Bitte!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("beatrice_battle","smile2",0.25)
	await novel_interface.show_dialog("Du heißt Ren, oder? \\nDu bist etwas Besonderes ...", "Beatrice")
	await novel_interface.show_dialog("Als Mädchen solltest du gegen meinen Charme immun sein. Warum hast du ... mir also heimliche Blicke zugeworfen?", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Sie hat es bemerkt! \\nIch schäme mich sooooooo!")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Aber… im Gegensatz zu Männern verliert man nicht völlig die Kontrolle… oder benimmt sich wie ein Verrückter.", "Beatrice")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Liegt es an meiner Magie?…) \\n(Nein, nein, nein, ich habe völlig die Kontrolle verloren!)", "Lian")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Beatrice hebt langsam mit einem Finger meinen Kiefer an und berührt dann sanft meine Nase.")
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Es macht mir nichts aus ... Ehrlich gesagt muss ich zugeben, ... du bist süß.", "Beatrice")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Ich schlucke unbewusst.")
	await novel_interface.show_text_only("Ist das ... nur die Wirkung von Magie?")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Kurze Zeit später hielt eine schwarze SUV-Limousine vor uns.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Ren, Annie, steig ein!", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Beatrice, richtig? Ich hoffe, dass du mit uns gehst.", "Mariru")
	await novel_interface.show_dialog("Ich habe alle verfügbaren Dokumente gefunden ... Falls Sie sich für das Leben derjenigen interessieren, die Sie kennen.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ihr heimlicher Bewunderer, der Dichter, hat Verse geschrieben, die über Jahrhunderte hinweg weitergegeben wurden.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Gut. Ich interessiere mich auch für diese Süße hier.", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich Beatrice in die Augen treffe, werde ich wieder rot …")
	await novel_interface.show_text_only("Ist... Ist das wirklich nur die Wirkung ihrer Magie?")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Und Raphael, du gehst einfach zurück in dein Zimmer. Die Bande ist bereits gegangen. Es ist jetzt sicher.", "Mariru")
	await novel_interface.show_dialog("Wenn die Delegation feststellt, dass Sie vermisst werden ... Sie wollen sie nicht erschrecken, wissen Sie.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Wir haben Schmuggelware mitgeführt ... und solchen Aufruhr verursacht ...", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael betrachtet Beatrice. \\nNun, aus der Schmuggelware ist eine wunderschöne Dame geworden. Wie süß!")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("Und du lässt mich einfach so gehen?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("Im Gegenzug hat Dr. Dekkers zugestimmt, dass meine designierten Händler im kommenden Jahr die ersten in der Schlange für die Produkte von Salmonton sein werden.", "Mariru")
	novel_interface.change_2nd_expression("speak2")
	await novel_interface.show_dialog("Und er hat mir auch versprochen, bei meinen Handelsaktivitäten an der Newmoridas Futures Exchange die Augen zu verschließen.", "Mariru")
	await novel_interface.show_dialog("Die Vereinbarung liegt bereits auf meinem Schreibtisch. Seien Sie also beruhigt. SID ist keine Wohltätigkeitsgruppe.", "Mariru")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Warte! Wir haben unser Leben nur für dich riskiert, um Geld zu verdienen!?")
	novel_interface.character_light(0.35,"thinking")
	await novel_interface.show_dialog("Humph—", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Gut. Ich verspreche, dass ich niemandem von diesem Vorfall erzählen werde, bevor ich alles geklärt habe.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Es macht so viel Freude, mit dem Dekkers zu arbeiten.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Ren, ich werde diese magische Sache auf jeden Fall herausfinden, wenn ich wieder bei Salmonton bin!", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","happy")
	await novel_interface.show_dialog("Bitte tun Sie es! Ich denke, du hast wirklich wunderbare magische Kräfte.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael wendet sich ab, bleibt aber abrupt stehen. \\nSie nimmt ihre Halskette ab und wirft sie mir zu.")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Das ist aus Ihrer Familiensammlung, nicht wahr? Wie können Sie…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","normal2")
	await novel_interface.show_dialog("Es gehört jetzt dir.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Ein galantes Mädchen! Wenn du erwachsen bist, wirst du eine herausragende Frau werden.", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Humph, ich werde nicht vergessen, eine Hintergrundüberprüfung bei dir durchzuführen.", "Raphael")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Passt auf euch auf, alle zusammen. Wir werden uns wiedersehen.", "Raphael")

	print("=== 第3章第15话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
