# chapter3_ep14.gd - 第3章第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep14_script()

func play_script():
	pass

func chapter3_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Jacob Golpeie o administrador do \\nElluka…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Atrás dele, vejo vários soldados de segurança caídos no chão.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Eles simplesmente desmaiaram. Matar na zona desmilitarizada não está nos meus planos.", "Jacob")
	await novel_interface.show_dialog("Eu pretendia retomar as páginas do clássico cult Livro dos Sete Filósofos e não esperava tal bônus…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("(Livro dos Sete Filósofos…) \\n(Este é o Grimório ligado à Borboleta Dourada?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Ren… Encontrei muitas feridas antigas no corpo de Elluka quando a ajudei a se lavar.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("(Você lavou Elluka?) \\n(Quando!?)", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("(Não, esse não é o ponto.) \\n(Velhas feridas… Isso significa…!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("Nenhuma criança comum poderia suportar uma experiência tão traumática!", "Annie")
	await novel_interface.show_dialog("Tem que ser esse cara ... é esse!!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Oh— \\nParece que aquela coisa ainda não quebrou.", "Jacob")
	await novel_interface.show_dialog("Tut-tut, acho que SID já fez engenharia reversa… \\nA tecnologia que usei nele.", "Jacob")
	await novel_interface.show_dialog("Se eu soubesse que causaria tantos problemas, teria instalado um dispositivo de autodestruição nele.", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Você—!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","serious")
	await novel_interface.show_dialog("— Idiota!", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A próxima coisa que sei é que Annie salta furiosamente e tenta chutar Jacob na cara.")
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Chiado—")
	await novel_interface.show_text_only("Com um grito agudo, a sala é iluminada por um enorme arco elétrico. Por um momento, estou cego.")
	await novel_interface.show_text_only("Leva segundos para o brilho desaparecer. Uma dor aguda permanece em meus olhos.")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","shout")
	await novel_interface.show_dialog("Annie…!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie perde a consciência e cai no chão. Uma faixa de marcas de queimadura em forma de galho aparece em sua pele.")
	await novel_interface.show_text_only("O soldado ao lado de Jacob está segurando uma arma fumegante… Essa é a arma que eles usaram agora?")
	await novel_interface.show_text_only("O soldado descarrega rapidamente uma bala semelhante a uma bateria do tamanho de uma vasilha.")
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("Sabemos como tirar o melhor proveito das bruxas…", "Jacob")
	await novel_interface.show_dialog("Prefiro pegá-los vivos. Mas a vadia SID chegará em breve…", "Jacob")
	await novel_interface.show_dialog("Agora que estamos ficando sem tempo…", "Jacob")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jacob tira um pedaço de metal em forma de torta. A casca verde-acinzentada emite um brilho azul claro familiar.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("Isso é… uma arma Substance H?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Eu sinto… o fluxo do poder mágico…", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","angry")
	await novel_interface.show_dialog("O que diabos você está fazendo? Esta é uma zona desmilitarizada!", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Ren)", "Mariru")
	await novel_interface.show_text_only("A voz de Mariru de repente vem dos fones de ouvido.")
	await novel_interface.show_dialog("(Essa é uma armadilha feita de fibras autoligadas.) \\n(É uma arma Substance H não letal.)", "Mariru")
	await novel_interface.show_dialog("(Ele explode três segundos após a detonação.) \\n(E as fibras se espalharão por todo o lugar. É impossível escapar.)", "Mariru")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("—!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("(Então, guarde suas forças por enquanto.) \\n(Vou descobrir como tirar você daqui…)", "Mariru")
	await novel_interface.show_text_only("Jacob levanta lentamente a armadilha em sua mão direita. Linhas douradas aparecem na palma da mão, como se estivesse pronto para uma luta.")
	novel_interface.show_character("ren_maid","solemn")
	await novel_interface.show_dialog("A mão dele… é uma inscrição mágica?", "Lian")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("(Finalmente… Minha vez de experimentar a arma Substance H…)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","smile2")
	await novel_interface.show_dialog("Desculpe por isso…", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice de repente me agarra com uma mão e arranca o colar de Raphael com a outra.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("O quê?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, o pingente de esmeralda emite um raio brilhante e se transforma em uma espada poderosa com inscrições na lâmina.")
	novel_interface.show_character("beatrice_battle","smile1")
	await novel_interface.show_dialog("Olhe para essas almas miseráveis implorando para limpar seus pecados -", "Beatrice")
	await novel_interface.hide_character()
	novel_interface.show_character("jacob")
	await novel_interface.show_dialog("O que…", "Jacob")
	await novel_interface.hide_character()
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Cale a boca!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Beatrice empurra a espada pesadamente no chão.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jacob abre a boca, mas não sai nada. \\nA sala está repleta de um silêncio mortal.")
	await novel_interface.show_text_only("O chão abaixo de Jacob racha, revelando nada além de escuridão total.")
	await novel_interface.show_text_only("Ouve-se um som assustador das profundezas da escuridão, como se milhões de pessoas estivessem de luto e uivando do inferno.")
	await novel_interface.show_text_only("Uma fumaça escura sai da fresta e toma conta de todos os cantos da sala, agora envolta em uma escuridão infernal em um piscar de olhos.")
	await novel_interface.show_text_only("Atingido por um calafrio nos ossos e uma profunda sensação de terror, meu cabelo se arrepia e não consigo me mover…")
	novel_interface.show_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	await novel_interface.show_text_only("Mas apenas alguns segundos depois, a escuridão se dissipou. \\nE a rachadura não foi encontrada em lugar nenhum.")
	await novel_interface.show_text_only("Como se estivesse sofrendo um ataque de pânico, Jacob cai no chão e coça o pescoço com tanta força que sangra.")
	await novel_interface.show_text_only("Seu rosto fica vermelho enquanto ele luta para respirar. Mas seus pulmões parecem estar sem ar, deixando-o ofegante e intrometido em vão.")
	await novel_interface.show_text_only("Demora um pouco até que ele recupere a respiração fraca.")
	await novel_interface.show_text_only("O homem alto e robusto se encolhe no tapete, tremendo, com os braços cruzados sobre o peito.")
	await novel_interface.show_text_only("Seus olhos injetados de sangue estão cheios de medo. As lágrimas saem como resultado da descompressão.")
	await novel_interface.show_text_only("As linhas em sua mão desapareceram completamente e a armadilha caída no tapete também perdeu o brilho.")
	await novel_interface.show_text_only("Os soldados mascarados estão todos parados, tremendo.")
	await novel_interface.show_text_only("Pelas suas faces inexpressivas, eles parecem tomados pelo horror de ver uma realidade além de qualquer descrição.")
	await novel_interface.show_text_only("Se você olhar longamente para um abismo, o abismo também olhará para você...")
	await novel_interface.show_text_only("Diante do verdadeiro horror, até mesmo respirando…")
	await novel_interface.show_text_only("Faz você se sentir exposto a um desespero indescritível.")
	novel_interface.show_character("beatrice_battle","angry")
	await novel_interface.show_dialog("Vamos!", "Beatrice")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_dialog("(Ren, saia daí!)", "Mariru")
	await novel_interface.show_text_only("Só agora recobrei o juízo. Com um aceno de cabeça para Beatrice, saio da sala com Annie em meus braços.")
	await novel_interface.show_text_only("Beatrice arrasta Raphael, que ainda está atordoado. Corremos para o elevador...")

	print("=== 第3章第14话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
