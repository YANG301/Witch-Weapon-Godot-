# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("According to the SID, several intermittent Spacetime Fluxes have been detected near the Sky Hotel since last night.")
	await novel_interface.show_text_only("Coincidentally, the entire Salmonton delegation checked into this luxury hotel located at the Agreed DMZ last night.")
	await novel_interface.show_text_only("Tonight, they’ll throw an art exchange dinner party there for celebrities from all Academic Cities.")
	await novel_interface.show_text_only("But Raphael and her attendant are not invited.")
	await novel_interface.show_text_only("So, Mariru sent Annie and me to this annoying place again.")
	await novel_interface.show_text_only("Standing at the entrance of the magnificent banquet hall, I feel rather uncomfortable.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Hm…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Are you all right? You seem pretty nervous.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Of course I do. I've never dressed up as a maid!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Yep. Annie and I entered the venue in disguise.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("And why should I be the maid while you are a student representative of Gosakuragawa?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("All men love maid dresses, don't they?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Well, I'm pretty sure that none of them loves wearing it themselves!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm… \\nYou've got a point.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("What a pity—you can't see how cute you are in this lovely dress. \\nNo wonder you are so restless…", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie takes a few steps back, grabs her phone… \\nAnd take a photo of me.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Wow… Ren, you look adorable with twintails.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Stop… Delete it, now!", "Lian")
	await novel_interface.show_dialog("(Such a shameful moment…) \\n(If it's seen…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A swooshing sound from Annie's phone confirms a success transmission.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("I've sent it to you and Mariru!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Damn.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Hee-hee, don't be shy. \\nThis ruffle trim suits you well!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("I unlock my phone and the photo shows up on the screen.")
	await novel_interface.show_text_only("Not bad…?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("You are out of your mind!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, a familiar voice comes from the headset.")
	await novel_interface.show_dialog("All right, no more selfies, girls. You've got all the details, right?", "Mariru")
	await novel_interface.show_dialog("The Forth Academic City has got the United Congress's permission to strengthen the security for the event. So, this hotel is heavily guarded tonight.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("All we need to do is find out the causes of the Spacetime Fluxes and pull out immediately, right? \\nI got it.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I can't make any bold move this time. So you two, remember to play it by ear. Especially you, Ren…", "Mariru")
	await novel_interface.show_dialog("If one of those bigwigs takes a fancy to you, you may never get the chance to escape…", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Enough!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("I gotta go. A couple of delegates from the Salmonton Education Commission wanted to talk to me. \\nIt's a good chance to listen in.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, just do what you need to do.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("In the blink of an eye, Annie fakes a smile and turns around, \\nwaving at a group of men in suit.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie is really good at this…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("But what is a maid supposed to do now?", "Lian")
	await novel_interface.show_dialog("Holding the serving tray is so hard…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("A Dom Perignon, please.", "Guest A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Uh? Ugh… Of course, sir. \\nHmm… Would you repeat that?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Guest A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Crap! Am I asking something really dumb?) \\nHmmm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Without proper training, I have absolutely no idea how to handle this. I don't even know what a maid should do.")
	await novel_interface.show_dialog("Pff, you do know this place is known for its maids, right? \\nHow could they let such an unprofessional one in?", "Guest A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("I'm sorry, sir…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Hey! Why are you standing there like a bump on a log?", "Pink-Haired Maid")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Huh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I turn around and see a pink-haired comely maid wearing red-framed glasses.")
	await novel_interface.show_text_only("She casts a polite smile to the guest. As she turns around, the sweet smile turns into fiery anger.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Come on, let’s go get the champagne for the guest.", "Pink-Haired Maid")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Huh? Who are you? \\n(From the way she dresses, she doesn’t look like a waitress at this hotel…)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("The pink-haired maid grabs my hand and heads towards the corner, without a word. Surprisingly, she is full of strength.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("You butterfingers! What's wrong with you?", "Pink-Haired Maid")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ugh… I… I…", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("I'm sorry. I'm new to this job. It’s my first day here…")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Wait, the way you speak… You don’t sound like a maid either…")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Why are you looking at me that way? \\nAre you questioning my ability as a maid?", "Pink-Haired Maid")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Listen up! As a maid, I can and will do anything for my master. No one can doubt that.", "Pink-Haired Maid")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The girl in red glasses suddenly makes a solemn pledge in front of me.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("O… Okay…", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Anyway, thanks for helping me out just now… \\nHonestly, I didn’t know what to do next.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("So, why are you here?", "Pink-Haired Maid")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Her voice suddenly turns cold as ice, \\ncasting a chill over my spine.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("If you lie to me, I will burn you down to a piece of coke.", "Pink-Haired Maid")
	novel_interface.character_dark()
	await novel_interface.show_text_only("The girl broke into silvery laughter as she uttered these intimidating words, but I'm pretty sure she wasn’t kidding!")
	novel_interface.character_light()
	await novel_interface.show_dialog("Are you trying to make something up?", "Pink-Haired Maid")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Damn it. Am I busted?) \\n(Who the hell is she?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("I know who you are. \\nAfter all…", "Pink-Haired Maid")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, don't be rude.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Following the sound, I find a petite girl in a fabulous evening dress.")
	await novel_interface.show_text_only("Her shiny blonde hair reaches down to the waist in braids and her eyes are bright and clear as crystal.")
	await novel_interface.show_text_only("Such an elfin girl's presence at this flamboyant occasion is like a square peg in a round hole.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Miss Skurd! \\nI'm so sorry that I've disturbed you.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Fierce as a lion a moment ago, the maid turns into a kitten just as the little girl shows up.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Look at the poor girl. She is too terrified to say a word.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Just let her go for now, okay?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Roger that!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
