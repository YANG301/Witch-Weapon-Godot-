# chapter3_ep08.gd - 第3章第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep08_script()

func play_script():
	pass

func chapter3_ep08_script():
	novel_interface.change_music("res://assets/audio/music/step by step.mp3")
	novel_interface.change_background("res://assets/images/bg/School/BG_School_centreSpace1.png")
	await novel_interface.show_text_only("Je me sentais agité lors de la tournée de Raphael sur le campus.")
	await novel_interface.show_text_only("Je n'aurais jamais cru pouvoir approcher la cible aussi facilement.")
	await novel_interface.show_text_only("Le directeur adjoint, voyant sa cérémonie de bienvenue préparée de longue date s'envoler, mordille un mouchoir avec ressentiment quelque part derrière nous.")
	await novel_interface.show_text_only("Cependant, la jeune femme ne semble pas satisfaite de notre petite tournée, même si elle est de bien meilleure humeur désormais.")
	novel_interface.show_character("raphael","normal1")
	await novel_interface.show_dialog("C'est ça ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","worry")
	await novel_interface.show_dialog("Hum, si tu parles de la tournée.", "Lian")
	await novel_interface.show_dialog("Si vous continuez ainsi, vous arriverez à la zone commerciale.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("De nombreux bâtiments imitent les styles architecturaux d'avant-guerre, essayant d'apporter une touche culturelle.", "Raphael")
	await novel_interface.show_dialog("Mais ce campus est si petit qu’il n’y a aucun tampon entre des bâtiments de styles contrastés.", "Raphael")
	await novel_interface.show_dialog("Cela rend tout cela trop étouffant ici, tu ne trouves pas ?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("New Opulentia est une ville reconstruite sur des ruines. La plupart de ses sites historiques ont été incendiés.")
	await novel_interface.show_text_only("C’est en fait assez luxueux d’avoir une telle étendue de terre à l’intérieur du bouclier protecteur là où les terres sont rares.")
	await novel_interface.show_text_only("Je me sens en quelque sorte offensé par ses paroles…")
	novel_interface.show_character("ren_uniform","normal2")
	await novel_interface.show_dialog("Hum…", "Lian")
	await novel_interface.show_dialog("Vous devez être Raphael Dekkers de la Quatrième Cité Académique.", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Alors pourquoi visitez-vous l’école si vous n’aimez pas cet endroit ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Wow, tu sais qui je suis ?", "Raphael")
	await novel_interface.show_dialog("Hm… C'est à cause de mon grand-père. Il veut que j'étudie dans une autre ville académique…", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Mais cette école copieuse, sans histoire du tout… Je n'y remettrais plus jamais les pieds.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("…", "Lian")
	await novel_interface.show_dialog("(Donc elle est tout simplement mécontente du plan de son grand-père…) \\n(Pourquoi n'a-t-elle pas simplement parlé ?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Merde ! Ses paroles m'ont d'une manière ou d'une autre affectée. Tous les bâtiments de l’école semblent soudain étranges.")
	await novel_interface.show_text_only("Bon sang ! Oubliez ces commentaires ! Maintenant!")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Whoa, puisque tu es tellement déçu…", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Pourquoi ne dis-tu pas simplement à ton grand-père ce que tu penses ?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix s'approche de nous, élégante comme elle l'est toujours.")
	await novel_interface.show_text_only("Alors que leurs regards se croisent, je crois entendre le crépitement d’une décharge à haute tension.")
	await novel_interface.show_text_only("Ça doit être… une hallucination, non ?")
	novel_interface.show_character("raphael","worry")
	await novel_interface.show_dialog("Qui es-tu ?", "Raphael")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_normal","smile",0.25)
	await novel_interface.show_dialog("Eh bien, je ne suis personne dans cette école.", "Nix")
	novel_interface.change_2nd_expression("mock")
	await novel_interface.show_dialog("Je me demande simplement ce qui vous amène ici, ma dame ?", "Nix")
	await novel_interface.show_dialog("Pourquoi avez-vous accepté de venir ici en premier lieu ? Est-ce à cause de la pression familiale ?", "Nix")
	novel_interface.character_light(0.35,"angry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mon affaire de famille ne vous regarde pas.", "Raphael")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Laissez-moi deviner. Une enfant égocentrique qui n’a jamais défié la volonté de ses parents.", "Nix")
	novel_interface.change_2nd_expression("sad")
	await novel_interface.show_dialog("Pourquoi vous considérez-vous plus haut ? Qui vous donne le droit de juger une école ? Après tout, elle s'est portée volontaire pour vous faire visiter les lieux.", "Nix")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"subtle")
	await novel_interface.show_dialog("Pardon ?! Quand me suis-je considéré comme supérieur ?", "Raphael")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Hé, espèce de pervers. Ai-je déjà été aussi hautain ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("Pas vraiment…", "Lian")
	await novel_interface.show_text_only("Attends, je ne suis pas un pervers !")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Vous voyez ? Je n'ai pas dit ça.", "Raphael")
	await novel_interface.show_dialog("Au fait, ce truc autour de ton cou…", "Raphael")
	novel_interface.change_expression("jeer")
	await novel_interface.show_dialog("Les bijoux sont-ils autorisés dans cette école ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","wry_smile")
	await novel_interface.show_dialog("En fait, nous n’avons aucune restriction sur le port d’ornements…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Et le collier de Nix est tellement mignon !")
	novel_interface.show_character("raphael","jeer")
	await novel_interface.show_dialog("Le groupe est peut-être discret, mais certainement pas son joyau : l'Orlov Black Diamond. Ce joyau royal s'est brisé en trois morceaux et a été perdu lors des turbulences qui ont précédé le déclenchement de la guerre.", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Vous pouvez probablement acheter quelques bâtiments ici avec une seule pièce.", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_uniform","perspire1")
	await novel_interface.show_dialog("Quoi ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("raphael","mock")
	await novel_interface.show_dialog("Se faire passer pour un étudiant ordinaire et prendre sa défense… Que veux-tu ? Pour tromper ce pervers travesti en lui faisant croire que tu es de son côté ?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("…", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Arrête de me traiter de pervers !")
	await novel_interface.show_text_only("Et pourquoi Nix a-t-il ce regard subtil et désolé ?")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Je porte juste quelque chose qui me va.", "Nix")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Et vous ? Vous essayez de paraître indépendant, mais vous êtes fier de profiter de la richesse de votre famille. C'est hilarant.", "Nix")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("raphael","mock",0.25)
	await novel_interface.show_dialog("Je me souviens que les trois pièces sont tombées entre les mains d'un chef de la mafia. Un Black Diamond acheté avec de l’argent mal acquis, ça vous va bien.", "Raphael")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eh bien, je dois admettre que ma famille est moins chanceuse. Après tout, tout le monde ne peut pas gagner une fortune et un titre de noblesse grâce au monopole des céréales.", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("C’est parce que seules nos cultures pourraient aider les gens à prévenir la peste noire. Ils méritent de vivre. Contrairement à toi, pourri à l’envers.", "Raphael")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Vous insistez pour garder la foi alors que vous menacez le monde de faim. Pourquoi ne réfléchissez-vous pas d’abord à votre propre âme ?", "Nix")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jeer")
	await novel_interface.show_dialog("Je n’ai pas besoin de faire ça avec des gens comme toi. Cela ne fera que me faire honte.", "Raphael")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("Oh, cela semble familier. Je ne veux pas non plus en savoir plus sur vous, les perdants.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…")
	await novel_interface.show_text_only("Le soleil de l'après-midi nous éclaire doucement.")
	await novel_interface.show_text_only("Entre les deux, je n’ai aucune idée de comment régler ce combat.")
	novel_interface.show_character("ren_uniform","wail")
	await novel_interface.show_dialog("(Êtes-vous sûr de ne jamais vous être rencontrés auparavant ?)", "Lian")
	await novel_interface.show_dialog("(N'êtes-vous vraiment pas des ennemis à vie ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le directeur adjoint au loin a déjà paniqué et est parti pour un traitement d'urgence.")
	await novel_interface.show_text_only("Peu importe. J'ai toutes les informations souhaitées par Mariru.")
	await novel_interface.show_text_only("De toute façon, ce ne sont pas mes affaires.")

	print("=== 第3章第8话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
