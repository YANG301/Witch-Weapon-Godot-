# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("De acordo com o SID, vários fluxos espaço-temporais intermitentes foram detectados perto do Sky Hotel desde a noite passada.")
	await novel_interface.show_text_only("Coincidentemente, toda a delegação Salmonton se hospedou neste hotel de luxo localizado na DMZ Acordada na noite passada.")
	await novel_interface.show_text_only("Esta noite, eles realizarão um jantar de intercâmbio artístico para celebridades de todas as cidades acadêmicas.")
	await novel_interface.show_text_only("Mas Raphael e seu acompanhante não foram convidados.")
	await novel_interface.show_text_only("Então, Mariru enviou Annie e eu para este lugar chato novamente.")
	await novel_interface.show_text_only("Parado na entrada do magnífico salão de banquetes, sinto-me bastante desconfortável.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Hum…", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Você está bem? Você parece muito nervoso.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Claro que sim. Nunca me vesti de empregada!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sim. Annie e eu entramos no local disfarçados.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E por que eu deveria ser a empregada doméstica enquanto você é representante estudantil de Gosakuragawa?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Todos os homens adoram vestidos de empregada, não é?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Bem, tenho quase certeza de que nenhum deles adora usá-lo!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm… \\nVocê tem razão.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Que pena, você não consegue ver o quão fofa você fica neste lindo vestido. \\nNão admira que você esteja tão inquieto...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie dá alguns passos para trás, pega o telefone dela… \\nE tira uma foto minha.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Uau… Ren, você fica adorável com twintails.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Pare… Exclua-o agora!", "Lian")
	await novel_interface.show_dialog("(Um momento tão vergonhoso…) \\n(Se for visto…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A swooshing sound from Annie's phone confirms a success transmission.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Enviei para você e Mariru!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Droga.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Hee-hee, não seja tímido. \\nEste acabamento com babados combina bem com você!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Desbloqueio meu telefone e a foto aparece na tela.")
	await novel_interface.show_text_only("Nada mal…?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Você está fora de si!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, uma voz familiar vem do fone de ouvido.")
	await novel_interface.show_dialog("Tudo bem, chega de selfies, meninas. Você tem todos os detalhes, certo?", "Mariru")
	await novel_interface.show_dialog("A Quarta Cidade Acadêmica obteve autorização do Congresso Unido para reforçar a segurança do evento. Então, este hotel está fortemente vigiado esta noite.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Tudo o que precisamos fazer é descobrir as causas dos Fluxos do Espaço-Tempo e sair imediatamente, certo? \\nEntendi.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Não posso fazer nenhum movimento ousado desta vez. Então vocês dois, lembrem-se de tocar de ouvido. Principalmente você, Ren...", "Mariru")
	await novel_interface.show_dialog("Se um desses figurões se interessar por você, talvez você nunca tenha a chance de escapar...", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Chega!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Eu tenho que ir. Alguns delegados da Comissão de Educação Salmonton queriam falar comigo. \\nÉ uma boa oportunidade para ouvir.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, apenas faça o que você precisa fazer.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("Num piscar de olhos, Annie finge um sorriso e se vira, \\nacenando para um grupo de homens de terno.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie é muito bom nisso…", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mas o que uma empregada deve fazer agora?", "Lian")
	await novel_interface.show_dialog("Segurar a bandeja de servir é tão difícil…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Um Dom Pérignon, por favor.", "Convidado A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Uh? Ugh… Claro, senhor. \\nHmm… Você poderia repetir isso?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Convidado A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Merda! Estou perguntando algo realmente idiota?) \\nHmmm…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sem treinamento adequado, não tenho absolutamente nenhuma ideia de como lidar com isso. Eu nem sei o que uma empregada deve fazer.")
	await novel_interface.show_dialog("Pff, você sabe que esse lugar é conhecido pelas empregadas domésticas, certo? \\nComo eles puderam deixar alguém tão pouco profissional entrar?", "Convidado A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Sinto muito, senhor…", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Ei! Por que você está aí parado como uma colisão em um tronco?", "Empregada de cabelo rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Hein?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu me viro e vejo uma empregada bonita de cabelo rosa usando óculos de armação vermelha.")
	await novel_interface.show_text_only("Ela lança um sorriso educado para o convidado. Quando ela se vira, o sorriso doce se transforma em raiva ardente.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Vamos, vamos buscar o champanhe para o convidado.", "Empregada de cabelo rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Hein? Quem é você? \\n(Pela forma como ela se veste, ela não parece uma garçonete deste hotel...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A empregada de cabelo rosa agarra minha mão e se dirige para o canto, sem dizer uma palavra. Surpreendentemente, ela está cheia de força.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Seus dedos de manteiga! O que você tem?", "Empregada de cabelo rosa")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ugh… eu… eu…", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Sinto muito. Eu sou novo neste trabalho. É meu primeiro dia aqui…")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Espere, o jeito que você fala… Você também não parece uma empregada…")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Por que você está me olhando desse jeito? \\nVocê está questionando minha habilidade como empregada doméstica?", "Empregada de cabelo rosa")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Ouça! Como empregada doméstica, posso e farei qualquer coisa pelo meu mestre. Ninguém pode duvidar disso.", "Empregada de cabelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A garota de óculos vermelhos de repente faz uma promessa solene na minha frente.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Ah... ok...", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("De qualquer forma, obrigado por me ajudar agora... \\nHonestamente, eu não sabia o que fazer a seguir.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Então, por que você está aqui?", "Empregada de cabelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Sua voz de repente fica fria como gelo, causando um arrepio na minha espinha.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Se você mentir para mim, vou queimá-lo até virar um pedaço de cocaína.", "Empregada de cabelo rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("A garota caiu na gargalhada ao pronunciar essas palavras intimidadoras, mas tenho certeza de que ela não estava brincando!")
	novel_interface.character_light()
	await novel_interface.show_dialog("Você está tentando inventar alguma coisa?", "Empregada de cabelo rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Droga. Estou preso?) \\n(Quem diabos é ela?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("Eu sei quem você é. \\nAfinal…", "Empregada de cabelo rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, não seja rude.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Seguindo o som, encontro uma menina pequena com um vestido de noite fabuloso.")
	await novel_interface.show_text_only("Seu cabelo loiro brilhante chega até a cintura em tranças e seus olhos são brilhantes e claros como cristal.")
	await novel_interface.show_text_only("A presença de uma garota élfica nesta ocasião extravagante é como uma estaca quadrada em um buraco redondo.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Senhorita Skurd! \\nSinto muito por ter incomodado você.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Feroz como um leão há pouco, a empregada se transforma em gatinha no momento em que a menina aparece.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Olhe para a pobre garota. Ela está com muito medo de dizer uma palavra.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Apenas deixe-a ir por enquanto, ok?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Rogério isso!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
