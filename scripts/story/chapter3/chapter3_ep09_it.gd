# chapter3_ep09.gd - 第3章第9话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep09_script()

func play_script():
	pass

func chapter3_ep09_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom1.png")
	await novel_interface.show_text_only("Secondo il SID, da ieri sera sono stati rilevati diversi flussi spaziotemporali intermittenti nei pressi dello Sky Hotel.")
	await novel_interface.show_text_only("Per coincidenza, ieri sera l'intera delegazione Salmonton ha fatto il check-in in questo hotel di lusso situato nella zona demilitarizzata concordata.")
	await novel_interface.show_text_only("Stasera organizzeranno lì una cena di scambio d'arte per celebrità di tutte le città accademiche.")
	await novel_interface.show_text_only("Ma Raphael e il suo assistente non sono invitati.")
	await novel_interface.show_text_only("Quindi, Mariru ha mandato di nuovo me e Annie in questo posto fastidioso.")
	await novel_interface.show_text_only("Stando all’ingresso della magnifica sala dei banchetti, mi sento piuttosto a disagio.")
	novel_interface.show_character("ren_maid","shy")
	await novel_interface.show_dialog("Mhm...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Stai bene? Sembri piuttosto nervoso.", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Certo che lo faccio. Non mi sono mai vestita da cameriera!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sì. Annie e io siamo entrati nel locale sotto mentite spoglie.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("E perché dovrei essere io la domestica mentre tu sei un rappresentante studentesco di Gosakuragawa?!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"happy")
	await novel_interface.show_dialog("Tutti gli uomini adorano gli abiti da cameriera, vero?", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Beh, sono abbastanza sicuro che nessuno di loro ami indossarlo!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Hmm... \\nHai ragione.", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Che peccato, non puoi vedere quanto sei carino con questo bel vestito. \\nNon c'è da stupirsi che tu sia così irrequieto...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie fa qualche passo indietro, prende il telefono... \\nE scattami una foto.")
	novel_interface.show_character("anne_uniform","happy")
	await novel_interface.show_dialog("Wow... Ren, sei adorabile con i codini.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","awkward")
	await novel_interface.show_dialog("Smettila... Cancellalo, adesso!", "Lian")
	await novel_interface.show_dialog("(Un momento così vergognoso...) \\n(Se viene visto...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un sibilo proveniente dal telefono di Annie conferma l'avvenuta trasmissione.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Te l'ho inviato e Mariru!", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Maledizione.")
	novel_interface.show_character("ren_maid","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("anne_uniform","smile",0.25)
	await novel_interface.show_dialog("Ih ih, non essere timido. \\nQuesto rivestimento con volant ti sta bene!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"shy")
	await novel_interface.show_text_only("Sblocco il telefono e la foto viene visualizzata sullo schermo.")
	await novel_interface.show_text_only("Non male...?")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Sei fuori di testa!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, dalle cuffie arriva una voce familiare.")
	await novel_interface.show_dialog("Va bene, basta selfie, ragazze. Hai tutti i dettagli, vero?", "Mariru")
	await novel_interface.show_dialog("La Quarta Città Accademica ha ottenuto il permesso del Congresso Unito per rafforzare la sicurezza dell'evento. Allora, questo hotel è pesantemente sorvegliato stanotte.", "Mariru")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Non ci resta che scoprire le cause dei Flussi Spaziotemporali e tirarcene subito fuori, giusto? \\nHo capito.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Non posso fare alcuna mossa audace questa volta. Quindi voi due ricordatevi di suonare a orecchio. Soprattutto tu, Ren...", "Mariru")
	await novel_interface.show_dialog("Se uno di quei pezzi grossi si invaghisce di te, potresti non avere mai la possibilità di scappare...", "Mariru")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Basta!", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","normal1",0.25)
	await novel_interface.show_dialog("Devo andare. Un paio di delegati della Salmonton Commissione per l'Istruzione volevano parlare con me. \\nÈ una buona occasione per ascoltare.", "Annie")
	novel_interface.change_2nd_expression("smile")
	await novel_interface.show_dialog("Ren, fai semplicemente quello che devi fare.", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,false)
	await novel_interface.show_text_only("In un batter d'occhio, Annie finge un sorriso e si gira, \\nsalutando un gruppo di uomini in giacca e cravatta.")
	novel_interface.character_light(0.35,"upset")
	await novel_interface.show_dialog("Annie è davvero bravo in questo...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ma cosa dovrebbe fare adesso una cameriera?", "Lian")
	await novel_interface.show_dialog("Tenere il vassoio da portata è così difficile...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Un Dom Perignon, per favore.", "Ospite A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Eh? Ugh… Certo, signore. \\nHmm… lo ripeteresti?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("…", "Ospite A")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Merda! Sto chiedendo qualcosa di veramente stupido?) \\nHmmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Senza una formazione adeguata, non ho assolutamente idea di come gestirlo. Non so nemmeno cosa dovrebbe fare una cameriera.")
	await novel_interface.show_dialog("Pff, sai che questo posto è noto per le sue cameriere, vero? \\nCome hanno potuto far entrare una persona così poco professionale?", "Ospite A")
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Mi dispiace, signore...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Ehi! Perché te ne stai lì come una protuberanza su un tronco?", "Cameriera dai capelli rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi giro e vedo un'avvenente cameriera dai capelli rosa che indossa occhiali dalla montatura rossa.")
	await novel_interface.show_text_only("Rivolge un sorriso educato all'ospite. Mentre si gira, il dolce sorriso si trasforma in rabbia ardente.")
	novel_interface.show_character("fabiola_maid","thinking")
	await novel_interface.show_dialog("Forza, andiamo a prendere lo champagne per l'ospite.", "Cameriera dai capelli rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	await novel_interface.show_dialog("Eh? Chi sei? \\n(Da come si veste non sembra una cameriera di questo hotel...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("La cameriera dai capelli rosa mi prende la mano e si dirige verso l'angolo, senza dire una parola. Sorprendentemente, è piena di forza.")
	novel_interface.show_character("fabiola_maid","perspire")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_maid","perspire1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Voi dita di burro! Cos'hai che non va?", "Cameriera dai capelli rosa")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Uffa... io... io...", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_text_only("Mi dispiace. Sono nuovo in questo lavoro. È il mio primo giorno qui...")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_text_only("Aspetta, da come parli... non sembri neanche una domestica...")
	novel_interface.character_light(0.35,"mock")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Perché mi guardi in quel modo? \\nStai mettendo in dubbio la mia abilità come domestica?", "Cameriera dai capelli rosa")
	novel_interface.change_expression("confident")
	await novel_interface.show_dialog("Ascolta! Come domestica, posso e farò qualsiasi cosa per il mio padrone. Nessuno può dubitarne.", "Cameriera dai capelli rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La ragazza con gli occhiali rossi fa improvvisamente davanti a me una solenne promessa.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Oh... va bene...", "Lian")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Comunque, grazie per avermi aiutato proprio ora... \\nOnestamente, non sapevo cosa fare dopo.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"normal")
	await novel_interface.show_dialog("Allora perché sei qui?", "Cameriera dai capelli rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La sua voce diventa improvvisamente fredda come il ghiaccio,\\ncandomi un brivido lungo la schiena.")
	novel_interface.character_light(0.35,"mock")
	await novel_interface.show_dialog("Se mi menti, ti brucio fino a ridurlo in un pezzo di coca.", "Cameriera dai capelli rosa")
	novel_interface.character_dark()
	await novel_interface.show_text_only("La ragazza scoppiò in una risata argentata mentre pronunciava queste parole intimidatorie, ma sono abbastanza sicuro che non stesse scherzando!")
	novel_interface.character_light()
	await novel_interface.show_dialog("Stai cercando di inventare qualcosa?", "Cameriera dai capelli rosa")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("(Dannazione. Sono stato beccato?) \\n(Chi diavolo è?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("fabiola_maid","confident")
	await novel_interface.show_dialog("So chi sei. \\nDopotutto...", "Cameriera dai capelli rosa")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("skuld","normal",0.25)
	await novel_interface.show_dialog("Fabella, non essere scortese.", "???")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Seguendo il suono, trovo una ragazza minuta con un favoloso abito da sera.")
	await novel_interface.show_text_only("I suoi capelli biondi lucenti arrivano fino alla vita raccolti in trecce e i suoi occhi sono luminosi e chiari come il cristallo.")
	await novel_interface.show_text_only("La presenza di una ragazza così elfica in questa occasione sfarzosa è come un piolo quadrato in un buco rotondo.")
	novel_interface.character_light(0.35,"panic")
	await novel_interface.show_dialog("Signorina Skurd! \\nMi dispiace tanto di averti disturbato.", "Fabella")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Feroce come un leone un attimo fa, la cameriera si trasforma in un gattino proprio nel momento in cui si presenta la bambina.")
	novel_interface.character_2nd_light(0.35,"think")
	await novel_interface.show_dialog("Guarda la povera ragazza. È troppo terrorizzata per dire una parola.", "Skuld")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Lasciala andare per ora, ok?", "Skuld")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Roger, quello!", "Fabella")

	print("=== 第3章第9话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
