# chapter3_ep10.gd - 第3章第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep10_script()

func play_script():
	pass

func chapter3_ep10_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/diningRoom2.png")
	await novel_interface.show_text_only("Благодаря Скурду, кажется, Fabella решает меня отпустить.")
	await novel_interface.show_text_only("Как только Скурд отворачивается, к ней подходят несколько хорошо одетых гостей и разговаривают.")
	await novel_interface.show_text_only("Девушка примерно того же возраста, что и Elluka, но она блистает на таком модном светском мероприятии…")
	novel_interface.show_character("ren_maid","worry")
	await novel_interface.show_dialog("(Skuld… Она из дворянской семьи?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Когда Fabella обращает внимание на своего хозяина, я прокрадываюсь на другую сторону банкетного зала.")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Это меня пугает… \\nМаленькая хозяйка и ее служанка, не так ли?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Кажется, горничная не собирается меня пригвоздить. \\nОна хотела только обмануть меня?")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Рен, ты здесь!", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Возможно, я наткнулся на важную подсказку!", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","normal2",0.25)
	await novel_interface.show_dialog("Э?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Только что я тайно проследовал за делегацией на руководящий этаж и там увидел свиту Raphael, несущую специальный чемодан.", "Annie")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("Чемодан… Что в нем?", "Lian")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Не знаю. Но я помню, что на тренинге SID упоминался материал, использованный в чемодане!", "Annie")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Это серовато-зеленый металл со своеобразным светло-голубым сиянием.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"solemn")
	await novel_interface.show_dialog("Голубое сияние… \\nЧто! Не правда ли…", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Я вспоминаю сплав, который уменьшает или устраняет эффекты психоактивных веществ и мемов Substance H…")
	await novel_interface.show_text_only("Контейнеры Substance H, изготовленные из этого сплава, могут ускользнуть от сканирования большинства цветов.")
	await novel_interface.show_text_only("Сам сплав представляет собой Substance H: 98% его составляют известные металлы, а остальные 2% — неизвестное вещество.")
	await novel_interface.show_text_only("Из-за его редкости цена на черном рынке взлетела до небес.")
	await novel_interface.show_text_only("Я почти уверен, что все, что находится в этом чемодане, имеет какое-то отношение к Substance H.")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("Святое дерьмо! \\nВы сообщили об этом Mariru?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Делегация Salmonton не сообщила Сенату, что они привезут с собой какие-либо Substance H.")
	await novel_interface.show_text_only("Любой разрушительный Substance H, тайно проникший в защитное силовое поле, может привести к катастрофе для New Opulentia.")
	novel_interface.show_character("anne_uniform","relieve")
	await novel_interface.show_dialog("Я ей сразу сказал. Должно быть, она сейчас подает в Сенат ордер на обыск.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Но я просто увидел это с первого взгляда и не сделал никаких фотографий. \\nЯ не думаю, что они смогут ворваться в комнату без каких-либо дополнительных улик…", "Annie")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Вот почему Mariru только что обновил нашу миссию: «Защитить и загрузить доказательства как можно скорее».", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_maid","solemn",0.25)
	await novel_interface.show_dialog("Если так, то единственный шанс — пробраться в их комнаты…", "Lian")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да… комната девушки. Непростая задача.", "Annie")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"stare")
	await novel_interface.show_dialog("Хм… Теперь нам придется играть на слух.", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomPassage.png")
	await novel_interface.show_text_only("Представительский этаж отведен для делегаций. Туда мы прибываем через служебный лифт.")
	await novel_interface.show_text_only("Я толкаю «одолженную» сервировочную тележку в сторону тщательно охраняемого коридора. Под ним прячется Annie…")
	await novel_interface.show_dialog("Эй! Разве ты не должен быть на банкете внизу? \\nВам здесь запрещено. Уходите сейчас.", "Безопасность")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("(Конечно, так много охранников…)", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("А? Но гостья из Королевского люкса только что заказала в номер фуа-гра с пылающим виски!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Лидер совершенно не выглядит впечатленным.")
	await novel_interface.show_text_only("Очевидно, я его недооценил. Надо искать другой путь…")
	novel_interface.show_character("ren_maid","wry_smile")
	await novel_interface.show_dialog("Э-э… Возможно, Служба поддержки номеров допустила ошибку. Мои извинения, сэр…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Едва я закончил говорить, как Annie выбегает и бьет его по шее бейсбольной битой.")
	await novel_interface.show_text_only("Затем она разворачивается и швыряет бейсбольный мяч прямо в лицо другому охраннику, находящемуся в 10 ярдах от нее.")
	await novel_interface.show_text_only("Оставшийся охранник ошеломлен атакой. Прежде чем он успел дотянуться до своего трансивера, Annie пинает его прямо в подбородок.")
	await novel_interface.show_text_only("Трое мужчин падают почти одновременно. Бита подпрыгивает на полу и прыгает обратно в руку Annie.")
	novel_interface.show_character("ren_maid","wry_smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Ясно!", "Annie")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"perspire1")
	await novel_interface.show_dialog("Что... Что ты сделал?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ничего. Просто дайте им немного отдохнуть.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","perspire1")
	await novel_interface.show_dialog("Хаха, это так Annie… \\n(Слава богу, я с ней…)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("И она даже не использовала никакой магии! \\nКакое обучение она проходит…")
	await novel_interface.show_text_only("Убрав охранников с дороги, Annie отводит меня в двухдверный номер в конце коридора.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Здесь.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Мы обмениваемся взглядами. \\nКак раз в тот момент, когда мы собираемся прижать уши к двери…")
	await novel_interface.show_text_only("Он внезапно открывается изнутри. Мы застигнуты врасплох и падаем на пол внутри комнаты.")
	await novel_interface.hide_background()
	novel_interface.show_character("ren_maid","sob")
	await novel_interface.show_dialog("Оуууу…", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Подняв глаза, я вижу знакомое высокомерное лицо.")
	novel_interface.change_background("res://assets/images/bg/SkyHotel/guestRoomInner.png")
	novel_interface.show_character("ren_maid","panic")
	await novel_interface.show_dialog("… Raphael?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Raphael окружена несколькими телохранителями и свитой, на ее лице написано презрение.")
	await novel_interface.show_text_only("Ух ты, сколько зрелых и красивых женщин!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Хм? Разве ты не тот урод, переодевающийся в другую одежду, из этой школьной помойки? Что ты здесь делаешь?", "Raphael")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("В нарядах французской горничной! Ты не чувствуешь себя достаточно извращенным?", "Raphael")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_maid","wail")
	await novel_interface.show_dialog("Ч… какое совпадение! \\nЯ просто подрабатываю здесь со своим одноклассником…", "Lian")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Да, и… банкетный зал внизу, да? \\nВозможно, мы пришли не туда.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Извини, Annie, я плохо умею врать!")
	novel_interface.show_character("raphael","stare")
	await novel_interface.show_dialog("Это странно. Вас не остановила охрана?", "Raphael")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В замешательстве Raphael смотрит в коридор.")
	await novel_interface.show_text_only("Raphael приходит в ужас, когда обнаруживает, что охранники лежат на полу без сознания.")
	novel_interface.show_character("raphael","perspire")
	await novel_interface.show_dialog("— Ловите их!", "Raphael")

	print("=== 第3章第10话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
