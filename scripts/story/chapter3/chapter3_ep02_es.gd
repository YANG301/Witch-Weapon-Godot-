# chapter3_ep02.gd - 第三章第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter3_ep02_script()

func play_script():
	pass

func chapter3_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Los registros de SID muestran que el Centro Akatraz recopila la clase EX Substance H cuya prueba e investigación está prohibida por el Congreso Unido.")
	await novel_interface.show_text_only("Debajo del terreno del Centro, está conectado a la entrada de una antigua casa-cueva Chate reliquia a la que se le prohíbe ingresar y ni siquiera se puede calificar.")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Clase EX Substance H… ¿Es algún tipo de material altamente peligroso?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform2","normal1",0.25)
	await novel_interface.show_dialog("La mayoría de ellos son objetos sagrados de importancia religiosa. Como son especiales para los seguidores religiosos, se pueden recopilar, pero está prohibida la investigación.", "Mariru")
	novel_interface.character_light(0.35,"perspire1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Suena a autoengaño.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Jaja, sentí lo mismo. \\nPero tiene sentido en cierto modo.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Se dice que algunos artefactos de la tradición religiosa poseen poder para matar dioses o desencadenar el Juicio Final.", "Mariru")
	await novel_interface.show_dialog("Una vez activados, podrían causar una catástrofe a escala apocalíptica.", "Mariru")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eso es malo.", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Aunque algunos elementos reverenciados en las historias religiosas resultaron más tarde ser débiles o incluso vergonzosamente ineficaces.", "Mariru")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Algo tonto?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speak2")
	await novel_interface.show_dialog("Bien, un ejemplo es este par de zapatos sagrados. Quien besa la punta del zapato no puede resistirse a rayar: qué vergüenza para la religión.", "Mariru")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Eso es repugnante. \\nEntonces. ¿A qué tipo pertenece este que falta?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("Es el Destiny Spear, un Substance H clase EX bajo la custodia conjunta de todas las ciudades academia.", "Mariru")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"smile")
	await novel_interface.show_dialog("Ah. \\nYa veo, suena bien.", "Lian")
	await novel_interface.show_dialog("¿Qué es exactamente Destiny Spear entonces?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("…", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Pareces un completo idiota en este momento.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","sob",0.25)
	await novel_interface.show_dialog("¡Oye, realmente no tengo idea! \\nSolo soy un estudiante de secundaria.", "Lian")
	novel_interface.character_2nd_dark()
	await novel_interface.show_text_only("Mariru me mira impotente, como si se preguntara por dónde empezar conmigo.")
	novel_interface.character_light()
	await novel_interface.show_dialog("En pocas palabras, es el primer tipo de Substance H, que se cree que tiene poderes deicidas.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Se encuentra muy poca descripción del Destiny Spear en la literatura disponible públicamente, excepto que \"no se derrite a altas temperaturas\" y que \"gana peso cuando se balancea\".", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("¿Eso es todo?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Si profundiza, encontrará que cualquiera de los rasgos lo convertirá en un Substance H de clase XK.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Puede haber otros rasgos peligrosos y desconocidos. Por eso no deberían llamar demasiado la atención de los medios.", "Mariru")
	novel_interface.character_dark()
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	await novel_interface.show_text_only("Esto me pone la piel de gallina. Incluso los niños pequeños saben qué es un Substance H clase XK...")
	await novel_interface.show_text_only("Conduciría a un desastre apocalíptico o crearía otro Substance H con el mismo poder. Actualmente sólo se conocen seis objetos de este tipo en todo el mundo.")
	await novel_interface.show_text_only("Cada uno de ellos pertenece a una de las seis Ciudades Academia. Más precisamente, solo aquellos en posesión de dicho Substance H son reconocidos por el Congreso Unido.")
	novel_interface.character_2nd_light(0.35,"perspire1")
	await novel_interface.show_dialog("¿Eh? \\n¿Qué significa ...?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Ahora sabes qué delito grave has cometido “tú”?", "Mariru")
	novel_interface.character_dark()
	await novel_interface.show_text_only("Estoy tan impactada que todo me parece surrealista.")
	novel_interface.character_2nd_light(0.35,"sob")
	await novel_interface.show_dialog("… Lo siento. \\n¡No! ¿Por qué dije lo siento? ¡Yo no soy el ladrón!", "Lian")
	await novel_interface.show_dialog("(Mierda. ¡Ese tipo debe ser súper peligroso!)", "Lian")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Pero por suerte la noticia fue eliminada.", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lo hicieron sólo para evitar el pánico público.\\nLa investigación continuaría en secreto.", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Por razones de confidencialidad, la notificación de búsqueda no se enviará al Ministerio de Defensa. Pero todos los servicios de inteligencia, incluido SID, ya deberían haber sido notificados.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Así que todavía es pronto para sentirte aliviado, Ren.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("Cierto… el viejo yo todavía está en peligro, ¿verdad?", "Lian")
	novel_interface.change_2nd_expression("perspire1")
	await novel_interface.show_dialog("¿Qué pasa si… quiero decir, qué pasa si… \\n…alguien me localiza…", "Lian")
	await novel_interface.show_dialog("Incluso si ahora fuera una niña, probablemente me podrían encerrar, ¿verdad?", "Lian")
	novel_interface.character_light(0.35,"speak2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Finalmente lo entendiste.", "Mariru")
	await novel_interface.show_dialog("El servicio de inteligencia revisó todas las imágenes de CCTV disponibles y descubrió que el tipo apareció en otras áreas de flujo, todavía con su antigua cara.", "Mariru")
	await novel_interface.show_dialog("Dado que podemos recuperar los datos de una fuente de terceros, es probable que otros servicios de inteligencia también tengan esta información.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.character_2nd_move_right(0,0.3,true,"panic")
	await novel_interface.show_dialog("¿Ya es reincidente? \\nMi futuro parece sombrío ...", "Lian")
	await novel_interface.hide_2nd_character()
	await novel_interface.show_text_only("Me imagino torturado en interminables interrogatorios…")
	await novel_interface.show_text_only("Siento que en cualquier momento me arrestarán y me etiquetarán como un criminal contra la humanidad.")
	await novel_interface.show_text_only("Lo encerraron en la prisión más brutal y lo sentenciaron a más de 200 años de cárcel.")
	await novel_interface.show_text_only("Podría tener un compañero de celda extremadamente peligroso, y él...")
	await novel_interface.show_text_only("¡Guau, basta! \\n¡No pienses más!")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Jajaja. Estás tan asustado y te ves tan pálido.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Tómatelo con calma, Ren. Puedo asegurarte un 98% de seguridad siempre que estés en New Opulentia.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","panic",0.25)
	await novel_interface.show_dialog("¿Entonces todavía tengo un 2% de posibilidades de que me arresten?", "Lian")
	await novel_interface.show_dialog("(¡Dos segundos de incertidumbre por cada cien segundos!) \\n(¡Eso no es nada seguro!)", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Que esos viejos perros del Congreso Unido hayan llegado a un consenso en tan poco tiempo… Algo no está bien.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Y este es el factor desconocido del 2% del que estaba hablando.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"upset")
	await novel_interface.show_dialog("No puedo imaginar el revuelo que ha causado entre esos peces gordos...", "Lian")
	novel_interface.character_light(0.35,"normal2")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Entonces, los servicios de inteligencia de otras Ciudades Academia deben haber usado muchos recursos para cazar al ladrón.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Q... qué debo hacer?", "Lian")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak2")
	await novel_interface.show_dialog("Siempre es fácil lidiar con un enemigo visible. Dejémoslo en SID.", "Mariru")

	print("=== 第三章第2话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
