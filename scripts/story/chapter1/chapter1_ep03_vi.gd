# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Chốt gác bên này vẫn chưa có hồi âm, cậu qua đó kiểm tra thử——", "Giọng nam A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Rõ!", "Giọng nam B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Tôi đi lấy máy dò nhịp tim, cậu canh chừng đi!", "Giọng nam A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Chết rồi, trốn ở đây thì không thoát nổi……",GameConfig.player_name)
	await novel_interface.show_dialog("Tầm nhìn của bọn chúng không có góc chết để mình lẻn qua. Cơ hội duy nhất là lúc chúng tách ra rồi đánh lén một tên",GameConfig.player_name)
	await novel_interface.show_dialog("Chắc ổn thôi nhỉ……\nĐến cả người phụ nữ đó còn tay không hạ được đối phương mà……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Phải tìm thứ gì đó làm vũ khí……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trên tường hành lang treo một cây gậy bóng chày bằng kim loại, dòng chữ nhỏ trên bảng tên phía dưới ghi 'Laibona - Ánh sáng Tự do……'")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Chắc là đồ trưng bày thôi mà……\nMượn tạm một chút thôi, ừm ừm, chỉ mượn tạm thôi……",GameConfig.player_name)
	await novel_interface.show_dialog("……\n……",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Vậy thì…… xông lên!\nHa——!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("RẦM!!!")
	await novel_interface.show_text_only("Tôi dốc toàn lực nện một cú vào sau gáy tên bịt mặt, phát ra một tiếng cực lớn. Hả…… âm thanh lại lớn đến thế sao?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Nhưng đối phương không hề ngã xuống như tôi mong đợi, mà quay phắt người lại với lửa giận bừng lên trong mắt.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Khác game hoàn toàn mà!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Ai đó!", "Kẻ bịt mặt A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("Gã bịt mặt nhanh chóng vung báng súng đánh tới, tôi cuống quýt siết chặt cây gậy để đỡ.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Không ổn——",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("Sức mạnh áp đảo của đối phương truyền dọc theo cây gậy đè lên hai tay và vai tôi. Đúng lúc tôi còn đang nghiến răng chống đỡ, tên bịt mặt bất ngờ tung ra một cú đá.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("Cú đá giáng thẳng vào bụng tôi khi tôi hoàn toàn không phòng bị.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Bị đá trúng, tôi văng ra ngoài, làm gãy lan can rồi rơi thẳng xuống tầng\ndưới.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("A!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Khốn kiếp, thằng nhóc đánh lén tao rơi xuống lầu dưới rồi.\nTao đi giết nó!", "Kẻ bịt mặt A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("……Mình phải mau trốn……\n……phải nấp vào… cái bóng của… món trưng bày đó……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Khoan đã… đội trưởng vừa gửi thông báo, thiết bị chống trộm tự hủy đã được gỡ thành công rồi", "Kẻ bịt mặt B")
	await novel_interface.show_dialog("Đừng lãng phí thời gian nữa, mau tập hợp ở hội trường đi!\nLúc nó tỉnh lại thì bọn ta rút lâu rồi.", "Kẻ bịt mặt B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Rõ!", "Kẻ bịt mặt A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("Ý thức…… đang dần…… mờ đi rồi\nLiliu……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cùng lúc đó, tại hội trường")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Xem ra đám này đã trà trộn vào nhờ ngụy trang quang học……","Liliu")
	await novel_interface.show_dialog("Chúng còn lợi dụng đúng lúc hệ thống dò phản quang học của khu giam giữ đang bảo trì một phần…… xem ra bên trong có kẻ làm rò rỉ tin tức rồi.","Liliu")
	await novel_interface.show_dialog("Vẫn chưa rõ bọn chúng thuộc phe nào…… chỉ có thể chờ thời cơ thôi.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Hừ hừ hừ ha ha——","Thủ lĩnh bịt mặt")
	await novel_interface.show_dialog("Cuối cùng chúng ta cũng lấy lại được……!", "Thủ lĩnh bịt mặt")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Đó là——『Chén Vàng Los』!?","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("『Vật dị chất』 được đoàn khảo sát tìm thấy trên quần đảo Los bất ngờ xuất hiện giữa Thái Bình Dương, bên ngoài chiếc chén được nạm bốn viên bảo thạch.")
	await novel_interface.show_text_only("Bên trong chén có một chất lỏng màu đỏ, nhưng thứ đó vừa không thể đổ ra ngoài, vừa không thể chạm vào. Nó cứ như ảo ảnh, dường như hoàn toàn không có thực thể……")
	await novel_interface.show_text_only("Mấy lão già trong viện nghiên cứu đã thử đủ mọi cách mà vẫn không hiểu rốt cuộc đó là thứ gì……")
	await novel_interface.show_text_only("Sau một thời gian, người ta hạ mức độ đe dọa của nó xuống 『Safe』\ncho phép tiến hành nghiên cứu công khai……")
	await novel_interface.show_dialog("Chậc, xem ra cũng chỉ còn mấy viên đá quý kia là đáng tiền.","Liliu")
	await novel_interface.show_dialog("Nhưng ở cấp độ phân tử, đá quý và thân chén đã hòa làm một……","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Chính tay ta sẽ tách chúng ra, hỡi vật ô uế này!!", "Thủ lĩnh bịt mặt")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Tách ra? Sao có thể được——","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
