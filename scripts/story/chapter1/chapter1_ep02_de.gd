# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("Anmeldung erfolgreich!","System")
	await novel_interface.show_dialog("Ihre ID: 2519G1911\nName: "+GameConfig.player_name,"System")
	await novel_interface.show_dialog("Alter: 15 Jahre\nGeschlecht: Männlich","System")
	await novel_interface.show_dialog("Willkommen im Steelemont-Eindämmungs- und Forschungszentrum der Fünften Akademiestadt, der größten Einrichtung zur Eindämmung und Erforschung von „Anomalobjekten“ in ganz Xinfengzhou.","System")
	await novel_interface.show_dialog("„Anomalobjekte“, auch „Wunder“ genannt, sind der Sammelbegriff für Gegenstände und Werkzeuge, die unter bestimmten Umständen übernatürliche physikalische Phänomene auslösen können.","System")
	await novel_interface.show_dialog("Heute ist Tag der offenen Akademie im Forschungszentrum.\nDas Zentrum ist für Bürger und Besuchergruppen aus anderen Akademiestädten geöffnet.","System")
	await novel_interface.show_dialog("Als wichtiger Teil der öffentlichen Aufklärung\nwerden einige „Wunder“ und Forschungsergebnisse ausgestellt...","System")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("Lucky!~ Gerade noch rechtzeitig vor der Schließung angekommen!",GameConfig.player_name)
	await novel_interface.show_dialog("Die Aufzüge in der Lobby sind tatsächlich alle außer Betrieb. Zum Glück habe ich noch diesen funktionierenden Lastenaufzug gefunden.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Also gut, ich muss mir nach dem Vortrag doch nur noch einen Stempel holen, dann gibt's die Credits, oder?",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Aber... warum ist auf dieser Etage denn kein Mensch zu sehen?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich ging den Flur im zweiten Stock entlang und ließ den Blick ständig umherschweifen.")
	await novel_interface.show_text_only("An so einem Ort ist zwar sonst schon kaum etwas los, aber jetzt ist nicht einmal eine Menschenseele zu sehen.")
	await novel_interface.show_text_only("Außerdem liegt dieser Geruch nach Krankenhausdesinfektion in der Luft. Unwillkürlich denke ich an Reinigungskräfte, die nach Schließung sauber machen.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("Der Vortrag ist doch wohl nicht schon vorbei?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während ich nach dem „Konferenzsaal“ des Vortrags suchte, bog ich an einer Wendeltreppe ab.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Verdammt, verdammt, ich hätte dieses Spiel wirklich nicht spielen sollen...",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Dieser „Nächste Runde“-Button ist echt pures Gift — aaaaah, ngh\n!!!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Plötzlich hakte sich etwas um meinen Hals und riss mich ruckartig nach hinten!")
	await novel_interface.show_text_only("Gerade als ich das Gleichgewicht verlor, spürte ich, wie mein Hinterkopf gegen etwas Weiches und zugleich Festes gedrückt wurde.")
	await novel_interface.show_text_only("Als ich wieder zu mir kam, war ich bereits in einen schmalen Gang an der Treppenecke gezerrt worden, wo es deutlich dunkler war.")
	await novel_interface.show_dialog("Mmph—!!\nNngh—!!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Noch bevor ich schreien konnte, presste mir eine Hand fest den Mund zu. Im Augenwinkel erkannte ich nur eine Frau in einem weißen Laborkittel —")
	await novel_interface.show_text_only("Sie lehnte mit dem Rücken an der Wand und hielt mir mit einer Hand den Mund zu.")
	await novel_interface.show_text_only("Eine Seite meines Gesichts war fest an ihre Brust gedrückt... und ihr betörender Duft stieg mir unaufhörlich in die Nase.")
	await novel_interface.show_dialog("(Hä?? So-so groß!!!! Mein Gesicht steckt da drin!!)",GameConfig.player_name)
	await novel_interface.show_dialog("(Was geht hier ab!? Wer ist diese Person!?)",GameConfig.player_name)
	await novel_interface.show_dialog("Psst—! Keinen Laut!", "Frau im Laborkittel")
	await novel_interface.show_text_only("Obwohl die Frau hinter mir ihre Stimme absichtlich senkte, lag in ihren Worten eine Autorität, die keinen Widerspruch duldete.")
	await novel_interface.show_text_only("Mein Kopf war völlig durcheinander, ich bekam kaum Luft\nund konnte nur leicht nicken, um zu zeigen, dass ich gehorchte...")
	await novel_interface.show_text_only("Mein Mund war zwar noch immer zugehalten, aber der Druck an meinem Hals ließ ein\nwenig nach.")
	await novel_interface.show_text_only("Als ich meinen Blick nach vorn fokussierte, erkannte ich undeutlich auf dem Namensschild an ihrem Kittel eine kleine Zeile: Chefwissenschaftlerin...")
	await novel_interface.show_dialog("(Wissenschaftlerin... gehört sie zum Personal des Instituts?)",GameConfig.player_name)
	await novel_interface.show_text_only("Erst da bemerkte ich, dass sie mich gar nicht ansah, sondern den Kopf zur\nanderen Seite gedreht hatte und konzentriert den Flur beobachtete.")
	await novel_interface.show_text_only("Aus der Ferne kamen hastige, kraftvolle Schritte den Flur entlang.")
	await novel_interface.show_dialog("Bericht, hier ist niemand.", "Männliche Stimme A")
	await novel_interface.show_dialog("Aber es gibt tatsächlich einen separaten Lastenaufzug. Ich schalte ihn manuell ab.", "Männliche Stimme A")
	await novel_interface.show_dialog("(Und die Person, die eben vorbeigerannt ist, hatte offenbar eine Maske auf und sogar eine... Waffe?)",GameConfig.player_name)
	await novel_interface.show_dialog("Hier sind Eindringlinge unterwegs. Wenn du leben willst, rühr dich nicht.", "Frau im Laborkittel")
	await novel_interface.show_dialog("(E-Eindringlinge? Was ist hier bloß los...)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Während ich noch wie erstarrt dastand, huschte die Frau bereits hinaus.")
	await novel_interface.show_text_only("Ein paar Sekunden später hörte ich einen dumpfen Schlag und etwas, das wie brechende Knochen klang.")
	await novel_interface.show_text_only("Ein Aufprall auf den Boden blieb aus. Stattdessen fing sie den maskierten Mann von hinten auf, zog ihn in den Gang zurück und nahm ihm eine Pistole ab.")
	await novel_interface.show_dialog("Der ist...?!",GameConfig.player_name)
	await novel_interface.show_text_only("Die Frau reagierte gar nicht auf mich, sondern öffnete routiniert die Tür zum Sicherungsraum an der Wand\nund trat den schlaffen Hühnen mit einem Schwung ihres High Heels hinein.")
	await novel_interface.show_text_only("Obwohl sie nur ein weißes Hemd und einen engen Rock trug, war jede ihrer Bewegungen schnell und präzise.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hm~ Vorläufig sollte hier niemand mehr auftauchen.", "Frau im Laborkittel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sie klopfte sich die Hände ab, als hätte sie gerade lediglich ein großes Stück Müll entsorgt, und sah dann gelassen zu mir zurück.")
	await novel_interface.show_text_only("Mein Gehirn konnte das, was gerade passiert war, einfach nicht verarbeiten. Ich konnte sie nur dumm anstarren.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(Wenn ich genauer hinsehe, ist diese große Schwester echt hübsch!)\n(Und ihre Figur ist auch fast wie bei einem Model...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(Aber auf dem Schild an ihrer Brust steht doch eindeutig „Wissenschaftlerin“.)",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Also war das eben bestimmt nur eine Halluzination!)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ganz genau. Im Sicherungsraum liegt selbstverständlich kein maskierter Hüne.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("Vollkommen beruhigt zog ich daraus diesen Schluss und ließ meinen Blick zu ihren Beinen wandern...")
	await novel_interface.show_text_only("(Mit so einer großen Schwester zusammenarbeiten zu dürfen, wäre echt traumhaft...)\n(Anomalobjekt-Forscher zu werden ist wohl auch kein schlechter Beruf.)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Na? Kleiner, wo schaust du denn hin?", "Frau im Laborkittel")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Während sie sprach, nahm sie das Magazin aus der Pistole und prüfte die Munition.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(Hör auf, dich selbst zu belügen!!!)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("H-Hallo...\nSie sind... ?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Na ja... du kannst mich einfach Liliu nennen.\nEigentlich sollte ich heute einen langweiligen Vortrag halten.", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mit geübten Handgriffen setzte sie die Pistole wieder zusammen und steckte sie in die Tasche ihres Laborkittels zurück.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Aber diese Typen haben gerade den Konferenzsaal gekapert.\nDank ihnen ist der Vortrag abgesagt~", "Liliu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("Liliu... Liliu von Braun?!",GameConfig.player_name)
	await novel_interface.show_dialog("S-Sie sind doch die Rednerin von dem Vortrag, für den ich den Stempel brauche!\nUnd eine vom Senat anerkannte SS-Klasse-Wissenschaftlerin!",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh, diese alten Herren sind leicht hinters Licht zu führen~", "Liliu")
	await novel_interface.show_dialog("Aber deinem Gesicht nach bist du doch nur hier, um Credits abzugreifen, oder?", "Liliu")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Uff... Es tut mir wirklich leid!!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("Soll ich dich nun Pechvogel oder Trottel nennen? Dass du ausgerechnet im Lockdown den Aufzug nach oben findest, muss man auch erst mal schaffen.", "Liliu")
	await novel_interface.show_dialog("Wenn ich dich ignoriert hätte, wärst du wahrscheinlich direkt in die Geiselnahme im „Konferenzsaal“ hineingelaufen.", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lockdown...?\nIch zog mein Handy heraus, und tatsächlich hatte ich überhaupt keinen Empfang.")
	await novel_interface.show_text_only("Jetzt verstand ich endlich, warum die Aufzüge vorne in der Lobby alle stillstanden... Das lag also gar nicht an der Schließung!")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Der Aufzug, mit dem du hochgekommen bist, ist inzwischen ebenfalls versiegelt. Also bleib schön hier und warte auf die Rettung durch das Verteidigungsamt.", "Liliu")
	await novel_interface.show_dialog("Ich muss mir im Konferenzsaal die Lage ansehen. Wenn jemand kommt, versteckst du dich.", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("A-Aber... Sie ganz allein...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Hast du verstanden?!", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Verstanden!!",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
