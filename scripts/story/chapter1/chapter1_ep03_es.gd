# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("El puesto de vigilancia de este lado lleva un rato sin responder; ve a comprobarlo—", "Voz masculina A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("¡Sí!", "Voz masculina B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Voy a buscar el detector de latidos. ¡Mantén los ojos abiertos aquí!", "Voz masculina A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Mierda, aquí no voy a poder esconderme...",GameConfig.player_name)
	await novel_interface.show_dialog("Su campo de visión no deja ningún ángulo muerto por donde escapar; mi única oportunidad es atacar por sorpresa a uno cuando se separen.",GameConfig.player_name)
	await novel_interface.show_dialog("Supongo que podré hacerlo...\nSi aquella mujer fue capaz de derribarlo con las manos vacías...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Necesito encontrar algo que pueda usar como arma...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En la pared del pasillo colgaba un bate metálico. En la pequeña placa que había debajo ponía: «Laebona, Luz de la Libertad...»")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Debe de ser una pieza de exposición...\nSolo lo estoy tomando prestado un momento, sí, solo un momento...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Entonces... ¡allá voy!\n¡Hah—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("¡¡¡PUM!!!")
	await novel_interface.show_text_only("Le asesté con todas mis fuerzas un golpe en la nuca al enmascarado, y el estruendo fue brutal. ¿Eh...? ¿De verdad hacía tanto ruido?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Pero, en vez de caer como yo esperaba, se giró hacia mí con furia en los ojos.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("¡¡Esto no pasa así en los juegos!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("¡¿Quién va ahí?!", "Enmascarado A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("El enmascarado blandió rápidamente la culata del arma y arremetió contra mí; yo apreté el bate y me defendí como pude.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("No puede ser—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("La fuerza aplastante del otro se transmitió a mis manos y hombros a través del bate. Mientras resistía apretando los dientes, el enmascarado soltó de pronto una patada.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("El pie se estrelló con violencia contra mi abdomen indefenso.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Salí despedido, rompí la barandilla y me precipité al piso inferior.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("¡¡¡¡¡¡Aaaaaah!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Joder, el mocoso que me atacó por la espalda se ha caído al piso de abajo.\n¡Voy a rematarlo!", "Enmascarado A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...Tengo que huir...\n...tengo que esconderme... en la sombra... de esa exhibición...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Espera... acaba de llegar un aviso del capitán: han desactivado con éxito el sistema antirrobo autodestructivo.", "Enmascarado B")
	await novel_interface.show_dialog("No pierdas el tiempo; reúnete ahora mismo en la sala de conferencias.\nPara cuando despierte, nosotros ya nos habremos largado.", "Enmascarado B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("¡Sí!", "Enmascarado A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("La conciencia... se me... apaga...\nLiliu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras tanto, en la sala de conferencias")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Parece que este grupo se infiltró usando camuflaje óptico...","Liliu")
	await novel_interface.show_dialog("Y justo aprovecharon que el sistema anti-camuflaje óptico del centro estaba parcialmente en mantenimiento... Parece que alguien de dentro filtró la información.","Liliu")
	await novel_interface.show_dialog("Aún no sé quiénes son... Tendré que esperar una oportunidad.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Je, je, je... ¡jajaja—!","Líder enmascarado")
	await novel_interface.show_dialog("¡Por fin lo hemos recuperado...!", "Líder enmascarado")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("¡¿Eso es... el «Cáliz de Los»?!","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("Un «objeto heterogéneo» hallado por una expedición en las islas Los, aparecidas de repente en medio del Pacífico. El cáliz tiene cuatro gemas incrustadas en el exterior.")
	await novel_interface.show_text_only("Dentro del cáliz hay una sustancia rojiza parecida a un líquido, pero no puede verterse ni tocarse; como un fantasma, parece carecer de cuerpo físico...")
	await novel_interface.show_text_only("Los viejos del laboratorio agotaron toda clase de métodos y aun así no lograron averiguar qué era...")
	await novel_interface.show_text_only("Después de un tiempo rebajaron su nivel de amenaza a «Safe»\ny autorizaron su investigación pública...")
	await novel_interface.show_dialog("Tch, al final parece que lo único valioso son esas piedras.","Liliu")
	await novel_interface.show_dialog("Pero las gemas y el cáliz están fusionados a nivel molecular...","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("¡Entonces seré yo quien las separe de este objeto impuro!", "Líder enmascarado")
	novel_interface.character_dark()
	await novel_interface.show_dialog("¿Separarlas? ¿Cómo sería posible—","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
