# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("... Ufa... haa... mesmo sem entender o que está acontecendo\nisso conta como vitória...?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("... Parece que sim.","Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Afinal, quem é você!?\nDe onde apareceu!?",GameConfig.player_name)
	await novel_interface.show_dialog("O que eram aquelas coisas que estavam me atacando!?\nE o que é esse taco!?",GameConfig.player_name)
	await novel_interface.show_dialog("O que aconteceu aqui?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Calma!\nVou responder suas perguntas uma por uma, dentro do que eu souber.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Mas eu também não entendo a situação.\nNa verdade, eu também queria saber quem você é...", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Desculpa. Eu entrei em pânico...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Não tem problema.\nAliás, ainda nem nos apresentamos direito.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Meu nome é Annie Bass.\nPode me chamar só de Annie~", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Eu me chamo "+GameConfig.player_name+", prazer.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"... digo o mesmo.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Seu nome parece nome de menino. É tão legal~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("！？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("O que foi? Por que essa cara de surpresa?","Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, é mesmo, eu agora...\nsou uma garota...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ué? Mas você é uma garota.\nOlha só: a roupa que eu preparei ficou certinha em você, não ficou?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Ficou muito fofa, muito fofa...\nConsidere este 『traje de combate』 um presente de boas-vindas meu~", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Traje de combate?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Aaah— aaaaaaaaaah!!!!!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Só quando me dei conta percebi que\nestava usando roupas de garota!!")
	await novel_interface.show_text_only("Um uniforme de marinheira...\nE uma saia tão curta que dá vergonha...!")
	await novel_interface.show_text_only("Então é essa a sensação estranha de usar meias nas pernas...?")
	await novel_interface.show_dialog("E essa sensação de aperto no peito não pode ser... (tocando)",GameConfig.player_name)
	await novel_interface.show_dialog("Aaaaaahhhh!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("O casaco também combina muito com a cor do seu cabelo~\nÉ um modelo ótimo para se movimentar.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Hm...? O que foi~~?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("É que...\nÉ que...",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
