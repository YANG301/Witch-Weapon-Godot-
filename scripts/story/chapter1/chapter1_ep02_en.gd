# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("Login Successful!","System Voice")
	await novel_interface.show_dialog("ID: 2519G1911\n Name: [%rolename%]"+GameConfig.player_name,"System Voice")
	await novel_interface.show_dialog("Age: 15\n Gender: Male","System Voice")
	await novel_interface.show_dialog("Welcome to the Steele Monte Containment and Research Center of the Fifth Academy City—the largest Substance H containment and research facility in New Opulentia.","System Voice")
	await novel_interface.show_dialog("Substance H, a.k.a. the Divine Touch, is a general term for items and tools that activate supernatural phenomena at certain conditions.","System Voice")
	await novel_interface.show_dialog("Today is the Academy Open Day at the research center.\nThe facility is open to citizens and delegations from other Academy Cities.","System Voice")
	await novel_interface.show_dialog("As part of its public education program,\nsome of the \"miracles\" and the center's research achievements are on display...","System Voice")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("Lucky! Finally here before the closing time!",GameConfig.player_name)
	await novel_interface.show_dialog("Why are all elevators in the lobby out of service? Luckily this freight elevator is still running.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Anyway, just need a stamp on the lecture paper to get school credits.",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Wait… why is there no one on this floor?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I walk along the corridor on the second floor and look around.")
	await novel_interface.show_text_only("Granted, places like this usually aren't crowded—but right now there isn't a single soul in sight.")
	await novel_interface.show_text_only("And there's this faint smell of hospital disinfectant in the air. It makes me think of the cleaning staff who come in after closing.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("Don't tell me the lecture's already over...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I was looking for the lecture hall when I turned the corner by a spiral staircase.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("It sucks. Shouldn't play the video game… ",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("That \"One More Round\" button is pure poison—aaah, ngh—\n!!!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Suddenly my neck feels like being clutched by something and pulled backwards.")
	await novel_interface.show_text_only("As I'm about to lose balance, I feel my head falls on something soft but firm.")
	await novel_interface.show_text_only("When I come back to myself, I find myself dragged into a dark, narrow aisle at the corner of the staircase.")
	await novel_interface.show_dialog("Mmph—!!\nNnngh—!!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Before I could cry out, a hand clamped firmly over my mouth. All I could see from the corner of my eye was a woman in a white lab coat—")
	await novel_interface.show_text_only("She had her back to the wall, one hand pressed over my mouth.")
	await novel_interface.show_text_only("My cheek pressed into her chest... I smell the fragrance on her.")
	await novel_interface.show_dialog("(Huh?? S-so soft!!!! My face is buried in it!!)",GameConfig.player_name)
	await novel_interface.show_dialog("(What is going on!? Who is this woman!?)",GameConfig.player_name)
	await novel_interface.show_dialog("Shh—! Not a sound.", "Woman in Lab Coat")
	await novel_interface.show_text_only("She keeps her voice down, but there’s still a sense of authority in it.")
	await novel_interface.show_text_only("I can't think straight. I'm suffocating. \n I can only nod slightly to show my obedience… ")
	await novel_interface.show_text_only("My mouth was still covered, but the pressure around my neck eased a little.")
	await novel_interface.show_text_only("I focused on what was right in front of me and made out a line of small print on the name tag pinned to her lab coat: Chief Scientist...")
	await novel_interface.show_dialog("(A scientist... Is she part of the institute staff?)",GameConfig.player_name)
	await novel_interface.show_text_only("That was when I realized she wasn't looking at me at all. Her head was turned toward the corridor, her eyes fixed in that direction.")
	await novel_interface.show_text_only("From far down the hall came a set of urgent, heavy footsteps.")
	await novel_interface.show_dialog("Report. Nobody here.", "Male Voice A")
	await novel_interface.show_dialog("But there is an independent freight elevator.\nI'll shut it down manually.", "Male Voice A")
	await novel_interface.show_dialog("(And the person who ran by just now seemed to be masked... and holding a... gun?)",GameConfig.player_name)
	await novel_interface.show_dialog("The place has been breached. If you want to live, don't move.", "Woman in Lab Coat")
	await novel_interface.show_dialog("(B-breached? What is happening here...?)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("While I was still frozen in place, the woman had already slipped out after them.")
	await novel_interface.show_text_only("A dull thud rang out a few seconds later, followed by a sound like bones snapping.")
	await novel_interface.show_text_only("There was no body hitting the floor. She caught the masked man from behind, dragged him back into the alcove, and stripped a pistol off him.")
	await novel_interface.show_dialog("That person is...?!",GameConfig.player_name)
	await novel_interface.show_text_only("Without even looking at me, she deftly opened the door to the electrical room by the wall and, with one kick of her high heel, sent the limp brute sprawling inside.")
	await novel_interface.show_text_only("Even in a white blouse and a tight skirt, every movement she made was crisp and efficient.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hmph~ No one should be coming this way for the moment.", "Woman in Lab Coat")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She dusted off her hands and turned back to me as casually as if she'd just taken out an oversized piece of trash.")
	await novel_interface.show_text_only("My brain couldn't process what I'd just seen. I could only stare at her.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(Now that I look at her closely, this woman is gorgeous!)\n(And she has the kind of figure you'd expect from a model...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(But the badge pinned to her lab coat clearly says \"Scientist.\")",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(So what just happened must have been a hallucination, right?)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("That's right—there was no masked giant inside the electrical room.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("I accepted that conclusion with startling ease... and my eyes drifted down to her legs.")
	await novel_interface.show_text_only("(It'd be amazing to work with a gorgeous lady like her...)\n(Maybe being a Substance H researcher isn't a bad career after all.)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hey, girl, what are you looking at, huh?", "Woman in Lab Coat")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As she spoke, she ejected the magazine and checked the rounds.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(Stop lying to yourself already!!!)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("H-hello.\nYou are...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Well... you can just call me Mariru.\nI was supposed to give a boring lecture today,", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("With practiced hands, she reassembled the pistol and slipped it back into the pocket of her lab coat.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("but those people hijacked the conference hall.\nThanks to them, the lecture's been cancelled~", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("Mariru... Mariru von Braun?!",GameConfig.player_name)
	await novel_interface.show_dialog("Y-you're the lecturer I came here to get stamped for!\nAnd an SS-ranked scientist certified by the Senate!",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Heh. Those old men are easy to fool~", "Mariru")
	await novel_interface.show_dialog("Though, judging by the look of you, you only came here to farm credits, right?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Uh... I'm terribly sorry!!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("Should I call you unlucky or just dumb? I can't believe you found the only elevator that still goes up during lockdown.", "Mariru")
	await novel_interface.show_dialog("If I'd left you alone, you'd probably have wandered straight into the hostage scene in the conference hall.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Lockdown...?\nI took out my phone. Sure enough, there wasn't a signal bar in sight.")
	await novel_interface.show_text_only("So that's why all the front-lobby elevators were shut down... This wasn't because the place had closed at all!")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("The elevator you took up here has already been sealed off too, so stay put and wait for the Defense Ministry to rescue you.", "Mariru")
	await novel_interface.show_dialog("I need to check what's happening in the conference hall. If anyone comes, hide.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("B-but... you're going alone...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Got it?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Yes, boss.",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# Call episode end function
	await novel_interface.end_story_episode(0.5)
