# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("(Я уже раз десять проверил это в ванной…)\n(Голова отказывается соображать…)",GameConfig.player_name)
	await novel_interface.show_dialog("(Я со всей силы ущипнул себя.)\n(Это точно не сон!)",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(И тело стало куда мягче.)\n(И на ощупь, между прочим, очень даже ничего…)",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Какое ещё «очень даже ничего»!!\nО чём я вообще думаю!!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Чёрт… ещё вчера эта футболка сидела как влитая,\nа теперь вдруг стала на мне такой огромной…",GameConfig.player_name)
	await novel_interface.show_dialog("То есть это не она выросла — это моё тело уменьшилось, да…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("В зеркале на меня смотрела миниатюрная девушка в одежде не по размеру — прямо как героиня фильма, напялившая рубашку своего парня…")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("…И почему я вообще краснею…",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Похоже…\nо том, что я стал девушкой, я никому рассказать не смогу…",GameConfig.player_name)
	await novel_interface.show_dialog("Я только что внимательно осмотрел комнату.\nЕдинственная странность — у кровати появилась металлическая бита.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Во сне вчера на исследовательский центр напали.\nЯ сражался этой битой…",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Если это вообще можно назвать сражением…",GameConfig.player_name)
	await novel_interface.show_dialog("А потом весь город рассыпался в прах…",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Точно, надо проверить телефон!\nЕсли это и правда было, новости об этом точно должны быть!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Никаких новостей о теракте или чём-то таком…",GameConfig.player_name)
	await novel_interface.show_dialog("Слава богу, значит, это всё-таки был просто сон…",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Э?.. А это ещё что——?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("«Кубок Лоса» внезапно исчез под строжайшим надзором.","Новости")
	await novel_interface.show_dialog("Прошлой ночью «Кубок Лоса» исчез из хранилища, несмотря на наблюдение двенадцати камер.","Новости")
	await novel_interface.show_dialog("Центр содержания и исследований «Стилмонт» оснащён строжайшей системой контроля и охраны, поэтому вероятность обычной кражи крайне мала…","Новости")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Чувствую… мне обязательно нужно ещё раз попасть в исследовательский центр!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("И про вчерашний сон, и про моё тело.\nПочему-то кажется, что если я пойду в исследовательский центр, то смогу хоть что-то понять.",GameConfig.player_name)
	await novel_interface.show_dialog("Ладно! Выдвигаюсь!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("Кстати…\nвыгляжу я сейчас, наверное, крайне подозрительно…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Увидев своё отражение в стекле у входа в здание, я всё же почувствовал сожаление.")
	await novel_interface.show_text_only("Рубашка явно была мне велика, а штанины джинсов волочились по земле.")
	await novel_interface.show_text_only("Но самый ужас — в правой руке я всё ещё держал металлическую биту.\nХотя это была единственная улика…")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Мм… я на одном дыхании дошёл досюда, но что мне делать дальше?",GameConfig.player_name)
	await novel_interface.show_dialog("Совсем не похоже, будто здесь мог случиться теракт,\nведь охраны тут полно.",GameConfig.player_name)
	await novel_interface.show_dialog("Хотя это неудивительно: у них ведь исчез объект содержания…",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("…Постой-ка, девочка.", "Охранник")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Эй, девочка вон там, стой!!!!", "Охранник")
	await novel_interface.show_text_only("Говоривший был коротко стриженным мужчиной; из рукавов виднелись мощные, рельефные руки, полные силы.")
	await novel_interface.show_text_only("Закалённое тело и доброжелательная ослепительная улыбка делали его похожим на главного героя какого-нибудь фильма о рестлинге.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("Ч-что!?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Да-да, я тебе говорю.", "Охранник")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Какая ещё девочка, придурок!\nЯ… я… я…",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм? В общем, вчера пропала очень важная вещь.\nМы получили приказ перекрыть весь этот район.", "Охранник")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("У меня тоже пропала очень важная вещь…\nОчень важная — исчезла, стоило мне проснуться!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Посторонним вход сейчас запрещён, так что, девочка, приходи в другой день.", "Охранник")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("И ещё!", "Охранник")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("А! Ч-что ещё…?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ты и так разгуливаешь с битой в руках — и это ещё полбеды, но в таком виде очень легко простудиться.", "Охранник")
	await novel_interface.show_dialog("Давай домой!", "Охранник")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("Охранник поднял большой палец и снова ослепительно тепло улыбнулся мне.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Х-хорошо, тогда до свидания!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Никак не привыкну, когда меня называют «девочкой»…)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Уф— тут точно должен быть хоть какой-то след.\nНо внутрь мне всё равно не попасть…",GameConfig.player_name)
	await novel_interface.show_dialog("…Похоже, придётся послушно возвращаться домой.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Э?.. Я ведь всё это время шёл к станции, но дорога будто стала какой-то странной?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Э-э?\nЧто происходит???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Я заблудился…?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Джи——!\n…věta…hrích…!!","Странная хулиганка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Что это с ними…\nЭти типы… о чём они вообще говорят?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Уваааааа!!!!",GameConfig.player_name)
	await novel_interface.show_dialog("Они… они бегут прямо на меня?!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…!!","Странная хулиганка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Надо скорее бежать!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("…хах…! Даже если я и хочу сбежать…\nв такой болтающейся одежде и обуви далеко не убежишь…!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("А-а-а-а-а!!!!","Странная хулиганка")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Они уже почти догнали…\nМне конец!!",GameConfig.player_name)
	await novel_interface.show_dialog("Э?.. Бита…?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я заметил, что узоры на бите в моей руке засветились странным светом.\nЭ-это ещё что…!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Я ведьма, можешь звать меня Анни.\n…Похоже, у тебя неприятности, да?~", "Девушка с синими волосами")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Анни… ведьма??\nДа уж, неприятности у меня сегодня явно не из обычных…",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("У меня к тебе куча вопросов.\nНо сначала давай разберёмся с тем, что у нас прямо перед носом!","Анни")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Кстати, что это на тебе вообще надето… всё болтается.\nВ такой одежде драться совсем неудобно~", "Анни")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Я помогу тебе переодеться во что-нибудь по размеру.\nПохоже, сейчас нам придётся подраться!", "Анни")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Д-драться?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
