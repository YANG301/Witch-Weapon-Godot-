# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("...ฮึก...ฮ่า...แม้จะไม่รู้ว่าเกิดอะไรขึ้น\nแต่นี่ถือว่า...ชนะแล้วเหรอ...?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("...เหมือนจะใช่นะ","แอนนี่")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("เธอ...เธอเป็นใครกันแน่!?\nโผล่มาจากไหนเนี่ย!?",GameConfig.player_name)
	await novel_interface.show_dialog("พวกที่โจมตีฉันเมื่อกี้มันคือตัวอะไรกัน!?\nแล้วไม้เบสบอลนี่คืออะไรอีก!?",GameConfig.player_name)
	await novel_interface.show_dialog("ที่นี่มันเกิดอะไรขึ้นกันแน่!?",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("ใจเย็นก่อน!\nเท่าที่ฉันรู้ ฉันจะตอบคำถามเธอทีละข้อเอง", "แอนนี่")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("แต่ฉันเองก็เหมือนเธอ ยังไม่เข้าใจสถานการณ์เหมือนกัน\nว่าเธอเป็นใคร ฉันก็อยากรู้เหมือนกันนะ...", "แอนนี่")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ขอโทษนะ ฉันตื่นตระหนกเกินไป...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("ไม่เป็นไรหรอก\nจริงสิ เรายังไม่ได้แนะนำตัวกันดี ๆ เลย", "แอนนี่")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("ฉันชื่อแอนนี่ บาส\nเรียกฉันว่าแอนนี่ก็พอ~", "แอนนี่")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...ฉันชื่อ "+GameConfig.player_name+" ยินดีที่ได้รู้จัก",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"เหรอ...ยินดีที่ได้รู้จักเหมือนกัน", "แอนนี่")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("ชื่อเธอฟังดูเหมือนชื่อผู้ชายเลยนะ เท่จะตาย~", "แอนนี่")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("เป็นอะไรไป ทำไมถึงตกใจขนาดนั้นล่ะ?","แอนนี่")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("อ๊ะ พูดถึงแล้ว ตอนนี้ฉัน...\nเป็นผู้หญิงนี่นา...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("หืม? เธอก็เป็นผู้หญิงอยู่นี่ไง\nดูสิ ชุดที่ฉันเปลี่ยนให้ก็พอดีดีไม่ใช่เหรอ?", "แอนนี่")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("น่ารักมาก น่ารักมาก...\nชุด『ต่อสู้』นี้ถือเป็นของขวัญพบหน้ากันครั้งแรกจากฉันแล้วกัน~", "แอนนี่")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...ชุดต่อสู้?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("อ๊ายยย—อ๊าาาาาาาาาา!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("พอตั้งสติได้ก็เพิ่งรู้\nว่าฉันใส่ชุดผู้หญิงอยู่ทั้งตัว!!")
	await novel_interface.show_text_only("ชุดกะลาสี...\nกับกระโปรงสั้นจนชวนอาย...!")
	await novel_interface.show_text_only("ถุงน่องที่ขา...ให้ความรู้สึกประหลาดแบบนี้เองเหรอ...?")
	await novel_interface.show_dialog("แล้วความรัดแน่นที่หน้าอกนี่คงไม่ใช่... (คลำ)",GameConfig.player_name)
	await novel_interface.show_dialog("อ๊าาาาาาาาาา!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("เสื้อนอกก็เข้ากับสีผมของเธอมากเลยนะ~\nเป็นแบบที่เหมาะกับการเคลื่อนไหวสุด ๆ", "แอนนี่")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("อืม...? เป็นอะไรไปล่ะ~~?", "แอนนี่")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("ก็เพราะว่า...\nเพราะว่า...",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
