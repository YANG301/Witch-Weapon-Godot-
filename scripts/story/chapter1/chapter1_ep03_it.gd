# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("La postazione di guardia da questa parte continua a non rispondere. Vai a controllare di là—", "Voce maschile A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Sì!", "Voce maschile B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Vado a prendere il rilevatore di battito cardiaco. Tieni gli occhi aperti!", "Voce maschile A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Merda, qui non potrò nascondermi...",GameConfig.player_name)
	await novel_interface.show_dialog("Il loro campo visivo non ha angoli morti. L'unica possibilità è coglierne uno di sorpresa quando si separano.",GameConfig.player_name)
	await novel_interface.show_dialog("Dovrei farcela...\nSe quella donna è riuscita a stenderne uno a mani nude...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Devo trovare qualcosa da usare come arma...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alla parete del corridoio era appesa una mazza metallica. Sulla targhetta in basso si leggeva in piccolo: «Raebona, Luce della Libertà...»")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Dev'essere un pezzo da esposizione...\nLa prendo solo in prestito per un attimo. Sì, solo in prestito...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Allora... andiamo!\nHaaah—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("Dong!!!")
	await novel_interface.show_text_only("Colpii con tutta la forza la nuca del mascherato, e risuonò un boato tremendo. Eh...? Doveva fare così tanto rumore?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Però non cadde affatto come mi aspettavo: si voltò invece verso di me con gli occhi in fiamme.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Non funziona come nei videogiochi!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Chi va là?!", "Mascherato A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("Il mascherato scagliò il calcio del fucile verso di me con un movimento rapidissimo. Stringendo la mazza, provai d'istinto a parare.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Oh no—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("La sua forza schiacciante attraversò la mazza e si abbatté su mani e spalle. Mentre stringevo i denti per resistere, il mascherato sferrò all'improvviso un calcio.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("Il colpo mi centrò in pieno l'addome, completamente scoperto.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Il calcio mi scaraventò via: sfondai la ringhiera e precipitai al piano\ninferiore.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("Aaaaaa!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Merda, quel moccioso che mi ha teso un agguato è caduto di sotto.\nVado a finirlo!", "Mascherato A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...Devo scappare...\n...devo nascondermi... nell'ombra di... quell'esposizione...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Aspetta... il capo ha appena mandato un avviso: il sistema antifurto autodistruttivo è stato disattivato.", "Mascherato B")
	await novel_interface.show_dialog("Non perdere tempo, radunati subito nella sala conferenze!\nQuando si risveglierà, noi saremo già lontani.", "Mascherato B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Sì!", "Mascherato A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("La coscienza... si sta... offuscando...\nLiliu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel frattempo, nella sala conferenze")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Sembra che questo gruppo sia entrato grazie a un camuffamento ottico...","Liliu")
	await novel_interface.show_dialog("Ne hanno approfittato mentre una parte del sistema di rilevamento ottico del centro era in manutenzione... sembra proprio che qualcuno dall'interno abbia passato l'informazione.","Liliu")
	await novel_interface.show_dialog("Non so ancora chi siano... posso solo aspettare il momento giusto.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Heh heh heh... ahahahah—","Capo dei mascherati")
	await novel_interface.show_dialog("Finalmente l'abbiamo ripreso...!", "Capo dei mascherati")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Quello è... il 『Calice di Los』!?","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("Un 『Oggetto Eterogeneo』 rinvenuto da una spedizione sulle Isole Los, comparse all'improvviso nel Pacifico centrale; all'esterno del calice sono incastonate quattro gemme.")
	await novel_interface.show_text_only("Nel calice c'è una sostanza rossa simile a un liquido, ma non la si può né versare né toccare: come un'illusione, sembra priva di consistenza fisica...")
	await novel_interface.show_text_only("Quei vecchi del laboratorio hanno provato qualsiasi cosa senza capire di che si trattasse...")
	await novel_interface.show_text_only("Dopo qualche tempo, il suo livello di minaccia è stato abbassato a 『Safe』\ne ne è stata autorizzata la ricerca pubblica...")
	await novel_interface.show_dialog("Tsk, a guardarlo così, sembrano avere un certo valore solo quelle gemme.","Liliu")
	await novel_interface.show_dialog("Però le gemme e il calice sono fusi insieme a livello molecolare...","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Sarò io a separarli da questo oggetto impuro!!", "Capo dei mascherati")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Separarli? Com'è possibile—","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
