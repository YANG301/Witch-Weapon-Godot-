# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("(Checked once and again in the washroom…) \n(Couldn't think properly now…)",GameConfig.player_name)
	await novel_interface.show_dialog("(Pinched myself really hard) \n(It’s not a dream!)",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(My body is much softer) \n(Feels… not bad…)",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Damn! \nNo, what's on my mind!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Damn it… This T-shirt fitted me well yesterday. \nNow it's oversized…",GameConfig.player_name)
	await novel_interface.show_dialog("Fact is, my body becomes much smaller…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The little girl in the mirror is wearing an oversized T-shirt. \nLooks like in her boyfriend's clothes… That's how it goes in movies…")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("… What am I blushing for…",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Indeed… \nBecoming a girl overnight… is hard to swallow…",GameConfig.player_name)
	await novel_interface.show_dialog("I searched the room carefully just now.\nThe only thing out of place was that metal bat by the bed.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("In yesterday's dream, the research center was attacked.\nI fought with this bat...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("If it can be called a battle…",GameConfig.player_name)
	await novel_interface.show_dialog("And then, the whole city… was in ruins…",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Right, check the cellphone! \nIf there was a battle yesterday, it should be made the headlines!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("No news about terrorist attacks…",GameConfig.player_name)
	await novel_interface.show_dialog("Great, it was really a dream…",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Wait, what's this…",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("Ross Goblet Vanished under Close Surveillance.","News")
	await novel_interface.show_dialog("The Ross Goblet disappeared from its site last night under the watchful eyes of a dozen surveillance devices.","News")
	await novel_interface.show_dialog("The Steele Monte Containment and Research Center is under extremely tight security and supervision. It’s unlikely for anyone to steal anything from the Center...","News")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Well… I have to go and find out what happened!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("The dream last night, and my body… \nI have a feeling that maybe they have something to do with the Center.",GameConfig.player_name)
	await novel_interface.show_dialog("OK! Let's go!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("But wait… \nI look clearly suspicious in these clothes…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I come to regret it when I see my reflection in the glass of the entrance hall.")
	await novel_interface.show_text_only("The shirt is obviously oversized. And the jeans are dragging on the ground.")
	await novel_interface.show_text_only("The worst part is that I'm still clutching this metal bat in my right hand.\nBut it's the only proof I have...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Well… like it or not, here I am… What next?",GameConfig.player_name)
	await novel_interface.show_dialog("This place doesn't look like the sort of place where a terrorist attack could happen—there are guards everywhere.",GameConfig.player_name)
	await novel_interface.show_dialog("Then again, that's only natural. One of the containment items vanished...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("… Wait, girl!", "Guard")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Little girl over there, stop!", "Guard")
	await novel_interface.show_text_only("A man with buzz-cut shouts behind me. I see from his cuffs the powerful muscles of his brawny arms.")
	await novel_interface.show_text_only("A well-trained body plus a dazzling smile… He looks just like a wrestler in the movie.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("What!?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Yeah, you girl.", "Guard")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Girl? No, you idiot! \nI am… I… am…",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmm? Anyway, something important went missing yesterday. \nWe are sent here to blockade this place.", "Guard")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("I've got something important missing too! \nVery important, missing since I woke up this morning!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("The public is no longer allowed to enter. Come back some other time, girl.", "Guard")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("And…", "Guard")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("What! Anything else…?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Setting aside why a little girl is running around with a bat in her hand, you'll catch cold dressed like that.", "Guard")
	await novel_interface.show_dialog("Go on home.", "Guard")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("The security guard gives me a thumb up and again, a warm smile.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("O… ok, goodbye!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Haven't got used to being called a girl…)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh—there must be some clues in the Center. \nBut I can't get in…",GameConfig.player_name)
	await novel_interface.show_dialog("… Seems the only thing to do now is go home.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Huh? I think I’m walking towards the station. But it seems to be a wrong way?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Uh… \nWhat’s wrong?",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Am I lost?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Chirp—! \n… Věta… hřích…!","Odd-Looking Delinquent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("These guys look fishy… \nWhat are they talking about?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Whoaaaaa!",GameConfig.player_name)
	await novel_interface.show_dialog("What! They are after me!?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("… Mors…!","Odd-Looking Delinquent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("I need to get out of here—fast!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("… Whirr…! It’s impossible to run away… \nCan't move fast enough in these baggy clothes and shoes…!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Ahhhh!","Odd-Looking Delinquent")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("They're catching up… \nI'm finished!!",GameConfig.player_name)
	await novel_interface.show_dialog("Huh? The bat...?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I noticed the pattern on the bat in my hand glowing with strange colors.\nW-what is this...?!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("I'm a witch. You can call me Annie.\n...Looks like you've gotten yourself into trouble.~", "Blue-Haired Girl")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Annie… witch? \nI am definitely in big trouble today.",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("I have loads of questions for you, \nBut let's solve the immediate problem first!","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("What are you wearing? So baggy… \nUnsuitable for a battle, huh?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("I’ll give you a fitted suit… \nReady for the battle?", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ba… Battle?",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# Call episode end function
	await novel_interface.end_story_episode(0.5)
