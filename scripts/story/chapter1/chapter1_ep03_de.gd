# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Von dem Posten hier kommt immer noch keine Rückmeldung. Geh rüber und sieh nach —", "Männliche Stimme A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Jawohl!", "Männliche Stimme B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Ich hole den Herzschlagdetektor, du hältst hier die Augen offen!", "Männliche Stimme A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Mist, hier kann ich mich nicht mehr verstecken...",GameConfig.player_name)
	await novel_interface.show_dialog("Sie haben alles im Blick, es gibt keinen toten Winkel, durch den ich entwischen könnte. Meine einzige Chance ist, einen von ihnen zu überfallen, sobald sie sich trennen.",GameConfig.player_name)
	await novel_interface.show_dialog("Müsste doch klappen...\nWenn diese Frau den Gegner sogar mit bloßen Händen umgehauen hat...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ich brauche etwas als Waffe...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("An der Flurwand hing ein Metallschläger. Auf dem kleinen Schild darunter stand in winziger Schrift „Raebona – Freiheitslicht...“")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Ist bestimmt ein Ausstellungsstück...\nIch leihe es mir nur ganz kurz, ja, nur ganz kurz...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Also dann... los geht's!\nHah—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("Klong!!!")
	await novel_interface.show_text_only("Mit aller Kraft schlug ich dem Maskierten auf den Hinterkopf, und ein ohrenbetäubender Schlag hallte durch den Raum. Hä...? War das wirklich so laut?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Doch statt wie erhofft umzukippen, drehte sich der Gegner mit zornfunkelnden Augen zu mir um.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Das ist ja ganz anders als in Spielen!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Wer ist da?!", "Maskierter A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("Der Maskierte riss blitzschnell den Gewehrkolben herum und schlug nach mir. Hastig umklammerte ich den Schläger und blockte.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Nicht gut—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("Die überwältigende Kraft des Gegners fuhr über den Schläger direkt in meine Hände und Schultern. Während ich zähneknirschend dagegenhielt, setzte der Maskierte plötzlich zum Tritt an.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("Sein Fuß krachte mir brutal in den ungeschützten Bauch.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Der Tritt schleuderte mich fort. Ich durchbrach das Geländer und stürzte direkt in die Etage\ndarunter.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("Aaaah!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Verdammt, der Bengel, der mich angegriffen hat, ist nach unten gefallen.\nIch mach ihn fertig!", "Maskierter A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...Ich muss weg...\n...muss mich im... Schatten von... diesem Ausstellungsstück... verstecken...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Warte... Der Anführer hat gerade Bescheid gegeben: Die selbstzerstörende Diebstahlsicherung wurde erfolgreich deaktiviert.", "Maskierter B")
	await novel_interface.show_dialog("Verschwende keine Zeit mehr, komm sofort in den Konferenzsaal!\nBis der Junge wieder zu sich kommt, sind wir längst weg.", "Maskierter B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Jawohl!", "Maskierter A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("Mein Bewusstsein... verschwimmt langsam...\nLiliu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Zur gleichen Zeit im Konferenzsaal")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Sieht so aus, als wären diese Leute mithilfe optischer Tarnung hereingekommen...","Liliu")
	await novel_interface.show_dialog("Dass sie den Zeitpunkt ausnutzten, in dem ein Teil der optischen Gegenerkennungsanlage der Einrichtung gewartet wurde, heißt wohl, dass jemand von innen Informationen weitergegeben hat.","Liliu")
	await novel_interface.show_dialog("Noch ist nicht klar, wer sie sind... Ich kann nur auf eine Gelegenheit warten.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Heh heh heh... hahahaha——", "Anführer der Maskierten")
	await novel_interface.show_dialog("Endlich haben wir ihn uns zurückgeholt...!", "Anführer der Maskierten")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Das ist doch der Los-Goldkelch!?","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("Ein „Anomalobjekt“, das eine Expedition auf den Los-Inseln fand, die plötzlich im zentralen Pazifik aufgetaucht waren. In die Außenseite des Kelchs sind vier Edelsteine eingelassen.")
	await novel_interface.show_text_only("Im Inneren befindet sich eine rote, flüssigkeitsartige Substanz, doch man kann sie weder ausgießen noch berühren. Wie ein Trugbild scheint sie gar keine reale Form zu besitzen...")
	await novel_interface.show_text_only("Die alten Herren im Forschungszentrum haben wirklich alles Mögliche versucht und trotzdem nicht herausgefunden, was dieses Ding eigentlich ist...")
	await novel_interface.show_text_only("Nach einiger Zeit wurde seine Gefahrenstufe auf „Safe“ herabgesetzt\nund öffentliche Forschung daran erlaubt...")
	await novel_interface.show_dialog("Tz, eigentlich scheinen nur diese paar Edelsteine etwas wert zu sein.","Liliu")
	await novel_interface.show_dialog("Aber die Edelsteine und der Kelch sind auf molekularer Ebene miteinander verschmolzen...","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Dann werde ich dieses unreine Ding eben trennen!!", "Anführer der Maskierten")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Trennen? Wie sollte das möglich sein—","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
