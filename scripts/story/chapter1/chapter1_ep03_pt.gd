# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("O posto de guarda daqui ainda não respondeu. Vá verificar aquele lado—", "Voz masculina A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Sim!", "Voz masculina B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Vou buscar o detector de batimentos. Fique de olho!", "Voz masculina A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Droga, não dá para continuar escondido aqui...",GameConfig.player_name)
	await novel_interface.show_dialog("O campo de visão deles não tem ponto cego nenhum. Minha única chance é atacar um deles de surpresa quando se separarem",GameConfig.player_name)
	await novel_interface.show_dialog("Acho que vai dar certo...\nAfinal, até aquela mulher derrubou um deles com as próprias mãos...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Preciso achar alguma coisa para usar como arma...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Na parede do corredor havia um taco metálico pendurado. Na plaquinha embaixo, em letras miúdas, estava escrito: 『Raebona, Luz Livre...』")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Deve ser uma peça de exposição...\nSó vou pegar emprestado por um instante, isso, só pegar emprestado...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Então... lá vou eu!\nHaa—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("TUM!!!")
	await novel_interface.show_text_only("Com toda a minha força, acertei a nuca do mascarado e produzi um estrondo enorme. Hã...? Fez tanto barulho assim?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Mas, em vez de cair como eu esperava, ele se virou para mim com os olhos em chamas de raiva.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Isso é diferente dos jogos!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Quem está aí?!", "Mascarado A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("O mascarado brandiu rapidamente a coronha da arma contra mim, e eu me apressei em segurar o taco para me defender.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Não—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("A força esmagadora do golpe percorreu o taco e atingiu minhas mãos e meus ombros. Enquanto eu cerrava os dentes para resistir, o mascarado me atingiu de repente com um chute.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("O pé acertou com violência meu abdômen indefeso.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("O chute me lançou longe; arrebentei o corrimão e caí direto no andar de baixo.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("AAAAAH!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Merda, o moleque que me atacou caiu lá embaixo.\nVou acabar com ele!", "Mascarado A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...Tenho que fugir logo...\n...Preciso me esconder... na sombra... daquela peça de exibição...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Espere... o chefe acabou de avisar que a desativação do dispositivo antirroubo de autodestruição foi concluída", "Mascarado B")
	await novel_interface.show_dialog("Não perca tempo, reúna-se logo no auditório!\nQuando ele acordar, nós já teremos ido embora.", "Mascarado B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Sim!", "Mascarado A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("Minha consciência... está ficando... turva\nLiliu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ao mesmo tempo, no auditório")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Pelo visto, esse grupo entrou usando camuflagem óptica...","Liliu")
	await novel_interface.show_dialog("Eles aproveitaram a manutenção parcial do sistema antidetecção óptica do centro. Ao que tudo indica, alguém de dentro vazou a informação.","Liliu")
	await novel_interface.show_dialog("Ainda não sei de onde vieram... só posso esperar por uma oportunidade.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Heh heh heh... hahahaha—","Chefe Mascarado")
	await novel_interface.show_dialog("Finalmente o recuperamos...!", "Chefe Mascarado")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Aquilo é— o 『Cálice de Los』!?","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("Um 『Objeto Heterogêneo』 encontrado pela equipe de investigação nas Ilhas de Los, que surgiram subitamente no meio do Pacífico. Quatro gemas estão incrustadas na parte externa do cálice.")
	await novel_interface.show_text_only("Dentro do cálice há uma substância líquida vermelha, mas ela não pode ser derramada nem tocada; como um fantasma, parece não possuir forma física...")
	await novel_interface.show_text_only("Os velhotes do instituto tentaram de tudo e não conseguiram descobrir o que aquilo era...")
	await novel_interface.show_text_only("Algum tempo depois, o nível de ameaça dele foi reduzido para 『Safe』\ne a pesquisa pública passou a ser permitida...")
	await novel_interface.show_dialog("Tsc. À primeira vista, só aquelas pedras parecem valer algum dinheiro.","Liliu")
	await novel_interface.show_dialog("Mas as gemas e o cálice se fundiram num nível molecular...","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Serei eu a separar esta coisa impura!!", "Chefe Mascarado")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Separar? Como isso seria possível—","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
