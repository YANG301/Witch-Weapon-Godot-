# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("¡Inicio de sesión completado!","Sistema")
	await novel_interface.show_dialog("Su ID: 2519G1911\nNombre: "+GameConfig.player_name,"Sistema")
	await novel_interface.show_dialog("Edad: 15 años\nSexo: masculino","Sistema")
	await novel_interface.show_dialog("Bienvenido al Centro de Investigación y Contención Stilmont de la Quinta Ciudad Académica. La mayor institución de contención e investigación de «Objetos Heterogéneos» de Nuevo Toyosu.","Sistema")
	await novel_interface.show_dialog("Los «Objetos Heterogéneos», también llamados «milagros», son el término general para designar objetos o herramientas que, bajo ciertas condiciones, pueden provocar fenómenos físicos sobrenaturales.","Sistema")
	await novel_interface.show_dialog("Hoy es la jornada de puertas abiertas del centro.\nEl centro recibe a ciudadanos y delegaciones de otras Ciudades Académicas.","Sistema")
	await novel_interface.show_dialog("Como parte fundamental de la educación pública,\nse exhibirá una parte de los «milagros» y de los resultados de investigación...","Sistema")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("¡Qué suerte!~ ¡Llegué justo antes de que cerraran!",GameConfig.player_name)
	await novel_interface.show_dialog("No puedo creer que todos los ascensores del vestíbulo estén fuera de servicio; menos mal que encontré un montacargas de reserva que todavía funcionaba.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("En fin, con asistir a una conferencia y conseguir un sello, me darán los créditos, ¿no?",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Pero... ¿por qué no hay nadie en esta planta?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras recorría el pasillo del segundo piso, miraba a mi alrededor.")
	await novel_interface.show_text_only("Aunque en un sitio así normalmente ya hay poca gente, ahora mismo no se veía ni un alma.")
	await novel_interface.show_text_only("Además, el aire olía a desinfectante de hospital, y no pude evitar imaginarme al personal de limpieza entrando a trabajar tras el cierre.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("¿No habrá terminado ya la conferencia?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras buscaba la «sala de conferencias», doblé en la esquina junto a una escalera de caracol.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Esto es un desastre... de verdad no debí ponerme a jugar a ese juego...",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Esos botones de «siguiente turno» son puro veneno— ¡aaaah, ngh!\n¡¡¡!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡De repente algo me enganchó del cuello y me tiró bruscamente hacia atrás!")
	await novel_interface.show_text_only("Justo cuando estaba a punto de perder el equilibrio, sentí la nuca apoyarse contra algo suave, pero firme.")
	await novel_interface.show_text_only("Cuando recuperé el sentido de la situación, ya me habían arrastrado hasta un estrecho pasadizo en la esquina de la escalera, mucho más oscuro que el pasillo.")
	await novel_interface.show_dialog("¡Mmf—!!\n¡¡Mm—!!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Antes de que pudiera gritar, una mano me tapó la boca con fuerza; por el rabillo del ojo apenas alcancé a ver a una mujer con bata blanca—")
	await novel_interface.show_text_only("Estaba apoyada contra la pared, tapándome la boca con una sola mano.")
	await novel_interface.show_text_only("Y una de mis mejillas quedó firmemente aplastada contra su pecho... un aroma intenso y embriagador no dejaba de colárseme por la nariz.")
	await novel_interface.show_dialog("（¿Eh?? ¡¡S-son enormes!! ¡¡Tengo la cara enterrada!!）",GameConfig.player_name)
	await novel_interface.show_dialog("（¿Qué está pasando?! ¿¡Quién es esta mujer!?）",GameConfig.player_name)
	await novel_interface.show_dialog("¡Shhh! ¡Ni una palabra!", "Mujer de bata blanca")
	await novel_interface.show_text_only("Aunque la mujer a mi espalda hablaba en voz baja a propósito, sus palabras transmitían una autoridad imposible de cuestionar.")
	await novel_interface.show_text_only("Tenía la cabeza hecha un caos y sentía que estaba a punto de asfixiarme,\nasí que solo pude asentir ligeramente en señal de obediencia...")
	await novel_interface.show_text_only("Aunque seguía con la boca tapada, la presión sobre mi cuello disminuyó un poco.")
	await novel_interface.show_text_only("Enfocando la vista a poca distancia, alcancé a distinguir una línea de letras pequeñas en la placa prendida a su bata: Científica Jefe...")
	await novel_interface.show_dialog("（¿Científica...? ¿Trabaja en este centro?）",GameConfig.player_name)
	await novel_interface.show_text_only("Solo entonces me di cuenta de que ni siquiera me estaba mirando a mí; tenía la cabeza girada hacia otro lado, observando fijamente el pasillo.")
	await novel_interface.show_text_only("Desde el fondo del pasillo llegaron pasos apresurados y firmes.")
	await novel_interface.show_dialog("Informe: aquí no hay nadie.", "Voz masculina A")
	await novel_interface.show_dialog("Pero sí hay un montacargas independiente; voy a detenerlo manualmente.", "Voz masculina A")
	await novel_interface.show_dialog("（Y además, la persona que pasó corriendo hace un momento iba con la cara cubierta y llevaba... ¿un arma?）",GameConfig.player_name)
	await novel_interface.show_dialog("Han irrumpido aquí. Si no quieres morir, no te muevas.", "Mujer de bata blanca")
	await novel_interface.show_dialog("（¿U-una incursión? ¿Qué demonios pasa...?）",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Mientras yo seguía atónito, la mujer ya había salido disparada tras él.")
	await novel_interface.show_text_only("Unos segundos después, sonó un golpe seco seguido de un crujido, como si se quebraran unos huesos.")
	await novel_interface.show_text_only("Sin que llegara a oírse el golpe de un cuerpo al caer, lo sujetó al instante por detrás, arrastró al enmascarado de vuelta al pasadizo y le quitó la pistola.")
	await novel_interface.show_dialog("¡¿Ese tipo es...?!",GameConfig.player_name)
	await novel_interface.show_text_only("La mujer no me hizo ni caso. Con total soltura abrió la puerta del cuarto eléctrico junto a la pared y, levantando el tacón, pateó hacia dentro al corpulento hombre flácido.")
	await novel_interface.show_text_only("Aunque llevaba una camisa blanca y una falda ajustada, sus movimientos fueron fluidos y precisos de principio a fin.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hum~ de momento no debería venir nadie más.", "Mujer de bata blanca")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Se sacudió las manos como si acabara de deshacerse de un montón de basura voluminosa y luego se volvió a mirarme con total tranquilidad.")
	await novel_interface.show_text_only("Mi cerebro ya era incapaz de procesar lo que acababa de pasar, así que solo podía mirarla embobado.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("（Mirándola bien, ¡esta mujer es guapísima!）\n（Y su figura parece la de una modelo...）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("（Pero en la placa de su pecho pone claramente «científica»...）",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("（¡Así que lo de hace un momento tuvo que ser una alucinación!）",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Exacto. En este momento no hay ningún grandullón enmascarado metido en el cuarto eléctrico.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("Muy tranquilo conmigo mismo, llegué a esa conclusión y deslicé la mirada hacia sus piernas...")
	await novel_interface.show_text_only("（Trabajar con una mujer así sería un sueño...）\n（Ser investigador de Objetos Heterogéneos tampoco suena nada mal）")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Oye, mocoso, ¿adónde crees que estás mirando?", "Mujer de bata blanca")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mientras hablaba, sacó el cargador de la pistola para comprobar las balas.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("（¡¡¡No puedo seguir engañándome a mí mismo!!!）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ho-hola.\n¿Tú eres...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Bueno... puedes llamarme Liliu.\nHoy se suponía que iba a dar una conferencia aburridísima.", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Montó de nuevo la pistola con habilidad y la guardó en el bolsillo de la bata.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Pero hace un momento ese grupo tomó la sala de conferencias.\nGracias a ellos, la charla se canceló~", "Liliu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("¿Liliu... Liliu von Braun?!",GameConfig.player_name)
	await novel_interface.show_dialog("¡T-tú eres la ponente de la charla cuyo sello necesito!\n¡Y además una científica de rango SS certificada por el Senado!",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je, esos vejestorios son facilísimos de engañar~", "Liliu")
	await novel_interface.show_dialog("Pero, por la pinta que llevas, diría que viniste a rascar créditos, ¿no?", "Liliu")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ugh... ¡lo siento muchísimo!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("No sé si decir que tienes mala suerte o que eres idiota; encontraste justo el ascensor que subía en mitad del cierre de emergencia.", "Liliu")
	await novel_interface.show_dialog("De no ser por mí, habrías entrado como un tonto directamente en plena toma de la «sala de conferencias».", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Cierre de emergencia...?\nSaqué el móvil y, en efecto, no tenía ni una raya de señal.")
	await novel_interface.show_text_only("Por fin entendí por qué todos los ascensores principales del vestíbulo estaban parados... ¡No es que el centro hubiera cerrado!")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ahora también han bloqueado el ascensor por el que subiste, así que quédate aquí quietecito y espera a que te rescate el Departamento de Defensa.", "Liliu")
	await novel_interface.show_dialog("Tengo que ir a la sala de conferencias a comprobar la situación. Si viene alguien, escóndete.", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("P-pero... tú sola...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("¡¿Ha quedado claro?!", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("¡¡Sí!!",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
