# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("Accesso confermato.","Sistema")
	await novel_interface.show_dialog("ID: 2519G1911\nNome: "+GameConfig.player_name,"Sistema")
	await novel_interface.show_dialog("Età: 15 anni\nSesso: maschile","Sistema")
	await novel_interface.show_dialog("Benvenuto al Centro di Contenimento e Ricerca Steele Monte della Quinta Città Accademica, il più grande istituto di contenimento e ricerca sugli 『Oggetti Eterogenei』 di Nuova Opulentia.","Sistema")
	await novel_interface.show_dialog("Gli 『Oggetti Eterogenei』, noti anche come 『miracoli』, sono il termine generico che indica oggetti e strumenti capaci di scatenare fenomeni fisici soprannaturali in condizioni specifiche.","Sistema")
	await novel_interface.show_dialog("Oggi il centro di ricerca apre al pubblico.\nLa struttura è accessibile ai cittadini e alle delegazioni provenienti dalle altre Città Accademiche.","Sistema")
	await novel_interface.show_dialog("Come parte fondamentale del programma di divulgazione,\nverranno esposti alcuni 『miracoli』 e diversi risultati della ricerca...","Sistema")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("Che fortuna! Sono arrivato appena prima della chiusura!",GameConfig.player_name)
	await novel_interface.show_dialog("Incredibile, tutti gli ascensori della hall erano fuori servizio. Per fortuna ho trovato un montacarichi di riserva ancora in funzione.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Insomma, basta assistere a una conferenza e farmi mettere un timbro per ottenere i crediti, giusto?",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Però... com'è possibile che a questo piano non si veda nessuno?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Camminai lungo il corridoio del secondo piano, guardandomi intorno.")
	await novel_interface.show_text_only("Di solito in un posto del genere non c'è molta gente, ma stavolta non si vedeva davvero anima viva.")
	await novel_interface.show_text_only("E nell'aria aleggiava anche un odore da disinfettante ospedaliero; senza volerlo mi vennero in mente gli addetti alle pulizie che lavorano dopo la chiusura.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("La conferenza sarà mica già finita?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre cercavo la 『sala conferenze』, svoltai verso una scala a chiocciola.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Che disastro, che disastro... Non avrei dovuto giocare a quel gioco...",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Quel pulsante 『turno successivo』 crea davvero dipendenza— ah, mmpf\n!!!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("All'improvviso qualcosa mi si serrò attorno al collo e mi trascinò violentemente all'indietro!")
	await novel_interface.show_text_only("Proprio mentre stavo per perdere l'equilibrio, sentii il retro della testa affondare contro qualcosa di morbido ma compatto.")
	await novel_interface.show_text_only("Quando mi resi conto di cosa stava succedendo, ero già stato trascinato in uno stretto passaggio all'angolo delle scale, dove la luce era molto più fioca.")
	await novel_interface.show_dialog("Mmf—!!\nMmh—!!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Prima ancora che potessi gridare, una mano mi serrò la bocca con forza. Con la coda dell'occhio riuscii appena a scorgere una donna in camice bianco—")
	await novel_interface.show_text_only("Era appoggiata al muro, e con una mano mi teneva la bocca chiusa")
	await novel_interface.show_text_only("mentre una guancia mi restava schiacciata contro il suo petto... un profumo caldo e inebriante mi riempiva il naso.")
	await novel_interface.show_dialog("(Eh?? So-sono enormi!! Mi ci è finita la faccia in mezzo!!)",GameConfig.player_name)
	await novel_interface.show_dialog("(Che situazione è questa!! Chi è questa persona!?)",GameConfig.player_name)
	await novel_interface.show_dialog("Ssst—! Non fiatare!", "Donna in camice bianco")
	await novel_interface.show_text_only("Anche se la donna alle mie spalle aveva abbassato apposta la voce, le sue parole trasmettevano un'autorità impossibile da mettere in dubbio.")
	await novel_interface.show_text_only("Avevo la testa completamente in tilt e sentivo che stavo per soffocare,\npotei solo annuire debolmente in segno di obbedienza...")
	await novel_interface.show_text_only("Anche se mi teneva ancora la bocca tappata, la pressione sul collo si allentò un\npo'.")
	await novel_interface.show_text_only("Mettendo a fuoco ciò che avevo davanti, intravidi sul cartellino appuntato al suo camice una piccola scritta: scienziata capo...")
	await novel_interface.show_dialog("(Una scienziata... quindi lavora al centro di ricerca?)",GameConfig.player_name)
	await novel_interface.show_text_only("Solo allora mi accorsi che non stava guardando me: aveva voltato il capo dall'altra\nparte, fissando con attenzione il corridoio.")
	await novel_interface.show_text_only("Dal fondo del corridoio arrivarono passi rapidi e pesanti.")
	await novel_interface.show_dialog("Rapporto: da questa parte non c'è nessuno.", "Voce maschile A")
	await novel_interface.show_dialog("C'è davvero un montacarichi indipendente. Vado a bloccarlo manualmente.", "Voce maschile A")
	await novel_interface.show_dialog("(E l'uomo che è corso di là poco fa aveva il volto coperto e in mano... una pistola?)",GameConfig.player_name)
	await novel_interface.show_dialog("Qui c'è stata un'irruzione. Se non vuoi morire, non muoverti.", "Donna in camice bianco")
	await novel_interface.show_dialog("(Vi-violato? Ma che sta succedendo...)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Nel breve istante in cui rimasi interdetto, la donna era già scattata fuori.")
	await novel_interface.show_text_only("Pochi secondi dopo si sentirono un tonfo sordo e il sinistro rumore di ossa che si spezzano.")
	await novel_interface.show_text_only("Non ci fu il tonfo a terra che mi aspettavo: lei afferrò alle spalle l'uomo mascherato\nprima che cadesse, lo trascinò nel passaggio e gli tolse una pistola.")
	await novel_interface.show_dialog("Lui è...?!",GameConfig.player_name)
	await novel_interface.show_text_only("La donna non mi degnò di uno sguardo. Aprì con disinvoltura la porta del locale elettrico accanto al muro\ne con un calcio del tacco scaraventò dentro quel bestione ormai del tutto inerte.")
	await novel_interface.show_text_only("Indossava una camicia bianca e una gonna corta aderente, ma i suoi movimenti erano puliti e rapidi, senza la minima esitazione.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hm~ per il momento non dovrebbe arrivare nessun altro.", "Donna in camice bianco")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si spolverò le mani, come se avesse appena buttato via un rifiuto ingombrante, poi si voltò verso di me con aria rilassata.")
	await novel_interface.show_text_only("Il mio cervello non era più in grado di elaborare quello che era appena successo e potei solo fissarla inebetito.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(A guardarla bene, questa donna è davvero bellissima!)\n(E ha pure il fisico di una modella...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(Però sul tesserino che porta sul petto c'è scritto chiaramente «scienziata»)",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Quindi quello che è appena successo dev'essere per forza un'allucinazione!)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Giusto: nel locale elettrico qui accanto non esiste affatto nessun energumeno mascherato.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("Con la coscienza a posto giunsi a questa conclusione e spostai lo sguardo verso le sue gambe...")
	await novel_interface.show_text_only("(Lavorare insieme a una donna così dev'essere il paradiso...)\n(Fare ricerca sugli 『Oggetti Eterogenei』 forse non è affatto male.)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ehi? Moccioso, dove credi di guardare?", "Donna in camice bianco")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mentre parlava, sfilò il caricatore dalla pistola e controllò i proiettili.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(Basta prendermi in giro da solo!!!)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("P-piacere...\nLei sarebbe...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Mah... chiamami Liliu.\nOggi avrei dovuto tenere una conferenza noiosissima.", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Riassemblò con disinvoltura la pistola e la infilò nella tasca del camice.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Però quei tizi hanno appena preso in ostaggio la sala conferenze.\nGrazie a loro, la conferenza è saltata~", "Liliu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("Liliu... Liliu von Braun?!",GameConfig.player_name)
	await novel_interface.show_dialog("L-lei non è proprio la relatrice della conferenza di cui mi serviva il timbro?!\nEd è pure una scienziata di grado SS riconosciuta dal Senato!",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm, quei vecchiacci si fanno infinocchiare con poco~", "Liliu")
	await novel_interface.show_dialog("Però, a giudicare dalla tua faccia, eri venuto qui a racimolare crediti, vero?", "Liliu")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ugh... mi dispiace davvero!!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("Non capisco se sei sfortunato o solo stupido: sei riuscito perfino a trovare un ascensore funzionante mentre l'edificio era in stato di blocco.", "Liliu")
	await novel_interface.show_dialog("Se ti avessi lasciato fare, saresti entrato bello tranquillo nella scena della presa d'ostaggi alla 『sala conferenze』.", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Blocco di sicurezza...?\nTirai fuori il telefono e, come immaginavo, non c'era il minimo segnale.")
	await novel_interface.show_text_only("Finalmente capii perché tutti gli ascensori principali della hall erano fermi... non era perché il centro aveva chiuso!")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Adesso anche l'ascensore con cui sei salito è stato sigillato. Sta' buono qui e aspetta i soccorsi del Ministero della Difesa.", "Liliu")
	await novel_interface.show_dialog("Io vado a vedere com'è la situazione nella sala conferenze. Se arriva qualcuno, nasconditi.", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("M-ma... tu da sola...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Mi sono spiegata?!", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("S-sì!!",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
