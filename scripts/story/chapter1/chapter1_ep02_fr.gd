# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("Connexion réussie !","Voix système")
	await novel_interface.show_dialog("Votre ID : 2519G1911\nNom : "+GameConfig.player_name,"Voix système")
	await novel_interface.show_dialog("Âge : 15 ans\nSexe : masculin","Voix système")
	await novel_interface.show_dialog("Bienvenue au Centre de confinement et de recherche Steele Monte de la Cinquième Cité Académique, le plus grand institut de confinement et de recherche sur la « Substance H » du territoire de New Opulentia.","Voix système")
	await novel_interface.show_dialog("La « Substance H », aussi appelée « miracle », est le terme générique désignant les objets et outils capables de provoquer des phénomènes physiques surnaturels dans certaines conditions.","Voix système")
	await novel_interface.show_dialog("Aujourd'hui a lieu la journée portes ouvertes du centre.\nLe centre est accessible aux citoyens ainsi qu'aux délégations des autres Cités Académiques.","Voix système")
	await novel_interface.show_dialog("Dans le cadre de son programme d'information au public,\nune partie des « miracles » et des résultats de recherche sera exposée...","Voix système")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("J'ai eu du bol ! J'ai réussi à arriver avant la fermeture !",GameConfig.player_name)
	await novel_interface.show_dialog("Tous les ascenseurs du hall étaient arrêtés ; heureusement, j'ai trouvé un monte-charge de secours encore en service.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Bref, il suffit d'aller écouter la conférence, de faire tamponner ma fiche et j'aurai mes crédits, pas vrai ?",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mais... pourquoi il n'y a absolument personne à cet étage ?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je longeais le couloir du deuxième étage en regardant autour de moi.")
	await novel_interface.show_text_only("Même si ce genre d'endroit n'est jamais très fréquenté, là, il n'y avait vraiment pas la moindre âme qui vive.")
	await novel_interface.show_text_only("Et en plus, l'air avait comme une odeur de désinfectant d'hôpital ; ça m'a fait penser aux agents d'entretien qui viennent nettoyer après la fermeture.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("Le cours n'est quand même pas déjà fini, si ?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout en cherchant la « salle de conférence », je suis arrivé près d'un escalier en colimaçon.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Je suis mal... J'aurais vraiment pas dû lancer ce jeu...",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Des boutons comme « Tour suivant », c'est vraiment du poison — aaah, ngh...\n!!!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Tout à coup, quelque chose a accroché mon cou et m'a brutalement tiré en arrière !")
	await novel_interface.show_text_only("Au moment où j'allais perdre l'équilibre, j'ai senti l'arrière de ma tête s'appuyer contre quelque chose de doux, mais ferme.")
	await novel_interface.show_text_only("Quand j'ai repris mes esprits, j'avais déjà été tiré dans un passage étroit au coin de l'escalier ; tout autour, la lumière était bien plus faible.")
	await novel_interface.show_dialog("Mmgh— !!\nMmmh— !!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Avant même que je puisse crier, une main m'a fermement couvert la bouche ; tout ce que je pouvais distinguer du coin de l'œil, c'était une femme en blouse blanche —")
	await novel_interface.show_text_only("À ce moment-là, elle était adossée au mur, une main plaquée sur ma bouche.")
	await novel_interface.show_text_only("Et une de mes joues était pressée contre sa poitrine... Un parfum riche et enivrant n'arrêtait pas de me monter au nez.")
	await novel_interface.show_dialog("(Hein ?? C'est, c'est énorme !!!! J'ai le visage enfoui dedans !!)",GameConfig.player_name)
	await novel_interface.show_dialog("(C'est quoi cette situation ?! C'est qui, cette femme ?!)",GameConfig.player_name)
	await novel_interface.show_dialog("Chut — ! Pas un bruit !", "Femme en blouse blanche")
	await novel_interface.show_text_only("Bien qu'elle prenne soin de baisser la voix, chacune de ses paroles dégageait une autorité impossible à contester.")
	await novel_interface.show_text_only("J'avais le cerveau en vrac, j'avais presque l'impression d'étouffer.\nJe n'ai pu que hocher très légèrement la tête pour montrer que j'obéissais...")
	await novel_interface.show_text_only("Même si ma bouche était toujours couverte, la pression autour de mon cou s'est un peu relâchée.")
	await novel_interface.show_text_only("J'ai concentré mon regard sur ce qui était tout près, et j'ai vaguement distingué une petite ligne sur la plaque accrochée à sa blouse blanche : Scientifique en chef...")
	await novel_interface.show_dialog("(Une scientifique... elle travaille donc dans l'institut ?)",GameConfig.player_name)
	await novel_interface.show_text_only("Ce n'est qu'à ce moment-là que j'ai remarqué qu'elle ne me regardait pas du tout ; elle avait tourné la tête de l'autre côté et fixait le couloir avec concentration.")
	await novel_interface.show_text_only("Des bruits de pas rapides et assurés ont retenti au loin dans le couloir.")
	await novel_interface.show_dialog("Rapport, il n'y a personne par ici.", "Voix masculine A")
	await novel_interface.show_dialog("Mais il y a bien un monte-charge indépendant. Je vais aller le couper manuellement.", "Voix masculine A")
	await novel_interface.show_dialog("(Et la personne qui a couru tout à l'heure avait l'air d'avoir le visage couvert, et dans la main elle tenait... un pistolet ?)",GameConfig.player_name)
	await novel_interface.show_dialog("Il y a eu une intrusion ici. Si tu tiens à la vie, ne bouge pas.", "Femme en blouse blanche")
	await novel_interface.show_dialog("(U-une intrusion ? Qu'est-ce qui se passe... ?)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Le temps que je réalise ce qui se passait, la femme s'était déjà faufilée dehors.")
	await novel_interface.show_text_only("Quelques secondes plus tard, un bruit sourd a retenti, suivi d'un craquement semblable à des os qui se brisent.")
	await novel_interface.show_text_only("Je n'ai pas entendu le bruit de chute auquel je m'attendais : elle a rattrapé l'homme masqué par-derrière, l'a traîné dans le passage et lui a retiré son pistolet.")
	await novel_interface.show_dialog("Lui, c'est... ?!",GameConfig.player_name)
	await novel_interface.show_text_only("La femme m'ignora totalement ; elle ouvrit avec aisance la porte du local électrique contre le mur,\npuis, d'un coup de talon, envoya le grand gaillard entièrement ramolli valser à l'intérieur.")
	await novel_interface.show_text_only("Malgré sa chemise blanche et sa jupe moulante, ses mouvements étaient fluides et d'une efficacité remarquable.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hmph~ Personne ne devrait venir par ici avant un moment.", "Femme en blouse blanche")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle épousseta ses mains, comme si elle venait simplement de jeter un énorme déchet, puis se retourna vers moi avec une aisance déconcertante.")
	await novel_interface.show_text_only("Mon cerveau était déjà incapable d'assimiler ce qui venait de se passer ; je ne pouvais que la fixer bêtement.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(En y regardant bien, cette femme est vraiment magnifique !)\n(Et en plus, elle a un corps de mannequin...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(Mais son badge indique clairement « scientifique ».)",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Donc ce qui vient de se passer doit forcément être une hallucination, pas vrai ?)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("C'est ça, oui : il n'y a absolument pas de colosse masqué enfermé dans le local électrique.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("J'ai tiré cette conclusion avec une parfaite bonne conscience, puis mon regard a glissé vers ses jambes...")
	await novel_interface.show_text_only("(Travailler avec une femme pareille, ce serait le rêve...)\n(Être chercheur en Substance H, ce n'est peut-être pas un si mauvais boulot.)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Hé, morveux, où tu crois regarder ?", "Femme en blouse blanche")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout en parlant, elle retira le chargeur du pistolet pour vérifier les balles.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(Arrête de te mentir à toi-même !!!)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("V-vous êtes... ?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Eh bien... appelle-moi Liliu.\nÀ la base, je devais donner une conférence d'un ennui mortel aujourd'hui", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle remonta le pistolet avec dextérité et le glissa dans la poche de sa blouse blanche.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Mais le groupe de tout à l'heure a pris la salle de conférence en otage.\nGrâce à eux, la conférence a été annulée~", "Liliu")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("Liliu... Liliu von Braun ?!",GameConfig.player_name)
	await novel_interface.show_dialog("T-tu es la conférencière dont je devais faire tamponner le papier !\nEt en plus, une scientifique de rang SS reconnue par le Sénat !",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hmph, ces vieux-là sont vraiment faciles à embobiner~", "Liliu")
	await novel_interface.show_dialog("Mais à te voir, tu étais surtout venu gratter des crédits, non ?", "Liliu")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ugh... je suis vraiment désolé !!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("Je dois te plaindre pour ta malchance ou pour ta bêtise ?\nTrouver l'ascenseur qui monte en pleine procédure de verrouillage, franchement...", "Liliu")
	await novel_interface.show_dialog("Si je t'avais laissé faire, tu aurais sans doute fini par entrer tout droit dans la prise d'otages de la « salle de conférence ».", "Liliu")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Procédure de verrouillage... ?\nJ'ai sorti mon téléphone : évidemment, pas la moindre barre de réseau.")
	await novel_interface.show_text_only("Je comprends enfin pourquoi tous les ascenseurs du hall principal étaient à l'arrêt...\nAlors ce n'était pas une simple fermeture !")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Maintenant, l'ascenseur par lequel tu es arrivé jusqu'ici a lui aussi été condamné. Sois sage et attends ici les secours du Bureau de la Défense.", "Liliu")
	await novel_interface.show_dialog("Je dois aller voir ce qui se passe dans la salle de conférence. Si quelqu'un vient, cache-toi.", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("M-mais... vous allez y aller seule...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Tu as bien compris ?", "Liliu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("D'accord !!",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
