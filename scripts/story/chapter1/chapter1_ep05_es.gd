# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("（Ya fui al baño a comprobarlo una y otra vez...）\n（Siento que se me va a fundir el cerebro...）",GameConfig.player_name)
	await novel_interface.show_dialog("（Me pellizqué con todas mis fuerzas）\n（¡No estoy soñando!）",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（Y además siento el cuerpo mucho más blando）\n（Y al tacto no está nada mal...）",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("¡¡¿Qué demonios significa eso de «no está nada mal»?!\n¡¡En qué estoy pensando!!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Maldita sea... ayer esta camiseta me quedaba perfecta,\ny de golpe me queda enorme...",GameConfig.player_name)
	await novel_interface.show_dialog("Más bien será que mi cuerpo se ha hecho más pequeño...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En el espejo se reflejaba una chica menuda, envuelta en ropa que le quedaba grande, como la protagonista de una película llevando la ropa de su novio...")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("...¿Por qué me estoy sonrojando...?",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Como pensaba...\nNo hay manera de contarle a nadie algo como que me he convertido en chica...",GameConfig.player_name)
	await novel_interface.show_dialog("Acabo de revisar la habitación con cuidado.\nLa única anomalía es un bate metálico que apareció junto a la cama.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("En el sueño de ayer, el centro de investigación fue atacado.\nYo luché con este bate...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Si es que a eso se le puede llamar luchar...",GameConfig.player_name)
	await novel_interface.show_dialog("Después, toda la ciudad quedó reducida a cenizas...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Cierto, voy a mirar el móvil.\nSi de verdad pasó, algo así tiene que haber salido en las noticias.",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("No hay ninguna noticia sobre atentados terroristas ni nada parecido...",GameConfig.player_name)
	await novel_interface.show_dialog("Menos mal... ¿de verdad solo fue un sueño?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿Eh? ¿Esto es—?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("El «Cáliz de Los» desaparece repentinamente bajo estricta vigilancia.","Noticias")
	await novel_interface.show_dialog("Anoche, el Cáliz de Los desapareció del lugar donde estaba custodiado pese a hallarse bajo la vigilancia de doce sistemas de monitoreo.","Noticias")
	await novel_interface.show_dialog("El Centro de Investigación y Contención Stilmont cuenta con estrictas medidas de administración y seguridad, por lo que la posibilidad de un robo es extremadamente baja...","Noticias")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Me da la impresión de que... ¡tengo que volver al centro de investigación!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Sobre el sueño de ayer y sobre lo que le pasa a mi cuerpo...\nSiento que quizá, si voy al laboratorio, pueda entender algo.",GameConfig.player_name)
	await novel_interface.show_dialog("¡Bien! ¡Allá voy!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("Ahora que lo pienso...\nCon esta pinta parezco una persona súper sospechosa...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al ver mi reflejo en el cristal de la entrada del edificio, no pude evitar arrepentirme un poco.")
	await novel_interface.show_text_only("La camisa me queda claramente grande y las perneras de los vaqueros arrastran por el suelo.")
	await novel_interface.show_text_only("Y para colmo, llevo un bate metálico en la mano derecha.\nPero es la única prueba que tengo...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Mmm... llegué hasta aquí del tirón, pero ¿qué se supone que hago ahora?",GameConfig.player_name)
	await novel_interface.show_dialog("No parece el tipo de lugar donde vaya a ocurrir un atentado terrorista, con tanta\nseguridad por todas partes.",GameConfig.player_name)
	await novel_interface.show_dialog("Pero supongo que es normal, si desapareció un objeto contenido...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("...Espera, jovencita.", "Guardia")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("¡¡¡¡Eh, tú, jovencita, detente!!!!", "Guardia")
	await novel_interface.show_text_only("Quien hablaba era un hombre de pelo corto; en los brazos que asomaban por las mangas se veían músculos poderosos y de líneas robustas.")
	await novel_interface.show_text_only("Su físico curtido, combinado con una sonrisa amable y deslumbrante, lo hacía parecer el protagonista de alguna película de lucha libre.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("¡¿Eh?!",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sí, te hablo a ti.", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("¡¿Qué jovencita ni qué nada, idiota?!\nYo soy... yo... soy...",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿Hm? En fin, ayer desapareció algo importante.\nHemos recibido la orden de acordonar toda esta zona.", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("Yo también he perdido algo importante...\n¡Algo muy importante, y había desaparecido cuando me desperté!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ahora mismo la entrada está prohibida para civiles, jovencita. Vuelve otro día.", "Guardia")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("¡Y otra cosa!", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¡Ah! ¿Q-qué pasa ahora...?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Y dejando de lado eso de que vayas corriendo por ahí con un bate, vestida así te vas a resfriar enseguida.", "Guardia")
	await novel_interface.show_dialog("¡Vuelve a casa!", "Guardia")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("El guardia me levantó el pulgar y me dedicó otra de esas sonrisas cálidas y deslumbrantes.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("D-de acuerdo... ¡hasta luego!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（No me acostumbro nada a que me llamen «jovencita»...）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh... seguro que tiene que haber alguna pista.\nPero no puedo entrar...",GameConfig.player_name)
	await novel_interface.show_dialog("...Supongo que no me queda otra que volver obedientemente a casa.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("¿Eh? Llevo rato caminando hacia la estación, pero ¿no está rara la calle?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("¿Eh?\n¿¿Qué está pasando???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("¿Me he perdido...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("¡Kiii—!\n…věta…hrích…！！","Pandillera extraña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("¿Qué les pasa a esas chicas...?\n¿Qué demonios están diciendo...?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("¡¡Uwaaaahhhhh!!!!",GameConfig.player_name)
	await novel_interface.show_dialog("¡¿Esas tipas vienen a por mí?!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…！！","Pandillera extraña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("¡Tengo que salir corriendo!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("...¡Jadeo...! Aunque quiera huir...\ncon la ropa y los zapatos tan holgados, no puedo correr rápido...!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("¡¡Gyaaaahhhh!!!!","Pandillera extraña")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("¡Me van a alcanzar...\n¡Se acabó, se acabó!",GameConfig.player_name)
	await novel_interface.show_dialog("¿Eh? ¿El bate...?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me di cuenta de que los dibujos del bate que llevaba en la mano brillaban con una luz extraña.\nE-esto es...!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Soy una bruja, puedes llamarme Annie.\n...Parece que has tenido problemas, ¿eh?~", "Chica de cabello azul")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("¿Annie... una bruja??\nLos problemas que he tenido hoy no han sido precisamente poca cosa...",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Hay un montón de cosas que quiero preguntarte.\nPero primero solucionemos lo que tenemos delante.","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Por cierto, ¿qué se supone que llevas puesto...? Todo te queda suelto.\nEsa ropa no sirve en absoluto para pelear~", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Voy a ayudarte a ponerte algo que te quede bien.\n¡Prepárate para pelear!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¿P-pelear?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
