# chapter1_ep6.gd - 第1章第6話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("……ふぅ、……何がなんだが分からないけど、\\nこれで勝てたのか……？",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("……みたいね。","アニー")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("き、きみは、どちらさまッ！？\\nどこから出てきたッ！？",GameConfig.player_name)
	await novel_interface.show_dialog("俺を襲ってきたあいつらは何者なんだ！？\nそれに、このバットは一体何なんだ！？",GameConfig.player_name)
	await novel_interface.show_dialog("ここでいったい何が起きたんだよ？！",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("ちょっと落ち着きなさいって！\\n私が分かる範囲なら答えてあげるから。", "アニー")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("でも、私だってあなたと同じで状況はよく分かってないの。\nむしろ、あなたが何者なのか私も知りたいくらいよ……。", "アニー")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ごめん……俺も、慌ててた……",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("気にしなくていいよ。\\nそうだ。お互い自己紹介もまだだったわね。", "アニー")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("私の名前はアニー・バス。\nアニーって呼んでね~", "アニー")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……俺は"+GameConfig.player_name+"。よろしく。",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"か……こちらこそよろしく。", "アニー")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("女の子なのに、男の子みたいな喋り方だね。\\nなんか格好いいなぁ～～", "アニー")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("っ！？", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("どうしたの、そんなに驚いて？","アニー")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("あ、そういえば今……\\n俺、女の子だね…………",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("うん？　女の子だよ？\\nほら、その服も結構いい感じでしょ？", "アニー")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("うんうん、可愛い可愛い……その『戦闘服』は\\nあなたにプレゼントしてあげよう～～！", "アニー")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…………『戦闘服』？",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("あぁ……の゛あああああああッッ！！！！",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("いつのまにか\\n俺、女装してるじゃんコレッ！！")
	await novel_interface.show_text_only("セーラー服……\\nスカート……\\n恥ずかしくて死んじゃうぐらい短い……！")
	await novel_interface.show_text_only("ストッキングって…\\nこんな微妙な感じなのか……!？")
	await novel_interface.show_dialog("そして胸あたりに伝わる緊縛感……\\nまさか……（さわっ）",GameConfig.player_name)
	await novel_interface.show_dialog("うぁぁああああッッ！！？！？",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("上着はあなたの髪色にも合ってるよ~\n運動するにはぴったりのデザインなんだから。", "アニー")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("……ええっと……？　どうしたの～～？", "アニー")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("だって…………　だって…………",GameConfig.player_name)

	print("=== 第1章第6話終了 ===")

	# エピソード終了処理
	await novel_interface.end_story_episode(0.5)
