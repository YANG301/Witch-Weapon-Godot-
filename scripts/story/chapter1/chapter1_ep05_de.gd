# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("(Ich hab im Bad schon zigmal nachgesehen...)\n(Mein Kopf ist völlig überfordert...)",GameConfig.player_name)
	await novel_interface.show_dialog("(Ich hab mich kräftig gezwickt)\n(Das ist kein Traum!)",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Und mein Körper fühlt sich viel weicher an)\n(Fühlt sich eigentlich gar nicht schlecht an...)",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Was heißt hier „gar nicht schlecht“!!\nWas denke ich da überhaupt!!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Verdammt... Das T-Shirt, das gestern noch perfekt saß,\nist plötzlich viel zu groß geworden...",GameConfig.player_name)
	await novel_interface.show_dialog("Nein, eigentlich ist wohl mein Körper kleiner geworden...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Im Spiegel sah ich ein zierliches Mädchen in viel zu großer Kleidung — fast wie eine Filmszene, in der ein Mädchen das Hemd ihres Freundes trägt...")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("...Warum werde ich dabei rot...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Also wirklich...\nDass ich zu einem Mädchen geworden bin, kann ich doch niemandem erzählen...",GameConfig.player_name)
	await novel_interface.show_dialog("Gerade eben habe ich das Zimmer gründlich durchsucht.\nDie einzige Auffälligkeit war der Metallschläger, der plötzlich neben meinem Bett lag.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Im Traum von gestern wurde das Forschungszentrum angegriffen.\nMit genau diesem Schläger habe ich gekämpft...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Falls man das überhaupt einen Kampf nennen kann...",GameConfig.player_name)
	await novel_interface.show_dialog("Und später ist sogar die ganze Stadt in Staub und Asche zerfallen...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Stimmt, ich sollte mein Handy checken!\nWenn das wirklich passiert ist, müsste es doch Berichte darüber geben!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Von Terroranschlägen oder Ähnlichem steht nichts in den Nachrichten...",GameConfig.player_name)
	await novel_interface.show_dialog("Zum Glück, also war es wirklich nur ein Traum...?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Hä? Was ist das—?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("„Los-Goldkelch“ verschwindet trotz lückenloser Überwachung.","Nachrichten")
	await novel_interface.show_dialog("Der Los-Goldkelch verschwand vergangene Nacht am Aufbewahrungsort unter den Augen von zwölf Überwachungsgeräten.","Nachrichten")
	await novel_interface.show_dialog("Das Steelemont-Eindämmungs- und Forschungszentrum gilt als streng verwaltet und bewacht. Ein Diebstahl scheint äußerst unwahrscheinlich...","Nachrichten")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Ich habe das Gefühl... ich muss unbedingt noch einmal zum Forschungszentrum!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Wegen des Traums von gestern und wegen meines Körpers.\nIrgendwie habe ich das Gefühl, dass ich im Forschungszentrum vielleicht etwas begreifen kann.",GameConfig.player_name)
	await novel_interface.show_dialog("Okay! Ich gehe los!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("Wenn man es genau nimmt...\nsehe ich so doch total verdächtig aus...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Als ich mein Spiegelbild im Glas am Gebäudeeingang sah, bereute ich es dann doch ein wenig.")
	await novel_interface.show_text_only("Das Hemd war offensichtlich zu groß, und die Hosenbeine der Jeans schliffen über den Boden.")
	await novel_interface.show_text_only("Das Krasseste ist aber, dass ich in der rechten Hand auch noch den Metallschläger halte.\nAber das ist mein einziger Beweis...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Hm... ohne groß nachzudenken bin ich bis hierher gekommen, aber was mache ich jetzt eigentlich?",GameConfig.player_name)
	await novel_interface.show_dialog("Es sieht gar nicht nach einem Ort aus, an dem ein Terroranschlag passiert wäre. Es sind so viele Wachen da.",GameConfig.player_name)
	await novel_interface.show_dialog("Aber eigentlich ist das kein Wunder, schließlich ist ein Verwahrstück verschwunden...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("...Moment mal, kleines Mädchen.", "Wachmann")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Hey, du da, kleines Mädchen, stehenbleiben!!!!", "Wachmann")
	await novel_interface.show_text_only("Der Sprecher war ein kurzhaariger Mann; an den Armen, die unter den Ärmeln hervorsahen, zeichneten sich grobe, kraftvolle Muskeln ab.")
	await novel_interface.show_text_only("Mit seinem gestählten Körper und dem warmen, gutmütigen Lächeln sah er aus wie der Held eines Wrestling-Films.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("Wah!?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ja, genau dich meine ich.", "Wachmann")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Was heißt hier kleines Mädchen, du Idiot!\nIch bin... ich... bin...",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm? Jedenfalls ist gestern etwas Wichtiges verschwunden.\nWir haben den Befehl erhalten, die Umgebung hier abzusperren.", "Wachmann")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("Mir ist auch etwas Wichtiges abhandengekommen...\nEtwas furchtbar Wichtiges — es war weg, als ich heute Morgen aufgewacht bin!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Zivilisten haben jetzt keinen Zutritt mehr. Komm ein andermal wieder, kleines Mädchen.", "Wachmann")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Und noch was!", "Wachmann")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Wah! W-Was denn noch...?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mal ganz davon abgesehen, dass du mit einem Schläger herumläufst — in dem Aufzug holst du dir leicht eine Erkältung.", "Wachmann")
	await novel_interface.show_dialog("Geh lieber schnell nach Hause!", "Wachmann")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("Der Wachmann hob den Daumen und schenkte mir erneut dieses blendend warme Lächeln.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("O-Okay... dann auf Wiedersehen!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(An so eine Anrede wie „kleines Mädchen“ werde ich mich nie gewöhnen...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh — hier muss es doch irgendwelche Hinweise geben.\nAber ich komme nicht hinein...",GameConfig.player_name)
	await novel_interface.show_dialog("...Dann bleibt mir wohl nichts anderes übrig, als brav wieder nach Hause zu gehen.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Hä? Ich gehe doch schon die ganze Zeit Richtung Bahnhof, aber irgendwie stimmt die Straße nicht?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Äh?\nWas ist denn los???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Habe ich mich verlaufen...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Kiii—!\n…věta…hrích…!!","Unheimliche Schlägerin")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Warum sind diese Leute so seltsam...?\nUnd was reden die da eigentlich?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Uwaaaahhhhh!!!!",GameConfig.player_name)
	await novel_interface.show_dialog("Die kommen auf mich zugerannt!?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…!!","Unheimliche Schlägerin")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Ich muss schnell weg!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("...Huff, huff...! Selbst wenn ich wegrennen will...\nmit diesen schlabberigen Klamotten und Schuhen komme ich überhaupt nicht voran...!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Graaahhhhh!!!!","Unheimliche Schlägerin")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Sie holen mich ein...\nDas war's, das war's!!",GameConfig.player_name)
	await novel_interface.show_dialog("Hä? Der Schläger...?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich bemerkte, dass das Muster auf dem Schläger in meiner Hand in fremdartigem Licht zu schimmern begann.\nD-Das ist doch...!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Ich bin eine Hexe, du kannst mich Annie nennen.\n...Sieht so aus, als hättest du Ärger am Hals~", "Blauhaariges Mädchen")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Annie... eine Hexe??\nDas heute ist wirklich kein normaler Ärger mehr...",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Ich habe jede Menge Fragen an dich.\nAber zuerst lösen wir das Problem direkt vor uns!","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Was trägst du da denn...? Alles so schlabberig.\nFürs Kämpfen taugt dieses Outfit überhaupt nicht~", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Ich verpasse dir schnell etwas Passenderes.\nMach dich bereit zum Kämpfen!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("K-Kämpfen?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
