# chapter1_ep5.gd - 第一章第5話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("（去洗手間反復確認過了……）\n（大腦要無法思考了……）",GameConfig.player_name)
	await novel_interface.show_dialog("（狠狠的捏了自己一把）\n（並不是在做夢！）",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（而且感覺自己的身體軟了許多）\n（手感還不錯……）",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("不錯個鬼啊！！\n我在想什麼！！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("可惡啊…昨天明明還很合身的T恤\n一下子就變得這麼大了…",GameConfig.player_name)
	await novel_interface.show_dialog("其實是我的身體變小了吧……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("從鏡子裡看去，映出的是一個穿著不合身衣服的小個子女生，
就像電影裡偷穿男友襯衫的少女一樣……")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("……我為什麼要臉紅啊……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("果然……\n變成女生這種事，跟誰也說不出口吧……",GameConfig.player_name)
	await novel_interface.show_dialog("剛才仔細的檢查了房間。\n唯一的異常是床邊多出一根金屬球棒。",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("昨天的夢裡研究中心遭到了襲擊。\n我用這根球棒戰斗過……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("如果那也能算作戰斗的話……",GameConfig.player_name)
	await novel_interface.show_dialog("最後整座城市都灰飛煙滅了……",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("對了，查一下手機！\n如果真的發生過，這樣的事件一定有報導的！",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("和恐怖襲擊有關的新聞……完全沒有。",GameConfig.player_name)
	await novel_interface.show_dialog("太好了……果然只是夢嗎……",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("咦？這是——？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("『洛斯金盃』在嚴密監視下突然消失。","新聞")
	await novel_interface.show_dialog("洛斯金盃於昨晚在十二組監視設備的注視下，自設置地點憑空消失。","新聞")
	await novel_interface.show_dialog("斯蒂爾蒙特收容研究中心的管理與警備都極為森嚴，發生失竊的可能性極低……","新聞")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("總覺得……我必須再去一趟研究中心才行！",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("關于昨天的夢，還有我身體的事。\n總覺得去了研究所說不定就能明白些什麼了。",GameConfig.player_name)
	await novel_interface.show_dialog("好！出發吧！",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("說來……\n我的樣子，完全是可疑人士吧……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("看到自己映在大樓入口玻璃上的模樣，我還是不禁有些後悔。")
	await novel_interface.show_text_only("襯衫明顯不合身，牛仔褲的褲腳也長得直拖在地上。")
	await novel_interface.show_text_only("最極品的是，右手還拿著金屬球棒。\n但這是唯一的證據了……")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("嗯……一鼓作氣跑到這裡來了，可接下來該怎麼辦啊……",GameConfig.player_name)
	await novel_interface.show_dialog("不像是會發生恐怖襲擊的樣子啊，有那麼多的保\n安。",GameConfig.player_name)
	await novel_interface.show_dialog("不過這也難怪，有收容品消失了嘛……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("……等等，小姑娘。", "警備員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("那邊的小姑娘，站住！！！！", "警備員")
	await novel_interface.show_text_only("說話的是個短髮男人，從袖口露出的手臂線條粗壯，一看就很有力。")
	await novel_interface.show_text_only("那副千錘百鍊過的身材，再加上和藹又燦爛的笑容，簡直像是從摔角電影裡走出來的主角。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("咦！？",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("對，就是在叫你。", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("什麼小姑娘，蠢貨！\n我是……我……是……",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("嗯？總之，昨天有重要的東西不見了。\n我們收到命令要對這一帶進行封鎖。", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("我也有重要的東西不見了……\n十分重要的東西，起床就不見了！")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("現在這裡禁止一般民眾進入，小姑娘妳改天再來吧。", "警備員")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("還有！", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("嚇！又、又怎麼了嗎……？",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("先不說妳拿著球棒到處亂跑這件事，穿成這樣真的很容易著涼。", "警備員")
	await novel_interface.show_dialog("快回家去吧！", "警備員")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("警備員朝我豎起大拇指，又露出了那種耀眼得過分的溫暖笑容。")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("好……好的，那我先走了！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（小姑娘什麼的稱呼，好不習慣啊……）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("嗚——肯定有什麼線索。\n可是進不去……",GameConfig.player_name)
	await novel_interface.show_dialog("……看來也只能先乖乖回去了。",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("咦？我明明一直朝車站的方向走，這條路怎麼有點不對勁？",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("呃？\n怎麼回事？？？",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("我迷路了嗎……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("唧——！\n…věta…hrích…！！","神情古怪的不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("這群人怎麼怪怪的……\n這些家伙……她們在說什麼？",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("嗚哇啊啊啊啊！！！！",GameConfig.player_name)
	await novel_interface.show_dialog("這些傢伙……是衝著我來的！？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…！！","神情古怪的不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("得趕快逃！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("……呼呼……！就算想逃……\n衣服和鞋都這麼松垮，根本跑不快……！",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("呀啊啊啊啊！！！！","神情古怪的不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("要被追上了……\n完了完了！！",GameConfig.player_name)
	await novel_interface.show_dialog("咦？球棒……？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我發現手中球棒上的花紋泛起了異色的光芒\n這、這是……！")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("我是魔女，你可以叫我安妮\n……看來你遇到麻煩了呢~", "藍色頭髮的少女")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("安妮……魔女？？\n我今天遇到的麻煩可不是一般的大……",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("雖然有很多想問你的事情。\n不過先來解決眼前的問題吧！","安妮")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("話說你穿的是什麼嘛……松松垮垮的\n這身衣服太不適合運動了吧~", "安妮")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("我來幫你換一件合身的衣服\n要準備打架了哦！", "安妮")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("打、打架？！",GameConfig.player_name)

	print("=== 第一章第5話結束 ===")

	# 調用劇情結束函數
	await novel_interface.end_story_episode(0.5)


