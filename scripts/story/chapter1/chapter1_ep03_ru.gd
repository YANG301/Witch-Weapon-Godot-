# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("С этого поста давно нет ответа, сходи проверь там—", "Мужской голос A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Есть!", "Мужской голос B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Я принесу датчик сердцебиения, а ты смотри в оба!", "Мужской голос A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Плохо дело, здесь мне не спрятаться…",GameConfig.player_name)
	await novel_interface.show_dialog("Из их поля зрения мне не уйти. Единственный шанс — дождаться, пока они разделятся, и напасть на одного из них исподтишка.",GameConfig.player_name)
	await novel_interface.show_dialog("Наверное, сработает…\nРаз уж та женщина и голыми руками сумела вырубить одного…",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Надо найти что-нибудь вместо оружия…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На стене коридора висела металлическая бита. На маленькой табличке под ней значилось: «Лайбона. Свободный свет…»")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Наверное, это экспонат…\nЯ просто одолжу его ненадолго, ага, совсем ненадолго…",GameConfig.player_name)
	await novel_interface.show_dialog("……\n……",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ну что ж… пора!\nХа—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("БАМ!!!")
	await novel_interface.show_text_only("Я со всей силы врезал человеку в маске по затылку, и раздался оглушительный грохот. Э?.. Разве звук должен быть таким громким?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Но противник не рухнул, как я надеялся, а, сверкая яростью в глазах, обернулся ко мне.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("В играх всё было не так!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Ты кто такой?!", "Человек в маске A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("Человек в маске тут же замахнулся на меня прикладом. Я поспешно вскинул биту, пытаясь закрыться.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Плохо—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("Чудовищная сила удара через биту отозвалась болью в руках и плечах; пока я, стиснув зубы, держался, человек в маске внезапно ударил меня ногой.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("Ботинок со всей силы врезался мне в беззащитный живот.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Меня отшвырнуло ударом, я проломил перила и рухнул прямо на этаж\nниже.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("А-а-а!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Чёрт, тот мелкий, что напал на меня исподтишка, свалился вниз.\nЯ его добью!", "Человек в маске A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("…Мне надо бежать…\n…нужно спрятаться… в тени… того экспоната…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Подожди… капитан только что сообщил: систему самоуничтожения противокражного устройства удалось отключить.", "Человек в маске B")
	await novel_interface.show_dialog("Не теряй время, немедленно собираемся в конференц-зале!\nПока он очнётся, мы уже будем далеко.", "Человек в маске B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Есть!", "Человек в маске A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("Сознание… медленно… меркнет…\nЛилю…",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тем временем в конференц-зале")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Похоже, эти люди проникли сюда под оптической маскировкой…","Лилю")
	await novel_interface.show_dialog("Они воспользовались тем, что часть антиоптической системы обнаружения хранилища была выведена на техобслуживание. Значит, кто-то изнутри слил информацию.","Лилю")
	await novel_interface.show_dialog("Пока неясно, кто они такие… Остаётся лишь ждать удобного момента.","Лилю")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Хм-хм-хм, ха-ха-ха—","Главарь в маске")
	await novel_interface.show_dialog("Наконец-то мы вернули его…!", "Главарь в маске")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Это же— «Кубок Лоса»?!","Лилю")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("«Гетеропредмет», найденный исследовательской группой на островах Лос, внезапно возникших в центре Тихого океана. Снаружи чашу украшают четыре драгоценных камня.")
	await novel_interface.show_text_only("Внутри чаши плещется красная жидкость, но её невозможно ни вылить, ни коснуться — словно призрак, она будто вовсе не имеет материальной формы…")
	await novel_interface.show_text_only("Старики в институте перепробовали всё, но так и не поняли, что это за штука…")
	await novel_interface.show_text_only("Через некоторое время её уровень угрозы понизили до категории «Safe»,\nразрешив проводить открытые исследования…")
	await novel_interface.show_dialog("Цк, разве что те камушки ещё чего-то стоят.","Лилю")
	await novel_interface.show_dialog("Но драгоценные камни и сама чаша срослись на молекулярном уровне…","Лилю")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Я сам отделю их от этой нечистой штуки!!", "Главарь в маске")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Отделишь? Да как это вообще возможно—","Лилю")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
