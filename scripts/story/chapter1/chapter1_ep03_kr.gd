# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("이쪽 초소에서 계속 응답이 없다. 너, 저쪽 가서 확인해——", "남자 목소리A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("네!", "남자 목소리B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("난 심박 감지기를 가져오지. 넌 여기 잘 지켜봐!", "남자 목소리A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("젠장, 여기선 숨을 수도 없잖아……",GameConfig.player_name)
	await novel_interface.show_dialog("저놈들 시야엔 사각이 없어. 둘로 갈라지는 순간 한 놈을 기습하는 수밖에.",GameConfig.player_name)
	await novel_interface.show_dialog("아마…… 괜찮겠지.\n그 여자도 맨손으로 저놈을 쓰러뜨렸으니까……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("무기로 쓸 만한 걸 찾아야 해……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("복도 벽에는 금속 배트 하나가 걸려 있었고, 아래 명패의 작은 글씨에는 「라이보나 자유광……」이라고 적혀 있었다.")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("전시품이겠지……\n아냐, 잠깐만 빌리는 거야. 그래, 잠깐만……",GameConfig.player_name)
	await novel_interface.show_dialog("…………",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("좋아…… 간다!\n하아——!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("쾅!!!")
	await novel_interface.show_text_only("온 힘을 다해 복면 남자의 뒤통수를 후려쳤다. 엄청난 굉음이 울렸다. 뭐야…… 이렇게까지 소리가 크다고?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("하지만 놈은 내가 기대한 것처럼 쓰러지지 않았고, 분노가 서린 눈으로 몸을 돌렸다.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("게임이랑 전혀 다르잖아!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("누구냐!", "복면남A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("복면 남자가 재빨리 총 개머리판을 휘둘러 달려들었다. 나는 허둥지둥 배트를 움켜쥐고 막아냈다.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("젠장——",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("압도적인 힘이 배트를 타고 양손과 어깨로 그대로 밀려든다. 이를 악물고 버티는 순간, 복면 남자가 갑자기 발길질을 날렸다.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("발끝이 무방비한 내 복부를 세차게 후려찼다.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("그대로 걷어차인 나는 난간을 부러뜨리며 아래층으로 곤두박질쳤다.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("아아아아악!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("빌어먹을, 아까 날 습격하던 꼬맹이가 아래층으로 떨어졌어.\n내가 가서 끝장내고 오지!", "복면남A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("……빨리 도망쳐야 해……\n……저 전시물…… 그림자 속으로…… 숨어야……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("잠깐…… 방금 대장한테 연락 왔다. 자폭 방지 장치 해제에 성공했대.", "복면남B")
	await novel_interface.show_dialog("시간 끌지 마. 당장 회의실로 집합해!\n저 녀석이 깨어날 때쯤이면 우린 이미 철수하고도 남았어.", "복면남B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("네!", "복면남A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("의식이…… 점점…… 흐려져……\n마리루……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("그 시각, 회의실에서는——")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("녀석들, 광학 위장으로 잠입한 모양이네.","마리루")
	await novel_interface.show_dialog("수용 시설의 광학 탐지 설비 일부가 점검 중이던 틈을 노린 모양이네…… 내부에서 정보가 샌 게 틀림없어.","마리루")
	await novel_interface.show_dialog("아직 놈들의 정체는 모르겠어…… 지금은 기회를 기다리는 수밖에 없겠네.","마리루")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("후후후…… 하하하——","복면 리더")
	await novel_interface.show_dialog("드디어 되찾았다……!", "복면 리더")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("저건——『로스 금잔』!?","마리루")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("태평양 중앙에 갑자기 나타난 로스 군도에서 조사단이 찾아낸 『이물질』. 잔 바깥쪽에는 네 개의 보석이 박혀 있다.")
	await novel_interface.show_text_only("잔 안에는 붉은 액체 같은 물질이 담겨 있지만, 그것은 부을 수도 만질 수도 없고, 환영처럼 실체가 없는 듯 보인다……")
	await novel_interface.show_text_only("연구소의 늙은이들은 온갖 방법을 다 써봤지만 그게 대체 뭔지 끝내 밝혀내지 못했어……")
	await novel_interface.show_text_only("얼마 후 그것의 위협 레벨은 『Safe』로 떨어졌고\\n공개 연구 허가가 났다……")
	await novel_interface.show_dialog("쳇, 저 보석들만 해도 제법 값이 나가겠군.","마리루")
	await novel_interface.show_dialog("하지만 보석과 잔 본체는 분자 단위에서 완전히 융합되어 있잖아……","마리루")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("그렇다면 내가 직접 분리해 주마, 이 불결한 물건을!!", "복면 리더")
	novel_interface.character_dark()
	await novel_interface.show_dialog("분리한다고? 그게 가능할 리가 없잖아——","마리루")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
