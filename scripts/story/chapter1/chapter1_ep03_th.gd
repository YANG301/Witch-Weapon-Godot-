# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("จุดเฝ้ายามทางนี้ไม่ตอบกลับมาเลย ไปตรวจทางนั้นหน่อย—", "เสียงผู้ชาย A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("ครับ!", "เสียงผู้ชาย B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("ฉันจะไปเอาเครื่องตรวจจับชีพจรมา นายคอยจับตาดูไว้!", "เสียงผู้ชาย A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("แย่แล้ว ซ่อนอยู่ตรงนี้ไม่รอดแน่...",GameConfig.player_name)
	await novel_interface.show_dialog("สายตาพวกมันไม่มีจุดบอดให้หนีเลย โอกาสเดียวคือตอนที่พวกมันแยกกันแล้วลอบโจมตีสักคน",GameConfig.player_name)
	await novel_interface.show_dialog("คงไม่มีปัญหาหรอกมั้ง...\nในเมื่อผู้หญิงคนนั้นยังล้มอีกฝ่ายได้ด้วยมือเปล่า...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("ต้องหาอะไรมาเป็นอาวุธ...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("บนผนังทางเดินมีไม้เบสบอลโลหะแขวนอยู่ ใต้แผ่นป้ายมีตัวหนังสือเล็ก ๆ เขียนว่า “ไลโบนา แสงอิสระ...”")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("น่าจะเป็นของจัดแสดงสินะ...\nแค่ยืมชั่วคราว อืม ๆ ยืมชั่วคราว...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("ถ้างั้น...ลุยล่ะ!\nฮ่า—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("ปัง!!!")
	await novel_interface.show_text_only("ฉันเหวี่ยงสุดแรงฟาดไปที่ท้ายทอยของชายสวมหน้ากาก เกิดเสียงดังสนั่น เอ๊ะ...เสียงดังขนาดนี้เลยเหรอ?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("แต่อีกฝ่ายกลับไม่ล้มลงอย่างที่ฉันหวังไว้ กลับหันมาด้วยแววตาเดือดดาล")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("มันไม่เหมือนในเกมเลยนี่หว่า!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("ใครน่ะ!", "ชายสวมหน้ากาก A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("ชายสวมหน้ากากเหวี่ยงพานท้ายปืนเข้าใส่ทางนี้อย่างรวดเร็ว ฉันรีบกำไม้เบสบอลขึ้นมารับไว้")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("ไม่ดีแล้ว—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("แรงมหาศาลของอีกฝ่ายถาโถมผ่านไม้เบสบอลลงมาที่มือทั้งสองและหัวไหล่ของฉัน ขณะที่ฉันกัดฟันทนอยู่ ชายสวมหน้ากากก็เตะเข้ามาอย่างฉับพลัน")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("เท้านั้นกระแทกเข้าที่ท้องฉันอย่างจังในจังหวะที่ไม่ทันตั้งตัว")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("ร่างของฉันที่โดนเตะกระเด็นไปชนราวกันตกจนหัก แล้วร่วงลงไปยัง\nชั้นล่างตรง ๆ")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("อ๊าก!!!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("แม่งเอ๊ย เด็กเมื่อกี้ที่ลอบตีฉันตกลงไปชั้นล่างแล้ว\nฉันจะไปเก็บมันเอง!", "ชายสวมหน้ากาก A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...ฉันต้องรีบหนี...\n...ต้องไปซ่อน...ในเงา...ของของจัดแสดงชิ้นนั้น...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("เดี๋ยวก่อน...หัวหน้าส่งข่าวมาแล้วว่า ปลดล็อกระบบป้องกันขโมยแบบทำลายตัวเองสำเร็จแล้ว", "ชายสวมหน้ากาก B")
	await novel_interface.show_dialog("อย่าเสียเวลา รีบไปรวมตัวที่ห้องประชุมเดี๋ยวนี้!\nกว่าหมอนั่นจะฟื้น พวกเราก็ถอนตัวไปแล้ว", "ชายสวมหน้ากาก B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("ครับ!", "ชายสวมหน้ากาก A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("สติ...ค่อย ๆ...เลือนราง...\nลิลิ่ว...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ขณะเดียวกัน ภายในห้องประชุม")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("ดูเหมือนว่าพวกนี้จะแฝงตัวเข้ามาด้วยการพรางตัวทางแสง...","ลิลิ่ว")
	await novel_interface.show_dialog("ถึงกับอาศัยช่วงที่ระบบตรวจจับต้านการพรางแสงของสถานกักกันกำลังซ่อมบำรุงบางส่วน แปลว่าต้องมีคนวงในปล่อยข่าวแน่","ลิลิ่ว")
	await novel_interface.show_dialog("ยังไม่รู้ว่าพวกมันมาจากไหน...ทำได้แค่รอโอกาสแล้วล่ะ","ลิลิ่ว")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("หึหึหึ ฮ่า ๆ ๆ —","หัวหน้าชายสวมหน้ากาก")
	await novel_interface.show_dialog("ในที่สุดพวกเราก็เอามันกลับคืนมาได้...!", "หัวหน้าชายสวมหน้ากาก")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("นั่นมัน—『จอกโลส』!?","ลิลิ่ว")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("『วัตถุต่างภาวะ』ที่คณะสำรวจค้นพบบนหมู่เกาะโลสซึ่งจู่ ๆ ก็โผล่ขึ้นมากลางมหาสมุทรแปซิฟิก ตัวจอกด้านนอกประดับด้วยอัญมณีสี่เม็ด")
	await novel_interface.show_text_only("ภายในจอกมีสสารคล้ายของเหลวสีแดงอยู่ แต่สิ่งนั้นทั้งเทออกมาไม่ได้และสัมผัสก็ไม่ได้ ราวกับเป็นภาพลวงตาที่ไม่มีตัวตนจริง...")
	await novel_interface.show_text_only("พวกตาแก่ในสถาบันวิจัยลองทุกวิถีทางแล้วก็ยังไม่เข้าใจว่ามันคืออะไรกันแน่...")
	await novel_interface.show_text_only("ผ่านไปพักหนึ่งพวกเขาก็ลดระดับภัยคุกคามของมันลงเป็น『Safe』\nและอนุญาตให้วิจัยแบบเปิดเผยได้...")
	await novel_interface.show_dialog("ชิ ก็ดูมีค่าอยู่แค่อัญมณีพวกนั้นเท่านั้นแหละ","ลิลิ่ว")
	await novel_interface.show_dialog("แต่อัญมณีกับตัวจอกหลอมรวมเป็นเนื้อเดียวกันในระดับโมเลกุล...","ลิลิ่ว")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("งั้นข้าจะเป็นผู้แยกมันออกจากกันเอง ของอัปมงคลชิ้นนี้!!", "หัวหน้าชายสวมหน้ากาก")
	novel_interface.character_dark()
	await novel_interface.show_dialog("แยกออกงั้นเหรอ? จะทำได้ยังไง—","ลิลิ่ว")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
