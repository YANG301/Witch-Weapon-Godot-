# chapter1_ep2.gd - Chapter 1 Episode 2
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("Вход выполнен успешно!","Системный голос")
	await novel_interface.show_dialog("Ваш ID: 2519G1911\nИмя: "+GameConfig.player_name,"Системный голос")
	await novel_interface.show_dialog("Возраст: 15 лет\nПол: мужской","Системный голос")
	await novel_interface.show_dialog("Добро пожаловать в Центр содержания и исследований «Стилмонт» Пятого Академгорода. Крупнейшее учреждение по содержанию и исследованию «гетероматерии» на территории Синтоёсу.","Системный голос")
	await novel_interface.show_dialog("«Гетероматерия», также известная как «чудо», — общее название предметов и инструментов, которые при определённых условиях способны вызывать сверхъестественные физические явления.","Системный голос")
	await novel_interface.show_dialog("Сегодня в исследовательском центре день открытых дверей.\nЦентр открыт для горожан и инспекционных делегаций из других Академгородов.","Системный голос")
	await novel_interface.show_dialog("Как важная часть общественного просвещения,\nздесь будут представлены некоторые «чудеса» и результаты исследований…","Системный голос")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("Повезло!~ Всё-таки успел до закрытия!",GameConfig.player_name)
	await novel_interface.show_dialog("Надо же, все лифты в холле не работают, но, к счастью, я нашёл запасной грузовой лифт, который ещё ходил.",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("В общем, мне ведь всего-то нужно послушать лекцию, получить штамп и заработать зачёт, да?",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Но… почему на этом этаже вообще ни души?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я шёл по коридору второго этажа, озираясь по сторонам.")
	await novel_interface.show_text_only("Вообще-то в таком месте и обычно людей немного, но сейчас здесь не было видно совсем никого.")
	await novel_interface.show_text_only("К тому же в воздухе стоял запах больничного дезинфицирующего средства, и я невольно представил уборщиков, которые после закрытия наводят здесь порядок.")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("Неужели лекция уже закончилась?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Подыскивая «конференц-зал», где должна была проходить лекция, я свернул к винтовой лестнице.")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Вот же влип… зря я всё-таки запустил ту игру…",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Эта кнопка «следующий ход» — чистый яд… а-а-а-а-мм\n!!!?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Вдруг что-то зацепило меня за шею и резко дёрнуло назад!")
	await novel_interface.show_text_only("Когда я уже почти потерял равновесие, затылок уткнулся во что-то мягкое, но в то же время упругое.")
	await novel_interface.show_text_only("Когда я пришёл в себя, меня уже втянули в узкий проход за поворотом лестницы, где вокруг было куда темнее.")
	await novel_interface.show_dialog("Угх—!!\nМмф—!!!",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("Я ещё даже не успел вскрикнуть, как чья-то ладонь крепко зажала мне рот. Краем глаза я смог разглядеть лишь женщину в белом халате—")
	await novel_interface.show_text_only("Сейчас она прижималась спиной к стене и одной рукой зажимала мне рот.")
	await novel_interface.show_text_only("А моя щека была плотно втиснута в её грудь… густой сладкий аромат без конца щекотал нос.")
	await novel_interface.show_dialog("(Э?.. О-очень… большая!!!! Моё лицо прямо утонуло!!)",GameConfig.player_name)
	await novel_interface.show_dialog("(Что вообще происходит!! Кто она такая!?)",GameConfig.player_name)
	await novel_interface.show_dialog("Тсс—! Ни звука!", "Женщина в белом халате")
	await novel_interface.show_text_only("Женщина позади меня нарочно понизила голос, но в её словах чувствовалась властность, не терпящая возражений.")
	await novel_interface.show_text_only("У меня в голове всё смешалось, дышать становилось тяжело,\nи я смог лишь едва заметно кивнуть в знак покорности…")
	await novel_interface.show_text_only("Хотя рот мне всё ещё закрывали рукой, давление на шею чуть\nослабло.")
	await novel_interface.show_text_only("Я сфокусировал взгляд перед собой и смутно разглядел на её бейдже, приколотом к халату на груди, мелкую надпись: Главный учёный…")
	await novel_interface.show_dialog("(Учёный… она сотрудница исследовательского центра?)",GameConfig.player_name)
	await novel_interface.show_text_only("Только сейчас я заметил, что смотрит она вовсе не на меня: она повернула голову в другую\nсторону и сосредоточенно всматривалась в коридор.")
	await novel_interface.show_text_only("Издалека по коридору донеслись торопливые тяжёлые шаги.")
	await novel_interface.show_dialog("Докладываю, здесь никого.", "Мужской голос A")
	await novel_interface.show_dialog("Но тут действительно есть отдельный грузовой лифт. Пойду отключу его вручную.", "Мужской голос A")
	await novel_interface.show_dialog("(И тот человек, что только что пробежал мимо, кажется, был в маске и держал в руках… пистолет?)",GameConfig.player_name)
	await novel_interface.show_dialog("Сюда проникли захватчики. Не хочешь умереть — не дёргайся.", "Женщина в белом халате")
	await novel_interface.show_dialog("(Захват… Что вообще происходит…)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Пока я стоял как вкопанный, женщина уже молнией выскользнула наружу.")
	await novel_interface.show_text_only("Через несколько секунд раздался глухой удар и звук, похожий на хруст ломающейся кости.")
	await novel_interface.show_text_only("Звука падения, которого я ожидал, не было: она подхватила человека в маске сзади,\nпотом втащила его обратно в проход и отобрала пистолет.")
	await novel_interface.show_dialog("Он же…?!",GameConfig.player_name)
	await novel_interface.show_text_only("Женщина даже не взглянула на меня. Она ловко открыла дверь электрощитовой у стены\nи, вскинув каблук, одним пинком зашвырнула туда обмякшего громилу.")
	await novel_interface.show_text_only("На ней были белая рубашка и облегающая короткая юбка, но двигалась она быстро, чётко и без лишних движений.")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Хм~ Похоже, какое-то время сюда никто не сунется.", "Лилю")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Отряхнув руки, будто только что избавилась от крупного мусора, она легко обернулась ко мне.")
	await novel_interface.show_text_only("Мой мозг уже не справлялся с тем, что только что произошло, и я мог лишь тупо смотреть на неё.")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(Если присмотреться, эта девушка очень красивая!)\n(И фигура у неё прямо как у модели…)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(Но на бейдже у неё на груди ведь чётко написано «учёный».)",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(Значит, всё, что только что случилось, мне просто померещилось!)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Верно. Никакого здоровенного мужчины в маске в электрощитовой сейчас не существует.")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("С чистой совестью придя к такому выводу, я перевёл взгляд на её ноги…")
	await novel_interface.show_text_only("(Наверное, работать рядом с такой девушкой — просто мечта…)\n(Быть исследователем гетероматерии — тоже неплохая профессия.)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Эй? Мелкий, ты вообще куда уставился?", "Лилю")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Говоря это, она вытащила магазин пистолета и проверила патроны.")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(Хватит обманывать самого себя!!!)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("З-здравствуйте.\nВы… кто?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Ну… можешь звать меня Лилю.\nВообще-то сегодня я должна была читать скучнейшую лекцию.", "Лилю")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она привычным движением снова собрала пистолет и сунула его в карман халата.")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Но та шайка только что захватила конференц-зал.\nТак что благодаря им лекцию отменили~", "Лилю")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("Лилю… Лилю фон Браун?!",GameConfig.player_name)
	await novel_interface.show_dialog("В-вы ведь и есть лектор, у которого я должен был получить штамп!\nИ ещё учёный SS-класса, признанная Сенатом!",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Хм, этих стариков обвести вокруг пальца проще простого~", "Лилю")
	await novel_interface.show_dialog("Но по твоему виду ясно: ты пришёл сюда просто за зачётом, да?", "Лилю")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("Ум… простите меня!!",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("То ли тебе просто не повезло, то ли ты и правда идиот — надо же было умудриться найти лифт наверх, когда всё уже заблокировано.", "Лилю")
	await novel_interface.show_dialog("Если бы я тебя не заметила, ты бы наверняка беззаботно ввалился прямо в захваченный «конференц-зал».", "Лилю")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Заблокировано…?\nЯ достал телефон — сигнала действительно не было совсем.")
	await novel_interface.show_text_only("Наконец-то я понял, почему все лифты у главного входа в холле остановлены… значит, дело было вовсе не в закрытии!")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Лифт, на котором ты поднялся, тоже уже заблокирован. Так что сиди тихо здесь и жди спасателей из Управления обороны.", "Лилю")
	await novel_interface.show_dialog("А я должна пойти в конференц-зал и посмотреть, что там происходит. Если сюда кто-то придёт — прячься.", "Лилю")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Н-но… ты же одна…",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ты всё понял?!", "Лилю")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Понял!!",GameConfig.player_name)

	print("=== Chapter 1 Episode 2 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
