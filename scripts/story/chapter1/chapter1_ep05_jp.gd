# chapter1_ep5.gd - 第1章第5話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("（トイレで何回も確認したけど……）\\n\\n（思考が現実に追い付かないな……）",GameConfig.player_name)
	await novel_interface.show_dialog("（思いっ切り、自分をつまんでみたけど）\\n\\n（これは夢じゃない！）",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（しかも身体つきがずいぶん柔らかくなってる）\n（……って、触り心地は悪くない……）",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("何が良いかもだよっ！！\\n何考えてるんだよ俺っ！！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("くそっ……昨日までピッタリだったシャツが……\\nこんなに大きくなるなんて……",GameConfig.player_name)
	await novel_interface.show_dialog("違うか……\\n俺の身体がちっちゃくなってるだけか……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("鏡の中には、サイズの合わない服を着ている\\n小柄な少女が。\\n映画とかで、よくある彼氏のシャツを羽織る\\n少女みたいだ……")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("……なんで、俺が照れてるんだよ……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("やっぱり……\\n女の子になったなんて、誰にも言えないよな……",GameConfig.player_name)
	await novel_interface.show_dialog("さっき部屋をくまなく調べた。\n異変と言えるのは、ベッド脇に金属バットが一本増えていたことくらいだ。",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("昨日の夢では研究センターが襲撃されていて、\nこの金属バットで俺は戦っていた……",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("アレが戦ったと呼べるモノであればだけど……",GameConfig.player_name)
	await novel_interface.show_dialog("その後は街全体が灰のように崩れ去った……",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("そうだ！　携帯！\\n\\nあんな大事件が本当にあったなら、\\n絶対に報道されてるはず！",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("テロ襲撃などのニュースは……ないな……",GameConfig.player_name)
	await novel_interface.show_dialog("よかった、やっぱりただの夢か……",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("うん？　これは……？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("『ロス・ゴールド』\\n厳重監視の中で突如姿を消す。","ニュース")
	await novel_interface.show_dialog("『ロス・ゴールド』は12か所の警備設備による\\n厳重監視体制が敷かれていたにも関わらず、\\n展示場所から突如消失。","ニュース")
	await novel_interface.show_dialog("スティールマウント研究センターの\\n管理、警備機能は非常に高く、\\n盗難の可能性は極めて低いとされる……","ニュース")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("どうやら……\\n\\nもう一度研究センターへ行く必要が、\\nあるみたいだ。",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("昨日見た夢のことも、今のこの身体のことも。\n研究所へ行けば、何か分かる気がするんだ。",GameConfig.player_name)
	await novel_interface.show_dialog("よし！　行ってきますっ！",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("とはいえ……\\n俺、完全に不審者だな……",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ビル入り口のガラスに映った自分の姿を見て、\\n少し後悔した。")
	await novel_interface.show_text_only("明らかにシャツのサイズが合ってないし、\\nジーンズも長すぎて地面を引きずっている。")
	await novel_interface.show_text_only("最悪なのは、右手に金属バットまで握ったままだったことだ。\nでも、これが唯一の証拠なんだ……")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("うーん……\\n何も考えずにここまで来ちゃったけど、\\nこれからどうしようかな。",GameConfig.player_name)
	await novel_interface.show_dialog("こんなに警備員がいるんだ。\nとてもテロが起きた場所には見えないけど……",GameConfig.player_name)
	await novel_interface.show_dialog("でも、収容品が消えたっていうなら無理もないか……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("……おい、そこのお嬢ちゃん。", "警備員")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("そこのお嬢ちゃん、止まりなさい！！！！", "警備員")
	await novel_interface.show_text_only("短髪で、腕っ節の強そうな男がこちらに向かって言い放ってくる。")
	await novel_interface.show_text_only("鍛えられた身体と親切そうな笑顔で、\\nどこかのレスリング動画の主人公のようだ。")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("えっ！？",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ああ、君のことだよ。", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("誰がお嬢ちゃんだ、この野郎！\\n\\n俺は……俺……は……？",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("昨日、この施設で物凄く大事なものが\\n無くなっちまったんだ。\\n今は上から、ここら一帯を封鎖するように\\n命じられていてな。", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("俺も大事なものがなくなったよ……\\n\\n本当に大事なモノがね……")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("そういうわけで今は一般人の立ち入り禁止だ。\\nまた日を改めてくれ、お嬢ちゃん。", "警備員")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("……それとっ！", "警備員")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("へっ！？　ま……まだなにか？",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("お嬢ちゃんが金属バットを振り回している件はひとまず置いておくとして、その格好じゃ風邪を引くぞ。", "警備員")
	await novel_interface.show_dialog("早く家に帰りなさい。", "警備員")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("警備員は俺に親指を立てて、\\n眩しい笑顔を見せた。")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("は……はい、それじゃ！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("（お嬢ちゃんって呼ばれ方、慣れないな……）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("くぅ……手がかりはあるはずなんだけど、\\n中に入れないと…どうにも……",GameConfig.player_name)
	await novel_interface.show_dialog("…………大人しく帰るしかないか。",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("あれ？駅に向かってたはずなのに……\\nなんか道が違うような……？",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("えっ？\nどういうこと？？？",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("俺、迷子になったのか……？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("チッ——！\n…věta…hrích…！！","様子のおかしい不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("なんだ？変な連中だな……\\n何か言ってるけど……？",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("うわあああああ！！！！",GameConfig.player_name)
	await novel_interface.show_dialog("あいつら、こっちに向かってくる！？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…！！","様子のおかしい不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("早く逃げないと！",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("──はぁ、はぁ……っ！　けど逃げようにも……\\n服と靴がぶかぶかで、無理……！",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("ァアアアアアッ！！！！","様子のおかしい不良")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("ダメ、ダメだッ！！\\nも、もう追いつかれる――\\n――――――",GameConfig.player_name)
	await novel_interface.show_dialog("えっ？　バット……？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("気付けば、手にしたバットの模様が異様な光を放っていた。\nこ、これは……！？")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("私は魔女。アニーと呼んで。\n……どうやら、ずいぶんなトラブルに巻き込まれてるみたいね~", "青髪少女")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("アニー……魔女？？\n今日の俺のトラブルは、そんな一言じゃ済まないくらい重いんだけど……",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("聞きたいことは山ほどあるけど、\nまずは目の前の問題を片付けましょう！","アニー")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("っていうか、その服装……だぶだぶじゃん。\\nそれじゃ動きにくいでしょ？", "アニー")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("ほら、私がぴったりの服に着替えさせてあげる！\\nそれから……ケンカの時間よッ！", "アニー")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ケ、ケンカ！？",GameConfig.player_name)

	print("=== 第1章第5話終了 ===")

	# エピソード終了処理
	await novel_interface.end_story_episode(0.5)
