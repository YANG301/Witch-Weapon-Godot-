# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("...Huff, huff... aunque no entiendo qué está pasando,\n¿se supone que... hemos ganado...?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("...Eso parece.","Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¿Quién demonios eres?!\n¡¿De dónde has salido?!",GameConfig.player_name)
	await novel_interface.show_dialog("¡¿Qué eran esas cosas que me atacaron?!\n¡¿Y qué demonios es este bate?!",GameConfig.player_name)
	await novel_interface.show_dialog("¡¿Qué le pasa a este lugar?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("¡Cálmate!\nResponderé una por una a tus preguntas, hasta donde yo sé.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Pero yo tampoco entiendo la situación mucho mejor que tú.\nDe hecho, también me gustaría saber quién eres...", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Perdón. Estoy demasiado alterado...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("No pasa nada.\nAh, cierto, todavía no nos hemos presentado como es debido.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Me llamo Annie Bass.\nLlámame Annie~", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Me llamo "+GameConfig.player_name+". Mucho gusto.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"... un placer.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Tu nombre suena muy masculino. Qué guay~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("¿Qué pasa? ¿Por qué te sorprendes tanto?","Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, ahora que lo dices...\nAhora mismo... soy una chica...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("¿Eh? Pero si eres una chica.\nMira, esa ropa transformada te queda bastante bien, ¿no?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Qué mona, qué mona...\nToma este «traje de combate» como regalo de bienvenida~", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...¿Traje de combate?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("¡¡No, no— aaaaaaaahhhhh!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Cuando reaccioné, me di cuenta de que\n¡¡iba vestida completamente con ropa de chica!!")
	await novel_interface.show_text_only("Un uniforme marinero...\ny una falda tan corta que da vergüenza...!")
	await novel_interface.show_text_only("¿Así se siente llevar medias...? ")
	await novel_interface.show_dialog("Y además, esa sensación de opresión en el pecho no será... (se toca)",GameConfig.player_name)
	await novel_interface.show_dialog("¡¡Aaaaaaahhhh!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Además, la chaqueta combina muy bien con el color de tu pelo~\nEs un diseño perfecto para moverse.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mmm...? ¿Qué pasa~~?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Porque...\nporque...",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
