# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("...Hah... haa... même si je ne comprends toujours pas ce qui se passe,\nça veut dire qu'on... a gagné... ?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("...On dirait bien.","Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Q-qui es-tu exactement ?!\nTu sors d'où, au juste ?!",GameConfig.player_name)
	await novel_interface.show_dialog("C'était quoi, ces types qui m'ont attaqué ?!\nEt cette batte, qu'est-ce que c'est ?!",GameConfig.player_name)
	await novel_interface.show_dialog("Et qu'est-ce qui se passe ici ?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Calme-toi !\nDans la limite de ce que je sais, je répondrai à toutes tes questions une par une.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Mais moi aussi, je suis dans le flou total.\nÀ vrai dire, j'aimerais bien savoir qui tu es, moi aussi...", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Désolé... j'étais trop paniqué.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ne t'en fais pas.\nD'ailleurs, on ne s'est même pas encore présentés correctement.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Je m'appelle Annie Bass.\nAppelle-moi juste Annie~", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Moi, c'est "+GameConfig.player_name+".\nEnchanté.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"... le plaisir est partagé.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Ton nom sonne un peu comme celui d'un garçon. C'est classe~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("?!", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Quoi ? Pourquoi cette tête-là ?","Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, c'est vrai... moi, là maintenant...\nje suis une fille...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hein ? Mais tu es une fille, voyons.\nRegarde, la tenue que j'ai faite apparaître pour toi te va très bien, non ?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Adorable, adorable...\nConsidère cette « tenue de combat » comme mon cadeau de bienvenue~", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Une tenue de combat ?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("Ah ah — AAAAAAAAAH !!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Ce n'est qu'en retrouvant mes esprits\nque j'ai réalisé que je portais une tenue féminine complète !!")
	await novel_interface.show_text_only("Un uniforme marin...\net une jupe si courte que c'en est embarrassant... !")
	await novel_interface.show_text_only("La sensation de ces collants sur mes jambes...\nc'est ça que ça fait... ?")
	await novel_interface.show_dialog("Et cette sensation de compression au niveau de la poitrine, ce ne serait pas... (touche)",GameConfig.player_name)
	await novel_interface.show_dialog("AAAAAAAAAH !!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("En plus, la veste va très bien avec la couleur de tes cheveux~\nC'est un modèle parfait pour bouger.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Hein...? Qu'est-ce qu'il y a~~ ?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Parce que...\nParce que...",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
