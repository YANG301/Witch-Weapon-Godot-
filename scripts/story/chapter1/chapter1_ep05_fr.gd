	await novel_interface.show_dialog("Et puis !", "Agent de sécurité")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Qu-quoi ? Il y a... autre chose... ?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je vais faire comme si je n'avais pas vu qu'une petite fille se promène partout avec une batte, mais habillée comme ça tu vas attraper froid.", "Agent de sécurité")
	await novel_interface.show_dialog("Rentre chez toi !", "Agent de sécurité")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("L'agent de sécurité leva le pouce vers moi, puis me gratifia encore une fois de son sourire chaleureux et éblouissant.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("D-d'accord... à bientôt !",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Je ne m'habitue vraiment pas à ce qu'on m'appelle « petite fille »...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh— il doit forcément y avoir un indice là-dedans.\nMais je ne peux pas entrer...",GameConfig.player_name)
	await novel_interface.show_dialog("...Je n'ai plus qu'à rentrer bien sagement, j'imagine.",GameConfig.player_name)
