	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("J'ai l'impression... qu'il faut absolument que j'aille de nouveau au centre de recherche !",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("À propos du rêve d'hier, et de ce qui est arrivé à mon corps.\nJ'ai le sentiment qu'en allant là-bas, je comprendrai peut-être enfin quelque chose.",GameConfig.player_name)
