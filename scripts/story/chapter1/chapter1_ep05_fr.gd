	await novel_interface.show_text_only("En voyant mon reflet dans la vitre à l'entrée du bâtiment, j'ai tout de même eu quelques regrets.")
	await novel_interface.show_text_only("La chemise est clairement trop grande, et les jambes du jean traînent carrément par terre.")
	await novel_interface.show_text_only("Le pire du pire, c'est que je tiens encore cette batte métallique dans la main droite.\nMais c'est la seule preuve qu'il me reste...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Bon... je suis venu ici d'un seul élan, mais qu'est-ce que je suis censé faire maintenant ?",GameConfig.player_name)
	await novel_interface.show_dialog("On n'a pas du tout l'impression qu'un attentat ait pu se produire ici,\nil y a tellement d'agents de sécurité.",GameConfig.player_name)
	await novel_interface.show_dialog("Enfin, c'est logique aussi... un objet confiné a disparu...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("... Attends un peu, petite.", "Agent de sécurité")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
