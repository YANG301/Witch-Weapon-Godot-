	await novel_interface.show_dialog("Euh ?\nQu'est-ce qui se passe ???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Je suis complètement perdu... ?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Kiiiih — !\n...věta...hřích... !!","Délinquante à l'air étrange")
