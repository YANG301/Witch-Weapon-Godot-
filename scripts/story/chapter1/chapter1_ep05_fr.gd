	await novel_interface.show_dialog("Aucune trace d'un attentat ou de quoi que ce soit d'approchant...",GameConfig.player_name)
	await novel_interface.show_dialog("Ouf... donc ce n'était vraiment qu'un rêve... ?",GameConfig.player_name)
