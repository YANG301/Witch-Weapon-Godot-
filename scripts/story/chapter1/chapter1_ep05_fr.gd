	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Hein ? Je marche vers la gare depuis tout à l'heure, mais cette route a l'air bizarre ?",GameConfig.player_name)
