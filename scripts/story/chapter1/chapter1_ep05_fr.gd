	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Ces filles sont vraiment pas normales...\nQu'est-ce qu'elles racontent... ?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Waaah !!!!",GameConfig.player_name)
	await novel_interface.show_dialog("Ces filles... elles foncent sur moi !?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("...Mors... !","Délinquante à l'air étrange")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Faut que je m'enfuie !",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("...Hah... hah... ! Même si je veux fuir...\navec ces vêtements et ces chaussures qui flottent, impossible de courir vite... !",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Raaahhhhh !!!!","Délinquante à l'air étrange")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Elles vont me rattraper...\nJe suis fichu !!",GameConfig.player_name)
	await novel_interface.show_dialog("Hein ? La batte...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai vu les motifs gravés sur la batte dans ma main rayonner d'une lueur étrange.\nC-c'est quoi, ça... ?!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Je suis une sorcière, tu peux m'appeler Annie.\n...On dirait bien que tu as des ennuis, hein~", "Fille aux cheveux bleus")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Annie... une sorcière ??\nLes ennuis que j'ai aujourd'hui sont loin d'être ordinaires...",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("J'ai plein de choses à te demander.\nMais commençons par régler le problème juste devant nous !","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Et dis-moi, c'est quoi cette tenue...\nDes vêtements aussi flottants, c'est beaucoup trop peu pratique pour se battre~", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Je vais t'aider à enfiler quelque chose à ta taille.\nPrépare-toi, on va se battre !", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Se... se battre ?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
