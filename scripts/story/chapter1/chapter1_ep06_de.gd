# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("...Puh, haa... Ich habe zwar keine Ahnung, was hier los ist,\naber... haben wir gewonnen...?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("...Sieht ganz so aus.","Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("W-Wer bist du eigentlich?!\nWo kommst du überhaupt her?!",GameConfig.player_name)
	await novel_interface.show_dialog("Was waren diese Dinger, die mich angegriffen haben?!\nUnd was ist dieser Schläger überhaupt?!",GameConfig.player_name)
	await novel_interface.show_dialog("Was ist hier passiert?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Beruhige dich!\nSoweit ich Bescheid weiß, beantworte ich dir alles der Reihe nach.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Aber ehrlich gesagt blicke ich genauso wenig durch wie du.\nWer du überhaupt bist, würde ich nämlich auch gern wissen...", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tut mir leid. Ich war völlig durcheinander...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Schon gut.\nApropos, wir haben uns ja noch gar nicht richtig vorgestellt.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Ich heiße Annie Bass.\nNenn mich einfach Annie~", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("... Ich heiße "+GameConfig.player_name+", freut mich.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+" also... ganz meinerseits.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Dein Name klingt irgendwie eher nach einem Jungen. Ziemlich cool~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Was ist? Warum guckst du denn so erschrocken?","Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ach ja, stimmt...\nich bin ja jetzt... ein Mädchen...",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hm? Du bist doch ein Mädchen.\nSieh mal, die Kleidung, die ich dir gezaubert habe, passt doch perfekt, oder?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Total süß, total süß...\nBetrachte dieses „Kampfdress“ einfach als mein Begrüßungsgeschenk~", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Kampfdress?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("J-Jaaa — aaaaaaaaaah!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Erst da wurde mir klar,\ndass ich tatsächlich komplett in Mädchenkleidung steckte!!")
	await novel_interface.show_text_only("Ein Matrosenoberteil...\nund ein Rock, der so kurz ist, dass es schon peinlich wird...!")
	await novel_interface.show_text_only("Fühlen sich Strümpfe an den Beinen etwa so seltsam an...?")
	await novel_interface.show_dialog("Und dieses drückende Gefühl an der Brust ist doch nicht etwa... (tastet)",GameConfig.player_name)
	await novel_interface.show_dialog("Aaaaaaaaaah!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Die Jacke passt übrigens auch super zu deiner Haarfarbe~\nUnd der Schnitt ist perfekt zum Kämpfen.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Hm...? Was ist denn~~?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Weil...\nweil...",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
