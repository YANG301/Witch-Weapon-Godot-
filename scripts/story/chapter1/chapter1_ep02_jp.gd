# chapter1_ep2.gd - 第1章第2話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("ログイン処理を正常に完了致しました！","システム音声")
	await novel_interface.show_dialog("ユーザーID：2519G1911\\n名前：[%rolename%]"+GameConfig.player_name,"システム音声")
	await novel_interface.show_dialog("年齢：15歳\\n性別：男性","システム音声")
	await novel_interface.show_dialog("第五学園都市スティールマウント収容研究センターへようこそ。新豊洲最大の『異質物』収容・研究機関です。","システム音声")
	await novel_interface.show_dialog("『異質物』は『聖痕』とも呼ばれ、\\n特定の状況下では一般常識を超えた、\\n物理現象を引き起こす道具などの総称です。","システム音声")
	await novel_interface.show_dialog("今日は研究センターの学園開放日だ。\n市民や他学園都市からの視察団にも施設が公開されている。","システム音声")
	await novel_interface.show_dialog("一般向け教育の一環として、\n一部の『聖痕』や研究成果が展示されるらしい……","システム音声")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("ラッキー！　なんとか閉館前に間に合った！",GameConfig.player_name)
	await novel_interface.show_dialog("ロビーのエレベーターが全部止まっている中で、\\nまだ動いてた予備の貨物用エレベーターを\\n見つけられるなんて、運が良いいな俺！",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("とにかく、講義を聞いて捺印をもらえば、\\nサクっと単位がもらえるかな？",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("でも……このフロア、なんで誰もいないんだ…？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は2階の廊下を渡りながらあっちこっちを\\n見回した。")
	await novel_interface.show_text_only("こういう場所は普段から人が少ないとはいえ、今は人影すら見当たらない。")
	await novel_interface.show_text_only("しかも空気には病院の消毒液みたいな匂いが漂っていて、閉館後に清掃作業をする人達のことを思い出してしまう。")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("講義、もう終わってたりしないよな？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("『会議室』を探しながら歩いているうちに、気付けば螺旋階段の脇まで来ていた。")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("ヤバイヤバイ、やっぱりあのゲームは\\n夜中までやるべきじゃなかった……",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("『次のラウンド』ってボタンは中毒性ありすぎだ――ああああうぐっ\n！！！？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("突然、何かが首に引っ掛かり、後ろへ一気に引っ張られた！")
	await novel_interface.show_text_only("身体のバランスが崩れると、後頭部に\\n柔らかくしっかりした物を感じた。")
	await novel_interface.show_text_only("気が付けば、そこは狭く周囲が薄暗い\\n階段の隅にある通路。")
	await novel_interface.show_dialog("う゛――！！\nん゛――！！！",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("叫ぶ間もなく口を手で塞がれ、横目にかろうじて見えたのは白衣を着た女の人だった——")
	await novel_interface.show_text_only("その女の人は壁を背にして立ち、片手で俺の口を押さえていた。")
	await novel_interface.show_text_only("頬にぎゅっと彼女の胸がくっ付けられて……\\n未知数の甘い香りが鼻を柔く刺激する。")
	await novel_interface.show_dialog("(えっ？？　で、でかい！！！！　顔が埋まってる！！)",GameConfig.player_name)
	await novel_interface.show_dialog("(何だこれ！？　この人はいったい誰なんだ！？)",GameConfig.player_name)
	await novel_interface.show_dialog("しっ——！　声を出すな。", "白衣の女性")
	await novel_interface.show_text_only("背後の女性は声を小さく抑えている。小さくてもその声には疑う余地の無い威厳があった。")
	await novel_interface.show_text_only("無茶苦茶に混乱していた俺は、\\n小刻みに頷いてただ従うしかできない……")
	await novel_interface.show_text_only("口は塞がれたままだったが、首にかかっていた圧力は少しだけ緩んだ。")
	await novel_interface.show_text_only("目を近くに向けると、彼女の白衣の胸元に付いた名札に小さな文字が見えた。『主席科学者』……")
	await novel_interface.show_dialog("(科学者……？　研究所の人なのか？)",GameConfig.player_name)
	await novel_interface.show_text_only("その時になってようやく、彼女が俺ではなく廊下の先をじっと見つめていると気付いた。")
	await novel_interface.show_text_only("廊下の奥から、切迫した力強い足音が響いてきた。")
	await novel_interface.show_dialog("報告、こちらには誰もいません。", "男性の声A")
	await novel_interface.show_dialog("ですが、独立した貨物用エレベーターが一基あります。\n手動で停止させます。", "男性の声A")
	await novel_interface.show_dialog("(さっき走っていった人、顔を隠してたうえに……銃まで持ってなかったか？)",GameConfig.player_name)
	await novel_interface.show_dialog("ここは侵入されている。死にたくなければ動くな。", "白衣の女性")
	await novel_interface.show_dialog("(し、侵入？　どういう状況なんだ……)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("俺が呆けている間に、その女の人はすっと身を翻して飛び出していった。")
	await novel_interface.show_text_only("数秒後、鈍い衝撃音と、骨が折れるような嫌な音が聞こえた。")
	await novel_interface.show_text_only("人が倒れる音はしなかった。彼女は背後から覆面の男を受け止め、そのまま通路へ引きずり戻し、拳銃を一丁取り上げた。")
	await novel_interface.show_dialog("あの人は……！？",GameConfig.player_name)
	await novel_interface.show_text_only("彼女は俺には目もくれず、壁際の配電室の扉を器用に開けると、ハイヒールの先でぐったりした大男を中へ蹴り込んだ。")
	await novel_interface.show_text_only("白いシャツにタイトなスカート姿だというのに、動きは一切無駄がなく鮮やかだった。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("ふぅん、しばらくは誰も来ないでしょうね。", "白衣の女性")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は手を軽く払うと、大型ゴミを片付けた直後のような顔で、気楽そうにこちらを振り向いた。")
	await novel_interface.show_text_only("今起きたことを、俺の頭はまるで処理できていなかった。ただ呆然と彼女を見つめることしかできない。")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("(よく見たら、このお姉さんすごく綺麗だ……！)\n(しかもモデルみたいな体つきしてるし……)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("(でも、胸元の名札には確かに「科学者」って書いてある)",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("(やっぱりさっきのは幻覚だったってことか？)",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そうだ。今の配電室の中に、覆面の大男なんて最初から存在しなかったんだ。")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("俺はそんな結論を都合よく受け入れ、そのまま視線を彼女の脚へと移してしまった……")
	await novel_interface.show_text_only("(こんなお姉さんと一緒に働けたら最高だよな……)\n(異質物研究員って仕事、案外アリなのかも)")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("おい、坊や。どこ見てる？", "白衣の女性")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("そう言いながら、彼女は拳銃のマガジンを抜いて中身を確かめた。")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("(いやいやいや、自分を誤魔化すな俺！！)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("あ、あの……\nあなたは……？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("まあ……マリルとでも呼んで。\n今日は退屈な講義をする予定だったんだけど、", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("手早く銃を組み直し、白衣のポケットへ滑り込ませる。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("さっきの連中が会議室を占拠しちゃってね。\nおかげで講義は中止よ〜", "マリル")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("マリル……マリル・フォン・ブラウン！？",GameConfig.player_name)
	await novel_interface.show_dialog("あ、あなたって、俺が捺印をもらうはずだった講義の担当者ですよね！？\nしかも元老院認定のSS級科学者！",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ふん、あの老人達はちょろいものよ〜", "マリル")
	await novel_interface.show_dialog("でも、見る限りあなたは単位目当てで来たんでしょ？", "マリル")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("うっ……ほんとにすみません！！",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("不運というべきか、ただの間抜けというべきか……まさか閉鎖中に上へ上がるエレベーターを見つけるなんてね。", "マリル")
	await novel_interface.show_dialog("放っておいたら、そのまま『会議室』の占拠現場に突っ込んでいたところよ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("閉鎖状態……？\nスマホを取り出してみると、やっぱりまったく圏外だった。")
	await novel_interface.show_text_only("ようやく分かった。ロビー正面のエレベーターが全部止まっていたのは……閉館したからじゃなかったんだ！")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("あなたが上がってきたエレベーターも、もう封鎖されたわ。\nここで大人しく防衛庁の救援を待ちなさい。", "マリル")
	await novel_interface.show_dialog("私は会議室の様子を見てくる。誰か来たら隠れてなさい。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("で、でも……あなた一人で……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("分かった？", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("は、はい！！",GameConfig.player_name)

	print("=== 第1章第2話終了 ===")

	# エピソード終了処理
	await novel_interface.end_story_episode(0.5)
