# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("(Sono già corsa in bagno a controllare non so quante volte...)\n(Il cervello mi si è spento...)",GameConfig.player_name)
	await novel_interface.show_dialog("(Mi sono pizzicata forte)\n(Non sto sognando!)",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(E il mio corpo adesso è molto più morbido)\n(Al tatto... non è neanche male...)",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Ma che vuol dire «non è male»!!\nA cosa diavolo sto pensando!!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Dannazione... ieri questa T-shirt mi stava a pennello,\ne invece adesso mi va larghissima...",GameConfig.player_name)
	await novel_interface.show_dialog("O forse... sono io che mi sono rimpicciolita...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nello specchio si rifletteva una ragazza minuta, avvolta in vestiti troppo grandi... sembrava la scena di un film, una ragazza con addosso i vestiti del suo fidanzato...")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("...Perché sto arrossendo...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Insomma... una cosa come diventare una ragazza\nnon potrei raccontarla a nessuno...",GameConfig.player_name)
	await novel_interface.show_dialog("Ho controllato bene la stanza poco fa.\nL'unica anomalia è una mazza metallica comparsa accanto al letto.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Nel sogno di ieri il centro di ricerca era stato attaccato.\nE io avevo combattuto usando proprio questa mazza...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Sempre che si possa chiamare combattere...",GameConfig.player_name)
	await novel_interface.show_dialog("Poi l'intera città si era dissolta nel nulla...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Giusto, controllo il telefono!\nSe è successo davvero, una cosa del genere sarà sicuramente finita sui giornali!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Non c'è traccia di notizie su attentati terroristici o roba simile...",GameConfig.player_name)
	await novel_interface.show_dialog("Meno male... allora era solo un sogno...?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Eh? E questo sarebbe—?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("Il 『Calice di Los』 è scomparso all'improvviso nonostante la sorveglianza serrata.","Notizie")
	await novel_interface.show_dialog("La scorsa notte il Calice di Los è sparito dal luogo di custodia sotto lo sguardo di dodici sistemi di sorveglianza.","Notizie")
	await novel_interface.show_dialog("Il Centro di Contenimento e Ricerca Steele Monte è protetto da misure di gestione e sicurezza rigidissime: l'ipotesi di un furto è estremamente improbabile...","Notizie")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Ho la sensazione... di dover tornare al centro di ricerca!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Per il sogno di ieri e per quello che è successo al mio corpo...\nSento che se torno al laboratorio forse riuscirò a capire qualcosa.",GameConfig.player_name)
	await novel_interface.show_dialog("Bene! Si esce!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("A pensarci bene...\ncon quest'aspetto sembro una persona sospettissima...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vedendo il mio riflesso nel vetro dell'ingresso del palazzo, mi venne un po' da pentirmene.")
	await novel_interface.show_text_only("La camicia era chiaramente troppo grande e le gambe dei jeans strisciavano per terra.")
	await novel_interface.show_text_only("E come ciliegina sulla torta, stringevo pure una mazza metallica in mano.\nPerò era anche l'unica prova che avevo...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Mmh... sono arrivata fin qui tutta d'un fiato, ma adesso che faccio?",GameConfig.player_name)
	await novel_interface.show_dialog("Con tutta questa sicurezza in giro,\nnon sembra affatto il tipo di posto in cui potrebbe avvenire un attentato terroristico.",GameConfig.player_name)
	await novel_interface.show_dialog("Beh, d'altronde è sparito un oggetto sotto custodia...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("...Ehi, ragazzina.", "Guardia")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Ehi, ragazzina laggiù, fermati!!!!", "Guardia")
	await novel_interface.show_text_only("A parlare era un uomo dai capelli corti; dai muscoli possenti che spuntavano dalle maniche si capiva subito quanta forza avesse nelle braccia.")
	await novel_interface.show_text_only("Fisico temprato, sorriso gentile e abbagliante: sembrava il protagonista di un film di wrestling.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("Eh!?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Sì, sto parlando proprio con te.", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Quale ragazzina, idiota!\nIo sono... io... sono...",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm? Comunque, ieri è sparita una cosa importante.\nAbbiamo ricevuto l'ordine di bloccare tutta la zona.", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("Anch'io ho perso qualcosa di importante...\nQualcosa di importantissimo, e al risveglio non c'era più!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Adesso ai civili è vietato entrare. Torna un altro giorno, ragazzina.", "Guardia")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("E poi!", "Guardia")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("A-ah! C-cos'altro c'è...?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Lasciamo pure stare il fatto che vai in giro con una mazza in mano, ma vestita così ti beccherai un raffreddore in un attimo.", "Guardia")
	await novel_interface.show_dialog("Torna a casa!", "Guardia")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("La guardia mi fece il pollice in su e mi regalò un altro di quei sorrisi caldi e abbaglianti.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("O-ok... allora a presto!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Sentirmi chiamare ragazzina... non ci sono proprio abituata...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh— dev'esserci per forza qualche indizio.\nPerò non posso entrare...",GameConfig.player_name)
	await novel_interface.show_dialog("...A questo punto non mi resta che tornare indietro.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Eh? È da un po' che cammino verso la stazione, ma questa strada non è un po' strana?",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Uh?\nChe succede???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mi sono persa...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…věta…hrích…！！","Teppista dall'aria strana")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Che hanno questi tipi...?\nE poi... che lingua stanno parlando?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Uwaaahhhhh!!!!",GameConfig.player_name)
	await novel_interface.show_dialog("Quelli... stanno venendo proprio verso di me!?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("…Mors…！！","Teppista dall'aria strana")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Devo scappare subito!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("...Hah...! Anche se provo a scappare...\ncon i vestiti e le scarpe così larghi non riesco proprio a correre...!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Aaaaargh!!!!","Teppista dall'aria strana")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Mi stanno per prendere...\nÈ finita, è finita!!",GameConfig.player_name)
	await novel_interface.show_dialog("Eh? La mazza...?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi accorsi che i motivi incisi sulla mazza che stringevo stavano emettendo una luce dai colori innaturali.\nQ-questo è...!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Sono una strega, puoi chiamarmi Annie.\n...Direi che sei capitata in un bel pasticcio, eh~", "Ragazza dai capelli blu")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Annie... una strega??\nQuello che mi è successo oggi è già ben oltre ogni normalità...",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Avrei un sacco di cose da chiederti.\nMa prima sistemiamo ciò che abbiamo davanti!","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("A proposito, ma che cos'hai addosso...? È tutto largo e svolazzante.\nCon questi vestiti non si combatte proprio bene~", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Ti aiuto a metterti qualcosa che ti stia a pennello.\nPreparati, sta per cominciare una rissa!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C-combattere?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
