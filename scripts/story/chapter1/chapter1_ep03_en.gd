# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("That sentry post still hasn't responded. Go check that side—", "Male Voice A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Yes!", "Male Voice B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("I'll go get the heartbeat sensor. Keep your eyes peeled!", "Male Voice A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Damn it... There's no slipping past them here...",GameConfig.player_name)
	await novel_interface.show_dialog("Their lines of sight don't leave any blind spots. My only chance is to wait until they split up and jump one of them.",GameConfig.player_name)
	await novel_interface.show_dialog("I should be able to do it...\nIf that woman could drop someone bare-handed...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("I need some kind of weapon...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A metal bat hung on the corridor wall. On the little plaque below, I could just make out: \"Raebona Liberty Light...\"")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("This is probably an exhibit...\nI'm only borrowing it for a moment. Yeah. Just borrowing it...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("All right... Here I go!\nHaaah—!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("Bang—!!")
	await novel_interface.show_text_only("I swung with all my strength and cracked the masked man across the back of the head. A tremendous clang rang out. Huh...? Was it supposed to be that loud?")
	await novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("But instead of collapsing the way I'd hoped, he turned toward me, eyes blazing with rage.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("This is nothing like it is in games!!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Who’s there?", "Balaclava A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("The masked man whipped his gun stock at me. I frantically raised the bat to block.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Oh, no!",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("The force of the impact ran through the bat into both my hands and shoulders. As I gritted my teeth and held on, the masked man lashed out with a kick.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("His boot slammed hard into my unguarded stomach.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("The kick sent me flying. I crashed through the railing and dropped to the floor below.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("Huh?")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Damn it. That brat who jumped me fell to the floor below.\nI'm going to finish him off!", "Balaclava A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...I have to get out of here...\n...Need to hide... in the shadow of... that exhibit...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Wait... The leader just sent word. The anti-theft self-destruct device has been disarmed.", "Balaclava B")
	await novel_interface.show_dialog("Quit wasting time. Get to the conference hall.\nBy the time he wakes up, we'll be long gone.", "Balaclava B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Yes!", "Balaclava A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("My consciousness... is... fading...\nMariru...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("At the same time, in the conference hall—")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("It looks like these guys have sneaked in with optic disguises…","Mariru")
	await novel_interface.show_dialog("They exploited the window when part of the containment facility's optical detection system was down for maintenance... Looks like someone inside tipped them off.","Mariru")
	await novel_interface.show_dialog("Still no idea who they are... I'll have to wait for an opening.","Mariru")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Heh... heh heh... hahahaha—","Balaclava Boss")
	await novel_interface.show_dialog("We've finally reclaimed it...!", "Balaclava Boss")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("That's—the Ross Goblet?!","Mariru")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("This Substance H artifact was discovered by the expedition on the Los Islands, which suddenly appeared in the central Pacific. Four gemstones are set into the outside of the cup.")
	await novel_interface.show_text_only("Inside the cup is a red liquid-like substance, yet it can neither be poured out nor touched. Like a phantom, it doesn't seem to possess any physical form at all...")
	await novel_interface.show_text_only("The old men at the institute tried every method they could think of and still couldn't figure out what it was.")
	await novel_interface.show_text_only("In time the risk rating of the Goblet was lowered to \"Safe\". \n Now it's available for public research…")
	await novel_interface.show_dialog("Tch. At a glance, only those gems seem worth anything.","Mariru")
	await novel_interface.show_dialog("But the gems and the cup are fused together at the molecular level. There's no way to separate them...","Mariru")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("To split this filthy thing into parts. I shall do it!", "Balaclava Boss")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Separate it? That's impossible—","Mariru")

	print("=== Chapter 1 Episode 3 End ===")

	# Call episode end function
	await novel_interface.end_story_episode(0.5)
