# chapter1_ep3.gd - Chapter 1 Episode 3
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep3_script()

func play_script():
	pass

func chapter1_ep3_script():
	novel_interface.change_music("res://assets/audio/music/Hand-to-hand combat.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Le poste de garde de ce côté ne répond plus. Va vérifier là-bas.", "Voix masculine A")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Oui !", "Voix masculine B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Je vais chercher un détecteur de battements cardiaques. Garde l'œil ouvert !", "Voix masculine A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("Ça craint, je ne pourrai pas me cacher ici...",GameConfig.player_name)
	await novel_interface.show_dialog("Ils n'ont aucun angle mort ; ma seule chance, c'est d'attendre qu'ils se séparent et d'en surprendre un.",GameConfig.player_name)
	await novel_interface.show_dialog("Ça devrait aller, non...\nPuisque cette femme a réussi à en mettre un au tapis à mains nues...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Je dois trouver quelque chose qui puisse servir d'arme...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sur le mur du couloir était suspendue une batte métallique. Les petites lettres sur la plaque au-dessous indiquaient : « Laebona - Lumière de liberté... »")
	novel_interface.show_character("ren_male","happy")
	await novel_interface.show_dialog("Ça doit être une pièce d'exposition...\nJe l'emprunte juste un instant, voilà, juste un instant...",GameConfig.player_name)
	await novel_interface.show_dialog("...\n...",GameConfig.player_name)
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Bon... j'y vais !\nHaaah— !",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.WHITE,3,0.15,1.0,[Color.RED,Color.BLACK],true)
	await novel_interface.show_text_only("Bam !!!")
	await novel_interface.show_text_only("J'ai frappé de toutes mes forces l'arrière du crâne de l'homme masqué ; un énorme bruit a retenti. Hein... c'était censé faire autant de bruit ?")
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("Mais l'autre, au lieu de s'effondrer comme je l'espérais, s'est retourné vers moi les yeux pleins de fureur.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Ça ne se passe pas du tout comme dans les jeux !!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Qui est là ?", "Homme masqué A")
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.RED,3,0.15,0.6,[],false)
	await novel_interface.show_text_only("L'homme masqué a aussitôt abattu la crosse de son arme vers moi ; j'ai serré la batte à deux mains pour la bloquer en catastrophe.")
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("Mince—",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.play_background_flash_effect(Color.BLACK,1,1.0,1.0,[],false)
	await novel_interface.show_text_only("La force écrasante de son attaque a traversé la batte jusque dans mes deux mains et mes épaules ; alors que je serrais les dents pour tenir bon, le masqué m'a soudain asséné un coup de pied.")
	await novel_interface.play_background_flash_effect(Color.BLACK,1,0.15,1.0,[Color.RED],true)  
	await novel_interface.show_text_only("Le coup a violemment frappé mon ventre sans défense.")
	await novel_interface.play_background_flash_effect(Color.WHITE,1,0.15,1.0,[],false)
	novel_interface.show_background("res://assets/images/bg/Baizhu/white_bg.png")
	await novel_interface.show_text_only("Le choc m'a projeté au loin ; j'ai fracassé la rambarde avant de m'écraser à l'étage inférieur.")
	await novel_interface.play_background_flash_effect(Color.RED,1,0.15,1.0,[Color.BLACK],true)
	await novel_interface.show_text_only("AAAAAAH !!!!!!!!!")
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Putain, le sale gosse qui m'a attaqué est tombé à l'étage du dessous.\nJe vais l'achever !", "Homme masqué A")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("...Je dois vite fuir...\n...me cacher dans... l'ombre... de cette pièce d'exposition...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("soldier_1")
	await novel_interface.show_dialog("Attends... le chef vient d'envoyer un message : le dispositif antivol à autodestruction a bien été désactivé.", "Homme masqué B")
	await novel_interface.show_dialog("Ne perds pas de temps, va immédiatement au point de rassemblement dans la salle de conférence !\nLe temps qu'il se réveille, on sera déjà loin.", "Homme masqué B")
	await novel_interface.hide_character()
	novel_interface.show_character("soldier_2")
	await novel_interface.show_dialog("Oui !", "Homme masqué A")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	novel_interface.show_character("ren_male","hurt")
	await novel_interface.show_dialog("Ma conscience... devient... floue...\nLiliu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pendant ce temps, dans la salle de conférence")
	novel_interface.change_music("res://assets/audio/music/Barrier Maze.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("On dirait que ce groupe s'est infiltré grâce à un camouflage optique...","Liliu")
	await novel_interface.show_dialog("Ils ont profité de la période où une partie des installations anti-détection optique du centre était en maintenance ; on dirait bien que quelqu'un de l'intérieur leur a vendu la mèche.","Liliu")
	await novel_interface.show_dialog("J'ignore encore qui ils sont exactement... je vais devoir attendre la bonne occasion.","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_conferenceRoom.png")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("Ha ha ha...","Chef des hommes masqués")
	await novel_interface.show_dialog("Nous l'avons enfin récupéré... !", "Chef des hommes masqués")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_instConfRoomWatching.png")
	await novel_interface.show_dialog("Ça, c'est... le « Calice de Los » ?!","Liliu")
	novel_interface.change_background("res://assets/images/bg/Shot/losgrail.png")
	await novel_interface.show_text_only("Un « objet de Substance H » rapporté des îles Los, un archipel apparu soudainement au beau milieu de l'océan Pacifique. Quatre pierres précieuses sont enchâssées à l'extérieur de la coupe.")
	await novel_interface.show_text_only("La coupe contient une substance rouge, liquide en apparence, mais impossible à verser ou même à toucher ; comme un fantôme, elle semble dépourvue de toute matérialité...")
	await novel_interface.show_text_only("Les vieux du labo ont tout essayé sans jamais parvenir à comprendre ce que c'était exactement...")
	await novel_interface.show_text_only("Après un certain temps, son niveau de danger a été ramené à « Safe »\net la recherche publique a été autorisée...")
	await novel_interface.show_dialog("Pff, à première vue, seules ces quelques pierres ont l'air de valoir de l'argent.","Liliu")
	await novel_interface.show_dialog("Mais les pierres précieuses et la coupe ne font qu'un à l'échelle moléculaire...","Liliu")
	novel_interface.show_character("soldier_leader")
	await novel_interface.show_dialog("C'est moi qui vais le séparer, cet objet impur !!", "Chef des hommes masqués")
	novel_interface.character_dark()
	await novel_interface.show_dialog("Le séparer ? Comment cela pourrait-il être possible ?","Liliu")

	print("=== Chapter 1 Episode 3 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
