# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("……Фух, ха… Я всё ещё не понимаю, что происходит,\nно это считается… победой…?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("…Похоже, да.","Анни")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Т-ты вообще кто такая!?\nОткуда ты вообще взялась!?",GameConfig.player_name)
	await novel_interface.show_dialog("Что это за твари на меня напали!?\nИ что это вообще за бита!?",GameConfig.player_name)
	await novel_interface.show_dialog("Что здесь произошло?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Успокойся!\nНа всё, что я знаю, постараюсь ответить по порядку.", "Анни")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Но, честно говоря, я и сама не понимаю, что здесь творится.\nКто ты такая — я бы и сама не прочь узнать…", "Анни")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Прости. Я слишком запаниковал…",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Ничего страшного.\nКстати, мы ведь ещё толком не представились друг другу.", "Анни")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Меня зовут Анни Басс.\nЗови просто Анни~", "Анни")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…Меня зовут "+GameConfig.player_name+". Приятно познакомиться.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+"… ну, взаимно.", "Анни")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("У тебя имя совсем как у мальчика. Звучит очень круто~", "Анни")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Что такое? Почему ты так удивился?","Анни")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("А, точно… я же сейчас…\nдевушка…",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("М? Ну ты и есть девушка.\nСмотри, как тебе идёт этот изменившийся наряд.", "Анни")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Очень мило, очень мило…\nСчитай этот «боевой наряд» моим подарком в честь знакомства~", "Анни")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("…Боевой наряд?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("А-а-а— ааааааааааааааа!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Только тут до меня дошло:\nна мне же самая настоящая женская одежда!!")
	await novel_interface.show_text_only("Матроска…\nи до неприличия короткая юбка…!")
	await novel_interface.show_text_only("Колготки на ногах… так вот какое у них странное ощущение…?")
	await novel_interface.show_dialog("И это стягивающее чувство в груди — неужели… (трогает)",GameConfig.player_name)
	await novel_interface.show_dialog("АААААААААААА!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("И куртка отлично сочетается с цветом твоих волос~\nИ фасон очень удобный для движения.", "Анни")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Мм…? Что такое~~?", "Анни")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Потому что…\nпотому что…",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
