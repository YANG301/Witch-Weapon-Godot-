# chapter1_ep2.gd - 第一章第2話
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep2_script()

func play_script():
	pass

func chapter1_ep2_script():
	novel_interface.change_music("res://assets/audio/music/Whisky.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/AEGIS.png")
	await novel_interface.show_dialog("登錄成功！","系統語音")
	await novel_interface.show_dialog("您的ID：2519G1911\n姓名："+GameConfig.player_name,"系統語音")
	await novel_interface.show_dialog("年齡：15歲\n性別：男性","系統語音")
	await novel_interface.show_dialog("歡迎來到第五學園都市斯蒂爾蒙特收容研究中心。這裡是新豐洲境內最大的『異質物』收容與研究機構。","系統語音")
	await novel_interface.show_dialog("『異質物』又稱『神蹟』，是指在特定條件下會引發超常物理現象的道具與媒介之總稱。","系統語音")
	await novel_interface.show_dialog("今天是研究中心的學園開放日。\n研究中心向市民和其他學園都市的考察團開放。","系統語音")
	await novel_interface.show_dialog("作為公眾教育的重要一環\n會將部分『神蹟』與研究成果一併展出……","系統語音")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_passageNight.png")
	novel_interface.show_character("ren_male","normal")
	await novel_interface.show_dialog("太好了！總算在閉館之前趕到了！",GameConfig.player_name)
	await novel_interface.show_dialog("大廳裡的電梯居然全都停運了，幸好還讓我發現一部仍在運作的備用貨梯。",GameConfig.player_name)
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("總之，只要去聽場講座、蓋個章，就能拿到學分了吧？",GameConfig.player_name)
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("不過……這一層怎麼連半個人影都看不到？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我一邊沿著二樓走廊往前走，一邊四處張望。")
	await novel_interface.show_text_only("雖說這種地方平時人就不多，但現在居然連一個人影都看不到。")
	await novel_interface.show_text_only("而且空氣裡還飄著一股醫院消毒水的味道，讓我不由得聯想到閉館後進來打掃的清潔人員。")
	novel_interface.show_character("ren_male","speechless")
	await novel_interface.show_dialog("講座不會已經結束了吧？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我一邊找講座的『會議廳』，一邊拐到一個旋轉樓梯邊上。")
	novel_interface.show_character("ren_male","worry")
	await novel_interface.show_dialog("慘了慘了，果然不該把那個遊戲玩到那麼晚……",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("『下一回合』這種按鈕真是有毒——啊啊啊啊唔嗯\n！！！？",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("突然我的脖子被什麼東西鉤住並被迅速向後拉！")
	await novel_interface.show_text_only("身體馬上要失去平衡的時候，感覺後腦勺靠在了一個柔軟又堅實的物體上。")
	await novel_interface.show_text_only("等我回過神來，已經被拉進了樓梯拐角處一條狹窄的過道，周圍的光線要暗上許多。")
	await novel_interface.show_dialog("嗚——！！\n唔——！！！",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/liliu_instPassageHiding.png")
	await novel_interface.show_text_only("還來不及叫出聲，我的嘴就被一隻手緊緊捂住，只能勉強用餘光看到一個穿著白大褂的女人——")
	await novel_interface.show_text_only("她背靠著牆壁，用一隻手緊緊摀住我的嘴。")
	await novel_interface.show_text_only("而我的半邊臉頰就這樣被緊緊貼在她胸前……甜得發膩的香氣不斷鑽進鼻子裡。")
	await novel_interface.show_dialog("（誒？？好、好大！！！！整張臉都埋進去了！！)",GameConfig.player_name)
	await novel_interface.show_dialog("（什麼狀況！！這個人到底是誰！？）",GameConfig.player_name)
	await novel_interface.show_dialog("噓——！別出聲！", "穿白大褂的女性")
	await novel_interface.show_text_only("身後的女人雖然刻意壓低了聲音，但語氣裡透著不容質疑的威嚴感。")
	await novel_interface.show_text_only("我的腦子亂作一團，感覺快要窒息了\n只能微微點頭表示順從……")
	await novel_interface.show_text_only("雖然我的嘴依然被捂著，但脖子上的壓力小了一\n些。")
	await novel_interface.show_text_only("我努力把視線聚焦到近處，隱約看見她胸前白大褂上的名牌寫著一行小字：首席科學家……")
	await novel_interface.show_dialog("（科學家……她是研究所的人嗎？）",GameConfig.player_name)
	await novel_interface.show_text_only("此時我才發現她並沒有看我，而是把頭轉向另一\n側，專注的盯著走廊的方向。")
	await novel_interface.show_text_only("走廊遠處傳來了急促有力的腳步聲。")
	await novel_interface.show_dialog("報告，這邊沒人。", "男性的聲音A")
	await novel_interface.show_dialog("不過確實有一部獨立的貨運電梯，我去手動關停。", "男性的聲音A")
	await novel_interface.show_dialog("（還有剛才跑過去的那個人似乎蒙著臉，手裡還拿著……槍？）",GameConfig.player_name)
	await novel_interface.show_dialog("這裡被入侵了喲，不想死就別動。", "穿白大褂的女性")
	await novel_interface.show_dialog("（入、入侵？什麼狀況……)",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	await novel_interface.show_text_only("我還在發愣，女人就已經閃身跟了出去。")
	await novel_interface.show_text_only("幾秒後傳來一記悶響和類似骨頭折斷的聲音。")
	await novel_interface.show_text_only("沒有預想中的倒地聲，她順勢從背後接住蒙面男\n人，然後把他拖回過道，並卸下了一把手槍。")
	await novel_interface.show_dialog("他是……？！",GameConfig.player_name)
	await novel_interface.show_text_only("女人並沒有理我，而是熟練地打開牆邊配電室的門\n，抬起高跟鞋一腳把渾身癱軟的壯漢踹了進去。")
	await novel_interface.show_text_only("雖然穿著白襯衫和貼身短裙，但動作一氣呵成十分利落。")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("哼~暫時應該不會有人過來了。", "穿白大褂的女性")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她拍了拍手，像是剛處理完一件大型垃圾似的，回過頭來輕鬆地看著我。")
	await novel_interface.show_text_only("我的大腦已經無法處理剛剛發生的事情了，只能傻傻的看著她。")
	novel_interface.show_character("ren_male","shy")
	await novel_interface.show_dialog("（仔細一看，這個姐姐很漂亮啊！）\n（而且身材也好像模特一樣……）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("（但是，她胸前的名牌上分明寫著“科學家”）",GameConfig.player_name)
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("（所以剛才的事一定是幻覺吧！）",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("沒錯，現在配電室裡並不存在一個蒙面壯漢。")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_liliu_leg1.png")
	await novel_interface.show_text_only("我居然心安理得地得出了這種結論，然後把視線移向了她的腿……")
	await novel_interface.show_text_only("（能跟這樣的姐姐在一起工作可真好啊……）\n（異質物研究員也是一份不錯的工作呢）")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_stairway.png")
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("喂？小鬼，你眼睛在看哪裡呢？", "穿白大褂的女性")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她一邊說話，一邊卸下手槍彈匣檢查子彈。")
	novel_interface.show_character("ren_male","sob")
	await novel_interface.show_dialog("（我不要自己騙自己了啊！！！）",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("你、你好\n你是……？",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("嘛……你叫我莉琉好了\n我今天本來是要做個無聊的講座", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她熟練地把槍重新組好，塞回了白大褂的口袋裡。")
	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("不過剛剛那群家伙劫持了會議廳。\n托他們的福，講座取消了~", "莉琉")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_male","shock",0.25)
	await novel_interface.show_dialog("莉琉……莉琉·馮·布勞恩？！",GameConfig.player_name)
	await novel_interface.show_dialog("你、你不就是我要蓋章的講座的主講人嗎！\n還是元老院評定的SS級科學家！",GameConfig.player_name)
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("哼，那幫老頭子很好騙的~", "莉琉")
	await novel_interface.show_dialog("不過看你的樣子是來混學分的吧？", "莉琉")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"worry")
	await novel_interface.show_dialog("唔……實在抱歉！！",GameConfig.player_name)
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0,0.3,true,"speak")
	await novel_interface.show_dialog("該說你運氣差還是太笨呢，居然能在封鎖狀態下找到上樓的電梯。", "莉琉")
	await novel_interface.show_dialog("不管你的話，怕不是要傻乎乎直接走進『會議廳』的劫持現場了。", "莉琉")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("閉鎖狀態……？\n我拿出手機，果然一點信號都沒有。")
	await novel_interface.show_text_only("終於明白為什麼大廳正面的電梯全都停了……原來不是閉館了啊！")
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("你搭上來的那部電梯現在也已經被封死了。乖乖待在這裡，等防衛廳來救你吧。", "莉琉")
	await novel_interface.show_dialog("我得去會議廳看看狀況。如果有人來，你就先躲起來。", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("可、可是……你一個人……",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("聽明白了嗎！", "莉琉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_male","shock")
	await novel_interface.show_dialog("好、好的！！",GameConfig.player_name)

	print("=== 第一章第2話結束 ===")

	# 調用劇情結束函數
	await novel_interface.end_story_episode(0.5)


