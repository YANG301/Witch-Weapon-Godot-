# chapter1_ep5.gd - Chapter 1 Episode 5
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep5_script()

func play_script():
	pass

func chapter1_ep5_script():
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/5-1.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Everything's gonna be Okay.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Home_bedroom.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("(Já fui ao banheiro confirmar várias vezes...)\n(Meu cérebro já não consegue pensar direito...)",GameConfig.player_name)
	await novel_interface.show_dialog("(Me belisquei com força)\n(Não é um sonho!)",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(E meu corpo parece muito mais macio)\n(A sensação ao toque... até que não é ruim...)",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Que 『não é ruim』 nada!!\nNo que eu estou pensando!!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("Droga... ontem essa camiseta servia perfeitamente\nmas de repente ficou desse tamanho...",GameConfig.player_name)
	await novel_interface.show_dialog("Na verdade, foi o meu corpo que diminuiu...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No espelho, vi uma garotinha miúda vestindo roupas grandes demais, como aquelas meninas de filme usando a camisa do namorado...")
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("... Por que eu estou corando...?",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mesmo assim...\nvirar uma garota é algo que eu simplesmente não posso contar a ninguém...",GameConfig.player_name)
	await novel_interface.show_dialog("Acabei de revistar o quarto com cuidado.\nA única coisa estranha é esse taco metálico que apareceu ao lado da cama.",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("No sonho de ontem, o centro de pesquisa foi atacado.\nEu lutei com esse taco...",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Se é que aquilo pode ser chamado de luta...",GameConfig.player_name)
	await novel_interface.show_dialog("Depois disso, a cidade inteira virou cinzas...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Ah, claro, o celular!\nSe isso aconteceu de verdade, uma notícia assim com certeza foi publicada!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Não tem nenhuma notícia sobre atentado terrorista...",GameConfig.player_name)
	await novel_interface.show_dialog("Que bom, então foi só um sonho...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Hã? Isto é—?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_special_centered_image("res://assets/images/bg/Shot/role25.png",410,1.0,1.0,0.3)
	await novel_interface.show_dialog("『Cálice de Los』 desaparece repentinamente sob vigilância rigorosa.","Notícia")
	await novel_interface.show_dialog("O 『Cálice de Los』 desapareceu de seu local na noite passada diante de 12 equipamentos de monitoramento.","Notícia")
	await novel_interface.show_dialog("O Centro de Contenção e Pesquisa Steele Monte conta com segurança e controle rigorosos; a possibilidade de furto é extremamente baixa...","Notícia")
	await novel_interface.hide_special_centered_image(0.3)
	novel_interface.show_character("ren_trans","stare")
	await novel_interface.show_dialog("Sinto que... preciso voltar ao centro de pesquisa!",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Sobre o sonho de ontem e o meu corpo...\nTenho a sensação de que, se eu for ao instituto, talvez consiga entender alguma coisa.",GameConfig.player_name)
	await novel_interface.show_dialog("Certo! Estou saindo!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/other/BG_City_street1.png")
	novel_interface.show_character("ren_trans","shy")
	await novel_interface.show_dialog("Pensando bem...\ndo jeito que eu estou, pareço uma pessoa totalmente suspeita...",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quando vi meu reflexo no vidro da entrada do prédio, comecei a me arrepender.")
	await novel_interface.show_text_only("A camisa claramente não tem o meu tamanho, e a barra da calça jeans arrasta no chão.")
	await novel_interface.show_text_only("O auge do absurdo é que eu ainda estou segurando um taco metálico na mão direita.\nMas essa é a única prova que eu tenho...")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("Hmm... num impulso cheguei até aqui, mas o que faço agora?",GameConfig.player_name)
	await novel_interface.show_dialog("Com tantos seguranças, isso não parece o tipo de lugar onde teria acontecido um ataque terrorista.",GameConfig.player_name)
	await novel_interface.show_dialog("Mas também é compreensível, já que uma peça sob contenção desapareceu...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("... Ei, mocinha.", "Segurança")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("...",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("nantetsu","speak")
	await novel_interface.show_dialog("Você aí, mocinha! Pare!!!!", "Segurança")
	await novel_interface.show_text_only("Quem falou foi um homem de cabelo curto; pelos braços expostos nas mangas, dava para ver músculos fortes e bem definidos.")
	await novel_interface.show_text_only("Seu físico lapidado pelo treino, somado a um sorriso afável e ofuscante, fazia dele a imagem perfeita de um protagonista de filme de luta livre.")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_trans","shock",0.25)
	await novel_interface.show_dialog("Hã!?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Isso, estou falando com você.", "Segurança")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shy")
	await novel_interface.show_dialog("Que mocinha o quê, idiota!\nEu sou... eu... sou...",GameConfig.player_name)
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hm? Enfim, uma coisa importante desapareceu ontem.\nRecebemos ordens para isolar toda esta área.", "Segurança")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"shock")
	await novel_interface.show_text_only("Eu também perdi uma coisa importante...\nUma coisa importantíssima desapareceu quando acordei!")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Agora pessoas comuns estão proibidas de entrar. Volte outro dia, mocinha.", "Segurança")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("E tem mais!", "Segurança")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Ah! O-o que foi agora...?",GameConfig.player_name)
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Além de andar por aí com um taco na mão, vestida desse jeito você vai acabar pegando um resfriado.", "Segurança")
	await novel_interface.show_dialog("Volte logo para casa!", "Segurança")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_left(0)
	await novel_interface.show_text_only("O segurança ergueu o polegar para mim e, de novo, abriu um sorriso caloroso e ofuscante.")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("T-tá bom, então até logo!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Ser chamada de 『mocinha』 ainda é tão estranho...)",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ugh— deve haver alguma pista.\nMas eu não consigo entrar...",GameConfig.player_name)
	await novel_interface.show_dialog("...\nAcho que só me resta voltar para casa.",GameConfig.player_name)
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_abnormal.png")
	await novel_interface.show_dialog("Hã? Faz um tempo que estou andando em direção à estação, mas essa rua está estranha...",GameConfig.player_name)
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Hã?\nO que está acontecendo???",GameConfig.player_name)
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Será que eu me perdi...?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Tchii—!\n...věta...hrích...！！","Delinquente estranha")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","normal")
	await novel_interface.show_dialog("O que há com esse grupo...?\nO que essas pessoas... estão dizendo?",GameConfig.player_name)
	novel_interface.change_expression("shock")
	await novel_interface.show_dialog("Uwaaaahhhhh!!!!",GameConfig.player_name)
	await novel_interface.show_dialog("Eles estão vindo atrás de mim!?",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("...Mors...！！","Delinquente estranha")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Preciso fugir logo!",GameConfig.player_name)
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("... Arf, arf...! Mesmo querendo fugir...\ncom roupas e sapatos tão folgados, eu não consigo correr direito...!",GameConfig.player_name)
	await novel_interface.hide_character()
	novel_interface.show_character("witch_first")
	await novel_interface.show_dialog("Graaaahhhh!!!!","Delinquente estranha")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Eles vão me pegar...\nAcabou, acabou!!",GameConfig.player_name)
	await novel_interface.show_dialog("Hã? O taco...?",GameConfig.player_name)
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Percebi que o padrão gravado no taco em minha mão emitia um brilho estranho\nI-isso é...!")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.enter_video_performance_mode([
		"res://assets/video/10005_2.ogv"
	])
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside_blue.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Eu sou uma bruxa. Pode me chamar de Annie.\n...Pelo visto, você se meteu em encrenca~", "Garota de cabelo azul")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_trans","shock")
	await novel_interface.show_dialog("Annie... bruxa??\nO problema em que me meti hoje não é nada pequeno...",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","smile",0.25)
	await novel_interface.show_dialog("Tenho um monte de coisas para te perguntar.\nMas primeiro vamos resolver o problema diante dos nossos olhos!","Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Aliás, o que é essa roupa enorme que você está usando?\nDefinitivamente não dá para lutar com isso~", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Vou te ajudar a trocar para algo que sirva direito.\nSe prepare, porque vamos ter que lutar!", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("L-lutar?!",GameConfig.player_name)

	print("=== Chapter 1 Episode 5 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
