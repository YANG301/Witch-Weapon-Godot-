# chapter1_ep6.gd - Chapter 1 Episode 6
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	chapter1_ep6_script()

func play_script():
	pass

func chapter1_ep6_script():
	novel_interface.change_music("res://assets/audio/music/Black Market.mp3")
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("ren_battle","normal1")
	await novel_interface.show_dialog("……Hộc, ha…… dù chẳng biết rốt cuộc đã xảy ra chuyện gì\nnhưng như vậy có tính là, thắng rồi không……?",GameConfig.player_name)
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_battle","normal",0.25)
	await novel_interface.show_dialog("……Có vẻ là vậy.","Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C, cậu rốt cuộc là ai vậy!?\nTừ đâu chui ra thế!?",GameConfig.player_name)
	await novel_interface.show_dialog("Mấy thứ vừa tấn công tôi là cái gì vậy!?\nCòn cây gậy này rốt cuộc là thứ quái gì!?",GameConfig.player_name)
	await novel_interface.show_dialog("Nơi này rốt cuộc bị làm sao vậy?!",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"perspire")
	await novel_interface.show_dialog("Bình tĩnh lại đi!\nTrong phạm vi tôi biết, tôi sẽ trả lời từng câu hỏi của cậu.", "Annie")
	novel_interface.change_2nd_expression("worry")
	await novel_interface.show_dialog("Nhưng thật ra tôi cũng giống cậu, hoàn toàn không hiểu tình hình bây giờ.\nCậu là ai, tôi còn muốn biết hơn đây……", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Xin lỗi. Tôi hoảng quá……",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Không sao đâu.\nÀ mà nhỉ, chúng ta vẫn chưa chính thức tự giới thiệu với nhau nữa.", "Annie")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Tên tôi là Annie Bass.\nCứ gọi tôi là Annie nhé~", "Annie")
	novel_interface.character_light(0.35,"worry")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……Tôi tên là "+GameConfig.player_name+", mong được giúp đỡ.",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog(GameConfig.player_name+" à…… rất mong được cậu giúp đỡ.", "Annie")
	novel_interface.change_2nd_expression("happy")
	await novel_interface.show_dialog("Tên cậu nghe giống con trai nhỉ. Ngầu lắm~", "Annie")
	novel_interface.character_light(0.35,"awkward")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("!?", GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal")
	await novel_interface.show_dialog("Sao vậy, sao lại ngạc nhiên thế?","Annie")
	novel_interface.character_light(0.35,"shy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("À, nói mới nhớ bây giờ tôi……\nlà con gái mà……",GameConfig.player_name)
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Hửm? Cậu vốn là con gái mà.\nCậu xem bộ đồ tôi biến ra này cũng hợp lắm đấy chứ?", "Annie")
	novel_interface.change_2nd_expression("uneasy")
	await novel_interface.show_dialog("Dễ thương lắm, dễ thương lắm……\nCứ xem bộ 『chiến phục』 này là quà gặp mặt tôi tặng cậu nhé~", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……Chiến phục?",GameConfig.player_name)
	novel_interface.change_expression("awkward")
	await novel_interface.show_dialog("A a——aaaaaaaaaaaa!!!!",GameConfig.player_name)
	await novel_interface.hide_all_characters()
	novel_interface.change_background("res://assets/images/bg/Shot/BG_Shot_girlchar_battleWearingShy.png")
	await novel_interface.show_text_only("Đến lúc hoàn hồn mới nhận ra\nmình thế mà lại đang mặc nguyên một bộ đồ con gái!!")
	await novel_interface.show_text_only("Đồng phục thủy thủ……\nvà chiếc váy ngắn đến mức khiến người ta xấu hổ……!")
	await novel_interface.show_text_only("Cảm giác của đôi tất trên chân…… lại vi diệu đến thế này sao……?")
	await novel_interface.show_dialog("Hơn nữa, cảm giác bị siết chặt ở ngực chẳng lẽ là…… (sờ)",GameConfig.player_name)
	await novel_interface.show_dialog("Aaaaaaa!!!",GameConfig.player_name)
	novel_interface.change_background("res://assets/images/bg/Shot/BG_RC_outside.png")
	novel_interface.show_character("anne_battle","normal")
	await novel_interface.show_dialog("Áo khoác cũng rất hợp với màu tóc của cậu nữa đó~\nLà kiểu cực kỳ thích hợp để vận động.", "Annie")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Ừm……? Sao thế~~?", "Annie")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_battle","shy",0.25)
	await novel_interface.show_dialog("Bởi vì……\nBởi vì……",GameConfig.player_name)

	print("=== Chapter 1 Episode 6 End ===")

	# episode end
	await novel_interface.end_story_episode(0.5)
