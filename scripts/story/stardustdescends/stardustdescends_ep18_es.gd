# stardustdescends_ep18.gd - 星尘降临篇第18话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep18_script()

func play_script():
	pass

func stardustdescends_ep18_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Psychology.png")
	await novel_interface.show_text_only("Todo el mundo ha experimentado dolor interior, algo tan real, tan pesado, tan agonizante, tan difícil de soportar.")
	await novel_interface.show_text_only("Sin embargo, pocas personas saben que la mayor parte del sufrimiento psicológico se aprende después del nacimiento.")
	await novel_interface.show_text_only("Un niño que puede estar feliz todo el día con nada más que un muslo de pollo no puede comprender el dolor de ser excluido y aislado por sus compañeros de clase en las redes sociales.")
	await novel_interface.show_text_only("Ya sea que sufras porque no puedes encajar en un grupo, porque quienes te rodean no te aceptan, o porque no puedes convertirte en la persona que imaginas…")
	await novel_interface.show_text_only("Todo ese dolor se basa en conceptos complejos, nada más que un subproducto de significados acumulados aprendidos después del hecho.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Camus.png")
	await novel_interface.show_text_only("Camus dijo que lo absurdo de la humanidad radica en la búsqueda interminable de significado en un universo sin sentido.")
	await novel_interface.show_text_only("Bajo las cadenas del significado, nadie puede obtener la verdadera libertad.")
	await novel_interface.show_text_only("La civilización humana no puede existir sin significado; es la base de los sistemas sociales en todas las épocas.")
	await novel_interface.show_text_only("El significado de clan, el significado de nación, el significado de su señor, el significado de religión, incluso la identidad étnica, la ideología y la cultura pop...")
	await novel_interface.show_text_only("Una vez que se te inculca un sistema de significado, todo tipo de ideas se forman naturalmente y se construye una escalera de valores en tu mente.")
	await novel_interface.show_text_only("lo que merece elogios y promoción, lo que merece desprecio y condena, lo que cuenta como felicidad y honor, lo que debería traer dolor y vergüenza...")
	await novel_interface.show_text_only("Algunas personas se ven impulsadas al suicidio por el cambio dinástico, otras por el matrimonio de su ídolo; no hay distinción verdadera o falsa entre su dolor.")
	await novel_interface.show_text_only("Pero si tu mente es lo suficientemente aguda, quizás de vez en cuando puedas liberarte de los grilletes y salir solo a tomar un poco de aire.")
	await novel_interface.show_text_only("Luego regresas al grupo, sigues fingiendo llevar las cadenas, alabando lo que todos alaban y despreciando lo que todos desprecian.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Porque si eres inteligente, ya debes darte cuenta de esto: la humanidad no sólo es prisionera del significado, sino que voluntariamente se convierte en su carcelera.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("................")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	await novel_interface.show_text_only("Centro Internacional de Convenciones de Masada, antes de la ceremonia de firma.")
	await novel_interface.show_text_only("En la sala ya se encontraban reporteros de más de cien medios de comunicación, con flashes y cámaras listas para registrar este momento histórico.")
	await novel_interface.show_text_only("Detrás del podio, una pesada cortina azul sellaba completamente el ruidoso salón del área detrás del escenario.")
	await novel_interface.show_text_only("Filas de nuevos equipos de iluminación profesional en las vigas del techo estaban todos en modo de espera de bajo brillo.")
	await novel_interface.show_text_only("Los paneles acústicos envueltos en las paredes y el revestimiento insonorizado de la cortina hacían que el lugar fuera inquietantemente silencioso.")
	await novel_interface.show_text_only("Cuando el oficial camuflado en el desierto vio al hombre de traje gris acercándose por el pasillo detrás de la cortina, inmediatamente se enderezó y saludó.")
	await novel_interface.show_text_only("La insignia de rango en el cuello de camuflaje y la estrella dorada de seis puntas mostraban que era un mayor de las Fuerzas de Defensa.")
	await novel_interface.show_text_only("Y el hombre al que estaba a punto de informar era el representante firmante de Masadan de hoy: el mayor general Hamon del Comando Norte de las Fuerzas de Defensa.")
	await novel_interface.show_dialog("Informe, señor. Estoy aquí para informarles sobre el ataque ahora mismo.", "Mayor")
	await novel_interface.show_text_only("El mayor general había ganado algo de peso, pero aún estaba peinado con perfecta precisión y su mirada conservaba la agudeza característica de un soldado.")
	await novel_interface.show_text_only("Mientras caminaba, se aflojó la corbata con impaciencia y la acomodó junto con la tableta con respaldo de cuero negro que tenía en la mano.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Nunca podré acostumbrarme a usar esta cosa...", "Hamon")
	await novel_interface.show_dialog("Continúe.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Es el informe de la investigación sobre la explosión al suroeste del centro de convenciones hace treinta minutos.", "Mayor")
	await novel_interface.show_dialog("Basándose en los rastros en el lugar, el equipo de desactivación de bombas concluyó que se trataba de un artefacto explosivo improvisado fabricado principalmente con azúcar.", "Mayor")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...¿Una bomba casera hecha de azúcar?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sí, pero la intensidad de la explosión no fue alta y no causó víctimas. El explosivo parece haber incluido aditivos que realzaban el humo.", "Mayor")
	await novel_interface.show_dialog("Apagamos el humo inmediatamente. El regimiento de guardias ha acordonado los alrededores y hasta el momento ningún medio de comunicación ha informado del incidente.", "Mayor")
	await novel_interface.show_dialog("La vigilancia de las calles cercanas aún no ha encontrado ningún sospechoso. Estamos ampliando el área de búsqueda ahora. Informe completo.", "Mayor")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("...¿Eso es todo?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon miró fijamente a los ojos del mayor y no dijo nada durante un largo momento. El mayor no se atrevía a hablar y sólo podía permanecer rígido en su lugar.")
	await novel_interface.show_text_only("Hamon resopló y, insatisfecho, golpeó la tableta que tenía en la mano contra el pecho del mayor.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("¡Míralo tú mismo!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Retrocediendo tambaleándose por el golpe, el mayor rápidamente estabilizó la tableta. En la pantalla estaba el icónico logotipo del candelabro de siete brazos de Monola.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Enviaron esto hace unos minutos.", "Hamon")
	await novel_interface.show_dialog("Monola vio a tres individuos sospechosos que se habían mezclado en el estacionamiento subterráneo.", "Hamon")
	await novel_interface.show_dialog("Dos de ellos se deslizaron por el hueco del ascensor con la intención de sabotear el sistema de extinción de incendios del edificio.", "Hamon")
	await novel_interface.show_dialog("Afortunadamente, sus agentes intervinieron a tiempo. Capturaron a uno, pero los otros dos escaparon; uno de ellos fue rozado por una bala mientras huía.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...¿¡El hueco del ascensor!?\nS-¿Alguien se ha infiltrado en el lugar?", "Mayor")
	await novel_interface.show_text_only("El mayor hojeó rápidamente el informe y su cabeza inmediatamente comenzó a zumbar.")
	await novel_interface.show_text_only("¿Fue esa explosión solo una distracción...?")
	await novel_interface.show_text_only("Debido a que el estacionamiento en superficie había sido ocupado por fuerzas de seguridad y vehículos militares, todas las camionetas con equipos de medios estaban estacionadas en el sótano del centro de convenciones.")
	await novel_interface.show_text_only("Entonces el estacionamiento subterráneo era realmente el área más fácil para infiltrarse.")
	await novel_interface.show_text_only("Aunque la Inteligencia Militar había desplegado estrictas medidas de seguridad en cada rincón del edificio, la parte inferior de la cabina del ascensor era un punto ciego de vigilancia.")
	await novel_interface.show_text_only("Al darse cuenta de que la línea defensiva que había dispuesto había sido violada con tanta facilidad, el sudor inmediatamente brotó de la frente del mayor.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("¿No me aseguró la Inteligencia Militar que la seguridad del lugar era hermética?", "Hamon")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Deliberadamente saqué a la gente de Monola y los envié al perímetro exterior, ¡¿y así es como me haces ver?!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al recordar que el pasillo más allá de la cortina estaba lleno de reporteros, Hamon deliberadamente bajó la voz mientras lo reprendía.")
	await novel_interface.show_dialog("Esto...\nE-¡Fue mi fracaso!", "Mayor")
	await novel_interface.show_dialog("¿Pero no estaban todos los agentes de Monola estacionados afuera del centro de convenciones?\n¿Cómo podrían estar dentro del edificio...?", "Mayor")
	await novel_interface.show_text_only("Hamon sacudió levemente la cabeza y le dio una palmada en el hombro al mayor.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Entre los reporteros que hay, quién sabe cuántos de ellos son suyos...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Entendía perfectamente que la Oficina de Inteligencia Militar que había cultivado dentro del sistema militar durante los últimos años no podía compararse con un monstruo como Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Speech.png")
	await novel_interface.show_text_only("\"Son el sistema nervioso de este país, capaces de reaccionar ante cualquier peligro con la mayor rapidez\".")
	await novel_interface.show_text_only("\"Si alguien te dispara una flecha y necesitas que tu cerebro piense antes de esquivarla, sólo morirás con una flecha en el cuerpo\".")
	await novel_interface.show_text_only("El tío de Hamon, el primer ministro Schneiderman, había explicado una vez al parlamento de esta manera por qué Monola tenía una autoridad operativa suprema e ilimitada.")
	await novel_interface.show_text_only("Pero Hamon no podía tolerar que toda la inteligencia estuviera en manos de una organización que no podía controlar.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("La información es poder. Ésa era la experiencia de combate que había acumulado durante décadas, ya sea en guerras internas o externas.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ConventionCentre.png")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Y además--", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Le dirigió al oficial que tenía delante, un hombre al que había ascendido personalmente, una mirada significativa.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("La mujer que capturaron es una teniente del Batallón Caracal.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("--¡¿Uno de los nuestros?!", "Mayor")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Y un cadete de la Torre, además...", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Hamon lo dijo palabra por palabra.")
	await novel_interface.show_text_only("Al darse cuenta de las repercusiones políticas que esto podría causar, el mayor no pudo evitar contener la respiración.")
	await novel_interface.show_text_only("Siempre hubo muchas voces dentro de las Fuerzas de Defensa que se oponían a este acuerdo, especialmente entre los jóvenes agitadores deseosos de distinguirse.")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Lo más extraño aún es que las huellas dactilares tomadas en el lugar muestran que entre quienes actuaban con ella se encontraba un extranjero que se había registrado en inmigración hace unos días.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Un espía extranjero...?", "Mayor")
	await novel_interface.show_text_only("Las cejas de Hamon se fruncieron mientras reflexionaba por un momento.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("Eso es posible. En cualquier caso, le pedí a Monola que compartiera toda su información primero, pero no puedes esperar que sean muy cooperativos...", "Hamon")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Hice que el regimiento de guardia retuviera a ese teniente. Ahora está en la habitación segura de arriba y también está bajo tu cuidado.", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Sí, señor!", "Mayor")
	await novel_interface.show_text_only("Hamon se giró, se ajustó el cuello y volvió a ponerse la corbata.")
	novel_interface.show_character("hamon","speak")
	await novel_interface.show_dialog("La ceremonia está a punto de comenzar...\n¡No me hagas más problemas!", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Sí! ¡Tiene mi palabra, señor!", "Mayor")
	await novel_interface.show_text_only("Hamon hizo una pausa y luego dijo sombríamente, de espaldas al mayor:")
	novel_interface.show_character("hamon","serious")
	await novel_interface.show_dialog("Hoy no llevo uniforme. No me llames por mi rango.", "Hamon")
	await novel_interface.show_dialog("El pueblo ya no quiere soldados al frente del gobierno... ¿entendido?", "Hamon")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Ah... entendido!", "Mayor")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...\nCentro Internacional de Convenciones de Masada, estacionamiento al aire libre.")
	await novel_interface.show_text_only("Dentro de un vehículo blindado de transporte de personal.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_dialog("¡¡¡Idiota--!!!\n¡¿Caíste directamente en su trampa??!", "Mariru")
	await novel_interface.show_text_only("Si estos auriculares no pudieran ajustar el volumen dinámicamente, mis tímpanos probablemente habrían muerto antes que yo.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Awoo...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("E-Eso...", "Lian")
	await novel_interface.show_dialog("P-Porque no pude comunicarme con nadie...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Jugué con los controles durante años antes de que finalmente desactivara el modo de protección de este vehículo y pudiera comunicarme con Mariru.")
	await novel_interface.show_text_only("Un fuerte golpe sonó a través del auricular y me la imaginé haciendo pedazos su escritorio.")
	await novel_interface.show_dialog("Entonces... te fuiste solo, ¿no?", "Mariru")
	await novel_interface.show_dialog("¿Ha pasado tanto tiempo desde que te sometí a ejercicios que te pica todo el cuerpo sin ello...?", "Mariru")
	await novel_interface.show_text_only("Mariru dejó de gritar y adoptó un tono bajo y amenazador.")
	await novel_interface.show_text_only("¡¡Como un volcán a punto de hacer erupción, era incluso más aterrador que antes!!")
	await novel_interface.show_dialog("Oye, oye...\nNo te enojes tanto~", "Aya")
	await novel_interface.show_text_only("Aya intentó suavizarme las cosas con su habitual tono perezoso.")
	await novel_interface.show_dialog("Incluso si Lian obtuvo todas las D en cada prueba física, el hecho de que ella se ofreciera como voluntaria para este tipo de trabajo de infiltración de campo todavía dice algo sobre su coraje~", "Aya")
	await novel_interface.show_text_only("¿¡Está tratando de calmar las cosas o avivar las llamas!?")
	await novel_interface.show_text_only("No tuve elección. Sólo pude apretar los dientes y explicarme.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("B-Debido a las estrellas--", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_dialog("Recuerdo que anoche estaba despejada y había pocas luces en el barrio pobre, por lo que las estrellas eran fáciles de ver.", "Lian")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea1.png")
	await novel_interface.show_dialog("Pero cuando esas personas pasaron más tarde por el barrio pobre, no se veía ni una sola estrella.", "Lian")
	await novel_interface.show_dialog("Y además de eso, todos los dispositivos de comunicación perdieron señal...", "Lian")
	await novel_interface.show_dialog("Sentí que no era una improvisación ordinaria...", "Lian")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("... ¿Qué quieres decir?", "Mariru")
	await novel_interface.show_dialog("Se sentía exactamente igual a la situación alrededor de la iglesia la noche que capturamos a Elgana...", "Lian")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Church.png")
	await novel_interface.show_text_only("Esa noche, cuando mi llamada con Mariru se cortó repentinamente, la atmósfera a mi alrededor también se volvió extraña...")
	await novel_interface.show_text_only("Los edificios en la distancia se desdibujaron y deformaron, y el claro cielo nocturno se oscureció instantáneamente.")
	await novel_interface.show_dialog("Lo recuerdo claramente: todas las estrellas del cielo desaparecieron a la vez.", "Lian")
	await novel_interface.show_dialog("Luego vinieron esos soldados con uniformes negros de operaciones especiales justo después de eso...", "Lian")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Mariru se quedó en silencio por un largo rato. Como un niño que hubiera roto un jarrón, apenas me atrevía a respirar mientras esperaba la respuesta de los adultos.")
	await novel_interface.show_dialog("... ¿Así que tontamente les seguiste la corriente?", "Mariru")
	await novel_interface.show_text_only("Al escuchar la mezcla de reproche y resignación en la voz de Mariru, mi cuerpo tenso se relajó un poco.")
	await novel_interface.show_dialog("Son sólo cadetes que aún no se han graduado de la escuela militar. ¿No saben que este es el tipo de cosas que deberían manejar los profesionales?", "Mariru")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("En realidad, después de que salimos del barrio pobre, Emily lo denunció al ejército, a la policía y a los servicios de inteligencia, e incluso llamó a la línea directa antiterrorista...", "Lian")
	await novel_interface.show_dialog("Pero todos dieron respuestas elevadas y formuladas, diciendo que irían a verificar el barrio tan pronto como fuera posible y agradeciéndole por el consejo y demás...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily dijo que su reacción no fue sorprendente, porque los tiroteos entre pandillas ocurren en el barrio pobre todo el tiempo y es común ver gente con armas afuera por la noche.")
	await novel_interface.show_text_only("Y a los ojos de los ciudadanos comunes y corrientes de Masadan, todos los que se encuentran en la calle después del anochecer parecen terroristas...")
	novel_interface.show_character("ren_medical","upset")
	await novel_interface.show_dialog("Emily también consideró que con el sistema de defensa de la ciudad de Masada, esa gente nunca podría salir del barrio pobre.", "Lian")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Si el vehículo realmente llevaba una bomba y decidieron detonarla durante la ceremonia de firma...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Los niños del orfanato...")
	await novel_interface.show_dialog("¿Debido a que todas las agencias con las que contactaron reaccionaron tan lentamente, decidieron provocar algo ellos mismos y forzar el aplazamiento de la ceremonia de firma?", "Mariru")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Mmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Entonces, ¿no tuviste tiempo suficiente para llamarme...?", "Mariru")
	await novel_interface.show_text_only("El tono de Mariru de repente se volvió cruel, y con cada latido deliberado de sus palabras, el sonido de los nudillos crujiendo llegaba a través del auricular.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("¿Eh?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡¡¡Aaaaah, lo dejé escapar!!!")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("¡¡¡Lo siento!!!!\n¡Me equivoqué!", "Lian")
	await novel_interface.show_dialog("Me equivoqué...", "Lian")
	await novel_interface.show_dialog("P-Pero Emily, ella...", "Lian")
	await novel_interface.show_dialog("¡¡¡Me lo llevaron~~~!!!!", "Lian")
	await novel_interface.show_dialog("Sollozo, sollozo, sollozo, sollozo, sollozo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tensión, ansiedad, arrepentimiento, agravio... todas esas emociones surgieron a la vez y las lágrimas no dejaban de brotar de mis ojos.")
	await novel_interface.show_dialog("Que idiota...", "Mariru")
	await novel_interface.show_text_only("Mariru suspiró y cambió a una voz firme y firme.")
	await novel_interface.show_dialog("Emily está con las Fuerzas de Defensa. También es una de las mejores estudiantes de la Torre y, además, no causó ningún daño sustancial.", "Mariru")
	await novel_interface.show_dialog("Todas las agencias tienen la grabación de su llamada de emergencia de anoche que demuestra sus motivos, y su abuelo no se quedará sentado sin hacer nada aunque sólo sea para salvar la reputación de la familia.", "Mariru")
	await novel_interface.show_dialog("Lo más importante ahora es que no te atrapen, o la naturaleza de lo que hicieron será diferente.", "Mariru")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Mmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuando Mariru habla en ese tono frío, siempre va directo al grano y no deja espacio para discutir.")
	await novel_interface.show_dialog("¿Algo más?", "Mariru")
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("¿No puedes ser un poco más amable cuando estás consolando a alguien...?", "Lian")
	await novel_interface.hide_character()
