# stardustdescends_ep4.gd - 星尘降临篇第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep4_script()

func play_script():
	pass

func stardustdescends_ep4_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("A few hours later -- Harima Tech Research Center")
	await novel_interface.show_text_only("A tiny girl lazily checks her tablet while speaking through her earpiece.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Don't worry. The two guards are having a sweet dream as we speak.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Don't underestimate the human brain--it's willing and able to rationalize the situations it's in.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya glances around the room again. Two men in black suits are lying on a pair of Mind Diving devices.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("After all, people are more likely to believe lies they piece together for themselves...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, something on Aya's tablet catches her attention. She quickly scrolls down several pages, then returns to the interesting data.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("This is...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What is it?", "Mariru")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("The Boltzmann sensor spiked past its maximum reading the moment Ren's and Nix's foreheads touched.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("A malfunction? I thought you'd already set the theoretical cap to its highest possible value.", "Mariru")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Almost the highest possible value. If the data volume reached the Bekenstein bound, that would be a different matter.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Are you saying that, in that moment, the data volume reached the absolute highest that any substance can carry?", "Mariru")
	await novel_interface.show_text_only("Aya is doing some calculations quickly on her tablet.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("If we set aside this one anomaly, Nix's parameters are very close to a witch's. She probably hasn't even realized it herself.", "Aya")
	await novel_interface.show_dialog("So, something like Raphilia?\nIf only Sonya weren't away on another mission...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya turns on the surveillance video as she complains.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("It's no malfunction. All the readings returned to normal quickly. The sensor has been working fine since, too.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("More importantly, only Ren lost consciousness while all the others there were fine...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya quickly rules out possibilities. In the end, there seems to be only one explanation...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Ren--and only Ren--absorbed 2.5 YB of data in under a second...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya finds her own conclusion hard to believe.")
	await novel_interface.show_dialog("...Remind me again how large a unit YB is?", "Mariru")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("One yottabyte is 10 to the 24th power bytes--more than all the data on the prewar internet combined...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya's voice is shaking from excitement.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("And I thought her brain was only good for games...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Yottabyte. I think I saw it in Professor Shih's report!", "Mariru")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("That ancient meteor in Hovering Palace!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya quickly pulls out that report.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("I'm afraid we'll have to rely on Ren now.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Five days later -- aboard Lebona's casino ship, Liberty Star")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Um... miss?", "Dealer")
	await novel_interface.show_dialog("Miss?", "Dealer")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("It's my turn?", "Ren")
	await novel_interface.show_dialog("F- Fold...", "Ren")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Sorry, but I have to sit one round out.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The girl leaves the table and walks to a quiet place in the corner of the aisle.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("I had a flush! Why'd you tell me to fold?!", "Ren")
	await novel_interface.show_dialog("(lowers her voice). Especially after I'd already bet so much money...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ren's low voice can't hide her disappointment.")
	await novel_interface.show_dialog("Take out your phone and pretend you're on a call, Ren. Right now, to everyone else, it just looks like you're muttering to yourself.", "Annie")
	await novel_interface.show_dialog("There are three control rooms on this ship. I've already raided one...", "Annie")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(R- Raid?!...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Cameras are everywhere on this ship. If anyone notices your micro-earpiece, you'll be thrown to the sharks.", "Nix")
	await novel_interface.show_text_only("I feel chills down my spine. I hurriedly take out my phone.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("I've already lost 20% of what I brought. Didn't you say I had to double my money before I could get into the VIP room?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I'm looking at the number on the wristband the casino issued and telling myself again and again--this is not money.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(But it's still hard-earned money from New Opulentia's taxpayers!)", "Ren")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("Thirty thousand meters up in the sky, aboard an SID high-speed heavy transport, Nix watches the projection screen with a cup of tea in hand.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("You only had the 2 and 6 of diamonds. Judging by his behavior, there was a high chance he had a flush too, and his cards were almost certainly higher than yours.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Seriously?!\nI was just about to go all in...", "Ren")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*sigh*", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She has no idea how to explain it clearly to Ren, the same girl who fell asleep drooling on a pile of chips worth fifty million last night.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("The most common mistake a rookie makes--whenever they've got a good hand, they want to bet big, even go all-in.", "Nix")
	await novel_interface.show_dialog("As if the good hand deprives them of the ability to do any analytical thinking.", "Nix")
	await novel_interface.show_dialog("Ignorance leads to fear; fear leads to recklessness. In the end, rookies can go all-in as their way to stop their fear.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("They'll only feel free after they've bet everything they've got.", "Nix")
	await novel_interface.show_dialog("The result is that his opponent can easily predict his decision from his behavior.", "Nix")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("In a nutshell, you won't win much money when you have a good hand, and will lose everything when your opponent has a better hand.", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Anyone who gambles away everything they have is that kind of fool.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("That's harsh!", "Ren")
	await novel_interface.show_text_only("Ren shivers uncontrollably.")
	await novel_interface.show_text_only("Nix takes a sip of her tea, then goes on.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Listen, Texas hold 'em is a turn-based game.", "Nix")
	await novel_interface.show_dialog("What matters the most isn't your cards, rather your opponents.", "Nix")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
	await novel_interface.show_dialog("After you take an action, your opponents will only have three options--fold, call, or raise.", "Nix")
	await novel_interface.show_dialog("So, you should make your moves based on one principle--make your opponents unable to find reasons to support either of their three options.", "Nix")
	await novel_interface.show_dialog("The best move is a move that makes your opponents feel that any choice they make could be right but could also be wrong at the same time.", "Nix")
	await novel_interface.show_dialog("It does make sense...", "Ren")
	await novel_interface.show_dialog("When they're caught in a situation like that, they'll panic--even suffer.", "Nix")
	await novel_interface.show_dialog("And it'll be their turn to want to break free.", "Nix")
	await novel_interface.show_dialog("Then the game is yours to control--the perfect moment to clean them out.", "Nix")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Clean them out...", "Ren")
	await novel_interface.show_text_only("I nod my head as I ruminate on Nix's words.")
	await novel_interface.show_dialog("(Where did Nix learn all that?...)", "Ren")
	await novel_interface.show_dialog("(Anyway, I'm never playing poker with her!)", "Ren")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("I return to the poker table. With the help of Nix, I double my chips in less than an hour.")
	await novel_interface.show_text_only("In the hand where I made the most money, the moment I shoved all my chips in, I heard Nix and Aya start talking about what I look like when I sleep.")
	await novel_interface.show_text_only("They even swapped photos! I was so embarrassed that my face turned red.")
	await novel_interface.show_text_only("My opponents didn't know what was going on--they thought I was bluffing... So, they fell right into the trap.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("I still feel they went too far despite helping me win.", "Ren")
	await novel_interface.show_dialog("I don't want to think about it any longer!", "Ren")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Now, I'm following the casino waiter to enter the VIP room.")
	await novel_interface.show_text_only("The ambiance of this room is nothing like the lobby. Decorations, tables, chairs... They're all much fancier.")
	await novel_interface.show_text_only("Three men in expensive suits are sitting by a table, already a bit tipsy. Several hot chicks are chatting on the couch.")
	await novel_interface.show_text_only("\"Liberty Star\" is a small casino ship reserved for high rollers. Wrapped in gray armor, it keeps a very low profile.")
	await novel_interface.show_text_only("Boarding this ship requires buying at least 20 million in chips, and there aren't even a few dozen guests aboard.")
	await novel_interface.show_text_only("As for the VIP room, you need to win more than 50 million...")
	await novel_interface.show_text_only("Following Mariru's instructions, I exchanged 100 million in cash for a single gold chip engraved with an exquisite Lebona crest.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Maybe the rumors really were true...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Chips made from Substance H that can withstand strong impact, magnetic fields, and high temperatures; they can be cashed in at hundreds of casinos all over the world.")
	await novel_interface.show_text_only("It's arguably the highest-valued bearer bond.")
	await novel_interface.show_dialog("We've hijacked all their surveillance cameras. It's a go whenever you're ready! ", "Annie")
	await novel_interface.show_text_only("Finally, some good news!")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
