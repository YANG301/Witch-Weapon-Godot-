# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("So this is the vault aboard the \"Liberty Star\"...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look around in astonishment. The ceiling, floor, and both walls are all clad in mirror-bright metal panels made of some special material.")
	await novel_interface.show_text_only("I compare the metal panels to the gold chip in my hand. The color is similar, but the walls give off a faint gray-green sheen.")
	await novel_interface.show_text_only("Only certain VIP guests are allowed to use the safes in the hold--and I only just obtained that privilege.")
	await novel_interface.show_text_only("The only way in or out is the elevator in the VIP area, and the door at the bottom is as thick as a wall.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(No signals here... Just as expected.)", "Ren")
	await novel_interface.show_text_only("I lost my comm as soon as I entered the elevator. Now, I must do everything exactly the way I did during the drill and can't even get one step wrong.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Step one: confirm the surveillance system is down... OK.)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I notice several cameras inside the vault blinking at the same time, then all going dark.")
	await novel_interface.show_dialog("Miss, your safe is No. 1212. Each time it's opened, both your key and ours have to be inserted...", "Waiter")
	await novel_interface.show_text_only("The waiter politely turns to hand me the key, only to find a bottle of \"perfume\" pointed straight at his face--")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("I'm so sorry!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("After one spray to the face, his eyes immediately go dull. He seems like he wants to say something, but after opening his mouth a few times, not a sound comes out.")
	await novel_interface.show_text_only("This anesthetic spray is a new SRD product. Aya even added a drug that removes the brain's inhibitory control.")
	await novel_interface.show_text_only("Anyone sprayed by it enters something like a hypnotic state and becomes extremely receptive to suggestion.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Come and stand here.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I carefully lead the dazed waiter to a spot directly facing the elevator door and slip a red chip into his hand.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Ahem...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Recalling the lines I'd been told to rehearse over and over, I address him in a firm voice--")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("You brought me here to the vault safe just now. Everything was normal.", "Ren")
	await novel_interface.show_dialog("After storing my item, I gave you a chip as a tip.", "Ren")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("The moment you hear a finger snap or see the elevator door open, you'll wake up and \"remember\" every detail.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The waiter can't say anything. He just stares at the elevator door. I carefully walk away.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(That's really enough?...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru said the human brain is good at filling in details from a few simple cues and suggestions... but this still feels way too easy, doesn't it?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("What exactly will he recall?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Still muttering to myself, I walk to the middle of the vault, quickly take off my high heels, and place them neatly on the floor.")
	await novel_interface.show_text_only("Then I stuff my earpiece and every other metal object into my handbag and leave it beside the heels.")
	await novel_interface.show_text_only("This vault is a huge superconducting static-magnetic shielding chamber, capable of blocking most radiation and magnetic fields.")
	await novel_interface.show_text_only("Lebona doesn't have technology like this. According to Professor Shih's intel, the shielding chamber was commissioned from a military manufacturer in Hovering Palace.")
	await novel_interface.show_text_only("I find the target container. Between the two keyholes on each door is a faint laser-etched cloud motif.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Container No. 0812...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I insert two ceramic master keys into the two locks at the same time and activate the switches on their ends.")
	await novel_interface.show_text_only("Fabella once said that the keys for private safes in banks and similar institutions are actually very low-security--")
	await novel_interface.show_text_only("Part of the reason is that those institutions are extremely confident in the security protecting the vault itself.")
	await novel_interface.show_text_only("More importantly, the key gives customers the illusion that only they can open the safe, which makes paying for the service feel a lot easier.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(So the vault and the security system provide \"security,\" while the key provides \"peace of mind\"...?)", "Ren")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Why does that sound so much like something Mariru would say? I hate it...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Click. The safe is open!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Inside the container lay the black meteorite over 1.5 meters long--")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("EX level Substance H?!", "Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Yes, EX level!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("But I remember you said that EX level is connected to religions.", "Ren")
	await novel_interface.show_dialog("As they're special to religious followers, EX level Substance H can be collected, but research is prohibited.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Some Substance H is said in religious legends to possess the power to kill gods.")
	await novel_interface.show_text_only("Once activated, it could trigger a doomsday-class disaster, so all forms of research are strictly forbidden.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("And yes...")
	await novel_interface.show_text_only("The reason I remember all of that so clearly...")
	await novel_interface.show_text_only("Is because the Destiny Spear she stole was EX-grade Substance H too!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Is she talking about me?)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look up and check myself in the mirror.")
	await novel_interface.show_text_only("It's exactly how I look in all the dreams I've had lately.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("EX level Substance H is connected to more than religions.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru's voice brings me back to reality.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Our test shows that the meteorite fell to Earth more than 4,000 years ago. It was excavated by Egyptian archaeologists before the war.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("Due to its regular corners and flat faces, it was concluded that the meteorite couldn't have formed naturally.", "Mariru")
	await novel_interface.show_dialog("At first, people thought it was a type of sarcophagus from Ancient Egypt, but that meteor was whole, without even the slightest crack.", "Mariru")
	await novel_interface.show_dialog("Years later, as issues surrounding Substance H escalated, the meteorite was transferred to the Hovering Palace Museum.", "Mariru")
	await novel_interface.show_dialog("Professor Shih was one of the lead researchers studying it. When Hovering Palace first received the meteorite, they thought they'd hit the jackpot.", "Mariru")
	await novel_interface.show_dialog("But they soon discovered that the meteorite refused every form of probing and intrusion.", "Mariru")
	await novel_interface.show_dialog("To begin with, its own magnetic field fluctuates periodically, almost like breathing--and at its peak, the field is nearly as strong as that of a neodymium magnet.", "Mariru")
	await novel_interface.show_dialog("The moment it detects radiation, its magnetic field surges sharply, reaching an intensity too high to measure.", "Mariru")
	await novel_interface.show_dialog("Not only did the experiment fail, it almost blew up the entire research station.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("...What if, say, I tried cutting it open?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Although the meteorite itself isn't especially hard, any attempt to damage its structure makes it emit intense heat and radiation.", "Mariru")
	await novel_interface.show_dialog("According to our calculations, if someone forcibly cut it open, the energy released would be enough to wipe out half the planet.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("No wonder research is prohibited...", "Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("It's also extremely unstable--a ticking bomb that no one knows when it will go off.", "Mariru")
	await novel_interface.show_dialog("Hovering Palace tried every way it could think of to get rid of the meteorite. In the end, the church agreed to take it over, and Samonton granted permission.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Speaking of the church. Sonya sent me an email this afternoon. Attached was a picture of her in the Penitentiary workshop.")
	await novel_interface.show_text_only("After the last incident, Sonya returned to the church. She said she needed to investigate something and upgrade a few \"tools.\"")
	await novel_interface.show_text_only("The room in her picture was full of expensive equipment. I almost mistook it for an SRD facility.")
	await novel_interface.show_text_only("If Sonya wasn't wearing her nun uniform, there wouldn't have been anything in that picture that would make people connect the place to religion.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Sounds like the church really will accept anyone and anything, as long as the price is right...)", "Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("The meteor couldn't be transported by a plane due to its strong magnetism. The only safe way was by ship.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Which led to another problem--once the ship passed through the Suez Canal, it could end up violating a whole series of international conventions...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("And that's where Lebona came in?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Exactly! The Hovering Palace even provided Substance H to build a safe vault on the ship to block radiation and magnetic fields.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("And by leaking all this intel to us...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru nods as she confirms Annie's theory.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("You've come into contact with something similar to this meteorite before, though.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Oh?", "Ren")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("While replying to her, I'm already distracted by one of the photos in the email. It's a shot of The Last Judgment, the fresco Sonya photographed in the Sistine Chapel.")
	await novel_interface.show_text_only("Relieved to see that Sonya can still move around the church freely, I start looking up information about the fresco.")
	await novel_interface.show_dialog("(Michelangelo... He's from the same era as Henriette.)", "Ren")
	await novel_interface.show_dialog("It feels like every genius from that era had an obsession with nude bodies...", "Ren")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Henriette's \"Tesheim Lapis Pillar.\"", "Mariru")
	await novel_interface.show_dialog("The pillar's surface temperature also fluctuates, just like breathing.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("So...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Both Mariru and Annie turn to look at me. The room suddenly falls silent.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ahem...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Huh??", "Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("To avoid another \"Heaven's Door\" incident from happening again, Mariru changed the SID protocol.")
	await novel_interface.show_text_only("It's mandatory to follow up all the intel related to EX level Substance H.")
	await novel_interface.show_text_only("\"You can't save the whole world by staying inside New Opulentia. We also need a key to the United Council.\"")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(True, but...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Those men in black special combat suits come across my mind, as does my fear.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(I just hope my key doesn't snap in the lock...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I reluctantly open the No.0812 safe and look at the black meteor stored inside.")
	await novel_interface.show_text_only("According to Aya, the room I'm standing in should be able to withstand even the strongest sorcery.")
	await novel_interface.show_text_only("On top of that, there's a Tactical Response Unit aboard this casino ship, ready to handle any kind of emergency.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("So I just need to touch it once?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervous or scared? I'm not sure. But I could almost feel my blood rushing through my veins.")
	await novel_interface.show_text_only("I reach out my hand slowly toward the meteor and close my eyes.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("It feels... soft?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("I open my eyes again. My palm is already resting on the meteorite. It's hard and slightly damp.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Was that just my imagination? I could've sworn I touched something soft...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I touch the meteor again. It's indeed hard and flat.")
	await novel_interface.show_text_only("According to the original plan, I was supposed to touch the meteor only once.")
	await novel_interface.show_text_only("Confused, I close the safe and put the lock back in place. Then I stand there quietly in front of it, still trying to figure out what I felt the first time.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(What was that...?)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, a strange sound comes from behind me--like a button dropping onto the floor.")
	await novel_interface.show_text_only("In this sealed little room, the noise of the object rolling across the floor sounds unnaturally clear.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I turn around--it's a tiny yellow thing. I walk over and pick it up.")
	await novel_interface.show_text_only("It's a tiny round object with eight little bumps on its surface.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("... Did it fall off my dress?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("But it looks just like the konpeito candy I used to eat when I was little. For a second I almost want to lick it.")
	await novel_interface.show_dialog("Huh?", "???")
	await novel_interface.show_text_only("It's a little girl's voice!")
	novel_interface.show_character("stardust_small","smile")
	await novel_interface.show_dialog("Huh? What am I supposed to be looking for?", "Stardust")

	print("=== 星尘降临篇第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
