# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Probabilmente conosci già questa storia classica...")
	await novel_interface.show_text_only("A un uomo ricco furono rubati gli oggetti di valore. La polizia trovò la refurtiva in una stanza condivisa da due sospettati, ma non aveva prove sufficienti per condannarne uno dei due.")
	await novel_interface.show_text_only("Così la polizia separò i due sospettati e pose loro questa scelta:")
	await novel_interface.show_text_only("Se uno confessa e l'altro resta in silenzio, il primo viene rilasciato e il secondo si prende dieci anni di carcere.")
	await novel_interface.show_text_only("Se entrambi tacciono, ricevono sei mesi a testa. Ma se confessano entrambi, si prendono cinque anni ciascuno.")
	await novel_interface.show_text_only("Per i due protagonisti di questa storia, l'esito che gioverebbe di più a entrambi resta per sempre fuori portata...")
	await novel_interface.show_text_only("Perché, che l'altra parte taccia o confessi, confessare per primi porta sempre a un risultato migliore. La confessione diventa così la strategia dominante.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Alcuni economisti sostengono che, nella vita reale, i giochi ripetuti possano insegnare a entrambe le parti che cooperare è la strategia migliore.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Ma alcuni giochi non lasciano spazio per un secondo round...")
	await novel_interface.show_text_only("Una volta che entrambe le parti si sospettano reciprocamente, non potranno mai sfuggire a questo \"dilemma del prigioniero\"...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Periferia, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Una lunga limousine si ferma all'ingresso della tenuta. Una ragazza ben vestita scende goffamente dal sedile posteriore.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("T-Questo tipo di posto...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Davanti a me c'era una sontuosa tenuta in stile europeo: un cancello di ottone, sculture squisite, persino il prato e gli arbusti tagliati alla perfezione.")
	await novel_interface.show_text_only("Non avevo idea che esistesse un posto simile in New Opulentia. Mentre osservo lo splendido scenario, sento la voce severa di Mariru dal mio auricolare.")
	await novel_interface.show_dialog("Smettila di stupirti. Stai praticamente sbavando.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Va bene, va bene...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi riprendo e faccio un passo avanti, inciampando subito nelle scarpe.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Questi tacchi sono troppo alti... E perché la gonna del vestito è così corta?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Ed è anche un po' stretto in vita. Ho mangiato troppo ultimamente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Fatti coraggio, non piegarti. Sembri un'aragosta.", "Mariru")
	await novel_interface.show_dialog("Non è il tuo primo giorno da ragazza!", "Mariru")
	await novel_interface.show_text_only("Così fastidioso--!!")
	await novel_interface.show_text_only("Mentre mi avvicino all'ingresso della villa, un portiere apre il cancello e mi saluta.")
	await novel_interface.show_text_only("Forzo un sorriso e prego intensamente di non inciampare di nuovo sulle scale.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Facendo attenzione, entro nella villa e passo attraverso una serie di complicati controlli di sicurezza. L'interno dell'edificio appare alla vista ed è stupendo.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("La lobby, anche se non è molto grande, è ovviamente progettata da qualcuno con gusto. Anche la lampada nell'angolo brilla come solo un oggetto d'antiquariato potrebbe fare.")
	await novel_interface.show_text_only("Nella mia testa, ripeto quello che ho imparato ieri nell'etichetta 101. Petto in fuori, pancia in dentro, collo dritto, sorridi, faccia in avanti...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(E non rompere nulla!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nel momento in cui entro nell'atrio, gli ospiti, tutti vestiti a festa e che sussurrano a due o a tre, si girano a fissarmi come se fossero uno solo.")
	await novel_interface.show_dialog("Wow, Lian, sei carino oggi!", "Annie")
	await novel_interface.show_text_only("Osservando ogni mio movimento dalla telecamera di sorveglianza, Annie sembra eccitata, anche se si ricorda di tenere la voce bassa.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Beh, questo vestito sembra davvero carino, è vero...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma sono un ragazzo! Uffa!")
	await novel_interface.show_dialog("Gli ospiti qui sono tutti personaggi famosi provenienti dalle varie Città Accademia. In apparenza, questo posto gestisce un casinò riservato ai soli membri con una licenza speciale del Senato.", "Mariru")
	await novel_interface.show_dialog("Ma i veri affari del maniero sono il contrabbando e il commercio di informazioni. È anche il più grande garante sotterraneo di tutto New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Quindi stai cercando di raccogliere prove per poter fare irruzione in questo posto...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sussurro, sorridendo e annuendo alle persone intorno a me.")
	await novel_interface.show_dialog("Ti sembro davvero così privo di tatto?\nInoltre, se volessi fare irruzione in un posto, avrei bisogno di prove?", "Mariru")
	await novel_interface.show_text_only("Mariru risponde. Scommetto che sta alzando gli occhi al cielo mentre parliamo.")
	await novel_interface.show_dialog("Devi prima attirare l'attenzione del bersaglio. Annie aiuterà.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Tutti qui sembrano essere tra i quaranta e i cinquanta. Ovviamente sono uno studente delle superiori... non sarebbe sospetto?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La sicurezza ti ha già scansionato e controllato i tuoi dati nel momento in cui hai varcato i cancelli.", "Mariru")
	await novel_interface.show_dialog("E non preoccuparti, apparirai nel sistema come un normale studente delle superiori che lavora part-time in un maid café.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Eh?\n(Perché qualcuno del genere dovrebbe essere ammesso a questo tipo di riunione?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi blocco, nervoso, tremando a disagio sotto lo sguardo degli altri ospiti.")
	await novel_interface.show_dialog("Persone come te vengono qui di tanto in tanto. Alcuni ospiti apprezzano molto questo genere di cose.", "Mariru")
	await novel_interface.show_text_only("Cosa intendi con \"persone come me\"?!!")
	await novel_interface.show_dialog("Il bersaglio è seduto vicino all'angolo, vicino alle scale. Sembra un po' nervoso.", "Annie")
	await novel_interface.show_text_only("Vado alla deriva in un punto da cui posso osservare il bersaglio e dare uno sguardo furtivo...")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Maledizione! Maledizione! Maledizione!", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("L'obiettivo è un uomo di mezza età che abbraccia una borsa. I suoi capelli sono un disastro, i peli del viso sono spettinati. Non assomiglia per niente agli altri ospiti.")
	await novel_interface.show_text_only("Un vecchio cappotto, una camicia bianca sotto un maglione color senape e perfino una sciarpa verde...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("Quello è il professor Shih?\n(È incredibilmente di cattivo gusto!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sì, immagino di sì...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Va bene.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Per qualche ragione, mi sentivo stranamente sicuro di come apparivo oggi.")
	await novel_interface.show_text_only("Mi avvicino a lui e fingo di ammirare le vetrate colorate al piano di sopra, dondolando i fianchi mentre cammino avanti e indietro. Il ragazzo continua a non guardarmi bene.")
	await novel_interface.show_text_only("Un po' riluttante ad arrendermi, di nascosto mi tiro le protezioni per il petto e mi avvicino, fingendo di esaminare la testa di cervo appesa al muro.")
	await novel_interface.show_text_only("In realtà ha voltato la testa disgustato!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Amico, andiamo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Uhm... mi scusi, signorina...", "Ospite maschile")
	await novel_interface.show_text_only("Al mio fianco appare un uomo di mezza età in smoking e papillon.")
	await novel_interface.show_dialog("Gestisco una società di media in Newmoridas... Ti interesserebbe chiacchierare un po'?", "Ospite maschile")
	await novel_interface.show_text_only("Sfregandosi le mani, l'uomo sorride allegramente.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("S-scusa, scusami...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi tengo lo stomaco, come se fossi colpito da un improvviso capogiro, e mi intrufolo in un angolo, dove lancio alla telecamera di sorveglianza uno sguardo disperato.")
	await novel_interface.show_text_only("L'obiettivo non ha reagito affatto. Alla fine ho solo attirato qualche tipo strano.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Non riesco proprio ad attirare l'attenzione di quel ragazzo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, sei troppo rigido...", "Annie")
	await novel_interface.show_dialog("Sembra anche che stia aspettando qualcuno. E qualunque cosa ci sia in quella borsa sembra sospetta.", "Annie")
	await novel_interface.show_dialog("C'è un dispositivo per la creazione di immagini nella tua borsetta. Abbiamo scannerizzato la sua borsa proprio adesso: all'interno non c'erano componenti elettronici, solo venti o trenta pagine di documenti cartacei.", "Mariru")
	await novel_interface.show_dialog("È davvero un vecchio fossile...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Aya non ha detto che questa cosa potrebbe fotografare il contenuto di più documenti cartacei attraverso gli ostacoli?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sollevo la borsa sorprendentemente pesante. Sotto la pelle verniciata accuratamente cucita, è pieno di piccoli gadget dell'SRD.")
	await novel_interface.show_text_only("La cosa più sorprendente è che, grazie al rivestimento appositamente trattato, ha in qualche modo superato il controllo di sicurezza all'ingresso.")
	await novel_interface.show_dialog("Per fotografare più fogli contemporaneamente, la polvere metallica deve essere dispersa uniformemente nello spazio in modo che i raggi che attraversano ciascuna pagina raggiungano livelli di intensità diversi.", "Mariru")
	await novel_interface.show_dialog("Nella tua borsa c'è una capsula di polvere metallica fatta esplodere a distanza, ma sono molte pagine. Dovrai agitarlo con forza affinché la polvere si distribuisca in modo uniforme.", "Mariru")
	await novel_interface.show_dialog("La capsula non emetterà alcun suono quando scoppierà? E ha abbracciato quella borsa come se fosse un tesoro...", "Annie")
	await novel_interface.show_dialog("Non hai una carica appiccicosa che può far saltare la serratura di una porta?", "Mariru")
	await novel_interface.show_dialog("È ancora più forte!\nE se attira l'attenzione con quel vestito e le persone sbagliate se ne accorgono...", "Annie")
	await novel_interface.show_text_only("Un brivido mi attraversa mentre ricordo il modo in cui quel mostro dell'azienda dei media continuava a fissarmi il petto.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Adesso che ci penso...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("La lobby sembra la nostra scelta migliore.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Non ci sono finestre. Anche i vetri colorati non lasciano entrare la luce, probabilmente per garantire la privacy.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Potete togliere la corrente a questa stanza?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sembra che tu abbia in mente qualcosa di audace, ragazzo...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Ritorno nell'atrio e passo accanto al Professore, cercando di comportarmi in modo naturale.")
	await novel_interface.show_text_only("All'improvviso, la lampadina dall'altra parte delle scale lampeggia e poi, con uno schiocco, si frantuma.")
	await novel_interface.show_text_only("Non appena tutti, professore compreso, si voltano, infilo una capsula d'argento nell'apertura della sua borsa.")
	await novel_interface.show_text_only("Poi mi accovaccio come per aggiustarmi i talloni e premo rapidamente la carica di colla contro una gamba della sedia.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Perfetto!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Faccio segno \"OK\" alla telecamera di sorveglianza e mi allontano di qualche passo.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Un tonfo arriva dal soffitto e in un attimo tutte le luci della stanza si spengono. Il professore urla.")
	await novel_interface.show_text_only("Prima che qualcuno possa reagire, una gamba della sedia si spezza e il Professore cade a terra.")
	await novel_interface.show_text_only("Nella stanza buia, punto il lato di scansione della mia borsa verso i file e prego furtivamente che il dispositivo funzioni come dovrebbe.")
	await novel_interface.show_text_only("Gli ospiti scoppiano in confusione. Un maggiordomo si precipita a calmare tutti, dicendo che la corrente tornerà a breve.")
	await novel_interface.show_dialog("Funziona.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Espiro con sollievo. Non appena metto giù la borsa, le luci si riaccendono.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("Sì!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tutto fatto!")
	await novel_interface.show_dialog("Ehi, voi due...", "???")
	await novel_interface.show_text_only("Una voce femminile... da dietro di me.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Ho guardato dal piano di sopra. Cosa stai facendo quaggiù, cerchi di sedurre la gente?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("...Niente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La ragazza più grande scruta il Professore, che è seduto vicino a noi, massaggiandosi il sedere.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Quella sedia ha almeno centotrenta anni. Secondo gli esperti vale più di due milioni.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Eh...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix si gira e mi posa una mano sulla guancia.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Sei vestita molto bene oggi, tesoro.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il suo dito freddo traccia una linea lungo il mio viso, raggiunge l'auricolare a conduzione ossea, che recupera con un sorriso freddo.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("... Allora come pensi di pagarlo?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
