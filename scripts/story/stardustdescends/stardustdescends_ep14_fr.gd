# stardustdescends_ep14.gd - 星尘降临篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep14_script()

func play_script():
	pass

func stardustdescends_ep14_script():
