	await novel_interface.show_dialog("Aaaaaahhhhh--!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle dévala la pente à grands pas. Si son emprise glissait maintenant, je volerais comme un petit phoque glissant sur la glace.")
