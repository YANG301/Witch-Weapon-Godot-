	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Restez caché ici. Je vais aider Emily à allumer le feu !", "Vera")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Jetant cette corde par-dessus son épaule, elle sauta dans la jeep et s'enfuit...")
