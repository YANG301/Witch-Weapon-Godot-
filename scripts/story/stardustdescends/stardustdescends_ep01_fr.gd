# stardustdescends_ep01.gd - 星尘降临篇第1话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep01_script()

func play_script():
	pass

func stardustdescends_ep01_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Prisoner.png")
	await novel_interface.show_text_only("Vous connaissez probablement déjà cette histoire classique...")
	await novel_interface.show_text_only("Les objets de valeur d'un homme riche ont été volés. La police a retrouvé le butin dans une chambre partagée par deux suspects, mais ne disposait pas de preuves suffisantes pour condamner l'un ou l'autre.")
	await novel_interface.show_text_only("La police a donc séparé les deux suspects et leur a proposé le choix suivant :")
	await novel_interface.show_text_only("Si l'un avoue pendant que l'autre garde le silence, le premier est libéré et le second écope de dix ans de prison.")
	await novel_interface.show_text_only("Si tous deux se taisent, ils écopent chacun de six mois. Mais s'ils avouent tous les deux, ils écopent chacun de cinq ans.")
	await novel_interface.show_text_only("Pour les deux personnes de cette histoire, l'issue qui servirait au mieux leurs intérêts communs restera à jamais hors de portée...")
	await novel_interface.show_text_only("Car que l'autre se taise ou avoue, avouer soi-même mène toujours à un meilleur résultat. L'aveu devient alors la stratégie dominante.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Certains économistes estiment que, dans la vie réelle, des jeux répétés peuvent apprendre aux deux parties que la coopération est la meilleure stratégie.")
	novel_interface.show_background("res://assets/images/bg/Shot/storyBGWar.png")
	await novel_interface.show_text_only("Mais certains jeux ne laissent pas de place à un second tour...")
	await novel_interface.show_text_only("Une fois que les deux parties se méfient mutuellement, elles ne pourront jamais échapper à ce « dilemme du prisonnier »...")
	novel_interface.hide_background()
	await novel_interface.show_text_only("<Périphérie, New Opulentia>")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Manorgate.png")
	await novel_interface.show_text_only("Une limousine allongée s'arrête à l'entrée du domaine. Une jeune fille finement habillée sort maladroitement de la banquette arrière.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("T-Ce genre d'endroit--!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Devant moi se trouvait un somptueux domaine de style européen : un portail en laiton, des sculptures exquises, même la pelouse et les arbustes taillés à la perfection.")
	await novel_interface.show_text_only("Je n'avais aucune idée qu'un tel endroit existait dans New Opulentia. Alors que j'admire le magnifique paysage, j'entends la voix sévère de Mariru dans mon oreillette.")
	await novel_interface.show_dialog("Arrêtez de rester bouche bée. Vous êtes pratiquement en train de baver.", "Mariru")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Très bien, très bien...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me reprends et fais un pas en avant, trébuchant aussitôt sur mes chaussures.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Ces talons sont bien trop hauts... Et pourquoi cette jupe habillée est-elle si courte ?!", "Lian")
	novel_interface.change_expression("shy_right")
	await novel_interface.show_dialog("(Et c'est aussi un peu serré au niveau de la taille. Est-ce que j'ai trop mangé ces derniers temps... ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Rassurez-vous, ne vous affalez pas. Tu ressembles à un homard.", "Mariru")
	await novel_interface.show_dialog("Ce n'est pas ton premier jour en tant que fille !", "Mariru")
	await novel_interface.show_text_only("Tellement ennuyeux--!!")
	await novel_interface.show_text_only("Alors que je m'approche de l'entrée de la villa, un portier ouvre les portes et me salue.")
	await novel_interface.show_text_only("Je me force à sourire et prie fort pour ne plus trébucher dans les escaliers.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("En prenant des mesures prudentes, j'entre dans la villa et passe une série de contrôles de sécurité compliqués. L'intérieur du bâtiment apparaît et c'est magnifique.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Le lobby, même s'il n'est pas grand, est évidemment conçu par quelqu'un de goût. Même la lampe dans le coin brille comme seule une antiquité peut le faire.")
	await novel_interface.show_text_only("Dans ma tête, je répète ce que j'ai appris hier dans l'étiquette 101. Poitrine dehors, ventre rentré, cou droit, sourire, visage devant...")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Et ne casse rien !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Au moment où j'entre dans le hall, les invités, tous habillés à neuf et chuchotant par deux ou trois, se tournent pour me regarder comme un seul.")
	await novel_interface.show_dialog("Wow, Lian, tu es jolie aujourd'hui !", "Annie")
	await novel_interface.show_text_only("En observant chacun de mes mouvements depuis la caméra de surveillance, Annie semble excitée, même si elle se souvient de garder sa voix basse.")
	novel_interface.show_character("ren_full","blush")
	await novel_interface.show_dialog("(Eh bien, cette robe est vraiment jolie, c'est vrai...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mais je suis un mec ! Pouah!")
	await novel_interface.show_dialog("Les invités ici sont tous des élites célèbres des différentes villes universitaires. En apparence, cet endroit gère un casino réservé aux membres sous une licence spéciale du Sénat.", "Mariru")
	await novel_interface.show_dialog("Mais la véritable activité du manoir est la contrebande et le commerce des renseignements. C'est aussi le plus grand garant souterrain de tout New Opulentia.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Donc vous essayez de rassembler des preuves pour pouvoir faire une descente dans cet endroit... ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je murmure, tout en souriant et en hochant la tête aux gens autour de moi.")
	await novel_interface.show_dialog("Est-ce que je vous semble vraiment manquer de tact ?\nD'ailleurs, si je voulais faire une descente dans un endroit, aurais-je besoin de preuves ?", "Mariru")
	await novel_interface.show_text_only("Mariru répond. Je parie qu'elle roule des yeux pendant que nous parlons.")
	await novel_interface.show_dialog("Vous devez d’abord attirer l’attention de la cible. Annie va l'aider.", "Mariru")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Ici, tout le monde semble avoir entre 40 et 50 ans. Je suis évidemment lycéen... cela ne serait-il pas suspect ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("La sécurité vous a déjà scanné et vérifié vos dossiers au moment où vous avez franchi les portes.", "Mariru")
	await novel_interface.show_dialog("Et ne vous inquiétez pas, vous apparaîtrez dans le système comme un lycéen normal qui travaille à temps partiel dans un maid café.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Hein ?\n(Pourquoi quelqu'un comme ça serait-il autorisé à participer à ce genre de rassemblement ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me fige, nerveux, rampant inconfortablement sous le regard des autres invités.")
	await novel_interface.show_dialog("Des gens comme vous viennent ici de temps en temps. Certains invités sont très friands de ce genre de choses.", "Mariru")
	await novel_interface.show_text_only("Que veux-tu dire par « les gens comme moi » ?!!")
	await novel_interface.show_dialog("La cible est assise près du coin, près des escaliers. Il a l'air un peu nerveux.", "Annie")
	await novel_interface.show_text_only("Je dérive vers un endroit où je peux observer la cible et jeter un coup d'œil par-dessus...")
	novel_interface.show_character("shi","angry")
	await novel_interface.show_dialog("Bon sang ! Bon sang ! Bon sang !", "???")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La cible est un homme d’âge moyen tenant un sac dans ses bras. Ses cheveux sont en désordre, ses poils sur le visage sont en désordre. Ne ressemble en rien aux autres invités.")
	await novel_interface.show_text_only("Un vieux manteau, une chemise blanche sous un pull couleur moutarde, et même une écharpe verte...")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("C'est le professeur Shih ?\n(Il est incroyablement ringard !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ouais, je suppose...", "Annie")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Très bien.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Pour une raison quelconque, je me sentais étrangement confiant quant à mon apparence aujourd'hui.")
	await novel_interface.show_text_only("Je m'approche devant lui et fais semblant d'admirer les vitraux à l'étage, balançant mes hanches en faisant les cent pas. Le gars ne me regarde toujours pas correctement.")
	await novel_interface.show_text_only("Un peu réticent à abandonner, je tire secrètement sur mes coussinets de poitrine et me rapproche, faisant semblant d'examiner la tête de cerf montée sur le mur.")
	await novel_interface.show_text_only("En fait, il a détourné la tête avec dégoût !!")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Mec, allez !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Euh... excusez-moi, mademoiselle...", "Invité masculin")
	await novel_interface.show_text_only("Un homme d’âge moyen en smoking et nœud papillon apparaît à mes côtés.")
	await novel_interface.show_dialog("Je dirige une entreprise de médias à Newmoridas... Seriez-vous intéressé à discuter un peu ?", "Invité masculin")
	await novel_interface.show_text_only("En se frottant les mains, l'homme rayonne de joie.")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("S-Désolé--excusez-moi...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je me tiens le ventre, comme frappé par un soudain vertige, et me faufile dans un coin, où j'envoie à la caméra de surveillance un regard désespéré.")
	await novel_interface.show_text_only("La cible n'a pas réagi du tout. J'ai seulement fini par attirer des cinglés.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Je n'arrive pas du tout à attirer l'attention de ce type...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lian, tu es bien trop raide...", "Annie")
	await novel_interface.show_dialog("Il semble aussi attendre quelqu'un. Et tout ce qu'il y a dans ce sac semble suspect.", "Annie")
	await novel_interface.show_dialog("Il y a un appareil d'imagerie dans votre sac à main. Nous venons de scanner son sac : aucun appareil électronique à l'intérieur, juste vingt ou trente pages de documents papier.", "Mariru")
	await novel_interface.show_dialog("C'est vraiment un vieux fossile...", "Annie")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Aya n'a-t-elle pas dit que cette chose pouvait photographier le contenu de plusieurs documents papier à travers des obstacles ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai soulevé le sac à main étonnamment lourd. Sous le cuir verni soigneusement cousu, il regorge de petits gadgets du SRD.")
	await novel_interface.show_text_only("Le plus étonnant, c'est que grâce à sa doublure spécialement traitée, il a réussi le contrôle de sécurité à l'entrée.")
	await novel_interface.show_dialog("Pour photographier plusieurs feuilles à la fois, la poudre métallique doit être répartie uniformément dans l'espace afin que les rayons traversant chaque page finissent avec des niveaux d'intensité différents.", "Mariru")
	await novel_interface.show_dialog("Il y a une capsule de poudre métallique déclenchée à distance dans votre sac, mais cela fait beaucoup de pages. Vous devrez le secouer fort pour que la poudre se répartisse uniformément.", "Mariru")
	await novel_interface.show_dialog("La capsule ne fera-t-elle pas de bruit lorsqu'elle éclatera ? Et il serre ce sac dans ses bras comme si c'était un trésor...", "Annie")
	await novel_interface.show_dialog("N'avez-vous pas une charge collante qui peut faire sauter une serrure de porte ?", "Mariru")
	await novel_interface.show_dialog("C'est encore plus fort !\nEt si elle attire l'attention dans cette tenue et que les mauvaises personnes le remarquent...", "Annie")
	await novel_interface.show_text_only("Un frisson me parcourt lorsque je me souviens de la façon dont ce type de société de médias n'arrêtait pas de fixer ma poitrine.")
	novel_interface.show_character("ren_full","normal2")
	await novel_interface.show_dialog("Maintenant que j'y pense...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Le lobby semble être notre meilleur choix.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il n'y a pas de fenêtres. Même le verre coloré ne laisse pas passer la lumière, probablement pour garantir l'intimité.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Pouvez-vous couper le courant dans cette pièce ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("On dirait que tu as quelque chose d'audacieux en tête, gamin...", "Mariru")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Je retourne dans le hall et passe devant le professeur, essayant d'agir naturellement.")
	await novel_interface.show_text_only("Soudain, l'ampoule de l'autre côté des escaliers clignote, puis, avec un bruit sec, elle se brise.")
	await novel_interface.show_text_only("À la seconde où tout le monde, y compris le professeur, tourne la tête, j'insère une capsule d'argent dans l'ouverture de son sac.")
	await novel_interface.show_text_only("Puis je m'accroupis comme pour ajuster mes talons et presse rapidement la charge de colle contre un pied de sa chaise.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Parfait !)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Je fais signe « OK » à la caméra de surveillance et m'éloigne de quelques pas.")
	novel_interface.hide_background()
	await novel_interface.show_text_only("Un bruit sourd vient du plafond et en un instant toutes les lumières de la pièce s'éteignent. Le professeur crie.")
	await novel_interface.show_text_only("Avant que quiconque puisse réagir, un pied de la chaise se brise et le professeur tombe au sol.")
	await novel_interface.show_text_only("Dans la pièce plongée dans l'obscurité totale, je dirige le côté numérisation de mon sac vers les fichiers et je prie furtivement pour que l'appareil fonctionne comme il est censé le faire.")
	await novel_interface.show_text_only("Les invités éclatent de confusion. Un majordome se précipite pour calmer tout le monde, disant que le courant reviendra momentanément.")
	await novel_interface.show_dialog("Ça marche.", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("J'expire de soulagement. Dès que je pose le sac, les lumières se rallument.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("Oui !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tout est fait !")
	await novel_interface.show_dialog("Hé, vous deux...", "???")
	await novel_interface.show_text_only("Une voix féminine... derrière moi.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("J'ai regardé d'en haut. Que fais-tu ici, à essayer de séduire les gens ?", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("... Nix ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La fille plus âgée regarde le professeur, qui est assis près de nous et se frotte les fesses.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Cette chaise a au moins cent trente ans. Les experts estiment que sa valeur dépasse les deux millions.", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Hein...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se retourne et pose une main sur ma joue.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Tu es très bien habillée aujourd'hui, ma chérie.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Son doigt froid trace une ligne sur mon visage, atteint mon écouteur à conduction osseuse, qu'elle récupère avec un sourire froid.")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("… Alors, comment comptez-vous payer cela ?", "Nix")

	print("=== 星尘降临篇第1话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
