	await novel_interface.show_dialog("........................??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El jeep voló trazando un elegante arco de bola de boliche hacia el enjambre que acababa de subir a la ladera, provocando una cadena de explosiones en un instante...")
