	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("¡¡¡Corre!!!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily sacó su pistola y disparó al cielo de inmediato, vaciando las doce balas en un instante.")
	await novel_interface.show_text_only("Un dron fue alcanzado por un brazo articulado y cayó fuera de la estación de suministros.")
	await novel_interface.show_text_only("Otro explotó directamente en el aire, bañando la tabla sobre nuestras cabezas con fragmentos de metal.")
	await novel_interface.show_text_only("Pero el último, arrastrando una línea roja a través del polvo, vino directo hacia nosotros...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(¡Estamos muertos!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("¡¡Boom--!!")
	await novel_interface.show_text_only("La onda expansiva de la granada, junto con el aire abrasador, llenó instantáneamente el estrecho espacio dentro del refugio y arrancó la tabla sobre nuestras cabezas.")
	await novel_interface.show_text_only("El aire se llenó del olor acre a quemado y del olor oxidado de la sangre secada instantáneamente por el calor.")
	await novel_interface.show_text_only("Al mismo tiempo, una tormenta de fragmentos de metal cayó sobre la estación de suministro...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("El impacto me hizo perder el equilibrio y caer al suelo, y un dolor agudo me desgarró la parte exterior del antebrazo.")
	await novel_interface.show_text_only("No, más importante que eso...")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("(Estoy... ¿todavía vivo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me controlé. Aparte de un corte en el antebrazo, básicamente salí ileso.")
	await novel_interface.show_text_only("Y frente a mí, protegiéndome, Emily parecía haber desplegado un escudo hecho de sangre...")
