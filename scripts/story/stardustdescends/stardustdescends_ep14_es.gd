	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("¿Qué hay en tu mano...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Realmente no quería que vieras esto...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ella movió su muñeca. La manga que se había manchado de rojo con sangre hace un momento ahora estaba completamente limpia.")
	novel_interface.show_character("ren_medical","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","stare",0.25)
