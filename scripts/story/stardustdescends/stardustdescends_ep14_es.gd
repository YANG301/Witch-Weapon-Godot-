	await novel_interface.show_dialog("Lian, corre...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me incliné y miré. Tres drones sobrevolaban la estación de suministros, realizando un escaneo completo de 360 ​​grados.")
