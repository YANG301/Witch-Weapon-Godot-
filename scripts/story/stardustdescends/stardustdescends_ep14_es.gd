	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Más del noventa por ciento de la población de Masada es religiosa. A los ojos de cualquier religión, una habilidad que manipula la sangre de esta manera sería una blasfemia y una maldición, ¿no es así?", "Emily")
