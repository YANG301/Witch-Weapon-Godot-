	await novel_interface.show_dialog("El poder de Vera es más práctico, aunque para empezar ya era increíblemente fuerte...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El jeep de Vera estaba en el borde derecho de nuestra vista.")
	await novel_interface.show_text_only("La mujer fuerte lo había detenido en la colina oriental, y la docena de drones detrás de ella la alcanzarían en unos diez segundos...")
	novel_interface.show_character("ren_medical","panic")
