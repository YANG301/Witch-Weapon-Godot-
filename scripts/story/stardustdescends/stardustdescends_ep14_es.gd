	await novel_interface.show_text_only("Emily tocó mi brazo y comenzó a salir de su refugio.")
	await novel_interface.show_text_only("Estaba a punto de seguirla cuando noté que ella se había congelado en su lugar. Su voz tembló levemente cuando dijo:")
