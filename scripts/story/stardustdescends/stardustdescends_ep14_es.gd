	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("No es nada. Necesitamos regresar rápidamente al APC. El blindaje de ese vehículo debería soportar estas cosas con espacio de sobra.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("El vehículo blindado estaba estacionado junto a la carretera bajo camuflaje óptico, a unos doscientos o trescientos metros de la estación de suministros.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
