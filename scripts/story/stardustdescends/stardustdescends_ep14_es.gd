# stardustdescends_ep14.gd - 星尘降临篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep14_script()

func play_script():
	pass

func stardustdescends_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ClusterBombs.png")
	await novel_interface.show_text_only("\"Hive\": un sistema de armas capaz de destruir indiscriminadamente personal y equipos en una amplia zona.")
	await novel_interface.show_text_only("Estos drones del tamaño de la palma de la mano eliminan los voluminosos módulos de control y llevan cada uno solo una granada de fragmentación autodestructiva.")
	await novel_interface.show_text_only("Al utilizar el reconocimiento de inteligencia artificial para distinguir al personal del equipo, docenas de drones pueden coordinarse entre sí y realizar ataques en áreas incluso de manera más efectiva que las bombas de racimo.")
	await novel_interface.show_text_only("Hace unos años, Masada arrojó grandes cantidades de colmenas en el valle de la Bekaa, lo que provocó miles de víctimas civiles y provocó una feroz condena internacional.")
	await novel_interface.show_text_only("Aun así, Masada todavía no ha firmado ningún convenio internacional que aboliera este tipo de armas...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("¡¡Boom--!!")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Con una explosión ensordecedora, la ametralladora en la colina sur de repente estalló y la lona que la cubría se rasgó en innumerables trozos carbonizados que se esparcieron por el aire...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("¿¡Por qué tienen algo así...?\n¿¡No se suponía que este camión transportaba suministros médicos!?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Las Fuerzas de Defensa debieron haber introducido silenciosamente algunos extras sin avisarles.", "Emily")
	await novel_interface.show_dialog("Hay un jeep en la estación de suministros. Vera, llévala allí.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("¡Entendido!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("¿Qué está pasando... oye, espera--aaaah!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La mujer súper fuerte me agarró de la cintura sin explicación alguna, me sujetó bajo el brazo y corrió hacia la estación de suministros.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("¡¡¡Aaaaaahhhhh--!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bajó la pendiente a grandes zancadas. Si su agarre se soltara ahora, saldría volando como una pequeña foca patinando sobre el hielo.")
	await novel_interface.show_text_only("Vera entró corriendo en la estación de suministros y me arrojó sobre una pila de sacos de arena.")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Mantente escondido aquí. ¡Voy a ayudar a Emily a encender el fuego!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Echándose esa cuerda por encima del hombro, saltó al jeep y se alejó a toda velocidad...")
	await novel_interface.show_text_only("El enjambre de drones está programado para destruir cualquier vehículo, arma o equipo circundante que no lleve dispositivos de identificación amigables.")
	await novel_interface.show_text_only("Y un vehículo que se mueve rápidamente es obviamente el objetivo de máxima prioridad.")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Temblando, me acurruqué detrás de un muro defensivo en la esquina de la estación de suministros, escuchando disparos de ametralladora a lo lejos y una explosión tras otra.")
	await novel_interface.show_text_only("Cada explosión fue seguida por un crujido de metal golpeando arena y piedra.")
	await novel_interface.show_text_only("Eran clavos de acero arrojados por las granadas, lo suficientemente mortales como para destrozar a una persona.")
	await novel_interface.show_text_only("Sin embargo, el fuego de las ametralladoras se hizo cada vez más escaso, y una enorme sensación de temor comenzó a apoderarse de mí...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Apoyé una tabla encima de la barrera y me agaché debajo como un hongo, cubriéndome la cabeza.")
	await novel_interface.show_text_only("Dicen que en la Segunda Guerra Mundial, cuando las propias ametralladoras se quedaban en silencio durante una carga, se asestaba un golpe devastador a la moral.")
	await novel_interface.show_text_only("Hoy entendí exactamente lo que eso significaba...")
	await novel_interface.show_text_only("Cuando la última ametralladora finalmente se calmó, los otros sonidos en el campo de batalla se volvieron aterradoramente distintos...")
	await novel_interface.show_text_only("El zumbido de esos drones que volaban en círculos sonaba como un cielo lleno de abejas mortales, imposibles de identificar.")
	await novel_interface.show_text_only("Parecían estar en todas partes, como la muerte misma girando sobre mí, lista para caer a mi lado en cualquier momento...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(¿Están bien esos dos...?)", "Lian")
	await novel_interface.show_dialog("(...Espera, ¿¡un motor!?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Asomé la cabeza y vi devastación por todas partes. A lo lejos, la cabaña donde se guardaban las municiones ya estaba envuelta en llamas.")
