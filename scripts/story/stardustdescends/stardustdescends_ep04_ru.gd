# stardustdescends_ep4.gd - 星尘降临篇第4话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep4_script()

func play_script():
	pass

func stardustdescends_ep4_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Fabiola/Hospital_Passage.png")
	await novel_interface.show_text_only("Несколько часов спустя — Технический исследовательский центр Харима.")
	await novel_interface.show_text_only("Крошечная девочка лениво проверяет свой планшет, разговаривая через наушник.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Не волнуйтесь. Пока мы разговариваем, двум охранникам снится сладкий сон.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Не стоит недооценивать человеческий мозг — он хочет и способен рационализировать ситуации, в которых находится.", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая снова оглядывает комнату. Двое мужчин в черных костюмах лежат на устройствах для дайвинга.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("В конце концов, люди с большей вероятностью поверят лжи, которую сами собирают...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно ее внимание привлекает что-то на планшете Аи. Она быстро пролистывает несколько страниц вниз, а затем возвращается к интересным данным.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Это...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что это такое?", "Мариру")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Датчик Больцмана превысил максимальное значение в тот момент, когда лбы Лиана и Никс соприкоснулись.", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Неисправность? Я думал, вы уже установили максимально возможное теоретическое ограничение.", "Мариру")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Почти максимально возможная стоимость. Если бы объем данных достиг границы Бекенштейна, это было бы другое дело.", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Вы хотите сказать, что в тот момент объем данных достиг абсолютно самого высокого уровня, который может нести любое вещество?", "Мариру")
	await novel_interface.show_text_only("Ая быстро делает какие-то расчеты на своем планшете.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Если отбросить эту аномалию, параметры Никс очень близки к ведьме. Она, наверное, даже сама этого не осознала.", "Ая")
	await novel_interface.show_dialog("Итак, что-то вроде Рафилии?\nЕсли бы только Соня не уехала на очередное задание...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая включает видеонаблюдение и жалуется.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Это не неисправность. Все показания быстро пришли в норму. Датчик с тех пор тоже работает нормально.", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Что еще более важно, только Лиан потерял сознание, а со всеми остальными все было в порядке...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая быстро исключает такие возможности. В конце концов, кажется, есть только одно объяснение...")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Лиан — и только Лиан — усвоил 2,5 гигабайта данных менее чем за секунду…", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ае трудно поверить в свой собственный вывод.")
	await novel_interface.show_dialog("...Напомните мне еще раз, какой размер имеет единица YB?", "Мариру")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Один йоттабайт равен 10 байтам в 24-й степени — больше, чем все данные в довоенном Интернете вместе взятые...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Голос Аи дрожит от волнения.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("А я думал, что ее мозг годится только для игр...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Йоттабайт. Кажется, я видел это в отчете профессора Ши!", "Мариру")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Этот древний метеор в Парящем дворце!", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая быстро достает отчет.")
	novel_interface.show_character("ai","blush_wink")
	await novel_interface.show_dialog("Боюсь, теперь нам придется положиться на Лиана.", "Ая")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Пять дней спустя — на борту корабля-казино Лебоны «Либерти Стар».")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_dialog("Эм... мисс?", "Крупье")
	await novel_interface.show_dialog("Мисс?", "Крупье")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Моя очередь?", "Лиан")
	await novel_interface.show_dialog("F- Сложить...", "Лиан")
	novel_interface.change_expression("perspire1")
	await novel_interface.show_dialog("Извините, но мне нужно отсидеть один раунд.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Девушка выходит из-за стола и идет в тихое место в углу прохода.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("У меня был прилив! Почему ты сказал мне сбросить карты?!", "Лиан")
	await novel_interface.show_dialog("(понижает голос). Особенно после того, как я уже поставил столько денег...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тихий голос Лиан не может скрыть ее разочарования.")
	await novel_interface.show_dialog("Достань телефон и представь, что ты разговариваешь по телефону, Лиан. Прямо сейчас для всех остальных это выглядит так, будто ты бормочешь что-то про себя.", "Энни")
	await novel_interface.show_dialog("На этом корабле есть три диспетчерские. Я уже совершил набег на одного...", "Энни")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Р- Рейд?!...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Камеры на этом корабле повсюду. Если кто-нибудь заметит ваш микронаушник, вас бросят к акулам.", "Никс")
	await novel_interface.show_text_only("Я чувствую озноб по спине. Я поспешно достаю телефон.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Я уже потерял 20% того, что принёс. Разве ты не говорил, что мне пришлось удвоить свои деньги, прежде чем я смог попасть в VIP-зал?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я смотрю на номер на браслете, который выдало казино, и снова и снова говорю себе: это не деньги.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("(Но это все еще кровно заработанные деньги налогоплательщиков New Opulentia!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Baizhu/BG_Dispatched_Ship_Aisle.png")
	await novel_interface.show_text_only("На высоте тридцати тысяч метров в небе, на борту высокоскоростного тяжелого транспорта SID, Никс наблюдает за проекционным экраном с чашкой чая в руке.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("У вас были только 2 и 6 бубен. Судя по его поведению, была большая вероятность, что у него тоже был флеш, и его карты почти наверняка были выше ваших.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Серьезно?!\nЯ как раз собирался пойти ва-банк...", "Лиан")
	novel_interface.show_character("nyx_normal","speak")
	await novel_interface.show_dialog("*вздох*", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она понятия не имеет, как доходчиво объяснить это Лиану, той самой девушке, которая прошлой ночью уснула, пуская слюни на куче фишек стоимостью пятьдесят миллионов.")
	novel_interface.show_character("nyx_normal","normal2")
	await novel_interface.show_dialog("Самая распространенная ошибка, которую допускает новичок: всякий раз, когда у него хорошая рука, он хочет сделать крупную ставку или даже пойти олл-ин.", "Никс")
	await novel_interface.show_dialog("Как будто добрая рука лишает их способности к любому аналитическому мышлению.", "Никс")
	await novel_interface.show_dialog("Невежество приводит к страху; страх приводит к безрассудству. В конце концов, новички могут пойти ва-банк, чтобы избавиться от своего страха.", "Никс")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Они почувствуют себя свободными только после того, как поставят на кон все, что у них есть.", "Никс")
	await novel_interface.show_dialog("В результате его оппонент может легко предсказать свое решение по его поведению.", "Никс")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Короче говоря, вы не выиграете много денег, если у вас хорошая рука, и потеряете все, если у вашего оппонента рука лучше.", "Никс")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Любой, кто проигрывает все, что имеет, — такой дурак.", "Никс")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Это жестко!", "Лиан")
	await novel_interface.show_text_only("Лиан неудержимо дрожит.")
	await novel_interface.show_text_only("Никс делает глоток чая и продолжает.")
	novel_interface.show_character("nyx_normal","mock")
	await novel_interface.show_dialog("Слушай, Техасский холдем — это пошаговая игра.", "Никс")
	await novel_interface.show_dialog("Самое важное — это не ваши карты, а ваши оппоненты.", "Никс")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Choice.png")
	await novel_interface.show_dialog("После того, как вы предпримете действие, у ваших оппонентов будет только три варианта действий: сбросить карты, уравнять или повысить ставку.", "Никс")
	await novel_interface.show_dialog("Итак, вы должны делать свои ходы, основываясь на одном принципе: не позволяйте вашим противникам найти причины для поддержки любого из трех своих вариантов.", "Никс")
	await novel_interface.show_dialog("Лучший ход — это ход, который заставляет ваших противников почувствовать, что любой выбор, который они сделают, может быть правильным, но в то же время может быть и неправильным.", "Никс")
	await novel_interface.show_dialog("Это имеет смысл...", "Лиан")
	await novel_interface.show_dialog("Когда они попадают в подобную ситуацию, они впадают в панику и даже страдают.", "Никс")
	await novel_interface.show_dialog("И наступит их очередь захотеть вырваться на свободу.", "Никс")
	await novel_interface.show_dialog("Тогда игра в вашем распоряжении — идеальный момент, чтобы их вычистить.", "Никс")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Очистите их...", "Лиан")
	await novel_interface.show_text_only("Я киваю головой, размышляя над словами Никса.")
	await novel_interface.show_dialog("(Где Никс всему этому научился?...)", "Лиан")
	await novel_interface.show_dialog("(Во всяком случае, я никогда не играю с ней в покер!)", "Лиан")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Я возвращаюсь к покерному столу. С помощью Никса я удваиваю свои фишки менее чем за час.")
	await novel_interface.show_text_only("В раздаче, где я заработал больше всего денег, в тот момент, когда я поставил все свои фишки, я услышал, как Никс и Айя начали говорить о том, как я выгляжу, когда сплю.")
	await novel_interface.show_text_only("Они даже обменялись фотографиями! Мне было так стыдно, что мое лицо покраснело.")
	await novel_interface.show_text_only("Мои оппоненты не знали, что происходит, они думали, что я блефую... Итак, они попали прямо в ловушку.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Я все еще чувствую, что они зашли слишком далеко, несмотря на то, что помогли мне победить.", "Лиан")
	await novel_interface.show_dialog("Я не хочу больше об этом думать!", "Лиан")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Теперь я следую за официантом казино, чтобы войти в VIP-зал.")
	await novel_interface.show_text_only("Атмосфера этой комнаты совсем не похожа на вестибюль. Декорации, столы, стулья... Все гораздо красивее.")
	await novel_interface.show_text_only("У стола сидят уже немного подвыпившие трое мужчин в дорогих костюмах. Несколько горячих цыпочек болтают на диване.")
	await novel_interface.show_text_only("«Liberty Star» — небольшой корабль-казино, предназначенный для хайроллеров. Закутанный в серую броню, он ведет себя очень сдержанно.")
	await novel_interface.show_text_only("Чтобы попасть на этот корабль, нужно купить как минимум 20 миллионов фишек, а на борту нет даже нескольких десятков гостей.")
	await novel_interface.show_text_only("Что касается VIP-зала, то вам нужно выиграть более 50 миллионов...")
	await novel_interface.show_text_only("Следуя инструкциям Мариру, я обменял 100 миллионов наличными на одну золотую фишку с выгравированным изысканным гербом Лебоны.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Возможно, слухи действительно были правдой...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Чипы из вещества H, способные выдерживать сильные удары, магнитные поля и высокие температуры; их можно обналичить в сотнях казино по всему миру.")
	await novel_interface.show_text_only("Это, пожалуй, самая дорогая облигация на предъявителя.")
	await novel_interface.show_dialog("Мы украли все их камеры наблюдения. Действуйте, когда вы будете готовы! ", "Энни")
	await novel_interface.show_text_only("Наконец-то хорошие новости!")

	print("=== 星尘降临篇第4话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
