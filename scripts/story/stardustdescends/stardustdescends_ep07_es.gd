# stardustdescends_ep07.gd - 星尘降临篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep07_script()

func play_script():
	pass

func stardustdescends_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("En este punto, sólo quiero salir de aquí lo más rápido posible. Le hago una señal a Stardust y luego camino hacia el ascensor.")
	await novel_interface.show_text_only("Ella inmediatamente comprende mi intención y rápidamente me alcanza.")
	await novel_interface.show_text_only("La pequeña niña parece sentir mi ansiedad, así que frota mi muñeca suavemente.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_dialog("(susurro) No te preocupes.", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al sentir su mano suave y su temperatura, poco a poco me calmo y luego tomo su mano.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("Parece que hemos establecido un vínculo especial entre nosotros. Ella comienza a sonreír.")
	await novel_interface.show_text_only("Es extraño; después de todo, nos acabamos de conocer.")
	await novel_interface.show_text_only("Además, ¿cómo es que tanto el camarero como los soldados la ignoraron por completo?")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Dentro del ascensor, pellizco su suave rostro mientras trato de resolver todo este asunto. A ella no le gusta.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("(Su piel de alguna manera me calma...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Quizás ella es como Beatriz? ¿Ambos tienen un poder especial del que ni siquiera se dan cuenta?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Mientras intento valorar todas las posibilidades, el ascensor nos lleva de vuelta a la sala VIP.")
	await novel_interface.show_text_only("Tan pronto como se abre la puerta, me doy cuenta de lo serias que se han puesto las cosas.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Los soldados de Masadan ya están reteniendo a decenas de invitados y tripulantes. Se han dividido en cuatro grupos y están esperando en la cola para pasar el control de seguridad.")
	await novel_interface.show_text_only("Un empleado utiliza una tableta militar para tomar fotografías de todos los invitados a pesar de sus objeciones.")
	await novel_interface.show_text_only("Se ha instalado un bloqueador en la sala para evitar que los invitados hagan llamadas telefónicas y muevan hilos.")
	await novel_interface.show_text_only("Mi teléfono y mi auricular tampoco pueden recibir ninguna señal. Stardust se asusta por lo que ve y se esconde detrás de mí.")
	await novel_interface.show_text_only("A la salida del vestíbulo, un agente utiliza un altavoz para anunciar las normas del control de seguridad.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Quítese los relojes, las joyas y cualquier otro objeto metálico.", "Oficial")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Pega un código de identificación a todos tus bolsos y maletas y luego tráelos aquí para escanearlos.", "Oficial")
	await novel_interface.show_dialog("Si todo sale bien, recibirás una pulsera azul. De aquí sólo podrán salir los que tengan la pulsera.", "Oficial")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Este control de seguridad no es una broma...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Compruebo que todavía tengo mi pulsera.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(¿Esta pulsera aquí significa que ya estoy libre de peligro?)", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("(Esperaré y veré solo para estar seguro).", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a mi alrededor. De todos los soldados en este piso, sólo el oficial con el altavoz es una niña. Y al igual que Emily, ella también es muy joven.")
	await novel_interface.show_text_only("Sin embargo, todos los demás soldados parecen respetarla genuinamente.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(Parece una estudiante de secundaria...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, un hombre corpulento se libera y corre hacia la salida. Le grita a la oficial.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Soy el Arzobispo Miller de la Iglesia Anglicana del Sur de la India. ¡No tienes derecho a cuestionar a los siervos de Dios!", "Miller")
	await novel_interface.show_dialog("Además, tu uniforme... ¡no es un uniforme de las Fuerzas de Defensa de Masada en absoluto!", "Miller")
	await novel_interface.show_dialog("¿Quién eres realmente? ¿Quién autorizó esta operación?", "Miller")
	await novel_interface.show_dialog("¡Exijo hablar con su supervisor!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El agresivo arzobispo se encuentra frente a la joven como una pequeña montaña.")
	novel_interface.show_character("valkyrja","normal2")
	await novel_interface.show_dialog("Oh, nunca dije que esto fuera un uniforme de las Fuerzas de Defensa de Masada. Soy la suboficial Vera Valkyrie, la oficial al mando temporal.", "Oficial")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("¿Quién eres tú otra vez? ¿Alguien del sur de la India?\n¿Es usted una especie de inspector de impuestos?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera parece haberse dado cuenta de algo.")
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("No es de extrañar que seas grande... Supongo que viene con el territorio de tu trabajo.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Sin embargo, la última vez que revisé esa región estaba en guerra. ¿La gente todavía paga sus impuestos durante la guerra?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ella ignora por completo la cara roja del arzobispo mientras toma la tableta que le entrega un empleado.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Bueno, bueno, bueno... Quién lo hubiera pensado. Tienes una visa de trabajador religioso.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera se ríe con desprecio y luego mira la mesa de la ruleta.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Un siervo de Dios. Ya veo... Alguien como tú tiene el tiempo y los medios para comer toda la comida deliciosa. ¿Te divertiste en el casino?", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Y aquí pensé \"Dios no juega a los dados\".", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("¡Eso es una blasfemia!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El arzobispo no puede soportarlo más. Comienza a gritar mientras se acerca a Vera, listo para ponerse físico. Pero antes de que pueda alcanzar a Vera, ella lo agarra por el cuello.")
	await novel_interface.show_text_only("Estoy sorprendido por lo que veo.")
	await novel_interface.show_text_only("Con una sola mano, Vera levanta al pesado arzobispo en el aire.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(¡Qué fuerza!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Por si no me escuchaste la primera vez...", "Vera")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("No soy un soldado. Soy un cadete del \"Programa Talpiot\" que fue asignado aquí en el último momento.", "Vera")
	await novel_interface.show_dialog("No quiero nada de esto, pero la gente del Comité de Servicios Armados cree que pueden mandarnos.", "Vera")
	await novel_interface.show_dialog("¡Y pueden! He estado enojado por esto estos días. ¡Si vuelves a cruzarme, te arrojaré al océano y te daré de comer a los tiburones!", "Vera")
	await novel_interface.show_dialog("¿Lo tenemos claro?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("El rostro del arzobispo se ha puesto morado. Incapaz de hablar, asiente apresuradamente con la cabeza.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("¡Vuelve a tu fila!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tan pronto como lo sueltan, el arzobispo corre de regreso a su fila mientras recupera el aliento.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Eh, discúlpeme...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me acerco con cuidado y le muestro mi pulsera.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ya tengo mi pulsera. ¿Puedo irme ahora?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera está un poco sorprendida. Escanea el código de barras de mi pulsera y luego sonríe.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Sí, puedes irte.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me siento aliviado. También me alegra que nadie en este piso pueda ver a Stardust.")
	await novel_interface.show_text_only("Tan pronto como salgo de la sala, un empleado del casino se acerca para disculparse.")
	await novel_interface.show_text_only("Según él, Lebona negociará con Masada para asegurarse de que no se filtre ninguna información del cliente.")
	await novel_interface.show_text_only("Las señales en toda la cabina están bloqueadas. Me dice que si necesito hacer una llamada telefónica, puedo usar su teléfono fijo o ir a la cubierta de popa.")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Arrastro a Stardust y camino hasta la cubierta.")
	await novel_interface.show_text_only("Junto al barco de juego está atracado un barco patrullero Super Dvora Mk y en él cuelga la bandera nacional azul y blanca.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("¡Por fin un poco de aire fresco!", "Lian")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Después de todo, todas las ventanas dentro del casino están cerradas).", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Estiro los brazos mientras miro el puente que cruza el canal.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("¿Es este el Canal de Suez?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("¡Vaya!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust está más emocionado que yo. Salta hasta la valla del barco.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(¿Es sólo una coincidencia? Stardust se dirige hacia la popa del barco.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, suena mi teléfono y me espera una voz familiar.")
	await novel_interface.show_dialog("¿Lian? ¿Estás bien?", "Annie")
	await novel_interface.show_dialog("Ella está bien. Ella está haciendo algunos estiramientos frente al océano.", "Mariru")
	await novel_interface.show_dialog("¡Ah, el dulce olor de la juventud! ¿Es esta tu forma de conseguir un par aún más grande?", "Aya")
	await novel_interface.show_text_only("Resulta ser una llamada de conferencia: Mariru y algunos otros también están en la línea...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("¿Me están espiando?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Miro a mi alrededor y no veo ningún dispositivo de vigilancia. Entonces me doy cuenta de que probablemente viene de muy arriba.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("(Se siente raro saber que un par de ojos observan cada uno de mis movimientos...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Vayamos al grano: ¿qué pasó antes?", "Mariru")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("¿Por dónde empiezo?...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me aclaro la garganta y luego les cuento todo lo que pasó. Señalo específicamente que nadie puede ver a Stardust.")
	await novel_interface.show_dialog("¿Está justo a tu lado? Por lo que vimos, saliste solo del vestíbulo...", "Annie")
	await novel_interface.show_dialog("Me preguntaba cómo pasaste el control de seguridad tan rápido: ¡fuiste la primera persona en salir!", "Annie")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Es el segundo teniente que conocí en la bóveda. Escaneó mi documento de identidad falso y luego me dio mi pulsera.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Los soldados de Masadan no deberían haber sido tan descuidados...", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Ah, una cosa más. Tanto el oficial al mando en el vestíbulo como el segundo teniente en la bóveda son chicas jóvenes, de no más de 20 años.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Qué? Sé que las mujeres también están sujetas al servicio militar obligatorio en Masada, pero ¿ya a esa edad?", "Annie")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("El oficial en el vestíbulo mencionó que ella era cadete del \"Programa Talpiot\". La asignaron aquí en el último momento.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Eso lo explica...", "Mariru")
	await novel_interface.show_dialog("Talpiot fue una academia militar de élite directamente bajo el mando del Estado Mayor de Masada durante décadas.", "Mariru")
	await novel_interface.show_dialog("Más tarde, el ejército de Masadan lo amplió hasta convertirlo en el \"Programa Talpiot\". Invita a probar sólo al uno por ciento superior de los estudiantes ordinarios de escuelas medias y militares.", "Mariru")
	await novel_interface.show_dialog("Sólo unas pocas docenas de candidatos pasan cada año su agotador examen mental, físico y de coeficiente intelectual.", "Mariru")
	await novel_interface.show_dialog("Es un canal para entrenar a futuras élites militares, y su plan de estudios incluye incluso operaciones de campo a pequeña escala.", "Mariru")
	await novel_interface.show_dialog("Monola ha reclutado a muchos graduados del \"Programa Talpiot\". Son conocidos por ser profesionales y leales.", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Una escuela militar de élite, ¿no?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No creo que Lian y yo podamos entrar...", "Annie")
	await novel_interface.show_dialog("Pobre Lian...", "Aya")
	await novel_interface.show_text_only("Aya duda en terminar su frase.")
	await novel_interface.show_dialog("La chica de la que hablaste. ¿Está ella en cubierta contigo ahora mismo?", "Aya")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Sí. ¿Por qué?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Pero incluso el sensor térmico indica que estás solo en cubierta...", "Aya")
	await novel_interface.show_text_only("Ahora ni siquiera yo puedo estar seguro, pero ahí está ella, en cuclillas frente a la valla y mirando en una dirección.")
	await novel_interface.show_text_only("De repente, se levanta y me señala en la dirección que estaba mirando.")
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("¡Nosotros... iremos allí!", "Stardust")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("No recuerdo por qué, pero algo me dice que hacia allá vamos.", "Stardust")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("De lo contrario... De lo contrario habrá un desastre...", "Stardust")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("¡Por favor! ¡Vamos juntos, por favor!", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust me agarra la cabeza y me mira con sus grandes ojos, solo una niña pequeña pidiéndole juguetes a su mamá.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("¿Escuchaste lo que ella me dijo hace un momento?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sólo te escuché...", "Annie")
	await novel_interface.show_dialog("El sonido se produce por la vibración de las cuerdas vocales. Si no hay cuerpo físico, no puede haber sonido.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Pero... Pero puedo verla, tocarla y sentir su temperatura corporal...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Según lo que describiste, tu cerebro probablemente se vio afectado por algo. Y después de eso, te ha estado enviando retroalimentación neuronal que sólo tú puedes percibir.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¡Pero incluso puedo ver su sombra!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Intento discutir, incapaz de aceptar su explicación.")
	await novel_interface.show_dialog("... Prueba con la cámara de tu teléfono.", "Mariru")
	await novel_interface.show_text_only("¡Esa es una buena idea! Pero cuando apunto mi cámara hacia ella...")
	await novel_interface.show_text_only("¡No hay nadie en el marco de la cámara!")
	await novel_interface.show_text_only("Sin embargo, tan pronto como alejo mi teléfono, la veo de nuevo, todavía suplicándome.")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("¡Por favor!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Todavía no creo que la chica sea sólo una ilusión. Busco en su bolso y encuentro la nota rosa con su nombre escrito.")
	await novel_interface.show_text_only("Sigue igual: no puedo ver la nota en el marco de mi cámara.")
	await novel_interface.show_text_only("Y esta vez, después de alejar mi teléfono, ¡la nota desapareció!")
	await novel_interface.show_text_only("Extiendo mi mano temblorosa y coloco mi teléfono encima de Stardust.")
	await novel_interface.show_text_only("!!! ¡Mi teléfono se cae al suelo!")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("?", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Me zumban los oídos y las extremidades se vuelven pesadas de repente.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Después de un rato, escucho la voz de Aya por teléfono.")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_dialog("Tengo una teoría; en realidad, más bien una suposición.", "Aya")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Dime.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Piensa en todas las brujas que convocaste antes. No eran \"fantasmas\" como éste, y todos tenían sus recuerdos completos.", "Aya")
	await novel_interface.show_dialog("Según lo que nos dijiste, sufre pérdida de memoria y no se la puede ver. ¿Quizás no se han cumplido por completo los requisitos para convocarla?", "Aya")
	await novel_interface.show_dialog("¿Ella pidió algo? ¿O darte alguna pista?", "Aya")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Sobre eso... ¡Sí!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente encuentro esperanza. Señalo en la dirección que Stardust quiere ir.")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ella quiere ir allí. No es la ubicación exacta, pero sí en algún lugar por allí.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Escucho el sonido de un teclado por teléfono.")
	await novel_interface.show_dialog("318 millas en esa dirección...", "Mariru")
	await novel_interface.show_dialog("¡Es la Fortaleza de Masada!", "Annie")

	print("=== 星尘降临篇第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
