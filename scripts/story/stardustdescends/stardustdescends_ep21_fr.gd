	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Donc les souvenirs de Stardust ne peuvent pas être récupérés ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Qui sait... De toute façon, le signal venu de l'espace lointain a disparu.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Peut-être que, dans un certain sens, il a déjà atteint son objectif ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","gratified")
	await novel_interface.show_dialog("Alors, comment va Stardust maintenant... ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("À son retour, elle dormait comme toi. Aya l'a emmenée à Harima Brain Research...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Mais vous semblez avoir une sorte de lien psychique. Vous vous êtes réveillés tous les deux presque à la même heure hier.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Pourtant, elle non plus ne sait rien. Aya a été très déçue et a dit que la tête de cet enfant était aussi vide que la vôtre.", "Mariru")
