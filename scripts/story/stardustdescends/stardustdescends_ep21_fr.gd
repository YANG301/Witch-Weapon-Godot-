	await novel_interface.show_text_only("Qui traites-tu de tête vide !?")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Ah oui ! Aya a également effectué un test de parenté sur Stardust...", "Mariru")
