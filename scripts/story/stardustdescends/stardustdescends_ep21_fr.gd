	novel_interface.character_light(0.35,"happy")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ne vous inquiétez pas, vous n'êtes vraiment pas liés par le sang ~", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"wail")
	await novel_interface.show_dialog("Il n’était pas censé y avoir une telle possibilité en premier lieu !!", "Lian")
	novel_interface.character_light(0.35,"speak")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La petite a insisté pour vous voir après son réveil, alors Annie la ramène au quartier général.", "Mariru")
	await novel_interface.show_dialog("Hehehe... les enfants sont vraiment vifs, n'est-ce pas~", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Why do you sound like somebody's grandma...?",)
	novel_interface.show_character("liliu_research","happy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_battle","wail",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Puisque cet enfant insiste pour s'accrocher à vous, j'ai pensé que cela pourrait aussi être une bonne occasion de corriger votre habitude de toujours essayer d'esquiver la responsabilité.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("W-Que veux-tu dire...?\n(Cela ne peut pas vouloir dire ce que je pense !!)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru prit son thermos et but une petite gorgée de tisane imprégnée de plantes étranges, un sourire bienveillant s'étalant sur son visage.")
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Au fait, euh... Est-ce qu'Emily et Vera vont bien ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Vous ne le saviez pas ? Ils vont très bien en ce moment ~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Un journaliste à proximité a filmé le toit du palais des congrès depuis le dernier étage d'un immeuble résidentiel.", "Mariru")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Alors le monde entier a vu Emily descendre comme une déesse et diviser la tempête de sable en deux...", "Mariru")
	await novel_interface.show_dialog("Les forces de défense l'ont expliqué plus tard comme une sorte d'arme à matière hétérogène consommable qui ne peut être tirée qu'une seule fois.", "Mariru")
	await novel_interface.show_dialog("Mais dans toutes les religions abrahamiques, seul un personnage choisi comme Moïse pouvait « diviser la mer et sauver le peuple ».", "Mariru")
	await novel_interface.show_dialog("Avec la réaction si forte des rangs inférieurs des fidèles, et avec le fait qu'elle soit métisse et n'ayant elle-même aucune religion...", "Mariru")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Le grand rabbin de Massada et ses imams sont parvenus à un consensus sans précédent, tous deux s'efforçant de la qualifier de messagère de Dieu.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Quel... pays compliqué.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Le Premier ministre Schneiderman a suivi le courant et a nommé sa conseillère principale auprès du ministère de la Religion et de l’Éducation.", "Mariru")
	await novel_interface.show_dialog("Ce n'est qu'un poste honorifique, mais Emily a quand même embauché Vera comme assistante.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Il y a quelques jours, le parlement de Massada a décidé de continuer à mettre en œuvre certaines parties de l'accord de cessez-le-feu initial, Emily coordonnant les affaires ethniques.", "Mariru")
	await novel_interface.show_dialog("De cette façon, peu importe l’issue de la lutte pour le pouvoir au sein des Forces de défense ou des futures élections, ils devraient éviter les ennuis.", "Mariru")
	await novel_interface.hide_character()
	
	novel_interface.show_character("ren_battle","happy")
	await novel_interface.show_dialog("Tant qu'ils sont en sécurité...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Puis à propos de \"Phantom Force\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Avant que je puisse finir, Mariru m'a interrompu.")
	novel_interface.show_character("liliu_research","angry")
	await novel_interface.show_dialog("Cette affaire doit rester strictement confidentielle. Même Annie ne peut pas le savoir.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Hein ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru m'a regardé avec le même sourire qu'on donne à un petit animal qui fait une bêtise.")
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Vous ne pensez pas vraiment qu'Hamon a épargné Emily parce que vous avez deviné le secret de Phantom Force, n'est-ce pas ?", "Mariru")
