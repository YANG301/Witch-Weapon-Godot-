	novel_interface.show_character("ren_battle","wail")
	await novel_interface.show_dialog("Quoi ?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("La vidéo publiée par le journaliste vous montre également, mais la plupart des gens supposent que vous n'êtes qu'un médecin qu'Emily a sauvé.", "Mariru")
