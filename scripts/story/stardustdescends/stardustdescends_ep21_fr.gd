	novel_interface.show_character("liliu_research","happy")
	await novel_interface.show_dialog("Tout ce dont vous avez besoin maintenant, c'est de gagner de l'argent pour rembourser votre dette ~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","sob")
	await novel_interface.show_dialog("Même si tu me vendais une douzaine de fois, ce ne serait toujours pas suffisant...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","speak")
	await novel_interface.show_dialog("Ne soyez pas si dur avec vous-même~\nJ'ai déjà décroché plusieurs offres publicitaires pour vous.", "Mariru")
