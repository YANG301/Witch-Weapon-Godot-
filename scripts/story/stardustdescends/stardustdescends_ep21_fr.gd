	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","smile")
	await novel_interface.show_dialog("Même s’il avait simplement envoyé ce satellite au sol, les dégâts auraient été énormes. Cela aurait même pu inverser la tendance sur le champ de bataille conventionnel.", "Mariru")
