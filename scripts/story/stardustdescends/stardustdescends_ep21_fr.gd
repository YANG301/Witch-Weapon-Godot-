# stardustdescends_ep21.gd - 星尘降临篇第21话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep21_script()

func play_script():
	pass

func stardustdescends_ep21_script():
	await novel_interface.show_text_only("..................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Deux semaines après l'incident, à la périphérie de la Cinquième Cité Académie.")
