	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Puisque vous avez été assez généreux pour me remettre également les données volées de la NASA.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix ramassa la tablette sur le bureau et ouvrit le fichier crypté.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("...Le satellite du projet 0812 s'appelle \"STARDUST\" ?", "Nix")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("Comment... ce n'est absolument pas surprenant~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Le lendemain, SID Salle de Commande.")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_research","shock")
	await novel_interface.show_dialog("Alors... tu ne te souviens vraiment de rien ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("Pas du tout...", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Je pense que l'onde de choc de l'impact du satellite m'a fait cogner la tête à l'intérieur de l'APC et m'avoir fait perdre connaissance.", "Lian")
	await novel_interface.show_dialog("Puis quand je me suis réveillé, je me suis retrouvé allongé dans un lit d'hôpital avec une intraveineuse...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_research","normal")
	await novel_interface.show_dialog("Dans les images des Forces de Défense, lorsque vous êtes sorti de l'APC, vous étiez sans expression et complètement silencieux, entouré d'une étrange lueur bleu cobalt.", "Mariru")
	await novel_interface.show_dialog("C'était comme si vous connaissiez déjà tout le plan. Sous le regard de tous, vous avez marché droit sur le toit du palais des congrès.", "Mariru")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Selon le rapport d'Annie, presque au même moment, le Stardust inconscient dans l'ambassade a également commencé à émettre une lueur similaire...", "Mariru")
	await novel_interface.show_dialog("Emily a dit que lorsque vous lui attrapiez la main sur le toit, une puissance indescriptiblement énorme semblait envahir son corps.", "Mariru")
	await novel_interface.show_dialog("Des centaines de fois plus fort que lorsque vous avez rencontré la Ruche auparavant, comme si cela pouvait faire fondre son corps à tout moment.", "Mariru")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Mais après que cette frappe ait été déclenchée, la lueur autour de vous a disparu. Tu es devenu mou dans ses bras et tu as désespérément essayé d'enfouir ton visage dans sa poitrine.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","awkward")
	await novel_interface.show_dialog("...Hein ?\nD-Est-ce que je l'ai fait ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bon sang, je ne me souviens de rien de tout ça !")
	novel_interface.show_character("ren_battle","upset")
	await novel_interface.show_dialog("Mais après avoir lu le briefing sur l'incident, il y a encore des choses que je ne comprends pas...", "Lian")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Mushar a acheté la clé de contrôle de ce satellite il y a deux ans, n'est-ce pas ?", "Lian")
