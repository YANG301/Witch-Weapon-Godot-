	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	await novel_interface.show_text_only("Casque sur les oreilles, Nix descendit l'escalier avec grâce tout en parlant au téléphone.")
	novel_interface.show_character("nyx_normal","normal1")
	await novel_interface.show_dialog("Cet incident a été officiellement classé comme l’attentat terroriste le plus grave et le plus ignoble depuis la guerre.", "Nix")
