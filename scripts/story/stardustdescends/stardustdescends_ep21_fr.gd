	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("J'ai déjà négocié une approbation pour les nouvelles batteries à haute énergie que Masada vient de lancer...", "Mariru")
	await novel_interface.show_dialog("Et le fabricant pense également que remplacer le lapin en jouet des publicités traditionnelles sur les piles par \"la fille sauvée\" est une idée absolument géniale ~", "Mariru")
