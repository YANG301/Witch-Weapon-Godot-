	await novel_interface.show_dialog("Alors...", "Nix")
	await novel_interface.show_dialog("À votre avis, combien vaut l'information selon laquelle \"Mushar a acheté ce satellite par votre canal\"... monsieur Hong ?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("C'est peut-être parce que... Je me suis récemment fait des amis qui sont très doués pour retracer la monnaie électronique en arrière~", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un léger sourire se dessina aux coins de la bouche de Nix.")
	novel_interface.show_character("nyx_normal","smile")
	await novel_interface.show_dialog("Je vais donc reprendre possession de cette succession au nom de mon père...", "Nix")
	await novel_interface.show_dialog("Bien entendu, l’activité qu’elle a toujours dirigée peut continuer. Je veux seulement dix pour cent des bénéfices sous forme de loyer.", "Nix")
	await novel_interface.show_dialog("Après tout, je ne voudrais pas que tu finisses comme Hamon.", "Nix")
	await novel_interface.show_dialog("J'ai simplement besoin que vous preniez en charge ma sécurité personnelle...", "Nix")
	await novel_interface.show_dialog("Inspiré par Mushar, on m'a également implanté une sorte de moniteur de signes de vie.", "Nix")
