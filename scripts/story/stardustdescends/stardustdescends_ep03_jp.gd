# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("俺は豪華なベッドの隅っこに座って先輩達の話を\n他人事のように聞いている。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("監視役は半年ごとに交代するわ。\n\n今いる2人は3ヶ月目かしらね。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("レンを家まで送りたいと、あの2人に伝えろ。\nこちらは車をすでに用意している。", "マリル")
	await novel_interface.show_dialog("2人が車へ近寄って来た瞬間を見計らい、\n麻酔で無力化する手筈だ。", "マリル")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("監視役は定期報告をする役目を担っているの。\n\n安全に事を進めたいのであれば、あの2人の\n協力は必要不可欠よ。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("唐突に決められた逃走計画に、先輩は明らかな\n不安を感じている。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("それに『対外安全委員会』の方達は全員が、\n厳しい尋問対処訓練を乗り越えているわ。", "ニュクス")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("監視の2人が委員会の下役だったとしても、\nそう簡単に無力化できるものでは……", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("それって、あの噂の……対外安全委員会？", "レン")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("『七戒』とも呼ばれるリバーナの情報機関だ。\n\n元はヨーロッパのマフィアが編成した粛清部隊を\n起源として、そこから発足されたんだとか。")
	await novel_interface.show_text_only("黒スーツに拘りを持ちながらも、その凄まじき\n標的暗殺能力によって世界中で名を馳せている。\n彼らの標的になった場合、何者であっても、\n逃げる事は難しいと考えて置いた方が良い。")
	await novel_interface.show_text_only("彼らの特徴としては《リバーナ戒禁》の維持を\n信条とした独立組織である点が挙げられる。")
	await novel_interface.show_text_only("全世界に点在するカジノの固定株式を持つため\n資金源は潤沢。\nあらゆる政府に属そうとしない姿勢はまさに……")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("（本当に……ハードボイルドすぎる……！）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ちなみに俺は彼らが出てくるゲームの何個かで、\nプラチナトロフィーを獲得済である。")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("事を安全に進めるなら、どう逃げるとかじゃなく\n『七戒』にバレないためにはどうするべきか……\nそれを考えなきゃいけないって事か？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("くくく……心配はいらんさ。", "マリル")
	await novel_interface.show_text_only("俺の心配を尻目にマリルがニヤリと笑った。")
	await novel_interface.show_dialog("あいつらへの対策など戦研部にいくらでも\nあるからな～～", "マリル")
	await novel_interface.show_text_only("なるほど、笑うのも理解できる。\n\n拷問道具を片手に興奮しまくっている愛衣の姿が\n俺の頭の中に浮かんだ。\n……それなら大丈夫……なのか？")
	await novel_interface.show_dialog("私も色々と行動を開始する。\n\nお前達2人は準備をしておけよ？\nいつでも動けるようにな。", "マリル")
	await novel_interface.show_text_only("とにかく、俺達2人はマリルの言葉に対して\n頷きながら了解と告げた。\n俺達の快諾を聞いたマリルは少し息を吐くと\n「じゃあな」と、その流れのまま通信を切る。")
	await novel_interface.show_text_only("……………………\n\nマリルがいなくなった途端に静かになって\n気まずい空気が流れる。\n先輩は未だ俺の胸元を見つめ続けていて、\n正直どんな反応をすれば良いのか分からない。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("音質は……良いかと思います。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は気詰まりした感じに頭を下げた。")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("で、ですかね……", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("…………\n\nお、俺達は一体……何の話をしてるんだ……")
	await novel_interface.show_text_only("前に愛衣がアップグレードしたとか言ってたから\n確かに音質は良くなっている気はするけど……？")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("（違うって、そもそも何でこんな意味ない部分を\n　アップグレードするんだよ！！？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("──などと考えている最中、突然ニュクス先輩が\n近寄って来た。\nごく自然な感じで右手を俺の背中へ回してくる。")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("せ、先輩……？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女が服の上を軽く引っ張った瞬間、\n俺は何かから解放された感じがした。")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("──え、えっ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ま、まさか、ホックが……")
	await novel_interface.show_text_only("そのまま先輩は俺のドレスの中に左手を\n突っ込んで……\nゆっくりと黒い胸パッドを抜き出した。")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("……", "レン")
	await novel_interface.show_dialog("…………", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……………………")
	await novel_interface.show_text_only("いひゃあああああぁぁぁぁぁぁ――！？！？！？")
	await novel_interface.show_text_only("先輩は胸パッドを色々と弄ってスピーカーが\n存在しない事を確認すると、\n訝しげな表情で俺の方を見てくる。")
	await novel_interface.show_text_only("俺は真っ赤になりながらパッドをもぎ取って、\n瞬時にトイレへと飛び込んだ。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("あら？ お腹の調子が悪くなったのかしら？", "ニュクス")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("もし「あれ」が必要でしたら、壁棚にストックが\nありますよ。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("……トイレの外から先輩の気遣う声が聞こえる。")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("ち、違いますから、大丈夫ですぅぅ！", "レン")
	await novel_interface.show_dialog("（うううぅぅ……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("──同刻、SID作戦指令室")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("オペレーションデスクの座席で愛衣がパラパラと\n書類を捲っている。\n彼女の目の前にある大スクリーンには、\n分析ウィンドウが4、5個ほど表示されていた。")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("ねぇねぇ？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣は座席の背もたれに深く身を預けながら、\n背後に立っている軍服を着た女性を眺める。")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("あんなどんくさい奴からデータを盗む方法なんて\n他に幾らでもあったでしょ？", "愛衣")
	await novel_interface.show_dialog("わざわざレンちゃんを不必要なリスクに\n晒すなんてさ～～\nレンちゃんとアニーに色々と疑問なり何なり\n言われなかったのかい？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("マリルは手元にあるデバイスのデータを\n見ながら笑った。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("あいつはまだ、あの先輩の部屋で色々と\nお楽しみ中だろうさ。", "マリル")
	await novel_interface.show_dialog("それに……元々これはアニーの提案だ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("……そうなの？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("覚えているよな？", "マリル")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("10数日前、レンが異空間からソヤを\n救助した時──\n世界的な範囲で約5秒間の巨大時空位相波動を\n観測した。", "マリル")
	await novel_interface.show_dialog("非常に強烈な信号であったが、即時消失したため\n未だ各国は発信源を特定するに至っていない。", "マリル")
	await novel_interface.show_dialog("現在で最も有力とされている解釈は、ちょうど\n太陽系が銀河中のGRB（ガンマ線バースト）の\n外側に接触したって説なんだよね。", "マリル")
	await novel_interface.show_dialog("その実は全くのデタラメだって言うのに……\n\nまあ、別の意味で人類は世界の滅亡と\nすれ違ってたけどね～♪", "マリル")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("だが、その通り「すれ違った」だけだ。\n\n世界が存続してしまったのであれば、\n新豊洲としては疑われる事を避けねばなるまい。", "マリル")
	await novel_interface.show_dialog("あの事件以来、SIDは輿論を含め、\nあらゆる情報流通に対して監視を行ってる。", "マリル")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("情報部の担当分野からは目ぼしい収穫を\n得られなかったが──\n一方でアニーがSNSから面白い情報を掴んだ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("え、アニーは情報分析とかもできるように\nなったんだ？\n体力訓練でも著しい成果を上げているって\n担当教官が言ってたよ。", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("あの子はあの子なりに努力する理由が\nあるんだろう。", "マリル")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("それに引き換え、あのぐうたらちゃんは……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("レンが最近クリアしたゲームの長々しいリストを\nマリルは呼び出した。\n自分の子供の馬鹿さ加減に気付いた親のように、\nもはや頭を左右に振るしかできない。")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("とにかくレンがソヤを救助したあの日、\n奇妙な書き込みをアニーは見つけている。", "マリル")
	await novel_interface.show_dialog("複数人が昼寝中におかしな夢を見たらしい。\n\n「夢の中で真っ暗な空間へ落ちて行くと、\n　亡くなった親族に会えた」とか言う話だ。", "マリル")
	await novel_interface.show_dialog("フォロワーの少ない一般人ばかりが書き込みを\nしてたため情報はすぐに埋もれてしまったがな。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("昼寝中に見た夢かぁ……", "愛衣")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("あの日の強烈な時空位相は新豊洲の時間で言うと\n午後4時頃に発生したから……\n……もしかして！？", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("その時間に寝ている人間は少ない。\n\nそして、自分の夢をネット上に書き込む人間は\n更に少ない。", "マリル")
	await novel_interface.show_dialog("彼らのアカウントを詳しく分析した結果、\n物理アドレスは全て新豊洲からだった。\nしかも全アドレスが半径5キロ圏内の区域で\n収まっている。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ここまで聞いて、愛衣の両目が輝きだした。")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("もう分かっただろう？\n\nその区域の中心を調べて、行き着いたのが\nニュクスの荘園と言う訳だ。", "マリル")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("あの荘園には「何か」が存在しているんだね！\n\nそれが天国の扉の開いた瞬間に活性化して、\n大規模な夢を引き起こした！？", "愛衣")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("愛衣の声から抑えきれない興奮が伝わってくる。")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("まぁ、まだ確定的だとは言えないな。\n\nだからこそ荘園の監視カメラにボルツマン探針を\n設置させたのだが……", "マリル")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("「だったら見せて」と言わんばかりの表情で\n愛衣がマリルへ飛びついた。\nしかし顔を片手で掴まれてしまう。")
	await novel_interface.show_text_only("銀髪少女の小柄な身体ではマリルに対して\n届きもしないが、\nそれでも両手を空中でグルグルしながら\n好奇心を爆発させる。")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("ふぃ（み）～ふぇ（せ）～ふぇ（て）～\nふぉ（よ）～～！！", "愛衣")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("デバイスを回収できたらすぐに見せてやるさ。\n\nそれよりも今は施教授の情報分析を\nさっさと済ませろ。", "マリル")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("──そうして愛衣は片付けられたのであった。\n\n愛衣が指令室を出ると、マリルはタブレットに\n届いた衛星からのデータを無言で見つめる。")
	await novel_interface.show_dialog("（先ほどレンがニュクスと額を合わせた時）\n\n（あの時も極めて強烈な低周波が発生した）", "マリル")
	await novel_interface.show_dialog("（あの電波のタイプは、レム睡眠時の人間の\n　脳波パターンと酷似している……）", "マリル")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("まるで、あの南極で起きた事象のように……")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
