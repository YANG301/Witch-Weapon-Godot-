# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("A Terceira Cidade Escolar, Masadaburg.")
	await novel_interface.show_text_only("Uma fortaleza militar construída no deserto, famosa pela lama do Mar Morto, tempestades de areia e ataques terroristas.")
	await novel_interface.show_text_only("Para a maioria das pessoas, qualquer notícia sobre Masadaburg significa conflito militar ou desastre humanitário.")
	await novel_interface.show_text_only("Uma paisagem tingida de sangue e areia, petróleo bruto e fumaça branca paira há muito tempo sobre esta terra antiga...")
	await novel_interface.show_text_only("Que tipo de vida as pessoas vivem lá?\nNão tenho a menor ideia...")
	await novel_interface.show_text_only("No entanto, também parece estranhamente familiar, como se eu mesmo estivesse lá...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Suspiro──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Encostei-me na grade do convés enquanto Stardust se agarrava a mim como um coala, com lágrimas ainda brilhando em seus olhos.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Tudo bem, tudo bem. Eu só estava brincando—", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Ei, calma aí. Suas unhas estão cravando em minha carne...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Cheirar...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("D-Não limpe o nariz nas minhas roupas!!!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Soltei um suspiro impotente e acariciei sua cabeça para acalmá-la.")
	await novel_interface.show_text_only("Mais cedo, Aya adivinhou que a direção que Stardust havia apontado era Masadaburg, mas depois de perguntar por aí, descobriu-se que a garota não tinha ideia do que o nome do lugar significava.")
	await novel_interface.show_text_only("Ou melhor, ela nem entendia o conceito de “cidade escolar”...")
	await novel_interface.show_text_only("Mariru disse que primeiro resolveria as informações e me disse para esperar no convés até que ela me contatasse novamente.")
	await novel_interface.show_text_only("Eu ainda não conseguia aceitar que essa garota era uma ilusão que só eu conseguia ver, então aproveitei a oportunidade para fazer mais alguns testes—")
	await novel_interface.show_text_only("Primeiro, coloquei meu telefone no chão e pedi que ela o atendesse.")
	await novel_interface.show_text_only("Em vez disso, ela apenas me deu um sorriso educado, inclinou a cabeça e olhou para mim como: \"Você é estúpido?\"")
	await novel_interface.show_text_only("Depois de cerca de trinta segundos de impasse, eu só consegui pegar meu próprio telefone sem jeito, e então uma ideia ainda mais idiota me ocorreu—")
	await novel_interface.show_text_only("“Se ela não tiver um corpo físico, ela poderia atravessar paredes?”")
	await novel_interface.show_text_only("Então, enquanto ela observava, voltei para a cabine, tranquei a porta que dava para o convés e me escondi no ponto cego dela.")
	await novel_interface.show_text_only("Dois minutos depois, ouvi soluços silenciosos do outro lado. Pressentindo problemas, abri a porta apressadamente e ela agarrou minha coxa e se recusou a me soltar.")
	await novel_interface.show_text_only("Para evitar que garçons ocasionais passassem pela cabine, lutei para arrastá-la de volta para o corrimão.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Com este acessório para as pernas, mal consigo andar...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuidar de uma criança é sempre tão cansativo!?")
	await novel_interface.show_text_only("Pior, ninguém mais pode vê-la. Neste momento devo parecer um lunático resmungando sozinho e movendo-se de maneira estranha.")
	await novel_interface.show_text_only("Como eu realmente não tinha resposta para sua pegajosidade, só pude persuadi-la gentilmente.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Pronto, pronto. Eu não vou deixar você para trás~", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Essa foi a minha culpa agora. Vou me desculpar, ok?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu disse isso enquanto fazia uma cara boba para ela.")
	await novel_interface.show_text_only("Se alguém me visse fazendo caretas para o vazio, eu iria querer rastejar direto para uma fenda no convés.")
	await novel_interface.show_text_only("Stardust se acalmou um pouco. Ainda me abraçando, ela olhou para cima, piscou seus grandes olhos e as orelhas em sua cabeça brilharam.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Então me prometa que irá nessa direção comigo, ok...?", "Stardust")
	await novel_interface.show_dialog("Isso realmente importa...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Você não estava chorando fingindo agora, estava?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Crianças realmente são um punhado...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu não tinha ideia se Mariru aprovaria que eu levasse essa pequena companhia para algum lugar tão perigoso.")
	await novel_interface.show_text_only("Só então, a estática estalou no meu fone de ouvido e Mariru voltou à linha.")
	await novel_interface.show_dialog("Lian, Annie, o que vocês dois sabem sobre Masadaburg?", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Hum...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aproximadamente...", "Annie")
	await novel_interface.show_text_only("Tentei muito lembrar, mas mesmo no treinamento do agente SID as informações sobre Masadaburg estavam fragmentadas.")
	await novel_interface.show_dialog("A Terceira Cidade Escolar, uma cidade-fortaleza no coração da Ásia Ocidental, dividida em distritos internos e externos por um muro de isolamento com dezenas de metros de altura.", "Annie")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("Acho que foi por causa de conflito étnico ou religioso ou algo assim?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De qualquer forma, o distrito externo de Masadaburg parece perigoso. Parece que há um ou dois ataques a bomba por mês!")
	await novel_interface.show_dialog("A sua agência de inteligência, o Masada Restoration Mission Bureau, é controlada diretamente pelos militares e tem um estilo ousado e radical.", "Annie")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ah, eu sei disso. Essa agência também se chama \"Monola\", certo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("É um nome que aparece o tempo todo em filmes e jogos, embora raramente como facção principal.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Certo, as armas deles também são avançadas. Nos jogos, Masada geralmente é o lado que fornece aos jogadores tanques e drones controlados remotamente...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tudo bem, isso é o suficiente──", "Mariru")
	await novel_interface.show_dialog("O ambiente geopolítico naquela região sempre foi complexo e, quando se acrescentam forças de resistência e grupos separatistas, torna-se ainda mais caótico.", "Mariru")
	await novel_interface.show_dialog("Mas falando apenas do “distrito interno” de Masadaburg, sua segurança não é pior do que a de Nova Toyosu, então—", "Mariru")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("Hein? Não me diga...\nVocê concordou?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ainda enrolado na minha coxa, Stardust se contorcia feliz.")
	await novel_interface.show_dialog("Só nós dois... tem certeza que ficaremos bem?", "Annie")
	await novel_interface.show_text_only("Três. Nós três!!\nNão esqueça que tem bagagem extra aqui!!")
	await novel_interface.show_dialog("Esta não é uma missão de espionagem. Ainda nem sabemos nosso destino exato. Contanto que você não faça nada ultrajante, tudo ficará bem.", "Mariru")
	await novel_interface.show_dialog("Além disso, você nem precisará trocar de navio. Este navio cassino irá atracar no porto de Masada amanhã de manhã ~", "Aya")
	await novel_interface.show_dialog("...O que está acontecendo? Não era suposto irmos para Samonton?", "Annie")
	await novel_interface.show_dialog("Massada deverá assinar um acordo de cessar-fogo com a resistência em três dias e, até que a cerimônia termine, o Canal de Suez ficará completamente selado.", "Mariru")
	await novel_interface.show_dialog("Para a segurança dos seus passageiros, o casino acaba de decidir seguir a \"forte recomendação\" dos militares de Masada e voltar para Eilat.", "Mariru")
	await novel_interface.show_dialog("Este navio seguirá para o norte ao longo do Grande Canal do Mar Vermelho-Mar Morto, atracará no Porto de Masada e permanecerá lá até que o bloqueio do Canal de Suez seja levantado.", "Mariru")
	await novel_interface.show_dialog("A identidade falsa de Annie é uma estudante de um programa de intercâmbio de arte de New Toyosu. A papelada já está feita.", "Mariru")
	await novel_interface.show_dialog("Quanto a você, a defesa costeira de Lian──Masada provavelmente já registrou sua identidade falsa, então continue sendo a pequena enfermeira que você é ~", "Mariru")
	await novel_interface.show_text_only("Havia um sorriso na voz de Mariru que me deixou um pouco desconfortável.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Hein??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("De qualquer forma, você não pode se mover até que o acordo seja assinado, então passe os próximos dois dias passeando pela cidade ~", "Aya")
	await novel_interface.show_dialog("Se o lugar que aquela garota quer ir for fora da cidade, farei com que a estação de inteligência local envie alguém para apoiá-lo em três dias.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Até o Canal de Suez está isolado...", "Lian")
	await novel_interface.show_dialog("Apenas assinando um acordo... eles realmente precisam ir tão longe?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Isso porque...", "Aya")
	await novel_interface.show_dialog("Porque as coisas já estão sérias──", "Aya")
	await novel_interface.show_dialog("Vocês dois estiveram no navio esse tempo todo, então ainda não sabem, não é?", "Mariru")
	await novel_interface.show_dialog("O-O que aconteceu...?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Há mais de dez horas, ocorreu uma explosão envolvendo produtos químicos industriais perto da Mesquita Ibra, em Hebron, no território de Masada.", "Mariru")
	await novel_interface.show_dialog("A onda de choque causou o colapso parcial de edifícios próximos e danificou os sistemas locais de energia, água e gás.", "Mariru")
	await novel_interface.show_dialog("Segundo o comunicado oficial, todos os residentes daquela zona já foram evacuados para uma zona segura.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Outro ataque terrorista?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Abaixo da Mesquita Ibra fica a Caverna de Machpelah, considerada o local de sepultamento dos ancestrais do povo Masadan.", "Aya")
	await novel_interface.show_dialog("Embora desde que tomaram aquela cidade no século passado, nunca tenham realizado nenhuma escavação arqueológica lá...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("O que é estranho é que, embora o relatório oficial de vítimas seja plausível, o bloqueio de informações é muito forte...", "Aya")
	await novel_interface.show_dialog("Você não consegue nem encontrar online vídeos filmados por residentes próximos. Todas as páginas de notícias sobre este incidente usam fotos e vídeos fornecidos por autoridades de Masada.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Ao mesmo tempo, todos os sistemas eletrônicos de vários grandes hospitais em Hebron funcionaram mal e um grande número de registros de emergência foram perdidos.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Após o acidente, Masada rejeitou quase imediatamente a oferta da organização do Património Mundial para ajudar a preservar as ruínas da Caverna de Machpelah.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Esse nível de controle flagrante de informações realmente parece Monola... mas por que eles bloqueariam as informações?", "Annie")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Provavelmente porque eles não querem que a situação se torne ainda mais complicada—", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("A análise de imagens de satélite sugere que a explosão foi provavelmente causada por um pequeno foguete.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("A resistência?\nMas eles não estão prestes a assinar um cessar-fogo...?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("O líder da resistência publicou imediatamente nas redes sociais dizendo que o incidente não tinha nada a ver com eles e expressou pesar e condenação.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Neste momento, a equipa de inteligência suspeita que o ataque possa ter sido realizado por alguma facção dissidente da resistência. Essas pessoas nunca foram um bloco unificado ~", "Aya")
	await novel_interface.show_dialog("Mesmo que o líder queira um cessar-fogo, os radicais de dentro não querem que o acordo aconteça, certo?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Talvez. Mas tudo isso ainda é especulação. O que não é especulativo é que estes próximos três dias são o período mais delicado que a Terceira Cidade Escolar poderia enfrentar—", "Mariru")
	await novel_interface.show_dialog("Conseqüentemente, o nível de segurança de Masada está no máximo. Você estará mais seguro no interior do distrito do que em mar aberto.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Descanse um pouco esta noite. Entraremos em contato com você novamente amanhã, assim que chegar ao porto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ok!", "Lian")
	await novel_interface.show_dialog("Entendi ~", "Annie")
	await novel_interface.show_text_only("Com isso, Mariru encerrou a ligação com as duas pessoas a bordo do navio e desviou o olhar para a imagem do vídeo de uma mulher vestida de vermelho na tela grande.")
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("...Você acha que algo está errado também, não é?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Sim. Este acordo foi anunciado muito abruptamente—", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Na semana passada, um porta-voz do governo de Masada anunciou subitamente que iriam assinar um acordo de cessar-fogo com a resistência dentro de dez dias.", "Mariru")
	await novel_interface.show_dialog("Os governos e os meios de comunicação social de todo o mundo elogiaram-no, e o desarmamento e o cessar-fogo são, de facto, a tendência geral.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──Mas o acordo ainda parece muito precipitado.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Eu concordo. Não parece o estilo habitual do primeiro-ministro Sheinneman de agir apenas após um planejamento cuidadoso.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("É porque sua condição piorou mais do que o esperado...?", "Aya")
	await novel_interface.show_dialog("Desde o último fórum de paz, o primeiro-ministro Sheinneman não apareceu em público nem uma vez~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Essa pode não ser a única razão—", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("As contradições internas nas forças de defesa de Massada estão provavelmente a aproximar-se do ponto em que não podem ser reconciliadas.", "Mariru")
	await novel_interface.show_dialog("Com o pessoal e os orçamentos enfrentando cortes acentuados, é apenas uma questão de tempo até que os oficiais condecorados e a facção tecnológica se separem.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Uma luta entre a facção técnica treinada na academia dentro das forças de defesa e a facção de mérito de guerra que ganhou distinção nas linhas de frente...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru assentiu levemente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("E Massada ainda não decidiu quem assinará este acordo histórico em seu nome──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Quem reivindicar uma conquista tão sem precedentes aos olhos do mundo inteiro provavelmente vencerá as próximas eleições, não é mesmo?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Inevitavelmente...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como se de repente percebesse algo, Akiko soltou um suave “Ah”.")
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Masada não quer que este ataque afete a cerimônia de assinatura, então eles estão insistindo que foi um acidente de explosão química...?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Heh, a maneira como você fica quando está abalado é tão fofa como sempre~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("(baixinho) ...Pervertido.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As bochechas de Akiko coraram levemente enquanto ela tossia duas vezes.")
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("Então, você já encontrou um?", "Akiko")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("──O “candidato” certo que você mencionou da última vez.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru balançou a cabeça.")
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Se fosse tão fácil encontrar um, aquele velho Sheinneman não teria resistido tanto tempo sem se aposentar...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Na manhã seguinte, 8h40.")
	await novel_interface.show_text_only("O navio cassino Liberty Star, restaurante VIP.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat4.png")
	await novel_interface.show_text_only("O restaurante VIP ficava no convés superior. Não era grande, mas a vista era excelente.")
	await novel_interface.show_text_only("Nuvens escuras pairavam do lado de fora das janelas, e a profunda superfície do mar parecia estar preparando alguma calamidade sinistra.")
	await novel_interface.show_text_only("Talvez porque a maioria dos convidados tenha sido nocauteada pelas bebidas gratuitas ilimitadas do cassino na noite passada, a nossa mesa era a única ocupada no restaurante.")
	await novel_interface.show_text_only("Olhei distraidamente pela janela. Esse trecho de água azul escura era o Canal Masada que ligava o Mar Vermelho ao Mar Morto.")
	await novel_interface.show_text_only("Esse canal, construído em conjunto pela Primeira e Terceira Cidades Escolares com tecnologia heteromórfica, tem 180 quilômetros de extensão, com desnível de 430 metros entre suas duas extremidades.")
	await novel_interface.show_text_only("Ele vai do porto de Eilat, no extremo norte do Golfo de Aqaba, até Masadaburg, na costa sudoeste do Mar Morto.")
	await novel_interface.show_text_only("Sendo a tábua de salvação de Masada, este canal tem sido acompanhado por conflitos e disputas com numerosos pequenos estados vizinhos desde a fase de planeamento.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Esse é o último bloqueio à frente, certo?\nQue peça de engenharia incrível...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie encontrou um documentário sobre o canal em seu telefone e me chamou para assistir com ela.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Sim. O gerente disse que já passamos por três eclusas gigantes com quedas de mais de cem metros durante a noite... Chegaremos antes do meio-dia.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Puxei o casaco excessivamente grande emitido pela Organização Internacional de Assistência Médica.")
	novel_interface.show_character("ren_medical","shy")
