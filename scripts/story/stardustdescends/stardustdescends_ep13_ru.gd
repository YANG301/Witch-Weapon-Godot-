# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("Судя по кадрам с монитора автомобиля, прямо впереди находился участок изоляционной стены, который еще строился.")
	await novel_interface.show_text_only("Поскольку это место находилось на окраине центральной части города, здесь не было той атмосферы процветания и умиротворения, как в центральном районе.")
	await novel_interface.show_text_only("Сталь, бетон и пыль восстановили грубую текстуру пустынной зоны боевых действий.")
	await novel_interface.show_text_only("Блокпост впереди был построен как крепость, вокруг него было припарковано несколько БТР одной модели.")
	await novel_interface.show_text_only("Вдалеке работало множество башенных кранов и тяжелой техники, а за стеной смутно виднелись в небе стаи дронов.")
	await novel_interface.show_text_only("Судя по тому, как были устроены металлические баррикады, выход впереди явно выглядел закрытым для движения транспорта.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Ты имеешь в виду... прорваться сквозь землю?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили постучала костяшками пальцев по внутренней стенке БТР.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("С этим?", "Эмили")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Броня прочная, но проводит тепло, как обычный металл. Мы, вероятно, продержимся секунд двадцать, прежде чем нас поджарят заживо~", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вдруг машина остановилась. Из кабины водителя послышался знакомый голос:")
	await novel_interface.show_dialog("Вера Валькирия, прапорщик первого класса батальона Каракал, забирает личный состав из лагеря для разведки за городом.", "Вера")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Это суперсильная охранница с корабля-казино, не так ли?!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я до сих пор отчетливо помню, как она поднимала огромного главного слона одной рукой.")
	await novel_interface.show_dialog("О, это Вера. Прямо сейчас возле рынка Иегуда проходит акция протеста. Если не хочешь увязнуть, лучше пойди в другой выход...", "Мужской голос")
	await novel_interface.show_dialog("Перестаньте говорить и пропустите нас уже. У нас нет времени на обход!", "Вера")
	await novel_interface.show_dialog("Хаха, хорошо, хорошо. Только не создавай больше проблем. В прошлый раз твой старик звонил из Генштаба просто чтобы людей поругать...", "Мужской голос")
	await novel_interface.show_dialog("Упомяни его еще раз, и я тебя собью.", "Вера")
	await novel_interface.show_dialog("Переместить блокпост. Пропустите их, пропустите!", "Мужской голос")
	await novel_interface.show_text_only("Эмили наклонилась и прошептала мне.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Итак, был ли у вас тот краткий момент, когда вы думали о том, чтобы позвать на помощь... а затем струсили?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Конечно нет!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я поспешно отвернул голову. Ух, она такая противная!")
	await novel_interface.show_text_only("Транспортное средство медленно покатилось вперед и вскоре проехало через изоляционную стену во внешний город Масады.")
	await novel_interface.show_text_only("Я предполагал, что внешний город будет еще более пустынным, но после того, как мы пересекли изоляционную стену, количество людей на дороге внезапно подскочило...")
	await novel_interface.show_text_only("Дороги здесь были более неровными, меньше высоток и зеленых полос, но улицы оказались неожиданно оживленными.")
	await novel_interface.show_text_only("Толпы, снующие туда-сюда автобусы и уличные торговцы, продающие товары, заставляли меня чувствовать, будто я проскользнул во времени.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Здесь так много людей...", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Конечно. Девяносто процентов населения этого города живет за пределами изоляционной стены.", "Эмили")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Так много!?", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Общая площадь внутреннего города составляет всего 32 квадратных километра, менее четверти общей площади Масады, а цены на землю возмутительны~", "Эмили")
	await novel_interface.show_dialog("Особенно в центральном районе. Площади единственного туалета там хватило бы, чтобы купить квартиру-студию на берегу Мертвого моря.", "Эмили")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Я думал, изоляционная стена предназначена для этого... ну, знаешь...", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Расовая сегрегация?", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Верно, верно. Нет ли какого-то правила, согласно которому определенные слова, оскорбительные для определенной группы, могут произноситься только самими людьми из этой группы...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Объединенный Совет давно запретил подобные вещи~", "Эмили")
	await novel_interface.show_dialog("Но Закон Масады о борьбе с терроризмом гласит, что если вы хотите долгосрочно проживать в центре города, где расположены правительство и парламент, вам необходимо пройти проверку Бюро безопасности.", "Эмили")
	await novel_interface.show_dialog("А претенденты, чьи ближайшие родственники принадлежат к определенным этническим группам, просто так никогда не проходят… понимаете?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я кивнул, понимая лишь наполовину.")
	await novel_interface.show_text_only("Вот это и есть сегрегация!\nДаже если кажется, что они изолируют себя...")
	await novel_interface.show_text_only("И если это правда, то даже большинство этнических масадцев также должны жить во внешнем городе, верно?")
	await novel_interface.show_text_only("На экране я увидел женщину-солдата с М16 на плече, которая сидела на корточках перед уличным ларьком, торгующим украшениями для волос, и торговалась с продавщицей, лицо которой было завернуто в платок.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Оказывается, никто не может позволить себе жилье, независимо от того, откуда он...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно машина резко затормозила. Моя голова чуть не ударилась об экран, а из кабины водителя послышалась ругань Веры.")
	await novel_interface.show_dialog("Черт возьми!!", "Вера")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Что случилось!?", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Я запустил разведывательный дрон. Просто смотрите на экран сами.", "Вера")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Мы с Эмили поспешили к дисплею и увидели сцену, от которой у меня побежали мурашки по коже...")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("На перекрестке впереди собралось более тысячи мужчин в черных пальто и черных шляпах, как на массовых похоронах.")
	await novel_interface.show_text_only("Они держали самодельные черно-белые плакаты протеста, как бы протестуя против существования каких-либо других цветов в мире.")
	await novel_interface.show_text_only("У большинства из них были огромные бороды и странные маленькие косички на висках. Этот взгляд показался мне ужасно знакомым...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Эти бесполезные куски дерьма! Они живут на государственные субсидии и продолжают протестовать каждый чертов день!", "Вера")
	await novel_interface.show_text_only("Давайте предположим, что «бип» — это какой-то диалект… Я все равно его не мог понять.")
	await novel_interface.show_dialog("Они хотят, чтобы число начальных школ, соответствующих их доктрине, удвоилось?\nЭти чертовы кудри на боках вросли в их мозги!?", "Вера")
	await novel_interface.show_text_only("Я услышал удары ногами из двери каюты. Видимо, наш водитель выскочил, чтобы затеять драку.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Ч-что она делает?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Собираюсь накрыть тарелки~", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эмили ответила рассеянно, проверяя карту маршрута на своем прочном военном планшете.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ч-что она собирается делать...? Эти люди - масаданцы, не так ли? \nКажется, я только что видел некоторых из них в музее...", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Это участок «исторического наследия» Масады. Они не работают, не платят налоги, не служат в армии, а государству по-прежнему приходится выплачивать им ежемесячные субсидии...", "Эмили")
	await novel_interface.show_dialog("Даже если они нарушают общественный порядок и блокируют движение, полиция и армия не могут их тронуть, потому что у них есть свои религиозные суды.", "Эмили")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Это так хорошо?", "Лиан")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Разве это не означало бы, что вы могли бы просто оставаться дома и играть в игры каждый день...)", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Но их доктрина гласит, что в доме не должно быть ни телевизоров, ни компьютеров, а доступ в Интернет строго запрещен.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Это пытка!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Но их жены другие. Им разрешено использовать электронные устройства, потому что эти мужчины полагаются на женщин, чтобы зарабатывать деньги и помогать содержать домашнее хозяйство.", "Эмили")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Это не потому, что субсидии слишком малы. Это потому, что у женщин в этих семьях в среднем шесть или семь детей, а у некоторых больше дюжины.", "Эмили")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Столько детей. Неудивительно, что религиозных школ недостаточно...", "Эмили")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Могли ли десять с лишним детей, собравшихся в музее вокруг двух бородатых мужчин в черном, быть...)", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("И две изможденные женщины следовали за ними...")
	await novel_interface.show_text_only("Когда я подумал о коляске, которую катил один из них, у меня по спине пробежал холодок.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Религиозные фундаменталисты — это рак, куда бы вы ни пошли...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили продолжала возиться со своим планшетом, опустив голову, и в ее тоне звучала странная печаль и намек на смирение.")
	await novel_interface.show_text_only("Вскоре Вера вернулась в машину, и Эмили похлопала по металлической перегородке кабины, чтобы напомнить ей.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Обогните до третьего перекрестка на восточной стороне. Там недавно построенный путепровод. Это самый быстрый маршрут за городом.", "Эмили")
	await novel_interface.show_dialog("А еще, если вы собираетесь сделать «это», не забудьте сначала развернуть автомобиль.", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Понятно~", "Вера")
	await novel_interface.show_text_only("Вера выкрутила руль до предела и резко нажала на газ, развернув переднюю часть за один оборот, нисколько не заботясь о комфорте пассажиров.")
	await novel_interface.show_text_only("Мгновение спустя с крыши машины раздались четыре глухих удара: тук, тук, тук, тук.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Подожди, почему это похоже на гранатомет...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Очень скоро собравшиеся люди в черном начали паниковать, поскольку из четырех разных мест толпы вырвались клубы белого дыма от слезоточивого газа...")
	await novel_interface.show_text_only("А наша машина врезалась в него и скрылась за углом.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("По мере того как тень от изолирующей стены позади меня становилась меньше, земля по обе стороны дороги постепенно становилась бесплодной.")
	await novel_interface.show_text_only("Пробыв в городе так долго, было легко забыть, что Масадабург сам по себе был необычным городом, построенным в пустыне.")
	await novel_interface.show_text_only("БТР мчался по пустой дороге, и нигде, кроме одинокого шоссе, не было никаких признаков человеческой жизни.")
	await novel_interface.show_text_only("Лишь несколько засохших кустов упорно стояли на песке...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Примерно через час за пределами города дверь десантного отделения медленно открылась, и передо мной предстал военный пункт снабжения.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Вот и все. Хотите, чтобы она помогла?", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("А?!", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Нет проблем. Она будет сотрудничать.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ты даже не волнуешься, что я убегу...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я запротестовал, очень послушно выходя из машины, но проглотил остаток на полпути.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Во всех направлениях пустынная пустыня. Куда бы мне вообще побежать...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эта затонувшая станция снабжения была спрятана в дюнах. Издалека это выглядело как еще одна голая земляная насыпь на бесплодном холме.")
	await novel_interface.show_text_only("Тем не менее, он явно был заброшен уже довольно давно...")
	await novel_interface.show_text_only("Вероятно, потому, что содержание такого места обходится слишком дорого, а также потому, что сопротивление уже сдало прилегающую территорию.")
	await novel_interface.show_text_only("Джип, припаркованный внутри станции, был покрыт толстым слоем пыли, повсюду были небрежно сложены огромные кучи мешков с песком, предназначенных для строительства укреплений.")
	await novel_interface.show_text_only("Вилочный погрузчик и генератор, прислоненные к стене, были покрыты ржавчиной и шрамами, оставленными ветром и песком. В углу тоже валялось несколько перевернутых коробок с боеприпасами...")
	await novel_interface.show_text_only("Вернувшись в машину, Эмили ответила на мой второй вопрос: по каким именно «личным делам» они пришли сюда.")
	await novel_interface.show_text_only("Я уже частично догадался. Это было связано с моим прикрытием...")
	await novel_interface.show_text_only("По словам Эмили, транспортировка любых видов военных грузов нарушает международные конвенции НПО в зонах боевых действий.")
