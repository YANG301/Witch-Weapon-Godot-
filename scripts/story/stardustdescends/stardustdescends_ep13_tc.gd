# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("從車體監控傳來的影像看，我們的正前方是一段還在建造中的隔離牆。")
	await novel_interface.show_text_only("由於地處內城區邊緣，這裡完全沒有中心區那種繁華安逸的感覺──")
	await novel_interface.show_text_only("鋼鐵、水泥和煙塵還原出了這片荒涼沙漠戰區最原始的粗糲質感。")
	await novel_interface.show_text_only("前方的崗哨被建得猶如堡壘一般，周圍還停靠著好幾輛同型號的裝甲運兵車。")
	await novel_interface.show_text_only("遠處有很多塔吊和重型機械在工作，牆壁上空還隱約能看到成片的無人機群。")
	await novel_interface.show_text_only("從金屬圍欄的放置方式看來，前方的出口儼然一副禁止通行的樣子。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("你們是要……闖過去？", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("艾米莉歐拍了拍裝甲車的內壁。")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("就憑它？", "艾米莉歐")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("這種裝甲雖然堅固，但導熱性和普通金屬沒什麼區別，在咱們被烤熟前大概能堅持個20秒吧~", "艾米莉歐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("忽然，我們的車停了下來，前方駕駛艙傳來一個似曾相識的聲音──")
	await novel_interface.show_dialog("卡拉卡爾營一級准尉薇拉·瓦爾基里，去營區接隊員出城偵查。", "薇拉")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("（是賭船上負責安檢的那個怪力女吧？！）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("她一隻手將那身材肥碩的總主教拎起來的畫面我現在都記憶猶新。")
	await novel_interface.show_dialog("是薇拉啊，現在耶胡達集市那邊有抗議活動，不想被圍住的話最好從其他出口……", "男聲")
	await novel_interface.show_dialog("別廢話快放行，繞路時間來不及了！", "薇拉")
	await novel_interface.show_dialog("哈哈好吧好吧，不過你別再捅什麼婁子了，上次你老爹從總參謀部直接打電話來罵人……", "男聲")
	await novel_interface.show_dialog("你要再提他，我就直接軋過去。", "薇拉")
	await novel_interface.show_dialog("挪一下路擋，放行了放行了！", "男聲")
	await novel_interface.show_text_only("艾米莉歐湊過來小聲問我。")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("吶，你剛才是不是有一瞬間想過大聲呼救，然後又慫下去了呀？", "艾米莉歐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("才沒！", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我趕忙扭過頭去，啊啊這人好討厭！")
	await novel_interface.show_text_only("車子向前緩緩移動，很快穿過隔離牆來到了馬薩達的外城區。")
	await novel_interface.show_text_only("我原以為外城區會更加荒蕪，但穿過隔離牆後，路上的人突然多了起來──")
	await novel_interface.show_text_only("雖然這邊路面有些不平整，也沒那麼多高層建築和綠化帶，但街道卻異常熱鬧。")
	await novel_interface.show_text_only("熙熙攘攘的人群、穿梭往來的公交車和在路邊招攬生意的小販，讓我感覺彷彿穿越了時空。")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("這裡人好多……", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("那當然了，這座城市90%的人住在隔離牆外面。", "艾米莉歐")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("這麼多！？", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("內城區總共只有32平方公里，不到馬薩達面積的四分之一，而且地價高得離譜~", "艾米莉歐")
	await novel_interface.show_dialog("尤其是中心區，一個廁所的面積就夠在死海旁邊買套單身公寓了。", "艾米莉歐")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("我還以為隔離牆是為了那個……嗯……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("種族隔離？", "艾米莉歐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("對對對，好像有某種規定，某些對特定族群不友好的詞彙，只有這個族群自己人能說……")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("聯合議會早就明確禁止這麼幹了~", "艾米莉歐")
	await novel_interface.show_dialog("但馬薩達《反恐襲法》規定，如果想在政府和議會所在的內城區長住，就必須透過安全域性的稽核。", "艾米莉歐")
	await novel_interface.show_dialog("而那些直系親屬是特定民族的申請者，都“恰好”無法過審……明白了嗎？", "艾米莉歐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我似懂非懂的點了點頭。")
	await novel_interface.show_text_only("這不就是隔離嗎！
雖然好像隔離的是自己……")
	await novel_interface.show_text_only("而且這麼說的話，即使是馬薩達本族的居民，也大部分都生活在外城區吧？")
	await novel_interface.show_text_only("我看到螢幕上，一個挎著M16的女兵蹲在賣頭飾的地攤前，在跟用頭巾包住臉的女攤主討價還價。")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("（原來哪兒的人都買不起房啊……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("突然車子一個急剎，我的頭差點沒磕在螢幕上，同時駕駛艙傳來了薇拉的叫罵。")
	await novel_interface.show_dialog("靠！！", "薇拉")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("怎麼了！？", "艾米莉歐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("我放了偵查無人機，你們自己看螢幕吧。", "薇拉")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("我和艾米莉歐趕忙湊到螢幕前，看到了讓人不寒而慄的景象──")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("上千名身穿黑外套，頭戴黑色帽子的男性聚在前方路口，猶如一場超大型的葬禮。")
	await novel_interface.show_text_only("他們舉著自制只有黑白兩色的標語牌，似乎在抗議這世界存在的其他任何顏色。")
	await novel_interface.show_text_only("這些人大多留著大鬍子，兩鬢梳著奇怪的小辮，這似曾相識的造型……")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("這幫XX玩意兒！吃著國家的補貼還XX天天抗議！", "薇拉")
	await novel_interface.show_text_only("就當“XX”是某種方言吧……反正我聽不懂。")
	await novel_interface.show_dialog("要求將符合教義的小學數量提升一倍？
他們的XX鬢角是不是XX長進腦子裡了！？", "薇拉")
	await novel_interface.show_text_only("駕駛艙傳來踹門的聲音，我們的駕駛員似乎跳下車去幹架了。")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("她、她幹嘛去了？", "小憐")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("去遮擋車牌吧~", "艾米莉歐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("艾米莉歐在厚實的軍用平板上檢視著路線圖，漫不經心的回答道。")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("要、要幹什麼……那些都是馬薩達人吧？
好像我剛在博物館也見過……", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("這幫人是馬薩達的“歷史遺產”，不工作不繳稅還不用服兵役，每個月還要政府發補助金──", "艾米莉歐")
	await novel_interface.show_dialog("就算是破壞公共秩序阻斷交通，警察和軍隊也管不了，因為他們有自己的宗教法庭。", "艾米莉歐")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("……這麼好？", "小憐")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("（那豈不可以天天宅家裡玩遊戲……）", "小憐")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("不過他們的教義要求家裡不能有電視和電腦，並且嚴格禁止上網──", "艾米莉歐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("那是酷刑吧！！")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("但他們的老婆就不一樣了，可以使用電子裝置，畢竟這幫人還要靠女人賺錢來補貼家用。", "艾米莉歐")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("倒不是因為補助金給的少，而是這種家庭的女性平均要生六七個孩子，多的能生十幾個。", "艾米莉歐")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("這麼多小孩，宗教學校當然不夠用了……", "艾米莉歐")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（難道剛才在博物館看到圍著那兩個黑衣大鬍子的十幾個小孩──）", "小憐")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("還有跟在那幫孩子身後面容憔悴的兩個女人……")
	await novel_interface.show_text_only("想到其中一個女人推著的那輛嬰兒車，我不禁打了個冷顫。")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("宗教原教旨主義者，無論在哪都是癌症……", "艾米莉歐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("艾米莉歐繼續低著頭在擺弄平板，語氣中帶著莫名的悲傷和些許無奈。")
	await novel_interface.show_text_only("不一會，薇拉就回到了車上，艾米莉歐拍了拍駕駛艙的金屬擋板提醒她注意。")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("繞到東邊第三個路口，有一座剛建好的高架橋，是最快的出城路線。", "艾米莉歐")
	await novel_interface.show_dialog("還有，你要做“那個”的話，記得先掉頭哦。", "艾米莉歐")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("明白~", "薇拉")
	await novel_interface.show_text_only("薇拉把方向盤打滿猛踩油門，一把輪就將車頭調了過來，完全不考慮乘客體驗。")
	await novel_interface.show_text_only("隨即車頂傳來“咚─”“咚─”“咚─”“咚─”四聲悶響。")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("（等等，怎麼像是榴彈發射器的聲音……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("很快聚集的黑衣人便開始騷動，人群中不同的位置同時冒出四股催淚彈的白煙……")
	await novel_interface.show_text_only("而我們的車開足馬力，迅速消失在轉角。")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("隨著隔離牆的影子在我身後越變越小，道路兩邊的環境逐漸開始變得荒蕪。")
	await novel_interface.show_text_only("在城區裡待久了，很容易忽略馬薩達堡本身是一座突兀建在沙漠中的城市。")
	await novel_interface.show_text_only("運兵車沿著空無一人的道路疾馳，孤獨的公路旁已經沒有任何人類的蹤跡。")
	await novel_interface.show_text_only("僅有少許乾枯的灌木，還死硬的佇立在沙地中……")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("出城後大約又行駛了一個多小時，隨著車廂門被緩緩開啟，一座軍用補給站出現在了我面前。")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("就是這了，要讓她幫忙幹活嗎？", "薇拉")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("誒？！", "小憐")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("沒問題，她會配合的。", "艾米莉歐")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("你們就不怕我逃跑──", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("我一邊抗議一邊很老實的下車，話說到一半就嚥了回去。")
