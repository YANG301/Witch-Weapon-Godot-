	await novel_interface.show_dialog("（四周都是荒無人煙的沙漠，我能跑哪去啊……）", "小憐")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("這座下沉式補給站藏在沙丘中，從遠處看不過是光禿禿的山上眾多土坡中的一個。")
