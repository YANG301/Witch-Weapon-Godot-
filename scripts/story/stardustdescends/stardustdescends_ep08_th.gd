	await novel_interface.show_text_only("Stardust ใจเย็นลงนิดหน่อย ยังคงกอดฉันอยู่ เธอเงยหน้าขึ้น กระพริบตาโต และชิ้นหูบนหัวของเธอก็เปล่งประกาย")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("ถ้าอย่างนั้นสัญญากับฉันว่าคุณจะไปในทิศทางนั้นกับฉัน โอเค...?", "Stardust")
	await novel_interface.show_dialog("มันสำคัญจริงๆ...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("เมื่อกี้คุณไม่ได้แกล้งร้องไห้ใช่ไหม?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(เด็กนี่มันกำมือจริงๆ...)", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันไม่รู้ว่า มาริรุ จะยอมให้ฉันพา Tagalong เล็กๆ นี้ไปที่ไหนสักแห่งที่อันตรายขนาดนี้หรือไม่")
	await novel_interface.show_text_only("ทันใดนั้น เสียงคงที่ก็ดังผ่านหูฟังของฉัน และมาริรุก็กลับมาที่สายอีกครั้ง")
	await novel_interface.show_dialog("เหลียน แอนนี่ คุณสองคนรู้จักมาซาดาเบิร์กมากแค่ไหน?", "มาริรุ")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("อืม...", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("ประมาณ...", "แอนนี่")
	await novel_interface.show_text_only("ฉันพยายามอย่างหนักที่จะจำ แต่แม้กระทั่งในการฝึกอบรมตัวแทน SID ข้อมูลเกี่ยวกับ Masadaburg ก็กระจัดกระจาย")
	await novel_interface.show_dialog("เมืองแห่งการศึกษาที่สาม ซึ่งเป็นเมืองป้อมปราการใจกลางเอเชียตะวันตก แบ่งออกเป็นเขตชั้นในและชั้นนอกด้วยกำแพงแยกสูงหลายสิบเมตร", "แอนนี่")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("ฉันคิดว่าเป็นเพราะความขัดแย้งทางเชื้อชาติหรือศาสนาหรืออะไร?", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("อย่างไรก็ตาม เขตรอบนอกของมาซาดาเบิร์กดูอันตราย ดูเหมือนมีการโจมตีด้วยระเบิดหนึ่งหรือสองครั้งทุกเดือน!")
	await novel_interface.show_dialog("หน่วยข่าวกรองของพวกเขาคือสำนักภารกิจฟื้นฟูมาซาดา ซึ่งถูกควบคุมโดยกองทัพโดยตรง และมีสไตล์ที่กล้าหาญและหัวรุนแรง", "แอนนี่")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("อา ฉันรู้แล้ว เอเจนซี่นั้นชื่อ \"โมโนล่า\" ใช่ไหม?", "เหลียน")
