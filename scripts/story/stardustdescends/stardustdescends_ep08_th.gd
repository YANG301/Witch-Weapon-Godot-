	await novel_interface.show_dialog("นอกจากนี้คุณไม่จำเป็นต้องเปลี่ยนเรือด้วยซ้ำ เรือคาสิโนนี้จะเทียบท่าที่ท่าเรือมาซาดาเช้าพรุ่งนี้~", "อายะ")
	await novel_interface.show_dialog("...เกิดอะไรขึ้น? เราควรจะมุ่งหน้าไปที่ซามอนตันไม่ใช่เหรอ?", "แอนนี่")
	await novel_interface.show_dialog("มาซาดาเตรียมลงนามข้อตกลงหยุดยิงกับกลุ่มต่อต้านภายใน 3 วัน และคลองสุเอซจะถูกปิดสนิทจนกว่าพิธีจะสิ้นสุด", "มาริรุ")
	await novel_interface.show_dialog("เพื่อความปลอดภัยของผู้โดยสาร คาสิโนเพิ่งตัดสินใจปฏิบัติตาม “คำแนะนำที่แข็งแกร่ง” ของกองทัพ Masada และหันกลับไปที่ Eilat", "มาริรุ")
	await novel_interface.show_dialog("เรือลำนี้จะมุ่งหน้าไปทางเหนือไปตามคลองแกรนด์ทะเลแดง-เดดซี ท่าเรือที่ท่าเรือมาซาดา และอยู่ที่นั่นจนกว่าการปิดล้อมคลองสุเอซจะถูกยกเลิก", "มาริรุ")
	await novel_interface.show_dialog("ตัวตนบนปกของแอนนี่คือนักเรียนในโครงการแลกเปลี่ยนงานศิลปะ New Toyosu เอกสารเรียบร้อยแล้ว", "มาริรุ")
	await novel_interface.show_dialog("สำหรับคุณ เหลียน──การป้องกันชายฝั่งของมาซาดะน่าจะลงทะเบียนตัวตนของคุณไว้แล้ว ดังนั้นเป็นพยาบาลตัวน้อยของคุณต่อไป~", "มาริรุ")
	await novel_interface.show_text_only("มีรอยยิ้มในน้ำเสียงของมาริรุที่ทำให้ฉันรู้สึกไม่สบายใจอย่างเห็นได้ชัด")
