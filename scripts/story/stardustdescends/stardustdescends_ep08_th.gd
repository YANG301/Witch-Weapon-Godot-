# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("เมืองแห่งการศึกษาที่สาม มาซาดาเบิร์ก")
	await novel_interface.show_text_only("ป้อมปราการทางทหารที่สร้างขึ้นในทะเลทราย มีชื่อเสียงจากโคลนทะเลเดดซี พายุทราย และการโจมตีของผู้ก่อการร้าย")
	await novel_interface.show_text_only("สำหรับคนส่วนใหญ่ ข่าวใดๆ เกี่ยวกับมาซาดาเบิร์กหมายถึงความขัดแย้งทางทหารหรือภัยพิบัติด้านมนุษยธรรม")
	await novel_interface.show_text_only("ภูมิทัศน์ที่เปื้อนเลือดและทราย น้ำมันดิบ และควันสีขาว ปกคลุมไปทั่วดินแดนโบราณแห่งนี้มายาวนาน...")
	await novel_interface.show_text_only("ผู้คนอาศัยอยู่ที่นั่นเป็นแบบไหน?\nฉันไม่รู้เลยจริงๆ...")
	await novel_interface.show_text_only("แต่ก็ยังรู้สึกคุ้นเคยอย่างประหลาด เหมือนกับว่าฉันเคยไปที่นั่นด้วยตัวเอง...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("เฮ้อ──", "เหลียน")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("ฉันพิงราวบันไดบนดาดฟ้า ขณะที่ Stardust เกาะฉันเหมือนโคอาล่า น้ำตายังคงไหลเป็นประกายในดวงตาของเธอ")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("เอาล่ะเอาล่ะ ฉันแค่ล้อเล่น──", "เหลียน")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("เฮ้ ง่ายๆเลยนะนั่น เล็บของคุณทิ่มเข้าไปในเนื้อของฉัน...", "เหลียน")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("ดม...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("ด-อย่าเช็ดจมูกโดนเสื้อผ้าฉันนะ!!!", "เหลียน")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ฉันถอนหายใจอย่างช่วยไม่ได้และลูบหัวเธอเพื่อทำให้เธอสงบลง")
	await novel_interface.show_text_only("ก่อนหน้านี้อายะเดาว่า Stardust ชี้ไปทางนั้นคือมาซาดาเบิร์ก แต่หลังจากถามไปรอบๆ กลับกลายเป็นว่าเด็กสาวไม่รู้ว่าชื่อสถานที่นั้นหมายถึงอะไร")
	await novel_interface.show_text_only("หรือว่าเธอไม่เข้าใจแนวคิดของ \"เมืองแห่งการศึกษา\" ด้วยซ้ำ...")
	await novel_interface.show_text_only("มาริรุบอกว่าเธอจะจัดการข้อมูลก่อนและบอกให้ฉันรอบนดาดฟ้าจนกว่าเธอจะติดต่อฉันอีกครั้ง")
	await novel_interface.show_text_only("ฉันยังยอมรับไม่ได้ว่าผู้หญิงคนนี้เป็นภาพลวงตาที่มีเพียงฉันเท่านั้นที่มองเห็น ดังนั้นฉันจึงถือโอกาสทดสอบเพิ่มเติมอีก 2-3 ครั้ง──")
	await novel_interface.show_text_only("ก่อนอื่น ฉันวางโทรศัพท์ลงบนพื้นแล้วขอให้เธอหยิบมันขึ้นมา")
	await novel_interface.show_text_only("แต่เธอแค่ยิ้มอย่างสุภาพให้ฉัน เอียงหัวแล้วมองฉันแบบ \"คุณโง่เหรอ?\"")
	await novel_interface.show_text_only("หลังจากจนมุมไปได้ประมาณสามสิบวินาที ฉันก็ทำได้เพียงหยิบโทรศัพท์ของตัวเองขึ้นมาอย่างเชื่องช้า แล้วความคิดที่โง่เขลาก็เกิดขึ้นกับฉัน──")
	await novel_interface.show_text_only("“ถ้าเธอไม่มีร่างกาย เธอจะทะลุกำแพงได้ไหม?”")
	await novel_interface.show_text_only("ขณะที่เธอมองดู ฉันก็กลับเข้าไปในกระท่อม ล็อคประตูที่ทอดไปสู่ดาดฟ้า และซ่อนตัวในจุดบอดของเธอ")
	await novel_interface.show_text_only("สองนาทีต่อมา ฉันได้ยินเสียงสะอื้นเงียบ ๆ จากอีกด้านหนึ่ง เมื่อรู้สึกได้ถึงปัญหา ฉันจึงรีบเปิดประตู และเธอก็คว้าต้นขาของฉันและไม่ยอมปล่อย")
	await novel_interface.show_text_only("เพื่อหลีกเลี่ยงไม่ให้พนักงานเสิร์ฟเดินผ่านห้องโดยสารเป็นครั้งคราว ฉันจึงพยายามลากเธอกลับมาข้างราวบันได")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(ติดอุปกรณ์เสริมขานี้แล้วเดินแทบไม่ได้เลย...)", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("เลี้ยงลูกเหนื่อยขนาดนี้มั้ย!?")
	await novel_interface.show_text_only("ที่แย่กว่านั้นคือไม่มีใครสามารถเห็นเธอได้ ตอนนี้ฉันคงดูเหมือนคนบ้าพึมพำกับตัวเองและเดินไปมาอย่างแปลกประหลาด")
	await novel_interface.show_text_only("เนื่องจากฉันไม่มีคำตอบสำหรับความเกาะติดของเธอ ฉันจึงทำได้เพียงเกลี้ยกล่อมเธออย่างอ่อนโยน")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("นั่น นั่น นั่น ฉันจะไม่ทิ้งคุณไว้ข้างหลัง~", "เหลียน")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("นั่นเป็นเรื่องแย่ของฉันเมื่อกี้ ฉันจะขอโทษ โอเคไหม?", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ฉันพูดพร้อมกับทำหน้าบูดบึ้งใส่เธอ")
