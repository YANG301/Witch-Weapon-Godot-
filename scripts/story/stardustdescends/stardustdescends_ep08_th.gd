	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("ใช่แล้ว อาวุธของพวกเขาก็ก้าวหน้าเช่นกัน ในเกม โดยปกติแล้ว Masada จะคอยจัดหารถถังและโดรนควบคุมระยะไกลให้กับผู้เล่น...", "เหลียน")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("เอาล่ะ ก็พอแล้ว──", "มาริรุ")
	await novel_interface.show_dialog("สภาพแวดล้อมทางภูมิศาสตร์การเมืองในภูมิภาคนั้นมีความซับซ้อนมาโดยตลอด และเมื่อคุณเพิ่มกองกำลังต่อต้านและกลุ่มแบ่งแยกดินแดนเข้าไป มันจะยิ่งวุ่นวายมากขึ้น", "มาริรุ")
	await novel_interface.show_dialog("แต่หากพูดถึงเฉพาะ \"เขตชั้นใน\" ของมาซาดาเบิร์ก การรักษาความปลอดภัยก็ไม่ได้แย่ไปกว่าของนิวโทโยสุ ดังนั้น──", "มาริรุ")
	novel_interface.show_character("ren_full","perspire1")
