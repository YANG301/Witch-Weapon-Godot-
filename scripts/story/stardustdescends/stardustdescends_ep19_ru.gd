# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Моей дочери Наше в этом году исполняется семь, и в последнее время она обожает тащить меня собирать вместе с ней пазлы.", "Запись")
	await novel_interface.show_dialog("Иногда я нарочно делаю вид, что мне не хочется или что я занят, и соглашаюсь только \"скрепя сердце\", после того как некоторое время слушаю ее мольбы.", "Запись")
	await novel_interface.show_dialog("На самом деле я и сам обожаю играть с ней... но, когда Нэша капризничает, это просто невозможно мило.", "Запись")
	await novel_interface.show_text_only("Из записи донесся взрыв смеха в зале.")
	await novel_interface.show_dialog("Пазл, с которым мы играли, был совершенно нового типа, совсем не похожего на те, что были у меня в детстве--", "Запись")
	await novel_interface.show_dialog("На одной стороне каждой детали был цветной e-ink-дисплей с неподвижным изображением, так что внешне он почти не отличался от обычного пазла.", "Запись")
	await novel_interface.show_dialog("Но чем ближе ты подходил к завершению и вставлял последний кусочек, тем ярче вспыхивали все элементы, а изображение на пазле начинало двигаться...", "Запись")
	await novel_interface.show_dialog("Я до сих пор отлично помню, как увидел это впервые. Сначала мне показалось, что мы собираем знаменитую фотографию Земли под названием \"Blue Marble\"--", "Запись")
	await novel_interface.show_dialog("Но когда моя дочь положила последний кусочек, все изображение начало двигаться: камера отъехала назад, пролетая мимо Луны, Марса, Юпитера...", "Запись")
	await novel_interface.show_dialog("Затем он пролетел за пределами Солнечной системы, за бесчисленными звездами, и, наконец, открыл весь Млечный Путь.", "Запись")
	await novel_interface.show_dialog("Наша от волнения вскочила, закричала и трясла меня за руку, точно так же, как я сделал это в первый раз, когда проводил эксперимент по изгибанию света из гетерогенной материи...", "Запись")
	await novel_interface.show_dialog("Я думаю, что каждый здесь пережил подобный момент.", "Запись")
	await novel_interface.show_dialog("В тот день я выбежал из лаборатории в тапочках и пижамных штанах, крича всю дорогу до кабинета профессора микробиологии нашего университета.", "Запись")
	await novel_interface.show_dialog("Старик однажды сказал мне, что если бы я смог провести эксперимент, он бы открыл дорогую бутылку японского саке, которую дал ему его ученик...", "Запись")
	await novel_interface.show_dialog("Этот напиток чуть не задушил меня до смерти. Я до сих пор не могу поверить, что его продают за такую ​​цену.", "Запись")
	await novel_interface.show_text_only("Публика разразилась смехом, а некоторые аплодировали.")
	await novel_interface.show_dialog("Позже я постепенно пришел к пониманию, что процесс изучения гетерогенной материи действительно во многом похож на сбор головоломки.", "Запись")
	await novel_interface.show_dialog("Прежде чем загадка будет окончательно решена, все, что вы можете сделать, это попробовать что-то, основываясь на интуиции и нескольких подсказках.", "Запись")
	await novel_interface.show_dialog("Это похоже на сбор головоломки: сначала вы находите четыре угла и используете их как аксиомы, как логические точки опоры.", "Запись")
	await novel_interface.show_dialog("Затем, начиная с углов, делаете все возможное, чтобы закрыть раму.", "Запись")
	await novel_interface.show_dialog("Точно так же, как вы начинаете с самых основных аксиом и постепенно приходите к логически последовательным выводам.", "Запись")
	await novel_interface.show_dialog("Затем, в рамках этого завершенного кадра, вы продолжаете предпринимать попытки проб и ошибок, шаг за шагом продвигаясь к неизвестному ядру...", "Запись")
	await novel_interface.show_dialog("Процесс долгий и изнурительный, и только когда последний кусок будет на месте, мы сможем мельком увидеть правду о мире.", "Запись")
	await novel_interface.show_dialog("В течение этого времени вы можете дать волю своему воображению в ожидании, гадая, какую великолепную панораму вы в конечном итоге увидите.", "Запись")
	await novel_interface.show_dialog("Я считаю, что это самая увлекательная часть научных исследований и причина, по которой большинство из нас упорствуют!", "Запись")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Нажмите--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Когда аплодисменты публики вот-вот нарастают, запись внезапно оборвалась.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Это запись, которую Мариру нашла на компьютере умершего исследователя.", "Ая")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Предположительно, это была часть частной беседы Мушара на 30-й Сольвейской конференции более десяти лет назад~", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Говорил... Валид Мушар?", "Акико")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Акико была немного удивлена. На мгновение она не могла связать этот утонченный, спокойный голос с безжалостным лидером террористов.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("30-я Сольвеевская конференция... это было в 2026 году, верно?", "Акико")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эта научная конференция, основанная бельгийским промышленником Эрнестом Сольвеем, приглашала на каждое заседание ведущих ученых мира того времени.")
	await novel_interface.show_text_only("Он проводился раз в три года, и хотя войны и политические беспорядки несколько раз приводили к его приостановке, он продолжается и по сей день.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Правильно, за год до начала войны...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Тогда Мушар и подумать не мог, что через несколько месяцев после этой речи его жена и дочь окажутся мертвыми на улице из-за слепого межэтнического кровопролития.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("В то время международные договоры запрещали исследования гетерогенных веществ, поэтому дискуссии на таких научных конференциях могли проводиться только в закрытом режиме.", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Но в следующем году каждая страна сорвала маски, и большинства людей, присутствовавших на той конференции, уже нет в живых...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("На лице Аи промелькнула меланхолия, но она быстро вернулась к своему обычному состоянию.")
	await novel_interface.show_text_only("Она вывела на большой экран прямые трансляции с десятков различных медиа-платформ, и все без исключения показывали церемонию подписания Масады...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Казалось, все шло гладко, никаких сообщений о взрыве, который Эмили устроила недалеко от места встречи, не поступало.")
	await novel_interface.show_text_only("После завершения длительного процесса подписания документов представители Масадана и сопротивления подошли вместе и прижали ладони к экрану.")
	await novel_interface.show_text_only("Их отпечатки ладоней вместе с текстом соглашения были загружены в Интернет в режиме реального времени, и система городской обороны Масады немедленно начала обновлять свой протокол защиты.")
	await novel_interface.show_text_only("В то же время сопротивление добровольно предоставило цифровые файлы более чем двухсот тысяч членов, поддержавших соглашение о прекращении огня.")
	await novel_interface.show_text_only("Отныне, пока эти люди сложат оружие, они смогут свободно входить и покидать большинство районов Масады, как обычные граждане.")
	await novel_interface.show_text_only("Цена заключалась в том, что им пришлось носить браслеты слежения в течение двух лет и находиться под системой наблюдения Монолы.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("В конце церемонии два представителя должны были обменяться документами и пожать друг другу руки на глазах у представителей СМИ.")
	await novel_interface.show_text_only("Генерал-майор Сил обороны и лидер сопротивления держали рукопожатие перед камерами целых три минуты.")
	await novel_interface.show_text_only("Преувеличенная ухмылка Хамона почти застыла на его лице, а Мушар лишь сохранял спокойную улыбку.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Ая посмотрела на разинутый рот на экране, затем взглянула на информацию, которую она собрала о мужчине вчера из социальных сетей.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Хамон, да...\nНеудивительно, что в армии его прозвали \"Жабой\"~", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Увидев, что Мариру все еще не вернулась, Акико сняла очки и естественно подышала на линзы.")
	await novel_interface.show_text_only("Когда она вытерла их, прядь волос, захваченная у виска, соскользнула с ее бакенбарда, и выражение ее лица и осанка мгновенно стали похожими на чужие...")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Этот парень является знаменосцем ястребиной фракции в Силах обороны Масады.", "Акико")
	await novel_interface.show_dialog("Его сторонники хвалят его как героя, защитившего нацию. Оппоненты называют его мясником, залитым кровью...", "Акико")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая заметила изменение тона Акико и с нескрываемым любопытством уставилась на ее видеоизображение.")
	await novel_interface.show_text_only("Акико, казалось, это не волновало, и она продолжала вспоминать.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Тогда Хамон последовал за своим дядей, премьер-министром Шнейдерманом, который в то время был генерал-лейтенантом Армии восстановления, и сражался в обороне Масады.", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Тот самый, где они изменили ситуацию с помощью \"Phantom Force\" после того, как закончились боеприпасы и припасы?", "Ая")
	await novel_interface.show_dialog("Это, безусловно, дает ему право баллотироваться на пост президента...", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Кажется, каждый старший офицер, принимавший участие в той битве и до сих пор жив, сейчас занимает важный пост либо в армии, либо в правительстве~", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая, которая обычно не интересовалась политикой, вынесла собственное суждение на основе информации, которую она собрала и систематизировала вместе с ИИ вчера вечером.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Менее десяти из этих офицеров живы, и каждый из них — герой войны, который также знает главные тайны страны...", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Правда о \"Phantom Force\", хах... Они, конечно, хорошо защищали этот секрет.", "Ая")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Но есть и другие причины, по которым Хамон получает такую большую поддержку, верно? Я слышал, что Силы обороны давно бы обанкротились, если бы не его эффективное руководство...", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Менеджмент?\nНазовите это грабежом.", "Акико")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Акико даже не пыталась скрыть своего презрения к нему.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Помимо обхода международного права во всех возможных серых зонах, он усилил расовую сегрегацию в военной зоне и значительно расширил возможности стрельбы из беспилотного оружия...", "Акико")
	await novel_interface.show_dialog("Офицеры разведки Палантира посчитали, что, если этот человек придет к власти, первое, что он сделает, — это протолкнет Национальный этнический закон.", "Акико")
	await novel_interface.show_dialog("В конце концов, Великий раввин уже открыто заявил о своей поддержке Хамона...", "Акико")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая понятия не имела, как реагировать на столь продвинутую политическую тему, поэтому спокойно поискала в поиске «Национальный этнический закон».")
	await novel_interface.show_text_only("Под ним всплыл поток ключевых слов вроде «расовая сегрегация».")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Люди действительно скучные...)", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Кстати, почему Мариру еще не вернулась...\nЭтот напиток был неплохим, да?", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Расслабься, эта женщина крутая...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ая открыла новую бутылку энергетического напитка и сделала глоток. Она мгновенно выглядела гораздо более проснувшейся.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Она, наверное, сейчас сидит в туалете и думает...", "Ая")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("...Думаешь, как тебя казнить?", "Акико")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Думая о плане Фамура~!!", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Даже собрав гору информации, Ая все еще понятия не имел, какую форму примет неминуемая атака сопротивления.")
	await novel_interface.show_text_only("Она вытащила еще одну серию спутниковых снимков Мертвого моря.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("На спутниковых снимках в реальном времени песчаная буря выглядела как лужа грязной воды, беспорядочно растекающаяся по поверхности Земли.")
	await novel_interface.show_text_only("К этому моменту эта лужа полностью поглотила Гранд-Каньон Муджиб на восточном берегу Мертвого моря и катилась к крепости Масада на юго-западе...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Айя еще дважды просканировал район трущоб Масады с помощью спутника SID и не обнаружил никаких следов каких-либо флуктуаций фазы пространства-времени.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Даже если бы действительно существовало какое-то оружие из гетерогенной материи, способное блокировать электромагнитные волны, оно в настоящее время должно быть бездействующим...", "Ая")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("В противном случае спутниковые снимки трущоб уже превратились бы в искаженное размытие из-за эффектов искривления света...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Атаковать хорошо защищенную крепость Масада без оружия из гетерогенной материи?", "Акико")
	await novel_interface.show_dialog("Даже если бы защитное оружие ИИ было на 100% повреждено, это всё равно было бы невозможно...", "Акико")
	await novel_interface.show_dialog("Судя по размеру ударных групп, описанных Лианом, эти террористы не продержатся и двадцати минут. Они не могли ступить в центр города.", "Акико")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Что-то определенно не так...", "Ая")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как и сказал Мариру, на этот раз Мушар сдал и себя, и сотни тысяч товарищей сопротивления.")
	await novel_interface.show_text_only("Если бы речь действительно шла о атаке, то, как игрок, решивший пойти олл-ин за столом, он был бы полон решимости победить противника в этом же раунде.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Еще сложнее то, что они действовали при неявном условии: они не могли активировать автоматическую систему возмездия Масады.")
	await novel_interface.show_text_only("Если бы их не заботила автоматическая система возмездия, сопротивление могло бы просто придерживаться своей прежней стратегии и продолжать сжимать жизненное пространство Масады.")
	await novel_interface.show_text_only("Однажды социальная и экономическая системы Масады полностью рухнут, и тогда сопротивление легко сможет взять город в лоб.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
