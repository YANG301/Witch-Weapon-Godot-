# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("I sit by the corner of Nix's luxurious bed and listen to her story.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("They change my guards every six months. Those two guys outside were just transferred here less than three months ago.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You tell the guards later that you'll personally escort Ren home. I've already sent the car.", "Mariru")
	await novel_interface.show_dialog("The moment those guards get into the car, they'll be dealt with.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("But they have to report in regularly. If we don't want to raise suspicion, don't we need their cooperation?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix is apparently not convinced by the current escape plan.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("All the guards sent here to spy on me have received strict anti-interrogation training from the external intelligence agency.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("I don't think they'll cooperate willingly...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("The external intelligence agency?", "Ren")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Yes. It's also known as the Seven Commandments. Lebona runs it now, but it originated with the old European mafias.")
	await novel_interface.show_text_only("The agency is known for pulling impossible assassinations and its obsession for black suits.")
	await novel_interface.show_text_only("What truly made the agency legendary, however, is that it's an independent organization answerable only to the Creed of Lebona.")
	await novel_interface.show_text_only("No government controls it, and thanks to the hundreds of casinos it runs around the world, it has practically unlimited funding.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Talk about hardcore...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I've reached platinum tier in all the games based on this agency!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("So, if we were to pull the extraction plan safely, we'd not only need to rescue Nix, but also do so without them knowing.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("You don't have to worry about that.", "Mariru")
	await novel_interface.show_text_only("Mariru smiles proudly.")
	await novel_interface.show_dialog("We always have special plans for special targets.", "Mariru")
	await novel_interface.show_text_only("I can't help picturing Aya surrounded by torture tools and gleefully enjoying herself...")
	await novel_interface.show_dialog("One last check, you two. Then, you're a go!", "Mariru")
	await novel_interface.show_text_only("Mariru is over and out.")
	await novel_interface.show_text_only("The sudden silence makes me feel awkward. Nix, on the other hand, is still staring at my ample chest.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Your voice... I almost would've been fooled.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I lower my head, embarrassed.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Er... thanks...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("What're we talking about, exactly?")
	await novel_interface.show_text_only("Aya said something about an upgrade. Seems like your voice sounds more feminine now.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Why did she even bother upgrading something like that?...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix suddenly approaches, her right hand reaching behind my back.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("What are you doing...?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I feel her tug something over my clothes and instinctively let out a small sigh of relief...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Don't tell me it's the buckle of that...")
	await novel_interface.show_text_only("Before I can even figure out what just happened, her hand slips inside my clothes... and pulls out my black bra!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Ren")
	await novel_interface.show_dialog("...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Aaaaaaaah!")
	await novel_interface.show_text_only("She squeezes my bra here and there for quite some time, then looks at me doubtfully after failing to find any voice changer device.")
	await novel_interface.show_text_only("Face beet red, I grab my bra back from her and rush to the bathroom.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Are you okay, Ren? Is your stomach upset?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("If it's that time of the month, you'll find what you need in the medicine cabinet.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix sounds genuinely concerned.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("It's not that!!!", "Ren")
	await novel_interface.show_dialog("(Boo-hoo!)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Meanwhile... SID Command Room")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya is going through a pile of documents on her desk. Five windows are open, quickly changing on the big screen in front of her.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Hey...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya turns around and looks at the woman in uniform.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("There were plenty of other ways to get information out of that bumpkin...", "Aya")
	await novel_interface.show_dialog("Why did you have to send Ren? It only increases the risk. Aren't you worried she and Annie will start suspecting something?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru checks the data on her mobile device and smiles.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ren's way too excited to suspect anything while she's in Nix's bedroom.", "Mariru")
	await novel_interface.show_dialog("Besides... This was Annie's idea to begin with.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("What?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("I'm sure you remember.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("About two weeks ago, after Ren brought Sonya back from the flux area, where a Spacetime Flux occurred globally and lasted about 5 seconds.", "Mariru")
	await novel_interface.show_dialog("The signal was strong but didn't last long. Therefore, no countries were able to trace its source.", "Mariru")
	await novel_interface.show_dialog("The official story now is that a gamma-ray burst occurred near the solar system.", "Mariru")
	await novel_interface.show_dialog("While it's made up, it's true on one thing--humanity was this close to extinction.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("But, the world didn't end. So we must make sure no one connects New Opulentia to that incident.", "Mariru")
	await novel_interface.show_dialog("The SID has been tracking all news reports and communications.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("So far nothing solid has turned up, but Annie did dig up something interesting through social-media crawling.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie's gotten that good, huh? Her instructor mentioned she's been working hard in physical training too.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("She has her own reasons, that kid.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Ren, however, is a whole different story...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru pulls out a list of all the games Ren cleared recently.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Anyway, Annie found dozens of posts published on the same day Ren brought Sonya back. They're from different people who had the same weird dream during their afternoon naps.", "Mariru")
	await novel_interface.show_dialog("\"I dreamed about falling into a dark abyss and meeting my relatives who'd passed away.\"", "Mariru")
	await novel_interface.show_dialog("None of those people had many followers, so their posts didn't attract much attention.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Dreams during afternoon naps...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Wait! The Spacetime Flux happened around 4 p.m., New Opulentia time!", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Not many people take naps at that time, and fewer would post their dreams online.", "Mariru")
	await novel_interface.show_dialog("We did more analyses. All those accounts' physical addresses are inside New Opulentia--within a 5-mile radius.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya listens on, eyes bright.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("And the center of that region is Nix's villa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("So there really may be something special in that villa. When Heaven's Door opened, that thing triggered dreams in people who were asleep?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya sounds excited.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Since I wasn't sure at first, I had Annie install a Boltzmann sensor in the villa's security system.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"I want to see it.\" Aya quickly comes to Mariru, but Mariru puts her hand on Aya's face to stop her.")
	await novel_interface.show_text_only("The silver-haired girl, unfortunately, has short arms--she can't reach Mariru, her hands waving in the air.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("\"Wu wut see ut!\" (I want to see it!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("I'll let you see it after we recover the sensor. Now hurry up and finish the assignment Professor Shih gave you!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Then, Mariru walks out of the command room, staring at the satellite data she's been receiving on her device.")
	await novel_interface.show_dialog("(A burst of low frequency radio waves occurred when the foreheads of Ren and Nix touched earlier.)", "Mariru")
	await novel_interface.show_dialog("It showed the same pattern as human brainwaves during REM sleep...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Almost identical to what happened in Antarctica...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
