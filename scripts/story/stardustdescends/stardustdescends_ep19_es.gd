# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Mi hija Nasha cumple siete años este año, y últimamente le encanta arrastrarme a hacer rompecabezas con ella.", "Grabación")
	await novel_interface.show_dialog("A veces finjo a propósito que no tengo ganas o que estoy ocupado, y solo acepto \"de mala gana\" después de verla suplicarme un buen rato.", "Grabación")
	await novel_interface.show_dialog("En realidad me encanta jugar con ella... pero cuando Nasha se pone mimada, resulta demasiado adorable.", "Grabación")
	await novel_interface.show_text_only("Una carcajada del público se coló en la grabación.")
	await novel_interface.show_dialog("El rompecabezas con el que jugábamos era de un tipo nuevo, muy distinto de los que tenía cuando era niño--", "Grabación")
	await novel_interface.show_dialog("Cada pieza llevaba en un lado una pantalla de tinta electrónica a color que mostraba una imagen fija, así que a simple vista no se diferenciaba mucho de un rompecabezas tradicional.", "Grabación")
	await novel_interface.show_dialog("Pero, a medida que lo ibas completando y encajabas la última pieza, cada tesela se iluminaba y la imagen del rompecabezas empezaba a moverse...", "Grabación")
	await novel_interface.show_dialog("Todavía recuerdo la primera vez que lo vi. Al principio pensé que estábamos armando esa famosa fotografía de la Tierra llamada \"Blue Marble\"--", "Grabación")
	await novel_interface.show_dialog("Pero cuando mi hija colocó la última pieza, toda la imagen empezó a moverse: la cámara se retiró, pasando por la Luna, Marte, Júpiter...", "Grabación")
	await novel_interface.show_dialog("Luego voló fuera del sistema solar, más allá de innumerables estrellas, y finalmente reveló toda la Vía Láctea.", "Grabación")
	await novel_interface.show_dialog("Nasha saltó de emoción, gritando mientras sacudía mi brazo, tal como lo hice yo la primera vez que completé un experimento de materia heterogénea para doblar la luz...", "Grabación")
	await novel_interface.show_dialog("Creo que todos aquí hemos vivido un momento así.", "Grabación")
	await novel_interface.show_dialog("Ese día salí corriendo del laboratorio en pantuflas y pantalones de pijama, gritando hasta la oficina de un profesor de microbiología de nuestra universidad.", "Grabación")
	await novel_interface.show_dialog("El viejo me había dicho una vez que si podía realizar el experimento, abriría esa costosa botella de sake japonés que le había regalado su alumno...", "Grabación")
	await novel_interface.show_dialog("Esa bebida casi me ahoga hasta la muerte. Todavía no puedo creer que se venda por tanto.", "Grabación")
	await novel_interface.show_text_only("El público estalló en carcajadas y algunos aplaudieron.")
	await novel_interface.show_dialog("Más tarde, poco a poco llegué a comprender que el proceso de estudiar materia heterogénea se parece mucho a resolver un rompecabezas.", "Grabación")
	await novel_interface.show_dialog("Antes de que finalmente se resuelva el enigma, todo lo que puedes hacer es probar cosas basadas en la intuición y un puñado de pistas.", "Grabación")
	await novel_interface.show_dialog("Es como hacer un rompecabezas: primero encuentras las cuatro esquinas y las utilizas como axiomas, como puntos de apoyo lógicos.", "Grabación")
	await novel_interface.show_dialog("Luego, empezando por las esquinas, haces todo lo posible para cerrar el marco.", "Grabación")
	await novel_interface.show_dialog("Así como se comienza con los axiomas más básicos y gradualmente se derivan conclusiones lógicamente consistentes.", "Grabación")
	await novel_interface.show_dialog("Luego, dentro de ese marco completo, sigues haciendo intentos de prueba y error, paso a paso avanzando hacia el núcleo desconocido...", "Grabación")
	await novel_interface.show_dialog("El proceso es largo y agotador, y sólo cuando la última pieza esté colocada podremos vislumbrar la verdad del mundo.", "Grabación")
	await novel_interface.show_dialog("Durante ese tiempo, puedes dejar volar tu imaginación con anticipación, preguntándote qué tipo de magnífico panorama verás finalmente.", "Grabación")
	await novel_interface.show_dialog("Creo que esa es la parte más cautivadora de la investigación científica y la razón por la que la mayoría de nosotros perseveramos.", "Grabación")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Haga clic--")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Justo cuando los aplausos del público estaban a punto de aumentar, la grabación se cortó abruptamente.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Esta fue una grabación que Mariru encontró en la computadora de un investigador fallecido.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Supuestamente fue parte de una charla privada que Mushar dio en la 30ª Conferencia de Solvay hace más de una década~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("El que hablaba era... ¿Walid Mushar?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko estaba un poco sorprendida. Por un momento, no pudo conectar esa voz refinada y tranquila con el despiadado líder terrorista.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("La 30ª Conferencia Solvay... eso fue en 2026, ¿verdad?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta conferencia académica, fundada por el industrial belga Ernest Solvay, invitó a cada sesión a los mejores científicos del mundo de la época.")
	await novel_interface.show_text_only("Se celebraba una vez cada tres años y, aunque las guerras y los disturbios políticos provocaron que se suspendiera varias veces, continúa hasta el día de hoy.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Así es, el año antes de que comenzara la guerra...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("En aquel entonces, Mushar no podría haber imaginado que unos meses después de ese discurso, su esposa y su hija terminarían muertas en la calle debido a un ciego derramamiento de sangre étnica.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("En aquel momento, los tratados internacionales prohibían la investigación sobre materias heterogéneas, por lo que los debates en conferencias académicas como ésta sólo podían celebrarse en privado.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Pero al año siguiente todos los países se quitaron la máscara, y la mayoría de las personas que asistieron a esa conferencia ya no están vivas...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Un destello de melancolía cruzó el rostro de Aya, pero rápidamente volvió a su estado habitual.")
	await novel_interface.show_text_only("Obtuvo transmisiones en vivo de docenas de plataformas de medios diferentes en la pantalla grande y, sin excepción, todas mostraban la ceremonia de firma de Masada.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Todo parecía ir bien, sin ningún informe sobre la explosión que Emily había causado cerca del lugar antes.")
	await novel_interface.show_text_only("Una vez completado el largo proceso de firma de documentos, los representantes de Masadan y de la resistencia caminaron juntos y presionaron sus palmas contra una pantalla.")
	await novel_interface.show_text_only("Las huellas de sus palmas, junto con el texto del acuerdo, se cargaron en línea en tiempo real, y el sistema de defensa de la ciudad de Masada comenzó inmediatamente a actualizar su protocolo de defensa.")
	await novel_interface.show_text_only("Al mismo tiempo, la resistencia presentó voluntariamente archivos digitales de más de doscientos mil miembros que apoyaron el acuerdo de alto el fuego.")
	await novel_interface.show_text_only("De ahora en adelante, mientras esas personas depusieran las armas, serían libres de entrar y salir de la mayoría de las zonas de Masada como ciudadanos comunes y corrientes.")
	await novel_interface.show_text_only("El precio fue que tuvieron que usar pulseras de rastreo durante dos años y estar bajo el sistema de vigilancia de Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("Al final de la ceremonia, los dos representantes intercambiaron documentos y se dieron la mano ante los medios de comunicación.")
	await novel_interface.show_text_only("El general de división de las Fuerzas de Defensa y el líder de la resistencia se estrecharon la mano frente a las cámaras durante tres minutos.")
	await novel_interface.show_text_only("La sonrisa exagerada de Hamon estaba casi congelada en su rostro, mientras que Mushar simplemente mantuvo su sonrisa tranquila.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya miró la boca abierta en la pantalla y luego miró la información que había recopilado sobre el hombre en las redes sociales ayer.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, eh...\nNo es de extrañar que el ejército lo apodara \"Sapo\"~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al ver que Mariru aún no había regresado, Akiko se quitó las gafas y naturalmente respiró sobre las lentes.")
	await novel_interface.show_text_only("Mientras los secaba, un mechón de cabello que había sido atrapado en la sien se deslizó hacia abajo por su patilla, y su expresión y porte instantáneamente se volvieron como los de otra persona...")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Este tipo es el abanderado de la facción dura dentro de las Fuerzas de Defensa de Masada.", "Akiko")
	await novel_interface.show_dialog("Sus seguidores lo elogian como un héroe que protegió a la nación. Sus oponentes lo llaman un carnicero empapado en sangre...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya notó el cambio en el tono de Akiko y miró la imagen de su video con curiosidad manifiesta.")
	await novel_interface.show_text_only("A Akiko no pareció importarle y continuó recordando el pasado.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("En aquel entonces, Hamon siguió a su tío, el Primer Ministro Schneiderman, que entonces era teniente general en el Ejército de Restauración, y luchó en la Defensa de Masada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("¿En el que cambiaron las cosas con \"Phantom Force\" después de quedarse sin municiones y suministros?", "Aya")
	await novel_interface.show_dialog("Eso ciertamente lo califica para postularse para un cargo...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Parece que cada oficial de alto rango que participó en esa batalla y todavía está vivo ahora ocupa un puesto importante en el ejército o en el gobierno~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, que normalmente no tenía ningún interés en la política, hizo su propio juicio basándose en la información que había reunido y organizado con AI anoche.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Menos de diez de esos oficiales siguen vivos, y cada uno de ellos es un héroe de guerra que también conoce los secretos más importantes del país...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("La verdad sobre \"Phantom Force\", eh... Ciertamente han protegido bien ese secreto.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Pero hay otras razones por las que Hamon recibe tanto apoyo, ¿verdad? Escuché que las Fuerzas de Defensa habrían quebrado hace mucho tiempo si no fuera por su gestión eficiente...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("¿Gestión?\nLlámalo saqueo.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko no hizo ningún esfuerzo por ocultar su desprecio por él.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Además de eludir el derecho internacional en todas las zonas grises posibles, impuso la segregación racial en la zona militar y amplió enormemente la autoridad para disparar armas no tripuladas...", "Akiko")
	await novel_interface.show_dialog("Los oficiales de inteligencia de Palantir juzgaron que si este hombre tomara el poder, lo primero que haría sería impulsar la Ley Étnica Nacional.", "Akiko")
	await novel_interface.show_dialog("Después de todo, el Gran Rabino ya ha hecho explícito su apoyo a Hamon...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya no tenía idea de cómo responder a un tema político tan avanzado, por lo que buscó en silencio \"Ley Étnica Nacional\".")
	await novel_interface.show_text_only("Debajo apareció una avalancha de palabras clave como \"segregación racial\".")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Los humanos realmente son aburridos...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Por cierto, ¿por qué Mariru no ha vuelto todavía...\nEsa bebida estuvo muy bien, verdad?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Tranquilo, esa mujer es dura...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya abrió una botella nueva de bebida energética y tomó un sorbo. Parecía mucho más despierta al instante.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Probablemente esté agachada en el baño pensando ahora mismo...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("... ¿Estás pensando en cómo ejecutarte?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("¡¡Pensando en el plan de Famur~!!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Incluso después de reunir una montaña de información, Aya todavía no tenía idea de qué forma tomaría el inminente ataque de la resistencia.")
	await novel_interface.show_text_only("Obtuvo otra serie de imágenes de satélite cerca del Mar Muerto.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("En las imágenes meteorológicas satelitales en tiempo real, la tormenta de arena parecía un charco de agua sucia que se extendía sin sentido por la superficie de la Tierra.")
	await novel_interface.show_text_only("A estas alturas, ese charco se había tragado por completo el Gran Cañón de Mujib en la costa oriental del Mar Muerto y avanzaba hacia la Fortaleza de Masada al suroeste...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya escaneó el barrio marginal de Masada dos veces más con un satélite SID y no encontró rastros de fluctuaciones de fase espacio-temporal.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Incluso si realmente existiera algún arma de materia heterogénea capaz de bloquear ondas electromagnéticas, actualmente debería estar inactiva...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("De lo contrario, las imágenes de satélite de los barrios marginales ya se habrían deformado debido a los efectos de desviación de la luz...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Atacar la fortaleza de Masada, fuertemente defendida, sin armas de materia heterogénea?", "Akiko")
	await novel_interface.show_dialog("Incluso si las armas de defensa de la IA estuvieran 100% dañadas, eso aún sería imposible...", "Akiko")
	await novel_interface.show_dialog("Teniendo en cuenta el tamaño de los equipos de ataque que describió Lian, esos terroristas no durarían veinte minutos. No podrían poner un pie en el centro de la ciudad.", "Akiko")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Definitivamente algo anda mal...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tal como dijo Mariru, esta vez Mushar se entregó a sí mismo y a cientos de miles de camaradas de la resistencia.")
	await novel_interface.show_text_only("Si realmente fuera para lanzar un ataque, entonces, como un jugador que elige ir all-in en la mesa, estaría decidido a derrotar al oponente en esta misma ronda.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Más difícil aún, estaban operando bajo una condición implícita: no podían activar el sistema automático de represalias de Masada.")
	await novel_interface.show_text_only("Si no les importara el sistema automático de represalias, la resistencia podría simplemente seguir con su estrategia anterior y seguir exprimiendo el espacio vital de Masada.")
	await novel_interface.show_text_only("Un día, los sistemas sociales y económicos de Masada colapsarían por completo, y entonces la resistencia fácilmente podría tomar la ciudad de frente.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya miró en silencio la pantalla grande, hundiéndose en sus pensamientos mientras el tiempo pasaba segundo tras segundo...")
	await novel_interface.show_dialog("Aaaahhh no tengo ni idea!!!", "Aya")
	await novel_interface.show_text_only("Como un estudiante incapaz de resolver una pregunta de examen con una puntuación alta, Aya de repente golpeó con fuerza su frente contra el teclado de la consola, sorprendiendo a Akiko.")
	await novel_interface.show_dialog("¿Cómo se aniquila o se apodera del centro de la ciudad de Masada sin activar el sistema automático de represalias...?", "Aya")
	await novel_interface.show_text_only("Todavía hundiendo la cabeza en el teclado, Aya murmuró para sí misma.")
	await novel_interface.show_dialog("¡¡He estado pensando en este problema durante semanas y es totalmente imposible!!", "Aya")
	await novel_interface.show_dialog("...¿Durante semanas?", "Akiko")
	await novel_interface.show_dialog("...¿Por qué pasas tu tiempo libre pensando en cosas así?", "Akiko")
	await novel_interface.show_dialog("Uh--\nBueno...", "Aya")
	await novel_interface.show_text_only("Aya levantó la cabeza, con varias marcas rojas impresas en su frente por el teclado, y respondió débilmente.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("Así es como mato el tiempo cuando mi cerebro está inactivo... He estado pensando en esto desde el día en que Masada anunció el sistema de represalias automáticas.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...¡¿Eres un demonio?!", "Akiko")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Mientras tanto, afuera del lugar de la ceremonia de firma.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Mientras pasaba el tiempo, me senté acurrucada en mi asiento con las rodillas abrazadas con fuerza, esperando ansiosamente la \"orden de evacuación\" que Mariru había mencionado.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("(A las niñas realmente parece que les resulta más fácil sentarse abrazadas a sus rodillas...)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Es solo que siento un poco de frío en el trasero...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La retransmisión televisiva de la ceremonia de firma estuvo en la pantalla de la consola. Aparentemente, incluso el director pensó que el apretón de manos había durado demasiado, porque la transmisión volvió al estudio.")
	await novel_interface.show_text_only("Los presentadores en el estudio comenzaron a conversar ociosamente con su invitado, mientras yo miraba distraídamente la radio militar que Emily había puesto en mis manos la noche anterior.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_UAVs.png")
	await novel_interface.show_text_only("De repente, la transmisión en vivo cambió al exterior del lugar y el camarógrafo amplió el teleobjetivo hacia el cielo sobre el muro de aislamiento del centro de la ciudad.")
	await novel_interface.show_text_only("Las voces tanto del invitado como del reportero de campo se elevaron al mismo tiempo cuando varios grupos de drones que patrullaban por encima del muro comenzaron a descender al unísono.")
	await novel_interface.show_text_only("Según el procedimiento, los drones que patrullan a lo largo del muro de aislamiento regresan a sus atracaderos en doce lotes rotativos para actualizar sus protocolos de defensa.")
	await novel_interface.show_text_only("A medida que las armas defensivas que normalmente circulaban sobre el muro durante todo el año descendían gradualmente y desaparecían detrás de él, la reportera presente en el lugar se emocionó intensamente.")
	await novel_interface.show_text_only("Su voz temblaba al borde de las lágrimas mientras elogiaba el significado histórico del momento y seguía hablando de cómo finalmente había llegado la paz.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_APC_Wall.png")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Vamos...)\n(Esos drones van a volar de regreso después de actualizar sus protocolos, ¿no?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Y además de eso, ella era claramente de Samonton TV, una caucásica estándar de cabello rubio y ojos azules, pero parecía más emocionada que la mayoría de los reporteros locales.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Así que algunos medios realmente rompen a llorar en el acto~", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente me di cuenta. No es de extrañar que insistieran en celebrar una ceremonia de firma en el interior al amanecer, antes de que llegara la tormenta de arena.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Si esperaran más, probablemente sólo podrían filmar un cielo lleno de polvo amarillo...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily tenía razón. El movimiento de Hamon fue realmente absurdamente efectivo.")
	novel_interface.show_character("ren_medical","normal2")
	await novel_interface.show_dialog("Emily y Vera...\nDeberían estar bien, ¿verdad?", "Lian")
