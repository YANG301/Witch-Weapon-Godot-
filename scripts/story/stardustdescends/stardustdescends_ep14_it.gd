# stardustdescends_ep14.gd - 星尘降临篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep14_script()

func play_script():
	pass

func stardustdescends_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ClusterBombs.png")
	await novel_interface.show_text_only("\"Hive\" - un sistema d'arma in grado di distruggere indiscriminatamente personale e attrezzature su una vasta area.")
	await novel_interface.show_text_only("Questi droni grandi come un palmo eliminano ingombranti moduli di controllo e trasportano solo una singola granata a frammentazione autodistruttiva ciascuno.")
	await novel_interface.show_text_only("Utilizzando il riconoscimento dell’intelligenza artificiale per distinguere il personale dalle attrezzature, decine di droni possono coordinarsi tra loro e sferrare attacchi ad area in modo ancora più efficace delle bombe a grappolo.")
	await novel_interface.show_text_only("Alcuni anni fa, Masada lasciò cadere un gran numero di alveari nella valle della Bekaa, causando migliaia di vittime civili e suscitando una feroce condanna internazionale.")
	await novel_interface.show_text_only("Nonostante ciò, Masada non ha ancora firmato alcuna convenzione internazionale che abolisca questo tipo di armi...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Bum--!!")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Con un'esplosione assordante, la mitragliatrice sulla collina sud improvvisamente esplose e la tela che la ricopriva si squarciò in innumerevoli frammenti carbonizzati che si dispersero nell'aria...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Perché hanno qualcosa del genere...?\nQuesto camion non doveva trasportare forniture mediche!?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Le Forze di Difesa devono aver tranquillamente inserito alcune comparse senza dirglielo.", "Emily")
	await novel_interface.show_dialog("C'è una jeep alla stazione di rifornimento. Vera, portala lì.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Capito!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Cosa sta succedendo... ehi, aspetta--aaaah!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La donna super forte mi ha afferrato per la vita senza spiegazioni, mi ha bloccato sotto il braccio ed è corsa verso la stazione di rifornimento.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Aaaaaahhhhh--!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Si precipitò giù per il pendio a passi enormi. Se adesso la sua presa si allentasse, volerei come una piccola foca che scivola sul ghiaccio.")
	await novel_interface.show_text_only("Vera si precipitò alla stazione di rifornimento e mi gettò su una pila di sacchi di sabbia.")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Rimani nascosto qui. Aiuterò Emily a spegnere il fuoco!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Gettandosi quella corda sulle spalle, saltò sulla jeep e partì a tutta velocità...")
	await novel_interface.show_text_only("Lo sciame di droni è programmato per distruggere qualsiasi veicolo, arma o equipaggiamento circostante che non porti dispositivi di identificazione amichevoli.")
	await novel_interface.show_text_only("E un veicolo in rapido movimento è ovviamente l’obiettivo con la massima priorità.")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Tremando, mi rannicchiai dietro un muro difensivo nell'angolo della stazione di rifornimento, ascoltando il fuoco delle mitragliatrici in lontananza e un'esplosione dopo l'altra.")
	await novel_interface.show_text_only("Ogni esplosione era seguita da un crepitio di metallo che colpiva sabbia e pietra.")
	await novel_interface.show_text_only("Quelli erano chiodi d'acciaio scagliati dalle granate, abbastanza mortali da fare a pezzi una persona.")
	await novel_interface.show_text_only("Eppure il fuoco delle mitragliatrici si faceva sempre più rado, e un enorme senso di terrore cominciò a pervadermi...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Ho appoggiato un'asse sopra la barriera e mi sono accovacciato sotto come un fungo, coprendomi la testa.")
	await novel_interface.show_text_only("Si dice che durante la seconda guerra mondiale, quando le vostre mitragliatrici tacevano durante una carica, il morale veniva inferto un colpo devastante.")
	await novel_interface.show_text_only("Oggi ho capito esattamente cosa significava...")
	await novel_interface.show_text_only("Quando finalmente l'ultima mitragliatrice si calmò, gli altri suoni sul campo di battaglia si fecero spaventosamente distinti...")
	await novel_interface.show_text_only("Il ronzio di quei droni in circolo sembrava un cielo pieno di api mortali, impossibili da individuare.")
	await novel_interface.show_text_only("Sembravano essere ovunque, come la morte stessa che volteggiava sopra di me, pronta a cadere accanto a me in qualsiasi momento...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Quei due stanno bene...?)", "Lian")
	await novel_interface.show_dialog("(...Aspetta, un motore!?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Ho sbirciato e ho visto devastazione ovunque. In lontananza, la capanna dove erano state ammassate le munizioni era già avvolta dalle fiamme.")
	await novel_interface.show_text_only("La jeep di Vera stava correndo verso la stazione di rifornimento dal versante orientale, sollevando dietro di sé un enorme pennacchio di polvere.")
	await novel_interface.show_text_only("Più di una dozzina di droni gli erano alle calcagna. Non erano particolarmente veloci, ma nemmeno abbastanza lenti da poter essere scossi.")
	await novel_interface.show_text_only("Emily è scesa sul tetto e ha impugnato un M16, sparando a raffiche allo sciame, ma era difficile colpire qualcosa.")
	await novel_interface.show_text_only("Ben presto rimase senza munizioni e semplicemente scagliò il fucile verso la parte posteriore del veicolo...")
	await novel_interface.show_text_only("Un drone si è immediatamente tuffato verso il fucile scartato e si è fatto esplodere, mentre gli altri si sono arrampicati rapidamente per evitare il raggio dell'esplosione.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Dannazione!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeep rallentò accanto al muro davanti alla stazione di rifornimento. Evitando il campo visivo dei droni, Emily saltò giù dal veicolo e si schiacciò nell'angolo vicino al muro.")
	await novel_interface.show_text_only("Poi la jeep sterzò, sollevando polvere, e partì a tutta velocità verso un'altra collina vicina.")
	await novel_interface.show_text_only("Emily si accovacciò accanto all'angolo, attese che lo sciame passasse sopra di lei, poi scavalcò dolcemente il muro ed entrò.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Lian!?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("H-qui...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ho risposto a bassa voce e lei ha seguito il muro fino al riparo di assi che avevo allestito.")
	novel_interface.show_character("ren_medical","sob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","perspire",0.25)
	await novel_interface.show_dialog("Sai come scegliere un posto... ma non devi sussurrare. Quelle cose non possono sentire.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ah, sei ferito?!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ho visto diversi tagli sul braccio di Emily. Il sangue era filtrato attraverso la manica dell'uniforme, ma lei sembrava del tutto indifferente.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Non è niente. Dobbiamo tornare velocemente all'APC. La corazzatura di quel veicolo dovrebbe gestire queste cose con spazio libero.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'APC era parcheggiato lungo la strada sotto mimetica ottica, a circa due o trecento metri dalla stazione di rifornimento.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non hai portato dispositivi di identificazione amichevoli!?\nQuei droni non attaccheranno la loro stessa fazione, vero...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("D'altra parte, questi due sono qui per impossessarsi delle forniture della loro stessa fazione. È un passatempo nazionale Masadan?")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Queste cose mantengono i registri di posizione integrati. Naturalmente li abbiamo lasciati in città prima di iniziare questo lavoro.", "Emily")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Dobbiamo muoverci!\nChissà per quanto ancora Vera potrà tenerli occupati...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily mi diede un colpetto sul braccio e iniziò ad uscire dal riparo.")
	await novel_interface.show_text_only("Stavo per seguirla quando ho notato che si era bloccata sul posto. La sua voce tremò leggermente mentre diceva...")
	novel_interface.show_character("emilio","perspire")
	await novel_interface.show_dialog("Lian, corri...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sono alzato e ho guardato. Tre droni volteggiavano sopra la stazione di rifornimento, eseguendo una scansione completa a 360 gradi.")
	await novel_interface.show_text_only("All'improvviso, uno di loro si è fermato quando si è trovato di fronte alla nostra posizione, e la luce rossa sul suo corpo ha iniziato a lampeggiare...")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Corri!!!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily estrasse la pistola e sparò subito in cielo, scaricando tutti e dodici i colpi in un istante.")
	await novel_interface.show_text_only("Un drone è stato colpito da un braccio ed è caduto fuori dalla stazione di rifornimento.")
	await novel_interface.show_text_only("Un altro esplose direttamente in aria, inondando l'asse sopra le nostre teste di frammenti di metallo.")
	await novel_interface.show_text_only("Ma l'ultimo, trascinando una linea rossa nella polvere, è arrivato dritto verso di noi...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Siamo morti!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Bum--!!")
	await novel_interface.show_text_only("L'onda d'urto della granata, insieme all'aria calda e rovente, riempì istantaneamente lo spazio angusto all'interno del rifugio e strappò via l'asse sopra le nostre teste.")
	await novel_interface.show_text_only("L'aria si riempiva dell'odore acre del bruciato e dell'odore arrugginito del sangue seccato dal calore.")
	await novel_interface.show_text_only("Allo stesso tempo, una tempesta di frammenti metallici si è riversata sulla stazione di rifornimento...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Lo shock mi ha fatto perdere l'equilibrio e sono caduto a terra, e un dolore acuto mi ha lacerato la parte esterna dell'avambraccio.")
	await novel_interface.show_text_only("No, cosa ancora più importante...")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("(Sono... ancora vivo?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi sono controllato. A parte uno squarcio sull'avambraccio, ero praticamente illeso.")
	await novel_interface.show_text_only("E davanti a me, facendomi scudo, Emily sembrava aver dispiegato uno scudo fatto di sangue...")
	await novel_interface.show_text_only("Lo scudo assorbì gran parte dell'esplosione, poi evaporò in fumo rosso scuro come ghiaccio secco sotto il sole e svanì nell'aria.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Cosa hai in mano...?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Non volevo davvero che tu vedessi questo...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Lei agitò il polso. La manica che un attimo prima era macchiata di sangue rosso ora era completamente pulita.")
	novel_interface.show_character("ren_medical","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Vera e io una volta siamo entrati in contatto accidentale con una specie di materia eterogenea e in seguito abbiamo acquisito questa strana capacità.", "Emily")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Posso trasformare il mio stesso sangue in un solido più duro dell'acciaio, anche se evapora rapidamente, quindi non è molto pratico...", "Emily")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Ma sembra così bello!!", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speechless")
	await novel_interface.show_dialog("Eh?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Sembrava colta di sorpresa dalla mia reazione, poi si voltò e mi vide mentre cercavo di leccarmi il gomito. Non poteva fare a meno di sorridere e scuotere la testa.")
	await novel_interface.show_text_only("Fa un male da morire!!\nUn frammento di metallo mi ha scalfito proprio ora...")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Più del novanta per cento della popolazione di Masada è religiosa. Agli occhi di qualsiasi religione, un'abilità che manipola il sangue in questo modo sarebbe una blasfemia e una maledizione, non è vero?", "Emily")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Il potere di Vera è più pratico, anche se all'inizio era già spaventosamente forte...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeep di Vera era sul lato destro del nostro campo visivo...")
	await novel_interface.show_text_only("La donna forte l'aveva fermato sulla collina orientale, e la dozzina di droni dietro di lei l'avrebbero raggiunta nel giro di una decina di secondi...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Il motore si è spento?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera scese dal posto di guida, si avvicinò alla parte anteriore della jeep e fece un respiro profondo guardando il paraurti anteriore...")
	await novel_interface.show_text_only("Poi, con un tonfo metallico che fece tremare la valle, diede un calcio laterale alla jeep in aria.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("........................??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La jeep descrisse un grazioso arco da palla da bowling nello sciame che si era appena arrampicato sulla collina, innescando in un istante una catena di esplosioni...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("...Li ha ripuliti!?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Non festeggiare ancora. Ascoltare.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Giusto, quel ronzio esasperante non era scomparso...")
	await novel_interface.show_text_only("Mi sono voltato e ho visto uno spettacolo che mi ha fatto sprofondare il cuore...")
	await novel_interface.show_text_only("Dai piedi della collina fuori dalla stazione di rifornimento, più di trenta nuovi punti neri si stavano alzando lentamente nell'aria...")
	await novel_interface.show_text_only("Quegli spettri neri come la pece volteggiavano nel fumo, con le luci rosse lampeggianti, come se volessero spegnere ogni voglia di vivere.")
	await novel_interface.show_text_only("Questo è ciò che rende l'Alveare così terrificante. Si aggrappa a te come un dio della morte e non si lascia mai andare finché ogni bersaglio non viene completamente distrutto...")
	await novel_interface.show_text_only("Emily mi ha istintivamente trascinato dietro di sé...")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Cosa facciamo...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Mi dispiace. Ti ho trascinato in questa cosa.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ehi, ehi, non dire versi che sembrano un testamento!")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","upset",0.25)
	await novel_interface.show_dialog("Ho finito le riviste. Tra un attimo li attirerò via e tu correrai verso l'APC il più velocemente possibile. Forse...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A quella distanza, non ce la farei in alcun modo, giusto?")
	await novel_interface.show_text_only("I primi sei o sette droni si stavano già tuffando verso di noi. Ho afferrato la mano di Emily d'istinto.")
	await novel_interface.show_text_only("Il sangue del taglio sul mio avambraccio le colava sulla mano, e sembrava che entrambi avessimo percepito qualcosa allo stesso tempo...")
	await novel_interface.show_text_only("Strinse la mano destra come se stesse afferrando qualcosa, e il sangue cominciò a raccogliersi nel palmo.")
	await novel_interface.stop_music()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Questo è...??", "Emily")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostL.png")
	await novel_interface.show_text_only("Allo stesso tempo, entrambi sentivamo i nostri cuori battere come motori da corsa riempiti di azoto liquido, battendo sotto un carico vicino al limite.")
	await novel_interface.show_text_only("Mentre il nostro battito cardiaco aumentava vertiginosamente, il nostro senso del tempo si allungava all'infinito...")
	await novel_interface.show_text_only("Ogni suono intorno a noi diventava prolungato e confuso, e i droni che si tuffavano ad alta velocità sembravano farfalle che svolazzavano al rallentatore.")
	await novel_interface.show_text_only("Il sangue nel palmo di Emily si dipanava in innumerevoli fili sottili a mezz'aria, intrecciandosi automaticamente in una struttura a rete come una stampante 3D seguendo un programma preimpostato.")
	await novel_interface.show_text_only("Fissò incredula l'oggetto in formazione tra le sue mani: sembrava una spada gigante finché ero alta.")
	await novel_interface.show_text_only("Nell'istante in cui la lama finì di formarsi, eruppe con una luce rosa bruciante e brillante, ed Emily girò su se stessa e si lanciò verso l'alto nel cielo...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Nel momento in cui ha oscillato, la mia vista si è improvvisamente oscurata e lo spazio intorno a noi sembrava come se fosse stato aspirato.")
	await novel_interface.show_text_only("Dopo uno squillo penetrante, fu come se il mondo intero fosse stato messo in silenzio e tutto tacque...")
	await novel_interface.show_text_only("------")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostC.png")
	await novel_interface.show_text_only("--!!!!!!!!!!!")
	await novel_interface.show_text_only("Quando tornai in me, il vento ruggente aveva soffocato ogni altro suono.")
	await novel_interface.show_text_only("Più di trenta droni precipitavano via come foglie morte sorprese da un uragano, rotolando nell'aria e scagliandosi lontano.")
	await novel_interface.show_text_only("L'intenso urto fece esplodere le loro granate una dopo l'altra, ma le palle di fuoco e i frammenti furono spazzati via dalla corrente d'aria rovente e svanirono oltre il limite della vista.")
	await novel_interface.show_text_only("Quando la tempesta si calmò gradualmente, la grande spada nelle mani di Emily si era completamente dispersa in fumo rosso scuro.")
	await novel_interface.show_text_only("Entrambi siamo rimasti sbalorditi dalla scena davanti a noi...")
	await novel_interface.show_text_only("La stazione di rifornimento sembrava essere stata ripulita. La polvere, la sabbia e le piccole pietre che si erano accumulate furono spazzate via in un colpo solo.")
	await novel_interface.show_text_only("Alzando lo sguardo, anche la foschia della sabbia nel cielo davanti a noi era stata completamente spazzata via, e la vista chiara si estendeva fino alla valle lontana...")
