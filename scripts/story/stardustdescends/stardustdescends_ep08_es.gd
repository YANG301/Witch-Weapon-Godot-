# stardustdescends_ep08.gd - 星尘降临篇第8话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep08_script()

func play_script():
	pass

func stardustdescends_ep08_script():
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Masada0.png")
	await novel_interface.show_text_only("La Tercera Ciudad Escolar, Masadaburg.")
	await novel_interface.show_text_only("Una fortaleza militar construida en el desierto, famosa por el barro del Mar Muerto, las tormentas de arena y los ataques terroristas.")
	await novel_interface.show_text_only("Para la mayoría de la gente, cualquier noticia sobre Masadaburg significa conflicto militar o desastre humanitario.")
	await novel_interface.show_text_only("Un paisaje teñido de muerte, de sangre y arena, petróleo crudo y humo blanco, se ha cernido durante mucho tiempo sobre esta antigua tierra...")
	await novel_interface.show_text_only("¿Qué tipo de vida vive la gente allí?\nNo tengo ni idea...")
	await novel_interface.show_text_only("Sin embargo, también me resulta extrañamente familiar, como si yo mismo hubiera estado allí...")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("Suspiro──", "Lian")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Me apoyé en la barandilla de la cubierta mientras Stardust se aferraba a mí como un koala, con lágrimas aún brillando en sus ojos.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Está bien, está bien. Solo estaba bromeando──", "Lian")
	novel_interface.change_expression("wail")
	await novel_interface.show_dialog("Oye, tranquilo. Tus uñas se están clavando en mi carne...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","tear",0.25)
	await novel_interface.show_dialog("Olfatear...", "Stardust")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("¡¡¡No te limpies la nariz con mi ropa!!!", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Dejé escapar un suspiro de impotencia y le acaricié la cabeza para calmarla.")
	await novel_interface.show_text_only("Anteriormente, Aya supuso que la dirección hacia la que Stardust había señalado era Masadaburg, pero después de preguntar, resultó que la chica no tenía idea de lo que significaba el nombre de ese lugar.")
	await novel_interface.show_text_only("O mejor dicho, ni siquiera entendía el concepto de \"ciudad escolar\"...")
	await novel_interface.show_text_only("Mariru dijo que primero ordenaría la información y me dijo que esperara en cubierta hasta que ella me contactara nuevamente.")
	await novel_interface.show_text_only("Todavía no podía aceptar que esta chica fuera una ilusión que solo yo podía ver, así que aproveché la oportunidad para realizar algunas pruebas más──")
	await novel_interface.show_text_only("Primero, dejé mi teléfono en el suelo y le pedí que lo levantara.")
	await novel_interface.show_text_only("En cambio, ella simplemente me dio una sonrisa educada, inclinó la cabeza y me miró como, \"¿Eres estúpido?\".")
	await novel_interface.show_text_only("Después de unos treinta segundos de punto muerto, solo pude levantar torpemente mi propio teléfono, y luego se me ocurrió una idea aún más tonta...")
	await novel_interface.show_text_only("\"Si no tiene cuerpo físico, ¿podría atravesar las paredes?\"")
	await novel_interface.show_text_only("Entonces, mientras ella observaba, regresé a la cabina, cerré la puerta que daba a la cubierta y me escondí en su punto ciego.")
	await novel_interface.show_text_only("Dos minutos más tarde, escuché sollozos silenciosos al otro lado. Sintiendo problemas, abrí la puerta apresuradamente, ella me agarró el muslo y se negó a soltarme.")
	await novel_interface.show_text_only("Para evitar que los camareros ocasionales pasaran por la cabina, luché por arrastrarla hacia la barandilla.")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("(Con este accesorio para las piernas colocado, apenas puedo caminar...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿¡Cuidar a un niño siempre es tan agotador!?")
	await novel_interface.show_text_only("Peor aún, nadie más puede verla. En este momento debo parecer un lunático murmurando para sí mismo y moviéndose de manera extraña.")
	await novel_interface.show_text_only("Como realmente no tenía respuesta para su apego, sólo pude persuadirla suavemente.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ahí, ahí. No te dejaré atrás ~", "Lian")
	novel_interface.change_expression("gratified")
	await novel_interface.show_dialog("Ese fue mi problema hace un momento. Me disculparé, ¿vale?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dije eso mientras le hacía una mueca tonta.")
	await novel_interface.show_text_only("Si alguien me viera haciendo muecas al aire, querría arrastrarme directamente hacia una grieta en la cubierta.")
	await novel_interface.show_text_only("Stardust se calmó un poco. Aún abrazándome, levantó la vista, parpadeó con sus grandes ojos y los auriculares de su cabeza brillaron.")
	novel_interface.show_character("stardust_small","tear")
	await novel_interface.show_dialog("Entonces prométeme que irás en esa dirección conmigo, ¿vale...?", "Stardust")
	await novel_interface.show_dialog("Realmente importa...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("No estabas fingiendo llorar hace un momento, ¿verdad?")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Los niños realmente son un puñado...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No tenía idea si Mariru aprobaría que llevara a este pequeño acompañante a un lugar tan peligroso.")
	await novel_interface.show_text_only("En ese momento, la estática crujió a través de mi auricular y Mariru volvió a la línea.")
	await novel_interface.show_dialog("Lian, Annie, ¿cuánto sabéis vosotros dos sobre Masadaburg?", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Mmm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Aproximadamente...", "Annie")
	await novel_interface.show_text_only("Intenté recordarlo con todas mis fuerzas, pero incluso en el entrenamiento del agente SID la información sobre Masadaburg estaba fragmentada.")
	await novel_interface.show_dialog("La Tercera Ciudad Escolar, una ciudad fortaleza en el corazón de Asia occidental, dividida en distritos interiores y exteriores por un muro de aislamiento de decenas de metros de altura.", "Annie")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("¿Creo que fue por un conflicto étnico o religioso o algo así?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De todos modos, el distrito exterior de Masadaburg parece peligroso. ¡Parece que hay uno o dos ataques con bombas cada mes!")
	await novel_interface.show_dialog("Su agencia de inteligencia, la Oficina de la Misión de Restauración de Masada, está controlada directamente por los militares y tiene un estilo audaz y radical.", "Annie")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("Ah, lo sé. Esa agencia también se llama \"Monola\", ¿verdad?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Es un nombre que aparece en películas y juegos todo el tiempo, aunque rara vez como facción principal.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Bien, sus armas también están avanzadas. En los juegos, Masada suele ser el bando que suministra a los jugadores tanques y drones controlados remotamente...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Muy bien, eso es suficiente──", "Mariru")
	await novel_interface.show_dialog("El entorno geopolítico en esa región siempre ha sido complejo, y una vez que se le suman las fuerzas de resistencia y los grupos separatistas, se vuelve aún más caótico.", "Mariru")
	await novel_interface.show_dialog("Pero hablando sólo del \"distrito interior\" de Masadaburg, su seguridad no es peor que la de Nuevo Toyosu, así que...", "Mariru")
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("¿Eh? No me digas...\n¿Estás de acuerdo?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Todavía envuelto alrededor de mi muslo, Stardust se retorcía felizmente.")
	await novel_interface.show_dialog("Solo nosotros dos... ¿estás seguro de que estaremos bien?", "Annie")
	await novel_interface.show_text_only("Tres. ¡¡Somos tres!!\n¡¡No olvides que aquí hay equipaje extra!!")
	await novel_interface.show_dialog("Esta no es una misión de espionaje. Ni siquiera sabemos todavía nuestro destino exacto. Mientras no hagas nada escandaloso, todo estará bien.", "Mariru")
	await novel_interface.show_dialog("Además, ni siquiera necesitarás cambiar de barco. Este barco casino atracará en el puerto de Masada mañana por la mañana ~", "Aya")
	await novel_interface.show_dialog("... ¿Qué está pasando? ¿No se suponía que nos dirigíamos a Samonton?", "Annie")
	await novel_interface.show_dialog("Masada firmará un acuerdo de alto el fuego con la resistencia en tres días y, hasta que finalice la ceremonia, el Canal de Suez estará completamente sellado.", "Mariru")
	await novel_interface.show_dialog("Por la seguridad de sus pasajeros, el casino acaba de decidir seguir la \"fuerte recomendación\" del ejército de Masada y regresar a Eilat.", "Mariru")
	await novel_interface.show_dialog("Este barco se dirigirá hacia el norte a lo largo del Gran Canal entre el Mar Rojo y el Mar Muerto, atracará en el puerto de Masada y permanecerá allí hasta que se levante el bloqueo del Canal de Suez.", "Mariru")
	await novel_interface.show_dialog("La identidad encubierta de Annie es una estudiante en un programa de intercambio de arte de New Toyosu. El papeleo ya está hecho.", "Mariru")
	await novel_interface.show_dialog("En cuanto a ti, Lian──la defensa costera de Masada probablemente ya registró tu identidad encubierta, así que sigue siendo la pequeña enfermera que eres~", "Mariru")
	await novel_interface.show_text_only("Había una sonrisa en la voz de Mariru que me hizo sentir vagamente incómodo.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¡¿Eh??!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("En cualquier caso, no podrás mudarte hasta que se firme el acuerdo, así que pasa los próximos dos días haciendo turismo en la ciudad~", "Aya")
	await novel_interface.show_dialog("Si el lugar al que esa chica quiere ir resulta estar fuera de la ciudad, haré que la estación de inteligencia local envíe a alguien para que te apoye en tres días.", "Mariru")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Incluso el Canal de Suez está cerrado...", "Lian")
	await novel_interface.show_dialog("Con sólo firmar un acuerdo... ¿realmente necesitan llegar tan lejos?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_dialog("Eso es porque...", "Aya")
	await novel_interface.show_dialog("Porque las cosas ya van en serio──", "Aya")
	await novel_interface.show_dialog("Ustedes dos han estado en el barco todo este tiempo, así que aún no lo saben, ¿verdad?", "Mariru")
	await novel_interface.show_dialog("¿Q-Qué pasó...?", "Annie")
	novel_interface.change_music("res://assets/audio/music/Hard Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Hace más de diez horas se produjo una explosión con productos químicos industriales cerca de la mezquita de Ibra en Hebrón, en el territorio de Masada.", "Mariru")
	await novel_interface.show_dialog("La onda expansiva provocó el colapso parcial de los edificios cercanos y dañó los sistemas locales de energía, agua y gas.", "Mariru")
	await novel_interface.show_dialog("Según el comunicado oficial, todos los residentes de esa zona ya han sido evacuados a una zona segura.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿Otro ataque terrorista?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Debajo de la Mezquita de Ibra se encuentra la Cueva de Macpela, que se dice que es el lugar de enterramiento de los antepasados del pueblo Masadan.", "Aya")
	await novel_interface.show_dialog("Aunque desde que tomaron esa ciudad en el siglo pasado, nunca han realizado ninguna excavación arqueológica allí...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Lo extraño es que, si bien el informe oficial de víctimas es plausible, el bloqueo de información es demasiado estricto...", "Aya")
	await novel_interface.show_dialog("Ni siquiera se pueden encontrar en línea vídeos grabados por residentes cercanos. Cada página de noticias sobre este incidente utiliza fotografías y vídeos proporcionados por funcionarios de Masada.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Al mismo tiempo, los sistemas electrónicos de varios hospitales importantes de Hebrón fallaron y se perdió una gran cantidad de registros de emergencia.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Después del accidente, Masada rechazó casi de inmediato la oferta de la organización del Patrimonio Mundial de ayudar a preservar las ruinas de la Cueva de Macpela.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Ese nivel de control descarado de la información realmente suena propio de Monola... pero ¿por qué bloquearían la información?", "Annie")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Probablemente porque no quieren que la situación se vuelva aún más complicada──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("El análisis de imágenes de satélite sugiere que la explosión probablemente fue causada por un pequeño cohete.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¿La resistencia?\n¿Pero no están a punto de firmar un alto el fuego...?", "Lian")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("El líder de la resistencia inmediatamente publicó en las redes sociales que el incidente no tenía nada que ver con ellos y expresó su pesar y condena.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("En este momento el equipo de inteligencia sospecha que el ataque pudo haber sido llevado a cabo por alguna facción escindida dentro de la resistencia. Esa gente nunca ha sido un bloque unificado ~", "Aya")
	await novel_interface.show_dialog("Incluso si el líder quiere un alto el fuego, los partidarios de la línea dura interna no quieren que se llegue a un acuerdo, ¿verdad?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Quizás. Pero todo eso sigue siendo especulación. Lo que no es especulativo es que estos próximos tres días son el período más sensible que podría enfrentar la Tercera Ciudad Escolar──", "Mariru")
	await novel_interface.show_dialog("En consecuencia, el nivel de seguridad de Masada está al máximo. Estará más seguro en el distrito interior que en mar abierto.", "Mariru")
	novel_interface.change_expression("sigh")
	await novel_interface.show_dialog("Descanse lo suficiente esta noche. Nos pondremos en contacto contigo nuevamente mañana una vez que llegues al puerto.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("¡Está bien!", "Lian")
	await novel_interface.show_dialog("Lo tengo ~", "Annie")
	await novel_interface.show_text_only("Con eso, Mariru terminó la llamada con las dos personas a bordo del barco y desvió su mirada hacia la imagen de video de una mujer vestida de rojo en la pantalla grande.")
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("...Tú también crees que algo anda mal, ¿no?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Sí. Este acuerdo fue anunciado demasiado abruptamente──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("La semana pasada, un portavoz del gobierno de Masada anunció repentinamente que firmarían un acuerdo de alto el fuego con la resistencia dentro de diez días.", "Mariru")
	await novel_interface.show_dialog("Los gobiernos y los medios de comunicación de todo el mundo lo elogiaron y, de hecho, el desarme y el alto el fuego son la tendencia general.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("──Pero el acuerdo todavía parece demasiado apresurado.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Estoy de acuerdo. No parece el estilo habitual del Primer Ministro Sheinneman de actuar sólo después de una cuidadosa planificación.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("¿Será porque su condición empeoró más de lo esperado…?", "Aya")
	await novel_interface.show_dialog("Desde el último foro de paz, el Primer Ministro Sheinneman no ha mostrado su rostro en público ni una sola vez~", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Puede que esa no sea la única razón──", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Las contradicciones internas dentro de las fuerzas de defensa de Masada probablemente estén llegando al punto en que no puedan reconciliarse.", "Mariru")
	await novel_interface.show_dialog("Dado que tanto el personal como los presupuestos enfrentan fuertes recortes, es sólo cuestión de tiempo antes de que los oficiales condecorados y la facción tecnológica se destrocen entre sí.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","serious")
	await novel_interface.show_dialog("Una lucha entre la facción técnica entrenada en la academia dentro de las fuerzas de defensa y la facción del mérito de guerra que ganó distinción en el frente...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru asintió levemente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Y Masada aún no ha decidido quién firmará este acuerdo histórico en su nombre──", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Quienquiera que reclame un logro sin precedentes ante los ojos de todo el mundo probablemente ganará las próximas elecciones, ¿no es así?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("Inevitablemente...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como si de repente se diera cuenta de algo, Akiko dejó escapar un suave \"Ah\".")
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Masada no quiere que este ataque afecte la ceremonia de firma, ¿por eso insisten en que fue un accidente de explosión química...?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Je, tu apariencia cuando te sacuden es tan linda como siempre~", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("(en voz baja) ...Pervertido.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Las mejillas de Akiko se sonrojaron levemente mientras tosía dos veces.")
	novel_interface.show_character("akiko","shy")
	await novel_interface.show_dialog("Entonces, ¿ya has encontrado uno?", "Akiko")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("──El \"candidato\" correcto que mencionaste la última vez.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru negó con la cabeza.")
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Si fuera tan fácil encontrar uno, ese viejo Sheinneman no habría aguantado tanto tiempo sin jubilarse...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("A la mañana siguiente, a las 8:40 a.m.")
	await novel_interface.show_text_only("El barco casino Liberty Star, restaurante VIP.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat4.png")
	await novel_interface.show_text_only("El restaurante VIP estaba en la cubierta superior. No era grande, pero la vista era excelente.")
	await novel_interface.show_text_only("Nubes oscuras colgaban fuera de las ventanas, y la superficie del mar profundo parecía estar gestando alguna calamidad siniestra.")
	await novel_interface.show_text_only("Quizás porque la mayoría de los invitados habían quedado inconscientes por las bebidas gratis ilimitadas del casino la noche anterior, la nuestra era la única mesa ocupada en el restaurante.")
	await novel_interface.show_text_only("Miré distraídamente por la ventana. Esa extensión de agua azul oscuro era el Canal de Masada que unía el Mar Rojo y el Mar Muerto.")
	await novel_interface.show_text_only("Este canal, construido conjuntamente entre las Ciudades de Primera y Tercera Escuela mediante tecnología heteromórfica, tiene una longitud de 180 kilómetros y un desnivel de 430 metros entre sus dos extremos.")
	await novel_interface.show_text_only("Va desde el puerto de Eilat en el extremo norte del Golfo de Aqaba hasta Masadaburg en la costa suroeste del Mar Muerto.")
	await novel_interface.show_text_only("Como salvavidas de Masada, este canal ha estado acompañado de conflictos y disputas con numerosos pequeños estados vecinos desde la etapa de planificación.")
	novel_interface.show_character("anne_uniform","normal1")
	await novel_interface.show_dialog("Ésa es la última cerradura que queda por delante, ¿verdad?\nQué increíble pieza de ingeniería...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie encontró un documental sobre el canal en su teléfono y me detuvo para verlo con ella.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Sí. El gerente dijo que ya habíamos pasado tres esclusas gigantes con desniveles de más de cien metros durante la noche... Llegaremos antes del mediodía.", "Lian")
