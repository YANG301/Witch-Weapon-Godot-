# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Me siento en la esquina de la lujosa cama de Nix y escucho su historia.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Me cambian de guardia cada seis meses. Esos dos tipos de afuera fueron transferidos aquí hace menos de tres meses.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Más tarde les dices a los guardias que acompañarás personalmente a Lian a casa. Ya envié el auto.", "Mariru")
	await novel_interface.show_dialog("En el momento en que esos guardias entren al auto, se ocuparán de ellos.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Pero tienen que presentarse periódicamente. Si no queremos levantar sospechas, ¿no necesitamos su cooperación?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Al parecer, a Nix no le convence el plan de fuga actual.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Todos los guardias enviados aquí para espiarme han recibido un estricto entrenamiento antiinterrogatorio por parte de la agencia de inteligencia externa.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("No creo que cooperen voluntariamente...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("¿La agencia de inteligencia externa?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Sí. También se le conoce como los Siete Mandamientos. Lebona lo dirige ahora, pero tiene su origen en las viejas mafias europeas.")
	await novel_interface.show_text_only("La agencia es conocida por realizar asesinatos imposibles y su obsesión por los trajes negros.")
	await novel_interface.show_text_only("Sin embargo, lo que realmente hizo que la agencia fuera legendaria es que es una organización independiente que sólo responde ante el Credo de Lebona.")
	await novel_interface.show_text_only("Ningún gobierno lo controla y, gracias a los cientos de casinos que administra en todo el mundo, tiene financiación prácticamente ilimitada.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Hablando de duro...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¡He alcanzado el nivel platino en todos los juegos basados en esta agencia!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Entonces, si pudiéramos ejecutar el plan de extracción de manera segura, no solo necesitaríamos rescatar a Nix, sino también hacerlo sin que ellos lo sepan.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("No tienes que preocuparte por eso.", "Mariru")
	await novel_interface.show_text_only("Mariru sonríe con orgullo.")
	await novel_interface.show_dialog("Siempre tenemos planes especiales para objetivos especiales.", "Mariru")
	await novel_interface.show_text_only("No puedo evitar imaginarme a Aya rodeada de herramientas de tortura y divirtiéndose alegremente...")
	await novel_interface.show_dialog("Un último control, ustedes dos. Entonces, ¡estás listo!", "Mariru")
	await novel_interface.show_text_only("Mariru ha terminado y fuera.")
	await novel_interface.show_text_only("El repentino silencio me hace sentir incómodo. Nix, por otro lado, sigue mirando mi amplio pecho.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Tu voz... casi me habría engañado.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Bajo la cabeza, avergonzada.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Eh... ¿gracias...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿De qué estamos hablando exactamente?")
	await novel_interface.show_text_only("Aya dijo algo sobre una mejora. Parece que tu voz suena más femenina ahora.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(¿Por qué se molestó siquiera en actualizar algo así?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix se acerca de repente y su mano derecha se extiende detrás de mi espalda.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("¿Qué estás haciendo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La siento tirar de algo sobre mi ropa e instintivamente dejo escapar un pequeño suspiro de alivio...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("No me digas que es la hebilla de eso...")
	await novel_interface.show_text_only("Antes de que pueda darme cuenta de lo que acaba de pasar, su mano se desliza dentro de mi ropa... ¡¡y saca mi sostén negro!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("¡Aaaaaaaah!")
	await novel_interface.show_text_only("Aprieta mi sostén aquí y allá durante bastante tiempo, luego me mira dudosa después de no encontrar ningún dispositivo de cambio de voz.")
	await novel_interface.show_text_only("Con la cara roja como un tomate, le quito el sujetador y corro al baño.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("¿Estás bien, Lian? ¿Tiene malestar estomacal?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Si es esa época del mes, encontrarás lo que necesitas en el botiquín.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix parece realmente preocupado.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("¡¡¡No es eso!!!", "Lian")
	await novel_interface.show_dialog("(¡Boo-hoo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Mientras tanto... SID Sala de Mando")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya está revisando una pila de documentos sobre su escritorio. Hay cinco ventanas abiertas, que cambian rápidamente en la pantalla grande frente a ella.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Oye...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya se da vuelta y mira a la mujer de uniforme.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Había muchas otras formas de sacarle información a ese paleto...", "Aya")
	await novel_interface.show_dialog("¿Por qué tuviste que enviar a Lian? Sólo aumenta el riesgo. ¿No te preocupa que ella y Annie empiecen a sospechar algo?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru consulta los datos en su dispositivo móvil y sonríe.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Lian está demasiado emocionada para sospechar algo mientras está en la habitación de Nix.", "Mariru")
	await novel_interface.show_dialog("Además... Para empezar, esta fue idea de Annie.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("¿Qué?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Estoy seguro de que lo recuerdas.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Hace aproximadamente dos semanas, después de que Lian trajera a Sonya de regreso del área de flujo, donde ocurrió un flujo de espacio-tiempo a nivel global y duró aproximadamente 5 segundos.", "Mariru")
	await novel_interface.show_dialog("La señal fue fuerte pero no duró mucho. Por lo tanto, ningún país pudo rastrear su origen.", "Mariru")
	await novel_interface.show_dialog("La historia oficial ahora es que se produjo una explosión de rayos gamma cerca del sistema solar.", "Mariru")
	await novel_interface.show_dialog("Si bien es inventado, es cierto en una cosa: la humanidad estuvo así de cerca de la extinción.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Pero el mundo no se acabó. Por lo tanto, debemos asegurarnos de que nadie relacione a New Opulentia con ese incidente.", "Mariru")
	await novel_interface.show_dialog("El SID ha estado siguiendo todas las noticias y comunicaciones.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Hasta ahora no ha aparecido nada sólido, pero Annie descubrió algo interesante a través de las redes sociales.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie se ha vuelto así de buena, ¿eh? Su instructor mencionó que ella también ha estado trabajando duro en el entrenamiento físico.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Ella tiene sus propias razones, esa niña.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Lian, sin embargo, es una historia completamente diferente...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru saca una lista de todos los juegos que Lian completó recientemente.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("De todos modos, Annie encontró docenas de publicaciones publicadas el mismo día que Lian trajo de vuelta a Sonya. Son de diferentes personas que tuvieron el mismo sueño extraño durante sus siestas de la tarde.", "Mariru")
	await novel_interface.show_dialog("\"Soñé con caer en un oscuro abismo y encontrarme con mis familiares fallecidos\".", "Mariru")
	await novel_interface.show_dialog("Ninguna de esas personas tenía muchos seguidores, por lo que sus publicaciones no llamaban mucho la atención.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Sueños durante las siestas de la tarde...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("¡Espera! ¡El flujo del espacio-tiempo ocurrió alrededor de las 4 p. m., hora New Opulentia!", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("No mucha gente toma una siesta a esa hora y menos publican sus sueños en línea.", "Mariru")
	await novel_interface.show_dialog("Hicimos más análisis. Todas las direcciones físicas de esas cuentas están dentro de New Opulentia, dentro de un radio de 5 millas.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya escucha con los ojos brillantes.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Y el centro de esa región es la villa de Nix.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Así que realmente puede haber algo especial en esa villa. Cuando se abrió la Puerta del Cielo, ¿esa cosa provocó sueños en las personas que estaban dormidas?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya suena emocionada.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Como al principio no estaba seguro, le pedí a Annie que instalara un sensor Boltzmann en el sistema de seguridad de la villa.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("\"Quiero verlo\". Aya se acerca rápidamente a Mariru, pero Mariru pone su mano en la cara de Aya para detenerla.")
	await novel_interface.show_text_only("La chica de cabello plateado, desafortunadamente, tiene brazos cortos: no puede alcanzar a Mariru y agita las manos en el aire.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("\"¡Vaya, ya verás!\" (¡Quiero verlo!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Te dejaré verlo después de que recuperemos el sensor. ¡Ahora date prisa y termina la tarea que te asignó el profesor Shih!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Luego, Mariru sale de la sala de mando y mira los datos satelitales que ha estado recibiendo en su dispositivo.")
	await novel_interface.show_dialog("(Se produjo una explosión de ondas de radio de baja frecuencia cuando las frentes de Lian y Nix se tocaron antes).", "Mariru")
	await novel_interface.show_dialog("Mostró el mismo patrón que las ondas cerebrales humanas durante el sueño REM...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Casi idéntico a lo que pasó en la Antártida...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
