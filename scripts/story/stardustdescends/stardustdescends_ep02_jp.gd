# stardustdescends_ep02.gd - 星尘降临篇第2话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep02_script()

func play_script():
	pass

func stardustdescends_ep02_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_VillaHall.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("……にっ、200万っ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("「セレブ学校に通う庶民の少女が誤って、\n　骨董品を割ってしまう」\nそんな何かのドラマで見た嫌なシーンが\n脳内で再生される。")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("（そ、それとも……弁償のために1050年ぐらい\n　地下労働施設で働くことになるのか……？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("嗚呼……あの椅子を弁償するのにメイドカフェで\nどれくらい働かないとダメなのか……\nそんな事を心の中で計算している最中、\n不意に先輩が俺の顎を持ち上げてきた。")
	novel_interface.show_character("ren_full","sob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_full","normal1",0.25)
	await novel_interface.show_dialog("普段、学校では呆けた感じに振舞っているけど。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("先輩はこちらにゆっくりと顔を向けると、\n俺の耳に付いているイヤリングを確認する。\n色々と察したような笑みを先輩は浮かべた。")
	novel_interface.show_character("ren_full","sob")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	await novel_interface.show_dialog("ちゃんと化粧をするだけで、\nこんなにも可愛くなるなんてね……", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("──ヒィッ！！？")
	await novel_interface.show_text_only("先輩の背後を見ると、ガタイの良い黒スーツの\nボディガード二名がこちらへ向かって来ている。")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("（お、終わった……）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("「機転を生かした華麗な動きだったろ？」って、\n後でマリルにドヤ顔しようと思ってたのに、\n結局、全部ばれちゃってるじゃないか！\n\nもう……絶望的だ……")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("……そんな顔しないで？\n\nフフッ、脅かせすぎちゃいましたね。", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("何事もなかったかのように、先輩は俺の耳から\n取ったイヤホンを手のひらに隠した。\n先輩の雰囲気が一気に変わる。")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("えっ？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は気をかけるように俺の頭を撫でると\n振り返りもせず、\n背後に迫ってきたボディーガードに対して\n冷たく言い放った。")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_full","sad",0.25)
	await novel_interface.show_dialog("彼女は学校の後輩よ。\n\nここで偶然、お会いしただけですから。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("黒スーツの一人が俺の顔に対して携帯電話で\nスキャンを始める。\nスクリーンの検索結果を見て彼は頷いた。")
	await novel_interface.show_text_only("もう一人は検索結果が出ても警戒を解かず、\n俺を疑っている様子だ。\n壊れた椅子を確認するために、床に転んだ\n施教授の場所まで移動している。")
	await novel_interface.show_text_only("それを見たニュクス先輩は俺の首に腕を回し、\n額をくっつけて体温を測る素振りをした。")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_full","mock",0.25)
	await novel_interface.show_dialog("……気を引き締めなさい。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("吐息を感じる距離で、先輩は俺にそう告げた。\n口調からは緊迫の空気が伝わる。")
	novel_interface.show_character("ren_full","awkward")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("nyx_full","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（というか顔が……近すぎる！）", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("動く事も反応する事もできない状態。\n\nそんな中で浮かんでくるのは沢山の疑問だ。")
	await novel_interface.show_text_only("（なんで先輩がここに？）\n（カジノに招待されたゲストなのか？）\n（それとも情報取引のために？）\n（ターゲットは彼女と関係あるのか？）")
	await novel_interface.show_text_only("壊した椅子の歴史や値段まで詳しかった……\n\nもしかして先輩はここを良く知っているのか？")
	await novel_interface.show_text_only("ボディーガードっぽい二人は何者？\nそれに、この異様な雰囲気は……")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_text_only("先輩の目をジッと見つめると、心臓の鼓動が\n加速していくのを感じた。\nあの薄紅色の瞳に吸い込まれてしまいそうな……")
	novel_interface.change_expression("sad")
	await novel_interface.show_text_only("彼女は流し目でボディーガードを観察していたが\n突然こちらに向き直って目線を合わせてくる。\n俺は無意識に目線を下にそらし……")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("待って。\n\nこの角度から下を見ると……")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("せせ、先輩のドレスの胸元は、\nこ、こんなデザインになっているのか！")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_text_only("見え隠れするレースを見ていると、心臓の鼓動が\nさらに激しくなってしまう。\n言い表せないような熱い感情が、直接脳内に\n差し込んでくるかのようだ。")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("耳が熱くなり、そして眩暈も……")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("──レンちゃん？", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_dialog("……どうしましたか？", "ニュクス")
	await novel_interface.show_dialog("……！？\n\n貴方たち何をぼんやりしているのですか、\n早くお助けなさい。", "ニュクス")
	await novel_interface.show_dialog("まずは……私の部屋で安否の確認を。", "ニュクス")
	await novel_interface.show_text_only("…………")
	await novel_interface.show_text_only("……………………")
	novel_interface.change_music("res://assets/audio/music/Noise.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Spot.png")
	await novel_interface.show_text_only("────────────────────")
	await novel_interface.show_text_only("────ねえ？")
	await novel_interface.show_text_only("────まだ覚えている？")
	await novel_interface.show_text_only("誰だ？")
	await novel_interface.show_text_only("果てしない暗闇の中、突如として黄金に輝く光が\n周囲に虹色の輝きを纏いながら現れた。")
	await novel_interface.show_text_only("覚えて……いる？\n\n……俺が……何を？")
	await novel_interface.show_text_only("────君を待っているね……")
	await novel_interface.show_text_only("────約束の場所で……")
	await novel_interface.show_text_only("約束の……")
	await novel_interface.show_text_only("……場所？")
	await novel_interface.show_text_only("待って、君は────────")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("────────────！！")
	await novel_interface.show_text_only("…………さい。")
	await novel_interface.show_text_only("…………なさい。")
	await novel_interface.show_text_only("…………起きなさい！")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_dialog("もう……ヨダレまで垂らしてしまって。", "ニュクス")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("はぇ……？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("ウトウトと目を開けると、俺は大きくて柔らかい\nベッドの上で横になっていた。")
	await novel_interface.show_text_only("紫色のベッドで、黒いシルク製の寝具が\n高貴な輝きを放っている。")
	await novel_interface.show_text_only("傍には先輩が座っており、小動物を見るような\n目で俺を見下ろしている。")
	await novel_interface.show_text_only("気付くと枕はヨダレだらけ。\n\n両足を大きく広げた状態で、スカートが腰まで\n捲れ上がってしまっていた。")
	await novel_interface.show_text_only("俺、先輩のベッドで寝てしまったのか……")
	novel_interface.show_character("ren_full","wail")
	await novel_interface.show_dialog("（待ってくれ、先輩の……ベッド！？）", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("さっきまであの豪邸にいたはずだよな！？\n\nそれにでっかい二人のボディーガードは……")
	await novel_interface.show_text_only("急いで両足を閉じてスカートを下ろした俺は、\n膝を抱えながらベッドの端に逃げ込んだ。\n警戒の眼差しをニュクス先輩へ向ける。")
	await novel_interface.show_text_only("部屋は俺達2人以外に誰もいない。\n\n片側の壁全体には紫色の厚いカーテンが\n掛かっており、外の光を遮断している。")
	await novel_interface.show_text_only("この部屋の家具類は、先ほどの荘園で見た\nレトロな様式と違っていて、\n床には分厚いグレーの絨毯が敷かれている。")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("（さっき俺、気絶したのか？）\n\n（どのくらい経ったんだ！？）", "レン")
	novel_interface.change_expression("shy_left")
	await novel_interface.show_dialog("こ、ここはどこなんですか！？\n\nお、おれ、俺に何かしたんですか！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("震えている俺の姿を見た先輩は、微笑みながら\n立ち上がった。")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("何か……とは？", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("彼女は片膝をベッドの上に乗せると、\nこっちへ近寄ろうとしてくる。")
	novel_interface.show_character("nyx_full","mock")
	await novel_interface.show_dialog("先ほどあなたに……私が何をしたと思う？", "ニュクス")
	await novel_interface.show_dialog("ねえ……レンちゃん？", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","perspire1")
	await novel_interface.show_dialog("さ、ささささっきっ！？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("俺は顔を真っ赤にしながら布団の中に隠れた。\n\nか、かの、彼女は俺に、な、何をっ！？")
	await novel_interface.show_dialog("はぁ……そいつをからかうのも程々にな。", "マリル")
	await novel_interface.show_text_only("俺の胸元から前触れなく声が響き、\n二人共々驚かされる。")
	await novel_interface.show_dialog("では、先ほど話したプラン通りだ――", "マリル")
	await novel_interface.show_dialog("そちらの準備が整い次第、いつでも行動して\nいいぞ。", "マリル")
	await novel_interface.show_text_only("先輩はそれ以上近寄らず、好奇の目で俺の胸を\n見ながら頷いた。")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("（……行動？）", "レン")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("ちょっと待って！　二人は何の話をしてたんだ？", "レン")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("なんか俺、また売られた気がするんだけど！")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	await novel_interface.show_dialog("気絶を装っているだけと思いましたが……\nまさか本当に寝てしまっていたとは。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("先輩がリラックスし始めたので、戸惑いながら\n布団を下して警戒を解く。")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	await novel_interface.show_dialog("SIDってまさか、レンちゃんみたいな子でも\n入隊できるなんてね。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("ポンコツが妙な組織に入っており、\nすみませんでした。")
	novel_interface.show_character("ren_full","upset")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("俺……気絶しちゃってましたか？", "レン")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("記憶に残っている最後の場面を唐突に思い出す。\n\nま、まさか俺は先輩の「あれ」を見たから……")
	novel_interface.show_character("ren_full","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("（そ、そんな情けない理由で気絶なんて、\n　いくら何でもしないよな？）", "レン")
	await novel_interface.show_dialog("（お風呂に入る時いつも自分のを見てるし……）", "レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("ご安心なさい。\nここは私の部屋なだけで、まだ荘園の中よ。", "ニュクス")
	await novel_interface.show_dialog("あなたが眠っていたのは1時間ぐらいかしらね。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("その言葉に俺が返事をしようとすると、\n先輩に口を塞がれる。")
	novel_interface.show_character("ren_full","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_full","sad",0.25)
	await novel_interface.show_dialog("しっ――　ここでは大きな声は厳禁。\n\nあの二人がまだ入り口で待機しているわ。\n\n遮音効果はありますが、この部屋から絶対に\n音が漏れない訳ではありません。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("俺は言葉を呑み込み、おとなしく頷いた。")
	novel_interface.show_character("ren_full","shy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("nyx_full","smile",0.25)
	await novel_interface.show_dialog("「あなたの身体の数値が正常」とマリルさんから\n伺えて本当に良かった。\nいくら揺すっても起きないから最初は危うく\n救急車を呼ぶところでしたのよ？", "ニュクス")
	novel_interface.character_light(0.35,"upset")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("先輩は……マリルと知り合いなんですか？", "レン")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("いいえ、先ほど知り合いとなったばかりです。", "ニュクス")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("そう言いながら、先輩は自分の耳に付けていた\n骨伝導イヤホンを取り外した。")
	await novel_interface.show_dialog("全て話してやってくれ。再説明の手間が省ける。", "マリル")
	await novel_interface.show_text_only("マリルの言葉に少し躊躇を先輩が見せる。\n\nしかし、確固とした決意は持っている様子で、\n俺から目を逸らさず語り始めた。")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("幼い頃に母が死んで、記憶に母親と呼べるモノが\nほとんど無くなっていた私を──\n育てて下さったのは父でした。", "ニュクス")
	await novel_interface.show_dialog("私の父、クリストファー・ストラッツィは\nかつて第六学園都市の……\nいえ、当時はリバーナ諸島と言う名前で\n呼ばれていましたわね──", "ニュクス")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("先輩は少し話を止め、言葉を整理している。")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("喩えるなら、元老院の主席執政官のような方だと\n考えれば差支えないわ。", "ニュクス")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("へ？", "レン")
	novel_interface.change_expression("smile")
	await novel_interface.show_dialog("め、めちゃくちゃ偉い人じゃないですか！", "レン")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_LiberNa.png")
	await novel_interface.show_text_only("第六学園都市――リバーナ諸島。")
	await novel_interface.show_text_only("15年前に起きた異質物の爆発事故により、\nアンダマン海東側の陸地はわずか数十日で、\n1000以上の大小異なる島々に分裂した。")
	await novel_interface.show_text_only("大陸変異の影響は大きな波紋を呼び寄せ、\n特に分裂した島々は扱いに困る代物となった。\n周辺国の領有権が曖昧となってしまい、\n領土問題における討論の的と化したからだ。")
	await novel_interface.show_text_only("当時の国際緊張度は高く、島を強制占領\nしようものなら、\n不特定多数の国家から宣戦布告を受けても\nおかしくない状態だった。")
	await novel_interface.show_text_only("だから小競り合いはあったものの、\n結局は誰も領有するまでには漕ぎ着けなかった。\n国際貿易路にて必ず通過するこの島々は、\n一時的に領有者のいない大地となったのだ。")
	await novel_interface.show_text_only("領有ができなければ、もちろん引き渡し条約など\n適用のしようがないため、\nこの地に最初に集まってきたのは各国の犯罪者や\n脱走兵だった。")
	await novel_interface.show_text_only("リバーナ（LiberNa）と命名されたのも、\n「自由の国」（LiberNation）という理念を、\n深く刻み込んでいるからである。")
	await novel_interface.show_text_only("その後、政治支援を持たないマフィアなども、\n海洋貿易の利益を得ようと次々に上陸を開始。")
	await novel_interface.show_text_only("現在においても、リバーナの最高権力者は多数の\nマフィア組織の中から交代制で選出されている。")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
