# stardustdescends_ep07.gd - 星尘降临篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep07_script()

func play_script():
	pass

func stardustdescends_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("В этот момент мне просто хочется уйти отсюда как можно быстрее. Я сигналю Stardust и иду к лифту.")
	await novel_interface.show_text_only("Она сразу понимает мое намерение и быстро меня догоняет.")
	await novel_interface.show_text_only("Маленькая девочка, кажется, чувствует мое беспокойство, поэтому нежно потирает мое запястье.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_dialog("(шепотом) Не волнуйся.", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ощущая ее мягкую руку и температуру, я постепенно успокаиваюсь, затем держу ее за руку.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("Кажется, между нами установилась особая связь. Она начинает улыбаться.")
	await novel_interface.show_text_only("Это жутко — в конце концов, мы только что встретились.")
	await novel_interface.show_text_only("Кроме того, почему и официант, и солдаты полностью ее проигнорировали?")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("В лифте я щипаю ее нежное лицо, пытаясь во всем этом разобраться. Ей это не нравится.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("(Ее кожа меня как-то успокаивает...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Может быть, она похожа на Беатрис? У них обоих есть особая сила, о которой они даже не подозревают?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("Пока я пытаюсь разобраться во всех возможностях, лифт возвращает нас в VIP-зал.")
	await novel_interface.show_text_only("Как только дверь открывается, я понимаю, насколько все стало серьезно.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Десятки гостей и членов экипажа уже удерживают масаданские солдаты. Они были разделены на четыре группы и ждут своей очереди на досмотр.")
	await novel_interface.show_text_only("Клерк использует военный планшет, чтобы сфотографировать всех гостей, несмотря на их возражения.")
	await novel_interface.show_text_only("В номере установлена глушилка, чтобы постояльцы не могли звонить по телефону и дергать за веревочки.")
	await novel_interface.show_text_only("Мой телефон и наушник тоже не принимают никаких сигналов. Stardust напугана тем, что видит, и прячется за моей спиной.")
	await novel_interface.show_text_only("У выхода из вестибюля офицер через громкоговоритель объявляет правила проверки безопасности.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Снимите часы, украшения и любые другие металлические предметы.", "Офицер")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Наклейте идентификационный код на все свои сумки и чемоданы, а затем принесите их сюда для сканирования.", "Офицер")
	await novel_interface.show_dialog("Если все пройдет успешно, вы получите синий браслет. Отсюда могут уйти только те, у кого есть браслет.", "Офицер")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Эта проверка безопасности - не шутка...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я проверяю, есть ли у меня браслет.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Этот браслет означает, что я теперь в безопасности?)", "Лиан")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("(Я подожду и посмотрю, чтобы быть уверенным.)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я оглядываюсь вокруг. Из всех солдат на этом этаже только офицер с громкоговорителем — девушка. И, как и Эмили, она тоже очень молода.")
	await novel_interface.show_text_only("Однако все остальные солдаты, кажется, искренне уважают ее.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(Она похожа на старшеклассницу...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно какой-то здоровенный мужчина вырывается на свободу и бросается к выходу. Он кричит на женщину-офицера.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Я архиепископ Миллер из Англиканской церкви Южной Индии. Вы не имеете права задавать вопросы рабам Божьим!", "Миллер")
	await novel_interface.show_dialog("Кроме того, ваша форма... это вообще не форма Сил обороны Масады!", "Миллер")
	await novel_interface.show_dialog("Кто ты на самом деле? Кто санкционировал эту операцию?", "Миллер")
	await novel_interface.show_dialog("Я требую поговорить с вашим руководителем!", "Миллер")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Агрессивный архиепископ стоит перед девушкой, как небольшая гора.")
	novel_interface.show_character("valkyrja","normal2")
	await novel_interface.show_dialog("О, я никогда не говорил, что это униформа Сил обороны Масады. Я прапорщик Вера Валькирия, временный командир.", "Офицер")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Кто ты еще раз? Кто-нибудь из Южной Индии?\nВы что, налоговый инспектор?", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вера, кажется, что-то поняла.")
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Неудивительно, что ты такой крупный... Полагаю, это связано с территорией твоей работы.", "Вера")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Однако в прошлый раз, когда я проверял, в этом регионе шла война. Люди все еще платят налоги во время войны?", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она совершенно игнорирует покрасневшее лицо архиепископа, когда берет в руки планшет, который протягивает ей клерк.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Ну-ну-ну... Кто бы мог подумать. У вас есть виза религиозного работника.", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вера презрительно смеется, затем смотрит на рулетку.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Слуга Божий. Понятно... У кого-то вроде тебя есть время и средства, чтобы съесть всю вкусную еду. Вы весело провели время в казино?", "Вера")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("И тут я подумал: «Бог не играет в кости».", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("Это богохульство!", "Миллер")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Архиепископ больше не может этого терпеть. Он начинает кричать, приближаясь к Вере, готовый к физической атаке. Но прежде чем он успевает добраться до Веры, она хватает его за воротник.")
	await novel_interface.show_text_only("Я в шоке от того, что вижу.")
	await novel_interface.show_text_only("Одной рукой Вера поднимает тяжеловесного архиепископа в воздух.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Какая сила!)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("На случай, если ты не услышал меня в первый раз...", "Вера")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Я не солдат. Я курсант «Программы Тальпиот», которого направили сюда в последнюю минуту.", "Вера")
	await novel_interface.show_dialog("Я не хочу всего этого, но люди в Комитете по вооруженным силам думают, что могут нами командовать.", "Вера")
	await novel_interface.show_dialog("И они могут! Я злился на это в эти дни. Если ты еще раз перейдешь мне дорогу, я брошу тебя в океан и скормлю акулам!", "Вера")
	await novel_interface.show_dialog("Нам ясно?!", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Лицо архиепископа побагровело. Не в силах говорить, он поспешно кивает головой.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Вернитесь в свою линию!", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Как только он отпускается, архиепископ бросается обратно на свою линию, переводя дыхание.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Э, извини...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я осторожно подхожу ближе и показываю ей свой браслет.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("У меня уже есть браслет. Могу ли я уйти сейчас?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вера немного удивлена. Она сканирует штрих-код на моем браслете и улыбается.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Да, ты можешь уйти.", "Вера")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я чувствую облегчение. Я также рад, что никто на этом этаже тоже не видит Stardust.")
	await novel_interface.show_text_only("Как только я выхожу из комнаты, подходит сотрудник казино, чтобы извиниться.")
	await novel_interface.show_text_only("По его словам, Лебона проведет переговоры с Масадой, чтобы исключить утечку информации о клиентах.")
	await novel_interface.show_text_only("Сигналы во всей кабине заглушены. Он говорит мне, что если мне нужно позвонить, я могу воспользоваться их стационарной линией или пойти на кормовую палубу.")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("Я тащу Stardust и иду до палубы.")
	await novel_interface.show_text_only("Рядом с игорным кораблем пришвартован патрульный катер «Супер Двора Мк», на катере висит сине-белый национальный флаг.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Наконец-то свежий воздух!", "Лиан")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(Ведь все окна внутри казино закрыты.)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я вытягиваю руки, глядя на мост через канал.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Это Суэцкий канал?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Ого!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust взволнован больше, чем я. Она прыгает до самого забора корабля.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Это просто совпадение? Stardust направляется к корме корабля.)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Внезапно у меня звонит телефон — меня ждет знакомый голос.")
	await novel_interface.show_dialog("Лиан? Ты в порядке?", "Энни")
	await novel_interface.show_dialog("Она в порядке. Она делает растяжку лицом к океану.", "Мариру")
	await novel_interface.show_dialog("Ах, этот сладкий запах молодости! Это ваш способ получить еще большую пару?", "Ая")
	await novel_interface.show_text_only("Оказывается, это конференц-связь — Мариру и еще несколько человек тоже на линии…")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("Они шпионят за мной?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я оглядываюсь вокруг и не замечаю ни одного устройства наблюдения. Потом я понимаю, что это, вероятно, откуда-то сверху.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("(Мне кажется странным осознавать, что пара глаз наблюдает за каждым моим движением...)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Давайте перейдем к делу: что произошло раньше?", "Мариру")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("С чего мне начать?...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я откашливаюсь и рассказываю им все, что произошло. Я специально отмечаю, что Stardust никто не видит.")
	await novel_interface.show_dialog("Она рядом с тобой? Судя по тому, что мы видели, вы вышли из вестибюля сами...", "Энни")
	await novel_interface.show_dialog("Мне было интересно, как ты так быстро прошел проверку безопасности — ты был первым, кто вышел!", "Энни")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Это второй лейтенант, которого я встретил в хранилище. Она отсканировала мое поддельное удостоверение личности, а затем дала мне браслет.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Масаданским солдатам не следовало быть такими беспечными...", "Мариру")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("О, еще одна вещь. И командир в вестибюле, и подпоручик в хранилище — молодые девушки, не старше 20 лет.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Что? Я знаю, что в Масаде женщины тоже подлежат обязательной военной службе, но уже в таком возрасте?", "Энни")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Офицер в вестибюле упомянул, что она была курсантом «Программы Тальпиот». Ее назначили сюда в последнюю минуту.", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Это объясняет...", "Мариру")
	await novel_interface.show_dialog("Тальпиот на протяжении десятилетий был элитной военной академией, подчинявшейся непосредственно Генеральному штабу Масады.", "Мариру")
	await novel_interface.show_dialog("Позже вооруженные силы Масадана расширили ее до «Программы Тальпиот». Он приглашает попробовать себя только один процент лучших учеников средних и военных училищ.", "Мариру")
	await novel_interface.show_dialog("Ежегодно лишь несколько десятков кандидатов проходят изнурительный психологический, физический тест и проверку IQ.", "Мариру")
	await novel_interface.show_dialog("Это канал подготовки будущей военной элиты, и его учебная программа включает даже небольшие полевые операции.", "Мариру")
	await novel_interface.show_dialog("Монола приняла на работу множество выпускников «Программы Тальпиот». Они известны своим профессионализмом и лояльностью.", "Мариру")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Элитное военное училище, да?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Я не думаю, что мы с Лианом сможем войти...", "Энни")
	await novel_interface.show_dialog("Бедный Лиан...", "Ая")
	await novel_interface.show_text_only("Ая не решается закончить предложение.")
	await novel_interface.show_dialog("Девушка, о которой ты говорил. Она сейчас с тобой на палубе?", "Ая")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Да. Почему?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Но даже термодатчик показывает, что ты на палубе один...", "Ая")
	await novel_interface.show_text_only("Теперь даже я не могу быть уверен, но вот она, сидит на корточках перед забором и смотрит в одну сторону.")
	await novel_interface.show_text_only("Внезапно она встает и указывает мне в том направлении, куда смотрела.")
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Мы... пойдем туда!", "Stardust")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("Не могу вспомнить почему, но что-то мне подсказывает, что мы идем именно туда.", "Stardust")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Иначе... Иначе будет катастрофа...", "Stardust")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Пожалуйста! Мы пойдем вместе, пожалуйста!", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust хватает меня за голову и смотрит на меня своими большими глазами, словно маленький ребенок, выпрашивающий у мамы игрушки.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ты... слышал, что она мне сейчас сказала?", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Я только слышал тебя...", "Энни")
	await novel_interface.show_dialog("Звук производится за счет вибрации голосовых связок. Если нет физического тела, не может быть и звука.", "Ая")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Но... Но я могу видеть ее, прикасаться к ней и чувствовать температуру ее тела...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Судя по тому, что вы описали, возможно, на ваш мозг что-то повлияло. И после этого он посылает вам нейронную обратную связь, которую можете воспринимать только вы.", "Ая")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Но я даже вижу ее тень!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я пытаюсь спорить, не в силах принять ее объяснение.")
