# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("A julgar pelas imagens do monitor do veículo, logo à frente havia um trecho do muro de isolamento ainda em construção.")
	await novel_interface.show_text_only("Por estar nos limites do centro da cidade, não tinha nada da sensação próspera e pacífica do distrito central...")
	await novel_interface.show_text_only("Aço, concreto e poeira restauraram a textura áspera e crua de uma zona de guerra no deserto.")
	await novel_interface.show_text_only("O posto de controle à frente foi construído como uma fortaleza e vários veículos blindados do mesmo modelo estavam estacionados ao redor dele.")
	await novel_interface.show_text_only("Ao longe, muitos guindastes de torre e máquinas pesadas trabalhavam, e além da parede era possível ver vagamente enxames de drones no céu.")
	await novel_interface.show_text_only("Pela forma como as barricadas de metal estavam dispostas, a saída à frente parecia claramente fechada ao tráfego.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Você pretende... forçar a passagem?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily bateu os nós dos dedos na parede interna do APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Com isso?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("A armadura é resistente, mas conduz calor como o metal comum. Provavelmente duraríamos cerca de vinte segundos antes de sermos assados vivos~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente o veículo parou. Uma voz familiar veio da cabine do motorista—")
	await novel_interface.show_dialog("Vera Valquíria, suboficial de primeira classe do Batalhão Caracal, recolhendo pessoal do acampamento para reconhecimento fora da cidade.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Essa é a segurança super forte do navio cassino, não é?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu ainda me lembrava vividamente dela levantando aquele enorme bispo-chefe com uma mão.")
	await novel_interface.show_dialog("Ah, é a Vera. Há um protesto acontecendo no Mercado Yehuda neste momento. Se você não quer se atolar, é melhor pegar outra saída...", "Voz masculina")
	await novel_interface.show_dialog("Pare de falar e deixe-nos passar já. Não temos tempo para desvios!", "Vera")
	await novel_interface.show_dialog("Haha, tudo bem, tudo bem. Só não cause mais problemas. Da última vez, o seu velho telefonou do quartel-general do Estado-Maior só para repreender as pessoas...", "Voz masculina")
	await novel_interface.show_dialog("Mencione-o novamente e eu atropelarei você.", "Vera")
	await novel_interface.show_dialog("Mova o obstáculo. Deixe-os passar, deixe-os passar!", "Voz masculina")
	await novel_interface.show_text_only("Emily se inclinou e sussurrou para mim.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Então, você teve aquele breve momento em que pensou em gritar por socorro... e depois se acovardou?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Claro que não!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu rapidamente virei minha cabeça. Ugh, ela é tão desagradável!")
	await novel_interface.show_text_only("O veículo avançou lentamente e logo atravessou o muro de isolamento até a periferia da cidade de Massada.")
	await novel_interface.show_text_only("Eu presumi que a cidade exterior seria ainda mais desolada, mas depois que cruzamos o muro de isolamento, o número de pessoas na estrada aumentou de repente.")
	await novel_interface.show_text_only("As estradas eram mais acidentadas aqui e havia menos arranha-céus e cinturões verdes, mas as ruas estavam inesperadamente animadas.")
	await novel_interface.show_text_only("As multidões, os ônibus indo e voltando e os vendedores ambulantes vendendo mercadorias me fizeram sentir como se tivesse viajado no tempo.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Tem tanta gente aqui...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Claro. Noventa por cento da população desta cidade vive fora do muro de isolamento.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tantos!?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("O centro da cidade tem apenas 32 quilômetros quadrados no total, menos de um quarto da área total de Massada, e os preços dos terrenos são exorbitantes.", "Emily")
	await novel_interface.show_dialog("Especialmente no distrito central. A área de um único banheiro seria suficiente para comprar um apartamento à beira do Mar Morto.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Achei que o muro de isolamento era para isso... sabe...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Segregação racial?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Certo, certo. Não existe alguma regra segundo a qual certas palavras ofensivas a um grupo específico só podem ser ditas pelas próprias pessoas desse grupo...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("O Conselho Unido proibiu esse tipo de coisa há muito tempo ~", "Emily")
	await novel_interface.show_dialog("Mas a Lei Anti-Terrorismo de Masada diz que se quiser residir por um longo período no centro da cidade onde o governo e o parlamento estão localizados, terá de passar por uma revisão do Departamento de Segurança.", "Emily")
	await novel_interface.show_dialog("E os candidatos cuja família imediata pertence a determinados grupos étnicos nunca são aprovados... entendeu?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Assenti, apenas parcialmente entendendo.")
	await novel_interface.show_text_only("Então isso é segregação!\nMesmo que pareça que eles estão se segregando...")
	await novel_interface.show_text_only("E se isso for verdade, então mesmo a maioria dos massadanos étnicos também devem viver na periferia da cidade, certo?")
	await novel_interface.show_text_only("Na tela, vi uma mulher soldado com uma M16 pendurada no ombro, agachada em frente a uma barraca de rua que vendia enfeites de cabelo, pechinchando com uma vendedora cujo rosto estava enrolado em um lenço na cabeça.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Acontece que ninguém pode pagar por moradia, não importa de onde venha...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("De repente, o veículo freou bruscamente. Minha cabeça quase bateu na tela e os palavrões de Vera ecoaram na cabine do motorista.")
	await novel_interface.show_dialog("Droga!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("O que aconteceu!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Lancei um drone escoteiro. Basta observar a tela você mesmo.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily e eu corremos até a vitrine e vimos uma cena que me fez arrepiar...")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Mais de mil homens de casacos e chapéus pretos estavam reunidos no cruzamento à frente, como num enorme funeral.")
	await novel_interface.show_text_only("Eles seguravam cartazes de protesto feitos em preto e branco, como se se opusessem à existência de quaisquer outras cores no mundo.")
	await novel_interface.show_text_only("A maioria deles tinha barbas enormes e pequenas tranças estranhas nas têmporas. Aquele olhar parecia terrivelmente familiar...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Essas porcarias inúteis! Eles vivem de subsídios estatais e ainda protestam todos os dias!", "Vera")
	await novel_interface.show_text_only("Vamos supor que \"bleep\" seja algum tipo de dialeto... eu não conseguia entender de qualquer maneira.")
	await novel_interface.show_dialog("Eles querem que o número de escolas primárias que correspondam à sua doutrina seja duplicado?\nEsses malditos cachos laterais cresceram em seus cérebros!?", "Vera")
	await novel_interface.show_text_only("Ouvi chutes na porta da cabine. Aparentemente, nosso motorista saltou para começar uma briga.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("O que ela está fazendo?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","mock",0.25)
	await novel_interface.show_dialog("Vou cobrir os pratos~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily respondeu distraidamente enquanto verificava o mapa de rotas em seu robusto tablet militar.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","mock",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("O-O que ela vai fazer...? Essas pessoas são Masadans, não são?\nAcho que vi alguns deles no museu agora há pouco...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Eles são o \"patrimônio histórico\" de Massada. Eles não trabalham, não pagam impostos, não servem nas forças armadas e o governo ainda tem de lhes dar subsídios mensais.", "Emily")
	await novel_interface.show_dialog("Mesmo que perturbem a ordem pública e bloqueiem o trânsito, a polícia e o exército não podem tocá-los, porque têm os seus próprios tribunais religiosos.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Isso é tão bom?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Isso não significaria que você poderia simplesmente ficar em casa e jogar todos os dias...)", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Mas a doutrina deles diz que não pode haver TVs ou computadores em casa, e o acesso à Internet é estritamente proibido.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Isso é tortura!!")
	novel_interface.show_character("ren_medical","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","speechless",0.25)
	await novel_interface.show_dialog("Mas suas esposas são diferentes. Eles podem usar dispositivos eletrônicos porque esses homens dependem das mulheres para ganhar dinheiro e ajudar no sustento da família.", "Emily")
	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Não é porque os subsídios sejam muito pequenos. É porque as mulheres nessas famílias têm em média seis ou sete filhos, e algumas têm mais de uma dúzia.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Tantas crianças. Não admira que as escolas religiosas não sejam suficientes...", "Emily")
	novel_interface.character_light(0.35,"bored")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Será que as dez crianças que vi reunidas em torno daqueles dois homens barbudos e vestidos de preto no museu poderiam ter sido...)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("E as duas mulheres abatidas seguindo atrás deles...")
	await novel_interface.show_text_only("Quando pensei no carrinho que um deles estava empurrando, um arrepio percorreu minhas costas.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Os fundamentalistas religiosos são um câncer, não importa onde você vá...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily continuou mexendo em seu tablet com a cabeça baixa, seu tom carregando uma estranha tristeza e uma pitada de resignação.")
	await novel_interface.show_text_only("Em pouco tempo, Vera voltou para o veículo e Emily deu um tapinha na divisória de metal da cabine para lembrá-la.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Dê a volta até a terceira interseção no lado leste. Há um viaduto recém-concluído lá. É o caminho mais rápido para sair da cidade.", "Emily")
	await novel_interface.show_dialog("E também, se você for fazer “isso”, lembre-se de virar o veículo primeiro.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Entendi ~", "Vera")
	await novel_interface.show_text_only("Vera girou o volante até o limite e pisou no acelerador, girando a dianteira de uma só vez, sem a menor preocupação com o conforto do passageiro.")
	await novel_interface.show_text_only("Um momento depois, ouviram-se quatro baques surdos vindos do teto do veículo: baque, baque, baque, baque.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Espere, por que isso soou como um lançador de granadas...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Muito em breve, os homens de preto reunidos começaram a entrar em pânico, enquanto nuvens de fumaça branca de gás lacrimogêneo irrompiam de quatro pontos diferentes na multidão...")
	await novel_interface.show_text_only("E nosso veículo pisou fundo e desapareceu na esquina.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("À medida que a sombra do muro de isolamento diminuía atrás de mim, a terra em ambos os lados da estrada tornou-se gradualmente árida.")
	await novel_interface.show_text_only("Depois de ficar tanto tempo na cidade, foi fácil esquecer que Masadaburg era uma cidade abrupta construída no deserto.")
	await novel_interface.show_text_only("O APC acelerava por uma estrada vazia e não havia sinal de vida humana em nenhum lugar ao lado da estrada solitária.")
	await novel_interface.show_text_only("Apenas alguns arbustos secos ainda permaneciam teimosamente na areia...")
	novel_interface.change_music("res://assets/audio/music/unkown/Battle_08.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Depois de mais ou menos uma hora fora da cidade, a porta do compartimento de tropas se abriu lentamente e um posto de abastecimento militar apareceu diante de mim.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("É isso. Quer fazer com que ela ajude?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("Hein?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Não há problema. Ela vai cooperar.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Você nem está preocupado que eu fuja--", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Protestei enquanto saía do veículo muito obedientemente, mas engoli o resto no meio do caminho.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(É um deserto vazio em todas as direções. Para onde exatamente eu correria...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Esta estação de abastecimento submersa estava escondida nas dunas. De longe, parecia apenas mais um monte de terra nua em uma colina árida.")
	await novel_interface.show_text_only("Ainda assim, claramente estava abandonado há muito tempo...")
	await novel_interface.show_text_only("Provavelmente porque um local como este custa muito para manter e porque a resistência já havia desistido do entorno.")
	await novel_interface.show_text_only("O jipe estacionado dentro da estação estava coberto por uma espessa camada de poeira, e enormes pilhas de sacos de areia destinados à construção de fortificações estavam empilhados descuidadamente por toda parte.")
	await novel_interface.show_text_only("A empilhadeira e o gerador encostados na parede estavam cobertos de ferrugem e cicatrizes deixadas pelo vento e pela areia. Algumas caixas de munição viradas também estavam no canto...")
	await novel_interface.show_text_only("De volta ao veículo, Emily respondeu à minha segunda pergunta: qual era exatamente o “assunto pessoal” que eles estavam aqui para fazer.")
	await novel_interface.show_text_only("Na verdade, eu já tinha adivinhado parte disso. Tinha a ver com minha identidade falsa...")
	await novel_interface.show_text_only("Segundo Emily, isso viola as convenções internacionais para ONGs em zonas de guerra transportarem qualquer tipo de suprimentos militares.")
	await novel_interface.show_text_only("Obter isenções de ambos os lados em nome da ajuda a civis inocentes, apenas para depois ajudar um lado, é uma grave violação da ética.")
	await novel_interface.show_text_only("Mas, nos últimos anos, os militares de Masadan disfarçaram muitos postos militares avançados como instalações de ajuda civil e subornaram ONG para transportarem abastecimentos para eles.")
	await novel_interface.show_text_only("Dessa forma, podem deter de forma mais flexível a resistência da guerrilha e, sempre que um desses postos avançados for destruído, podem denunciá-lo em voz alta como um ataque terrorista contra inocentes.")
	await novel_interface.show_text_only("O que eles estavam aqui para fazer era sequestrar esse tipo de oferta do mercado paralelo.")
	await novel_interface.show_text_only("Usando o código de emergência em meu crachá, Emily encontrou informações sobre o veículo mais adequado para o alvo.")
	await novel_interface.show_text_only("Essa função foi originalmente concebida para localizar e solicitar suprimentos de ajuda humanitária da ONG mais próxima em caso de emergência.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("O caminhão transporta principalmente suprimentos médicos militares. Passará por aqui na rodovia em quarenta minutos.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Vou montar barreiras e minas. Vocês dois preparem as metralhadoras e os alto-falantes.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy")
	await novel_interface.show_dialog("...Alto-falantes?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Minha mão se moveu para o meu peito por reflexo.")
	await novel_interface.show_text_only("Vera retirou as capas protetoras dos equipamentos do veículo, uma por uma. Eu estava me preparando, mas ainda assim me assustou...")
	await novel_interface.show_text_only("Um grande robô de carga quadrúpede, duas fileiras de bloqueios de estradas controlados remotamente, seis metralhadoras com mira automática, quatro alto-falantes e um monte de pequenas bombas remotas...")
	await novel_interface.show_text_only("...O que diabos eles estavam planejando fazer!?")
	await novel_interface.show_text_only("Emily e eu rapidamente usamos a capacidade de carga do robô de carga para posicionar as metralhadoras e os alto-falantes nas colinas próximas.")
	await novel_interface.show_text_only("Depois de colocar os bloqueios e as bombas, Vera seguiu as instruções de Emily, abasteceu um jipe ​​com gasolina e dirigiu-o para trás de uma pedra gigante à beira da estrada.")
	await novel_interface.show_text_only("Então eles lançaram o drone de reconhecimento do topo do APC e esconderam o veículo perfeitamente sob uma cobertura de camuflagem óptica.")
	await novel_interface.show_text_only("Por fim, nós três nos agachamos atrás da colina mais alta e esperamos em silêncio que o alvo aparecesse.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Você realmente garante que ninguém vai se machucar...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu perguntei desconfortável. As armas que acabamos de montar pareciam suficientes para destruir um pelotão inteiro.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Relaxe. Este é um plano de Emily--", "Vera")
	await novel_interface.show_dialog("Todos no nosso batalhão sabem que se esse for o plano dela, tudo bem!", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Essas metralhadoras usam mira infravermelha controlada por IA. Eles absolutamente não vão atingir as pessoas.", "Emily")
	await novel_interface.show_dialog("E as bombas remotas também foram modificadas. Basicamente eles não têm muito poder de matar. Alguns são principalmente para fazer barulho, e outros apenas expelem toneladas de fumaça...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Ah, o caminhão está chegando!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O feed do drone batedor mostrou um caminhão com o logotipo vermelho da organização de ajuda médica dirigindo pela rodovia.")
	await novel_interface.show_text_only("Quando chegou ao trecho próximo ao posto de abastecimento, uma bomba explodiu e a primeira fileira de barreiras surgiu em um ângulo que sacudiu o caminhão.")
	await novel_interface.show_text_only("O caminhão diminuiu a velocidade. Pensando que um pneu havia estourado, o motorista saiu correndo para verificar.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Agora!", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ao comando do tenente, o show de fogos de artifício cuidadosamente organizado começou...")
	await novel_interface.show_text_only("A segunda fileira de bloqueios de estrada se ergueu e travou as rodas dianteiras do caminhão, e as metralhadoras no topo das colinas começaram a disparar em sequência.")
