# stardustdescends_ep03.gd - 星尘降临篇第3话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep03_script()

func play_script():
	pass

func stardustdescends_ep03_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	await novel_interface.show_text_only("Ich sitze an der Ecke von Nix‘ luxuriösem Bett und höre ihrer Geschichte zu.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Sie wechseln meine Wachen alle sechs Monate. Die beiden Typen da draußen wurden erst vor weniger als drei Monaten hierher versetzt.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Sie teilen den Wachen später mit, dass Sie Lian persönlich nach Hause begleiten werden. Ich habe das Auto bereits verschickt.", "Mariru")
	await novel_interface.show_dialog("Sobald diese Wachen ins Auto steigen, werden sie erledigt.", "Mariru")
	novel_interface.show_character("nyx_full","sad")
	await novel_interface.show_dialog("Sie müssen sich aber regelmäßig melden. Wenn wir keinen Verdacht erregen wollen, brauchen wir dann nicht ihre Mitarbeit?", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix ist von dem aktuellen Fluchtplan offenbar nicht überzeugt.")
	novel_interface.show_character("nyx_full","normal1")
	await novel_interface.show_dialog("Alle Wachen, die hierher geschickt wurden, um mich auszuspionieren, haben vom externen Geheimdienst eine strenge Anti-Verhör-Schulung erhalten.", "Nix")
	novel_interface.change_expression("sad")
	await novel_interface.show_dialog("Ich glaube nicht, dass sie bereitwillig kooperieren werden ...", "Nix")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Der externe Geheimdienst?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Commandments.png")
	await novel_interface.show_text_only("Ja. Es ist auch als die Sieben Gebote bekannt. Lebona leitet es jetzt, aber es hat seinen Ursprung bei den alten europäischen Mafias.")
	await novel_interface.show_text_only("Die Agentur ist dafür bekannt, unmögliche Attentate zu verüben und eine Vorliebe für schwarze Anzüge zu haben.")
	await novel_interface.show_text_only("Was die Agentur jedoch wirklich legendär machte, ist, dass es sich um eine unabhängige Organisation handelt, die nur dem Glaubensbekenntnis von Lebona verpflichtet ist.")
	await novel_interface.show_text_only("Keine Regierung kontrolliert es und dank der Hunderten von Casinos, die es auf der ganzen Welt betreibt, verfügt es über praktisch unbegrenzte Mittel.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_NoxRoom.png")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("(Apropos Hardcore...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich habe in allen Spielen, die auf dieser Agentur basieren, die Platin-Stufe erreicht!")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Wenn wir also den Extraktionsplan sicher umsetzen wollten, müssten wir nicht nur Nix retten, sondern dies auch tun, ohne dass sie es merken.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Darüber müssen Sie sich keine Sorgen machen.", "Mariru")
	await novel_interface.show_text_only("Mariru lächelt stolz.")
	await novel_interface.show_dialog("Wir haben immer besondere Pläne für besondere Ziele.", "Mariru")
	await novel_interface.show_text_only("Ich kann nicht umhin, mir Aya vorzustellen, die von Folterwerkzeugen umgeben ist und sich vergnügt vergnügt ...")
	await novel_interface.show_dialog("Ein letzter Check, ihr zwei. Dann kann es losgehen!", "Mariru")
	await novel_interface.show_text_only("Mariru ist vorbei und raus.")
	await novel_interface.show_text_only("Die plötzliche Stille macht mich unbehaglich. Nix hingegen starrt immer noch auf meine üppige Brust.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Deine Stimme... ich hätte mich fast täuschen lassen.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich senke verlegen den Kopf.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("Ähm... danke...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Worüber reden wir genau?")
	await novel_interface.show_text_only("Aya sagte etwas über ein Upgrade. Scheint, als ob deine Stimme jetzt weiblicher klingt.")
	novel_interface.show_character("ren_full","shy_right")
	await novel_interface.show_dialog("(Warum hat sie sich überhaupt die Mühe gemacht, so etwas zu verbessern?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich nähert sich Nix, ihre rechte Hand greift hinter meinen Rücken.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Was machst du...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich spüre, wie sie etwas über meine Kleidung zieht und instinktiv einen kleinen Seufzer der Erleichterung ausstößt ...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("!!!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sagen Sie mir nicht, dass es an der Schnalle liegt...")
	await novel_interface.show_text_only("Bevor ich überhaupt begreifen kann, was gerade passiert ist, schlüpft ihre Hand in meine Kleidung ... und zieht meinen schwarzen BH heraus!!")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.show_dialog("...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Aaaaaaaah!")
	await novel_interface.show_text_only("Sie drückt hier und da eine ganze Weile meinen BH und schaut mich dann zweifelnd an, nachdem sie kein Gerät zur Sprachveränderung gefunden hat.")
	await novel_interface.show_text_only("Mit rotem Gesicht nehme ich ihr meinen BH weg und renne ins Badezimmer.")
	novel_interface.show_character("nyx_full","smile")
	await novel_interface.show_dialog("Geht es dir gut, Lian? Haben Sie Magenbeschwerden?", "Nix")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Wenn es diese Zeit im Monat ist, finden Sie alles, was Sie brauchen, im Medikamentenschrank.", "Nix")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nix klingt wirklich besorgt.")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Das ist es nicht!!!", "Lian")
	await novel_interface.show_dialog("(Boo-hoo!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background_with_fade()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("In der Zwischenzeit... SID Kommandoraum")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya geht einen Stapel Dokumente auf ihrem Schreibtisch durch. Fünf Fenster sind geöffnet und die große Leinwand vor ihr verändert sich schnell.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Hey...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya dreht sich um und sieht die Frau in Uniform an.")
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Es gab viele andere Möglichkeiten, Informationen aus diesem Trottel herauszuholen ...", "Aya")
	await novel_interface.show_dialog("Warum musstest du Lian schicken? Es erhöht nur das Risiko. Befürchten Sie nicht, dass sie und Annie einen Verdacht hegen?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru überprüft die Daten auf ihrem Mobilgerät und lächelt.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Lian ist viel zu aufgeregt, um irgendetwas zu ahnen, während sie in Nix' Schlafzimmer ist.", "Mariru")
	await novel_interface.show_dialog("Außerdem... Das war von Anfang an Annies Idee.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Was?", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ich bin sicher, du erinnerst dich.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Soya/Earthperspective.png")
	await novel_interface.show_dialog("Vor etwa zwei Wochen, nachdem Lian Sonya aus dem Flux-Bereich zurückgebracht hatte, wo es weltweit zu einem Raumzeit-Flux kam, der etwa 5 Sekunden anhielt.", "Mariru")
	await novel_interface.show_dialog("Das Signal war stark, hielt aber nicht lange an. Daher war kein Land in der Lage, die Quelle zu ermitteln.", "Mariru")
	await novel_interface.show_dialog("Die offizielle Geschichte besagt nun, dass es in der Nähe des Sonnensystems zu einem Gammastrahlenausbruch kam.", "Mariru")
	await novel_interface.show_dialog("Obwohl es nur erfunden ist, stimmt eines: Die Menschheit stand kurz vor der Ausrottung.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Aber die Welt ging nicht unter. Deshalb müssen wir sicherstellen, dass niemand New Opulentia mit diesem Vorfall in Verbindung bringt.", "Mariru")
	await novel_interface.show_dialog("Das SID hat alle Nachrichtenberichte und Mitteilungen verfolgt.", "Mariru")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Bisher ist nichts Konkretes aufgetaucht, aber Annie hat durch Social-Media-Crawling etwas Interessantes herausgefunden.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Annie ist so gut geworden, oder? Ihr Lehrer erwähnte, dass sie auch hart im körperlichen Training gearbeitet hat.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","sigh")
	await novel_interface.show_dialog("Sie hat ihre eigenen Gründe, dieses Kind.", "Mariru")
	novel_interface.change_expression("serious")
	await novel_interface.show_dialog("Lian ist jedoch eine ganz andere Geschichte ...", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru holt eine Liste aller Spiele heraus, die Lian kürzlich abgeschlossen hat.")
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Jedenfalls hat Annie Dutzende Beiträge gefunden, die am selben Tag veröffentlicht wurden, an dem Lian Sonya zurückbrachte. Sie stammen von verschiedenen Menschen, die während ihres Mittagsschlafs denselben seltsamen Traum hatten.", "Mariru")
	await novel_interface.show_dialog("„Ich habe davon geträumt, in einen dunklen Abgrund zu fallen und meine verstorbenen Verwandten zu treffen.“", "Mariru")
	await novel_interface.show_dialog("Keiner dieser Leute hatte viele Follower, daher erregten ihre Beiträge nicht viel Aufmerksamkeit.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Träume beim Mittagsschlaf...", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Warte! Der Raumzeitfluss ereignete sich gegen 16 Uhr, New Opulentia Zeit!", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal1")
	await novel_interface.show_dialog("Zu dieser Zeit machen nicht viele Menschen ein Nickerchen und noch weniger würden ihre Träume online veröffentlichen.", "Mariru")
	await novel_interface.show_dialog("Wir haben weitere Analysen durchgeführt. Die physischen Adressen aller dieser Konten liegen innerhalb von New Opulentia – in einem Umkreis von 5 Meilen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya hört mit strahlenden Augen zu.")
	novel_interface.show_character("liliu_uniform1","serious")
	await novel_interface.show_dialog("Und das Zentrum dieser Region ist Nix‘ Villa.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Es könnte also wirklich etwas Besonderes in dieser Villa sein. Als sich das Himmelstor öffnete, löste dieses Ding bei schlafenden Menschen Träume aus?", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya klingt aufgeregt.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Da ich mir zunächst nicht sicher war, ließ ich Annie einen Boltzmann-Sensor in das Sicherheitssystem der Villa einbauen.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("„Ich will es sehen.“ Aya kommt schnell zu Mariru, aber Mariru legt ihre Hand auf Ayas Gesicht, um sie aufzuhalten.")
	await novel_interface.show_text_only("Das silberhaarige Mädchen hat leider kurze Arme – sie kann Mariru nicht erreichen, ihre Hände wedeln in der Luft.")
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("„Wer wird es sehen!“ (Ich will es sehen!)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Ich werde es Ihnen zeigen, nachdem wir den Sensor geborgen haben. Jetzt beeilen Sie sich und beenden Sie die Aufgabe, die Professor Shih Ihnen gegeben hat!", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Dann verlässt Mariru den Kommandoraum und starrt auf die Satellitendaten, die sie auf ihrem Gerät empfangen hat.")
	await novel_interface.show_dialog("(Als sich die Stirnen von Lian und Nix zuvor berührten, kam es zu einem Ausbruch niederfrequenter Radiowellen.)", "Mariru")
	await novel_interface.show_dialog("Es zeigte das gleiche Muster wie menschliche Gehirnwellen im REM-Schlaf ...", "Mariru")
	novel_interface.show_background("res://assets/images/bg/Baizhu/snowfield.png")
	await novel_interface.show_text_only("Fast identisch mit dem, was in der Antarktis passiert ist ...")

	print("=== 星尘降临篇第3话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
