# stardustdescends_ep17.gd - 星尘降临篇第17话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep17_script()

func play_script():
	pass

func stardustdescends_ep17_script():
	novel_interface.change_music("res://assets/audio/music/Sewer.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("Bajé a tientas la oscura escalera y salí del edificio en total oscuridad.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(Está tan oscuro...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi llamada con Emily acababa de cortarse sin previo aviso. No importa cuántas veces intenté devolver la llamada, no hubo respuesta.")
	await novel_interface.show_text_only("Un mal presentimiento se apoderó de mí. La tasa de criminalidad en este barrio pobre ya estaba fuera de serie por la noche, y supuestamente extremistas aparecían aquí de vez en cuando...")
	await novel_interface.show_text_only("La tía Haifa apagó rápidamente las luces del pasillo y de todas las habitaciones. Por suerte los niños ya estaban dormidos.")
	await novel_interface.show_text_only("Mientras cerraba lentamente la pesada puerta de metal del orfanato, una ola de temor repentinamente surgió en mi pecho...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Si me quedara aquí, tal vez nunca volvería a ver a Emily y a los demás...")
	await novel_interface.show_text_only("No sé de dónde vino el impulso, pero antes de que se cerrara la puerta salí corriendo, dejé un rápido \"voy a echar un vistazo\" y bajé corriendo las escaleras.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	await novel_interface.show_text_only("...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(¿Por qué salí corriendo tan imprudentemente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Puede que Masada tenga un clima mediterráneo templado, pero el viento de la noche todavía se sentía frío contra mi cabello, que aún no se había secado por completo.")
	await novel_interface.show_text_only("El vehículo blindado estacionado en el patio tenía las luces interiores y exteriores apagadas, pero noté que la trampilla trasera estaba sólo medio cerrada.")
	await novel_interface.show_text_only("Conteniendo la respiración, me deslicé hasta la parte trasera del vehículo y abrí la escotilla lo suficiente para asomar la cabeza.")
	await novel_interface.show_text_only("Mirando hacia la cabina a oscuras, encendí la linterna de mi teléfono.")
	await novel_interface.show_text_only("¡De repente apareció a la vista la cara al revés de un hombre! ¡Espuma colgaba de la comisura de su boca y sus pupilas sin vida me miraban fijamente!")
	await novel_interface.show_text_only("Salté hacia atrás por reflejo como un ciervo asustado y mi teléfono se me escapó de la mano.")
	await novel_interface.show_text_only("Antes de que mis pies tocaran el suelo, un brazo me agarró por detrás mientras otra mano me tapaba la boca con fuerza.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(¡Mmmph--!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vi mi teléfono hacer un arco en el aire, solo para que Emily lo agarrara con una mano antes de que cayera al suelo y apagara suavemente la linterna.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("(susurrando) ¡Shh! Somos nosotros.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Acarició mi rostro aterrorizado con impotencia y casualmente secó las lágrimas que acababan de brotar de las comisuras de mis ojos.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("¿Acabas de salir de la ducha?\n(sniff sniff) Hueles muy bien~", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("No hagas ningún sonido, ¿entendido?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voz burlona de Vera llegó detrás de mí. Sólo después de verme asentir obedientemente me soltó.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("(susurrando) Mira afuera.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Siguiendo la dirección que ella señaló, miré a través del hueco en la puerta del patio hacia la calle exterior...")
	await novel_interface.show_text_only("Una vez que mis ojos se acostumbraron a la oscuridad, rápidamente noté sombras que crujían en la calle.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","stare",0.25)
	await novel_interface.show_dialog("(¿Son esos ladrones...? No, hay demasiados).", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Había cuatro o cinco hombres vestidos de negro justo dentro de mi campo de visión, rodeando dos viejas camionetas que se movían a un ritmo anormalmente lento.")
	await novel_interface.show_text_only("Las furgonetas no tenían faros e incluso les habían quitado las luces de freno. Los conductores mantuvieron los motores lo más silenciosos posible.")
	await novel_interface.show_text_only("No mucho después de que pasara ese convoy sospechoso, otro equipo con exactamente la misma configuración apareció por detrás.")
	await novel_interface.show_text_only("A lo lejos, un hombre sin hogar salió tambaleándose de una choza en la esquina sosteniendo una botella de licor, eructó y miró fijamente la calle oscura.")
	await novel_interface.show_text_only("Uno de los hombres vestidos de negro se acercó al borracho, le rompió el cuello sin dudarlo y rápidamente arrastró el cuerpo hacia las sombras junto al camino.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("--?!!", "Lian")
	await novel_interface.show_dialog("¿Quiénes son esas personas...?", "Lian")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ya es el sexto equipo que vemos. Agarré uno en secreto hace un momento, pero antes de que pudiera interrogarlo, mordió el veneno y se suicidó.", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily señaló el vehículo blindado, probablemente refiriéndose al hombre que acababa de ver echando espuma por la boca.")
	novel_interface.show_character("emilio","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("ren_medical","panic",0.25)
	await novel_interface.show_dialog("Llevaba una bandera negra con lemas religiosos metidos en la ropa. Por lo general, sólo los extremistas que llevan a cabo ataques suicidas hacen eso...", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily frunció el ceño profundamente. La situación claramente había ido mucho más allá de lo que esperaba.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("¿Ataque suicida?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sólo había visto ese término en películas y noticias extranjeras. ¡Nunca había oído hablar de tanta gente apareciendo a la vez!")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Esos vehículos no tienen matrícula ni luces de freno, por lo que sólo pueden circular dentro de las favelas, que son puntos ciegos en la red de vigilancia. En cualquier otro lugar, los drones los interceptarían casi de inmediato.", "Emily")
	await novel_interface.show_dialog("La Fuerza de Defensa Nacional también realiza patrullas aleatorias por aquí durante el día, así que no creo que esos vehículos estuvieran destinados a regresar intactos...", "Emily")
	await novel_interface.hide_2nd_character()
	novel_interface.character_move_right(0)
	await novel_interface.show_dialog("T-quieres decir--", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Un ataque suicida de una magnitud sin precedentes y que muy probablemente ocurrirá en las próximas horas.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("El hecho de que hayan llegado tan cerca del centro de la ciudad significa que los vehículos no transportan material radiactivo...", "Vera")
	await novel_interface.show_dialog("Hay detectores de material radiactivo enterrados bajo las carreteras a lo largo de kilómetros alrededor de Masada.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Pero si esto fuera sólo un ataque con coche bomba, ¿realmente necesitarían tanta gente?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("¿Deberíamos informar esto primero?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Las señales electromagnéticas cercanas están todas bloqueadas en este momento. Acabo de enviar un código de emergencia desde una cabina telefónica pública.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("¿Aún quedan cosas así de viejas por aquí?")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("La resistencia rara vez utiliza equipos de interferencia en el frente. No tengo idea de quiénes son estas personas...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Incluso si el ejército y Monola se apresuran, les tomará al menos diez minutos. Para entonces, estas personas ya habrán desaparecido.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Entonces ¿deberíamos seguirlos silenciosamente?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Eso no ayudará. Como operan en grupos, definitivamente se dividirán y se esconderán por separado.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Correcto. Este barrio pobre ya es un enclave de minorías étnicas, y las pandillas locales que hablan diferentes idiomas están mezcladas en completo caos.")
	await novel_interface.show_text_only("No sólo la infraestructura está muy deteriorada, sino que también hay muchas zonas ocultas excavadas por estructuras ilegales que no aparecen en ningún mapa de planificación.")
	await novel_interface.show_text_only("El gobierno de Masada siempre ha sido ambiguo respecto del desastre que hay aquí. De todos modos, el presupuesto nacional se ha visto limitado durante años, por lo que no han tenido fuerzas para limpiar este vertedero.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("¿Podría esto tener algo que ver con el acuerdo de alto el fuego de mañana?", "Lian")
	novel_interface.change_expression("wry_smile")
	await novel_interface.show_dialog("Li... quiero decir, mi superior mencionó algún tipo de ceremonia de firma mañana.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("¡Ah! ¿A qué hora es la ceremonia mañana?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","panic")
	await novel_interface.show_dialog("Si mal no recuerdo, el aviso interno decía que se adelantó hasta las seis de la mañana. Habrá muchos medios de comunicación allí, por lo que querían evitar la tormenta de arena tanto como fuera posible para el metraje.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Nuestro representante firmante es el mayor general Hamon. En entrevistas incluso dijo que usaría traje en lugar de uniforme para la ceremonia.", "Vera")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Ese gran sapo podría simplemente anunciar que se presentará a las elecciones del próximo año. Sus ambiciones no podrían ser más obvias...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(... ¿Sapo?)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Espera... si es Hamon...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily parecía muy familiarizada con el mayor general. Ella frunció el ceño y pensó mucho.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Si Hamon realmente tiene la intención de postularse para primer ministro, con su personalidad probablemente pensaría que una simple firma y un apretón de manos son demasiado débiles.", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Si quiere que los medios vean los cambios traídos por el alto el fuego de una manera más directa, supongo que actualizará los protocolos electrónicos de las armas de defensa de IA al mismo tiempo.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("¿Qué quieres decir...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Si los medios de izquierda presentes en el lugar fueran testigos del desarmado y retirada de los enjambres de drones que rodean Masada durante todo el año, probablemente se echarían a llorar en el acto.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Pfft--\nSí, puedo verlo.", "Vera")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Espera... ¿¡Estás diciendo que esas personas están planeando atacar mientras el sistema de defensa de Masada está actualizando el protocolo unificado!?", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("El ochenta por ciento de las defensas de Masada dependen del armamento de IA. El sistema no sería tan estúpido como para desconectar todo de una vez.", "Emily")
	await novel_interface.show_dialog("Para una actualización importante del protocolo como esa, se haría en lotes por sector de defensa...", "Emily")
	novel_interface.change_expression("shout")
	await novel_interface.show_dialog("Correcto. ¿Dónde exactamente se celebrará la ceremonia de firma de mañana?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Uh, creo que es algún centro de convenciones junto al Mar Muerto.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Recordé que Mariru lo mencionó por teléfono hace un momento...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	await novel_interface.show_dialog("Han seleccionado al representante de Masada para la firma del alto el fuego de mañana. Será el mayor general Hamon del Comando Norte.", "Mariru")
	await novel_interface.show_dialog("Y por razones políticas, el lugar de la firma fue elegido como el Centro Internacional de Convenciones de Masada junto al Mar Muerto.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SlumArea.png")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("¿Centro Internacional de Convenciones de Masada?\nEso no está lejos de aquí...", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","solemn")
	await novel_interface.show_dialog("¿Están planeando atacar el lugar directamente?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("No seas ridículo. El área alrededor del lugar definitivamente estará bajo estricta vigilancia de Monola, y la Fuerza de Defensa Nacional tendrá armas pesadas desplegadas por todo el lugar.", "Vera")
	await novel_interface.show_dialog("Si esas personas se atrevían a dirigirse al centro de convenciones, serían descubiertas a cinco kilómetros de distancia y aniquiladas inmediatamente.", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Recuerdo dónde está el centro de convenciones en el mapa. Si estuviera parado en ese pasillo...", "Emily")
	await novel_interface.show_dialog("El muro de aislamiento más cercano que pude ver sería ese tramo frente a nosotros, ¿verdad?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Seguí el gesto de Emily y miré en esa dirección. El camino que se extendía en la distancia parecía casi cortado por el imponente muro de aislamiento...")
	await novel_interface.show_text_only("Más allá, se filtraban débiles destellos del bullicioso centro de la ciudad...")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Ese es el muro de aislamiento noreste del centro de la ciudad. Si el lugar no es su verdadero objetivo...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily y Vera guardaron silencio. A juzgar por sus expresiones, me di cuenta de lo mala que era la situación.")
	await novel_interface.show_text_only("Miré hacia el cielo oscurecido. No había ni una sola estrella.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("(¿El cielo... siempre estaba tan oscuro?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("En aquel entonces, un sentimiento inquietante y siniestro que no podía expresar con palabras brotó dentro de mí.")
	await novel_interface.show_text_only("Pero en ese momento, no tenía forma de saber que las cosas resultarían así...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Al mismo tiempo, en la Quinta Ciudad Escolar.")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_bar.png")
	await novel_interface.show_text_only("La suave música de fondo continuó sonando mientras el profesor Shih se sentaba en el sofá agarrándose la cabeza por el dolor.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("¿Estás despierto?", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru colocó una bebida frente al profesor Shih y lentamente se sentó en el sillón frente a él.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Es agua electrolítica. Ayudará con el dolor de cabeza.", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("shi","eyeclose",0.25)
	await novel_interface.show_dialog("Yo...", "Professor Shih")
	novel_interface.change_2nd_expression("normal")
	await novel_interface.show_dialog("Siento que... ¿te conozco?", "Professor Shih")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru estaba sorprendida por dentro, pero no se mostró ni rastro de ello en su rostro.")
	await novel_interface.show_text_only("Tenía la intención de cotejar la información que acababa de obtener sobre el proyecto negro de la NASA con el profesor Shih, pero su reacción le dio algo inesperado.")
	novel_interface.show_character("liliu_uniform1","normal1")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("shi","normal",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Ninguno de los interrogatorios anteriores le dejó recuerdos. ¿No pudo finalizar el último borrado de memoria?)", "Mariru")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("¿Qué... te acuerdas?", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"eyeclose")
	await novel_interface.show_dialog("N-No... Creo que te vi en un sueño... N-yo tampoco lo recuerdo claramente.", "Professor Shih")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Es agua electrolítica. Ayudará con el dolor de cabeza.", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru empujó la bebida de color amarillo pálido hacia el profesor Shih. Era la \"medida de seguridad\" que Aya había diseñado.")
	await novel_interface.show_text_only("Mientras se consumiera el líquido de la taza, el vínculo entre el interrogador y el sujeto se cortaría automáticamente.")
	await novel_interface.show_text_only("En circunstancias normales, cuando el sujeto veía el agua con electrolitos, instintivamente se resistía, como si beberla significara admitir que algo andaba mal con ellos.")
	await novel_interface.show_text_only("Pero una vez que el estado mental del sujeto se volviera inestable, estaría más inclinado a beber agua para calmarse.")
	await novel_interface.show_text_only("El profesor Shih miró fijamente la taza durante mucho tiempo antes de que finalmente comenzara a hablar.")
	novel_interface.stop_music()
	novel_interface.show_character("shi","eyeclose")
	await novel_interface.show_dialog("Hubo un período en el que mi hija sufría de insomnio repetido. Durante una llamada telefónica, me habló de un experimento mental...", "Professor Shih")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Su pregunta fue: ¿por qué no ha llegado todavía el apocalipsis?", "Professor Shih")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("¿Ah?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_music("res://assets/audio/music/Deep Water.mp3")
	novel_interface.show_character("shi","normal")
	await novel_interface.show_dialog("Las cinco extinciones masivas anteriores de la Tierra ocurrieron hace 440 millones, 365 millones, 250 millones, 200 millones y 65 millones de años, respectivamente.", "Professor Shih")
	await novel_interface.show_dialog("Con esa frecuencia, el entorno natural debería producir un evento apocalíptico aproximadamente cada cien millones de años.", "Professor Shih")
