	await novel_interface.show_text_only("Prendendo a respiração, fui até a traseira do veículo e abri a escotilha apenas o suficiente para enfiar a cabeça lá dentro.")
	await novel_interface.show_text_only("Olhando para a cabine escura como breu, liguei a lanterna do meu telefone...")
	await novel_interface.show_text_only("O rosto invertido de um homem de repente apareceu! Espuma pendia do canto de sua boca e suas pupilas sem vida olhavam diretamente para mim!")
	await novel_interface.show_text_only("Pulei para trás por reflexo, como um cervo assustado, e meu telefone voou da minha mão.")
	await novel_interface.show_text_only("Antes mesmo de meus pés tocarem o chão, um braço me agarrou por trás enquanto outra mão apertou minha boca com força.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Mmmph--!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Observei meu telefone fazer um arco no ar, apenas para Emily pegá-lo com uma mão antes que ele caísse no chão e desligar suavemente a lanterna.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("(sussurrando) Shh! Somos nós.", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela deu um tapinha no meu rosto aterrorizado e casualmente enxugou as lágrimas que haviam brotado nos cantos dos meus olhos.")
