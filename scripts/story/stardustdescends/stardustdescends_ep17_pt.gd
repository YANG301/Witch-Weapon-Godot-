	await novel_interface.show_text_only("...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Por que eu corri aqui tão imprudentemente...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Massada pode ter um clima mediterrâneo ameno, mas o vento noturno ainda fazia frio no meu cabelo, que ainda não estava completamente seco.")
