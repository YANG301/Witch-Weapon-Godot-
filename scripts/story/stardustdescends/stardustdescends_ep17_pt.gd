	await novel_interface.show_dialog("Não faça barulho, entendeu?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("A voz provocante de Vera veio atrás de mim. Só depois que ela me viu acenar obedientemente ela me soltou.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("(sussurrando) Olhe para fora.", "Emily")
	await novel_interface.hide_character()
