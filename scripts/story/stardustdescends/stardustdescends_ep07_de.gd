	await novel_interface.hide_character()
	await novel_interface.show_dialog("Basierend auf dem, was Sie beschrieben haben, wurde Ihr Gehirn wahrscheinlich durch etwas beeinträchtigt. Und danach sendet es Ihnen neuronales Feedback, das nur Sie wahrnehmen können.", "Aya")
