	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Ich habe mein Armband bereits. Kann ich jetzt gehen?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera ist ein wenig überrascht. Sie scannt den Barcode auf meinem Armband und lächelt dann.")
