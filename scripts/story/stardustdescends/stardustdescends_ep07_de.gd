	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich strecke meine Arme aus, während ich auf die Brücke über den Kanal blicke.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Ist das der Suezkanal?", "Lian")
