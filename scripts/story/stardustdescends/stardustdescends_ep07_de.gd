	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("Sie spionieren mich aus?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ich schaue mich um und entdecke kein Überwachungsgerät. Dann wird mir klar, dass es wahrscheinlich von weit oben kommt.")
