	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Ist es nur ein Zufall? Stardust steuert auf das Heck des Schiffes zu.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Plötzlich klingelt mein Telefon – eine vertraute Stimme erwartet mich.")
	await novel_interface.show_dialog("Lian? Geht es dir gut?", "Annie")
