	await novel_interface.show_text_only("Das ist eine gute Idee! Aber wenn ich meine Kamera auf sie richte...")
	await novel_interface.show_text_only("Es ist niemand im Kamerabild!")
	await novel_interface.show_text_only("Sobald ich jedoch mein Telefon wegbewege, sehe ich sie wieder, wie sie mich immer noch bettelt.")
