	await novel_interface.show_dialog("(Welche Stärke!)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("Falls Sie mich beim ersten Mal nicht gehört haben ...", "Vera")
