	await novel_interface.show_dialog("Und sie können! Ich war in letzter Zeit sauer darüber. Wenn du mir noch einmal in die Quere kommst, werfe ich dich ins Meer und verfüttere dich an Haie!", "Vera")
	await novel_interface.show_dialog("Sind wir klar?!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Das Gesicht des Erzbischofs ist lila geworden. Da er nicht in der Lage ist zu sprechen, nickt er hastig.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Komm zurück in deine Schlange!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sobald er losgelassen wird, eilt der Erzbischof zu seiner Linie zurück, während er wieder zu Atem kommt.")
