# stardustdescends_ep11.gd - 星尘降临篇第11话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep11_script()

func play_script():
	pass

func stardustdescends_ep11_script():
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadMuseum.png")
	novel_interface.show_character("ren_medical","normal1")
	await novel_interface.show_dialog("Bảo tàng Quốc gia Masada... đây là nơi nào?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cầm điện thoại, tôi chắc chắn rằng mình đã đến đúng địa điểm.")
	await novel_interface.show_text_only("Điều làm tôi ngạc nhiên là hầu hết các phòng triển lãm của bảo tàng quốc gia này đều được bố trí ở không gian bán ngầm.")
	await novel_interface.show_text_only("Bức tường đá đen đứng ở lối vào chính được cho là chứa đá lấy từ tàn tích của bức tường thành cổ ở phía tây Núi Đền ở cố đô.")
	await novel_interface.show_text_only("Lớp vật liệu chắn bức xạ màu đen quấn chặt bên ngoài bức tường như đang thầm nói lên những vết thương, nỗi đau mà thảm họa đó để lại.")
	await novel_interface.show_text_only("Toàn bộ bức tường giống như một tấm bia mộ khổng lồ. Một vài người lớn tuổi đứng dưới đó, cúi đầu nhẹ nhàng vuốt ve tảng đá, không biết họ đang than khóc hay đang cầu nguyện...")
	novel_interface.show_character("ren_medical","uneasy")
	await novel_interface.show_dialog("Tôi đăng ký ở đây... phải không?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi sử dụng huy hiệu của mình tại quầy không người lái ở lối vào và hoàn tất quá trình quét sinh trắc học khuôn mặt.")
	await novel_interface.show_text_only("Huy hiệu này là thông tin xác thực được mã hóa từ Tổ chức Cứu trợ Y tế Quốc tế, được thiết kế dành riêng cho các nhân viên y tế thường xuyên ra vào vùng chiến sự.")
	await novel_interface.show_text_only("Bên cạnh việc lưu trữ thông tin cá nhân và hồ sơ y tế, nó còn cho phép bạn gọi đến thiết bị liên lạc và hàng cứu trợ của tổ chức ở bất kỳ đâu trên thế giới.")
	await novel_interface.show_text_only("Nó thậm chí còn được cài sẵn một lượng tiền điện tử ngoại tuyến, được cho là để trả tiền chuộc nếu bạn bị bắt cóc...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Y tá thực tập không cần quyền truy cập như thế này chút nào, phải không!)\n(Mariru, thật lòng mà nói...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dù sao thì, miễn là họ không bắt tôi làm điều gì nguy hiểm...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_FirstExhibition.png")
	await novel_interface.show_text_only("Tôi đi thang cuốn xuống phòng triển lãm đầu tiên, nơi trưng bày rất nhiều bức phù điêu bằng đá trong căn phòng không rộng lắm.")
	await novel_interface.show_text_only("Những dấu vết xói mòn do gió có thể nhìn thấy dường như kể về một lịch sử xa xôi, phong hóa.")
	await novel_interface.show_text_only("Nhưng tôi không quan tâm đến lịch sử. Tôi chỉ lướt điện thoại và cố gắng tìm hiểu xem mình sẽ sống sót như thế nào trong ba giờ khốn khổ này.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Đó có phải là... hướng dẫn không?!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trong thời đại ngày nay, khi hướng dẫn bằng giọng nói AI có ở khắp mọi nơi, tôi đã không nhìn thấy hướng dẫn viên thực sự là con người trong một thời gian rất dài.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Không phải Masada đang rất thiếu dân số sao...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ông ta là một người đàn ông lớn tuổi có bộ râu trắng, có lẽ khoảng sáu mươi tuổi, đội một chiếc mũ đầu lâu nhỏ màu đen có gắn huy hiệu ID trên cổ áo vest.")
	await novel_interface.show_text_only("Anh kiên nhẫn hướng dẫn mọi người khi họ nhặt tờ rơi, mỉm cười ân cần khi trả lời từng người hỏi anh điều gì đó.")
	await novel_interface.show_text_only("Tò mò, tôi nhích lại gần. Anh ấy đang giới thiệu lịch sử của bảo tàng với một vài du khách--")
	await novel_interface.show_dialog("Mặc dù nhiều di tích quý giá đã bị phá hủy trong chiến tranh cùng với bảo tàng quốc gia ban đầu.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Tuy nhiên, trong những năm gần đây, bảo tàng mới này đã thu thập được nhiều hiện vật quý giá từ Tây Á và Châu Phi, giúp chúng thoát khỏi sự tàn phá của chiến tranh...", "Hướng dẫn viên")
	await novel_interface.show_text_only("Tôi liếc nhìn xác ướp Ai Cập và chiếc mặt nạ bằng đồng được in ở mặt sau của tờ rơi quảng cáo.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Vậy là bạn vừa lấy trộm chúng từ những nơi đó à!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nhưng ngày nay, hầu hết các hiện vật lịch sử quý giá trên khắp thế giới đều được lưu giữ bởi Sáu Thành phố Học viện, nên chuyện như thế này hầu như không có gì bất thường.")
	await novel_interface.show_text_only("Tôi nhận thấy rằng trong khi anh ấy nói với cảm xúc mãnh liệt, tay trái của anh ấy luôn nhét vào túi áo vest.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Có lẽ đó là một phong tục tôn giáo đặc biệt nào đó...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi nhìn xung quanh. May mắn thay, hôm nay không phải ngày Sa-bát nên không có nhiều du khách và cũng không có thành viên nào khác của tổ chức y tế trong bảo tàng.")
	await novel_interface.show_text_only("Đối với các thành viên NGO, thủ tục \"tham quan học tập\" bắt buộc bắt đầu bằng việc dành ít nhất ba mươi phút trong phòng lịch sử và tài liệu.")
	await novel_interface.show_text_only("Tôi lang thang khắp nơi trong sự buồn chán, và chẳng mấy chốc, ánh mắt của tôi bị thu hút bởi một vài người dân địa phương và hơn chục đứa trẻ cùng lúc đi tham quan nơi này.")
	await novel_interface.show_text_only("Trong số đó, bắt mắt nhất là hai người đàn ông khoảng bốn mươi tuổi - cả hai đều có bộ râu rậm và những bím tóc nhỏ kỳ lạ buông thõng trên tóc ở thái dương.")
	await novel_interface.show_text_only("Họ ăn mặc giống nhau: áo sơ mi trắng, áo khoác đen dài đến đầu gối và những chiếc mũ dẹt màu đen có vành cong, giống như những người thuộc một tổ chức kỳ lạ nào đó.")
	await novel_interface.show_text_only("Khoảng hơn chục đứa trẻ đi theo xung quanh những người đàn ông đó, cả trai lẫn gái đều mặc trang phục đen trắng giống nhau.")
	novel_interface.show_character("ren_medical","bored")
	await novel_interface.show_dialog("(Đây có phải là chuyến đi thực tế của trường ở gần đây không?)\n(Nhưng độ tuổi ở trường này hơi hoang dã...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Trẻ em có độ tuổi đều nhau từ khoảng ba hoặc bốn tuổi đến khoảng mười tuổi; đứa nhỏ nhất hầu như không thể đi vững, trong khi một số đứa lớn hơn lại la hét và hung dữ.")
	await novel_interface.show_text_only("Phía sau nhóm là hai người phụ nữ trung niên trông có vẻ mệt mỏi với dáng người chảy xệ.")
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("(Hai người đó không phải là giáo viên... phải không?)", "Lian")
	await novel_interface.show_dialog("(Tại sao một trong số họ lại đẩy xe đẩy?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Thật là một sự kết hợp kỳ lạ...")
	await novel_interface.show_text_only("Chuyến tham quan hội trường lịch sử nhanh chóng kết thúc và người hướng dẫn bắt đầu dẫn mọi người đến hội trường tài liệu.")
	await novel_interface.show_text_only("Anh ta chỉnh lại chiếc micro kẹp trên cổ áo và hắng giọng--")
	await novel_interface.show_dialog("Tiếp theo, tôi sẽ cho bạn xem cuộc triển lãm quan trọng nhất trong bảo tàng này.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Việc chụp ảnh bị cấm ở sảnh tiếp theo. Hãy cất điện thoại của bạn và theo tôi vào Đền Sách.", "Hướng dẫn viên")
	await novel_interface.show_text_only("Vừa nghe thấy lời này, đám trẻ ồn ào đều im lặng, hai người áo đen cũng trở nên nghiêm nghị.")
	await novel_interface.show_text_only("Tôi cất điện thoại và đi theo với sự tò mò bùng cháy trong lồng ngực.")
	await novel_interface.hide_background()
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Sau khi người hướng dẫn viên quét dấu tay của mình, một cánh cửa đá bazan trong sảnh lịch sử từ từ mở ra, để lộ một hành lang đá dài phía sau.")
	await novel_interface.show_text_only("Hơn hai mươi người chúng tôi lần lượt nộp đơn. Có cảm giác như bầu không khí trang nghiêm nào đó đã lây nhiễm vào chúng tôi; Mọi người di chuyển cẩn thận và không nói gì.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_SOTB.png")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Đây là...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cuối hành lang là một căn phòng có hình dáng kỳ lạ.")
	await novel_interface.show_text_only("Phòng triển lãm của Đền Sách có hình tròn hoàn hảo, với các sọc tròn cách đều nhau chạy từ các bức tường cho đến tận giếng trời phía trên.")
	await novel_interface.show_text_only("Ánh sáng xuyên qua giếng trời chiếu xuống quầy trưng bày ở trung tâm, khiến cả không gian trở nên tĩnh lặng và thiêng liêng.")
	await novel_interface.show_text_only("Toàn bộ không gian được thiết kế giống như một chiếc bình bằng đất sét và các bức tường xung quanh sử dụng vật liệu đất tương tự.")
	await novel_interface.show_text_only("Trên bệ trưng bày hình tròn có hình dạng như một chiếc trống kinh thánh, đặt trên các bậc đá có một cuộn giấy da lốm đốm màu vàng cổ xưa.")
	await novel_interface.show_text_only("Tôi bước lên bậc thang và nghiêng người để nhìn kỹ hơn. Tấm kính bảo vệ trông dày ít nhất năm cm và hầu hết các ký tự tiếng Do Thái trên cuộn giấy đều có thể nhìn thấy rõ ràng.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
	await novel_interface.show_dialog("Đây có phải là--", "Lian")
	await novel_interface.show_text_only("Bạn biết đấy, thứ trong anime đó...")
	await novel_interface.show_dialog("Đây là một tài liệu cổ được phát hiện trong các hang động phía tây bắc Biển Chết, được gọi là \"Cuộn sách Biển Chết\", khám phá khảo cổ học vĩ đại nhất của thế kỷ trước.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Những cuộn giấy ở Biển Chết có quy mô rất lớn, bao gồm hơn năm trăm bản thảo được khai quật từ mười hai hang động--", "Hướng dẫn viên")
	await novel_interface.show_dialog("Và cái trong hộp trưng bày này là một phần bản thảo của Genesis từ \"Torah\", một trong những Cuộn giấy Biển Chết.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Nó ghi lại quá trình Chúa tạo ra thế giới và cách Ngài chọn người Masadan làm dân tộc được Ngài chọn. Đây là di tích lịch sử quan trọng nhất ở đất nước này.", "Hướng dẫn viên")
	await novel_interface.show_text_only("Nghĩ lại thì, người Masadan dường như luôn tự hào rằng mình là người được Chúa chọn...")
	await novel_interface.show_text_only("Nhưng tôi chưa bao giờ quan tâm đến những câu chuyện tôn giáo như thế này--")
	await novel_interface.show_text_only("Mọi người trên trái đất đều có một vài tổ tiên đã biến thành thần trong truyền thuyết của họ, phải không?")
	await novel_interface.show_text_only("Các du khách địa phương rõ ràng không nghĩ như vậy. Hai ông chú đội chiếc mũ kỳ lạ lập tức quay về phía chiếc hộp và bắt đầu cầu nguyện.")
	await novel_interface.show_text_only("Bằng giọng nói trầm ấm và tử tế, người hướng dẫn tiếp tục.")
	await novel_interface.show_dialog("Bản thảo này ghi lại những câu chuyện về tổ tiên Áp-ra-ham, Y-sác, Gia-cốp và mười hai người con trai của Gia-cốp.", "Hướng dẫn viên")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheThree.png")
	await novel_interface.show_dialog("Abraham là nhà tiên tri trong nhiều tôn giáo và là tổ tiên chung của người Do Thái và người Ả Rập.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Áp-ra-ham là người được Chúa chọn giữa muôn loài và được phước.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Đức Chúa Trời đã lập giao ước với Áp-ra-ham, hứa ban một vùng đất màu mỡ cho con trai hợp pháp, cháu nội của ông và tất cả con cháu mà dòng dõi của cháu trai sẽ sinh ra.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Vùng đất này trải dài từ sông Nile đến sông Euphrates. Đó là nơi mà ngày nay chúng ta gọi là “Miền Đất Hứa”.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Sau đó, Áp-ra-ham sinh con trai hợp pháp của mình là Y-sác; Y-sác sinh Ê-sau, con trai thứ hai tên là Gia-cốp...", "Hướng dẫn viên")
	await novel_interface.show_dialog("(Đợi đã... Jacob?)", "Lian")
	await novel_interface.show_text_only("Đó không phải là tên của quản trị viên Elluka sao?")
	await novel_interface.show_text_only("Một lần nữa, người phương Tây thực sự thích đặt tên con mình theo những nhân vật trong các tác phẩm kinh điển về tôn giáo...")
	await novel_interface.show_text_only("Người hướng dẫn viên dừng lại, chỉnh lại kính đọc sách và tiếp tục giải thích nội dung của cuộn giấy.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MessOfPottage.png")
	await novel_interface.show_dialog("Theo kinh thánh, Jacob, con trai thứ hai của Isaac, từng mua quyền thừa kế của anh trai Esau bằng bát đậu đỏ hầm.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Theo giao ước của Áp-ra-ham với Đức Chúa Trời, một khi Gia-cốp có được quyền trưởng nam, ông có được quyền hợp pháp để thừa kế “Đất Hứa”.", "Hướng dẫn viên")
	await novel_interface.show_dialog("Jacob sau này trở thành thánh tộc trưởng của Masada, và mười hai người con trai của ông trở thành mười hai tổ tiên của bộ tộc Masada...", "Hướng dẫn viên")
	await novel_interface.show_text_only("Đến lúc này đầu tôi bắt đầu nhức nhối.")
	await novel_interface.show_text_only("Đợi chút... đậu đỏ hầm? Cái quái gì thế!?\nNgười cổ đại có thực sự giản dị đến thế không?")
	await novel_interface.show_text_only("Và nếu điều đó là sự thật thì tất cả người Masadan đều là hậu duệ của tên Jacob đó...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_DSS.png")
