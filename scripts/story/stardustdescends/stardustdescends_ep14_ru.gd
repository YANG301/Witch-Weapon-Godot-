# stardustdescends_ep14.gd - 星尘降临篇第14话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep14_script()

func play_script():
	pass

func stardustdescends_ep14_script():
	novel_interface.change_music("res://assets/audio/music/Conspiracy.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ClusterBombs.png")
	await novel_interface.show_text_only("«Улей» — система вооружения, способная неизбирательного поражения личного состава и техники на большой территории.")
	await novel_interface.show_text_only("Эти дроны размером с ладонь лишены громоздких модулей управления и несут только одну осколочную гранату самоуничтожения каждый.")
	await novel_interface.show_text_only("Используя распознавание ИИ, позволяющее отличать личный состав от оборудования, десятки дронов могут координировать свои действия друг с другом и наносить удары по площади даже более эффективно, чем кассетные бомбы.")
	await novel_interface.show_text_only("Несколько лет назад Масада сбросил большое количество «ульев» на долину Бекаа, что привело к тысячам жертв среди гражданского населения и вызвало резкое международное осуждение.")
	await novel_interface.show_text_only("Несмотря на это, Масада до сих пор не подписал ни одной международной конвенции, запрещающей этот вид оружия...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Бум--!!")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("С оглушительным взрывом пулемет на южном холме внезапно разлетелся на части, а прикрывавшее его полотно разорвалось на бесчисленные обугленные клочки, которые разлетелись в воздух...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Зачем им что-то подобное...?\nРазве этот грузовик не должен был перевозить медикаменты!?", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Силы обороны, должно быть, незаметно подсунули кого-то из массовки, не сказав им об этом.", "Эмили")
	await novel_interface.show_dialog("На станции снабжения есть джип. Вера, отвези ее туда.", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Понял!", "Вера")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Что происходит... эй, вай-ааа!!!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Сверхсильная женщина без объяснения причин схватила меня за талию, прижала под мышку и помчалась к станции снабжения.")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Ааааааа-!!!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Она неслась вниз по склону огромными шагами. Если бы ее хватка сейчас ослабла, я бы полетел, как маленький тюлень, скользящий по льду.")
	await novel_interface.show_text_only("Вера бросилась на станцию снабжения и бросила меня на кучу мешков с песком.")
	novel_interface.show_character("valkyrja","speak")
	await novel_interface.show_dialog("Оставайся здесь скрытым. Я помогу Эмили разжечь огонь!", "Вера")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Перекинув веревку через плечо, она прыгнула в джип и умчалась прочь...")
	await novel_interface.show_text_only("Рой дронов запрограммирован на уничтожение любых окружающих транспортных средств, оружия или оборудования, не оснащенных дружественными идентификационными устройствами.")
	await novel_interface.show_text_only("И быстро движущееся транспортное средство, очевидно, является наиболее приоритетной целью.")
	await novel_interface.show_text_only("...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Дрожа, я забился за оборонительную стену в углу станции снабжения, прислушиваясь к отдаленной пулеметной стрельбе и одному взрыву за другим.")
	await novel_interface.show_text_only("За каждым взрывом следовал треск металла, ударяющегося о песок и камень.")
	await novel_interface.show_text_only("Это были стальные гвозди, вылетевшие из гранат, достаточно смертоносные, чтобы разорвать человека.")
	await novel_interface.show_text_only("Однако пулеметный огонь становился все реже и реже, и меня начало охватывать огромное чувство страха...")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Я подперла доску сверху барьера и присела под ней, как гриб, прикрывая голову.")
	await novel_interface.show_text_only("Говорят, что во время Второй мировой войны, когда собственные пулеметы замолкали во время атаки, это наносило сокрушительный удар по моральному духу.")
	await novel_interface.show_text_only("Сегодня я понял, что это значит...")
	await novel_interface.show_text_only("Когда наконец затих последний пулемет, остальные звуки на поле боя стали пугающе отчетливыми...")
	await novel_interface.show_text_only("Жужжание кружащих дронов напоминало небо, полное смертоносных пчел, которых невозможно точно определить.")
	await novel_interface.show_text_only("Казалось, они были повсюду, словно сама смерть, кружащаяся над головой, готовая в любой момент упасть рядом со мной...")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(С этими двумя все в порядке...?)", "Лиан")
	await novel_interface.show_dialog("(...Подождите, двигатель!?)", "Лиан")
	await novel_interface.hide_character()
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("Я выглянул наружу и увидел повсюду опустошение. Вдалеке хижина, где были сложены боеприпасы, уже была охвачена пламенем.")
	await novel_interface.show_text_only("Джип Веры мчался к станции снабжения с восточного склона, поднимая за собой огромный шлейф пыли.")
	await novel_interface.show_text_only("Более дюжины дронов преследовали его прямо на хвосте. Они были не особенно быстрыми, но и не настолько медленными, чтобы их трясло.")
	await novel_interface.show_text_only("Эмили вылезла на крышу и взяла на вооружение М16, стреляя очередями по рой, но попасть во что-либо было сложно.")
	await novel_interface.show_text_only("Вскоре у нее кончились боеприпасы, и она просто швырнула винтовку в заднюю часть машины...")
	await novel_interface.show_text_only("Один дрон сразу же пикировал на брошенную винтовку и взорвался, а остальные быстро набрали высоту, чтобы избежать радиуса взрыва.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Черт возьми!", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Джип замедлил ход у стены возле станции снабжения. Избегая прямой видимости дронов, Эмили выпрыгнула из машины и прижалась к углу у стены.")
	await novel_interface.show_text_only("Затем джип дернул колесом, поднимая пыль, и помчался прямо к другому близлежащему холму.")
	await novel_interface.show_text_only("Эмили присела в углу, подождала, пока рой пронесется над головой, затем плавно перелезла через стену и вошла внутрь.")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Лиан!?", "Эмили")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("Х-здесь...", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я ответил тихим голосом, и она прошла вдоль стены до самого навеса, который я соорудил.")
	novel_interface.show_character("ren_medical","sob")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","perspire",0.25)
	await novel_interface.show_dialog("Ты знаешь, как выбрать место... но тебе не обязательно шептать. Эти твари не слышат.", "Эмили")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ах, ты ранен?!", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Я видел несколько порезов на плече Эмили. Кровь просочилась сквозь рукав ее формы, но она выглядела совершенно равнодушной.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Это ничего. Нам нужно быстро вернуться в БТР. Броня этой машины должна справиться с этими вещами, оставив достаточно места.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("БТР стоял у дороги под оптическим камуфляжем, примерно в двух-трехстах метрах от станции снабжения.")
	novel_interface.show_character("ren_medical","panic")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Разве вы не взяли с собой дружественные идентификационные устройства!?\nЭти дроны не собираются атаковать свою сторону, не так ли...?", "Лиан")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Опять же, эти двое здесь, чтобы украсть припасы своей стороны. Это какое-то национальное развлечение Масада?")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Эти штуки ведут встроенные журналы местоположений. Конечно, мы оставили их в городе, прежде чем приступить к этой работе.", "Эмили")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("Нам пора двигаться!\nКто знает, как долго Вера сможет их отвлекать...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили похлопала меня по руке и направилась к выходу из укрытия.")
	await novel_interface.show_text_only("Я собирался последовать за ней, когда заметил, что она застыла на месте. Ее голос слегка дрожал, когда она сказала:")
	novel_interface.show_character("emilio","perspire")
	await novel_interface.show_dialog("Лиан, беги...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я наклонился и посмотрел. Три дрона кружили над станцией снабжения, выполняя полное сканирование на 360 градусов.")
	await novel_interface.show_text_only("Внезапно один из них остановился перед нашей позицией, и красный свет на его теле начал мигать...")
	novel_interface.show_character("emilio","angry")
	await novel_interface.show_dialog("Беги!!!", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Эмили вытащила пистолет и сразу выстрелила в небо, мгновенно опустошив все двенадцать патронов.")
	await novel_interface.show_text_only("Один дрон попал в стрелу и упал за пределы станции снабжения.")
	await novel_interface.show_text_only("Другой взорвался прямо в воздухе, осыпав металлическими осколками доску над нашими головами.")
	await novel_interface.show_text_only("Но последний, проведя красную линию сквозь пыль, двинулся прямо на нас...")
	novel_interface.show_character("ren_medical","sob")
	await novel_interface.show_dialog("(Мы мертвы!)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Бум--!!")
	await novel_interface.show_text_only("Взрывная волна гранаты вместе с раскаленным воздухом мгновенно заполнила тесноту внутри укрытия и сорвала доску над нашими головами.")
	await novel_interface.show_text_only("Воздух наполнился едким запахом гари и ржавым запахом крови, высушенной жарой.")
	await novel_interface.show_text_only("В то же время на станцию снабжения посыпался ураган металлических осколков...")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPostF.png")
	await novel_interface.show_text_only("От шока я потерял равновесие и упал на землю, а острая боль пронзила внешнюю сторону моего предплечья.")
	await novel_interface.show_text_only("Нет, это важнее...")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("(Я... еще жив?)", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Я проверил себя. Если не считать раны на предплечье, я практически не пострадал.")
	await novel_interface.show_text_only("А передо мной, прикрывая меня, Эмили словно развернула щит из крови...")
	await novel_interface.show_text_only("Щит поглотил большую часть взрыва, затем испарился в темно-красный дым, как сухой лед под солнцем, и растворился в воздухе.")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Что у тебя в руке...?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Я правда не хотел, чтобы ты это видел...", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она щелкнула запястьем. Рукав, который мгновение назад был испачкан кровью, теперь был совершенно чистым.")
	novel_interface.show_character("ren_medical","worry")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Мы с Верой однажды случайно соприкоснулись с какой-то гетерогенной материей, после чего обрели эту странную способность.", "Эмили")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Я могу превратить собственную кровь в твердое вещество, твёрже стали, но оно быстро испаряется, так что это не очень практично...", "Эмили")
	novel_interface.character_light(0.35,"smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Но это выглядит так круто!!", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"speechless")
	await novel_interface.show_dialog("А?", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Она, казалось, была ошеломлена моей реакцией, затем обернулась и увидела, что я пытаюсь лизнуть собственный локоть. Она не смогла сдержать улыбку и покачала головой.")
	await novel_interface.show_text_only("Это чертовски больно!!\nМеня только что порезал металлический осколок...")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Более девяноста процентов населения Масады религиозны. В глазах любой религии способность манипулировать кровью была бы богохульством и проклятием, не так ли?", "Эмили")
	novel_interface.change_expression("worry")
	await novel_interface.show_dialog("Сила Веры более практична, хотя она уже с самого начала была невероятно сильна...", "Эмили")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Джип Веры был справа от нашего поля зрения...")
	await novel_interface.show_text_only("Сильная женщина остановила его на восточном холме, и дюжина или около того дронов позади нее догонят секунд через десять…")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Двигатель заглох?!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Вера вылезла из водительского сиденья, подошла к передней части джипа и глубоко вздохнула, глядя в передний бампер...")
	await novel_interface.show_text_only("Затем с сотрясающим долину металлическим стуком она толкнула джип в сторону.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("........................??!", "Лиан")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Джип полетел изящной дугой шара для боулинга в рой, только что поднявшийся на склон холма, вызвав в одно мгновение цепочку взрывов...")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("...Она их вычистила!?", "Лиан")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","stare",0.25)
	await novel_interface.show_dialog("Пока не празднуйте. Слушать.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Да, это сводящее с ума жужжание не исчезло...")
	await novel_interface.show_text_only("Я обернулся и увидел зрелище, которое заставило мое сердце замереть:")
	await novel_interface.show_text_only("От подножия холма возле станции снабжения медленно поднимались в воздух более тридцати новых черных точек...")
	await novel_interface.show_text_only("Эти черные как смоль призраки кружились в дыму, мигая красными огнями, как будто они хотели погасить всякую волю к жизни.")
	await novel_interface.show_text_only("Вот что делает Улей таким ужасающим. Он цепляется за вас, как бог смерти, и никогда не отпускает, пока все цели не будут полностью уничтожены...")
	await novel_interface.show_text_only("Эмили инстинктивно потянула меня за собой...")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","stare",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Что нам делать...", "Лиан")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"smile")
	await novel_interface.show_dialog("Извините. Я втянул тебя в это.", "Эмили")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Эй, эй, не говори фразы, которые звучат как последняя воля!")
	novel_interface.show_character("ren_medical","wail")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","upset",0.25)
