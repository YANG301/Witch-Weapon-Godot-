# stardustdescends_ep19.gd - 星尘陨落篇第19话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep19_script()

func play_script():
	pass

func stardustdescends_ep19_script():
	novel_interface.change_music("res://assets/audio/music/Witch's Confession.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Recording.png")
	await novel_interface.show_dialog("Cette année, ma fille Nasha a sept ans, et ces derniers temps elle adore m'entraîner à faire des puzzles avec elle.", "Enregistrement")
	await novel_interface.show_dialog("Parfois, je fais exprès de paraître réticent ou débordé, et je n'accepte \"à contrecœur\" qu'après l'avoir laissée me supplier un bon moment.", "Enregistrement")
	await novel_interface.show_dialog("En réalité, j'adore jouer avec elle... mais quand Nasha fait sa petite gâtée, elle est tout simplement trop adorable.", "Enregistrement")
	await novel_interface.show_text_only("Un éclat de rire du public traversa l'enregistrement.")
	await novel_interface.show_dialog("Le puzzle avec lequel nous jouions était d'un genre entièrement nouveau, très différent de ceux que j'avais étant enfant--", "Enregistrement")
	await novel_interface.show_dialog("Chaque pièce possédait sur une face un écran e-ink couleur affichant une image fixe, si bien qu'à première vue il ne différait guère d'un puzzle traditionnel.", "Enregistrement")
	await novel_interface.show_dialog("Mais à mesure qu'on le complétait et qu'on insérait la dernière pièce, chaque élément s'illuminait et l'image du puzzle se mettait à bouger...", "Enregistrement")
	await novel_interface.show_dialog("Je me souviens encore très bien de la première fois où je l'ai vu. D'abord, j'ai cru que nous reconstituions cette célèbre photographie de la Terre appelée \"Blue Marble\"--", "Enregistrement")
	await novel_interface.show_dialog("Mais lorsque ma fille a posé le dernier morceau, toute l'image s'est mise à bouger : la caméra s'est reculée, passant devant la Lune, Mars, Jupiter...", "Enregistrement")
	await novel_interface.show_dialog("Puis il s’est envolé hors du système solaire, au-delà d’innombrables étoiles, et a finalement révélé toute la Voie Lactée.", "Enregistrement")
	await novel_interface.show_dialog("Nasha sursauta d'excitation, criant en me secouant le bras, tout comme je l'ai fait la première fois que j'ai réalisé une expérience de flexion de la lumière sur une matière hétérogène...", "Enregistrement")
	await novel_interface.show_dialog("Je crois que tout le monde ici a vécu un moment comme celui-là.", "Enregistrement")
	await novel_interface.show_dialog("Ce jour-là, je suis sorti du laboratoire en pantoufles et en pantalon de pyjama, criant jusqu'au bureau d'un professeur de microbiologie de notre université.", "Enregistrement")
	await novel_interface.show_dialog("Le vieil homme m'avait dit un jour que si je réussissais l'expérience, il ouvrirait cette chère bouteille de saké japonais que son élève lui avait offerte...", "Enregistrement")
	await novel_interface.show_dialog("Cette boisson m'a presque étouffé à mort. Je n'arrive toujours pas à croire qu'il se vende à ce prix-là.", "Enregistrement")
	await novel_interface.show_text_only("Le public a éclaté de rire et certains ont applaudi.")
	await novel_interface.show_dialog("Plus tard, j’ai progressivement compris que le processus d’étude d’une matière hétérogène ressemble beaucoup à la réalisation d’un puzzle.", "Enregistrement")
	await novel_interface.show_dialog("Avant que l’énigme ne soit enfin résolue, tout ce que vous pouvez faire est d’essayer des choses basées sur votre intuition et une poignée d’indices.", "Enregistrement")
	await novel_interface.show_dialog("C'est comme faire un puzzle : vous trouvez d'abord les quatre coins et vous les utilisez comme axiomes, comme points d'appui logiques.", "Enregistrement")
	await novel_interface.show_dialog("Ensuite, en partant des coins, vous faites tout votre possible pour fermer le cadre.", "Enregistrement")
	await novel_interface.show_dialog("Tout comme vous commencez par les axiomes les plus fondamentaux et en tirez progressivement des conclusions logiquement cohérentes.", "Enregistrement")
	await novel_interface.show_dialog("Ensuite, dans ce cadre terminé, vous continuez à faire des tentatives d’essais et d’erreurs, en poussant étape par étape vers le noyau inconnu…", "Enregistrement")
	await novel_interface.show_dialog("Le processus est long et épuisant, et ce n’est que lorsque la dernière pièce est en place que nous pouvons avoir un aperçu de la vérité du monde.", "Enregistrement")
	await novel_interface.show_dialog("Pendant ce temps, vous pouvez laisser libre cours à votre imagination en vous demandant quel genre de panorama magnifique vous finirez par voir.", "Enregistrement")
	await novel_interface.show_dialog("Je crois que c’est la partie la plus captivante de la recherche scientifique, et la raison pour laquelle la plupart d’entre nous persévèrent !", "Enregistrement")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Cliquez...")
	await novel_interface.stop_music()
	await novel_interface.show_text_only("Alors que les applaudissements du public étaient sur le point d'enfler, l'enregistrement s'est brusquement interrompu.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.show_background("res://assets/images/bg/SID/opsRoom.png")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("Il s'agissait d'un enregistrement que Mariru a trouvé sur l'ordinateur d'un chercheur décédé.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Apparemment, cela faisait partie d'une conférence privée donnée par Mushar lors de la 30e Conférence Solvay il y a plus de dix ans.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akiko","shock")
	await novel_interface.show_dialog("Celui qui parlait était... Walid Mushar ?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko était un peu surpris. Pendant un instant, elle ne parvint pas à associer cette voix raffinée et décontractée à l'impitoyable chef terroriste.")
	novel_interface.show_character("akiko","normal")
	await novel_interface.show_dialog("La 30ème Conférence Solvay... c'était en 2026, non ?", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Cette conférence académique, fondée par l'industriel belge Ernest Solvay, invitait à chaque session les meilleurs scientifiques mondiaux de l'époque.")
	await novel_interface.show_text_only("Il avait lieu tous les trois ans et, bien que les guerres et les troubles politiques aient entraîné sa suspension à plusieurs reprises, il se poursuit encore aujourd'hui.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("C'est vrai, l'année avant le début de la guerre...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("À l’époque, Mushar n’aurait pas pu imaginer que quelques mois après ce discours, sa femme et sa fille finiraient mortes dans la rue à cause d’un bain de sang ethnique aveugle.")
	novel_interface.show_character("ai","normal")
	await novel_interface.show_dialog("À l’époque, les traités internationaux interdisaient la recherche sur des matières hétérogènes, de sorte que les discussions lors de conférences universitaires comme celle-ci ne pouvaient avoir lieu qu’en privé.", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Mais l’année suivante, tous les pays ont arraché le masque, et la plupart des personnes qui ont assisté à cette conférence ne sont plus en vie aujourd’hui…", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Une lueur de mélancolie traversa le visage d'Aya, mais elle revint rapidement à son état habituel.")
	await novel_interface.show_text_only("Elle a diffusé des flux en direct de dizaines de plateformes médiatiques différentes sur grand écran, et sans exception, elles diffusaient toutes la cérémonie de signature de Massada...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony.png")
	await novel_interface.show_text_only("Tout semblait se dérouler sans problème, sans aucun rapport sur l'explosion qu'Emily avait provoquée près de la salle plus tôt.")
	await novel_interface.show_text_only("Une fois le long processus de signature du document terminé, les Masadan et les représentants de la résistance ont marché ensemble et ont appuyé leurs paumes sur un écran.")
	await novel_interface.show_text_only("Leurs empreintes palmaires, ainsi que le texte de l'accord, ont été mis en ligne en temps réel, et le système de défense de la ville de Massada a immédiatement commencé à mettre à jour son protocole de défense.")
	await novel_interface.show_text_only("Dans le même temps, la résistance a volontairement soumis des fichiers numériques de plus de deux cent mille membres soutenant l’accord de cessez-le-feu.")
	await novel_interface.show_text_only("Désormais, tant que ces gens déposeraient les armes, ils seraient libres d’entrer et de sortir de la plupart des quartiers de Massada comme des citoyens ordinaires.")
	await novel_interface.show_text_only("Le prix était qu'ils devaient porter des bracelets de suivi pendant deux ans et être placés sous le système de surveillance de Monola.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SigningCeremony1.png")
	await novel_interface.show_text_only("A l'issue de la cérémonie, les deux représentants devaient échanger des documents et se serrer la main devant les médias.")
	await novel_interface.show_text_only("Le général de division des Forces de défense et le chef de la résistance ont tenu leur poignée de main devant les caméras pendant trois bonnes minutes.")
	await novel_interface.show_text_only("Le sourire exagéré de Hamon était presque figé sur son visage, tandis que Mushar gardait simplement son sourire calme.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya a regardé la bouche béante sur l'écran, puis a jeté un coup d'œil aux informations qu'elle avait recueillies hier sur l'homme sur les réseaux sociaux.")
	novel_interface.show_character("ai","dizzy")
	await novel_interface.show_dialog("Hamon, hein...\nPas étonnant que l'armée l'ait surnommé \"Crapaud\"~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Voyant que Mariru n'était toujours pas revenue, Akiko ôta ses lunettes et respira naturellement sur les lentilles.")
	await novel_interface.show_text_only("Alors qu'elle les essuyait, une mèche de cheveux qui avait été accrochée par la tempe glissa jusqu'à ses favoris, et son expression et son allure devinrent instantanément celles de quelqu'un d'autre...")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Ce type est le porte-drapeau de la faction belliciste au sein des forces de défense de Massada.", "Akiko")
	await novel_interface.show_dialog("Ses partisans le considèrent comme un héros qui a protégé la nation. Ses adversaires le traitent de boucher trempé de sang...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya remarqua le changement de ton d'Akiko et regarda son image vidéo avec une curiosité non dissimulée.")
	await novel_interface.show_text_only("Akiko ne semblait pas s'en soucier et continuait à se remémorer ses souvenirs.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("À l’époque, Hamon suivait son oncle, le Premier ministre Schneiderman, alors lieutenant général de l’Armée de Restauration, et combattait pour la défense de Massada.", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Celui où ils ont renversé la situation avec « Phantom Force » après avoir manqué de munitions et de fournitures ?", "Aya")
	await novel_interface.show_dialog("Cela le qualifie certainement pour se présenter aux élections...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Il semble que tous les officiers supérieurs qui ont pris part à cette bataille et qui sont encore en vie occupent désormais un poste important dans l'armée ou au sein du gouvernement ~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya, qui ne s'intéresse normalement pas à la politique, a fait son propre jugement sur la base des informations qu'elle avait rassemblées et organisées avec AI la nuit dernière.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Moins de dix de ces officiers sont encore en vie, et chacun d'entre eux est un héros de guerre qui connaît également les principaux secrets du pays...", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("La vérité sur \"Phantom Force\", hein... Ils ont certainement bien protégé ce secret.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Mais il y a d’autres raisons pour lesquelles Hamon reçoit autant de soutien, n’est-ce pas ? J'ai entendu dire que les Forces de Défense auraient fait faillite depuis longtemps sans sa gestion efficace...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Gestion?\nAppelez ça du pillage.", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Akiko ne fit aucun effort pour cacher son mépris à son égard.")
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("En plus de contourner le droit international dans toutes les zones grises possibles, il a imposé la ségrégation raciale dans la zone militaire et a considérablement élargi l'autorité de tir des armes sans pilote...", "Akiko")
	await novel_interface.show_dialog("Les agents des renseignements de Palantir ont estimé que si cet homme prenait le pouvoir, la première chose qu'il ferait serait de faire adopter la loi nationale sur l'ethnicité.", "Akiko")
	await novel_interface.show_dialog("Après tout, le Grand Rabbin a déjà exprimé explicitement son soutien à Hamon...", "Akiko")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya n'avait aucune idée de comment répondre à un sujet politique aussi avancé, alors elle a discrètement cherché « Loi ethnique nationale ».")
	await novel_interface.show_text_only("Un flot de mots-clés comme « ségrégation raciale » est apparu en dessous.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("(Les humains sont vraiment ennuyeux...)", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("Au fait, pourquoi Mariru n'est-elle pas encore revenue...\nCette boisson était vraiment bien, non ?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Détendez-vous, cette femme est dure...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Aya ouvrit une nouvelle bouteille de boisson énergisante et but une gorgée. Elle parut instantanément beaucoup plus réveillée.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Elle est probablement accroupie dans les toilettes et réfléchit en ce moment...", "Aya")
	await novel_interface.hide_character()
	novel_interface.show_character("akikounglass")
	await novel_interface.show_dialog("... Vous réfléchissez à la façon de vous exécuter ?", "Akiko")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","blush_dizzy")
	await novel_interface.show_dialog("Je pense au plan de Famur ~ !!", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Même après avoir rassemblé une montagne d’informations, Aya n’avait toujours aucune idée de la forme que prendrait l’attaque imminente de la résistance.")
	await novel_interface.show_text_only("Elle a récupéré une autre série d’images satellite près de la mer Morte.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_SatelliteDustStorm.png")
	await novel_interface.show_text_only("Dans les images satellite météorologiques en temps réel, la tempête de sable ressemblait à une flaque d’eau sale s’étendant sans raison sur la surface de la Terre.")
	await novel_interface.show_text_only("À présent, cette flaque d'eau avait complètement englouti le Grand Canyon de Mujib, sur la rive est de la mer Morte, et se dirigeait vers la forteresse de Massada, au sud-ouest...")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya a scanné deux fois encore le bidonville de Massada avec un satellite SID et n'a trouvé aucune trace de fluctuations de phase spatio-temporelle.")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Même s'il existait réellement une arme à matière hétérogène capable de bloquer les ondes électromagnétiques, elle devrait actuellement être inactive...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Sinon, les images satellite des bidonvilles se seraient déjà transformées en un flou déformé à cause des effets de déviation de la lumière...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Attaquer la forteresse de Massada lourdement défendue sans armes à matière hétérogène ?", "Akiko")
	await novel_interface.show_dialog("Même si les armes de défense de l’IA étaient paralysées à 100 %, cela resterait impossible…", "Akiko")
	await novel_interface.show_dialog("D'après la taille des équipes d'attaque décrites par Lian, ces terroristes ne tiendraient pas vingt minutes. Ils ne pouvaient pas mettre les pieds dans le centre-ville.", "Akiko")
	novel_interface.show_character("ai","think")
	await novel_interface.show_dialog("Quelque chose ne va définitivement pas...", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Comme l'a dit Mariru, cette fois Mushar s'est rendu lui-même ainsi que des centaines de milliers de camarades résistants.")
	await novel_interface.show_text_only("S'il s'agissait réellement de lancer une attaque, alors, comme un joueur qui choisit de faire tapis à la table, il serait déterminé à vaincre son adversaire dès ce tour.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("Plus grave encore, ils opéraient sous une condition implicite : ils ne pouvaient pas déclencher le système de représailles automatiques de Massada.")
	await novel_interface.show_text_only("S’ils ne se souciaient pas du système de représailles automatiques, la résistance pourrait simplement s’en tenir à sa stratégie précédente et continuer à réduire l’espace vital de Massada.")
	await novel_interface.show_text_only("Un jour, les systèmes sociaux et économiques de Massada s'effondreraient complètement et la résistance pourrait alors facilement prendre la ville de front.")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Aya regardait silencieusement le grand écran, plongée dans ses pensées alors que le temps passait seconde après seconde...")
	await novel_interface.show_dialog("Aaaahhh, je n'en ai absolument aucune idée !!!", "Aya")
	await novel_interface.show_text_only("Comme une étudiante incapable de résoudre une question d'examen avec un score élevé, Aya a soudainement cogné violemment son front contre le clavier de la console, surprenant Akiko.")
	await novel_interface.show_dialog("Comment anéantir ou s'emparer du centre-ville de Massada sans déclencher le système de représailles automatiques...", "Aya")
	await novel_interface.show_text_only("Toujours enfouie sa tête dans le clavier, Aya marmonna pour elle-même.")
	await novel_interface.show_dialog("Je réfléchis à ce problème depuis des semaines, et c'est totalement impossible !!", "Aya")
	await novel_interface.show_dialog("...Pendant des semaines ?", "Akiko")
	await novel_interface.show_dialog("...Pourquoi passez-vous votre temps libre à penser à des choses comme ça ?", "Akiko")
	await novel_interface.show_dialog("Euh--\nEh bien...", "Aya")
	await novel_interface.show_text_only("Aya releva la tête, plusieurs marques rouges imprimées sur son front par le clavier, et répondit faiblement.")
	novel_interface.show_character("ai","blush_stare")
	await novel_interface.show_dialog("C'est comme ça que je tue le temps quand mon cerveau est inactif... J'y pense depuis le jour où Massada a annoncé le système de représailles automatiques.", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("...Es-tu un démon ?!", "Akiko")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Pendant ce temps, à l’extérieur du lieu de la cérémonie de signature.")
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCRS.png")
	await novel_interface.show_text_only("Alors que le temps passait, je me suis assis recroquevillé sur mon siège, les genoux serrés, attendant anxieusement \"l'ordre d'évacuation\" mentionné par Mariru.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("(Les filles semblent vraiment trouver plus facile de s'asseoir en serrant leurs genoux...)", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(C'est juste que j'ai les fesses un peu froides...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La retransmission télévisée de la cérémonie de signature était diffusée sur l'écran de la console. Apparemment, même le réalisateur a trouvé que la poignée de main avait duré trop longtemps, car le signal du studio était interrompu.")
	await novel_interface.show_text_only("Les animateurs du studio ont commencé à avoir une conversation inutile avec leur invité, tandis que je regardais distraitement la radio militaire qu'Emily m'avait fourrée entre les mains la nuit dernière.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_UAVs.png")
	await novel_interface.show_text_only("Soudain, le flux en direct est passé à l'extérieur de la salle et le caméraman a dirigé le téléobjectif vers le ciel au-dessus du mur d'isolement du centre-ville.")
	await novel_interface.show_text_only("Les voix de l'invité et du journaliste de terrain s'élevèrent immédiatement alors que plusieurs groupes de drones patrouillant au-dessus du mur commençaient à descendre à l'unisson.")
	await novel_interface.show_text_only("Conformément à la procédure, les drones patrouillant le long du mur d'isolement regagnent leurs postes d'amarrage en douze lots tournants pour mettre à jour leurs protocoles de défense.")
	await novel_interface.show_text_only("Alors que les armes défensives qui tournaient normalement au-dessus du mur toute l’année descendaient progressivement et disparaissaient derrière celui-ci, la journaliste présente sur place est devenue intensément émue.")
	await novel_interface.show_text_only("Sa voix tremblait au bord des larmes alors qu'elle louait l'importance historique de ce moment et continuait à raconter comment la paix était enfin arrivée.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_APC_Wall.png")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Allez...)\n(Ces drones vont revenir après avoir mis à jour leurs protocoles, n'est-ce pas ?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Et en plus de cela, elle venait clairement de Samonton TV, une Caucasienne aux cheveux blonds et aux yeux bleus, mais elle semblait plus excitée que la plupart des journalistes locaux.")
	novel_interface.show_character("ren_medical","wry_smile")
