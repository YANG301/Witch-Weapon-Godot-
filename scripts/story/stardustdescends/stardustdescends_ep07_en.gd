# stardustdescends_ep07.gd - 星尘降临篇第7话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep07_script()

func play_script():
	pass

func stardustdescends_ep07_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("At this point, I just want to get out of here as quickly as possible. I signal Stardust, then walk toward the elevator.")
	await novel_interface.show_text_only("She immediately understands my intention and quickly catches up with me.")
	await novel_interface.show_text_only("The small girl seems to feel my anxiety, so she rubs my wrist softly.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_dialog("(whisper) Don't worry.", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Feeling her soft hand and temperature, I gradually calm down, then I hold her hand.")
	novel_interface.show_character("stardust_small","normal2")
	await novel_interface.show_text_only("We seem to have established a special bond between us. She starts to smile.")
	await novel_interface.show_text_only("It's uncanny—we just met, after all.")
	await novel_interface.show_text_only("Also, how come both the waiter and the soldiers completely ignored her?")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Inside the elevator, I pinch her soft face as I try to figure this whole thing out. She doesn't like it.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("(Her skin somehow calms me down...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Maybe she's like Beatrice? They both have a special power they themselves don't even realize?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat3.png")
	await novel_interface.show_text_only("As I'm trying to sort out all the possibilities, the elevator takes us back to the VIP room.")
	await novel_interface.show_text_only("As soon as the door opens, I realize how serious things have gotten.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Gambling_Boat.png")
	await novel_interface.show_text_only("Dozens of guests and crew are already being held by Masadan soldiers. They've been split into four groups and are waiting in line for security screening.")
	await novel_interface.show_text_only("A clerk is using a military tablet to take photos of all the guests despite their objections.")
	await novel_interface.show_text_only("A jammer has been set up in the room to prevent the guests from making phone calls and pulling strings.")
	await novel_interface.show_text_only("My phone and earpiece can't receive any signals, either. Stardust is scared by what she sees and hides behind me.")
	await novel_interface.show_text_only("By the lobby exit, an officer is using a loudspeaker to announce the rules for the security check.")
	novel_interface.show_character("valkyrja","normal")
	await novel_interface.show_dialog("Remove your watches, jewelry, and any other metal objects.", "Officer")
	novel_interface.change_expression("speak")
	await novel_interface.show_dialog("Stick an identification code to all your bags and suitcases, then bring them here for scanning.", "Officer")
	await novel_interface.show_dialog("If everything checks out, you'll get a blue wristband. Only those with the wristband can leave here.", "Officer")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("This security check is no joke...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I check to make sure I still have my wristband.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(This wristband here means I'm in the clear now?)", "Ren")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("(I'll wait and see just to be sure.)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look around. Of all the soldiers on this floor, only the officer with the loudspeaker is a girl. And just like Emily, she's very young, too.")
	await novel_interface.show_text_only("All the other soldiers seem to genuinely respect her, though.")
	novel_interface.show_character("ren_full","bored")
	await novel_interface.show_dialog("(She looks like a highschooler...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, some hefty man breaks free and rushes to the exit. He yells at the female officer.")
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("I'm Archbishop Miller from the Anglican Church of Southern India. You don't have the right to question servants of God!", "Miller")
	await novel_interface.show_dialog("Besides, your uniform... that's not a Masada Defense Force uniform at all!", "Miller")
	await novel_interface.show_dialog("Who're you, really? Who authorized this operation?", "Miller")
	await novel_interface.show_dialog("I demand to talk to your supervisor!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The aggressive archbishop stands in front of the young girl like a small mountain.")
	novel_interface.show_character("valkyrja","normal2")
	await novel_interface.show_dialog("Oh, I never said this was a Masada Defense Force uniform. I'm Warrant Officer Vera Valkyrie, the temporary officer in command.", "Officer")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Who're you again? Someone from Southern India?
Are you some kinda tax inspector?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera seems to have realized something.")
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("No wonder you're large... It comes with the territory of your job, I suppose.", "Vera")
	novel_interface.change_expression("normal2")
	await novel_interface.show_dialog("Last time I checked, though, that region was at war. People still pay their taxes during war?", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("She completely ignores the archbishop's red face as she picks up the tablet a clerk hands to her.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("Well, well, well... Who'd have thought. You're holding a religious worker visa.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera laughs in contempt, then looks at the roulette table.")
	novel_interface.show_character("valkyrja","happy")
	await novel_interface.show_dialog("A servant of God. I see... Someone like you does have the time and means to eat all the delicious food. Did you have fun in the casino?", "Vera")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("And here I thought \"God does not play dice.\"", "Vera")
	await novel_interface.hide_character()
	novel_interface.show_character("miller")
	await novel_interface.show_dialog("That's blasphemy!", "Miller")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The archbishop can't take it anymore. He starts shouting as he approaches Vera, ready to get physical. But before he can reach Vera, she grabs him by his collar.")
	await novel_interface.show_text_only("I'm shocked by what I see.")
	await novel_interface.show_text_only("With only one hand, Vera lifts the heavy archbishop into air.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(What strength!)", "Ren")
	await novel_interface.hide_character()
	novel_interface.show_character("valkyrja","speechless")
	await novel_interface.show_dialog("In case you didn't hear me the first time...", "Vera")
	novel_interface.change_expression("angry")
	await novel_interface.show_dialog("I'm no soldier. I'm a cadet of the \"Talpiot Program\" who got assigned here last minute.", "Vera")
	await novel_interface.show_dialog("I don't want any of this, but people in the Committee on Armed Services think they can boss us around.", "Vera")
	await novel_interface.show_dialog("And they can! I've been pissed about this these days. If you cross me again, I'll throw you into the ocean and feed you to sharks!", "Vera")
	await novel_interface.show_dialog("Are we clear?!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("The archbishop's face has turned purple. Unable to speak, he nods his head hurriedly.")
	novel_interface.show_character("valkyrja","angry")
	await novel_interface.show_dialog("Get back in your line!", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("As soon as he's let go, the archbishop rushes back to his line as he catches his breath.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Uh, excuse me...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I carefully walk closer and show her my wristband.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("I already have my wristband. Can I leave now?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Vera is a little surprised. She scans the barcode on my wristband, then smiles.")
	novel_interface.show_character("valkyrja","wink")
	await novel_interface.show_dialog("Yes, you can leave.", "Vera")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I feel relieved. I'm also glad that no one on this floor can see Stardust either.")
	await novel_interface.show_text_only("As soon as I get out of the room, a casino staffer approaches to apologize.")
	await novel_interface.show_text_only("According to him, Lebona will negotiate with Masada to make sure no customer information gets leaked.")
	await novel_interface.show_text_only("The signals in the entire cabin are jammed. He tells me if I need to make a phone call, I can use their land line or go to the afterdeck.")
	novel_interface.change_music("res://assets/audio/music/unkown/UI_Main_Funk.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_text_only("I drag Stardust and walk all the way to the deck.")
	await novel_interface.show_text_only("A Super Dvora Mk patrol boat is docked next to the gambling ship, the blue-and-white national flag hanging on the boat.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Finally, some fresh air!", "Ren")
	novel_interface.change_expression("sob")
	await novel_interface.show_dialog("(After all, all the windows inside the casino are closed.)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I stretch my arms as I look at the bridge across the canal.")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("Is this the Suez Canal?", "Ren")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Whoa!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust is more excited than I am. She hops all the way to the ship fence.")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("(Is it just a coincidence? Stardust is heading toward the stern of the ship.)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Suddenly, my phone rings—a familiar voice awaits.")
	await novel_interface.show_dialog("Ren? Are you OK?", "Annie")
	await novel_interface.show_dialog("She's fine. She's doing some stretching facing the ocean.", "Mariru")
	await novel_interface.show_dialog("Ah, the sweet smell of youth! Is this your way of getting an even bigger pair?", "Aya")
	await novel_interface.show_text_only("It turns out to be a conference call—Mariru and some others are also on the line...")
	novel_interface.show_character("ren_full","awkward")
	await novel_interface.show_dialog("They're spying on me?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I look around and fail to spot any surveillance device. Then I realize it's probably from way above.")
	novel_interface.show_character("ren_full","shy")
	await novel_interface.show_dialog("(It feels weird knowing that a pair of eyes is watching my every move...)", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Let's get to the point—what happened earlier?", "Mariru")
	novel_interface.show_character("ren_full","shy_left")
	await novel_interface.show_dialog("Where do I start?...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I clear my throat, then tell them everything that's happened. I specifically point out that no one can see Stardust.")
	await novel_interface.show_dialog("She's right next to you? From what we saw, you walked out of the lobby by yourself...", "Annie")
	await novel_interface.show_dialog("I was wondering how you passed the security check so quickly—you were the first person who walked out!", "Annie")
	novel_interface.show_character("ren_full","gratified")
	await novel_interface.show_dialog("It's the second lieutenant I met in the vault. She scanned my fake ID card, then gave me my wristband.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Masadan soldiers shouldn't have been that careless...", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Oh, one more thing. Both the commanding officer in the lobby and the second lieutenant in the vault are young girls, no more than 20.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("What? I know women are also subject to mandatory military service in Masada, but at that age already?", "Annie")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("The officer in the lobby mentioned she was a cadet of the \"Talpiot Program.\" She got assigned here last minute.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("That explains it...", "Mariru")
	await novel_interface.show_dialog("Talpiot was an elite military academy directly under Masada's General Staff for decades.", "Mariru")
	await novel_interface.show_dialog("Later, the Masadan military expanded it into the \"Talpiot Program.\" It invites only the top one percent of ordinary middle-school and military-school students to try out.", "Mariru")
	await novel_interface.show_dialog("Only a few dozen candidates pass its grueling mental, physical, and IQ screening each year.", "Mariru")
	await novel_interface.show_dialog("It's a pipeline for training future military elites, and its curriculum even includes small-scale field operations.", "Mariru")
	await novel_interface.show_dialog("Monola has recruited many graduates from the \"Talpiot Program.\" They're known for being professional and loyal.", "Mariru")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("An elite military school, yeah?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I don't think Ren and I would be able to get in...", "Annie")
	await novel_interface.show_dialog("Poor Ren...", "Aya")
	await novel_interface.show_text_only("Aya is hesitant to finish her sentence.")
	await novel_interface.show_dialog("The girl you talked about. Is she on the deck with you right now?", "Aya")
	novel_interface.show_character("ren_full","worry")
	await novel_interface.show_dialog("Yes. Why?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("But even the thermal sensor indicates that you're alone on the deck...", "Aya")
	await novel_interface.show_text_only("Now even I can't be sure, but there she is, squatting in front of the fence and staring in one direction.")
	await novel_interface.show_text_only("Suddenly, she stands up and points me towards the direction she was looking.")
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("We... will go there!", "Stardust")
	novel_interface.change_expression("pleased")
	await novel_interface.show_dialog("I can't remember why, but something tells me that's where we're going.", "Stardust")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("Otherwise... Otherwise there'll be a disaster...", "Stardust")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Please! We go together, please!", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust grabs my head and stares at me with her big eyes, just a small child begging her mom for toys.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Did you... hear what she said to me just now?", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("I only heard you...", "Annie")
	await novel_interface.show_dialog("Sound is produced by vocal fold vibration. If there's no physical body, there can be no sound.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("But... But I can see her, touch her, and feel her body temperature...", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Based on what you described, your brain was probably affected by something. And after that, it's been sending you neural feedback that only you can perceive.", "Aya")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("But I can even see her shadow!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I try to argue, unable to accept her explanation.")
	await novel_interface.show_dialog("... Try with the camera on your phone.", "Mariru")
	await novel_interface.show_text_only("That's a good idea! But when I aim my camera at her...")
	await novel_interface.show_text_only("There's no one in the camera frame!")
	await novel_interface.show_text_only("As soon as I move my phone away, though, I see her again, still begging me.")
	novel_interface.show_character("ren_full","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("stardust_small","happy",0.25)
	await novel_interface.show_dialog("Please!", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("I still don't believe the girl is only an illusion. I search her purse and find the pink note with her name written on it.")
	await novel_interface.show_text_only("Still the same—I can't see the note in my camera frame.")
	await novel_interface.show_text_only("And this time, after I move my phone away, the note has disappeared!")
	await novel_interface.show_text_only("I reach out my shaking hand and place my phone above Stardust.")
	await novel_interface.show_text_only("!!! My phone falls right on the floor!")
	novel_interface.show_character("stardust_small","konata_eye")
	await novel_interface.show_dialog("?", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("My ears are ringing, limbs becoming heavy all of a sudden.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("After a while, I hear Aya's voice over the phone.")
	novel_interface.show_background("res://assets/images/bg/Stardust/Vessel.png")
	await novel_interface.show_dialog("I have a theory—more like a guess, really.", "Aya")
	novel_interface.show_character("ren_full","sob")
	await novel_interface.show_dialog("Tell me.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Think about all the witches you summoned before. They weren't \"ghosts\" like this one, and they all had their complete memories.", "Aya")
	await novel_interface.show_dialog("Based on what you told us, she suffers from memory loss and can't be seen. Maybe, the requirements for summoning her haven't been completely met?", "Aya")
	await novel_interface.show_dialog("Did she ask for anything? Or give you any hint at all?", "Aya")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("About that... Yes!", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I suddenly find hope. I point in the direction Stardust wants to go.")
	novel_interface.show_character("ren_full","happy")
	await novel_interface.show_dialog("She wants to go there. Not the exact location, but somewhere over there.", "Ren")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("I hear the sound of a keyboard over the phone.")
	await novel_interface.show_dialog("318 miles in that direction...", "Mariru")
	await novel_interface.show_dialog("It's Masada Fortress!", "Annie")

	print("=== 星尘降临篇第7话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
