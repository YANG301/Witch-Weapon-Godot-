# stardustdescends_ep05.gd - 星尘降临篇第5话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep05_script()

func play_script():
	pass

func stardustdescends_ep05_script():
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("Quindi questo è il caveau a bordo della \"Liberty Star\"...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi guardo intorno stupito. Il soffitto, il pavimento ed entrambe le pareti sono tutti rivestiti con pannelli metallici lucidi a specchio realizzati con un materiale speciale.")
	await novel_interface.show_text_only("Confronto i pannelli di metallo con il chip d'oro che ho in mano. Il colore è simile, ma le pareti emanano una debole lucentezza grigio-verde.")
	await novel_interface.show_text_only("Solo ad alcuni ospiti VIP è consentito utilizzare le casseforti nella stiva e io ho appena ottenuto questo privilegio.")
	await novel_interface.show_text_only("L'unico modo per entrare o uscire è l'ascensore nell'area VIP e la porta in fondo è spessa come un muro.")
	await novel_interface.hide_background()
	await novel_interface.show_dialog("(Nessun segnale qui... Proprio come previsto.)", "Lian")
	await novel_interface.show_text_only("Ho perso la comunicazione non appena sono entrato nell'ascensore. Ora devo fare tutto esattamente come ho fatto durante l'esercitazione e non posso sbagliare nemmeno un passo.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("(Passaggio uno: verificare che il sistema di sorveglianza sia inattivo... OK.)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Noto diverse telecamere all'interno del caveau lampeggiare contemporaneamente, poi tutte si spengono.")
	await novel_interface.show_dialog("Signorina, la sua cassaforte è la n. 1212. Ogni volta che viene aperta bisogna inserire sia la sua chiave che la nostra...", "Cameriere")
	await novel_interface.show_text_only("Il cameriere si gira educatamente per darmi la chiave, solo per trovare una bottiglia di \"profumo\" puntata direttamente in faccia...")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("Mi dispiace così tanto!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Dopo uno spruzzo sul viso, i suoi occhi diventano immediatamente opachi. Sembra che voglia dire qualcosa, ma dopo aver aperto la bocca alcune volte non esce alcun suono.")
	await novel_interface.show_text_only("Questo spray anestetico è un nuovo prodotto SRD. Aya ha anche aggiunto un farmaco che rimuove il controllo inibitorio del cervello.")
	await novel_interface.show_text_only("Chiunque ne venga spruzzato entra in una sorta di stato ipnotico e diventa estremamente ricettivo alla suggestione.")
	novel_interface.show_character("ren_full","smile")
	await novel_interface.show_dialog("Vieni e stai qui.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Conduco con cautela il cameriere stordito in un punto direttamente di fronte alla porta dell'ascensore e gli faccio scivolare in mano un chip rosso.")
	novel_interface.show_character("ren_full","solemn")
	await novel_interface.show_dialog("Ehm...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ricordando le battute che mi era stato detto di provare più e più volte, mi rivolgo a lui con voce ferma:")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Mi hai portato qui alla cassaforte proprio adesso. Tutto era normale.", "Lian")
	await novel_interface.show_dialog("Dopo aver conservato il mio oggetto, ti ho dato un chip come mancia.", "Lian")
	novel_interface.change_expression("solemn")
	await novel_interface.show_dialog("Nel momento in cui sentirai schioccare le dita o vedrai la porta dell'ascensore aprirsi, ti sveglierai e \"ricorderai\" ogni dettaglio.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Il cameriere non può dire nulla. Si limita a fissare la porta dell'ascensore. Mi allontano con cautela.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Basta davvero?...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru dice che il cervello umano è bravo a inserire i dettagli partendo da alcuni semplici segnali e suggerimenti... ma sembra ancora troppo facile, non è vero?!")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("Cosa ricorderà esattamente?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Continuando a borbottare tra me e me, cammino fino al centro della volta, mi tolgo velocemente i tacchi alti e li appoggio ordinatamente sul pavimento.")
	await novel_interface.show_text_only("Poi infilo l'auricolare e ogni altro oggetto metallico nella borsetta e lo lascio accanto ai tacchi.")
	await novel_interface.show_text_only("Questa volta è un'enorme camera di schermatura magnetico-statica superconduttiva, in grado di bloccare la maggior parte delle radiazioni e dei campi magnetici.")
	await novel_interface.show_text_only("Lebona non ha una tecnologia come questa. Secondo le informazioni del professor Shih, la camera di schermatura è stata commissionata a un produttore militare del Palazzo Hovering.")
	await novel_interface.show_text_only("Trovo il contenitore di destinazione. Tra le due serrature su ciascuna porta c'è un debole motivo a nuvola inciso al laser.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("Contenitore n. 0812...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Inserisco contemporaneamente due chiavi master in ceramica nelle due serrature e aziono gli interruttori alle loro estremità.")
	await novel_interface.show_text_only("Fabella una volta disse che le chiavi delle casseforti private nelle banche e in istituzioni simili hanno in realtà un livello di sicurezza molto basso...")
	await novel_interface.show_text_only("Parte del motivo è che tali istituzioni sono estremamente fiduciose nella sicurezza che protegge il caveau stesso.")
	await novel_interface.show_text_only("Ancora più importante, la chiave dà ai clienti l’illusione che solo loro possano aprire la cassaforte, il che rende molto più semplice il pagamento del servizio.")
	novel_interface.show_character("ren_full","stare")
	await novel_interface.show_dialog("(Quindi il caveau e il sistema di sicurezza forniscono \"sicurezza\", mentre la chiave fornisce \"tranquillità\"...?)", "Lian")
	novel_interface.change_expression("shy")
	await novel_interface.show_dialog("(Perché assomiglia così tanto a qualcosa che direbbe Mariru? Lo odio...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Fare clic. La cassaforte è aperta!")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("All'interno del contenitore giaceva il meteorite nero lungo più di 1,5 metri...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Sostanza H di livello EX?!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Sì, livello EX!", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","stare")
	await novel_interface.show_dialog("Ma ricordo che hai detto che il livello EX è collegato alle religioni.", "Lian")
	await novel_interface.show_dialog("Dato che sono speciali per i seguaci religiosi, è possibile raccogliere la Sostanza H di livello EX, ma la ricerca è vietata.", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nelle leggende religiose si dice che una certa sostanza H possieda il potere di uccidere gli dei.")
	await novel_interface.show_text_only("Una volta attivato, potrebbe innescare un disastro di classe apocalittica, quindi tutte le forme di ricerca sono severamente vietate.")
	novel_interface.change_background("res://assets/images/bg/Shot/boySP_news.png")
	await novel_interface.show_text_only("E sì...")
	await novel_interface.show_text_only("Il motivo per cui ricordo tutto così chiaramente...")
	await novel_interface.show_text_only("È perché anche la Lancia del Destino che ha rubato era Sostanza H di grado EX!")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("ren_battle","worry")
	await novel_interface.show_dialog("(Sta parlando di me?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Alzo lo sguardo e mi guardo allo specchio.")
	await novel_interface.show_text_only("È esattamente come appaio in tutti i sogni che ho fatto ultimamente.")
	novel_interface.show_character("liliu_uniform2","speak")
	await novel_interface.show_dialog("Livello EX La sostanza H non è collegata solo alle religioni.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("La voce di Mariru mi riporta alla realtà.")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("Il nostro test mostra che il meteorite cadde sulla Terra più di 4.000 anni fa. Fu scavato dagli archeologi egiziani prima della guerra.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheMeteorite.png")
	await novel_interface.show_dialog("A causa dei suoi angoli regolari e delle facce piatte, si è concluso che il meteorite non avrebbe potuto formarsi naturalmente.", "Mariru")
	await novel_interface.show_dialog("Inizialmente si pensò che si trattasse di una specie di sarcofago dell'Antico Egitto, ma quella meteora era integra, senza nemmeno la minima crepa.", "Mariru")
	await novel_interface.show_dialog("Anni dopo, con l’escalation dei problemi relativi alla sostanza H, il meteorite fu trasferito all’Hovering Palace Museum.", "Mariru")
	await novel_interface.show_dialog("Il professor Shih è stato uno dei principali ricercatori che lo hanno studiato. Quando Hovering Palace ricevette per la prima volta il meteorite, pensarono di aver vinto il jackpot.", "Mariru")
	await novel_interface.show_dialog("Ma presto scoprirono che il meteorite rifiutava ogni forma di indagine e intrusione.", "Mariru")
	await novel_interface.show_dialog("Per cominciare, il suo campo magnetico fluttua periodicamente, quasi come il respiro, e al suo apice il campo è forte quasi quanto quello di un magnete al neodimio.", "Mariru")
	await novel_interface.show_dialog("Nel momento in cui rileva la radiazione, il suo campo magnetico aumenta bruscamente, raggiungendo un’intensità troppo elevata per essere misurata.", "Mariru")
	await novel_interface.show_dialog("Non solo l'esperimento fallì, ma fece quasi saltare in aria l'intera stazione di ricerca.", "Mariru")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("anne_normal","happy")
	await novel_interface.show_dialog("...E se, per esempio, provassi ad aprirlo?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Sebbene il meteorite in sé non sia particolarmente duro, qualsiasi tentativo di danneggiarne la struttura lo fa emettere calore e radiazioni intense.", "Mariru")
	await novel_interface.show_dialog("Secondo i nostri calcoli, se qualcuno lo aprisse con la forza, l’energia liberata sarebbe sufficiente a spazzare via metà del pianeta.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","panic")
	await novel_interface.show_dialog("Non c'è da stupirsi che la ricerca sia vietata...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("È anche estremamente instabile: una bomba ad orologeria che nessuno sa quando esploderà.", "Mariru")
	await novel_interface.show_dialog("Hovering Palace ha tentato in tutti i modi di sbarazzarsi del meteorite. Alla fine, la chiesa accettò di rilevarla e Samonton concesse il permesso.", "Mariru")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Parlando della chiesa. Sonya mi ha inviato un'e-mail questo pomeriggio. In allegato c'era una sua foto nel laboratorio del penitenziario.")
	await novel_interface.show_text_only("Dopo l'ultimo incidente, Sonya è tornata in chiesa. Ha detto che aveva bisogno di indagare su qualcosa e aggiornare alcuni \"strumenti\".")
	await novel_interface.show_text_only("La stanza nella sua foto era piena di attrezzature costose. L'avevo quasi scambiato per una struttura SRD.")
	await novel_interface.show_text_only("Se Sonya non avesse indossato l'uniforme da suora, non ci sarebbe stato nulla in quella foto che avrebbe fatto sì che le persone collegassero quel posto alla religione.")
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("(Sembra che la chiesa accetterà davvero qualsiasi cosa e chiunque, purché il prezzo sia giusto...)", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("La meteora non poteva essere trasportata da un aereo a causa del suo forte magnetismo. L'unico modo sicuro era la nave.", "Mariru")
	novel_interface.change_expression("speak2")
	await novel_interface.show_dialog("Ciò portò ad un altro problema: una volta che la nave avesse attraversato il Canale di Suez, avrebbe potuto finire per violare tutta una serie di convenzioni internazionali...", "Mariru")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_normal","normal1",0.25)
	await novel_interface.show_dialog("Ed è qui che è entrata in gioco Lebona?", "Annie")
	novel_interface.character_light(0.35,"normal1")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Esattamente! Il Palazzo Hovering fornì persino la Sostanza H per costruire un deposito sicuro sulla nave per bloccare le radiazioni e i campi magnetici.", "Mariru")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"panic")
	await novel_interface.show_dialog("E facendoci trapelare tutte queste informazioni...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru annuisce mentre conferma la teoria di Annie.")
	novel_interface.show_character("liliu_uniform2","speak2")
	await novel_interface.show_dialog("Tuttavia, sei già entrato in contatto con qualcosa di simile a questo meteorite.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","wry_smile")
	await novel_interface.show_dialog("Ah?", "Lian")
	await novel_interface.hide_character()
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_TheLastJudgement.png")
	await novel_interface.show_text_only("Mentre le rispondo sono già distratto da una delle foto nell'email. È uno scatto del Giudizio Universale, l'affresco che Sonya ha fotografato nella Cappella Sistina.")
	await novel_interface.show_text_only("Sollevato nel vedere che Sonya può ancora muoversi liberamente per la chiesa, inizio a cercare informazioni sull'affresco.")
	await novel_interface.show_dialog("(Michelangelo... È della stessa epoca di Henriette.)", "Lian")
	await novel_interface.show_dialog("Sembra che ogni genio di quell'epoca avesse un'ossessione per i corpi nudi...", "Lian")
	novel_interface.change_background("res://assets/images/bg/APT/livingRoom.png")
	novel_interface.show_character("liliu_uniform2","normal2")
	await novel_interface.show_dialog("\"Pilastro di lapislazzuli di Tesheim\" di Henriette.", "Mariru")
	await novel_interface.show_dialog("Anche la temperatura superficiale del pilastro varia, proprio come la respirazione.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_normal","stare")
	await novel_interface.show_dialog("Quindi...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Sia Mariru che Annie si girano a guardarmi. Nella stanza improvvisamente cade il silenzio.")
	novel_interface.show_character("liliu_uniform2","normal1")
	await novel_interface.show_dialog("Ehm...", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_battle","speechless")
	await novel_interface.show_dialog("?", "Lian")
	novel_interface.change_expression("panic")
	await novel_interface.show_dialog("Eh??", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Shop.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Per evitare che si ripeta un altro incidente \"Heaven's Door\", Mariru ha cambiato il protocollo SID.")
	await novel_interface.show_text_only("È obbligatorio seguire tutte le informazioni relative alla sostanza H di livello EX.")
	await novel_interface.show_text_only("\"Non puoi salvare il mondo intero restando all'interno di New Opulentia. Abbiamo bisogno anche di una chiave per il Consiglio Unito.\"")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Vero, ma...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quegli uomini in speciali tute da combattimento nere mi vengono in mente, così come la mia paura.")
	novel_interface.show_character("ren_full","uneasy")
	await novel_interface.show_dialog("(Spero solo che la mia chiave non si incastri nella serratura...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apro con riluttanza la cassaforte n. 0812 e guardo la meteora nera custodita al suo interno.")
	await novel_interface.show_text_only("Secondo Aya, la stanza in cui mi trovo dovrebbe essere in grado di resistere anche alla stregoneria più potente.")
	await novel_interface.show_text_only("Inoltre, a bordo di questa nave casinò c'è un'unità di risposta tattica, pronta a gestire qualsiasi tipo di emergenza.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("Quindi devo toccarlo solo una volta?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Nervoso o spaventato? Non sono sicuro. Ma potevo quasi sentire il sangue che mi scorreva nelle vene.")
	await novel_interface.show_text_only("Allungo lentamente la mano verso la meteora e chiudo gli occhi.")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("Sembra... morbido?")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_Vault.png")
	await novel_interface.show_text_only("Apro di nuovo gli occhi. Il mio palmo è già appoggiato sul meteorite. È duro e leggermente umido.")
	novel_interface.show_character("ren_full","panic")
	await novel_interface.show_dialog("(Era solo la mia immaginazione? Avrei giurato di aver toccato qualcosa di morbido...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tocco di nuovo la meteora. È davvero duro e piatto.")
	await novel_interface.show_text_only("Secondo il piano originale avrei dovuto toccare la meteora solo una volta.")
	await novel_interface.show_text_only("Confuso, chiudo la cassaforte e rimetto a posto la serratura. Poi rimango lì in silenzio di fronte, cercando ancora di capire cosa ho provato la prima volta.")
	novel_interface.show_character("ren_full","upset")
	await novel_interface.show_dialog("(Cos'era quello...?)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("All'improvviso, uno strano suono proviene da dietro di me, come se un bottone cadesse sul pavimento.")
	await novel_interface.show_text_only("In questa piccola stanza sigillata, il rumore dell'oggetto che rotola sul pavimento sembra innaturalmente chiaro.")
	novel_interface.show_character("ren_full","normal1")
	await novel_interface.show_dialog("?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mi giro: è una piccola cosa gialla. Mi avvicino e lo prendo.")
	await novel_interface.show_text_only("È un minuscolo oggetto rotondo con otto piccole protuberanze sulla superficie.")
	novel_interface.show_character("ren_full","wry_smile")
	await novel_interface.show_dialog("... È caduto dal mio vestito?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ma assomiglia proprio alle caramelle konpeito che mangiavo quando ero piccola. Per un secondo ho quasi voglia di leccarlo.")
	await novel_interface.show_dialog("Eh?", "???")
	await novel_interface.show_text_only("È la voce di una bambina!")
	novel_interface.show_character("stardust_small","smile")
	await novel_interface.show_dialog("Eh? Cosa dovrei cercare?", "Stardust")

	print("=== 星尘降临篇第5话结束 ===")

	# 调用剧情结束函数
	await novel_interface.end_story_episode(0.5)
