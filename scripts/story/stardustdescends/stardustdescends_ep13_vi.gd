	await novel_interface.show_text_only("Rất nhanh, những người mặc đồ đen tụ tập bắt đầu hoảng sợ, khi những luồng khói hơi cay trắng phun ra từ bốn điểm khác nhau trong đám đông...")
	await novel_interface.show_text_only("Và chiếc xe của chúng tôi lao đi và biến mất ở góc đường.")
	await novel_interface.stop_music()
	await novel_interface.hide_background_with_fade()
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("............")
	await novel_interface.show_text_only("Khi cái bóng của bức tường biệt lập sau lưng tôi nhỏ dần, đất đai hai bên đường dần trở nên cằn cỗi.")
	await novel_interface.show_text_only("Sau khi ở lại thành phố quá lâu, người ta dễ dàng quên rằng bản thân Masadaburg là một thành phố đột ngột được xây dựng trên sa mạc.")
	await novel_interface.show_text_only("Chiếc APC phóng nhanh trên một con đường vắng, và không có dấu hiệu của sự sống con người ở đâu ngoài con đường cao tốc vắng vẻ.")
	await novel_interface.show_text_only("Chỉ còn vài bụi cây khô héo vẫn bướng bỉnh đứng trên cát...")
