	await novel_interface.show_dialog("Đi đậy đĩa~", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emily lơ đãng trả lời trong khi kiểm tra bản đồ lộ trình trên chiếc máy tính bảng quân sự chắc chắn của mình.")
	novel_interface.show_character("ren_medical","wry_smile")
	novel_interface.character_move_left(-0.25,0)
