	await novel_interface.show_dialog("Hiểu rồi~", "Vera")
	await novel_interface.show_text_only("Vera quay bánh xe đến giới hạn và nhấn ga, xoay phần đầu xe trong một vòng mà không hề quan tâm đến sự thoải mái của hành khách.")
	await novel_interface.show_text_only("Một lúc sau, trên mui xe vang lên bốn tiếng thịch: thịch, thịch, thịch, thịch.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("(Đợi đã, tại sao âm thanh đó lại giống súng phóng lựu...)", "Lian")
