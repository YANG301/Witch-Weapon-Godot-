# stardustdescends_ep13.gd - 星尘降临篇第13话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep13_script()

func play_script():
	pass

func stardustdescends_ep13_script():
	novel_interface.change_music("res://assets/audio/music/Story_01.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadSentry.png")
	await novel_interface.show_text_only("Dựa trên hình ảnh từ màn hình phương tiện, phía trước là một phần bức tường cách ly vẫn đang được xây dựng.")
	await novel_interface.show_text_only("Bởi vì nơi này nằm ở rìa nội thành, nên nó không có cảm giác thịnh vượng, yên bình như quận trung tâm--")
	await novel_interface.show_text_only("Thép, bê tông và bụi đã khôi phục lại kết cấu thô sơ của vùng chiến sự sa mạc.")
	await novel_interface.show_text_only("Trạm kiểm soát phía trước được xây dựng giống như một pháo đài và một số APC cùng mẫu đậu xung quanh nó.")
	await novel_interface.show_text_only("Ở phía xa, nhiều cần cẩu tháp và máy móc hạng nặng đang làm việc, và đằng sau bức tường bạn có thể mơ hồ nhìn thấy những đàn máy bay không người lái trên bầu trời.")
	await novel_interface.show_text_only("Từ cách các rào chắn kim loại được bố trí, lối ra phía trước rõ ràng đã bị cấm xe cộ qua lại.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCO2.png")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("Ý bạn là... ép bạn vượt qua?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily gõ đốt ngón tay vào bức tường bên trong của APC.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Với cái này?", "Emily")
	novel_interface.change_expression("mock")
	await novel_interface.show_dialog("Bộ giáp rất chắc chắn nhưng nó dẫn nhiệt giống như kim loại thông thường. Có lẽ chúng tôi sẽ trụ được khoảng hai mươi giây trước khi bị nướng sống~", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên chiếc xe dừng lại. Một giọng nói quen thuộc phát ra từ cabin tài xế--")
	await novel_interface.show_dialog("Vera Valkyrie, Chuẩn úy của Tiểu đoàn Caracal, đang đón nhân sự từ trại để trinh sát bên ngoài thành phố.", "Vera")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("(Đó là nữ bảo vệ siêu mạnh trên tàu sòng bạc phải không?!)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi vẫn còn nhớ rất rõ cô ấy đã nâng vị giám mục to lớn đó bằng một tay.")
	await novel_interface.show_dialog("Ồ, đó là Vera. Hiện tại đang có một cuộc biểu tình diễn ra ở chợ Yehuda. Nếu không muốn sa lầy, tốt nhất bạn nên tìm lối thoát khác...", "Giọng nam")
	await novel_interface.show_dialog("Đừng nói nữa và để chúng tôi đi qua đã. Chúng ta không có thời gian để đi đường vòng!", "Vera")
	await novel_interface.show_dialog("Haha, được, được. Chỉ cần đừng gây thêm rắc rối là được. Lần trước ông già của cậu đã gọi từ Bộ Tổng tham mưu xuống chỉ để trêu chọc mọi người...", "Giọng nam")
	await novel_interface.show_dialog("Nhắc đến anh ta một lần nữa và tôi sẽ chạy qua bạn.", "Vera")
	await novel_interface.show_dialog("Di chuyển rào chắn. Hãy để họ đi qua, để họ đi qua!", "Giọng nam")
	await novel_interface.show_text_only("Emily cúi xuống và thì thầm với tôi.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Vậy, bạn có từng nghĩ đến việc hét lên để được giúp đỡ... và sau đó bỏ chạy không?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","shy_left")
	await novel_interface.show_dialog("Tất nhiên là không!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi vội quay đầu đi. Hừ, cô thật đáng ghét!")
	await novel_interface.show_text_only("Chiếc xe từ từ lăn bánh về phía trước và nhanh chóng xuyên qua bức tường cách ly để tiến vào ngoại thành Masada.")
	await novel_interface.show_text_only("Tôi đã cho rằng thành phố bên ngoài sẽ còn hoang vắng hơn nữa, nhưng sau khi chúng tôi vượt qua bức tường cách ly, số người trên đường đột nhiên tăng vọt--")
	await novel_interface.show_text_only("Ở đây đường sá gồ ghề hơn, ít nhà cao tầng và vành đai xanh hơn, nhưng đường phố lại sôi động đến không ngờ.")
	await novel_interface.show_text_only("Những dòng người đông đúc, những chiếc xe buýt len lỏi qua lại, những gánh hàng rong bán hàng rong khiến tôi có cảm giác như mình đang trôi xuyên thời gian.")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Có rất nhiều người ở đây...", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Tất nhiên. Chín mươi phần trăm dân số thành phố này sống bên ngoài bức tường cách ly.", "Emily")
	novel_interface.character_light(0.35,"panic")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Nhiều đến vậy sao!?", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Nội thành chỉ có tổng diện tích 32 km2, chưa bằng 1/4 tổng diện tích của Masada và giá đất thì quá cao ~", "Emily")
	await novel_interface.show_dialog("Đặc biệt là ở quận trung tâm. Diện tích sàn của một nhà vệ sinh ở đó đủ để mua một căn hộ studio bên Biển Chết.", "Emily")
	novel_interface.character_light(0.35,"wry_smile")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Tôi tưởng bức tường cách ly là để làm việc đó... bạn biết đấy...", "Lian")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Phân biệt chủng tộc?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Đúng, đúng. Chẳng phải có quy định nào đó rằng một số từ xúc phạm đến một nhóm cụ thể chỉ có thể được nói bởi chính những người trong nhóm đó sao...")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Hội đồng Liên hiệp đã đặt những việc đó ra ngoài vòng pháp luật từ lâu rồi~", "Emily")
	await novel_interface.show_dialog("Nhưng Đạo luật chống khủng bố của Masada quy định rằng nếu bạn muốn cư trú lâu dài trong nội thành, nơi đặt trụ sở của chính phủ và quốc hội, bạn phải vượt qua cuộc kiểm tra của Cục An ninh.", "Emily")
	await novel_interface.show_dialog("Và những người nộp đơn có gia đình trực hệ thuộc một số nhóm dân tộc nhất định sẽ không bao giờ vượt qua... hiểu không?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Tôi gật đầu, chỉ hiểu được một nửa.")
	await novel_interface.show_text_only("Vậy đó là sự phân biệt!\nNgay cả khi nghe có vẻ như họ đang tự tách biệt mình...")
	await novel_interface.show_text_only("Và nếu điều đó là sự thật thì ngay cả hầu hết người dân tộc Masadan cũng phải sống ở ngoại thành phải không?")
	await novel_interface.show_text_only("Trên màn hình, tôi nhìn thấy một nữ quân nhân đeo khẩu M16 trên vai đang ngồi xổm trước một quầy bán đồ trang trí tóc trên đường, mặc cả với một người phụ nữ bán hàng có khuôn mặt quấn khăn trùm đầu.")
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("(Hóa ra không ai có đủ khả năng mua nhà cho dù họ đến từ đâu...)", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Đột nhiên xe phanh gấp. Đầu tôi suýt đập vào màn hình, và tiếng chửi thề của Vera vang lên từ cabin tài xế.")
	await novel_interface.show_dialog("Chết tiệt!!", "Vera")
	novel_interface.show_character("emilio","shout")
	await novel_interface.show_dialog("Chuyện gì đã xảy ra vậy!?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Tôi đã phóng một máy bay trinh sát không người lái. Chỉ cần xem màn hình chính mình.", "Vera")
	await novel_interface.hide_background()
	await novel_interface.show_text_only("Emily và tôi vội vã đến chỗ trưng bày và nhìn thấy một cảnh khiến tôi nổi da gà--")
	#novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_AncientHumanEH.png") #原游戏有素材，但已丢失
	await novel_interface.show_text_only("Hơn một nghìn người mặc áo khoác đen, đội mũ đen đã tụ tập ở ngã tư phía trước, giống như một đám tang lớn nào đó.")
	await novel_interface.show_text_only("Họ giương cao những tấm biển phản đối đen trắng tự chế, như thể phản đối sự tồn tại của bất kỳ màu sắc nào khác trên thế giới.")
	await novel_interface.show_text_only("Hầu hết họ đều có bộ râu rậm rạp và những bím tóc nhỏ kỳ lạ ở thái dương. Ánh mắt đó thật quen thuộc...")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_MasadAPCR1.png")
	await novel_interface.show_dialog("Những thứ vô dụng này! Họ sống nhờ tiền trợ cấp của nhà nước và vẫn biểu tình hàng ngày!", "Vera")
	await novel_interface.show_text_only("Cứ cho là \"bleep\" là một loại phương ngữ nào đó... Dù sao thì tôi cũng không hiểu được.")
	await novel_interface.show_dialog("Họ muốn số trường tiểu học phù hợp với học thuyết của họ tăng gấp đôi?\nNhững lọn tóc xoăn chết tiệt đó đã mọc vào não họ chưa!?", "Vera")
	await novel_interface.show_text_only("Tôi nghe thấy tiếng đá từ cửa cabin. Có vẻ như tài xế của chúng tôi đã nhảy ra ngoài để gây sự.")
	novel_interface.show_character("ren_medical","wail")
