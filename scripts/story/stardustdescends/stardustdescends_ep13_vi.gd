	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("(Có lẽ khoảng mười đứa trẻ mà tôi thấy tụ tập quanh hai người đàn ông có râu mặc đồ đen ở bảo tàng đã--)", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Và hai người phụ nữ hốc hác đi theo sau họ...")
	await novel_interface.show_text_only("Khi tôi nghĩ đến chiếc xe đẩy mà một trong số họ đã đẩy, một cơn ớn lạnh chạy dọc sống lưng tôi.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Những người theo trào lưu tôn giáo chính thống là căn bệnh ung thư cho dù bạn có đi đâu...", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emily tiếp tục cúi đầu nghịch máy tính bảng, giọng điệu mang theo một nỗi buồn kỳ lạ và một chút cam chịu.")
	await novel_interface.show_text_only("Chẳng bao lâu Vera đã quay lại xe, Emily vỗ nhẹ vào vách ngăn kim loại của cabin để nhắc nhở cô.")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Đi vòng đến ngã tư thứ ba ở phía đông. Có một cầu vượt mới hoàn thành ở đó. Đó là con đường nhanh nhất ra khỏi thành phố.", "Emily")
	await novel_interface.show_dialog("Ngoài ra, nếu bạn định làm \"việc đó\", hãy nhớ quay đầu xe trước.", "Emily")
