	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"stare")
	await novel_interface.show_dialog("Chúng là lô \"di sản lịch sử\" của Masada. Họ không làm việc, không đóng thuế, không phục vụ trong quân đội, và chính phủ vẫn phải trợ cấp hàng tháng cho họ--", "Emily")
	await novel_interface.show_dialog("Ngay cả khi họ gây rối trật tự công cộng và cản trở giao thông, cảnh sát và quân đội cũng không thể động đến họ, vì họ có tòa án tôn giáo riêng.", "Emily")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("...Tốt quá à?", "Lian")
	novel_interface.change_expression("uneasy")
	await novel_interface.show_dialog("(Không phải điều đó có nghĩa là bạn có thể ở nhà và chơi game mỗi ngày...)", "Lian")
