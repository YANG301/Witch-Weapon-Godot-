	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_StagingPost.png")
	await novel_interface.show_text_only("Sau khoảng một giờ ở bên ngoài thành phố, cửa khoang quân từ từ mở ra và một trạm tiếp tế quân sự xuất hiện trước mặt tôi.")
	novel_interface.show_character("valkyrja","normal")
