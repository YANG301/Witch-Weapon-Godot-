	novel_interface.character_2nd_light(0.35,"mock")
	await novel_interface.show_dialog("Nhưng học thuyết của họ nói rằng không được có TV hay máy tính trong nhà, và việc truy cập internet bị nghiêm cấm--", "Emily")
