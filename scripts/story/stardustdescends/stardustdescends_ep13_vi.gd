	novel_interface.change_2nd_expression("stare")
	await novel_interface.show_dialog("Không phải vì trợ cấp quá nhỏ. Đó là bởi vì phụ nữ trong những gia đình đó trung bình có sáu hoặc bảy đứa con, và một số có hơn chục đứa con.", "Emily")
	novel_interface.change_2nd_expression("speechless")
	await novel_interface.show_dialog("Nhiều con thế. Không có gì ngạc nhiên khi các trường tôn giáo là không đủ...", "Emily")
