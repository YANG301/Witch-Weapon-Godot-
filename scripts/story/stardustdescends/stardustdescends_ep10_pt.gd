	await novel_interface.show_dialog("Ehehe~~", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("O que está acontecendo...?\nEssa coisinha... deixou de ser uma ilusão?")
	await novel_interface.show_text_only("Desde quando? Será que Annie e eu simplesmente não percebemos porque pudemos vê-la o tempo todo?")
	await novel_interface.show_text_only("Não, tinha que ser depois de passarmos pela imigração. Caso contrário, a alfândega nunca nos teria deixado passar tão facilmente.")
	await novel_interface.show_text_only("O que significa que aconteceu agora há pouco?")
	await novel_interface.show_text_only("De qualquer forma, devemos investigar isso no hotel mais tarde. Por enquanto precisamos blefar ~")
	await novel_interface.show_text_only("Espere, falando em imigração...")
	novel_interface.show_character("emilio","normal")
	await novel_interface.show_dialog("Ainda assim, Lian──", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Emilio pareceu notar alguma coisa. Ela casualmente agarrou o pulso de Stardust e virou-o.")
	novel_interface.show_character("emilio","stare")
	await novel_interface.show_dialog("Por que ela não tem um código de barras de imigração na mão?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Minha cabeça zumbia e o suor começou a escorrer pela minha testa.")
	await novel_interface.show_text_only("Acabou, acabou. Estou sendo preso!!")
	await novel_interface.show_text_only("Ouvi dizer que até mesmo os cidadãos comuns em Massada são extremamente sensíveis em relação a entradas ilegais – não importa se os soldados nos pegassem em flagrante na rua...")
	await novel_interface.show_text_only("Emilio estudou minha expressão rígida, depois olhou para Stardust, que ainda abraçava o suco de romã e sorria estupidamente sem entender nada.")
	novel_interface.show_character("emilio","speechless")
	await novel_interface.show_dialog("Suspiro. Se você andar pela cidade com ela abertamente, será preso em uma hora.", "Emily")
	await novel_interface.hide_character()
