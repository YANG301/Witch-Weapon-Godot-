	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Emílio se agachou.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Essa criança é adorável ~ Ela não é local, é?", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust e eu congelei no local.")
	novel_interface.show_character("stardust_small","panic")
	await novel_interface.show_dialog("Hein...?\nUgh... guh...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Toda a sua bravata desapareceu num instante. Apavorada quase até as lágrimas, ela se escondeu freneticamente atrás de mim.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("ren_medical","wail",0.25)
	await novel_interface.show_dialog("Ah? Hahaha...\nS-Ela é minha... minha, hum...", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Como ela está vendo ela?")
	await novel_interface.show_text_only("Emilio tirou da sacola de compras uma garrafa de vidro cheia de um líquido vermelho transparente. Não havia nenhum rótulo nele.")
	novel_interface.show_character("stardust_small","panic")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("emilio","smile",0.25)
	await novel_interface.show_dialog("Suco de romã espremido na hora. É uma delícia~\nUma das famosas especialidades da cidade.", "Emily")
	await novel_interface.show_dialog("Aqui, tome um──", "Emily")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Ao dizer isso, ela estendeu a garrafa para Stardust. Quando percebi que precisava impedi-la, já era tarde demais.")
	await novel_interface.show_text_only("Eu praticamente pude ver a garrafa passando pelo corpo do Stardust e se espatifando no chão...")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("emilio","smile",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Hum... obrigado...", "Stardust")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Stardust pegou a garrafa e segurou-a nos braços.\nEmilio estendeu a mão e deu um tapinha na cabeça dela.")
	novel_interface.show_character("stardust_small","uneasy")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("emilio","mock",0.25)
