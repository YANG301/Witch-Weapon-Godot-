# stardustdescends_ep10.gd - 星尘降临篇第10话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep10_script()

func play_script():
	pass

func stardustdescends_ep10_script():
	await novel_interface.show_text_only("Quando saímos da imigração, o céu já havia clareado e nós três embarcamos no ônibus ferroviário do porto.")
	await novel_interface.show_text_only("O trem maglev era incrivelmente rápido. Em menos de dez minutos, chegou à estação Knesset, no centro da cidade de Massada.")
	await novel_interface.show_text_only("...")
	novel_interface.change_music("res://assets/audio/music/Like A Girl.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","panic")
	await novel_interface.show_dialog("Isto...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("I-Isso é incrível!!", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","happy")
	await novel_interface.show_dialog("Uau──", "Stardust")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Então isto é... Masadaburg?", "Lian")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","panic",0.25)
	await novel_interface.show_dialog("Até eu... não esperava isso...", "Annie")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("A cena diante de nós derrubou completamente minha impressão de Masada como uma “fortaleza no deserto devastada pela guerra”──")
	await novel_interface.show_text_only("Em ruas tão limpas e elegantes como um jardim, robôs de saneamento de IA e carrinhos de carga não tripulados podiam ser vistos por toda parte.")
	await novel_interface.show_text_only("As fachadas dos arranha-céus no distante centro da cidade eram revestidas com painéis metálicos com um forte toque futurista, refletindo vagamente as nuvens brancas acima.")
	await novel_interface.show_text_only("Sob o céu azul, vastas extensões de vegetação estendiam-se até o horizonte...")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Este ar é incrivelmente refrescante──", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apoiando-me no corrimão de pedra, respirei fundo. O ar úmido carregava o leve sabor salgado exclusivo do vento marinho.")
	novel_interface.show_character("ren_medical","smile")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("anne_uniform","happy",0.25)
	await novel_interface.show_dialog("Este é o local com a maior pressão atmosférica da Terra. Com mais oxigênio no ar, respirar fica mais fácil ~", "Annie")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Não acredito que transformaram o deserto do Mar Morto nisto...", "Annie")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Annie, que trecho é aquele ali...?", "Lian")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Apontei para a esquerda. Ao longe havia uma barreira que se estendia de leste a oeste, e além dela parecia não haver nenhum arranha-céu.")
	novel_interface.show_character("anne_uniform","stare")
	await novel_interface.show_dialog("Esse é o “muro de isolamento”.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("Estamos longe agora, mas na verdade tem dezenas de metros de altura, com pontos de verificação de segurança e sistemas de defesa automatizados por toda parte.", "Annie")
	await novel_interface.show_dialog("Existem muitos sensores enterrados no subsolo também. Nem mesmo um rato conseguiria passar.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie suspirou e murmurou baixinho para si mesma.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("A capital anterior deles também tinha algo assim e ainda assim foi achatada...", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("Isso aconteceu há muito tempo, certo...?\nEu estava apenas no ensino fundamental naquela época—", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Então me ocorreu que Annie havia passado sete anos na Lacuna da Causalidade. Para ela, essa memória pode não ser tão antiga.")
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("M-A propósito──\nQual é o sentido de construir um muro como esse?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Eu rapidamente mudei de assunto de maneira bastante estranha.")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Se a guerra realmente estourasse, um muro como aquele não impediria nada...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","normal2")
	await novel_interface.show_dialog("Os governos constroem muros por todos os tipos de razões - para impedir invasões, impedir a fuga de pessoas, impedir a entrada de imigrantes ilegais...", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Annie disse isso enquanto olhava para as bandeiras das Seis Cidades Escolares no parque à frente.")
	novel_interface.show_character("anne_uniform","upset")
	await novel_interface.show_dialog("Mas a situação de Masada é ainda mais complicada...", "Annie")
	await novel_interface.show_dialog("Em ambos os lados desse muro, muitas pessoas não querem ver o outro lado.", "Annie")
	await novel_interface.show_dialog("Só não vendo o outro lado, fingindo que os outros não existem, é que poderão viver com a consciência limpa.", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Bem... embora eu duvide que você realmente entenda, Lian.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Ooh~~ Entendo...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust de repente entrou na conversa, balançando a cabeça e fazendo uma pose pensativa, como se entendesse completamente.")
	novel_interface.show_character("stardust_small","pleased")
	await novel_interface.show_dialog("Hum, hum~", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Como se você entendesse alguma coisa! Não é exatamente a mesma reação que tenho quando desmaio durante a aula de física?!")
	await novel_interface.show_text_only("Para ser justo, a explicação de Annie também passou pela minha cabeça. Talvez tivesse algo a ver com seu próprio passado...")
	await novel_interface.show_text_only("Vendo o olhar vazio e perdido em meus olhos, Annie passou um braço em volta do meu pescoço.")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ei, não leve isso tão a sério. Na maioria das vezes estou apenas falando bobagem ~", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Deixe-me dizer uma coisa. O \"Phantom Force\" de Masada está em algum lugar subterrâneo no centro da cidade!", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Huh...?\nVocê quer dizer aquele objeto heteromórfico da classe XK?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("\"Phantom Force\" é o objeto heteromórfico de classe estratégica de Masada, existindo como um espaço designado imóvel.")
	await novel_interface.show_text_only("Qualquer arma disparada de dentro desse espaço ganha um efeito de amplificação anormal, produzindo poder destrutivo centenas de vezes além do seu design original.")
	novel_interface.show_background("res://assets/images/bg/Stardust/BG_Stardust_doomsday.png")
	await novel_interface.show_text_only("O “sistema de contra-ataque automático” anunciado pela Terceira Cidade Escolar há algum tempo faz uso exatamente dessa propriedade.")
	await novel_interface.show_text_only("Se o sistema determinar que os danos à área urbana de Massada ultrapassaram 50%, ele ativará automaticamente o “Programa do Juízo Final”──")
	await novel_interface.show_text_only("Usar Phantom Force para lançar armas nucleares indiscriminadamente em todas as grandes cidades do mundo, garantindo a destruição mútua.")
	await novel_interface.show_text_only("Suscitou protestos ferozes quando foi anunciado pela primeira vez, mas as pessoas pareceram aceitar o facto consumado com uma rapidez surpreendente.")
	await novel_interface.show_text_only("O facto de Masada ter conseguido chegar rapidamente a um acordo de cessar-fogo com a resistência provavelmente tem muito a ver com esse sistema.")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_Masadainner.png")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Você vê a blindagem de metal nesses edifícios?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("eu notei isso antes...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Não me diga que toda esta cidade foi construída para lutar contra os Apóstolos...")
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Ouvi dizer que todo o subsolo do centro da cidade está revestido com a mesma armadura.", "Annie")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Quanto mais ouço, mais soa exatamente assim!")
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("O-O que você quer dizer...?", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","smile")
	await novel_interface.show_dialog("Por que você acha que eles escolheram construir sua nova capital neste deserto árido e salgado perto do Mar Morto—", "Annie")
	await novel_interface.show_dialog("E depois gastou uma soma enorme construindo um grande canal com uma queda de mais de quatrocentos metros apenas para sustentar uma capital num local tão miserável.", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Por causa do Phantom Force abaixo...?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Apontei para o chão sob meus pés, mas algo parecia estranho.")
	novel_interface.show_character("ren_medical","panic")
	await novel_interface.show_dialog("Mas isso ainda é um investimento muito grande... Não é como Aegis, um escudo que pode bloquear todos os ataques externos.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("anne_uniform","worry")
	await novel_interface.show_dialog("É por isso que todos os países suspeitam que Phantom Force possa ter alguma propriedade chave não revelada.", "Annie")
	novel_interface.change_expression("normal1")
	await novel_interface.show_dialog("O suficiente para que os líderes de Massada estivessem dispostos a arriscar o destino de todo o povo desta terra.", "Annie")
	await novel_interface.show_dialog("Você poderia dizer que toda a cidade é uma instalação de proteção construída em torno de Phantom Force──", "Annie")
	novel_interface.change_expression("happy")
	await novel_interface.show_dialog("Então, como parte desse sistema defensivo, construir um muro de isolamento nessa escala não parece tão estranho, não é?", "Annie")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","stare")
	await novel_interface.show_dialog("Então \"Masada Shall Never Fall\" também carrega essa implicação...", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mas quanto mais incansavelmente um segredo é protegido, mais curioso ele torna as pessoas...")
	await novel_interface.show_text_only("Virei-me para olhar para o outdoor gigante do lado de fora da estação Knesset com o mesmo slogan e inesperadamente vi um rosto familiar—")
	await novel_interface.show_text_only("Emilio, carregando uma sacola de compras branca e recheada, subia a escada rolante de saída da estação...")
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Ah?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("O tenente encontrou meus olhos, sorriu e se aproximou.")
	await novel_interface.show_text_only("Annie instantaneamente, como uma profissional, agiu como uma estranha que não me conhecia, arrastando a mala enquanto olhava para o telefone.")
	await novel_interface.show_text_only("Enquanto isso, nos últimos dois dias Stardust parecia ter percebido que ninguém mais podia vê-la ou ouvi-la, e ficou muito mais ousado.")
	await novel_interface.show_text_only("Ela ficou presunçosamente na minha frente como um cachorrinho encorajado por ter seu dono por trás dele.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Ah! Você é aquela... enfermeira estagiária do navio cassino, certo?", "Emily")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Ela olhou para o crachá pendurado em meu peito.")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Seu nome é Lian, certo ~", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","perspire1")
	await novel_interface.show_dialog("H-Olá...\nQue bom encontrar você novamente.", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("Haha, eu queria te contar: depois que você saiu naquele dia, dei uma lição adequada ao garçom.", "Emily")
	await novel_interface.show_dialog("Mais tarde descobrimos que ele também havia assediado várias traficantes.", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wail")
	await novel_interface.show_dialog("——O que!?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Então ele também era reincidente?")
	novel_interface.show_character("emilio","mock")
	await novel_interface.show_dialog("E desta vez ele até ousou colocar as mãos em um convidado. O cérebro dele estava em curto-circuito ou o quê?", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("ren_medical","wry_smile")
	await novel_interface.show_dialog("Ahahaha...!", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Na verdade, era o spray de hipnose!")
	novel_interface.show_character("ren_medical","happy")
	await novel_interface.show_dialog("Falando nisso, eu realmente preciso agradecer por me deixar passar pela segurança naquele dia...", "Lian")
	await novel_interface.hide_character()
	novel_interface.show_character("emilio","smile")
	await novel_interface.show_dialog("Ah, não foi nada. Ultimamente, os superiores têm adorado nos recrutar para todo tipo de tarefas chatas.", "Emily")
	novel_interface.change_expression("upset")
	await novel_interface.show_dialog("E da última vez eles também fizeram papel de bobo – a equipe de contenção passou meio dia examinando o navio com uma montanha de equipamentos e não encontrou absolutamente nada.", "Emily")
	novel_interface.change_expression("speechless")
	await novel_interface.show_dialog("Não tenho ideia de onde eles compraram essas informações falsas dessa época...", "Emily")
	await novel_interface.hide_character()
	novel_interface.show_character("stardust_small","stare")
	await novel_interface.show_dialog("Hmph! E ela ainda tinha que ser tão má...", "Stardust")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Stardust mostrou a língua para Emilio.")
	novel_interface.show_character("stardust_small","stare")
	novel_interface.character_move_left(-0.25)
