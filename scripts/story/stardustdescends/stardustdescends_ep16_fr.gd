# stardustdescends_ep16.gd - 星尘降临篇第16话
extends Node2D

@onready var novel_interface = $NovelInterface

func _ready():
	await get_tree().process_frame
	stardustdescends_ep16_script()

func play_script():
	pass

func stardustdescends_ep16_script():
	novel_interface.change_music("res://assets/audio/music/Sunset.mp3")
	novel_interface.change_background("res://assets/images/bg/Stardust/BG_Stardust_ShelterOffice.png")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Combien d'enfants avez-vous ici ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("J'ai demandé à tante Haïfa, qui était tombée dans ses pensées.")
	await novel_interface.show_dialog("Trente-deux. Ce sont tous des orphelins de la colonie, aucun n'ayant plus de dix ans.", "Haifa")
	await novel_interface.show_dialog("C'est tout ce que je peux gérer, et même là, j'ai encore besoin de travailleurs sociaux pour m'aider pendant la journée... soupir...", "Haifa")
	await novel_interface.show_dialog("Il y a des centaines d’autres enfants comme ça dans les bidonvilles voisins. Les crèches de Massada reçoivent si peu de financement qu'elles parviennent à peine à continuer de fonctionner.", "Haifa")
	await novel_interface.show_text_only("Tout comme Mariru l'a dit, une fois que les ressources environnantes sont pillées, même un endroit comme Massada, avec une armée aussi énorme, ne peut pas continuer éternellement...")
	novel_interface.show_character("ren_medical","worry")
	await novel_interface.show_dialog("N'y a-t-il personne qui puisse aider ces orphelins ? Massada ne garde-t-elle pas toujours ses portes ouvertes aux ONG... ?", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("Certaines personnes portant des casques blancs sont venues avant, mais elles ont juste pris quelques photos d'enfants handicapés et sont parties...", "Haifa")
	await novel_interface.show_dialog("J'arrive à peine à suivre comme ça. Même les tâches comme le ménage dépendent de l’aide des enfants plus âgés. Je ne peux pas faire grand-chose...", "Haifa")
	novel_interface.show_character("ren_medical","smile")
	await novel_interface.show_dialog("Ne dis pas ça ! Je suis sûr que les enfants vous sont tous incroyablement reconnaissants...\nJe veux dire, même moi--", "Lian")
	await novel_interface.show_dialog("R-Quoi qu'il en soit, avoir une famille est vraiment important pour des enfants comme eux !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Elle m'a regardé avec surprise, puis a souri gentiment.")
	await novel_interface.show_dialog("Quel bon enfant. Vous n'êtes pas d'ici, n'est-ce pas, Lian ?", "Haifa")
	await novel_interface.show_dialog("Emily a dit que tu resterais ici ce soir et que tu partirais demain matin ?", "Haifa")
	novel_interface.show_character("ren_medical","gratified")
	await novel_interface.show_dialog("Mm. On dirait que le centre-ville est sous la loi martiale ce soir parce qu'ils signent demain un accord de cessez-le-feu avec la résistance... Désolé de l'imposer !", "Lian")
	await novel_interface.hide_character()
	await novel_interface.show_dialog("C'est bon, c'est bon. Je vais d'abord préparer le bain.", "Haifa")
	await novel_interface.show_text_only("Tante Haïfa se leva et se dirigea vers la porte en murmurant pour elle-même.")
	await novel_interface.show_dialog("Soupir... Tant de haine peut-elle vraiment être effacée par un seul morceau de papier...", "Haifa")
	await novel_interface.stop_music()
	await novel_interface.hide_background()
	await novel_interface.show_text_only("..................")
	await novel_interface.show_text_only("...")
	await novel_interface.show_text_only("SID Salle de Commande.")
	novel_interface.change_music("res://assets/audio/music/Normal Stage.mp3")
	novel_interface.change_background("res://assets/images/bg/SID/opsRoom.png")
	await novel_interface.show_text_only("Mariru entra dans la salle de commandement en bâillant et en portant deux tasses de café, pour découvrir qu'Aya travaillait toujours sur la console principale.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Il est rare que vous vous portiez volontaire pour un travail de renseignement aussi morne que celui-ci.", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","wink")
	await novel_interface.show_dialog("Parce que la cible est intéressante~", "Aya")
	await novel_interface.hide_character()
	await novel_interface.show_text_only("Mariru posa le macchiato au caramel sur la table à côté d'Aya, et Aya en but une gorgée.")
	novel_interface.show_character("liliu_uniform1","normal2")
	await novel_interface.show_dialog("Est-il vraiment acceptable de boire quelque chose d'aussi sucré au milieu de la nuit... ?", "Mariru")
	await novel_interface.hide_character()
	novel_interface.show_character("ai","stare")
	await novel_interface.show_dialog("Mon cerveau va brûler le sucre de toute façon. Et j'ai trouvé une percée.", "Aya")
	novel_interface.character_move_left(-0.25)
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	await novel_interface.show_dialog("Vous avez trouvé un initié ?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Non. Étant donné le niveau de cryptage du projet 0812, moins de dix personnes devraient connaître l'image complète, et je n'en trouve aucune.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("C'est vrai. Connaissant le style de Palantir, il était hors de question qu'ils laissent échapper une cible d'une telle valeur...", "Mariru")
	novel_interface.character_light(0.35,"stare")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("J'ai donc changé d'approche à la place...", "Aya")
	await novel_interface.show_dialog("Tout vaisseau spatial impliquant de la matière hétérogène devrait être le summum de la capacité industrielle et technologique d'un pays.", "Aya")
	await novel_interface.show_dialog("Au moins plusieurs milliers de personnes auraient été impliquées dans sa conception, sa R&D, sa fabrication et son transport.", "Aya")
	novel_interface.change_expression("think")
	await novel_interface.show_dialog("Et après l'effondrement du gouvernement fédéral, les lois sur le secret ont cessé de s'appliquer, donc...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Vous envisagez d'analyser des informations publiques en ligne ?\nLa plupart doivent être des déchets, n'est-ce pas... ?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya haussa les épaules.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Au début, certains anciens initiés divulguaient des informations juste pour gagner de l'argent... les gens étaient naturellement curieux de ce genre d'histoire.", "Aya")
	await novel_interface.show_dialog("Ensuite, les sociétés de marketing en ligne ont envahi le site, ont publié des titres sensationnels sur ces bribes d'informations brutes et les ont complétées de toutes sortes d'embellissements.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Avant que le public n’en ait assez des pièges à clics et des fausses nouvelles, il existait plus de six millions d’informations publiques impliquant des secrets de la NASA.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Je pensais autant...", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Mariru se frotta les tempes, impuissante, et Aya lui fit une grimace.")
	novel_interface.show_character("ai","stare")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Mais si vous utilisez l'IA pour la décomposition sémantique et le traçage des sources, filtrez les informations avec une confiance orthogonale supérieure à 90 %...", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Vous obtenez bien plus de matériel que prévu ~", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Aya tapota le clavier et un écran de données apparut instantanément. Mariru se redressa immédiatement.")
	novel_interface.show_character("ai","normal")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.character_light()
	novel_interface.show_2nd_character("liliu_uniform1","normal1",0.25)
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Le projet 0812 a une masse totale comprise entre 30 et 50 tonnes. L'équipement optique représente à lui seul 5 tonnes et il n'emporte aucun système de survie.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("A cette masse, ce n'est certainement pas un satellite... Une station spatiale sans pilote ?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Peut-être. L'engin dispose de deux systèmes de propulsion et peut changer d'orbite entre 660 kilomètres au-dessus de la Terre et 36 000 kilomètres.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("L’un d’eux est un moteur ionique capable de fournir une accélération stable dans l’espace sur le long terme, avec une durée de vie nominale de trente ans.", "Aya")
	novel_interface.change_expression("normal") 
	await novel_interface.show_dialog("L’autre est un moteur à propulsion conventionnel capable de supporter un atterrissage retour sur Terre et représente près de la moitié de la masse du système.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"serious")
	await novel_interface.show_dialog("S'attarder dans l'espace aussi longtemps et ajuster constamment sa position orbitale... Était-il censé rester dirigé vers une source de signal située à 400 années-lumière ?", "Mariru")
	novel_interface.character_light()
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Et le fait qu'il soit récupérable suggère que le volume de données est trop important pour être transmis sans fil...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("De quelle quantité d’informations parlons-nous… ?", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Pouvez-vous localiser ce satellite ?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quelque chose d'aussi gros aurait dû être impossible à cacher à Sentinel, mais il n'apparaît sur aucune orbite...", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Sentinel est le système de surveillance des astéroïdes, n'est-ce pas ?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Ouais. Selon les archives, la dernière fois qu’un vaisseau spatial correspondant à ces caractéristiques a changé d’orbite, c’était il y a environ un an.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light()
	await novel_interface.show_dialog("Alors à ce moment-là... la clé de contrôle a été vendue au marché noir ?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Aucune idée. Si vous vouliez cacher quelque chose d'aussi gros, vous le cacheriez peut-être derrière la lune ?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"sigh")
	await novel_interface.show_dialog("Au fait... quand avez-vous écrit une IA comme celle-ci ?", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Je ne pourrais pas écrire quelque chose comme ça. Le modèle et les paramètres ont été mis en ligne avant-hier par un compte appelé Elder Seven.", "Aya")
	novel_interface.change_expression("wink")
	await novel_interface.show_dialog("Les forums de la communauté open source ont explosé ces derniers jours~", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Qu'a-t-il de si spécial ?", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("La personne a également publié l’algorithme. Selon des estimations approximatives, former une IA à ce niveau nécessiterait plus d'un milliard de dollars de calcul.", "Aya")
	await novel_interface.show_dialog("Et un code à cette échelle n’aurait certainement pas pu être écrit par une seule personne.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Quelle organisation ouvrirait quelque chose d'aussi précieux... ? L'as-tu bien isolé ?", "Mariru")
	novel_interface.character_light(0.35,"wink")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Bien sûr. J'ai tout exécuté dans une machine virtuelle Themis.", "Aya")
	novel_interface.change_expression("normal")
	await novel_interface.show_dialog("Ce modèle peut rapidement archiver des volumes massifs d'informations similaires et juger des corrélations entre elles...", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("Dans le même temps, il évalue la fiabilité de chaque élément en fonction du degré d'orthogonalité des différentes sources.", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"jest")
	await novel_interface.show_dialog("Cela semble utile. Ces sociétés de marketing louches sont alors en difficulté ?", "Mariru")
	novel_interface.character_light(0.35,"blush_think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C'est ce que je pensais au début. Mais réfléchissez-y : si vous le connectiez à une base de données suffisamment grande...", "Aya")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("L'expression de Mariru devint soudainement sérieuse...")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","serious",0.25)
	await novel_interface.show_dialog("Comme un système de surveillance de sécurité gouvernemental... ?", "Mariru")
	await novel_interface.hide_all_characters()
	await novel_interface.show_text_only("Exactement. Combiné à la reconnaissance d’images, il pourrait profiler et classer tout le monde, puis déduire comment ils sont connectés.")
	await novel_interface.show_text_only("Il pourrait également utiliser ces informations pour déterminer les objectifs d’une cible et prédire le comportement des gens, voire même les orienter volontairement…")
	await novel_interface.show_text_only("Mariru secoua la tête. Ce n’était pas le moment de laisser leur attention dériver.")
	novel_interface.show_character("ai","blush_think")
	novel_interface.character_move_left(-0.25,0)
	novel_interface.show_2nd_character("liliu_uniform1","sigh",0.25)
	await novel_interface.show_dialog("Nous pourrons parler de cette IA plus tard.", "Mariru")
	novel_interface.change_2nd_expression("normal1")
	await novel_interface.show_dialog("Ils ont finalisé le choix du représentant de Massada pour la signature du cessez-le-feu de demain. Ce sera le général de division Hamon du Commandement du Nord.", "Mariru")
	await novel_interface.show_dialog("Et pour des raisons politiques, le site de signature a été choisi comme étant le Centre international de congrès de Massada, au bord de la mer Morte.", "Mariru")
	novel_interface.character_light(0.35,"think")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("C’est logique. Un cessez-le-feu signé derrière le mur d’isolement ne convaincra jamais personne.", "Aya")
	novel_interface.change_expression("stare")
	await novel_interface.show_dialog("De toute façon, quel genre de personnes font partie de la résistance ? Je n’y ai jamais prêté beaucoup d’attention auparavant.", "Aya")
