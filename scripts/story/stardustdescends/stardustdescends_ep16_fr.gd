	novel_interface.character_2nd_light(0.35,"normal2")
	await novel_interface.show_dialog("Bien sûr que non ~", "Mariru")
	await novel_interface.show_dialog("Au début, il s’agissait d’une coalition de milices ethniques locales, de groupes religieux extrémistes, de restes de l’armée après la chute du gouvernement et de bandits errants.", "Mariru")
	await novel_interface.show_dialog("Il s’agissait tous de groupes armés qui détestaient Massada et parlaient entre eux sept ou huit langues locales. Normalement, ils auraient dû être effacés séparément...", "Mariru")
	novel_interface.character_light(0.35,"normal")
	novel_interface.character_2nd_dark()
	await novel_interface.show_dialog("Quel genre de personne pourrait organiser un groupe comme celui-là ?", "Aya")
	novel_interface.character_dark()
	novel_interface.character_2nd_light(0.35,"normal1")
	await novel_interface.show_dialog("Walid Mushar, celui qui signera demain l'accord au nom de la résistance.", "Mariru")
	await novel_interface.show_dialog("Même après des années de traque par une Force de défense nationale équipée deux générations avant elle, il a quand même réussi à rendre la résistance de plus en plus grande.", "Mariru")
